import Mathlib
import InfoGeometry.Canonical.SplitOctonionExterior3HodgeDiracBridge
import InfoGeometry.Canonical.SplitOctonionCl55ExteriorRestrictionBridge
import InfoGeometry.Physics.ColorCARStandardModel

/-!
# Injective canonical-Zorn to Cl(5,5) Furey carrier bridge

The repository already owns:

* a basis-preserving linear equivalence from the real three-mode exterior
  algebra to the canonical circular Zorn split-octonion carrier;
* an injective linear restriction from that exterior carrier into `Cl(5,5)`;
* the identification of each exterior degree-one generator with
  `2 • chiralPlus55 i`;
* the conjugate Furey span generated by the `chiralPlus55` convention.

Composing the inverse exterior/Zorn equivalence with the exterior/Clifford
injection gives an explicit injective linear map from the full canonical real
Zorn carrier into `Cl(5,5)`.  This is a carrier map, not a multiplicative
split-octonion-to-Clifford algebra homomorphism.
-/

noncomputable section

namespace InfoGeometry.Physics.QCDZornCl55FureyBridge

open InfoGeometry.Canonical.SplitOctonionExterior3HodgeDiracBridge
open InfoGeometry.Canonical.SplitOctonionCl55ExteriorRestrictionBridge
open InfoGeometry.Physics.ColorCARStandardModel
open InfoGeometry.Clifford.Clifford55

abbrev CanonicalZornR :=
  InfoGeometry.Canonical.SplitOctonionExterior3HodgeDiracBridge.CanonicalSplitOctonion
abbrev Exterior3 :=
  InfoGeometry.Canonical.SplitOctonionExterior3HodgeDiracBridge.Exterior3

/-- Injective carrier map from the canonical real Zorn split-octonion model to
`Cl(5,5)`, routed through the literal three-mode exterior algebra. -/
noncomputable def canonicalZornToCl55 : CanonicalZornR →ₗ[ℝ] Cl55 :=
  exterior3ToCl55Carrier.comp exterior3CircularPeirceEquiv.symm.toLinearMap

/-- The Zorn-to-Clifford carrier map is injective. -/
theorem canonicalZornToCl55_injective :
    Function.Injective canonicalZornToCl55 := by
  intro X Y hXY
  apply exterior3CircularPeirceEquiv.symm.injective
  exact exterior3ToCl55Carrier_injective hXY

/-- Canonical Zorn color generator obtained from the literal exterior degree-one
basis vector. -/
noncomputable def canonicalColorGenerator (i : Fin 3) : CanonicalZornR :=
  exterior3CircularPeirceEquiv
    (ExteriorAlgebra.ι ℝ
      (InfoGeometry.Canonical.SplitOctonionCl55ExteriorRestrictionBridge.basisVector3 i))

/-- Each canonical Zorn color generator maps exactly to twice the corresponding
positive Witt generator in `Cl(5,5)`. -/
theorem canonicalZornToCl55_colorGenerator (i : Fin 3) :
    canonicalZornToCl55 (canonicalColorGenerator i) =
      (2 : ℝ) • chiralPlus55 i := by
  simp [canonicalZornToCl55, canonicalColorGenerator]
  exact exterior3ToCl55Carrier_basis_generator i

/-- Each canonical Zorn color generator lands in the conjugate Furey span. -/
theorem canonicalColorGenerator_mem_fureyConjugateGeneration (i : Fin 3) :
    canonicalZornToCl55 (canonicalColorGenerator i) ∈
      (fureyConjugateGeneration : Submodule ℝ Cl55) := by
  rw [canonicalZornToCl55_colorGenerator]
  exact fureyConjugateGeneration.smul_mem (2 : ℝ)
    (carAnn_mem_fureyConjugateGeneration i)

/-- The three Zorn color generators remain linearly distinguishable after the
Clifford embedding. -/
theorem canonicalColorGenerator_embedding_injective
    {i j : Fin 3}
    (h : canonicalZornToCl55 (canonicalColorGenerator i) =
      canonicalZornToCl55 (canonicalColorGenerator j)) :
    canonicalColorGenerator i = canonicalColorGenerator j :=
  canonicalZornToCl55_injective h

/-- Consolidated carrier-level Zorn/Clifford/Furey bridge. -/
theorem zorn_cl55_furey_packet :
    Function.Injective canonicalZornToCl55 ∧
    (∀ i : Fin 3,
      canonicalZornToCl55 (canonicalColorGenerator i) =
        (2 : ℝ) • chiralPlus55 i) ∧
    (∀ i : Fin 3,
      canonicalZornToCl55 (canonicalColorGenerator i) ∈
        (fureyConjugateGeneration : Submodule ℝ Cl55)) :=
  ⟨canonicalZornToCl55_injective,
    canonicalZornToCl55_colorGenerator,
    canonicalColorGenerator_mem_fureyConjugateGeneration⟩

end InfoGeometry.Physics.QCDZornCl55FureyBridge

end noncomputable section
