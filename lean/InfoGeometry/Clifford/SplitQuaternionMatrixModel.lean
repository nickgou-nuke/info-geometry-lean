import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra

/-!
# The real `M₂(ℝ)` model of split quaternions

This is the associative four-dimensional subalgebra generated by an elliptic
unit `ι` and a hyperbolic unit `ℓ`:
`ι² = -1`, `ℓ² = 1`, and `ιℓ = -ℓι`.

The names are local to this owner so they do not collide with the repository's
other Pauli and Clifford conventions.
-/

namespace InfoGeometry.Clifford.SplitQuaternionMatrixModel

open scoped Matrix

abbrev Mat2R := InfoGeometry.Algebra.FiniteSpin.Mat2R

def one : Mat2R := !![(1 : ℝ), 0; 0, 1]

def elliptic : Mat2R := !![(0 : ℝ), -1; 1, 0]

def hyperbolic : Mat2R := !![(0 : ℝ), 1; 1, 0]

def bivector : Mat2R := !![(1 : ℝ), 0; 0, -1]

/-! The coordinate combination of the four native `Cl(1,1)` generators. -/
def cl11Combination (a b c d : ℝ) : Mat2R :=
  a • one + b • elliptic + c • hyperbolic + d • bivector

theorem cl11Combination_apply (a b c d : ℝ) :
    cl11Combination a b c d = !![a + d, -b + c; b + c, a - d] := by
  ext r c'
  fin_cases r <;> fin_cases c' <;>
    simp [cl11Combination, one, elliptic, hyperbolic, bivector]
  <;> ring

theorem cl11Combination_eq_zero_iff (a b c d : ℝ) :
    cl11Combination a b c d = 0 ↔ a = 0 ∧ b = 0 ∧ c = 0 ∧ d = 0 := by
  rw [cl11Combination_apply]
  constructor
  · intro h
    have h00 := congrArg (fun M : Mat2R => M 0 0) h
    have h01 := congrArg (fun M : Mat2R => M 0 1) h
    have h10 := congrArg (fun M : Mat2R => M 1 0) h
    have h11 := congrArg (fun M : Mat2R => M 1 1) h
    simp at h00 h01 h10 h11
    constructor
    · linarith
    constructor
    · linarith
    constructor
    · linarith
    · linarith
  · rintro ⟨rfl, rfl, rfl, rfl⟩
    ext r c'
    fin_cases r <;> fin_cases c' <;> simp

/-! The four coordinates give an actual linear equivalence with `M₂(ℝ)`. -/
def cl11CoordinateMap : (Fin 4 → ℝ) →ₗ[ℝ] Mat2R where
  toFun x := cl11Combination (x 0) (x 1) (x 2) (x 3)
  map_add' x y := by
    ext r c'
    fin_cases r <;> fin_cases c' <;>
      simp [cl11Combination, one, elliptic, hyperbolic, bivector]
    <;> ring
  map_smul' a x := by
    ext r c'
    fin_cases r <;> fin_cases c' <;>
      simp [cl11Combination, one, elliptic, hyperbolic, bivector]
    <;> ring

noncomputable def cl11CoordinateInverse : Mat2R →ₗ[ℝ] (Fin 4 → ℝ) where
  toFun M :=
    ![(M 0 0 + M 1 1) / 2,
      (M 1 0 - M 0 1) / 2,
      (M 0 1 + M 1 0) / 2,
      (M 0 0 - M 1 1) / 2]
  map_add' M N := by
    funext i
    fin_cases i <;> simp <;> ring
  map_smul' a M := by
    funext i
    fin_cases i <;> simp <;> ring

theorem cl11CoordinateMap_leftInverse :
    cl11CoordinateInverse.comp cl11CoordinateMap = LinearMap.id := by
  ext x i
  fin_cases i <;>
    simp [cl11CoordinateInverse, cl11CoordinateMap, cl11Combination_apply]
    <;> ring

theorem cl11CoordinateMap_rightInverse :
    cl11CoordinateMap.comp cl11CoordinateInverse = LinearMap.id := by
  ext M r c'
  fin_cases r <;> fin_cases c' <;>
    simp [cl11CoordinateInverse, cl11CoordinateMap, cl11Combination_apply]
    <;> ring

noncomputable def cl11CoordinateLinearEquiv : (Fin 4 → ℝ) ≃ₗ[ℝ] Mat2R :=
  LinearEquiv.ofLinear cl11CoordinateMap cl11CoordinateInverse
    cl11CoordinateMap_rightInverse cl11CoordinateMap_leftInverse

@[simp] theorem cl11CoordinateLinearEquiv_apply (x : Fin 4 → ℝ) :
    cl11CoordinateLinearEquiv x = cl11CoordinateMap x := rfl

@[simp] theorem elliptic_sq : elliptic * elliptic = -one := by
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [elliptic, one, Matrix.mul_apply, Fin.sum_univ_two]

@[simp] theorem hyperbolic_sq : hyperbolic * hyperbolic = one := by
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [hyperbolic, one, Matrix.mul_apply, Fin.sum_univ_two]

@[simp] theorem bivector_sq : bivector * bivector = one := by
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [bivector, one, Matrix.mul_apply, Fin.sum_univ_two]

theorem elliptic_mul_hyperbolic : elliptic * hyperbolic = -bivector := by
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [elliptic, hyperbolic, bivector, Matrix.mul_apply,
      Fin.sum_univ_two]

theorem hyperbolic_mul_elliptic : hyperbolic * elliptic = bivector := by
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [elliptic, hyperbolic, bivector, Matrix.mul_apply,
      Fin.sum_univ_two]

theorem elliptic_mul_bivector : elliptic * bivector = hyperbolic := by
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [elliptic, hyperbolic, bivector, Matrix.mul_apply,
      Fin.sum_univ_two]

theorem bivector_mul_elliptic : bivector * elliptic = -hyperbolic := by
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [elliptic, hyperbolic, bivector, Matrix.mul_apply,
      Fin.sum_univ_two]

theorem hyperbolic_mul_bivector : hyperbolic * bivector = elliptic := by
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [elliptic, hyperbolic, bivector, Matrix.mul_apply,
      Fin.sum_univ_two]

theorem bivector_mul_hyperbolic : bivector * hyperbolic = -elliptic := by
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [elliptic, hyperbolic, bivector, Matrix.mul_apply,
      Fin.sum_univ_two]

theorem elliptic_hyperbolic_anticomm :
    elliptic * hyperbolic + hyperbolic * elliptic = 0 := by
  rw [elliptic_mul_hyperbolic, hyperbolic_mul_elliptic]
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [bivector]

theorem hyperbolic_bivector_anticomm :
    hyperbolic * bivector + bivector * hyperbolic = 0 := by
  rw [hyperbolic_mul_bivector, bivector_mul_hyperbolic]
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [elliptic]

theorem bivector_elliptic_anticomm :
    bivector * elliptic + elliptic * bivector = 0 := by
  rw [bivector_mul_elliptic, elliptic_mul_bivector]
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [hyperbolic]

theorem split_clifford_signature :
    elliptic * elliptic = -one ∧
      hyperbolic * hyperbolic = one ∧
      bivector * bivector = one ∧
      elliptic * hyperbolic + hyperbolic * elliptic = 0 ∧
      hyperbolic * bivector + bivector * hyperbolic = 0 ∧
      bivector * elliptic + elliptic * bivector = 0 := by
  exact ⟨elliptic_sq, hyperbolic_sq, bivector_sq,
    elliptic_hyperbolic_anticomm, hyperbolic_bivector_anticomm,
    bivector_elliptic_anticomm⟩

theorem determinant_formula (a b c d : ℝ) :
    (a • one + b • elliptic + c • hyperbolic + d • bivector).det
      = a ^ 2 + b ^ 2 - c ^ 2 - d ^ 2 := by
  simp [one, elliptic, hyperbolic, bivector, Matrix.det_fin_two, pow_two]
  ring

end InfoGeometry.Clifford.SplitQuaternionMatrixModel
