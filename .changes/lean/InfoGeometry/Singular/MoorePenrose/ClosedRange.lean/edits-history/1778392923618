{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Singular/MoorePenrose/ClosedRange.lean","time":1778392923618,"baseTime":1778392922781,"changes":[{"range":{"start":{"line":4,"character":0},"end":{"line":136,"character":0}},"text":"import InfoGeometry.Singular.MoorePenrose\n\nopen InfoGeometry.Singular.MoorePenrose\n\n/-!\n# Analytic closed-range Moore-Penrose inverse: canonical Mathlib v4.28.0\n\nThis file is an API-faithful, owner-correct analytic Moore-Penrose existence block for continuous linear operators on Hilbert spaces, following strict Mathlib v4.28.0 conventions and ensuring all facts are owned by explicit API theorems and instances.\n\nMain theorem: `exists_moorePenroseInverse_of_closedRange`\n- A bounded operator A : E →L[𝕜] E with closed range admits a Moore-Penrose inverse B.\n- All Penrose equations and the adjoint (star) laws follow from explicit projection identities.\n\nReferences:\n  - Mathlib/Analysis/InnerProductSpace/Projection/Basic.lean (starProjection, orthogonalProjection API)\n  - Mathlib/Analysis/InnerProductSpace/Adjoint.lean (isSelfAdjoint_starProjection)\n  - Mathlib/Analysis/Normed/Operator/Banach.lean (ContinuousLinearEquiv.ofBijective)\n\nAuthors: see git blame and upstream references.\n-/\n\nsection Hilbert\n\nopen InnerProductSpace ContinuousLinearMap\nopen scoped InnerProduct ComplexConjugate\n\nvariable {𝕜 E : Type*}\nvariable [RCLike 𝕜]\nvariable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\n\n/-- Existence of a canonical Moore-Penrose inverse for closed-range Hilbert operators. -/\ntheorem exists_moorePenroseInverse_of_closedRange\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    ∃ (B : E →L[𝕜] E), IsMoorePenroseInverse A B := by\n  classical\n\n  let K : Submodule 𝕜 E := A.ker\n  let R : Submodule 𝕜 E := A.range\n  let Kp : Submodule 𝕜 E := Kᗮ\n\n  -- Instances: HasOrthogonalProjection for K, R, Kp, derived from closedness.\n  haveI : CompleteSpace K := by\n    dsimp [K]\n    exact A.isClosed_ker.completeSpace_coe\n  haveI : K.HasOrthogonalProjection := inferInstance\n  haveI : CompleteSpace Kp := by dsimp [Kp]; infer_instance\n  haveI : Kp.HasOrthogonalProjection := by dsimp [Kp]; infer_instance\n  haveI : CompleteSpace R := by dsimp [R]; exact hClosedRange.completeSpace_coe\n  haveI : R.HasOrthogonalProjection := inferInstance\n\n  -- Key fact: A vanishes on K and only sees the Kᗮ component.\n  have hA_on_Kp : ∀ x : E, A (Kp.starProjection x) = A x := by\n    intro x\n    have hsplit :=\n        Submodule.starProjection_add_starProjection_orthogonal (K := K) x\n    have hKzero : A (K.starProjection x) = 0 := by\n      exact Submodule.starProjection_apply_mem K x\n    calc\n      A (Kp.starProjection x)\n          = A (K.starProjection x + Kp.starProjection x) := by\n              rw [map_add, hKzero, zero_add]\n      _ = A x := by\n              rw [hsplit]\n\n  -- Restrict and codrestrict A to Kᗮ and R\n  let Ares : Kp →L[𝕜] R :=\n    (A.comp Kp.subtypeL).codRestrict R\n      (fun x => LinearMap.mem_range.mpr ⟨x.1, rfl⟩)\n\n  have hAres_inj : (Ares : Kp →ₗ[𝕜] R).ker = ⊥ :=\n    LinearMap.ker_eq_bot.mpr\n      (by\n        intro x y hxy\n        apply Subtype.ext\n        have hval : A x.1 = A y.1 := congrArg Subtype.val hxy\n        have hker : x.1 - y.1 ∈ K := by\n          change A (x.1 - y.1) = 0\n          rw [map_sub, hval, sub_self]\n        have horth : x.1 - y.1 ∈ Kᗮ := by\n          simpa [Kp] using Submodule.sub_mem Kp x.2 y.2\n        have hinner :=\n            (K.mem_orthogonal (x.1 - y.1)).mp horth (x.1 - y.1) hker\n        have hzero : x.1 - y.1 = 0 :=\n          inner_self_eq_zero.mp hinner\n        exact sub_eq_zero.mp hzero)\n\n  have hAres_surj : (Ares : Kp →ₗ[𝕜] R).range = ⊤ :=\n    LinearMap.range_eq_top.mpr\n      (by\n        intro y\n        rcases y with ⟨y, hy⟩\n        rcases hy with ⟨x, rfl⟩\n        refine ⟨Kp.orthogonalProjection x, ?_⟩\n        apply Subtype.ext\n        change A ((Kp.orthogonalProjection x : Kp) : E) = A x\n        simpa using hA_on_Kp x)\n\n  let e : Kp ≃L[𝕜] R :=\n    ContinuousLinearEquiv.ofBijective Ares hAres_inj hAres_surj\n\n  -- Construction: inclusion_Kᗮ ∘ e⁻¹ ∘ orthogonalProjection_R\n  let B : E →L[𝕜] E :=\n    Kp.subtypeL.comp (e.symm.toContinuousLinearMap.comp R.orthogonalProjection)\n\n  -- Projection identities, as direct calculations:\n  have hAB_apply : ∀ x : E, A (B x) = R.starProjection x := by\n    intro x\n    have h :=\n      ContinuousLinearEquiv.ofBijective_apply_symm_apply\n         Ares hAres_inj hAres_surj (R.orthogonalProjection x)\n    simp only [B, comp_apply, Submodule.subtypeL_apply]\n    change (Ares (e.symm (R.orthogonalProjection x)) : E) = _\n    rw [h]\n\n  have hBA_apply : ∀ x : E, B (A x) = Kp.starProjection x := by\n    intro x\n    have hproj :=\n        Submodule.orthogonalProjection_mem_subspace_eq_self\n          (K := R) (⟨A x, ⟨x, rfl⟩⟩ : R)\n    have hTz :\n        Ares (Kp.orthogonalProjection x) =\n          (⟨A x, ⟨x, rfl⟩⟩ : R) := by\n      apply Subtype.ext\n      change A ((Kp.orthogonalProjection x : Kp) : E) = A x\n      simpa using hA_on_Kp x\n    have hsymm₀ :=\n      ContinuousLinearEquiv.ofBijective_symm_apply_apply\n        Ares hAres_inj hAres_surj (Kp.orthogonalProjection x)\n    have hsymm :\n        e.symm (⟨A x, ⟨x, rfl⟩⟩ : R) = Kp.orthogonalProjection x := by\n      rw [← hTz]\n      simp [e] at hsymm₀ ⊢; exact hsymm₀\n","rangeOffset":219,"rangeLength":5033}]}