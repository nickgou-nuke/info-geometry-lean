import Mathlib.Tactic.NoncommRing
import Mathlib.Algebra.Ring.GeomSum

/-!
# Idempotent order and finite Zorn-chain Peirce refinement

These are finite algebraic consequences of a two-sided idempotent flag in an
associative unital ring. They do not assert that arbitrary rings have maximal
abelian diagonal subalgebras, nor that arbitrary chains have upper bounds.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine.IdempotentZornChainArchetypes

variable {B : Type*} [Ring B]

/-- Natural two-sided absorption order on idempotents. -/
def idemLe (P Q : B) : Prop := P * Q = P ∧ Q * P = P

def chainCyclo3 (X : B) : B := X * X + X + 1
def chainCyclo2 (X : B) : B := X + 1
def chainCyclo4 (X : B) : B := X * X + 1
def chainCyclo6 (X : B) : B := X * X - X + 1
def ringComm (X Y : B) : B := X * Y - Y * X

def idempotencyDefect (x : B) : B := x * x - x

/-- The two quadratic cyclotomic evaluations have product `1 + X²` whenever
the fourth power vanishes. This is an identity in one ring element and does
not assume that the ambient ring is commutative. -/
theorem chainCyclo3_mul_chainCyclo6_of_fourth_power_eq_zero {X : B}
    (hX4 : X * X * X * X = 0) :
    chainCyclo3 X * chainCyclo6 X = 1 + X * X := by
  dsimp [chainCyclo3, chainCyclo6]
  calc
    (X * X + X + 1) * (X * X - X + 1) =
        1 + X * X + X * X * X * X := by noncomm_ring
    _ = 1 + X * X := by rw [hX4]; abel

/-- The commutator of the inner derivations generated by the sum and
difference of two noncommuting link operators is the inner derivation of
their commutator, with the exact factor `-2`. Thus a zero-curvature claim
requires a further centrality/annihilation hypothesis; it does not follow
from the two-generator notation alone. -/
theorem sum_difference_inner_derivation_curvature (s t X : B) :
    ringComm (s + t) (ringComm (s - t) X) -
      ringComm (s - t) (ringComm (s + t) X) =
        -((2 : ℤ) • ringComm (ringComm s t) X) := by
  unfold ringComm
  noncomm_ring

/-- Exact flatness criterion for the sum/difference inner-derivation pair.
Over an arbitrary ring, the curvature vanishes on every operator precisely
when twice the adjoint action of the generator commutator vanishes. This
formulation does not cancel `2`, which is not cancellable in general
characteristic. -/
theorem sum_difference_inner_derivation_flat_iff_two_torsion
    (s t : B) :
    (∀ X : B,
      ringComm (s + t) (ringComm (s - t) X) -
        ringComm (s - t) (ringComm (s + t) X) = 0) ↔
      (∀ X : B,
        (2 : ℤ) • ringComm (ringComm s t) X = 0) := by
  constructor
  · intro h X
    have hcurv := sum_difference_inner_derivation_curvature s t X
    rw [h X] at hcurv
    have hzero : -((2 : ℤ) • ringComm (ringComm s t) X) = 0 := hcurv.symm
    exact (neg_eq_zero.mp hzero)
  · intro h X
    rw [sum_difference_inner_derivation_curvature]
    rw [h X]
    simp

/-- A pair of adjacent square-zero chain steps factors the quadratic
cyclotomic evaluations in their directed order and the linear factors in the
reverse order. The exact two-sided inverses retain no scalar divisions. -/
theorem adjacent_square_zero_cyclotomic_factorization {x y : B}
    (hx : x * x = 0) (hy : y * y = 0) (hyx : y * x = 0) :
    (1 - y) * (1 - x) = 1 - (x + y) ∧
    (1 + y) * (1 + x) = 1 + (x + y) ∧
    (1 + x) * (1 + y) = chainCyclo3 (x + y) ∧
    (1 - x) * (1 - y) = chainCyclo6 (x + y) ∧
    (1 - (x + y)) * chainCyclo3 (x + y) = 1 ∧
    chainCyclo3 (x + y) * (1 - (x + y)) = 1 ∧
    (1 + (x + y)) * chainCyclo6 (x + y) = 1 ∧
    chainCyclo6 (x + y) * (1 + (x + y)) = 1 := by
  have hsquare : (x + y) * (x + y) = x * y := by
    noncomm_ring [hx, hy, hyx]
  have hxxyp : x * (x * y) = 0 := by rw [← mul_assoc, hx, zero_mul]
  have hyxy : y * (x * y) = 0 := by rw [← mul_assoc, hyx, zero_mul]
  have hrevMinus : (1 - y) * (1 - x) = 1 - (x + y) := by
    noncomm_ring [hyx]
  have hrevPlus : (1 + y) * (1 + x) = 1 + (x + y) := by
    noncomm_ring [hyx]
  have hforPlus : (1 + x) * (1 + y) = chainCyclo3 (x + y) := by
    dsimp [chainCyclo3]
    rw [hsquare]
    noncomm_ring
  have hforMinus : (1 - x) * (1 - y) = chainCyclo6 (x + y) := by
    dsimp [chainCyclo6]
    rw [hsquare]
    noncomm_ring
  refine ⟨hrevMinus, hrevPlus, hforPlus, hforMinus, ?_, ?_, ?_, ?_⟩
  · rw [← hrevMinus, ← hforPlus]
    noncomm_ring [hx, hy, hyx, hxxyp, hyxy]
  · rw [← hforPlus, ← hrevMinus]
    noncomm_ring [hx, hy, hyx, hxxyp, hyxy]
  · rw [← hrevPlus, ← hforMinus]
    noncomm_ring [hx, hy, hyx, hxxyp, hyxy]
  · rw [← hforMinus, ← hrevPlus]
    noncomm_ring [hx, hy, hyx, hxxyp, hyxy]

/-- Three directed square-zero steps form a four-vertex path. Its forward
unipotent product is the four-term path sum, equivalently
`(1 + A)(1 + A^2)` for the total step `A`; the reverse product is `1 - A`.
Consequently the four-term path sum is a two-sided inverse of `1 - A`.
All products are kept in their directed noncommutative order. -/
theorem three_step_path_cyclotomic_factorization {x y z : B}
    (hxx : x * x = 0) (hyy : y * y = 0) (hzz : z * z = 0)
    (hyx : y * x = 0) (hzx : z * x = 0) (hzy : z * y = 0)
    (hxz : x * z = 0) :
    let A := x + y + z
    A * A = x * y + y * z ∧
    A * A * A = x * y * z ∧
    A * A * A * A = 0 ∧
    (1 - z) * (1 - y) * (1 - x) = 1 - A ∧
    (1 + x) * (1 + y) * (1 + z) =
      chainCyclo2 A * chainCyclo4 A ∧
    (1 - A) * (chainCyclo2 A * chainCyclo4 A) = 1 ∧
    (chainCyclo2 A * chainCyclo4 A) * (1 - A) = 1 := by
  let a := x + y + z
  have hA2 : a * a = x * y + y * z := by
    dsimp [a]
    noncomm_ring [hxx, hyy, hzz, hyx, hzx, hzy, hxz]
  have hA3 : a * a * a = x * y * z := by
    dsimp [a]
    noncomm_ring [hxx, hyy, hzz, hyx, hzx, hzy, hxz]
  have hA4 : a * a * a * a = 0 := by
    dsimp [a]
    noncomm_ring [hxx, hyy, hzz, hyx, hzx, hzy, hxz]
  have hA4r : a * (a * (a * a)) = 0 := by
    calc
      a * (a * (a * a)) = a * a * a * a := by noncomm_ring
      _ = 0 := hA4
  have hForward : (1 + x) * (1 + y) * (1 + z) =
      1 + a + a * a + a * a * a := by
    dsimp [a]
    noncomm_ring [hxx, hyy, hzz, hyx, hzx, hzy, hxz]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · change a * a = x * y + y * z
    exact hA2
  · change a * a * a = x * y * z
    exact hA3
  · change a * a * a * a = 0
    exact hA4
  · change (1 - z) * (1 - y) * (1 - x) = 1 - a
    dsimp [a]
    noncomm_ring [hxx, hyy, hzz, hyx, hzx, hzy, hxz]
  · change (1 + x) * (1 + y) * (1 + z) =
      chainCyclo2 a * chainCyclo4 a
    calc
      _ = 1 + a + a * a + a * a * a := hForward
      _ = chainCyclo2 a * chainCyclo4 a := by
        rw [chainCyclo2, chainCyclo4]
        noncomm_ring
  · change (1 - a) * (chainCyclo2 a * chainCyclo4 a) = 1
    rw [chainCyclo2, chainCyclo4]
    noncomm_ring [hA4r]
  · change (chainCyclo2 a * chainCyclo4 a) * (1 - a) = 1
    rw [chainCyclo2, chainCyclo4]
    noncomm_ring [hA4r]

/-- A finite directed family of square-zero steps has an exact ordered
unipotent inverse. The hypothesis says that every later step annihilates
each earlier step in the reverse direction; no commutativity is assumed. -/
def directedSquareZeroSteps : List B → Prop
  | [] => True
  | x :: xs =>
      x * x = 0 ∧ (∀ y ∈ xs, y * x = 0) ∧ directedSquareZeroSteps xs

/-- Forward product of the factors associated to an ordered step list. -/
def directedStepForwardProduct : List B → B
  | [] => 1
  | x :: xs => (1 + x) * directedStepForwardProduct xs

/-- Reverse-ordered product of the inverse factors associated to an ordered
step list. -/
def directedStepReverseInverseProduct : List B → B
  | [] => 1
  | x :: xs => directedStepReverseInverseProduct xs * (1 - x)

/-- The reverse-ordered product collapses to one minus the sum of all steps. -/
theorem directedStepReverseInverseProduct_eq_one_sub_sum
    (xs : List B) (hxs : directedSquareZeroSteps xs) :
    directedStepReverseInverseProduct xs = 1 - xs.sum := by
  induction xs with
  | nil => simp [directedStepReverseInverseProduct]
  | cons x xs ih =>
      rcases hxs with ⟨_hx, hcross, htail⟩
      have hsum : xs.sum * x = 0 := by
        have hsum_zero : ∀ ys : List B, (∀ y ∈ ys, y * x = 0) → ys.sum * x = 0 := by
          intro ys
          induction ys with
          | nil => intro; simp
          | cons y ys ih =>
              intro hall
              simp only [List.sum_cons, add_mul]
              rw [hall y (by simp)]
              have htail_zero : ys.sum * x = 0 := by
                apply ih
                intro z hz
                exact hall z (by simp [hz])
              rw [htail_zero]
              simp
        exact hsum_zero xs hcross
      simp only [directedStepReverseInverseProduct, List.sum_cons]
      rw [ih htail]
      noncomm_ring [hsum]

/-- The ordered forward unipotent product and the reverse-ordered product of
the inverse factors are two-sided inverses. This is the finite-list form of
the directed Zorn-chain cancellation law. -/
theorem directedStepProducts_are_two_sided_inverses
    (xs : List B) (hxs : directedSquareZeroSteps xs) :
    directedStepReverseInverseProduct xs * directedStepForwardProduct xs = 1 ∧
      directedStepForwardProduct xs * directedStepReverseInverseProduct xs = 1 := by
  induction xs with
  | nil => simp [directedStepReverseInverseProduct, directedStepForwardProduct]
  | cons x xs ih =>
      rcases hxs with ⟨hx, _hcross, htail⟩
      rcases ih htail with ⟨hleft, hright⟩
      constructor
      · simp only [directedStepReverseInverseProduct, directedStepForwardProduct]
        calc
          directedStepReverseInverseProduct xs * (1 - x) *
              ((1 + x) * directedStepForwardProduct xs) =
              directedStepReverseInverseProduct xs *
                ((1 - x) * (1 + x)) * directedStepForwardProduct xs := by
                  noncomm_ring
          _ = directedStepReverseInverseProduct xs * 1 *
                directedStepForwardProduct xs := by
                  rw [show (1 - x) * (1 + x) = 1 by noncomm_ring [hx]]
          _ = 1 := by noncomm_ring [hleft]
      · simp only [directedStepReverseInverseProduct, directedStepForwardProduct]
        calc
          (1 + x) * directedStepForwardProduct xs *
              (directedStepReverseInverseProduct xs * (1 - x)) =
              (1 + x) * (directedStepForwardProduct xs *
                directedStepReverseInverseProduct xs) * (1 - x) := by
                  noncomm_ring
          _ = (1 + x) * 1 * (1 - x) := by rw [hright]
          _ = 1 := by noncomm_ring [hx]

/-- Every finite directed square-zero step family supplies an exact
two-sided inverse for `1 - sum(steps)`, with its inverse written as the
forward-ordered product of the elementary unipotent factors. -/
theorem directedStepForwardProduct_is_geometric_resolvent
    (xs : List B) (hxs : directedSquareZeroSteps xs) :
    (1 - xs.sum) * directedStepForwardProduct xs = 1 ∧
      directedStepForwardProduct xs * (1 - xs.sum) = 1 := by
  have hreverse := directedStepReverseInverseProduct_eq_one_sub_sum xs hxs
  have hinverses := directedStepProducts_are_two_sided_inverses xs hxs
  constructor
  · rw [← hreverse]
    exact hinverses.1
  · rw [← hreverse]
    exact hinverses.2

/-- If every element of a list annihilates a fixed element on the right,
then the list sum does too. -/
private theorem list_sum_mul_eq_zero_of_forall
    (xs : List B) (x : B) (h : ∀ y ∈ xs, y * x = 0) : xs.sum * x = 0 := by
  induction xs with
  | nil => simp
  | cons y ys ih =>
      simp only [List.sum_cons, add_mul]
      rw [h y (by simp)]
      have htail : ∀ z ∈ ys, z * x = 0 := by
        intro z hz
        exact h z (by simp [hz])
      rw [ih htail]
      simp

/-- The sum of a finite directed square-zero family is nilpotent of exponent
`length + 1`. This is the algebraic path-length cutoff for an acyclic chain. -/
private theorem squareZero_sum_binomial_step {x s : B}
    (hxx : x * x = 0)
    (hpowx : ∀ n : ℕ, 0 < n → s ^ n * x = 0) :
    ∀ n : ℕ, (x + s) ^ (n + 1) = x * s ^ n + s ^ (n + 1) := by
  intro n
  induction n with
  | zero => simp
  | succ n ihn =>
      rw [pow_succ (x + s) (n + 1), ihn]
      have h1 := hpowx (n + 1) (Nat.succ_pos n)
      have hs1 : s ^ n * s = s ^ (n + 1) := by
        rw [← pow_succ s n]
      have hxss : x * s ^ n * s = x * s ^ (n + 1) := by
        calc
          x * s ^ n * s = x * (s ^ n * s) := by noncomm_ring
          _ = x * s ^ (n + 1) := by rw [hs1]
      have hs2 : s ^ (n + 1) * s = s ^ (n + 2) := by
        rw [← pow_succ s (n + 1)]
      have hxsx : x * s ^ n * x = 0 := by
        cases n with
        | zero => simpa using hxx
        | succ k =>
            have hk := hpowx (k + 1) (Nat.succ_pos k)
            calc
              x * s ^ (k + 1) * x = x * (s ^ (k + 1) * x) := by noncomm_ring
              _ = 0 := by rw [hk]; simp
      calc
        (x * s ^ n + s ^ (n + 1)) * (x + s) =
            x * s ^ (n + 1) + s ^ (n + 2) := by
              calc
                _ = x * s ^ n * x + x * s ^ n * s +
                    s ^ (n + 1) * x + s ^ (n + 1) * s := by noncomm_ring
                _ = x * s ^ (n + 1) + s ^ (n + 2) := by
                  rw [hxsx, h1, hxss, hs2]
                  abel

private theorem directedSquareZero_cons_sum_pow_succ_eq_zero
    (x : B) (xs : List B) (hxx : x * x = 0)
    (hcross : ∀ y ∈ xs, y * x = 0)
    (htailPow : xs.sum ^ (xs.length + 1) = 0) :
    (x :: xs).sum ^ ((x :: xs).length + 1) = 0 := by
  let s := xs.sum
  have hsx : s * x = 0 := by
    dsimp [s]
    exact list_sum_mul_eq_zero_of_forall xs x hcross
  have hpowx : ∀ n : ℕ, 0 < n → s ^ n * x = 0 := by
    intro n hn
    cases n with
    | zero => exact False.elim (Nat.lt_irrefl 0 hn)
    | succ n =>
        calc
          s ^ (n + 1) * x = s ^ n * (s * x) := by
            rw [pow_succ, mul_assoc]
          _ = 0 := by rw [hsx]; simp
  have hbinom := squareZero_sum_binomial_step hxx hpowx
  calc
    (x :: xs).sum ^ ((x :: xs).length + 1) =
        (x + s) ^ ((xs.length + 1) + 1) := by simp [s]
    _ = x * s ^ (xs.length + 1) + s ^ ((xs.length + 1) + 1) :=
        hbinom (xs.length + 1)
    _ = 0 := by
      rw [pow_succ s (xs.length + 1), htailPow]
      simp

theorem directedSquareZeroSteps_sum_pow_succ_eq_zero
    (xs : List B) (hxs : directedSquareZeroSteps xs) :
    xs.sum ^ (xs.length + 1) = 0 := by
  induction xs with
  | nil => simp
  | cons x xs ih =>
      rcases hxs with ⟨hxx, hcross, htail⟩
      exact directedSquareZero_cons_sum_pow_succ_eq_zero x xs hxx hcross (ih htail)

/-- The ordered product of the elementary unipotent factors is exactly the
finite geometric sum `1 + A + ⋯ + A^length` of the total path operator.
This upgrades the inverse statement to the term-by-term path-propagator law. -/
theorem directedStepForwardProduct_eq_geometric_sum
    (xs : List B) (hxs : directedSquareZeroSteps xs) :
    directedStepForwardProduct xs =
      ∑ k ∈ Finset.range (xs.length + 1), xs.sum ^ k := by
  let G : B := ∑ k ∈ Finset.range (xs.length + 1), xs.sum ^ k
  have hnil : xs.sum ^ (xs.length + 1) = 0 :=
    directedSquareZeroSteps_sum_pow_succ_eq_zero xs hxs
  have hleft : (1 - xs.sum) * directedStepForwardProduct xs = 1 :=
    (directedStepForwardProduct_is_geometric_resolvent xs hxs).1
  have hright : G * (1 - xs.sum) = 1 := by
    dsimp [G]
    rw [geom_sum_mul_neg, hnil]
    simp
  calc
    directedStepForwardProduct xs = (G * (1 - xs.sum)) *
        directedStepForwardProduct xs := by rw [hright]; simp
    _ = G * ((1 - xs.sum) * directedStepForwardProduct xs) := by
        noncomm_ring
    _ = G := by rw [hleft]; simp

/-- On a cyclic shell whose return operator is idempotent, the sixth-power
defect is precisely the idempotency defect of that return operator. -/
theorem cycle_return_idempotency_defect {Ω V₃ : B}
    (hcycle : Ω * Ω * Ω = V₃) :
    idempotencyDefect (Ω * Ω * Ω) = idempotencyDefect V₃ := by
  rw [hcycle]

theorem idemLe_refl {P : B} (hP : P * P = P) : idemLe P P := ⟨hP, hP⟩

theorem idemLe_antisymm {P Q : B} (hPQ : idemLe P Q) (hQP : idemLe Q P) : P = Q := by
  calc
    P = P * Q := hPQ.1.symm
    _ = Q := hQP.2

theorem idemLe_trans {P Q R : B} (hPQ : idemLe P Q) (hQR : idemLe Q R) : idemLe P R := by
  constructor
  · calc
      P * R = (P * Q) * R := by rw [hPQ.1]
      _ = P * (Q * R) := mul_assoc P Q R
      _ = P * Q := by rw [hQR.1]
      _ = P := hPQ.1
  · calc
      R * P = R * (Q * P) := by rw [hPQ.2]
      _ = (R * Q) * P := (mul_assoc R Q P).symm
      _ = Q * P := by rw [hQR.2]
      _ = P := hPQ.2

/-- The relative complement in a two-sided idempotent inclusion is an
orthogonal idempotent, and the larger idempotent is their sum. -/
theorem relative_complement {P Q : B} (hP : P * P = P) (hQ : Q * Q = Q)
    (hPQ : idemLe P Q) :
    (Q - P) * (Q - P) = Q - P ∧ P * (Q - P) = 0 ∧
      (Q - P) * P = 0 ∧ P + (Q - P) = Q := by
  rcases hPQ with ⟨hPQ, hQP⟩
  constructor
  · calc
      (Q - P) * (Q - P) = Q * Q - Q * P - P * Q + P * P := by noncomm_ring
      _ = Q - P := by rw [hQ, hQP, hPQ, hP]; noncomm_ring
  constructor
  · calc
      P * (Q - P) = P * Q - P * P := by noncomm_ring
      _ = 0 := by rw [hPQ, hP]; exact sub_self P
  constructor
  · calc
      (Q - P) * P = Q * P - P * P := by noncomm_ring
      _ = 0 := by rw [hQP, hP]; exact sub_self P
  · noncomm_ring

/-- A three-block orthogonal partition arising from a nested pair
`P₁ ≤ P₂ ≤ 1`. -/
def shell1 (P₁ : B) : B := P₁
def shell2 (P₁ P₂ : B) : B := P₂ - P₁
def shell3 (P₂ : B) : B := 1 - P₂
def shell3Between (P₂ P₃ : B) : B := P₃ - P₂
def shell4 (P₃ : B) : B := 1 - P₃

theorem three_shell_partition {P₁ P₂ : B} (h1 : P₁ * P₁ = P₁)
    (h2 : P₂ * P₂ = P₂) (h12 : idemLe P₁ P₂) :
    shell1 P₁ + shell2 P₁ P₂ + shell3 P₂ = 1 ∧
    shell1 P₁ * shell1 P₁ = shell1 P₁ ∧
    shell2 P₁ P₂ * shell2 P₁ P₂ = shell2 P₁ P₂ ∧
    shell3 P₂ * shell3 P₂ = shell3 P₂ ∧
    shell1 P₁ * shell2 P₁ P₂ = 0 ∧ shell2 P₁ P₂ * shell1 P₁ = 0 ∧
    shell1 P₁ * shell3 P₂ = 0 ∧ shell3 P₂ * shell1 P₁ = 0 ∧
    shell2 P₁ P₂ * shell3 P₂ = 0 ∧ shell3 P₂ * shell2 P₁ P₂ = 0 := by
  rcases h12 with ⟨h12, h21⟩
  dsimp [shell1, shell2, shell3]
  constructor
  · noncomm_ring
  constructor
  · exact h1
  constructor
  · exact (relative_complement h1 h2 ⟨h12, h21⟩).1
  constructor
  · noncomm_ring [h2]
  constructor
  · exact (relative_complement h1 h2 ⟨h12, h21⟩).2.1
  constructor
  · exact (relative_complement h1 h2 ⟨h12, h21⟩).2.2.1
  constructor
  · noncomm_ring [h1, h2, h12, h21]
  constructor
  · noncomm_ring [h1, h2, h12, h21]
  constructor
  · noncomm_ring [h1, h2, h12, h21]
  · noncomm_ring [h1, h2, h12, h21]

/-- The four orthogonal atoms cut out by a three-step nested idempotent flag
`P₁ ≤ P₂ ≤ P₃`. `shell3Between` names the interval `(P₂,P₃]`, while
`shell4` is the complement of `P₃`. -/
theorem four_step_shell_partition {P₁ P₂ P₃ : B}
    (h1 : P₁ * P₁ = P₁) (h2 : P₂ * P₂ = P₂) (h3 : P₃ * P₃ = P₃)
    (h12 : idemLe P₁ P₂) (h23 : idemLe P₂ P₃) :
    shell1 P₁ + shell2 P₁ P₂ + shell3Between P₂ P₃ + shell4 P₃ = 1 ∧
    shell1 P₁ * shell1 P₁ = shell1 P₁ ∧
    shell2 P₁ P₂ * shell2 P₁ P₂ = shell2 P₁ P₂ ∧
    shell3Between P₂ P₃ * shell3Between P₂ P₃ = shell3Between P₂ P₃ ∧
    shell4 P₃ * shell4 P₃ = shell4 P₃ ∧
    shell1 P₁ * shell2 P₁ P₂ = 0 ∧ shell2 P₁ P₂ * shell1 P₁ = 0 ∧
    shell1 P₁ * shell3Between P₂ P₃ = 0 ∧ shell3Between P₂ P₃ * shell1 P₁ = 0 ∧
    shell1 P₁ * shell4 P₃ = 0 ∧ shell4 P₃ * shell1 P₁ = 0 ∧
    shell2 P₁ P₂ * shell3Between P₂ P₃ = 0 ∧ shell3Between P₂ P₃ * shell2 P₁ P₂ = 0 ∧
    shell2 P₁ P₂ * shell4 P₃ = 0 ∧ shell4 P₃ * shell2 P₁ P₂ = 0 ∧
    shell3Between P₂ P₃ * shell4 P₃ = 0 ∧ shell4 P₃ * shell3Between P₂ P₃ = 0 := by
  rcases h12 with ⟨h12, h21⟩
  rcases h23 with ⟨h23, h32⟩
  have h13 : idemLe P₁ P₃ := idemLe_trans ⟨h12, h21⟩ ⟨h23, h32⟩
  rcases h13 with ⟨h13, h31⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    simp only [shell1, shell2, shell3Between, shell4] <;>
    noncomm_ring [h1, h2, h3, h12, h21, h23, h32, h13, h31]

def root12 (E1 E2 A : B) : B := E1 * A * E2
def root21 (E2 E1 C : B) : B := E2 * C * E1
def root23 (E2 E3 C : B) : B := E2 * C * E3
def root32 (E3 E2 D : B) : B := E3 * D * E2
def root31 (E3 E1 D : B) : B := E3 * D * E1
def root34 (E3 E4 D : B) : B := E3 * D * E4
def root13 (E1 E3 X : B) : B := E1 * X * E3

/-- Forward and reverse operators on the first Zorn link. -/
def majoranaPhi12 (E1 E2 A C : B) : B := root12 E1 E2 A + root21 E2 E1 C
def majoranaJ12 (E1 E2 A C : B) : B := root12 E1 E2 A - root21 E2 E1 C
def linkMetric12 (E1 E2 A C : B) : B :=
  root12 E1 E2 A * root21 E2 E1 C + root21 E2 E1 C * root12 E1 E2 A
def linkSpin12 (E1 E2 A C : B) : B :=
  root12 E1 E2 A * root21 E2 E1 C - root21 E2 E1 C * root12 E1 E2 A

/-- Forward and reverse operators on the second Zorn link. -/
def majoranaPhi23 (E2 E3 A C : B) : B := root23 E2 E3 A + root32 E3 E2 C
def majoranaJ23 (E2 E3 A C : B) : B := root23 E2 E3 A - root32 E3 E2 C
def linkMetric23 (E2 E3 A C : B) : B :=
  root23 E2 E3 A * root32 E3 E2 C + root32 E3 E2 C * root23 E2 E3 A
def linkSpin23 (E2 E3 A C : B) : B :=
  root23 E2 E3 A * root32 E3 E2 C - root32 E3 E2 C * root23 E2 E3 A

/-- If left multiplication by `s` fixes `x` and negates `y`, it exchanges
the symmetric and skew products of the ordered pair `(x,y)`. -/
theorem left_parity_swaps_product_sum_difference {s x y : B}
    (hsx : s * x = x) (hsy : s * y = -y) :
    s * (x * y + y * x) = x * y - y * x ∧
    s * (x * y - y * x) = x * y + y * x := by
  constructor
  · calc
      s * (x * y + y * x) = (s * x) * y + (s * y) * x := by noncomm_ring
      _ = x * y - y * x := by rw [hsx, hsy]; noncomm_ring
  · calc
      s * (x * y - y * x) = (s * x) * y - (s * y) * x := by noncomm_ring
      _ = x * y + y * x := by rw [hsx, hsy]; noncomm_ring

/-- The two Zorn link-spin inner derivations commute only when their
commutator acts trivially. Their exact curvature correction is the inner
derivation generated by the commutator of the link spins. -/
theorem zorn_link_spin_derivation_curvature
    {E1 E2 E3 A Bc C D X : B} :
    ringComm (linkSpin12 E1 E2 A Bc + linkSpin23 E2 E3 C D)
        (ringComm (linkSpin12 E1 E2 A Bc - linkSpin23 E2 E3 C D) X) -
      ringComm (linkSpin12 E1 E2 A Bc - linkSpin23 E2 E3 C D)
        (ringComm (linkSpin12 E1 E2 A Bc + linkSpin23 E2 E3 C D) X) =
      -((2 : ℤ) • ringComm
        (ringComm (linkSpin12 E1 E2 A Bc) (linkSpin23 E2 E3 C D)) X) := by
  exact sum_difference_inner_derivation_curvature
    (linkSpin12 E1 E2 A Bc) (linkSpin23 E2 E3 C D) X

/-- The two directed length-two paths and their symmetric/skew edge defects. -/
def edgeRoot13 (E1 E2 E3 A C : B) : B := root12 E1 E2 A * root23 E2 E3 C
def edgeRoot31 (E1 E2 E3 Bc D : B) : B := root32 E3 E2 D * root21 E2 E1 Bc
def edgeMajoranaPhi13 (E1 E2 E3 A Bc C D : B) : B :=
  edgeRoot13 E1 E2 E3 A C + edgeRoot31 E1 E2 E3 Bc D
def edgeMajoranaJ13 (E1 E2 E3 A Bc C D : B) : B :=
  edgeRoot13 E1 E2 E3 A C - edgeRoot31 E1 E2 E3 Bc D

def edgeMetric13 (E1 E2 E3 A Bc C D : B) : B :=
  edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D +
  edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C

def edgeSpin13 (E1 E2 E3 A Bc C D : B) : B :=
  edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D -
  edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C

/-- The endpoint arrows of a two-link Zorn path are square-zero. Their
sum/difference therefore carries the same exact split-signature tetraktys
as a primitive link, now supported on the two endpoint corners. -/
theorem zorn_edge_majorana_tetraktys
    {E1 E2 E3 A Bc C D : B}
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0) :
    edgeRoot13 E1 E2 E3 A C * edgeRoot13 E1 E2 E3 A C = 0 /\
    edgeRoot31 E1 E2 E3 Bc D * edgeRoot31 E1 E2 E3 Bc D = 0 /\
    edgeMajoranaPhi13 E1 E2 E3 A Bc C D *
        edgeMajoranaPhi13 E1 E2 E3 A Bc C D =
      edgeMetric13 E1 E2 E3 A Bc C D /\
    edgeMajoranaJ13 E1 E2 E3 A Bc C D *
        edgeMajoranaJ13 E1 E2 E3 A Bc C D =
      -edgeMetric13 E1 E2 E3 A Bc C D /\
    edgeMajoranaPhi13 E1 E2 E3 A Bc C D *
        edgeMajoranaJ13 E1 E2 E3 A Bc C D +
      edgeMajoranaJ13 E1 E2 E3 A Bc C D *
        edgeMajoranaPhi13 E1 E2 E3 A Bc C D = 0 /\
    edgeMajoranaJ13 E1 E2 E3 A Bc C D *
        edgeMajoranaPhi13 E1 E2 E3 A Bc C D =
      edgeSpin13 E1 E2 E3 A Bc C D /\
    edgeMajoranaPhi13 E1 E2 E3 A Bc C D *
        edgeMajoranaJ13 E1 E2 E3 A Bc C D =
      -edgeSpin13 E1 E2 E3 A Bc C D := by
  have h13sq : edgeRoot13 E1 E2 E3 A C * edgeRoot13 E1 E2 E3 A C = 0 := by
    unfold edgeRoot13 root12 root23
    calc
      (E1 * A * E2 * (E2 * C * E3)) *
          (E1 * A * E2 * (E2 * C * E3)) =
        E1 * A * E2 * E2 * C * (E3 * E1) * A * E2 * E2 * C * E3 := by
          simp only [mul_assoc]
      _ = 0 := by rw [h31]; noncomm_ring
  have h31sq : edgeRoot31 E1 E2 E3 Bc D * edgeRoot31 E1 E2 E3 Bc D = 0 := by
    unfold edgeRoot31 root32 root21
    calc
      (E3 * D * E2 * (E2 * Bc * E1)) *
          (E3 * D * E2 * (E2 * Bc * E1)) =
        E3 * D * E2 * E2 * Bc * (E1 * E3) * D * E2 * E2 * Bc * E1 := by
          simp only [mul_assoc]
      _ = 0 := by rw [h13]; noncomm_ring
  refine ⟨h13sq, h31sq, ?_, ?_, ?_, ?_, ?_⟩
  · change (edgeRoot13 E1 E2 E3 A C + edgeRoot31 E1 E2 E3 Bc D) *
      (edgeRoot13 E1 E2 E3 A C + edgeRoot31 E1 E2 E3 Bc D) =
      edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D +
        edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C
    noncomm_ring [h13sq, h31sq]
  · change (edgeRoot13 E1 E2 E3 A C - edgeRoot31 E1 E2 E3 Bc D) *
      (edgeRoot13 E1 E2 E3 A C - edgeRoot31 E1 E2 E3 Bc D) =
      -(edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D +
        edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C)
    noncomm_ring [h13sq, h31sq]
  · change (edgeRoot13 E1 E2 E3 A C + edgeRoot31 E1 E2 E3 Bc D) *
      (edgeRoot13 E1 E2 E3 A C - edgeRoot31 E1 E2 E3 Bc D) +
      (edgeRoot13 E1 E2 E3 A C - edgeRoot31 E1 E2 E3 Bc D) *
        (edgeRoot13 E1 E2 E3 A C + edgeRoot31 E1 E2 E3 Bc D) = 0
    noncomm_ring [h13sq, h31sq]
  · change (edgeRoot13 E1 E2 E3 A C - edgeRoot31 E1 E2 E3 Bc D) *
      (edgeRoot13 E1 E2 E3 A C + edgeRoot31 E1 E2 E3 Bc D) =
      edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D -
        edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C
    noncomm_ring [h13sq, h31sq]
  · change (edgeRoot13 E1 E2 E3 A C + edgeRoot31 E1 E2 E3 Bc D) *
      (edgeRoot13 E1 E2 E3 A C - edgeRoot31 E1 E2 E3 Bc D) =
      -(edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D -
        edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C)
    noncomm_ring [h13sq, h31sq]

/-- Endpoint Majorana tetraktys for the two boundary shells of an actual
nested idempotent flag. The long-root pair is square-zero, while its sum and
difference satisfy the exact split-signature multiplication laws. -/
theorem nested_zorn_edge_majorana_tetraktys
    {P₁ P₂ A Bc C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    edgeRoot13 E₁ E₂ E₃ A C * edgeRoot13 E₁ E₂ E₃ A C = 0 ∧
    edgeRoot31 E₁ E₂ E₃ Bc D * edgeRoot31 E₁ E₂ E₃ Bc D = 0 ∧
    edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D *
        edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D = edgeMetric13 E₁ E₂ E₃ A Bc C D ∧
    edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D *
        edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D = -edgeMetric13 E₁ E₂ E₃ A Bc C D ∧
    edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D * edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D +
        edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D * edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D = 0 ∧
    edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D * edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D =
      edgeSpin13 E₁ E₂ E₃ A Bc C D ∧
    edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D * edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D =
      -edgeSpin13 E₁ E₂ E₃ A Bc C D := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, _, _, h13, h31, _, _⟩
  exact zorn_edge_majorana_tetraktys h13 h31

/-- The finite two-link Majorana sums retain their nonzero edge defect. -/
def kitaevPhi23 (E1 E2 E3 A Bc C D : B) : B :=
  majoranaPhi12 E1 E2 A Bc + majoranaPhi23 E2 E3 C D
def kitaevJ23 (E1 E2 E3 A Bc C D : B) : B :=
  majoranaJ12 E1 E2 A Bc + majoranaJ23 E2 E3 C D

/-- Alternating parity of the three Peirce shells. -/
def zornPlabicParity (E1 E2 E3 : B) : B := E1 - E2 + E3

/-- A corner operator is fixed under the commutator with a parity element
that fixes its left and right support corners. -/
theorem parity_commutes_with_corner {s e f x : B}
    (hse : s * e = e) (hfs : f * s = f) :
    ringComm s (e * x * f) = 0 := by
  unfold ringComm
  calc
    s * (e * x * f) - (e * x * f) * s =
        (s * e) * x * f - e * x * (f * s) := by noncomm_ring
    _ = e * x * f - e * x * f := by rw [hse, hfs]
    _ = 0 := sub_self _

theorem zorn_plabic_parity_link_and_edge_action
    {E1 E2 E3 A Bc C D : B}
    (h1 : E1 * E1 = E1) (h2 : E2 * E2 = E2) (h3 : E3 * E3 = E3)
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0)
    (hsum : E1 + E2 + E3 = 1) :
    zornPlabicParity E1 E2 E3 * zornPlabicParity E1 E2 E3 = 1 ∧
    zornPlabicParity E1 E2 E3 * majoranaPhi12 E1 E2 A Bc =
      majoranaJ12 E1 E2 A Bc ∧
    zornPlabicParity E1 E2 E3 * majoranaPhi23 E2 E3 C D =
      -majoranaJ23 E2 E3 C D ∧
    zornPlabicParity E1 E2 E3 * edgeMajoranaPhi13 E1 E2 E3 A Bc C D =
      edgeMajoranaPhi13 E1 E2 E3 A Bc C D ∧
    zornPlabicParity E1 E2 E3 * edgeMajoranaJ13 E1 E2 E3 A Bc C D =
      edgeMajoranaJ13 E1 E2 E3 A Bc C D := by
  have hSE1 : zornPlabicParity E1 E2 E3 * E1 = E1 := by
    simp only [zornPlabicParity, sub_mul, add_mul, h1, h21, h31]
    abel
  have hSE2 : zornPlabicParity E1 E2 E3 * E2 = -E2 := by
    simp only [zornPlabicParity, sub_mul, add_mul, h2, h12, h32]
    abel
  have hSE3 : zornPlabicParity E1 E2 E3 * E3 = E3 := by
    simp only [zornPlabicParity, sub_mul, add_mul, h3, h13, h23]
    abel
  have hSr12 : zornPlabicParity E1 E2 E3 * root12 E1 E2 A = root12 E1 E2 A := by
    unfold root12
    calc
      zornPlabicParity E1 E2 E3 * (E1 * A * E2) =
          (zornPlabicParity E1 E2 E3 * E1) * A * E2 := by noncomm_ring
      _ = E1 * A * E2 := by rw [hSE1]
  have hSr21 : zornPlabicParity E1 E2 E3 * root21 E2 E1 Bc =
      -root21 E2 E1 Bc := by
    unfold root21
    calc
      zornPlabicParity E1 E2 E3 * (E2 * Bc * E1) =
          (zornPlabicParity E1 E2 E3 * E2) * Bc * E1 := by noncomm_ring
      _ = -(E2 * Bc * E1) := by rw [hSE2]; noncomm_ring
  have hSr23 : zornPlabicParity E1 E2 E3 * root23 E2 E3 C =
      -root23 E2 E3 C := by
    unfold root23
    calc
      zornPlabicParity E1 E2 E3 * (E2 * C * E3) =
          (zornPlabicParity E1 E2 E3 * E2) * C * E3 := by noncomm_ring
      _ = -(E2 * C * E3) := by rw [hSE2]; noncomm_ring
  have hSr32 : zornPlabicParity E1 E2 E3 * root32 E3 E2 D = root32 E3 E2 D := by
    unfold root32
    calc
      zornPlabicParity E1 E2 E3 * (E3 * D * E2) =
          (zornPlabicParity E1 E2 E3 * E3) * D * E2 := by noncomm_ring
      _ = E3 * D * E2 := by rw [hSE3]
  have hSEdge13 : zornPlabicParity E1 E2 E3 * edgeRoot13 E1 E2 E3 A C =
      edgeRoot13 E1 E2 E3 A C := by
    unfold edgeRoot13
    calc
      zornPlabicParity E1 E2 E3 * (root12 E1 E2 A * root23 E2 E3 C) =
          (zornPlabicParity E1 E2 E3 * root12 E1 E2 A) * root23 E2 E3 C := by noncomm_ring
      _ = root12 E1 E2 A * root23 E2 E3 C := by rw [hSr12]
  have hSEdge31 : zornPlabicParity E1 E2 E3 * edgeRoot31 E1 E2 E3 Bc D =
      edgeRoot31 E1 E2 E3 Bc D := by
    unfold edgeRoot31
    calc
      zornPlabicParity E1 E2 E3 * (root32 E3 E2 D * root21 E2 E1 Bc) =
          (zornPlabicParity E1 E2 E3 * root32 E3 E2 D) * root21 E2 E1 Bc := by noncomm_ring
      _ = root32 E3 E2 D * root21 E2 E1 Bc := by rw [hSr32]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · unfold zornPlabicParity
    rw [← hsum]
    noncomm_ring [h1, h2, h3, h12, h21, h13, h31, h23, h32]
  · unfold majoranaPhi12 majoranaJ12
    rw [mul_add, hSr12, hSr21]
    noncomm_ring
  · unfold majoranaPhi23 majoranaJ23
    rw [mul_add, hSr23, hSr32]
    noncomm_ring
  · unfold edgeMajoranaPhi13
    rw [mul_add, hSEdge13, hSEdge31]
  · unfold edgeMajoranaJ13
    rw [mul_sub, hSEdge13, hSEdge31]

/-- The parity involution also exchanges the two Majorana coordinates on
each link. This complementary left-action statement follows from the
already-proved action on `Φ` together with `S² = 1`; the second link carries
the orientation sign. -/
theorem zorn_plabic_parity_j_link_action
    {E1 E2 E3 A Bc C D : B}
    (h1 : E1 * E1 = E1) (h2 : E2 * E2 = E2) (h3 : E3 * E3 = E3)
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0)
    (hsum : E1 + E2 + E3 = 1) :
    zornPlabicParity E1 E2 E3 * majoranaJ12 E1 E2 A Bc =
      majoranaPhi12 E1 E2 A Bc ∧
    zornPlabicParity E1 E2 E3 * majoranaJ23 E2 E3 C D =
      -majoranaPhi23 E2 E3 C D := by
  rcases zorn_plabic_parity_link_and_edge_action
      h1 h2 h3 h12 h21 h13 h31 h23 h32 hsum with
    ⟨hS2, hPhi12, hPhi23, _, _⟩
  constructor
  · calc
      zornPlabicParity E1 E2 E3 * majoranaJ12 E1 E2 A Bc =
          zornPlabicParity E1 E2 E3 *
            (zornPlabicParity E1 E2 E3 * majoranaPhi12 E1 E2 A Bc) := by
              rw [hPhi12]
      _ = majoranaPhi12 E1 E2 A Bc := by
        rw [← mul_assoc, hS2]
        noncomm_ring
  · calc
      zornPlabicParity E1 E2 E3 * majoranaJ23 E2 E3 C D =
          -(zornPlabicParity E1 E2 E3 *
            (zornPlabicParity E1 E2 E3 * majoranaPhi23 E2 E3 C D)) := by
              rw [hPhi23]
              noncomm_ring
      _ = -majoranaPhi23 E2 E3 C D := by
        rw [← mul_assoc, hS2]
        noncomm_ring

/-- The alternating shell parity exchanges the symmetric link metric with
the oriented link spin. The second link has the opposite orientation sign. -/
theorem zorn_plabic_parity_metric_spin_duality
    {E1 E2 E3 A Bc C D : B}
    (h1 : E1 * E1 = E1) (h2 : E2 * E2 = E2) (h3 : E3 * E3 = E3)
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    zornPlabicParity E1 E2 E3 * linkMetric12 E1 E2 A Bc =
      linkSpin12 E1 E2 A Bc ∧
    zornPlabicParity E1 E2 E3 * linkSpin12 E1 E2 A Bc =
      linkMetric12 E1 E2 A Bc ∧
    zornPlabicParity E1 E2 E3 * linkMetric23 E2 E3 C D =
      -linkSpin23 E2 E3 C D ∧
    zornPlabicParity E1 E2 E3 * linkSpin23 E2 E3 C D =
      -linkMetric23 E2 E3 C D ∧
    zornPlabicParity E1 E2 E3 *
        (linkMetric12 E1 E2 A Bc + linkMetric23 E2 E3 C D) =
      linkSpin12 E1 E2 A Bc - linkSpin23 E2 E3 C D ∧
    zornPlabicParity E1 E2 E3 *
        (linkSpin12 E1 E2 A Bc + linkSpin23 E2 E3 C D) =
      linkMetric12 E1 E2 A Bc - linkMetric23 E2 E3 C D := by
  let S := zornPlabicParity E1 E2 E3
  have hS1 : S * E1 = E1 := by
    dsimp [S, zornPlabicParity]
    noncomm_ring [h1, h21, h31]
  have hS2 : S * E2 = -E2 := by
    dsimp [S, zornPlabicParity]
    noncomm_ring [h2, h12, h32]
  have hS3 : S * E3 = E3 := by
    dsimp [S, zornPlabicParity]
    noncomm_ring [h3, h13, h23]
  have hx12 : S * root12 E1 E2 A = root12 E1 E2 A := by
    unfold root12
    calc
      S * (E1 * A * E2) = (S * E1) * A * E2 := by noncomm_ring
      _ = E1 * A * E2 := by rw [hS1]
  have hy12 : S * root21 E2 E1 Bc = -root21 E2 E1 Bc := by
    unfold root21
    calc
      S * (E2 * Bc * E1) = (S * E2) * Bc * E1 := by noncomm_ring
      _ = -(E2 * Bc * E1) := by rw [hS2]; noncomm_ring
  have hx23 : S * root23 E2 E3 C = -root23 E2 E3 C := by
    unfold root23
    calc
      S * (E2 * C * E3) = (S * E2) * C * E3 := by noncomm_ring
      _ = -(E2 * C * E3) := by rw [hS2]; noncomm_ring
  have hy23 : S * root32 E3 E2 D = root32 E3 E2 D := by
    unfold root32
    calc
      S * (E3 * D * E2) = (S * E3) * D * E2 := by noncomm_ring
      _ = E3 * D * E2 := by rw [hS3]
  have h12swap := left_parity_swaps_product_sum_difference hx12 hy12
  have h23swap := left_parity_swaps_product_sum_difference hy23 hx23
  have h12metric : S * linkMetric12 E1 E2 A Bc =
      linkSpin12 E1 E2 A Bc := by
    simpa [linkMetric12, linkSpin12] using h12swap.1
  have h12spin : S * linkSpin12 E1 E2 A Bc =
      linkMetric12 E1 E2 A Bc := by
    simpa [linkMetric12, linkSpin12] using h12swap.2
  have h23metric : S * linkMetric23 E2 E3 C D =
      -linkSpin23 E2 E3 C D := by
    dsimp [linkMetric23, linkSpin23]
    calc
      S * (root23 E2 E3 C * root32 E3 E2 D +
          root32 E3 E2 D * root23 E2 E3 C) =
        root32 E3 E2 D * root23 E2 E3 C -
          root23 E2 E3 C * root32 E3 E2 D := by
            simpa [add_comm, sub_eq_add_neg] using h23swap.1
      _ = -(root23 E2 E3 C * root32 E3 E2 D -
          root32 E3 E2 D * root23 E2 E3 C) := by abel
  have h23spin : S * linkSpin23 E2 E3 C D =
      -linkMetric23 E2 E3 C D := by
    dsimp [linkSpin23, linkMetric23]
    calc
      S * (root23 E2 E3 C * root32 E3 E2 D -
          root32 E3 E2 D * root23 E2 E3 C) =
        -(S * (root32 E3 E2 D * root23 E2 E3 C -
          root23 E2 E3 C * root32 E3 E2 D)) := by noncomm_ring
      _ = -(linkMetric23 E2 E3 C D) := by
        rw [h23swap.2]
        dsimp [linkMetric23]
        abel
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact h12metric
  · exact h12spin
  · exact h23metric
  · exact h23spin
  · rw [mul_add, h12metric, h23metric]
    abel
  · rw [mul_add, h12spin, h23spin]
    abel

/-- Parity/metric-spin duality specialized to the three shells of a nested
idempotent pair. -/
theorem nested_zorn_plabic_parity_metric_spin_duality
    {P₁ P₂ A Bc C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    let S := zornPlabicParity E₁ E₂ E₃
    S * linkMetric12 E₁ E₂ A Bc = linkSpin12 E₁ E₂ A Bc ∧
    S * linkSpin12 E₁ E₂ A Bc = linkMetric12 E₁ E₂ A Bc ∧
    S * linkMetric23 E₂ E₃ C D = -linkSpin23 E₂ E₃ C D ∧
    S * linkSpin23 E₂ E₃ C D = -linkMetric23 E₂ E₃ C D ∧
    S * (linkMetric12 E₁ E₂ A Bc + linkMetric23 E₂ E₃ C D) =
      linkSpin12 E₁ E₂ A Bc - linkSpin23 E₂ E₃ C D ∧
    S * (linkSpin12 E₁ E₂ A Bc + linkSpin23 E₂ E₃ C D) =
      linkMetric12 E₁ E₂ A Bc - linkMetric23 E₂ E₃ C D := by
  intro E₁ E₂ E₃ S
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨hsum, hE₁, hE₂, hE₃, h12, h21, h13, h31, h23, h32⟩
  exact zorn_plabic_parity_metric_spin_duality
    hE₁ hE₂ hE₃ h12 h21 h13 h31 h23 h32

/-- The parity action above is a genuine grading: every one-hop Majorana
operator anticommutes with the alternating shell parity, while both
two-hop boundary modes commute with it. -/
theorem zorn_plabic_parity_grading
    {E1 E2 E3 A Bc C D : B}
    (h1 : E1 * E1 = E1) (h2 : E2 * E2 = E2) (h3 : E3 * E3 = E3)
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    (zornPlabicParity E1 E2 E3) * majoranaPhi12 E1 E2 A Bc +
        majoranaPhi12 E1 E2 A Bc * zornPlabicParity E1 E2 E3 = 0 ∧
    (zornPlabicParity E1 E2 E3) * majoranaJ12 E1 E2 A Bc +
        majoranaJ12 E1 E2 A Bc * zornPlabicParity E1 E2 E3 = 0 ∧
    (zornPlabicParity E1 E2 E3) * majoranaPhi23 E2 E3 C D +
        majoranaPhi23 E2 E3 C D * zornPlabicParity E1 E2 E3 = 0 ∧
    (zornPlabicParity E1 E2 E3) * majoranaJ23 E2 E3 C D +
        majoranaJ23 E2 E3 C D * zornPlabicParity E1 E2 E3 = 0 ∧
    ringComm (zornPlabicParity E1 E2 E3)
        (edgeMajoranaPhi13 E1 E2 E3 A Bc C D) = 0 ∧
    ringComm (zornPlabicParity E1 E2 E3)
        (edgeMajoranaJ13 E1 E2 E3 A Bc C D) = 0 := by
  let S := zornPlabicParity E1 E2 E3
  have hS1L : S * E1 = E1 := by
    dsimp [S, zornPlabicParity]
    noncomm_ring [h1, h21, h31]
  have hS2L : S * E2 = -E2 := by
    dsimp [S, zornPlabicParity]
    noncomm_ring [h2, h12, h32]
  have hS3L : S * E3 = E3 := by
    dsimp [S, zornPlabicParity]
    noncomm_ring [h3, h13, h23]
  have hS1R : E1 * S = E1 := by
    dsimp [S, zornPlabicParity]
    noncomm_ring [h1, h12, h13]
  have hS2R : E2 * S = -E2 := by
    dsimp [S, zornPlabicParity]
    noncomm_ring [h2, h21, h23]
  have hS3R : E3 * S = E3 := by
    dsimp [S, zornPlabicParity]
    noncomm_ring [h3, h31, h32]
  have h12L : S * root12 E1 E2 A = root12 E1 E2 A := by
    unfold root12
    calc S * (E1 * A * E2) = (S * E1) * A * E2 := by noncomm_ring
      _ = E1 * A * E2 := by rw [hS1L]
  have h21L : S * root21 E2 E1 Bc = -root21 E2 E1 Bc := by
    unfold root21
    calc S * (E2 * Bc * E1) = (S * E2) * Bc * E1 := by noncomm_ring
      _ = -(E2 * Bc * E1) := by rw [hS2L]; noncomm_ring
  have h23L : S * root23 E2 E3 C = -root23 E2 E3 C := by
    unfold root23
    calc S * (E2 * C * E3) = (S * E2) * C * E3 := by noncomm_ring
      _ = -(E2 * C * E3) := by rw [hS2L]; noncomm_ring
  have h32L : S * root32 E3 E2 D = root32 E3 E2 D := by
    unfold root32
    calc S * (E3 * D * E2) = (S * E3) * D * E2 := by noncomm_ring
      _ = E3 * D * E2 := by rw [hS3L]
  have h12R : root12 E1 E2 A * S = -root12 E1 E2 A := by
    unfold root12
    calc (E1 * A * E2) * S = E1 * A * (E2 * S) := by noncomm_ring
      _ = -(E1 * A * E2) := by rw [hS2R]; noncomm_ring
  have h21R : root21 E2 E1 Bc * S = root21 E2 E1 Bc := by
    unfold root21
    calc (E2 * Bc * E1) * S = E2 * Bc * (E1 * S) := by noncomm_ring
      _ = E2 * Bc * E1 := by rw [hS1R]
  have h23R : root23 E2 E3 C * S = root23 E2 E3 C := by
    unfold root23
    calc (E2 * C * E3) * S = E2 * C * (E3 * S) := by noncomm_ring
      _ = E2 * C * E3 := by rw [hS3R]
  have h32R : root32 E3 E2 D * S = -root32 E3 E2 D := by
    unfold root32
    calc (E3 * D * E2) * S = E3 * D * (E2 * S) := by noncomm_ring
      _ = -(E3 * D * E2) := by rw [hS2R]; noncomm_ring
  have hEdge13L : S * edgeRoot13 E1 E2 E3 A C = edgeRoot13 E1 E2 E3 A C := by
    unfold edgeRoot13
    rw [show S * (root12 E1 E2 A * root23 E2 E3 C) =
      (S * root12 E1 E2 A) * root23 E2 E3 C by noncomm_ring, h12L]
  have hEdge13R : edgeRoot13 E1 E2 E3 A C * S = edgeRoot13 E1 E2 E3 A C := by
    unfold edgeRoot13
    rw [show (root12 E1 E2 A * root23 E2 E3 C) * S =
      root12 E1 E2 A * (root23 E2 E3 C * S) by noncomm_ring, h23R]
  have hEdge31L : S * edgeRoot31 E1 E2 E3 Bc D = edgeRoot31 E1 E2 E3 Bc D := by
    unfold edgeRoot31
    rw [show S * (root32 E3 E2 D * root21 E2 E1 Bc) =
      (S * root32 E3 E2 D) * root21 E2 E1 Bc by noncomm_ring, h32L]
  have hEdge31R : edgeRoot31 E1 E2 E3 Bc D * S = edgeRoot31 E1 E2 E3 Bc D := by
    unfold edgeRoot31
    rw [show (root32 E3 E2 D * root21 E2 E1 Bc) * S =
      root32 E3 E2 D * (root21 E2 E1 Bc * S) by noncomm_ring, h21R]
  have hComm13 : ringComm S (edgeRoot13 E1 E2 E3 A C) = 0 := by
    unfold ringComm
    rw [hEdge13L, hEdge13R]
    exact sub_self _
  have hComm31 : ringComm S (edgeRoot31 E1 E2 E3 Bc D) = 0 := by
    unfold ringComm
    rw [hEdge31L, hEdge31R]
    exact sub_self _
  have hEdgePhi : ringComm S (edgeMajoranaPhi13 E1 E2 E3 A Bc C D) = 0 := by
    unfold edgeMajoranaPhi13 ringComm
    rw [mul_add, add_mul]
    rw [hEdge13L, hEdge13R, hEdge31L, hEdge31R]
    simp
  have hEdgeJ : ringComm S (edgeMajoranaJ13 E1 E2 E3 A Bc C D) = 0 := by
    unfold edgeMajoranaJ13 ringComm
    rw [mul_sub, sub_mul]
    rw [hEdge13L, hEdge13R, hEdge31L, hEdge31R]
    simp
  have hAnti12 : S * majoranaPhi12 E1 E2 A Bc +
      majoranaPhi12 E1 E2 A Bc * S = 0 := by
    simp only [majoranaPhi12, add_mul, mul_add, h12L, h21L, h12R, h21R]
    abel
  have hAntiJ12 : S * majoranaJ12 E1 E2 A Bc +
      majoranaJ12 E1 E2 A Bc * S = 0 := by
    simp only [majoranaJ12, sub_mul, mul_sub, h12L, h21L, h12R, h21R]
    abel
  have hAnti23 : S * majoranaPhi23 E2 E3 C D +
      majoranaPhi23 E2 E3 C D * S = 0 := by
    simp only [majoranaPhi23, add_mul, mul_add, h23L, h32L, h23R, h32R]
    abel
  have hAntiJ23 : S * majoranaJ23 E2 E3 C D +
      majoranaJ23 E2 E3 C D * S = 0 := by
    simp only [majoranaJ23, sub_mul, mul_sub, h23L, h32L, h23R, h32R]
    abel
  exact ⟨hAnti12, hAntiJ12, hAnti23, hAntiJ23, hEdgePhi, hEdgeJ⟩

/-- Kasteleyn grading laws for the shells cut out by a nested idempotent
pair. This specializes the orthogonal-shell parity theorems to the actual
Zorn flag and records the oriented action on both Majorana coordinates. -/
theorem nested_zorn_plabic_parity_grading
    {P₁ P₂ A Bc C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    let S := zornPlabicParity E₁ E₂ E₃
    S * S = 1 ∧
    S * majoranaPhi12 E₁ E₂ A Bc = majoranaJ12 E₁ E₂ A Bc ∧
    S * majoranaJ12 E₁ E₂ A Bc = majoranaPhi12 E₁ E₂ A Bc ∧
    S * majoranaPhi23 E₂ E₃ C D = -majoranaJ23 E₂ E₃ C D ∧
    S * majoranaJ23 E₂ E₃ C D = -majoranaPhi23 E₂ E₃ C D ∧
    ringComm S (edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D) = 0 ∧
    ringComm S (edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D) = 0 := by
  intro E₁ E₂ E₃ S
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨hsum, hE₁, hE₂, hE₃, h12, h21, h13, h31, h23, h32⟩
  have hAction := zorn_plabic_parity_link_and_edge_action
    (A := A) (Bc := Bc) (C := C) (D := D)
    hE₁ hE₂ hE₃ h12 h21 h13 h31 h23 h32 hsum
  have hJAction := zorn_plabic_parity_j_link_action
    (A := A) (Bc := Bc) (C := C) (D := D)
    hE₁ hE₂ hE₃ h12 h21 h13 h31 h23 h32 hsum
  have hGrading := zorn_plabic_parity_grading
    (A := A) (Bc := Bc) (C := C) (D := D)
    hE₁ hE₂ hE₃ h12 h21 h13 h31 h23 h32
  exact ⟨hAction.1, hAction.2.1, hJAction.1, hAction.2.2.1,
    hJAction.2, hGrading.2.2.2.2.1, hGrading.2.2.2.2.2⟩

/-- Multiplication by an interior corner observable annihilates an operator
whose left and right supports are orthogonal to the interior corner.  This is
the support statement used for boundary operators; it does not assert an
anticommutation law. -/
theorem corner_supported_operator_commutes_with_orthogonal_corner
    {e z X : B} (hez : e * z = 0) (hze : z * e = 0) :
    z * (e * X * e) = 0 ∧ (e * X * e) * z = 0 ∧
      ringComm z (e * X * e) = 0 := by
  constructor
  · calc
      z * (e * X * e) = (z * e) * X * e := by noncomm_ring
      _ = 0 := by rw [hze]; simp
  constructor
  · calc
      (e * X * e) * z = e * X * (e * z) := by noncomm_ring
      _ = 0 := by rw [hez]; simp
  · dsimp [ringComm]
    rw [show z * (e * X * e) = 0 by
      calc z * (e * X * e) = (z * e) * X * e := by noncomm_ring
           _ = 0 := by rw [hze]; simp,
      show (e * X * e) * z = 0 by
      calc (e * X * e) * z = e * X * (e * z) := by noncomm_ring
           _ = 0 := by rw [hez]; simp]
    simp

theorem directed_majorana_pair_laws {x y : B}
    (hx : x * x = 0) (hy : y * y = 0) :
    (x + y) * (x + y) = x * y + y * x ∧
    (x - y) * (x - y) = -(x * y + y * x) ∧
    (x + y) * (x - y) + (x - y) * (x + y) = 0 ∧
    (x - y) * (x + y) = x * y - y * x := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> noncomm_ring [hx, hy]

theorem directed_edge_defect_laws {x y u v : B}
    (hxx : x * x = 0) (hyy : y * y = 0)
    (huu : u * u = 0) (hvv : v * v = 0)
    (hxv : x * v = 0) (hyu : y * u = 0) (hux : u * x = 0)
    (huy : u * y = 0) (hvx : v * x = 0) (hyv : y * v = 0) :
    ((x + y) + (u + v)) * ((x + y) + (u + v)) +
      ((x - y) + (u - v)) * ((x - y) + (u - v)) =
        (2 : ℤ) • (x * u + v * y) ∧
    ((x + y) + (u + v)) * ((x - y) + (u - v)) +
      ((x - y) + (u - v)) * ((x + y) + (u + v)) =
        (2 : ℤ) • (x * u - v * y) := by
  constructor <;> noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]

/-- Exact squares for the two-link sums. The length-two paths `x*u` and
`v*y` remain as the boundary bridge in both squares; only the local metric
changes sign. -/
theorem directed_two_link_square_laws {x y u v : B}
    (hxx : x * x = 0) (hyy : y * y = 0)
    (huu : u * u = 0) (hvv : v * v = 0)
    (hxv : x * v = 0) (hyu : y * u = 0) (hux : u * x = 0)
    (huy : u * y = 0) (hvx : v * x = 0) (hyv : y * v = 0) :
    ((x + y) + (u + v)) * ((x + y) + (u + v)) =
      x * y + y * x + u * v + v * u + x * u + v * y ∧
    ((x - y) + (u - v)) * ((x - y) + (u - v)) =
      -(x * y + y * x + u * v + v * u) + x * u + v * y := by
  constructor <;> noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]

/-- Algebraic elimination of a middle corner. If `a` is the interior
idempotent, `u` is a square-zero incoming sum with `u*a = u`, and `v` is a
square-zero outgoing sum with `a*v = v`, then the two unipotent factors remove
the linear arrows and leave the return product `u*v`:
`(1-u)(a+u+v)(1-v) = a-u*v`. -/
theorem unipotent_middle_corner_contraction {a u v : B}
    (hu : u * u = 0) (hv : v * v = 0)
    (hua : u * a = u) (hav : a * v = v) :
    (1 - u) * (a + u + v) * (1 - v) = a - u * v := by
  noncomm_ring [hu, hv, hua, hav]

/-- A square-zero element gives a two-sided inverse for its elementary
unipotent factor. -/
theorem square_zero_elementary_unipotent_inverse {x : B}
    (hx : x * x = 0) :
    (1 - x) * (1 + x) = 1 ∧ (1 + x) * (1 - x) = 1 := by
  constructor <;> noncomm_ring [hx]

/-- Multiplication of two supported corner arrows factors through the middle
corner product. This reusable rule makes orthogonality proofs independent of
the particular endpoint idempotents. -/
theorem corner_arrows_mul_zero {e f g h a b : B} (hfg : f * g = 0) :
    (e * a * f) * (g * b * h) = 0 := by
  calc
    (e * a * f) * (g * b * h) = e * a * (f * g) * b * h := by noncomm_ring
    _ = 0 := by rw [hfg]; noncomm_ring

/-- A nested pair of idempotents produces adjacent corner arrows whose
forward and reverse unipotent products give the quadratic cyclotomic
factorizations. The product of the two quadratic evaluations is
`1 + A²`; all statements retain the directed order of multiplication. -/
theorem zorn_adjacent_cyclotomic_factorization {P₁ P₂ A C : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    let N₁₂ := root12 E₁ E₂ A
    let N₂₃ := root23 E₂ E₃ C
    let Astep := N₁₂ + N₂₃
    Astep * Astep = N₁₂ * N₂₃ ∧
    Astep * Astep * Astep = 0 ∧
    Astep * Astep * Astep * Astep = 0 ∧
    (1 - N₂₃) * (1 - N₁₂) = 1 - Astep ∧
    (1 + N₂₃) * (1 + N₁₂) = 1 + Astep ∧
    (1 + N₁₂) * (1 + N₂₃) = chainCyclo3 Astep ∧
    (1 - N₁₂) * (1 - N₂₃) = chainCyclo6 Astep ∧
    chainCyclo3 Astep * chainCyclo6 Astep = 1 + Astep * Astep ∧
    (1 - Astep) * chainCyclo3 Astep = 1 ∧
    (1 + Astep) * chainCyclo6 Astep = 1 := by
  intro E₁ E₂ E₃ N₁₂ N₂₃ Astep
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, h13, h31, h23, h32⟩
  have hN12sq : N₁₂ * N₁₂ = 0 := by
    simpa [N₁₂, E₁, E₂, root12] using
      (corner_arrows_mul_zero (e := shell1 P₁) (f := shell2 P₁ P₂)
        (g := shell1 P₁) (h := shell2 P₁ P₂) (a := A) (b := A) h21)
  have hN23sq : N₂₃ * N₂₃ = 0 := by
    simpa [N₂₃, E₂, E₃, root23] using
      (corner_arrows_mul_zero (e := shell2 P₁ P₂) (f := shell3 P₂)
        (g := shell2 P₁ P₂) (h := shell3 P₂) (a := C) (b := C) h32)
  have hN23N12 : N₂₃ * N₁₂ = 0 := by
    simpa [N₁₂, N₂₃, E₁, E₂, E₃, root12, root23] using
      (corner_arrows_mul_zero (e := shell2 P₁ P₂) (f := shell3 P₂)
        (g := shell1 P₁) (h := shell2 P₁ P₂) (a := C) (b := A) h31)
  have hFactor := adjacent_square_zero_cyclotomic_factorization
    hN12sq hN23sq hN23N12
  have hA2 : Astep * Astep = N₁₂ * N₂₃ := by
    dsimp [Astep]
    noncomm_ring [hN12sq, hN23sq, hN23N12]
  have hA3 : Astep * Astep * Astep = 0 := by
    calc
      Astep * Astep * Astep = (Astep * Astep) * Astep := by noncomm_ring
      _ = (N₁₂ * N₂₃) * (N₁₂ + N₂₃) := by rw [hA2]
      _ = N₁₂ * (N₂₃ * N₁₂) + N₁₂ * (N₂₃ * N₂₃) := by noncomm_ring
      _ = 0 := by rw [hN23N12, hN23sq]; simp
  have hA4 : Astep * Astep * Astep * Astep = 0 := by
    calc
      Astep * Astep * Astep * Astep =
          (Astep * Astep) * (Astep * Astep) := by noncomm_ring
      _ = (N₁₂ * N₂₃) * (N₁₂ * N₂₃) := by rw [hA2]
      _ = N₁₂ * (N₂₃ * N₁₂) * N₂₃ := by noncomm_ring
      _ = 0 := by rw [hN23N12]; simp
  have hCycloProduct := chainCyclo3_mul_chainCyclo6_of_fourth_power_eq_zero hA4
  exact ⟨hA2, hA3, hA4, hFactor.1, hFactor.2.1, hFactor.2.2.1,
    hFactor.2.2.2.1, hCycloProduct, hFactor.2.2.2.2.1,
    hFactor.2.2.2.2.2.2.1⟩

/-- The four-shell Zorn refinement realizes the three-step path theorem.
For `P₁ ≤ P₂ ≤ P₃`, the successive arrows `N₁₂`, `N₂₃`, and `N₃₄`
therefore have the exact four-term geometric resolvent and two-sided
unipotent inverse, with no commutativity or scalar model assumptions. -/
theorem four_step_zorn_path_cyclotomic_factorization {P₁ P₂ P₃ A C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂) (hP₃ : P₃ * P₃ = P₃)
    (h12 : idemLe P₁ P₂) (h23 : idemLe P₂ P₃) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3Between P₂ P₃
    let E₄ := shell4 P₃
    let N₁₂ := root12 E₁ E₂ A
    let N₂₃ := root23 E₂ E₃ C
    let N₃₄ := root34 E₃ E₄ D
    let A₄ := N₁₂ + N₂₃ + N₃₄
    A₄ * A₄ = N₁₂ * N₂₃ + N₂₃ * N₃₄ ∧
    A₄ * A₄ * A₄ = N₁₂ * N₂₃ * N₃₄ ∧
    A₄ * A₄ * A₄ * A₄ = 0 ∧
    (1 - N₃₄) * (1 - N₂₃) * (1 - N₁₂) = 1 - A₄ ∧
    (1 + N₁₂) * (1 + N₂₃) * (1 + N₃₄) =
      chainCyclo2 A₄ * chainCyclo4 A₄ ∧
    (1 - A₄) * (chainCyclo2 A₄ * chainCyclo4 A₄) = 1 ∧
    (chainCyclo2 A₄ * chainCyclo4 A₄) * (1 - A₄) = 1 := by
  intro E₁ E₂ E₃ E₄ N₁₂ N₂₃ N₃₄
  rcases four_step_shell_partition hP₁ hP₂ hP₃ h12 h23 with
    ⟨_, _, _, _, _, _, h21, h13, h31, h14, h41, h23', h32, h24, h42, h34, h43⟩
  have hxx : N₁₂ * N₁₂ = 0 := by
    simpa [N₁₂, E₁, E₂, root12] using
      (corner_arrows_mul_zero (e := shell1 P₁) (f := shell2 P₁ P₂)
        (g := shell1 P₁) (h := shell2 P₁ P₂) (a := A) (b := A) h21)
  have hyy : N₂₃ * N₂₃ = 0 := by
    simpa [N₂₃, E₂, E₃, root23] using
      (corner_arrows_mul_zero (e := shell2 P₁ P₂) (f := shell3Between P₂ P₃)
        (g := shell2 P₁ P₂) (h := shell3Between P₂ P₃)
        (a := C) (b := C) h32)
  have hzz : N₃₄ * N₃₄ = 0 := by
    simpa [N₃₄, E₃, E₄, root34] using
      (corner_arrows_mul_zero (e := shell3Between P₂ P₃) (f := shell4 P₃)
        (g := shell3Between P₂ P₃) (h := shell4 P₃)
        (a := D) (b := D) h43)
  have hyx : N₂₃ * N₁₂ = 0 := by
    simpa [N₁₂, N₂₃, E₁, E₂, E₃, root12, root23] using
      (corner_arrows_mul_zero (e := shell2 P₁ P₂) (f := shell3Between P₂ P₃)
        (g := shell1 P₁) (h := shell2 P₁ P₂) (a := C) (b := A) h31)
  have hzx : N₃₄ * N₁₂ = 0 := by
    simpa [N₁₂, N₃₄, E₁, E₂, E₃, E₄, root12, root34] using
      (corner_arrows_mul_zero (e := shell3Between P₂ P₃) (f := shell4 P₃)
        (g := shell1 P₁) (h := shell2 P₁ P₂) (a := D) (b := A) h41)
  have hzy : N₃₄ * N₂₃ = 0 := by
    simpa [N₂₃, N₃₄, E₂, E₃, E₄, root23, root34] using
      (corner_arrows_mul_zero (e := shell3Between P₂ P₃) (f := shell4 P₃)
        (g := shell2 P₁ P₂) (h := shell3Between P₂ P₃) (a := D) (b := C) h42)
  have hxz : N₁₂ * N₃₄ = 0 := by
    simpa [N₁₂, N₃₄, E₁, E₂, E₃, E₄, root12, root34] using
      (corner_arrows_mul_zero (e := shell1 P₁) (f := shell2 P₁ P₂)
        (g := shell3Between P₂ P₃) (h := shell4 P₃) (a := A) (b := D) h23')
  exact three_step_path_cyclotomic_factorization hxx hyy hzz hyx hzx hzy hxz

/-- In a three-corner Peirce path, eliminating the middle-corner arrows by
the two unipotent factors leaves both diagonal return terms and the two
end-to-end paths.  The result is a ring identity under the displayed corner
relations; it makes no planarity or network-measurement assertion. -/
theorem zorn_three_corner_middle_contraction_readout
    {E1 E2 E3 A1 C1 A2 C2 : B}
    (h2 : E2 * E2 = E2)
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    (1 - root12 E1 E2 A1 - root32 E3 E2 C2) *
      (E2 + majoranaPhi12 E1 E2 A1 C1 + majoranaPhi23 E2 E3 A2 C2) *
      (1 - root21 E2 E1 C1 - root23 E2 E3 A2) =
      E2 - (root12 E1 E2 A1 * root21 E2 E1 C1 +
        root32 E3 E2 C2 * root23 E2 E3 A2) -
        edgeMajoranaPhi13 E1 E2 E3 A1 C1 A2 C2 := by
  let incoming := root12 E1 E2 A1 + root32 E3 E2 C2
  let outgoing := root21 E2 E1 C1 + root23 E2 E3 A2
  have hn2 : root12 E1 E2 A1 * root12 E1 E2 A1 = 0 :=
    corner_arrows_mul_zero h21
  have hm2 : root32 E3 E2 C2 * root32 E3 E2 C2 = 0 :=
    corner_arrows_mul_zero h23
  have hnm : root12 E1 E2 A1 * root32 E3 E2 C2 = 0 :=
    corner_arrows_mul_zero h23
  have hmn : root32 E3 E2 C2 * root12 E1 E2 A1 = 0 :=
    corner_arrows_mul_zero h21
  have hu2 : root21 E2 E1 C1 * root21 E2 E1 C1 = 0 :=
    corner_arrows_mul_zero h12
  have hv2 : root23 E2 E3 A2 * root23 E2 E3 A2 = 0 :=
    corner_arrows_mul_zero h32
  have huv : root21 E2 E1 C1 * root23 E2 E3 A2 = 0 :=
    corner_arrows_mul_zero h12
  have hvu : root23 E2 E3 A2 * root21 E2 E1 C1 = 0 :=
    corner_arrows_mul_zero h32
  have hincoming_sq : incoming * incoming = 0 := by
    dsimp [incoming]
    noncomm_ring [hn2, hm2, hnm, hmn]
  have houtgoing_sq : outgoing * outgoing = 0 := by
    dsimp [outgoing]
    noncomm_ring [hu2, hv2, huv, hvu]
  have hincoming_absorb : incoming * E2 = incoming := by
    dsimp [incoming, root12, root32]
    noncomm_ring [h2]
  have houtgoing_absorb : E2 * outgoing = outgoing := by
    dsimp [outgoing, root21, root23]
    rw [mul_add]
    congr 1
    · rw [← mul_assoc, ← mul_assoc, h2]
    · rw [← mul_assoc, ← mul_assoc, h2]

  calc
    _ = (1 - incoming) * (E2 + incoming + outgoing) * (1 - outgoing) := by
      dsimp [incoming, outgoing, majoranaPhi12, majoranaPhi23]
      noncomm_ring
    _ = E2 - incoming * outgoing :=
      unipotent_middle_corner_contraction hincoming_sq houtgoing_sq
        hincoming_absorb houtgoing_absorb
    _ = E2 - (root12 E1 E2 A1 * root21 E2 E1 C1 +
          root32 E3 E2 C2 * root23 E2 E3 A2) -
          edgeMajoranaPhi13 E1 E2 E3 A1 C1 A2 C2 := by
      dsimp [incoming, outgoing, edgeMajoranaPhi13, edgeRoot13,
        edgeRoot31, root12, root21, root23, root32]
      noncomm_ring [h2, h12, h21, h23, h32]

/-- The alternating-sign contraction of the middle corner has a different
boundary term from the one stated in the transcript.  With
`u = N₁₂ - N₃₂` and `v = -N₂₁ + N₂₃`, the unipotent contraction leaves
`E₂ + Q₁₂ + Q₃₂ - Φ₁₃`; both directed length-two paths occur with negative
sign.  In particular, this is not the proposed `... - J₁₃` formula. -/
theorem zorn_three_corner_twisted_middle_contraction_readout
    {E1 E2 E3 A1 C1 A2 C2 : B}
    (h2 : E2 * E2 = E2)
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    (1 - root12 E1 E2 A1 + root32 E3 E2 C2) *
      (E2 + kitaevJ23 E1 E2 E3 A1 C1 A2 C2) *
      (1 + root21 E2 E1 C1 - root23 E2 E3 A2) =
      E2 + (root12 E1 E2 A1 * root21 E2 E1 C1 +
        root32 E3 E2 C2 * root23 E2 E3 A2) -
        edgeMajoranaPhi13 E1 E2 E3 A1 C1 A2 C2 := by
  let incoming := root12 E1 E2 A1 - root32 E3 E2 C2
  let outgoing := -root21 E2 E1 C1 + root23 E2 E3 A2
  have hu2 : incoming * incoming = 0 := by
    dsimp [incoming]
    have hxx : root12 E1 E2 A1 * root12 E1 E2 A1 = 0 :=
      corner_arrows_mul_zero h21
    have hzz : root32 E3 E2 C2 * root32 E3 E2 C2 = 0 :=
      corner_arrows_mul_zero h23
    have hxz : root12 E1 E2 A1 * root32 E3 E2 C2 = 0 :=
      corner_arrows_mul_zero h23
    have hzx : root32 E3 E2 C2 * root12 E1 E2 A1 = 0 :=
      corner_arrows_mul_zero h21
    noncomm_ring [hxx, hzz, hxz, hzx]
  have hv2 : outgoing * outgoing = 0 := by
    dsimp [outgoing]
    have hyy : root21 E2 E1 C1 * root21 E2 E1 C1 = 0 :=
      corner_arrows_mul_zero h12
    have hww : root23 E2 E3 A2 * root23 E2 E3 A2 = 0 :=
      corner_arrows_mul_zero h32
    have hyw : root21 E2 E1 C1 * root23 E2 E3 A2 = 0 :=
      corner_arrows_mul_zero h12
    have hwy : root23 E2 E3 A2 * root21 E2 E1 C1 = 0 :=
      corner_arrows_mul_zero h32
    noncomm_ring [hyy, hww, hyw, hwy]
  have hua : incoming * E2 = incoming := by
    dsimp [incoming, root12, root32]
    noncomm_ring [h2]
  have hav : E2 * outgoing = outgoing := by
    dsimp [outgoing, root21, root23]
    calc
      E2 * (-(E2 * C1 * E1) + E2 * A2 * E3) =
          -(E2 * E2 * C1 * E1) + E2 * E2 * A2 * E3 := by noncomm_ring
      _ = -(E2 * C1 * E1) + E2 * A2 * E3 := by rw [h2]
  calc
    _ = (1 - incoming) * (E2 + incoming + outgoing) * (1 - outgoing) := by
      dsimp [incoming, outgoing, kitaevJ23, majoranaJ12, majoranaJ23]
      noncomm_ring
    _ = E2 - incoming * outgoing :=
      unipotent_middle_corner_contraction hu2 hv2 hua hav
    _ = E2 + (root12 E1 E2 A1 * root21 E2 E1 C1 +
          root32 E3 E2 C2 * root23 E2 E3 A2) -
          edgeMajoranaPhi13 E1 E2 E3 A1 C1 A2 C2 := by
      dsimp [incoming, outgoing, edgeMajoranaPhi13, edgeRoot13,
        edgeRoot31, root12, root21, root23, root32]
      noncomm_ring

/-- Both middle-corner contractions specialized to the shells of a nested
idempotent flag. This makes the corrected A116 readouts available directly
from `P₁ ≤ P₂`, including the distinct symmetric and alternating signs. -/
theorem nested_zorn_three_corner_contraction_readouts
    {P₁ P₂ A₁ C₁ A₂ C₂ : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    (1 - root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂) *
        (E₂ + majoranaPhi12 E₁ E₂ A₁ C₁ + majoranaPhi23 E₂ E₃ A₂ C₂) *
        (1 - root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂) =
      E₂ - (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ +
        root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) -
        edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂ ∧
    (1 - root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂) *
        (E₂ + kitaevJ23 E₁ E₂ E₃ A₁ C₁ A₂ C₂) *
        (1 + root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂) =
      E₂ + (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ +
        root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) -
        edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂ := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, hE₂, _, h12, h21, _, _, h23, h32⟩
  exact ⟨zorn_three_corner_middle_contraction_readout hE₂ h12 h21 h23 h32,
    zorn_three_corner_twisted_middle_contraction_readout hE₂ h12 h21 h23 h32⟩

/-- The ordinary and alternating-sign middle-corner contractions have the
same negative two-path bridge. Their sum keeps that even part and cancels
the corner self-energy, while their difference isolates twice the
self-energy. This is a twist-sensitive sign decomposition. Identifying it
with `wallpaperGlide` requires an additional carrier map and hypotheses; the
arbitrary-ring contraction statement alone does not provide them. -/
theorem nested_zorn_three_corner_contraction_even_odd_readouts
    {P₁ P₂ A₁ C₁ A₂ C₂ : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    ((1 - root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂) *
        (E₂ + majoranaPhi12 E₁ E₂ A₁ C₁ + majoranaPhi23 E₂ E₃ A₂ C₂) *
        (1 - root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂) +
      (1 - root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂) *
        (E₂ + kitaevJ23 E₁ E₂ E₃ A₁ C₁ A₂ C₂) *
        (1 + root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂)) =
      (2 : ℤ) • (E₂ - edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂) ∧
    ((1 - root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂) *
        (E₂ + kitaevJ23 E₁ E₂ E₃ A₁ C₁ A₂ C₂) *
        (1 + root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂) -
      (1 - root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂) *
        (E₂ + majoranaPhi12 E₁ E₂ A₁ C₁ + majoranaPhi23 E₂ E₃ A₂ C₂) *
        (1 - root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂)) =
      (2 : ℤ) • (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ +
        root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) := by
  intro E₁ E₂ E₃
  rcases nested_zorn_three_corner_contraction_readouts hP₁ hP₂ hChain with
    ⟨hOrdinary, hTwisted⟩
  constructor
  · rw [hOrdinary, hTwisted]
    noncomm_ring
  · rw [hTwisted, hOrdinary]
    noncomm_ring

/-- Both corrected three-corner contraction outputs are fixed by conjugation
with the alternating shell parity `E₁ - E₂ + E₃`. Their middle-shell term
has parity `-1` on both sides, while each self-energy and boundary bridge is
a two-hop term with parity `+1` at both ends. This is the A116 readout law
for the actual A113 path grading; it does not identify that grading with the
separate star-based wallpaper glide. -/
theorem nested_zorn_three_corner_readouts_fixed_by_path_parity
    {P₁ P₂ A₁ C₁ A₂ C₂ : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    let S := zornPlabicParity E₁ E₂ E₃
    S * (E₂ - (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ +
        root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) -
        edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂) * S =
      E₂ - (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ +
        root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) -
        edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂ ∧
    S * (E₂ + (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ +
        root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) -
        edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂) * S =
      E₂ + (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ +
        root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) -
        edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂ := by
  intro E₁ E₂ E₃ S
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨hsum, hE₁, hE₂, hE₃, h12, h21, h13, h31, h23, h32⟩
  have hS2 : S * S = 1 :=
    (zorn_plabic_parity_link_and_edge_action
      (A := A₁) (Bc := C₁) (C := A₂) (D := C₂)
      hE₁ hE₂ hE₃ h12 h21 h13 h31
      h23 h32 hsum).1
  have hS1L : S * E₁ = E₁ := by
    change (shell1 P₁ - shell2 P₁ P₂ + shell3 P₂) * shell1 P₁ = shell1 P₁
    noncomm_ring [hE₁, h21, h31]
  have hS1R : E₁ * S = E₁ := by
    change shell1 P₁ * (shell1 P₁ - shell2 P₁ P₂ + shell3 P₂) = shell1 P₁
    noncomm_ring [hE₁, h12, h13]
  have hS2L : S * E₂ = -E₂ := by
    change (shell1 P₁ - shell2 P₁ P₂ + shell3 P₂) * shell2 P₁ P₂ =
      -shell2 P₁ P₂
    noncomm_ring [hE₂, h12, h32]
  have hS2R : E₂ * S = -E₂ := by
    change shell2 P₁ P₂ * (shell1 P₁ - shell2 P₁ P₂ + shell3 P₂) =
      -shell2 P₁ P₂
    noncomm_ring [hE₂, h21, h23]
  have hS3L : S * E₃ = E₃ := by
    change (shell1 P₁ - shell2 P₁ P₂ + shell3 P₂) * shell3 P₂ = shell3 P₂
    noncomm_ring [hE₃, h13, h23]
  have hS3R : E₃ * S = E₃ := by
    change shell3 P₂ * (shell1 P₁ - shell2 P₁ P₂ + shell3 P₂) = shell3 P₂
    noncomm_ring [hE₃, h31, h32]
  have hq₁₂ : ringComm S (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁) = 0 := by
    have hcorner : root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ =
        E₁ * (A₁ * E₂ * C₁) * E₁ := by
      unfold root12 root21
      calc
        (E₁ * A₁ * E₂) * (E₂ * C₁ * E₁) =
            E₁ * A₁ * (E₂ * E₂) * C₁ * E₁ := by noncomm_ring
        _ = E₁ * A₁ * E₂ * C₁ * E₁ := by rw [hE₂]
        _ = E₁ * (A₁ * E₂ * C₁) * E₁ := by noncomm_ring
    rw [hcorner]
    exact parity_commutes_with_corner hS1L hS1R
  have hq₃₂ : ringComm S (root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) = 0 := by
    have hcorner : root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂ =
        E₃ * (C₂ * E₂ * A₂) * E₃ := by
      unfold root32 root23
      calc
        (E₃ * C₂ * E₂) * (E₂ * A₂ * E₃) =
            E₃ * C₂ * (E₂ * E₂) * A₂ * E₃ := by noncomm_ring
        _ = E₃ * C₂ * E₂ * A₂ * E₃ := by rw [hE₂]
        _ = E₃ * (C₂ * E₂ * A₂) * E₃ := by noncomm_ring
    rw [hcorner]
    exact parity_commutes_with_corner hS3L hS3R
  have hEdge := zorn_plabic_parity_grading
    (A := A₁) (Bc := C₁) (C := A₂) (D := C₂)
    hE₁ hE₂ hE₃ h12 h21 h13 h31 h23 h32
  have hEdgePhi : ringComm S
      (edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂) = 0 := hEdge.2.2.2.2.1
  have hCommE₂ : ringComm S E₂ = 0 := by
    unfold ringComm
    rw [hS2L, hS2R]
    noncomm_ring
  have hCommSub (x y : B) :
      ringComm S (x - y) = ringComm S x - ringComm S y := by
    unfold ringComm
    noncomm_ring
  have hCommAdd (x y : B) :
      ringComm S (x + y) = ringComm S x + ringComm S y := by
    unfold ringComm
    noncomm_ring
  have hFirstComm : ringComm S
      (E₂ - (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ +
        root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) -
        edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂) = 0 := by
    simp only [hCommSub, hCommAdd, hCommE₂, hq₁₂, hq₃₂, hEdgePhi]
    abel_nf
  have hSecondComm : ringComm S
      (E₂ + (root12 E₁ E₂ A₁ * root21 E₂ E₁ C₁ +
        root32 E₃ E₂ C₂ * root23 E₂ E₃ A₂) -
        edgeMajoranaPhi13 E₁ E₂ E₃ A₁ C₁ A₂ C₂) = 0 := by
    simp only [hCommSub, hCommAdd, hCommE₂, hq₁₂, hq₃₂, hEdgePhi]
    abel_nf
  have hConjugate {x : B} (hx : ringComm S x = 0) : S * x * S = x := by
    have hxs : S * x = x * S := sub_eq_zero.mp hx
    calc
      S * x * S = x * S * S := by rw [hxs]
      _ = x := by
        rw [mul_assoc, hS2, mul_one]
  constructor
  · exact hConjugate hFirstComm
  · exact hConjugate hSecondComm

/-- The incoming and outgoing sums used by the nested three-corner
contraction are square-zero, so their displayed edge-stripping factors have
explicit two-sided unipotent inverses. -/
theorem nested_zorn_three_corner_contraction_strippers_are_inverses
    {P₁ P₂ A₁ C₁ A₂ C₂ : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    (1 - (root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂)) *
        (1 + (root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂)) = 1 ∧
    (1 + (root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂)) *
        (1 - (root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂)) = 1 ∧
    (1 + (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) *
        (1 - (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) = 1 ∧
    (1 - (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) *
        (1 + (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) = 1 := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, _, _, h23, h32⟩
  have h12sq : root12 E₁ E₂ A₁ * root12 E₁ E₂ A₁ = 0 :=
    corner_arrows_mul_zero (e := E₁) (f := E₂) (g := E₁) (h := E₂)
      (a := A₁) (b := A₁) h21
  have h32sq : root32 E₃ E₂ C₂ * root32 E₃ E₂ C₂ = 0 :=
    corner_arrows_mul_zero (e := E₃) (f := E₂) (g := E₃) (h := E₂)
      (a := C₂) (b := C₂) h23
  have h₁₂₃₂ : root12 E₁ E₂ A₁ * root32 E₃ E₂ C₂ = 0 :=
    corner_arrows_mul_zero (e := E₁) (f := E₂) (g := E₃) (h := E₂)
      (a := A₁) (b := C₂) h23
  have h₃₂₁₂ : root32 E₃ E₂ C₂ * root12 E₁ E₂ A₁ = 0 :=
    corner_arrows_mul_zero (e := E₃) (f := E₂) (g := E₁) (h := E₂)
      (a := C₂) (b := A₁) h21
  have hIncoming :
      (root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂) *
        (root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂) = 0 := by
    calc
      _ = root12 E₁ E₂ A₁ * root12 E₁ E₂ A₁ +
          root12 E₁ E₂ A₁ * root32 E₃ E₂ C₂ +
          root32 E₃ E₂ C₂ * root12 E₁ E₂ A₁ +
          root32 E₃ E₂ C₂ * root32 E₃ E₂ C₂ := by noncomm_ring
      _ = 0 := by rw [h12sq, h₁₂₃₂, h₃₂₁₂, h32sq]; simp
  have h21sq : root21 E₂ E₁ C₁ * root21 E₂ E₁ C₁ = 0 :=
    corner_arrows_mul_zero (e := E₂) (f := E₁) (g := E₂) (h := E₁)
      (a := C₁) (b := C₁) h12
  have h23sq : root23 E₂ E₃ A₂ * root23 E₂ E₃ A₂ = 0 :=
    corner_arrows_mul_zero (e := E₂) (f := E₃) (g := E₂) (h := E₃)
      (a := A₂) (b := A₂) h32
  have h₂₁₂₃ : root21 E₂ E₁ C₁ * root23 E₂ E₃ A₂ = 0 :=
    corner_arrows_mul_zero (e := E₂) (f := E₁) (g := E₂) (h := E₃)
      (a := C₁) (b := A₂) h12
  have h₂₃₂₁ : root23 E₂ E₃ A₂ * root21 E₂ E₁ C₁ = 0 :=
    corner_arrows_mul_zero (e := E₂) (f := E₃) (g := E₂) (h := E₁)
      (a := A₂) (b := C₁) h32
  have hOutgoing :
      (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂) *
        (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂) = 0 := by
    calc
      _ = root21 E₂ E₁ C₁ * root21 E₂ E₁ C₁ +
          root21 E₂ E₁ C₁ * root23 E₂ E₃ A₂ +
          root23 E₂ E₃ A₂ * root21 E₂ E₁ C₁ +
          root23 E₂ E₃ A₂ * root23 E₂ E₃ A₂ := by noncomm_ring
      _ = 0 := by rw [h21sq, h₂₁₂₃, h₂₃₂₁, h23sq]; simp
  have hinv := square_zero_elementary_unipotent_inverse hIncoming
  have houtv := square_zero_elementary_unipotent_inverse hOutgoing
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc
      _ = (1 - (root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂)) *
          (1 + root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂) := by noncomm_ring
      _ = 1 := by convert hinv.1 using 1; noncomm_ring
  · calc
      _ = (1 + root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂) *
          (1 - (root12 E₁ E₂ A₁ + root32 E₃ E₂ C₂)) := by noncomm_ring
      _ = 1 := by convert hinv.2 using 1; noncomm_ring
  · calc
      _ = (1 + (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) *
          (1 - root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂) := by noncomm_ring
      _ = (1 + (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) *
          (1 - (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) := by noncomm_ring
      _ = 1 := houtv.2
  · calc
      _ = (1 - (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) *
          (1 + root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂) := by noncomm_ring
      _ = (1 - (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) *
          (1 + (root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) := by noncomm_ring
      _ = 1 := houtv.1

/-- The alternating-sign edge strippers in the twisted middle-corner
contraction are also two-sided unipotent inverses. The incoming and outgoing
differences are square-zero because the same corner-orthogonality relations
annihilate each of their four products. -/
theorem nested_zorn_three_corner_twisted_contraction_strippers_are_inverses
    {P₁ P₂ A₁ C₁ A₂ C₂ : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    (1 - (root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂)) *
        (1 + (root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂)) = 1 ∧
    (1 + (root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂)) *
        (1 - (root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂)) = 1 ∧
    (1 + (root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂)) *
        (1 - (root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂)) = 1 ∧
    (1 - (root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂)) *
        (1 + (root21 E₂ E₁ C₁ - root23 E₂ E₃ A₂)) = 1 := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, _, _, h23, h32⟩
  have h12sq : root12 E₁ E₂ A₁ * root12 E₁ E₂ A₁ = 0 :=
    corner_arrows_mul_zero (e := E₁) (f := E₂) (g := E₁) (h := E₂)
      (a := A₁) (b := A₁) h21
  have h32sq : root32 E₃ E₂ C₂ * root32 E₃ E₂ C₂ = 0 :=
    corner_arrows_mul_zero (e := E₃) (f := E₂) (g := E₃) (h := E₂)
      (a := C₂) (b := C₂) h23
  have h1232 : root12 E₁ E₂ A₁ * root32 E₃ E₂ C₂ = 0 :=
    corner_arrows_mul_zero (e := E₁) (f := E₂) (g := E₃) (h := E₂)
      (a := A₁) (b := C₂) h23
  have h3212 : root32 E₃ E₂ C₂ * root12 E₁ E₂ A₁ = 0 :=
    corner_arrows_mul_zero (e := E₃) (f := E₂) (g := E₁) (h := E₂)
      (a := C₂) (b := A₁) h21
  have hIncoming :
      (root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂) *
        (root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂) = 0 := by
    calc
      _ = root12 E₁ E₂ A₁ * root12 E₁ E₂ A₁ -
          root12 E₁ E₂ A₁ * root32 E₃ E₂ C₂ -
          root32 E₃ E₂ C₂ * root12 E₁ E₂ A₁ +
          root32 E₃ E₂ C₂ * root32 E₃ E₂ C₂ := by noncomm_ring
      _ = 0 := by rw [h12sq, h1232, h3212, h32sq]; simp
  have h21sq : root21 E₂ E₁ C₁ * root21 E₂ E₁ C₁ = 0 :=
    corner_arrows_mul_zero (e := E₂) (f := E₁) (g := E₂) (h := E₁)
      (a := C₁) (b := C₁) h12
  have h23sq : root23 E₂ E₃ A₂ * root23 E₂ E₃ A₂ = 0 :=
    corner_arrows_mul_zero (e := E₂) (f := E₃) (g := E₂) (h := E₃)
      (a := A₂) (b := A₂) h32
  have h2123 : root21 E₂ E₁ C₁ * root23 E₂ E₃ A₂ = 0 :=
    corner_arrows_mul_zero (e := E₂) (f := E₁) (g := E₂) (h := E₃)
      (a := C₁) (b := A₂) h12
  have h2321 : root23 E₂ E₃ A₂ * root21 E₂ E₁ C₁ = 0 :=
    corner_arrows_mul_zero (e := E₂) (f := E₃) (g := E₂) (h := E₁)
      (a := A₂) (b := C₁) h32
  have hOutgoing :
      (-root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂) *
        (-root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂) = 0 := by
    calc
      _ = root21 E₂ E₁ C₁ * root21 E₂ E₁ C₁ -
          root21 E₂ E₁ C₁ * root23 E₂ E₃ A₂ -
          root23 E₂ E₃ A₂ * root21 E₂ E₁ C₁ +
          root23 E₂ E₃ A₂ * root23 E₂ E₃ A₂ := by noncomm_ring
      _ = 0 := by rw [h21sq, h2123, h2321, h23sq]; simp
  have hinv := square_zero_elementary_unipotent_inverse hIncoming
  have houtv := square_zero_elementary_unipotent_inverse hOutgoing
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc
      _ = (1 - (root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂)) *
          (1 + root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂) := by noncomm_ring
      _ = 1 := by convert hinv.1 using 1; noncomm_ring
  · calc
      _ = (1 + root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂) *
          (1 - (root12 E₁ E₂ A₁ - root32 E₃ E₂ C₂)) := by noncomm_ring
      _ = 1 := by convert hinv.2 using 1; noncomm_ring
  · calc
      _ = (1 - (-root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) *
          (1 + (-root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) := by noncomm_ring
      _ = 1 := by convert houtv.1 using 1
  · calc
      _ = (1 + (-root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) *
          (1 - (-root21 E₂ E₁ C₁ + root23 E₂ E₃ A₂)) := by noncomm_ring
      _ = 1 := by convert houtv.2 using 1

/-- For a three-shell Peirce decomposition, each adjacent pair gives the
split-signature Majorana square laws, while the two-link chain retains its
length-two edge defect. The defect identities are stated as sums of squares
and anticommutators, so the edge contribution is not discarded. -/
theorem zorn_shell_kitaev_defect_laws {E1 E2 E3 A Bc C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    majoranaPhi12 E1 E2 A Bc * majoranaPhi12 E1 E2 A Bc =
      linkMetric12 E1 E2 A Bc ∧
    majoranaJ12 E1 E2 A Bc * majoranaJ12 E1 E2 A Bc =
      -linkMetric12 E1 E2 A Bc ∧
    majoranaPhi23 E2 E3 C D * majoranaPhi23 E2 E3 C D =
      linkMetric23 E2 E3 C D ∧
    majoranaJ23 E2 E3 C D * majoranaJ23 E2 E3 C D =
      -linkMetric23 E2 E3 C D ∧
    kitaevPhi23 E1 E2 E3 A Bc C D * kitaevPhi23 E1 E2 E3 A Bc C D +
      kitaevJ23 E1 E2 E3 A Bc C D * kitaevJ23 E1 E2 E3 A Bc C D =
      (2 : ℤ) • edgeMajoranaPhi13 E1 E2 E3 A Bc C D ∧
    kitaevPhi23 E1 E2 E3 A Bc C D * kitaevJ23 E1 E2 E3 A Bc C D +
      kitaevJ23 E1 E2 E3 A Bc C D * kitaevPhi23 E1 E2 E3 A Bc C D =
      (2 : ℤ) • edgeMajoranaJ13 E1 E2 E3 A Bc C D := by
  have hxx : root12 E1 E2 A * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero h21
  have hyy : root21 E2 E1 Bc * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero h12
  have huu : root23 E2 E3 C * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero h32
  have hvv : root32 E3 E2 D * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero h23
  have hxv : root12 E1 E2 A * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero h23
  have hyu : root21 E2 E1 Bc * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero h12
  have hux : root23 E2 E3 C * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero h31
  have huy : root23 E2 E3 C * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero h32
  have hvx : root32 E3 E2 D * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero h21
  have hyv : root21 E2 E1 Bc * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero h13
  have hPair12 := directed_majorana_pair_laws hxx hyy
  have hPair23 := directed_majorana_pair_laws huu hvv
  have hEdges := directed_edge_defect_laws hxx hyy huu hvv hxv hyu hux huy hvx hyv
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact hPair12.1
  · exact hPair12.2.1
  · exact hPair23.1
  · exact hPair23.2.1
  · change
      (root12 E1 E2 A + root21 E2 E1 Bc + (root23 E2 E3 C + root32 E3 E2 D)) *
        (root12 E1 E2 A + root21 E2 E1 Bc + (root23 E2 E3 C + root32 E3 E2 D)) +
      (root12 E1 E2 A - root21 E2 E1 Bc + (root23 E2 E3 C - root32 E3 E2 D)) *
        (root12 E1 E2 A - root21 E2 E1 Bc + (root23 E2 E3 C - root32 E3 E2 D)) =
      (2 : ℤ) • (root12 E1 E2 A * root23 E2 E3 C + root32 E3 E2 D * root21 E2 E1 Bc)
    exact hEdges.1
  · change
      (root12 E1 E2 A + root21 E2 E1 Bc + (root23 E2 E3 C + root32 E3 E2 D)) *
        (root12 E1 E2 A - root21 E2 E1 Bc + (root23 E2 E3 C - root32 E3 E2 D)) +
      (root12 E1 E2 A - root21 E2 E1 Bc + (root23 E2 E3 C - root32 E3 E2 D)) *
        (root12 E1 E2 A + root21 E2 E1 Bc + (root23 E2 E3 C + root32 E3 E2 D)) =
      (2 : ℤ) • (root12 E1 E2 A * root23 E2 E3 C - root32 E3 E2 D * root21 E2 E1 Bc)
    exact hEdges.2

/-- A112's two-link defect and edge identities specialized directly to a
nested idempotent flag. The surviving endpoint terms remain explicit. -/
theorem nested_zorn_shell_kitaev_defect_laws
    {P₁ P₂ A Bc C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    majoranaPhi12 E₁ E₂ A Bc * majoranaPhi12 E₁ E₂ A Bc =
      linkMetric12 E₁ E₂ A Bc ∧
    majoranaJ12 E₁ E₂ A Bc * majoranaJ12 E₁ E₂ A Bc =
      -linkMetric12 E₁ E₂ A Bc ∧
    majoranaPhi23 E₂ E₃ C D * majoranaPhi23 E₂ E₃ C D =
      linkMetric23 E₂ E₃ C D ∧
    majoranaJ23 E₂ E₃ C D * majoranaJ23 E₂ E₃ C D =
      -linkMetric23 E₂ E₃ C D ∧
    kitaevPhi23 E₁ E₂ E₃ A Bc C D * kitaevPhi23 E₁ E₂ E₃ A Bc C D +
      kitaevJ23 E₁ E₂ E₃ A Bc C D * kitaevJ23 E₁ E₂ E₃ A Bc C D =
      (2 : ℤ) • edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D ∧
    kitaevPhi23 E₁ E₂ E₃ A Bc C D * kitaevJ23 E₁ E₂ E₃ A Bc C D +
      kitaevJ23 E₁ E₂ E₃ A Bc C D * kitaevPhi23 E₁ E₂ E₃ A Bc C D =
      (2 : ℤ) • edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, h13, h31, h23, h32⟩
  have hxx : root12 E₁ E₂ A * root12 E₁ E₂ A = 0 := corner_arrows_mul_zero h21
  have hyy : root21 E₂ E₁ Bc * root21 E₂ E₁ Bc = 0 := corner_arrows_mul_zero h12
  have huu : root23 E₂ E₃ C * root23 E₂ E₃ C = 0 := corner_arrows_mul_zero h32
  have hvv : root32 E₃ E₂ D * root32 E₃ E₂ D = 0 := corner_arrows_mul_zero h23
  have hxv : root12 E₁ E₂ A * root32 E₃ E₂ D = 0 := corner_arrows_mul_zero h23
  have hyu : root21 E₂ E₁ Bc * root23 E₂ E₃ C = 0 := corner_arrows_mul_zero h12
  have hux : root23 E₂ E₃ C * root12 E₁ E₂ A = 0 := corner_arrows_mul_zero h31
  have huy : root23 E₂ E₃ C * root21 E₂ E₁ Bc = 0 := corner_arrows_mul_zero h32
  have hvx : root32 E₃ E₂ D * root12 E₁ E₂ A = 0 := corner_arrows_mul_zero h21
  have hyv : root21 E₂ E₁ Bc * root32 E₃ E₂ D = 0 := corner_arrows_mul_zero h13
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · change (root12 E₁ E₂ A + root21 E₂ E₁ Bc) *
      (root12 E₁ E₂ A + root21 E₂ E₁ Bc) =
      root12 E₁ E₂ A * root21 E₂ E₁ Bc + root21 E₂ E₁ Bc * root12 E₁ E₂ A
    noncomm_ring [hxx, hyy]
  · change (root12 E₁ E₂ A - root21 E₂ E₁ Bc) *
      (root12 E₁ E₂ A - root21 E₂ E₁ Bc) =
      -(root12 E₁ E₂ A * root21 E₂ E₁ Bc + root21 E₂ E₁ Bc * root12 E₁ E₂ A)
    noncomm_ring [hxx, hyy]
  · change (root23 E₂ E₃ C + root32 E₃ E₂ D) *
      (root23 E₂ E₃ C + root32 E₃ E₂ D) =
      root23 E₂ E₃ C * root32 E₃ E₂ D + root32 E₃ E₂ D * root23 E₂ E₃ C
    noncomm_ring [huu, hvv]
  · change (root23 E₂ E₃ C - root32 E₃ E₂ D) *
      (root23 E₂ E₃ C - root32 E₃ E₂ D) =
      -(root23 E₂ E₃ C * root32 E₃ E₂ D + root32 E₃ E₂ D * root23 E₂ E₃ C)
    noncomm_ring [huu, hvv]
  · change
      (root12 E₁ E₂ A + root21 E₂ E₁ Bc + (root23 E₂ E₃ C + root32 E₃ E₂ D)) *
        (root12 E₁ E₂ A + root21 E₂ E₁ Bc + (root23 E₂ E₃ C + root32 E₃ E₂ D)) +
      (root12 E₁ E₂ A - root21 E₂ E₁ Bc + (root23 E₂ E₃ C - root32 E₃ E₂ D)) *
        (root12 E₁ E₂ A - root21 E₂ E₁ Bc + (root23 E₂ E₃ C - root32 E₃ E₂ D)) =
      (2 : ℤ) • (root12 E₁ E₂ A * root23 E₂ E₃ C +
        root32 E₃ E₂ D * root21 E₂ E₁ Bc)
    noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]
  · change
      (root12 E₁ E₂ A + root21 E₂ E₁ Bc + (root23 E₂ E₃ C + root32 E₃ E₂ D)) *
        (root12 E₁ E₂ A - root21 E₂ E₁ Bc + (root23 E₂ E₃ C - root32 E₃ E₂ D)) +
      (root12 E₁ E₂ A - root21 E₂ E₁ Bc + (root23 E₂ E₃ C - root32 E₃ E₂ D)) *
        (root12 E₁ E₂ A + root21 E₂ E₁ Bc + (root23 E₂ E₃ C + root32 E₃ E₂ D)) =
      (2 : ℤ) • (root12 E₁ E₂ A * root23 E₂ E₃ C -
        root32 E₃ E₂ D * root21 E₂ E₁ Bc)
    noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]

/-! ### Corrected A₁₁₄: Twisted Chain Product and Bracket Decomposition -/

/-- Products of neighboring link generators. The two forward arrows compose
to the `1 → 3` root; in reverse order the only surviving path is `3 → 1`.
This lemma is the reusable sign/orientation interface for the twist laws. -/
theorem zorn_interlink_majorana_products
    {E1 E2 E3 A Bc C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    majoranaPhi12 E1 E2 A Bc * majoranaPhi23 E2 E3 C D =
      edgeRoot13 E1 E2 E3 A C ∧
    majoranaPhi23 E2 E3 C D * majoranaPhi12 E1 E2 A Bc =
      edgeRoot31 E1 E2 E3 Bc D ∧
    majoranaJ12 E1 E2 A Bc * majoranaPhi23 E2 E3 C D =
      edgeRoot13 E1 E2 E3 A C ∧
    majoranaJ23 E2 E3 C D * majoranaPhi12 E1 E2 A Bc =
      -edgeRoot31 E1 E2 E3 Bc D ∧
    majoranaJ12 E1 E2 A Bc * majoranaPhi12 E1 E2 A Bc =
      linkSpin12 E1 E2 A Bc ∧
    majoranaJ23 E2 E3 C D * majoranaPhi23 E2 E3 C D =
      linkSpin23 E2 E3 C D := by
  have hxx : root12 E1 E2 A * root12 E1 E2 A = 0 := corner_arrows_mul_zero h21
  have hyy : root21 E2 E1 Bc * root21 E2 E1 Bc = 0 := corner_arrows_mul_zero h12
  have huu : root23 E2 E3 C * root23 E2 E3 C = 0 := corner_arrows_mul_zero h32
  have hvv : root32 E3 E2 D * root32 E3 E2 D = 0 := corner_arrows_mul_zero h23
  have hxv : root12 E1 E2 A * root32 E3 E2 D = 0 := corner_arrows_mul_zero h23
  have hyu : root21 E2 E1 Bc * root23 E2 E3 C = 0 := corner_arrows_mul_zero h12
  have hux : root23 E2 E3 C * root12 E1 E2 A = 0 := corner_arrows_mul_zero h31
  have huy : root23 E2 E3 C * root21 E2 E1 Bc = 0 := corner_arrows_mul_zero h32
  have hvx : root32 E3 E2 D * root12 E1 E2 A = 0 := corner_arrows_mul_zero h21
  have hyv : root21 E2 E1 Bc * root32 E3 E2 D = 0 := corner_arrows_mul_zero h13
  simp only [majoranaPhi12, majoranaJ12, majoranaPhi23, majoranaJ23,
    edgeRoot13, edgeRoot31, linkSpin12, linkSpin23]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]

/-- Corrected Kasteleyn-twisted chain brackets. For directed link arrows
`x,y` and `u,v`, the product of the alternating first link with the summed
second link retains the symmetric endpoint bridge `x*u + v*y`. Thus the
commutator is the twisted spin term **plus** that bridge, while the
anticommutator vanishes. -/
theorem alternating_chain_product_and_brackets {x y u v : B}
    (hxx : x * x = 0) (hyy : y * y = 0)
    (huu : u * u = 0) (hvv : v * v = 0)
    (hxv : x * v = 0) (hyu : y * u = 0) (hux : u * x = 0)
    (huy : u * y = 0) (hvx : v * x = 0) (hyv : y * v = 0) :
    ((x - y) - (u - v)) * ((x + y) + (u + v)) =
        (x * y - y * x) - (u * v - v * u) + (x * u + v * y) ∧
    ringComm ((x - y) - (u - v)) ((x + y) + (u + v)) =
        (2 : ℤ) • ((x * y - y * x) - (u * v - v * u) + (x * u + v * y)) ∧
    (((x - y) - (u - v)) * ((x + y) + (u + v)) +
      ((x + y) + (u + v)) * ((x - y) - (u - v))) = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]
  · unfold ringComm
    noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]
  · noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]

/-- The corrected twisted-bracket law specialized to the four arrows of an
orthogonal three-corner Peirce decomposition. It keeps the surviving edge
bridge as an explicit summand of the commutator. -/
theorem zorn_plabic_twisted_chain_brackets
    {E1 E2 E3 A Bc C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    (majoranaJ12 E1 E2 A Bc - majoranaJ23 E2 E3 C D) *
        (majoranaPhi12 E1 E2 A Bc + majoranaPhi23 E2 E3 C D) =
      linkSpin12 E1 E2 A Bc - linkSpin23 E2 E3 C D +
        edgeMajoranaPhi13 E1 E2 E3 A Bc C D ∧
    ringComm (majoranaJ12 E1 E2 A Bc - majoranaJ23 E2 E3 C D)
        (majoranaPhi12 E1 E2 A Bc + majoranaPhi23 E2 E3 C D) =
      (2 : ℤ) • (linkSpin12 E1 E2 A Bc - linkSpin23 E2 E3 C D +
        edgeMajoranaPhi13 E1 E2 E3 A Bc C D) ∧
    (majoranaJ12 E1 E2 A Bc - majoranaJ23 E2 E3 C D) *
        (majoranaPhi12 E1 E2 A Bc + majoranaPhi23 E2 E3 C D) +
      (majoranaPhi12 E1 E2 A Bc + majoranaPhi23 E2 E3 C D) *
        (majoranaJ12 E1 E2 A Bc - majoranaJ23 E2 E3 C D) = 0 := by
  have hxx : root12 E1 E2 A * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E1) (h := E2)
      (a := A) (b := A) h21
  have hyy : root21 E2 E1 Bc * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E1) (g := E2) (h := E1)
      (a := Bc) (b := Bc) h12
  have huu : root23 E2 E3 C * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E2) (h := E3)
      (a := C) (b := C) h32
  have hvv : root32 E3 E2 D * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E2) (g := E3) (h := E2)
      (a := D) (b := D) h23
  have hxv : root12 E1 E2 A * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E3) (h := E2)
      (a := A) (b := D) h23
  have hyu : root21 E2 E1 Bc * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E1) (g := E2) (h := E3)
      (a := Bc) (b := C) h12
  have hux : root23 E2 E3 C * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E1) (h := E2)
      (a := C) (b := A) h31
  have huy : root23 E2 E3 C * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E2) (h := E1)
      (a := C) (b := Bc) h32
  have hvx : root32 E3 E2 D * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E2) (g := E1) (h := E2)
      (a := D) (b := A) h21
  have hyv : root21 E2 E1 Bc * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E1) (g := E3) (h := E2)
      (a := Bc) (b := D) h13
  have hTwist := alternating_chain_product_and_brackets
    hxx hyy huu hvv hxv hyu hux huy hvx hyv
  refine ⟨?_, ?_, ?_⟩
  · simpa [majoranaJ12, majoranaJ23, majoranaPhi12, majoranaPhi23,
      linkSpin12, linkSpin23, edgeMajoranaPhi13, edgeRoot13, edgeRoot31,
      root12, root21, root23, root32] using hTwist.1
  · simpa [majoranaJ12, majoranaJ23, majoranaPhi12, majoranaPhi23,
      linkSpin12, linkSpin23, edgeMajoranaPhi13, edgeRoot13, edgeRoot31,
      root12, root21, root23, root32, ringComm] using hTwist.2.1
  · simpa [majoranaJ12, majoranaJ23, majoranaPhi12, majoranaPhi23,
      root12, root21, root23, root32] using hTwist.2.2

/-- The other Kasteleyn twist, `Φ₁₂ - Φ₂₃`, against the untwisted sum
has a different decomposition from the `J₁₂ - J₂₃` bracket above: its
commutator is the endpoint phase bridge, while its anticommutator is the
difference of the link metrics. -/
theorem zorn_plabic_twisted_phi_chain_brackets
    {E1 E2 E3 A Bc C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    (majoranaPhi12 E1 E2 A Bc - majoranaPhi23 E2 E3 C D) *
        (majoranaPhi12 E1 E2 A Bc + majoranaPhi23 E2 E3 C D) =
      linkMetric12 E1 E2 A Bc - linkMetric23 E2 E3 C D +
        edgeMajoranaJ13 E1 E2 E3 A Bc C D ∧
    ringComm (majoranaPhi12 E1 E2 A Bc - majoranaPhi23 E2 E3 C D)
        (majoranaPhi12 E1 E2 A Bc + majoranaPhi23 E2 E3 C D) =
      (2 : ℤ) • edgeMajoranaJ13 E1 E2 E3 A Bc C D ∧
    ((majoranaPhi12 E1 E2 A Bc - majoranaPhi23 E2 E3 C D) *
        (majoranaPhi12 E1 E2 A Bc + majoranaPhi23 E2 E3 C D) +
      (majoranaPhi12 E1 E2 A Bc + majoranaPhi23 E2 E3 C D) *
        (majoranaPhi12 E1 E2 A Bc - majoranaPhi23 E2 E3 C D)) =
      (2 : ℤ) • (linkMetric12 E1 E2 A Bc - linkMetric23 E2 E3 C D) := by
  have hxx : root12 E1 E2 A * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E1) (h := E2)
      (a := A) (b := A) h21
  have hyy : root21 E2 E1 Bc * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E1) (g := E2) (h := E1)
      (a := Bc) (b := Bc) h12
  have huu : root23 E2 E3 C * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E2) (h := E3)
      (a := C) (b := C) h32
  have hvv : root32 E3 E2 D * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E2) (g := E3) (h := E2)
      (a := D) (b := D) h23
  have hxv : root12 E1 E2 A * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E3) (h := E2)
      (a := A) (b := D) h23
  have hyu : root21 E2 E1 Bc * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E1) (g := E2) (h := E3)
      (a := Bc) (b := C) h12
  have hux : root23 E2 E3 C * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E1) (h := E2)
      (a := C) (b := A) h31
  have huy : root23 E2 E3 C * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E2) (h := E1)
      (a := C) (b := Bc) h32
  have hvx : root32 E3 E2 D * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E2) (g := E1) (h := E2)
      (a := D) (b := A) h21
  have hyv : root21 E2 E1 Bc * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E1) (g := E3) (h := E2)
      (a := Bc) (b := D) h13
  refine ⟨?_, ?_, ?_⟩
  · change
      (root12 E1 E2 A + root21 E2 E1 Bc -
        (root23 E2 E3 C + root32 E3 E2 D)) *
        (root12 E1 E2 A + root21 E2 E1 Bc +
          (root23 E2 E3 C + root32 E3 E2 D)) =
      (root12 E1 E2 A * root21 E2 E1 Bc +
        root21 E2 E1 Bc * root12 E1 E2 A) -
        (root23 E2 E3 C * root32 E3 E2 D +
          root32 E3 E2 D * root23 E2 E3 C) +
        (root12 E1 E2 A * root23 E2 E3 C -
          root32 E3 E2 D * root21 E2 E1 Bc)
    noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]
  · change
      (root12 E1 E2 A + root21 E2 E1 Bc -
        (root23 E2 E3 C + root32 E3 E2 D)) *
          (root12 E1 E2 A + root21 E2 E1 Bc +
            (root23 E2 E3 C + root32 E3 E2 D)) -
        (root12 E1 E2 A + root21 E2 E1 Bc +
          (root23 E2 E3 C + root32 E3 E2 D)) *
          (root12 E1 E2 A + root21 E2 E1 Bc -
            (root23 E2 E3 C + root32 E3 E2 D)) =
      (2 : ℤ) • (root12 E1 E2 A * root23 E2 E3 C -
        root32 E3 E2 D * root21 E2 E1 Bc)
    noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]
  · change
      (root12 E1 E2 A + root21 E2 E1 Bc -
        (root23 E2 E3 C + root32 E3 E2 D)) *
          (root12 E1 E2 A + root21 E2 E1 Bc +
            (root23 E2 E3 C + root32 E3 E2 D)) +
        (root12 E1 E2 A + root21 E2 E1 Bc +
          (root23 E2 E3 C + root32 E3 E2 D)) *
          (root12 E1 E2 A + root21 E2 E1 Bc -
            (root23 E2 E3 C + root32 E3 E2 D)) =
      (2 : ℤ) • ((root12 E1 E2 A * root21 E2 E1 Bc +
        root21 E2 E1 Bc * root12 E1 E2 A) -
        (root23 E2 E3 C * root32 E3 E2 D +
          root32 E3 E2 D * root23 E2 E3 C))
    noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv]

/-- The companion twisted-`Φ` bracket for an actual nested idempotent flag.
This packages `three_shell_partition` with the orthogonal-shell identity, so
the A114 readout is available directly from `P₁ ≤ P₂`. -/
theorem nested_zorn_plabic_twisted_phi_chain_brackets
    {P₁ P₂ A Bc C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    (majoranaPhi12 E₁ E₂ A Bc - majoranaPhi23 E₂ E₃ C D) *
        (majoranaPhi12 E₁ E₂ A Bc + majoranaPhi23 E₂ E₃ C D) =
      linkMetric12 E₁ E₂ A Bc - linkMetric23 E₂ E₃ C D +
        edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D ∧
    ringComm (majoranaPhi12 E₁ E₂ A Bc - majoranaPhi23 E₂ E₃ C D)
        (majoranaPhi12 E₁ E₂ A Bc + majoranaPhi23 E₂ E₃ C D) =
      (2 : ℤ) • edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D ∧
    ((majoranaPhi12 E₁ E₂ A Bc - majoranaPhi23 E₂ E₃ C D) *
        (majoranaPhi12 E₁ E₂ A Bc + majoranaPhi23 E₂ E₃ C D) +
      (majoranaPhi12 E₁ E₂ A Bc + majoranaPhi23 E₂ E₃ C D) *
        (majoranaPhi12 E₁ E₂ A Bc - majoranaPhi23 E₂ E₃ C D)) =
      (2 : ℤ) • (linkMetric12 E₁ E₂ A Bc - linkMetric23 E₂ E₃ C D) := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, hE₁, hE₂, hE₃, h12, h21, h13, h31, h23, h32⟩
  exact zorn_plabic_twisted_phi_chain_brackets
    h12 h21 h13 h31 h23 h32

/-- The corrected twisted-`J` bracket law specialized to the three shells
of a nested idempotent pair. The commutator retains the symmetric endpoint
bridge, and the anticommutator is zero. -/
theorem nested_zorn_plabic_twisted_chain_brackets
    {P₁ P₂ A Bc C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    (majoranaJ12 E₁ E₂ A Bc - majoranaJ23 E₂ E₃ C D) *
        (majoranaPhi12 E₁ E₂ A Bc + majoranaPhi23 E₂ E₃ C D) =
      linkSpin12 E₁ E₂ A Bc - linkSpin23 E₂ E₃ C D +
        edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D ∧
    ringComm (majoranaJ12 E₁ E₂ A Bc - majoranaJ23 E₂ E₃ C D)
        (majoranaPhi12 E₁ E₂ A Bc + majoranaPhi23 E₂ E₃ C D) =
      (2 : ℤ) • (linkSpin12 E₁ E₂ A Bc - linkSpin23 E₂ E₃ C D +
        edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D) ∧
    (majoranaJ12 E₁ E₂ A Bc - majoranaJ23 E₂ E₃ C D) *
        (majoranaPhi12 E₁ E₂ A Bc + majoranaPhi23 E₂ E₃ C D) +
      (majoranaPhi12 E₁ E₂ A Bc + majoranaPhi23 E₂ E₃ C D) *
        (majoranaJ12 E₁ E₂ A Bc - majoranaJ23 E₂ E₃ C D) = 0 := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, h13, h31, h23, h32⟩
  exact zorn_plabic_twisted_chain_brackets
    h12 h21 h13 h31 h23 h32

/-- Four-arrow path calculation for the spin actions. The hypotheses say
that each arrow is square-zero and that every cross-composition vanishes
except the two directed length-two paths `x*u` and `v*y`. -/
theorem two_link_spin_action_on_paths {x y u v : B}
    (hxx : x * x = 0) (hyy : y * y = 0)
    (huu : u * u = 0) (hvv : v * v = 0)
    (hxv : x * v = 0) (hyu : y * u = 0) (hux : u * x = 0)
    (huy : u * y = 0) (hvx : v * x = 0) (hyv : y * v = 0) :
    ringComm (x * y - y * x + (u * v - v * u)) (x * u) =
      (x * y + y * x) * (x * u) + (x * u) * (u * v + v * u) ∧
    ringComm (x * y - y * x - (u * v - v * u)) (x * u) =
      (x * y + y * x) * (x * u) - (x * u) * (u * v + v * u) ∧
    ringComm (x * y - y * x + (u * v - v * u)) (v * y) =
      -((u * v + v * u) * (v * y) + (v * y) * (x * y + y * x)) ∧
    ringComm (x * y - y * x - (u * v - v * u)) (v * y) =
      (u * v + v * u) * (v * y) - (v * y) * (x * y + y * x) := by
  have hxxu : x * (x * u) = 0 := by rw [← mul_assoc, hxx, zero_mul]
  have hyxxu : y * (x * (x * u)) = 0 := by rw [hxxu, mul_zero]
  have hvxu : v * (x * u) = 0 := by rw [← mul_assoc, hvx, zero_mul]
  have huxu : u * (x * u) = 0 := by rw [← mul_assoc, hux, zero_mul]
  have huxy : x * (u * (x * y)) = 0 := by
    calc
      x * (u * (x * y)) = x * ((u * x) * y) := by noncomm_ring
      _ = 0 := by rw [hux]; simp
  have huyx : x * (u * (y * x)) = 0 := by
    calc
      x * (u * (y * x)) = x * ((u * y) * x) := by noncomm_ring
      _ = 0 := by rw [huy]; simp
  have huuv : x * (u * (u * v)) = 0 := by
    calc
      x * (u * (u * v)) = x * ((u * u) * v) := by noncomm_ring
      _ = 0 := by rw [huu]; simp
  have h_yvy : y * (v * y) = 0 := by rw [← mul_assoc, hyv, zero_mul]
  have hxvy : x * (v * y) = 0 := by rw [← mul_assoc, hxv, zero_mul]
  have hyxvy : y * (x * (v * y)) = 0 := by rw [hxvy, mul_zero]
  have hyvuv : v * (y * (u * v)) = 0 := by
    calc
      v * (y * (u * v)) = v * ((y * u) * v) := by noncomm_ring
      _ = 0 := by rw [hyu]; simp
  have hvvy : v * (v * y) = 0 := by rw [← mul_assoc, hvv, zero_mul]
  have huvvy : u * (v * (v * y)) = 0 := by rw [hvvy, mul_zero]
  have hvyvu : v * (y * (v * u)) = 0 := by
    calc
      v * (y * (v * u)) = v * ((y * v) * u) := by noncomm_ring
      _ = 0 := by rw [hyv]; simp
  have hyyyx : v * (y * (y * x)) = 0 := by
    calc
      v * (y * (y * x)) = v * ((y * y) * x) := by noncomm_ring
      _ = 0 := by rw [hyy]; simp
  unfold ringComm
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    noncomm_ring [hxx, hyy, huu, hvv, hxv, hyu, hux, huy, hvx, hyv,
      hxxu, hyxxu, hvxu, huxu, huxy, huyx, huuv, h_yvy, hxvy, hyxvy,
      hyvuv, hyyyx, hvvy, huvvy, hvyvu]

/-- The untwisted and alternating link-spin commutators act on the two
oriented length-two paths by the sum and difference of the adjacent corner
metrics. This is the exact algebraic content of the A₁₁₅ boundary holonomy
claim; it does not assert that either link metric is scalar or that the two
inner derivations commute. -/
theorem zorn_link_spin_action_on_boundary_paths
    {E1 E2 E3 A Bc C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    ringComm (linkSpin12 E1 E2 A Bc + linkSpin23 E2 E3 C D)
        (edgeRoot13 E1 E2 E3 A C) =
      linkMetric12 E1 E2 A Bc * edgeRoot13 E1 E2 E3 A C +
        edgeRoot13 E1 E2 E3 A C * linkMetric23 E2 E3 C D ∧
    ringComm (linkSpin12 E1 E2 A Bc - linkSpin23 E2 E3 C D)
        (edgeRoot13 E1 E2 E3 A C) =
      linkMetric12 E1 E2 A Bc * edgeRoot13 E1 E2 E3 A C -
        edgeRoot13 E1 E2 E3 A C * linkMetric23 E2 E3 C D ∧
    ringComm (linkSpin12 E1 E2 A Bc + linkSpin23 E2 E3 C D)
        (edgeRoot31 E1 E2 E3 Bc D) =
      -(linkMetric23 E2 E3 C D * edgeRoot31 E1 E2 E3 Bc D +
        edgeRoot31 E1 E2 E3 Bc D * linkMetric12 E1 E2 A Bc) ∧
    ringComm (linkSpin12 E1 E2 A Bc - linkSpin23 E2 E3 C D)
        (edgeRoot31 E1 E2 E3 Bc D) =
      linkMetric23 E2 E3 C D * edgeRoot31 E1 E2 E3 Bc D -
        edgeRoot31 E1 E2 E3 Bc D * linkMetric12 E1 E2 A Bc := by
  have hxx : root12 E1 E2 A * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E1) (h := E2)
      (a := A) (b := A) h21
  have hyy : root21 E2 E1 Bc * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E1) (g := E2) (h := E1)
      (a := Bc) (b := Bc) h12
  have huu : root23 E2 E3 C * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E2) (h := E3)
      (a := C) (b := C) h32
  have hvv : root32 E3 E2 D * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E2) (g := E3) (h := E2)
      (a := D) (b := D) h23
  have hxv : root12 E1 E2 A * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E3) (h := E2)
      (a := A) (b := D) h23
  have hyu : root21 E2 E1 Bc * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E1) (g := E2) (h := E3)
      (a := Bc) (b := C) h12
  have hux : root23 E2 E3 C * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E1) (h := E2)
      (a := C) (b := A) h31
  have huy : root23 E2 E3 C * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E2) (h := E1)
      (a := C) (b := Bc) h32
  have hvx : root32 E3 E2 D * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E2) (g := E1) (h := E2)
      (a := D) (b := A) h21
  have hyv : root21 E2 E1 Bc * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E1) (g := E3) (h := E2)
      (a := Bc) (b := D) h13
  have hActions := two_link_spin_action_on_paths
    (x := root12 E1 E2 A) (y := root21 E2 E1 Bc)
    (u := root23 E2 E3 C) (v := root32 E3 E2 D)
    hxx hyy huu hvv hxv hyu hux huy hvx hyv
  simpa [linkSpin12, linkSpin23, linkMetric12, linkMetric23,
    edgeRoot13, edgeRoot31, root12, root21, root23, root32] using hActions

/-- A115's two oriented boundary-path spin actions, specialized to shells
from a nested idempotent pair. -/
theorem nested_zorn_link_spin_action_on_boundary_paths
    {P₁ P₂ A Bc C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    ringComm (linkSpin12 E₁ E₂ A Bc + linkSpin23 E₂ E₃ C D)
        (edgeRoot13 E₁ E₂ E₃ A C) =
      linkMetric12 E₁ E₂ A Bc * edgeRoot13 E₁ E₂ E₃ A C +
        edgeRoot13 E₁ E₂ E₃ A C * linkMetric23 E₂ E₃ C D ∧
    ringComm (linkSpin12 E₁ E₂ A Bc - linkSpin23 E₂ E₃ C D)
        (edgeRoot13 E₁ E₂ E₃ A C) =
      linkMetric12 E₁ E₂ A Bc * edgeRoot13 E₁ E₂ E₃ A C -
        edgeRoot13 E₁ E₂ E₃ A C * linkMetric23 E₂ E₃ C D ∧
    ringComm (linkSpin12 E₁ E₂ A Bc + linkSpin23 E₂ E₃ C D)
        (edgeRoot31 E₁ E₂ E₃ Bc D) =
      -(linkMetric23 E₂ E₃ C D * edgeRoot31 E₁ E₂ E₃ Bc D +
        edgeRoot31 E₁ E₂ E₃ Bc D * linkMetric12 E₁ E₂ A Bc) ∧
    ringComm (linkSpin12 E₁ E₂ A Bc - linkSpin23 E₂ E₃ C D)
        (edgeRoot31 E₁ E₂ E₃ Bc D) =
      linkMetric23 E₂ E₃ C D * edgeRoot31 E₁ E₂ E₃ Bc D -
        edgeRoot31 E₁ E₂ E₃ Bc D * linkMetric12 E₁ E₂ A Bc := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, hE₁, hE₂, hE₃, h12, h21, h13, h31, h23, h32⟩
  exact zorn_link_spin_action_on_boundary_paths
    (A := A) (Bc := Bc) (C := C) (D := D)
    h12 h21 h13 h31 h23 h32

/-- If both oriented endpoint paths are balanced against their adjacent link
metrics, the twisted spin derivation annihilates both boundary Majorana
combinations. Both balance equations are required for this pair-level result. -/
theorem nested_zorn_balanced_twisted_spin_parallel_edge_modes
    {P₁ P₂ A Bc C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂)
    (hBalance13 :
      linkMetric12 (shell1 P₁) (shell2 P₁ P₂) A Bc *
          edgeRoot13 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) A C =
        edgeRoot13 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) A C *
          linkMetric23 (shell2 P₁ P₂) (shell3 P₂) C D)
    (hBalance31 :
      linkMetric23 (shell2 P₁ P₂) (shell3 P₂) C D *
          edgeRoot31 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) Bc D =
        edgeRoot31 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) Bc D *
          linkMetric12 (shell1 P₁) (shell2 P₁ P₂) A Bc) :
    ringComm
        (linkSpin12 (shell1 P₁) (shell2 P₁ P₂) A Bc -
          linkSpin23 (shell2 P₁ P₂) (shell3 P₂) C D)
        (edgeMajoranaPhi13 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂)
          A Bc C D) = 0 ∧
    ringComm
        (linkSpin12 (shell1 P₁) (shell2 P₁ P₂) A Bc -
          linkSpin23 (shell2 P₁ P₂) (shell3 P₂) C D)
        (edgeMajoranaJ13 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂)
          A Bc C D) = 0 := by
  have hActions := nested_zorn_link_spin_action_on_boundary_paths
    (A := A) (Bc := Bc) (C := C) (D := D) hP₁ hP₂ hChain
  let spin := linkSpin12 (shell1 P₁) (shell2 P₁ P₂) A Bc -
    linkSpin23 (shell2 P₁ P₂) (shell3 P₂) C D
  let n13 := edgeRoot13 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) A C
  let n31 := edgeRoot31 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) Bc D
  have hComm13 : ringComm spin n13 =
      linkMetric12 (shell1 P₁) (shell2 P₁ P₂) A Bc * n13 -
        n13 * linkMetric23 (shell2 P₁ P₂) (shell3 P₂) C D := by
    simpa [spin, n13] using hActions.2.1
  have hComm31 : ringComm spin n31 =
      linkMetric23 (shell2 P₁ P₂) (shell3 P₂) C D * n31 -
        n31 * linkMetric12 (shell1 P₁) (shell2 P₁ P₂) A Bc := by
    simpa [spin, n31] using hActions.2.2.2
  have hAdd : ringComm spin (n13 + n31) =
      ringComm spin n13 + ringComm spin n31 := by
    unfold ringComm
    noncomm_ring
  have hSub : ringComm spin (n13 - n31) =
      ringComm spin n13 - ringComm spin n31 := by
    unfold ringComm
    noncomm_ring
  refine ⟨?_, ?_⟩
  · change ringComm
      (linkSpin12 (shell1 P₁) (shell2 P₁ P₂) A Bc -
        linkSpin23 (shell2 P₁ P₂) (shell3 P₂) C D)
      (edgeRoot13 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) A C +
        edgeRoot31 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) Bc D) = 0
    rw [hAdd, hComm13, hComm31, ← hBalance13, ← hBalance31]
    noncomm_ring
  · change ringComm
      (linkSpin12 (shell1 P₁) (shell2 P₁ P₂) A Bc -
        linkSpin23 (shell2 P₁ P₂) (shell3 P₂) C D)
      (edgeRoot13 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) A C -
        edgeRoot31 (shell1 P₁) (shell2 P₁ P₂) (shell3 P₂) Bc D) = 0
    rw [hSub, hComm13, hComm31, ← hBalance13, ← hBalance31]
    noncomm_ring

/-- The two-link idempotency defects retain both the edge bridge and the
linear operator term from `δ(T) = T² - T`. This is the precise defect
readout; neither defect is identified with a bulk-only quantity. -/
theorem zorn_kitaev_idempotency_defect_readout {E1 E2 E3 A Bc C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    idempotencyDefect (kitaevPhi23 E1 E2 E3 A Bc C D) =
      linkMetric12 E1 E2 A Bc + linkMetric23 E2 E3 C D +
        edgeMajoranaPhi13 E1 E2 E3 A Bc C D -
        kitaevPhi23 E1 E2 E3 A Bc C D ∧
    idempotencyDefect (kitaevJ23 E1 E2 E3 A Bc C D) =
      -(linkMetric12 E1 E2 A Bc + linkMetric23 E2 E3 C D) +
        edgeMajoranaPhi13 E1 E2 E3 A Bc C D -
        kitaevJ23 E1 E2 E3 A Bc C D := by
  have hxx : root12 E1 E2 A * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero h21
  have hyy : root21 E2 E1 Bc * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero h12
  have huu : root23 E2 E3 C * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero h32
  have hvv : root32 E3 E2 D * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero h23
  have hxv : root12 E1 E2 A * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero h23
  have hyu : root21 E2 E1 Bc * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero h12
  have hux : root23 E2 E3 C * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero h31
  have huy : root23 E2 E3 C * root21 E2 E1 Bc = 0 :=
    corner_arrows_mul_zero h32
  have hvx : root32 E3 E2 D * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero h21
  have hyv : root21 E2 E1 Bc * root32 E3 E2 D = 0 :=
    corner_arrows_mul_zero h13
  have hSquares := directed_two_link_square_laws hxx hyy huu hvv hxv hyu hux huy hvx hyv
  have hPhiSq : kitaevPhi23 E1 E2 E3 A Bc C D * kitaevPhi23 E1 E2 E3 A Bc C D =
      linkMetric12 E1 E2 A Bc + linkMetric23 E2 E3 C D +
        edgeMajoranaPhi13 E1 E2 E3 A Bc C D := by
    change (root12 E1 E2 A + root21 E2 E1 Bc + (root23 E2 E3 C + root32 E3 E2 D)) *
        (root12 E1 E2 A + root21 E2 E1 Bc + (root23 E2 E3 C + root32 E3 E2 D)) = _
    calc
      _ = root12 E1 E2 A * root21 E2 E1 Bc + root21 E2 E1 Bc * root12 E1 E2 A +
          root23 E2 E3 C * root32 E3 E2 D + root32 E3 E2 D * root23 E2 E3 C +
          root12 E1 E2 A * root23 E2 E3 C + root32 E3 E2 D * root21 E2 E1 Bc := hSquares.1
      _ = _ := by
        simp only [linkMetric12, linkMetric23, edgeMajoranaPhi13,
          edgeRoot13, edgeRoot31]
        abel
  have hJSq : kitaevJ23 E1 E2 E3 A Bc C D * kitaevJ23 E1 E2 E3 A Bc C D =
      -(linkMetric12 E1 E2 A Bc + linkMetric23 E2 E3 C D) +
        edgeMajoranaPhi13 E1 E2 E3 A Bc C D := by
    change (root12 E1 E2 A - root21 E2 E1 Bc + (root23 E2 E3 C - root32 E3 E2 D)) *
        (root12 E1 E2 A - root21 E2 E1 Bc + (root23 E2 E3 C - root32 E3 E2 D)) = _
    calc
      _ = -(root12 E1 E2 A * root21 E2 E1 Bc + root21 E2 E1 Bc * root12 E1 E2 A +
          root23 E2 E3 C * root32 E3 E2 D + root32 E3 E2 D * root23 E2 E3 C) +
          root12 E1 E2 A * root23 E2 E3 C + root32 E3 E2 D * root21 E2 E1 Bc := hSquares.2
      _ = _ := by simp [linkMetric12, linkMetric23, edgeMajoranaPhi13,
        edgeRoot13, edgeRoot31]; abel
  constructor
  · unfold idempotencyDefect
    rw [hPhiSq]
  · unfold idempotencyDefect
    rw [hJSq]

/-- Boundary bridge modes have no support in the middle corner. Therefore
they commute with every operator supported entirely in that corner. This is
an exact finite Peirce-algebra statement, with no dynamical or analytic claim. -/
theorem zorn_edge_modes_are_invisible_to_interior_corner
    {E1 E2 E3 A Bc C D X : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    E2 * edgeMajoranaPhi13 E1 E2 E3 A Bc C D = 0 ∧
    edgeMajoranaPhi13 E1 E2 E3 A Bc C D * E2 = 0 ∧
    E2 * edgeMajoranaJ13 E1 E2 E3 A Bc C D = 0 ∧
    edgeMajoranaJ13 E1 E2 E3 A Bc C D * E2 = 0 ∧
    ringComm (edgeMajoranaPhi13 E1 E2 E3 A Bc C D) (E2 * X * E2) = 0 ∧
    ringComm (edgeMajoranaJ13 E1 E2 E3 A Bc C D) (E2 * X * E2) = 0 ∧
    ringComm (edgeMetric13 E1 E2 E3 A Bc C D) (E2 * X * E2) = 0 ∧
    ringComm (edgeSpin13 E1 E2 E3 A Bc C D) (E2 * X * E2) = 0 := by
  have hE2n13 : E2 * edgeRoot13 E1 E2 E3 A C = 0 := by
    unfold edgeRoot13 root12 root23
    calc
      E2 * (E1 * A * E2 * (E2 * C * E3)) =
          (E2 * E1) * A * E2 * E2 * C * E3 := by noncomm_ring
      _ = 0 := by rw [h21]; simp
  have hn13E2 : edgeRoot13 E1 E2 E3 A C * E2 = 0 := by
    unfold edgeRoot13 root12 root23
    calc
      (E1 * A * E2 * (E2 * C * E3)) * E2 =
          E1 * A * E2 * E2 * C * (E3 * E2) := by noncomm_ring
      _ = 0 := by rw [h32]; simp
  have hE2n31 : E2 * edgeRoot31 E1 E2 E3 Bc D = 0 := by
    unfold edgeRoot31 root32 root21
    calc
      E2 * (E3 * D * E2 * (E2 * Bc * E1)) =
          (E2 * E3) * D * E2 * E2 * Bc * E1 := by noncomm_ring
      _ = 0 := by rw [h23]; simp
  have hn31E2 : edgeRoot31 E1 E2 E3 Bc D * E2 = 0 := by
    unfold edgeRoot31 root32 root21
    calc
      (E3 * D * E2 * (E2 * Bc * E1)) * E2 =
          E3 * D * E2 * E2 * Bc * (E1 * E2) := by noncomm_ring
      _ = 0 := by rw [h12]; simp
  have hE2Phi : E2 * edgeMajoranaPhi13 E1 E2 E3 A Bc C D = 0 := by
    unfold edgeMajoranaPhi13
    rw [mul_add, hE2n13, hE2n31, zero_add]
  have hPhiE2 : edgeMajoranaPhi13 E1 E2 E3 A Bc C D * E2 = 0 := by
    unfold edgeMajoranaPhi13
    rw [add_mul, hn13E2, hn31E2, zero_add]
  have hE2J : E2 * edgeMajoranaJ13 E1 E2 E3 A Bc C D = 0 := by
    unfold edgeMajoranaJ13
    rw [mul_sub, hE2n13, hE2n31, sub_zero]
  have hJE2 : edgeMajoranaJ13 E1 E2 E3 A Bc C D * E2 = 0 := by
    unfold edgeMajoranaJ13
    rw [sub_mul, hn13E2, hn31E2, zero_sub, neg_zero]
  have cornerComm {Z : B} (hLeft : E2 * Z = 0) (hRight : Z * E2 = 0) :
      ringComm Z (E2 * X * E2) = 0 := by
    unfold ringComm
    calc
      Z * (E2 * X * E2) - (E2 * X * E2) * Z =
          (Z * E2) * (X * E2) - (E2 * X) * (E2 * Z) := by noncomm_ring
      _ = 0 := by rw [hRight, hLeft]; simp
  refine ⟨hE2Phi, hPhiE2, hE2J, hJE2, cornerComm hE2Phi hPhiE2,
    cornerComm hE2J hJE2, ?_, ?_⟩
  · apply cornerComm
    · unfold edgeMetric13
      calc
        E2 * (edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D +
            edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C) =
          (E2 * edgeRoot13 E1 E2 E3 A C) * edgeRoot31 E1 E2 E3 Bc D +
            (E2 * edgeRoot31 E1 E2 E3 Bc D) * edgeRoot13 E1 E2 E3 A C := by noncomm_ring
        _ = 0 := by rw [hE2n13, hE2n31]; simp
    · unfold edgeMetric13
      calc
        (edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D +
            edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C) * E2 =
          edgeRoot13 E1 E2 E3 A C * (edgeRoot31 E1 E2 E3 Bc D * E2) +
            edgeRoot31 E1 E2 E3 Bc D * (edgeRoot13 E1 E2 E3 A C * E2) := by noncomm_ring
        _ = 0 := by rw [hn31E2, hn13E2]; simp
  · apply cornerComm
    · unfold edgeSpin13
      calc
        E2 * (edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D -
            edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C) =
          (E2 * edgeRoot13 E1 E2 E3 A C) * edgeRoot31 E1 E2 E3 Bc D -
            (E2 * edgeRoot31 E1 E2 E3 Bc D) * edgeRoot13 E1 E2 E3 A C := by noncomm_ring
        _ = 0 := by rw [hE2n13, hE2n31]; simp
    · unfold edgeSpin13
      calc
        (edgeRoot13 E1 E2 E3 A C * edgeRoot31 E1 E2 E3 Bc D -
            edgeRoot31 E1 E2 E3 Bc D * edgeRoot13 E1 E2 E3 A C) * E2 =
          edgeRoot13 E1 E2 E3 A C * (edgeRoot31 E1 E2 E3 Bc D * E2) -
            edgeRoot31 E1 E2 E3 Bc D * (edgeRoot13 E1 E2 E3 A C * E2) := by noncomm_ring
        _ = 0 := by rw [hn31E2, hn13E2]; simp

/-- A111's edge/bulk decoupling specialized to the interior shell of a
nested idempotent pair. The conclusion is zero support and commutation for
all compressed bulk observables in that shell. -/
theorem nested_zorn_edge_modes_are_invisible_to_interior_corner
    {P₁ P₂ A Bc C D X : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    E₂ * edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D = 0 ∧
    edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D * E₂ = 0 ∧
    E₂ * edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D = 0 ∧
    edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D * E₂ = 0 ∧
    ringComm (edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D) (E₂ * X * E₂) = 0 ∧
    ringComm (edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D) (E₂ * X * E₂) = 0 ∧
    ringComm (edgeMetric13 E₁ E₂ E₃ A Bc C D) (E₂ * X * E₂) = 0 ∧
    ringComm (edgeSpin13 E₁ E₂ E₃ A Bc C D) (E₂ * X * E₂) = 0 := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, _, _, h23, h32⟩
  exact zorn_edge_modes_are_invisible_to_interior_corner
    h12 h21 h23 h32

/-- The boundary bridge operators annihilate every observable supported in
the middle corner on both sides. This strengthens commutation with the
interior corner to a zero-product statement, so their anticommutators with
such observables vanish as well. -/
theorem zorn_edge_modes_annihilate_interior_corner
    {E1 E2 E3 A Bc C D X : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    edgeMajoranaPhi13 E1 E2 E3 A Bc C D * (E2 * X * E2) = 0 ∧
    (E2 * X * E2) * edgeMajoranaPhi13 E1 E2 E3 A Bc C D = 0 ∧
    edgeMajoranaJ13 E1 E2 E3 A Bc C D * (E2 * X * E2) = 0 ∧
    (E2 * X * E2) * edgeMajoranaJ13 E1 E2 E3 A Bc C D = 0 := by
  rcases zorn_edge_modes_are_invisible_to_interior_corner
      (E1 := E1) (E2 := E2) (E3 := E3) (A := A) (Bc := Bc)
      (C := C) (D := D) (X := X) h12 h21 h23 h32 with
    ⟨hPhiL, hPhiR, hJL, hJR, hPhiComm, hJComm, _, _⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc
      edgeMajoranaPhi13 E1 E2 E3 A Bc C D * (E2 * X * E2) =
          (edgeMajoranaPhi13 E1 E2 E3 A Bc C D * E2) * (X * E2) := by
            noncomm_ring
      _ = 0 := by rw [hPhiR]; simp
  · calc
      (E2 * X * E2) * edgeMajoranaPhi13 E1 E2 E3 A Bc C D =
          (E2 * X) * (E2 * edgeMajoranaPhi13 E1 E2 E3 A Bc C D) := by
            noncomm_ring
      _ = 0 := by rw [hPhiL]; simp
  · calc
      edgeMajoranaJ13 E1 E2 E3 A Bc C D * (E2 * X * E2) =
          (edgeMajoranaJ13 E1 E2 E3 A Bc C D * E2) * (X * E2) := by
            noncomm_ring
      _ = 0 := by rw [hJR]; simp
  · calc
      (E2 * X * E2) * edgeMajoranaJ13 E1 E2 E3 A Bc C D =
          (E2 * X) * (E2 * edgeMajoranaJ13 E1 E2 E3 A Bc C D) := by
            noncomm_ring
      _ = 0 := by rw [hJL]; simp

/-- The edge modes anticommute with every observable compressed to the
middle corner.  This is the literal zero-product consequence of the stronger
two-sided annihilation theorem, not a graded-commutation convention. -/
theorem zorn_edge_modes_anticommute_with_interior_corner
    {E1 E2 E3 A Bc C D X : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    edgeMajoranaPhi13 E1 E2 E3 A Bc C D * (E2 * X * E2) +
        (E2 * X * E2) * edgeMajoranaPhi13 E1 E2 E3 A Bc C D = 0 ∧
    edgeMajoranaJ13 E1 E2 E3 A Bc C D * (E2 * X * E2) +
        (E2 * X * E2) * edgeMajoranaJ13 E1 E2 E3 A Bc C D = 0 := by
  rcases zorn_edge_modes_annihilate_interior_corner
      h12 h21 h23 h32 with
    ⟨hPhiL, hPhiR, hJL, hJR⟩
  exact ⟨by rw [hPhiL, hPhiR]; simp, by rw [hJL, hJR]; simp⟩

/-- The direct two-sided annihilation law for both endpoint Majorana modes
against every compressed observable in the middle shell of a nested flag. -/
theorem nested_zorn_edge_modes_annihilate_interior_corner
    {P₁ P₂ A Bc C D X : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D * (E₂ * X * E₂) = 0 ∧
    (E₂ * X * E₂) * edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D = 0 ∧
    edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D * (E₂ * X * E₂) = 0 ∧
    (E₂ * X * E₂) * edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D = 0 := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, h13, h31, h23, h32⟩
  exact zorn_edge_modes_annihilate_interior_corner
    h12 h21 h23 h32

/-- A111's anticommutation statement for the shells of an actual nested
idempotent pair. -/
theorem nested_zorn_edge_modes_anticommute_with_interior_corner
    {P₁ P₂ A Bc C D X : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D * (E₂ * X * E₂) +
        (E₂ * X * E₂) * edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D = 0 ∧
    edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D * (E₂ * X * E₂) +
        (E₂ * X * E₂) * edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D = 0 := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, _, _, h23, h32⟩
  exact zorn_edge_modes_anticommute_with_interior_corner
    h12 h21 h23 h32

/-- All four operators in the endpoint tetraktys have zero products, hence
zero anticommutator, with every observable compressed to the middle corner.
This records the stronger A111 claim for the metric and spin bilinears as
well as for the two Majorana modes. -/
theorem zorn_edge_tetraktys_anticommutes_with_interior_corner
    {E1 E2 E3 A Bc C D X : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    edgeMajoranaPhi13 E1 E2 E3 A Bc C D * (E2 * X * E2) +
        (E2 * X * E2) * edgeMajoranaPhi13 E1 E2 E3 A Bc C D = 0 ∧
    edgeMajoranaJ13 E1 E2 E3 A Bc C D * (E2 * X * E2) +
        (E2 * X * E2) * edgeMajoranaJ13 E1 E2 E3 A Bc C D = 0 ∧
    edgeMetric13 E1 E2 E3 A Bc C D * (E2 * X * E2) +
        (E2 * X * E2) * edgeMetric13 E1 E2 E3 A Bc C D = 0 ∧
    edgeSpin13 E1 E2 E3 A Bc C D * (E2 * X * E2) +
        (E2 * X * E2) * edgeSpin13 E1 E2 E3 A Bc C D = 0 := by
  let u := edgeRoot13 E1 E2 E3 A C
  let v := edgeRoot31 E1 E2 E3 Bc D
  have huL : E2 * u = 0 := by
    dsimp [u, edgeRoot13, root12, root23]
    calc
      E2 * (E1 * A * E2 * (E2 * C * E3)) =
          (E2 * E1) * A * E2 * E2 * C * E3 := by noncomm_ring
      _ = 0 := by rw [h21]; simp
  have huR : u * E2 = 0 := by
    dsimp [u, edgeRoot13, root12, root23]
    calc
      (E1 * A * E2 * (E2 * C * E3)) * E2 =
          E1 * A * E2 * E2 * C * (E3 * E2) := by noncomm_ring
      _ = 0 := by rw [h32]; simp
  have hvL : E2 * v = 0 := by
    dsimp [v, edgeRoot31, root32, root21]
    calc
      E2 * (E3 * D * E2 * (E2 * Bc * E1)) =
          (E2 * E3) * D * E2 * E2 * Bc * E1 := by noncomm_ring
      _ = 0 := by rw [h23]; simp
  have hvR : v * E2 = 0 := by
    dsimp [v, edgeRoot31, root32, root21]
    calc
      (E3 * D * E2 * (E2 * Bc * E1)) * E2 =
          E3 * D * E2 * E2 * Bc * (E1 * E2) := by noncomm_ring
      _ = 0 := by rw [h12]; simp
  have hPhiL : E2 * edgeMajoranaPhi13 E1 E2 E3 A Bc C D = 0 := by
    change E2 * (u + v) = 0
    rw [mul_add, huL, hvL]
    simp
  have hPhiR : edgeMajoranaPhi13 E1 E2 E3 A Bc C D * E2 = 0 := by
    change (u + v) * E2 = 0
    rw [add_mul, huR, hvR]
    simp
  have hJL : E2 * edgeMajoranaJ13 E1 E2 E3 A Bc C D = 0 := by
    change E2 * (u - v) = 0
    rw [mul_sub, huL, hvL]
    simp
  have hJR : edgeMajoranaJ13 E1 E2 E3 A Bc C D * E2 = 0 := by
    change (u - v) * E2 = 0
    rw [sub_mul, huR, hvR]
    simp
  have hVL : E2 * edgeMetric13 E1 E2 E3 A Bc C D = 0 := by
    change E2 * (u * v + v * u) = 0
    calc
      E2 * (u * v + v * u) = (E2 * u) * v + (E2 * v) * u := by noncomm_ring
      _ = 0 := by rw [huL, hvL]; simp
  have hVR : edgeMetric13 E1 E2 E3 A Bc C D * E2 = 0 := by
    change (u * v + v * u) * E2 = 0
    calc
      (u * v + v * u) * E2 = u * (v * E2) + v * (u * E2) := by noncomm_ring
      _ = 0 := by rw [hvR, huR]; simp
  have hSigmaL : E2 * edgeSpin13 E1 E2 E3 A Bc C D = 0 := by
    change E2 * (u * v - v * u) = 0
    calc
      E2 * (u * v - v * u) = (E2 * u) * v - (E2 * v) * u := by noncomm_ring
      _ = 0 := by rw [huL, hvL]; simp
  have hSigmaR : edgeSpin13 E1 E2 E3 A Bc C D * E2 = 0 := by
    change (u * v - v * u) * E2 = 0
    calc
      (u * v - v * u) * E2 = u * (v * E2) - v * (u * E2) := by noncomm_ring
      _ = 0 := by rw [hvR, huR]; simp
  have hAnti {Z : B} (hL : E2 * Z = 0) (hR : Z * E2 = 0) :
      Z * (E2 * X * E2) + (E2 * X * E2) * Z = 0 := by
    calc
      Z * (E2 * X * E2) + (E2 * X * E2) * Z =
          (Z * E2) * (X * E2) + (E2 * X) * (E2 * Z) := by noncomm_ring
      _ = 0 := by rw [hR, hL]; simp
  exact ⟨hAnti hPhiL hPhiR, hAnti hJL hJR,
    hAnti hVL hVR, hAnti hSigmaL hSigmaR⟩

/-- Four-operator edge/bulk anticommutation specialized to the shell
partition determined by a nested idempotent flag. -/
theorem nested_zorn_edge_tetraktys_anticommutes_with_interior_corner
    {P₁ P₂ A Bc C D X : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D * (E₂ * X * E₂) +
        (E₂ * X * E₂) * edgeMajoranaPhi13 E₁ E₂ E₃ A Bc C D = 0 ∧
    edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D * (E₂ * X * E₂) +
        (E₂ * X * E₂) * edgeMajoranaJ13 E₁ E₂ E₃ A Bc C D = 0 ∧
    edgeMetric13 E₁ E₂ E₃ A Bc C D * (E₂ * X * E₂) +
        (E₂ * X * E₂) * edgeMetric13 E₁ E₂ E₃ A Bc C D = 0 ∧
    edgeSpin13 E₁ E₂ E₃ A Bc C D * (E₂ * X * E₂) +
        (E₂ * X * E₂) * edgeSpin13 E₁ E₂ E₃ A Bc C D = 0 := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, _, _, h23, h32⟩
  exact zorn_edge_tetraktys_anticommutes_with_interior_corner
    h12 h21 h23 h32

/-- Directed three-corner cycle formed from the three cyclic root arrows. -/
def zornCycle3 (E1 E2 E3 A C D : B) : B :=
  root12 E1 E2 A + root23 E2 E3 C + root31 E3 E1 D

/-- The diagonal return term of a closed three-corner cycle. It is a sum of
corner elements; idempotence is not asserted without additional hypotheses. -/
def zornCycleMass3 (E1 E2 E3 A C D : B) : B :=
  root12 E1 E2 A * root23 E2 E3 C * root31 E3 E1 D +
  root23 E2 E3 C * root31 E3 E1 D * root12 E1 E2 A +
  root31 E3 E1 D * root12 E1 E2 A * root23 E2 E3 C

def zornCycleReynolds3 (Ω X : B) : B :=
  Ω * Ω * X + Ω * X * Ω + X * Ω * Ω

/-- The finite polynomial remainder identity is valid in every associative
ring: the cubic defect from the order-three relation is exactly `1 - Ω³`. -/
theorem cycle_cyclotomic_remainders (Ω : B) :
    (1 - Ω) * chainCyclo3 Ω = 1 - Ω * Ω * Ω ∧
    (1 + Ω) * chainCyclo6 Ω = 1 + Ω * Ω * Ω := by
  constructor <;> dsimp [chainCyclo3, chainCyclo6] <;> noncomm_ring

/-- The product of the third and sixth cyclotomic evaluations is
`1 + Ω² + Ω⁴`; multiplying by `1 - Ω²` gives the sixth-power remainder. -/
theorem cycle_cyclotomic_norm_remainder (Ω : B) :
    (1 - Ω * Ω) * (chainCyclo3 Ω * chainCyclo6 Ω) =
      1 - Ω * Ω * Ω * Ω * Ω * Ω := by
  dsimp [chainCyclo3, chainCyclo6]
  noncomm_ring

/-- The cube of the closed cycle is the sum of its three directed closed
paths, under an orthogonal three-idempotent decomposition. -/
theorem zorn_cycle3_cube {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D *
        zornCycle3 E1 E2 E3 A C D = zornCycleMass3 E1 E2 E3 A C D := by
  let u := root12 E1 E2 A
  let v := root23 E2 E3 C
  let w := root31 E3 E1 D
  have huu : u * u = 0 := by
    dsimp [u, root12]
    calc
      E1 * A * E2 * (E1 * A * E2) = E1 * A * (E2 * E1) * A * E2 := by
        simp only [← mul_assoc]
      _ = 0 := by rw [h21]; noncomm_ring
  have hvv : v * v = 0 := by
    dsimp [v, root23]
    calc
      E2 * C * E3 * (E2 * C * E3) = E2 * C * (E3 * E2) * C * E3 := by
        simp only [← mul_assoc]
      _ = 0 := by rw [h32]; noncomm_ring
  have hww : w * w = 0 := by
    dsimp [w, root31]
    calc
      E3 * D * E1 * (E3 * D * E1) = E3 * D * (E1 * E3) * D * E1 := by
        simp only [← mul_assoc]
      _ = 0 := by rw [h13]; noncomm_ring
  have hvu : v * u = 0 := by
    dsimp [u, v, root12, root23]
    calc
      E2 * C * E3 * (E1 * A * E2) = E2 * C * (E3 * E1) * A * E2 := by
        simp only [← mul_assoc]
      _ = 0 := by rw [h31]; noncomm_ring
  have hwv : w * v = 0 := by
    dsimp [v, w, root23, root31]
    calc
      E3 * D * E1 * (E2 * C * E3) = E3 * D * (E1 * E2) * C * E3 := by
        noncomm_ring
      _ = 0 := by rw [h12]; noncomm_ring
  have huw : u * w = 0 := by
    dsimp [u, w, root12, root31]
    calc
      E1 * A * E2 * (E3 * D * E1) = E1 * A * (E2 * E3) * D * E1 := by
        simp only [← mul_assoc]
      _ = 0 := by rw [h23]; noncomm_ring
  change (u + v + w) * (u + v + w) * (u + v + w) =
    u * v * w + v * w * u + w * u * v
  noncomm_ring [huu, hvv, hww, hvu, hwv, huw]

/-- The cyclotomic remainders of a closed Peirce cycle are exactly the
cycle-mass defects. This keeps the return operator `zornCycleMass3` visible
instead of assuming the cycle is already a root of unity. -/
theorem zorn_cycle3_cyclotomic_remainders {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    (1 - zornCycle3 E1 E2 E3 A C D) *
        chainCyclo3 (zornCycle3 E1 E2 E3 A C D) =
      1 - zornCycleMass3 E1 E2 E3 A C D ∧
    (1 + zornCycle3 E1 E2 E3 A C D) *
        chainCyclo6 (zornCycle3 E1 E2 E3 A C D) =
      1 + zornCycleMass3 E1 E2 E3 A C D := by
  have hminus := (cycle_cyclotomic_remainders (zornCycle3 E1 E2 E3 A C D)).1
  have hplus := (cycle_cyclotomic_remainders (zornCycle3 E1 E2 E3 A C D)).2
  have hcube := zorn_cycle3_cube (E1 := E1) (E2 := E2) (E3 := E3)
    (A := A) (C := C) (D := D)
    h12 h21 h13 h31 h23 h32
  constructor
  · calc
      (1 - zornCycle3 E1 E2 E3 A C D) *
          chainCyclo3 (zornCycle3 E1 E2 E3 A C D) =
          1 - zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D *
            zornCycle3 E1 E2 E3 A C D := hminus
      _ = 1 - zornCycleMass3 E1 E2 E3 A C D := by rw [hcube]
  · calc
      (1 + zornCycle3 E1 E2 E3 A C D) *
          chainCyclo6 (zornCycle3 E1 E2 E3 A C D) =
          1 + zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D *
            zornCycle3 E1 E2 E3 A C D := hplus
      _ = 1 + zornCycleMass3 E1 E2 E3 A C D := by rw [hcube]

/-- On a closed three-corner cycle, the sixth-power cyclotomic remainder is
the idempotency-defect polynomial of the return mass, with no assumption
that the return mass is a scalar or a unit. -/
theorem zorn_cycle3_cyclotomic_norm_remainder {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    let Ω := zornCycle3 E1 E2 E3 A C D
    let V := zornCycleMass3 E1 E2 E3 A C D
    (1 - Ω * Ω) * (chainCyclo3 Ω * chainCyclo6 Ω) = 1 - V * V := by
  intro Ω V
  have hcube := zorn_cycle3_cube (A := A) (C := C) (D := D)
    h12 h21 h13 h31 h23 h32
  have hsix : Ω * Ω * Ω * Ω * Ω * Ω = V * V := by
    change zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D *
      zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D *
      zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D =
      zornCycleMass3 E1 E2 E3 A C D * zornCycleMass3 E1 E2 E3 A C D
    rw [← hcube]
    noncomm_ring
  calc
    (1 - Ω * Ω) * (chainCyclo3 Ω * chainCyclo6 Ω) =
        1 - Ω * Ω * Ω * Ω * Ω * Ω := cycle_cyclotomic_norm_remainder Ω
    _ = 1 - V * V := by rw [hsix]

/-- Under the same corner orthogonality, the cycle mass commutes with the
cycle operator. -/
theorem zorn_cycle3_mass_commutes_with_clock {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    ringComm (zornCycleMass3 E1 E2 E3 A C D)
      (zornCycle3 E1 E2 E3 A C D) = 0 := by
  rw [← zorn_cycle3_cube h12 h21 h13 h31 h23 h32]
  dsimp [ringComm]
  noncomm_ring

/-- The three cyclic length-three return paths are pairwise annihilating
under the square-zero and reverse-direction path relations. -/
theorem cyclic_path_primes_pairwise_annihilate {u v w : B}
    (huu : u * u = 0) (hvv : v * v = 0) (hww : w * w = 0)
    (hvu : v * u = 0) (hwv : w * v = 0) (huw : u * w = 0) :
    (u * v * w) * (v * w * u) = 0 ∧
    (u * v * w) * (w * u * v) = 0 ∧
    (v * w * u) * (u * v * w) = 0 ∧
    (v * w * u) * (w * u * v) = 0 ∧
    (w * u * v) * (u * v * w) = 0 ∧
    (w * u * v) * (v * w * u) = 0 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · calc
      (u * v * w) * (v * w * u) = u * v * (w * v) * w * u := by noncomm_ring
      _ = 0 := by rw [hwv]; noncomm_ring
  · calc
      (u * v * w) * (w * u * v) = u * v * (w * w) * u * v := by noncomm_ring
      _ = 0 := by rw [hww]; noncomm_ring
  · calc
      (v * w * u) * (u * v * w) = v * w * (u * u) * v * w := by noncomm_ring
      _ = 0 := by rw [huu]; noncomm_ring
  · calc
      (v * w * u) * (w * u * v) = v * w * (u * w) * u * v := by noncomm_ring
      _ = 0 := by rw [huw]; noncomm_ring
  · calc
      (w * u * v) * (u * v * w) = w * u * (v * u) * v * w := by noncomm_ring
      _ = 0 := by rw [hvu]; noncomm_ring
  · calc
      (w * u * v) * (v * w * u) = w * u * (v * v) * w * u := by noncomm_ring
      _ = 0 := by rw [hvv]; noncomm_ring

/-- The Euler product of the three cyclic return-path factors is `1` minus
their sum. Pairwise annihilation is the precise hypothesis; no claim that
the sum is an idempotent or a unit is implicit. -/
theorem cyclic_path_prime_euler_product {u v w : B}
    (hww : w * w = 0) (hwv : w * v = 0) (huw : u * w = 0) :
    (1 - u * v * w) * (1 - v * w * u) * (1 - w * u * v) =
      1 - (u * v * w + v * w * u + w * u * v) := by
  let x := u * v * w
  let y := v * w * u
  let z := w * u * v
  have hxy : x * y = 0 := by
    dsimp [x, y]
    calc
      (u * v * w) * (v * w * u) = u * v * (w * v) * w * u := by noncomm_ring
      _ = 0 := by rw [hwv]; noncomm_ring
  have hxz : x * z = 0 := by
    dsimp [x, z]
    calc
      (u * v * w) * (w * u * v) = u * v * (w * w) * u * v := by noncomm_ring
      _ = 0 := by rw [hww]; noncomm_ring
  have hyz : y * z = 0 := by
    dsimp [y, z]
    calc
      (v * w * u) * (w * u * v) = v * w * (u * w) * u * v := by noncomm_ring
      _ = 0 := by rw [huw]; noncomm_ring
  change (1 - x) * (1 - y) * (1 - z) = 1 - (x + y + z)
  calc
    (1 - x) * (1 - y) * (1 - z) = (1 - x - y) * (1 - z) := by
      noncomm_ring [hxy]
    _ = 1 - x - y - z := by noncomm_ring [hxz, hyz]
    _ = 1 - (x + y + z) := by noncomm_ring

/-- Specialization of the cyclic-prime Euler product to three orthogonal
Peirce corners. -/
theorem zorn_cycle3_prime_euler_product {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h13 : E1 * E3 = 0)
    (h23 : E2 * E3 = 0) :
    (1 - root12 E1 E2 A * root23 E2 E3 C * root31 E3 E1 D) *
      (1 - root23 E2 E3 C * root31 E3 E1 D * root12 E1 E2 A) *
      (1 - root31 E3 E1 D * root12 E1 E2 A * root23 E2 E3 C) =
        1 - zornCycleMass3 E1 E2 E3 A C D := by
  let u := root12 E1 E2 A
  let v := root23 E2 E3 C
  let w := root31 E3 E1 D
  have hww : w * w = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E1) (g := E3) (h := E1)
      (a := D) (b := D) h13
  have hwv : w * v = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E1) (g := E2) (h := E3)
      (a := D) (b := C) h12
  have huw : u * w = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E3) (h := E1)
      (a := A) (b := D) h23
  simpa [u, v, w, zornCycleMass3] using
    cyclic_path_prime_euler_product hww hwv huw

/-- The three closed return paths in orthogonal Peirce corners annihilate
pairwise in both orders. -/
theorem zorn_cycle3_primes_pairwise_orthogonal {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    (root12 E1 E2 A * root23 E2 E3 C * root31 E3 E1 D) *
        (root23 E2 E3 C * root31 E3 E1 D * root12 E1 E2 A) = 0 ∧
    (root12 E1 E2 A * root23 E2 E3 C * root31 E3 E1 D) *
        (root31 E3 E1 D * root12 E1 E2 A * root23 E2 E3 C) = 0 ∧
    (root23 E2 E3 C * root31 E3 E1 D * root12 E1 E2 A) *
        (root12 E1 E2 A * root23 E2 E3 C * root31 E3 E1 D) = 0 ∧
    (root23 E2 E3 C * root31 E3 E1 D * root12 E1 E2 A) *
        (root31 E3 E1 D * root12 E1 E2 A * root23 E2 E3 C) = 0 ∧
    (root31 E3 E1 D * root12 E1 E2 A * root23 E2 E3 C) *
        (root12 E1 E2 A * root23 E2 E3 C * root31 E3 E1 D) = 0 ∧
    (root31 E3 E1 D * root12 E1 E2 A * root23 E2 E3 C) *
        (root23 E2 E3 C * root31 E3 E1 D * root12 E1 E2 A) = 0 := by
  have huu : root12 E1 E2 A * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E1) (h := E2)
      (a := A) (b := A) h21
  have hvv : root23 E2 E3 C * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E2) (h := E3)
      (a := C) (b := C) h32
  have hww : root31 E3 E1 D * root31 E3 E1 D = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E1) (g := E3) (h := E1)
      (a := D) (b := D) h13
  have hvu : root23 E2 E3 C * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E1) (h := E2)
      (a := C) (b := A) h31
  have hwv : root31 E3 E1 D * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E1) (g := E2) (h := E3)
      (a := D) (b := C) h12
  have huw : root12 E1 E2 A * root31 E3 E1 D = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E3) (h := E1)
      (a := A) (b := D) h23
  simpa using cyclic_path_primes_pairwise_annihilate huu hvv hww hvu hwv huw

/-- A107's six prime-orthogonality laws and Euler product, specialized to
the shells of a nested idempotent pair. -/
theorem nested_zorn_cycle3_prime_euler_and_orthogonality
    {P₁ P₂ A C D : B} (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    let Q₁ := root12 E₁ E₂ A * root23 E₂ E₃ C * root31 E₃ E₁ D
    let Q₂ := root23 E₂ E₃ C * root31 E₃ E₁ D * root12 E₁ E₂ A
    let Q₃ := root31 E₃ E₁ D * root12 E₁ E₂ A * root23 E₂ E₃ C
    Q₁ * Q₂ = 0 ∧ Q₁ * Q₃ = 0 ∧ Q₂ * Q₁ = 0 ∧
    Q₂ * Q₃ = 0 ∧ Q₃ * Q₁ = 0 ∧ Q₃ * Q₂ = 0 ∧
    (1 - Q₁) * (1 - Q₂) * (1 - Q₃) =
      1 - zornCycleMass3 E₁ E₂ E₃ A C D := by
  intro E₁ E₂ E₃ Q₁ Q₂ Q₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, _, _, _, h12, h21, h13, h31, h23, h32⟩
  have hOrth := zorn_cycle3_primes_pairwise_orthogonal
    (E1 := E₁) (E2 := E₂) (E3 := E₃) (A := A) (C := C) (D := D)
    h12 h21 h13 h31 h23 h32
  have hEuler := zorn_cycle3_prime_euler_product
    (E1 := E₁) (E2 := E₂) (E3 := E₃) (A := A) (C := C) (D := D)
    h12 h13 h23
  exact ⟨hOrth.1, hOrth.2.1, hOrth.2.2.1, hOrth.2.2.2.1,
    hOrth.2.2.2.2.1, hOrth.2.2.2.2.2, hEuler⟩

/-- The sum of the three cyclic length-three paths commutes with each arrow
whenever the arrows are square-zero and multiply only in the displayed
cyclic direction. -/
theorem cyclic_path_mass_commutes_with_arrows {u v w : B}
    (huu : u * u = 0) (hvv : v * v = 0) (hww : w * w = 0)
    (hvu : v * u = 0) (hwv : w * v = 0) (huw : u * w = 0) :
    ringComm (u * v * w + v * w * u + w * u * v) u = 0 ∧
    ringComm (u * v * w + v * w * u + w * u * v) v = 0 ∧
    ringComm (u * v * w + v * w * u + w * u * v) w = 0 := by
  have hU1 : v * w * u * u = 0 := by
    calc
      v * w * u * u = v * w * (u * u) := by noncomm_ring
      _ = 0 := by rw [huu]; simp
  have hU2 : w * u * v * u = 0 := by
    calc
      w * u * v * u = w * u * (v * u) := by noncomm_ring
      _ = 0 := by rw [hvu]; simp
  have hU3 : u * u * v * w = 0 := by
    calc
      u * u * v * w = (u * u) * v * w := by noncomm_ring
      _ = 0 := by rw [huu]; simp
  have hU4 : u * w * u * v = 0 := by
    calc
      u * w * u * v = (u * w) * u * v := by noncomm_ring
      _ = 0 := by rw [huw]; simp
  have hV1 : u * v * w * v = 0 := by
    calc
      u * v * w * v = u * v * (w * v) := by noncomm_ring
      _ = 0 := by rw [hwv]; simp
  have hV2 : w * u * v * v = 0 := by
    calc
      w * u * v * v = w * u * (v * v) := by noncomm_ring
      _ = 0 := by rw [hvv]; simp
  have hV3 : v * u * v * w = 0 := by
    calc
      v * u * v * w = (v * u) * v * w := by noncomm_ring
      _ = 0 := by rw [hvu]; simp
  have hV4 : v * v * w * u = 0 := by
    calc
      v * v * w * u = (v * v) * w * u := by noncomm_ring
      _ = 0 := by rw [hvv]; simp
  have hW1 : u * v * w * w = 0 := by
    calc
      u * v * w * w = u * v * (w * w) := by noncomm_ring
      _ = 0 := by rw [hww]; simp
  have hW2 : v * w * u * w = 0 := by
    calc
      v * w * u * w = v * w * (u * w) := by noncomm_ring
      _ = 0 := by rw [huw]; simp
  have hW3 : w * v * w * u = 0 := by
    calc
      w * v * w * u = (w * v) * w * u := by noncomm_ring
      _ = 0 := by rw [hwv]; simp
  have hW4 : w * w * u * v = 0 := by
    calc
      w * w * u * v = (w * w) * u * v := by noncomm_ring
      _ = 0 := by rw [hww]; simp
  refine ⟨?_, ?_, ?_⟩
  · dsimp [ringComm]
    calc
      (u * v * w + v * w * u + w * u * v) * u -
          u * (u * v * w + v * w * u + w * u * v) =
        v * w * u * u + w * u * v * u - (u * u * v * w + u * w * u * v) := by
          noncomm_ring
      _ = 0 := by rw [hU1, hU2, hU3, hU4]; simp
  · dsimp [ringComm]
    calc
      (u * v * w + v * w * u + w * u * v) * v -
          v * (u * v * w + v * w * u + w * u * v) =
        u * v * w * v + w * u * v * v - (v * u * v * w + v * v * w * u) := by
          noncomm_ring
      _ = 0 := by rw [hV1, hV2, hV3, hV4]; simp
  · dsimp [ringComm]
    calc
      (u * v * w + v * w * u + w * u * v) * w -
          w * (u * v * w + v * w * u + w * u * v) =
        u * v * w * w + v * w * u * w - (w * v * w * u + w * w * u * v) := by
          noncomm_ring
      _ = 0 := by rw [hW1, hW2, hW3, hW4]; simp

/-- The cyclic return mass also commutes with each directed arrow. The
identities are cyclic reassociations of the length-four paths; no equality
between the three diagonal loop terms is needed. -/
theorem zorn_cycle3_mass_commutes_with_arrows {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    ringComm (zornCycleMass3 E1 E2 E3 A C D) (root12 E1 E2 A) = 0 ∧
    ringComm (zornCycleMass3 E1 E2 E3 A C D) (root23 E2 E3 C) = 0 ∧
    ringComm (zornCycleMass3 E1 E2 E3 A C D) (root31 E3 E1 D) = 0 := by
  have huu : root12 E1 E2 A * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E1) (h := E2)
      (a := A) (b := A) h21
  have hvv : root23 E2 E3 C * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E2) (h := E3)
      (a := C) (b := C) h32
  have hww : root31 E3 E1 D * root31 E3 E1 D = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E1) (g := E3) (h := E1)
      (a := D) (b := D) h13
  have hvu : root23 E2 E3 C * root12 E1 E2 A = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E1) (h := E2)
      (a := C) (b := A) h31
  have hwv : root31 E3 E1 D * root23 E2 E3 C = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E1) (g := E2) (h := E3)
      (a := D) (b := C) h12
  have huw : root12 E1 E2 A * root31 E3 E1 D = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E3) (h := E1)
      (a := A) (b := D) h23
  have hcycle := cyclic_path_mass_commutes_with_arrows huu hvv hww hvu hwv huw
  refine ⟨?_, ?_, ?_⟩
  · change ringComm (root12 E1 E2 A * root23 E2 E3 C * root31 E3 E1 D +
      root23 E2 E3 C * root31 E3 E1 D * root12 E1 E2 A +
      root31 E3 E1 D * root12 E1 E2 A * root23 E2 E3 C) (root12 E1 E2 A) = 0
    exact hcycle.1
  · change ringComm (root12 E1 E2 A * root23 E2 E3 C * root31 E3 E1 D +
      root23 E2 E3 C * root31 E3 E1 D * root12 E1 E2 A +
      root31 E3 E1 D * root12 E1 E2 A * root23 E2 E3 C) (root23 E2 E3 C) = 0
    exact hcycle.2.1
  · change ringComm (root12 E1 E2 A * root23 E2 E3 C * root31 E3 E1 D +
      root23 E2 E3 C * root31 E3 E1 D * root12 E1 E2 A +
      root31 E3 E1 D * root12 E1 E2 A * root23 E2 E3 C) (root31 E3 E1 D) = 0
    exact hcycle.2.2

/-- The closed-cycle cube and centralizer laws specialize to the three
orthogonal shells cut out by a nested pair of idempotents. -/
theorem nested_zorn_cycle3_cube_and_mass_centralizer
    {P₁ P₂ : B} (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) (A C D : B) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    let Ω := zornCycle3 E₁ E₂ E₃ A C D
    let V := zornCycleMass3 E₁ E₂ E₃ A C D
    Ω * Ω * Ω = V ∧
    ringComm V (root12 E₁ E₂ A) = 0 ∧
    ringComm V (root23 E₂ E₃ C) = 0 ∧
    ringComm V (root31 E₃ E₁ D) = 0 ∧
    ringComm V Ω = 0 := by
  intro E₁ E₂ E₃ Ω V
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, hE₁, hE₂, hE₃, h12, h21, h13, h31, h23, h32⟩
  have hCube := zorn_cycle3_cube (E1 := E₁) (E2 := E₂) (E3 := E₃)
    (A := A) (C := C) (D := D) h12 h21 h13 h31 h23 h32
  have hCentral := zorn_cycle3_mass_commutes_with_arrows
    (E1 := E₁) (E2 := E₂) (E3 := E₃) (A := A) (C := C) (D := D)
    h12 h21 h13 h31 h23 h32
  have hSum : ringComm V
      (root12 E₁ E₂ A + root23 E₂ E₃ C + root31 E₃ E₁ D) =
      ringComm V (root12 E₁ E₂ A) + ringComm V (root23 E₂ E₃ C) +
        ringComm V (root31 E₃ E₁ D) := by
    unfold ringComm
    noncomm_ring
  have hCycleComm : ringComm V Ω = 0 := by
    change ringComm V
      (root12 E₁ E₂ A + root23 E₂ E₃ C + root31 E₃ E₁ D) = 0
    rw [hSum, hCentral.1, hCentral.2.1, hCentral.2.2]
    simp
  exact ⟨hCube, hCentral.1, hCentral.2.1, hCentral.2.2, hCycleComm⟩

/-- Cyclotomic remainders for the closed cycle, directly at the nested-flag
interface. The cycle mass remains an operator-valued remainder. -/
theorem nested_zorn_cycle3_cyclotomic_remainders
    {P₁ P₂ : B} (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) (A C D : B) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    let Ω := zornCycle3 E₁ E₂ E₃ A C D
    let V := zornCycleMass3 E₁ E₂ E₃ A C D
    (1 - Ω) * chainCyclo3 Ω = 1 - V ∧
    (1 + Ω) * chainCyclo6 Ω = 1 + V := by
  intro E₁ E₂ E₃ Ω V
  have hCube := (nested_zorn_cycle3_cube_and_mass_centralizer
    hP₁ hP₂ hChain A C D).1
  have hRemainders := cycle_cyclotomic_remainders Ω
  exact ⟨by rw [hRemainders.1, hCube], by rw [hRemainders.2, hCube]⟩

/-- The cubic Reynolds sandwich detects exactly the commutator with the
three-step power, without requiring commutativity or an order-three relation. -/
theorem zorn_cycle_reynolds3_commutator (Ω X : B) :
    ringComm Ω (zornCycleReynolds3 Ω X) = ringComm (Ω * Ω * Ω) X := by
  dsimp [ringComm, zornCycleReynolds3]
  noncomm_ring

/-- The cubic Reynolds sandwich sends the unit to three copies of the
operator square; no order-three relation is assumed. -/
theorem zorn_cycle_reynolds3_one (Ω : B) :
    zornCycleReynolds3 Ω 1 = (3 : ℤ) • (Ω * Ω) := by
  dsimp [zornCycleReynolds3]
  noncomm_ring

/-- The unit Reynolds readout commutes with its cycle operator because it is
a polynomial in that same operator. -/
theorem zorn_cycle_reynolds3_one_commutes (Ω : B) :
    ringComm Ω (zornCycleReynolds3 Ω 1) = 0 := by
  dsimp [ringComm, zornCycleReynolds3]
  noncomm_ring

/-- A Reynolds corner readout is determined by its three directed paths:
the left and right square terms and the middle sandwich term. The statement
is valid in an arbitrary associative ring and does not normalize by three. -/
theorem cycle_reynolds3_corner_of_path_terms {Ω M E x y z : B}
    (hOmegaSq : Ω * Ω = M) (hLeft : M * E = x)
    (hMiddle : Ω * E * Ω = y) (hRight : E * M = z)
    (hpaths : x + y + z = M) :
    zornCycleReynolds3 Ω E = M := by
  dsimp [zornCycleReynolds3]
  rw [hOmegaSq, hLeft, hMiddle, mul_assoc E Ω Ω, hOmegaSq, hRight]
  exact hpaths

/-- The three-site cyclic path law: each site readout is the sum of the
three two-step paths, with a different cyclic ordering. The hypotheses expose
the path support identities explicitly, so no commutativity or scalar
normalization is implicit. -/
theorem cycle_reynolds3_three_site_path_readout {Ω M E1 E2 E3 r12 r23 r31 : B}
    (hOmegaSq : Ω * Ω = M) (hMass : r12 + r23 + r31 = M)
    (hL1 : M * E1 = r23) (hC1 : Ω * E1 * Ω = r31) (hR1 : E1 * M = r12)
    (hL2 : M * E2 = r31) (hC2 : Ω * E2 * Ω = r12) (hR2 : E2 * M = r23)
    (hL3 : M * E3 = r12) (hC3 : Ω * E3 * Ω = r23) (hR3 : E3 * M = r31) :
    zornCycleReynolds3 Ω E1 = M ∧
    zornCycleReynolds3 Ω E2 = M ∧
    zornCycleReynolds3 Ω E3 = M := by
  have hpaths1 : r23 + r31 + r12 = M := by rw [← hMass]; abel
  have hpaths2 : r31 + r12 + r23 = M := by rw [← hMass]; abel
  refine ⟨cycle_reynolds3_corner_of_path_terms hOmegaSq hL1 hC1 hR1 hpaths1, ?_, ?_⟩
  · exact cycle_reynolds3_corner_of_path_terms hOmegaSq hL2 hC2 hR2 hpaths2
  · exact cycle_reynolds3_corner_of_path_terms hOmegaSq hL3 hC3 hR3 hMass

/-- The cyclic path theorem instantiated on the three Peirce arrows
`E1 → E2 → E3 → E1`. This is the concrete site readout for a Zorn cycle;
the proof records both the two-step mass and the left, middle, and right
corner support at each site. -/
theorem zorn_cycle_reynolds3_site_readout {E1 E2 E3 A C D : B}
    (h1 : E1 * E1 = E1) (h2 : E2 * E2 = E2) (h3 : E3 * E3 = E3)
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    zornCycleReynolds3 (zornCycle3 E1 E2 E3 A C D) E1 =
        zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D ∧
    zornCycleReynolds3 (zornCycle3 E1 E2 E3 A C D) E2 =
        zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D ∧
    zornCycleReynolds3 (zornCycle3 E1 E2 E3 A C D) E3 =
        zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D := by
  let u := root12 E1 E2 A
  let v := root23 E2 E3 C
  let w := root31 E3 E1 D
  let Ω := u + v + w
  let M := Ω * Ω
  have huu : u * u = 0 := corner_arrows_mul_zero h21
  have hvv : v * v = 0 := corner_arrows_mul_zero h32
  have hww : w * w = 0 := corner_arrows_mul_zero h13
  have hvu : v * u = 0 := corner_arrows_mul_zero h31
  have hwv : w * v = 0 := corner_arrows_mul_zero h12
  have huw : u * w = 0 := corner_arrows_mul_zero h23
  have hMass : u * v + v * w + w * u = M := by
    dsimp [M, Ω]
    noncomm_ring [huu, hvv, hww, hvu, hwv, huw]
  have hOw : Ω * w = v * w := by
    dsimp [Ω]
    noncomm_ring [huw, hww]
  have hOu : Ω * u = w * u := by
    dsimp [Ω]
    noncomm_ring [huu, hvu]
  have hOv : Ω * v = u * v := by
    dsimp [Ω]
    noncomm_ring [hvv, hwv]
  have huO : u * Ω = u * v := by
    dsimp [Ω]
    noncomm_ring [huu, huw]
  have hvO : v * Ω = v * w := by
    dsimp [Ω]
    noncomm_ring [hvu, hvv]
  have hwO : w * Ω = w * u := by
    dsimp [Ω]
    noncomm_ring [hwv, hww]
  have hO1 : Ω * E1 = w := by
    dsimp [Ω, u, v, w, root12, root23, root31]
    noncomm_ring [h1, h12, h21, h13, h31, h23, h32]
  have h1O : E1 * Ω = u := by
    dsimp [Ω, u, v, w, root12, root23, root31]
    simp [← mul_assoc, mul_add, h1, h12, h13]
  have hO2 : Ω * E2 = u := by
    dsimp [Ω, u, v, w, root12, root23, root31]
    noncomm_ring [h1, h2, h3, h12, h21, h13, h31, h23, h32]
  have h2O : E2 * Ω = v := by
    dsimp [Ω, u, v, w, root12, root23, root31]
    simp [← mul_assoc, mul_add, h2, h21, h23]
  have hO3 : Ω * E3 = v := by
    dsimp [Ω, u, v, w, root12, root23, root31]
    noncomm_ring [h1, h2, h3, h12, h21, h13, h31, h23, h32]
  have h3O : E3 * Ω = w := by
    dsimp [Ω, u, v, w, root12, root23, root31]
    simp [← mul_assoc, mul_add, h3, h31, h32]
  have hL1 : M * E1 = v * w := by
    change (Ω * Ω) * E1 = v * w
    calc
      (Ω * Ω) * E1 = Ω * (Ω * E1) := mul_assoc Ω Ω E1
      _ = Ω * w := by rw [hO1]
      _ = v * w := hOw
  have hC1 : Ω * E1 * Ω = w * u := by rw [hO1, hwO]
  have hR1 : E1 * M = u * v := by
    change E1 * (Ω * Ω) = u * v
    calc
      E1 * (Ω * Ω) = (E1 * Ω) * Ω := (mul_assoc E1 Ω Ω).symm
      _ = u * Ω := by rw [h1O]
      _ = u * v := huO
  have hL2 : M * E2 = w * u := by
    change (Ω * Ω) * E2 = w * u
    calc
      (Ω * Ω) * E2 = Ω * (Ω * E2) := mul_assoc Ω Ω E2
      _ = Ω * u := by rw [hO2]
      _ = w * u := hOu
  have hC2 : Ω * E2 * Ω = u * v := by rw [hO2, huO]
  have hR2 : E2 * M = v * w := by
    change E2 * (Ω * Ω) = v * w
    calc
      E2 * (Ω * Ω) = (E2 * Ω) * Ω := (mul_assoc E2 Ω Ω).symm
      _ = v * Ω := by rw [h2O]
      _ = v * w := hvO
  have hL3 : M * E3 = u * v := by
    change (Ω * Ω) * E3 = u * v
    calc
      (Ω * Ω) * E3 = Ω * (Ω * E3) := mul_assoc Ω Ω E3
      _ = Ω * v := by rw [hO3]
      _ = u * v := hOv
  have hC3 : Ω * E3 * Ω = v * w := by rw [hO3, hvO]
  have hR3 : E3 * M = w * u := by
    change E3 * (Ω * Ω) = w * u
    calc
      E3 * (Ω * Ω) = (E3 * Ω) * Ω := (mul_assoc E3 Ω Ω).symm
      _ = w * Ω := by rw [h3O]
      _ = w * u := hwO
  have hSite := cycle_reynolds3_three_site_path_readout
    (Ω := Ω) (M := M) (E1 := E1) (E2 := E2) (E3 := E3)
    (r12 := u * v) (r23 := v * w) (r31 := w * u)
    rfl hMass hL1 hC1 hR1 hL2 hC2 hR2 hL3 hC3 hR3
  constructor
  · simpa [Ω, M, u, v, w, zornCycle3] using hSite.1
  constructor
  · simpa [Ω, M, u, v, w, zornCycle3] using hSite.2.1
  · simpa [Ω, M, u, v, w, zornCycle3] using hSite.2.2

/-- The A107 three-site Reynolds readout for the shells of a nested
idempotent pair. Each site maps to the same square of the closed cycle. -/
theorem nested_zorn_cycle_reynolds3_site_readout
    {P₁ P₂ A C D : B}
    (hP₁ : P₁ * P₁ = P₁) (hP₂ : P₂ * P₂ = P₂)
    (hChain : idemLe P₁ P₂) :
    let E₁ := shell1 P₁
    let E₂ := shell2 P₁ P₂
    let E₃ := shell3 P₂
    zornCycleReynolds3 (zornCycle3 E₁ E₂ E₃ A C D) E₁ =
        zornCycle3 E₁ E₂ E₃ A C D * zornCycle3 E₁ E₂ E₃ A C D ∧
    zornCycleReynolds3 (zornCycle3 E₁ E₂ E₃ A C D) E₂ =
        zornCycle3 E₁ E₂ E₃ A C D * zornCycle3 E₁ E₂ E₃ A C D ∧
    zornCycleReynolds3 (zornCycle3 E₁ E₂ E₃ A C D) E₃ =
        zornCycle3 E₁ E₂ E₃ A C D * zornCycle3 E₁ E₂ E₃ A C D := by
  intro E₁ E₂ E₃
  rcases three_shell_partition hP₁ hP₂ hChain with
    ⟨_, hE₁, hE₂, hE₃, h12, h21, h13, h31, h23, h32⟩
  exact zorn_cycle_reynolds3_site_readout
    hE₁ hE₂ hE₃ h12 h21 h13 h31 h23 h32

/-- A closed three-step operator is a cube root of unity only on the explicit
unit-cycle shell; its general cyclotomic remainder is preserved in the
preceding theorem. -/
theorem zorn_cycle3_cube_eq_one_of_unit_shell {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0)
    (hunit : zornCycleMass3 E1 E2 E3 A C D = 1) :
    zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D *
      zornCycle3 E1 E2 E3 A C D = 1 := by
  rw [zorn_cycle3_cube h12 h21 h13 h31 h23 h32, hunit]

/-- On the anti-periodic return shell, the cycle operator has cube `-1`
and hence sixth power `1`. -/
theorem zorn_cycle3_sixth_power_eq_one_of_antiperiodic_shell
    {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0)
    (hanti : zornCycleMass3 E1 E2 E3 A C D = -1) :
    let Ω := zornCycle3 E1 E2 E3 A C D
    Ω * Ω * Ω = -1 ∧ Ω * Ω * Ω * Ω * Ω * Ω = 1 := by
  intro Ω
  have hcube := zorn_cycle3_cube (A := A) (C := C) (D := D)
    h12 h21 h13 h31 h23 h32
  constructor
  · rw [hcube, hanti]
  · have hcubeAnti : Ω * Ω * Ω = -1 := by rw [hcube, hanti]
    calc
      Ω * Ω * Ω * Ω * Ω * Ω =
          (Ω * Ω * Ω) * (Ω * Ω * Ω) := by noncomm_ring
      _ = (-1) * (-1) := by rw [hcubeAnti]
      _ = 1 := by noncomm_ring

/-- Adjacent roots in a three-shell Peirce decomposition multiply in one
direction to the long root and vanish in the reverse direction. Their sum
has square equal to the long root and cube zero. -/
theorem adjacent_roots_form_nilpotent_chain {E1 E2 E3 A C : B}
    (h2 : E2 * E2 = E2) (h21 : E2 * E1 = 0)
    (h31 : E3 * E1 = 0) (h32 : E3 * E2 = 0) :
    root12 E1 E2 A * root12 E1 E2 A = 0 ∧
    root23 E2 E3 C * root23 E2 E3 C = 0 ∧
    root23 E2 E3 C * root12 E1 E2 A = 0 ∧
    root12 E1 E2 A * root23 E2 E3 C = root13 E1 E3 (A * E2 * C) ∧
    (root12 E1 E2 A + root23 E2 E3 C) ^ 2 =
      root12 E1 E2 A * root23 E2 E3 C ∧
    (root12 E1 E2 A + root23 E2 E3 C) ^ 3 = 0 := by
  dsimp [root12, root23, root13]
  let n12 := E1 * A * E2
  let n23 := E2 * C * E3
  have hn12 : n12 * n12 = 0 := by
    dsimp [n12]
    calc
      E1 * A * E2 * (E1 * A * E2) = E1 * A * (E2 * E1) * A * E2 := by
        simp only [← mul_assoc]
      _ = 0 := by rw [h21]; noncomm_ring
  have hn23 : n23 * n23 = 0 := by
    dsimp [n23]
    calc
      E2 * C * E3 * (E2 * C * E3) = E2 * C * (E3 * E2) * C * E3 := by
        simp only [← mul_assoc]
      _ = 0 := by rw [h32]; noncomm_ring
  have hback : n23 * n12 = 0 := by
    dsimp [n12, n23]
    calc
      E2 * C * E3 * (E1 * A * E2) = E2 * C * (E3 * E1) * A * E2 := by
        simp only [← mul_assoc]
      _ = 0 := by rw [h31]; noncomm_ring
  have hforward : n12 * n23 = E1 * (A * E2 * C) * E3 := by
    dsimp [n12, n23]
    calc
      E1 * A * E2 * (E2 * C * E3) = E1 * A * (E2 * E2) * C * E3 := by
        simp only [← mul_assoc]
      _ = E1 * (A * E2 * C) * E3 := by rw [h2]; simp only [mul_assoc]
  constructor
  · calc
      E1 * A * E2 * (E1 * A * E2) = n12 * n12 := by rfl
      _ = 0 := hn12
  constructor
  · calc
      E2 * C * E3 * (E2 * C * E3) = n23 * n23 := by rfl
      _ = 0 := hn23
  constructor
  · calc
      E2 * C * E3 * (E1 * A * E2) = n23 * n12 := by rfl
      _ = 0 := hback
  constructor
  · exact hforward
  constructor
  · have hsquare : (n12 + n23) * (n12 + n23) = n12 * n23 := by
      simp only [add_mul, mul_add, hn12, hn23, hback, zero_add, add_zero]
    rw [pow_two]
    simpa only [n12, n23] using hsquare
  · have hsquare : (n12 + n23) * (n12 + n23) = n12 * n23 := by
      simp only [add_mul, mul_add, hn12, hn23, hback, zero_add, add_zero]
    have hLong12 : (n12 * n23) * n12 = 0 := by
      calc
        (n12 * n23) * n12 = E1 * (A * E2 * C) * (E3 * (E1 * A * E2)) := by
          rw [hforward, mul_assoc]
        _ = E1 * (A * E2 * C) * ((E3 * E1) * A * E2) := by simp only [mul_assoc]
        _ = 0 := by rw [h31]; simp
    have hLong23 : (n12 * n23) * n23 = 0 := by
      calc
        (n12 * n23) * n23 = E1 * (A * E2 * C) * (E3 * (E2 * C * E3)) := by
          rw [hforward, mul_assoc]
        _ = E1 * (A * E2 * C) * ((E3 * E2) * C * E3) := by simp only [mul_assoc]
        _ = 0 := by rw [h32]; simp
    rw [pow_succ, pow_two]
    change ((n12 + n23) * (n12 + n23)) * (n12 + n23) = 0
    rw [hsquare]
    simp only [mul_add, hLong12, hLong23, zero_add]

/-- The second power of a closed three-corner shift consists exactly of
the three directed two-hop paths. -/
theorem zorn_cycle3_square {E1 E2 E3 A C D : B}
    (h12 : E1 * E2 = 0) (h21 : E2 * E1 = 0)
    (h13 : E1 * E3 = 0) (h31 : E3 * E1 = 0)
    (h23 : E2 * E3 = 0) (h32 : E3 * E2 = 0) :
    zornCycle3 E1 E2 E3 A C D * zornCycle3 E1 E2 E3 A C D =
      root12 E1 E2 A * root23 E2 E3 C +
      root23 E2 E3 C * root31 E3 E1 D +
      root31 E3 E1 D * root12 E1 E2 A := by
  let u := root12 E1 E2 A
  let v := root23 E2 E3 C
  let w := root31 E3 E1 D
  have huu : u * u = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E1) (h := E2)
      (a := A) (b := A) h21
  have hvv : v * v = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E2) (h := E3)
      (a := C) (b := C) h32
  have hww : w * w = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E1) (g := E3) (h := E1)
      (a := D) (b := D) h13
  have huw : u * w = 0 :=
    corner_arrows_mul_zero (e := E1) (f := E2) (g := E3) (h := E1)
      (a := A) (b := D) h23
  have hvu : v * u = 0 :=
    corner_arrows_mul_zero (e := E2) (f := E3) (g := E1) (h := E2)
      (a := C) (b := A) h31
  have hwv : w * v = 0 :=
    corner_arrows_mul_zero (e := E3) (f := E1) (g := E2) (h := E3)
      (a := D) (b := C) h12
  change (u + v + w) * (u + v + w) = u * v + v * w + w * u
  noncomm_ring [huu, hvv, hww, huw, hvu, hwv]

/-- Nine-block decomposition into diagonal corners and six off-diagonal
corners for a three-shell partition of the unit. -/
theorem three_shell_nine_block_decomposition {E1 E2 E3 X : B}
    (hsum : E1 + E2 + E3 = 1) :
    E1 * X * E1 + E2 * X * E2 + E3 * X * E3 +
      (E1 * X * E2 + E2 * X * E1 + E2 * X * E3 +
       E3 * X * E2 + E1 * X * E3 + E3 * X * E1) = X := by
  calc
    E1 * X * E1 + E2 * X * E2 + E3 * X * E3 +
        (E1 * X * E2 + E2 * X * E1 + E2 * X * E3 +
         E3 * X * E2 + E1 * X * E3 + E3 * X * E1) =
        (E1 + E2 + E3) * X * (E1 + E2 + E3) := by noncomm_ring
    _ = X := by rw [hsum]; simp

