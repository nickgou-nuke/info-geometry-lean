import Mathlib.Algebra.Algebra.Equiv
import InfoGeometry.Lie.SplitOctonionRegularActionIntertwiner

/-!
# Automorphism covariance of the regular Zorn tetraktys superoperators

The native real split-octonion automorphism acts on the associative
endomorphism algebra by conjugation.  This file transports the tetraktys
formed from left-regular Zorn operators, their double-commutator
superoperators, and the regular-action associator defect under that same
action.  It does not identify this real carrier with the arbitrary-coefficient
operator-Zorn gauge carrier.
-/

noncomputable section

namespace InfoGeometry.Lie.SplitOctonionTetraktysAutomorphismCovariance

open InfoGeometry.Canonical
open InfoGeometry.Lie.SplitOctonionRegularActionIntertwiner
open InfoGeometry.Lie.SplitOctonionChiralOperatorSupergrading

abbrev CZ := InfoGeometry.Canonical.ZornMatrix ℝ
abbrev EndCZ := Module.End ℝ CZ

def operatorComm (X Y : EndCZ) : EndCZ := X * Y - Y * X

def regularPhi (x y : CZ) : EndCZ := leftRegular x + leftRegular y
def regularJ (x y : CZ) : EndCZ := leftRegular x - leftRegular y
def regularV (x y : CZ) : EndCZ := leftRegular x * leftRegular y + leftRegular y * leftRegular x
def regularSig (x y : CZ) : EndCZ := leftRegular x * leftRegular y - leftRegular y * leftRegular x

/-- The degree-two inner superoperator generated by an endomorphism. -/
def doubleComm (H X : EndCZ) : EndCZ := operatorComm H (operatorComm H X)

/-- The regular-action associator defect, retaining the nonmultiplicativity
of the left regular representation. -/
def leftRegularDefect (x y : CZ) : EndCZ :=
  leftRegular (x * y) - leftRegular x * leftRegular y

/-- The four regular tetraktys operators are transported by the actual
split-octonion automorphism on their Zorn labels. -/
theorem conjugateEnd_regularTetraktys (φ : RealSplitOctonionAut) (x y : CZ) :
    conjugateEnd φ (regularPhi x y) = regularPhi (φ.1 x) (φ.1 y) ∧
    conjugateEnd φ (regularJ x y) = regularJ (φ.1 x) (φ.1 y) ∧
    conjugateEnd φ (regularV x y) = regularV (φ.1 x) (φ.1 y) ∧
    conjugateEnd φ (regularSig x y) = regularSig (φ.1 x) (φ.1 y) := by
  have hleft (z : CZ) :
      (φ.1.conjAlgEquiv ℝ) (leftRegular z) = leftRegular (φ.1 z) := by
    change conjugateEnd φ (leftRegular z) = leftRegular (φ.1 z)
    exact automorphism_conjugates_leftRegular φ z
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold regularPhi
    change (φ.1.conjAlgEquiv ℝ) (leftRegular x + leftRegular y) = _
    rw [map_add, hleft, hleft]
  · unfold regularJ
    change (φ.1.conjAlgEquiv ℝ) (leftRegular x - leftRegular y) = _
    rw [map_sub, hleft, hleft]
  · unfold regularV
    change (φ.1.conjAlgEquiv ℝ)
      (leftRegular x * leftRegular y + leftRegular y * leftRegular x) = _
    rw [map_add, map_mul, map_mul, hleft, hleft]
  · unfold regularSig
    change (φ.1.conjAlgEquiv ℝ)
      (leftRegular x * leftRegular y - leftRegular y * leftRegular x) = _
    rw [map_sub, map_mul, map_mul, hleft, hleft]

/-- In particular, the Φ, J, and Σ double-commutator superoperators are
covariant under the real split-octonion automorphism action. -/
theorem conjugateEnd_tetraktysSuperoperators
    (φ : RealSplitOctonionAut) (x y : CZ) (T : EndCZ) :
    conjugateEnd φ (doubleComm (regularPhi x y) T) =
      doubleComm (regularPhi (φ.1 x) (φ.1 y)) (conjugateEnd φ T) ∧
    conjugateEnd φ (doubleComm (regularJ x y) T) =
      doubleComm (regularJ (φ.1 x) (φ.1 y)) (conjugateEnd φ T) ∧
    conjugateEnd φ (doubleComm (regularSig x y) T) =
      doubleComm (regularSig (φ.1 x) (φ.1 y)) (conjugateEnd φ T) := by
  rcases conjugateEnd_regularTetraktys φ x y with ⟨hΦ, hJ, _, hSigma⟩
  have htransport (U : EndCZ) :
      conjugateEnd φ U = (φ.1.conjAlgEquiv ℝ) U := rfl
  have hΦ' : (φ.1.conjAlgEquiv ℝ) (regularPhi x y) =
      regularPhi (φ.1 x) (φ.1 y) := (htransport _).symm.trans hΦ
  have hJ' : (φ.1.conjAlgEquiv ℝ) (regularJ x y) =
      regularJ (φ.1 x) (φ.1 y) := (htransport _).symm.trans hJ
  have hSigma' : (φ.1.conjAlgEquiv ℝ) (regularSig x y) =
      regularSig (φ.1 x) (φ.1 y) := (htransport _).symm.trans hSigma
  refine ⟨?_, ?_, ?_⟩
  · calc
      conjugateEnd φ (doubleComm (regularPhi x y) T) =
          (φ.1.conjAlgEquiv ℝ) (doubleComm (regularPhi x y) T) := htransport _
      _ = doubleComm ((φ.1.conjAlgEquiv ℝ) (regularPhi x y))
          ((φ.1.conjAlgEquiv ℝ) T) := by
            simp only [doubleComm, operatorComm, map_sub, map_mul]
      _ = doubleComm (regularPhi (φ.1 x) (φ.1 y)) (conjugateEnd φ T) := by
            rw [hΦ', ← htransport T]
  · calc
      conjugateEnd φ (doubleComm (regularJ x y) T) =
          (φ.1.conjAlgEquiv ℝ) (doubleComm (regularJ x y) T) := htransport _
      _ = doubleComm ((φ.1.conjAlgEquiv ℝ) (regularJ x y))
          ((φ.1.conjAlgEquiv ℝ) T) := by
            simp only [doubleComm, operatorComm, map_sub, map_mul]
      _ = doubleComm (regularJ (φ.1 x) (φ.1 y)) (conjugateEnd φ T) := by
            rw [hJ', ← htransport T]
  · calc
      conjugateEnd φ (doubleComm (regularSig x y) T) =
          (φ.1.conjAlgEquiv ℝ) (doubleComm (regularSig x y) T) := htransport _
      _ = doubleComm ((φ.1.conjAlgEquiv ℝ) (regularSig x y))
          ((φ.1.conjAlgEquiv ℝ) T) := by
            simp only [doubleComm, operatorComm, map_sub, map_mul]
      _ = doubleComm (regularSig (φ.1 x) (φ.1 y)) (conjugateEnd φ T) := by
            rw [hSigma', ← htransport T]

/-- The associator defect is transported exactly; the automorphism action
does not force the regular representation to become multiplicative. -/
theorem conjugateEnd_leftRegularDefect
    (φ : RealSplitOctonionAut) (x y : CZ) :
    conjugateEnd φ (leftRegularDefect x y) =
      leftRegularDefect (φ.1 x) (φ.1 y) := by
  change (φ.1.conjAlgEquiv ℝ) (leftRegularDefect x y) = _
  unfold leftRegularDefect
  rw [map_sub, map_mul]
  have hxy : (φ.1.conjAlgEquiv ℝ) (leftRegular (x * y)) =
      leftRegular (φ.1 (x * y)) := by
    change conjugateEnd φ (leftRegular (x * y)) = _
    exact automorphism_conjugates_leftRegular φ (x * y)
  have hx : (φ.1.conjAlgEquiv ℝ) (leftRegular x) = leftRegular (φ.1 x) := by
    change conjugateEnd φ (leftRegular x) = _
    exact automorphism_conjugates_leftRegular φ x
  have hy : (φ.1.conjAlgEquiv ℝ) (leftRegular y) = leftRegular (φ.1 y) := by
    change conjugateEnd φ (leftRegular y) = _
    exact automorphism_conjugates_leftRegular φ y
  rw [hxy, hx, hy, RealSplitOctonionAut.preserves_mul]

end InfoGeometry.Lie.SplitOctonionTetraktysAutomorphismCovariance

end
