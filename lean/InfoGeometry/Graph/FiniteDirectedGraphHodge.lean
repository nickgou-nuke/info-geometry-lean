    ∀ record ∈ recordedCycleParentRecords, ∀ slot : Fin record.parents.size,
      (record.parents[slot]).topologicalIndex < record.child.topologicalIndex := by
  intro record hRecord slot
  simp [recordedCycleParentRecords] at hRecord
  rcases hRecord with hLeft | hRight
  · subst record
    fin_cases slot
    norm_num [recordedCycleLeftParents, recordedCycleLeftRef,
      recordedCycleRootRef]
  · subst record
    fin_cases slot <;>
      norm_num [recordedCycleRightParents, recordedCycleRightRef,
        recordedCycleRootRef, recordedCycleLeftRef]

/-- The finite edge family used for the Hodge calculation has strictly
increasing oldest-first commit ranks on each parent-to-child edge. -/
