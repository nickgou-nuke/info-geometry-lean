import InfoGeometry.OperatorAlgebra.PeirceSpine.Tetraktys

/-!
# A second-order relation for a sum of inner and double commutators

The operator below is the sum of the inner derivation generated by `Σ` and
minus the square of the inner derivation generated by `Φ`. Its restriction to
`Φ` and `J` satisfies a quadratic relation with coefficients in the centralizer
of the tetraktys mass `V`.
-/
namespace InfoGeometry.OperatorAlgebra.PeirceSpine

variable {B : Type*} [Ring B] {P : B} (hP : P * P = P) (A C X : B)
include hP

/-- Sum of the `Σ` inner derivation and the signed `Φ` double derivation. -/
def curvatureDoubleCommutator (P A C X : B) : B :=
  comm (genSig P A C) X + derivSqPhi P A C X

/-- The `Φ` mode satisfies the corresponding quadratic relation. -/
theorem curvatureDoubleCommutator_quadratic_phi :
    curvatureDoubleCommutator P A C (curvatureDoubleCommutator P A C (genPhi P A C)) +
      (4 : ℤ) • (genV P A C * curvatureDoubleCommutator P A C (genPhi P A C)) -
      (4 : ℤ) • ((genV P A C * genV P A C) * genPhi P A C) = 0 := by
  simp only [curvatureDoubleCommutator, derivSqPhi]
  peirce_nf hP

/-- The `J` mode satisfies the same quadratic relation. -/
theorem curvatureDoubleCommutator_quadratic_j :
    curvatureDoubleCommutator P A C (curvatureDoubleCommutator P A C (genJ P A C)) +
      (4 : ℤ) • (genV P A C * curvatureDoubleCommutator P A C (genJ P A C)) -
      (4 : ℤ) • ((genV P A C * genV P A C) * genJ P A C) = 0 := by
  simp only [curvatureDoubleCommutator, derivSqPhi]
  peirce_nf hP

end InfoGeometry.OperatorAlgebra.PeirceSpine
