+        ((plusRootCharacterHom
+          (Multiplicative.ofAdd (bipolarLog s)) : ℂˣ) : ℂ) • σPlus ∧
+      finiteAdjointFlow s σMinus =
+        ((minusRootCharacterHom
+          (Multiplicative.ofAdd (bipolarLog s)) : ℂˣ) : ℂ) • σMinus ∧
