// logarithmic_cft.sing
// Formalization of Logarithmic conformal field theories
// Represents the non-diagonalizable action of L0

LIB "matrix.lib";

// Define a ring over the rationals with a dummy variable x
ring R = 0, (x), dp;

// Define the matrix M = L0 - Delta*I as the nilpotent part of a rank-2 Jordan block.
// A rank 2 Jordan block for L0 has the form:
// [ Delta,   1   ]
// [   0  , Delta ]
// Thus, M = L0 - Delta*I is:
// [ 0, 1 ]
// [ 0, 0 ]
matrix M[2][2] = 0, 1, 0, 0;

print("Matrix M = L0 - Delta * I :");
print(M);

// Compute M^2 to show it is nilpotent of order 2
matrix M2 = M * M;

print("Matrix M^2 :");
print(M2);

// Verify nilpotency
int is_nilpotent = 1;
int i, j;
for (i = 1; i <= 2; i = i + 1) {
    for (j = 1; j <= 2; j = j + 1) {
        if (M2[i,j] != 0) {
            is_nilpotent = 0;
        }
    }
}

if (is_nilpotent == 1) {
    print("Result: M is nilpotent of order 2.");
} else {
    print("Result: M is NOT nilpotent of order 2.");
}

// Ideal annihilator approach
// The minimal polynomial of M is x^2. Let's substitute M into x^2.
// Alternatively, just show that the ideal generated by entries of M^2 is the zero ideal.
ideal I = M2[1,1], M2[1,2], M2[2,1], M2[2,2];
I = std(I);
print("Standard basis of the ideal generated by the entries of M^2:");
print(I);

quit;
