import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Canonical.CayleyWittenPeirceParityBridge
import InfoGeometry.Canonical.CayleyConjugationExteriorDualityBridge

/-!
# Cayley Peirce Klein Four-Group Bridge

This module establishes the second Klein four-group $V_4 \cong \mathbb{Z}_2 \times \mathbb{Z}_2$
generated by the commuting Peirce grading $P$ and exterior fermion parity $\Gamma_F$, with product
$M = P \Gamma_F$ (middle sign flip).

It proves:
1. The Klein 4-group algebra on $\{I, P, \Gamma_F, M\}$.
2. The four orthogonal character projection operators $E_{++}, E_{+-}, E_{-+}, E_{--}$ decomposing
   the 8-dimensional space $\operatorname{Coord} \cong \mathbb{R} \oplus \mathbb{R}^3 \oplus \mathbb{R}^3 \oplus \mathbb{R}$
   into its 4 graded pieces $\mathbb{R} \oplus 0 \oplus 0 \oplus 0$, $0 \oplus \mathbb{R}^3 \oplus 0 \oplus 0$,
   $0 \oplus 0 \oplus \mathbb{R}^3 \oplus 0$, and $0 \oplus 0 \oplus 0 \oplus \mathbb{R}$.
3. Linear equivalence `bigradingEquiv : Coord ≃ₗ[ℝ] E_{++} × E_{+-} × E_{-+} × E_{--}`.
4. Embedding of the first Klein group $\{I, C, \star, \Xi\}$ as the even-parity subgroup
   of the cubic elementary swap group $(\mathbb{Z}_2)^3$ generated by $(S, T, M)$ with $C = SM$,
   $\star = ST$, $\Xi = TM$, and $C \star \Xi = I$.
-/

noncomputable section

namespace InfoGeometry.Canonical.CayleyPeirceKleinFourBridge

open InfoGeometry.Canonical.CayleyConjugationExteriorDualityBridge
open InfoGeometry.Canonical.CayleyWittenPeirceParityBridge

abbrev Coord := InfoGeometry.Canonical.CayleyConjugationExteriorDualityBridge.Coord
abbrev CoordEnd := Module.End ℝ Coord

-- ============================================================================
-- Section 1: Parity Klein Four-Group Algebra
-- ============================================================================

abbrev P : CoordEnd := peirceGrading
abbrev GammaF : CoordEnd := exteriorFermionParity
abbrev M_mid : CoordEnd := middleSignFlip

theorem P_sq : P * P = 1 := peirceGrading_sq
theorem GammaF_sq : GammaF * GammaF = 1 := exteriorFermionParity_sq
theorem M_mid_sq : M_mid * M_mid = 1 := middleSignFlip_sq

theorem P_comm_GammaF : P * GammaF = GammaF * P :=
  peirceGrading_comm_exteriorFermionParity

theorem P_mul_GammaF : P * GammaF = M_mid :=
  middleSignFlip_eq_peirceGrading_mul_exteriorFermionParity.symm

theorem GammaF_mul_P : GammaF * P = M_mid :=
  middleSignFlip_eq_exteriorFermionParity_mul_peirceGrading.symm

theorem GammaF_mul_M : GammaF * M_mid = P := by
  rw [← GammaF_mul_P, ← mul_assoc, GammaF_sq, one_mul]

theorem M_mul_GammaF : M_mid * GammaF = P := by
  rw [← P_mul_GammaF, mul_assoc, GammaF_sq, mul_one]

theorem M_mul_P : M_mid * P = GammaF := by
  rw [← GammaF_mul_P, mul_assoc, P_sq, mul_one]

theorem P_mul_M : P * M_mid = GammaF := by
  rw [← P_mul_GammaF, ← mul_assoc, P_sq, one_mul]

/-! Section 2: Four Orthogonal Projectors onto Character Sectors. -/

/-- Projector onto the scalar 0-form sector (1D). -/
def proj0 : CoordEnd where
  toFun x := (x.1, 0, 0, 0)
  map_add' x y := by ext <;> simp
  map_smul' c x := by ext <;> simp

/-- Projector onto the vector 1-form sector (3D). -/
def proj1 : CoordEnd where
  toFun x := (0, x.2.1, 0, 0)
  map_add' x y := by ext <;> simp
  map_smul' c x := by ext <;> simp

/-- Projector onto the bivector 2-form sector (3D). -/
def proj2 : CoordEnd where
  toFun x := (0, 0, x.2.2.1, 0)
  map_add' x y := by ext <;> simp
  map_smul' c x := by ext <;> simp

/-- Projector onto the pseudoscalar 3-form sector (1D). -/
def proj3 : CoordEnd where
  toFun x := (0, 0, 0, x.2.2.2)
  map_add' x y := by ext <;> simp
  map_smul' c x := by ext <;> simp

@[simp] theorem proj0_apply (x : Coord) : proj0 x = (x.1, 0, 0, 0) := rfl
@[simp] theorem proj1_apply (x : Coord) : proj1 x = (0, x.2.1, 0, 0) := rfl
@[simp] theorem proj2_apply (x : Coord) : proj2 x = (0, 0, x.2.2.1, 0) := rfl
@[simp] theorem proj3_apply (x : Coord) : proj3 x = (0, 0, 0, x.2.2.2) := rfl

/-- Character projector for (P = +1, Γ_F = +1): (1/4)(I + P + Γ_F + M). -/
theorem proj0_eq_character_formula :
    proj0 = (1 / 4 : ℝ) • (1 + P + GammaF + M_mid) := by
  apply LinearMap.ext
  intro x
  ext <;> { dsimp [proj0, P, GammaF, M_mid, peirceGrading, chiralGrading, middleSignFlip]; ring }

/-- Character projector for (P = +1, Γ_F = -1): (1/4)(I + P - Γ_F - M). -/
theorem proj1_eq_character_formula :
    proj1 = (1 / 4 : ℝ) • (1 + P - GammaF - M_mid) := by
  apply LinearMap.ext
  intro x
  ext <;> { dsimp [proj1, P, GammaF, M_mid, peirceGrading, chiralGrading, middleSignFlip]; ring }

/-- Character projector for (P = -1, Γ_F = +1): (1/4)(I - P + GammaF - M_mid). -/
theorem proj2_eq_character_formula :
    proj2 = (1 / 4 : ℝ) • (1 - P + GammaF - M_mid) := by
  apply LinearMap.ext
  intro x
  ext <;> { dsimp [proj2, P, GammaF, M_mid, peirceGrading, chiralGrading, middleSignFlip]; ring }

/-- Character projector for (P = -1, Γ_F = -1): (1/4)(I - P - GammaF + M_mid). -/
theorem proj3_eq_character_formula :
    proj3 = (1 / 4 : ℝ) • (1 - P - GammaF + M_mid) := by
  apply LinearMap.ext
  intro x
  ext <;> { dsimp [proj3, P, GammaF, M_mid, peirceGrading, chiralGrading, middleSignFlip]; ring }

/-- Completeness of character projectors: sum is identity. -/
theorem character_projectors_sum_id :
    proj0 + proj1 + proj2 + proj3 = 1 := by
  apply LinearMap.ext
  intro x
  ext <;> simp [proj0, proj1, proj2, proj3]

/-- Distinct character sectors are algebraically orthogonal. -/
theorem character_projectors_pairwise_orthogonal :
    proj0 * proj1 = 0 ∧
      proj0 * proj2 = 0 ∧
      proj0 * proj3 = 0 ∧
      proj1 * proj2 = 0 ∧
      proj1 * proj3 = 0 ∧
      proj2 * proj3 = 0 := by
  constructor
  · apply LinearMap.ext
    intro x
    ext <;> simp [proj0, proj1]
  constructor
  · apply LinearMap.ext
    intro x
    ext <;> simp [proj0, proj2]
  constructor
  · apply LinearMap.ext
    intro x
    ext <;> simp [proj0, proj3]
  constructor
  · apply LinearMap.ext
    intro x
    ext <;> simp [proj1, proj2]
  constructor
  · apply LinearMap.ext
    intro x
    ext <;> simp [proj1, proj3]
  · apply LinearMap.ext
    intro x
    ext <;> simp [proj2, proj3]

-- ============================================================================
-- Section 3: Joint Character Eigenspaces
-- ============================================================================

def E_plus_plus : Submodule ℝ Coord :=
  LinearMap.ker (P - 1) ⊓ LinearMap.ker (GammaF - 1)

def E_plus_minus : Submodule ℝ Coord :=
  LinearMap.ker (P - 1) ⊓ LinearMap.ker (GammaF + 1)

def E_minus_plus : Submodule ℝ Coord :=
  LinearMap.ker (P + 1) ⊓ LinearMap.ker (GammaF - 1)

def E_minus_minus : Submodule ℝ Coord :=
  LinearMap.ker (P + 1) ⊓ LinearMap.ker (GammaF + 1)

theorem mem_E_plus_plus_iff (x : Coord) :
    x ∈ E_plus_plus ↔ x.2.1 = 0 ∧ x.2.2.1 = 0 ∧ x.2.2.2 = 0 := by
  constructor
  · rintro ⟨hP, hF⟩
    have hP' : P x = x := sub_eq_zero.mp hP
    have hF' : GammaF x = x := sub_eq_zero.mp hF
    refine ⟨?_, ?_, ?_⟩
    · ext i
      simp only [Pi.zero_apply]
      have h1 : -x.2.1 i = x.2.1 i := congrFun (congrArg Prod.fst (congrArg Prod.snd hF')) i
      linarith [h1]
    · ext i
      simp only [Pi.zero_apply]
      have h2 : -x.2.2.1 i = x.2.2.1 i := congrFun (congrArg Prod.fst (congrArg Prod.snd (congrArg Prod.snd hP'))) i
      linarith [h2]
    · have h3 : -x.2.2.2 = x.2.2.2 := congrArg Prod.snd (congrArg Prod.snd (congrArg Prod.snd hP'))
      linarith [h3]
  · rintro ⟨h1, h2, h3⟩
    have hPx : P x = x := by
      ext
      · rfl
      · rfl
      · simp [h2]
      · simp [h3]
    have hFx : GammaF x = x := by
      ext
      · rfl
      · simp [h1]
      · rfl
      · simp [h3]
    constructor
    · show (P - 1) x = 0
      simp [hPx]
    · show (GammaF - 1) x = 0
      simp [hFx]

theorem mem_E_plus_minus_iff (x : Coord) :
    x ∈ E_plus_minus ↔ x.1 = 0 ∧ x.2.2.1 = 0 ∧ x.2.2.2 = 0 := by
  constructor
  · rintro ⟨hP, hF⟩
    have hP' : P x = x := sub_eq_zero.mp hP
    have hF' : GammaF x = -x := add_eq_zero_iff_eq_neg.mp hF
    refine ⟨?_, ?_, ?_⟩
    · have h0 : x.1 = -x.1 := congrArg Prod.fst hF'
      linarith [h0]
    · ext i
      simp only [Pi.zero_apply]
      have h2 : -x.2.2.1 i = x.2.2.1 i := congrFun (congrArg Prod.fst (congrArg Prod.snd (congrArg Prod.snd hP'))) i
      linarith [h2]
    · have h3 : -x.2.2.2 = x.2.2.2 := congrArg Prod.snd (congrArg Prod.snd (congrArg Prod.snd hP'))
      linarith [h3]
  · rintro ⟨h0, h2, h3⟩
    have hPx : P x = x := by
      ext
      · rfl
      · rfl
      · simp [h2]
      · simp [h3]
    have hFx : GammaF x = -x := by
      ext
      · simp [h0]
      · rfl
      · simp [h2]
      · simp [h3]
    constructor
    · show (P - 1) x = 0
      simp [hPx]
    · show (GammaF + 1) x = 0
      simp [hFx]

theorem mem_E_minus_plus_iff (x : Coord) :
    x ∈ E_minus_plus ↔ x.1 = 0 ∧ x.2.1 = 0 ∧ x.2.2.2 = 0 := by
  constructor
  · rintro ⟨hP, hF⟩
    have hP' : P x = -x := add_eq_zero_iff_eq_neg.mp hP
    have hF' : GammaF x = x := sub_eq_zero.mp hF
    refine ⟨?_, ?_, ?_⟩
    · have h0 : x.1 = -x.1 := congrArg Prod.fst hP'
      linarith [h0]
    · ext i
      simp only [Pi.zero_apply]
      have h1 : x.2.1 i = -x.2.1 i := congrFun (congrArg Prod.fst (congrArg Prod.snd hP')) i
      linarith [h1]
    · have h3 : -x.2.2.2 = x.2.2.2 := congrArg Prod.snd (congrArg Prod.snd (congrArg Prod.snd hF'))
      linarith [h3]
  · rintro ⟨h0, h1, h3⟩
    have hPx : P x = -x := by
      ext
      · simp [h0]
      · simp [h1]
      · rfl
      · simp [h3]
    have hFx : GammaF x = x := by
      ext
      · simp [h0]
      · simp [h1]
      · rfl
      · simp [h3]
    constructor
    · show (P + 1) x = 0
      simp [hPx]
    · show (GammaF - 1) x = 0
      simp [hFx]

theorem mem_E_minus_minus_iff (x : Coord) :
    x ∈ E_minus_minus ↔ x.1 = 0 ∧ x.2.1 = 0 ∧ x.2.2.1 = 0 := by
  constructor
  · rintro ⟨hP, hF⟩
    have hP' : P x = -x := add_eq_zero_iff_eq_neg.mp hP
    have hF' : GammaF x = -x := add_eq_zero_iff_eq_neg.mp hF
    refine ⟨?_, ?_, ?_⟩
    · have h0 : x.1 = -x.1 := congrArg Prod.fst hP'
      linarith [h0]
    · ext i
      simp only [Pi.zero_apply]
      have h1 : x.2.1 i = -x.2.1 i := congrFun (congrArg Prod.fst (congrArg Prod.snd hP')) i
      linarith [h1]
    · ext i
      simp only [Pi.zero_apply]
      have h2 : x.2.2.1 i = -x.2.2.1 i := congrFun (congrArg Prod.fst (congrArg Prod.snd (congrArg Prod.snd hF'))) i
      linarith [h2]
  · rintro ⟨h0, h1, h2⟩
    have hPx : P x = -x := by
      ext
      · simp [h0]
      · simp [h1]
      · simp [h2]
      · rfl
    have hFx : GammaF x = -x := by
      ext
      · simp [h0]
      · simp [h1]
      · simp [h2]
      · rfl
    constructor
    · show (P + 1) x = 0
      simp [hPx]
    · show (GammaF + 1) x = 0
      simp [hFx]

-- ============================================================================
-- Section 4: Bigraded Isomorphism to Character Direct Sum
-- ============================================================================

/-- Linear equivalence between Coord and the direct sum of its 4 character eigenspaces. -/
def bigradingEquiv :
    Coord ≃ₗ[ℝ] E_plus_plus × E_plus_minus × E_minus_plus × E_minus_minus where
  toFun x :=
    ( ⟨(x.1, 0, 0, 0), (mem_E_plus_plus_iff _).2 ⟨rfl, rfl, rfl⟩⟩,
      ⟨(0, x.2.1, 0, 0), (mem_E_plus_minus_iff _).2 ⟨rfl, rfl, rfl⟩⟩,
      ⟨(0, 0, x.2.2.1, 0), (mem_E_minus_plus_iff _).2 ⟨rfl, rfl, rfl⟩⟩,
      ⟨(0, 0, 0, x.2.2.2), (mem_E_minus_minus_iff _).2 ⟨rfl, rfl, rfl⟩⟩ )
  invFun p := p.1.1 + p.2.1.1 + p.2.2.1.1 + p.2.2.2.1
  left_inv x := by
    ext <;> simp
  right_inv p := by
    obtain ⟨⟨x0, h0⟩, ⟨x1, h1⟩, ⟨x2, h2⟩, ⟨x3, h3⟩⟩ := p
    rw [mem_E_plus_plus_iff] at h0
    rw [mem_E_plus_minus_iff] at h1
    rw [mem_E_minus_plus_iff] at h2
    rw [mem_E_minus_minus_iff] at h3
    rcases h0 with ⟨h0_1, h0_2, h0_3⟩
    rcases h1 with ⟨h1_0, h1_2, h1_3⟩
    rcases h2 with ⟨h2_0, h2_1, h2_3⟩
    rcases h3 with ⟨h3_0, h3_1, h3_2⟩
    ext <;> simp [h0_1, h0_2, h0_3, h1_0, h1_2, h1_3, h2_0, h2_1, h2_3, h3_0, h3_1, h3_2]
  map_add' x y := by
    ext <;> simp
  map_smul' c x := by
    ext <;> simp

/-! The joint sectors have the expected intrinsic dimensions.  These
equivalences make the `1 + 3 + 3 + 1` readout a theorem about the actual
submodules, rather than only a coordinate mnemonic. -/

noncomputable def E_plus_plus_equiv : E_plus_plus ≃ₗ[ℝ] ℝ where
  toFun x := x.1.1
  invFun r := ⟨(r, 0, 0, 0), (mem_E_plus_plus_iff _).2 ⟨rfl, rfl, rfl⟩⟩
  left_inv x := by
    apply Subtype.ext
    have hx := x.property
    rw [mem_E_plus_plus_iff] at hx
    rcases hx with ⟨h₁, h₂, h₃⟩
    ext <;> simp [h₁, h₂, h₃]
  right_inv r := rfl
  map_add' x y := rfl
  map_smul' c x := rfl

noncomputable def E_plus_minus_equiv : E_plus_minus ≃ₗ[ℝ] (Fin 3 → ℝ) where
  toFun x := x.1.2.1
  invFun v := ⟨(0, v, 0, 0), (mem_E_plus_minus_iff _).2 ⟨rfl, rfl, rfl⟩⟩
  left_inv x := by
    apply Subtype.ext
    have hx := x.property
    rw [mem_E_plus_minus_iff] at hx
    rcases hx with ⟨h₀, h₂, h₃⟩
    ext <;> simp [h₀, h₂, h₃]
  right_inv v := rfl
  map_add' x y := rfl
  map_smul' c x := rfl

noncomputable def E_minus_plus_equiv : E_minus_plus ≃ₗ[ℝ] (Fin 3 → ℝ) where
  toFun x := x.1.2.2.1
  invFun v := ⟨(0, 0, v, 0), (mem_E_minus_plus_iff _).2 ⟨rfl, rfl, rfl⟩⟩
  left_inv x := by
    apply Subtype.ext
    have hx := x.property
    rw [mem_E_minus_plus_iff] at hx
    rcases hx with ⟨h₀, h₁, h₃⟩
    ext <;> simp [h₀, h₁, h₃]
  right_inv v := rfl
  map_add' x y := rfl
  map_smul' c x := rfl

noncomputable def E_minus_minus_equiv : E_minus_minus ≃ₗ[ℝ] ℝ where
  toFun x := x.1.2.2.2
  invFun r := ⟨(0, 0, 0, r), (mem_E_minus_minus_iff _).2 ⟨rfl, rfl, rfl⟩⟩
  left_inv x := by
    apply Subtype.ext
    have hx := x.property
    rw [mem_E_minus_minus_iff] at hx
    rcases hx with ⟨h₀, h₁, h₂⟩
    ext <;> simp [h₀, h₁, h₂]
  right_inv r := rfl
  map_add' x y := rfl
  map_smul' c x := rfl

theorem finrank_E_plus_plus : Module.finrank ℝ E_plus_plus = 1 := by
  rw [E_plus_plus_equiv.finrank_eq]
  simp

theorem finrank_E_plus_minus : Module.finrank ℝ E_plus_minus = 3 := by
  rw [E_plus_minus_equiv.finrank_eq]
  simp

theorem finrank_E_minus_plus : Module.finrank ℝ E_minus_plus = 3 := by
  rw [E_minus_plus_equiv.finrank_eq]
  simp

theorem finrank_E_minus_minus : Module.finrank ℝ E_minus_minus = 1 := by
  rw [E_minus_minus_equiv.finrank_eq]
  simp

/-- The four joint character sectors recover the full eight-dimensional
coordinate carrier at the level of intrinsic dimensions. -/
theorem parity_joint_finrank_sum :
    Module.finrank ℝ E_plus_plus + Module.finrank ℝ E_plus_minus +
        Module.finrank ℝ E_minus_plus + Module.finrank ℝ E_minus_minus =
      Module.finrank ℝ Coord := by
  rw [finrank_E_plus_plus, finrank_E_plus_minus, finrank_E_minus_plus,
    finrank_E_minus_minus]
  simp [Coord]

-- ============================================================================
-- Section 5: Cayley-Hodge Klein Four-Group as Even Subgroup of (ℤ₂)^3
-- ============================================================================

abbrev C_op : CoordEnd := cayleyConj
abbrev Star_op : CoordEnd := hodgeStar
abbrev Xi_op : CoordEnd := middleExchangeFlip

theorem C_sq : C_op * C_op = 1 := cayleyConj_sq
theorem Star_sq : Star_op * Star_op = 1 := hodgeStar_sq
theorem Xi_sq : Xi_op * Xi_op = 1 := middleExchangeFlip_sq

theorem C_mul_Star : C_op * Star_op = Xi_op := by
  apply LinearMap.ext; intro x; ext <;> simp

theorem Star_mul_C : Star_op * C_op = Xi_op := by
  apply LinearMap.ext; intro x; ext <;> simp

theorem Star_mul_Xi : Star_op * Xi_op = C_op := by
  apply LinearMap.ext; intro x; ext <;> simp

theorem Xi_mul_Star : Xi_op * Star_op = C_op := by
  apply LinearMap.ext; intro x; ext <;> simp

theorem Xi_mul_C : Xi_op * C_op = Star_op := by
  apply LinearMap.ext; intro x; ext <;> simp

theorem C_mul_Xi : C_op * Xi_op = Star_op := by
  apply LinearMap.ext; intro x; ext <;> simp

/-- The three commuting generator involutions for (ℤ₂)³: S (scalar swap), T (mid swap), M (mid flip). -/
abbrev S_gen : CoordEnd := scalarExchange
abbrev T_gen : CoordEnd := middleExchange
abbrev M_gen : CoordEnd := middleSignFlip

theorem S_sq : S_gen * S_gen = 1 := scalarExchange_sq
theorem T_sq : T_gen * T_gen = 1 := middleExchange_sq
theorem M_gen_sq : M_gen * M_gen = 1 := middleSignFlip_sq

theorem S_comm_T : S_gen * T_gen = T_gen * S_gen := by
  apply LinearMap.ext; intro x; ext <;> simp

theorem S_comm_M : S_gen * M_gen = M_gen * S_gen := by
  apply LinearMap.ext; intro x; ext <;> simp

theorem T_comm_M : T_gen * M_gen = M_gen * T_gen := by
  apply LinearMap.ext; intro x; ext <;> simp

/-- Even-parity representation of the Klein group {I, C, ⋆, Ξ} in terms of (S, T, M): -/
theorem C_eq_SM : C_op = S_gen * M_gen :=
  cayleyConj_eq_scalarExchange_mul_middleSignFlip

theorem Star_eq_ST : Star_op = S_gen * T_gen :=
  hodgeStar_eq_scalarExchange_mul_middleExchange

theorem Xi_eq_TM : Xi_op = T_gen * M_gen :=
  middleExchangeFlip_eq_middleExchange_mul_middleSignFlip

theorem C_Star_Xi_triple_product :
    C_op * Star_op * Xi_op = 1 := by
  rw [C_mul_Star, Xi_sq]

/-! The parity packet is closed under composition.  Together with the
involution and joint-eigenspace results above, this is the finite operator
level Klein-four statement; it is deliberately not identified with any
spacetime, Galois, or braid group. -/
def parityPacket : Set CoordEnd := {1, P, GammaF, M_mid}

theorem parityPacket_mul_closed {X Y : CoordEnd}
    (hX : X ∈ parityPacket) (hY : Y ∈ parityPacket) :
    X * Y ∈ parityPacket := by
  simp only [parityPacket, Set.mem_insert_iff, Set.mem_singleton_iff] at hX hY ⊢
  rcases hX with rfl | rfl | rfl | rfl <;>
    rcases hY with rfl | rfl | rfl | rfl <;>
      simp only [one_mul, mul_one, P_sq, GammaF_sq, M_mid_sq,
        P_mul_GammaF, GammaF_mul_P, GammaF_mul_M, M_mul_GammaF,
        M_mul_P, P_mul_M, true_or, or_true]

/-- Native Mathlib submonoid generated by the four parity operators. -/
def paritySubmonoid : Submonoid CoordEnd where
  carrier := parityPacket
  one_mem' := by
    simp [parityPacket]
  mul_mem' := by
    intro X Y hX hY
    exact parityPacket_mul_closed hX hY

@[simp] theorem mem_paritySubmonoid_iff {X : CoordEnd} :
    X ∈ paritySubmonoid ↔ X ∈ parityPacket := Iff.rfl

theorem parity_element_self_inverse {X : CoordEnd}
    (hX : X ∈ paritySubmonoid) :
    X * X = 1 := by
  change X ∈ parityPacket at hX
  simp only [parityPacket, Set.mem_insert_iff, Set.mem_singleton_iff] at hX
  rcases hX with rfl | rfl | rfl | rfl
  · simp
  · exact P_sq
  · exact GammaF_sq
  · exact M_mid_sq

/-- The parity packet is commutative under operator composition. -/
theorem parity_packet_mul_comm {X Y : CoordEnd}
    (hX : X ∈ paritySubmonoid) (hY : Y ∈ paritySubmonoid) :
    X * Y = Y * X := by
  change X ∈ parityPacket at hX
  change Y ∈ parityPacket at hY
  simp only [parityPacket, Set.mem_insert_iff, Set.mem_singleton_iff] at hX hY
  rcases hX with rfl | rfl | rfl | rfl <;>
    rcases hY with rfl | rfl | rfl | rfl <;>
      simp only [one_mul, mul_one, P_sq, GammaF_sq, M_mid_sq,
        P_mul_GammaF, GammaF_mul_P, GammaF_mul_M, M_mul_GammaF,
        M_mul_P, P_mul_M]

