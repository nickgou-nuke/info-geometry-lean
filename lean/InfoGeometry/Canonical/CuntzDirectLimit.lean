/-
Cuntz Direct Limit: Direct Limit of Finite-Stage Word Algebras
==============================================================

This file formalizes the direct limit of Cuntz-Toeplitz algebras generated by
finite binary Cantor/crystal words (`CrystalWord`).

It defines:
  1. `Stage n` as the free algebra generated by words of length at most `n`.
  2. `bond n` as the canonical algebra homomorphism inclusion from stage `n` to stage `n+1`.
  3. `CuntzColimit` as the direct limit of this system.
-/

import Mathlib.Algebra.FreeAlgebra
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Algebra.Colimit.DirectLimit
import InfoGeometry.Canonical.KashiwaraCuntzCohomology
import InfoGeometry.Algebra.DirectLimitSuperClosureLemmas

open InfoGeometry.Canonical.KashiwaraCuntzCohomology
open InfoGeometry.Algebra.DirectLimitSuperClosureLemmas

namespace InfoGeometry.Canonical.KashiwaraCuntzCohomology

variable (R : Type) [CommRing R]

/-- Finite stage algebra at depth `n` generated by words of length ≤ `n` -/
def Stage (n : ℕ) : Type :=
  FreeAlgebra R {w : CrystalWord // w.length ≤ n}

instance (n : ℕ) : Semiring (Stage R n) :=
  inferInstanceAs (Semiring (FreeAlgebra R {w : CrystalWord // w.length ≤ n}))

instance (n : ℕ) : Algebra R (Stage R n) :=
  inferInstanceAs (Algebra R (FreeAlgebra R {w : CrystalWord // w.length ≤ n}))

/-- The one-step algebra bonding homomorphism (inclusion of prefix-tree generators) -/
def bond (n : ℕ) : Stage R n →ₐ[R] Stage R (n + 1) :=
  FreeAlgebra.lift R (fun (w : {w : CrystalWord // w.length ≤ n}) =>
    FreeAlgebra.ι R ⟨w.val, Nat.le_trans w.property (Nat.le_succ n)⟩)

/-- One-step bonding map represented as a ring homomorphism -/
def bondRing (n : ℕ) : Stage R n →+* Stage R (n + 1) :=
  (bond R n).toRingHom

/-- The infinite-dimensional colimit (direct limit) of the Cuntz-Toeplitz algebra system -/
abbrev CuntzColimit : Type :=
  DirectLimitSuperClosure (Stage := Stage R) (bondRing R)

end InfoGeometry.Canonical.KashiwaraCuntzCohomology
