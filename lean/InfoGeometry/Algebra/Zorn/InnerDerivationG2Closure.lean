import InfoGeometry.Algebra.Zorn.NativeStanDerivationCoverage
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Lie.CanonicalZornDerivationDimension

/-!
# Native split-octonion inner-derivation closure

This owner closes the finite linear-algebra statement left open by the original
Schafer-derivation bridge.  The existing native Zorn development already proves
that the standard bilinear operators

`D_{x,y} = [L_x,L_y] + [L_x,R_y] + [R_x,R_y]`

are genuine derivations and satisfy the exact operatorial normal form

`D_{x,y}(z) = [[x,y],z] - 3 [x,y,z]`.

`NativeStanDerivationCoverage` further proves that their span is the whole native
derivation carrier.  Combining that theorem with the independently proved
14-dimensional native derivation carrier gives the exact finite statement:
all native split-octonion derivations are generated linearly by the Schafer
inner derivations, and that generated space has real dimension 14.

This does not identify the global automorphism group with a concrete Lie group
object `G₂(2)`/`G_{2(2)}`.  It closes the derivation-algebra carrier and dimension
statement only.
-/

noncomputable section

namespace InfoGeometry.Algebra.Zorn.InnerDerivationG2Closure

open InfoGeometry.Algebra
open InfoGeometry.Algebra.Zorn.NativeStanDerivationBilinear
open InfoGeometry.Algebra.Zorn.NativeStanDerivationCoverage

abbrev VZ := ZornVectorMatrix ℝ
abbrev VDer := ZornVectorMatrix.Derivation (R := ℝ)

/-- Linear span of all native Schafer inner derivations `D_{x,y}`. -/
def innerDerivationSpan : Submodule ℝ VDer :=
  Submodule.span ℝ
    (Set.range (fun p : VZ × VZ => innerDerivation p.1 p.2))

/-- Every native split-octonion derivation is a linear combination of Schafer
inner derivations. -/
theorem innerDerivationSpan_eq_top : innerDerivationSpan = ⊤ := by
  exact vector_inner_derivations_span_top

/-- The native Zorn derivation carrier has real dimension 14. -/
theorem nativeDerivation_finrank : Module.finrank ℝ VDer = 14 := by
  exact InfoGeometry.Lie.CanonicalZornDerivationDimension.finrank_vectorDerivations

/-- The span generated by the Schafer inner derivations itself has dimension 14. -/
theorem innerDerivationSpan_finrank :
    Module.finrank ℝ innerDerivationSpan = 14 := by
  rw [innerDerivationSpan_eq_top]
  simpa using nativeDerivation_finrank

/-- Every derivation belongs to the inner-derivation span. -/
theorem mem_innerDerivationSpan (D : VDer) : D ∈ innerDerivationSpan := by
  rw [innerDerivationSpan_eq_top]
  exact Submodule.mem_top

/-- In particular, the Lie bracket of two native derivations lies in the
inner-derivation span.  Lie closure here is not postulated: the target span is
already proved to be the entire derivation carrier. -/
theorem bracket_mem_innerDerivationSpan (D E : VDer) :
    ⁅D, E⁆ ∈ innerDerivationSpan :=
  mem_innerDerivationSpan ⁅D, E⁆

/-- The operatorial associator-absorption formula is exposed at the closure
owner so downstream exceptional-Lie code need not reopen the implementation. -/
theorem innerDerivation_associator_normal_form (x y z : VZ) :
    innerDerivation x y z =
      ((x * y - y * x) * z - z * (x * y - y * x)) -
        3 • ((x * y) * z - x * (y * z)) :=
  innerDerivation_operatorial_normal_form x y z

/-- Compact closure packet: associator absorption, full span, and dimension 14. -/
theorem native_inner_derivation_g2_packet :
    innerDerivationSpan = ⊤ ∧
    Module.finrank ℝ innerDerivationSpan = 14 :=
  ⟨innerDerivationSpan_eq_top, innerDerivationSpan_finrank⟩

end InfoGeometry.Algebra.Zorn.InnerDerivationG2Closure

