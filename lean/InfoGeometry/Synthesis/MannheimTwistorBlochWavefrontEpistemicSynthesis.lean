/-- **Orthogonal Weyl–Souriau Bloch Wavefront Decomposition & Umegaki Invariance**:
For every `2 × 2` complex matrix `W : Matrix (Fin 2) (Fin 2) ℂ`:
1. **Frobenius Orthogonality**: `Matrix.trace (tracelessPart2 W) = 0` and
   `Tr(Wᴴ W) = |Tr W|² / 2 + Tr((tracelessPart2 W)ᴴ * tracelessPart2 W)`;
2. **Weyl Log-Trace Cocycle & Normalization**: for `W = (Real.exp (2 * β) : ℝ) • W₀` with
   `Matrix.trace W₀ ≠ 0`:
   - `Real.log ‖Matrix.trace W‖ = 2 * β + Real.log ‖Matrix.trace W₀‖` (exact additive conformal cocycle);
   - `weylNormalize W = weylNormalize W₀` (collapsing the dilation mode onto `Tr = 1`);
   - Exact Weyl invariance of Bloch radius, coherence relative entropy, and Umegaki Gibbs entropy;
3. **Umegaki–Pythagoras Bridge**: when `ρ := weylNormalize W₀` is self-adjoint, unit-trace, with
   `blochNormSq ρ < 1`, `umegakiKernel_trace_and_coherence_pythagoras` holds on `ρ`. -/
theorem orthogonal_weyl_souriau_bloch_wavefront :
    (∀ W : Matrix (Fin 2) (Fin 2) ℂ,
      Matrix.trace (tracelessPart2 W) = 0 ∧
      Matrix.trace (Wᴴ * W) =
        ((Complex.normSq (Matrix.trace W) / 2 : ℝ) : ℂ) +
          Matrix.trace ((tracelessPart2 W)ᴴ * tracelessPart2 W)) ∧
    (∀ (β θ : ℝ) (W₀ : Matrix (Fin 2) (Fin 2) ℂ),
      Matrix.trace W₀ ≠ 0 →
      let W : Matrix (Fin 2) (Fin 2) ℂ := (Real.exp (2 * β) : ℝ) • W₀
      Real.log ‖Matrix.trace W‖ = 2 * β + Real.log ‖Matrix.trace W₀‖ ∧
      weylNormalize W = weylNormalize W₀ ∧
      blochRadius (weylNormalize W) = blochRadius (weylNormalize W₀) ∧
      coherenceRelEntropy (weylNormalize W) = coherenceRelEntropy (weylNormalize W₀) ∧
      quantumUmegakiGibbs (weylNormalize W) θ = quantumUmegakiGibbs (weylNormalize W₀) θ) ∧
    (∀ (W₀ : Matrix (Fin 2) (Fin 2) ℂ) (θ : ℝ),
      let ρ := weylNormalize W₀
      IsSelfAdjoint ρ → Matrix.trace ρ = 1 → blochNormSq ρ < 1 →
      0 ≤ quantumUmegakiGibbs ρ θ ∧
      quantumUmegakiGibbs ρ θ = coherenceRelEntropy ρ + bregmanPhi (blochZ ρ) (meanSpin θ)) := by
  refine ⟨?_, ?_, ?_⟩
  · intro W
    have htr0 : Matrix.trace (tracelessPart2 W) = 0 := by
      unfold tracelessPart2
      rw [Matrix.trace_sub, Matrix.trace_smul, show Matrix.trace (1 : Matrix (Fin 2) (Fin 2) ℂ) = 2 by
        simp [Matrix.trace]]
      simp [smul_eq_mul]
    have hnormSq (z : ℂ) : star z * z = ((Complex.normSq z : ℝ) : ℂ) := by
      rw [mul_comm, Complex.star_def, Complex.mul_conj]
    have hfrob : Matrix.trace (Wᴴ * W) =
        ((Complex.normSq (Matrix.trace W) / 2 : ℝ) : ℂ) +
          Matrix.trace ((tracelessPart2 W)ᴴ * tracelessPart2 W) := by
      have hconj_2 : star ((2 : ℂ)) = (2 : ℂ) := by simp
      simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.conjTranspose_apply,
        tracelessPart2, Matrix.sub_apply, Matrix.smul_apply, Matrix.one_apply, Fin.sum_univ_two,
        smul_eq_mul, Fin.isValue, zero_ne_one, one_ne_zero, ite_true, ite_false,
        Complex.ofReal_div, Complex.ofReal_ofNat]
      simp only [star_sub, star_mul, hconj_2, star_div₀, star_zero]
      have hns : ((Complex.normSq (W 0 0 + W 1 1) : ℝ) : ℂ) =
          star (W 0 0 + W 1 1) * (W 0 0 + W 1 1) := (hnormSq (W 0 0 + W 1 1)).symm
      rw [hns, star_add]
      ring
    exact ⟨htr0, hfrob⟩
  · intro β θ W₀ htr0 W
    have hexp_pos : 0 < Real.exp (2 * β) := Real.exp_pos (2 * β)
    have hW_csmul : W = (Real.exp (2 * β) : ℂ) • W₀ := by
      ext i j; simp [W, Complex.real_smul]
    have htr_scale : Matrix.trace W = (Real.exp (2 * β) : ℂ) * Matrix.trace W₀ := by
      rw [hW_csmul, Matrix.trace_smul, smul_eq_mul]
    have hlog : Real.log ‖Matrix.trace W‖ = 2 * β + Real.log ‖Matrix.trace W₀‖ := by
      rw [htr_scale, norm_mul, Complex.norm_of_nonneg hexp_pos.le,
          Real.log_mul hexp_pos.ne' (norm_ne_zero_iff.mpr htr0), Real.log_exp]
    have hwnorm : weylNormalize W = weylNormalize W₀ := by
      unfold weylNormalize
      rw [htr_scale, mul_inv, hW_csmul, smul_smul]
      have hexpC : (Real.exp (2 * β) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hexp_pos.ne'
      congr 1
      field_simp [hexpC, htr0]
    exact ⟨hlog, hwnorm, by rw [hwnorm], by rw [hwnorm], by rw [hwnorm]⟩
  · intro W₀ θ ρ hsa htr hb
    have hu := umegakiKernel_trace_and_coherence_pythagoras hsa htr hb θ
    exact ⟨hu.2.2.2.1, hu.2.1⟩

/-- Constructive Weyl-invariant Bloch density state `ρ(W) := (Tr(Wᴴ W))⁻¹ • (Wᴴ W)`
generated canonically from any nonzero complex amplitude matrix `W : M₂(ℂ)` (discharging
`IsSelfAdjoint`, `trace = 1`, `IsStrictlyPositive`, and `blochNormSq < 1 ↔ det W ≠ 0`). -/
def gramBlochState (W : Matrix (Fin 2) (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  weylNormalize (Wᴴ * W)

/-- **Constructive Determinant & Unconditional Umegaki Theorem on `GL₂(ℂ)` (`C-COND` #3 Discharge)**:
1. For any self-adjoint unit-trace `2 × 2` state `ρ`, `1 - blochNormSq ρ = 4 * (Matrix.det ρ).re`;
2. For every nonzero `W : M₂(ℂ)`:
   - `(Matrix.trace (Wᴴ * W)).im = 0`, `0 < (Matrix.trace (Wᴴ * W)).re`, and `Matrix.trace (Wᴴ * W) ≠ 0`;
   - `IsSelfAdjoint (gramBlochState W)` and `Matrix.trace (gramBlochState W) = 1`;
   - `1 - blochNormSq (gramBlochState W) = 4 * Complex.normSq (Matrix.det W) / ((Matrix.trace (Wᴴ * W)).re) ^ 2`;
   - `blochNormSq (gramBlochState W) ≤ 1` and `blochNormSq (gramBlochState W) < 1 ↔ Matrix.det W ≠ 0`;
   - Exact scale–gauge invariance `gramBlochState (scaleGaugeMultiplier β α • W) = gramBlochState W`;
3. **Unconditional `GL₂(ℂ)` Umegaki Pythagoras & `IsStrictlyPositive`**:
   for every `W₀ : M₂(ℂ)` with `Matrix.det W₀ ≠ 0` and every inverse temperature `θ : ℝ` (with
   **zero** extra self-adjointness, unit-trace, or Bloch-radius hypotheses!),
   `ρ := gramBlochState W₀` satisfies `IsStrictlyPositive ρ`, `0 ≤ quantumUmegakiGibbs ρ θ`, and
   `quantumUmegakiGibbs ρ θ = coherenceRelEntropy ρ + bregmanPhi (blochZ ρ) (meanSpin θ)`. -/
theorem gramBlochState_determinant_and_unconditional_umegaki :
    (∀ ρ : Matrix (Fin 2) (Fin 2) ℂ, IsSelfAdjoint ρ → Matrix.trace ρ = 1 →
      1 - blochNormSq ρ = 4 * (Matrix.det ρ).re) ∧
    (∀ W : Matrix (Fin 2) (Fin 2) ℂ, W ≠ 0 →
      (Matrix.trace (Wᴴ * W)).im = 0 ∧
      0 < (Matrix.trace (Wᴴ * W)).re ∧
      Matrix.trace (Wᴴ * W) ≠ 0 ∧
      IsSelfAdjoint (gramBlochState W) ∧
      Matrix.trace (gramBlochState W) = 1 ∧
      1 - blochNormSq (gramBlochState W) =
        4 * Complex.normSq (Matrix.det W) / ((Matrix.trace (Wᴴ * W)).re) ^ 2 ∧
      blochNormSq (gramBlochState W) ≤ 1 ∧
      (blochNormSq (gramBlochState W) < 1 ↔ Matrix.det W ≠ 0)) ∧
    (∀ (β α : ℝ) (W : Matrix (Fin 2) (Fin 2) ℂ),
      gramBlochState (scaleGaugeMultiplier β α • W) = gramBlochState W) ∧
    (∀ (W₀ : Matrix (Fin 2) (Fin 2) ℂ) (θ : ℝ), Matrix.det W₀ ≠ 0 →
      let ρ := gramBlochState W₀
      IsSelfAdjoint ρ ∧ Matrix.trace ρ = 1 ∧ blochNormSq ρ < 1 ∧
      IsStrictlyPositive ρ ∧
      0 ≤ quantumUmegakiGibbs ρ θ ∧
      quantumUmegakiGibbs ρ θ = coherenceRelEntropy ρ + bregmanPhi (blochZ ρ) (meanSpin θ)) := by
  have hnormSq : ∀ z : ℂ, star z * z = ((Complex.normSq z : ℝ) : ℂ) := fun z => by
    rw [mul_comm, Complex.star_def, Complex.mul_conj]
  have hdet_self : ∀ ρ : Matrix (Fin 2) (Fin 2) ℂ, IsSelfAdjoint ρ → Matrix.trace ρ = 1 →
      1 - blochNormSq ρ = 4 * (Matrix.det ρ).re := by
    intro ρ hsa htr
    rcases hermitian_unitTrace_entries hsa htr with ⟨h00, h11, h10, _⟩
    have hdet : Matrix.det ρ =
        ((((1 + blochZ ρ) / 2) * ((1 - blochZ ρ) / 2) - Complex.normSq (ρ 0 1) : ℝ) : ℂ) := by
      rw [Matrix.det_fin_two, h00, h11, h10]
      have hmul : ρ 0 1 * star (ρ 0 1) = ((Complex.normSq (ρ 0 1) : ℝ) : ℂ) := by
        rw [mul_comm]; exact hnormSq (ρ 0 1)
      rw [hmul]
      push_cast
      ring
    have hre : (Matrix.det ρ).re =
        ((1 + blochZ ρ) / 2) * ((1 - blochZ ρ) / 2) - Complex.normSq (ρ 0 1) := by
      rw [hdet, Complex.ofReal_re]
    rw [hre]
    unfold blochNormSq coherenceSq
    ring
  have htr_form : ∀ W : Matrix (Fin 2) (Fin 2) ℂ,
      Matrix.trace (Wᴴ * W) =
        ((Complex.normSq (W 0 0) + Complex.normSq (W 1 0) +
          Complex.normSq (W 0 1) + Complex.normSq (W 1 1) : ℝ) : ℂ) := by
    intro W
    simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.conjTranspose_apply,
      Fin.sum_univ_two, hnormSq]
    push_cast
    ring
  have hgram : ∀ W : Matrix (Fin 2) (Fin 2) ℂ, W ≠ 0 →
      (Matrix.trace (Wᴴ * W)).im = 0 ∧
      0 < (Matrix.trace (Wᴴ * W)).re ∧
      Matrix.trace (Wᴴ * W) ≠ 0 ∧
      IsSelfAdjoint (gramBlochState W) ∧
      Matrix.trace (gramBlochState W) = 1 ∧
      1 - blochNormSq (gramBlochState W) =
        4 * Complex.normSq (Matrix.det W) / ((Matrix.trace (Wᴴ * W)).re) ^ 2 ∧
      blochNormSq (gramBlochState W) ≤ 1 ∧
      (blochNormSq (gramBlochState W) < 1 ↔ Matrix.det W ≠ 0) := by
    intro W hW
    have htf := htr_form W
    have him : (Matrix.trace (Wᴴ * W)).im = 0 := by rw [htf, Complex.ofReal_im]
    have hre_eq : (Matrix.trace (Wᴴ * W)).re =
        Complex.normSq (W 0 0) + Complex.normSq (W 1 0) +
          Complex.normSq (W 0 1) + Complex.normSq (W 1 1) := by
      rw [htf, Complex.ofReal_re]
    have hre_pos : 0 < (Matrix.trace (Wᴴ * W)).re := by
      rw [hre_eq]
      have hne : ∃ i j : Fin 2, W i j ≠ 0 := by
        by_contra hall
        push Not at hall
        apply hW
        ext i j
        exact hall i j
      rcases hne with ⟨i, j, hij⟩
      have hpos_ij : 0 < Complex.normSq (W i j) := Complex.normSq_pos.mpr hij
      have h00 : 0 ≤ Complex.normSq (W 0 0) := Complex.normSq_nonneg _
      have h10 : 0 ≤ Complex.normSq (W 1 0) := Complex.normSq_nonneg _
      have h01 : 0 ≤ Complex.normSq (W 0 1) := Complex.normSq_nonneg _
      have h11 : 0 ≤ Complex.normSq (W 1 1) := Complex.normSq_nonneg _
      have hi01 : i = 0 ∨ i = 1 := by fin_cases i <;> [left; right] <;> rfl
      have hj01 : j = 0 ∨ j = 1 := by fin_cases j <;> [left; right] <;> rfl
      rcases hi01 with rfl | rfl <;> rcases hj01 with rfl | rfl <;> linarith
    have htr_ne : Matrix.trace (Wᴴ * W) ≠ 0 := by
      intro hz
      have := congrArg Complex.re hz
      rw [Complex.zero_re] at this
      linarith
    have hsa_WW : IsSelfAdjoint (Wᴴ * W) := by
      rw [IsSelfAdjoint, Matrix.star_eq_conjTranspose, Matrix.conjTranspose_mul,
        Matrix.conjTranspose_conjTranspose]
    have hstar_tr : star (Matrix.trace (Wᴴ * W)) = Matrix.trace (Wᴴ * W) := by
      rw [htf]; simp
    have hsa : IsSelfAdjoint (gramBlochState W) := by
      unfold gramBlochState weylNormalize
      rw [IsSelfAdjoint, star_smul, star_inv₀, hstar_tr, hsa_WW.star_eq]
    have htr1 : Matrix.trace (gramBlochState W) = 1 := by
      unfold gramBlochState weylNormalize
      rw [Matrix.trace_smul, smul_eq_mul, inv_mul_cancel₀ htr_ne]
    have hdet_eq : 1 - blochNormSq (gramBlochState W) =
        4 * Complex.normSq (Matrix.det W) / ((Matrix.trace (Wᴴ * W)).re) ^ 2 := by
      rw [hdet_self (gramBlochState W) hsa htr1]
      have hdet_WW : Matrix.det (Wᴴ * W) = (Complex.normSq (Matrix.det W) : ℂ) := by
        rw [Matrix.det_mul, Matrix.det_conjTranspose]
        exact hnormSq W.det
      have hdet_g : Matrix.det (gramBlochState W) =
          (((Complex.normSq (Matrix.det W) / ((Matrix.trace (Wᴴ * W)).re) ^ 2 : ℝ) : ℂ)) := by
        unfold gramBlochState weylNormalize
        rw [Matrix.det_smul, Fintype.card_fin, hdet_WW]
        have htr_real : Matrix.trace (Wᴴ * W) = ((Matrix.trace (Wᴴ * W)).re : ℂ) :=
          Complex.ext rfl him
        rw [htr_real, Complex.ofReal_re]
        push_cast
        rw [div_eq_mul_inv, mul_comm, inv_pow]
      rw [hdet_g, Complex.ofReal_re]
      ring
    have hle1 : blochNormSq (gramBlochState W) ≤ 1 := by
      have hnonneg : 0 ≤ 4 * Complex.normSq (Matrix.det W) / ((Matrix.trace (Wᴴ * W)).re) ^ 2 :=
        div_nonneg (mul_nonneg (by norm_num) (Complex.normSq_nonneg _)) (sq_nonneg _)
      linarith [hdet_eq, hnonneg]
    have hlt1 : blochNormSq (gramBlochState W) < 1 ↔ Matrix.det W ≠ 0 := by
      have hden_pos : 0 < ((Matrix.trace (Wᴴ * W)).re) ^ 2 := sq_pos_of_pos hre_pos
      have hpos_iff :
          0 < 4 * Complex.normSq (Matrix.det W) / ((Matrix.trace (Wᴴ * W)).re) ^ 2 ↔
            Matrix.det W ≠ 0 := by
        rw [div_pos_iff_of_pos_right hden_pos]
        constructor
        · intro h4 hz
          rw [hz, Complex.normSq_zero, mul_zero] at h4
          exact lt_irrefl _ h4
        · intro hdet_ne
          exact mul_pos (by norm_num) (Complex.normSq_pos.mpr hdet_ne)
      have hsub_lt : blochNormSq (gramBlochState W) < 1 ↔
          0 < 1 - blochNormSq (gramBlochState W) := sub_pos.symm
      rw [hsub_lt, hdet_eq]
      exact hpos_iff
    exact ⟨him, hre_pos, htr_ne, hsa, htr1, hdet_eq, hle1, hlt1⟩
  have hgauge : ∀ (β α : ℝ) (W : Matrix (Fin 2) (Fin 2) ℂ),
      gramBlochState (scaleGaugeMultiplier β α • W) = gramBlochState W := by
    intro β α W
    set c : ℂ := scaleGaugeMultiplier β α
    have hc_ne : c ≠ 0 := Complex.exp_ne_zero _
    have hcc_ne : star c * c ≠ 0 := mul_ne_zero (star_ne_zero.mpr hc_ne) hc_ne
    have hmul : (c • W)ᴴ * (c • W) = (star c * c) • (Wᴴ * W) := by
      rw [Matrix.conjTranspose_smul, Matrix.smul_mul, Matrix.mul_smul, smul_smul]
    unfold gramBlochState weylNormalize
    rw [hmul, Matrix.trace_smul, smul_eq_mul, mul_inv, smul_smul]
    by_cases htr0 : Matrix.trace (Wᴴ * W) = 0
    · simp [htr0]
    · congr 1
      field_simp [hc_ne, star_ne_zero.mpr hc_ne, hcc_ne, htr0]
  refine ⟨hdet_self, hgram, hgauge, ?_⟩
  intro W₀ θ hdet0 ρ
  have hW0 : W₀ ≠ 0 := by
    intro hz
    rw [hz, Matrix.det_zero] at hdet0
    exact hdet0 rfl
  have hg := hgram W₀ hW0
  have hsa : IsSelfAdjoint ρ := hg.2.2.2.1
  have htr : Matrix.trace ρ = 1 := hg.2.2.2.2.1
  have hbn : blochNormSq ρ < 1 := hg.2.2.2.2.2.2.2.mpr hdet0
  have hsp := (spectralProjector_twoSheet_and_cfc_log hsa htr hbn).2.2.2.1
  have hu := umegakiKernel_trace_and_coherence_pythagoras hsa htr hbn θ
  exact ⟨hsa, htr, hbn, hsp, hu.2.2.2.1, hu.2.1⟩

