{"type":"new","contents":"import Mathlib.Algebra.BigOperators.Field\nimport Mathlib.Analysis.SpecialFunctions.Log.Deriv\nimport InfoGeometry.Convex.Bregman\n\nopen scoped BigOperators\n\n/-!\n# Log-Sum-Exp (Finite)\n\nFinite log-sum-exp potentials with smoothness and positivity facts used by\nthe Legendre/exponential-family bridge.\n-/\n\nnamespace InfoGeometry.Analytic\n\n/-- Unnormalized partition sum underlying finite `logSumExp`. -/\nnoncomputable def logSumExpPartition\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) : ℝ :=\n  ∑ i, w i * Real.exp (θ * a i)\n\n/-- Finite log-sum-exp potential with weights `w` and slopes `a`. -/\nnoncomputable def logSumExp\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) : ℝ :=\n  Real.log (logSumExpPartition w a θ)\n\n/-- Softmax/Gibbs weights induced by finite `logSumExp` data. -/\nnoncomputable def logSumExpWeight\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) (i : ι) : ℝ :=\n  w i * Real.exp (θ * a i) / logSumExpPartition w a θ\n\n/-- Unnormalized first moment `∑ wᵢ e^{θ aᵢ} aᵢ`. -/\nnoncomputable def logSumExpMoment1\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) : ℝ :=\n  ∑ i, w i * Real.exp (θ * a i) * a i\n\n/-- Unnormalized second moment `∑ wᵢ e^{θ aᵢ} aᵢ²`. -/\nnoncomputable def logSumExpMoment2\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) : ℝ :=\n  ∑ i, w i * Real.exp (θ * a i) * (a i) ^ (2 : ℕ)\n\n/-- Mean of slopes under the softmax/Gibbs weights. -/\nnoncomputable def logSumExpMean\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) : ℝ :=\n  logSumExpMoment1 w a θ / logSumExpPartition w a θ\n\n/-- Second moment of slopes under the softmax/Gibbs weights. -/\nnoncomputable def logSumExpSecondMoment\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) : ℝ :=\n  logSumExpMoment2 w a θ / logSumExpPartition w a θ\n\n/-- Variance of slopes under the softmax/Gibbs weights. -/\nnoncomputable def logSumExpVariance\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) : ℝ :=\n  logSumExpSecondMoment w a θ - (logSumExpMean w a θ) ^ (2 : ℕ)\n\n/-- `ε`-scaled partition sum `Z_ε(θ) = ∑ᵢ wᵢ exp((θ aᵢ)/ε)`. -/\nnoncomputable def logSumExpScaledPartition\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε θ : ℝ) : ℝ :=\n  logSumExpPartition w (fun i => a i / ε) θ\n\n/-- `ε`-scaled potential `ψ_ε(θ) = ε log Z_ε(θ)`. -/\nnoncomputable def logSumExpScaled\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε θ : ℝ) : ℝ :=\n  ε * logSumExp w (fun i => a i / ε) θ\n\n/-- `ε`-scaled Gibbs/softmax weights. -/\nnoncomputable def logSumExpScaledWeight\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε θ : ℝ) (i : ι) : ℝ :=\n  logSumExpWeight w (fun j => a j / ε) θ i\n\n/-- Mean slope under `ε`-scaled Gibbs weights. -/\nnoncomputable def logSumExpScaledMean\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε θ : ℝ) : ℝ :=\n  ∑ i, logSumExpScaledWeight w a ε θ i * a i\n\n/-- Parameterized KL divergence for the `ε`-scaled Gibbs family. -/\nnoncomputable def logSumExpScaledKL\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε θ η : ℝ) : ℝ :=\n  ∑ i, logSumExpScaledWeight w a ε θ i *\n    (Real.log (logSumExpScaledWeight w a ε θ i)\n      - Real.log (logSumExpScaledWeight w a ε η i))\n\n/-- Bregman divergence generated by `ψ_ε`. -/\nnoncomputable def logSumExpScaledBregman\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε η θ : ℝ) : ℝ :=\n  InfoGeometry.bregmanDiv (logSumExpScaled w a ε) η θ\n\n/-! ### Optimal-Transport Naming Bridge -/\n\n/-- OT naming alias for the `ε`-regularized objective in the scaled Gibbs family. -/\nnoncomputable abbrev logSumExpScaledEntropicTransportObjective\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε θ η : ℝ) : ℝ :=\n  logSumExpScaledKL w a ε θ η\n\n/-- OT naming alias for the convex potential gap in the scaled Gibbs family. -/\nnoncomputable abbrev logSumExpScaledEntropicTransportPotentialGap\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε θ η : ℝ) : ℝ :=\n  logSumExpScaledBregman w a ε η θ\n\n@[simp] lemma logSumExpScaledEntropicTransportObjective_eq\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε θ η : ℝ) :\n    logSumExpScaledEntropicTransportObjective w a ε θ η\n      = logSumExpScaledKL w a ε θ η := rfl\n\n@[simp] lemma logSumExpScaledEntropicTransportPotentialGap_eq\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (ε θ η : ℝ) :\n    logSumExpScaledEntropicTransportPotentialGap w a ε θ η\n      = logSumExpScaledBregman w a ε η θ := rfl\n\n/-- Positivity of the finite weighted exponential sum for strictly positive weights. -/\nlemma logSumExp_sum_pos\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    0 < logSumExpPartition w a θ := by\n  classical\n  unfold logSumExpPartition\n  simpa using\n    (Finset.sum_pos\n      (s := (Finset.univ : Finset ι))\n      (f := fun i => w i * Real.exp (θ * a i))\n      (by\n        intro i hi\n        exact mul_pos (hw i) (Real.exp_pos _))\n      Finset.univ_nonempty)\n\nlemma logSumExpScaledPartition_pos\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ) (ε : ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    0 < logSumExpScaledPartition w a ε θ := by\n  simpa [logSumExpScaledPartition] using\n    logSumExp_sum_pos (w := w) (a := fun i => a i / ε) hw θ\n\nlemma logSumExpWeight_sum_one\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    ∑ i, logSumExpWeight w a θ i = 1 := by\n  unfold logSumExpWeight\n  have hZne : logSumExpPartition w a θ ≠ 0 :=\n    (logSumExp_sum_pos w a hw θ).ne'\n  calc\n    ∑ i, w i * Real.exp (θ * a i) / logSumExpPartition w a θ\n        = (∑ i, w i * Real.exp (θ * a i)) / logSumExpPartition w a θ := by\n            symm\n            simpa [logSumExpPartition] using\n              (Finset.sum_div\n                (s := (Finset.univ : Finset ι))\n                (f := fun i => w i * Real.exp (θ * a i))\n                (a := logSumExpPartition w a θ))\n    _ = 1 := by\n          rw [show (∑ i, w i * Real.exp (θ * a i)) = logSumExpPartition w a θ by rfl]\n          exact div_self hZne\n\nlemma logSumExpWeight_pos\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) (i : ι) :\n    0 < logSumExpWeight w a θ i := by\n  unfold logSumExpWeight\n  exact div_pos\n    (mul_pos (hw i) (Real.exp_pos _))\n    (logSumExp_sum_pos w a hw θ)\n\nlemma logSumExpScaledWeight_sum_one\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ) (ε : ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    ∑ i, logSumExpScaledWeight w a ε θ i = 1 := by\n  simpa [logSumExpScaledWeight] using\n    logSumExpWeight_sum_one (w := w) (a := fun i => a i / ε) hw θ\n\nlemma logSumExpScaledWeight_pos\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ) (ε : ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) (i : ι) :\n    0 < logSumExpScaledWeight w a ε θ i := by\n  simpa [logSumExpScaledWeight] using\n    logSumExpWeight_pos (w := w) (a := fun j => a j / ε) hw θ i\n\nlemma hasDerivAt_logSumExpPartition_term\n    {ι : Type _}\n    (w a : ι → ℝ) (i : ι) (θ : ℝ) :\n    HasDerivAt\n      (fun t : ℝ => w i * Real.exp (t * a i))\n      (w i * (a i * Real.exp (θ * a i)))\n      θ := by\n  have hlin : HasDerivAt (fun t : ℝ => t * a i) (a i) θ := by\n    simpa [mul_comm, mul_left_comm, mul_assoc] using\n      ((hasDerivAt_id' θ).mul_const (a i))\n  have hExp :\n      HasDerivAt (fun t : ℝ => Real.exp (t * a i))\n        (a i * Real.exp (θ * a i)) θ := by\n    simpa [mul_comm, mul_left_comm, mul_assoc] using\n      (Real.hasDerivAt_exp (θ * a i)).comp θ hlin\n  simpa [mul_assoc, mul_left_comm, mul_comm] using hExp.const_mul (w i)\n\nlemma hasDerivAt_logSumExpPartition\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) :\n    HasDerivAt (logSumExpPartition w a) (logSumExpMoment1 w a θ) θ := by\n  classical\n  unfold logSumExpPartition logSumExpMoment1\n  simpa [mul_assoc, mul_left_comm, mul_comm] using\n    (HasDerivAt.fun_sum\n      (u := (Finset.univ : Finset ι))\n      (fun i _ => hasDerivAt_logSumExpPartition_term (w := w) (a := a) (i := i) (θ := θ)))\n\nlemma deriv_logSumExpPartition\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) :\n    deriv (logSumExpPartition w a) θ = logSumExpMoment1 w a θ :=\n  (hasDerivAt_logSumExpPartition w a θ).deriv\n\nlemma hasDerivAt_logSumExpMoment1\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) :\n    HasDerivAt (logSumExpMoment1 w a) (logSumExpMoment2 w a θ) θ := by\n  classical\n  unfold logSumExpMoment1 logSumExpMoment2\n  refine (HasDerivAt.fun_sum (u := (Finset.univ : Finset ι)) (fun i _ => ?_))\n  have hbase :\n      HasDerivAt\n        (fun t : ℝ => w i * Real.exp (t * a i))\n        (w i * (a i * Real.exp (θ * a i)))\n        θ :=\n    hasDerivAt_logSumExpPartition_term (w := w) (a := a) (i := i) (θ := θ)\n  have hmul :\n      HasDerivAt\n        (fun t : ℝ => (w i * Real.exp (t * a i)) * a i)\n        ((w i * (a i * Real.exp (θ * a i))) * a i)\n        θ :=\n    hbase.mul_const (a i)\n  simpa [pow_two, mul_assoc, mul_left_comm, mul_comm] using hmul\n\nlemma deriv_logSumExpMoment1\n    {ι : Type _} [Fintype ι]\n    (w a : ι → ℝ) (θ : ℝ) :\n    deriv (logSumExpMoment1 w a) θ = logSumExpMoment2 w a θ :=\n  (hasDerivAt_logSumExpMoment1 w a θ).deriv\n\nlemma logSumExpMean_eq_weighted_sum\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    logSumExpMean w a θ = ∑ i, logSumExpWeight w a θ i * a i := by\n  unfold logSumExpMean logSumExpMoment1 logSumExpWeight\n  have hZne : logSumExpPartition w a θ ≠ 0 :=\n    (logSumExp_sum_pos w a hw θ).ne'\n  calc\n    (∑ i, w i * Real.exp (θ * a i) * a i) / logSumExpPartition w a θ\n        = ∑ i, (w i * Real.exp (θ * a i) * a i) / logSumExpPartition w a θ := by\n            simpa using\n              (Finset.sum_div\n                (s := (Finset.univ : Finset ι))\n                (f := fun i => w i * Real.exp (θ * a i) * a i)\n                (a := logSumExpPartition w a θ))\n    _ = ∑ i, (w i * Real.exp (θ * a i) / logSumExpPartition w a θ) * a i := by\n          refine Finset.sum_congr rfl ?_\n          intro i hi\n          field_simp [hZne]\n    _ = ∑ i, logSumExpWeight w a θ i * a i := by\n          rfl\n\nlemma logSumExpSecondMoment_eq_weighted_sum\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    logSumExpSecondMoment w a θ = ∑ i, logSumExpWeight w a θ i * (a i) ^ (2 : ℕ) := by\n  unfold logSumExpSecondMoment logSumExpMoment2 logSumExpWeight\n  have hZne : logSumExpPartition w a θ ≠ 0 :=\n    (logSumExp_sum_pos w a hw θ).ne'\n  calc\n    (∑ i, w i * Real.exp (θ * a i) * (a i) ^ (2 : ℕ)) / logSumExpPartition w a θ\n        =\n      ∑ i, (w i * Real.exp (θ * a i) * (a i) ^ (2 : ℕ)) / logSumExpPartition w a θ := by\n            simpa using\n              (Finset.sum_div\n                (s := (Finset.univ : Finset ι))\n                (f := fun i => w i * Real.exp (θ * a i) * (a i) ^ (2 : ℕ))\n                (a := logSumExpPartition w a θ))\n    _ = ∑ i, (w i * Real.exp (θ * a i) / logSumExpPartition w a θ) * (a i) ^ (2 : ℕ) := by\n          refine Finset.sum_congr rfl ?_\n          intro i hi\n          field_simp [hZne]\n    _ = ∑ i, logSumExpWeight w a θ i * (a i) ^ (2 : ℕ) := by\n          rfl\n\nlemma logSumExp_deriv_eq_ratio\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    deriv (logSumExp w a) θ\n      = logSumExpMoment1 w a θ / logSumExpPartition w a θ := by\n  have hdiff : DifferentiableAt ℝ (logSumExpPartition w a) θ :=\n    (hasDerivAt_logSumExpPartition (w := w) (a := a) (θ := θ)).differentiableAt\n  have hne : logSumExpPartition w a θ ≠ 0 :=\n    (logSumExp_sum_pos w a hw θ).ne'\n  unfold logSumExp\n  calc\n    deriv (fun t => Real.log (logSumExpPartition w a t)) θ\n        = deriv (logSumExpPartition w a) θ / logSumExpPartition w a θ := by\n            simpa using (deriv.log (f := logSumExpPartition w a) hdiff hne)\n    _ = logSumExpMoment1 w a θ / logSumExpPartition w a θ := by\n          rw [deriv_logSumExpPartition]\n\nlemma logSumExp_deriv_eq_mean\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    deriv (logSumExp w a) θ = logSumExpMean w a θ := by\n  simpa [logSumExpMean] using logSumExp_deriv_eq_ratio (w := w) (a := a) hw θ\n\nlemma logSumExp_secondDeriv_eq_ratio\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    deriv (fun t => deriv (logSumExp w a) t) θ\n      =\n      (logSumExpMoment2 w a θ * logSumExpPartition w a θ\n        - logSumExpMoment1 w a θ * logSumExpMoment1 w a θ)\n        / (logSumExpPartition w a θ) ^ (2 : ℕ) := by\n  have hderiv :\n      (fun t => deriv (logSumExp w a) t)\n        = fun t => logSumExpMoment1 w a t / logSumExpPartition w a t := by\n    funext t\n    simpa using logSumExp_deriv_eq_ratio (w := w) (a := a) hw t\n  rw [hderiv]\n  have hnumDiff : DifferentiableAt ℝ (logSumExpMoment1 w a) θ :=\n    (hasDerivAt_logSumExpMoment1 (w := w) (a := a) (θ := θ)).differentiableAt\n  have hdenDiff : DifferentiableAt ℝ (logSumExpPartition w a) θ :=\n    (hasDerivAt_logSumExpPartition (w := w) (a := a) (θ := θ)).differentiableAt\n  have hZne : logSumExpPartition w a θ ≠ 0 :=\n    (logSumExp_sum_pos w a hw θ).ne'\n  calc\n    deriv (fun t => logSumExpMoment1 w a t / logSumExpPartition w a t) θ\n        =\n        (deriv (logSumExpMoment1 w a) θ * logSumExpPartition w a θ\n          - logSumExpMoment1 w a θ * deriv (logSumExpPartition w a) θ)\n          / (logSumExpPartition w a θ) ^ (2 : ℕ) := by\n            simpa using\n              (deriv_div\n                (c := logSumExpMoment1 w a)\n                (d := logSumExpPartition w a)\n                (x := θ) hnumDiff hdenDiff hZne)\n    _ =\n      (logSumExpMoment2 w a θ * logSumExpPartition w a θ\n        - logSumExpMoment1 w a θ * logSumExpMoment1 w a θ)\n        / (logSumExpPartition w a θ) ^ (2 : ℕ) := by\n          rw [deriv_logSumExpMoment1, deriv_logSumExpPartition]\n\nlemma logSumExp_secondDeriv_eq_variance\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) :\n    deriv (fun t => deriv (logSumExp w a) t) θ = logSumExpVariance w a θ := by\n  rw [logSumExpVariance, logSumExpSecondMoment, logSumExpMean]\n  rw [logSumExp_secondDeriv_eq_ratio (w := w) (a := a) hw θ]\n  have hZne : logSumExpPartition w a θ ≠ 0 :=\n    (logSumExp_sum_pos w a hw θ).ne'\n  field_simp [hZne]\n\nlemma logSumExpScaledMean_eq_eps_mul_mean\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ) (ε : ℝ)\n    (hw : ∀ i, 0 < w i)\n    (heps : ε ≠ 0)\n    (θ : ℝ) :\n    logSumExpScaledMean w a ε θ\n      = ε * logSumExpMean w (fun i => a i / ε) θ := by\n  let p : ι → ℝ := fun i => logSumExpScaledWeight w a ε θ i\n  have hmean :\n      logSumExpMean w (fun i => a i / ε) θ\n        = ∑ i, p i * (a i / ε) := by\n    simpa [p, logSumExpScaledWeight] using\n      logSumExpMean_eq_weighted_sum (w := w) (a := fun i => a i / ε) hw θ\n  unfold logSumExpScaledMean\n  calc\n    ∑ i, p i * a i\n        = ∑ i, ε * (p i * (a i / ε)) := by\n            refine Finset.sum_congr rfl ?_\n            intro i hi\n            have hεi : ε * (a i / ε) = a i := by\n              field_simp [heps]\n            calc\n              p i * a i = p i * (ε * (a i / ε)) := by rw [hεi]\n              _ = ε * (p i * (a i / ε)) := by ring\n    _ = ε * ∑ i, p i * (a i / ε) := by\n          rw [Finset.mul_sum]\n    _ = ε * logSumExpMean w (fun i => a i / ε) θ := by\n          rw [hmean]\n\n/-- First derivative of `ψ_ε` equals the `ε`-scaled Gibbs mean. -/\nlemma logSumExpScaled_deriv_eq_mean\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ) (ε : ℝ)\n    (hw : ∀ i, 0 < w i)\n    (heps : ε ≠ 0)\n    (θ : ℝ) :\n    deriv (logSumExpScaled w a ε) θ = logSumExpScaledMean w a ε θ := by\n  unfold logSumExpScaled\n  calc\n    deriv (fun t => ε * logSumExp w (fun i => a i / ε) t) θ\n        = ε * deriv (fun t => logSumExp w (fun i => a i / ε) t) θ := by\n            rw [deriv_const_mul_field]\n    _ = ε * logSumExpMean w (fun i => a i / ε) θ := by\n          rw [logSumExp_deriv_eq_mean (w := w) (a := fun i => a i / ε) hw θ]\n    _ = logSumExpScaledMean w a ε θ := by\n          symm\n          exact logSumExpScaledMean_eq_eps_mul_mean\n            (w := w) (a := a) (ε := ε) hw heps θ\n\nlemma logSumExpScaled_logWeight_eq\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ) (ε : ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ : ℝ) (i : ι) :\n    Real.log (logSumExpScaledWeight w a ε θ i)\n      =\n      Real.log (w i)\n        + (θ * a i) / ε\n        - Real.log (logSumExpScaledPartition w a ε θ) := by\n  unfold logSumExpScaledWeight logSumExpWeight\n  have hwi : w i ≠ 0 := (hw i).ne'\n  have hexp : Real.exp (θ * (a i / ε)) ≠ 0 := (Real.exp_pos _).ne'\n  have hZ : logSumExpScaledPartition w a ε θ ≠ 0 :=\n    (logSumExpScaledPartition_pos (w := w) (a := a) (ε := ε) hw θ).ne'\n  calc\n    Real.log (w i * Real.exp (θ * (a i / ε)) / logSumExpScaledPartition w a ε θ)\n        =\n        Real.log (w i * Real.exp (θ * (a i / ε)))\n          - Real.log (logSumExpScaledPartition w a ε θ) := by\n            rw [Real.log_div (mul_ne_zero hwi hexp) hZ]\n    _ =\n      Real.log (w i) + Real.log (Real.exp (θ * (a i / ε)))\n        - Real.log (logSumExpScaledPartition w a ε θ) := by\n          rw [Real.log_mul hwi hexp]\n    _ =\n      Real.log (w i) + (θ * (a i / ε))\n        - Real.log (logSumExpScaledPartition w a ε θ) := by\n          simp\n    _ =\n      Real.log (w i) + (θ * a i) / ε\n        - Real.log (logSumExpScaledPartition w a ε θ) := by\n          ring\n\n/-- Expanded KL formula for the `ε`-scaled Gibbs family. -/\nlemma logSumExpScaledKL_eq\n    {ι : Type _} [Fintype ι] [Nonempty ι]\n    (w a : ι → ℝ) (ε : ℝ)\n    (hw : ∀ i, 0 < w i)\n    (θ η : ℝ) :\n    logSumExpScaledKL w a ε θ η\n      =\n      ((θ - η) / ε) * logSumExpScaledMean w a ε θ\n        -\n      (Real.log (logSumExpScaledPartition w a ε θ)\n        - Real.log (logSumExpScaledPartition w a ε η)) := by\n  unfold logSumExpScaledKL logSumExpScaledMean\n  calc\n    ∑ i,\n      logSumExpScaledWeight w a ε θ i\n        *\n      (Real.log (logSumExpScaledWeight w a ε θ i)\n        - Real.log (logSumExpScaledWeight w a ε η i))\n      =\n      ∑ i,\n        logSumExpScaledWeight w a ε θ i\n          *\n        ((((θ - η) * a i) / ε)\n          - (Real.log (logSumExpScaledPartition w a ε θ)\n            - Real.log (logSumExpScaledPartition w a ε η))) := by\n            refine Finset.sum_congr rfl ?_\n            intro i hi\n            rw [logSumExpScaled_logWeight_eq (w := w) (a := a) (ε := ε) hw θ i]\n            rw [logSumExpScaled_logWeight_eq (w := w) (a := a) (ε := ε) hw η i]\n            ring\n    _ =\n      ∑ i,\n        (((θ - η) / ε) * (logSumExpScaledWeight w a ε θ i * a i)\n          - (Real.log (logSumExpScaledPartition w a ε θ)\n              - Real.log (logSumExpScaledPartition w a ε η))\n              * logSumExpScaledWeight w a ε θ i) := by\n            refine Finset.sum_congr rfl ?_\n            intro i hi\n            ring\n    _ =\n      ((θ - η) / ε) * (∑ i, logSumExpScaledWeight w a ε θ i * a i)\n        -\n      (Real.log (logSumExpScaledPartition w a ε θ)\n        - Real.log (logSumExpScaledPartition w a ε η))\n        * (∑ i, logSumExpScaledWeight w a ε θ i) := by\n          rw [Finset.sum_sub_distrib, Finset.mul_sum, Finset.mul_sum]\n    _ =\n      ((θ - η) / ε) * logSumExpScaledMean w a ε θ\n        -\n      (Real.log (logSumExpScaledPartition w a ε θ)\n        - Real.log (logSumExpScaledPartition w a ε η)) := by\n          rw [show (∑ i, logSumExpScaledWeight w a ε θ i * a i)\n              = logSumExpScaledMean w a ε θ by rfl]\n          rw [logSumExpScaledWeight_sum_one (w := w) (a := a) (ε := ε) hw θ]\n          ring\n\n/-- `ε`-scaled KL as an inverse-temperature weighted