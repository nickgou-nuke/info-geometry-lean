import InfoGeometry.Canonical.TimeReversalKramers
import InfoGeometry.Canonical.BogoliubovTransport
import InfoGeometry.Meta.Architecture

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.ModularKramersBridge

Bridge the doubled-real Kramers lane to modular conjugation/flow fixed sectors.

This file stays in the repo-native language `(H₂, J, ε, K)`:
- `J` from `modular_j`,
- `K = J ∘ ε` from `phaseAxisK`,
- Kramers symmetry as real-linear/Krein-isometric/phase-antilinear.
-/

namespace InfoGeometry.Canonical.ModularKramersBridge

open InfoGeometry.Krein
open InfoGeometry.Canonical.HestenesRealStructures
open InfoGeometry.Canonical.TimeReversalKramers
open InfoGeometry.Canonical.OperatorDictionary
open InfoGeometry.Canonical.BogoliubovTransport

section Core

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance
local instance : SMulCommClass ℝ EndH EndH := inferInstance
local instance : IsScalarTower ℝ EndH EndH := inferInstance

/-- Fixed-point predicate for a doubled-carrier operator action. -/
@[rep_depth krein]
def IsFixedBy (U : EndH) (u : H₂) : Prop := U u = u

/-- Fixed-point predicate for the modular transport flow generated by `hMod`. -/
@[rep_depth transport]
def IsFixedByModularFlow (hMod : EndH) (u : H₂) : Prop :=
  ∀ t : ℝ, modularTransportFlow (E := E) hMod t u = u

/--
If `Θ` commutes with modular conjugation `J`, it preserves the `J`-fixed sector.
-/
@[rep_depth krein]
theorem kramers_preserves_modularConjugation_fixed_of_commute
    (S : KramersSymmetry (E := E))
    (hJ : Commute S.Θ (modular_j (E := E)))
    {u : H₂}
    (hu : IsFixedBy (modular_j (E := E)) u) :
    IsFixedBy (modular_j (E := E)) (S.Θ u) := by
  unfold IsFixedBy at hu ⊢
  calc
    modular_j (E := E) (S.Θ u) = ((modular_j (E := E)) * S.Θ) u := rfl
    _ = (S.Θ * (modular_j (E := E))) u := by rw [hJ.eq]
    _ = S.Θ ((modular_j (E := E)) u) := rfl
    _ = S.Θ u := by rw [hu]

/--
If `Θ` commutes pointwise with the modular flow, it preserves modular-flow
fixed vectors.
-/
@[rep_depth transport]
theorem kramers_preserves_modularFlow_fixed_of_commute
    (S : KramersSymmetry (E := E))
    (hMod : EndH)
    (hComm : ∀ t : ℝ, Commute S.Θ (modularTransportFlow (E := E) hMod t))
    {u : H₂}
    (hu : IsFixedByModularFlow (E := E) hMod u) :
    IsFixedByModularFlow (E := E) hMod (S.Θ u) := by
  intro t
  have hCommT : Commute S.Θ (modularTransportFlow (E := E) hMod t) := hComm t
  have huT : modularTransportFlow (E := E) hMod t u = u := hu t
  calc
    modularTransportFlow (E := E) hMod t (S.Θ u)
        = ((modularTransportFlow (E := E) hMod t) * S.Θ) u := rfl
    _ = (S.Θ * modularTransportFlow (E := E) hMod t) u := by
          rw [hCommT.eq]
    _ = S.Θ (modularTransportFlow (E := E) hMod t u) := rfl
    _ = S.Θ u := by rw [huT]

/--
Capstone API name: if `Θ` commutes with the modular-flow generator, then `Θ`
commutes with the full modular flow.
-/
@[rep_depth transport]
theorem theta_commutes_modularFlow_of_commute_generator
    (S : KramersSymmetry (E := E))
    (hMod : EndH)
    (hCommGen : Commute S.Θ (modularTransportGenerator (E := E) hMod)) :
    ∀ t : ℝ, Commute S.Θ (modularTransportFlow (E := E) hMod t) := by
  intro t
  simpa [modularTransportFlow] using ((hCommGen.smul_right t).exp_right)

/--
Capstone API name: if `Θ` commutes pointwise with modular flow, `Θ` preserves
the modular fixed sector.
-/
@[rep_depth transport]
theorem theta_preserves_modular_fixedSector_of_commute_flow
    (S : KramersSymmetry (E := E))
    (hMod : EndH)
    (hComm : ∀ t : ℝ, Commute S.Θ (modularTransportFlow (E := E) hMod t))
    {u : H₂}
    (hu : IsFixedByModularFlow (E := E) hMod u) :
    IsFixedByModularFlow (E := E) hMod (S.Θ u) :=
  kramers_preserves_modularFlow_fixed_of_commute
    (E := E) (S := S) (hMod := hMod) hComm hu

/--
If the Majorana involution `C` commutes pointwise with modular flow, then the
Majorana fixed sector is preserved by modular transport.
-/
@[rep_depth transport]
theorem majoranaFix_preserved_under_modularFlow_of_commute_C
    (M : MajoranaRealStructure (E := E))
    (hMod : EndH)
    (hComm : ∀ t : ℝ, Commute M.C (modularTransportFlow (E := E) hMod t))
    {u : H₂}
    (hu : M.IsMajorana u) :
    ∀ t : ℝ, M.IsMajorana (modularTransportFlow (E := E) hMod t u) := by
  intro t
  unfold MajoranaRealStructure.IsMajorana at hu ⊢
  have hCommT : Commute M.C (modularTransportFlow (E := E) hMod t) := hComm t
  calc
    M.C (modularTransportFlow (E := E) hMod t u)
        = ((M.C) * modularTransportFlow (E := E) hMod t) u := rfl
    _ = (modularTransportFlow (E := E) hMod t * M.C) u := by
          rw [hCommT.eq]
    _ = modularTransportFlow (E := E) hMod t (M.C u) := rfl
    _ = modularTransportFlow (E := E) hMod t u := by rw [hu]

omit [CompleteSpace E] in
/--
If the modular seed is phase-linear, the exact modular transport flow commutes
with the internal phase axis `K = J ∘ ε`.
-/
@[rep_depth transport]
theorem phaseAxisK_commutes_modularFlow_of_IsPhaseLinear
    (hMod : EndH)
    (hPhase : IsPhaseLinear (E := E) hMod)
    (t : ℝ) :
    Commute (phaseAxisK (E := E)) (modularTransportFlow (E := E) hMod t) := by
  show (phaseAxisK (E := E)) * modularTransportFlow (E := E) hMod t =
      modularTransportFlow (E := E) hMod t * (phaseAxisK (E := E))
  simpa [phaseAxisK] using
    (complex_i_comp_modularTransportFlow_eq_modularTransportFlow_comp_complex_i_of_IsPhaseLinear
      (E := E) hMod hPhase t)

/--
If `Θ` commutes with modular conjugation `J`, Kramers pairing is equivariant
under `J` on the doubled carrier.
-/
@[rep_depth krein]
theorem modularConjugation_equivariant_kramersPair_of_commute
    (S : KramersSymmetry (E := E))
    (hJ : Commute S.Θ (modular_j (E := E)))
    (u : H₂) :
    (modular_j (E := E) (S.pair u).1, modular_j (E := E) (S.pair u).2)
      =
    S.pair (modular_j (E := E) u) := by
  refine Prod.ext ?_ ?_
  · rfl
  ·
    calc
      modular_j (E := E) (S.pair u).2
          = modular_j (E := E) (S.Θ u) := by rfl
      _ = ((modular_j (E := E)) * S.Θ) u := rfl
      _ = (S.Θ * (modular_j (E := E))) u := by rw [hJ.eq]
      _ = S.Θ (modular_j (E := E) u) := rfl
      _ = (S.pair (modular_j (E := E) u)).2 := by rfl

end Core

end InfoGeometry.Canonical.ModularKramersBridge
