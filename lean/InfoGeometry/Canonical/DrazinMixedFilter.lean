import Mathlib
import InfoGeometry.Algebra.HypercomplexTriad
import InfoGeometry.Canonical.SplitCliffordChiralProjection

/-!
# InfoGeometry.Canonical.DrazinMixedFilter

Concrete mixed-state filter on the `M₂(ℝ)` seed.

We use an explicit commuting decomposition
`X = H + N` with `H = 1` and nilpotent boundary `N`.
The filter is the chiral diagonal extraction
`P_D(A) = N_left * A * N_left + N_right * A * N_right`.

This proves, concretely and without wrappers:
* `[H, N] = 0`
* `N^2 = 0`
* `P_D(N) = 0`
* `P_D(X) = H`
-/

namespace InfoGeometry.Canonical.DrazinMixedFilter

open Matrix
open InfoGeometry.Algebra.HypercomplexTriad
open InfoGeometry.Canonical.SplitCliffordChiralProjection

abbrev M2R := Matrix (Fin 2) (Fin 2) ℝ

/-- Invertible bulk core witness. -/
def H : M2R := (1 : M2R)

/-- Mixed state witness `X = H + N`. -/
noncomputable def X : M2R := H + N

/--
Diagonal/chiral filter that removes boundary transitions.
-/
noncomputable def PD (A : M2R) : M2R :=
  N_left * A * N_left + N_right * A * N_right

/-- Commutation constraint for the concrete mixed witness. -/
theorem comm_H_N : H * N - N * H = 0 := by
  unfold H
  simp

/-- Nilpotency condition for boundary witness. -/
theorem N_sq_zero : N * N = (0 : M2R) := by
  ext i j <;> fin_cases i <;> fin_cases j <;>
    norm_num [N, Matrix.mul_apply, Fin.sum_univ_two]

/-- Projector kernel: the filter kills the nilpotent boundary part. -/
theorem PD_mul_N_eq_zero : PD N = 0 := by
  unfold PD
  rw [N_left_eval, N_right_eval]
  ext i j <;> fin_cases i <;> fin_cases j <;>
    norm_num [N, Matrix.mul_apply, Fin.sum_univ_two]

/-- Filter acts as identity on the bulk core `H = 1`. -/
theorem PD_H_eq_H : PD H = H := by
  unfold PD H
  rw [N_left_eval, N_right_eval]
  ext i j <;> fin_cases i <;> fin_cases j <;>
    norm_num [Matrix.mul_apply, Fin.sum_univ_two]

/-- Core recovery: the filter extracts the bulk core from `X = H + N`. -/
theorem PD_X_eq_H : PD X = H := by
  unfold X H PD
  rw [N_left_eval, N_right_eval]
  ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [N, Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two]

/-- Trivial bulk flow generated by `H = 1`: conjugation acts as identity. -/
def flowH (_t : ℝ) (A : M2R) : M2R := A

/-- `PD` is idempotent on the mixed witness `X`. -/
theorem PD_idempotent_X : PD (PD X) = PD X := by
  rw [PD_X_eq_H]
  exact PD_H_eq_H

/-- `PD` commutes with the bulk `H`-flow on this witness family. -/
theorem PD_flowH_commute (t : ℝ) (A : M2R) :
    PD (flowH t A) = flowH t (PD A) := by
  simp [flowH]

end InfoGeometry.Canonical.DrazinMixedFilter
