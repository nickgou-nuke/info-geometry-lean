import InfoGeometry.Canonical.KKTCore
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import InfoGeometry.Meta.Architecture

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.KKTLorentzOrbitBridge

Translator/coherence surface for Lorentz-orbit language on the existing
`KKTCore` split `Cl(1,1)` channel decomposition.

This file does not add new owners. It exposes the channel-weight action of the
`ε`-generated hyperbolic boost on the already-owned `uPlus/uMinus` channels.
-/

namespace InfoGeometry.Canonical.KKTLorentzOrbitBridge

open InfoGeometry.Canonical.KKTCore
open InfoGeometry.Quantum

section Core

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

local notation "EndH" => H →L[ℝ] H
local notation "IdH" => ContinuousLinearMap.id ℝ H

/-- Hyperbolic Cartan boost generated by the grading involution `ε`. -/
@[rep_depth transport]
noncomputable def channelBoost (X : RealSplitCl11Action H) (τ : ℝ) : EndH :=
  (Real.cosh τ) • IdH + (Real.sinh τ) • X.eps

/-- Left `ε`-action on the grade `+1` channel is weight `+1`. -/
@[rep_depth krein]
theorem eps_mul_gOnePart
    (X : RealSplitCl11Action H) (A : EndH) :
    X.eps * gOnePart X A = gOnePart X A := by
  unfold gOnePart
  calc
    X.eps * (plusProjector X * A * minusProjector X)
        = (X.eps * plusProjector X) * A * minusProjector X := by simp [mul_assoc]
    _ = plusProjector X * A * minusProjector X := by
          rw [eps_mul_plusProjector]

/-- Right `ε`-action on the grade `+1` channel is weight `-1`. -/
@[rep_depth krein]
theorem gOnePart_mul_eps
    (X : RealSplitCl11Action H) (A : EndH) :
    gOnePart X A * X.eps = -(gOnePart X A) := by
  unfold gOnePart
  calc
    (plusProjector X * A * minusProjector X) * X.eps
        = plusProjector X * A * (minusProjector X * X.eps) := by simp [mul_assoc]
    _ = plusProjector X * A * (-minusProjector X) := by
          rw [minusProjector_mul_eps]
    _ = -(plusProjector X * A * minusProjector X) := by simp [mul_assoc]

/-- Left `ε`-action on the grade `-1` channel is weight `-1`. -/
@[rep_depth krein]
theorem eps_mul_gNegOnePart
    (X : RealSplitCl11Action H) (A : EndH) :
    X.eps * gNegOnePart X A = -(gNegOnePart X A) := by
  unfold gNegOnePart
  calc
    X.eps * (minusProjector X * A * plusProjector X)
        = (X.eps * minusProjector X) * A * plusProjector X := by simp [mul_assoc]
    _ = (-minusProjector X) * A * plusProjector X := by
          rw [eps_mul_minusProjector]
    _ = -(minusProjector X * A * plusProjector X) := by simp [mul_assoc]

/-- Right `ε`-action on the grade `-1` channel is weight `+1`. -/
@[rep_depth krein]
theorem gNegOnePart_mul_eps
    (X : RealSplitCl11Action H) (A : EndH) :
    gNegOnePart X A * X.eps = gNegOnePart X A := by
  unfold gNegOnePart
  calc
    (minusProjector X * A * plusProjector X) * X.eps
        = minusProjector X * A * (plusProjector X * X.eps) := by simp [mul_assoc]
    _ = minusProjector X * A * plusProjector X := by
          rw [plusProjector_mul_eps]

/-- The grade-zero channel commutes with the grading involution `ε`. -/
@[rep_depth krein]
theorem eps_mul_gZeroPart_eq_gZeroPart_mul_eps
    (X : RealSplitCl11Action H) (A : EndH) :
    X.eps * gZeroPart X A = gZeroPart X A * X.eps := by
  unfold gZeroPart
  calc
    X.eps * (plusProjector X * A * plusProjector X + minusProjector X * A * minusProjector X)
        =
      (X.eps * plusProjector X) * A * plusProjector X
        + (X.eps * minusProjector X) * A * minusProjector X := by
          simp [mul_add, mul_assoc]
    _ =
      plusProjector X * A * plusProjector X
        + (-minusProjector X) * A * minusProjector X := by
          rw [eps_mul_plusProjector, eps_mul_minusProjector]
    _ =
      plusProjector X * A * plusProjector X
        + minusProjector X * A * (-minusProjector X) := by
          simp [mul_assoc]
    _ =
      plusProjector X * A * (plusProjector X * X.eps)
        + minusProjector X * A * (minusProjector X * X.eps) := by
          rw [plusProjector_mul_eps, minusProjector_mul_eps]
    _ =
      plusProjector X * A * plusProjector X * X.eps
        + minusProjector X * A * minusProjector X * X.eps := by
          simp [mul_assoc]
    _ = (plusProjector X * A * plusProjector X + minusProjector X * A * minusProjector X) * X.eps := by
          simp [add_mul, mul_assoc]

/-- The `ε`-boost commutes with grade-zero operators. -/
@[rep_depth transport]
theorem channelBoost_mul_gZeroPart_eq_gZeroPart_mul_channelBoost
    (X : RealSplitCl11Action H) (τ : ℝ) (A : EndH) :
    channelBoost X τ * gZeroPart X A = gZeroPart X A * channelBoost X τ := by
  have hIdLeft (T : EndH) : IdH * T = T := by
    change (1 : EndH) * T = T
    simp
  have hIdRight (T : EndH) : T * IdH = T := by
    change T * (1 : EndH) = T
    simp
  calc
    channelBoost X τ * gZeroPart X A
        = ((Real.cosh τ) • IdH + (Real.sinh τ) • X.eps) * gZeroPart X A := by
            rfl
    _ = (Real.cosh τ) • (IdH * gZeroPart X A)
          + (Real.sinh τ) • (X.eps * gZeroPart X A) := by
            simp [add_mul]
    _ = (Real.cosh τ) • gZeroPart X A
          + (Real.sinh τ) • (gZeroPart X A * X.eps) := by
            rw [hIdLeft, eps_mul_gZeroPart_eq_gZeroPart_mul_eps]
    _ = (Real.cosh τ) • (gZeroPart X A * IdH)
          + (Real.sinh τ) • (gZeroPart X A * X.eps) := by
            rw [hIdRight]
    _ = gZeroPart X A * ((Real.cosh τ) • IdH + (Real.sinh τ) • X.eps) := by
          simp [mul_add]
    _ = gZeroPart X A * channelBoost X τ := by
          rfl

/-- Boost weight of the circularly polarized `uPlus` (`g₁`) channel. -/
@[rep_depth transport]
theorem channelBoost_mul_uPlus
    (X : RealSplitCl11Action H) (τ : ℝ) (A : EndH) :
    channelBoost X τ * uPlus X A
      = (Real.cosh τ + Real.sinh τ) • uPlus X A := by
  have hIdLeft (T : EndH) : IdH * T = T := by
    change (1 : EndH) * T = T
    simp
  calc
    channelBoost X τ * uPlus X A
        = ((Real.cosh τ) • IdH + (Real.sinh τ) • X.eps) * uPlus X A := by
            rfl
    _ = (Real.cosh τ) • (IdH * uPlus X A) + (Real.sinh τ) • (X.eps * uPlus X A) := by
          simp [add_mul]
    _ = (Real.cosh τ) • uPlus X A + (Real.sinh τ) • uPlus X A := by
          rw [hIdLeft]
          simp [uPlus, eps_mul_gOnePart]
    _ = (Real.cosh τ + Real.sinh τ) • uPlus X A := by
          exact (add_smul (Real.cosh τ) (Real.sinh τ) (uPlus X A)).symm

/-- Boost weight of the circularly polarized `uMinus` (`g₋₁`) channel. -/
@[rep_depth transport]
theorem channelBoost_mul_uMinus
    (X : RealSplitCl11Action H) (τ : ℝ) (A : EndH) :
    channelBoost X τ * uMinus X A
      = (Real.cosh τ - Real.sinh τ) • uMinus X A := by
  have hIdLeft (T : EndH) : IdH * T = T := by
    change (1 : EndH) * T = T
    simp
  calc
    channelBoost X τ * uMinus X A
        = ((Real.cosh τ) • IdH + (Real.sinh τ) • X.eps) * uMinus X A := by
            rfl
    _ = (Real.cosh τ) • (IdH * uMinus X A) + (Real.sinh τ) • (X.eps * uMinus X A) := by
          simp [add_mul]
    _ = (Real.cosh τ) • uMinus X A + (Real.sinh τ) • (-(uMinus X A)) := by
          rw [hIdLeft]
          simp [uMinus, eps_mul_gNegOnePart]
    _ = (Real.cosh τ) • uMinus X A + (-Real.sinh τ) • uMinus X A := by
          simp [smul_neg]
    _ = (Real.cosh τ - Real.sinh τ) • uMinus X A := by
          simpa [sub_eq_add_neg] using
            (add_smul (Real.cosh τ) (-Real.sinh τ) (uMinus X A)).symm

end Core

end InfoGeometry.Canonical.KKTLorentzOrbitBridge
