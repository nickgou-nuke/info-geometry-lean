-- Macaulay2 script for D-modules and Hecke Eigensheaves

print("Constructing Hecke eigensheaves as D-modules over the moduli stack...")

-- Weyl algebra represents the ring of differential operators (D-modules)
load "WeylAlgebra.m2"

-- Define a Weyl algebra
W = QQ[x, y, dx, dy, WeylAlgebra => {x=>dx, y=>dy}]

-- Define a D-module representing a Hecke eigensheaf
-- An ideal generated by differential operators
I = ideal(dx^2 - x, dy^2 - y)

-- The D-module is W/I
M = W^1 / I

print("Hecke Eigensheaf D-module:")
print(M)

-- Formally link GW volume expansions to Weyl gauge scalar
-- We compute the holonomic rank or characteristic variety
-- This requires Dmodules package
load "Dmodules.m2"
charVar = characteristicVariety(I)
print("Characteristic Variety (links to GW volume expansions):")
print(charVar)
