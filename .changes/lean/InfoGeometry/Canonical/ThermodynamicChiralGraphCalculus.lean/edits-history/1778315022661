{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Canonical/ThermodynamicChiralGraphCalculus.lean","time":1778315022661,"baseTime":1778315021941,"changes":[{"range":{"start":{"line":162,"character":0},"end":{"line":162,"character":0}},"text":"/-- A vertex gauge/potential used to shift a discrete log-affinity by a coboundary. -/\nstructure GaugeTransform (V : Type) where\n  potential : V → ℝ\n\n/-- Gauge-shifted log-affinity on one directed edge.\n\nThe added term is the vertex coboundary `φ(dst e) - φ(src e)`. -/\ndef gaugeShiftedLogAffinity (γ : GaugeTransform V) (e : E) : ℝ :=\n  G.logAffinity e + γ.potential (G.dst e) - γ.potential (G.src e)\n\n/-- Boundary/coboundary contribution of a vertex gauge around an ordered cycle. -/\ndef gaugeBoundaryTerm (γ : GaugeTransform V) (C : Cycle E) : ℝ :=\n  (C.edges.map (fun e => γ.potential (G.dst e) - γ.potential (G.src e))).sum\n\n/-- Cycle curvature computed from the gauge-shifted log-affinity. -/\ndef gaugeShiftedCycleCurvatureLog (γ : GaugeTransform V) (C : Cycle E) : ℝ :=\n  (C.edges.map (G.gaugeShiftedLogAffinity γ)).sum\n\n/-- A cycle is gauge-closed when every vertex-gauge coboundary telescopes to zero. -/\nstructure CycleGaugeClosed (C : Cycle E) : Prop where\n  boundary_zero : ∀ γ : GaugeTransform V, G.gaugeBoundaryTerm γ C = 0\n\n","rangeOffset":5806,"rangeLength":0}]}