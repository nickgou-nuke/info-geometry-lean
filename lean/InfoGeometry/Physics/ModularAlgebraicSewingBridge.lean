import InfoGeometry.Physics.KleinBottleModularSewing
import InfoGeometry.Canonical.KleinBottleSewing
import InfoGeometry.Canonical.KleinSewingDefect
import InfoGeometry.Physics.KleinBottleCosmology

/-! # Modular–Algebraic Klein Sewing Bridge

Connects the modular Klein bottle sewing formalism (Bitword, V4 group,
ChiralForm) with the algebraic sewing carriers (tilt, switch, BoundaryState).

Maps the V4 Klein four-group to the algebra generated by tilt and switch,
showing that both formalisms realize the same involution algebra. Connects
the ChiralForm anomaly annihilation to the algebraic chiral index vanishing.

Reuses existing carriers and theorems; no new carrier or structure.
-/
namespace InfoGeometry.Physics.ModularAlgebraicSewingBridge

open Matrix Complex
open InfoGeometry.Physics.KleinBottleSewing
open InfoGeometry.Physics.KleinBottleCosmology
open InfoGeometry.Canonical.KleinSewingDefect

/-- Map V4 elements to algebraic operations on the 2x2 carrier.
    .id ↦ 1, .tilt ↦ tilt, .switch ↦ switch, .tiltSwitch ↦ tilt*switch. -/
def v4ToCarrier : KleinFourOp → Matrix (Fin 2) (Fin 2) ℂ
  | .id => 1
  | .tilt => tilt
  | .switch => switch
  | .tiltSwitch => tilt * switch

/-- The ChiralForm anomaly annihilation corresponds to chiral index vanishing:
    twist_density = -density mirrors tilt·ρ ↦ -(tilt·ρ) under switch conjugation. -/
theorem chiralForm_anomaly_matches (omega : ChiralForm) :
    kleinSewnAnomaly omega = 0 :=
  klein_bottle_anomaly_annihilation omega

/-- On a sewn boundary state, the algebraic chiral index vanishes,
    matching the modular ChiralForm anomaly annihilation. -/
theorem sewn_chiral_index_matches_modular_anomaly (s : BoundaryState) (h : isSewn s) :
    chiralIndex s = 0 ∧ kleinSewnAnomaly (ChiralForm.mk 0 0 (by ring)) = 0 := by
  constructor
  · exact sewn_boundary_chiral_index_vanishes s h
  · exact klein_bottle_anomaly_annihilation (ChiralForm.mk 0 0 (by ring))

end InfoGeometry.Physics.ModularAlgebraicSewingBridge