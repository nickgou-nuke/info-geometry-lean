import InfoGeometry.Clifford.BivectorProjectorCorrection
import Mathlib.LinearAlgebra.Complex.Module

/-! Classify the entire real scalar–bivector plane in the native algebra.
Mathlib's complex universal property supplies an injective algebra map; no
centrality of the bivector in the ambient algebra is required. -/

namespace InfoGeometry.Clifford.BivectorProjector

variable {A : Type*} [Ring A] [Algebra ℝ A] [Nontrivial A]

/-- A real plane generated by a square root of minus one has only trivial
idempotents, even when its ambient algebra is noncommutative. -/
theorem scalar_imaginary_idempotent_iff {J : A} (hJ : J * J = -1) (a b : ℝ) :
    IsIdempotentElem (a • (1 : A) + b • J) ↔
      (a = 0 ∧ b = 0) ∨ (a = 1 ∧ b = 0) := by
  let f : ℂ →ₐ[ℝ] A := Complex.lift ⟨J, hJ⟩
  have he : f (⟨a, b⟩ : ℂ) = a • (1 : A) + b • J := by
    change Complex.liftAux J hJ (⟨a, b⟩ : ℂ) = _
    rw [Complex.liftAux_apply, Algebra.algebraMap_eq_smul_one]
  rw [← he]
  have hi : IsIdempotentElem (f (⟨a, b⟩ : ℂ)) ↔
      IsIdempotentElem (⟨a, b⟩ : ℂ) := by
    simp only [IsIdempotentElem, ← map_mul]
    exact f.injective.eq_iff
  rw [hi, IsIdempotentElem.iff_eq_zero_or_one]
  simp [Complex.ext_iff]

/-- Specialization to the existing definite three-dimensional Clifford algebra. -/
theorem unitBivector_plane_idempotent_iff (a b : ℝ) :
    IsIdempotentElem (a • (1 : Cl) + b • unitBivector) ↔
      (a = 0 ∧ b = 0) ∨ (a = 1 ∧ b = 0) :=
  scalar_imaginary_idempotent_iff unitBivector_sq a b

/-- In particular, normalizing the proposed circular expression does not
make it a projector. -/
theorem normalized_bivector_not_idempotent :
    ¬ IsIdempotentElem ((1 / 2 : ℝ) • ((1 : Cl) + unitBivector)) := by
  rw [smul_add, unitBivector_plane_idempotent_iff]
  norm_num

end InfoGeometry.Clifford.BivectorProjector
