import Mathlib

/-!
# Souriau operatorial Lie-group thermodynamics: finite algebraic core

This file puts the Radon--Nikodym / modular Hamiltonian / log-partition /
Legendre--Fenchel words in their natural finite Souriau context.

The analytic measure-theoretic and Tomita--Takesaki claims are not asserted here.
The proved core is the exponential-family identity

  `-log exp(-βE - ψ) = βE + ψ`,

read as: the negative logarithm of the Radon--Nikodym density is the modular
Hamiltonian / surprisal, while entropy is its expectation.
-/

noncomputable section

namespace SouriauOperatorThermodynamics

open scoped BigOperators
open Classical

/-! ## Souriau finite Lie thermodynamics data -/

/-- A finite Souriau system: states `Ω`, Lie-algebra coordinates `𝔤`, a moment
map `moment : Ω → 𝔤`, and a pairing with the thermodynamic covector `β`.
This is finite/discrete: no analytic integration is hidden here. -/
structure FiniteSouriauSystem where
  Ω : Type
  instFintype : Fintype Ω
  instDecidableEq : DecidableEq Ω
  𝔤 : Type
  moment : Ω → 𝔤
  pairing : 𝔤 → 𝔤 → ℝ

attribute [instance] FiniteSouriauSystem.instFintype
attribute [instance] FiniteSouriauSystem.instDecidableEq

namespace FiniteSouriauSystem

variable (S : FiniteSouriauSystem)

/-- Souriau energy generated by a thermodynamic covector `β`: `Eβ(x)=⟨β,J(x)⟩`. -/
def energy (β : S.𝔤) (x : S.Ω) : ℝ :=
  S.pairing β (S.moment x)

/-- Finite Souriau partition function `Z(β)=Σ exp(-Eβ(x))`. -/
def partition (β : S.𝔤) : ℝ :=
  ∑ x : S.Ω, Real.exp (-(S.energy β x))

/-- Log-generating / Massieu potential `ψ(β)=log Z(β)`. -/
def logGeneratingPotential (β : S.𝔤) : ℝ :=
  Real.log (S.partition β)

/-- Exponential-family density written in normalized-potential form.
When `ψ = log Z`, this is the finite Gibbs/Radon--Nikodym density. -/
def exponentialDensity (β : S.𝔤) (ψ : ℝ) (x : S.Ω) : ℝ :=
  Real.exp (-(S.energy β x) - ψ)

/-- Negative logarithmic Radon--Nikodym derivative: the finite modular
Hamiltonian / surprisal random variable. -/
def modularHamiltonian (β : S.𝔤) (ψ : ℝ) (x : S.Ω) : ℝ :=
  - Real.log (S.exponentialDensity β ψ x)

/-- Core identity: for an exponential family, the negative log-density is
energy plus log-potential.  This is the finite algebraic statement behind
`K = -log(dν/dμ) = Eβ + ψ`. -/
theorem modularHamiltonian_eq_energy_add_potential (β : S.𝔤) (ψ : ℝ) (x : S.Ω) :
    S.modularHamiltonian β ψ x = S.energy β x + ψ := by
  simp [modularHamiltonian, exponentialDensity]
  ring

/-- Entropy is the expectation of the modular Hamiltonian, not the modular
Hamiltonian itself. -/
def boltzmannEntropy (β : S.𝔤) (ψ : ℝ) : ℝ :=
  ∑ x : S.Ω, S.exponentialDensity β ψ x * S.modularHamiltonian β ψ x

/-- The entropy readout expands to the expectation of `Eβ+ψ`. -/
theorem boltzmannEntropy_eq_expect_energy_add_potential (β : S.𝔤) (ψ : ℝ) :
    S.boltzmannEntropy β ψ =
      ∑ x : S.Ω, S.exponentialDensity β ψ x * (S.energy β x + ψ) := by
  simp [boltzmannEntropy, S.modularHamiltonian_eq_energy_add_potential]

/-! ## Legendre--Fenchel polarity and modular-J boundary -/

/-- One-dimensional Legendre--Fenchel transform of a thermodynamic potential.
This is the convex dual/polarity layer; it is not definitionally the
Tomita modular conjugation operator. -/
def legendreFenchel (ψ : ℝ → ℝ) (u : ℝ) : ℝ :=
  sSup (Set.range fun β : ℝ => β * u - ψ β)

/-- The finite Souriau dictionary, bundled theorem-honestly. -/
theorem souriau_operatorial_dictionary (β : S.𝔤) (ψ : ℝ) :
    (∀ x : S.Ω, S.modularHamiltonian β ψ x = S.energy β x + ψ) ∧
    S.boltzmannEntropy β ψ =
      ∑ x : S.Ω, S.exponentialDensity β ψ x * (S.energy β x + ψ) := by
  exact ⟨S.modularHamiltonian_eq_energy_add_potential β ψ,
    S.boltzmannEntropy_eq_expect_energy_add_potential β ψ⟩

end FiniteSouriauSystem

/-! ## Operator-first Souriau thermodynamics

The previous finite section is only the scalar readout of the theory.  The
actual thermodynamic object is operatorial: Souriau data produces an observable
`Hβ`; the modular Hamiltonian is an operator `Kβ = Hβ + ψ·1`; only after applying
a state/expectation `ω` do scalar potentials appear.
-/

section Operatorial

variable (𝔤 A : Type*) [Ring A] [Algebra ℝ A]

/-- Operatorial Souriau system: the thermodynamic covector `β` is sent to an
observable/modular-energy operator.  Scalar thermodynamic potentials are not
primitive; they are read out by states. -/
structure OperatorSouriauSystem where
  hamiltonianOp : 𝔤 → A

namespace OperatorSouriauSystem

variable {𝔤 A : Type*} [Ring A] [Algebra ℝ A]
variable (S : OperatorSouriauSystem 𝔤 A)

/-- Add a scalar log-potential to an operator as `ψ·1`. -/
def potentialOp (ψ : ℝ) : A :=
  algebraMap ℝ A ψ

/-- Operator-level modular Hamiltonian / negative logarithmic density:
`Kβ = Hβ + ψ·1`.  This is the object-level statement; no expectation has been
applied yet. -/
def modularHamiltonianOp (β : 𝔤) (ψ : ℝ) : A :=
  S.hamiltonianOp β + potentialOp (A := A) ψ

/-- The operator identity behind the slogan `K = -log ρ = H + ψ·1`. -/
theorem modularHamiltonianOp_eq (β : 𝔤) (ψ : ℝ) :
    S.modularHamiltonianOp β ψ = S.hamiltonianOp β + potentialOp (A := A) ψ :=
  rfl

/-- A state/expectation functional.  Only after applying this do we get scalar
thermodynamic potentials. -/
abbrev StateExpectation := A →ₗ[ℝ] ℝ

/-- Applying a state turns the operator identity into the scalar potential
readout.  If `ω 1 = 1`, this becomes `ω(Kβ)=ω(Hβ)+ψ`. -/
theorem expectation_modularHamiltonianOp
    (ω : StateExpectation (A := A)) (β : 𝔤) (ψ : ℝ) :
    ω (S.modularHamiltonianOp β ψ) =
      ω (S.hamiltonianOp β) + ψ * ω (1 : A) := by
  simp [modularHamiltonianOp, potentialOp, map_add, Algebra.algebraMap_eq_smul_one]

/-- Normalized-state version: scalar potentials arise as expectation values of
operator modular Hamiltonians. -/
theorem normalized_expectation_modularHamiltonianOp
    (ω : StateExpectation (A := A)) (hω : ω (1 : A) = 1) (β : 𝔤) (ψ : ℝ) :
    ω (S.modularHamiltonianOp β ψ) = ω (S.hamiltonianOp β) + ψ := by
  rw [expectation_modularHamiltonianOp (S := S) ω β ψ, hω]
  ring

/-! ## Goutev–Tonev information unit: `exp(ε·K) - I - ε·K`

The regularized modular deviation is the operator-level Bregman divergence
generator. Its second-order truncation `(ε²/2)·K²` is well-defined in any
`Ring A` with `Algebra ℝ A`. The full exponential series is socketed. -/

/-- Second-order truncation of the Goutev–Tonev regularized deviation:
`(ε²/2)·K²`. This is the leading term of `exp(ε·K) - I - ε·K` and is
always well-defined — no exponential needed. -/
def goutevTonevUnit (ε : ℝ) (K : A) : A :=
  ((ε ^ 2 / 2 : ℝ) : ℝ) • (K * K)

/-- The identity operator in A. -/
def identityOp : A := 1

/-! ## Goutev--Tonev operator Bregman generator

The second-order truncation `goutevTonevUnit` is proved above.  The full
operator exponential `exp(ε·K)` is represented by an explicit parameter
`expOp : A → A`; convergence/functional calculus is an analytic socket.

The information unit is operatorial before it is scalar:

`exp(ε K) - 1 - ε K`.
-/

/-- Operator-level Bregman remainder / information unit for an exponential
operator family. -/
def operatorBregmanGenerator (expOp : A → A) (ε : ℝ) (K : A) : A :=
  expOp (ε • K) - 1 - ε • K

/-- If an exponential family is already split as
`expOp (ε • K) = 1 + ε • K + R`, then the Goutev--Tonev information unit
extracts precisely the nonlinear remainder `R`. -/
theorem operatorBregmanGenerator_eq_remainder
    (expOp : A → A) (ε : ℝ) (K R : A)
    (h : expOp (ε • K) = 1 + ε • K + R) :
    operatorBregmanGenerator (A := A) expOp ε K = R := by
  rw [operatorBregmanGenerator, h]
  abel

/-- The generator vanishes at zero coupling whenever the exponential is
normalized by `expOp 0 = 1`. -/
theorem operatorBregmanGenerator_zero
    (expOp : A → A) (h0 : expOp 0 = (1 : A)) (K : A) :
    operatorBregmanGenerator (A := A) expOp 0 K = 0 := by
  simp [operatorBregmanGenerator, h0]

/-- Expectation turns the operator Bregman generator into its scalar readout;
the operator expression remains primary. -/
theorem expectation_operatorBregmanGenerator
    (ω : StateExpectation (A := A)) (expOp : A → A) (ε : ℝ) (K : A) :
    ω (operatorBregmanGenerator (A := A) expOp ε K) =
      ω (expOp (ε • K)) - ω (1 : A) - ε * ω K := by
  simp [operatorBregmanGenerator, map_sub]

/-- Normalized-state scalar readout of the Goutev--Tonev information unit. -/
theorem normalized_expectation_operatorBregmanGenerator
    (ω : StateExpectation (A := A)) (hω : ω (1 : A) = 1)
    (expOp : A → A) (ε : ℝ) (K : A) :
    ω (operatorBregmanGenerator (A := A) expOp ε K) =
      ω (expOp (ε • K)) - 1 - ε * ω K := by
  rw [expectation_operatorBregmanGenerator (ω := ω) expOp ε K, hω]

/-- The algebraic information unit vanishes at zero coupling. -/
theorem goutevTonevUnit_zero (K : A) :
    goutevTonevUnit (A := A) 0 K = 0 := by
  simp [goutevTonevUnit]

/-- State readout of the quadratic Goutev--Tonev unit.  This is the finite
operator-level bridge toward Fisher/variance language; positivity and limits
require additional ordered/C⋆ hypotheses and are not asserted here. -/
theorem expectation_goutevTonevUnit
    (ω : StateExpectation (A := A)) (ε : ℝ) (K : A) :
    ω (goutevTonevUnit (A := A) ε K) = (ε ^ 2 / 2) * ω (K * K) := by
  simp [goutevTonevUnit]

/-- Closed finite algebraic synthesis for the Goutev--Tonev operator unit. -/
theorem goutevTonev_operator_synthesis
    (ω : StateExpectation (A := A)) (expOp : A → A) (h0 : expOp 0 = (1 : A)) :
    (∀ K : A, operatorBregmanGenerator (A := A) expOp 0 K = 0) ∧
    (∀ (ε : ℝ) (K : A),
      ω (operatorBregmanGenerator (A := A) expOp ε K) =
        ω (expOp (ε • K)) - ω (1 : A) - ε * ω K) ∧
    (∀ (ε : ℝ) (K : A),
      ω (goutevTonevUnit (A := A) ε K) = (ε ^ 2 / 2) * ω (K * K)) := by
  exact ⟨operatorBregmanGenerator_zero (A := A) expOp h0,
    expectation_operatorBregmanGenerator (A := A) (ω := ω) expOp,
    expectation_goutevTonevUnit (A := A) (ω := ω)⟩

end OperatorSouriauSystem

end Operatorial

end SouriauOperatorThermodynamics
