import InfoGeometry.Canonical.RealDiracLinearLift
import InfoGeometry.Canonical.RealDiracSpinCasimir

/-!
# Exact regressions for the real Dirac and associative ternary contracts

These six examples retain a nonzero null Dirac matrix, distinguish its
actual alternating-form isotropy from a positive definite pairing, reject
the square-zero right-ideal and positive mixed-Casimir claims, and separate
the full alternating cubic from a Filippov bracket and an inner derivation.
-/

noncomputable section

open scoped Matrix BigOperators
open InfoGeometry.Canonical.RealPauliPfaffianKernel
open InfoGeometry.Canonical.RealDiracLinearLift
open InfoGeometry.Canonical.RealDiracSpinCasimir
open InfoGeometry.Clifford.GullDoranPseudoscalarBridge
open InfoGeometry.OperatorAlgebra
open InfoGeometry.OperatorAlgebra.PeirceSpine
open InfoGeometry.Algebra.AssociativeNambuOperators

attribute [local instance 100] LieRing.ofAssociativeRing

/-- A nonzero null vector is faithfully represented by a nonzero square-zero matrix. -/
example : diracLift ![1, 0, 0, 1] ≠ 0 ∧
    diracLift ![1, 0, 0, 1] * diracLift ![1, 0, 0, 1] = 0 := by
  constructor
  · rw [ne_eq, diracLift_eq_zero_iff]
    intro h
    have h₀ := congrFun h (0 : Fin 4)
    norm_num at h₀
  · rw [diracLift_sq_eq_zero_iff]
    norm_num [intervalSq]

/-- Null Dirac images are not isotropic for an arbitrary chosen bilinear form. -/
example :
    let w := Matrix.toLin' (diracLift ![1, 0, 0, 1]) ![0, 0, 1, 0]
    Matrix.toBilin' (1 : Matrix4) w w = 4 := by
  norm_num [Matrix.toBilin'_apply', Matrix.toLin'_apply, dotProduct,
    Matrix.mulVec, diracLift_apply, diracVector, pauli_explicit, timeGamma,
    Matrix.mul_apply, Fin.sum_univ_four]

/-- The right ideal generated by a square-zero matrix need not be trace-isotropic. -/
example :
    let N : Matrix (Fin 2) (Fin 2) ℝ := Matrix.single 0 1 1
    let M : Matrix (Fin 2) (Fin 2) ℝ := Matrix.single 1 0 1
    N * N = 0 ∧ Matrix.trace ((N * M) * (N * M)) = 1 := by
  dsimp only
  norm_num [Matrix.single_mul_single_same, Matrix.single_mul_single_of_ne,
    Matrix.trace_single_eq_same]

/-- The displayed doubled mixed Casimir has the opposite sign from the intake claim. -/
example : (∑ i : Fin 3, totalJ i * totalK i) ≠
    (3 / 4 : ℝ) • (doubledCut * doubledPhase) := by
  rw [doubled_lorentz_second_casimir]
  intro h
  have he := congrArg (fun M : DoubledMatrix => M (Sum.inl 0) (Sum.inl 1)) h
  norm_num [doubledCut, doubledPhase, realPhaseAxis,
    Matrix.fromBlocks_multiply] at he

/-- The actual alternating cubic has a nonzero value on the unit, unlike ad. -/
example :
    let A : Matrix (Fin 2) (Fin 2) ℝ := Matrix.single 0 0 1
    let B : Matrix (Fin 2) (Fin 2) ℝ := Matrix.single 0 1 1
    alternatingProduct3 A B 1 = B ∧
      LieAlgebra.ad ℝ (Matrix (Fin 2) (Fin 2) ℝ) (PeirceSpine.comm A B) 1 = 0 ∧
      B ≠ 0 := by
  refine ⟨?_, ?_, ?_⟩
  · rw [alternatingProduct3_one]
    norm_num [PeirceSpine.comm, Matrix.single_mul_single_same,
      Matrix.single_mul_single_of_ne]
  · simp [LieAlgebra.ad_apply, Ring.lie_def]
  · intro h
    have he := congrArg (fun M : Matrix (Fin 2) (Fin 2) ℝ => M 0 1) h
    norm_num [Matrix.single] at he

/-- The concrete M3 witness separates both sides of the Filippov identity. -/
example :
    let A : Matrix (Fin 3) (Fin 3) ℝ := Matrix.single 0 0 1
    let B : Matrix (Fin 3) (Fin 3) ℝ := Matrix.single 0 1 1
    let U : Matrix (Fin 3) (Fin 3) ℝ := Matrix.single 0 0 1
    let V : Matrix (Fin 3) (Fin 3) ℝ := Matrix.single 0 2 1
    let W : Matrix (Fin 3) (Fin 3) ℝ := Matrix.single 1 0 1
    alternatingProduct3 A B (alternatingProduct3 U V W) = V ∧
      alternatingProduct3 (alternatingProduct3 A B U) V W +
        alternatingProduct3 U (alternatingProduct3 A B V) W +
        alternatingProduct3 U V (alternatingProduct3 A B W) = 0 := by
  constructor <;>
    norm_num [alternatingProduct3, mul_add, add_mul, mul_sub, sub_mul,
      Matrix.single_mul_single_same, Matrix.single_mul_single_of_ne] <;> abel

end
