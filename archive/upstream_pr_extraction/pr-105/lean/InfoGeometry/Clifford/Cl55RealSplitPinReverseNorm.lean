import InfoGeometry.Clifford.Cl55RealSplitPinScalarKernel

namespace InfoGeometry.Clifford.Clifford55

/-!
# Reversion norm of the corrected split-Pin generators

The corrected split-Pin subgroup is generated by vectors of quadratic norm
`1` or `-1`.  Reversion is anti-multiplicative, so the reversion norm of every
element of the generated subgroup is again one of those two scalars.
-/

theorem realSplitPin_reverse_mul_coe_eq_one_or_neg
    (x : Cl55ˣ) (hx : x ∈ realSplitPin55) :
    CliffordAlgebra.reverse (Q := Q55) (x : Cl55) * (x : Cl55) = 1 ∨
      CliffordAlgebra.reverse (Q := Q55) (x : Cl55) * (x : Cl55) = -1 := by
  induction hx using Subgroup.closure_induction'' with
  | mem x hx =>
      rcases hx with ⟨v, hv, hxeq⟩
      rcases hv with hv | hv
      · left
        rw [← hxeq, CliffordAlgebra.reverse_ι,
          CliffordAlgebra.ι_sq_scalar, hv]
        simp
      · right
        rw [← hxeq, CliffordAlgebra.reverse_ι,
          CliffordAlgebra.ι_sq_scalar, hv]
        simp
  | one =>
      left
      simp
  | mul y z _ _ hy hz =>
      rcases hy with hy | hy <;> rcases hz with hz | hz
      · left
        calc
          CliffordAlgebra.reverse (Q := Q55) ((y * z : Cl55ˣ) : Cl55) *
              ((y * z : Cl55ˣ) : Cl55) =
              CliffordAlgebra.reverse (Q := Q55) (z : Cl55) *
                (CliffordAlgebra.reverse (Q := Q55) (y : Cl55) *
                  (y : Cl55)) * (z : Cl55) := by
                    rw [Units.val_mul, CliffordAlgebra.reverse.map_mul]
                    noncomm_ring
          _ = 1 := by rw [hy]; simp [hz]
      · right
        calc
          CliffordAlgebra.reverse (Q := Q55) ((y * z : Cl55ˣ) : Cl55) *
              ((y * z : Cl55ˣ) : Cl55) =
              CliffordAlgebra.reverse (Q := Q55) (z : Cl55) *
                (CliffordAlgebra.reverse (Q := Q55) (y : Cl55) *
                  (y : Cl55)) * (z : Cl55) := by
                    rw [Units.val_mul, CliffordAlgebra.reverse.map_mul]
                    noncomm_ring
          _ = -1 := by rw [hy]; simp [hz]
      · right
        calc
          CliffordAlgebra.reverse (Q := Q55) ((y * z : Cl55ˣ) : Cl55) *
              ((y * z : Cl55ˣ) : Cl55) =
              CliffordAlgebra.reverse (Q := Q55) (z : Cl55) *
                (CliffordAlgebra.reverse (Q := Q55) (y : Cl55) *
                  (y : Cl55)) * (z : Cl55) := by
                    rw [Units.val_mul, CliffordAlgebra.reverse.map_mul]
                    noncomm_ring
          _ = -1 := by rw [hy]; simp [hz]
      · left
        calc
          CliffordAlgebra.reverse (Q := Q55) ((y * z : Cl55ˣ) : Cl55) *
              ((y * z : Cl55ˣ) : Cl55) =
              CliffordAlgebra.reverse (Q := Q55) (z : Cl55) *
                (CliffordAlgebra.reverse (Q := Q55) (y : Cl55) *
                  (y : Cl55)) * (z : Cl55) := by
                    rw [Units.val_mul, CliffordAlgebra.reverse.map_mul]
                    noncomm_ring
          _ = 1 := by rw [hy]; simp [hz]
  | inv_mem x hx =>
      obtain ⟨v, hv, hxeq⟩ := hx
      have hleft : (x : Cl55) * (↑(x⁻¹) : Cl55) = 1 := Units.mul_inv x
      have hright : (↑(x⁻¹) : Cl55) * (x : Cl55) = 1 := Units.inv_mul x
      have hxx : (x : Cl55) * (x : Cl55) = 1 ∨
          (x : Cl55) * (x : Cl55) = -1 := by
        rcases hv with hv | hv
        · left
          rw [← hxeq, CliffordAlgebra.ι_sq_scalar, hv]
          simp
        · right
          rw [← hxeq, CliffordAlgebra.ι_sq_scalar, hv]
          simp
      have hreverse :
          CliffordAlgebra.reverse (Q := Q55) (↑(x⁻¹) : Cl55) *
            CliffordAlgebra.reverse (Q := Q55) (x : Cl55) = 1 := by
        have h := congrArg (CliffordAlgebra.reverse (Q := Q55)) hleft
        simpa only [CliffordAlgebra.reverse.map_mul,
          CliffordAlgebra.reverse.map_one] using h
      have hrevx : CliffordAlgebra.reverse (Q := Q55) (x : Cl55) = (x : Cl55) := by
        rw [← hxeq, CliffordAlgebra.reverse_ι]
      have hinv_rev :
          CliffordAlgebra.reverse (Q := Q55) (↑(x⁻¹) : Cl55) =
            (↑(x⁻¹) : Cl55) := by
        rw [hrevx] at hreverse
        calc
          CliffordAlgebra.reverse (Q := Q55) (↑(x⁻¹) : Cl55) =
              CliffordAlgebra.reverse (Q := Q55) (↑(x⁻¹) : Cl55) * 1 := by simp
          _ = CliffordAlgebra.reverse (Q := Q55) (↑(x⁻¹) : Cl55) *
              ((x : Cl55) * (↑(x⁻¹) : Cl55)) := by rw [hleft]
          _ = (CliffordAlgebra.reverse (Q := Q55) (↑(x⁻¹) : Cl55) *
              (x : Cl55)) * (↑(x⁻¹) : Cl55) := by noncomm_ring
          _ = (↑(x⁻¹) : Cl55) := by rw [hreverse]; simp
      rw [hinv_rev]
      rcases hxx with hxx | hxx
      · left
        calc
          (↑(x⁻¹) : Cl55) * (↑(x⁻¹) : Cl55) =
              (↑(x⁻¹) : Cl55) * (↑(x⁻¹) : Cl55) *
                ((x : Cl55) * (x : Cl55)) := by rw [hxx]; simp
          _ = (↑(x⁻¹) : Cl55) *
                ((↑(x⁻¹) : Cl55) * (x : Cl55)) * (x : Cl55) := by
                  simp only [mul_assoc]
          _ = 1 := by rw [hright]; simp [hright]
      · right
        calc
          (↑(x⁻¹) : Cl55) * (↑(x⁻¹) : Cl55) =
              -((↑(x⁻¹) : Cl55) * (↑(x⁻¹) : Cl55) *
                ((x : Cl55) * (x : Cl55))) := by rw [hxx]; noncomm_ring
          _ = -((↑(x⁻¹) : Cl55) *
                ((↑(x⁻¹) : Cl55) * (x : Cl55)) * (x : Cl55)) := by
                  simp only [mul_assoc]
          _ = -1 := by rw [hright]; simp [hright]

end InfoGeometry.Clifford.Clifford55
