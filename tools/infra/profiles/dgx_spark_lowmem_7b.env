# Low-memory profile for local Lean4 agentic runs (no Leanstral).
# Source this file before running tools/infra/deploy_spark_models.sh

# Two smaller 7B-class endpoints:
# - proposer: general code/planning lane
# - formalizer: Lean-specialized prover lane
PROPOSER_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
FORMALIZER_MODEL=deepseek-ai/DeepSeek-Prover-V2-7B

PROPOSER_SERVED_NAME=qwen25-coder-7b-proposer
FORMALIZER_SERVED_NAME=deepseek-prover-v2-7b-formalizer

PROPOSER_PORT=8000
FORMALIZER_PORT=8001

# Conservative memory/context limits for reduced footprint.
PROPOSER_LIMIT=--gpu-memory-utilization 0.24 --max-model-len 8192 --max-num-seqs 4
FORMALIZER_LIMIT=--gpu-memory-utilization 0.30 --max-model-len 12288 --max-num-seqs 4

STARTUP_TIMEOUT_SEC=1200
STARTUP_POLL_SEC=5
