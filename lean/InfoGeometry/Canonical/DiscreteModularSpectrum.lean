/-!
# Discrete Modular Spectrum

Formalization of the discrete modular spectrum and the quantization of 
thermal time for the operatorial layer (L2) of the $C\ell(4,4)$ informational 
gravity framework.

This module provides the structural bridge between continuous modular flows 
and discrete operator lattices. Strictly coordinate-free: finite-dimensional 
scalar diagonal matrices are NOT allowed.
-/

namespace InfoGeometry.Canonical.DiscreteModularSpectrum

section TypeIIIScale

/-- Additive modular scale group surface for Type-III flow restrictions. -/
@[rep_depth transport]
structure TypeIIIScaleGroup where
  G : Set ℝ
  zero_mem : 0 ∈ G
  add_closed : ∀ a b : ℝ, a ∈ G → b ∈ G → a + b ∈ G
  neg_closed : ∀ a : ℝ, a ∈ G → -a ∈ G

/--
Discrete Type-IIIλ scale data.
Period is log q; parameter lambda = q⁻¹.
-/
@[rep_depth transport]
structure DiscreteTypeIIILambdaScale where
  q : ℝ
  hq : 1 < q

namespace DiscreteTypeIIILambdaScale

/-- Additive modular period generated by the discrete scale. -/
@[rep_depth transport]
noncomputable def period (S : DiscreteTypeIIILambdaScale) : ℝ :=
  Real.log S.q

/-- Multiplicative Type-IIIλ parameter `λ = q⁻¹`. -/
@[rep_depth transport]
noncomputable def lambda (S : DiscreteTypeIIILambdaScale) : ℝ :=
  S.q⁻¹

/-- Integer additive modular spectrum generated by `log q`. -/
@[rep_depth transport]
noncomputable def spectrum (S : DiscreteTypeIIILambdaScale) : Set ℝ :=
  {t | ∃ k : ℤ, t = (k : ℝ) * period S}

/-- The discrete modular spectrum is an additive scale group. -/
@[rep_depth transport]
noncomputable def toScaleGroup (S : DiscreteTypeIIILambdaScale) : TypeIIIScaleGroup where
  G := spectrum S
  zero_mem := ⟨0, by simp⟩
  add_closed := by
    rintro a b ⟨ka, rfl⟩ ⟨kb, rfl⟩
    refine ⟨ka + kb, ?_⟩
    simp; ring
  neg_closed := by
    rintro a ⟨ka, rfl⟩
    refine ⟨-ka, ?_⟩
    simp

end DiscreteTypeIIILambdaScale

end TypeIIIScale

section TypeIIIGLattice

variable {E : Type 0} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

/--
Proof-carrying Type-IIIg modular/Mellin lattice interface.

Strictly coordinate-free. Records the discrete thermal-time scale `q > 1` 
and the sampled boost action.
-/
@[rep_depth operator]
structure ModularMellinLattice (E : Type 0) [NormedAddCommGroup E] 
    [InnerProductSpace ℝ E] [CompleteSpace E] (CIK : CertifiedInverseKernel (DoubledSpace E)) where
  /-- Baseline modular flow generator. -/
  K0 : DoubledSpace E →L[ℝ] DoubledSpace E
  /-- Fundamental discrete scale. -/
  q : ℝ
  hq : q > 1
  /-- Drazin-cut compatibility. -/
  commutes_with_drazin : Commute K0 (CertifiedInverseKernel.spectralProjector (E := DoubledSpace E) CIK)
  /--
  Explicit Drazin fixed-point gate for sampled Bogoliubov transport.

  This is required proof data. The discrete Mellin lattice must not infer
  projector invariance merely from the presence of a modular generator.
  -/
  drazin_projector_invariant_gate :
    ∀ k : ℤ,
      let X : DoubledSpace E →L[ℝ] DoubledSpace E := modularTransportGenerator (E := E) K0
      expTransport (A := DoubledSpace E →L[ℝ] DoubledSpace E) X
        (CertifiedInverseKernel.spectralProjector (E := DoubledSpace E) CIK)
        ((k : ℝ) * Real.log q)
        = CertifiedInverseKernel.spectralProjector (E := DoubledSpace E) CIK

namespace ModularMellinLattice

variable {E : Type 0} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {CIK : CertifiedInverseKernel (DoubledSpace E)}
variable (L : ModularMellinLattice E CIK)

local notation "H₂_loc" => DoubledSpace E
local notation "EndH_loc" => H₂_loc →L[ℝ] H₂_loc

noncomputable local instance : NormedRing EndH_loc := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH_loc := inferInstance
local instance : IsTopologicalRing EndH_loc := inferInstance
local instance : CompleteSpace EndH_loc := inferInstance

/-- Discrete thermal time step `tₖ = k log q`. -/
@[rep_depth transport]
noncomputable def thermalTimeStep (k : ℤ) : ℝ :=
  (k : ℝ) * Real.log L.q

/-- Operatorial sampled modular boost at the lattice time `k log q`. -/
@[rep_depth operator]
noncomputable def discreteBoost (k : ℤ) (A : EndH_loc) : EndH_loc :=
  let X : EndH_loc := modularTransportGenerator (E := E) L.K0
  expTransport (A := EndH_loc) X A (L.thermalTimeStep k)

/--
The Drazin projector is invariant under the sampled modular boost.
Confirmed fixed-point gate for the coordinate-free lattice.
-/
@[rep_depth operator]
theorem drazin_projector_invariant (k : ℤ) :
    L.discreteBoost k (CertifiedInverseKernel.spectralProjector (E := H₂_loc) CIK) = 
      CertifiedInverseKernel.spectralProjector (E := H₂_loc) CIK :=
  L.drazin_projector_invariant_gate k

/--
Algebraic band-limit predicate for future discrete Mellin sums.
-/
@[rep_depth operator]
def IsMellinBandlimited (A : EndH_loc) : Prop :=
  ∃ N : ℕ, ∀ k : ℤ, Int.natAbs k > N → L.discreteBoost k A = 0

end ModularMellinLattice

end TypeIIIGLattice

end InfoGeometry.Canonical.DiscreteModularSpectrum
