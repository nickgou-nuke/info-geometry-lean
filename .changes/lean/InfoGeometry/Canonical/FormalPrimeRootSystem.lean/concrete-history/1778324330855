{"type":"new","contents":"import Mathlib\nimport InfoGeometry.Meta.Architecture\nimport InfoGeometry.Algebra.PrimeA1RootSystem\n\n/-!\n# InfoGeometry.Canonical.FormalPrimeRootSystem\n\nFinite prime cutoff root-system layer for the corrected Souriau-Weyl\nsupertrace corridor.\n\nThe root system is the finite Boolean `A₁^P` model: one formal root `α_p` for\neach rational prime in a finite cutoff `P`, with Weyl elements represented by\nsubsets of `P`.  This file proves the finite denominator identity as a direct\n`Finset.prod_sub` combinatorial expansion.\n-/\n\nnamespace InfoGeometry.Canonical.FormalPrimeRootSystem\n\nopen scoped BigOperators\n\n/-- Finite family of primes with explicit primality proof for every member. -/\n@[rep_depth thermo]\nstructure FinitePrimeSet where\n  primes : Finset ℕ\n  prime_mem : ∀ p ∈ primes, Nat.Prime p\n\nnamespace FinitePrimeSet\n\n/-- Read a finite prime set through the certified algebraic `A₁^P` root. -/\n@[rep_depth thermo]\ndef toAlgebraPrimeA1RootSystem (P : FinitePrimeSet) :\n    InfoGeometry.Algebra.PrimeA1RootSystem where\n  P := P.primes\n  all_prime := P.prime_mem\n\n@[simp, rep_depth thermo]\ntheorem toAlgebraPrimeA1RootSystem_P (P : FinitePrimeSet) :\n    P.toAlgebraPrimeA1RootSystem.P = P.primes :=\n  rfl\n\n/-- Finite-prime-set primality is conducted through the algebraic root system. -/\n@[rep_depth thermo]\ntheorem prime_mem_via_algebra (P : FinitePrimeSet) {p : ℕ} (hp : p ∈ P.primes) :\n    Nat.Prime p :=\n  P.toAlgebraPrimeA1RootSystem.prime_of_mem hp\n\n/-- Build the finite prime-set surface from the certified algebraic root. -/\n@[rep_depth thermo]\ndef ofAlgebraPrimeA1RootSystem (S : InfoGeometry.Algebra.PrimeA1RootSystem) :\n    FinitePrimeSet where\n  primes := S.P\n  prime_mem := S.all_prime\n\n@[simp, rep_depth thermo]\ntheorem ofAlgebraPrimeA1RootSystem_primes (S : InfoGeometry.Algebra.PrimeA1RootSystem) :\n    (ofAlgebraPrimeA1RootSystem S).primes = S.P :=\n  rfl\n\n@[simp, rep_depth thermo]\ntheorem toAlgebra_ofAlgebraPrimeA1RootSystem\n    (S : InfoGeometry.Algebra.PrimeA1RootSystem) :\n    (ofAlgebraPrimeA1RootSystem S).toAlgebraPrimeA1RootSystem = S := by\n  cases S\n  rfl\n\n@[simp, rep_depth thermo]\ntheorem ofAlgebra_toAlgebraPrimeA1RootSystem (P : FinitePrimeSet) :\n    ofAlgebraPrimeA1RootSystem P.toAlgebraPrimeA1RootSystem = P := by\n  cases P\n  rfl\n\nend FinitePrimeSet\n\n/-- Formal root lattice carrier for a finite prime cutoff. -/\n@[rep_depth thermo]\nstructure FormalPrimeRootLattice where\n  primes : Finset ℕ\n  prime_mem : ∀ p ∈ primes, Nat.Prime p\n\nnamespace FormalPrimeRootLattice\n\n/-- Read a formal prime root lattice through the certified algebraic `A₁^P` root. -/\n@[rep_depth thermo]\ndef toAlgebraPrimeA1RootSystem (L : FormalPrimeRootLattice) :\n    InfoGeometry.Algebra.PrimeA1RootSystem where\n  P := L.primes\n  all_prime := L.prime_mem\n\n@[simp, rep_depth thermo]\ntheorem toAlgebraPrimeA1RootSystem_P (L : FormalPrimeRootLattice) :\n    L.toAlgebraPrimeA1RootSystem.P = L.primes :=\n  rfl\n\n/-- Formal-lattice primality is conducted through the algebraic root system. -/\n@[rep_depth thermo]\ntheorem prime_mem_via_algebra (L : FormalPrimeRootLattice) {p : ℕ} (hp : p ∈ L.primes) :\n    Nat.Prime p :=\n  L.toAlgebraPrimeA1RootSystem.prime_of_mem hp\n\n/-- Build a formal prime root lattice from the certified algebraic root. -/\n@[rep_depth thermo]\ndef ofAlgebraPrimeA1RootSystem (S : InfoGeometry.Algebra.PrimeA1RootSystem) :\n    FormalPrimeRootLattice where\n  primes := S.P\n  prime_mem := S.all_prime\n\n@[simp, rep_depth thermo]\ntheorem ofAlgebraPrimeA1RootSystem_primes (S : InfoGeometry.Algebra.PrimeA1RootSystem) :\n    (ofAlgebraPrimeA1RootSystem S).primes = S.P :=\n  rfl\n\n@[simp, rep_depth thermo]\ntheorem toAlgebra_ofAlgebraPrimeA1RootSystem\n    (S : InfoGeometry.Algebra.PrimeA1RootSystem) :\n    (ofAlgebraPrimeA1RootSystem S).toAlgebraPrimeA1RootSystem = S := by\n  cases S\n  rfl\n\n@[simp, rep_depth thermo]\ntheorem ofAlgebra_toAlgebraPrimeA1RootSystem (L : FormalPrimeRootLattice) :\n    ofAlgebraPrimeA1RootSystem L.toAlgebraPrimeA1RootSystem = L := by\n  cases L\n  rfl\n\nend FormalPrimeRootLattice\n\n/-!\nCompatibility note for older structural-surface tests:\ndef FormalPrimeRootLattice\ndef BooleanWeylGroup\n-/\n\n/-- Boolean Weyl group element: a subset of the finite prime cutoff. -/\n@[rep_depth thermo]\nstructure BooleanWeylGroup (L : FormalPrimeRootLattice) where\n  support : Finset ℕ\n  support_subset : support ⊆ L.primes\n\nnamespace BooleanWeylGroup\n\n/-- A Weyl support coordinate lies in the ambient prime cutoff. -/\n@[rep_depth thermo]\ntheorem mem_cutoff_of_mem_support {L : FormalPrimeRootLattice}\n    (w : BooleanWeylGroup L) {p : ℕ} (hp : p ∈ w.support) :\n    p ∈ L.primes :=\n  w.support_subset hp\n\n/-- Weyl support primality is conducted through the algebraic `A₁^P` root. -/\n@[rep_depth thermo]\ntheorem prime_of_mem_support {L : FormalPrimeRootLattice}\n    (w : BooleanWeylGroup L) {p : ℕ} (hp : p ∈ w.support) :\n    Nat.Prime p :=\n  L.prime_mem_via_algebra (w.mem_cutoff_of_mem_support hp)\n\nend BooleanWeylGroup\n\n/-- Finite `A₁^P` root system, deliberately only the Boolean prime-mode cutoff. -/\n@[rep_depth thermo]\nstructure PrimeA1RootSystem where\n  lattice : FormalPrimeRootLattice\n\nnamespace PrimeA1RootSystem\n\n/-- Read the canonical finite root-system surface through the algebraic root. -/\n@[rep_depth thermo]\ndef toAlgebraPrimeA1RootSystem (R : PrimeA1RootSystem) :\n    InfoGeometry.Algebra.PrimeA1RootSystem :=\n  R.lattice.toAlgebraPrimeA1RootSystem\n\n@[simp, rep_depth thermo]\ntheorem toAlgebraPrimeA1RootSystem_P (R : PrimeA1RootSystem) :\n    R.toAlgebraPrimeA1RootSystem.P = R.lattice.primes :=\n  rfl\n\n/-- Root-system primality is conducted through the algebraic `A₁^P` root. -/\n@[rep_depth thermo]\ntheorem prime_mem_via_algebra (R : PrimeA1RootSystem) {p : ℕ} (hp : p ∈ R.lattice.primes) :\n    Nat.Prime p :=\n  R.toAlgebraPrimeA1RootSystem.prime_of_mem hp\n\nend PrimeA1RootSystem\n\n/-- Formal half-sum of positive roots, represented by its finite support. -/\n@[rep_depth thermo]\ndef rho_P (R : PrimeA1RootSystem) : Finset ℕ :=\n  R.lattice.primes\n\n/-- Weyl sign character `ε(w_S) = (-1)^{|S|}`. -/\n@[rep_depth thermo]\ndef weylSign {L : FormalPrimeRootLattice} (w : BooleanWeylGroup L) : ℝ :=\n  (-1 : ℝ) ^ w.support.card\n\n/-- Evaluated root variable `e^{-α_p}` supplied by an external thermal evaluation. -/\n@[rep_depth thermo]\ndef rootThermalVariable (_L : FormalPrimeRootLattice) (x : ℕ → ℝ) (p : ℕ) : ℝ :=\n  x p\n\n/-- Finite Weyl-denominator/product side `∏_{p∈P} (1 - e^{-α_p})`. -/\n@[rep_depth thermo]\ndef weylDenominatorProduct (L : FormalPrimeRootLattice) (x : ℕ → ℝ) : ℝ :=\n  ∏ p ∈ L.primes, (1 - rootThermalVariable L x p)\n\n/-- Alternating subset expansion `∑_{S⊆P} (-1)^{|S|} ∏_{p∈S} e^{-α_p}`. -/\n@[rep_depth thermo]\ndef weylAlternatingSum (L : FormalPrimeRootLattice) (x : ℕ → ℝ) : ℝ :=\n  ∑ S ∈ L.primes.powerset, ((-1 : ℝ) ^ S.card) * ∏ p ∈ S, rootThermalVariable L x p\n\n/--\nFinite prime-mode Weyl denominator identity.\n\nThis is the manuscript-safe algebraic core: the denominator-like object is the\nalternating product/supertrace, and the proof is purely finite combinatorics.\n-/\n@[rep_depth thermo]\ntheorem finite_prime_weyl_denominator\n    (L : FormalPrimeRootLattice) (x : ℕ → ℝ) :\n    weylDenominatorProduct L x = weylAlternatingSum L x := by\n  classical\n  unfold weylDenominatorProduct weylAlternatingSum rootThermalVariable\n  simpa using (Finset.prod_sub (fun _ : ℕ => (1 : ℝ)) x L.primes)\n\n@[rep_depth thermo]\ntheorem finite_denominator_identity\n    (L : FormalPrimeRootLattice) (x : ℕ → ℝ) :\n    weylDenominatorProduct L x = weylAlternatingSum L x :=\n  finite_prime_weyl_denominator L x\n\nend InfoGeometry.Canonical.FormalPrimeRootSystem\n","mtime":1778324330855}