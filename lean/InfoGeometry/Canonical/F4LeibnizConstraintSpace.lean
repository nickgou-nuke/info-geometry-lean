import Mathlib
import InfoGeometry.Algebra.BaezF4H3Zorn
import InfoGeometry.Canonical.H3ZornCoordinateBasisBridge
import InfoGeometry.Canonical.F4ActionMatrixRationalCertificate

noncomputable section

namespace InfoGeometry.Canonical.F4LeibnizConstraintSpace

open InfoGeometry.Algebra
open InfoGeometry.Algebra.H3Zorn
open InfoGeometry.Canonical.H3ZornBasis

abbrev H3 := H3Zorn ℝ
abbrev EndH3 := Module.End ℝ H3
abbrev ActionCoord := Fin 27 → Fin 27 → ℝ
abbrev ConstraintCoord := Fin 27 → Fin 27 → Fin 27 → ℝ

/-- Canonical 729-coordinate readout of an endomorphism in the certified
27-element `H3Zorn` basis.  The first coordinate is the input basis vector,
the second is the output coordinate. -/
def f4Readout (D : EndH3) : ActionCoord := fun r c =>
  (h3ZornCoordinateBasis.repr (D (h3ZornCoordinateBasis r))) c

/-- The action readout is linear in the endomorphism. -/
def f4ReadoutLM : EndH3 →ₗ[ℝ] ActionCoord where
  toFun := f4Readout
  map_add' D E := by
    funext r c
    simp [f4Readout]
  map_smul' a D := by
    funext r c
    simp [f4Readout]

/-- Faithfulness of the 729-coordinate action readout.  Equality of all
basis-action coordinates implies equality of the underlying endomorphisms. -/
theorem f4Readout_injective : Function.Injective f4ReadoutLM := by
  intro D E hDE
  apply LinearMap.ext
  intro X
  rw [← h3ZornCoordinateBasis.sum_repr X]
  simp only [map_sum, map_smul]
  apply Finset.sum_congr rfl
  intro r hr
  have hrEq : D (h3ZornCoordinateBasis r) = E (h3ZornCoordinateBasis r) := by
    apply h3ZornCoordinateBasis.repr.injective
    ext c
    exact congrFun (congrFun hDE r) c
  exact congrArg (fun Z : H3 => (h3ZornCoordinateBasis.repr X r) • Z) hrEq

/-- The Jordan-Leibniz defect of an arbitrary endomorphism, bundled as a
bilinear map.  A genuine `F4` derivation is exactly an endomorphism whose
residual vanishes identically. -/
def leibnizResidual (D : EndH3) : H3 →ₗ[ℝ] H3 →ₗ[ℝ] H3 where
  toFun X :=
    { toFun := fun Y =>
        D (candidateJordanMul X Y) -
          candidateJordanMul (D X) Y -
          candidateJordanMul X (D Y)
      map_add' := by
        intro Y Z
        simp only [candidateJordanMul_add_right, map_add,
          candidateJordanMul_add_left]
        module
      map_smul' := by
        intro a Y
        simp only [candidateJordanMul_smul_right, map_smul,
          candidateJordanMul_smul_left]
        module }
  map_add' := by
    intro X Y
    ext Z
    simp only [candidateJordanMul_add_left, map_add,
      candidateJordanMul_add_right]
    module
  map_smul' := by
    intro a X
    ext Y
    simp only [candidateJordanMul_smul_left, map_smul,
      candidateJordanMul_smul_right]
    module

/-- Linear constraint operator from the full 729-dimensional endomorphism
space to the space of bilinear Leibniz residuals. -/
def f4ConstraintMap : EndH3 →ₗ[ℝ] (H3 →ₗ[ℝ] H3 →ₗ[ℝ] H3) where
  toFun := leibnizResidual
  map_add' D E := by
    ext X Y
    simp [leibnizResidual, candidateJordanMul_add_left,
      candidateJordanMul_add_right]
    module
  map_smul' a D := by
    ext X Y
    simp [leibnizResidual, candidateJordanMul_smul_left,
      candidateJordanMul_smul_right]
    module

/-- Exact kernel characterization: the native split-Albert derivations are
precisely the kernel of the linear Leibniz-constraint operator. -/
theorem mem_constraintKernel_iff (D : EndH3) :
    D ∈ LinearMap.ker f4ConstraintMap ↔ H3ZornJordanDerivation D := by
  constructor
  · intro hD X Y
    have hzero : f4ConstraintMap D X Y = 0 := by
      have hmap : f4ConstraintMap D = 0 := LinearMap.mem_ker.mp hD
      rw [hmap]
      rfl
    change D (candidateJordanMul X Y) =
      candidateJordanMul (D X) Y + candidateJordanMul X (D Y)
    dsimp [f4ConstraintMap, leibnizResidual] at hzero
    linear_combination hzero
  · intro hD
    apply LinearMap.mem_ker.mpr
    apply LinearMap.ext
    intro X
    apply LinearMap.ext
    intro Y
    have h := hD X Y
    change D (candidateJordanMul X Y) =
      candidateJordanMul (D X) Y + candidateJordanMul X (D Y) at h
    dsimp [f4ConstraintMap, leibnizResidual]
    rw [h]
    module

/-- Submodule form of the full constraint space. -/
def F4ConstraintKernel : Submodule ℝ EndH3 :=
  LinearMap.ker f4ConstraintMap

/-- Membership in the constraint kernel is definitionally the native `F4`
Jordan-derivation property. -/
theorem mem_F4ConstraintKernel_iff (D : EndH3) :
    D ∈ F4ConstraintKernel ↔ D ∈ H3ZornF4Derivations := by
  exact mem_constraintKernel_iff D

/-- Finite basis-generated constraint tensor.  No hand-written Albert
structure tensor is introduced: the equations are generated by evaluating the
Leibniz residual on the 27×27 ordered basis pairs and reading the 27 output
coordinates.  This is the canonical 27^3 = 19683 equation presentation. -/
def constraintReadout
    (B : H3 →ₗ[ℝ] H3 →ₗ[ℝ] H3) : ConstraintCoord := fun i j k =>
  (h3ZornCoordinateBasis.repr
    (B (h3ZornCoordinateBasis i) (h3ZornCoordinateBasis j))) k

/-- Linear finite-coordinate readout of a bilinear residual. -/
def constraintReadoutLM :
    (H3 →ₗ[ℝ] H3 →ₗ[ℝ] H3) →ₗ[ℝ] ConstraintCoord where
  toFun := constraintReadout
  map_add' B C := by
    funext i j k
    simp [constraintReadout]
  map_smul' a B := by
    funext i j k
    simp [constraintReadout]

/-- The actual finite Leibniz constraint matrix map on arbitrary Albert
endomorphisms.  A row/column flattening can be generated from this map for an
exact rational rank certificate. -/
def f4ConstraintCoordinateMap : EndH3 →ₗ[ℝ] ConstraintCoord :=
  constraintReadoutLM.comp f4ConstraintMap

@[simp] theorem f4ConstraintCoordinateMap_apply
    (D : EndH3) (i j k : Fin 27) :
    f4ConstraintCoordinateMap D i j k =
      (h3ZornCoordinateBasis.repr
        (D (candidateJordanMul (h3ZornCoordinateBasis i) (h3ZornCoordinateBasis j)) -
          candidateJordanMul (D (h3ZornCoordinateBasis i))
            (h3ZornCoordinateBasis j) -
          candidateJordanMul (h3ZornCoordinateBasis i)
            (D (h3ZornCoordinateBasis j)))) k := rfl

/-- Every native `F4` derivation satisfies all 19683 generated basis
constraints. -/
theorem f4_derivation_constraint_coordinates_zero
    (D : H3ZornF4Derivations) :
    f4ConstraintCoordinateMap D.1 = 0 := by
  have hk : D.1 ∈ LinearMap.ker f4ConstraintMap :=
    (mem_constraintKernel_iff D.1).2 D.property
  have hz : f4ConstraintMap D.1 = 0 := LinearMap.mem_ker.mp hk
  rw [f4ConstraintCoordinateMap, hz]
  rfl

/-- Arithmetic size of the generated equation family. -/
theorem constraint_equation_count : 27 * 27 * 27 = 19683 := by
  norm_num

/-- Arithmetic form of the required rank certificate for the upper bound:
`729 - 52 = 677`.  The next computational owner should certify rank 677 for
the flattened rational matrix of `f4ConstraintCoordinateMap`. -/
theorem required_constraint_rank : 729 - 52 = 677 := by
  norm_num

/-- Existing independent 52-row action certificate gives the lower bound;
the new constraint rank certificate must provide the complementary upper
bound.  Keeping these certificates distinct prevents circular dimension
reasoning. -/
def f4_constraint_rank_closure_debt : String :=
  "Open computational certificate: flatten f4ConstraintCoordinateMap to a rational 19683×729 matrix and prove rank = 677. Together with f4Readout_injective and ker(f4ConstraintMap)=H3ZornF4Derivations, rank-nullity gives finrank <= 52; the existing 52 independent f4Basis rows then force equality and span = top."

end InfoGeometry.Canonical.F4LeibnizConstraintSpace
