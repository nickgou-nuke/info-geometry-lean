{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AutoproofTracePacket.schema.json",
  "title": "AutoproofTracePacket",
  "allOf": [
    {
      "$ref": "authority.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "authority",
        "promotion_allowed",
        "target",
        "budgets",
        "result",
        "attempts",
        "frontier"
      ],
      "properties": {
        "kind": {
          "const": "AutoproofTracePacket"
        },
        "authority": {
          "const": "proposal"
        },
        "promotion_allowed": {
          "const": false
        },
        "target": {
          "type": "object",
          "required": ["goal", "imports"],
          "properties": {
            "goal": {"type": "string", "minLength": 1},
            "imports": {"type": "array", "items": {"type": "string"}},
            "context_present": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "budgets": {
          "type": "object",
          "required": ["max_iterations"],
          "properties": {
            "max_iterations": {"type": "integer", "minimum": 0},
            "max_seconds": {"type": "number", "minimum": 0},
            "max_repeated_error": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        },
        "result": {
          "type": "object",
          "required": ["status", "emitted_packet_kind"],
          "properties": {
            "status": {"enum": ["verified", "failed", "partial", "blocked", "exhausted", "unknown"]},
            "emitted_packet_kind": {"enum": ["TheoremCandidatePacket", "ResiduePacket", "none"]}
          },
          "additionalProperties": true
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "attempt_index",
              "mode",
              "candidate_text",
              "lean_result",
              "strategy",
              "changed_strategy",
              "error_signature"
            ],
            "properties": {
              "attempt_index": {"type": "integer", "minimum": 1},
              "mode": {"enum": ["tactic", "repair", "patch", "whole_proof", "theorem_shape", "retrieval_retry"]},
              "goal_before": {"type": "string"},
              "goal_after": {"type": "string"},
              "candidate_text": {"type": "string"},
              "lean_result": {
                "type": "object",
                "required": ["accepted", "status"],
                "properties": {
                  "accepted": {"type": "boolean"},
                  "status": {"type": "string"},
                  "feedback": {"type": "string"}
                },
                "additionalProperties": true
              },
              "error_signature": {"type": "string"},
              "strategy": {"type": "string", "minLength": 1},
              "changed_strategy": {"type": "boolean"},
              "retrieved_lemmas": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        },
        "frontier": {
          "type": "object",
          "required": ["next_recommended_bee"],
          "properties": {
            "last_error_signature": {"type": "string"},
            "next_recommended_bee": {"enum": ["none", "RetrieverBee", "SocratesBee", "PauliBee", "HermesLeanstralBee"]},
            "new_information_needed": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  ]
}
