import InfoGeometry.Clifford.Cl55WittPinSignatureBoundary

namespace InfoGeometry.Clifford.Clifford55

/-!
# The real split Pin generator subgroup

Mathlib's `pinGroup Q55` uses the unitary condition and therefore omits the
positive Witt generators.  The split real Pin object below is the subgroup of
Clifford units generated by all normalized anisotropic vectors of norm `+1`
or `-1`.  This is the generator-level correction; the orthogonal covering
theorems are deliberately separate.
-/

def normalizedVectorUnitSet : Set Cl55ˣ :=
  {u | ∃ v : V55,
      (Q55 v = 1 ∨ Q55 v = -1) ∧
        ι55 v = (u : Cl55)}

def realSplitPin55 : Subgroup Cl55ˣ :=
  Subgroup.closure normalizedVectorUnitSet

theorem normalizedVector_mem_lipschitz
    {u : Cl55ˣ} (hu : u ∈ normalizedVectorUnitSet) :
    u ∈ LipschitzGroup55 := by
  rcases hu with ⟨v, _, hv⟩
  change u ∈ lipschitzGroup Q55
  apply Subgroup.subset_closure
  exact ⟨v, hv⟩

theorem realSplitPin_mem_lipschitz (u : Cl55ˣ) (hu : u ∈ realSplitPin55) :
    u ∈ LipschitzGroup55 := by
  change u ∈ lipschitzGroup Q55
  induction hu using Subgroup.closure_induction'' with
  | mem u hu =>
      exact normalizedVector_mem_lipschitz hu
  | inv_mem u hu =>
      exact Subgroup.inv_mem _ (normalizedVector_mem_lipschitz hu)
  | one =>
      exact Subgroup.one_mem _
  | mul u v hu hv hU hV =>
      exact Subgroup.mul_mem _ hU hV

noncomputable def normalizedVectorUnit
    (v : V55) (hv : IsUnit (Q55 v)) : Cl55ˣ :=
  (CliffordAlgebra.isUnit_ι_of_isUnit Q55 hv).unit

theorem normalizedVectorUnit_coe
    (v : V55) (hv : IsUnit (Q55 v)) :
    (normalizedVectorUnit v hv : Cl55) = ι55 v := by
  exact (CliffordAlgebra.isUnit_ι_of_isUnit Q55 hv).unit_spec

theorem ePos_mem_realSplitPin (i : Fin 5) :
    ∃ g : realSplitPin55, ((g : Cl55ˣ) : Cl55) = ι55 (e_pos i) := by
  let hv : IsUnit (Q55 (e_pos i)) := by
    rw [Q55_e_pos]
    exact ⟨1, by simp⟩
  let u := normalizedVectorUnit (e_pos i) hv
  have hu : u ∈ normalizedVectorUnitSet := by
    refine ⟨e_pos i, Or.inl (Q55_e_pos i), ?_⟩
    exact (normalizedVectorUnit_coe (e_pos i) hv).symm
  exact ⟨⟨u, Subgroup.subset_closure hu⟩, by
    exact normalizedVectorUnit_coe (e_pos i) hv⟩

theorem fNeg_mem_realSplitPin (i : Fin 5) :
    ∃ g : realSplitPin55, ((g : Cl55ˣ) : Cl55) = ι55 (f_neg i) := by
  let hv : IsUnit (Q55 (f_neg i)) := by
    rw [Q55_f_neg]
    exact ⟨-1, by simp⟩
  let u := normalizedVectorUnit (f_neg i) hv
  have hu : u ∈ normalizedVectorUnitSet := by
    refine ⟨f_neg i, Or.inr (Q55_f_neg i), ?_⟩
    exact (normalizedVectorUnit_coe (f_neg i) hv).symm
  exact ⟨⟨u, Subgroup.subset_closure hu⟩, by
    exact normalizedVectorUnit_coe (f_neg i) hv⟩

theorem fNegUnit_mem_realSplitPin (i : Fin 5) :
    fNegUnit i ∈ realSplitPin55 := by
  rcases fNeg_mem_realSplitPin i with ⟨g, hg⟩
  have hunit : (g : Cl55ˣ) = fNegUnit i := by
    apply Units.ext
    rw [hg, fNegUnit_coe]
  rw [← hunit]
  exact g.property

theorem globalSheetUnit_mem_realSplitPin :
    globalSheetUnit ∈ realSplitPin55 := by
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _
      (Subgroup.mul_mem _
        (Subgroup.mul_mem _
          (fNegUnit_mem_realSplitPin 0)
          (fNegUnit_mem_realSplitPin 1))
        (fNegUnit_mem_realSplitPin 2))
      (fNegUnit_mem_realSplitPin 3))
    (fNegUnit_mem_realSplitPin 4)

end InfoGeometry.Clifford.Clifford55
