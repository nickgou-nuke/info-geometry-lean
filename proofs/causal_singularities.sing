// causal_singularities.sing
// Algebraic variety where the null cone (laser beam boundary) degenerates.

ring r = 0, (t, x, y, z), dp;

// Define the standard light cone (null cone) equation: -t^2 + x^2 + y^2 + z^2 = 0
poly null_cone = -t^2 + x^2 + y^2 + z^2;

// Ideal of the null cone
ideal I = null_cone;

// Calculate the singular locus of the null cone variety
// The singular locus is given by the ideal generated by the polynomials and their partial derivatives
ideal J = I, jacob(I);
J = std(J);

print("Null cone ideal:");
print(I);

print("Singular locus (where the null cone degenerates):");
print(J);
// The result should be the origin (t=0, x=0, y=0, z=0)
