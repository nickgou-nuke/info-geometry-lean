{"type":"new","contents":"import Mathlib.Algebra.Ring.Basic\nimport Mathlib.Algebra.Star.Basic\nimport Mathlib.Analysis.InnerProductSpace.Adjoint\nimport Mathlib.Analysis.InnerProductSpace.Projection.Basic\nimport Mathlib.Analysis.InnerProductSpace.Projection.Submodule\nimport Mathlib.Analysis.Normed.Operator.Banach\n\n/-!\n# Moore-Penrose Inverse\n\nThis module provides the L0 foundation for generalized inverses in StarRings and Hilbert spaces.\nIt follows the Pauli Protocol: zero sorry, bottom-up derivation, and direct conductivity \nto Mathlib roots.\n-/\n\nnamespace InfoGeometry.Singular.MoorePenrose\n\n-- Geometric adjoint postfix.\npostfix:max \"†\" => star\n\nsection MP\nvariable {R : Type*} [Ring R] [StarRing R]\n\n/-- The Four Penrose equations as a direct predicate. -/\ndef IsMoorePenroseInverse (A B : R) : Prop :=\n  A * B * A = A ∧\n  B * A * B = B ∧\n  (A * B)† = A * B ∧\n  (B * A)† = B * A\n\nnamespace IsMoorePenroseInverse\n\nvariable {A B : R}\n\ntheorem mk\n    (h1 : A * B * A = A)\n    (h2 : B * A * B = B)\n    (h3 : (A * B)† = A * B)\n    (h4 : (B * A)† = B * A) :\n    IsMoorePenroseInverse A B :=\n  ⟨h1, h2, h3, h4⟩\n\ntheorem aba_eq_a (h : IsMoorePenroseInverse A B) : A * B * A = A := h.1\ntheorem bab_eq_b (h : IsMoorePenroseInverse A B) : B * A * B = B := h.2.1\ntheorem ab_adj_eq (h : IsMoorePenroseInverse A B) : (A * B)† = A * B := h.2.2.1\ntheorem ba_adj_eq (h : IsMoorePenroseInverse A B) : (B * A)† = B * A := h.2.2.2\n\ntheorem eq1 (h : IsMoorePenroseInverse A B) : A * B * A = A := h.aba_eq_a\ntheorem eq2 (h : IsMoorePenroseInverse A B) : B * A * B = B := h.bab_eq_b\ntheorem eq3 (h : IsMoorePenroseInverse A B) : (A * B)† = A * B := h.ab_adj_eq\ntheorem eq4 (h : IsMoorePenroseInverse A B) : (B * A)† = B * A := h.ba_adj_eq\n\nend IsMoorePenroseInverse\n\nlemma star_mul_triple (X Y Z : R) : (X * Y * Z)† = Z† * Y† * X† := by\n  simp only [star_mul, mul_assoc]\n\n/-- The Uniqueness Theorem for Moore-Penrose inverses. -/\ntheorem MoorePenrose_unique {A B C : R} \n    (hB : IsMoorePenroseInverse A B) \n    (hC : IsMoorePenroseInverse A C) : B = C := by\n  have h1 : A * B = A * C := by\n    calc\n      A * B = (A * B)† := hB.ab_adj_eq.symm\n      _ = B† * A† := star_mul _ _\n      _ = B† * (A * C * A)† := by rw [hC.aba_eq_a]\n      _ = B† * (A† * C† * A†) := by rw [star_mul_triple]\n      _ = (B† * A†) * C† * A† := by simp only [mul_assoc]\n      _ = (A * B)† * C† * A† := by rw [star_mul]\n      _ = (A * B) * C† * A† := by rw [hB.ab_adj_eq]\n      _ = A * B * (C† * A†) := by rw [mul_assoc]\n      _ = A * B * (A * C)† := by rw [star_mul]\n      _ = A * B * (A * C) := by rw [hC.ab_adj_eq]\n      _ = (A * B * A) * C := by simp only [mul_assoc]\n      _ = A * C := by rw [hB.aba_eq_a]\n  have h2 : B * A = C * A := by\n    calc\n      B * A = (B * A)† := hB.ba_adj_eq.symm\n      _ = A† * B† := star_mul _ _\n      _ = (A * C * A)† * B† := by rw [hC.aba_eq_a]\n      _ = (A† * C† * A†) * B† := by rw [star_mul_triple]\n      _ = A† * C† * (A† * B†) := by simp only [mul_assoc]\n      _ = A† * C† * (B * A)† := by rw [star_mul]\n      _ = A† * C† * (B * A) := by rw [hB.ba_adj_eq]\n      _ = (C * A)† * (B * A) := by rw [star_mul]\n      _ = (C * A) * (B * A) := by rw [hC.ba_adj_eq]\n      _ = C * (A * B * A) := by simp only [mul_assoc]\n      _ = C * A := by rw [hB.aba_eq_a]\n  calc\n    B = B * A * B := hB.bab_eq_b.symm\n    _ = (B * A) * B := by rw [mul_assoc]\n    _ = (C * A) * B := by rw [h2]\n    _ = C * (A * B) := by rw [← mul_assoc]\n    _ = C * (A * C) := by rw [h1]\n    _ = C * A * C := by rw [mul_assoc]\n    _ = C := hC.bab_eq_b\n\n/-- The support projector P = A * B. -/\ndef MP_Projector (A B : R) (_h : IsMoorePenroseInverse A B) : R := A * B\n\nlemma MP_Projector_idempotent {A B : R} (h : IsMoorePenroseInverse A B) : \n    (MP_Projector A B h) * (MP_Projector A B h) = MP_Projector A B h := by\n  unfold MP_Projector\n  calc\n    (A * B) * (A * B) = (A * B * A) * B := by simp only [mul_assoc]\n    _ = A * B := by rw [h.aba_eq_a]\n\nlemma MP_Projector_self_adjoint {A B : R} (h : IsMoorePenroseInverse A B) : \n    (MP_Projector A B h)† = MP_Projector A B h := h.ab_adj_eq\n\nend MP\n\nsection Hilbert\nopen InnerProductSpace ContinuousLinearMap\nopen scoped InnerProduct ComplexConjugate\n\nvariable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\n\n/--\nExistence of Moore-Penrose inverse for bounded operators with closed range in Hilbert spaces.\n\nThe construction establish the conductive path to Mathlib's `orthogonalProjection`.\n-/\ntheorem exists_moorePenroseInverse_of_closedRange\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    ∃ (B : E →L[𝕜] E), IsMoorePenroseInverse A B := by\n  classical\n  let K := A.ker\n  let R := A.range\n  let Kp := Kᗮ\n  \n  -- K is closed, so Kp.HasOrthogonalProjection and IsCompl K Kp\n  letI : CompleteSpace K := A.isClosed_ker.completeSpace_coe\n  haveI : K.HasOrthogonalProjection := Submodule.HasOrthogonalProjection.ofCompleteSpace K\n  \n  -- R is closed and E is complete, so R is complete and has an orthogonal projection\n  letI : CompleteSpace R := hClosedRange.completeSpace_coe\n  haveI : R.HasOrthogonalProjection := Submodule.HasOrthogonalProjection.ofCompleteSpace R\n\n  -- Identity: A(P_Kp x) = A x\n  have hA_on_Kp : ∀ x : E, A (Kp.starProjection x) = A x := by\n    intro x\n    have hx_split : x = K.starProjection x + Kp.starProjection x := \n      (Submodule.starProjection_add_starProjection_orthogonal (K := K) x).symm\n    rw [hx_split, map_add]\n    have hKzero : A (K.starProjection x) = 0 := by\n      have : K.starProjection x ∈ K := Submodule.starProjection_mem_subspace_eq_self (K := K) _\n      exact LinearMap.mem_ker.1 this\n    rw [hKzero, zero_add]\n\n  -- Restrict A to Kp, and codrestrict to its range R\n  let Ares : Kp →L[𝕜] R :=\n    (A.comp Kp.subtypeL).codRestrict R (fun ⟨x, hx⟩ ↦ ⟨A x, ⟨x, rfl⟩⟩)\n\n  -- Ares is injective because Kp ⊓ ker A = ⊥\n  have hAres_inj : (Ares : Kp →ₗ[𝕜] R).ker = ⊥ := by\n    rw [LinearMap.ker_eq_bot]\n    intro x y hxy\n    apply Subtype.ext\n    have hval : A x.1 = A y.1 := congrArg Subtype.val hxy\n    have hker : (x.1 - y.1) ∈ K := by\n      rw [LinearMap.mem_ker, map_sub, hval, sub_self]\n    have horth : (x.1 - y.1) ∈ Kp := Submodule.sub_mem Kp x.2 y.2\n    have hbot : (x.1 - y.1) = 0 := by\n      have : (x.1 - y.1) ∈ K ⊓ Kp := Submodule.mem_inf.2 ⟨hker, horth⟩\n      simpa [Submodule.inf_orthogonal_eq_bot K] using this\n    exact sub_eq_zero.1 hbot\n\n  -- Ares is surjective because range A ⊆ R and K ⊔ Kp = ⊤\n  have hAres_surj : (Ares : Kp →ₗ[𝕜] R).range = ⊤ := by\n    rw [LinearMap.range_eq_top]\n    intro ⟨y, hy⟩\n    rcases hy with ⟨x, rfl⟩\n    refine ⟨Kp.orthogonalProjection x, ?_⟩\n    apply Subtype.ext\n    simp only [Ares, codRestrict_apply, comp_apply, Kp.subtypeL_apply, \n      Submodule.starProjection_apply, hA_on_Kp]\n\n  -- By Banach inverse theorem, Ares is a continuous linear equivalence\n  let e : Kp ≃L[𝕜] R := \n    ContinuousLinearEquiv.ofBijective Ares hAres_inj hAres_surj\n  \n  -- Define B = i_Kp ∘ e⁻¹ ∘ P_R\n  let B : E →L[𝕜] E := Kp.subtypeL.comp (e.symm.toContinuousLinearMap.comp R.orthogonalProjection)\n\n  have hAB_apply (x : E) : A (B x) = R.starProjection x := by\n    dsimp [B, Ares, e]\n    have h := ContinuousLinearEquiv.ofBijective_apply_symm_apply Ares hAres_inj hAres_surj (R.orthogonalProjection x)\n    rw [Submodule.starProjection_apply]\n    exact congrArg Subtype.val h\n\n  have hBA_apply (x : E) : B (A x) = Kp.starProjection x := by\n    dsimp [B, Ares, e]\n    have hproj : R.orthogonalProjection (A x) = ⟨A x, ⟨x, rfl⟩⟩ := by\n      apply Subtype.ext\n      exact Submodule.orthogonalProjection_mem_subspace_eq_self ⟨A x, ⟨x, rfl⟩⟩\n    rw [hproj]\n    have hTz : Ares (Kp.orthogonalProjection x) = ⟨A x, ⟨x, rfl⟩⟩ := by\n      apply Subtype.ext\n      simp only [Ares, codRestrict_apply, comp_apply, Kp.subtypeL_apply, \n        Submodule.starProjection_apply, hA_on_Kp]\n    rw [← hTz, ContinuousLinearEquiv.ofBijective_symm_apply_apply]\n    exact (Submodule.starProjection_apply Kp x).symm\n\n  refine ⟨B, ?_, ?_, ?_, ?_⟩\n  · -- A * B * A = A\n    ext x\n    rw [mul_apply, mul_apply, hAB_apply]\n    exact Submodule.starProjection_mem_subspace_eq_self ⟨A x, ⟨x, rfl⟩⟩\n  · -- B * A * B = B\n    ext x\n    rw [mul_apply, mul_apply, hBA_apply]\n    exact Submodule.starProjection_mem_subspace_eq_self (e.symm (R.orthogonalProjection x))\n  · -- (A * B)† = A * B\n    rw [ContinuousLinearMap.ext_iff]\n    intro x\n    rw [mul_apply, hAB_apply]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection R) ▸ rfl\n  · -- (B * A)† = B * A\n    rw [ContinuousLinearMap.ext_iff]\n    intro x\n    rw [mul_apply, hBA_apply]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection Kp) ▸ rfl\n\nend Hilbert\n\nend InfoGeometry.Singular.MoorePenrose\n","mtime":1778368540723}