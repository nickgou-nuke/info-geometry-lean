import Mathlib.LinearAlgebra.Matrix.ToLinearEquiv
import Mathlib.Tactic
import InfoGeometry.Canonical.MatrixDetExpTraceJacobi

/-!
# Algebraic trace identities for finite matrix Lax data

This file proves the algebraic trace cancellations associated with a matrix
commutator and the finite-dimensional determinant/kernel criterion. It does
not define a differentiable Lax flow, a spectral-gap quantity, or a Yang–Mills
mass gap. Those require additional analytic and spectral data.
-/

namespace InfoGeometry.NCG.LaxPairIsospectralMassGap

open scoped Matrix Matrix.Norms.Frobenius

/-- The matrix commutator in the indicated order. -/
def laxCommutator {n : ℕ} (P L : Matrix (Fin n) (Fin n) ℂ) :
    Matrix (Fin n) (Fin n) ℂ := P * L - L * P

/-- The finite matrix trace annihilates commutators. -/
theorem trace_commutator_zero {n : ℕ} (P L : Matrix (Fin n) (Fin n) ℂ) :
    Matrix.trace (laxCommutator P L) = 0 := by
  rw [laxCommutator, Matrix.trace_sub, Matrix.trace_mul_comm]
  exact sub_self _

/-- The commutator contribution to each cyclic trace-power variation vanishes.
This is an algebraic cancellation identity; it does not assert that a curve
of matrices solves the Lax differential equation. -/
theorem trace_power_commutator_zero {n : ℕ}
    (L P : Matrix (Fin n) (Fin n) ℂ) (k : ℕ) :
    Matrix.trace (L ^ k * laxCommutator P L) = 0 := by
  rw [laxCommutator, mul_sub, Matrix.trace_sub]
  have h₁ : Matrix.trace (L ^ k * (P * L)) =
      Matrix.trace ((L * L ^ k) * P) := by
    calc
      Matrix.trace (L ^ k * (P * L)) =
          Matrix.trace ((L ^ k * P) * L) := by simp [mul_assoc]
      _ = Matrix.trace (L * (L ^ k * P)) := Matrix.trace_mul_comm _ _
      _ = Matrix.trace ((L * L ^ k) * P) := by simp [mul_assoc]
  have h₂ : L * L ^ k = L ^ k * L := by
    rw [← pow_succ', pow_succ]
  calc
    Matrix.trace (L ^ k * (P * L)) - Matrix.trace (L ^ k * (L * P)) =
        Matrix.trace ((L * L ^ k) * P) - Matrix.trace ((L ^ k * L) * P) := by
          rw [h₁]
          simp only [mul_assoc]
    _ = 0 := by rw [h₂]; exact sub_self _

/-- A square complex matrix is singular exactly when its action has a nonzero
kernel vector. This is Mathlib's finite-dimensional determinant criterion. -/
theorem zeroMode_iff_det_zero {n : ℕ} (L : Matrix (Fin n) (Fin n) ℂ) :
    (Matrix.det L = 0) ↔ ∃ v : (Fin n → ℂ),
      v ≠ 0 ∧ Matrix.mulVec L v = 0 := by
  exact (Matrix.exists_mulVec_eq_zero_iff (M := L)).symm

/-- Conjugate operators have the same determinant.  The conjugating matrix is
an actual unit, so this statement records similarity invariance without an
unstated invertibility premise. -/
theorem det_conjugateByUnit_eq {n : ℕ}
    (U : (Matrix (Fin n) (Fin n) ℂ)ˣ) (L : Matrix (Fin n) (Fin n) ℂ) :
    Matrix.det (U.val * L * U⁻¹.val) = Matrix.det L := by
  exact Matrix.det_units_conj U L

/-- Powers commute with unit conjugation in the expected operator order. -/
theorem conjugateByUnit_pow {n : ℕ}
    (U : (Matrix (Fin n) (Fin n) ℂ)ˣ) (L : Matrix (Fin n) (Fin n) ℂ) (k : ℕ) :
    (U.val * L * U⁻¹.val) ^ k = U.val * L ^ k * U⁻¹.val := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [pow_succ, ih, pow_succ]
      calc
        (U.val * L ^ k * U⁻¹.val) * (U.val * L * U⁻¹.val) =
            U.val * (L ^ k * (U⁻¹.val * U.val)) * L * U⁻¹.val := by
              simp only [mul_assoc]
        _ = U.val * (L ^ k * 1) * L * U⁻¹.val := by rw [Units.inv_mul]
        _ = U.val * L ^ (k + 1) * U⁻¹.val := by
          rw [pow_succ]
          simp only [mul_assoc]
          simp only [one_mul]

/-- Every cyclic trace-power is invariant under an actual invertible operator
conjugation. This is the finite-dimensional algebraic isospectral invariant;
it does not assume or construct a differentiable Lax trajectory. -/
theorem trace_conjugateByUnit_pow {n : ℕ}
    (U : (Matrix (Fin n) (Fin n) ℂ)ˣ) (L : Matrix (Fin n) (Fin n) ℂ) (k : ℕ) :
    Matrix.trace ((U.val * L * U⁻¹.val) ^ k) = Matrix.trace (L ^ k) := by
  rw [conjugateByUnit_pow]
  calc
    Matrix.trace (U.val * L ^ k * U⁻¹.val) =
        Matrix.trace (U⁻¹.val * (U.val * L ^ k)) := by
          rw [show U.val * L ^ k * U⁻¹.val = (U.val * L ^ k) * U⁻¹.val by simp [mul_assoc]]
          exact Matrix.trace_mul_comm _ _
    _ = Matrix.trace (L ^ k) := by simp

/-- The actual finite-matrix conjugation trajectory generated by `P`.  This
uses the repository's native matrix exponential flow on both sides of `L`;
the order is retained, so no commutation hypothesis on `P` and `L` is needed. -/
noncomputable def laxExponentialFlow {n : ℕ} (P L : Matrix (Fin n) (Fin n) ℂ) (t : ℂ) :
    Matrix (Fin n) (Fin n) ℂ :=
  InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P t * L *
    InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P (-t)

/-- The constructed exponential-conjugation curve solves the Lax equation
`L'(t) = P * L(t) - L(t) * P`. This is an actual derivative theorem for the
existing matrix-valued curve; it is independent of any spectral-gap claim. -/
theorem hasDerivAt_laxExponentialFlow {n : ℕ}
    (P L : Matrix (Fin n) (Fin n) ℂ) (t : ℂ) :
    HasDerivAt (fun z : ℂ => laxExponentialFlow P L z)
      (P * laxExponentialFlow P L t - laxExponentialFlow P L t * P) t := by
  let U := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P t
  let V := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P (-t)
  have hU : HasDerivAt
      (fun z : ℂ => InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P z)
      (P * U) t := by
    simpa [U, InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow] using
      InfoGeometry.Canonical.MatrixDetExpTraceJacobi.hasDerivAt_matrixExpFlow_left P t
  have hV : HasDerivAt
      (fun z : ℂ => InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P (-z))
      (-(V * P)) t := by
    convert InfoGeometry.Canonical.MatrixDetExpTraceJacobi.hasDerivAt_matrixExpFlow_right (-P) t
      using 1 <;>
      simp [U, V, InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow,
        smul_neg, neg_smul, neg_mul]
  have hUL := hU.mul_const L
  have hflow := hUL.mul hV
  have hderiv :
      (P * U * L) * V + (U * L) * (-(V * P)) =
        P * (U * L * V) - (U * L * V) * P := by
    noncomm_ring
  change HasDerivAt
    ((fun z : ℂ =>
      InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P z * L) *
      fun z : ℂ => InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P (-z))
    (P * (U * L * V) - (U * L * V) * P) t
  rw [← hderiv]
  exact hflow

/-- The time derivative of the Lax velocity is the iterated commutator
`[P, [P, L(t)]]`.  This is the second-order operator identity for this
constructed trajectory; it does not assert a positivity or spectral-gap
estimate. -/
theorem hasDerivAt_laxVelocity {n : ℕ}
    (P L : Matrix (Fin n) (Fin n) ℂ) (t : ℂ) :
    HasDerivAt
      (fun z : ℂ => P * laxExponentialFlow P L z -
        laxExponentialFlow P L z * P)
      (P * (P * laxExponentialFlow P L t -
          laxExponentialFlow P L t * P) -
        (P * laxExponentialFlow P L t -
          laxExponentialFlow P L t * P) * P) t := by
  have hflow := hasDerivAt_laxExponentialFlow P L t
  have hleft := hflow.const_mul P
  have hright := hflow.mul_const P
  change HasDerivAt
    ((fun z : ℂ => P * laxExponentialFlow P L z) -
      fun z : ℂ => laxExponentialFlow P L z * P)
    (P * (P * laxExponentialFlow P L t -
        laxExponentialFlow P L t * P) -
      (P * laxExponentialFlow P L t -
        laxExponentialFlow P L t * P) * P) t
  exact hleft.sub hright

/-- The second derivative of the constructed Lax trajectory is the double
commutator `[P, [P, L(t)]]`. -/
theorem hasDerivAt_deriv_laxExponentialFlow {n : ℕ}
    (P L : Matrix (Fin n) (Fin n) ℂ) (t : ℂ) :
    HasDerivAt (deriv (fun z : ℂ => laxExponentialFlow P L z))
      (P * (P * laxExponentialFlow P L t -
          laxExponentialFlow P L t * P) -
        (P * laxExponentialFlow P L t -
          laxExponentialFlow P L t * P) * P) t := by
  have hderiv :
      deriv (fun z : ℂ => laxExponentialFlow P L z) =
        fun z => P * laxExponentialFlow P L z -
          laxExponentialFlow P L z * P := by
    funext z
    exact (hasDerivAt_laxExponentialFlow P L z).deriv
  rw [hderiv]
  exact hasDerivAt_laxVelocity P L t

/-- Every trace power is constant along the explicit exponential conjugation
trajectory.  This is the isospectral invariant for the constructed curve, not
an assertion that an arbitrary differentiable curve satisfies a Lax equation. -/
theorem trace_laxExponentialFlow_pow {n : ℕ}
    (P L : Matrix (Fin n) (Fin n) ℂ) (t : ℂ) (k : ℕ) :
    Matrix.trace (laxExponentialFlow P L t ^ k) = Matrix.trace (L ^ k) := by
  let U := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P t
  let V := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P (-t)
  have hVU : V * U = 1 := by
    dsimp [U, V]
    exact InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow_neg_mul P t
  have hUV : U * V = 1 := by
    dsimp [U, V]
    exact InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow_mul_neg P t
  have hpow : laxExponentialFlow P L t ^ k = U * L ^ k * V := by
    induction k with
    | zero => simp [laxExponentialFlow, U, V, hUV]
    | succ k ih =>
        rw [pow_succ, ih]
        simp only [laxExponentialFlow, U, V]
        calc
          (U * L ^ k * V) * (U * L * V) = U * (L ^ k * (V * U)) * L * V := by
            simp only [mul_assoc]
          _ = U * L ^ (k + 1) * V := by rw [hVU, mul_one, pow_succ]; simp [mul_assoc]
  rw [hpow]
  calc
    Matrix.trace (U * L ^ k * V) = Matrix.trace (V * (U * L ^ k)) := by
      rw [show U * L ^ k * V = (U * L ^ k) * V by simp [mul_assoc]]
      exact Matrix.trace_mul_comm _ _
    _ = Matrix.trace ((V * U) * L ^ k) := by simp [mul_assoc]
    _ = Matrix.trace (L ^ k) := by rw [hVU]; simp

/-- The characteristic polynomial is preserved by the constructed Lax flow.
This gives the full finite-dimensional algebraic isospectral invariant, while
making no positivity or spectral-gap claim. -/
theorem charpoly_laxExponentialFlow_eq {n : ℕ}
    (P L : Matrix (Fin n) (Fin n) ℂ) (t : ℂ) :
    (laxExponentialFlow P L t).charpoly = L.charpoly := by
  let U := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P t
  let V := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P (-t)
  have hVU : V * U = 1 := by
    dsimp [U, V]
    exact InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow_neg_mul P t
  have hUV : U * V = 1 := by
    dsimp [U, V]
    exact InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow_mul_neg P t
  let u : (Matrix (Fin n) (Fin n) ℂ)ˣ := Units.mk U V hUV hVU
  have hinv : (u : Matrix (Fin n) (Fin n) ℂ)⁻¹ = V := by
    calc
      (u : Matrix (Fin n) (Fin n) ℂ)⁻¹ = (u⁻¹).val := by simp
      _ = V := rfl
  change (U * L * V).charpoly = L.charpoly
  rw [← hinv]
  exact Matrix.charpoly_units_conj u L

/-- The exponential Lax conjugation intertwines the initial and transported
operators on vectors. The transported vector is `U.mulVec v`, where `U` is
the actual left exponential in the flow; no normality or unitarity assumption
is needed for this algebraic identity. -/
theorem laxExponentialFlow_mulVec_intertwines {n : ℕ}
    (P L : Matrix (Fin n) (Fin n) ℂ) (t : ℂ) (v : Fin n → ℂ) :
    Matrix.mulVec (laxExponentialFlow P L t)
        (Matrix.mulVec
          (InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P t) v) =
      Matrix.mulVec
        (InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P t)
        (Matrix.mulVec L v) := by
  let U := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P t
  let V := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P (-t)
  have hVU : V * U = 1 := by
    dsimp [U, V]
    exact InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow_neg_mul P t
  change Matrix.mulVec (U * L * V) (Matrix.mulVec U v) =
    Matrix.mulVec U (Matrix.mulVec L v)
  calc
    Matrix.mulVec (U * L * V) (Matrix.mulVec U v) =
        Matrix.mulVec ((U * L * V) * U) v := by rw [Matrix.mulVec_mulVec]
    _ = Matrix.mulVec (U * L) v := by simp [mul_assoc, hVU]
    _ = Matrix.mulVec U (Matrix.mulVec L v) := by rw [Matrix.mulVec_mulVec]

/-- The explicit exponential Lax trajectory preserves the existence of a
nonzero kernel vector at every time. Thus isospectral transport preserves
zero modes as well as trace powers. -/
theorem laxExponentialFlow_zeroMode_iff {n : ℕ}
    (P L : Matrix (Fin n) (Fin n) ℂ) (t : ℂ) :
    (∃ v : Fin n → ℂ, v ≠ 0 ∧
      Matrix.mulVec (laxExponentialFlow P L t) v = 0) ↔
    ∃ v : Fin n → ℂ, v ≠ 0 ∧ Matrix.mulVec L v = 0 := by
  let U := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P t
  let V := InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow P (-t)
  have hVU : V * U = 1 := by
    dsimp [U, V]
    exact InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow_neg_mul P t
  have hUV : U * V = 1 := by
    dsimp [U, V]
    exact InfoGeometry.Canonical.MatrixDetExpTraceJacobi.matrixExpFlow_mul_neg P t
  constructor
  · rintro ⟨v, hv, hzero⟩
    refine ⟨V.mulVec v, ?_, ?_⟩
    · intro hV
      have hrecover : U.mulVec (V.mulVec v) = v := by
        calc
          U.mulVec (V.mulVec v) = (U * V).mulVec v := by
            rw [Matrix.mulVec_mulVec]
          _ = v := by rw [hUV]; simp
      rw [hV] at hrecover
      have hvzero : (0 : Fin n → ℂ) = v := by simpa using hrecover
      exact hv hvzero.symm
    · have hfact : U.mulVec (L.mulVec (V.mulVec v)) = 0 := by
        simpa [laxExponentialFlow, U, V, Matrix.mulVec_mulVec, mul_assoc] using hzero
      have hrecover :
          V.mulVec (U.mulVec (L.mulVec (V.mulVec v))) =
            L.mulVec (V.mulVec v) := by
        calc
          V.mulVec (U.mulVec (L.mulVec (V.mulVec v))) =
              (V * U).mulVec (L.mulVec (V.mulVec v)) := by
                rw [Matrix.mulVec_mulVec]
          _ = L.mulVec (V.mulVec v) := by rw [hVU]; simp
      rw [hfact] at hrecover
      simpa using hrecover.symm
  · rintro ⟨v, hv, hzero⟩
    refine ⟨U.mulVec v, ?_, ?_⟩
    · intro hU
      have hrecover : V.mulVec (U.mulVec v) = v := by
        calc
          V.mulVec (U.mulVec v) = (V * U).mulVec v := by
            rw [Matrix.mulVec_mulVec]
          _ = v := by rw [hVU]; simp
      rw [hU] at hrecover
      have hvzero : (0 : Fin n → ℂ) = v := by simpa using hrecover
      exact hv hvzero.symm
    · simpa [U] using
        (laxExponentialFlow_mulVec_intertwines P L t v).trans
          (congrArg (fun z : Fin n → ℂ => U.mulVec z) hzero)

/-- The determinant criterion applies uniformly along the constructed Lax
trajectory. This connects the finite kernel criterion to the time-invariant
zero-mode statement, without upgrading it to a positive spectral gap. -/
theorem laxExponentialFlow_zeroMode_iff_det_zero {n : ℕ}
    (P L : Matrix (Fin n) (Fin n) ℂ) (t : ℂ) :
    (∃ v : Fin n → ℂ, v ≠ 0 ∧
      Matrix.mulVec (laxExponentialFlow P L t) v = 0) ↔
      Matrix.det L = 0 := by
  rw [laxExponentialFlow_zeroMode_iff, zeroMode_iff_det_zero]

/-- Similarity preserves the existence of a nonzero kernel vector.  This is
the precise zero-mode consequence of finite-dimensional isospectral
conjugation; it does not assert a positive spectral gap. -/
theorem zeroMode_conjugation_iff {n : ℕ}
    (U : (Matrix (Fin n) (Fin n) ℂ)ˣ) (L : Matrix (Fin n) (Fin n) ℂ) :
    (∃ v : (Fin n → ℂ), v ≠ 0 ∧ Matrix.mulVec (U.val * L * U⁻¹.val) v = 0) ↔
      ∃ v : (Fin n → ℂ), v ≠ 0 ∧ Matrix.mulVec L v = 0 := by
  rw [← zeroMode_iff_det_zero (U.val * L * U⁻¹.val),
    ← zeroMode_iff_det_zero L, det_conjugateByUnit_eq]

end InfoGeometry.NCG.LaxPairIsospectralMassGap
