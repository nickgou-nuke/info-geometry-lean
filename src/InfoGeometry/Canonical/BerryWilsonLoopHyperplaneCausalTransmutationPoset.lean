namespace InfoGeometry.Canonical.BerryWilsonLoopHyperplaneCausalTransmutationPoset

open InfoGeometry.OperatorAlgebra.OntologyRing
open InfoGeometry.Meta
open InfoGeometry.OperatorAlgebra.PeirceSpine

/-! ===========================================================================
    Section 1: The 7-Stage Berry Wilson Loop & Hyperplane Causal Transmutation
    Poset (`𝔚₁ ≺ 𝔚₂ ≺ ⋯ ≺ 𝔚₇`)
    =========================================================================== -/

/-- **The 7-Stage Berry Wilson Loop & Hyperplane Causal Transmutation Poset
(`BerryWilsonLoopCausalStage`)**:
Encodes the strict 7-stage progression `𝔚₁ ≺ 𝔚₂ ≺ 𝔚₃ ≺ 𝔚₄ ≺ 𝔚₅ ≺ 𝔚₆ ≺ 𝔚₇`. -/
inductive BerryWilsonLoopCausalStage : Type
  | W1_CausalHyperplaneAndOrthogonalOppositeSquares
  | W2_BerryCurvatureHyperplaneBivectorGenerator
  | W3_DirectBerryBivectorSignatureTransmutation
  | W4_InfinitesimalHolonomyCommutatorAndFluxHorizon
  | W5_UniversalPolynomialWilsonLoopHolonomy
  | W6_LightConeNilpotentHorizonAtCriticalFlux
  | W7_TrigonometricBerryRotorAndExactWickTransmutation
  deriving DecidableEq, Repr, Inhabited

namespace BerryWilsonLoopCausalStage

/-- Integer rank `0..6` of the 7 causal transmutation stages. -/
def stageIndex : BerryWilsonLoopCausalStage → ℕ
  | .W1_CausalHyperplaneAndOrthogonalOppositeSquares => 0
  | .W2_BerryCurvatureHyperplaneBivectorGenerator => 1
  | .W3_DirectBerryBivectorSignatureTransmutation => 2
  | .W4_InfinitesimalHolonomyCommutatorAndFluxHorizon => 3
  | .W5_UniversalPolynomialWilsonLoopHolonomy => 4
  | .W6_LightConeNilpotentHorizonAtCriticalFlux => 5
  | .W7_TrigonometricBerryRotorAndExactWickTransmutation => 6

/-- The integer rank map `stageIndex` is injective on `BerryWilsonLoopCausalStage`. -/
theorem stageIndex_injective : Function.Injective stageIndex := by
  intro a b h
  cases a <;> cases b <;> first | rfl | cases h

instance instLinearOrder : LinearOrder BerryWilsonLoopCausalStage :=
  LinearOrder.lift' stageIndex stageIndex_injective

instance instFintype : Fintype BerryWilsonLoopCausalStage where
  elems := {
    .W1_CausalHyperplaneAndOrthogonalOppositeSquares,
    .W2_BerryCurvatureHyperplaneBivectorGenerator,
    .W3_DirectBerryBivectorSignatureTransmutation,
    .W4_InfinitesimalHolonomyCommutatorAndFluxHorizon,
    .W5_UniversalPolynomialWilsonLoopHolonomy,
    .W6_LightConeNilpotentHorizonAtCriticalFlux,
    .W7_TrigonometricBerryRotorAndExactWickTransmutation
  }
  complete x := by cases x <;> simp

/-- Directed causal edges of the diamond-and-chain poset
`𝔚₁ → 𝔚₂ → (𝔚₃, 𝔚₄) → 𝔚₅ → 𝔚₆ → 𝔚₇`. -/
def causalEdge : BerryWilsonLoopCausalStage → BerryWilsonLoopCausalStage → Prop
  | .W1_CausalHyperplaneAndOrthogonalOppositeSquares,
    .W2_BerryCurvatureHyperplaneBivectorGenerator => True
  | .W2_BerryCurvatureHyperplaneBivectorGenerator,
    .W3_DirectBerryBivectorSignatureTransmutation => True
  | .W2_BerryCurvatureHyperplaneBivectorGenerator,
    .W4_InfinitesimalHolonomyCommutatorAndFluxHorizon => True
  | .W3_DirectBerryBivectorSignatureTransmutation,
    .W4_InfinitesimalHolonomyCommutatorAndFluxHorizon => True
  | .W3_DirectBerryBivectorSignatureTransmutation,
    .W5_UniversalPolynomialWilsonLoopHolonomy => True
  | .W4_InfinitesimalHolonomyCommutatorAndFluxHorizon,
    .W5_UniversalPolynomialWilsonLoopHolonomy => True
  | .W5_UniversalPolynomialWilsonLoopHolonomy,
    .W6_LightConeNilpotentHorizonAtCriticalFlux => True
  | .W6_LightConeNilpotentHorizonAtCriticalFlux,
    .W7_TrigonometricBerryRotorAndExactWickTransmutation => True
  | _, _ => False

instance instDecidableRelCausalEdge : DecidableRel causalEdge := by
  intro a b
  cases a <;> cases b <;> unfold causalEdge <;> infer_instance

/-- Every directed causal edge strictly increases the stage order. -/
theorem causalEdge_lt {s t : BerryWilsonLoopCausalStage} (h : causalEdge s t) : s < t := by
  change stageIndex s < stageIndex t
  cases s <;> cases t <;> revert h <;> decide

/-- The transitive closure of `causalEdge` strictly increases the stage order. -/
theorem transGen_causalEdge_lt {s t : BerryWilsonLoopCausalStage}
    (h : Relation.TransGen causalEdge s t) : s < t := by
  induction h with
  | single h1 => exact causalEdge_lt h1
  | tail _ h2 ih => exact lt_trans ih (causalEdge_lt h2)

/-- The causal edge relation on `BerryWilsonLoopCausalStage` is acyclic. -/
theorem causalEdge_acyclic (s : BerryWilsonLoopCausalStage) :
    ¬ Relation.TransGen causalEdge s s := by
  intro h
  exact lt_irrefl s (transGen_causalEdge_lt h)

/-- Strict 7-stage chain `𝔚₁ < 𝔚₂ < 𝔚₃ < 𝔚₄ < 𝔚₅ < 𝔚₆ < 𝔚₇`. -/
theorem strict_seven_stage_chain :
    BerryWilsonLoopCausalStage.W1_CausalHyperplaneAndOrthogonalOppositeSquares <
      .W2_BerryCurvatureHyperplaneBivectorGenerator ∧
    BerryWilsonLoopCausalStage.W2_BerryCurvatureHyperplaneBivectorGenerator <
      .W3_DirectBerryBivectorSignatureTransmutation ∧
    BerryWilsonLoopCausalStage.W3_DirectBerryBivectorSignatureTransmutation <
      .W4_InfinitesimalHolonomyCommutatorAndFluxHorizon ∧
    BerryWilsonLoopCausalStage.W4_InfinitesimalHolonomyCommutatorAndFluxHorizon <
      .W5_UniversalPolynomialWilsonLoopHolonomy ∧
    BerryWilsonLoopCausalStage.W5_UniversalPolynomialWilsonLoopHolonomy <
      .W6_LightConeNilpotentHorizonAtCriticalFlux ∧
    BerryWilsonLoopCausalStage.W6_LightConeNilpotentHorizonAtCriticalFlux <
      .W7_TrigonometricBerryRotorAndExactWickTransmutation := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

/-- Representation-depth projection `toRepDepth : BerryWilsonLoopCausalStage → RepDepth`. -/
def toRepDepth : BerryWilsonLoopCausalStage → RepDepth
  | .W1_CausalHyperplaneAndOrthogonalOppositeSquares => .projective
  | .W2_BerryCurvatureHyperplaneBivectorGenerator => .operator
  | .W3_DirectBerryBivectorSignatureTransmutation => .operator
  | .W4_InfinitesimalHolonomyCommutatorAndFluxHorizon => .krein
  | .W5_UniversalPolynomialWilsonLoopHolonomy => .transport
  | .W6_LightConeNilpotentHorizonAtCriticalFlux => .transport
  | .W7_TrigonometricBerryRotorAndExactWickTransmutation => .thermo

/-- The representation-depth projection `toRepDepth` is monotone with respect to stage order. -/
theorem toRepDepth_rank_monotone {a b : BerryWilsonLoopCausalStage} (h : a ≤ b) :
    (toRepDepth a).toNat ≤ (toRepDepth b).toNat := by
  change stageIndex a ≤ stageIndex b at h
  cases a <;> cases b <;> simp [toRepDepth, RepDepth.toNat, stageIndex] at h ⊢

/-- Meta-level projection `toOntologyMetaLevel : BerryWilsonLoopCausalStage → OntologyMetaLevel`. -/
def toOntologyMetaLevel : BerryWilsonLoopCausalStage → OntologyMetaLevel
  | .W1_CausalHyperplaneAndOrthogonalOppositeSquares => .M1_ProjectorClabject
  | .W2_BerryCurvatureHyperplaneBivectorGenerator => .M1_ProjectorClabject
  | .W3_DirectBerryBivectorSignatureTransmutation => .M2_GrassmannianPowertypeOrbit
  | .W4_InfinitesimalHolonomyCommutatorAndFluxHorizon => .M2_GrassmannianPowertypeOrbit
  | .W5_UniversalPolynomialWilsonLoopHolonomy => .M2_GrassmannianPowertypeOrbit
  | .W6_LightConeNilpotentHorizonAtCriticalFlux => .M3_ErlangenCasimirMetaLaw
  | .W7_TrigonometricBerryRotorAndExactWickTransmutation => .M3_ErlangenCasimirMetaLaw

/-- The ontology meta-level projection `toOntologyMetaLevel` is monotone with respect to stage order. -/
theorem toOntologyMetaLevel_rank_monotone {a b : BerryWilsonLoopCausalStage} (h : a ≤ b) :
    (toOntologyMetaLevel a).rank ≤ (toOntologyMetaLevel b).rank := by
  change stageIndex a ≤ stageIndex b at h
  cases a <;> cases b <;> simp [toOntologyMetaLevel, OntologyMetaLevel.rank, stageIndex] at h ⊢

end BerryWilsonLoopCausalStage

/-! ===========================================================================
    Section 2: Stages `𝔚₁` & `𝔚₂` — The Causal `(J, Φ)` Hyperplane,
    Opposite Squares, Hyperplane Pythagorean Cancellation, and the Berry
    Curvature Bivector `Σ = J Φ`
    =========================================================================== -/

section AlgebraicSpine

variable {R : Type*} [CommRing R]
variable {B : Type*} [Ring B] [Algebra R B]
variable {P : B} (hP : P * P = P)
include hP

/-- **Stage `𝔚₁` Theorem (`stage_W1_causal_hyperplane_opposite_squares_and_orthogonality`)**:
In any associative `R`-algebra `B` with idempotent `P² = P`:
1. The light-cone Peirce corners are square-zero (`N₊² = 0`, `N₋² = 0`),
2. The timelike current `J = N₊ - N₋` and spacelike bridge `Φ = N₊ + N₋` have opposite
   squares `J² = -V` and `Φ² = +V` (`J² + Φ² = 0`),
3. `J` and `Φ` strictly anticommute (`{J, Φ} = J Φ + Φ J = 0` and `{Φ, J} = 0`),
4. The light-cone nilpotents reconstruct from `Φ ± J`:
   `Φ + J = 2 • N₊` and `Φ - J = 2 • N₋`,
5. **Hyperplane Pythagorean Difference-of-Squares Law**: for any scalars `c, s : R`,
   `(c • J + s • Φ)² = (s² - c²) • V` and `(c • Φ + s • J)² = (c² - s²) • V`. -/
theorem stage_W1_causal_hyperplane_opposite_squares_and_orthogonality
    (A C : B) (c s : R) :
    (conePlus P A * conePlus P A = 0 ∧
     coneMinus P C * coneMinus P C = 0) ∧
    (genJ P A C * genJ P A C = -genV P A C ∧
     genPhi P A C * genPhi P A C = genV P A C ∧
     genJ P A C * genJ P A C + genPhi P A C * genPhi P A C = 0) ∧
    (anticomm (genJ P A C) (genPhi P A C) = 0 ∧
     anticomm (genPhi P A C) (genJ P A C) = 0) ∧
    (genPhi P A C + genJ P A C = (2 : ℤ) • conePlus P A ∧
     genPhi P A C - genJ P A C = (2 : ℤ) • coneMinus P C) ∧
    ((c • genJ P A C + s • genPhi P A C) * (c • genJ P A C + s • genPhi P A C) =
       (s ^ 2 - c ^ 2) • genV P A C ∧
     (c • genPhi P A C + s • genJ P A C) * (c • genPhi P A C + s • genJ P A C) =
       (c ^ 2 - s ^ 2) • genV P A C) := by
  have hA3 := archetype_A3_nilpotent_cones_and_tetraktys_table hP A C
  have hJ2 : genJ P A C * genJ P A C = -genV P A C := hA3.2.2.2.1
  have hPhi2 : genPhi P A C * genPhi P A C = genV P A C := hA3.2.2.1
  have hAntiJPhi : genJ P A C * genPhi P A C + genPhi P A C * genJ P A C = 0 := by
    peirce_nf hP
  have hAntiPhiJ : genPhi P A C * genJ P A C + genJ P A C * genPhi P A C = 0 := by
    peirce_nf hP
  have hPythJ :
      (c • genJ P A C + s • genPhi P A C) * (c • genJ P A C + s • genPhi P A C) =
        (s ^ 2 - c ^ 2) • genV P A C := by
    calc
      (c • genJ P A C + s • genPhi P A C) * (c • genJ P A C + s • genPhi P A C)
        = (c * c) • (genJ P A C * genJ P A C) +
          (c * s) • (genJ P A C * genPhi P A C + genPhi P A C * genJ P A C) +
          (s * s) • (genPhi P A C * genPhi P A C) := by
          simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
            smul_add, smul_smul, mul_comm s c]
          abel
      _ = (c * c) • (-genV P A C) + (c * s) • (0 : B) + (s * s) • genV P A C := by
          rw [hJ2, hAntiJPhi, hPhi2]
      _ = (s ^ 2 - c ^ 2) • genV P A C := by
          rw [smul_neg, smul_zero, add_zero, sub_smul, sq, sq]
          abel
  have hPythPhi :
      (c • genPhi P A C + s • genJ P A C) * (c • genPhi P A C + s • genJ P A C) =
        (c ^ 2 - s ^ 2) • genV P A C := by
    calc
      (c • genPhi P A C + s • genJ P A C) * (c • genPhi P A C + s • genJ P A C)
        = (c * c) • (genPhi P A C * genPhi P A C) +
          (c * s) • (genPhi P A C * genJ P A C + genJ P A C * genPhi P A C) +
          (s * s) • (genJ P A C * genJ P A C) := by
          simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
            smul_add, smul_smul, mul_comm s c]
          abel
      _ = (c * c) • genV P A C + (c * s) • (0 : B) + (s * s) • (-genV P A C) := by
          rw [hPhi2, hAntiPhiJ, hJ2]
      _ = (c ^ 2 - s ^ 2) • genV P A C := by
          rw [smul_neg, smul_zero, add_zero, sub_smul, sq, sq]
          abel
  refine ⟨⟨hA3.1, hA3.2.1⟩,
          ⟨hJ2, hPhi2, by peirce_nf hP⟩,
          ⟨by peirce_nf hP, hA3.2.2.2.2.2.2.2.1⟩,
          ⟨by peirce_nf hP, by peirce_nf hP⟩,
          ⟨hPythJ, hPythPhi⟩⟩

/-- **Stage `𝔚₂` Theorem (`stage_W2_berry_curvature_hyperplane_bivector_generator`)**:
The Berry curvature `Σ = [N₊, N₋] = genSig P A C` is the bivector generator of the `(J, Φ)`
hyperplane:
1. `J * Φ = Σ`, `Φ * J = -Σ`, and `[J, Φ] = 2 • Σ`,
2. `Σ = S_P * V = V * S_P`, `V = S_P * Σ = Σ * S_P`, and `Σ² = V²`,
3. `Σ` and `S_P` strictly anticommute with both `J` and `Φ`:
   `{Σ, J} = 0`, `{Σ, Φ} = 0`, `{S_P, J} = 0`, `{S_P, Φ} = 0`,
4. The metric modulus `V` commutes with `J`, `Φ`, and `Σ`:
   `[V, J] = 0`, `[V, Φ] = 0`, `[V, Σ] = 0`,
5. The 4-factor Peirce Wilson plaquette `wilsonPlaquette P A C` expands with leading
   curvature `1 + Σ - V * J + Q_+²` (`wilsonPlaquette_ordered_expansions`). -/
theorem stage_W2_berry_curvature_hyperplane_bivector_generator (A C : B) :
    (genJ P A C * genPhi P A C = genSig P A C ∧
     genPhi P A C * genJ P A C = -genSig P A C ∧
     comm (genJ P A C) (genPhi P A C) = (2 : ℤ) • genSig P A C) ∧
    (genSig P A C = invS P * genV P A C ∧
     genSig P A C = genV P A C * invS P ∧
     genV P A C = invS P * genSig P A C ∧
     genSig P A C * genSig P A C = genV P A C * genV P A C) ∧
    (anticomm (genSig P A C) (genJ P A C) = 0 ∧
     anticomm (genSig P A C) (genPhi P A C) = 0 ∧
     anticomm (invS P) (genJ P A C) = 0 ∧
     anticomm (invS P) (genPhi P A C) = 0) ∧
    (comm (genV P A C) (genJ P A C) = 0 ∧
     comm (genV P A C) (genPhi P A C) = 0 ∧
     comm (genV P A C) (genSig P A C) = 0) ∧
    (wilsonPlaquette P A C =
       1 + genSig P A C - genV P A C * genJ P A C + qgtPlus P A C * qgtPlus P A C ∧
     wilsonPlaquetteRev P A C =
       1 - genSig P A C + genV P A C * genJ P A C + qgtMinus P A C * qgtMinus P A C) := by
  refine ⟨⟨?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩,
          wilsonPlaquette_ordered_expansions hP A C⟩ <;> peirce_nf hP

/-! ===========================================================================
    Section 3: Stages `𝔚₃` & `𝔚₄` — Direct Berry Bivector Transmutation
    (`Σ J = V Φ`, `(Σ J)² = +V³`) and Infinitesimal Holonomy Commutator
    (`[Σ, J] = 2 V Φ`, `(J + t V Φ)² = V(t² V² - 1)`)
    =========================================================================== -/

/-- **Stage `𝔚₃` Theorem (`stage_W3_direct_berry_bivector_signature_transmutation`)**:
Direct action of the Berry curvature bivector `Σ = J Φ` on the causal hyperplane:
1. `Σ * J = V * Φ` and `J * Σ = -(V * Φ)`,
2. `Σ * Φ = V * J` and `Φ * Σ = -(V * J)`,
3. **Causal Signature Inversion**:
   * Although `J` is timelike (`J² = -V`), its Berry-rotated image `Σ * J` has positive
     spacelike square `(Σ * J)² = +V³`,
   * Although `Φ` is spacelike (`Φ² = +V`), its Berry-rotated image `Σ * Φ` has negative
     timelike square `(Σ * Φ)² = -V³`,
   * `(Σ * J)² + (Σ * Φ)² = 0`,
4. Hodge grading `⋆ X = invS P * X` swaps `J ↔ Φ` and `V ↔ Σ` with `(⋆ J)² = +V`
   and `(⋆ Φ)² = -V`. -/
theorem stage_W3_direct_berry_bivector_signature_transmutation (A C : B) :
    (genSig P A C * genJ P A C = genV P A C * genPhi P A C ∧
     genJ P A C * genSig P A C = -(genV P A C * genPhi P A C) ∧
     genSig P A C * genPhi P A C = genV P A C * genJ P A C ∧
     genPhi P A C * genSig P A C = -(genV P A C * genJ P A C)) ∧
    ((genSig P A C * genJ P A C) * (genSig P A C * genJ P A C) =
       genV P A C * genV P A C * genV P A C ∧
     (genSig P A C * genPhi P A C) * (genSig P A C * genPhi P A C) =
       -(genV P A C * genV P A C * genV P A C) ∧
     (genSig P A C * genJ P A C) * (genSig P A C * genJ P A C) +
       (genSig P A C * genPhi P A C) * (genSig P A C * genPhi P A C) = 0) ∧
    (hodgeStar P (genJ P A C) = genPhi P A C ∧
     hodgeStar P (genPhi P A C) = genJ P A C ∧
     hodgeStar P (genJ P A C) * hodgeStar P (genJ P A C) = genV P A C ∧
     hodgeStar P (genPhi P A C) * hodgeStar P (genPhi P A C) = -genV P A C) := by
  refine ⟨⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_⟩⟩ <;>
    ((try simp only [hodgeStar]); peirce_nf hP)

/-- Infinitesimal Berry-holonomy parallel-transported current
`J(t) = J + t • (V * Φ) = J + t • (Σ * J)`. -/
def infinitesimalHolonomyJ (P A C : B) (t : R) : B :=
  genJ P A C + t • (genV P A C * genPhi P A C)

/-- Infinitesimal Berry-holonomy parallel-transported bridge
`Φ(t) = Φ + t • (V * J) = Φ + t • (Σ * Φ)`. -/
def infinitesimalHolonomyPhi (P A C : B) (t : R) : B :=
  genPhi P A C + t • (genV P A C * genJ P A C)

/-- **Stage `𝔚₄` Theorem (`stage_W4_infinitesimal_berry_holonomy_and_flux_horizon`)**:
Infinitesimal Berry Wilson loop transport via the holonomy commutator `[Σ, J] = 2 V Φ`:
1. `[Σ, J] = 2 • (V * Φ)` and `[Σ, Φ] = 2 • (V * J)`,
2. `2 • infinitesimalHolonomyJ P A C t = 2 • J + t • [Σ, J]`,
3. **Exact Quadratic Flux Horizon Law**:
   `infinitesimalHolonomyJ P A C t * infinitesimalHolonomyJ P A C t = -V + t² • V³ = V * (t² • V² - 1)`,
4. Dual bridge square:
   `infinitesimalHolonomyPhi P A C t * infinitesimalHolonomyPhi P A C t = V - t² • V³ = V * (1 - t² • V²)`,
5. At `t = 0`, `infinitesimalHolonomyJ P A C 0 = J` with square `-V`, and at `t = 1` on the
   unit-mass shell `V² = V`, `(J + V * Φ)² = 0` (the light-cone horizon!). -/
theorem stage_W4_infinitesimal_berry_holonomy_and_flux_horizon
    (A C : B) (t : R) :
    (comm (genSig P A C) (genJ P A C) = (2 : ℤ) • (genV P A C * genPhi P A C) ∧
     comm (genSig P A C) (genPhi P A C) = (2 : ℤ) • (genV P A C * genJ P A C)) ∧
    ((2 : ℤ) • infinitesimalHolonomyJ P A C t =
       (2 : ℤ) • genJ P A C + t • comm (genSig P A C) (genJ P A C)) ∧
    (infinitesimalHolonomyJ P A C t * infinitesimalHolonomyJ P A C t =
       -genV P A C + (t ^ 2) • (genV P A C * genV P A C * genV P A C) ∧
     infinitesimalHolonomyJ P A C t * infinitesimalHolonomyJ P A C t =
       genV P A C * ((t ^ 2) • (genV P A C * genV P A C) - 1)) ∧
    (infinitesimalHolonomyPhi P A C t * infinitesimalHolonomyPhi P A C t =
       genV P A C - (t ^ 2) • (genV P A C * genV P A C * genV P A C)) ∧
    (infinitesimalHolonomyJ P A C (0 : R) * infinitesimalHolonomyJ P A C (0 : R) =
       -genV P A C) := by
  have hCommJ : comm (genSig P A C) (genJ P A C) = (2 : ℤ) • (genV P A C * genPhi P A C) := by
    peirce_nf hP
  have hCommPhi : comm (genSig P A C) (genPhi P A C) = (2 : ℤ) • (genV P A C * genJ P A C) := by
    peirce_nf hP
  have hTwoJ :
      (2 : ℤ) • infinitesimalHolonomyJ P A C t =
        (2 : ℤ) • genJ P A C + t • comm (genSig P A C) (genJ P A C) := by
    unfold infinitesimalHolonomyJ
    rw [hCommJ, smul_add, smul_comm]
  have hJ2 : genJ P A C * genJ P A C = -genV P A C := by peirce_nf hP
  have hPhi2 : genPhi P A C * genPhi P A C = genV P A C := by peirce_nf hP
  have hCrossJ :
      genJ P A C * (genV P A C * genPhi P A C) +
        (genV P A C * genPhi P A C) * genJ P A C = 0 := by
    peirce_nf hP
  have hCrossPhi :
      genPhi P A C * (genV P A C * genJ P A C) +
        (genV P A C * genJ P A C) * genPhi P A C = 0 := by
    peirce_nf hP
  have hVPhiSq :
      (genV P A C * genPhi P A C) * (genV P A C * genPhi P A C) =
        genV P A C * genV P A C * genV P A C := by
    peirce_nf hP
  have hVJSq :
      (genV P A C * genJ P A C) * (genV P A C * genJ P A C) =
        -(genV P A C * genV P A C * genV P A C) := by
    peirce_nf hP
  have hSqJ :
      infinitesimalHolonomyJ P A C t * infinitesimalHolonomyJ P A C t =
        -genV P A C + (t ^ 2) • (genV P A C * genV P A C * genV P A C) := by
    unfold infinitesimalHolonomyJ
    calc
      (genJ P A C + t • (genV P A C * genPhi P A C)) *
          (genJ P A C + t • (genV P A C * genPhi P A C))
        = genJ P A C * genJ P A C +
          t • (genJ P A C * (genV P A C * genPhi P A C) +
            (genV P A C * genPhi P A C) * genJ P A C) +
          (t * t) • ((genV P A C * genPhi P A C) * (genV P A C * genPhi P A C)) := by
          simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, smul_add, smul_smul]
          abel
      _ = -genV P A C + t • (0 : B) +
          (t ^ 2) • (genV P A C * genV P A C * genV P A C) := by
          rw [hJ2, hCrossJ, hVPhiSq, sq]
      _ = -genV P A C + (t ^ 2) • (genV P A C * genV P A C * genV P A C) := by
          rw [smul_zero, add_zero]
  have hSqJFact :
      infinitesimalHolonomyJ P A C t * infinitesimalHolonomyJ P A C t =
        genV P A C * ((t ^ 2) • (genV P A C * genV P A C) - 1) := by
    rw [hSqJ, mul_sub, mul_smul_comm, mul_one, ← mul_assoc]
    abel
  have hSqPhi :
      infinitesimalHolonomyPhi P A C t * infinitesimalHolonomyPhi P A C t =
        genV P A C - (t ^ 2) • (genV P A C * genV P A C * genV P A C) := by
    unfold infinitesimalHolonomyPhi
    calc
      (genPhi P A C + t • (genV P A C * genJ P A C)) *
          (genPhi P A C + t • (genV P A C * genJ P A C))
        = genPhi P A C * genPhi P A C +
          t • (genPhi P A C * (genV P A C * genJ P A C) +
            (genV P A C * genJ P A C) * genPhi P A C) +
          (t * t) • ((genV P A C * genJ P A C) * (genV P A C * genJ P A C)) := by
          simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, smul_add, smul_smul]
          abel
      _ = genV P A C + t • (0 : B) +
          (t ^ 2) • (-(genV P A C * genV P A C * genV P A C)) := by
          rw [hPhi2, hCrossPhi, hVJSq, sq]
      _ = genV P A C - (t ^ 2) • (genV P A C * genV P A C * genV P A C) := by
          rw [smul_zero, add_zero, smul_neg, sub_eq_add_neg]
  have hSqJ0 :
      infinitesimalHolonomyJ P A C (0 : R) * infinitesimalHolonomyJ P A C (0 : R) =
        -genV P A C := by
    unfold infinitesimalHolonomyJ
    simp only [zero_smul, add_zero]
    exact hJ2
  exact ⟨⟨hCommJ, hCommPhi⟩, hTwoJ, ⟨hSqJ, hSqJFact⟩, hSqPhi, hSqJ0⟩

/-! ===========================================================================
    Section 4: Stages `𝔚₅` & `𝔚₆` — Universal Polynomial Wilson Loop Holonomy
    `W(c, s) = c • V + s • Σ` and the Light-Cone Nilpotent Horizon (`s = ±c`)
    =========================================================================== -/

/-- The universal even polynomial Wilson loop holonomy operator
`W(c, s) = c • V + s • Σ` in the Peirce even subalgebra `𝔨`. -/
def wilsonLoopEven (P A C : B) (c s : R) : B :=
  c • genV P A C + s • genSig P A C

/-- **Stage `𝔚₅` Theorem (`stage_W5_universal_polynomial_wilson_loop_transmutation`)**:
For any scalars `c, s : R` in an `R`-algebra `B`:
1. `wilsonLoopEven P A C c s` lies strictly in the even Peirce subalgebra
   (`evenGrade P W = W` and `oddGrade P W = 0`),
2. Acting on `J` rotates `J` into the `(J, Φ)` hyperplane:
   `W(c, s) * J = V * (c • J + s • Φ)`,
3. Acting on `Φ` rotates `Φ` into the `(Φ, J)` hyperplane:
   `W(c, s) * Φ = V * (c • Φ + s • J)`,
4. **Universal Polynomial Causal Transmutation Law**:
   `(W(c, s) * J)² = (s² - c²) • V³` and `(W(c, s) * Φ)² = (c² - s²) • V³`,
5. Mirror sum cancellation: `(W(c, s) * J)² + (W(c, s) * Φ)² = 0`. -/
theorem stage_W5_universal_polynomial_wilson_loop_transmutation
    (A C : B) (c s : R) :
    (evenGrade P (wilsonLoopEven P A C c s) = wilsonLoopEven P A C c s ∧
     oddGrade P (wilsonLoopEven P A C c s) = 0) ∧
    (wilsonLoopEven P A C c s * genJ P A C =
       genV P A C * (c • genJ P A C + s • genPhi P A C) ∧
     wilsonLoopEven P A C c s * genPhi P A C =
       genV P A C * (c • genPhi P A C + s • genJ P A C)) ∧
    ((wilsonLoopEven P A C c s * genJ P A C) *
       (wilsonLoopEven P A C c s * genJ P A C) =
       (s ^ 2 - c ^ 2) • (genV P A C * genV P A C * genV P A C) ∧
     (wilsonLoopEven P A C c s * genPhi P A C) *
       (wilsonLoopEven P A C c s * genPhi P A C) =
       (c ^ 2 - s ^ 2) • (genV P A C * genV P A C * genV P A C) ∧
     (wilsonLoopEven P A C c s * genJ P A C) *
       (wilsonLoopEven P A C c s * genJ P A C) +
     (wilsonLoopEven P A C c s * genPhi P A C) *
       (wilsonLoopEven P A C c s * genPhi P A C) = 0) := by
  have hEvenW : evenGrade P (wilsonLoopEven P A C c s) = wilsonLoopEven P A C c s := by
    unfold wilsonLoopEven
    peirce_nf hP
  have hOddW : oddGrade P (wilsonLoopEven P A C c s) = 0 := by
    unfold wilsonLoopEven
    peirce_nf hP
  have hSigJ : genSig P A C * genJ P A C = genV P A C * genPhi P A C := by peirce_nf hP
  have hSigPhi : genSig P A C * genPhi P A C = genV P A C * genJ P A C := by peirce_nf hP
  have hWJ :
      wilsonLoopEven P A C c s * genJ P A C =
        genV P A C * (c • genJ P A C + s • genPhi P A C) := by
    unfold wilsonLoopEven
    rw [add_mul, smul_mul_assoc, smul_mul_assoc, hSigJ,
        mul_add, mul_smul_comm, mul_smul_comm]
  have hWPhi :
      wilsonLoopEven P A C c s * genPhi P A C =
        genV P A C * (c • genPhi P A C + s • genJ P A C) := by
    unfold wilsonLoopEven
    rw [add_mul, smul_mul_assoc, smul_mul_assoc, hSigPhi,
        mul_add, mul_smul_comm, mul_smul_comm]
  have hVJ2 :
      (genV P A C * genJ P A C) * (genV P A C * genJ P A C) =
        -(genV P A C * genV P A C * genV P A C) := by peirce_nf hP
  have hVPhi2 :
      (genV P A C * genPhi P A C) * (genV P A C * genPhi P A C) =
        genV P A C * genV P A C * genV P A C := by peirce_nf hP
  have hVJPhiAnti :
      (genV P A C * genJ P A C) * (genV P A C * genPhi P A C) +
        (genV P A C * genPhi P A C) * (genV P A C * genJ P A C) = 0 := by peirce_nf hP
  have hVPhiJAnti :
      (genV P A C * genPhi P A C) * (genV P A C * genJ P A C) +
        (genV P A C * genJ P A C) * (genV P A C * genPhi P A C) = 0 := by peirce_nf hP
  have hWJSq :
      (wilsonLoopEven P A C c s * genJ P A C) *
        (wilsonLoopEven P A C c s * genJ P A C) =
        (s ^ 2 - c ^ 2) • (genV P A C * genV P A C * genV P A C) := by
    have hExpand :
        wilsonLoopEven P A C c s * genJ P A C =
          c • (genV P A C * genJ P A C) + s • (genV P A C * genPhi P A C) := by
      unfold wilsonLoopEven
      rw [add_mul, smul_mul_assoc, smul_mul_assoc, hSigJ]
    rw [hExpand]
    calc
      (c • (genV P A C * genJ P A C) + s • (genV P A C * genPhi P A C)) *
          (c • (genV P A C * genJ P A C) + s • (genV P A C * genPhi P A C))
        = (c * c) • ((genV P A C * genJ P A C) * (genV P A C * genJ P A C)) +
          (c * s) • ((genV P A C * genJ P A C) * (genV P A C * genPhi P A C) +
            (genV P A C * genPhi P A C) * (genV P A C * genJ P A C)) +
          (s * s) • ((genV P A C * genPhi P A C) * (genV P A C * genPhi P A C)) := by
          simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
            smul_add, smul_smul, mul_comm s c]
          abel
      _ = (c * c) • (-(genV P A C * genV P A C * genV P A C)) +
          (c * s) • (0 : B) +
          (s * s) • (genV P A C * genV P A C * genV P A C) := by
          rw [hVJ2, hVJPhiAnti, hVPhi2]
      _ = (s ^ 2 - c ^ 2) • (genV P A C * genV P A C * genV P A C) := by
          rw [smul_neg, smul_zero, add_zero, sub_smul, sq, sq]
          abel
  have hWPhiSq :
      (wilsonLoopEven P A C c s * genPhi P A C) *
        (wilsonLoopEven P A C c s * genPhi P A C) =
        (c ^ 2 - s ^ 2) • (genV P A C * genV P A C * genV P A C) := by
    have hExpand :
        wilsonLoopEven P A C c s * genPhi P A C =
          c • (genV P A C * genPhi P A C) + s • (genV P A C * genJ P A C) := by
      unfold wilsonLoopEven
      rw [add_mul, smul_mul_assoc, smul_mul_assoc, hSigPhi]
    rw [hExpand]
    calc
      (c • (genV P A C * genPhi P A C) + s • (genV P A C * genJ P A C)) *
          (c • (genV P A C * genPhi P A C) + s • (genV P A C * genJ P A C))
        = (c * c) • ((genV P A C * genPhi P A C) * (genV P A C * genPhi P A C)) +
          (c * s) • ((genV P A C * genPhi P A C) * (genV P A C * genJ P A C) +
            (genV P A C * genJ P A C) * (genV P A C * genPhi P A C)) +
          (s * s) • ((genV P A C * genJ P A C) * (genV P A C * genJ P A C)) := by
          simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
            smul_add, smul_smul, mul_comm s c]
          abel
      _ = (c * c) • (genV P A C * genV P A C * genV P A C) +
          (c * s) • (0 : B) +
          (s * s) • (-(genV P A C * genV P A C * genV P A C)) := by
          rw [hVPhi2, hVPhiJAnti, hVJ2]
      _ = (c ^ 2 - s ^ 2) • (genV P A C * genV P A C * genV P A C) := by
          rw [smul_neg, smul_zero, add_zero, sub_smul, sq, sq]
          abel
  have hSumZero :
      (wilsonLoopEven P A C c s * genJ P A C) *
        (wilsonLoopEven P A C c s * genJ P A C) +
      (wilsonLoopEven P A C c s * genPhi P A C) *
        (wilsonLoopEven P A C c s * genPhi P A C) = 0 := by
    rw [hWJSq, hWPhiSq, ← add_smul]
    have hCoef : s ^ 2 - c ^ 2 + (c ^ 2 - s ^ 2) = 0 := by ring
    rw [hCoef, zero_smul]
  exact ⟨⟨hEvenW, hOddW⟩, ⟨hWJ, hWPhi⟩, ⟨hWJSq, hWPhiSq, hSumZero⟩⟩

/-- **Stage `𝔚₆` Theorem (`stage_W6_light_cone_nilpotent_horizon_at_critical_flux`)**:
At the critical Berry flux ratios `(c, s) = (1, ±1)` and `(c, s) = (0, 1)`:
1. **Forward Light-Cone Horizon `(c, s) = (1, 1)`**:
   * `W(1, 1) = V + Σ = 2 • (N₊ * N₋)`,
   * `W(1, 1) * J = 2 • (V * N₊)`,
   * `(W(1, 1) * J)² = 0` (strictly nilpotent light-cone!),
2. **Backward Light-Cone Horizon `(c, s) = (1, -1)`**:
   * `W(1, -1) = V - Σ = 2 • (N₋ * N₊)`,
   * `W(1, -1) * J = -(2 • (V * N₋))`,
   * `(W(1, -1) * J)² = 0` (strictly nilpotent light-cone!),
3. **Pure Spacelike Inversion `(c, s) = (0, 1)`**:
   * `W(0, 1) = Σ`,
   * `W(0, 1) * J = V * Φ`,
   * `(W(0, 1) * J)² = +V³` (spacelike!). -/
theorem stage_W6_light_cone_nilpotent_horizon_at_critical_flux (A C : B) :
    (wilsonLoopEven P A C (1 : R) (1 : R) = (2 : ℤ) • (conePlus P A * coneMinus P C) ∧
     wilsonLoopEven P A C (1 : R) (1 : R) * genJ P A C =
       (2 : ℤ) • (genV P A C * conePlus P A) ∧
     (wilsonLoopEven P A C (1 : R) (1 : R) * genJ P A C) *
       (wilsonLoopEven P A C (1 : R) (1 : R) * genJ P A C) = 0) ∧
    (wilsonLoopEven P A C (1 : R) (-1 : R) = (2 : ℤ) • (coneMinus P C * conePlus P A) ∧
     wilsonLoopEven P A C (1 : R) (-1 : R) * genJ P A C =
       -((2 : ℤ) • (genV P A C * coneMinus P C)) ∧
     (wilsonLoopEven P A C (1 : R) (-1 : R) * genJ P A C) *
       (wilsonLoopEven P A C (1 : R) (-1 : R) * genJ P A C) = 0) ∧
    (wilsonLoopEven P A C (0 : R) (1 : R) = genSig P A C ∧
     wilsonLoopEven P A C (0 : R) (1 : R) * genJ P A C =
       genV P A C * genPhi P A C ∧
     (wilsonLoopEven P A C (0 : R) (1 : R) * genJ P A C) *
       (wilsonLoopEven P A C (0 : R) (1 : R) * genJ P A C) =
       genV P A C * genV P A C * genV P A C) := by
  have hW11 : wilsonLoopEven P A C (1 : R) (1 : R) = genV P A C + genSig P A C := by
    unfold wilsonLoopEven; simp
  have hW1m1 : wilsonLoopEven P A C (1 : R) (-1 : R) = genV P A C - genSig P A C := by
    unfold wilsonLoopEven; simp [sub_eq_add_neg]
  have hW01 : wilsonLoopEven P A C (0 : R) (1 : R) = genSig P A C := by
    unfold wilsonLoopEven; simp
  refine ⟨⟨?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩, ⟨hW01, ?_, ?_⟩⟩
  · rw [hW11]; peirce_nf hP
  · rw [hW11]; peirce_nf hP
  · rw [hW11]; peirce_nf hP
  · rw [hW1m1]; peirce_nf hP
  · rw [hW1m1]; peirce_nf hP
  · rw [hW1m1]; peirce_nf hP
  · rw [hW01]; peirce_nf hP
  · rw [hW01]; peirce_nf hP

/-- **Theorem (`single_sheet_blind_sidedness_and_two_sheet_coupling`)**:
Why neither single-sheet connection `∇₊ = sheetPlusConnection P W = P W P` nor
`∇₋ = sheetMinusConnection P W = (1 - P) W (1 - P)` can execute a two-sided Lie bracket
on the throat nilpotents `N₊, N₋` alone:
1. On `N₊ = conePlus P A`:
   * `∇₋ * N₊ = 0` (the lower sheet is blind on the left of `N₊`),
   * `N₊ * ∇₊ = 0` (the upper sheet is blind on the right of `N₊`),
   * `[Ω_sum, N₊] = ∇₊ * N₊ - N₊ * ∇₋ = {Ω_diff, N₊}`,
   * `{Ω_sum, N₊} = ∇₊ * N₊ + N₊ * ∇₋ = [Ω_diff, N₊]`,
2. On `N₋ = coneMinus P C`:
   * `∇₊ * N₋ = 0` (the upper sheet is blind on the left of `N₋`),
   * `N₋ * ∇₋ = 0` (the lower sheet is blind on the right of `N₋`),
   * `[Ω_diff, N₋] = -{Ω_sum, N₋}` and `{Ω_diff, N₋} = -[Ω_sum, N₋]`. -/
theorem single_sheet_blind_sidedness_and_two_sheet_coupling (W A C : B) :
    (sheetMinusConnection P W * conePlus P A = 0 ∧
     conePlus P A * sheetPlusConnection P W = 0 ∧
     sheetConnectionSum P W * conePlus P A = sheetPlusConnection P W * conePlus P A ∧
     conePlus P A * sheetConnectionSum P W = conePlus P A * sheetMinusConnection P W) ∧
    (sheetPlusConnection P W * coneMinus P C = 0 ∧
     coneMinus P C * sheetMinusConnection P W = 0 ∧
     sheetConnectionSum P W * coneMinus P C = sheetMinusConnection P W * coneMinus P C ∧
     coneMinus P C * sheetConnectionSum P W = coneMinus P C * sheetPlusConnection P W) ∧
    (comm (sheetConnectionDiff P W) (conePlus P A) =
       anticomm (sheetConnectionSum P W) (conePlus P A) ∧
     anticomm (sheetConnectionDiff P W) (conePlus P A) =
       comm (sheetConnectionSum P W) (conePlus P A) ∧
     comm (sheetConnectionDiff P W) (coneMinus P C) =
       -anticomm (sheetConnectionSum P W) (coneMinus P C) ∧
     anticomm (sheetConnectionDiff P W) (coneMinus P C) =
       -comm (sheetConnectionSum P W) (coneMinus P C)) := by
  refine ⟨⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_⟩⟩ <;>
    ((try dsimp only [sheetConnectionSum, sheetConnectionDiff,
      sheetPlusConnection, sheetMinusConnection]);
     peirce_nf hP)

/-- **Theorem (`fourfold_sheet_connection_crossover_and_dewitt_specialization`)**:
Reuses `sheetConnection_sum_difference_crossover` from `Homogenized.lean` and proves
its endogenous DeWitt/Gramian specialization and sheet-curvature asymmetry:
1. **Fourfold Sum–Difference Crossover Law** (for any seed `W : B`):
   * `[Ω_diff, Φ] = {Ω_sum, J}` and `{Ω_diff, Φ} = [Ω_sum, J]`,
   * `[Ω_diff, J] = {Ω_sum, Φ}` and `{Ω_diff, J} = [Ω_sum, Φ]`,
2. **Endogenous DeWitt / Gramian Specialization (`W = V = genV P A C`)**:
   * `∇₊(V) = N₊ * N₋`, `∇₋(V) = N₋ * N₊`,
   * `Ω_sum(V) = V` (DeWitt / Fisher metric) and `Ω_diff(V) = Σ` (Berry spin connection),
   * `[Σ, Φ] = {V, J} = 2 • (V * J)` and `[Σ, J] = {V, Φ} = 2 • (V * Φ)`,
   * `{Σ, Φ} = [V, J] = 0` and `{Σ, J} = [V, Φ] = 0`,
3. **Sheet Orthogonality & Curvature Asymmetry**:
   * `∇₊ * ∇₋ = 0` and `∇₋ * ∇₊ = 0`,
   * `∇₊² - ∇₋² = Ω_sum * Ω_diff = Ω_diff * Ω_sum`. -/
theorem fourfold_sheet_connection_crossover_and_dewitt_specialization (W A C : B) :
    (comm (sheetConnectionDiff P W) (genPhi P A C) =
       anticomm (sheetConnectionSum P W) (genJ P A C) ∧
     anticomm (sheetConnectionDiff P W) (genPhi P A C) =
       comm (sheetConnectionSum P W) (genJ P A C) ∧
     comm (sheetConnectionDiff P W) (genJ P A C) =
       anticomm (sheetConnectionSum P W) (genPhi P A C) ∧
     anticomm (sheetConnectionDiff P W) (genJ P A C) =
       comm (sheetConnectionSum P W) (genPhi P A C)) ∧
    (sheetPlusConnection P (genV P A C) = conePlus P A * coneMinus P C ∧
     sheetMinusConnection P (genV P A C) = coneMinus P C * conePlus P A ∧
     sheetConnectionSum P (genV P A C) = genV P A C ∧
     sheetConnectionDiff P (genV P A C) = genSig P A C ∧
     comm (genSig P A C) (genPhi P A C) = anticomm (genV P A C) (genJ P A C) ∧
     comm (genSig P A C) (genJ P A C) = anticomm (genV P A C) (genPhi P A C) ∧
     anticomm (genSig P A C) (genPhi P A C) = comm (genV P A C) (genJ P A C) ∧
     anticomm (genSig P A C) (genJ P A C) = comm (genV P A C) (genPhi P A C)) ∧
    (sheetPlusConnection P W * sheetMinusConnection P W = 0 ∧
     sheetMinusConnection P W * sheetPlusConnection P W = 0 ∧
     sheetPlusConnection P W * sheetPlusConnection P W -
       sheetMinusConnection P W * sheetMinusConnection P W =
       sheetConnectionSum P W * sheetConnectionDiff P W ∧
     sheetConnectionSum P W * sheetConnectionDiff P W =
       sheetConnectionDiff P W * sheetConnectionSum P W) := by
  refine ⟨sheetConnection_sum_difference_crossover hP W A C,
          ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩,
          ⟨?_, ?_, ?_, ?_⟩⟩ <;>
    (first | simp only [sheetConnectionSum, sheetConnectionDiff,
      sheetPlusConnection, sheetMinusConnection] | skip) <;> peirce_nf hP

end AlgebraicSpine

/-! ===========================================================================
    Section 5: Stage `𝔚₇` — Trigonometric Berry Rotor `R(θ) = cos θ • 1 + sin θ • S_P`,
    Rung 0 Socratic Aporia (`J R(θ) = R(-θ) J`), and Exact Wick Causal Transmutation
    =========================================================================== -/

section TrigonometricWickTransmutation

variable {B : Type*} [Ring B] [Algebra ℝ B]
variable {P : B} (hP : P * P = P)
include hP

/-- The trigonometric Berry rotor `R(θ) = cos θ • 1 + sin θ • S_P` in the even
chiral subalgebra of an `ℝ`-algebra `B`. -/
def berryRotor (P : B) (θ : ℝ) : B :=
  Real.cos θ • (1 : B) + Real.sin θ • invS P

/-- The Berry-rotated current `J(θ) := R(θ) * J`. -/
def rotatedCurrentJ (P A C : B) (θ : ℝ) : B :=
  berryRotor P θ * genJ P A C

/-- The Berry-rotated solder bridge `Φ(θ) := R(θ) * Φ`. -/
def rotatedBridgePhi (P A C : B) (θ : ℝ) : B :=
  berryRotor P θ * genPhi P A C

/-- **Rung 0 Socratic Aporia Lemma (`socratic_aporia_chiral_rotor_angle_inversion`)**:
Why naiveholonomy isometry fails in the `(J, Φ)` hyperplane:
1. Moving `J` or `Φ` past the rotor `R(θ)` **inverts the angle** `θ ↦ -θ`:
   `J * R(θ) = R(-θ) * J` and `Φ * R(θ) = R(-θ) * Φ`,
2. Because `S_P² = +1` (para-complex / Lorentzian signature rather than `i² = -1`),
   the product `R(θ) * R(-θ)` is the **sign-changing Lorentzian difference of squares**
   `(cos² θ - sin² θ) • 1 = cos(2θ) • 1`, whereas `R(θ)² = 1 + sin(2θ) • S_P`. -/
theorem socratic_aporia_chiral_rotor_angle_inversion (A C : B) (θ : ℝ) :
    genJ P A C * berryRotor P θ = berryRotor P (-θ) * genJ P A C ∧
    genPhi P A C * berryRotor P θ = berryRotor P (-θ) * genPhi P A C ∧
    berryRotor P θ * berryRotor P (-θ) = Real.cos (2 * θ) • (1 : B) := by
  have hJS : genJ P A C * invS P = -(invS P * genJ P A C) := by peirce_nf hP
  have hPhiS : genPhi P A C * invS P = -(invS P * genPhi P A C) := by peirce_nf hP
  have hS2 : invS P * invS P = 1 := (archetype_A2_peirce_cartan_grading_and_tangent_closure hP A C).1
  refine ⟨?_, ?_, ?_⟩
  · unfold berryRotor
    rw [Real.cos_neg, Real.sin_neg, mul_add, add_mul,
        mul_smul_comm, mul_smul_comm, smul_mul_assoc, smul_mul_assoc,
        mul_one, one_mul, hJS, smul_neg, neg_smul]
  · unfold berryRotor
    rw [Real.cos_neg, Real.sin_neg, mul_add, add_mul,
        mul_smul_comm, mul_smul_comm, smul_mul_assoc, smul_mul_assoc,
        mul_one, one_mul, hPhiS, smul_neg, neg_smul]
  · unfold berryRotor
    rw [Real.cos_neg, Real.sin_neg]
    calc
      (Real.cos θ • (1 : B) + Real.sin θ • invS P) *
          (Real.cos θ • (1 : B) + (-Real.sin θ) • invS P)
        = (Real.cos θ ^ 2 - Real.sin θ ^ 2) • (1 : B) := by
          rw [add_mul, mul_add, mul_add, smul_mul_assoc, smul_mul_assoc,
              smul_mul_assoc, smul_mul_assoc, mul_smul_comm, mul_smul_comm,
              mul_smul_comm, mul_smul_comm, smul_smul, smul_smul, smul_smul, smul_smul,
              one_mul, mul_one, hS2]
          have h1 : Real.cos θ * (-Real.sin θ) = -(Real.sin θ * Real.cos θ) := by ring
          have h2 : Real.sin θ * (-Real.sin θ) = -(Real.sin θ ^ 2) := by ring
          have h3 : Real.cos θ * Real.cos θ = Real.cos θ ^ 2 := by ring
          rw [one_mul, h1, h2, h3, neg_smul, neg_smul, sub_smul]
          module
      _ = Real.cos (2 * θ) • (1 : B) := by
          rw [← Real.cos_two_mul']

/-- **Stage `𝔚₇` Theorem (`stage_W7_trigonometric_berry_rotor_and_wick_transmutation`)**:
Continuous causal transmutation of `J` into `Φ` across the null nilpotent light-cone:
1. **Hyperplane Decomposition**:
   * `rotatedCurrentJ P A C θ = cos θ • J + sin θ • Φ`,
   * `rotatedBridgePhi P A C θ = cos θ • Φ + sin θ • J`,
2. **Continuous Causal Sign Inversion**:
   * `rotatedCurrentJ P A C θ * rotatedCurrentJ P A C θ = (-Real.cos (2 * θ)) • V`,
   * `rotatedBridgePhi P A C θ * rotatedBridgePhi P A C θ = Real.cos (2 * θ) • V`,
3. **The Three Causal Phases (Timelike `θ = 0` → Null Horizon `θ = π/4` → Spacelike `θ = π/2`)**:
   * At `θ = 0`: `J(0) = J` and `J(0)² = -V` (**Timelike**),
   * At `θ = π/4`: `J(π/4) = √2 • N₊` and `J(π/4)² = 0` (**Lightlike Nilpotent Horizon**),
   * At `θ = π/2`: `J(π/2) = Φ` and `J(π/2)² = +V` (**Spacelike**). -/
theorem stage_W7_trigonometric_berry_rotor_and_wick_transmutation
    (A C : B) (θ : ℝ) :
    (rotatedCurrentJ P A C θ = Real.cos θ • genJ P A C + Real.sin θ • genPhi P A C ∧
     rotatedBridgePhi P A C θ = Real.cos θ • genPhi P A C + Real.sin θ • genJ P A C) ∧
    (rotatedCurrentJ P A C θ * rotatedCurrentJ P A C θ = (-Real.cos (2 * θ)) • genV P A C ∧
     rotatedBridgePhi P A C θ * rotatedBridgePhi P A C θ = Real.cos (2 * θ) • genV P A C) ∧
    (rotatedCurrentJ P A C 0 = genJ P A C ∧
     rotatedCurrentJ P A C 0 * rotatedCurrentJ P A C 0 = -genV P A C) ∧
    (rotatedCurrentJ P A C (Real.pi / 4) = Real.sqrt 2 • conePlus P A ∧
     rotatedCurrentJ P A C (Real.pi / 4) * rotatedCurrentJ P A C (Real.pi / 4) = 0) ∧
    (rotatedCurrentJ P A C (Real.pi / 2) = genPhi P A C ∧
     rotatedCurrentJ P A C (Real.pi / 2) * rotatedCurrentJ P A C (Real.pi / 2) = genV P A C) := by
  have hSJ : invS P * genJ P A C = genPhi P A C := by peirce_nf hP
  have hSPhi : invS P * genPhi P A C = genJ P A C := by peirce_nf hP
  have hRotJ :
      rotatedCurrentJ P A C θ = Real.cos θ • genJ P A C + Real.sin θ • genPhi P A C := by
    unfold rotatedCurrentJ berryRotor
    rw [add_mul, smul_mul_assoc, smul_mul_assoc, one_mul, hSJ]
  have hRotPhi :
      rotatedBridgePhi P A C θ = Real.cos θ • genPhi P A C + Real.sin θ • genJ P A C := by
    unfold rotatedBridgePhi berryRotor
    rw [add_mul, smul_mul_assoc, smul_mul_assoc, one_mul, hSPhi]
  have hW1 := stage_W1_causal_hyperplane_opposite_squares_and_orthogonality
    (R := ℝ) hP A C (Real.cos θ) (Real.sin θ)
  have hJSq :
      rotatedCurrentJ P A C θ * rotatedCurrentJ P A C θ = (-Real.cos (2 * θ)) • genV P A C := by
    rw [hRotJ, hW1.2.2.2.2.1]
    have hTrig : Real.sin θ ^ 2 - Real.cos θ ^ 2 = -Real.cos (2 * θ) := by
      rw [Real.cos_two_mul']
      ring
    rw [hTrig]
  have hPhiSq :
      rotatedBridgePhi P A C θ * rotatedBridgePhi P A C θ = Real.cos (2 * θ) • genV P A C := by
    rw [hRotPhi, hW1.2.2.2.2.2]
    rw [← Real.cos_two_mul']
  have hRotJ0 : rotatedCurrentJ P A C 0 = genJ P A C := by
    have h0 := hRotJ
    have hRotJ_zero :
        rotatedCurrentJ P A C 0 = Real.cos 0 • genJ P A C + Real.sin 0 • genPhi P A C := by
      unfold rotatedCurrentJ berryRotor
      rw [add_mul, smul_mul_assoc, smul_mul_assoc, one_mul, hSJ]
    rw [hRotJ_zero, Real.cos_zero, Real.sin_zero, one_smul, zero_smul, add_zero]
  have hJSq0 : rotatedCurrentJ P A C 0 * rotatedCurrentJ P A C 0 = -genV P A C := by
    rw [hRotJ0]
    peirce_nf hP
  have hRotJPi4 : rotatedCurrentJ P A C (Real.pi / 4) = Real.sqrt 2 • conePlus P A := by
    have hPi4 :
        rotatedCurrentJ P A C (Real.pi / 4) =
          Real.cos (Real.pi / 4) • genJ P A C + Real.sin (Real.pi / 4) • genPhi P A C := by
      unfold rotatedCurrentJ berryRotor
      rw [add_mul, smul_mul_assoc, smul_mul_assoc, one_mul, hSJ]
    have hSumCone : genJ P A C + genPhi P A C = (2 : ℝ) • conePlus P A := by
      rw [two_smul]
      peirce_nf hP
    rw [hPi4, Real.cos_pi_div_four, Real.sin_pi_div_four, ← smul_add,
        hSumCone, smul_smul]
    have hHalfTwo : Real.sqrt 2 / 2 * 2 = Real.sqrt 2 := by ring
    rw [hHalfTwo]
  have hJSqPi4 :
      rotatedCurrentJ P A C (Real.pi / 4) * rotatedCurrentJ P A C (Real.pi / 4) = 0 := by
    rw [hRotJPi4, smul_mul_assoc, mul_smul_comm]
    have hNil : conePlus P A * conePlus P A = 0 := by peirce_nf hP
    rw [hNil, smul_zero, smul_zero]
  have hRotJPi2 : rotatedCurrentJ P A C (Real.pi / 2) = genPhi P A C := by
    have hPi2 :
        rotatedCurrentJ P A C (Real.pi / 2) =
          Real.cos (Real.pi / 2) • genJ P A C + Real.sin (Real.pi / 2) • genPhi P A C := by
      unfold rotatedCurrentJ berryRotor
      rw [add_mul, smul_mul_assoc, smul_mul_assoc, one_mul, hSJ]
    rw [hPi2, Real.cos_pi_div_two, Real.sin_pi_div_two, zero_smul, one_smul, zero_add]
  have hJSqPi2 :
      rotatedCurrentJ P A C (Real.pi / 2) * rotatedCurrentJ P A C (Real.pi / 2) =
        genV P A C := by
    rw [hRotJPi2]
    peirce_nf hP
  exact ⟨⟨hRotJ, hRotPhi⟩, ⟨hJSq, hPhiSq⟩, ⟨hRotJ0, hJSq0⟩,
         ⟨hRotJPi4, hJSqPi4⟩, ⟨hRotJPi2, hJSqPi2⟩⟩

