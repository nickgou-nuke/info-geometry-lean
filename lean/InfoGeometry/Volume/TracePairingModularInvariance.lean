import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Tactic
import InfoGeometry.Canonical.TransportLieDerivative
import InfoGeometry.Volume.ConnesInfinitesimal

/-!
# Trace-pairing invariance under modular flow

This owner proves that the finite trace pairing on matrix/operator carriers
is invariant under the modular flow generated by `K = -log Δ`.

The trace pairing is

  B_tr(X, Y) = Matrix.trace (X * Y).

For the modular flow

  α_t(X) = exp(t • K) * X * exp(-t • K)

the finite-flow invariance is

  B_tr(α_t(X), α_t(Y)) = B_tr(X, Y),

and the infinitesimal ad-invariance is

  B_tr([K, X], Y) + B_tr(X, [K, Y]) = 0.

The proof uses only cyclicity of the finite trace and the exponential
conjugation structure; no BKM or integral metric is needed.
-/

noncomputable section

namespace InfoGeometry.Volume.TracePairingModularInvariance

open scoped Matrix

variable {n : Type*} [Fintype n] [DecidableEq n]

/-! ## Finite matrix modular flow -/

/-- Modular flow on finite matrices by exponential conjugation. -/
def matrixModularFlow (K X : Matrix n n ℝ) (t : ℝ) : Matrix n n ℝ :=
  (NormedSpace.exp (t • K)) * X * (NormedSpace.exp (-t • K))

@[simp] theorem matrixModularFlow_zero (K X : Matrix n n ℝ) :
    matrixModularFlow K X 0 = X := by
  simp [matrixModularFlow, NormedSpace.exp_zero, smul_zero]

/-- The modular flow fixes the generator matrix. -/
theorem matrixModularFlow_self (K : Matrix n n ℝ) (t : ℝ) :
    matrixModularFlow K K t = K := by
  unfold matrixModularFlow
  rw [Matrix.mul_assoc, Matrix.exp_neg_smul_mul_smul K t K, Matrix.one_mul]

/-- The derivative of the modular flow is the transported commutator. -/
theorem hasDerivAt_matrixModularFlow
    (K X : Matrix n n ℝ) (t : ℝ) :
    HasDerivAt (fun s => matrixModularFlow K X s)
      (matrixModularFlow K (K * X - X * K) t) t := by
  unfold matrixModularFlow
  have h := hasDerivAt_expTransport_at_zero (X := K) (A₀ := X)
  convert h using 2
  simp [expTransport]

/-! ## Trace pairing -/

/-- The finite trace pairing on matrix operators. -/
def tracePairing (X Y : Matrix n n ℝ) : ℝ :=
  Matrix.trace (X * Y)

@[simp] theorem tracePairing_apply (X Y : Matrix n n ℝ) :
    tracePairing X Y = Matrix.trace (X * Y) := rfl

/-- The trace pairing is symmetric under transpose. -/
theorem tracePairing_symm (X Y : Matrix n n ℝ) :
    tracePairing X Y = tracePairing Y X := by
  simp [tracePairing, Matrix.trace_mul_comm]

/-- Trace is invariant under cyclic permutation. -/
theorem trace_mul_cycle (X Y Z : Matrix n n ℝ) :
    Matrix.trace (X * Y * Z) = Matrix.trace (Y * Z * X) := by
  rw [Matrix.trace_mul_comm, Matrix.trace_mul_comm]

/-! ## Finite-flow trace invariance -/

/-- The trace pairing is invariant under the modular flow.

This is the finite Killing theorem for the trace metric:
  B_tr(α_t(X), α_t(Y)) = B_tr(X, Y).
-/
theorem tracePairing_modularFlow_invariant
    (K X Y : Matrix n n ℝ) (t : ℝ) :
    tracePairing (matrixModularFlow K X t) (matrixModularFlow K Y t) =
      tracePairing X Y := by
  unfold tracePairing matrixModularFlow
  rw [trace_mul_cycle (X := exp t K) (Y := X) (Z := exp (-t) K)]
  rw [trace_mul_cycle (X := exp (-t) K) (Y := K) (Z := X)]
  simp [Matrix.exp_mul_comm_of_commute]
  rw [Matrix.trace_mul_comm]
  ring_nf
  rw [Matrix.trace_mul_cycle (X := X) (Y := K) (Z := Y)]
  rw [trace_mul_cycle (X := K) (Y := Y) (Z := exp (-t) K)]
  simp [Matrix.exp_mul_comm_of_commute]

/-! ## Infinitesimal ad-invariance -/

/-- The infinitesimal trace pairing satisfies the Killing skew condition:
  B_tr([K, X], Y) + B_tr(X, [K, Y]) = 0.
-/
theorem tracePairing_ad_skew
    (K X Y : Matrix n n ℝ) :
    tracePairing (K * X - X * K) Y + tracePairing X (K * Y - Y * K) = 0 := by
  unfold tracePairing
  simp [Matrix.trace_add, Matrix.trace_neg, Matrix.trace_mul]
  ring

end InfoGeometry.Volume.TracePairingModularInvariance
