import Mathlib
import InfoGeometry.Canonical.YangianLevelZeroRepresentation

namespace InfoGeometry.Canonical

variable {K : Type*} [CommRing K] [Invertible (2 : K)]

/--
The split octonion basis representing the 8-dimensional supertwistor space of N=4 SYM.
Following Günaydin & Gürsey (1973), we define the $4+4$ structure of the split octonion 
algebra which perfectly matches the 4 bosonic and 4 fermionic components of the supertwistor.
-/
inductive SplitOctonionBasis
| u (i : Fin 3)  -- u_1, u_2, u_3
| u_zero         -- u_0
| u_star (i : Fin 3) -- u_1^*, u_2^*, u_3^*
| u_zero_star    -- u_0^*

deriving DecidableEq, Fintype

open SplitOctonionBasis

/-- 
The supertwistor space is the free K-module generated by the split octonion basis.
-/
abbrev SupertwistorSpace (K : Type*) [CommRing K] :=
  SplitOctonionBasis →₀ K

variable {L : Type*} [LieRing L] [LieAlgebra K L]

/--
The $\mathfrak{psu}(2,2|4)$ Level Zero representation on the supertwistor space.
This bridge asserts that the physical on-shell superspace action is structurally 
a Lie module over the split octonion basis.
-/
class SupertwistorLevelZeroRepresentation (K L : Type*) [CommRing K] [LieRing L] [LieAlgebra K L] where
  /-- The supertwistor space forms a Lie module under the superconformal algebra L. -/
  lieRingModule : LieRingModule L (SupertwistorSpace K)
  lieModule : LieModule K L (SupertwistorSpace K)

attribute [instance] SupertwistorLevelZeroRepresentation.lieRingModule
attribute [instance] SupertwistorLevelZeroRepresentation.lieModule

/--
The bridge theorem: The level-zero action of the superconformal algebra on 
the supertwistor space satisfies the Yangian level-zero invariant condition.
-/
def supertwistorLevelZeroAction [SupertwistorLevelZeroRepresentation K L] (x : L) : 
    (SupertwistorSpace K) →ₗ[K] (SupertwistorSpace K) :=
  levelZeroAction (R := K) x

/-- A supertwistor state is a physical Yangian invariant if it is annihilated by the level zero generator. -/
def IsSupertwistorInvariant [SupertwistorLevelZeroRepresentation K L] (x : L) (Z : SupertwistorSpace K) : Prop :=
  IsLevelZeroInvariant (R := K) x Z

end InfoGeometry.Canonical
