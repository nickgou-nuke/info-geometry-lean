import Mathlib

noncomputable section

open scoped Interval

namespace InfoGeometry.Canonical.MixedBeta

/-- The physical owner model (generalized variance function) -/
def V (c0 c1 c2 μ : ℝ) : ℝ :=
  c0 + c1 * μ + c2 * μ^2

/-- Positive definiteness constraints for the noise geometry -/
class ValidSensorModel (c0 c1 c2 : ℝ) : Prop where
  c0_pos : 0 < c0
  c1_nonneg : 0 ≤ c1
  c2_nonneg : 0 ≤ c2

/-- Variance is strictly positive for positive signals -/
theorem V_pos {c0 c1 c2 : ℝ} [h : ValidSensorModel c0 c1 c2] (μ : ℝ) (hμ : 0 ≤ μ) : 
    0 < V c0 c1 c2 μ := by
  dsimp [V]
  have h1 : 0 ≤ c1 * μ := mul_nonneg h.c1_nonneg hμ
  have h2 : 0 ≤ c2 * μ^2 := mul_nonneg h.c2_nonneg (sq_nonneg μ)
  linarith [h.c0_pos]

/-- Quasi-deviance function generated by the variance model V -/
def D_V (c0 c1 c2 : ℝ) (x μ : ℝ) : ℝ :=
  2 * ∫ u in μ..x, (x - u) / V c0 c1 c2 u

/-- Null property of the divergence -/
theorem D_V_self (c0 c1 c2 : ℝ) (μ : ℝ) : D_V c0 c1 c2 μ μ = 0 := by
  dsimp [D_V]
  rw [intervalIntegral.integral_same]
  ring

end InfoGeometry.Canonical.MixedBeta
