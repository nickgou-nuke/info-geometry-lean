import InfoGeometry.Algebra.PeirceLieJordanEigen
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Quadratic closure of square-zero operator pairs

For square-zero `u,v`, the four expressions `u+v`, `u-v`, `uv+vu`, `uv-vu`
obey exact noncommutative product and adjoint identities. Centrality is proved
only in the subalgebra generated by the pair. An algebraic adjoint two-cycle
is not a periodic time evolution, a scalar frequency, or a spectral gap.
-/

namespace InfoGeometry.Algebra.PeirceQuadraticCycle

attribute [local instance 100] LieRing.ofAssociativeRing

variable {A : Type*} [Ring A]

lemma square_zero_left {u : A} (hu : u * u = 0) (x : A) : u * (u * x) = 0 := by
  rw [← mul_assoc, hu, zero_mul]

theorem sum_sq {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    (u + v) * (u + v) = u * v + v * u := by
  simp only [add_mul, mul_add, hu, hv, zero_add, add_zero]
  abel

theorem difference_sq {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    (u - v) * (u - v) = -(u * v + v * u) := by
  simp only [sub_mul, mul_sub, hu, hv]
  abel

theorem difference_mul_sum {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    (u - v) * (u + v) = u * v - v * u := by
  simp only [sub_mul, mul_add, hu, hv]
  abel

theorem sum_mul_difference {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    (u + v) * (u - v) = -(u * v - v * u) := by
  simp only [add_mul, mul_sub, hu, hv]
  abel

theorem sum_difference_anticommute {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    (u + v) * (u - v) + (u - v) * (u + v) = 0 := by
  rw [sum_mul_difference hu hv, difference_mul_sum hu hv, neg_add_cancel]

theorem quadratic_commutes_left {u v : A} (hu : u * u = 0) :
    (u * v + v * u) * u = u * (u * v + v * u) := by
  simp only [add_mul, mul_add, mul_assoc, hu, square_zero_left hu,
    mul_zero, zero_add, add_zero]

theorem quadratic_commutes_right {u v : A} (hv : v * v = 0) :
    (u * v + v * u) * v = v * (u * v + v * u) := by
  simp only [add_mul, mul_add, mul_assoc, hv, square_zero_left hv,
    mul_zero, zero_add, add_zero]

/-- The quadratic expression is central on the generated algebra, not asserted
central on the ambient matrix algebra. -/
theorem quadratic_central_on_adjoin {R : Type*} [CommRing R] [Algebra R A]
    {u v x : A} (hu : u * u = 0) (hv : v * v = 0)
    (hx : x ∈ Algebra.adjoin R ({u, v} : Set A)) :
    (u * v + v * u) * x = x * (u * v + v * u) := by
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx
  · intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · exact quadratic_commutes_left hu
    · exact quadratic_commutes_right hv
  · intro r
    exact (Algebra.commutes r (u * v + v * u)).symm
  · intro a b _ _ ha hb
    rw [mul_add, ha, hb, ← add_mul]
  · intro a b _ _ ha hb
    calc
      _ = ((u * v + v * u) * a) * b := by rw [mul_assoc]
      _ = (a * (u * v + v * u)) * b := by rw [ha]
      _ = a * ((u * v + v * u) * b) := by rw [mul_assoc]
      _ = a * (b * (u * v + v * u)) := by rw [hb]
      _ = _ := by rw [mul_assoc]

/-- The coefficient is the actual quadratic operator, never a scalar frequency. -/
theorem bracket_sum {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    ⁅u * v - v * u, u + v⁆ = 2 • ((u * v + v * u) * (u - v)) := by
  simp only [Ring.lie_def, two_nsmul, add_mul, mul_add, sub_mul, mul_sub,
    mul_assoc, hu, hv, square_zero_left hu, square_zero_left hv,
    mul_zero, add_zero, zero_add, sub_zero, zero_sub]
  abel

theorem bracket_difference {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    ⁅u * v - v * u, u - v⁆ = 2 • ((u * v + v * u) * (u + v)) := by
  simp only [Ring.lie_def, two_nsmul, add_mul, mul_add, sub_mul, mul_sub,
    mul_assoc, hu, hv, square_zero_left hu, square_zero_left hv,
    mul_zero, add_zero, zero_add, sub_zero, zero_sub]
  abel

theorem bracket_square_eq_quadratic_square {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    (u * v - v * u) * (u * v - v * u) =
      (u * v + v * u) * (u * v + v * u) := by
  simp only [add_mul, mul_add, sub_mul, mul_sub, mul_assoc,
    square_zero_left hu, square_zero_left hv,
    mul_zero, add_zero, zero_add, sub_zero, zero_sub]
  abel

theorem bracket_twice_sum {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    ⁅u * v - v * u, ⁅u * v - v * u, u + v⁆⁆ =
      (4 : ℕ) • ((u * v + v * u) * (u * v + v * u) * (u + v)) := by
  simp only [Ring.lie_def, show (4 : ℕ) = 2 + 2 from rfl, add_nsmul, two_nsmul,
    add_mul, mul_add, sub_mul, mul_sub, neg_mul, mul_neg, mul_assoc,
    hu, hv, square_zero_left hu, square_zero_left hv,
    mul_zero, add_zero, zero_add, sub_zero, zero_sub]
  abel

/-- A reciprocal adjoint cycle gives this exact derivative of its mixed product. -/
theorem cycle_product {p j e : A} (hj : ⁅p, j⁆ = e) (he : ⁅p, e⁆ = j) :
    ⁅p, j * e⁆ = e * e + j * j := by
  calc
    _ = ⁅p, j⁆ * e + j * ⁅p, e⁆ := by
      simp only [Ring.lie_def]
      noncomm_ring
    _ = _ := by rw [hj, he]

theorem cycle_square {p j e : A} (he : ⁅p, e⁆ = j) :
    ⁅p, e * e⁆ = j * e + e * j := by
  calc
    _ = ⁅p, e⁆ * e + e * ⁅p, e⁆ := by
      simp only [Ring.lie_def]
      noncomm_ring
    _ = _ := by rw [he]

theorem cycle_product_conserved_iff {p j e : A}
    (hj : ⁅p, j⁆ = e) (he : ⁅p, e⁆ = j) :
    ⁅p, j * e⁆ = 0 ↔ e * e + j * j = 0 := by
  rw [cycle_product hj he]

theorem cycle_square_conserved_iff {p j e : A} (he : ⁅p, e⁆ = j) :
    ⁅p, e * e⁆ = 0 ↔ j * e + e * j = 0 := by
  rw [cycle_square he]

/-- This invariant holds for every reciprocal cycle, without anticommutation. -/
theorem cycle_square_difference_conserved {p j e : A}
    (hj : ⁅p, j⁆ = e) (he : ⁅p, e⁆ = j) :
    ⁅p, e * e - j * j⁆ = 0 := by
  have hsplit : ⁅p, e * e - j * j⁆ = ⁅p, e * e⁆ - ⁅p, j * j⁆ := by
    simp only [Ring.lie_def]
    noncomm_ring
  rw [hsplit, cycle_square he, cycle_square hj]
  abel

/-- The actual Peirce corners meet the square-zero hypotheses for any input. -/
theorem peirce_bracket_sum {p : A} (hp : p * p = p) (x : A) :
    ⁅peirce10 p x * peirce01 p x - peirce01 p x * peirce10 p x,
        peirce10 p x + peirce01 p x⁆ =
      2 • ((peirce10 p x * peirce01 p x + peirce01 p x * peirce10 p x) *
        (peirce10 p x - peirce01 p x)) :=
  bracket_sum (peirce10_square_zero hp x) (peirce01_square_zero hp x)

end InfoGeometry.Algebra.PeirceQuadraticCycle
