import Mathlib.Algebra.Category.ModuleCat.FilteredColimits
import Mathlib.CategoryTheory.Functor.OfSequence
import Mathlib.Tactic
import InfoGeometry.Canonical.SplitOctonionExterior3HodgeDiracBridge
import InfoGeometry.Canonical.ChiralHodgeDiracFilteredColimit
import InfoGeometry.Canonical.HestenesRealModularRealizationBridge

/-!
# Concrete Hestenes doubling of the finite chiral Hodge--Dirac packet

The exterior carrier is doubled over `ℝ`.  The map `K (a,b) = (-b,a)` is the
real Hestenes phase: it squares to `-I`.  The finite Hodge--Dirac operator is
lifted diagonally, so it commutes with `K`; the ordinary exterior grading is
lifted diagonally as the chiral involution.  The resulting packet is then
transported through the native filtered colimit API on the constant diagram.

This is an algebraic finite/filtered-colimit statement.  It does not assert a
norm completion, analytic convergence, or a spectral identification.
-/

noncomputable section

namespace InfoGeometry.Canonical.ConcreteChiralHodgeDiracHestenesColimit

open CategoryTheory CategoryTheory.Limits
open InfoGeometry.Canonical.SplitOctonionExterior3HodgeDiracBridge
open InfoGeometry.Canonical.ChiralHodgeDiracFilteredColimit
open InfoGeometry.Canonical.HestenesRealModularRealizationBridge

abbrev DoubledExterior3 := Exterior3 × Exterior3
abbrev DoubledExterior3End := Module.End ℝ DoubledExterior3

def doubledDiagonal (T : Exterior3 →ₗ[ℝ] Exterior3) : DoubledExterior3End :=
  T.prodMap T

@[simp] theorem doubledDiagonal_apply (T : Exterior3 →ₗ[ℝ] Exterior3)
    (x : DoubledExterior3) :
    doubledDiagonal T x = (T x.1, T x.2) := by
  rfl

def hestenesPhase3 : DoubledExterior3End where
  toFun x := (-x.2, x.1)
  map_add' x y := by
    ext <;> simp [add_comm]
  map_smul' c x := by
    ext <;> simp

@[simp] theorem hestenesPhase3_apply (x : DoubledExterior3) :
    hestenesPhase3 x = (-x.2, x.1) := rfl

theorem hestenesPhase3_sq :
    hestenesPhase3 * hestenesPhase3 = -(1 : DoubledExterior3End) := by
  apply LinearMap.ext
  rintro ⟨a, b⟩
  simp [hestenesPhase3]

/-! ## A concrete finite real phase flow

The following flow is the finite algebraic rotation generated by the internal
complex structure `hestenesPhase3`.  It is deliberately stated using the
trigonometric polynomial `cos t + sin t K`; no analytic exponential or
functional calculus is being introduced here.
-/

def concreteHestenesPhaseFlow (t : ℝ) : DoubledExterior3End :=
  { toFun := fun x =>
      (Real.cos t • x.1 - Real.sin t • x.2,
        Real.sin t • x.1 + Real.cos t • x.2)
    map_add' := by
      intro x y
      ext <;> simp [smul_add, sub_eq_add_neg] <;> module
    map_smul' := by
      intro c x
      ext <;> simp [smul_add, sub_eq_add_neg, smul_smul] <;> module }

theorem concreteHestenesPhaseFlow_eq_linear_combination (t : ℝ) :
    concreteHestenesPhaseFlow t =
      Real.cos t • (1 : DoubledExterior3End) +
        Real.sin t • hestenesPhase3 := by
  apply LinearMap.ext
  rintro ⟨a, b⟩
  simp [concreteHestenesPhaseFlow, hestenesPhase3]
  constructor <;> module

@[simp] theorem concreteHestenesPhaseFlow_zero :
    concreteHestenesPhaseFlow 0 = (1 : DoubledExterior3End) := by
  apply LinearMap.ext
  intro x
  simp [concreteHestenesPhaseFlow]

theorem concreteHestenesPhaseFlow_add (s t : ℝ) :
    concreteHestenesPhaseFlow (s + t) =
      concreteHestenesPhaseFlow s ∘ₗ concreteHestenesPhaseFlow t := by
  apply LinearMap.ext
  intro x
  change
    (Real.cos (s + t) • x.1 - Real.sin (s + t) • x.2,
      Real.sin (s + t) • x.1 + Real.cos (s + t) • x.2) =
      (Real.cos s • (Real.cos t • x.1 - Real.sin t • x.2) -
          Real.sin s • (Real.sin t • x.1 + Real.cos t • x.2),
        Real.sin s • (Real.cos t • x.1 - Real.sin t • x.2) +
          Real.cos s • (Real.sin t • x.1 + Real.cos t • x.2))
  apply Prod.ext
  · change Real.cos (s + t) • x.1 - Real.sin (s + t) • x.2 = _
    rw [Real.cos_add, Real.sin_add]
    module
  · change Real.sin (s + t) • x.1 + Real.cos (s + t) • x.2 = _
    rw [Real.cos_add, Real.sin_add]
    module

theorem concreteHestenesPhaseFlow_two_pi (t : ℝ) :
    concreteHestenesPhaseFlow (t + 2 * Real.pi) =
      concreteHestenesPhaseFlow t := by
  rw [concreteHestenesPhaseFlow_eq_linear_combination (t + 2 * Real.pi),
    concreteHestenesPhaseFlow_eq_linear_combination t]
  simp [Real.cos_add_two_pi, Real.sin_add_two_pi]

def concreteHestenesPhaseModularDatum :
    HestenesModularDatum DoubledExterior3 where
  I := hestenesPhase3
  V := (1 : DoubledExterior3End)
  I_sq := hestenesPhase3_sq
  I_commutes_V := by
    apply LinearMap.ext
    intro x
    change hestenesPhase3 x = hestenesPhase3 x
    rfl
  realFlow := concreteHestenesPhaseFlow
  realFlow_zero := concreteHestenesPhaseFlow_zero
  realFlow_add := concreteHestenesPhaseFlow_add

def concreteDirac3 (v : V3) (φ : Module.Dual ℝ V3) : DoubledExterior3End :=
  doubledDiagonal (exteriorHodgeDirac3 v φ)

def concreteLaplacian3 (v : V3) (φ : Module.Dual ℝ V3) : DoubledExterior3End :=
  doubledDiagonal (exteriorHodgeLaplacian3 v φ)

def concreteChirality3 : DoubledExterior3End :=
  doubledDiagonal exteriorGrade3.toLinearMap

theorem concreteDirac3_sq (v : V3) (φ : Module.Dual ℝ V3) :
    concreteDirac3 v φ * concreteDirac3 v φ = concreteLaplacian3 v φ := by
  apply LinearMap.ext
  rintro ⟨a, b⟩
  apply Prod.ext
  · simpa [concreteDirac3, concreteLaplacian3, doubledDiagonal] using
      congrArg (fun T : Exterior3End => T a) (exteriorHodgeDirac3_sq v φ)
  · simpa [concreteDirac3, concreteLaplacian3, doubledDiagonal] using
      congrArg (fun T : Exterior3End => T b) (exteriorHodgeDirac3_sq v φ)

theorem concreteChirality3_sq :
    concreteChirality3 * concreteChirality3 = (1 : DoubledExterior3End) := by
  apply LinearMap.ext
  rintro ⟨a, b⟩
  simp [concreteChirality3, doubledDiagonal, exteriorGrade3_involutive]

theorem concreteChirality3_odd (v : V3) (φ : Module.Dual ℝ V3) :
    concreteChirality3 * concreteDirac3 v φ =
      -(concreteDirac3 v φ * concreteChirality3) := by
  apply LinearMap.ext
  rintro ⟨a, b⟩
  simp [concreteChirality3, concreteDirac3, doubledDiagonal,
    exteriorHodgeDirac3_odd]

theorem concreteDirac3_phase (v : V3) (φ : Module.Dual ℝ V3) :
    hestenesPhase3 * concreteDirac3 v φ =
      concreteDirac3 v φ * hestenesPhase3 := by
  apply LinearMap.ext
  rintro ⟨a, b⟩
  simp [hestenesPhase3, concreteDirac3, doubledDiagonal]

/-! The internal real complex structure preserves the chirality grading in
the present doubled carrier.  This is deliberately separate from a chiral
exchange involution, which would instead be an off-diagonal map between the
two summands. -/

theorem concreteHestenesPhase_chirality_commutes :
    hestenesPhase3 * concreteChirality3 =
      concreteChirality3 * hestenesPhase3 := by
  apply LinearMap.ext
  rintro ⟨a, b⟩
  simp [hestenesPhase3, concreteChirality3, doubledDiagonal]

theorem concreteHestenesPhase3_dirac_sq
    (v : V3) (φ : Module.Dual ℝ V3) :
    (hestenesPhase3 * concreteDirac3 v φ) *
        (hestenesPhase3 * concreteDirac3 v φ) =
      -(concreteLaplacian3 v φ) := by
  calc
    (hestenesPhase3 * concreteDirac3 v φ) *
        (hestenesPhase3 * concreteDirac3 v φ) =
      hestenesPhase3 *
        (concreteDirac3 v φ * (hestenesPhase3 * concreteDirac3 v φ)) := by
          rw [mul_assoc]
    _ = hestenesPhase3 *
        ((concreteDirac3 v φ * hestenesPhase3) * concreteDirac3 v φ) := by
          rw [mul_assoc]
    _ = hestenesPhase3 *
        ((hestenesPhase3 * concreteDirac3 v φ) * concreteDirac3 v φ) := by
          rw [concreteDirac3_phase]
    _ = (hestenesPhase3 * hestenesPhase3) *
        (concreteDirac3 v φ * concreteDirac3 v φ) := by
          noncomm_ring
    _ = -(concreteLaplacian3 v φ) := by
      rw [hestenesPhase3_sq, concreteDirac3_sq]
      rfl

theorem concreteHestenesPhaseFlow_commutes_dirac
    (t : ℝ) (v : V3) (φ : Module.Dual ℝ V3) :
    concreteHestenesPhaseFlow t ∘ₗ concreteDirac3 v φ =
      concreteDirac3 v φ ∘ₗ concreteHestenesPhaseFlow t := by
  rw [concreteHestenesPhaseFlow_eq_linear_combination]
  rw [LinearMap.add_comp, LinearMap.comp_add,
    LinearMap.smul_comp, LinearMap.comp_smul]
  apply LinearMap.ext
  intro x
  simp only [LinearMap.add_apply, LinearMap.smul_apply, LinearMap.comp_apply,
    Module.End.one_apply, LinearMap.map_smul]
  have hphase : hestenesPhase3 (concreteDirac3 v φ x) =
      concreteDirac3 v φ (hestenesPhase3 x) := by
    simpa only [Module.End.mul_apply] using
      congrArg (fun T => T x) (concreteDirac3_phase v φ)
  rw [hphase]

theorem concreteHestenesPhaseFlow_commutes_phase (t : ℝ) :
    hestenesPhase3 ∘ₗ concreteHestenesPhaseFlow t =
      concreteHestenesPhaseFlow t ∘ₗ hestenesPhase3 := by
  rw [concreteHestenesPhaseFlow_eq_linear_combination]
  apply LinearMap.ext
  rintro ⟨a, b⟩
  simp [hestenesPhase3, concreteHestenesPhaseFlow]
  module

abbrev constantDoubledExterior3Functor : ℕ ⥤ ModuleCat ℝ :=
  (Functor.const ℕ).obj (ModuleCat.of ℝ DoubledExterior3)

def constantEndNatTrans (T : DoubledExterior3End) :
    constantDoubledExterior3Functor ⟶ constantDoubledExterior3Functor :=
  NatTrans.ofSequence
    (fun _ => ModuleCat.ofHom T)
    (by
      intro n
      apply ModuleCat.hom_ext
      ext x
      rfl)

/-! The concrete trigonometric Hestenes flow is transported directly through
the native filtered colimit.  This is an algebraic replacement for extending
the finite flow by analytic functional calculus. -/

def concreteHestenesPhaseFlowColimit (t : ℝ) :
    colimit constantDoubledExterior3Functor ⟶
      colimit constantDoubledExterior3Functor :=
  colim.map (constantEndNatTrans (concreteHestenesPhaseFlow t))

theorem concreteHestenesPhaseFlowColimit_on_stage
    (t : ℝ) (j : ℕ) (x : DoubledExterior3) :
    concreteHestenesPhaseFlowColimit t
        ((colimit.ι constantDoubledExterior3Functor j).hom x) =
      (colimit.ι constantDoubledExterior3Functor j).hom
        (concreteHestenesPhaseFlow t x) := by
  have h := colimit.ι_map
    (constantEndNatTrans (concreteHestenesPhaseFlow t)) j
  exact congrArg (fun f => f x) h

theorem concreteHestenesPhaseFlowColimit_add (s t : ℝ) :
    concreteHestenesPhaseFlowColimit (s + t) =
      concreteHestenesPhaseFlowColimit t ≫
        concreteHestenesPhaseFlowColimit s := by
  change colim.map (constantEndNatTrans (concreteHestenesPhaseFlow (s + t))) =
    colim.map (constantEndNatTrans (concreteHestenesPhaseFlow t)) ≫
      colim.map (constantEndNatTrans (concreteHestenesPhaseFlow s))
  rw [← colim.map_comp]
  congr 1
  ext j x
  simpa [constantEndNatTrans, ModuleCat.comp_apply] using
    congrArg (fun f => f x) (concreteHestenesPhaseFlow_add s t)

theorem concreteHestenesPhaseFlowColimit_two_pi (t : ℝ) :
    concreteHestenesPhaseFlowColimit (t + 2 * Real.pi) =
      concreteHestenesPhaseFlowColimit t := by
  change colim.map (constantEndNatTrans
      (concreteHestenesPhaseFlow (t + 2 * Real.pi))) =
    colim.map (constantEndNatTrans (concreteHestenesPhaseFlow t))
  rw [concreteHestenesPhaseFlow_two_pi]

def concreteHestenesDatum (v : V3) (φ : Module.Dual ℝ V3) :
    HestenesDatum (F := constantDoubledExterior3Functor) where
  dirac := constantEndNatTrans (concreteDirac3 v φ)
  laplacian := constantEndNatTrans (concreteLaplacian3 v φ)
  chirality := constantEndNatTrans concreteChirality3
  phase := constantEndNatTrans hestenesPhase3
  dirac_sq := by
    ext j x
    simpa [constantEndNatTrans, ModuleCat.comp_apply] using
      congrArg (fun f => f x) (concreteDirac3_sq v φ)
  chirality_sq := by
    ext j x
    simpa [constantEndNatTrans, ModuleCat.comp_apply] using
      congrArg (fun f => f x) concreteChirality3_sq
  dirac_odd := by
    ext j x
    have h := congrArg (fun f => f x) (concreteChirality3_odd v φ)
    have h' := congrArg (fun y : DoubledExterior3 => -y) h.symm
    simpa [constantEndNatTrans, ModuleCat.comp_apply] using h'
  phase_sq := by
    ext j x
    simpa [constantEndNatTrans, ModuleCat.comp_apply] using
      congrArg (fun f => f x) hestenesPhase3_sq
  dirac_phase := by
    ext j x
    simpa [constantEndNatTrans, ModuleCat.comp_apply] using
      (congrArg (fun f => f x) (concreteDirac3_phase v φ)).symm

def concreteHestenesDiracColimit (v : V3) (φ : Module.Dual ℝ V3) :
    colimit constantDoubledExterior3Functor ⟶ colimit constantDoubledExterior3Functor :=
  diracColimit (concreteHestenesDatum v φ).toDatum

theorem concreteHestenesPhaseFlowColimit_commutes_dirac
    (v : V3) (φ : Module.Dual ℝ V3) (t : ℝ) :
    concreteHestenesPhaseFlowColimit t ≫
        concreteHestenesDiracColimit v φ =
      concreteHestenesDiracColimit v φ ≫
        concreteHestenesPhaseFlowColimit t := by
  change colim.map (constantEndNatTrans (concreteHestenesPhaseFlow t)) ≫
      colim.map (constantEndNatTrans (concreteDirac3 v φ)) =
    colim.map (constantEndNatTrans (concreteDirac3 v φ)) ≫
      colim.map (constantEndNatTrans (concreteHestenesPhaseFlow t))
  rw [← colim.map_comp, ← colim.map_comp]
  congr 1
  ext j x
  simpa [constantEndNatTrans, ModuleCat.comp_apply] using
    (congrArg (fun f => f x) (concreteHestenesPhaseFlow_commutes_dirac t v φ)).symm

def concreteHestenesLaplacianColimit (v : V3) (φ : Module.Dual ℝ V3) :
    colimit constantDoubledExterior3Functor ⟶ colimit constantDoubledExterior3Functor :=
  laplacianColimit (concreteHestenesDatum v φ).toDatum

def concreteHestenesChiralityColimit :
    colimit constantDoubledExterior3Functor ⟶ colimit constantDoubledExterior3Functor :=
  chiralityColimit (concreteHestenesDatum (0 : V3) (0 : Module.Dual ℝ V3)).toDatum

theorem concreteHestenesDiracColimit_sq (v : V3) (φ : Module.Dual ℝ V3) :
    concreteHestenesDiracColimit v φ ≫ concreteHestenesDiracColimit v φ =
      concreteHestenesLaplacianColimit v φ := by
  exact diracColimit_sq (concreteHestenesDatum v φ).toDatum

theorem concreteHestenesDiracColimit_on_stage
    (v : V3) (φ : Module.Dual ℝ V3) (j : ℕ) (x : DoubledExterior3) :
    concreteHestenesDiracColimit v φ
        ((colimit.ι constantDoubledExterior3Functor j).hom x) =
      (colimit.ι constantDoubledExterior3Functor j).hom
        (concreteDirac3 v φ x) := by
  have h := diracColimit_on_stage (concreteHestenesDatum v φ).toDatum j
  exact congrArg (fun f => f x) h

theorem concreteHestenesChiralityColimit_sq :
    concreteHestenesChiralityColimit ≫ concreteHestenesChiralityColimit =
      𝟙 (colimit constantDoubledExterior3Functor) := by
  exact chiralityColimit_sq
    (concreteHestenesDatum (0 : V3) (0 : Module.Dual ℝ V3)).toDatum

theorem concreteHestenesDiracColimit_odd (v : V3) (φ : Module.Dual ℝ V3) :
    chiralityColimit (concreteHestenesDatum v φ).toDatum ≫
        concreteHestenesDiracColimit v φ =
      -(concreteHestenesDiracColimit v φ ≫
        chiralityColimit (concreteHestenesDatum v φ).toDatum) :=
  diracColimit_odd (concreteHestenesDatum v φ).toDatum

theorem concreteHestenesPhaseColimit_sq (v : V3) (φ : Module.Dual ℝ V3) :
    phaseColimit (concreteHestenesDatum v φ) ≫
        phaseColimit (concreteHestenesDatum v φ) =
      -(𝟙 (colimit constantDoubledExterior3Functor)) :=
  phaseColimit_sq (concreteHestenesDatum v φ)

theorem concreteHestenesPhaseColimit_chirality_commutes :
    phaseColimit (concreteHestenesDatum (0 : V3) (0 : Module.Dual ℝ V3)) ≫
        concreteHestenesChiralityColimit =
      concreteHestenesChiralityColimit ≫
        phaseColimit (concreteHestenesDatum (0 : V3) (0 : Module.Dual ℝ V3)) := by
  let D₀ := concreteHestenesDatum (0 : V3) (0 : Module.Dual ℝ V3)
  change colim.map D₀.phase ≫ colim.map D₀.chirality =
    colim.map D₀.chirality ≫ colim.map D₀.phase
  rw [← colim.map_comp, ← colim.map_comp]
  congr 1
  ext j x
  simpa [constantEndNatTrans, ModuleCat.comp_apply] using
    (congrArg (fun T => T x) concreteHestenesPhase_chirality_commutes).symm

/-! The preceding theorem is the canonical zero-parameter readout.  The
concrete phase and the concrete chirality are independent of the datum
parameters, so the same commutation descends for every finite Hodge--Dirac
datum in this family. -/

theorem concreteHestenesPhaseColimit_chirality_commutes_of
    (v : V3) (φ : Module.Dual ℝ V3) :
    phaseColimit (concreteHestenesDatum v φ) ≫
        chiralityColimit (concreteHestenesDatum v φ).toDatum =
      chiralityColimit (concreteHestenesDatum v φ).toDatum ≫
        phaseColimit (concreteHestenesDatum v φ) := by
  let D := concreteHestenesDatum v φ
  change colim.map D.phase ≫ colim.map D.chirality =
    colim.map D.chirality ≫ colim.map D.phase
  rw [← colim.map_comp, ← colim.map_comp]
  congr 1
  ext j x
  simpa [constantEndNatTrans, ModuleCat.comp_apply] using
    (congrArg (fun T => T x) concreteHestenesPhase_chirality_commutes).symm

theorem concreteHestenesPhaseColimit_on_stage
    (v : V3) (φ : Module.Dual ℝ V3) (j : ℕ) (x : DoubledExterior3) :
    phaseColimit (concreteHestenesDatum v φ)
        ((colimit.ι constantDoubledExterior3Functor j).hom x) =
      (colimit.ι constantDoubledExterior3Functor j).hom
        (hestenesPhase3 x) := by
  have h := phaseColimit_on_stage (concreteHestenesDatum v φ) j
  exact congrArg (fun f => f x) h

theorem concreteHestenesDiracColimit_phase (v : V3) (φ : Module.Dual ℝ V3) :
    phaseColimit (concreteHestenesDatum v φ) ≫ concreteHestenesDiracColimit v φ =
      concreteHestenesDiracColimit v φ ≫ phaseColimit (concreteHestenesDatum v φ) :=
  diracColimit_phase (concreteHestenesDatum v φ)

theorem concreteHestenesPhaseColimit_laplacian (v : V3) (φ : Module.Dual ℝ V3) :
    phaseColimit (concreteHestenesDatum v φ) ≫
        concreteHestenesLaplacianColimit v φ =
      concreteHestenesLaplacianColimit v φ ≫
        phaseColimit (concreteHestenesDatum v φ) :=
  phaseColimit_laplacian (concreteHestenesDatum v φ)

theorem concreteHestenesPhaseDiracColimit_sq (v : V3) (φ : Module.Dual ℝ V3) :
    (phaseColimit (concreteHestenesDatum v φ) ≫
        concreteHestenesDiracColimit v φ) ≫
        (phaseColimit (concreteHestenesDatum v φ) ≫
          concreteHestenesDiracColimit v φ) =
      -(concreteHestenesLaplacianColimit v φ) :=
  phaseDiracColimit_sq (concreteHestenesDatum v φ)

/-! The two even Hestenes readouts are exposed together for downstream
consumers: the phase preserves the Laplacian and its insertion into the odd
Dirac operator squares to the negative Laplacian. -/
theorem concreteHestenesColimit_hestenes_hodge_packet
    (v : V3) (φ : Module.Dual ℝ V3) :
    (phaseColimit (concreteHestenesDatum v φ) ≫
        concreteHestenesLaplacianColimit v φ =
      concreteHestenesLaplacianColimit v φ ≫
        phaseColimit (concreteHestenesDatum v φ)) ∧
    ((phaseColimit (concreteHestenesDatum v φ) ≫
        concreteHestenesDiracColimit v φ) ≫
        (phaseColimit (concreteHestenesDatum v φ) ≫
          concreteHestenesDiracColimit v φ) =
      -(concreteHestenesLaplacianColimit v φ)) := by
  exact ⟨concreteHestenesPhaseColimit_laplacian v φ,
    concreteHestenesPhaseDiracColimit_sq v φ⟩

/-! A single reusable readout for the concrete doubled colimit packet.  Each
component is an equality of native `ModuleCat` endomorphisms; no analytic
completion or convergence premise is hidden in this conjunction. -/

theorem concreteHestenesColimit_operator_packet
    (v : V3) (φ : Module.Dual ℝ V3) :
    (phaseColimit (concreteHestenesDatum v φ) ≫
        phaseColimit (concreteHestenesDatum v φ) =
      -(𝟙 (colimit constantDoubledExterior3Functor))) ∧
    (concreteHestenesDiracColimit v φ ≫
        concreteHestenesDiracColimit v φ =
      concreteHestenesLaplacianColimit v φ) ∧
    (concreteHestenesChiralityColimit ≫ concreteHestenesChiralityColimit =
      𝟙 (colimit constantDoubledExterior3Functor)) ∧
    (chiralityColimit (concreteHestenesDatum v φ).toDatum ≫
        concreteHestenesDiracColimit v φ =
      -(concreteHestenesDiracColimit v φ ≫
        chiralityColimit (concreteHestenesDatum v φ).toDatum)) ∧
    (phaseColimit (concreteHestenesDatum v φ) ≫
        concreteHestenesDiracColimit v φ =
      concreteHestenesDiracColimit v φ ≫
        phaseColimit (concreteHestenesDatum v φ)) ∧
    (phaseColimit (concreteHestenesDatum (0 : V3) (0 : Module.Dual ℝ V3)) ≫
        concreteHestenesChiralityColimit =
      concreteHestenesChiralityColimit ≫
        phaseColimit (concreteHestenesDatum (0 : V3) (0 : Module.Dual ℝ V3))) := by
  exact ⟨concreteHestenesPhaseColimit_sq v φ,
    concreteHestenesDiracColimit_sq v φ,
    concreteHestenesChiralityColimit_sq,
    concreteHestenesDiracColimit_odd v φ,
    concreteHestenesDiracColimit_phase v φ,
    concreteHestenesPhaseColimit_chirality_commutes⟩

end InfoGeometry.Canonical.ConcreteChiralHodgeDiracHestenesColimit
