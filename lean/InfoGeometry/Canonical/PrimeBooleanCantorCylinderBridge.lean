import InfoGeometry.Canonical.FormalPrimeRootSystem
import InfoGeometry.Canonical.CantorCylinderLattice

/-!
# InfoGeometry.Canonical.PrimeBooleanCantorCylinderBridge

Honest structural bridge between the finite prime Boolean algebra `B(P)` of
`FormalPrimeRootSystem` and the level-`n` Cantor cylinder lattice
`Set (BinaryWord n)` of `CantorCylinderLattice` (for `n = |P|`).

Because `Set (BinaryWord n)` has cardinality `2^(2^n)` while `B(P)` has
cardinality `2^n`, the two Boolean lattices are **not** isomorphic.  Instead,
this file constructs and proves the two exact canonical embeddings:

1. **Downset / ideal embedding** `downsetCylinder : Finset (Fin n) → Set (BinaryWord n)`,
   `S ↦ { w | supp(w) ⊆ S }`: an injective order embedding and meet-semilattice
   homomorphism (`downsetCylinder_subset_iff`, `downsetCylinder_inter`,
   `downsetCylinder_univ`), honestly recording that `downsetCylinder ∅ ≠ ∅`.
2. **Weight-1 cylinder-atom embedding** `atomCylinderMap : Finset (Fin n) → Set (BinaryWord n)`,
   `S ↦ ⋃ i ∈ S, cylinder n (basisWord i)`: an injective `⊥`-preserving
   lattice and set-difference homomorphism (`atomCylinderMap_empty`,
   `atomCylinderMap_union`, `atomCylinderMap_inter`, `atomCylinderMap_sdiff`,
   `atomCylinderMap_injective`) embedding `B(P)` onto the Boolean sublattice
   generated by the `n` weight-1 Cantor cylinder atoms.
3. **Weyl sign / bit-support readout** connecting `BinaryWord n` to
   `FormalPrimeRootSystem.BooleanWeylGroup L` and `weylSign`.
-/

namespace InfoGeometry.Canonical.PrimeBooleanCantorCylinderBridge

open InfoGeometry.Canonical.FormalPrimeRootSystem
open InfoGeometry.Canonical.CantorCylinderLattice

/-! ## 1. Binary word support and basis words -/

/-- The support of a level-`n` binary word: coordinates where the bit is `true`. -/
def wordSupport {n : ℕ} (w : BinaryWord n) : Finset (Fin n) :=
  Finset.univ.filter fun i => w i = true

@[simp] theorem mem_wordSupport {n : ℕ} (w : BinaryWord n) (i : Fin n) :
    i ∈ wordSupport w ↔ w i = true := by
  simp [wordSupport]

/-- Indicator binary word `χ_S : BinaryWord n` of a subset `S ⊆ Fin n`. -/
def indicatorWord {n : ℕ} (S : Finset (Fin n)) : BinaryWord n :=
  fun i => decide (i ∈ S)

@[simp] theorem wordSupport_indicatorWord {n : ℕ} (S : Finset (Fin n)) :
    wordSupport (indicatorWord S) = S := by
  ext i
  simp [wordSupport, indicatorWord]

/-- Weight-1 basis word `e_i : BinaryWord n` with a single `true` bit at `i`. -/
def basisWord {n : ℕ} (i : Fin n) : BinaryWord n :=
  fun j => decide (j = i)

@[simp] theorem basisWord_apply_self {n : ℕ} (i : Fin n) :
    basisWord i i = true := by
  simp [basisWord]

theorem basisWord_injective {n : ℕ} :
    Function.Injective (basisWord (n := n)) := by
  intro i j h
  have hi := congrFun h i
  simp [basisWord] at hi
  exact hi

@[simp] theorem wordSupport_basisWord {n : ℕ} (i : Fin n) :
    wordSupport (basisWord i) = {i} := by
  ext j
  simp [wordSupport, basisWord]

/-! ## 2. Downset cylinder embedding `S ↦ { w | supp(w) ⊆ S }` -/

/-- Downset cylinder map sending `S ⊆ Fin n` to all binary words supported in `S`. -/
def downsetCylinder {n : ℕ} (S : Finset (Fin n)) : Set (BinaryWord n) :=
  { w : BinaryWord n | wordSupport w ⊆ S }

@[simp] theorem mem_downsetCylinder {n : ℕ} {S : Finset (Fin n)} {w : BinaryWord n} :
    w ∈ downsetCylinder S ↔ wordSupport w ⊆ S :=
  Iff.rfl

theorem indicatorWord_mem_downsetCylinder {n : ℕ} (S : Finset (Fin n)) :
    indicatorWord S ∈ downsetCylinder S := by
  simp [downsetCylinder]

theorem downsetCylinder_subset_iff {n : ℕ} (S T : Finset (Fin n)) :
    downsetCylinder S ⊆ downsetCylinder T ↔ S ⊆ T := by
  constructor
  · intro h
    have hmem : indicatorWord S ∈ downsetCylinder T :=
      h (indicatorWord_mem_downsetCylinder S)
    simpa [downsetCylinder] using hmem
  · intro hST w hw
    exact hw.trans hST

theorem downsetCylinder_injective {n : ℕ} :
    Function.Injective (downsetCylinder (n := n)) := by
  intro S T h
  apply Finset.Subset.antisymm
  · exact (downsetCylinder_subset_iff S T).mp (h ▸ Set.Subset.rfl)
  · exact (downsetCylinder_subset_iff T S).mp (h.symm ▸ Set.Subset.rfl)

theorem downsetCylinder_inter {n : ℕ} (S T : Finset (Fin n)) :
    downsetCylinder (S ∩ T) = downsetCylinder S ∩ downsetCylinder T := by
  ext w
  simp [downsetCylinder, Finset.subset_inter_iff]

theorem downsetCylinder_univ {n : ℕ} :
    downsetCylinder (Finset.univ : Finset (Fin n)) = Set.univ := by
  ext w
  simp [downsetCylinder]

/-- Honesty check: the downset map sends `∅` to `{all-false}`, not `∅`. -/
theorem downsetCylinder_empty_ne_empty {n : ℕ} :
    downsetCylinder (n := n) ∅ ≠ ∅ := by
  intro h
  have hmem : indicatorWord (∅ : Finset (Fin n)) ∈ (∅ : Set (BinaryWord n)) := by
    rw [← h]
    exact indicatorWord_mem_downsetCylinder ∅
  exact hmem

/-! ## 3. Weight-1 Cantor cylinder-atom embedding -/

/-- Embed `B(n)` into `Set (BinaryWord n)` via the union of weight-1 singleton
Cantor cylinders `⋃ i ∈ S, cylinder n (basisWord i)`. -/
def atomCylinderMap {n : ℕ} (S : Finset (Fin n)) : Set (BinaryWord n) :=
  ⋃ i ∈ S, cylinder n (basisWord i)

theorem mem_atomCylinderMap {n : ℕ} {S : Finset (Fin n)} {w : BinaryWord n} :
    w ∈ atomCylinderMap S ↔ ∃ i ∈ S, w = basisWord i := by
  simp [atomCylinderMap, cylinder]

@[simp] theorem basisWord_mem_atomCylinderMap {n : ℕ} {S : Finset (Fin n)} {i : Fin n} :
    basisWord i ∈ atomCylinderMap S ↔ i ∈ S := by
  rw [mem_atomCylinderMap]
  constructor
  · rintro ⟨j, hj, hji⟩
    exact (basisWord_injective hji) ▸ hj
  · intro hi
    exact ⟨i, hi, rfl⟩

theorem atomCylinderMap_empty {n : ℕ} :
    atomCylinderMap (n := n) ∅ = ⊥ := by
  ext w
  simp [atomCylinderMap]

theorem atomCylinderMap_union {n : ℕ} (S T : Finset (Fin n)) :
    atomCylinderMap (S ∪ T) = atomCylinderMap S ⊔ atomCylinderMap T := by
  ext w
  simp only [mem_atomCylinderMap, Finset.mem_union, Set.sup_eq_union, Set.mem_union]
  constructor
  · rintro ⟨i, hi | hi, rfl⟩
    · exact Or.inl ⟨i, hi, rfl⟩
    · exact Or.inr ⟨i, hi, rfl⟩
  · rintro (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩)
    · exact ⟨i, Or.inl hi, rfl⟩
    · exact ⟨i, Or.inr hi, rfl⟩

theorem atomCylinderMap_inter {n : ℕ} (S T : Finset (Fin n)) :
    atomCylinderMap (S ∩ T) = atomCylinderMap S ⊓ atomCylinderMap T := by
  ext w
  simp only [mem_atomCylinderMap, Finset.mem_inter, Set.inf_eq_inter, Set.mem_inter_iff]
  constructor
  · rintro ⟨i, ⟨hS, hT⟩, rfl⟩
    exact ⟨⟨i, hS, rfl⟩, ⟨i, hT, rfl⟩⟩
  · rintro ⟨⟨i, hS, rfl⟩, ⟨j, hT, hij⟩⟩
    have hEq : i = j := basisWord_injective hij
    subst hEq
    exact ⟨i, ⟨hS, hT⟩, rfl⟩

theorem atomCylinderMap_sdiff {n : ℕ} (S T : Finset (Fin n)) :
    atomCylinderMap (S \ T) = atomCylinderMap S \ atomCylinderMap T := by
  ext w
  simp only [mem_atomCylinderMap, Finset.mem_sdiff, Set.mem_sdiff]
  constructor
  · rintro ⟨i, ⟨hS, hT⟩, rfl⟩
    refine ⟨⟨i, hS, rfl⟩, ?_⟩
    rintro ⟨j, hjT, hij⟩
    exact hT ((basisWord_injective hij) ▸ hjT)
  · rintro ⟨⟨i, hS, rfl⟩, hnotT⟩
    refine ⟨i, ⟨hS, ?_⟩, rfl⟩
    intro hiT
    exact hnotT ⟨i, hiT, rfl⟩

theorem atomCylinderMap_subset_iff {n : ℕ} (S T : Finset (Fin n)) :
    atomCylinderMap S ⊆ atomCylinderMap T ↔ S ⊆ T := by
  constructor
  · intro h i hi
    exact (basisWord_mem_atomCylinderMap (S := T)).mp
      (h ((basisWord_mem_atomCylinderMap (S := S)).mpr hi))
  · intro hST w hw
    rcases (mem_atomCylinderMap.mp hw) with ⟨i, hi, rfl⟩
    exact (basisWord_mem_atomCylinderMap.mpr (hST hi))

theorem atomCylinderMap_injective {n : ℕ} :
    Function.Injective (atomCylinderMap (n := n)) := by
  intro S T h
  apply Finset.Subset.antisymm
  · exact (atomCylinderMap_subset_iff S T).mp (h ▸ Set.Subset.rfl)
  · exact (atomCylinderMap_subset_iff T S).mp (h.symm ▸ Set.Subset.rfl)

/-! ## 4. Prime cutoff Weyl-group and sign readout -/

/-- Map a binary word `w : BinaryWord n` to a `BooleanWeylGroup L` element
along a bijection `e : Fin n ≃ L.primes`. -/
def booleanWeylOfWord (L : FormalPrimeRootLattice) {n : ℕ}
    (e : Fin n ≃ L.primes) (w : BinaryWord n) : BooleanWeylGroup L where
  support := (wordSupport w).image fun i => (e i : ℕ)
  support_subset := by
    intro p hp
    rcases Finset.mem_image.mp hp with ⟨i, _, rfl⟩
    exact (e i).2

theorem card_booleanWeylOfWord_support (L : FormalPrimeRootLattice) {n : ℕ}
    (e : Fin n ≃ L.primes) (w : BinaryWord n) :
    (booleanWeylOfWord L e w).support.card = (wordSupport w).card := by
  unfold booleanWeylOfWord
  apply Finset.card_image_of_injective
  intro i j hij
  exact e.injective (Subtype.ext hij)

/-- The Weyl sign of the prime subset coded by a binary word `w` equals
`(-1)^|supp(w)|`. -/
theorem weylSign_booleanWeylOfWord (L : FormalPrimeRootLattice) {n : ℕ}
    (e : Fin n ≃ L.primes) (w : BinaryWord n) :
    weylSign (booleanWeylOfWord L e w) = (-1 : ℝ) ^ (wordSupport w).card := by
  unfold weylSign
  rw [card_booleanWeylOfWord_support]

end InfoGeometry.Canonical.PrimeBooleanCantorCylinderBridge
