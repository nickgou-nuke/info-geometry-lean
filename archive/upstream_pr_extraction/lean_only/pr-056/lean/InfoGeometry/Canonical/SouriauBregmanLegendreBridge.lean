import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith

set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false

open Matrix BigOperators

namespace SouriauBregman

variable {n : ℕ}

/-- 1. General Bregman Divergence generated by a differentiable potential Φ:
    D_Φ(x, y) = Φ(x) - Φ(y) - ⟨∇Φ(y), x - y⟩ -/
def bregmanDivergence (Phi : (Fin n → ℝ) → ℝ) (gradPhi : (Fin n → ℝ) → (Fin n → ℝ))
    (x y : Fin n → ℝ) : ℝ :=
  Phi x - Phi y - dotProduct (gradPhi y) (fun i => x i - y i)

/-- 🏆 THEOREM 1: Self-Nullity of Bregman Divergence D_Φ(x, x) = 0 -/
theorem bregmanDivergence_self_zero (Phi : (Fin n → ℝ) → ℝ)
    (gradPhi : (Fin n → ℝ) → (Fin n → ℝ)) (x : Fin n → ℝ) :
    bregmanDivergence Phi gradPhi x x = 0 := by
  dsimp [bregmanDivergence]
  have hzero : (fun i => x i - x i) = (0 : Fin n → ℝ) := by ext; simp
  rw [hzero, dotProduct_zero, sub_zero, sub_self]

/-- 🏆 THEOREM 2: Non-Negativity of Bregman Divergence under Convexity Axiom -/
theorem bregmanDivergence_nonneg (Phi : (Fin n → ℝ) → ℝ)
    (gradPhi : (Fin n → ℝ) → (Fin n → ℝ))
    (h_convex : ∀ x y : Fin n → ℝ, dotProduct (gradPhi y) (fun i => x i - y i) ≤ Phi x - Phi y)
    (x y : Fin n → ℝ) :
    0 ≤ bregmanDivergence Phi gradPhi x y := by
  dsimp [bregmanDivergence]
  have h := h_convex x y
  linarith

/-- 🏆 THEOREM 4: Bregman-Legendre Dual Divergence Identity
    D_Φ(x, y) = D_S(Q_y, Q_x) -/
theorem bregman_legendre_duality_identity (Phi S : (Fin n → ℝ) → ℝ)
    (gradPhi : (Fin n → ℝ) → (Fin n → ℝ))
    (h_legendre : ∀ x : Fin n → ℝ, S (gradPhi x) = dotProduct x (gradPhi x) - Phi x)
    (x y : Fin n → ℝ) :
    Phi x - Phi y - dotProduct (gradPhi y) (fun i => x i - y i) =
      S (gradPhi y) - S (gradPhi x) - dotProduct x (fun i => gradPhi y i - gradPhi x i) := by
  have hx := h_legendre x
  have hy := h_legendre y
  dsimp [dotProduct] at *
  have h_sum1 : (∑ i, gradPhi y i * (x i - y i)) = (∑ i, gradPhi y i * x i) - (∑ i, gradPhi y i * y i) := by
    simp_rw [mul_sub, Finset.sum_sub_distrib]
  have h_sum2 : (∑ i, x i * (gradPhi y i - gradPhi x i)) = (∑ i, x i * gradPhi y i) - (∑ i, x i * gradPhi x i) := by
    simp_rw [mul_sub, Finset.sum_sub_distrib]
  have h_comm1 : (∑ i, gradPhi y i * x i) = (∑ i, x i * gradPhi y i) := by
    congr 1; ext i; ring
  have h_comm2 : (∑ i, gradPhi y i * y i) = (∑ i, y i * gradPhi y i) := by
    congr 1; ext i; ring
  rw [hx, hy, h_sum1, h_sum2, h_comm1, h_comm2]
  ring

end SouriauBregman
