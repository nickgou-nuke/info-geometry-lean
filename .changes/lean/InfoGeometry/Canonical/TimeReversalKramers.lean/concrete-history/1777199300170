{"type":"new","contents":"import InfoGeometry.Canonical.HestenesRealStructures\nimport InfoGeometry.Meta.Architecture\n\nopen scoped InnerProductSpace\n\n/-!\n# InfoGeometry.Canonical.TimeReversalKramers\n\nStrict real time-reversal/Kramers interface on the doubled carrier.\n\nThis file encodes time reversal without external complex antiunitaries:\neverything is real-linear on `H₂`, with phase-(anti)linearity measured against\nthe internal axis `K = J ∘ ε`.\n-/\n\nnamespace InfoGeometry.Canonical.TimeReversalKramers\n\nopen InfoGeometry.Krein\nopen InfoGeometry.Canonical.HestenesRealStructures\nopen InfoGeometry.Canonical.HestenesKramersBridge\nopen InfoGeometry.Canonical.OperatorDictionary\nopen InfoGeometry.Canonical.BogoliubovTransport\n\nsection Core\n\nvariable {E : Type 0}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\n\n/--\nReal time-reversal surrogate on the doubled carrier:\nreal-linear, Krein isometric, and phase-antilinear (`ΘK = -KΘ`).\n-/\n@[rep_depth krein]\nstructure RealTimeReversal where\n  Θ : EndH\n  kreinIsometric : KreinIsometric (E := E) Θ\n  phaseAntilinear : KAntilinear (E := E) Θ\n\nnamespace RealTimeReversal\n\nvariable (R : RealTimeReversal (E := E))\n\n/-- Carrier-native anticommutation law with the internal phase axis `K`. -/\n@[rep_depth krein]\ntheorem anticomm_phaseAxisK :\n    R.Θ.comp (phaseAxisK (E := E))\n      =\n    -((phaseAxisK (E := E)).comp R.Θ) := by\n  have hAnti :\n      transportAnticommutator (E := E) R.Θ (phaseAxisK (E := E)) = 0 := by\n    exact\n      (kAntilinear_iff_phaseAxisAnticommutator_eq_zero (E := E) R.Θ).2\n        R.phaseAntilinear\n  unfold transportAnticommutator at hAnti\n  exact eq_neg_of_add_eq_zero_left hAnti\n\n/-- The canonical doubled-carrier pair generated by real time reversal. -/\n@[rep_depth krein]\nnoncomputable def pair (u : H₂) : H₂ × H₂ := (u, R.Θ u)\n\n/-- Krein pairing is preserved along the real time-reversal action. -/\n@[rep_depth krein]\ntheorem preserves_kreinInner (u v : H₂) :\n    KreinSpace.kreinInner (H := H₂) (R.Θ u) (R.Θ v)\n      = KreinSpace.kreinInner (H := H₂) u v :=\n  R.kreinIsometric u v\n\n/--\nOwner bridge to the intrinsic Hestenes partner map:\nevery real time-reversal surrogate `Θ` sends `K u` to `-K(Θ u)`.\n-/\n@[rep_depth krein]\ntheorem map_phasePartner_eq_neg_phasePartner_map (u : H₂) :\n    R.Θ (phasePartner (E := E) u)\n      =\n    -(phasePartner (E := E) (R.Θ u)) := by\n  have hAnti := R.anticomm_phaseAxisK\n  have hApply := congrArg (fun F : EndH => F u) hAnti\n  simpa [phasePartner] using hApply\n\n/--\nPair transport law against the intrinsic phase partner:\n`pair (K u) = (K u, -K (Θ u))`.\n-/\n@[rep_depth krein]\ntheorem pair_phasePartner (u : H₂) :\n    R.pair (phasePartner (E := E) u)\n      = (phasePartner (E := E) u, -(phasePartner (E := E) (R.Θ u))) := by\n  change (phasePartner (E := E) u, R.Θ (phasePartner (E := E) u))\n      = (phasePartner (E := E) u, -(phasePartner (E := E) (R.Θ u)))\n  rw [R.map_phasePartner_eq_neg_phasePartner_map (u := u)]\n\nend RealTimeReversal\n\n/-- Kramers specialization: real time reversal with square `-1`. -/\n@[rep_depth krein]\nstructure KramersTimeReversal extends RealTimeReversal (E := E) where\n  square_neg : Θ.comp Θ = -(ContinuousLinearMap.id ℝ H₂)\n\nnamespace KramersTimeReversal\n\nvariable (R : KramersTimeReversal (E := E))\n\n/-- Forgetful map to the previously owned `KramersSymmetry` interface. -/\n@[rep_depth krein]\ndef toKramersSymmetry : KramersSymmetry (E := E) where\n  Θ := R.Θ\n  kreinIsometric := R.kreinIsometric\n  phaseAntilinear := R.phaseAntilinear\n  square_neg := R.square_neg\n\n/-- Nontriviality of Kramers partner for nonzero vectors. -/\n@[rep_depth krein]\ntheorem partner_ne_self_of_ne_zero {u : H₂} (hu : u ≠ 0) :\n    R.Θ u ≠ u := by\n  simpa [toKramersSymmetry] using\n    (KramersSymmetry.partner_ne_self_of_ne_zero (E := E) (S := R.toKramersSymmetry) hu)\n\n/--\nKramers specialization of the intrinsic partner anti-transport law:\n`Θ (K u) = -K (Θ u)`.\n-/\n@[rep_depth krein]\ntheorem map_phasePartner_eq_neg_phasePartner_map (u : H₂) :\n    R.Θ (phasePartner (E := E) u)\n      =\n    -(phasePartner (E := E) (R.Θ u)) := by\n  simpa using\n    (RealTimeReversal.map_phasePartner_eq_neg_phasePartner_map\n      (E := E) (R := R.toRealTimeReversal) u)\n\nend KramersTimeReversal\n\nend Core\n\nend InfoGeometry.Canonical.TimeReversalKramers\n","mtime":1777199300170}