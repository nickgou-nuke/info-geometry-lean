"""Finite spinor-lift kernel certificate for the signed Weyl subgroup.

This is an exact QQ computation.  It concerns the finite signed-mode lift
subgroup generated by adjacent mode swaps and one mode-sign lift; it is not a
classification of the kernel of the full continuous split-Pin group.
"""

load("tools/experiments/cl55_five_grade/01_cl55_witt_generators.sage")
import json


def mode_bit(i):
    return 1 << (4 - i)


def permutation_lift(permutation):
    U = zero_matrix(Q, 32)
    for mask in range(32):
        selected = [i for i in range(5) if mask & mode_bit(i)]
        target = sum(mode_bit(permutation[i]) for i in selected)
        inversions = sum(
            permutation[i] > permutation[j]
            for position, i in enumerate(selected)
            for j in selected[position + 1:])
        U[target, mask] = (-1) ** inversions
    return U


generators = []
for i in range(4):
    permutation = list(range(5))
    permutation[i], permutation[i + 1] = permutation[i + 1], permutation[i]
    generators.append(permutation_lift(permutation))
generators.append(positive_gamma[0] * negative_gamma[0])
# The scalar central lift is separate from the signed-mode section.
generators.append(-Id)


def key(M):
    return tuple(M.list())


seen = {key(Id): Id}
frontier = [Id]
while frontier:
    current = frontier.pop()
    for generator in generators:
        candidate = generator * current
        candidate_key = key(candidate)
        if candidate_key not in seen:
            seen[candidate_key] = candidate
            frontier.append(candidate)


cartan = [creators[i] * annihilators[i] - (1 / 2) * Id
          for i in range(5)]


def cartan_action(U):
    Uinv = U.transpose()
    images = [U * H * Uinv for H in cartan]
    result = []
    for image in images:
        found = None
        for j, H in enumerate(cartan):
            if image == H:
                found = (1, j)
            if image == -H:
                found = (-1, j)
        assert found is not None
        result.append(found)
    return tuple(result)


actions = {key(U): cartan_action(U) for U in seen.values()}
identity_action = tuple((1, i) for i in range(5))
cartan_kernel = [U for U in seen.values()
                 if cartan_action(U) == identity_action]


def witt_action_is_identity(U):
    Uinv = U.transpose()
    return all(U * X * Uinv == X for X in lie_basis)


kernel = [U for U in seen.values() if witt_action_is_identity(U)]
scalar_kernel = [U for U in kernel if U == Id or U == -Id]

assert len(seen) == 2 * 2 ** 5 * factorial(5)
assert len(kernel) == 2
assert len(scalar_kernel) == 2

report = {
    "coefficient_field": "QQ",
    "spinor_dimension": 32,
    "generator_count": len(generators),
    "lift_group_order": len(seen),
    "projected_signed_group_order": 2 ** 5 * factorial(5),
    "cartan_action_order": len(set(actions.values())),
    "cartan_action_kernel_order": len(cartan_kernel),
    "witt_lie_action_kernel_order": len(kernel),
    "witt_lie_action_kernel_is_scalar_pm_identity": len(scalar_kernel) == 2,
    "scope": "finite_signed_mode_lift_only",
    "full_split_pin_kernel_proved": False,
}

output = "tools/experiments/cl55_five_grade/export/pin_weyl_kernel.json"
with open(output, "w") as stream:
    json.dump(report, stream, indent=2, sort_keys=True, default=int)

print("SAGE:finite_lift_group_order=%d" % len(seen))
print("SAGE:cartan_action_kernel_order=%d" % len(kernel))
print("SAGE:cartan_kernel_is_pm_identity=true")
print("SAGE:full_split_pin_kernel_proved=false")
print("SAGE:report=%s" % output)
