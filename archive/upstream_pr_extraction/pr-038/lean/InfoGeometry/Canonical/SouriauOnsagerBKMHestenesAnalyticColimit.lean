import InfoGeometry.Canonical.FilteredHestenesKreinColimit
import InfoGeometry.Canonical.SouriauOnsagerBKMFilteredColimit

noncomputable section

/-!
# Hestenes analytic descent of filtered Kubo--Mori kernels

The analytic parameter in this owner is the operator phase generated by
multiplication by `Complex.I`.  Thus analyticity is expressed by the
coordinate-free Hestenes phase law `K² = -1`, not by coordinate charts,
epsilon limits, or an independently postulated power series.

The finite-stage kernels are the genuine noncommutative Kubo--Mori
functionals from `SouriauOnsagerBKMBridge`.  Their stage independence is the
direct/inverse-colimit theorem from
`SouriauOnsagerBKMFilteredColimit`.  A continuous complex-linear functional
on the colimit carrier then has a native Cauchy--Hestenes derivative, and its
restriction to every finite stage is the corresponding Kubo--Mori kernel.
-/

namespace InfoGeometry.Canonical.SouriauOnsagerBKMHestenesAnalyticColimit

open SouriauOnsagerBKM
open FilteredColimit
open FilteredColimit.InductiveCocone
open InfoGeometry.Krein
open InfoGeometry.Geometry.BilingualAnalyticity
open InfoGeometry.Canonical.HestenesAnalyticity
open InfoGeometry.Canonical.SouriauOnsagerBKMFilteredColimit

/-- The coordinate-free Cartan phase axis on a complex normed module,
regarded as a real continuous-linear operator. -/
def complexModuleAxis
    (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E] :
    E →L[ℝ] E :=
  (Complex.I • ContinuousLinearMap.id ℂ E).restrictScalars ℝ

/-- Hestenes phase structure carried by any complex normed module. -/
def complexModulePhase
    (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E] :
    PhaseStructure E where
  K := complexModuleAxis E
  K_square := by
    apply ContinuousLinearMap.ext
    intro x
    change Complex.I • (Complex.I • x) = -x
    rw [← mul_smul, Complex.I_mul_I]
    simp

/-- A complex continuous-linear map intertwines the Hestenes phase axes after
restriction of scalars. -/
theorem complexLinearMap_isPhaseLinear
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℂ E]
    [NormedAddCommGroup F] [NormedSpace ℂ F]
    (L : E →L[ℂ] F) :
    (complexModulePhase E).IsPhaseLinearMap
      (L.restrictScalars ℝ) (complexModulePhase F) := by
  apply ContinuousLinearMap.ext
  intro x
  change L (Complex.I • x) = Complex.I • L x
  exact L.map_smul Complex.I x

/-- Componentwise transport of a real continuous-linear map to the canonical
Krein doubled carriers. -/
def doubledContinuousLinearMap
    {E F : Type}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    (L : E →L[ℝ] F) :
    DoubledSpace E →L[ℝ] DoubledSpace F where
  toFun v := to_doubled (L (WithLp.fst v)) (L (WithLp.snd v))
  map_add' u v := by
    apply DoubledSpace.ext <;> simp
  map_smul' c v := by
    apply DoubledSpace.ext <;> simp
  cont := by
    simpa [to_doubled] using
      (WithLp.prod_continuous_toLp
          (p := (2 : ENNReal)) (α := F) (β := F)).comp
        ((L.cont.comp
            (WithLp.continuous_fst
              (p := (2 : ENNReal)) (α := E) (β := E))).prodMk
          (L.cont.comp
            (WithLp.continuous_snd
              (p := (2 : ENNReal)) (α := E) (β := E))))

@[simp] theorem doubledContinuousLinearMap_apply_fst
    {E F : Type}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    (L : E →L[ℝ] F) (v : DoubledSpace E) :
    WithLp.fst (doubledContinuousLinearMap L v) =
      L (WithLp.fst v) :=
  rfl

@[simp] theorem doubledContinuousLinearMap_apply_snd
    {E F : Type}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    (L : E →L[ℝ] F) (v : DoubledSpace E) :
    WithLp.snd (doubledContinuousLinearMap L v) =
      L (WithLp.snd v) :=
  rfl

/-- Componentwise operator transport commutes with the canonical Hestenes
clock axis `K = Jε`.  This is the real-doubled Krein realization of
coordinate-free complex linearity. -/
theorem doubledContinuousLinearMap_isHestenes
    {E F : Type}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    (L : E →L[ℝ] F) :
    IsHestenesHolomorphicDifferential
      (E := E) (F := F) (doubledContinuousLinearMap L) := by
  apply ContinuousLinearMap.ext
  intro v
  apply DoubledSpace.ext <;>
    simp [doubledContinuousLinearMap, clockAxis, complex_i,
      modular_j, spectral_epsilon]

/-- The fixed-Cartan-parameter Kubo--Mori kernel as a continuous
complex-linear functional on the full finite operator algebra.  Continuity is
obtained from native finite-dimensionality, not from diagonalization. -/
def kuboMoriKernelCLM
    {n : ℕ}
    (D : FaithfulDensityOperator n)
    (A : FiniteOperatorAlgebra n) (s : ℝ) :
    FiniteOperatorAlgebra n →L[ℂ] ℂ :=
  LinearMap.toContinuousLinearMap
    (D.kuboMoriKernelFunctional A s)

@[simp] theorem kuboMoriKernelCLM_apply
    {n : ℕ}
    (D : FaithfulDensityOperator n)
    (A B : FiniteOperatorAlgebra n) (s : ℝ) :
    kuboMoriKernelCLM D A s B =
      D.kuboMoriIntegrand A B s :=
  rfl

/-- Every finite-stage noncommutative Kubo--Mori kernel is Cauchy--Hestenes
analytic in the observable argument. -/
def kuboMoriKernelCauchyAnalyticAt
    {n : ℕ}
    (D : FaithfulDensityOperator n)
    (A B : FiniteOperatorAlgebra n) (s : ℝ) :
    CauchyAnalyticAt
      (complexModulePhase (FiniteOperatorAlgebra n))
      (complexModulePhase ℂ)
      (fun X => D.kuboMoriIntegrand A X s) B :=
  CauchyAnalyticAt.ofContinuousLinearMap
    (complexModulePhase (FiniteOperatorAlgebra n))
    (complexModulePhase ℂ)
    ((kuboMoriKernelCLM D A s).restrictScalars ℝ)
    (complexLinearMap_isPhaseLinear (kuboMoriKernelCLM D A s))
    B

@[simp] theorem kuboMoriKernelCauchyAnalyticAt_deriv
    {n : ℕ}
    (D : FaithfulDensityOperator n)
    (A B : FiniteOperatorAlgebra n) (s : ℝ) :
    (kuboMoriKernelCauchyAnalyticAt D A B s).deriv =
      (kuboMoriKernelCLM D A s).restrictScalars ℝ :=
  rfl

variable {I : Type*} [Preorder I]
variable (dim : I → ℕ)
variable
  (sys : DirectInductiveSystem ℂ I (OperatorStage dim))
  (D : ∀ i, FaithfulDensityOperator (dim i))
  (A : ∀ i, FiniteOperatorAlgebra (dim i))
  (s : ℝ)

variable {Ainf : Type}
variable [NormedAddCommGroup Ainf] [NormedSpace ℂ Ainf]
variable
  (cocone : InductiveCocone ℂ sys Ainf)
  (Phi : Ainf →L[ℂ] ℂ)

/-- A continuous complex-linear Kubo--Mori functional on the categorical
colimit carrier is Cauchy--Hestenes analytic at every colimit point. -/
def colimitKernelCauchyAnalyticAt
    (x : Ainf) :
    CauchyAnalyticAt
      (complexModulePhase Ainf)
      (complexModulePhase ℂ)
      (fun y => Phi y) x :=
  CauchyAnalyticAt.ofContinuousLinearMap
    (complexModulePhase Ainf)
    (complexModulePhase ℂ)
    (Phi.restrictScalars ℝ)
    (complexLinearMap_isPhaseLinear Phi)
    x

@[simp] theorem colimitKernelCauchyAnalyticAt_deriv
    (x : Ainf) :
    (colimitKernelCauchyAnalyticAt Phi x).deriv =
      Phi.restrictScalars ℝ :=
  rfl

section KreinRealization

variable [InnerProductSpace ℝ Ainf] [CompleteSpace Ainf]

/-- The global Kubo--Mori functional lifted to the canonical real-doubled
Krein carriers.  Both legs retain the full colimit observable; this is not a
diagonal restriction of the operator algebra. -/
def doubledColimitKernel :
    DoubledSpace Ainf →L[ℝ] DoubledSpace ℂ :=
  doubledContinuousLinearMap (Phi.restrictScalars ℝ)

/-- The doubled global Kubo--Mori functional is Hestenes-holomorphic with
respect to the native clock axes. -/
theorem doubledColimitKernel_isHestenes :
    IsHestenesHolomorphicDifferential
      (E := Ainf) (F := ℂ) (doubledColimitKernel Phi) :=
  doubledContinuousLinearMap_isHestenes (Phi.restrictScalars ℝ)

/-- Native Hestenes--Krein analyticity of the doubled global kernel at every
point of the categorical colimit carrier. -/
def doubledColimitKernelCauchyAnalyticAt
    (x : DoubledSpace Ainf) :
    CauchyAnalyticAt
      (clockPhaseStructure Ainf)
      (clockPhaseStructure ℂ)
      (fun y => doubledColimitKernel Phi y) x :=
  CauchyAnalyticAt.ofContinuousLinearMap
    (clockPhaseStructure Ainf)
    (clockPhaseStructure ℂ)
    (doubledColimitKernel Phi)
    (doubledColimitKernel_isHestenes Phi)
    x

@[simp] theorem doubledColimitKernelCauchyAnalyticAt_deriv
    (x : DoubledSpace Ainf) :
    (doubledColimitKernelCauchyAnalyticAt Phi x).deriv =
      doubledColimitKernel Phi :=
  rfl

/-- The Hestenes clock-axis law for the doubled categorical BKM kernel. -/
theorem doubledColimitKernel_clockAxis
    (x v : DoubledSpace Ainf) :
    (doubledColimitKernelCauchyAnalyticAt Phi x).deriv
        (clockAxis (E := Ainf) v) =
      clockAxis (E := ℂ)
        ((doubledColimitKernelCauchyAnalyticAt Phi x).deriv v) :=
  (doubledColimitKernelCauchyAnalyticAt Phi x).cauchyRiemann_apply v

end KreinRealization

/-- The global colimit derivative satisfies the operator-phase
Cauchy--Riemann law generated by the Cartan axis. -/
theorem colimitKernel_cauchyRiemann
    (x v : Ainf) :
    (colimitKernelCauchyAnalyticAt Phi x).deriv
        (complexModuleAxis Ainf v) =
      complexModuleAxis ℂ
        ((colimitKernelCauchyAnalyticAt Phi x).deriv v) :=
  (colimitKernelCauchyAnalyticAt Phi x).cauchyRiemann_apply v

/-- Filtered stage independence and global Hestenes analyticity form one
descent statement.  The first component is categorical; the second is the
Cartan-phase Cauchy--Riemann law on the colimit carrier. -/
theorem stageIndependent_readout_and_hestenes_descent
    (hdesc :
      ∀ i,
        Phi.toLinearMap.comp (cocone.psi i) =
          stageKernel dim D A s i)
    {i j : I} (hij : i ≤ j)
    (B : OperatorStage dim i)
    (x v : Ainf) :
    Phi (cocone.psi j (sys.f hij B)) =
        stageKernel dim D A s i B ∧
      (colimitKernelCauchyAnalyticAt Phi x).deriv
          (complexModuleAxis Ainf v) =
        complexModuleAxis ℂ
          ((colimitKernelCauchyAnalyticAt Phi x).deriv v) := by
  constructor
  · rw [cocone.cocone_eval_comm hij B]
    exact LinearMap.congr_fun (hdesc i) B
  · exact colimitKernel_cauchyRiemann Phi x v

end InfoGeometry.Canonical.SouriauOnsagerBKMHestenesAnalyticColimit
