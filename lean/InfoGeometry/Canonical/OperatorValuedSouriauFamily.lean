import Mathlib
import InfoGeometry.Canonical.SouriauOperatorialLogPotential
import InfoGeometry.Canonical.OperatorModularTemperatureDuality
import InfoGeometry.Meta.Architecture

set_option linter.dupNamespace false

noncomputable section

namespace InfoGeometry.Canonical.OperatorValuedSouriauFamily

open InfoGeometry.Canonical.SouriauOperatorialLogPotential
open InfoGeometry.Canonical.OperatorModularTemperatureDuality

/--
Operator-valued Souriau family.

`Obs` is the noncommutative observable/operator carrier. The parameter itself is
also operatorial: `betaOperator : Obs`. Scalar beta/time coordinates are not the
owner objects; they are chart/readout shadows supplied only after `eval`.
-/
structure OperatorValuedSouriauFamily
    (LieAlg Obs State Direction : Type*) where
  /-- Closed product/trace surface used by the modular-temperature duality. -/
  frobenius : OperatorFrobeniusClosure Obs

  /-- Quantum moment map / sufficient-statistic assignment. -/
  quantumMomentMap : LieAlg → Obs

  /-- Operator-valued inverse temperature / geometric-temperature direction. -/
  betaOperator : Obs

  /-- Operator-valued clock/time/dilation observable or affiliated witness. -/
  timeOperator : Obs

  /-- Modular/Souriau Hamiltonian generated by the operatorial thermal direction. -/
  souriauGenerator : Obs

  /-- Untraced exponential weight `exp(-K_B)` in the operator layer. -/
  expWeight : Obs

  /-- Operatorial exponential-family owner packet with parameter carrier `Obs`. -/
  exponentialFamily : OperatorialExponentialFamily Obs Obs

  /-- Duhamel/ordered-product derivative owner packet. -/
  duhamelDerivative : DuhamelOperatorDerivative Obs Obs Direction

  /-- State/weight carrier used only for scalar readouts. -/
  state : State

  /-- Scalar evaluation/readout map. -/
  eval : State → Obs → ℝ

  /-- Scalar free-energy/readout after evaluation. -/
  freeEnergyReadout : State → ℝ

  /-- Beta operator is admissible for the chosen Frobenius closure. -/
  beta_closed : frobenius.closed betaOperator

  /-- Time/clock operator is admissible for the chosen Frobenius closure. -/
  time_closed : frobenius.closed timeOperator

  /-- Souriau generator is admissible for the chosen Frobenius closure. -/
  souriauGenerator_closed : frobenius.closed souriauGenerator

  /-- Exponential weight is admissible for the chosen Frobenius closure. -/
  expWeight_closed : frobenius.closed expWeight

  /--
  Bridge to the existing operatorial exponential family: its generator at the
  operator beta is the Souriau generator.
  -/
  exponentialFamily_K_beta_eq_souriauGenerator :
    exponentialFamily.K betaOperator = souriauGenerator

  /--
  Bridge to the existing operatorial exponential family: its untraced exponential
  at the operator beta is the supplied operator weight.
  -/
  exponentialFamily_untraced_beta_eq_expWeight :
    exponentialFamily.untracedExponential betaOperator = expWeight

namespace OperatorValuedSouriauFamily

variable {LieAlg Obs State Direction : Type*}
variable (P : OperatorValuedSouriauFamily LieAlg Obs State Direction)

/-- The existing operatorial exponential family has generator `K_B` at operator beta. -/
theorem exponentialFamily_K_beta_eq_souriauGenerator_holds :
    P.exponentialFamily.K P.betaOperator = P.souriauGenerator :=
  P.exponentialFamily_K_beta_eq_souriauGenerator

/-- The existing operatorial exponential family has untraced weight `exp(-K_B)`. -/
theorem exponentialFamily_untraced_beta_eq_expWeight_holds :
    P.exponentialFamily.untracedExponential P.betaOperator = P.expWeight :=
  P.exponentialFamily_untraced_beta_eq_expWeight

/-- Scalar expectation of the operator beta is a readout through the supplied state. -/
def betaScalarReadout : ℝ :=
  P.eval P.state P.betaOperator

/-- Scalar expectation of the operator clock is a readout through the supplied state. -/
def timeScalarReadout : ℝ :=
  P.eval P.state P.timeOperator

/-- Scalar expectation of the modular/Souriau generator is a downstream readout. -/
def souriauGeneratorScalarReadout : ℝ :=
  P.eval P.state P.souriauGenerator

/-- The beta/K operator product remains inside the supplied Frobenius closure. -/
theorem beta_mul_souriauGenerator_closed :
    P.frobenius.closed
      (P.frobenius.product P.betaOperator P.souriauGenerator) :=
  P.frobenius.product_closed
    P.betaOperator P.souriauGenerator
    P.beta_closed P.souriauGenerator_closed

/-- The time/K operator product remains inside the supplied Frobenius closure. -/
theorem time_mul_souriauGenerator_closed :
    P.frobenius.closed
      (P.frobenius.product P.timeOperator P.souriauGenerator) :=
  P.frobenius.product_closed
    P.timeOperator P.souriauGenerator
    P.time_closed P.souriauGenerator_closed

/-- The operator beta/K action is the Frobenius trace pairing. -/
def betaSouriauAction : ℝ :=
  P.frobenius.pairing P.betaOperator P.souriauGenerator

/-- The operator clock/K action is the Frobenius trace pairing. -/
def timeSouriauAction : ℝ :=
  P.frobenius.pairing P.timeOperator P.souriauGenerator

end OperatorValuedSouriauFamily

end InfoGeometry.Canonical.OperatorValuedSouriauFamily
