{"file":"/home/goutev/repos/info-geometry-lean/external/SpectralThm/SpectralThm/Ledger.lean","time":1778535663405,"baseTime":1778535662446,"changes":[{"range":{"start":{"line":120,"character":0},"end":{"line":178,"character":0}},"text":"def moorePenroseCoimageProjector (A B : R) (_hMP : IsMoorePenroseInverse A B) : R :=\n  B * A\n\ntheorem moorePenroseRangeProjector_idempotent {A B : R} (hMP : IsMoorePenroseInverse A B) :\n    moorePenroseRangeProjector A B hMP * moorePenroseRangeProjector A B hMP =\n      moorePenroseRangeProjector A B hMP :=\n  mpProjector_idempotent hMP\n\ntheorem moorePenroseRangeProjector_self_adjoint {A B : R} (hMP : IsMoorePenroseInverse A B) :\n    star (moorePenroseRangeProjector A B hMP) = moorePenroseRangeProjector A B hMP :=\n  mpProjector_self_adjoint hMP\n\ntheorem moorePenroseCoimageProjector_idempotent {A B : R} (hMP : IsMoorePenroseInverse A B) :\n    moorePenroseCoimageProjector A B hMP * moorePenroseCoimageProjector A B hMP =\n      moorePenroseCoimageProjector A B hMP := by\n  unfold moorePenroseCoimageProjector\n  calc\n    (B * A) * (B * A) = B * (A * B * A) := by rw [← mul_assoc]\n    _ = B * A := by rw [hMP.aba_eq_a]\n\ntheorem moorePenroseCoimageProjector_self_adjoint {A B : R} (hMP : IsMoorePenroseInverse A B) :\n    star (moorePenroseCoimageProjector A B hMP) = moorePenroseCoimageProjector A B hMP :=\n  hMP.ba_star_eq\n\nend MoorePenroseWrappers\n\n/-! ## 4. Combined Drazin and Moore-Penrose Ledger -/\n\n/--\nWitness-gated structure recording both the dynamical (Drazin) and metric (MP)\nsplits for an operator.\n-/\nstructure DrazinMoorePenroseLedger\n    (R : Type*) [Ring R] [StarRing R] where\n  A : R\n  D : R\n  k : ℕ\n  drazin : IsDrazinInverse A D k\n  B : R\n  moorePenrose : IsMoorePenroseInverse A B\n\n/-- Schur normal form socket structure. -/\nstructure SchurDrazinNormalForm\n    (R : Type*) [Ring R] [StarRing R] where\n  A : R\n  U : R\n  T : R\n  hSchur : A = U * T * star U\n  hUnitary : U * star U = 1 ∧ star U * U = 1\n\n/-- SVD normal form socket structure. -/\nstructure SVDMoorePenroseNormalForm\n    (𝕜 E : Type*) [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E] where\n  A : E →L[𝕜] E\n  U : E ≃L[𝕜] E\n  V : E ≃L[𝕜] E\n  s : E →L[𝕜] E\n  hSVD : A = (U.toContinuousLinearMap.comp s).comp V.symm.toContinuousLinearMap\n","rangeOffset":4111,"rangeLength":2048}]}