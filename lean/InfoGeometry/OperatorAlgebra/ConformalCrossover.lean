/-
InfoGeometry/OperatorAlgebra/ConformalCrossover.lean

Constructive conformal crossover.

This file formalizes the small theorem that follows from the projective-null
grammar slogan:

* a nonzero null generator `k` determines a projective null ray;
* a conformal crossover map `theta` preserving nullness sends it to another
  projective null ray;
* if `theta k = a • k` with `a ≠ 0`, the projective ray survives the crossover.

No cosmological, observational, or Navier-Stokes conclusion is asserted.
-/

import Mathlib.Tactic

noncomputable section

namespace InfoGeometry.OperatorAlgebra.ConformalCrossover

/-! ## 1. Conformal crossover datum -/

/--
A linear conformal crossover datum.

`Null v` is the scale-free null predicate.  The crossover map `theta` is a
linear equivalence, intended as the algebraic part of a conformal/Möbius chart
transition.
-/
structure ConformalCrossoverDatum
    (V : Type*) [AddCommGroup V] [Module ℝ V] where
  /-- Crossover/inversion map. -/
  theta : V ≃ₗ[ℝ] V

  /-- Involutivity of the crossover. -/
  theta_involutive :
    ∀ v : V, theta (theta v) = v

  /-- Null predicate: the conformal, scale-free light condition. -/
  Null : V → Prop

  /-- Nullness is preserved by the crossover. -/
  theta_preserves_null :
    ∀ v : V, Null v → Null (theta v)

  /-- Nullness is homogeneous under real rescaling. -/
  null_smul :
    ∀ (a : ℝ) (v : V), Null v → Null (a • v)

namespace ConformalCrossoverDatum

variable {V : Type*} [AddCommGroup V] [Module ℝ V]
variable (C : ConformalCrossoverDatum V)

/-- Fixed vector under the crossover map. -/
def IsFixed
    (v : V) : Prop :=
  C.theta v = v

/-- Projectively fixed vector under the crossover map. -/
def IsProjectivelyFixed
    (v : V) : Prop :=
  ∃ a : ℝ, a ≠ 0 ∧ C.theta v = a • v

/-- A fixed vector is projectively fixed. -/
theorem projectivelyFixed_of_fixed
    {v : V}
    (hv : C.IsFixed v) :
    C.IsProjectivelyFixed v := by
  refine ⟨1, by norm_num, ?_⟩
  simpa [IsFixed] using hv

end ConformalCrossoverDatum

/-! ## 2. Projective null rays -/

/--
A projective null ray represented by a nonzero null generator.

The projective carrier is `span ℝ {generator}`.
-/
structure ProjectiveNullRay
    {V : Type*} [AddCommGroup V] [Module ℝ V]
    (C : ConformalCrossoverDatum V) where
  /-- Nonzero representative of the ray. -/
  generator : V

  /-- A projective ray cannot be generated by zero. -/
  generator_ne_zero : generator ≠ 0

  /-- The representative is null. -/
  generator_null : C.Null generator

namespace ProjectiveNullRay

variable {V : Type*} [AddCommGroup V] [Module ℝ V]
variable {C : ConformalCrossoverDatum V}

variable (P : ProjectiveNullRay C)

/-- The carrier submodule of the projective ray. -/
def carrier : Submodule ℝ V :=
  Submodule.span ℝ ({P.generator} : Set V)

/-- Two projective null rays are the same if they have the same carrier. -/
def SameRay
    (P Q : ProjectiveNullRay C) : Prop :=
  P.carrier = Q.carrier

/-- Projective equality is reflexive. -/
theorem sameRay_refl :
    SameRay P P :=
  rfl

/-- Projective equality is symmetric. -/
theorem sameRay_symm
    {P Q : ProjectiveNullRay C}
    (h : SameRay P Q) :
    SameRay Q P :=
  h.symm

/-- Projective equality is transitive. -/
theorem sameRay_trans
    {P Q R : ProjectiveNullRay C}
    (hPQ : SameRay P Q)
    (hQR : SameRay Q R) :
    SameRay P R :=
  hPQ.trans hQR

end ProjectiveNullRay

/-! ## 3. Span lemmas for projective scaling -/

/-- A nonzero scalar multiple generates the same one-dimensional submodule. -/
theorem span_singleton_smul_eq
    {V : Type*} [AddCommGroup V] [Module ℝ V]
    {k : V}
    {a : ℝ}
    (ha : a ≠ 0) :
    Submodule.span ℝ ({a • k} : Set V) =
      Submodule.span ℝ ({k} : Set V) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    intro x hx
    have hx' : x = a • k := by
      simpa using hx
    rw [hx']
    exact
      Submodule.smul_mem
        (Submodule.span ℝ ({k} : Set V))
        a
        (Submodule.subset_span (show k ∈ ({k} : Set V) by simp))
  · apply Submodule.span_le.mpr
    intro x hx
    have hx' : x = k := by
      simpa using hx
    rw [hx']
    have hmem : a • k ∈ Submodule.span ℝ ({a • k} : Set V) :=
      Submodule.subset_span (show a • k ∈ ({a • k} : Set V) by simp)
    convert
      Submodule.smul_mem
        (Submodule.span ℝ ({a • k} : Set V))
        a⁻¹
        hmem
      using 1
    simp [smul_smul, ha]

/-! ## 4. Crossover of projective null rays -/

/--
The crossover of a projective null ray.

This is constructive: nonzeroness is obtained from injectivity of `theta`, and
nullness is obtained from `theta_preserves_null`.
-/
def crossover
    {V : Type*} [AddCommGroup V] [Module ℝ V]
    {C : ConformalCrossoverDatum V}
    (P : ProjectiveNullRay C) :
    ProjectiveNullRay C where
  generator := C.theta P.generator
  generator_ne_zero := by
    intro hzero
    have htheta0 : C.theta P.generator = C.theta 0 := by
      simpa using hzero
    exact P.generator_ne_zero (C.theta.injective htheta0)
  generator_null :=
    C.theta_preserves_null P.generator P.generator_null

namespace ProjectiveNullRay

variable {V : Type*} [AddCommGroup V] [Module ℝ V]
variable {C : ConformalCrossoverDatum V}

variable (P : ProjectiveNullRay C)

/-- The crossover generator is `θ k`. -/
theorem crossover_generator :
    (crossover P).generator = C.theta P.generator :=
  rfl

/-- The crossover generator is null. -/
theorem crossover_generator_null :
    C.Null (crossover P).generator :=
  (crossover P).generator_null

/-- If the generator is fixed by the crossover, the projective ray survives. -/
theorem sameRay_crossover_of_fixed
    (hfixed : C.IsFixed P.generator) :
    SameRay (crossover P) P := by
  dsimp [SameRay, carrier, crossover, ConformalCrossoverDatum.IsFixed] at *
  rw [hfixed]

/--
If the generator is projectively fixed by the crossover, the projective ray
survives.

This is the correct projective version of the survivor theorem.
-/
theorem sameRay_crossover_of_projectivelyFixed
    (hfixed : C.IsProjectivelyFixed P.generator) :
    SameRay (crossover P) P := by
  rcases hfixed with ⟨a, ha, htheta⟩
  dsimp [
    SameRay,
    carrier,
    crossover,
    ConformalCrossoverDatum.IsProjectivelyFixed
  ]
  rw [htheta]
  exact span_singleton_smul_eq (V := V) (k := P.generator) ha

/-- Applying crossover twice returns the original generator. -/
theorem crossover_twice_generator :
    (crossover (crossover P)).generator = P.generator := by
  dsimp [crossover]
  exact C.theta_involutive P.generator

/-- Applying crossover twice returns the same projective ray. -/
theorem sameRay_crossover_twice :
    SameRay (crossover (crossover P)) P := by
  dsimp [SameRay, carrier, crossover]
  rw [C.theta_involutive P.generator]

end ProjectiveNullRay

/-! ## 5. Rescaling representatives -/

namespace ProjectiveNullRay

variable {V : Type*} [AddCommGroup V] [Module ℝ V]
variable {C : ConformalCrossoverDatum V}

/-- Rescale the representative of a projective null ray by a nonzero scalar. -/
def rescale
    (P : ProjectiveNullRay C)
    (a : ℝ)
    (ha : a ≠ 0) :
    ProjectiveNullRay C where
  generator := a • P.generator
  generator_ne_zero := by
    intro hzero
    have hback : P.generator = 0 := by
      have h :=
        congrArg (fun v : V => a⁻¹ • v) hzero
      simpa [smul_smul, ha] using h
    exact P.generator_ne_zero hback
  generator_null :=
    C.null_smul a P.generator P.generator_null

/-- Rescaling by a nonzero scalar does not change the projective ray. -/
theorem sameRay_rescale
    (P : ProjectiveNullRay C)
    (a : ℝ)
    (ha : a ≠ 0) :
    SameRay (P.rescale a ha) P := by
  dsimp [SameRay, carrier, rescale]
  exact span_singleton_smul_eq (V := V) (k := P.generator) ha

end ProjectiveNullRay

/-! ## 6. Genesis as re-contextualization -/

/--
A new aeon context for a surviving ray.

This does not assert physics. It records the minimum data needed to say that a
surviving projective null ray has been embedded into a new state space.
-/
structure GenesisContext
    {V NewState : Type*}
    [AddCommGroup V] [Module ℝ V]
    [AddCommGroup NewState] [Module ℝ NewState]
    (C : ConformalCrossoverDatum V) where
  /-- Linear embedding/readout of old conformal grammar into the new state space. -/
  seedMap : V →ₗ[ℝ] NewState

  /-- The seed map does not erase nonzero surviving generators. -/
  seed_nonzero :
    ∀ v : V, v ≠ 0 → seedMap v ≠ 0

/-- The image of a surviving null ray as a new genesis seed. -/
structure GenesisSeed
    {V NewState : Type*}
    [AddCommGroup V] [Module ℝ V]
    [AddCommGroup NewState] [Module ℝ NewState]
    {C : ConformalCrossoverDatum V}
    (G : GenesisContext (V := V) (NewState := NewState) C)
    (P : ProjectiveNullRay C) where
  /-- The seed is nonzero. -/
  seed_ne_zero :
    G.seedMap P.generator ≠ 0

namespace GenesisSeed

variable {V NewState : Type*}
variable [AddCommGroup V] [Module ℝ V]
variable [AddCommGroup NewState] [Module ℝ NewState]
variable {C : ConformalCrossoverDatum V}
variable (G : GenesisContext (V := V) (NewState := NewState) C)
variable (P : ProjectiveNullRay C)

/-- The new seed vector determined by the surviving generator. -/
abbrev seed (S : GenesisSeed G P) : NewState := G.seedMap P.generator

/-- The seed is the image of the surviving generator. -/
theorem seed_eq (S : GenesisSeed G P) :
    S.seed = G.seedMap P.generator := by
  rfl

end GenesisSeed

/-- Construct the genesis seed from a surviving projective null ray. -/
def genesisSeed
    {V NewState : Type*}
    [AddCommGroup V] [Module ℝ V]
    [AddCommGroup NewState] [Module ℝ NewState]
    {C : ConformalCrossoverDatum V}
    (G : GenesisContext (V := V) (NewState := NewState) C)
    (P : ProjectiveNullRay C) :
    GenesisSeed G P where
  seed_ne_zero :=
    G.seed_nonzero P.generator P.generator_ne_zero

end InfoGeometry.OperatorAlgebra.ConformalCrossover
