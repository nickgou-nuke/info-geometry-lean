-- Macaulay2 script for D-module mapping the continuous RG flow
-- Driven by logarithmic scale gradient

needsPackage "Dmodules"

-- Weyl algebra for continuous variables and their derivatives
-- x represents the state parameter, dx its derivative (gradient)
W = QQ[x, dx, WeylAlgebra => {{x, dx}}]

-- Logarithmic scale gradient representation
-- d_IS flow roughly involves terms like x*dx + 1
-- The RG flow is generated by a D-module ideal
I = ideal(x*dx + 1)

-- Check holonomicity
h = isHolonomic I
print("Is the D-module holonomic? ", h)

-- Compute the dimension of the D-module
dimI = dim(W/I)
print("Dimension of the D-module:", dimI)

-- The D-module structural properties map the renormalization group flow
