import InfoGeometry.Canonical.HestenesQuaternionCore
import InfoGeometry.Canonical.HestenesHyperbolicDoubling
import Mathlib.Algebra.Quaternion

/-!
# The concrete quaternion slice of the Fano paravector carrier

This owner identifies the real quaternion carrier with the associative
four-dimensional Fano slice generated by `1, q1, q2, q3`.  It does not add an
associative multiplication instance to the full octonion carrier.
-/

noncomputable section

namespace InfoGeometry.Canonical.HestenesQuaternionSlice

open InfoGeometry.Clifford.FanoOctonionParavector
open InfoGeometry.Clifford.OctonionParavectorBridge
open InfoGeometry.Canonical.HestenesQuaternionCore
open InfoGeometry.Canonical.HestenesHyperbolicDoubling

abbrev Carrier := OctonionCarrier

def quaternionSlice (a : Quaternion ℝ) : Carrier :=
  (QuaternionAlgebra.re a, fun i =>
    if i.val = 0 then QuaternionAlgebra.imI a
    else if i.val = 1 then QuaternionAlgebra.imJ a
    else if i.val = 2 then QuaternionAlgebra.imK a
    else 0)

@[simp] theorem quaternionSlice_one :
    quaternionSlice (1 : Quaternion ℝ) = scalar 1 := by
  apply Prod.ext
  · simp [quaternionSlice, scalar]
  · funext i
    fin_cases i <;> simp [quaternionSlice, scalar]

@[simp] theorem quaternionSlice_quaternionI :
    quaternionSlice quaternionI = q1 := by
  apply Prod.ext
  · simp [quaternionSlice, quaternionI, q1, imaginary]
  · funext i
    fin_cases i <;> simp [quaternionSlice, quaternionI, q1, imaginary, e0]

@[simp] theorem quaternionSlice_quaternionJ :
    quaternionSlice quaternionJ = q2 := by
  apply Prod.ext
  · simp [quaternionSlice, quaternionJ, q2, imaginary]
  · funext i
    fin_cases i <;> simp [quaternionSlice, quaternionJ, q2, imaginary, e1]

@[simp] theorem quaternionSlice_quaternionK :
    quaternionSlice quaternionK = q3 := by
  apply Prod.ext
  · simp [quaternionSlice, quaternionK, q3, imaginary]
  · funext i
    fin_cases i <;> simp [quaternionSlice, quaternionK, q3, imaginary, e2]

def quaternionSliceConjugate (a : Quaternion ℝ) : Carrier :=
  quaternionSlice (star a)

theorem quaternionSliceConjugate_involutive (a : Quaternion ℝ) :
    quaternionSliceConjugate (star a) = quaternionSlice a := by
  simp [quaternionSliceConjugate]

theorem quaternionSliceConjugate_quaternionI :
    quaternionSliceConjugate quaternionI = -q1 := by
  apply Prod.ext
  · simp [quaternionSliceConjugate, quaternionSlice,
      Quaternion.instStar, QuaternionAlgebra.instStarQuaternionAlgebra,
      quaternionI, q1, imaginary]
  · funext i
    fin_cases i <;>
      simp [quaternionSliceConjugate, quaternionSlice,
        Quaternion.instStar, QuaternionAlgebra.instStarQuaternionAlgebra,
        quaternionI, q1, imaginary, e0]

theorem quaternionSliceConjugate_quaternionJ :
    quaternionSliceConjugate quaternionJ = -q2 := by
  apply Prod.ext
  · simp [quaternionSliceConjugate, quaternionSlice,
      Quaternion.instStar, QuaternionAlgebra.instStarQuaternionAlgebra,
      quaternionJ, q2, imaginary]
  · funext i
    fin_cases i <;>
      simp [quaternionSliceConjugate, quaternionSlice,
        Quaternion.instStar, QuaternionAlgebra.instStarQuaternionAlgebra,
        quaternionJ, q2, imaginary, e1]

theorem quaternionSliceConjugate_quaternionK :
    quaternionSliceConjugate quaternionK = -q3 := by
  apply Prod.ext
  · simp [quaternionSliceConjugate, quaternionSlice,
      Quaternion.instStar, QuaternionAlgebra.instStarQuaternionAlgebra,
      quaternionK, q3, imaginary]
  · funext i
    fin_cases i <;>
      simp [quaternionSliceConjugate, quaternionSlice,
        Quaternion.instStar, QuaternionAlgebra.instStarQuaternionAlgebra,
        quaternionK, q3, imaginary, e2]

theorem quaternionSlice_injective :
    Function.Injective quaternionSlice := by
  intro a b h
  apply Quaternion.ext
  · exact congrArg Prod.fst h
  · exact congrArg (fun x : Carrier => x.2 0) h
  · exact congrArg (fun x : Carrier => x.2 1) h
  · exact congrArg (fun x : Carrier => x.2 2) h

set_option maxHeartbeats 2000000 in
theorem quaternionSlice_mul (a b : Quaternion ℝ) :
    paravectorMul fanoOctonionParavectorData
        (quaternionSlice a) (quaternionSlice b) =
      quaternionSlice (a * b) := by
  apply Prod.ext
  · simp [quaternionSlice, paravectorMul, fanoOctonionParavectorData,
      dot7, fanoCross, fanoCrossRaw, Fin.sum_univ_seven]
    ring_nf
  · funext i
    fin_cases i <;>
      simp [quaternionSlice, paravectorMul, fanoOctonionParavectorData,
        dot7, fanoCross, fanoCrossRaw, Fin.sum_univ_seven,
        Matrix.vecHead, Matrix.vecTail] <;>
      ring_nf

theorem quaternionSliceConjugate_mul (a b : Quaternion ℝ) :
    paravectorMul fanoOctonionParavectorData
        (quaternionSliceConjugate b) (quaternionSliceConjugate a) =
      quaternionSliceConjugate (a * b) := by
  simp [quaternionSliceConjugate, quaternionSlice_mul, star_mul]

end InfoGeometry.Canonical.HestenesQuaternionSlice
