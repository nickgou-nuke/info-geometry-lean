import InfoGeometry.Convex.HessianGeometry
import Mathlib.Analysis.Calculus.FDeriv.Basic
import Mathlib.Topology.MetricSpace.Contracting

set_option linter.unnecessarySimpa false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace RGFlow

open InfoGeometry.Convex

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/--
A Renormalization Group (RG) Flow on information manifolds.
This represents the evolution of the belief geometry as the 'resolution'
of the data changes (coarse-graining).
-/
def InformationFlow (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] :=
  ℝ → HessianGeometry E

/-- Discrete RG flow on Hessian geometries. -/
def DiscreteInformationFlow (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] :=
  Nat → HessianGeometry E

/-- One-step renormalization operator on Hessian geometries. -/
abbrev RGStepMap (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] :=
  HessianGeometry E → HessianGeometry E

/--
Constant RG flow generated by a fixed Hessian geometry.
-/
def constantFlow (H : HessianGeometry E) : InformationFlow E :=
  fun _ => H

@[simp] theorem constantFlow_apply (H : HessianGeometry E) (t : ℝ) :
    constantFlow (E := E) H t = H := rfl

/--
Discrete flow generated by iterating a one-step RG operator from an initial geometry.
-/
def generatedDiscreteFlow (F : RGStepMap E) (H0 : HessianGeometry E) : DiscreteInformationFlow E :=
  fun n => F^[n] H0

@[simp] theorem generatedDiscreteFlow_zero (F : RGStepMap E) (H0 : HessianGeometry E) :
    generatedDiscreteFlow (E := E) F H0 0 = H0 := by
  simp [generatedDiscreteFlow]

@[simp] theorem generatedDiscreteFlow_succ (F : RGStepMap E) (H0 : HessianGeometry E) (n : Nat) :
    generatedDiscreteFlow (E := E) F H0 (n + 1) =
      F (generatedDiscreteFlow (E := E) F H0 n) := by
  simp [generatedDiscreteFlow, Function.iterate_succ_apply']

/--
The Beta Function of the information potential.
This is the totalized scalar derivative of the potential along the RG scale.
It is useful as a readout, but the canonical stationary notion below is stated
using `HasDerivAt`, not `deriv`.
This measures how the 'Information Mass' changes as we ignore microscopic details.
-/
noncomputable def betaFunction (flow : InformationFlow E) (scale : ℝ) (x : E) : ℝ :=
  -- Time derivative of the potential at point x
  deriv (fun t => (flow t).potential x) scale

/--
Stationarity at scale `scale0`.
Both the potential path and the dual-map path have derivative zero at `scale0`
in the `HasDerivAt` sense.
-/
def IsStationaryAtScale (flow : InformationFlow E) (scale0 : ℝ) : Prop :=
  (∀ x, HasDerivAt (fun t => (flow t).potential x) 0 scale0) ∧
    (∀ x, HasDerivAt (fun t => (flow t).dualMap x) 0 scale0)

/--
Flow invariance at scale `scale0`:
both potential and dual map are invariant along the RG parameter.
-/
def FlowInvariantAtScale (flow : InformationFlow E) (scale0 : ℝ) : Prop :=
  (∀ x : E, ∀ t : ℝ, (flow t).potential x = (flow scale0).potential x) ∧
    (∀ x : E, ∀ t : ℝ, (flow t).dualMap x = (flow scale0).dualMap x)

/--
Modular-flow + Clifford-action invariance on the bundle:
at each RG-time `t`, evaluating potential/dual map on transformed sections
`c ℓ (σ_t x)` is invariant relative to the reference scale `scale0`.

`unit` is a neutral Clifford label whose action is identity, and each
`σ_t` is surjective on the base space.
-/
def ModularCliffordFlowInvariantAtScale
    {ι : Type*}
    (flow : InformationFlow E) (scale0 : ℝ)
    (σ : ℝ → E →ₗ[ℝ] E)
    (cliffordAction : ι → E →ₗ[ℝ] E)
    (unit : ι) : Prop :=
  cliffordAction unit = LinearMap.id ∧
    (∀ t : ℝ, Function.Surjective (σ t)) ∧
    (∀ t : ℝ, ∀ x : E, ∀ ℓ : ι,
      (flow t).potential ((cliffordAction ℓ) (σ t x)) =
        (flow scale0).potential ((cliffordAction ℓ) (σ t x))) ∧
    (∀ t : ℝ, ∀ x : E, ∀ ℓ : ι,
      (flow t).dualMap ((cliffordAction ℓ) (σ t x)) =
        (flow scale0).dualMap ((cliffordAction ℓ) (σ t x)))

theorem flowInvariantAtScale_of_modularCliffordFlowInvariant
    {ι : Type*}
    (flow : InformationFlow E) (scale0 : ℝ)
    (σ : ℝ → E →ₗ[ℝ] E)
    (cliffordAction : ι → E →ₗ[ℝ] E)
    (unit : ι)
    (hInv : ModularCliffordFlowInvariantAtScale
      (E := E) (ι := ι) flow scale0 σ cliffordAction unit) :
    FlowInvariantAtScale flow scale0 := by
  rcases hInv with ⟨hUnit, hSurj, hPot, hDual⟩
  refine ⟨?_, ?_⟩
  · intro x t
    rcases hSurj t x with ⟨x0, hx0⟩
    have h := hPot t x0 unit
    simpa [hUnit, hx0] using h
  · intro x t
    rcases hSurj t x with ⟨x0, hx0⟩
    have h := hDual t x0 unit
    simpa [hUnit, hx0] using h

theorem modularCliffordFlowInvariant_of_flowInvariant
    {ι : Type*}
    (flow : InformationFlow E) (scale0 : ℝ)
    (σ : ℝ → E →ₗ[ℝ] E)
    (cliffordAction : ι → E →ₗ[ℝ] E)
    (unit : ι)
    (hUnit : cliffordAction unit = LinearMap.id)
    (hSurj : ∀ t : ℝ, Function.Surjective (σ t))
    (hInv : FlowInvariantAtScale flow scale0) :
    ModularCliffordFlowInvariantAtScale
      (E := E) (ι := ι) flow scale0 σ cliffordAction unit := by
  refine ⟨hUnit, hSurj, ?_, ?_⟩
  · intro t x ℓ
    exact hInv.1 ((cliffordAction ℓ) (σ t x)) t
  · intro t x ℓ
    exact hInv.2 ((cliffordAction ℓ) (σ t x)) t

theorem modularCliffordFlowInvariant_id_of_flowInvariant
    (flow : InformationFlow E) (scale0 : ℝ)
    (hInv : FlowInvariantAtScale flow scale0) :
    ModularCliffordFlowInvariantAtScale
      (E := E) (ι := Unit) flow scale0
      (fun _ : ℝ => (LinearMap.id : E →ₗ[ℝ] E))
      (fun _ : Unit => (LinearMap.id : E →ₗ[ℝ] E))
      () := by
  refine modularCliffordFlowInvariant_of_flowInvariant
    (E := E) (ι := Unit) flow scale0
    (fun _ : ℝ => (LinearMap.id : E →ₗ[ℝ] E))
    (fun _ : Unit => (LinearMap.id : E →ₗ[ℝ] E))
    ()
    ?_ ?_ hInv
  · rfl
  · intro t x
    refine ⟨x, ?_⟩
    simp

theorem isStationaryAtScale_of_flowInvariant
    (flow : InformationFlow E) (scale0 : ℝ)
    (hInv : FlowInvariantAtScale flow scale0) :
    IsStationaryAtScale flow scale0 := by
  refine ⟨?_, ?_⟩
  · intro x
    have hfun :
        (fun t => (flow t).potential x) =
          (fun _ : ℝ => (flow scale0).potential x) := by
      funext t
      exact hInv.1 x t
    rw [hfun]
    simpa using (hasDerivAt_const scale0 ((flow scale0).potential x))
  · intro x
    have hfun :
        (fun t => (flow t).dualMap x) =
          (fun _ : ℝ => (flow scale0).dualMap x) := by
      funext t
      exact hInv.2 x t
    rw [hfun]
    simpa using (hasDerivAt_const scale0 ((flow scale0).dualMap x))

theorem isStationaryAtScale_of_modularCliffordFlowInvariant
    {ι : Type*}
    (flow : InformationFlow E) (scale0 : ℝ)
    (σ : ℝ → E →ₗ[ℝ] E)
    (cliffordAction : ι → E →ₗ[ℝ] E)
    (unit : ι)
    (hInv : ModularCliffordFlowInvariantAtScale
      (E := E) (ι := ι) flow scale0 σ cliffordAction unit) :
    IsStationaryAtScale flow scale0 :=
  isStationaryAtScale_of_flowInvariant (E := E) flow scale0
    (flowInvariantAtScale_of_modularCliffordFlowInvariant
      (E := E) (ι := ι) flow scale0 σ cliffordAction unit hInv)

theorem betaFunction_eq_zero_at_stationary_scale
    (flow : InformationFlow E) (scale0 : ℝ)
    (hStationary : IsStationaryAtScale flow scale0)
    (x : E) :
    betaFunction flow scale0 x = 0 := by
  unfold betaFunction
  simpa using (hStationary.1 x).deriv

@[simp] theorem betaFunction_constantFlow
    (H : HessianGeometry E) (scale : ℝ) (x : E) :
    betaFunction (constantFlow (E := E) H) scale x = 0 := by
  unfold betaFunction constantFlow
  simpa using (deriv_const (x := scale) (c := H.potential x))

@[simp] theorem dualDeriv_constantFlow
    (H : HessianGeometry E) (scale : ℝ) (x : E) :
    deriv (fun t => (constantFlow (E := E) H t).dualMap x) scale = 0 := by
  unfold constantFlow
  simpa using (deriv_const (x := scale) (c := H.dualMap x))

/--
Every constant RG flow is stationary at every scale.
-/
theorem isStationaryAtScale_constantFlow
    (H : HessianGeometry E) (scale0 : ℝ) :
    IsStationaryAtScale (constantFlow (E := E) H) scale0 := by
  refine ⟨?_, ?_⟩
  · intro x
    unfold constantFlow
    simpa using (hasDerivAt_const scale0 (H.potential x))
  · intro x
    unfold constantFlow
    simpa using (hasDerivAt_const scale0 (H.dualMap x))

/--
Constructive stationary-scale existence for constant RG flows.
-/
theorem exists_isStationaryAtScale_constantFlow
    (H : HessianGeometry E) :
    ∃ scale0 : ℝ, IsStationaryAtScale (constantFlow (E := E) H) scale0 :=
  ⟨0, isStationaryAtScale_constantFlow (E := E) H 0⟩

section Contraction

variable [MetricSpace (HessianGeometry E)] [CompleteSpace (HessianGeometry E)] [Nonempty (HessianGeometry E)]

/--
Banach fixed-point theorem specialized to one-step RG operators:
if `F` is contracting, then a unique fixed geometry exists.
-/
theorem existsUnique_fixedPoint_of_contracting
    (F : RGStepMap E) {K : NNReal} (hF : ContractingWith K F) :
    ∃! Hstar : HessianGeometry E, Function.IsFixedPt F Hstar := by
  refine ⟨ContractingWith.fixedPoint F hF, ?_, ?_⟩
  · exact ContractingWith.fixedPoint_isFixedPt (f := F) (hf := hF)
  · intro H hH
    exact ContractingWith.fixedPoint_unique (f := F) (hf := hF) hH

/--
Contraction-driven convergence of RG iterates to the unique fixed geometry.
-/
theorem tendsto_generatedDiscreteFlow_fixedPoint_of_contracting
    (F : RGStepMap E) {K : NNReal} (hF : ContractingWith K F) (H0 : HessianGeometry E) :
    Filter.Tendsto (generatedDiscreteFlow (E := E) F H0) Filter.atTop
      (nhds (ContractingWith.fixedPoint F hF)) := by
  simpa [generatedDiscreteFlow] using
    (ContractingWith.tendsto_iterate_fixedPoint (f := F) (hf := hF) H0)

end Contraction

theorem flowInvariantAtScale_constantFlow
    (H : HessianGeometry E) (scale0 : ℝ) :
    FlowInvariantAtScale (constantFlow (E := E) H) scale0 := by
  refine ⟨?_, ?_⟩
  · intro x t
    simp [constantFlow]
  · intro x t
    simp [constantFlow]

theorem modularCliffordFlowInvariant_constantFlow_id
    (H : HessianGeometry E) (scale0 : ℝ) :
    ModularCliffordFlowInvariantAtScale
      (E := E) (ι := Unit)
      (constantFlow (E := E) H) scale0
      (fun _ : ℝ => (LinearMap.id : E →ₗ[ℝ] E))
      (fun _ : Unit => (LinearMap.id : E →ₗ[ℝ] E))
      () :=
  modularCliffordFlowInvariant_id_of_flowInvariant
    (E := E) (flow := constantFlow (E := E) H) (scale0 := scale0)
    (flowInvariantAtScale_constantFlow (E := E) H scale0)

/--
At a stationary scale, the dual-map derivative vanishes.
-/
theorem dual_map_deriv_eq_zero_at_stationary_scale
    (flow : InformationFlow E) (scale0 : ℝ)
    (hStationary : IsStationaryAtScale flow scale0) (x : E) :
    deriv (fun t => (flow t).dualMap x) scale0 = 0 :=
  (hStationary.2 x).deriv

end RGFlow
