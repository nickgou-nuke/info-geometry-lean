{"type":"new","contents":"import InfoGeometry.Krein.DoubledRootLemmas\nimport InfoGeometry.Clifford.Hestenes\nimport InfoGeometry.Clifford.GeometricRotor\n\n/-!\n# Real doubled Hestenes anchor\n\nThis module exposes the repo's real-doubled translation of complex/Hestenes\nstructure.  It proves only facts already rooted in `DoubledSpace`, `Hestenes`,\nand `GeometricRotor`.\n-/\n\nnamespace InfoGeometry.Clifford.RealDoubledHestenesAnchor\n\nopen InfoGeometry.Krein\n\nvariable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => InfoGeometry.Krein.DoubledSpace E\n\n/-- The real doubled phase axis `I = Jε` is a Hestenes bivector: `I² = -1`. -/\n@[rep_depth krein]\nnoncomputable def doubledIBivector : InfoGeometry.Clifford.Bivector E where\n  op := InfoGeometry.Krein.doubledI (E := E)\n  square_neg := InfoGeometry.Krein.doubledI_sq (E := E)\n\n/-- The rotor generated by the doubled phase axis has inverse given by reverse. -/\n@[rep_depth krein]\ntheorem doubledI_rotor_exp_reverse (θ : ℝ) :\n    (InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ).exp.comp\n        ((InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ).reverse) =\n      ContinuousLinearMap.id ℝ H₂ :=\n  InfoGeometry.Clifford.Rotor.exp_reverse\n    (InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ)\n\n/-- The reverse of the doubled phase-axis rotor is also a left inverse. -/\n@[rep_depth krein]\ntheorem doubledI_rotor_reverse_comp_exp (θ : ℝ) :\n    (InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ).reverse.comp\n        ((InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ).exp) =\n      ContinuousLinearMap.id ℝ H₂ :=\n  InfoGeometry.Clifford.Rotor.reverse_comp_exp\n    (InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ)\n\n/-- Hestenes `Cl(1,1)` pseudoscalar representation is the doubled spectral involution. -/\n@[rep_depth krein]\ntheorem hestenes_pseudoscalar_rep_eq_doubledEpsilon :\n    _root_.cl11Rep (E := E) InfoGeometry.Clifford.Hestenes.Pseudoscalar =\n      InfoGeometry.Krein.doubledEpsilon (E := E) := by\n  simpa [InfoGeometry.Krein.doubledEpsilon] using\n    InfoGeometry.Clifford.Hestenes.cl11Rep_pseudoscalar_eq_spectral_epsilon (E := E)\n\n/-- The represented Hestenes pseudoscalar squares to identity on the doubled carrier. -/\n@[rep_depth krein]\ntheorem hestenes_pseudoscalar_rep_sq :\n    (_root_.cl11Rep (E := E) InfoGeometry.Clifford.Hestenes.Pseudoscalar).comp\n        (_root_.cl11Rep (E := E) InfoGeometry.Clifford.Hestenes.Pseudoscalar) =\n      ContinuousLinearMap.id ℝ H₂ :=\n  InfoGeometry.Clifford.Hestenes.cl11Rep_pseudoscalar_comp_self (E := E)\n\nend InfoGeometry.Clifford.RealDoubledHestenesAnchor\n","mtime":1778588625701}