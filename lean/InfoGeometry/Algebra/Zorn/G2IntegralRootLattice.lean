import InfoGeometry.Algebra.Zorn.G2CoordinateWeylAction

/-!
# The integral `G₂` root lattice in simple-root coordinates

The finite root carrier is the repository's signed coordinate root set in
`ℤ × ℤ`. This owner identifies its integral span with the full lattice
generated by the two simple roots. It makes no identification with a
cyclotomic operator spectrum.
-/

namespace InfoGeometry.Algebra.Zorn.G2IntegralRootLattice

open InfoGeometry.Algebra.Zorn.G2CoordinateWeylAction
open InfoGeometry.Algebra.Zorn.G2Roots

/-- The integral span of the twelve signed `G₂` roots in simple-root coordinates. -/
def rootLattice : Submodule ℤ (ℤ × ℤ) :=
  Submodule.span ℤ (phi : Set (ℤ × ℤ))

theorem simpleShortRoot_mem_rootLattice : (1, 0) ∈ rootLattice := by
  apply Submodule.subset_span
  simp [phi, phiPlus, phiMinus]

theorem simpleLongRoot_mem_rootLattice : (0, 1) ∈ rootLattice := by
  apply Submodule.subset_span
  simp [phi, phiPlus, phiMinus]

/-- In the simple-root basis, the integral span of the twelve roots is `ℤ²`. -/
theorem rootLattice_eq_top : rootLattice = ⊤ := by
  apply Submodule.ext
  intro v
  constructor
  · intro _
    simp
  · intro _
    rw [show v = v.1 • (1, 0) + v.2 • (0, 1) by ext <;> simp]
    exact Submodule.add_mem _
      (Submodule.smul_mem _ _ simpleShortRoot_mem_rootLattice)
      (Submodule.smul_mem _ _ simpleLongRoot_mem_rootLattice)

/-- Both simple reflections preserve the full integral root lattice. -/
theorem simpleReflections_preserve_rootLattice (v : ℤ × ℤ) :
    s1 v ∈ rootLattice ∧ s2 v ∈ rootLattice := by
  rw [rootLattice_eq_top]
  simp

end InfoGeometry.Algebra.Zorn.G2IntegralRootLattice
