{"type":"new","contents":"import InfoGeometry.SuperMetriplectic.Axioms\nimport InfoGeometry.Canonical.InverseKernelCartanCore\nimport InfoGeometry.Core.SymmetricLie\nimport InfoGeometry.Core.UnifiedGeometry\nimport InfoGeometry.Meta.Architecture\n\nopen scoped InnerProductSpace\n\n/-!\n# SuperMetriplectic Cartan Bridge\n\nSmall theorem-backed bridge from the certified inverse-kernel spectral Cartan lane\ninto the conservative `SuperMetriplectic.CartanOnsagerSplit` interface.\n\nThis file does not derive a new Onsager law. It packages the already owned\nspectral Cartan involution generated by `Γ_S` as a symmetric Lie algebra on the\noperator lane, then reads off the `𝔨 ⊕ 𝔭` split as the Drazin core / dissipative\nrange shadow required by `CartanOnsagerSplit`.\n-/\n\nnamespace InfoGeometry.SuperMetriplectic.CartanBridge\n\nopen InfoGeometry.Canonical\nopen InfoGeometry.Core\n\nsection Core\n\nvariable {E : Type 0}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"EndH\" => E →L[ℝ] E\n\n/--\nThe spectral Cartan grading is involutive as an endomorphism of the carrier.\n-/\n@[rep_depth transport]\ntheorem GammaS_comp_GammaS\n    (CIK : CertifiedInverseKernel E) :\n    CIK.GammaS.comp CIK.GammaS = ContinuousLinearMap.id ℝ E := by\n  ext x\n  have h := congrArg (fun T : EndH => T x) (CIK.GammaS_sq_eq_one)\n  simpa using h\n\n/--\nThe spectral Cartan involution on operators viewed as a linear Onsager-style map.\n-/\n@[rep_depth transport]\nnoncomputable def spectralOnsagerMap\n    (CIK : CertifiedInverseKernel E) :\n    EndH →ₗ[ℝ] EndH :=\n  InfoGeometry.Core.conjugationMap CIK.GammaS\n\n/--\nThe spectral Cartan involution generated by `Γ_S`, packaged in the generic\nsymmetric-Lie interface on the operator lane.\n-/\n@[rep_depth transport]\nnoncomputable def spectralCartanSymmetricLieAlgebra\n    (CIK : CertifiedInverseKernel E) :\n    InfoGeometry.Core.SymmetricLieAlgebra EndH := by\n  let θ : InfoGeometry.Core.InvolutiveLieAut EndH :=\n    ⟨InfoGeometry.Core.conjugationLieEquiv CIK.GammaS (GammaS_comp_GammaS (CIK := CIK)),\n      InfoGeometry.Core.conjugationMap_involutive CIK.GammaS (GammaS_comp_GammaS (CIK := CIK))⟩\n  exact InfoGeometry.Core.SymmetricLieAlgebra.ofInvolutiveLieAut θ\n\n/--\nBridge object packaging the repo-owned spectral Cartan split as a conservative\n`CartanOnsagerSplit`.\n-/\n@[rep_depth transport]\nstructure DrazinCartanOnsagerBridge where\n  CIK : CertifiedInverseKernel E\n\nnamespace DrazinCartanOnsagerBridge\n\nvariable (B : DrazinCartanOnsagerBridge (E := E))\n\n/--\nThe spectral Cartan `𝔨 ⊕ 𝔭` split read as the Drazin core / dissipative range\nshadow demanded by `SuperMetriplectic.CartanOnsagerSplit`.\n-/\n@[rep_depth transport]\nnoncomputable def toCartanOnsagerSplit :\n    InfoGeometry.SuperMetriplectic.CartanOnsagerSplit EndH where\n  S := spectralCartanSymmetricLieAlgebra B.CIK\n  onsager := spectralOnsagerMap B.CIK\n  drazinCore := (spectralCartanSymmetricLieAlgebra B.CIK).𝔨\n  dissipativeRange := (spectralCartanSymmetricLieAlgebra B.CIK).𝔭\n  drazinCore_eq_k := rfl\n  dissipativeRange_eq_p := rfl\n\n@[rep_depth transport]\ntheorem toCartanOnsagerSplit_drazinCore_eq_k :\n    (toCartanOnsagerSplit B).drazinCore\n      = (toCartanOnsagerSplit B).S.𝔨 := by\n  exact (toCartanOnsagerSplit B).drazinCore_eq_k\n\n@[rep_depth transport]\ntheorem toCartanOnsagerSplit_dissipativeRange_eq_p :\n    (toCartanOnsagerSplit B).dissipativeRange\n      = (toCartanOnsagerSplit B).S.𝔭 := by\n  exact (toCartanOnsagerSplit B).dissipativeRange_eq_p\n\nend DrazinCartanOnsagerBridge\n\nend Core\n\nend InfoGeometry.SuperMetriplectic.CartanBridge\n","mtime":1777928003351}