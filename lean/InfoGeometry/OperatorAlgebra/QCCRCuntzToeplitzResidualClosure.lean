import InfoGeometry.OperatorAlgebra.QCCRCuntzToeplitzVacuumClosure

namespace InfoGeometry.OperatorAlgebra.QCCRCuntzToeplitzGeneralized

open BigOperators
open InfoGeometry.OperatorAlgebra.QCCRCuntzToeplitz

variable {ι R Op : Type*} [DecidableEq ι] [Fintype ι]
  [CommRing R] [Ring Op] [StarRing Op] [Algebra R Op]

/-- The square of the finite vacuum defect has an exact q-weighted residual.
At q = 0 this specializes to idempotence; for general q it records the
failure of idempotence in the algebra generated by the q-CCR relations. -/
theorem P_vac_sq_eq_P_vac_add_q_double_sum
    (A : QCCROperators ι R Op) :
    P_vac A * P_vac A =
      P_vac A + A.q •
        (∑ j : ι, ∑ i : ι,
          (A.a i * (A.a j * star (A.a i))) * star (A.a j)) := by
  change P_vac A * ((1 : Op) - ∑ j : ι, A.a j * star (A.a j)) = _
  rw [mul_sub, mul_one, Finset.mul_sum]
  simp_rw [← mul_assoc]
  have hterm : ∀ j : ι,
      (P_vac A * A.a j) * star (A.a j) =
        (-A.q) • (∑ i : ι,
          (A.a i * (A.a j * star (A.a i))) * star (A.a j)) := by
    intro j
    rw [P_vac_mul_a_eq_neg_q_sum A j]
    rw [smul_mul_assoc, Finset.sum_mul, Finset.smul_sum]
  have hsum : (∑ j : ι, (P_vac A * A.a j) * star (A.a j)) =
      ∑ j : ι, (-A.q) • (∑ i : ι,
        (A.a i * (A.a j * star (A.a i))) * star (A.a j)) :=
    Finset.sum_congr rfl (fun j _ => hterm j)
  rw [hsum]
  rw [← Finset.smul_sum]
  simp only [neg_smul, sub_neg_eq_add]
  simp only [mul_assoc]

end InfoGeometry.OperatorAlgebra.QCCRCuntzToeplitzGeneralized
