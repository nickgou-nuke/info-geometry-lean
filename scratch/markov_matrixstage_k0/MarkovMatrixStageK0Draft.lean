import Mathlib.Algebra.Category.ModuleCat.Basic
import Mathlib.Algebra.Category.ModuleCat.Projective
import Mathlib.LinearAlgebra.Basis.Prod
import Mathlib.LinearAlgebra.Prod
import InfoGeometry.Algebra.FiniteProjectiveModuleGrothendieck
import InfoGeometry.QuantumContext.MarkovGroupInverseStageColimit

/-!
# Draft: projective-module K₀ split for a Markov group inverse in the matrix-stage limit

Ground-truth owner facts:

* MarkovGroupInverseStageColimit.exists_rowStochastic_groupInverse_inMatrixStageLimit
  transports an actual finite real row-stochastic Laplacian witness through the
  explicit real-to-complex stage algebra hom and the quotient direct-colimit
  inclusion. Its conclusion is an algebraic group-inverse pair in
  MatrixStageLimit.
* HartwigSouriauFrameDrazin.regularIdempotent and principalIdempotent are
  respectively A * G and 1 - A * G. For a group-inverse witness they are
  complementary orthogonal idempotents.
* FiniteProjectiveModuleGrothendieck defines K0 R from finitely generated
  projective left R-modules. The carrier is noncommutative here: the left
  ideals R * e are represented as ranges of right multiplication.

This draft proves the general algebraic idempotent-complement decomposition
first, then instantiates it at the actual MatrixStageLimit witness. It makes
no C*-algebraic, positivity, trace, or operator-limit assertion.
-/

noncomputable section

namespace InfoGeometry.QuantumContext.MarkovMatrixStageK0Draft

open InfoGeometry.Algebra.FiniteProjectiveModuleGrothendieck
open InfoGeometry.Canonical.HartwigSouriauFrameDrazin
open InfoGeometry.QuantumContext.MarkovGroupInverseStageColimit
open InfoGeometry.Canonical.UHFInductiveColimitBoundary

universe u

section GeneralRing

variable {R : Type u} [Ring R]

local instance : AddCommGroup (K0 R) := by
  change AddCommGroup (Grothendieck (ProjectiveModuleClass R))
  infer_instance

/-- The left R-submodule generated by an idempotent, realized as the image
of right multiplication. This is a left module even when R is
noncommutative. -/
abbrev rightIdempotentRange (e : R) : Type u :=
  LinearMap.range (LinearMap.mulRight R e)

private def rightRangeInclusion (e : R) : rightIdempotentRange e →ₗ[R] R :=
  (rightIdempotentRange e).subtype

private def rightRangeProjection (e : R) : R →ₗ[R] rightIdempotentRange e where
  toFun x := ⟨x * e, ⟨x, by simp [rightIdempotentRange, LinearMap.mulRight_apply]⟩⟩
  map_add' x y := by
    apply Subtype.ext
    simp [mul_add]
  map_smul' c x := by
    apply Subtype.ext
    simp [LinearMap.mulRight_apply, mul_assoc]

private theorem rightRangeProjection_subtype (e : R) (he : e * e = e) :
    (rightRangeProjection e).comp (rightRangeInclusion e) = LinearMap.id := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  obtain ⟨y, hy⟩ := x.2
  change x.1 * e = x.1
  calc
    x.1 * e = (y * e) * e := by rw [hy]
    _ = y * (e * e) := by rw [mul_assoc]
    _ = y * e := by rw [he]
    _ = x.1 := hy

private theorem rightRange_projective (e : R) :
    Module.Projective R (rightIdempotentRange e) := by
  exact @Module.Projective.of_split R _ (rightIdempotentRange e) _ _ R _ _
    Module.Projective.of_free (rightRangeInclusion e)
      (rightRangeProjection e) (rightRangeProjection_subtype e)

private theorem rightRange_finite (e : R) :
    Module.Finite R (rightIdempotentRange e) := by
  let f : R →ₗ[R] rightIdempotentRange e := rightRangeProjection e
  have hf : Function.Surjective f := by
    rintro ⟨x, ⟨y, hy⟩⟩
    refine ⟨y, ?_⟩
    apply Subtype.ext
    simpa [f, rightRangeProjection, rightIdempotentRange,
      LinearMap.mulRight_apply] using hy
  exact Module.Finite.of_surjective f hf

/-- The finitely generated projective left module cut out by right
multiplication by an idempotent. -/
def rightIdempotentProjectiveModule (e : R) (he : e * e = e) :
    FiniteProjectiveModule R :=
  ⟨ModuleCat.of R (rightIdempotentRange e), rightRange_finite e,
    rightRange_projective e⟩

private theorem rightRange_fixed (e : R) (he : e * e = e)
    (x : rightIdempotentRange e) : x.1 * e = x.1 := by
  obtain ⟨y, hy⟩ := x.2
  calc
    x.1 * e = (y * e) * e := by rw [hy]
    _ = y * (e * e) := by rw [mul_assoc]
    _ = y * e := by rw [he]
    _ = x.1 := hy

private theorem rightRange_cross_zero (e f : R) (hfe : f * e = 0)
    (x : rightIdempotentRange f) : x.1 * e = 0 := by
  obtain ⟨y, hy⟩ := x.2
  calc
    x.1 * e = (y * f) * e := by rw [hy]
    _ = y * (f * e) := by rw [mul_assoc]
    _ = 0 := by rw [hfe, mul_zero]

/-- Complementary idempotents decompose the regular left module. The
isomorphism is between the regular module and the product of the two
idempotent-generated left ideals. -/
private def complementaryRangeEquiv (e f : R)
    (he : e * e = e) (hf : f * f = f)
    (hef : e * f = 0) (hfe : f * e = 0) (hsum : e + f = 1) :
    R ≃ₗ[R] (rightIdempotentRange e × rightIdempotentRange f) where
  toFun x :=
    (⟨x * e, ⟨x, by simp [rightIdempotentRange, LinearMap.mulRight_apply]⟩⟩,
     ⟨x * f, ⟨x, by simp [rightIdempotentRange, LinearMap.mulRight_apply]⟩⟩)
  invFun z := z.1.1 + z.2.1
  left_inv x := by
    change x * e + x * f = x
    calc
      x * e + x * f = x * (e + f) := by rw [mul_add]
      _ = x := by rw [hsum, mul_one]
  right_inv z := by
    apply Prod.ext
    · apply Subtype.ext
      change (z.1.1 + z.2.1) * e = z.1.1
      rw [add_mul, rightRange_fixed e he z.1,
        rightRange_cross_zero e f hfe z.2]
      simp
    · apply Subtype.ext
      change (z.1.1 + z.2.1) * f = z.2.1
      rw [add_mul, rightRange_cross_zero f e hef z.1,
        rightRange_fixed f hf z.2]
      simp
  map_add' x y := by
    apply Prod.ext <;> apply Subtype.ext <;> simp [add_mul]
  map_smul' c x := by
    apply Prod.ext <;> apply Subtype.ext <;>
      simp [LinearMap.mulRight_apply, mul_assoc]

/-- The two projective-module classes of complementary idempotents sum to
the class of the regular left module, and hence to its class in the
repository's algebraic projective-module K₀(R). -/
theorem complementary_idempotent_k0_split (e f : R)
    (he : e * e = e) (hf : f * f = f)
    (hef : e * f = 0) (hfe : f * e = 0) (hsum : e + f = 1) :
    k0Class R (rightIdempotentProjectiveModule e he) +
      k0Class R (rightIdempotentProjectiveModule f hf) =
        k0Class R
          ⟨ModuleCat.of R R, inferInstance, Module.Projective.of_free⟩ := by
  let Me := rightIdempotentProjectiveModule e he
  let Mf := rightIdempotentProjectiveModule f hf
  let MR : FiniteProjectiveModule R :=
    ⟨ModuleCat.of R R, inferInstance, Module.Projective.of_free⟩
  let ce : ProjectiveModuleClass R := Quotient.mk _ Me
  let cf : ProjectiveModuleClass R := Quotient.mk _ Mf
  let cR : ProjectiveModuleClass R := Quotient.mk _ MR
  have hclass : classAdd R ce cf = cR := by
    apply Quotient.sound
    exact ⟨(complementaryRangeEquiv e f he hf hef hfe hsum).symm.toModuleIso⟩
  change grothendieckMap (ProjectiveModuleClass R) ce +
      grothendieckMap (ProjectiveModuleClass R) cf =
    grothendieckMap (ProjectiveModuleClass R) cR
  calc
    _ = grothendieckMap (ProjectiveModuleClass R) (ce + cf) := by
      rw [(grothendieckMap (ProjectiveModuleClass R)).map_add]
    _ = grothendieckMap (ProjectiveModuleClass R) cR :=
      congrArg (grothendieckMap (ProjectiveModuleClass R)) hclass

end GeneralRing

/-! ## Markov witness in the actual noncommutative quotient-stage ring -/

section MatrixStageLimit

open InfoGeometry.Canonical.ComplexMatrixStage
open InfoGeometry.Canonical.MatrixStageInductiveLimit

theorem matrixStageLimit_k0_split_of_groupInverse
    {ι : Type*} [Fintype ι] [DecidableEq ι] [Nontrivial ι]
    (n : ℕ) (e : ι ≃ BitWord n) (P : Matrix ι ι ℝ)
    (G : MatrixStageLimit)
    (hG : IsGroupInverse
      (canonicalStageHom n (realMatrixToComplexStage n e (1 - P))) G) :
      k0Class MatrixStageLimit
          (rightIdempotentProjectiveModule
            (regularIdempotent
              (canonicalStageHom n
                (realMatrixToComplexStage n e (1 - P))) G)
            (regularIdempotent_idempotent hG)) +
        k0Class MatrixStageLimit
          (rightIdempotentProjectiveModule
            (principalIdempotent
              (canonicalStageHom n
                (realMatrixToComplexStage n e (1 - P))) G)
            (principalIdempotent_idempotent hG)) =
        k0Class MatrixStageLimit
          ⟨ModuleCat.of MatrixStageLimit MatrixStageLimit, inferInstance,
            Module.Projective.of_free⟩ := by
  let A := canonicalStageHom n (realMatrixToComplexStage n e (1 - P))
  have hE := regularIdempotent_idempotent hG
  have hF := principalIdempotent_idempotent hG
  have hEF := mul_principalIdempotent_eq_zero hG
  have hFE := principalIdempotent_mul_eq_zero hG
  have hsum : regularIdempotent A G + principalIdempotent A G = 1 := by
    simp [regularIdempotent, principalIdempotent]
  have hsplit := complementary_idempotent_k0_split
    (regularIdempotent A G) (principalIdempotent A G)
    hE hF hEF hFE hsum
  simpa [A] using hsplit

/-- A finite row-stochastic real transition matrix therefore supplies a
group-inverse pair and the corresponding projective-module K₀ decomposition
inside the actual noncommutative quotient-stage ring. -/
theorem exists_markov_idempotent_k0_split
    {ι : Type*} [Fintype ι] [DecidableEq ι] [Nontrivial ι]
    (n : ℕ) (e : ι ≃ BitWord n) (P : Matrix ι ι ℝ)
    (hP : P ∈ Matrix.rowStochastic ℝ ι) :
    ∃ G : MatrixStageLimit,
      ∃ hG : IsGroupInverse
        (canonicalStageHom n (realMatrixToComplexStage n e (1 - P))) G,
      k0Class MatrixStageLimit
          (rightIdempotentProjectiveModule
            (regularIdempotent
              (canonicalStageHom n
                (realMatrixToComplexStage n e (1 - P))) G)
            (regularIdempotent_idempotent hG)) +
        k0Class MatrixStageLimit
          (rightIdempotentProjectiveModule
            (principalIdempotent
              (canonicalStageHom n
                (realMatrixToComplexStage n e (1 - P))) G)
            (principalIdempotent_idempotent hG)) =
        k0Class MatrixStageLimit
          ⟨ModuleCat.of MatrixStageLimit MatrixStageLimit, inferInstance,
            Module.Projective.of_free⟩ := by
  obtain ⟨G, hG⟩ := exists_rowStochastic_groupInverse_inMatrixStageLimit n e P hP
  refine ⟨G, hG, ?_⟩
  exact rowStochastic_matrixStageLimit_k0_split n e P G hG

end MatrixStageLimit

end InfoGeometry.QuantumContext.MarkovMatrixStageK0Draft
