import Mathlib.Data.ZMod.Basic
import Mathlib.LinearAlgebra.BilinearForm.Orthogonal
import Mathlib.LinearAlgebra.Dimension.Finrank
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.LinearAlgebra.Matrix.BilinearForm
import Mathlib.LinearAlgebra.Matrix.ToLin

/-!
# The extended binary Golay code

This file constructs the code rather than storing the parameters `[24,12,8]`
in a certificate.  We use the standard cyclic binary Golay code of length 23
generated by

`g(X) = 1 + X^2 + X^4 + X^5 + X^6 + X^10 + X^11`

and append the parity coordinate.  Consequently every theorem below concerns
the resulting finite set of actual binary words.
-/

namespace InfoGeometry.Combinatorics.ExtendedBinaryGolay

abbrev F₂ := ZMod 2
abbrev Message := Fin 12 → F₂
abbrev Word23 := Fin 23 → F₂
abbrev Word24 := Fin 24 → F₂

/-- Support of the standard degree-eleven generator polynomial. -/
def generatorSupport : Finset ℕ := {0, 2, 4, 5, 6, 10, 11}

/-- A coefficient of the standard binary Golay generator polynomial. -/
def generatorCoefficient (j : ℕ) : F₂ :=
  if j % 23 ∈ generatorSupport then 1 else 0

/-- Cyclic convolution of a twelve-bit message with the Golay generator. -/
def cyclicGolayWord (m : Message) : Word23 :=
  fun j =>
    ∑ i : Fin 12,
      m i * generatorCoefficient (j.val + 23 - i.val)

/-- Parity bit appended to the cyclic length-23 word. -/
def parityBit (w : Word23) : F₂ :=
  ∑ j : Fin 23, w j

/-- The extended length-24 binary Golay encoding map. -/
def encode (m : Message) : Word24 :=
  fun j =>
    if h : j.val < 23 then
      cyclicGolayWord m ⟨j.val, h⟩
    else
      parityBit (cyclicGolayWord m)

/-- The actual finite set of encoded extended Golay words. -/
def code : Finset Word24 :=
  Finset.univ.image encode

/-- Hamming weight of a binary word. -/
def hammingWeight {n : ℕ} (w : Fin n → F₂) : ℕ :=
  (Finset.univ.filter fun i => w i ≠ 0).card

/-- Binary dot product on words of equal length. -/
def dot {n : ℕ} (u v : Fin n → F₂) : F₂ :=
  ∑ i, u i * v i

/-- The cyclic encoder sends the zero message to the zero word. -/
theorem cyclicGolayWord_zero :
    cyclicGolayWord 0 = 0 := by
  funext j
  simp [cyclicGolayWord]

/-- Appending parity preserves the zero codeword. -/
theorem encode_zero :
    encode 0 = 0 := by
  funext j
  simp [encode, cyclicGolayWord_zero, parityBit]

/-- Cyclic convolution is additive in the message. -/
theorem cyclicGolayWord_add (m n : Message) :
    cyclicGolayWord (m + n) =
      cyclicGolayWord m + cyclicGolayWord n := by
  funext j
  simp [cyclicGolayWord, add_mul, Finset.sum_add_distrib]

/-- Cyclic convolution is homogeneous over the binary field. -/
theorem cyclicGolayWord_smul (a : F₂) (m : Message) :
    cyclicGolayWord (a • m) = a • cyclicGolayWord m := by
  funext j
  simp [cyclicGolayWord, Finset.mul_sum, mul_assoc]

/-- The parity coordinate is additive. -/
theorem parityBit_add (u v : Word23) :
    parityBit (u + v) = parityBit u + parityBit v := by
  simp [parityBit, Finset.sum_add_distrib]

/-- The parity coordinate is homogeneous. -/
theorem parityBit_smul (a : F₂) (u : Word23) :
    parityBit (a • u) = a • parityBit u := by
  simp [parityBit, Finset.mul_sum]

/-- The extended Golay encoder is additive. -/
theorem encode_add (m n : Message) :
    encode (m + n) = encode m + encode n := by
  funext j
  simp [encode, cyclicGolayWord_add, parityBit_add]

/-- The extended Golay encoder is homogeneous over `F₂`. -/
theorem encode_smul (a : F₂) (m : Message) :
    encode (a • m) = a • encode m := by
  funext j
  simp [encode, cyclicGolayWord_smul, parityBit_smul]

/-- The extended Golay encoding as a native linear map. -/
def encodeLinear : Message →ₗ[F₂] Word24 where
  toFun := encode
  map_add' := encode_add
  map_smul' := encode_smul

/-- The extended binary Golay code as a native binary submodule. -/
def codeSubmodule : Submodule F₂ Word24 :=
  encodeLinear.range

/-- Standard binary dot product as a native bilinear form. -/
def dotBilin : LinearMap.BilinForm F₂ Word24 :=
  dotProductBilin F₂ F₂

@[simp]
theorem dotBilin_apply (u v : Word24) :
    dotBilin u v = dot u v :=
  rfl

/-- Symmetry of the standard binary dot-product form. -/
theorem dotBilin_isSymm :
    dotBilin.IsSymm := by
  rw [LinearMap.BilinForm.isSymm_def]
  intro u v
  simp only [dotBilin_apply, dot]
  apply Finset.sum_congr rfl
  intro i _
  exact mul_comm _ _

/-- Reflexivity follows from symmetry of the binary dot-product form. -/
theorem dotBilin_isRefl :
    dotBilin.IsRefl :=
  dotBilin_isSymm.isRefl

/--
The standard dot-product form is nondegenerate.  In the coordinate basis its
Gram matrix is the identity, whose determinant is one.
-/
theorem dotBilin_nondegenerate :
    dotBilin.Nondegenerate := by
  apply LinearMap.BilinForm.nondegenerate_of_det_ne_zero
    dotBilin (Pi.basisFun F₂ (Fin 24))
  simp [dotBilin]

/--
The explicit encoder is injective.  Hence the construction has dimension
twelve over `F₂`.
-/
theorem encode_injective :
    Function.Injective encode := by
  native_decide

/-- The linear encoder is injective. -/
theorem encodeLinear_injective :
    Function.Injective encodeLinear :=
  encode_injective

/-- The constructed code has binary dimension twelve. -/
theorem finrank_codeSubmodule :
    Module.finrank F₂ codeSubmodule = 12 := by
  rw [codeSubmodule, LinearMap.finrank_range_of_inj encodeLinear_injective]
  simp [Message]

/-- Membership in the finite code and in the linear range agree. -/
theorem mem_code_iff_mem_codeSubmodule (w : Word24) :
    w ∈ code ↔ w ∈ codeSubmodule := by
  simp [code, codeSubmodule, encodeLinear]

/-- The constructed code contains exactly `2^12 = 4096` words. -/
theorem card_code :
    code.card = 4096 := by
  native_decide

/--
Every nonzero constructed word has Hamming weight at least eight.
This is the minimum-distance lower bound, proved on the actual finite code.
-/
theorem minimumWeight_eight_lower_bound :
    ∀ w ∈ code, w ≠ 0 → 8 ≤ hammingWeight w := by
  native_decide

/-- A codeword of Hamming weight eight exists. -/
theorem exists_weight_eight :
    ∃ w ∈ code, hammingWeight w = 8 := by
  native_decide

/-- The minimum nonzero Hamming weight of the constructed code is exactly 8. -/
theorem minimumWeight_eq_eight :
    (∀ w ∈ code, w ≠ 0 → 8 ≤ hammingWeight w) ∧
      (∃ w ∈ code, hammingWeight w = 8) :=
  ⟨minimumWeight_eight_lower_bound, exists_weight_eight⟩

/--
All constructed codewords are mutually orthogonal for the binary dot product.
Together with the cardinality theorem, this is the finite algebraic content
from which self-duality is derived.
-/
theorem self_orthogonal :
    ∀ u ∈ code, ∀ v ∈ code, dot u v = 0 := by
  native_decide

/-- The code submodule is contained in its bilinear orthogonal complement. -/
theorem codeSubmodule_le_orthogonal :
    codeSubmodule ≤ dotBilin.orthogonal codeSubmodule := by
  intro u hu
  rw [LinearMap.BilinForm.mem_orthogonal_iff]
  intro v hv
  rw [dotBilin_apply]
  exact self_orthogonal v
    ((mem_code_iff_mem_codeSubmodule v).2 hv) u
    ((mem_code_iff_mem_codeSubmodule u).2 hu)

/-- The bilinear dual of the code also has binary dimension twelve. -/
theorem finrank_orthogonal_codeSubmodule :
    Module.finrank F₂ (dotBilin.orthogonal codeSubmodule) = 12 := by
  rw [dotBilin.finrank_orthogonal
    dotBilin_nondegenerate dotBilin_isRefl]
  rw [finrank_codeSubmodule]
  simp [Word24]

/--
The constructed extended binary Golay code equals its binary-dot-product
orthogonal complement: genuine code self-duality.
-/
theorem codeSubmodule_selfDual :
    codeSubmodule = dotBilin.orthogonal codeSubmodule := by
  apply Submodule.eq_of_le_of_finrank_eq codeSubmodule_le_orthogonal
  rw [finrank_codeSubmodule, finrank_orthogonal_codeSubmodule]

/-- Every constructed codeword has even Hamming weight. -/
theorem even_hammingWeight :
    ∀ w ∈ code, Even (hammingWeight w) := by
  native_decide

/-- Every extended Golay codeword has Hamming weight divisible by four. -/
theorem four_dvd_hammingWeight :
    ∀ w ∈ code, 4 ∣ hammingWeight w := by
  native_decide

/-- The constant one word belongs to the extended Golay code. -/
theorem one_mem_code :
    (1 : Word24) ∈ code := by
  native_decide

/-- The constant one word belongs to the native Golay submodule. -/
theorem one_mem_codeSubmodule :
    (1 : Word24) ∈ codeSubmodule :=
  (mem_code_iff_mem_codeSubmodule 1).1 one_mem_code

end InfoGeometry.Combinatorics.ExtendedBinaryGolay
