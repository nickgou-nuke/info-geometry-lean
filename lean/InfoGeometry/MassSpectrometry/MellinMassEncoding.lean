import Mathlib.Analysis.SpecialFunctions.Complex.Exponential
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import InfoGeometry.LLM.PositionalEncoding
import InfoGeometry.MassSpectrometry.PeakSpectrum

/-!
# Mellin/log-mass encoding

Mass enters through the multiplicative positive-real scale group, while
`Real.log` supplies its additive coordinate.  The final positional-encoding
adapter reuses the repository's generic `InfoGeometry.LLM.PositionalEncoding`
interface without identifying that interface with a physical instrument.
-/

noncomputable section

namespace InfoGeometry.MassSpectrometry

/-- Dimensionless relative logarithmic mass. -/
def logMass (m m₀ : ℝ) : ℝ :=
  Real.log (m / m₀)

/-- Common multiplicative rescaling cancels from relative log mass. -/
theorem logMass_common_scale
    {λ m m₀ : ℝ} (hλ : λ ≠ 0) (hm₀ : m₀ ≠ 0) :
    logMass (λ * m) (λ * m₀) = logMass m m₀ := by
  unfold logMass
  congr 1
  field_simp [hλ, hm₀]

/-- Relative log mass is the difference of absolute log coordinates. -/
theorem logMass_eq_sub
    {m m₀ : ℝ} (hm : m ≠ 0) (hm₀ : m₀ ≠ 0) :
    logMass m m₀ = Real.log m - Real.log m₀ := by
  unfold logMass
  exact Real.log_div hm hm₀

/-- Multiplication becomes addition in logarithmic mass coordinates. -/
theorem log_scale_add
    {λ m : ℝ} (hλ : λ ≠ 0) (hm : m ≠ 0) :
    Real.log (λ * m) = Real.log λ + Real.log m := by
  exact Real.log_mul hλ hm

/-- A Mellin-style phase feature generated by relative log mass. -/
def mellinMassPhase (ω m m₀ : ℝ) : ℂ :=
  Complex.exp (Complex.I * (ω : ℂ) * (logMass m m₀ : ℂ))

/-- Mellin phase inherits common-scale invariance from relative log mass. -/
theorem mellinMassPhase_common_scale
    {ω λ m m₀ : ℝ} (hλ : λ ≠ 0) (hm₀ : m₀ ≠ 0) :
    mellinMassPhase ω (λ * m) (λ * m₀) = mellinMassPhase ω m m₀ := by
  simp [mellinMassPhase, logMass_common_scale hλ hm₀]

/-- Log-mass translation as the repository's generic positional-encoding type. -/
def logMassTranslation (c : ℝ) : InfoGeometry.LLM.PositionalEncoding ℝ :=
  fun x => x + c

@[simp] theorem logMassTranslation_apply (c x : ℝ) :
    (logMassTranslation c).encode x = x + c := rfl

/-- Sequential scale translations add their logarithmic shifts. -/
theorem logMassTranslation_comp (a b : ℝ) :
    InfoGeometry.LLM.PositionalEncoding.comp
      (logMassTranslation a) (logMassTranslation b) =
    logMassTranslation (a + b) := by
  funext x
  simp [InfoGeometry.LLM.PositionalEncoding.comp, logMassTranslation]
  ring

end InfoGeometry.MassSpectrometry
