
needsPackage "Dmodules"
W = QQ[x,y, Dx, Dy, WeylAlgebra => {x=>Dx, y=>Dy}]
Q = x^2 + y^2
-- Compute the D-module annihilating 1/Q (or Q^s)
-- We compute the characteristic ideal of the ideal generated by Q
I = ideal(Q)
CI = charIdeal(I)
dimCI = dim(W/CI)
print("--- Macaulay2 Singular Support Output ---")
print("Characteristic Ideal = " | toString(CI))
print("Dimension = " | toString(dimCI))
exit(0)
