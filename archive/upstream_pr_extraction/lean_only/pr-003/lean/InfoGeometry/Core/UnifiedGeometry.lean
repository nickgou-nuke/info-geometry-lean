import InfoGeometry.Core.Involution
import InfoGeometry.Architecture.SymmetricSpace
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Algebra.Lie.Submodule
import Mathlib.LinearAlgebra.Eigenspace.Basic

/-!
# Unified Geometry Core

Unifying abstractions for involutive symmetric geometry, Cartan splitting,
and Lie-style compatibility.
-/

namespace InfoGeometry.Core

/-- Symmetric-space style reflection data packaged as pointwise involutions. -/
structure SymmetricSpace (M : Type _) where
  reflection : M → InvolutiveAutomorphism M
  reflection_fix : ∀ x, reflection x x = x

@[simp]
lemma reflection_involutive
    {M : Type _}
    (S : SymmetricSpace M) (x y : M) :
    S.reflection x (S.reflection x y) = y :=
  (S.reflection x).involutive y

@[simp]
lemma reflection_self
    {M : Type _}
    (S : SymmetricSpace M) (x : M) :
    S.reflection x x = x :=
  S.reflection_fix x

/-- Bridge from the existing Cartan-Loos structure. -/
def SymmetricSpace.ofLegacy
    {M : Type _}
    (S : InfoGeometry.Architecture.SymmetricSpace M) : SymmetricSpace M where
  reflection x :=
    { toFun := S.symmetry x
      involutive := S.symm_involutive x }
  reflection_fix := S.symm_fixpoint

/-- Bridge to the existing Cartan-Loos structure. -/
def SymmetricSpace.toLegacy
    {M : Type _}
    (S : SymmetricSpace M) : InfoGeometry.Architecture.SymmetricSpace M where
  symmetry := fun x y => S.reflection x y
  symm_involutive := by
    intro x y
    exact (S.reflection x).involutive y
  symm_fixpoint := S.reflection_fix

/-- Cartan decomposition generated by a linear involution. -/
structure CartanDecomposition (V : Type _)
    [AddCommGroup V] [Module ℝ V] where
  θ : LinearInvolutiveAutomorphism V

section Cartan

variable {V : Type _} [AddCommGroup V] [Module ℝ V]

/-- `+1` Cartan component. -/
noncomputable def plusPart
    (C : CartanDecomposition V) (v : V) : V :=
  InfoGeometry.Core.cartanPlus C.θ v

/-- `-1` Cartan component. -/
noncomputable def minusPart
    (C : CartanDecomposition V) (v : V) : V :=
  InfoGeometry.Core.cartanMinus C.θ v

/-- Even subspace predicate (`+1` eigenspace of `θ`). -/
def IsEven
    (C : CartanDecomposition V) (v : V) : Prop :=
  C.θ v = v

/-- Odd subspace predicate (`-1` eigenspace of `θ`). -/
def IsOdd
    (C : CartanDecomposition V) (v : V) : Prop :=
  C.θ v = -v

lemma cartan_split
    (C : CartanDecomposition V) (v : V) :
    v = plusPart C v + minusPart C v :=
  InfoGeometry.Core.cartan_decomposition C.θ v

lemma cartanPlus_even
    (C : CartanDecomposition V) (v : V) :
    IsEven C (plusPart C v) :=
  InfoGeometry.Core.cartanPlus_fixed C.θ v

lemma cartanMinus_odd
    (C : CartanDecomposition V) (v : V) :
    IsOdd C (minusPart C v) :=
  InfoGeometry.Core.cartanMinus_neg_fixed C.θ v

end Cartan

/-- Minimal Lie-style bracket data with Cartan involution compatibility. -/
structure CartanLieStructure (L : Type _)
    [AddCommGroup L] [Module ℝ L] where
  bracket : L → L → L
  cartan : CartanDecomposition L
  bracket_compat :
    ∀ x y,
      cartan.θ (bracket x y) = bracket (cartan.θ x) (cartan.θ y)

section Endomorphism

variable {V : Type _} [NormedAddCommGroup V] [NormedSpace ℝ V]

/-- Conjugation linear endomorphism on `End(V)` induced by `J`. -/
noncomputable def conjugationMap
    (J : V →L[ℝ] V) :
    (V →L[ℝ] V) →ₗ[ℝ] (V →L[ℝ] V) :=
  { toFun := fun A => J.comp (A.comp J)
    map_add' := by
      intro A B
      ext v
      simp
    map_smul' := by
      intro a A
      ext v
      simp }

/-- `conjugationMap` as an endomorphism object in the `Module.End` API. -/
noncomputable def conjugationEnd
    (J : V →L[ℝ] V) :
    Module.End ℝ (V →L[ℝ] V) :=
  conjugationMap J

/-- Involutivity of conjugation when `J² = Id`. -/
lemma conjugationMap_involutive
    (J : V →L[ℝ] V)
    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :
    Function.Involutive (conjugationMap J) := by
  intro A
  have hJ_apply : ∀ x : V, J (J x) = x := by
    intro x
    simpa using congrArg (fun T : V →L[ℝ] V => T x) hJ
  ext v
  simp [conjugationMap, hJ_apply]

/-- Bracket compatibility of conjugation when `J² = Id`. -/
lemma conjugationMap_bracket
    (J : V →L[ℝ] V)
    (hJ : J.comp J = ContinuousLinearMap.id ℝ V)
    (A B : V →L[ℝ] V) :
    conjugationMap J ⁅A, B⁆
      = ⁅conjugationMap J A, conjugationMap J B⁆ := by
  have hJ_apply : ∀ x : V, J (J x) = x := by
    intro x
    simpa using congrArg (fun T : V →L[ℝ] V => T x) hJ
  ext v
  simp [conjugationMap, hJ_apply, LieRing.of_associative_ring_bracket]

/-- Conjugation by an involution as a Lie algebra equivalence on `End(V)`. -/
noncomputable def conjugationLieEquiv
    (J : V →L[ℝ] V)
    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :
    (V →L[ℝ] V) ≃ₗ⁅ℝ⁆ (V →L[ℝ] V) := by
  let θ := conjugationMap J
  have hInv := conjugationMap_involutive J hJ
  refine
    { toFun := θ
      invFun := θ
      left_inv := by
        intro A
        exact hInv A
      right_inv := by
        intro A
        exact hInv A
      map_add' := by
        intro A B
        exact θ.map_add A B
      map_smul' := by
        intro a A
        exact θ.map_smul a A
      map_lie' := by
        intro A B
        exact conjugationMap_bracket J hJ A B }

/-- `+1` eigenspace of conjugation by `J`. -/
noncomputable def conjugationEvenSubmodule
    (J : V →L[ℝ] V) :
    Submodule ℝ (V →L[ℝ] V) :=
  (conjugationEnd J).eigenspace (1 : ℝ)

/-- `-1` eigenspace of conjugation by `J`. -/
noncomputable def conjugationOddSubmodule
    (J : V →L[ℝ] V) :
    Submodule ℝ (V →L[ℝ] V) :=
  (conjugationEnd J).eigenspace (-1 : ℝ)

/-- Bracket closure `[𝔨, 𝔨] ⊆ 𝔨` for the conjugation eigenspace decomposition. -/
lemma conjugation_bracket_even_even_mem_even
    (J : V →L[ℝ] V)
    (hJ : J.comp J = ContinuousLinearMap.id ℝ V)
    {A B : V →L[ℝ] V}
    (hA : A ∈ conjugationEvenSubmodule J)
    (hB : B ∈ conjugationEvenSubmodule J) :
    ⁅A, B⁆ ∈ conjugationEvenSubmodule J := by
  rw [conjugationEvenSubmodule, Module.End.mem_eigenspace_iff] at hA hB ⊢
  change (conjugationMap J) A = (1 : ℝ) • A at hA
  change (conjugationMap J) B = (1 : ℝ) • B at hB
  calc
    conjugationMap J ⁅A, B⁆
        = ⁅conjugationMap J A, conjugationMap J B⁆ :=
          conjugationMap_bracket J hJ A B
    _ = ⁅(1 : ℝ) • A, (1 : ℝ) • B⁆ := by rw [hA, hB]
    _ = (1 : ℝ) • ⁅A, B⁆ := by simp

/-- Bracket closure `[𝔨, 𝔭] ⊆ 𝔭` for the conjugation eigenspace decomposition. -/
lemma conjugation_bracket_even_odd_mem_odd
    (J : V →L[ℝ] V)
    (hJ : J.comp J = ContinuousLinearMap.id ℝ V)
    {A B : V →L[ℝ] V}
    (hA : A ∈ conjugationEvenSubmodule J)
    (hB : B ∈ conjugationOddSubmodule J) :
    ⁅A, B⁆ ∈ conjugationOddSubmodule J := by
  rw [conjugationEvenSubmodule, Module.End.mem_eigenspace_iff] at hA
  rw [conjugationOddSubmodule, Module.End.mem_eigenspace_iff] at hB ⊢
  change (conjugationMap J) A = (1 : ℝ) • A at hA
  change (conjugationMap J) B = (-1 : ℝ) • B at hB
  calc
    conjugationMap J ⁅A, B⁆
        = ⁅conjugationMap J A, conjugationMap J B⁆ :=
          conjugationMap_bracket J hJ A B
    _ = ⁅(1 : ℝ) • A, (-1 : ℝ) • B⁆ := by rw [hA, hB]
    _ = (-1 : ℝ) • ⁅A, B⁆ := by simp

/-- Bracket closure `[𝔭, 𝔭] ⊆ 𝔨` for the conjugation eigenspace decomposition. -/
lemma conjugation_bracket_odd_odd_mem_even
    (J : V →L[ℝ] V)
    (hJ : J.comp J = ContinuousLinearMap.id ℝ V)
    {A B : V →L[ℝ] V}
    (hA : A ∈ conjugationOddSubmodule J)
    (hB : B ∈ conjugationOddSubmodule J) :
    ⁅A, B⁆ ∈ conjugationEvenSubmodule J := by
  rw [conjugationOddSubmodule, Module.End.mem_eigenspace_iff] at hA hB
  rw [conjugationEvenSubmodule, Module.End.mem_eigenspace_iff]
  change (conjugationMap J) A = (-1 : ℝ) • A at hA
  change (conjugationMap J) B = (-1 : ℝ) • B at hB
  calc
    conjugationMap J ⁅A, B⁆
        = ⁅conjugationMap J A, conjugationMap J B⁆ :=
          conjugationMap_bracket J hJ A B
    _ = ⁅(-1 : ℝ) • A, (-1 : ℝ) • B⁆ := by rw [hA, hB]
    _ = (1 : ℝ) • ⁅A, B⁆ := by simp

/-- The `+1` conjugation eigenspace is a Lie subalgebra. -/
noncomputable def conjugationEvenLieSubalgebra
    (J : V →L[ℝ] V)
    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :
    LieSubalgebra ℝ (V →L[ℝ] V) where
  carrier := conjugationEvenSubmodule J
  zero_mem' := by
    simp [conjugationEvenSubmodule]
  add_mem' := by
    intro A B hA hB
    exact (conjugationEvenSubmodule J).add_mem hA hB
  smul_mem' := by
    intro a A hA
    exact (conjugationEvenSubmodule J).smul_mem a hA
  lie_mem' := by
    intro A B hA hB
    exact conjugation_bracket_even_even_mem_even J hJ hA hB

/-- Conjugation by an involutive endomorphism as a linear involution on endomorphisms. -/
noncomputable def conjugationByInvolution
    (J : V →L[ℝ] V)
    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :
    LinearInvolutiveAutomorphism (V →L[ℝ] V) := by
  refine ⟨?_, ?_⟩
  · exact
      { toFun := conjugationMap J
        involutive := conjugationMap_involutive J hJ }
  · refine
      { map_add := ?_
        map_smul := ?_ }
    · intro A B
      exact (conjugationMap J).map_add A B
    · intro a A
      exact (conjugationMap J).map_smul a A

/-- Cartan decomposition induced by involutive conjugation on endomorphisms. -/
noncomputable def endomorphismCartanDecomposition
    (J : V →L[ℝ] V)
    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :
    CartanDecomposition (V →L[ℝ] V) where
  θ := conjugationByInvolution J hJ

end Endomorphism

section GroupBridge

variable {G : Type _} [Group G]

/-- Bridge from the existing group-level Cartan involution. -/
def mulInvolutiveOfCartan
    (θ : InfoGeometry.Architecture.CartanInvolution G) :
    MulInvolutiveAutomorphism G := by
  refine ⟨?_, ?_⟩
  · exact
      { toFun := θ.toMulAut
        involutive := θ.involutive }
  · refine
      { map_mul := ?_
        map_one := ?_ }
    · intro x y
      simp
    · simp

end GroupBridge

end InfoGeometry.Core
