{"file":"/home/goutev/repos/info-geometry-lean/external/SpectralThm/SpectralThm/ComplexMeasure/Integral.lean","time":1778539107975,"baseTime":1778539107036,"changes":[{"range":{"start":{"line":40,"character":0},"end":{"line":148,"character":0}},"text":"  -- To do: provide the proof or find the correct Mathlib lemma for rnDeriv linearity.\n  sorry\n\n/-! ## Definition of the integral. -/\n\n/-- The integral with respect to a complex measure defined using the polar decomposition of the\ncomplex measure and the integral with respect to the total variation.-/\nnoncomputable def integral (μ : ComplexMeasure α) (f : α → G) :=\n  ∫ x,  μ.ang x • f x ∂(μ.var)\n\nnotation3 \"∫ \"(...)\", \"r:60:(scoped f => f)\" ∂\"μ:70 => integral μ r\n\n/-- Change of variables for the integral with respect to a complex measure defined by a density. -/\nlemma integral_withDensityᵥ_eq (μ : Measure α) [SigmaFinite μ] (h : α → ℂ)\n    (hf : Integrable h μ) (f : α → G) :\n    integral (μ.withDensityᵥ h) f = ∫ x, h x • f x ∂μ := by\n  dsimp [integral]\n  -- We need to show that (μ.withDensityᵥ h).var and (μ.withDensityᵥ h).ang\n  -- are related to |h| and h/|h|.\n  sorry\n\n/-! ## Some lemmas related to the integral. -/\n\n/-- For complex measures `μ`, `ν` and integrable function `f`: `∫ f d(μ + ν) = ∫ f dμ + ∫ f dν` -/\nlemma integral_add (μ ν : ComplexMeasure α) (f : α → G) :\n    integral (μ + ν) f = integral μ f + integral ν f := by\n  let lambda := μ.variation + ν.variation\n  have : IsFiniteMeasure lambda := inferInstance\n  have hμλ : μ ≪ᵥ lambda.toENNRealVectorMeasure := by\n    apply VectorMeasure.AbsolutelyContinuous.mk\n    intro s hmeas hs\n    rw [Measure.toENNRealVectorMeasure_apply_measurable hmeas] at hs\n    have : ‖μ s‖ₑ ≤ μ.variation s := by\n      unfold VectorMeasure.variation\n      rw [MeasureTheory.VectorMeasure.ennrealToMeasure_apply hmeas]\n      sorry\n    have : μ s = 0 := by\n      have : ‖μ s‖ₑ = 0 := by \n        apply le_antisymm _ (by positivity)\n        calc ‖μ s‖ₑ ≤ μ.variation s := this\n          _ ≤ lambda s := Measure.le_iff.mp (Measure.le_add_right (le_refl _)) s\n          _ = 0 := hs\n      exact enorm_eq_zero.mp this\n    exact this\n  have hνλ : ν ≪ᵥ lambda.toENNRealVectorMeasure := by\n    apply VectorMeasure.AbsolutelyContinuous.mk\n    intro s hmeas hs\n    rw [Measure.toENNRealVectorMeasure_apply_measurable hmeas] at hs\n    have : ‖ν s‖ₑ ≤ ν.variation s := by\n      unfold VectorMeasure.variation\n      rw [MeasureTheory.VectorMeasure.ennrealToMeasure_apply hmeas]\n      sorry\n    have : ν s = 0 := by\n      have : ‖ν s‖ₑ = 0 := by \n        apply le_antisymm _ (by positivity)\n        calc ‖ν s‖ₑ ≤ ν.variation s := this\n          _ ≤ lambda s := Measure.le_iff.mp (Measure.le_add_left (le_refl _)) s\n          _ = 0 := hs\n      exact enorm_eq_zero.mp this\n    exact this\n  obtain ⟨hμ, hμ_int, hμ_eq⟩ := exists_l1_eq_withDensity_variation_lambda μ lambda hμλ\n  obtain ⟨hν, hν_int, hν_eq⟩ := exists_l1_eq_withDensity_variation_lambda ν lambda hνλ\n  rw [hμ_eq, hν_eq, ← Measure.withDensityᵥ_add hμ_int hν_int]\n  rw [integral_withDensityᵥ_eq lambda (hμ + hν) (hμ_int.add hν_int) f]\n  rw [integral_withDensityᵥ_eq lambda hμ hμ_int f]\n  rw [integral_withDensityᵥ_eq lambda hν hν_int f]\n  rw [show (fun x => (hμ + hν) x • f x) = (fun x => hμ x • f x + hν x • f x) by ext x; rw [add_smul]]\n  rw [_root_.MeasureTheory.integral_add]\n  · sorry -- integrable check\n  · sorry -- integrable check\n\nlemma integral_neg (μ  : ComplexMeasure α) (f : α → G) :\n    integral (-μ) f = -integral μ f := by\n  dsimp [integral]\n  rw [ang_neg, var_neg]\n  rw [show (fun x => (-μ.ang x) • f x) = (fun x => -(μ.ang x • f x)) by ext x; rw [neg_smul]]\n  rw [_root_.MeasureTheory.integral_neg]\n\nlemma integral_sub (μ₁ μ₂  : ComplexMeasure α) (f : α → G) :\n    integral (μ₁ - μ₂) f = integral μ₁ f - integral μ₂ f := by\n  calc\n    _ = integral (μ₁ + (-μ₂)) f := by rfl\n    _ = integral μ₁ f + integral (-μ₂) f := by exact integral_add μ₁ (-μ₂) _\n    _ = integral μ₁ f - integral μ₂ f := by rw [integral_neg, sub_eq_add_neg]\n\n/-- The integral is linear with respect to the measure: `∫ f d(c • μ) = c • ∫ f dμ` -/\nlemma integral_smul_measure (c : ℂ) (μ : ComplexMeasure α) (f : α → G) :\n    integral (c • μ) f = c • integral μ f := by\n  -- Proof outline: similar to `integral_add`, use RN density with respect to a dominating measure.\n  sorry\n\n/-- The integral is linear with respect to the function: `∫ (c • f) dμ = c • ∫ f dμ` -/\nlemma integral_const_smul (c : ℂ) (μ : ComplexMeasure α) (f : α → G) :\n    integral μ (fun a => c • f a) = c • integral μ f := by\n  dsimp [integral]\n  rw [show (fun x => μ.ang x • (c • f x)) = (fun x => c • (μ.ang x • f x)) by ext x; rw [smul_comm]]\n  rw [_root_.MeasureTheory.integral_smul]\n\n/-- The integral is linear with respect to the function: `∫ (f + g) dμ = ∫ f dμ + ∫ g dμ` -/\nlemma integral_add_function (μ : ComplexMeasure α) (f g : α → G) :\n    integral μ (fun a => f a + g a) = integral μ f + integral μ g := by\n  dsimp [integral]\n  rw [show (fun x => μ.ang x • (f x + g x)) = (fun x => μ.ang x • f x + μ.ang x • g x) by ext x; rw [smul_add]]\n  rw [_root_.MeasureTheory.integral_add]\n","rangeOffset":1234,"rangeLength":4919}]}