import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Tactic
import InfoGeometry.Algebra.GradedNullconeAlgebra

/-!
# Graded Nullcone Parabolic Monodromy and Daviau–Fierz Chiral Spinor Bridge

This module bridges the five-axiom graded nullcone operator algebra
(`InfoGeometry.Algebra.GradedNullconeAlgebra`) to:

1. **Parabolic unipotent monodromy (`parabolicFlow`, `parabolic_unipotent_monodromy`)**:
   The one-parameter shear group generated by the unilateral Peirce nilpotent bridge
   `peirceY 1 = !![0, 1; 0, 0]`, stabilizing the `+` isotropic null ray while shearing
   `N₋` along `N₊`, with invariant trace `2`, determinant `1`, and `(U - I)^2 = 0`.
2. **Daviau–Hestenes / Lochak–Takabayasi chiral Dirac spinor & Fierz bridge**:
   Complex two-component Weyl–Krein spinor pairs `ChiralDiracSpinor = (plus, minus)` on
   `EuclideanSpace ℂ (Fin 2)` equipping the Fierz scalar `fierzScalar`, pseudoscalar
   `fierzPseudoscalar`, Krein probability density `kreinProbDensity`, axial charge density
   `chiralAxialDensity`, and spatial Dirac/axial currents `(JVec, J5Vec)` satisfying the
   exact Lochak–Fierz–Takabayasi Lorentz identities, orthogonal currents, massless nullcone
   reduction, and vector `U(2) / SU(2)` invariance.
-/

namespace InfoGeometry.Algebra.GradedNullconeDaviauFierzBridge

open scoped Matrix
open InfoGeometry.Algebra.GradedNullconeAlgebra

/-! ## Noncommutativity Witness for Complex `2 × 2` Matrices (Trap T16) -/

/-- Explicit Trap T16 noncommutativity witness for `Matrix (Fin 2) (Fin 2) ℂ`. -/
theorem mat2C_mul_noncommutative :
    ∃ A B : Matrix (Fin 2) (Fin 2) ℂ, A * B ≠ B * A := by
  refine ⟨!![1, 0; 0, -1], !![0, 1; 1, 0], ?_⟩
  intro hEq
  have h01 := congrFun (congrFun hEq 0) 1
  simp [Matrix.mul_apply, Fin.sum_univ_two] at h01
  norm_num at h01

/-! ## Parabolic Unipotent Monodromy Along the Unilateral Nullcone Bridge -/

/-- One-parameter unipotent parabolic flow `exp(t · peirceY 1) = [[1, t], [0, 1]]`. -/
def parabolicFlow (t : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  !![1, t; 0, 1]

/-- Complete algebraic monodromy laws of `parabolicFlow`: one-parameter additive group,
inverse law, invariant trace `2` and determinant `1`, index-2 unipotency `(U - 1)^2 = 0`,
logarithmic soldering recovery of the nilpotent Peirce bridge `peirceY 1`, and nullcone
stabilizer/shear action. -/
theorem parabolic_unipotent_monodromy (t s : ℝ) :
    (parabolicFlow 0 = 1) ∧
    (parabolicFlow t * parabolicFlow s = parabolicFlow (t + s)) ∧
    (parabolicFlow t * parabolicFlow (-t) = 1) ∧
    ((parabolicFlow t).trace = 2) ∧
    ((parabolicFlow t).det = 1) ∧
    ((parabolicFlow t - 1) * (parabolicFlow t - 1) = 0) ∧
    (parabolicFlow (-t) * peirceY (1 : ℝ) = peirceY (1 : ℝ)) ∧
    (parabolicFlow t *ᵥ ![1, 0] = ![1, 0] ∧ parabolicFlow t *ᵥ ![0, 1] = ![t, 1]) ∧
    (parabolicFlow 1 * gammaCut2 ≠ gammaCut2 * parabolicFlow 1) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ⟨?_, ?_⟩, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [parabolicFlow]
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [parabolicFlow, Matrix.mul_apply, Fin.sum_univ_two]
    ring
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [parabolicFlow, Matrix.mul_apply, Fin.sum_univ_two]
  · simp [parabolicFlow, Matrix.trace, Fin.sum_univ_two]
    ring
  · simp [parabolicFlow, Matrix.det_fin_two]
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [parabolicFlow, Matrix.mul_apply, Fin.sum_univ_two]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [parabolicFlow, peirceY, Matrix.mul_apply, Fin.sum_univ_two]
  · ext i
    fin_cases i <;> simp [parabolicFlow, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  · ext i
    fin_cases i <;> simp [parabolicFlow, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  · intro hEq
    have h01 := congrFun (congrFun hEq 0) 1
    simp [parabolicFlow, gammaCut2, Matrix.mul_apply, Fin.sum_univ_two] at h01
    linarith

/-! ## Chiral Dirac Spinors, Fierz Bilinears, and Daviau–Lochak Identities -/

/-- Two-component chiral Weyl–Krein pair `(ψ₊, ψ₋) ∈ ℂ² × ℂ²` matching `N₊ ⊕ N₋`. -/
structure ChiralDiracSpinor where
  /-- Right-handed nullcone Weyl component `ψ₊`. -/
  plus : EuclideanSpace ℂ (Fin 2)
  /-- Left-handed nullcone Weyl component `ψ₋`. -/
  minus : EuclideanSpace ℂ (Fin 2)

instance : Inhabited ChiralDiracSpinor :=
  ⟨⟨0, 0⟩⟩

/-- Fierz–Dirac scalar bilinear `σ = ψ† γ⁰ ψ = 2 Re ⟨ψ₊, ψ₋⟩`. -/
noncomputable def fierzScalar (ψ : ChiralDiracSpinor) : ℝ :=
  2 * (inner ℂ ψ.plus ψ.minus).re

/-- Fierz–Dirac pseudoscalar bilinear `ω = -i ψ† γ⁰ γ⁵ ψ = 2 Im ⟨ψ₊, ψ₋⟩`. -/
noncomputable def fierzPseudoscalar (ψ : ChiralDiracSpinor) : ℝ :=
  2 * (inner ℂ ψ.plus ψ.minus).im

/-- Positive Krein–Dirac probability density `J⁰ = ‖ψ₊‖² + ‖ψ₋‖²`. -/
noncomputable def kreinProbDensity (ψ : ChiralDiracSpinor) : ℝ :=
  ‖ψ.plus‖ ^ 2 + ‖ψ.minus‖ ^ 2

/-- Signed chiral axial charge density `J₅⁰ = ‖ψ₊‖² - ‖ψ₋‖²`. -/
noncomputable def chiralAxialDensity (ψ : ChiralDiracSpinor) : ℝ :=
  ‖ψ.plus‖ ^ 2 - ‖ψ.minus‖ ^ 2

/-- Spatial 3-spin density `(s₁, s₂, s₃) = (⟨u, σ₁ u⟩, ⟨u, σ₂ u⟩, ⟨u, σ₃ u⟩)` of `u ∈ ℂ²`. -/
private noncomputable def pauliVec3 (u : EuclideanSpace ℂ (Fin 2)) : Fin 3 → ℝ
  | 0 => 2 * (star (u 0) * u 1).re
  | 1 => 2 * (star (u 0) * u 1).im
  | 2 => Complex.normSq (u 0) - Complex.normSq (u 1)

/-- Spatial Dirac probability 3-current `J = s(ψ₊) - s(ψ₋)`. -/
private noncomputable def diracVec3 (ψ : ChiralDiracSpinor) : Fin 3 → ℝ :=
  fun k => pauliVec3 ψ.plus k - pauliVec3 ψ.minus k

/-- Spatial axial 3-current `J₅ = s(ψ₊) + s(ψ₋)`. -/
private noncomputable def axialVec3 (ψ : ChiralDiracSpinor) : Fin 3 → ℝ :=
  fun k => pauliVec3 ψ.plus k + pauliVec3 ψ.minus k

private noncomputable def dot3 (a b : Fin 3 → ℝ) : ℝ :=
  a 0 * b 0 + a 1 * b 1 + a 2 * b 2

private theorem norm_sq_eq_sum_normSq (u : EuclideanSpace ℂ (Fin 2)) :
    ‖u‖ ^ 2 = Complex.normSq (u 0) + Complex.normSq (u 1) := by
  rw [PiLp.norm_sq_eq_of_L2]
  simp [Fin.sum_univ_two, Complex.normSq_eq_norm_sq]

private theorem inner_eq_sum (u v : EuclideanSpace ℂ (Fin 2)) :
    inner ℂ u v = star (u 0) * v 0 + star (u 1) * v 1 := by
  rw [PiLp.inner_apply]
  simp [Fin.sum_univ_two, mul_comm]

private theorem pauliVec3_dot_self (u : EuclideanSpace ℂ (Fin 2)) :
    dot3 (pauliVec3 u) (pauliVec3 u) = ‖u‖ ^ 4 := by
  rw [show ‖u‖ ^ 4 = (‖u‖ ^ 2) ^ 2 by ring, norm_sq_eq_sum_normSq]
  simp only [dot3, pauliVec3, Complex.normSq_apply, Complex.mul_re, Complex.mul_im,
    Complex.conj_re, Complex.conj_im, Complex.star_def]
  ring

private theorem pauliVec3_dot (u v : EuclideanSpace ℂ (Fin 2)) :
    dot3 (pauliVec3 u) (pauliVec3 v) =
      2 * Complex.normSq (inner ℂ u v) - ‖u‖ ^ 2 * ‖v‖ ^ 2 := by
  rw [norm_sq_eq_sum_normSq u, norm_sq_eq_sum_normSq v, inner_eq_sum u v]
  simp only [dot3, pauliVec3, Complex.normSq_apply, Complex.add_re, Complex.add_im,
    Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im, Complex.star_def]
  ring

/-- Complete Lochak–Fierz–Takabayasi identities, Proca/massless chiral reduction, and
Krein vs. axial energy-density bounds on `ChiralDiracSpinor`. -/
theorem lochak_fierz_takabayasi_and_proca_coupling (ψ : ChiralDiracSpinor) :
    (0 ≤ kreinProbDensity ψ) ∧
    (fierzScalar ψ ^ 2 + fierzPseudoscalar ψ ^ 2 = 4 * Complex.normSq (inner ℂ ψ.plus ψ.minus)) ∧
    ((kreinProbDensity ψ) ^ 2 - dot3 (diracVec3 ψ) (diracVec3 ψ) =
      fierzScalar ψ ^ 2 + fierzPseudoscalar ψ ^ 2) ∧
    (dot3 (axialVec3 ψ) (axialVec3 ψ) - (chiralAxialDensity ψ) ^ 2 =
      fierzScalar ψ ^ 2 + fierzPseudoscalar ψ ^ 2) ∧
    (kreinProbDensity ψ * chiralAxialDensity ψ - dot3 (diracVec3 ψ) (axialVec3 ψ) = 0) ∧
    (fierzScalar ψ ^ 2 + fierzPseudoscalar ψ ^ 2 + chiralAxialDensity ψ ^ 2 =
      (kreinProbDensity ψ) ^ 2 -
        4 * Complex.normSq (ψ.plus 0 * ψ.minus 1 - ψ.plus 1 * ψ.minus 0)) ∧
    (fierzScalar ψ ^ 2 + fierzPseudoscalar ψ ^ 2 + chiralAxialDensity ψ ^ 2 ≤
      (kreinProbDensity ψ) ^ 2) ∧
    (ψ.plus = 0 ∨ ψ.minus = 0 →
      fierzScalar ψ = 0 ∧ fierzPseudoscalar ψ = 0 ∧
      (chiralAxialDensity ψ) ^ 2 = (kreinProbDensity ψ) ^ 2) := by
  have hFierz : fierzScalar ψ ^ 2 + fierzPseudoscalar ψ ^ 2 =
      4 * Complex.normSq (inner ℂ ψ.plus ψ.minus) := by
    simp only [fierzScalar, fierzPseudoscalar, Complex.normSq_apply]
    ring
  have hDet :
      4 * ‖ψ.plus‖ ^ 2 * ‖ψ.minus‖ ^ 2 -
        4 * Complex.normSq (inner ℂ ψ.plus ψ.minus) =
      4 * Complex.normSq (ψ.plus 0 * ψ.minus 1 - ψ.plus 1 * ψ.minus 0) := by
    rw [norm_sq_eq_sum_normSq ψ.plus, norm_sq_eq_sum_normSq ψ.minus, inner_eq_sum]
    simp only [Complex.normSq_apply, Complex.add_re, Complex.add_im, Complex.sub_re,
      Complex.sub_im, Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im,
      Complex.star_def]
    ring
  refine ⟨?_, hFierz, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp only [kreinProbDensity]
    positivity
  · simp only [kreinProbDensity, diracVec3, dot3]
    have hsp := pauliVec3_dot_self ψ.plus
    have hsm := pauliVec3_dot_self ψ.minus
    have hdp := pauliVec3_dot ψ.plus ψ.minus
    simp only [dot3] at hsp hsm hdp
    rw [hFierz]
    linarith [show (‖ψ.plus‖ ^ 2 + ‖ψ.minus‖ ^ 2) ^ 2 -
        ((pauliVec3 ψ.plus 0 - pauliVec3 ψ.minus 0) * (pauliVec3 ψ.plus 0 - pauliVec3 ψ.minus 0) +
        (pauliVec3 ψ.plus 1 - pauliVec3 ψ.minus 1) * (pauliVec3 ψ.plus 1 - pauliVec3 ψ.minus 1) +
        (pauliVec3 ψ.plus 2 - pauliVec3 ψ.minus 2) * (pauliVec3 ψ.plus 2 - pauliVec3 ψ.minus 2)) =
        2 * ‖ψ.plus‖ ^ 2 * ‖ψ.minus‖ ^ 2 + 2 * (pauliVec3 ψ.plus 0 * pauliVec3 ψ.minus 0 +
          pauliVec3 ψ.plus 1 * pauliVec3 ψ.minus 1 + pauliVec3 ψ.plus 2 * pauliVec3 ψ.minus 2) -
        ((pauliVec3 ψ.plus 0 * pauliVec3 ψ.plus 0 + pauliVec3 ψ.plus 1 * pauliVec3 ψ.plus 1 +
          pauliVec3 ψ.plus 2 * pauliVec3 ψ.plus 2) - ‖ψ.plus‖ ^ 4) -
        ((pauliVec3 ψ.minus 0 * pauliVec3 ψ.minus 0 + pauliVec3 ψ.minus 1 * pauliVec3 ψ.minus 1 +
          pauliVec3 ψ.minus 2 * pauliVec3 ψ.minus 2) - ‖ψ.minus‖ ^ 4) by ring]
  · simp only [chiralAxialDensity, axialVec3, dot3]
    have hsp := pauliVec3_dot_self ψ.plus
    have hsm := pauliVec3_dot_self ψ.minus
    have hdp := pauliVec3_dot ψ.plus ψ.minus
    simp only [dot3] at hsp hsm hdp
    rw [hFierz]
    linarith [show ((pauliVec3 ψ.plus 0 + pauliVec3 ψ.minus 0) *
          (pauliVec3 ψ.plus 0 + pauliVec3 ψ.minus 0) +
        (pauliVec3 ψ.plus 1 + pauliVec3 ψ.minus 1) * (pauliVec3 ψ.plus 1 + pauliVec3 ψ.minus 1) +
        (pauliVec3 ψ.plus 2 + pauliVec3 ψ.minus 2) * (pauliVec3 ψ.plus 2 + pauliVec3 ψ.minus 2)) -
        (‖ψ.plus‖ ^ 2 - ‖ψ.minus‖ ^ 2) ^ 2 =
        2 * ‖ψ.plus‖ ^ 2 * ‖ψ.minus‖ ^ 2 + 2 * (pauliVec3 ψ.plus 0 * pauliVec3 ψ.minus 0 +
          pauliVec3 ψ.plus 1 * pauliVec3 ψ.minus 1 + pauliVec3 ψ.plus 2 * pauliVec3 ψ.minus 2) +
        ((pauliVec3 ψ.plus 0 * pauliVec3 ψ.plus 0 + pauliVec3 ψ.plus 1 * pauliVec3 ψ.plus 1 +
          pauliVec3 ψ.plus 2 * pauliVec3 ψ.plus 2) - ‖ψ.plus‖ ^ 4) +
        ((pauliVec3 ψ.minus 0 * pauliVec3 ψ.minus 0 + pauliVec3 ψ.minus 1 * pauliVec3 ψ.minus 1 +
          pauliVec3 ψ.minus 2 * pauliVec3 ψ.minus 2) - ‖ψ.minus‖ ^ 4) by ring]
  · simp only [kreinProbDensity, chiralAxialDensity, diracVec3, axialVec3, dot3]
    have hsp := pauliVec3_dot_self ψ.plus
    have hsm := pauliVec3_dot_self ψ.minus
    simp only [dot3] at hsp hsm
    linarith [show (‖ψ.plus‖ ^ 2 + ‖ψ.minus‖ ^ 2) * (‖ψ.plus‖ ^ 2 - ‖ψ.minus‖ ^ 2) -
        ((pauliVec3 ψ.plus 0 - pauliVec3 ψ.minus 0) * (pauliVec3 ψ.plus 0 + pauliVec3 ψ.minus 0) +
        (pauliVec3 ψ.plus 1 - pauliVec3 ψ.minus 1) * (pauliVec3 ψ.plus 1 + pauliVec3 ψ.minus 1) +
        (pauliVec3 ψ.plus 2 - pauliVec3 ψ.minus 2) * (pauliVec3 ψ.plus 2 + pauliVec3 ψ.minus 2)) =
        (‖ψ.plus‖ ^ 4 - (pauliVec3 ψ.plus 0 * pauliVec3 ψ.plus 0 +
          pauliVec3 ψ.plus 1 * pauliVec3 ψ.plus 1 + pauliVec3 ψ.plus 2 * pauliVec3 ψ.plus 2)) -
        (‖ψ.minus‖ ^ 4 - (pauliVec3 ψ.minus 0 * pauliVec3 ψ.minus 0 +
          pauliVec3 ψ.minus 1 * pauliVec3 ψ.minus 1 + pauliVec3 ψ.minus 2 * pauliVec3 ψ.minus 2))
        by ring]
  · rw [hFierz, ← hDet]
    simp only [kreinProbDensity, chiralAxialDensity]
    ring
  · rw [show fierzScalar ψ ^ 2 + fierzPseudoscalar ψ ^ 2 + chiralAxialDensity ψ ^ 2 =
        (kreinProbDensity ψ) ^ 2 -
          4 * Complex.normSq (ψ.plus 0 * ψ.minus 1 - ψ.plus 1 * ψ.minus 0) by
      rw [hFierz, ← hDet]
      simp only [kreinProbDensity, chiralAxialDensity]
      ring]
    have hnonneg : 0 ≤ Complex.normSq (ψ.plus 0 * ψ.minus 1 - ψ.plus 1 * ψ.minus 0) :=
      Complex.normSq_nonneg _
    linarith
  · rintro (h0 | h0) <;>
    · simp only [h0, fierzScalar, fierzPseudoscalar, chiralAxialDensity, kreinProbDensity,
        inner_zero_left, inner_zero_right, Complex.zero_re, Complex.zero_im, norm_zero]
      constructor <;> [norm_num; constructor <;> [norm_num; ring]]

/-- Vector unitary action `ψ ↦ (U ψ₊, U ψ₋)` in `U(2)` / `SU(2)`. -/
noncomputable def vectorGaugeAct (U : Matrix (Fin 2) (Fin 2) ℂ) (ψ : ChiralDiracSpinor) :
    ChiralDiracSpinor where
  plus := (WithLp.equiv 2 (Fin 2 → ℂ)).symm (U *ᵥ ψ.plus.ofLp)
  minus := (WithLp.equiv 2 (Fin 2 → ℂ)).symm (U *ᵥ ψ.minus.ofLp)

private theorem re_inner_self_eq_norm_sq (a : EuclideanSpace ℂ (Fin 2)) :
    (inner ℂ a a).re = ‖a‖ ^ 2 := by
  rw [PiLp.inner_apply, norm_sq_eq_sum_normSq a]
  simp [Fin.sum_univ_two, Complex.normSq_eq_norm_sq, ← Complex.ofReal_pow]

/-- Daviau vector `SU(2)` / `U(2)` invariance: any unitary `2 × 2` matrix (`Uᴴ * U = 1`) acting
diagonally on `(ψ₊, ψ₋)` preserves the chiral pairing `⟨ψ₊, ψ₋⟩`, both Fierz invariants
`(σ, ω)`, the Krein density `J⁰`, and the axial density `J₅⁰`. -/
theorem daviau_vector_su2_preserves_chiral_pairing
    (U : Matrix (Fin 2) (Fin 2) ℂ) (hU : Uᴴ * U = 1) (ψ : ChiralDiracSpinor) :
    (inner ℂ (vectorGaugeAct U ψ).plus (vectorGaugeAct U ψ).minus = inner ℂ ψ.plus ψ.minus) ∧
    (fierzScalar (vectorGaugeAct U ψ) = fierzScalar ψ) ∧
    (fierzPseudoscalar (vectorGaugeAct U ψ) = fierzPseudoscalar ψ) ∧
    (kreinProbDensity (vectorGaugeAct U ψ) = kreinProbDensity ψ) ∧
    (chiralAxialDensity (vectorGaugeAct U ψ) = chiralAxialDensity ψ) := by
  have hpair :
      ∀ a b : EuclideanSpace ℂ (Fin 2),
        inner ℂ ((WithLp.equiv 2 (Fin 2 → ℂ)).symm (U *ᵥ a.ofLp))
          ((WithLp.equiv 2 (Fin 2 → ℂ)).symm (U *ᵥ b.ofLp)) = inner ℂ a b := by
    intro a b
    have hdot :
        (star (U *ᵥ a.ofLp)) ⬝ᵥ (U *ᵥ b.ofLp) = star a.ofLp ⬝ᵥ b.ofLp := by
      calc
        (star (U *ᵥ a.ofLp)) ⬝ᵥ (U *ᵥ b.ofLp)
            = (star a.ofLp ᵥ* Uᴴ) ⬝ᵥ (U *ᵥ b.ofLp) := by
                rw [Matrix.star_mulVec]
        _ = ((star a.ofLp ᵥ* Uᴴ) ᵥ* U) ⬝ᵥ b.ofLp := by
              rw [Matrix.dotProduct_mulVec]
        _ = (star a.ofLp ᵥ* (Uᴴ * U)) ⬝ᵥ b.ofLp := by
              rw [Matrix.vecMul_vecMul]
        _ = star a.ofLp ⬝ᵥ b.ofLp := by
              rw [hU, Matrix.vecMul_one]
    rw [inner_eq_sum, inner_eq_sum]
    change star ((U *ᵥ a.ofLp) 0) * (U *ᵥ b.ofLp) 0 +
        star ((U *ᵥ a.ofLp) 1) * (U *ᵥ b.ofLp) 1 =
      star (a.ofLp 0) * b.ofLp 0 + star (a.ofLp 1) * b.ofLp 1
    simpa [dotProduct, Fin.sum_univ_two] using hdot
  have hnorm :
      ∀ a : EuclideanSpace ℂ (Fin 2),
        ‖(WithLp.equiv 2 (Fin 2 → ℂ)).symm (U *ᵥ a.ofLp)‖ ^ 2 = ‖a‖ ^ 2 := by
    intro a
    have hre := congrArg Complex.re (hpair a a)
    rwa [re_inner_self_eq_norm_sq, re_inner_self_eq_norm_sq] at hre
  have hmain : inner ℂ (vectorGaugeAct U ψ).plus (vectorGaugeAct U ψ).minus =
      inner ℂ ψ.plus ψ.minus :=
    hpair ψ.plus ψ.minus
  refine ⟨hmain, ?_, ?_, ?_, ?_⟩
  · simp [fierzScalar, hmain]
  · simp [fierzPseudoscalar, hmain]
  · simp only [kreinProbDensity, vectorGaugeAct, hnorm ψ.plus, hnorm ψ.minus]
  · simp only [chiralAxialDensity, vectorGaugeAct, hnorm ψ.plus, hnorm ψ.minus]

end InfoGeometry.Algebra.GradedNullconeDaviauFierzBridge
