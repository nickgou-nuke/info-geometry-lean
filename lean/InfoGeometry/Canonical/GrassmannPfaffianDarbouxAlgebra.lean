/-! ## 1. Grassmann No. 511 — Algebraic Pfaff Exterior Vanishing (`p. 379`) -/

section PfaffJetNo511

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- Algebraic jet 1-form `ω = ∑ i, uᵢ ι(αᵢ)` corresponding to `∑ Uᵢ duᵢ`. -/
def pfaffJetOneForm {n : ℕ} (u : Fin n → R) (α : Fin n → M) : ExteriorAlgebra R M :=
  ∑ i : Fin n, u i • ExteriorAlgebra.ι R (α i)

/-- Algebraic jet 2-form `Ω = ∑ i, ι(βᵢ) ∧ ι(αᵢ)` corresponding to `∑ dUᵢ ∧ duᵢ`. -/
def pfaffJetTwoForm {n : ℕ} (β α : Fin n → M) : ExteriorAlgebra R M :=
  ∑ i : Fin n, ExteriorAlgebra.ι R (β i) * ExteriorAlgebra.ι R (α i)

/-- Invariant submodule generated by `pref * ιMulti k (α ∘ g)` with injective `g : Fin k → Fin n`. -/
def spanInjBlades {n : ℕ} (α : Fin n → M) (k : ℕ) : Submodule R (ExteriorAlgebra R M) :=
  Submodule.span R
    {z : ExteriorAlgebra R M |
      ∃ (pref : ExteriorAlgebra R M) (g : Fin k → Fin n),
        Function.Injective g ∧ z = pref * ExteriorAlgebra.ιMulti R k (α ∘ g)}

private theorem pfaffJetOneForm_mem_spanInjBlades {n : ℕ} (u : Fin n → R) (α : Fin n → M) :
    pfaffJetOneForm u α ∈ spanInjBlades α 1 := by
  dsimp [pfaffJetOneForm]
  refine Submodule.sum_mem _ fun i _ => Submodule.subset_span ?_
  refine ⟨algebraMap R (ExteriorAlgebra R M) (u i), (fun _ : Fin 1 => i),
    fun a b _ => Subsingleton.elim a b, ?_⟩
  rw [ExteriorAlgebra.ιMulti_succ_apply, ExteriorAlgebra.ιMulti_zero_apply, mul_one,
    Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
  rfl

private theorem mul_pfaffJetTwoForm_mem_spanInjBlades {n k : ℕ} (β α : Fin n → M)
    {z : ExteriorAlgebra R M} (hz : z ∈ spanInjBlades α k) :
    z * pfaffJetTwoForm β α ∈ spanInjBlades α (k + 1) := by
  induction hz using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨pref, g, _, rfl⟩ := hw
    dsimp [pfaffJetTwoForm]
    rw [Finset.mul_sum]
    refine Submodule.sum_mem _ fun j _ => ?_
    have h2_mem : ExteriorAlgebra.ι R (β j) * ExteriorAlgebra.ι R (α j) ∈ ⋀[R]^2 M := by
      rw [ExteriorAlgebra.exteriorPower, pow_two]
      exact Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) (LinearMap.mem_range_self _ _)
    have hcomm_2 := exteriorPower_two_mul_comm h2_mem (ExteriorAlgebra.ιMulti R k (α ∘ g))
    have hcons : ExteriorAlgebra.ι R (α j) * ExteriorAlgebra.ιMulti R k (α ∘ g) =
        ExteriorAlgebra.ιMulti R (k + 1) (α ∘ Fin.cons j g) := by
      rw [ExteriorAlgebra.ιMulti_succ_apply]
      rfl
    have hprod : (pref * ExteriorAlgebra.ιMulti R k (α ∘ g)) *
        (ExteriorAlgebra.ι R (β j) * ExteriorAlgebra.ι R (α j)) =
        (pref * ExteriorAlgebra.ι R (β j)) *
          ExteriorAlgebra.ιMulti R (k + 1) (α ∘ Fin.cons j g) := by
      calc
        (pref * ExteriorAlgebra.ιMulti R k (α ∘ g)) *
            (ExteriorAlgebra.ι R (β j) * ExteriorAlgebra.ι R (α j))
            = pref * (ExteriorAlgebra.ιMulti R k (α ∘ g) *
                (ExteriorAlgebra.ι R (β j) * ExteriorAlgebra.ι R (α j))) := by simp only [mul_assoc]
        _ = pref * ((ExteriorAlgebra.ι R (β j) * ExteriorAlgebra.ι R (α j)) *
                ExteriorAlgebra.ιMulti R k (α ∘ g)) := by rw [← hcomm_2]
        _ = (pref * ExteriorAlgebra.ι R (β j)) *
              (ExteriorAlgebra.ι R (α j) * ExteriorAlgebra.ιMulti R k (α ∘ g)) := by
            simp only [mul_assoc]
        _ = (pref * ExteriorAlgebra.ι R (β j)) *
              ExteriorAlgebra.ιMulti R (k + 1) (α ∘ Fin.cons j g) := by rw [hcons]
    rw [hprod]
    by_cases hinj : Function.Injective (Fin.cons j g)
    · exact Submodule.subset_span ⟨_, Fin.cons j g, hinj, rfl⟩
    · have hdep : ¬Function.Injective (α ∘ Fin.cons j g) := fun h =>
        hinj (Function.Injective.of_comp h)
      rw [ExteriorAlgebra.ιMulti_eq_zero_of_not_inj hdep, mul_zero]
      exact Submodule.zero_mem _
  | zero =>
    rw [zero_mul]
    exact Submodule.zero_mem _
  | add x y _ _ ihx ihy =>
    rw [add_mul]
    exact Submodule.add_mem _ ihx ihy
  | smul r x _ ih =>
    rw [smul_mul_assoc]
    exact Submodule.smul_mem _ r ih

private theorem spanInjBlades_succ_eq_bot {n : ℕ} (α : Fin n → M) :
    spanInjBlades (R := R) α (n + 1) = ⊥ := by
  rw [eq_bot_iff, spanInjBlades, Submodule.span_le]
  rintro _ ⟨_, g, hg, rfl⟩
  exfalso
  exact absurd hg (Fintype.not_injective_of_card_lt g (by simp))

/-- **Grassmann No. 511 (`p. 379`)**: For `ω = ∑ i, uᵢ ι(αᵢ)` and `Ω = ∑ i, ι(βᵢ) ∧ ι(αᵢ)`
over ANY `[CommRing R]` and ANY `R`-module `M`, `ω * Ω ^ n = 0`. -/
theorem grassmann_no511_pfaff_exterior_vanishing {n : ℕ} (u : Fin n → R) (β α : Fin n → M) :
    pfaffJetOneForm u α * (pfaffJetTwoForm β α) ^ n = 0 := by
  have hstep : ∀ k : ℕ,
      pfaffJetOneForm u α * (pfaffJetTwoForm β α) ^ k ∈ spanInjBlades α (1 + k) := fun k => by
    induction k with
    | zero =>
      simpa only [pow_zero, mul_one, add_zero] using pfaffJetOneForm_mem_spanInjBlades u α
    | succ k ih =>
      rw [pow_succ, ← mul_assoc, show 1 + (k + 1) = (1 + k) + 1 by omega]
      exact mul_pfaffJetTwoForm_mem_spanInjBlades β α ih
  have hmem := hstep n
  rw [show 1 + n = n + 1 by omega, spanInjBlades_succ_eq_bot α] at hmem
  exact (Submodule.mem_bot R).mp hmem

end PfaffJetNo511

/-! ## 2. Grassmann No. 518 — Exterior Division / Algebraic Darboux Class (`pp. 383–384`) -/

section ExteriorDivisionNo518

section CommRingDivision

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

theorem contractLeft_two_mem_range_ι (d : Module.Dual R M)
    {Ω : ExteriorAlgebra R M} (hΩ : Ω ∈ ⋀[R]^2 M) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω ∈
      LinearMap.range (ExteriorAlgebra.ι R) := by
  rw [← ExteriorAlgebra.ιMulti_span_fixedDegree R 2] at hΩ
  induction hΩ using Submodule.span_induction with
  | mem _ h =>
    obtain ⟨v, rfl⟩ := h
    rw [ExteriorAlgebra.ιMulti_succ_apply, ExteriorAlgebra.ιMulti_succ_apply,
      ExteriorAlgebra.ιMulti_zero_apply, mul_one]
    have hmul := CliffordAlgebra.contractLeft_ι_mul (Q := (0 : QuadraticForm R M)) d (v 0)
      (ExteriorAlgebra.ι R (Matrix.vecTail v 0))
    have hι0 : CliffordAlgebra.ι (0 : QuadraticForm R M) (v 0) = ExteriorAlgebra.ι R (v 0) := rfl
    have hs : CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d
        (ExteriorAlgebra.ι R (Matrix.vecTail v 0)) = algebraMap R _ (d (Matrix.vecTail v 0)) :=
      CliffordAlgebra.contractLeft_ι (d := d) (0 : QuadraticForm R M) (Matrix.vecTail v 0)
    rw [hι0] at hmul
    rw [hmul, hs, Algebra.algebraMap_eq_smul_one, mul_smul_comm, mul_one,
      ← (ExteriorAlgebra.ι R).map_smul, ← (ExteriorAlgebra.ι R).map_smul,
      ← (ExteriorAlgebra.ι R).map_sub]
    exact LinearMap.mem_range_self _ _
  | zero => simp
  | add x y _ _ ihx ihy =>
    rw [map_add]
    exact Submodule.add_mem _ ihx ihy
  | smul r x _ ih =>
    rw [map_smul]
    exact Submodule.smul_mem _ r ih

/-- On any 2-form `Ω ∈ ⋀[R]^2 M`, left contraction differentiates powers via
`contractLeft d (Ω ^ (k + 1)) = (k + 1) • (contractLeft d Ω * Ω ^ k)`. -/
theorem contractLeft_two_pow_succ (d : Module.Dual R M)
    {Ω : ExteriorAlgebra R M} (hΩ : Ω ∈ ⋀[R]^2 M) (k : ℕ) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d (Ω ^ (k + 1)) =
      ((k + 1 : ℕ) : R) •
        (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω * Ω ^ k) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ' Ω (k + 1), contractLeft_mul_of_mem_exteriorPower d hΩ (Ω ^ (k + 1))]
    have hsq : (-1 : R) ^ 2 = 1 := by norm_num
    rw [hsq, one_smul, ih, mul_smul_comm]
    have hcomm_dΩ : Ω * CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω =
        CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω * Ω :=
      exteriorPower_two_mul_comm hΩ _
    rw [← mul_assoc, hcomm_dΩ, mul_assoc, ← pow_succ']
    calc
      CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω * Ω ^ (k + 1) +
          ((k + 1 : ℕ) : R) •
            (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω * Ω ^ (k + 1))
          = ((1 : R) + ((k + 1 : ℕ) : R)) •
              (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω * Ω ^ (k + 1)) := by
        rw [add_smul, one_smul]
      _ = ((k + 2 : ℕ) : R) •
            (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω * Ω ^ (k + 1)) := by
        push_cast
        ring_nf

/-- **Grassmann No. 518 over Arbitrary Commutative Rings (`pp. 383–384`)**:
Given `d : Dual R M` with `d x = 1` and `Ω ∈ ⋀[R]^2 M`,
`ι R x * Ω ^ n = 0 → Ω ^ (n + 1) = 0`. -/
theorem grassmann_no518_exterior_division_of_dual_one (x : M) (d : Module.Dual R M)
    (hd : d x = 1) {Ω : ExteriorAlgebra R M} (hΩ : Ω ∈ ⋀[R]^2 M) (n : ℕ)
    (hxΩ : ExteriorAlgebra.ι R x * Ω ^ n = 0) :
    Ω ^ (n + 1) = 0 := by
  cases n with
  | zero =>
    rw [pow_zero, mul_one] at hxΩ
    have h1 := congrArg (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d) hxΩ
    rw [CliffordAlgebra.contractLeft_ι, hd, map_one, map_zero] at h1
    rw [zero_add, pow_one, ← mul_one Ω, h1, mul_zero]
  | succ k =>
    have hcon := congrArg (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d) hxΩ
    rw [CliffordAlgebra.contractLeft_ι_mul, hd, one_smul, map_zero, sub_eq_zero,
      contractLeft_two_pow_succ d hΩ k] at hcon
    have hmulΩ := congrArg (· * Ω) hcon
    have hιx : CliffordAlgebra.ι (0 : QuadraticForm R M) x = ExteriorAlgebra.ι R x := rfl
    rw [← pow_succ, hιx, mul_smul_comm, smul_mul_assoc] at hmulΩ
    simp only [mul_assoc] at hmulΩ
    rw [← pow_succ] at hmulΩ
    have hcomm : Commute Ω (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω) :=
      exteriorPower_two_mul_comm hΩ _
    have hcomm_pow :
        CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω * Ω ^ (k + 1) =
          Ω ^ (k + 1) * CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) d Ω :=
      (hcomm.pow_left (k + 1)).symm.eq
    rw [hcomm_pow, ← mul_assoc, hxΩ, zero_mul, smul_zero] at hmulΩ
    exact hmulΩ

end CommRingDivision

section FieldDivision

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- **Grassmann No. 518 Exterior Division / Darboux-Class Theorem (`pp. 383–384`)**:
Over ANY field `K` and any `K`-vector space `V`, if `x ≠ 0` and `Ω ∈ ⋀[K]^2 V`, then
`ι K x * Ω ^ n = 0 → Ω ^ (n + 1) = 0`. -/
theorem grassmann_no518_exterior_division {x : V} (hx : x ≠ 0)
    {Ω : ExteriorAlgebra K V} (hΩ : Ω ∈ ⋀[K]^2 V) (n : ℕ)
    (hxΩ : ExteriorAlgebra.ι K x * Ω ^ n = 0) :
    Ω ^ (n + 1) = 0 := by
  obtain ⟨d, hd⟩ := Module.Projective.exists_dual_eq_one K hx
  exact grassmann_no518_exterior_division_of_dual_one x d hd hΩ n hxΩ

/-- Monotone vanishing along the Pfaff–Darboux chain: once `ι x * Ω ^ n = 0`, all higher
`ι x * Ω ^ m` and `Ω ^ (m + 1)` vanish for `m ≥ n`. -/
theorem darboux_pfaff_monotone_vanishing {x : V} (hx : x ≠ 0)
    {Ω : ExteriorAlgebra K V} (hΩ : Ω ∈ ⋀[K]^2 V) {n m : ℕ} (hnm : n ≤ m)
    (hxΩ : ExteriorAlgebra.ι K x * Ω ^ n = 0) :
    ExteriorAlgebra.ι K x * Ω ^ m = 0 ∧ Ω ^ (m + 1) = 0 := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnm
  have hxmn : ExteriorAlgebra.ι K x * Ω ^ (n + k) = 0 := by
    rw [pow_add, ← mul_assoc, hxΩ, zero_mul]
  exact ⟨hxmn, grassmann_no518_exterior_division hx hΩ (n + k) hxmn⟩

/-- In finite dimension `m` with nonzero `x ≠ 0` and any 2-form `Ω ∈ ⋀[K]^2 V`:
`(ι K x * Ω ^ m = 0)` and `Ω ^ (m + 1) = 0`, while `ι K x * Ω ^ 0 = ι K x ≠ 0`, guaranteeing a
well-defined algebraic Pfaff rank `k ≤ m` with `1 ≤ k`. -/
theorem darboux_pfaff_finite_termination {m : ℕ} (b : Module.Basis (Fin m) K V)
    {x : V} (hx : x ≠ 0) {Ω : ExteriorAlgebra K V} (hΩ : Ω ∈ ⋀[K]^2 V) :
    ExteriorAlgebra.ι K x * Ω ^ 0 ≠ 0 ∧
      ExteriorAlgebra.ι K x * Ω ^ m = 0 ∧
      Ω ^ (m + 1) = 0 := by
  have hdeg_pow : ∀ k : ℕ, Ω ^ k ∈ ⋀[K]^(2 * k) V := fun k => by
    induction k with
    | zero =>
      rw [mul_zero, pow_zero, ExteriorAlgebra.exteriorPower, pow_zero]
      exact Submodule.mem_one.mpr ⟨1, map_one _⟩
    | succ k ih =>
      rw [pow_succ, mul_add, mul_one, ExteriorAlgebra.exteriorPower, pow_add]
      exact Submodule.mul_mem_mul ih hΩ
  have htop : ExteriorAlgebra.ι K x * Ω ^ m ∈ ⋀[K]^(1 + 2 * m) V := by
    rw [ExteriorAlgebra.exteriorPower, pow_add, pow_one]
    exact Submodule.mul_mem_mul (LinearMap.mem_range_self _ x) (hdeg_pow m)
  have hzero_top : ExteriorAlgebra.ι K x * Ω ^ m = 0 :=
    exteriorPower_eq_zero_of_gt b (by omega) htop
  refine ⟨?_, hzero_top, grassmann_no518_exterior_division hx hΩ m hzero_top⟩
  rw [pow_zero, mul_one]
  intro hι0
  exact hx ((ExteriorAlgebra.ι_eq_zero_iff x).1 hι0)

end FieldDivision

end ExteriorDivisionNo518

/-! ## 3. Cayley Bordered `5 × 5` Skew-Symmetric Pfaffian Identity (`Eq. (15), p. 382`) -/

section CayleyBorderedPfaffian5

variable {R : Type*} [CommRing R]

/-- `5 × 5` bordered skew-symmetric matrix with top row `[0, x₁, x₂, x₃, x₄]` and lower `4 × 4`
skew block `skewMatrix4 a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄` (`hmath019-endmatter.pdf`, p. 382). -/
def borderedSkewMatrix5 (x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ : R) :
    Matrix (Fin 5) (Fin 5) R :=
  !![0,    x₁,   x₂,   x₃,   x₄;
    -x₁,   0,    a₁₂,  a₁₃,  a₁₄;
    -x₂,  -a₁₂,  0,    a₂₃,  a₂₄;
    -x₃,  -a₁₃, -a₂₃,  0,    a₃₄;
    -x₄,  -a₁₄, -a₂₄, -a₃₄,  0]

/-- Characteristic Pfaffian cofactor vector `ξ_μ = (-1)^μ pf_{0, 1, ..., μ̂, ..., 4}` (`p. 382`). -/
def borderedCharacteristicVec (x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ : R) : Fin 4 → R :=
  ![ -pfaffian4 x₂ x₃ x₄ a₂₃ a₂₄ a₃₄,
      pfaffian4 x₁ x₃ x₄ a₁₃ a₁₄ a₃₄,
     -pfaffian4 x₁ x₂ x₄ a₁₂ a₁₄ a₂₄,
      pfaffian4 x₁ x₂ x₃ a₁₂ a₁₃ a₂₃ ]

theorem borderedSkewMatrix5_transpose (x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ : R) :
    (borderedSkewMatrix5 x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄)ᵀ =
      -borderedSkewMatrix5 x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [borderedSkewMatrix5, Matrix.transpose_apply]

/-- **Cayley's Bordered Pfaffian Identity (Eq. (15), `p. 382`)**:
1. Row-0 tangency: `dotProduct ![x₁, x₂, x₃, x₄] ξ = 0`.
2. Characteristic multiplication: `(skewMatrix4 a...) *ᵥ ξ = pfaffian4 a... • ![x₁, x₂, x₃, x₄]`.
3. Odd-class reduction: whenever `pfaffian4 a... = 0`, `ξ` is simultaneously a kernel vector
   of `skewMatrix4` and orthogonal to `![x₁, x₂, x₃, x₄]`. -/
theorem cayley_bordered_pfaffian5_identity (x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ : R) :
    dotProduct ![x₁, x₂, x₃, x₄] (borderedCharacteristicVec x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄) = 0 ∧
      (skewMatrix4 a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄).mulVec
          (borderedCharacteristicVec x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄) =
        pfaffian4 a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ • ![x₁, x₂, x₃, x₄] ∧
      (pfaffian4 a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ = 0 →
        (skewMatrix4 a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄).mulVec
          (borderedCharacteristicVec x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄) = 0) := by
  have htang :
      dotProduct ![x₁, x₂, x₃, x₄] (borderedCharacteristicVec x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄) = 0 := by
    simp [dotProduct, borderedCharacteristicVec, pfaffian4, Fin.sum_univ_four]
    ring
  have hchar :
      (skewMatrix4 a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄).mulVec
          (borderedCharacteristicVec x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄) =
        pfaffian4 a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ • ![x₁, x₂, x₃, x₄] := by
    ext i
    fin_cases i <;>
      simp [Matrix.mulVec, dotProduct, skewMatrix4, borderedCharacteristicVec, pfaffian4,
        Fin.sum_univ_four] <;>
      ring
  refine ⟨htang, hchar, ?_⟩
  intro hpf
  rw [hchar, hpf, zero_smul]

end CayleyBorderedPfaffian5

/-! ## 4. 8-Node Acyclic Causal Poset & Master Epistemic Coagulation -/

section CausalPosetAndMasterCoagulation

/-- Eight-node non-linear branching causal poset covering `hmath019-endmatter.pdf`. -/
inductive GrassmannEndmatterArchetype : Type
  | GA1_GradedCommutativityHodgeSquare
  | GA2_PoincareContractionBasisCovariance
  | GA3_CodimOneVsDim4CompoundBivector
  | GA4_No103ShuffleAndNote31Countermodel
  | GA5_NormalShadowReciprocityAndPolarization
  | GA6_No511PfaffJetVanishing
  | GA7_No518ExteriorDivisionAndCayleyPfaffian
  | GA8_MasterAusdehnungslehreSynthesis
  deriving DecidableEq, Repr

open GrassmannEndmatterArchetype

def gaLe : GrassmannEndmatterArchetype → GrassmannEndmatterArchetype → Prop
  | a, b =>
    a = b ∨
    a = GA1_GradedCommutativityHodgeSquare ∨
    b = GA8_MasterAusdehnungslehreSynthesis ∨
    (a = GA2_PoincareContractionBasisCovariance ∧
      (b = GA3_CodimOneVsDim4CompoundBivector ∨
       b = GA4_No103ShuffleAndNote31Countermodel ∨
       b = GA5_NormalShadowReciprocityAndPolarization)) ∨
    (a = GA6_No511PfaffJetVanishing ∧ b = GA7_No518ExteriorDivisionAndCayleyPfaffian)

instance : DecidableRel gaLe := fun a b => by
  dsimp [gaLe]
  infer_instance

instance : PartialOrder GrassmannEndmatterArchetype where
  le := gaLe
  le_refl a := by cases a <;> decide
  le_trans a b c := by cases a <;> cases b <;> cases c <;> decide
  le_antisymm a b := by cases a <;> cases b <;> decide

instance : DecidableLE GrassmannEndmatterArchetype := fun a b =>
  inferInstanceAs (Decidable (gaLe a b))

instance : DecidableLT GrassmannEndmatterArchetype := fun a b => by
  change Decidable (gaLe a b ∧ ¬ gaLe b a)
  infer_instance

/-- Explicit non-linear branching witnesses in the 8-node causal poset. -/
theorem grassmann_endmatter_poset_branching :
    ¬ (GA3_CodimOneVsDim4CompoundBivector ≤ GA6_No511PfaffJetVanishing) ∧
      ¬ (GA6_No511PfaffJetVanishing ≤ GA3_CodimOneVsDim4CompoundBivector) ∧
      ¬ (GA4_No103ShuffleAndNote31Countermodel ≤ GA5_NormalShadowReciprocityAndPolarization) ∧
      ¬ (GA5_NormalShadowReciprocityAndPolarization ≤ GA4_No103ShuffleAndNote31Countermodel) ∧
      GA1_GradedCommutativityHodgeSquare < GA2_PoincareContractionBasisCovariance ∧
      GA2_PoincareContractionBasisCovariance < GA4_No103ShuffleAndNote31Countermodel ∧
      GA4_No103ShuffleAndNote31Countermodel < GA8_MasterAusdehnungslehreSynthesis ∧
      GA6_No511PfaffJetVanishing < GA7_No518ExteriorDivisionAndCayleyPfaffian ∧
      GA7_No518ExteriorDivisionAndCayleyPfaffian < GA8_MasterAusdehnungslehreSynthesis := by
  decide

/-- Concrete Master Synthesis bridging every pillar proved across
`GrassmannAusdehnungslehreRegressiveShadow` and `GrassmannPfaffianDarbouxAlgebra`. -/
theorem grassmann_endmatter_master_synthesis :
    (let b3 := Pi.basisFun ℝ (Fin 3)
     let ω := b3.ExteriorAlgebra {0, 1}
     hodge b3 (hodge b3 ω) = ω) ∧
      (∀ (b' : Module.Basis (Fin 3) ℝ (Fin 3 → ℝ)) (x y : ExteriorAlgebra ℝ (Fin 3 → ℝ)),
        ((Pi.basisFun ℝ (Fin 3)).det b') • regressive b' x y =
          regressive (Pi.basisFun ℝ (Fin 3)) x y) ∧
      (let b4 := Pi.basisFun ℝ (Fin 4)
       bladeSupport (ExteriorAlgebra.ι ℝ (b4 0) * ExteriorAlgebra.ι ℝ (b4 1) +
         ExteriorAlgebra.ι ℝ (b4 2) * ExteriorAlgebra.ι ℝ (b4 3)) = ⊥) ∧
      (let b5 := Pi.basisFun ℝ (Fin 5)
       let A := ExteriorAlgebra.ι ℝ (b5 0) * ExteriorAlgebra.ι ℝ (b5 1)
       let B := ExteriorAlgebra.ι ℝ (b5 0) * ExteriorAlgebra.ι ℝ (b5 2)
       let C := ExteriorAlgebra.ι ℝ (b5 3) * ExteriorAlgebra.ι ℝ (b5 4)
       regressive b5 (A * C) (B * C) ≠ C * regressive b5 (A * B) C) ∧
      (let b4 := Pi.basisFun ℝ (Fin 4)
       let A := ExteriorAlgebra.ι ℝ (b4 0) + ExteriorAlgebra.ι ℝ (b4 1)
       let B := ExteriorAlgebra.ι ℝ (b4 0) * ExteriorAlgebra.ι ℝ (b4 2) +
         ExteriorAlgebra.ι ℝ (b4 1) * ExteriorAlgebra.ι ℝ (b4 3)
       extInner b4 A (normalShadowLeft b4 A B) = extInner b4 (normalShadowRight b4 A B) B) ∧
      (sigPos indefiniteForm2.toQuadraticMap = 1 ∧
        sigNeg indefiniteForm2.toQuadraticMap = 1) ∧
      (∀ (u : Fin 3 → ℝ) (β α : Fin 3 → (Fin 4 → ℝ)),
        pfaffJetOneForm u α * (pfaffJetTwoForm β α) ^ 3 = 0) ∧
      (∀ (x : Fin 4 → ℝ) (Ω : ExteriorAlgebra ℝ (Fin 4 → ℝ)),
        x ≠ 0 → Ω ∈ ⋀[ℝ]^2 (Fin 4 → ℝ) →
          ExteriorAlgebra.ι ℝ x * Ω ^ 2 = 0 → Ω ^ 3 = 0) ∧
      (∀ (x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ : ℝ),
        (skewMatrix4 a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄).mulVec
            (borderedCharacteristicVec x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄) =
          pfaffian4 a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄ • ![x₁, x₂, x₃, x₄]) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp
    have hc : ({0, 1} : Finset (Fin 3)).card = 2 := by decide
    have hpow : (-1 : ℝ) ^ (2 * (3 - 2)) = 1 := by norm_num
    rw [hodge_hodge_basis (Pi.basisFun ℝ (Fin 3)) ({0, 1} : Finset (Fin 3)), hc, hpow, one_smul]
  · intro b' x y
    exact det_smul_regressive_change_basis (Pi.basisFun ℝ (Fin 3)) b' x y
  · exact (compound_bivector_fin4_not_decomposable (Pi.basisFun ℝ (Fin 4))).1
  · exact (note31_counterexample_dim5 ℝ).2.2.2.2
  · dsimp
    have hA : ExteriorAlgebra.ι ℝ (Pi.basisFun ℝ (Fin 4) 0) +
        ExteriorAlgebra.ι ℝ (Pi.basisFun ℝ (Fin 4) 1) ∈ ⋀[ℝ]^1 (Fin 4 → ℝ) := by
      rw [ExteriorAlgebra.exteriorPower, pow_one]
      exact Submodule.add_mem _ (LinearMap.mem_range_self _ _) (LinearMap.mem_range_self _ _)
    have hB : ExteriorAlgebra.ι ℝ (Pi.basisFun ℝ (Fin 4) 0) * ExteriorAlgebra.ι ℝ (Pi.basisFun ℝ (Fin 4) 2) +
        ExteriorAlgebra.ι ℝ (Pi.basisFun ℝ (Fin 4) 1) * ExteriorAlgebra.ι ℝ (Pi.basisFun ℝ (Fin 4) 3) ∈
        ⋀[ℝ]^2 (Fin 4 → ℝ) := by
      rw [ExteriorAlgebra.exteriorPower, pow_two]
      exact Submodule.add_mem _
        (Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) (LinearMap.mem_range_self _ _))
        (Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) (LinearMap.mem_range_self _ _))
    exact (note68_homogeneous_reciprocity (Pi.basisFun ℝ (Fin 4)) hA hB).2
  · exact ⟨seligman_note391_indefinite_critique.{0}.1,
      seligman_note391_indefinite_critique.{0}.2.1⟩
  · intro u β α
    exact grassmann_no511_pfaff_exterior_vanishing u β α
  · intro x Ω hx hΩ hxΩ
    exact grassmann_no518_exterior_division hx hΩ 2 hxΩ
  · intro x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄
    exact (cayley_bordered_pfaffian5_identity x₁ x₂ x₃ x₄ a₁₂ a₁₃ a₁₄ a₂₃ a₂₄ a₃₄).2.1

end CausalPosetAndMasterCoagulation

