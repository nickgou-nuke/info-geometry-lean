import Mathlib.Algebra.Lie.Basic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Algebra.Lie.Classical
import Mathlib.Algebra.Lie.Matrix
import Mathlib.Data.Matrix.Basic

/-!
# Canonical Zorn G₂ Simple Root $\mathfrak{sl}_2$ Bridge

This module formally specifies the local-to-global Lie wire for the $G_2$ root geometry.
For every root $\alpha \in \Phi_{G_2}$, we isolate the 3-dimensional subalgebra:
$S_\alpha = \mathfrak{g}_\alpha \oplus \mathfrak{g}_{-\alpha} \oplus [\mathfrak{g}_\alpha, \mathfrak{g}_{-\alpha}]$
and establish its canonical isomorphism to $\mathfrak{sl}_2(\mathbb{k})$.

Following the explicit textbook formulation verified in the Draper $G_2$ survey,
this provides the foundational Cartan-Weyl $\mathfrak{sl}_2$ atomic building blocks 
from which the full $G_2$ exceptional geometry is globally assembled.
-/

namespace InfoGeometry.Canonical.CanonicalZornG2SimpleRootSL2Bridge

variable {𝕜 𝔤 : Type*} [CommRing 𝕜] [LieRing 𝔤] [LieAlgebra 𝕜 𝔤]

/-- 
The abstract datum for a generic $\mathfrak{sl}_2$ root triple.
This requires the three canonical generators $(x_\alpha, x_{-\alpha}, h_\alpha)$
along with the standard $\mathfrak{sl}_2$ commutation relations.
-/
structure RootSL2Triple where
  x_pos : 𝔤
  x_neg : 𝔤
  h     : 𝔤
  bracket_pos_neg : ⁅x_pos, x_neg⁆ = h
  bracket_h_pos   : ⁅h, x_pos⁆ = (2 : 𝕜) • x_pos
  bracket_h_neg   : ⁅h, x_neg⁆ = (-2 : 𝕜) • x_neg

/-- 
The explicit Cartan matrix for $G_2$ as defined in the literature.
$C = \begin{pmatrix} 2 & -1 \\ -3 & 2 \end{pmatrix}$
-/
def g2CartanMatrix : Matrix (Fin 2) (Fin 2) ℤ :=
  ![![2, -1],
    ![-3, 2]]

/-!
### G₂ Root System Specification

The $G_2$ root system $\Phi_{G_2}$ consists of 12 roots:
$\pm \{ \alpha_1, \alpha_2, \alpha_1+\alpha_2, 2\alpha_1+\alpha_2, 3\alpha_1+\alpha_2, 3\alpha_1+2\alpha_2 \}$.
-/

inductive G2PositiveRoot
| alpha1
| alpha2
| alpha1_add_alpha2
| two_alpha1_add_alpha2
| three_alpha1_add_alpha2
| three_alpha1_add_two_alpha2

inductive G2Root
| pos (r : G2PositiveRoot)
| neg (r : G2PositiveRoot)

/-- 
The global $G_2$ root realization datum. 
This requires an associative assignment of an $\mathfrak{sl}_2$ triple for every root,
satisfying the $G_2$ Cartan interaction matrix on the simple roots.
-/
structure G2RootRealization where
  triple : G2Root → RootSL2Triple (𝕜 := 𝕜) (𝔤 := 𝔤)

  -- The Cartan relations between the two simple roots:
  bracket_h1_x2 : ⁅(triple (G2Root.pos G2PositiveRoot.alpha1)).h, 
                    (triple (G2Root.pos G2PositiveRoot.alpha2)).x_pos⁆ = 
                  (-1 : 𝕜) • (triple (G2Root.pos G2PositiveRoot.alpha2)).x_pos
                  
  bracket_h2_x1 : ⁅(triple (G2Root.pos G2PositiveRoot.alpha2)).h, 
                    (triple (G2Root.pos G2PositiveRoot.alpha1)).x_pos⁆ = 
                  (-3 : 𝕜) • (triple (G2Root.pos G2PositiveRoot.alpha1)).x_pos

/-!
### Capstone Placeholders

The capstones will define the exact explicit isomorphism $S_\alpha \cong \mathfrak{sl}_2(\mathbb{k})$
for each root, bridging the local atoms to the global Lie algebra.
-/

/-- CAPSTONE 1: The subspace generated by a root triple is a Lie subalgebra isomorphic to sl_2. -/
def rootTripleSubalgebra {𝕜 𝔤 : Type*} [CommRing 𝕜] [LieRing 𝔤] [LieAlgebra 𝕜 𝔤] (T : RootSL2Triple (𝕜 := 𝕜) (𝔤 := 𝔤)) : LieSubalgebra 𝕜 𝔤 :=
  LieSubalgebra.lieSpan 𝕜 𝔤 ({T.x_pos, T.x_neg, T.h} : Set 𝔤)

/-- CAPSTONE 1.1: The generated subalgebra is isomorphic to $\mathfrak{sl}_2$. -/
def rootTripleSubalgebra_eq_sl2 {𝕜 𝔤 : Type*} [CommRing 𝕜] [LieRing 𝔤] [LieAlgebra 𝕜 𝔤] (T : RootSL2Triple (𝕜 := 𝕜) (𝔤 := 𝔤)) : Prop :=
  Nonempty (rootTripleSubalgebra T ≃ₗ⁅𝕜⁆ LieAlgebra.SpecialLinear.sl (Fin 2) 𝕜)

/-- CAPSTONE 2: Global reconstruction. The simple root triples generate the entire Lie algebra $G_2$. -/
def g2_generated_by_simple_roots {𝕜 𝔤 : Type*} [CommRing 𝕜] [LieRing 𝔤] [LieAlgebra 𝕜 𝔤] (D : G2RootRealization (𝕜 := 𝕜) (𝔤 := 𝔤)) : Prop :=
  LieSubalgebra.lieSpan 𝕜 𝔤 ({ (D.triple (G2Root.pos G2PositiveRoot.alpha1)).x_pos,
                             (D.triple (G2Root.pos G2PositiveRoot.alpha1)).x_neg,
                             (D.triple (G2Root.pos G2PositiveRoot.alpha1)).h,
                             (D.triple (G2Root.pos G2PositiveRoot.alpha2)).x_pos,
                             (D.triple (G2Root.pos G2PositiveRoot.alpha2)).x_neg,
                             (D.triple (G2Root.pos G2PositiveRoot.alpha2)).h } : Set 𝔤) = ⊤

end InfoGeometry.Canonical.CanonicalZornG2SimpleRootSL2Bridge
