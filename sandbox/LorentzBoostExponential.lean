import Mathlib

/-!
# Lorentz Boosts and Spatial Rotations via Algebra Exponentials

This file models the algebraic exponential expansions for geometric transformations.
Depending on the scalar ring ($\mathbb{C}$ vs $\mathbb{D}$), the generator $G$ of the 
transformation will square to either $-1$ or $+1$.

1. When $G^2 = -1$, $e^{\theta G} = \cos(\theta) + G \sin(\theta)$ (Periodic Rotation)
2. When $G^2 = +1$, $e^{\phi G} = \cosh(\phi) + G \sinh(\phi)$ (Hyperbolic Boost)
-/

namespace InfoGeometry.Transformations

/--
A formal algebraic type modeling a sub-algebra generated by a single element $G$.
Every element can be written as $a + b G$.
-/
structure TransformationAlgebra (sign : ℝ) where
  re : ℝ
  im : ℝ

namespace TransformationAlgebra

variable {sign : ℝ}

/-- The unit element $1 = 1 + 0G$ -/
def one : TransformationAlgebra sign := ⟨1, 0⟩

/-- The generator $G = 0 + 1G$ -/
def G : TransformationAlgebra sign := ⟨0, 1⟩

/--
Multiplication follows $(a + b G)(c + d G) = ac + bd G^2 + (ad + bc)G$.
Since $G^2 = \text{sign}$, $bd G^2 = bd \cdot \text{sign}$.
-/
def mul (x y : TransformationAlgebra sign) : TransformationAlgebra sign :=
  ⟨x.re * y.re + sign * (x.im * y.im), x.re * y.im + x.im * y.re⟩

/-- Addition of algebra elements. -/
def add (x y : TransformationAlgebra sign) : TransformationAlgebra sign :=
  ⟨x.re + y.re, x.im + y.im⟩

/-- Scalar multiplication by a real angle/rapidity. -/
def smul (c : ℝ) (x : TransformationAlgebra sign) : TransformationAlgebra sign :=
  ⟨c * x.re, c * x.im⟩

/--
The trigonometric rotation operator $R(\theta) = \cos\theta + G \sin\theta$.
This occurs when the generator squares to -1.
-/
noncomputable def rotationOp (θ : ℝ) : TransformationAlgebra (-1) :=
  add (smul (Real.cos θ) one) (smul (Real.sin θ) G)

/--
The hyperbolic boost operator $B(\phi) = \cosh\phi + G \sinh\phi$.
This occurs when the generator squares to +1.
-/
noncomputable def boostOp (ϕ : ℝ) : TransformationAlgebra 1 :=
  add (smul (Real.cosh ϕ) one) (smul (Real.sinh ϕ) G)

end TransformationAlgebra
end InfoGeometry.Transformations
