import Mathlib.RepresentationTheory.Basic
import InfoGeometry.Categorical.FibonacciBraidGroup3Representation
import InfoGeometry.Categorical.LogNilpotentCrossCheckedR
import InfoGeometry.Categorical.LogNilpotentCheckedRAdapter

/-!
# InfoGeometry.Categorical.LogNilpotentBraidGroup3Representation

Three-strand braid-group representation generated by the repository-owned
checked logarithmic `R` operator.

This file deliberately reuses the universal presented-group owner
`FibonacciBraidGroup3Representation.BraidThreeGenerators`.  No new braid group,
presentation, or representation abstraction is introduced.

For a square-zero logarithmic object `X`, the two generator images on the
right-associated triple tensor carrier are exactly the already-proved local
operators

* `logCheckedR12 X hX p`, and
* `logCheckedR23 X hX p`.

Their Artin relation is the existing theorem
`LogNilpotentCrossCheckedR.logCheckedR_yangBaxter`.
-/

noncomputable section

namespace InfoGeometry.Categorical.LogNilpotentBraidGroup3Representation

open InfoGeometry.Categorical.FibonacciBraidGroup3Representation
open InfoGeometry.Categorical.LogNilpotentModuleCategory
open InfoGeometry.Categorical.LogNilpotentModuleCategory.LogNilpotentModule
open InfoGeometry.Categorical.LogNilpotentCrossCheckedR
open InfoGeometry.Categorical.LogNilpotentCheckedRAdapter

/-- The right-associated three-fold tensor carrier generated by one logarithmic
object. -/
abbrev TripleCarrier (X : LogNilpotentModule ℂ) :=
  TripleObj X

variable (X : LogNilpotentModule ℂ)
variable (hX : X.N ^ 2 = 0)

/-- The two local checked logarithmic braid operators form an Artin pair in the
existing universal `BraidThreeGenerators` interface. -/
noncomputable def logBraidThreeGenerators (p : ℂ) :
    BraidThreeGenerators (TripleCarrier X ≃ₗ[ℂ] TripleCarrier X) where
  sigmaOne := logCheckedR12 X hX p
  sigmaTwo := logCheckedR23 X hX p
  artin := by
    apply LinearEquiv.ext
    intro t
    have ht := LinearMap.congr_fun (logCheckedR_yangBaxter X hX p) t
    simpa [LinearMap.comp_apply] using ht

/-- Group-level action of the repository's presented `B₃` on the logarithmic
triple tensor carrier. -/
noncomputable def logBraidGroup3Hom (p : ℂ) :
    BraidGroup3 →* (TripleCarrier X ≃ₗ[ℂ] TripleCarrier X) :=
  (logBraidThreeGenerators X hX p).toGroupHom

/-- Mathlib representation of `B₃` on the logarithmic triple tensor carrier. -/
noncomputable def logBraidRepresentation (p : ℂ) :
    Representation ℂ BraidGroup3 (TripleCarrier X) :=
  LinearEquiv.automorphismGroup.toLinearMapMonoidHom.comp
    (logBraidGroup3Hom X hX p)

/-- The first abstract braid generator acts by `checkR` on tensor slots 1--2. -/
@[simp]
theorem logBraidGroup3Hom_sigmaOne (p : ℂ) :
    logBraidGroup3Hom X hX p sigmaOne = logCheckedR12 X hX p := by
  simp [logBraidGroup3Hom, logBraidThreeGenerators]

/-- The second abstract braid generator acts by `checkR` on tensor slots 2--3. -/
@[simp]
theorem logBraidGroup3Hom_sigmaTwo (p : ℂ) :
    logBraidGroup3Hom X hX p sigmaTwo = logCheckedR23 X hX p := by
  simp [logBraidGroup3Hom, logBraidThreeGenerators]

/-- The representation readback of the first generator is the underlying
linear map of the local `R₁₂`. -/
@[simp]
theorem logBraidRepresentation_sigmaOne (p : ℂ) :
    logBraidRepresentation X hX p sigmaOne =
      (logCheckedR12 X hX p).toLinearMap := by
  rfl

/-- The representation readback of the second generator is the underlying
linear map of the local `R₂₃`. -/
@[simp]
theorem logBraidRepresentation_sigmaTwo (p : ℂ) :
    logBraidRepresentation X hX p sigmaTwo =
      (logCheckedR23 X hX p).toLinearMap := by
  rfl

/-- The group representation satisfies the Artin relation because the local
checked logarithmic operators satisfy Yang--Baxter. -/
theorem logBraidRepresentation_artin (p : ℂ) :
    logBraidGroup3Hom X hX p sigmaOne *
        logBraidGroup3Hom X hX p sigmaTwo *
        logBraidGroup3Hom X hX p sigmaOne =
      logBraidGroup3Hom X hX p sigmaTwo *
        logBraidGroup3Hom X hX p sigmaOne *
        logBraidGroup3Hom X hX p sigmaTwo := by
  simpa using (logBraidThreeGenerators X hX p).artin

/-- Inverse braid generators are represented by the inverse local checked
operators, inherited from the universal presented-group owner. -/
@[simp]
theorem logBraidGroup3Hom_sigmaOne_inv (p : ℂ) :
    logBraidGroup3Hom X hX p sigmaOne⁻¹ =
      (logCheckedR12 X hX p)⁻¹ := by
  simpa [logBraidGroup3Hom, logBraidThreeGenerators] using
    (BraidThreeGenerators.toGroupHom_sigmaOne_inv
      (logBraidThreeGenerators X hX p))

@[simp]
theorem logBraidGroup3Hom_sigmaTwo_inv (p : ℂ) :
    logBraidGroup3Hom X hX p sigmaTwo⁻¹ =
      (logCheckedR23 X hX p)⁻¹ := by
  simpa [logBraidGroup3Hom, logBraidThreeGenerators] using
    (BraidThreeGenerators.toGroupHom_sigmaTwo_inv
      (logBraidThreeGenerators X hX p))

end InfoGeometry.Categorical.LogNilpotentBraidGroup3Representation
