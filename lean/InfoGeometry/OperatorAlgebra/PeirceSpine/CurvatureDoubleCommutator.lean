import InfoGeometry.OperatorAlgebra.PeirceSpine.Tetraktys
import InfoGeometry.OperatorAlgebra.PeirceSpine.Homogenized
import InfoGeometry.OperatorAlgebra.PeirceSpine.ConeSheetBraiding

/-!
# A second-order relation for a sum of inner and double commutators

The operator below is the sum of the inner derivation generated by `Σ` and
minus the square of the inner derivation generated by `Φ`. Its restriction to
`Φ` and `J` (and their products with all finite defect iterates `δ^[n](V)`)
satisfies a quadratic relation with coefficients in the centralizer of the
tetraktys mass `V`.
-/
namespace InfoGeometry.OperatorAlgebra.PeirceSpine

open InfoGeometry.Core.IdempotentGraphGrassmannian

variable {B : Type*} [Ring B] {P : B} (hP : P * P = P) (A C X : B)
include hP

/-- Sum of the `Σ` inner derivation and the signed `Φ` double derivation. -/
def curvatureDoubleCommutator (P A C X : B) : B :=
  comm (genSig P A C) X + derivSqPhi P A C X

/-- The `Φ` mode satisfies the corresponding quadratic relation. -/
theorem curvatureDoubleCommutator_quadratic_phi :
    curvatureDoubleCommutator P A C (curvatureDoubleCommutator P A C (genPhi P A C)) +
      (4 : ℤ) • (genV P A C * curvatureDoubleCommutator P A C (genPhi P A C)) -
      (4 : ℤ) • ((genV P A C * genV P A C) * genPhi P A C) = 0 := by
  simp only [curvatureDoubleCommutator, derivSqPhi]
  peirce_nf hP

/-- The `J` mode satisfies the same quadratic relation. -/
theorem curvatureDoubleCommutator_quadratic_j :
    curvatureDoubleCommutator P A C (curvatureDoubleCommutator P A C (genJ P A C)) +
      (4 : ℤ) • (genV P A C * curvatureDoubleCommutator P A C (genJ P A C)) -
      (4 : ℤ) • ((genV P A C * genV P A C) * genJ P A C) = 0 := by
  simp only [curvatureDoubleCommutator, derivSqPhi]
  peirce_nf hP

/-- Every symmetric defect iterate `δ^[n](V)` commutes with `Φ`, `J`, and `Σ`. -/
theorem genV_defect_iterate_comm_tetraktys (n : ℕ) :
    genPhi P A C * idempotencyDefect^[n] (genV P A C) =
      idempotencyDefect^[n] (genV P A C) * genPhi P A C ∧
    genJ P A C * idempotencyDefect^[n] (genV P A C) =
      idempotencyDefect^[n] (genV P A C) * genJ P A C ∧
    genSig P A C * idempotencyDefect^[n] (genV P A C) =
      idempotencyDefect^[n] (genV P A C) * genSig P A C := by
  have hSplit := genV_defect_iterates_cycle_split hP A C n
  have hPhi : genPhi P A C * idempotencyDefect^[n] (genV P A C) =
      idempotencyDefect^[n] (genV P A C) * genPhi P A C := by
    rw [hSplit]
    exact sub_eq_zero.mp (qgt_defect_iterate_sum_commutes_with_generators hP A C n).1
  have hJ : genJ P A C * idempotencyDefect^[n] (genV P A C) =
      idempotencyDefect^[n] (genV P A C) * genJ P A C := by
    rw [hSplit]
    exact sub_eq_zero.mp (qgt_defect_iterate_sum_commutes_with_generators hP A C n).2
  refine ⟨hPhi, hJ, ?_⟩
  have hJP : genSig P A C = genJ P A C * genPhi P A C :=
    (archetype_A3_nilpotent_cones_and_tetraktys_table hP A C).2.2.2.2.2.1.symm
  rw [hJP, mul_assoc, hPhi, ← mul_assoc, hJ, mul_assoc]

/-- Right multiplication by `δ^[n](V)` commutes with `curvatureDoubleCommutator`. -/
theorem curvatureDoubleCommutator_mul_genV_defect_iterate (n : ℕ) :
    curvatureDoubleCommutator P A C (X * idempotencyDefect^[n] (genV P A C)) =
      curvatureDoubleCommutator P A C X * idempotencyDefect^[n] (genV P A C) := by
  rcases genV_defect_iterate_comm_tetraktys hP A C n with ⟨hPhi, hJ, hSig⟩
  have hCommPhi : ∀ Y : B,
      comm (genPhi P A C) (Y * idempotencyDefect^[n] (genV P A C)) =
        comm (genPhi P A C) Y * idempotencyDefect^[n] (genV P A C) := by
    intro Y
    unfold comm
    calc
      genPhi P A C * (Y * idempotencyDefect^[n] (genV P A C)) -
          (Y * idempotencyDefect^[n] (genV P A C)) * genPhi P A C =
        (genPhi P A C * Y) * idempotencyDefect^[n] (genV P A C) -
          Y * (idempotencyDefect^[n] (genV P A C) * genPhi P A C) := by
        noncomm_ring
      _ = (genPhi P A C * Y) * idempotencyDefect^[n] (genV P A C) -
          Y * (genPhi P A C * idempotencyDefect^[n] (genV P A C)) := by
        rw [← hPhi]
      _ = (genPhi P A C * Y - Y * genPhi P A C) *
          idempotencyDefect^[n] (genV P A C) := by
        noncomm_ring
  have hCommSig :
      comm (genSig P A C) (X * idempotencyDefect^[n] (genV P A C)) =
        comm (genSig P A C) X * idempotencyDefect^[n] (genV P A C) := by
    unfold comm
    calc
      genSig P A C * (X * idempotencyDefect^[n] (genV P A C)) -
          (X * idempotencyDefect^[n] (genV P A C)) * genSig P A C =
        (genSig P A C * X) * idempotencyDefect^[n] (genV P A C) -
          X * (idempotencyDefect^[n] (genV P A C) * genSig P A C) := by
        noncomm_ring
      _ = (genSig P A C * X) * idempotencyDefect^[n] (genV P A C) -
          X * (genSig P A C * idempotencyDefect^[n] (genV P A C)) := by
        rw [← hSig]
      _ = (genSig P A C * X - X * genSig P A C) *
          idempotencyDefect^[n] (genV P A C) := by
        noncomm_ring
  unfold curvatureDoubleCommutator derivSqPhi
  rw [hCommSig, hCommPhi, hCommPhi]
  noncomm_ring

/-- At every defect depth `n`, `curvatureDoubleCommutator` annihilates the
symmetric defect iterate `δ^[n](V)` and acts on `qgtDefectDiff P A C n` by
`-4 V` (`A75`). -/
theorem curvatureDoubleCommutator_even_defect_iterates (n : ℕ) :
    curvatureDoubleCommutator P A C (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    curvatureDoubleCommutator P A C (qgtDefectDiff P A C n) +
      (4 : ℤ) • (genV P A C * qgtDefectDiff P A C n) = 0 := by
  have h1 : curvatureDoubleCommutator P A C (1 : B) = 0 := by
    simp only [curvatureDoubleCommutator, derivSqPhi]; peirce_nf hP
  have hS : curvatureDoubleCommutator P A C (invS P) =
      -((4 : ℤ) • (genV P A C * invS P)) := by
    simp only [curvatureDoubleCommutator, derivSqPhi]; peirce_nf hP
  constructor
  · have h := curvatureDoubleCommutator_mul_genV_defect_iterate hP A C (1 : B) n
    simpa [one_mul, h1, zero_mul] using h
  · have hSV := (qgt_defect_iterates_invS_and_parity hP A C n).2.2.1
    have h := curvatureDoubleCommutator_mul_genV_defect_iterate hP A C (invS P) n
    rw [hSV, hS] at h
    rw [h, ← hSV]
    simp only [neg_mul, smul_mul_assoc, mul_assoc, neg_add_cancel]

/-- At every defect depth `n`, the odd defect-tower modes `Φ δ^[n](V)` and
`J δ^[n](V)` satisfy the telegrapher quadratic relation (`A76`). -/
theorem curvatureDoubleCommutator_quadratic_odd_defect_iterates (n : ℕ) :
    curvatureDoubleCommutator P A C
        (curvatureDoubleCommutator P A C
          (genPhi P A C * idempotencyDefect^[n] (genV P A C))) +
      (4 : ℤ) • (genV P A C *
        curvatureDoubleCommutator P A C
          (genPhi P A C * idempotencyDefect^[n] (genV P A C))) -
      (4 : ℤ) • ((genV P A C * genV P A C) *
        (genPhi P A C * idempotencyDefect^[n] (genV P A C))) = 0 ∧
    curvatureDoubleCommutator P A C
        (curvatureDoubleCommutator P A C
          (genJ P A C * idempotencyDefect^[n] (genV P A C))) +
      (4 : ℤ) • (genV P A C *
        curvatureDoubleCommutator P A C
          (genJ P A C * idempotencyDefect^[n] (genV P A C))) -
      (4 : ℤ) • ((genV P A C * genV P A C) *
        (genJ P A C * idempotencyDefect^[n] (genV P A C))) = 0 := by
  have hMul := fun Y : B => curvatureDoubleCommutator_mul_genV_defect_iterate hP A C Y n
  have hPhi0 := curvatureDoubleCommutator_quadratic_phi hP A C
  have hJ0 := curvatureDoubleCommutator_quadratic_j hP A C
  constructor
  · rw [hMul (genPhi P A C), hMul (curvatureDoubleCommutator P A C (genPhi P A C))]
    calc
      curvatureDoubleCommutator P A C (curvatureDoubleCommutator P A C (genPhi P A C)) *
          idempotencyDefect^[n] (genV P A C) +
        (4 : ℤ) • (genV P A C *
          (curvatureDoubleCommutator P A C (genPhi P A C) *
            idempotencyDefect^[n] (genV P A C))) -
        (4 : ℤ) • ((genV P A C * genV P A C) *
          (genPhi P A C * idempotencyDefect^[n] (genV P A C))) =
      (curvatureDoubleCommutator P A C (curvatureDoubleCommutator P A C (genPhi P A C)) +
        (4 : ℤ) • (genV P A C * curvatureDoubleCommutator P A C (genPhi P A C)) -
        (4 : ℤ) • ((genV P A C * genV P A C) * genPhi P A C)) *
        idempotencyDefect^[n] (genV P A C) := by noncomm_ring
      _ = 0 := by rw [hPhi0, zero_mul]
  · rw [hMul (genJ P A C), hMul (curvatureDoubleCommutator P A C (genJ P A C))]
    calc
      curvatureDoubleCommutator P A C (curvatureDoubleCommutator P A C (genJ P A C)) *
          idempotencyDefect^[n] (genV P A C) +
        (4 : ℤ) • (genV P A C *
          (curvatureDoubleCommutator P A C (genJ P A C) *
            idempotencyDefect^[n] (genV P A C))) -
        (4 : ℤ) • ((genV P A C * genV P A C) *
          (genJ P A C * idempotencyDefect^[n] (genV P A C))) =
      (curvatureDoubleCommutator P A C (curvatureDoubleCommutator P A C (genJ P A C)) +
        (4 : ℤ) • (genV P A C * curvatureDoubleCommutator P A C (genJ P A C)) -
        (4 : ℤ) • ((genV P A C * genV P A C) * genJ P A C)) *
        idempotencyDefect^[n] (genV P A C) := by noncomm_ring
      _ = 0 := by rw [hJ0, zero_mul]

/-- All-depth commutator-product factorization for the odd defect modes
`Φ δ^[n](V)` and `J δ^[n](V)` (transcript labels A73/A75). -/
theorem madelung_vorticity_factorization_defect_iterates (n : ℕ) :
    comm P (genPhi P A C * idempotencyDefect^[n] (genV P A C)) =
      genJ P A C * idempotencyDefect^[n] (genV P A C) ∧
    comm P (genJ P A C * idempotencyDefect^[n] (genV P A C)) =
      genPhi P A C * idempotencyDefect^[n] (genV P A C) ∧
    comm P (genPhi P A C * idempotencyDefect^[n] (genV P A C)) *
        (genPhi P A C * idempotencyDefect^[n] (genV P A C)) =
      genSig P A C *
        (idempotencyDefect^[n] (genV P A C) * idempotencyDefect^[n] (genV P A C)) := by
  rcases genV_defect_iterate_comm_tetraktys hP A C n with
    ⟨hPhi_comm, hJ_comm, _hSig_comm⟩
  have hP_comm : P * idempotencyDefect^[n] (genV P A C) =
      idempotencyDefect^[n] (genV P A C) * P := by
    have hPcomp : P * (1 - P) = 0 := by
      rw [mul_sub, mul_one, hP, sub_self]
    have hcompP : (1 - P) * P = 0 := by
      rw [sub_mul, one_mul, hP, sub_self]
    have hMinusL : P * idempotencyDefect^[n] (qgtMinus P A C) = 0 := by
      rw [← qgtMinus_defect_iterates_left hP A C n, ← mul_assoc, hPcomp, zero_mul]
    have hMinusR : idempotencyDefect^[n] (qgtMinus P A C) * P = 0 := by
      rw [← qgtMinus_defect_iterates_right hP A C n, mul_assoc, hcompP, mul_zero]
    rw [genV_defect_iterates_cycle_split hP A C n, mul_add, add_mul,
      qgtPlus_defect_iterates_left hP A C n,
      qgtPlus_defect_iterates_right hP A C n,
      hMinusL, hMinusR]
  have hPPhi : comm P (genPhi P A C) = genJ P A C := by peirce_nf hP
  have hPJ : comm P (genJ P A C) = genPhi P A C := by peirce_nf hP
  have hJPhi : genJ P A C * genPhi P A C = genSig P A C := by peirce_nf hP
  have h1 : comm P (genPhi P A C * idempotencyDefect^[n] (genV P A C)) =
      genJ P A C * idempotencyDefect^[n] (genV P A C) := by
    unfold comm at hPPhi ⊢
    calc
      P * (genPhi P A C * idempotencyDefect^[n] (genV P A C)) -
          genPhi P A C * idempotencyDefect^[n] (genV P A C) * P =
        P * genPhi P A C * idempotencyDefect^[n] (genV P A C) -
          genPhi P A C * (idempotencyDefect^[n] (genV P A C) * P) := by noncomm_ring
      _ = P * genPhi P A C * idempotencyDefect^[n] (genV P A C) -
          genPhi P A C * (P * idempotencyDefect^[n] (genV P A C)) := by rw [← hP_comm]
      _ = (P * genPhi P A C - genPhi P A C * P) * idempotencyDefect^[n] (genV P A C) := by
        noncomm_ring
      _ = genJ P A C * idempotencyDefect^[n] (genV P A C) := by rw [hPPhi]
  have h2 : comm P (genJ P A C * idempotencyDefect^[n] (genV P A C)) =
      genPhi P A C * idempotencyDefect^[n] (genV P A C) := by
    unfold comm at hPJ ⊢
    calc
      P * (genJ P A C * idempotencyDefect^[n] (genV P A C)) -
          genJ P A C * idempotencyDefect^[n] (genV P A C) * P =
        P * genJ P A C * idempotencyDefect^[n] (genV P A C) -
          genJ P A C * (idempotencyDefect^[n] (genV P A C) * P) := by noncomm_ring
      _ = P * genJ P A C * idempotencyDefect^[n] (genV P A C) -
          genJ P A C * (P * idempotencyDefect^[n] (genV P A C)) := by rw [← hP_comm]
      _ = (P * genJ P A C - genJ P A C * P) * idempotencyDefect^[n] (genV P A C) := by
        noncomm_ring
      _ = genPhi P A C * idempotencyDefect^[n] (genV P A C) := by rw [hPJ]
  refine ⟨h1, h2, ?_⟩
  rw [h1]
  calc
    genJ P A C * idempotencyDefect^[n] (genV P A C) *
        (genPhi P A C * idempotencyDefect^[n] (genV P A C)) =
      genJ P A C * (idempotencyDefect^[n] (genV P A C) * genPhi P A C) *
        idempotencyDefect^[n] (genV P A C) := by noncomm_ring
    _ = genJ P A C * (genPhi P A C * idempotencyDefect^[n] (genV P A C)) *
        idempotencyDefect^[n] (genV P A C) := by rw [← hPhi_comm]
    _ = (genJ P A C * genPhi P A C) *
        (idempotencyDefect^[n] (genV P A C) * idempotencyDefect^[n] (genV P A C)) := by
      noncomm_ring
    _ = genSig P A C *
        (idempotencyDefect^[n] (genV P A C) * idempotencyDefect^[n] (genV P A C)) := by
      rw [hJPhi]

/-- Double-derivation and homogenized-channel (`hProjV`, `hProjPhi`, `hProjJ`,
`hProjSig`) evaluations on `δ^[n](V)` and `qgtDefectDiff P A C n` at every
defect depth `n` (transcript labels A65/A67). -/
theorem derivSq_and_hProj_defect_iterates (n : ℕ) :
    derivSqPhi P A C (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    derivSqJ P A C (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    derivSqSig P A C (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    hProjV P A C (idempotencyDefect^[n] (genV P A C)) =
      (8 : ℤ) • ((genV P A C * genV P A C) * idempotencyDefect^[n] (genV P A C)) ∧
    hProjPhi P A C (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    hProjJ P A C (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    hProjSig P A C (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    derivSqPhi P A C (qgtDefectDiff P A C n) =
      -((4 : ℤ) • (genV P A C * qgtDefectDiff P A C n)) ∧
    derivSqJ P A C (qgtDefectDiff P A C n) =
      -((4 : ℤ) • (genV P A C * qgtDefectDiff P A C n)) ∧
    derivSqSig P A C (qgtDefectDiff P A C n) = 0 ∧
    hProjV P A C (qgtDefectDiff P A C n) = 0 ∧
    hProjPhi P A C (qgtDefectDiff P A C n) = 0 ∧
    hProjJ P A C (qgtDefectDiff P A C n) = 0 ∧
    hProjSig P A C (qgtDefectDiff P A C n) =
      (8 : ℤ) • ((genV P A C * genV P A C) * qgtDefectDiff P A C n) := by
  rcases genV_defect_iterate_comm_tetraktys hP A C n with ⟨hPhi, hJ, hSig⟩
  have hCommPhi : comm (genPhi P A C) (idempotencyDefect^[n] (genV P A C)) = 0 :=
    sub_eq_zero.mpr hPhi
  have hCommJ : comm (genJ P A C) (idempotencyDefect^[n] (genV P A C)) = 0 :=
    sub_eq_zero.mpr hJ
  have hCommSig : comm (genSig P A C) (idempotencyDefect^[n] (genV P A C)) = 0 :=
    sub_eq_zero.mpr hSig
  have hDPhiV : derivSqPhi P A C (idempotencyDefect^[n] (genV P A C)) = 0 := by
    unfold derivSqPhi
    rw [hCommPhi]
    unfold comm
    simp only [mul_zero, zero_mul, sub_self, neg_zero]
  have hDJV : derivSqJ P A C (idempotencyDefect^[n] (genV P A C)) = 0 := by
    unfold derivSqJ
    rw [hCommJ]
    unfold comm
    simp only [mul_zero, zero_mul, sub_self]
  have hDSigV : derivSqSig P A C (idempotencyDefect^[n] (genV P A C)) = 0 := by
    unfold derivSqSig
    rw [hCommSig]
    unfold comm
    simp only [mul_zero, zero_mul, sub_self, neg_zero]
  have hAnticomm := qgtDefectDiff_anticomm_generators hP A C n
  have hSPhi : qgtDefectDiff P A C n * genPhi P A C =
      -(genPhi P A C * qgtDefectDiff P A C n) :=
    eq_neg_of_add_eq_zero_right hAnticomm.1
  have hSJ : qgtDefectDiff P A C n * genJ P A C =
      -(genJ P A C * qgtDefectDiff P A C n) :=
    eq_neg_of_add_eq_zero_right hAnticomm.2
  have hSV := (qgt_defect_iterates_invS_and_parity hP A C n).2.2.1
  have hSigInvS : genSig P A C * invS P = invS P * genSig P A C := by peirce_nf hP
  have hSigS : genSig P A C * qgtDefectDiff P A C n =
      qgtDefectDiff P A C n * genSig P A C := by
    rw [← hSV, ← mul_assoc, hSigInvS, mul_assoc, hSig, ← mul_assoc]
  have hDSigS : derivSqSig P A C (qgtDefectDiff P A C n) = 0 := by
    have hCS : comm (genSig P A C) (qgtDefectDiff P A C n) = 0 := sub_eq_zero.mpr hSigS
    unfold derivSqSig
    rw [hCS]
    unfold comm
    simp only [mul_zero, zero_mul, sub_self, neg_zero]
  have hPhiSq : genPhi P A C * genPhi P A C = genV P A C := by peirce_nf hP
  have hJSq : genJ P A C * genJ P A C = -genV P A C := by peirce_nf hP
  have hDPhiS : derivSqPhi P A C (qgtDefectDiff P A C n) =
      -((4 : ℤ) • (genV P A C * qgtDefectDiff P A C n)) := by
    have hCommPhiS : comm (genPhi P A C) (qgtDefectDiff P A C n) =
        genPhi P A C * qgtDefectDiff P A C n + genPhi P A C * qgtDefectDiff P A C n := by
      unfold comm; rw [hSPhi]; abel
    have hPhiSPhi : (genPhi P A C * qgtDefectDiff P A C n) * genPhi P A C =
        -(genV P A C * qgtDefectDiff P A C n) := by
      rw [mul_assoc, hSPhi, mul_neg, ← mul_assoc, hPhiSq]
    have hPhiPhiS : genPhi P A C * (genPhi P A C * qgtDefectDiff P A C n) =
        genV P A C * qgtDefectDiff P A C n := by
      rw [← mul_assoc, hPhiSq]
    unfold derivSqPhi
    rw [hCommPhiS]
    unfold comm
    simp only [mul_add, add_mul, hPhiPhiS, hPhiSPhi]
    abel_nf
  have hDJS : derivSqJ P A C (qgtDefectDiff P A C n) =
      -((4 : ℤ) • (genV P A C * qgtDefectDiff P A C n)) := by
    have hCommJS : comm (genJ P A C) (qgtDefectDiff P A C n) =
        genJ P A C * qgtDefectDiff P A C n + genJ P A C * qgtDefectDiff P A C n := by
      unfold comm; rw [hSJ]; abel
    have hJSJ : (genJ P A C * qgtDefectDiff P A C n) * genJ P A C =
        genV P A C * qgtDefectDiff P A C n := by
      rw [mul_assoc, hSJ, mul_neg, ← mul_assoc, hJSq, neg_mul, neg_neg]
    have hJJS : genJ P A C * (genJ P A C * qgtDefectDiff P A C n) =
        -(genV P A C * qgtDefectDiff P A C n) := by
      rw [← mul_assoc, hJSq, neg_mul]
    unfold derivSqJ
    rw [hCommJS]
    unfold comm
    simp only [mul_add, add_mul, hJJS, hJSJ]
    abel_nf
  refine ⟨hDPhiV, hDJV, hDSigV, ?_, ?_, ?_, ?_, hDPhiS, hDJS, hDSigS, ?_, ?_, ?_, ?_⟩
  · simp only [hProjV, hDPhiV, hDJV, hDSigV, mul_zero, add_zero]
  · simp only [hProjPhi, hDPhiV, hDJV, hDSigV, mul_zero, sub_self]
  · simp only [hProjJ, hDPhiV, hDJV, hDSigV, mul_zero, sub_self]
  · simp only [hProjSig, hDPhiV, hDJV, hDSigV, mul_zero, sub_self]
  · unfold hProjV
    rw [hDPhiS, hDJS, hDSigS]
    noncomm_ring
  · unfold hProjPhi
    rw [hDPhiS, hDJS, hDSigS]
    noncomm_ring
  · unfold hProjJ
    rw [hDPhiS, hDJS, hDSigS]
    noncomm_ring
  · unfold hProjSig
