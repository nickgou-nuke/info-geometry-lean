import InfoGeometry.Canonical.BoundaryBraidRepresentation
import InfoGeometry.Twistor.ProjectiveNullConfigurationExchangeLoop
import InfoGeometry.Twistor.ProjectiveNullConfigurationLocalSystemMonodromy
import InfoGeometry.Twistor.ProjectiveNullOrderedExchangePath

/-!
# Boundary braid representation from projective-null local-system monodromy

This owner isolates the exact comparison contract between the concrete native
`B₃ → GL₈(ℂ)` representation and monodromy of a module-valued local system on
unordered projective-null configurations.

The geometric input is kept explicit: a homomorphism assigning based
fundamental-group classes to `B₃`, and a homomorphism comparing automorphisms
of the local-system fiber with the native eight-dimensional boundary carrier.
If the two resulting representations agree on the two Artin generators, they
agree on all of `B₃`.

The geometric input may equivalently be supplied by two based fundamental-group
classes satisfying the adjacent Artin relation.  No exchange loop,
conformal-block local system, or anyon interpretation is constructed here.
-/

noncomputable section

namespace InfoGeometry.Projective.ProjectiveNullBoundaryBraidMonodromyComparison

open InfoGeometry.Canonical.BoundaryBraidRepresentation
open InfoGeometry.Physics.B3PresentedGroup
open InfoGeometry.Twistor.ProjectiveNullConfiguration
open InfoGeometry.Twistor.ProjectiveNullConfigurationExchangeLoop
open InfoGeometry.Twistor.ProjectiveNullConfigurationLocalSystemMonodromy
open InfoGeometry.Twistor.ProjectiveNullConfigurationTopology
open InfoGeometry.Twistor.ProjectiveNullUnorderedConfiguration
open InfoGeometry.Twistor.ProjectiveNullOrderedExchangePath

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- Pull a local-system monodromy representation back along a proposed
geometric realization of `B₃` by based projective-null configuration loops,
then compare its fiber automorphisms with the native boundary braid carrier. -/
def comparedBoundaryMonodromy
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ)
    (L : ConfigurationLocalSystem ℂ Q n) (p : Unordered Q n)
    (exchangeClasses :
      BoundaryBraidGroup →*
        @FundamentalGroup (Unordered Q n)
          (unorderedConfigurationTopology Q n) p)
    (fiberComparison :
      let _inst : TopologicalSpace (Unordered Q n) :=
        unorderedConfigurationTopology Q n
      LinearMap.GeneralLinearGroup ℂ
          (L.obj (FundamentalGroupoid.mk p)) →*
        BoundaryBraidLinearCarrier) :
    BoundaryBraidGroup →* BoundaryBraidLinearCarrier := by
  letI : TopologicalSpace (Unordered Q n) := unorderedConfigurationTopology Q n
  exact fiberComparison.comp
    ((localSystemLinearMonodromy Q n L p).comp exchangeClasses)

/-- Generator-level geometric monodromy readouts determine the complete
native `B₃` boundary representation. -/
theorem comparedBoundaryMonodromy_eq_native
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ)
    (L : ConfigurationLocalSystem ℂ Q n) (p : Unordered Q n)
    (exchangeClasses :
      BoundaryBraidGroup →*
        @FundamentalGroup (Unordered Q n)
          (unorderedConfigurationTopology Q n) p)
    (fiberComparison :
      let _inst : TopologicalSpace (Unordered Q n) :=
        unorderedConfigurationTopology Q n
      LinearMap.GeneralLinearGroup ℂ
          (L.obj (FundamentalGroupoid.mk p)) →*
        BoundaryBraidLinearCarrier)
    (h0 : comparedBoundaryMonodromy Q n L p exchangeClasses fiberComparison
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup) =
      boundaryBraidLinearRepresentation
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup))
    (h1 : comparedBoundaryMonodromy Q n L p exchangeClasses fiberComparison
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup) =
      boundaryBraidLinearRepresentation
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup)) :
    comparedBoundaryMonodromy Q n L p exchangeClasses fiberComparison =
      boundaryBraidLinearRepresentation := by
  exact b3_hom_ext _ _ h0 h1

/-! ## Comparison from two based loop classes -/

/-- The proposed geometric `B₃` realization generated by two based
projective-null configuration loop classes satisfying the Artin relation. -/
def exchangeClassMap
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ) (p : Unordered Q n)
    (gamma0 gamma1 :
      @FundamentalGroup (Unordered Q n)
        (unorderedConfigurationTopology Q n) p)
    (hArtin : gamma0 * gamma1 * gamma0 = gamma1 * gamma0 * gamma1) :
    BoundaryBraidGroup →*
      @FundamentalGroup (Unordered Q n)
        (unorderedConfigurationTopology Q n) p :=
  homOfArtinPair gamma0 gamma1 hArtin

@[simp] theorem exchangeClassMap_sig0
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ) (p : Unordered Q n)
    (gamma0 gamma1 :
      @FundamentalGroup (Unordered Q n)
        (unorderedConfigurationTopology Q n) p)
    (hArtin : gamma0 * gamma1 * gamma0 = gamma1 * gamma0 * gamma1) :
    exchangeClassMap Q n p gamma0 gamma1 hArtin
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup) = gamma0 := by
  exact homOfArtinPair_sig0 gamma0 gamma1 hArtin

@[simp] theorem exchangeClassMap_sig1
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ) (p : Unordered Q n)
    (gamma0 gamma1 :
      @FundamentalGroup (Unordered Q n)
        (unorderedConfigurationTopology Q n) p)
    (hArtin : gamma0 * gamma1 * gamma0 = gamma1 * gamma0 * gamma1) :
    exchangeClassMap Q n p gamma0 gamma1 hArtin
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup) = gamma1 := by
  exact homOfArtinPair_sig1 gamma0 gamma1 hArtin

/-- Two based loop classes satisfying the Artin relation suffice for the
global comparison with the native boundary braid representation, once their
two monodromy readouts agree with the native generators. -/
theorem comparedBoundaryMonodromy_of_exchange_classes_eq_native
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ)
    (L : ConfigurationLocalSystem ℂ Q n) (p : Unordered Q n)
    (gamma0 gamma1 :
      @FundamentalGroup (Unordered Q n)
        (unorderedConfigurationTopology Q n) p)
    (hArtin : gamma0 * gamma1 * gamma0 = gamma1 * gamma0 * gamma1)
    (fiberComparison :
      let _inst : TopologicalSpace (Unordered Q n) :=
        unorderedConfigurationTopology Q n
      LinearMap.GeneralLinearGroup ℂ
          (L.obj (FundamentalGroupoid.mk p)) →*
        BoundaryBraidLinearCarrier)
    (h0 : comparedBoundaryMonodromy Q n L p
        (exchangeClassMap Q n p gamma0 gamma1 hArtin) fiberComparison
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup) =
      boundaryBraidLinearRepresentation
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup))
    (h1 : comparedBoundaryMonodromy Q n L p
        (exchangeClassMap Q n p gamma0 gamma1 hArtin) fiberComparison
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup) =
      boundaryBraidLinearRepresentation
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup)) :
    comparedBoundaryMonodromy Q n L p
        (exchangeClassMap Q n p gamma0 gamma1 hArtin) fiberComparison =
      boundaryBraidLinearRepresentation := by
  exact comparedBoundaryMonodromy_eq_native Q n L p _ fiberComparison h0 h1

/-! ## Comparison from actual based loops -/

/-- Two actual based loops whose triple concatenations are homotopic induce
the proposed geometric `B₃` realization in the fundamental group. -/
def exchangeClassMapOfLoops
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ) (p : Unordered Q n)
    (gamma0 gamma1 :
      @Path (Unordered Q n) (unorderedConfigurationTopology Q n) p p)
    (hArtin : ConfigurationLoopArtin Q n p gamma0 gamma1) :
    BoundaryBraidGroup →*
      @FundamentalGroup (Unordered Q n)
        (unorderedConfigurationTopology Q n) p :=
  exchangeClassMap Q n p
    (configurationLoopClass Q n p gamma0)
    (configurationLoopClass Q n p gamma1)
    (configurationLoopClasses_artin Q n p gamma0 gamma1 hArtin)

@[simp] theorem exchangeClassMapOfLoops_sig0
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ) (p : Unordered Q n)
    (gamma0 gamma1 :
      @Path (Unordered Q n) (unorderedConfigurationTopology Q n) p p)
    (hArtin : ConfigurationLoopArtin Q n p gamma0 gamma1) :
    exchangeClassMapOfLoops Q n p gamma0 gamma1 hArtin
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup) =
      configurationLoopClass Q n p gamma0 := by
  exact exchangeClassMap_sig0 Q n p _ _ _

@[simp] theorem exchangeClassMapOfLoops_sig1
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ) (p : Unordered Q n)
    (gamma0 gamma1 :
      @Path (Unordered Q n) (unorderedConfigurationTopology Q n) p p)
    (hArtin : ConfigurationLoopArtin Q n p gamma0 gamma1) :
    exchangeClassMapOfLoops Q n p gamma0 gamma1 hArtin
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup) =
      configurationLoopClass Q n p gamma1 := by
  exact exchangeClassMap_sig1 Q n p _ _ _

/-- Path-level Artin data and the two generator monodromy readouts determine
the global native boundary braid representation. -/
theorem comparedBoundaryMonodromy_of_loops_eq_native
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ)
    (L : ConfigurationLocalSystem ℂ Q n) (p : Unordered Q n)
    (gamma0 gamma1 :
      @Path (Unordered Q n) (unorderedConfigurationTopology Q n) p p)
    (hArtin : ConfigurationLoopArtin Q n p gamma0 gamma1)
    (fiberComparison :
      let _inst : TopologicalSpace (Unordered Q n) :=
        unorderedConfigurationTopology Q n
      LinearMap.GeneralLinearGroup ℂ
          (L.obj (FundamentalGroupoid.mk p)) →*
        BoundaryBraidLinearCarrier)
    (h0 : comparedBoundaryMonodromy Q n L p
        (exchangeClassMapOfLoops Q n p gamma0 gamma1 hArtin) fiberComparison
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup) =
      boundaryBraidLinearRepresentation
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup))
    (h1 : comparedBoundaryMonodromy Q n L p
        (exchangeClassMapOfLoops Q n p gamma0 gamma1 hArtin) fiberComparison
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup) =
      boundaryBraidLinearRepresentation
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup)) :
    comparedBoundaryMonodromy Q n L p
        (exchangeClassMapOfLoops Q n p gamma0 gamma1 hArtin) fiberComparison =
      boundaryBraidLinearRepresentation := by
  exact comparedBoundaryMonodromy_eq_native Q n L p _ fiberComparison h0 h1

/-! ## Comparison from ordered exchange paths -/

/-- Two ordered paths ending at finite reindexings of one configuration give
a `B₃` realization after unordered projection, provided their descended loops
satisfy the path-level Artin homotopy. -/
def exchangeClassMapOfOrderedPaths
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ) (p : Ordered Q n)
    (sigma0 sigma1 : Equiv.Perm (Fin n))
    (gamma0 : @Path (Ordered Q n) (orderedConfigurationTopology Q n)
      p (permute Q n sigma0 p))
    (gamma1 : @Path (Ordered Q n) (orderedConfigurationTopology Q n)
      p (permute Q n sigma1 p))
    (hArtin : ConfigurationLoopArtin Q n (Quotient.mk' p)
      (orderedExchangeLoop Q n p sigma0 gamma0)
      (orderedExchangeLoop Q n p sigma1 gamma1)) :
    BoundaryBraidGroup →*
      @FundamentalGroup (Unordered Q n)
        (unorderedConfigurationTopology Q n) (Quotient.mk' p) :=
  exchangeClassMapOfLoops Q n (Quotient.mk' p)
    (orderedExchangeLoop Q n p sigma0 gamma0)
    (orderedExchangeLoop Q n p sigma1 gamma1) hArtin

/-- Generator monodromy readouts for two genuine ordered exchange paths
determine the complete native boundary braid representation. -/
theorem comparedBoundaryMonodromy_of_ordered_paths_eq_native
    [TopologicalSpace V]
    (Q : QuadraticForm K V) (n : ℕ)
    (L : ConfigurationLocalSystem ℂ Q n) (p : Ordered Q n)
    (sigma0 sigma1 : Equiv.Perm (Fin n))
    (gamma0 : @Path (Ordered Q n) (orderedConfigurationTopology Q n)
      p (permute Q n sigma0 p))
    (gamma1 : @Path (Ordered Q n) (orderedConfigurationTopology Q n)
      p (permute Q n sigma1 p))
    (hArtin : ConfigurationLoopArtin Q n (Quotient.mk' p)
      (orderedExchangeLoop Q n p sigma0 gamma0)
      (orderedExchangeLoop Q n p sigma1 gamma1))
    (fiberComparison :
      let _inst : TopologicalSpace (Unordered Q n) :=
        unorderedConfigurationTopology Q n
      LinearMap.GeneralLinearGroup ℂ
          (L.obj (FundamentalGroupoid.mk (Quotient.mk' p))) →*
        BoundaryBraidLinearCarrier)
    (h0 : comparedBoundaryMonodromy Q n L (Quotient.mk' p)
        (exchangeClassMapOfOrderedPaths Q n p sigma0 sigma1 gamma0 gamma1 hArtin)
        fiberComparison
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup) =
      boundaryBraidLinearRepresentation
        (PresentedGroup.of B3Gen.sig0 : BoundaryBraidGroup))
    (h1 : comparedBoundaryMonodromy Q n L (Quotient.mk' p)
        (exchangeClassMapOfOrderedPaths Q n p sigma0 sigma1 gamma0 gamma1 hArtin)
        fiberComparison
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup) =
      boundaryBraidLinearRepresentation
        (PresentedGroup.of B3Gen.sig1 : BoundaryBraidGroup)) :
    comparedBoundaryMonodromy Q n L (Quotient.mk' p)
        (exchangeClassMapOfOrderedPaths Q n p sigma0 sigma1 gamma0 gamma1 hArtin)
        fiberComparison = boundaryBraidLinearRepresentation := by
  exact comparedBoundaryMonodromy_eq_native Q n L (Quotient.mk' p) _
    fiberComparison h0 h1

end InfoGeometry.Projective.ProjectiveNullBoundaryBraidMonodromyComparison
