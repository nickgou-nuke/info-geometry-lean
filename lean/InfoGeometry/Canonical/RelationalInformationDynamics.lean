import InfoGeometry.Canonical.RelationalInformationCore
import InfoGeometry.Canonical.InformationPartitionCore

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.RelationalInformationDynamics

Constructive transport layer for operatorial relational information geometry on
the doubled carrier.

This file does not introduce a new scalar facade. It works directly with:

- normalized operator-valued Massieu/log-partition potentials,
- exact exponential transport of doubled-space endomorphisms,
- commutator-defined first and second information variations,
- the QGT metric/phase readouts of those variations,
- and a concrete realization of the abstract relational-information datum.
-/

namespace InfoGeometry.Canonical.RelationalInformationDynamics

open InfoGeometry.Canonical.RelationalInformationCore
open InfoGeometry.Canonical.StateDependentTransport
open InfoGeometry.Canonical.BogoliubovTransport
open InfoGeometry.Canonical.InformationCalculus.ModularRadonNikodymData
open InfoGeometry.Quantum.GeometricQuantumTensor
open InfoGeometry.Krein

section Core

variable {E : Type*}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance

/-- Primitive operatorial Massieu/log-partition potential generated by an observable seed. -/
@[rep_depth operator]
noncomputable def operatorMassieuPotential
    (ω : EndH →L[ℝ] ℝ) (A : EndH) : ℝ → ℝ :=
  fun τ => logInformationPartitionFunction ω A τ

/-- Infinitesimal operatorial Massieu slope at `τ = 0`. -/
@[rep_depth operator]
noncomputable def operatorMassieuSlope
    (ω : EndH →L[ℝ] ℝ) (A : EndH) : ℝ :=
  deriv (operatorMassieuPotential ω A) 0

/-- On normalized probes, the operatorial Massieu slope is exactly the observable expectation. -/
@[rep_depth operator]
theorem operatorMassieuSlope_eq_of_normalized
    (ω : EndH →L[ℝ] ℝ) (A : EndH)
    (hω1 : ω (1 : EndH) = 1) :
    operatorMassieuSlope ω A = ω A := by
  unfold operatorMassieuSlope operatorMassieuPotential
  simpa using
    (hasDerivAt_logInformationPartitionFunction_zero_of_normalized
      (ω := ω) (K := A) hω1).deriv

/-- First information variation of an observable seed along a transport channel. -/
@[rep_depth transport]
abbrev operatorInformationFirstVariation
    (X A : EndH) : EndH :=
  transportCommutator (E := E) X A

/-- Mixed second information variation along two transport channels. -/
@[rep_depth transport]
abbrev operatorInformationMixedSecondVariation
    (X Y A : EndH) : EndH :=
  transportCommutator (E := E) X (operatorInformationFirstVariation (E := E) Y A)

/-- Diagonal second information variation of an observable seed. -/
@[rep_depth transport]
abbrev operatorInformationHessian
    (X A : EndH) : EndH :=
  operatorInformationMixedSecondVariation (E := E) X X A

/-- Symmetric operator-valued second-variation sector. -/
@[rep_depth transport]
noncomputable def operatorInformationMetricPart
    (X Y A : EndH) : EndH :=
  ((2 : ℝ)⁻¹) •
    (operatorInformationMixedSecondVariation (E := E) X Y A
      + operatorInformationMixedSecondVariation (E := E) Y X A)

/-- Antisymmetric operator-valued second-variation sector. -/
@[rep_depth transport]
noncomputable def operatorInformationCurvaturePart
    (X Y A : EndH) : EndH :=
  operatorInformationMixedSecondVariation (E := E) X Y A
    - operatorInformationMixedSecondVariation (E := E) Y X A

/-- The symmetric second-variation sector is invariant under swapping the channels. -/
@[rep_depth transport]
theorem operatorInformationMetricPart_swap
    (X Y A : EndH) :
    operatorInformationMetricPart (E := E) X Y A
      =
    operatorInformationMetricPart (E := E) Y X A := by
  unfold operatorInformationMetricPart
  simp [add_comm]

/-- Exponential transport path of an observable seed along a transport channel. -/
@[rep_depth transport]
noncomputable def transportedObservable
    (X A : EndH) (t : ℝ) : EndH :=
  InfoGeometry.Canonical.expTransport (A := EndH) X A t

/-- The transported Massieu slope of an observable seed. -/
@[rep_depth transport]
noncomputable def transportedMassieuSlope
    (ω : EndH →L[ℝ] ℝ) (X A : EndH) (t : ℝ) : ℝ :=
  operatorMassieuSlope ω (transportedObservable (E := E) X A t)

/-- Metric readout of the first operatorial information variation. -/
@[rep_depth transport]
noncomputable def operatorInformationMetricReadout
    (X A : EndH) : LinearMap.BilinForm ℝ H₂ :=
  metricOfOperator (E := E) (operatorInformationFirstVariation (E := E) X A)

/-- `(Jε)`-phase readout of the first operatorial information variation. -/
@[rep_depth transport]
noncomputable def operatorInformationPhaseReadout
    (X A : EndH) : LinearMap.BilinForm ℝ H₂ :=
  berryOfOperator (E := E) (operatorInformationFirstVariation (E := E) X A)

/-- The phase readout is the metric readout twisted by the concrete phase axis `K = Jε`. -/
@[rep_depth transport, simp]
theorem operatorInformationPhaseReadout_eq_metric_comp_modularComplexI
    (X A : EndH) :
    operatorInformationPhaseReadout (E := E) X A
      =
    (operatorInformationMetricReadout (E := E) X A).compLeft
      (InfoGeometry.Canonical.TomitaTakesaki.modularComplexI (E := E)).toLinearMap := by
  rfl

/-- The derivative of the transported observable at `t = 0` is the first information variation. -/
@[rep_depth transport]
theorem deriv_transportedObservable_at_zero_eq_firstVariation
    (X A : EndH) :
    deriv (fun t => transportedObservable (E := E) X A t) 0
      =
    operatorInformationFirstVariation (E := E) X A := by
  simpa [transportedObservable, operatorInformationFirstVariation,
    lieBracket_eq_transportCommutator] using
    (InfoGeometry.Canonical.deriv_expTransport_at_zero
      (A := EndH) (X := X) (A₀ := A))

/--
The second derivative of the transported observable at `t = 0` is the nested
commutator/Hessian channel.
-/
@[rep_depth transport]
theorem deriv2_transportedObservable_at_zero_eq_hessian
    (X A : EndH) :
    let f := fun t => transportedObservable (E := E) X A t
    deriv (fun t => deriv f t) 0
      =
    operatorInformationHessian (E := E) X A := by
  let δA : EndH := operatorInformationFirstVariation (E := E) X A
  have hDeriv :
      (fun t => deriv (fun s => transportedObservable (E := E) X A s) t)
        =
      fun t => transportedObservable (E := E) X δA t := by
    funext t
    simpa [transportedObservable, δA, operatorInformationFirstVariation,
      lieBracket_eq_transportCommutator] using
      (InfoGeometry.Canonical.hasDerivAt_expTransport
        (A := EndH) (X := X) (A₀ := A) t).deriv
  have hSecond :
      deriv (fun t => transportedObservable (E := E) X δA t) 0
        =
      operatorInformationHessian (E := E) X A := by
    simpa [transportedObservable, operatorInformationHessian,
      operatorInformationMixedSecondVariation, δA,
      operatorInformationFirstVariation, lieBracket_eq_transportCommutator] using
      (InfoGeometry.Canonical.deriv_expTransport_at_zero
        (A := EndH) (X := X) (A₀ := δA))
  dsimp
  rw [hDeriv]
  exact hSecond

/-- Under normalization, the transported Massieu slope is the expectation of the transported seed. -/
@[rep_depth transport]
theorem transportedMassieuSlope_eq_of_normalized
    (ω : EndH →L[ℝ] ℝ) (X A : EndH)
    (hω1 : ω (1 : EndH) = 1) (t : ℝ) :
    transportedMassieuSlope (E := E) ω X A t
      =
    ω (transportedObservable (E := E) X A t) := by
  unfold transportedMassieuSlope transportedObservable
  exact operatorMassieuSlope_eq_of_normalized
    (ω := ω) (A := InfoGeometry.Canonical.expTransport (A := EndH) X A t) hω1

/-- Derivative of the transported expectation along exponential transport at arbitrary `t`. -/
@[rep_depth transport]
theorem deriv_expectation_transportedObservable
    (ω : EndH →L[ℝ] ℝ) (X A : EndH) (t : ℝ) :
    deriv (fun s => ω (transportedObservable (E := E) X A s)) t
      =
    ω (transportedObservable (E := E)
      X (operatorInformationFirstVariation (E := E) X A) t) := by
  have hω : HasDerivAt (fun _ : ℝ => ω) (0 : EndH →L[ℝ] ℝ) t := by
    simpa using (hasDerivAt_const (x := t) (c := ω))
  have hExp :
      HasDerivAt
        (fun s => transportedObservable (E := E) X A s)
        (transportedObservable (E := E)
          X (operatorInformationFirstVariation (E := E) X A) t)
        t := by
    simpa [transportedObservable, operatorInformationFirstVariation,
      lieBracket_eq_transportCommutator] using
      (InfoGeometry.Canonical.hasDerivAt_expTransport
        (A := EndH) (X := X) (A₀ := A) t)
  have hApply :
      HasDerivAt
        (fun s : ℝ => (fun _ : ℝ => ω) s (transportedObservable (E := E) X A s))
        ((0 : EndH →L[ℝ] ℝ) (transportedObservable (E := E) X A t)
          + ω (transportedObservable (E := E)
            X (operatorInformationFirstVariation (E := E) X A) t))
        t :=
    hω.clm_apply hExp
  have hMain :
      HasDerivAt
        (fun s : ℝ => ω (transportedObservable (E := E) X A s))
        (ω (transportedObservable (E := E)
          X (operatorInformationFirstVariation (E := E) X A) t))
        t := by
    simpa [transportedObservable] using hApply
  exact hMain.deriv

/-- The derivative of the transported normalized Massieu slope is the expected first variation. -/
@[rep_depth transport]
theorem deriv_transportedMassieuSlope_at_zero_of_normalized
    (ω : EndH →L[ℝ] ℝ) (X A : EndH)
    (hω1 : ω (1 : EndH) = 1) :
    deriv (fun t => transportedMassieuSlope (E := E) ω X A t) 0
      =
    ω (operatorInformationFirstVariation (E := E) X A) := by
  have hEq :
      (fun t => transportedMassieuSlope (E := E) ω X A t)
        =
      fun t => ω (transportedObservable (E := E) X A t) := by
    funext t
    exact transportedMassieuSlope_eq_of_normalized
      (E := E) ω X A hω1 t
  rw [hEq]
  simpa [transportedObservable] using
    deriv_expectation_transportedObservable (E := E) ω X A 0

/--
The second derivative of the transported normalized Massieu slope is the
expected operatorial Hessian channel.
-/
@[rep_depth transport]
theorem deriv2_transportedMassieuSlope_at_zero_of_normalized
    (ω : EndH →L[ℝ] ℝ) (X A : EndH)
    (hω1 : ω (1 : EndH) = 1) :
    let f := fun t => transportedMassieuSlope (E := E) ω X A t
    deriv (fun t => deriv f t) 0
      =
    ω (operatorInformationHessian (E := E) X A) := by
  let δA : EndH := operatorInformationFirstVariation (E := E) X A
  have hEq :
      (fun t => transportedMassieuSlope (E := E) ω X A t)
        =
      fun t => ω (transportedObservable (E := E) X A t) := by
    funext t
    exact transportedMassieuSlope_eq_of_normalized
      (E := E) ω X A hω1 t
  have hDeriv :
      (fun t => deriv (fun s => ω (transportedObservable (E := E) X A s)) t)
        =
      fun t => ω (transportedObservable (E := E) X δA t) := by
    funext t
    simpa [δA, transportedObservable] using
      deriv_expectation_transportedObservable (E := E) ω X A t
  dsimp
  rw [hEq, hDeriv]
  simpa [operatorInformationHessian, δA, transportedObservable] using
    deriv_expectation_transportedObservable (E := E) ω X δA 0

/-- Infinitesimal metric transport law for the observable seed. -/
@[rep_depth transport]
theorem deriv_metricOfTransportedObservable_at_zero_eq_operatorInformationMetricReadout
    (X A : EndH) (u v : H₂) :
    deriv
      (fun t => metricOfOperator (E := E) (transportedObservable (E := E) X A t) u v)
      0
      =
    operatorInformationMetricReadout (E := E) X A u v := by
  simpa [transportedObservable, operatorInformationMetricReadout,
    operatorInformationFirstVariation] using
    (deriv_metricOfOperator_expTransport_at_zero (E := E) X A u v)

/-- Infinitesimal `(Jε)`-phase transport law for the observable seed. -/
@[rep_depth transport]
theorem deriv_phaseOfTransportedObservable_at_zero_eq_operatorInformationPhaseReadout
    (X A : EndH) (u v : H₂) :
    deriv
      (fun t => berryOfOperator (E := E) (transportedObservable (E := E) X A t) u v)
      0
      =
    operatorInformationPhaseReadout (E := E) X A u v := by
  simpa [transportedObservable, operatorInformationPhaseReadout,
    operatorInformationFirstVariation] using
    (deriv_berryOfOperator_expTransport (E := E) X A u v 0)

/-- Channel bilinear form induced by evaluating perturbation channels on a fixed doubled state. -/
@[rep_depth krein]
noncomputable def channelMetricAtState
    (ψ : H₂) : LinearMap.BilinForm ℝ (PerturbationChannel E) :=
  LinearMap.mk₂ ℝ
    (fun X Y => ⟪X ψ, Y ψ⟫_ℝ)
    (by
      intro X₁ X₂ Y
      simp [map_add, inner_add_left])
    (by
      intro c X Y
      simp [map_smul, real_inner_smul_left, smul_eq_mul, mul_assoc])
    (by
      intro X Y₁ Y₂
      simp [map_add, inner_add_right])
    (by
      intro c X Y
      simp [map_smul, real_inner_smul_right, smul_eq_mul, mul_assoc])

@[rep_depth krein, simp] theorem channelMetricAtState_apply
    (ψ : H₂) (X Y : PerturbationChannel E) :
    channelMetricAtState (E := E) ψ X Y = ⟪X ψ, Y ψ⟫_ℝ := rfl

/-- Concrete normalized realization of the abstract relational-information datum. -/
@[rep_depth krein]
noncomputable def normalizedRelationalDatum
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1) :
    RelationalInformationDatum (E := E) where
  referenceState := reference
  comparisonState := comparison
  modularData := M
  informationFunctional := fun ψ =>
    operatorMassieuSlope ω (stateRelativeModularGenerator (E := E) M ψ)
  firstVariation := fun ψ A =>
    ω (stateInducedDynamics (E := E) M ψ A)
  secondVariation := fun ψ =>
    channelMetricAtState (E := E) ψ

/-- The realized information functional is the normalized Massieu slope of the state generator. -/
@[rep_depth krein, simp]
theorem normalizedRelationalDatum_informationFunctional
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1)
    (ψ : H₂) :
    (normalizedRelationalDatum (E := E) reference comparison M ω hω1).informationFunctional ψ
      =
    ω (stateRelativeModularGenerator (E := E) M ψ) := by
  exact operatorMassieuSlope_eq_of_normalized
    (ω := ω) (A := stateRelativeModularGenerator (E := E) M ψ) hω1

/-- Reference functional value of the realized datum is the normalized slope at the reference state. -/
@[rep_depth krein, simp]
theorem normalizedRelationalDatum_referenceFunctionalValue
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1) :
    referenceFunctionalValue
        (normalizedRelationalDatum (E := E) reference comparison M ω hω1)
      =
    ω (stateRelativeModularGenerator (E := E) M reference) := by
  simp [referenceFunctionalValue, normalizedRelationalDatum_informationFunctional]

/-- Comparison functional value of the realized datum is the normalized slope at the comparison state. -/
@[rep_depth krein, simp]
theorem normalizedRelationalDatum_comparisonFunctionalValue
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1) :
    comparisonFunctionalValue
        (normalizedRelationalDatum (E := E) reference comparison M ω hω1)
      =
    ω (stateRelativeModularGenerator (E := E) M comparison) := by
  simp [comparisonFunctionalValue, normalizedRelationalDatum_informationFunctional]

/-- Comparison-state channel metric of the realized datum is the state-evaluated channel bilinear form. -/
@[rep_depth krein, simp]
theorem normalizedRelationalDatum_comparisonGeneratorMetric_apply
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1)
    (X Y : PerturbationChannel E) :
    comparisonGeneratorMetric
        (normalizedRelationalDatum (E := E) reference comparison M ω hω1) X Y
      =
    ⟪X comparison, Y comparison⟫_ℝ := by
  simp [comparisonGeneratorMetric, normalizedRelationalDatum, channelMetricAtState]

/-- The comparison-state first variation of the realized datum is the expected induced dynamics. -/
@[rep_depth transport, simp]
theorem normalizedRelationalDatum_firstVariation_comparison
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1)
    (A : ObservableAlgebra E) :
    (normalizedRelationalDatum (E := E) reference comparison M ω hω1).firstVariation comparison A
      =
    ω (comparisonInducedDynamics
      (normalizedRelationalDatum (E := E) reference comparison M ω hω1) A) := by
  rfl

/-- The comparison-state phase form of the realized datum is the channel metric twisted by `K = Jε`. -/
@[rep_depth krein, simp]
theorem normalizedRelationalDatum_comparisonGeneratorPhase_apply
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1)
    (X Y : PerturbationChannel E) :
    comparisonGeneratorPhase
        (normalizedRelationalDatum (E := E) reference comparison M ω hω1) X Y
      =
    ⟪(X.comp (InfoGeometry.Canonical.TomitaTakesaki.modularComplexI (E := E))) comparison,
      Y comparison⟫_ℝ := by
  simp [comparisonGeneratorPhase, comparisonGeneratorMetric,
    normalizedRelationalDatum, channelMetricAtState, channelPhaseAxis]

end Core

end InfoGeometry.Canonical.RelationalInformationDynamics
