{"type":"new","contents":"import InfoGeometry.Tensor.DeBruijn\n\nnamespace InfoGeometry\nnamespace Tensor\n\n/-!\n# De Bruijn payload readback records\n\nThis module is the first conservative readback layer above\n`InfoGeometry.Tensor.DeBruijn`.  It models the shape of an external graph edge\nrecord without granting authority to the graph store.\n\nThe endpoints and role strings are ordinary payload data.  Promotion to a\ncertified contraction still requires Lean evidence for the `DeBruijnEdge`\nobtained from the payload.\n-/\n\n/-- Physical graph endpoints for an external graph record.\n\nThese endpoints model storage/navigation identity such as Arango `_from` and\n`_to`.  They are not De Bruijn coordinates and carry no proof authority. -/\nstructure GraphEndpoints where\n  source : String\n  target : String\n  deriving Repr, DecidableEq\n\nnamespace GraphEndpoints\n\n/-- Read back the storage source endpoint. -/\ntheorem source_readback (g : GraphEndpoints) : g.source = g.source :=\n  rfl\n\n/-- Read back the storage target endpoint. -/\ntheorem target_readback (g : GraphEndpoints) : g.target = g.target :=\n  rfl\n\nend GraphEndpoints\n\n/-- External edge-payload coordinates that can be read back to a Lean\n`DeBruijnEdge`.\n\nThe field order keeps endpoint-free local coordinates separate from graph\nstorage endpoints.  The fields mirror a conservative JSON-like payload, but this\nstructure itself is only Lean data. -/\nstructure DeBruijnPayload where\n  sourceArity : ℕ\n  targetArity : ℕ\n  sourcePort : ℕ\n  targetPort : ℕ\n  binderDepth : ℕ\n  scopeDepth : ℕ\n  sourceBondDim : ℕ\n  targetBondDim : ℕ\n  deriving Repr, DecidableEq\n\nnamespace DeBruijnPayload\n\n/-- Read a payload back into the certified Lean edge kernel. -/\ndef toEdge (p : DeBruijnPayload) : DeBruijnEdge where\n  sourceArity := p.sourceArity\n  targetArity := p.targetArity\n  sourcePort := p.sourcePort\n  targetPort := p.targetPort\n  binderDepth := p.binderDepth\n  scopeDepth := p.scopeDepth\n  sourceBondDim := p.sourceBondDim\n  targetBondDim := p.targetBondDim\n\n@[simp] theorem toEdge_sourceArity (p : DeBruijnPayload) :\n    p.toEdge.sourceArity = p.sourceArity :=\n  rfl\n\n@[simp] theorem toEdge_targetArity (p : DeBruijnPayload) :\n    p.toEdge.targetArity = p.targetArity :=\n  rfl\n\n@[simp] theorem toEdge_sourcePort (p : DeBruijnPayload) :\n    p.toEdge.sourcePort = p.sourcePort :=\n  rfl\n\n@[simp] theorem toEdge_targetPort (p : DeBruijnPayload) :\n    p.toEdge.targetPort = p.targetPort :=\n  rfl\n\n@[simp] theorem toEdge_binderDepth (p : DeBruijnPayload) :\n    p.toEdge.binderDepth = p.binderDepth :=\n  rfl\n\n@[simp] theorem toEdge_scopeDepth (p : DeBruijnPayload) :\n    p.toEdge.scopeDepth = p.scopeDepth :=\n  rfl\n\n@[simp] theorem toEdge_sourceBondDim (p : DeBruijnPayload) :\n    p.toEdge.sourceBondDim = p.sourceBondDim :=\n  rfl\n\n@[simp] theorem toEdge_targetBondDim (p : DeBruijnPayload) :\n    p.toEdge.targetBondDim = p.targetBondDim :=\n  rfl\n\n/-- Payload-level in-scope condition, defined by Lean readback. -/\ndef InScope (p : DeBruijnPayload) : Prop :=\n  p.toEdge.InScope\n\n/-- Payload-level port-compatibility condition, defined by Lean readback. -/\ndef PortCompatible (p : DeBruijnPayload) : Prop :=\n  p.toEdge.PortCompatible\n\n/-- Payload-level promotion condition. -/\ndef Promotable (p : DeBruijnPayload) : Prop :=\n  p.toEdge.ContractionSound\n\n/-- Payload promotability is exactly the conjunction required by the kernel. -/\ntheorem promotable_iff (p : DeBruijnPayload) :\n    p.Promotable ↔ p.InScope ∧ p.PortCompatible :=\n  Iff.rfl\n\n/-- Read back the source-port bound from a payload-level scope proof. -/\ntheorem source_port_lt {p : DeBruijnPayload} (h : p.InScope) :\n    p.sourcePort < p.sourceArity :=\n  h.1\n\n/-- Read back the target-port bound from a payload-level scope proof. -/\ntheorem target_port_lt {p : DeBruijnPayload} (h : p.InScope) :\n    p.targetPort < p.targetArity :=\n  h.2.1\n\n/-- Read back the binder/scope bound from a payload-level scope proof. -/\ntheorem scope_sound {p : DeBruijnPayload} (h : p.InScope) :\n    p.binderDepth ≤ p.scopeDepth :=\n  h.2.2\n\n/-- Read back local bond-dimension compatibility from a payload-level\ncompatibility proof. -/\ntheorem compatible_of_payload {p : DeBruijnPayload} (h : p.PortCompatible) :\n    p.sourceBondDim = p.targetBondDim :=\n  h\n\n/-- Promote a payload to a Lean certificate when Lean evidence is supplied. -/\ndef mkCertified (p : DeBruijnPayload) (hscope : p.InScope)\n    (hcompat : p.PortCompatible) : CertifiedContraction :=\n  CertifiedContraction.mkCertifiedEdge p.toEdge hscope hcompat\n\n@[simp] theorem mkCertified_edge (p : DeBruijnPayload) (hscope : p.InScope)\n    (hcompat : p.PortCompatible) :\n    (p.mkCertified hscope hcompat).edge = p.toEdge :=\n  rfl\n\n/-- A promoted payload is contraction-sound in the kernel. -/\ntheorem certified_contractionSound (p : DeBruijnPayload) (hscope : p.InScope)\n    (hcompat : p.PortCompatible) :\n    (p.mkCertified hscope hcompat).edge.ContractionSound :=\n  (p.mkCertified hscope hcompat).contractionSound\n\nend DeBruijnPayload\n\n/-- Candidate graph record for a De Bruijn contraction.\n\nThe candidate role is data only.  It does not certify the payload. -/\nstructure CandidateContractionRecord where\n  endpoints : GraphEndpoints\n  payload : DeBruijnPayload\n  deriving Repr, DecidableEq\n\nnamespace CandidateContractionRecord\n\n/-- The conventional external role string for candidate records. -/\ndef role (_ : CandidateContractionRecord) : String :=\n  \"candidate_contraction\"\n\n@[simp] theorem role_eq (r : CandidateContractionRecord) :\n    r.role = \"candidate_contraction\" :=\n  rfl\n\n/-- A candidate record is promotable exactly when its payload is promotable. -/\ndef Promotable (r : CandidateContractionRecord) : Prop :=\n  r.payload.Promotable\n\n/-- Candidate-record promotability is Lean kernel contraction soundness after\npayload readback. -/\ntheorem promotable_iff (r : CandidateContractionRecord) :\n    r.Promotable ↔ r.payload.toEdge.ContractionSound :=\n  Iff.rfl\n\n/-- The candidate source endpoint is preserved as graph-navigation data. -/\ntheorem endpoint_source_readback (r : CandidateContractionRecord) :\n    r.endpoints.source = r.endpoints.source :=\n  rfl\n\n/-- The candidate target endpoint is preserved as graph-navigation data. -/\ntheorem endpoint_target_readback (r : CandidateContractionRecord) :\n    r.endpoints.target = r.endpoints.target :=\n  rfl\n\nend CandidateContractionRecord\n\n/-- Certified graph record for a De Bruijn contraction.\n\nA certified record keeps the original endpoints and payload, but also carries a\nLean `CertifiedContraction` whose edge is definitionally the payload readback. -/\nstructure CertifiedContractionRecord where\n  endpoints : GraphEndpoints\n  payload : DeBruijnPayload\n  certificate : CertifiedContraction\n  certificate_readback : certificate.edge = payload.toEdge\n\nnamespace CertifiedContractionRecord\n\n/-- The conventional external role string for certified records. -/\ndef role (_ : CertifiedContractionRecord) : String :=\n  \"certified_contraction\"\n\n@[simp] theorem role_eq (r : CertifiedContractionRecord) :\n    r.role = \"certified_contraction\" :=\n  rfl\n\n/-- Promote a candidate graph record only when Lean evidence for the payload is\navailable. -/\ndef promote (r : CandidateContractionRecord) (hscope : r.payload.InScope)\n    (hcompat : r.payload.PortCompatible) : CertifiedContractionRecord where\n  endpoints := r.endpoints\n  payload := r.payload\n  certificate := r.payload.mkCertified hscope hcompat\n  certificate_readback := rfl\n\n@[simp] theorem promote_endpoints (r : CandidateContractionRecord)\n    (hscope : r.payload.InScope) (hcompat : r.payload.PortCompatible) :\n    (promote r hscope hcompat).endpoints = r.endpoints :=\n  rfl\n\n@[simp] theorem promote_payload (r : CandidateContractionRecord)\n    (hscope : r.payload.InScope) (hcompat : r.payload.PortCompatible) :\n    (promote r hscope hcompat).payload = r.payload :=\n  rfl\n\n@[simp] theorem promote_certificate_edge (r : CandidateContractionRecord)\n    (hscope : r.payload.InScope) (hcompat : r.payload.PortCompatible) :\n    (promote r hscope hcompat).certificate.edge = r.payload.toEdge :=\n  rfl\n\n/-- A certified graph record has a Lean contraction-sound certificate. -/\ntheorem contractionSound (r : CertifiedContractionRecord) :\n    r.certificate.edge.ContractionSound :=\n  r.certificate.contractionSound\n\n/-- Read back source-port bound from a certified graph record. -/\ntheorem source_port_lt (r : CertifiedContractionRecord) :\n    r.payload.sourcePort < r.payload.sourceArity := by\n  have hsource : r.certificate.edge.sourcePort < r.certificate.edge.sourceArity :=\n    r.certificate.source_port_lt\n  simpa [r.certificate_readback] using hsource\n\n/-- Read back target-port bound from a certified graph record. -/\ntheorem target_port_lt (r : CertifiedContractionRecord) :\n    r.payload.targetPort < r.payload.targetArity := by\n  have htarget : r.certificate.edge.targetPort < r.certificate.edge.targetArity :=\n    r.certificate.target_port_lt\n  simpa [r.certificate_readback] using htarget\n\n/-- Read back binder/scope soundness from a certified graph record. -/\ntheorem scope_sound (r : CertifiedContractionRecord) :\n    r.payload.binderDepth ≤ r.payload.scopeDepth := by\n  have hscope : r.certificate.edge.binderDepth ≤ r.certificate.edge.scopeDepth :=\n    r.certificate.scope_sound\n  simpa [r.certificate_readback] using hscope\n\n/-- Read back local bond-dimension compatibility from a certified graph record. -/\ntheorem compatible_of_certified (r : CertifiedContractionRecord) :\n    r.payload.sourceBondDim = r.payload.targetBondDim := by\n  have hcompat : r.certificate.edge.sourceBondDim = r.certificate.edge.targetBondDim :=\n    r.certificate.compatible_of_certified\n  simpa [r.certificate_readback] using hcompat\n\nend CertifiedContractionRecord\n\nend Tensor\nend InfoGeometry\n","mtime":1778320428033}