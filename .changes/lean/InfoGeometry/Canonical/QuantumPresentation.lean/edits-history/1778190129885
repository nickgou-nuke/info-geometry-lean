{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Canonical/QuantumPresentation.lean","time":1778190129885,"baseTime":1778190129348,"changes":[{"range":{"start":{"line":218,"character":0},"end":{"line":234,"character":0}},"text":"/-- Left identity law for intertwiner composition. -/\n@[rep_depth krein]\ntheorem compIntertwiner_id_left\n    {P Q : Presentation}\n    (F : Intertwiner P Q) :\n    compIntertwiner (idIntertwiner P) F = F := by\n  cases F\n  rfl\n\n/-- Right identity law for intertwiner composition. -/\n@[rep_depth krein]\ntheorem compIntertwiner_id_right\n    {P Q : Presentation}\n    (F : Intertwiner P Q) :\n    compIntertwiner F (idIntertwiner Q) = F := by\n  cases F\n  rfl\n\n/-- Associativity law for intertwiner composition. -/\n@[rep_depth krein]\ntheorem compIntertwiner_assoc\n    {P Q R S : Presentation}\n    (F : Intertwiner P Q)\n    (G : Intertwiner Q R)\n    (H : Intertwiner R S) :\n    compIntertwiner (compIntertwiner F G) H =\n      compIntertwiner F (compIntertwiner G H) := by\n  cases F\n  cases G\n  cases H\n  rfl\n\n/--\nConcrete toy presentation on paired states.\n\nIt provides a non-identity swap example for the `Intertwiner` and\nreadout-preservation machinery.  It is not a quantum owner surface.\n-/\n@[rep_depth operator]\ndef pairedFunctionPresentation (α : Type) : Presentation where\n  Scalar := α × α\n  State := α × α\n  Observable := (α → α) × (α → α)\n  act := fun o s => (o.1 s.1, o.2 s.2)\n  support := fun s => s.1 = s.2\n  generator := fun s => (s.2, s.1)\n  metricReadout := fun s => s\n  phaseReadout := fun s => (s.2, s.1)\n\n/-- Support in the paired toy presentation is the diagonal relation. -/\n@[rep_depth operator]\ntheorem pairedFunctionPresentation_support_iff\n    {α : Type} (s : (pairedFunctionPresentation α).State) :\n    (pairedFunctionPresentation α).support s ↔ s.1 = s.2 := by\n  rfl\n","rangeOffset":6883,"rangeLength":514}]}