    (Obs : Type*) [Ring Obs] where
  action : Obs ≃+* Obs
  involutive : ∀ x : Obs, action (action x) = x

/--
A Klein-four-style action by ring automorphisms.

This is intentionally structural.  It records an abstract fourfold discrete
symmetry action without choosing a concrete finite type or proving that the
type has exactly four elements.
-/
@[rep_depth operator]
structure KleinFourAction
    (Obs : Type*) [Ring Obs] where
  V4 : Type*
  one : V4
  mul : V4 → V4 → V4
  action : V4 → Obs ≃+* Obs
  action_one : action one = RingEquiv.refl Obs
  action_mul :
    ∀ g h : V4, ∀ x : Obs,
      action (mul g h) x = action g (action h x)
  involutive :
    ∀ g : V4, ∀ x : Obs,
      action g (action g x) = x

/--
The modular-chiral trembling orbit generated by modular time and one supplied
involutive symmetry.
-/
@[rep_depth operator]
def modularChiralOrbit
    {Obs : Type*} [Ring Obs]
    (flow : ModularFlow Obs)
    (χ : InvolutiveSymmetry Obs)
    (x : Obs)
    (t : ℝ) : Obs :=
  flow.flow t (χ.action x)

/--
A modular V₄ orbit point.

This is the structural form of `x(t,g) = σ_t(g · x)`.
-/
@[rep_depth operator]
def modularV4Orbit
    {Obs : Type*} [Ring Obs]
    (flow : ModularFlow Obs)
    (V : KleinFourAction Obs)
    (x : Obs)
    (g : V.V4)
    (t : ℝ) : Obs :=
  flow.flow t (V.action g x)

/--
Drazin data for a modular-chiral frequency operator.

This is distinct from the signal Drazin support.  Here the projector
`1 - L * LD` is the harmonic / zero-frequency selector.
-/
@[rep_depth operator]
structure DrazinFrequencyData
    (Obs : Type*) [Ring Obs] [Star Obs] where
  L : Obs
  LD : Obs
  harmonicProj : Obs
  index : ℕ
  drazin_True : IsDrazinInverse L LD index
  harmonicProj_def : harmonicProj = 1 - L * LD
  harmonic_self_adjoint : star harmonicProj = harmonicProj

namespace DrazinFrequencyData

variable {Obs : Type*} [Ring Obs] [Star Obs]
variable (F : DrazinFrequencyData Obs)

/-- The harmonic / zero-frequency projector is idempotent. -/
@[rep_depth operator]
theorem harmonic_idempotent :
    F.harmonicProj * F.harmonicProj = F.harmonicProj := by
  rw [F.harmonicProj_def]
  simpa [IsDrazinInverse.complementaryProjection, IsDrazinInverse.projection] using
    IsDrazinInverse.complementaryProjection_is_idempotent F.drazin_True

end DrazinFrequencyData

/--
A horizon harmonic mode is localized on the Drazin horizon, selected by the
frequency harmonic projector on both sides, and fixed by the modular flow.
-/
@[rep_depth operator]
def IsHorizonHarmonicMode
    {Obs : Type*} [Ring Obs] [Star Obs]
    (flow : ModularFlow Obs)
    (H : DrazinHorizon Obs)
    (F : DrazinFrequencyData Obs)
    (x : Obs) : Prop :=
  H.p * x * H.p = x ∧
  F.harmonicProj * x * F.harmonicProj = x ∧
  IsModularZeroMode flow x
