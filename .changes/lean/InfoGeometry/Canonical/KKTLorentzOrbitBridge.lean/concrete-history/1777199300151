{"type":"new","contents":"import InfoGeometry.Canonical.KKTCore\nimport Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic\nimport InfoGeometry.Meta.Architecture\n\nopen scoped InnerProductSpace\n\n/-!\n# InfoGeometry.Canonical.KKTLorentzOrbitBridge\n\nTranslator/coherence surface for Lorentz-orbit language on the existing\n`KKTCore` split `Cl(1,1)` channel decomposition.\n\nThis file does not add new owners. It exposes the channel-weight action of the\n`ε`-generated hyperbolic boost on the already-owned `uPlus/uMinus` channels.\n-/\n\nnamespace InfoGeometry.Canonical.KKTLorentzOrbitBridge\n\nopen InfoGeometry.Canonical.KKTCore\nopen InfoGeometry.Quantum\n\nsection Core\n\nvariable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]\n\nlocal notation \"EndH\" => H →L[ℝ] H\nlocal notation \"IdH\" => ContinuousLinearMap.id ℝ H\n\n/-- Hyperbolic Cartan boost generated by the grading involution `ε`. -/\n@[rep_depth transport]\nnoncomputable def channelBoost (X : RealSplitCl11Action H) (τ : ℝ) : EndH :=\n  (Real.cosh τ) • IdH + (Real.sinh τ) • X.eps\n\n/-- Left `ε`-action on the grade `+1` channel is weight `+1`. -/\n@[rep_depth krein]\ntheorem eps_mul_gOnePart\n    (X : RealSplitCl11Action H) (A : EndH) :\n    X.eps * gOnePart X A = gOnePart X A := by\n  unfold gOnePart\n  calc\n    X.eps * (plusProjector X * A * minusProjector X)\n        = (X.eps * plusProjector X) * A * minusProjector X := by simp [mul_assoc]\n    _ = plusProjector X * A * minusProjector X := by\n          rw [eps_mul_plusProjector]\n\n/-- Right `ε`-action on the grade `+1` channel is weight `-1`. -/\n@[rep_depth krein]\ntheorem gOnePart_mul_eps\n    (X : RealSplitCl11Action H) (A : EndH) :\n    gOnePart X A * X.eps = -(gOnePart X A) := by\n  unfold gOnePart\n  calc\n    (plusProjector X * A * minusProjector X) * X.eps\n        = plusProjector X * A * (minusProjector X * X.eps) := by simp [mul_assoc]\n    _ = plusProjector X * A * (-minusProjector X) := by\n          rw [minusProjector_mul_eps]\n    _ = -(plusProjector X * A * minusProjector X) := by simp [mul_assoc]\n\n/-- Left `ε`-action on the grade `-1` channel is weight `-1`. -/\n@[rep_depth krein]\ntheorem eps_mul_gNegOnePart\n    (X : RealSplitCl11Action H) (A : EndH) :\n    X.eps * gNegOnePart X A = -(gNegOnePart X A) := by\n  unfold gNegOnePart\n  calc\n    X.eps * (minusProjector X * A * plusProjector X)\n        = (X.eps * minusProjector X) * A * plusProjector X := by simp [mul_assoc]\n    _ = (-minusProjector X) * A * plusProjector X := by\n          rw [eps_mul_minusProjector]\n    _ = -(minusProjector X * A * plusProjector X) := by simp [mul_assoc]\n\n/-- Right `ε`-action on the grade `-1` channel is weight `+1`. -/\n@[rep_depth krein]\ntheorem gNegOnePart_mul_eps\n    (X : RealSplitCl11Action H) (A : EndH) :\n    gNegOnePart X A * X.eps = gNegOnePart X A := by\n  unfold gNegOnePart\n  calc\n    (minusProjector X * A * plusProjector X) * X.eps\n        = minusProjector X * A * (plusProjector X * X.eps) := by simp [mul_assoc]\n    _ = minusProjector X * A * plusProjector X := by\n          rw [plusProjector_mul_eps]\n\n/-- The grade-zero channel commutes with the grading involution `ε`. -/\n@[rep_depth krein]\ntheorem eps_mul_gZeroPart_eq_gZeroPart_mul_eps\n    (X : RealSplitCl11Action H) (A : EndH) :\n    X.eps * gZeroPart X A = gZeroPart X A * X.eps := by\n  unfold gZeroPart\n  calc\n    X.eps * (plusProjector X * A * plusProjector X + minusProjector X * A * minusProjector X)\n        =\n      (X.eps * plusProjector X) * A * plusProjector X\n        + (X.eps * minusProjector X) * A * minusProjector X := by\n          simp [mul_add, mul_assoc]\n    _ =\n      plusProjector X * A * plusProjector X\n        + (-minusProjector X) * A * minusProjector X := by\n          rw [eps_mul_plusProjector, eps_mul_minusProjector]\n    _ =\n      plusProjector X * A * plusProjector X\n        + minusProjector X * A * (-minusProjector X) := by\n          simp [mul_assoc]\n    _ =\n      plusProjector X * A * (plusProjector X * X.eps)\n        + minusProjector X * A * (minusProjector X * X.eps) := by\n          rw [plusProjector_mul_eps, minusProjector_mul_eps]\n    _ =\n      plusProjector X * A * plusProjector X * X.eps\n        + minusProjector X * A * minusProjector X * X.eps := by\n          simp [mul_assoc]\n    _ = (plusProjector X * A * plusProjector X + minusProjector X * A * minusProjector X) * X.eps := by\n          simp [add_mul, mul_assoc]\n\n/-- The `ε`-boost commutes with grade-zero operators. -/\n@[rep_depth transport]\ntheorem channelBoost_mul_gZeroPart_eq_gZeroPart_mul_channelBoost\n    (X : RealSplitCl11Action H) (τ : ℝ) (A : EndH) :\n    channelBoost X τ * gZeroPart X A = gZeroPart X A * channelBoost X τ := by\n  have hIdLeft (T : EndH) : IdH * T = T := by\n    change (1 : EndH) * T = T\n    simp\n  have hIdRight (T : EndH) : T * IdH = T := by\n    change T * (1 : EndH) = T\n    simp\n  calc\n    channelBoost X τ * gZeroPart X A\n        = ((Real.cosh τ) • IdH + (Real.sinh τ) • X.eps) * gZeroPart X A := by\n            rfl\n    _ = (Real.cosh τ) • (IdH * gZeroPart X A)\n          + (Real.sinh τ) • (X.eps * gZeroPart X A) := by\n            simp [add_mul]\n    _ = (Real.cosh τ) • gZeroPart X A\n          + (Real.sinh τ) • (gZeroPart X A * X.eps) := by\n            rw [hIdLeft, eps_mul_gZeroPart_eq_gZeroPart_mul_eps]\n    _ = (Real.cosh τ) • (gZeroPart X A * IdH)\n          + (Real.sinh τ) • (gZeroPart X A * X.eps) := by\n            rw [hIdRight]\n    _ = gZeroPart X A * ((Real.cosh τ) • IdH + (Real.sinh τ) • X.eps) := by\n          simp [mul_add]\n    _ = gZeroPart X A * channelBoost X τ := by\n          rfl\n\n/-- Boost weight of the circularly polarized `uPlus` (`g₁`) channel. -/\n@[rep_depth transport]\ntheorem channelBoost_mul_uPlus\n    (X : RealSplitCl11Action H) (τ : ℝ) (A : EndH) :\n    channelBoost X τ * uPlus X A\n      = (Real.cosh τ + Real.sinh τ) • uPlus X A := by\n  have hIdLeft (T : EndH) : IdH * T = T := by\n    change (1 : EndH) * T = T\n    simp\n  calc\n    channelBoost X τ * uPlus X A\n        = ((Real.cosh τ) • IdH + (Real.sinh τ) • X.eps) * uPlus X A := by\n            rfl\n    _ = (Real.cosh τ) • (IdH * uPlus X A) + (Real.sinh τ) • (X.eps * uPlus X A) := by\n          simp [add_mul]\n    _ = (Real.cosh τ) • uPlus X A + (Real.sinh τ) • uPlus X A := by\n          rw [hIdLeft]\n          simp [uPlus, eps_mul_gOnePart]\n    _ = (Real.cosh τ + Real.sinh τ) • uPlus X A := by\n          exact (add_smul (Real.cosh τ) (Real.sinh τ) (uPlus X A)).symm\n\n/-- Boost weight of the circularly polarized `uMinus` (`g₋₁`) channel. -/\n@[rep_depth transport]\ntheorem channelBoost_mul_uMinus\n    (X : RealSplitCl11Action H) (τ : ℝ) (A : EndH) :\n    channelBoost X τ * uMinus X A\n      = (Real.cosh τ - Real.sinh τ) • uMinus X A := by\n  have hIdLeft (T : EndH) : IdH * T = T := by\n    change (1 : EndH) * T = T\n    simp\n  calc\n    channelBoost X τ * uMinus X A\n        = ((Real.cosh τ) • IdH + (Real.sinh τ) • X.eps) * uMinus X A := by\n            rfl\n    _ = (Real.cosh τ) • (IdH * uMinus X A) + (Real.sinh τ) • (X.eps * uMinus X A) := by\n          simp [add_mul]\n    _ = (Real.cosh τ) • uMinus X A + (Real.sinh τ) • (-(uMinus X A)) := by\n          rw [hIdLeft]\n          simp [uMinus, eps_mul_gNegOnePart]\n    _ = (Real.cosh τ) • uMinus X A + (-Real.sinh τ) • uMinus X A := by\n          simp [smul_neg]\n    _ = (Real.cosh τ - Real.sinh τ) • uMinus X A := by\n          simpa [sub_eq_add_neg] using\n            (add_smul (Real.cosh τ) (-Real.sinh τ) (uMinus X A)).symm\n\nend Core\n\nend InfoGeometry.Canonical.KKTLorentzOrbitBridge\n","mtime":1777199300151}