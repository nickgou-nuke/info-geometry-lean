import InfoGeometry.Canonical.DualConnectionsCore
import InfoGeometry.Information.MultiLogPotential
import Mathlib.Tactic.Ring
set_option linter.unusedSimpArgs false

open scoped BigOperators

/-!
# Canonical.DualConnectionsFiniteExpFamily

Concrete bridge between finite exponential-family Fisher/covariance objects and
the `alphaConnectionTensor` API.
-/

namespace InfoGeometry.Canonical.DualConnections

open InfoGeometry.Information

variable {α : Type*} [Fintype α] [Nonempty α]
variable {d : ℕ}

/-- The finite-exponential-family density at `θ` packaged as `FinProb`. -/
noncomputable def finiteExpFamilyFinProb
    (F : FiniteExpFamily (α := α) d)
    (θ : Fin d → ℝ) : InfoGeometry.FinProb α := by
  classical
  have hnonneg :
      ∀ x ∈ (Finset.univ : Finset α), 0 ≤ density F θ x := by
    intro x hx
    exact density_nonneg (F := F) (θ := θ) (x := x)
  have hsum :
      ∑ x, ENNReal.ofReal (density F θ x) = 1 := by
    calc
      ∑ x, ENNReal.ofReal (density F θ x)
          = ENNReal.ofReal (∑ x, density F θ x) := by
              simpa using
                (ENNReal.ofReal_sum_of_nonneg
                  (s := (Finset.univ : Finset α))
                  (f := fun x => density F θ x)
                  hnonneg).symm
      _ = ENNReal.ofReal 1 := by
            simp [density_sum_one (F := F) (θ := θ)]
      _ = 1 := by simp
  exact InfoGeometry.FinProb.of_fintype (fun x => ENNReal.ofReal (density F θ x)) hsum

/-- Probability map induced by a finite exponential family. -/
noncomputable def finiteExpFamilyProbMap
    (F : FiniteExpFamily (α := α) d) :
    (Fin d → ℝ) → InfoGeometry.FinProb α :=
  finiteExpFamilyFinProb F

@[simp] lemma finiteExpFamilyProbMap_apply
    (F : FiniteExpFamily (α := α) d)
    (θ : Fin d → ℝ) (x : α) :
    finiteExpFamilyProbMap F θ x = ENNReal.ofReal (density F θ x) := by
  simp [finiteExpFamilyProbMap, finiteExpFamilyFinProb, InfoGeometry.FinProb.of_fintype]

lemma finiteExpFamilyProbMap_apply_toReal
    (F : FiniteExpFamily (α := α) d)
    (θ : Fin d → ℝ) (x : α) :
    (finiteExpFamilyProbMap F θ x).toReal = density F θ x := by
  have hnonneg : 0 ≤ density F θ x := density_nonneg (F := F) (θ := θ) (x := x)
  simpa [finiteExpFamilyProbMap_apply] using (ENNReal.toReal_ofReal hnonneg)

/-- Fisher/covariance bilinear form in parameter coordinates. -/
noncomputable def fisherCovarianceBilinear
    (F : FiniteExpFamily (α := α) d)
    (θ : Fin d → ℝ)
    (u v : Fin d → ℝ) : ℝ :=
  ∑ i, ∑ j, u i * InfoGeometry.Information.fisherMetric F θ i j * v j

omit [Nonempty α] in
@[simp] lemma fisherMetric_eq_covariance
    (F : FiniteExpFamily (α := α) d)
    (θ : Fin d → ℝ)
    (i j : Fin d) :
    InfoGeometry.Information.fisherMetric F θ i j = covariance F θ i j := rfl

/-- Score field generated by a parameter direction using centered statistics. -/
noncomputable def centeredScore
    (F : FiniteExpFamily (α := α) d)
    (θ : Fin d → ℝ)
    (v : Fin d → ℝ) : FiberTangent α :=
  fun x => centeredLinearStat F θ v x

/-- `fisherBilinear` specializes to expectation of pointwise products for this family. -/
lemma fisherBilinear_eq_expectation_mul
    (F : FiniteExpFamily (α := α) d)
    (θ : Fin d → ℝ)
    (u v : FiberTangent α) :
    fisherBilinear (p := finiteExpFamilyProbMap F) θ u v
      = InfoGeometry.Information.expectation F θ (fun x => u x * v x) := by
  unfold fisherBilinear InfoGeometry.Information.expectation
  refine Finset.sum_congr rfl ?_
  intro x _hx
  have hnonneg : 0 ≤ density F θ x := density_nonneg (F := F) (θ := θ) (x := x)
  simp [finiteExpFamilyProbMap_apply, ENNReal.toReal_ofReal, hnonneg, mul_assoc, mul_comm, mul_left_comm]

/--
Concrete Fisher bridge:
the finite-family Fisher quadratic form equals `fisherBilinear` evaluated on the
centered score field induced by the same direction.
-/
lemma fisherQuadratic_eq_fisherBilinear_centeredScore
    (F : FiniteExpFamily (α := α) d)
    (θ v : Fin d → ℝ) :
    InfoGeometry.Information.fisherQuadratic F θ v
      = fisherBilinear (p := finiteExpFamilyProbMap F) θ
          (centeredScore F θ v) (centeredScore F θ v) := by
  rw [InfoGeometry.Information.fisher_as_variance (F := F) (θ := θ) (v := v)]
  have hsq :
      InfoGeometry.Information.expectation F θ
          (fun x => InfoGeometry.Information.centeredLinearStat F θ v x ^ (2 : ℕ))
        =
      InfoGeometry.Information.expectation F θ
          (fun x => centeredScore F θ v x * centeredScore F θ v x) := by
    unfold InfoGeometry.Information.expectation centeredScore
    refine Finset.sum_congr rfl ?_
    intro x _hx
    ring
  rw [hsq]
  rw [← fisherBilinear_eq_expectation_mul (F := F) (θ := θ)
      (u := centeredScore F θ v) (v := centeredScore F θ v)]

/-- `alphaConnectionTensor` specialized to the finite-family probability map. -/
noncomputable def finiteExpFamilyAlphaConnectionTensor
    (F : FiniteExpFamily (α := α) d)
    (Gamma0 : ConnectionTensor (Fin d → ℝ) α)
    (αc : ℝ) : ConnectionTensor (Fin d → ℝ) α :=
  alphaConnectionTensor Gamma0 (finiteExpFamilyProbMap F) αc

/-- Canonical bundled `α`-connection carried by a finite exponential family. -/
noncomputable def finiteExpFamilyAlphaConnection
    (F : FiniteExpFamily (α := α) d)
    (Gamma0 : ConnectionTensor (Fin d → ℝ) α)
    (αc : ℝ) :
    alphaConnection (p := finiteExpFamilyProbMap F) αc :=
  alphaConnection.mkFromReference
    (p := finiteExpFamilyProbMap F)
    (αc := αc)
    (Gamma0 := Gamma0)
    (hFisher := fisherMetric_of_finProb (p := finiteExpFamilyProbMap F))
    (hChentsov := amariChentsovTensor_of_finProb (p := finiteExpFamilyProbMap F))

@[simp] lemma finiteExpFamilyAlphaConnection_deformation
    (F : FiniteExpFamily (α := α) d)
    (Gamma0 : ConnectionTensor (Fin d → ℝ) α)
    (αc : ℝ) :
    (finiteExpFamilyAlphaConnection (F := F) Gamma0 αc).Gamma
      = finiteExpFamilyAlphaConnectionTensor (F := F) Gamma0 αc := by
  rfl

end InfoGeometry.Canonical.DualConnections
