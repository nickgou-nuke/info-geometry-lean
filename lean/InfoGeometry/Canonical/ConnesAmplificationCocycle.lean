import Mathlib.Analysis.Normed.Algebra.Exponential
import Mathlib.Analysis.CStarAlgebra.Matrix
import Mathlib.Data.Matrix.Block
import Mathlib.Tactic
import InfoGeometry.Modular.ConnesCocycle
import InfoGeometry.OperatorAlgebra.ConstructiveConnesCocycle

/-!
# Constructive Connes Radon–Nikodym Cocycle & 2×2 Block Amplification (`F4`)

Constructs noncommutative Connes 1-cocycles `u_t = (Dψ : Dφ)_t` unconditionally
from self-adjoint modular generators `H_φ, H_ψ` (without taking `isCocycle` or
`intertwines` as hypotheses and without restricting to scalar multiples of `1`):

1. **Generic Complex Banach \*-Algebra Connes Cocycle**:
   Over any `[NormedRing A] [NormedAlgebra ℂ A] [CompleteSpace A] [StarRing A] [ContinuousStar A] [StarModule ℂ A]`,
   defines `unitaryExp H t = exp ((I * t) • H)` and `u_t = unitaryExp H_psi t * unitaryExp H_phi (-t)`,
   proving `u_{s+t} = u_s * σ_s^φ(u_t)`, intertwining `σ_t^ψ(x) = u_t * σ_t^φ(x) * u_t⋆`,
   and the Connes chain rule `u_{χ,φ}(t) = u_{χ,ψ}(t) * u_{ψ,φ}(t)`.
   Instantiates both `InfoGeometry.Modular.ConnesCocycle.ConnesOneCocycle` and
   `InfoGeometry.OperatorAlgebra.ConstructiveConnesCocycle.ConnesCocycleData`.
2. **Connes 2×2 Matrix Amplification (`M₂(M_n(ℂ))`)**:
   Forms the balanced block Hamiltonian `fromBlocks H_phi 0 0 H_psi` on `Fin n ⊕ Fin n`
   and proves that evaluating its modular flow on `e₂₁ = fromBlocks 0 0 1 0` recovers
   `u_t = unitaryExp H_psi t * unitaryExp H_phi (-t)` directly in the `(2,1)` block.
3. **Explicit Noncommuting `2×2` Witness**:
   `witnessHPhi = !![1, 0; 0, -1]` and `witnessHPsi = !![0, 1; 1, 0]` satisfy `H* = H`
   and `H_φ * H_ψ ≠ H_ψ * H_φ`, giving a noncommuting Connes cocycle inhabitant.
-/

noncomputable section

namespace InfoGeometry.Canonical.ConnesAmplificationCocycle

open Complex
open InfoGeometry.Modular.ConnesCocycle
open InfoGeometry.OperatorAlgebra.OperatorThermodynamics
open InfoGeometry.OperatorAlgebra.ConstructiveConnesCocycle

section GenericBanachStar

variable {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [CompleteSpace A]
  [StarRing A] [ContinuousStar A] [StarModule ℂ A]

/-- One-parameter unitary exponential `exp((i * t) • H)` for a self-adjoint generator `H`. -/
def unitaryExp (H : A) (t : ℝ) : A :=
  NormedSpace.exp ((Complex.I * (t : ℂ)) • H)

omit [CompleteSpace A] [StarRing A] [ContinuousStar A] [StarModule ℂ A] in
@[simp]
theorem unitaryExp_zero (H : A) : unitaryExp H 0 = 1 := by
  simp [unitaryExp]

omit [StarRing A] [ContinuousStar A] [StarModule ℂ A] in
theorem unitaryExp_add (H : A) (s t : ℝ) :
    unitaryExp H (s + t) = unitaryExp H s * unitaryExp H t := by
  let _ : NormedAlgebra ℚ A := NormedAlgebra.restrictScalars ℚ ℂ A
  unfold unitaryExp
  have hcomm : Commute ((Complex.I * (s : ℂ)) • H) ((Complex.I * (t : ℂ)) • H) :=
    ((Commute.refl H).smul_left _).smul_right _
  have hsmul :
      (Complex.I * ((s + t : ℝ) : ℂ)) • H =
        (Complex.I * (s : ℂ)) • H + (Complex.I * (t : ℂ)) • H := by
    rw [← add_smul]
    congr 1
    push_cast
    ring
  rw [hsmul]
  exact NormedSpace.exp_add_of_commute hcomm

omit [StarRing A] [ContinuousStar A] [StarModule ℂ A] in
@[simp]
theorem unitaryExp_mul_neg (H : A) (t : ℝ) :
    unitaryExp H t * unitaryExp H (-t) = 1 := by
  rw [← unitaryExp_add, add_neg_cancel, unitaryExp_zero]

omit [StarRing A] [ContinuousStar A] [StarModule ℂ A] in
@[simp]
theorem unitaryExp_neg_mul (H : A) (t : ℝ) :
    unitaryExp H (-t) * unitaryExp H t = 1 := by
  rw [← unitaryExp_add, neg_add_cancel, unitaryExp_zero]

omit [CompleteSpace A] in
theorem star_unitaryExp (H : A) (hH : star H = H) (t : ℝ) :
    star (unitaryExp H t) = unitaryExp H (-t) := by
  unfold unitaryExp
  rw [NormedSpace.star_exp, star_smul, hH]
  congr 1
  simp [Complex.conj_I, mul_comm]

/-- Inner modular `*-automorphism` `σ_t(x) = U(t) x U(-t)` generated by `H = H⋆`. -/
def innerModularStarAlgHom (H : A) (hH : star H = H) (t : ℝ) : A →⋆ₐ[ℂ] A where
  toFun x := unitaryExp H t * x * unitaryExp H (-t)
  map_one' := by simp
  map_mul' x y := by
    simp only [mul_assoc]
    rw [← mul_assoc (unitaryExp H (-t)) (unitaryExp H t), unitaryExp_neg_mul, one_mul]
  map_zero' := by simp
  map_add' x y := by simp [mul_add, add_mul]
  commutes' c := by
    simp only [Algebra.algebraMap_eq_smul_one, mul_smul_comm, smul_mul_assoc, mul_one]
    rw [unitaryExp_mul_neg]
  map_star' x := by
    simp [star_mul, star_unitaryExp H hH, mul_assoc]

@[simp]
theorem innerModularStarAlgHom_apply (H : A) (hH : star H = H) (t : ℝ) (x : A) :
    innerModularStarAlgHom H hH t x = unitaryExp H t * x * unitaryExp H (-t) := rfl

/-- `ModularFlow ℂ A` generated by a self-adjoint element `H`. -/
def innerModularFlow (H : A) (hH : star H = H) : ModularFlow ℂ A where
  toFun := innerModularStarAlgHom H hH
  map_zero := by
    ext x
    simp
  map_add s t x := by
    simp only [innerModularStarAlgHom_apply, unitaryExp_add]
    have hneg : -(s + t) = -t + -s := by ring
    rw [hneg, unitaryExp_add]
    simp [mul_assoc]

/-- `OperatorFlow A` generated by a self-adjoint element `H`. -/
def innerOperatorFlow (H : A) (hH : star H = H) : OperatorFlow A where
  flow t :=
    { toFun := innerModularStarAlgHom H hH t
      invFun := innerModularStarAlgHom H hH (-t)
      left_inv := fun x => by
        simp only [innerModularStarAlgHom_apply, mul_assoc, neg_neg]
        rw [← mul_assoc (unitaryExp H (-t)) (unitaryExp H t), unitaryExp_neg_mul, one_mul, mul_one]
      right_inv := fun x => by
        simp only [innerModularStarAlgHom_apply, mul_assoc, neg_neg]
        rw [← mul_assoc (unitaryExp H t) (unitaryExp H (-t)), unitaryExp_mul_neg, one_mul, mul_one]
      map_mul' := (innerModularStarAlgHom H hH t).map_mul' }
  flow_zero x := by simp [innerModularStarAlgHom_apply]
  flow_add s t x := by
    have hneg : -(s + t) = -t + -s := by ring
    simp [innerModularStarAlgHom_apply, unitaryExp_add, hneg, mul_assoc]

/-- Constructive Connes Radon–Nikodym cocycle element `u_t = (Dψ : Dφ)_t = U_ψ(t) U_φ(-t)`. -/
def connesCocycleElem (H_psi H_phi : A) (t : ℝ) : A :=
  unitaryExp H_psi t * unitaryExp H_phi (-t)

omit [CompleteSpace A] [StarRing A] [ContinuousStar A] [StarModule ℂ A] in
@[simp]
theorem connesCocycleElem_zero (H_psi H_phi : A) :
    connesCocycleElem H_psi H_phi 0 = 1 := by
  simp [connesCocycleElem]

theorem connesCocycleElem_unitary_left (H_psi H_phi : A)
    (hψ : star H_psi = H_psi) (hφ : star H_phi = H_phi) (t : ℝ) :
    connesCocycleElem H_psi H_phi t * star (connesCocycleElem H_psi H_phi t) = 1 := by
  unfold connesCocycleElem
  rw [star_mul, star_unitaryExp H_psi hψ, star_unitaryExp H_phi hφ, neg_neg]
  calc unitaryExp H_psi t * unitaryExp H_phi (-t) * (unitaryExp H_phi t * unitaryExp H_psi (-t))
      = unitaryExp H_psi t * (unitaryExp H_phi (-t) * unitaryExp H_phi t) * unitaryExp H_psi (-t) := by
          simp only [mul_assoc]
    _ = 1 := by rw [unitaryExp_neg_mul, mul_one, unitaryExp_mul_neg]

theorem connesCocycleElem_unitary_right (H_psi H_phi : A)
    (hψ : star H_psi = H_psi) (hφ : star H_phi = H_phi) (t : ℝ) :
    star (connesCocycleElem H_psi H_phi t) * connesCocycleElem H_psi H_phi t = 1 := by
  unfold connesCocycleElem
  rw [star_mul, star_unitaryExp H_psi hψ, star_unitaryExp H_phi hφ, neg_neg]
  calc unitaryExp H_phi t * unitaryExp H_psi (-t) * (unitaryExp H_psi t * unitaryExp H_phi (-t))
      = unitaryExp H_phi t * (unitaryExp H_psi (-t) * unitaryExp H_psi t) * unitaryExp H_phi (-t) := by
          simp only [mul_assoc]
    _ = 1 := by rw [unitaryExp_neg_mul, mul_one, unitaryExp_mul_neg]

/-- Multiplicative Connes 1-cocycle law `u(s+t) = u(s) * σ_s^φ(u(t))`. -/
theorem connesCocycleElem_add (H_psi H_phi : A) (hφ : star H_phi = H_phi) (s t : ℝ) :
    connesCocycleElem H_psi H_phi (s + t) =
      connesCocycleElem H_psi H_phi s *
        innerModularFlow H_phi hφ s (connesCocycleElem H_psi H_phi t) := by
  unfold connesCocycleElem
  change unitaryExp H_psi (s + t) * unitaryExp H_phi (-(s + t)) =
    unitaryExp H_psi s * unitaryExp H_phi (-s) *
      (unitaryExp H_phi s * (unitaryExp H_psi t * unitaryExp H_phi (-t)) * unitaryExp H_phi (-s))
  have hneg : -(s + t) = -t + -s := by ring
  rw [unitaryExp_add H_psi s t, hneg, unitaryExp_add H_phi (-t) (-s)]
  calc unitaryExp H_psi s * unitaryExp H_psi t * (unitaryExp H_phi (-t) * unitaryExp H_phi (-s))
      = unitaryExp H_psi s * 1 * (unitaryExp H_psi t * unitaryExp H_phi (-t)) * unitaryExp H_phi (-s) := by
          simp only [mul_assoc, mul_one]
    _ = unitaryExp H_psi s * (unitaryExp H_phi (-s) * unitaryExp H_phi s) *
          (unitaryExp H_psi t * unitaryExp H_phi (-t)) * unitaryExp H_phi (-s) := by
          rw [unitaryExp_neg_mul]
    _ = unitaryExp H_psi s * unitaryExp H_phi (-s) *
          (unitaryExp H_phi s * (unitaryExp H_psi t * unitaryExp H_phi (-t)) * unitaryExp H_phi (-s)) := by
          simp only [mul_assoc]

/-- Intertwining identity `σ_t^ψ(x) = u_t * σ_t^φ(x) * u_t*`. -/
theorem connesCocycleElem_intertwines (H_psi H_phi : A)
    (hψ : star H_psi = H_psi) (hφ : star H_phi = H_phi) (t : ℝ) (x : A) :
    innerModularFlow H_psi hψ t x =
      connesCocycleElem H_psi H_phi t * innerModularFlow H_phi hφ t x *
        star (connesCocycleElem H_psi H_phi t) := by
  unfold connesCocycleElem
  change unitaryExp H_psi t * x * unitaryExp H_psi (-t) =
    unitaryExp H_psi t * unitaryExp H_phi (-t) *
      (unitaryExp H_phi t * x * unitaryExp H_phi (-t)) *
      star (unitaryExp H_psi t * unitaryExp H_phi (-t))
  rw [star_mul, star_unitaryExp H_psi hψ, star_unitaryExp H_phi hφ, neg_neg]
  calc unitaryExp H_psi t * x * unitaryExp H_psi (-t)
      = unitaryExp H_psi t * (1 * x * 1) * unitaryExp H_psi (-t) := by simp
    _ = unitaryExp H_psi t * ((unitaryExp H_phi (-t) * unitaryExp H_phi t) * x *
          (unitaryExp H_phi (-t) * unitaryExp H_phi t)) * unitaryExp H_psi (-t) := by
          rw [unitaryExp_neg_mul]
    _ = unitaryExp H_psi t * unitaryExp H_phi (-t) *
          (unitaryExp H_phi t * x * unitaryExp H_phi (-t)) *
          (unitaryExp H_phi t * unitaryExp H_psi (-t)) := by
          simp only [mul_assoc]

omit [StarRing A] [ContinuousStar A] [StarModule ℂ A] in
/-- Exact Connes Radon–Nikodym chain rule `(Dχ : Dφ)_t = (Dχ : Dψ)_t * (Dψ : Dφ)_t`. -/
theorem connesCocycleElem_chain_rule (H_chi H_psi H_phi : A) (t : ℝ) :
    connesCocycleElem H_chi H_phi t =
      connesCocycleElem H_chi H_psi t * connesCocycleElem H_psi H_phi t := by
  unfold connesCocycleElem
  calc unitaryExp H_chi t * unitaryExp H_phi (-t)
      = unitaryExp H_chi t * 1 * unitaryExp H_phi (-t) := by simp
    _ = unitaryExp H_chi t * (unitaryExp H_psi (-t) * unitaryExp H_psi t) * unitaryExp H_phi (-t) := by
          rw [unitaryExp_neg_mul]
    _ = (unitaryExp H_chi t * unitaryExp H_psi (-t)) * (unitaryExp H_psi t * unitaryExp H_phi (-t)) := by
          simp only [mul_assoc]

/-- Constructive inhabitant of `InfoGeometry.Modular.ConnesCocycle.ConnesOneCocycle`. -/
def connesOneCocycleOfGenerators (H_psi H_phi : A)
    (hψ : star H_psi = H_psi) (hφ : star H_phi = H_phi) :
    ConnesOneCocycle (innerModularFlow H_phi hφ) where
  u := connesCocycleElem H_psi H_phi
  cocycle_id := connesCocycleElem_add H_psi H_phi hφ
  cocycle_zero := connesCocycleElem_zero H_psi H_phi
  unitary_left := connesCocycleElem_unitary_left H_psi H_phi hψ hφ
  unitary_right := connesCocycleElem_unitary_right H_psi H_phi hψ hφ

/-- The cocycle-perturbed modular flow equals the target flow `innerModularFlow H_psi hψ`. -/
theorem perturbedFlow_eq_innerModularFlow (H_psi H_phi : A)
    (hψ : star H_psi = H_psi) (hφ : star H_phi = H_phi) (t : ℝ) (x : A) :
    perturbedFlow (connesOneCocycleOfGenerators H_psi H_phi hψ hφ) t x =
      innerModularFlow H_psi hψ t x :=
  (connesCocycleElem_intertwines H_psi H_phi hψ hφ t x).symm

/-- Constructive inhabitant of `ConstructiveConnesCocycle.ConnesCocycleData` together with both
    cocycle and intertwining proofs. -/
def constructiveConnesCocycleOfGenerators (H_psi H_phi : A)
    (hψ : star H_psi = H_psi) (hφ : star H_phi = H_phi) :
    ConnesCocycleData A (innerOperatorFlow H_psi hψ) (innerOperatorFlow H_phi hφ) where
  u := connesCocycleElem H_psi H_phi

theorem constructiveConnesCocycleOfGenerators_isCocycle (H_psi H_phi : A)
    (hψ : star H_psi = H_psi) (hφ : star H_phi = H_phi) :
    IsConnesCocycle
      (constructiveConnesCocycleOfGenerators H_psi H_phi hψ hφ) := by
  intro s t
  exact connesCocycleElem_add H_psi H_phi hφ s t

theorem constructiveConnesCocycleOfGenerators_intertwines (H_psi H_phi : A)
    (hψ : star H_psi = H_psi) (hφ : star H_phi = H_phi) :
    Intertwines (constructiveConnesCocycleOfGenerators H_psi H_phi hψ hφ) := by
  intro t x
  dsimp [constructiveConnesCocycleOfGenerators, innerOperatorFlow, innerModularStarAlgHom]
  unfold connesCocycleElem
  calc unitaryExp H_psi t * x * unitaryExp H_psi (-t) *
        (unitaryExp H_psi t * unitaryExp H_phi (-t))
      = unitaryExp H_psi t * x * (unitaryExp H_psi (-t) * unitaryExp H_psi t) *
          unitaryExp H_phi (-t) := by simp only [mul_assoc]
    _ = unitaryExp H_psi t * x * unitaryExp H_phi (-t) := by
          rw [unitaryExp_neg_mul, mul_one]
    _ = unitaryExp H_psi t * 1 * x * unitaryExp H_phi (-t) := by simp
    _ = unitaryExp H_psi t * (unitaryExp H_phi (-t) * unitaryExp H_phi t) * x *
          unitaryExp H_phi (-t) := by
          rw [unitaryExp_neg_mul]
    _ = (unitaryExp H_psi t * unitaryExp H_phi (-t)) *
          (unitaryExp H_phi t * x * unitaryExp H_phi (-t)) := by
          simp only [mul_assoc]

end GenericBanachStar

section MatrixTwoByTwoAmplification

open scoped Matrix.Norms.L2Operator

variable {n : ℕ}

/-- Block-diagonal matrix embedding `M_n(ℂ) × M_n(ℂ) →+* M_{n ⊕ n}(ℂ)` for Connes' 2×2 amplification. -/
def blockDiagRingHom (n : ℕ) :
    (Matrix (Fin n) (Fin n) ℂ × Matrix (Fin n) (Fin n) ℂ) →+*
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℂ where
  toFun p := Matrix.fromBlocks p.1 0 0 p.2
  map_one' := by simp [Matrix.fromBlocks_one]
  map_mul' p q := by
    simp [Matrix.fromBlocks_multiply]
  map_zero' := by simp [Matrix.fromBlocks_zero]
  map_add' p q := by
    ext (i | i) (j | j) <;> simp

/-- `blockDiagRingHom n` is continuous (linear on a finite-dimensional complex normed space). -/
theorem continuous_blockDiagRingHom (n : ℕ) :
    Continuous (blockDiagRingHom n) := by
  let L : (Matrix (Fin n) (Fin n) ℂ × Matrix (Fin n) (Fin n) ℂ) →ₗ[ℂ]
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℂ :=
    { toFun := blockDiagRingHom n
      map_add' := (blockDiagRingHom n).map_add
      map_smul' := fun c p => by
        ext (i | i) (j | j) <;> simp [blockDiagRingHom] }
  exact L.continuous_of_finiteDimensional

/-- Block-diagonal exponential splits across blocks: `exp(diag(X, Y)) = diag(exp X, exp Y)`. -/
theorem exp_fromBlocks_diag (X Y : Matrix (Fin n) (Fin n) ℂ) :
    NormedSpace.exp (Matrix.fromBlocks X 0 0 Y) =
      Matrix.fromBlocks (NormedSpace.exp X) 0 0 (NormedSpace.exp Y) := by
  let _ : NormedAlgebra ℚ (Matrix (Fin n) (Fin n) ℂ) :=
    NormedAlgebra.restrictScalars ℚ ℂ (Matrix (Fin n) (Fin n) ℂ)
  let _ : NormedAlgebra ℚ (Matrix (Fin n) (Fin n) ℂ × Matrix (Fin n) (Fin n) ℂ) :=
    NormedAlgebra.restrictScalars ℚ ℂ (Matrix (Fin n) (Fin n) ℂ × Matrix (Fin n) (Fin n) ℂ)
  have hmap := NormedSpace.map_exp (blockDiagRingHom n) (continuous_blockDiagRingHom n) (X, Y)
  have hprod : NormedSpace.exp (X, Y) = (NormedSpace.exp X, NormedSpace.exp Y) :=
    Prod.ext (Prod.fst_exp (X, Y)) (Prod.snd_exp (X, Y))
  rw [hprod] at hmap
  exact hmap.symm

/-- Balanced generator `H_θ = diag(H_φ, H_ψ)` on `M₂(M_n(ℂ))`. -/
def balancedBlockHam (H_phi H_psi : Matrix (Fin n) (Fin n) ℂ) :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℂ :=
  Matrix.fromBlocks H_phi 0 0 H_psi

theorem star_balancedBlockHam {H_phi H_psi : Matrix (Fin n) (Fin n) ℂ}
    (hφ : star H_phi = H_phi) (hψ : star H_psi = H_psi) :
    star (balancedBlockHam H_phi H_psi) = balancedBlockHam H_phi H_psi := by
  unfold balancedBlockHam
  rw [Matrix.star_eq_conjTranspose, Matrix.fromBlocks_conjTranspose]
  simp [← Matrix.star_eq_conjTranspose, hφ, hψ]

/-- Lower-left matrix unit `e₂₁ = ⟦0, 0; 1, 0⟧` in `M₂(M_n(ℂ))`. -/
def e21Block (n : ℕ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℂ :=
  Matrix.fromBlocks 0 0 1 0

/-- **Connes 2×2 Amplification Extraction Theorem**:
    Applying the balanced modular flow `σ_t^θ` to `e₂₁` yields `e₂₁` multiplied in the
    `(2,1)` block by the exact noncommutative Connes cocycle `u_t = (Dψ : Dφ)_t`. -/
theorem connes_amplification_e21_extract
    {H_phi H_psi : Matrix (Fin n) (Fin n) ℂ}
    (hφ : star H_phi = H_phi) (hψ : star H_psi = H_psi) (t : ℝ) :
    innerModularFlow (balancedBlockHam H_phi H_psi) (star_balancedBlockHam hφ hψ) t (e21Block n) =
      Matrix.fromBlocks 0 0 (connesCocycleElem H_psi H_phi t) 0 := by
  change unitaryExp (balancedBlockHam H_phi H_psi) t * e21Block n *
      unitaryExp (balancedBlockHam H_phi H_psi) (-t) =
    Matrix.fromBlocks 0 0 (connesCocycleElem H_psi H_phi t) 0
  have hexp_pos :
      unitaryExp (balancedBlockHam H_phi H_psi) t =
        Matrix.fromBlocks (unitaryExp H_phi t) 0 0 (unitaryExp H_psi t) := by
    unfold unitaryExp balancedBlockHam
    have hsmul :
        (Complex.I * (t : ℂ)) • Matrix.fromBlocks H_phi 0 0 H_psi =
          Matrix.fromBlocks ((Complex.I * (t : ℂ)) • H_phi) 0 0
            ((Complex.I * (t : ℂ)) • H_psi) := by
      ext (i | i) (j | j) <;> simp
    rw [hsmul, exp_fromBlocks_diag]
  have hexp_neg :
      unitaryExp (balancedBlockHam H_phi H_psi) (-t) =
        Matrix.fromBlocks (unitaryExp H_phi (-t)) 0 0 (unitaryExp H_psi (-t)) := by
    unfold unitaryExp balancedBlockHam
    have hsmul :
        (Complex.I * ((-t : ℝ) : ℂ)) • Matrix.fromBlocks H_phi 0 0 H_psi =
          Matrix.fromBlocks ((Complex.I * ((-t : ℝ) : ℂ)) • H_phi) 0 0
            ((Complex.I * ((-t : ℝ) : ℂ)) • H_psi) := by
      ext (i | i) (j | j) <;> simp
    rw [hsmul, exp_fromBlocks_diag]
  rw [hexp_pos, hexp_neg]
  unfold e21Block connesCocycleElem
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp

end MatrixTwoByTwoAmplification

section NoncommutingWitness

open scoped Matrix.Norms.L2Operator

/-- Noncommuting self-adjoint generator `H_φ = σ_z` on `M₂(ℂ)`. -/
def witnessHPhi : Matrix (Fin 2) (Fin 2) ℂ :=
  !![1, 0; 0, -1]

/-- Noncommuting self-adjoint generator `H_ψ = σ_x` on `M₂(ℂ)`. -/
def witnessHPsi : Matrix (Fin 2) (Fin 2) ℂ :=
  !![0, 1; 1, 0]

theorem star_witnessHPhi : star witnessHPhi = witnessHPhi := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [witnessHPhi, Matrix.star_apply]

theorem star_witnessHPsi : star witnessHPsi = witnessHPsi := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [witnessHPsi, Matrix.star_apply]

/-- Explicit noncommutativity witness: `H_φ * H_ψ ≠ H_ψ * H_φ`. -/
theorem witness_generators_noncomm :
    witnessHPhi * witnessHPsi ≠ witnessHPsi * witnessHPhi := by
  intro h
  have h01 := congrArg (fun M : Matrix (Fin 2) (Fin 2) ℂ => M 0 1) h
  simp [witnessHPhi, witnessHPsi, Matrix.mul_apply, Fin.sum_univ_two] at h01
  norm_num at h01

/-- Genuine noncommuting Connes 1-cocycle instance on `M₂(ℂ)`. -/
def witnessConnesOneCocycle :
    ConnesOneCocycle (innerModularFlow witnessHPhi star_witnessHPhi) :=
  connesOneCocycleOfGenerators witnessHPsi witnessHPhi star_witnessHPsi star_witnessHPhi

end NoncommutingWitness

end InfoGeometry.Canonical.ConnesAmplificationCocycle
