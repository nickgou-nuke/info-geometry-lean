import InfoGeometry.OperatorAlgebra.PeirceSpine.DefectTower
import InfoGeometry.OperatorAlgebra.PeirceSpine.StarGrading
import InfoGeometry.Algebra.PeirceRegularityIdentities
import Mathlib.Algebra.Ring.Subring.Basic

/-!
# The on-shell Peirce kernel and the generated noncommutative ring

`genV * genV = genV` makes the two corner cycles and `1 - genV`
mutually orthogonal idempotents. It does not assert `genV = 1`.
The metric commutes with the subring generated by the cut and the two
arrows; no ambient centrality is assumed. In a star realization this
actual generated subring is star closed.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine

open InfoGeometry.Core.IdempotentGraphGrassmannian

variable {B : Type*} [Ring B]

/-- The unital ring generated by the cut and its two ordered arrows. -/
def generatedPeirceRing (P A C : B) : Subring B :=
  Subring.closure {P, conePlus P A, coneMinus P C}

/-- The seed cut belongs to its generated ring. -/
theorem cut_mem_generatedPeirceRing (P A C : B) :
    P ∈ generatedPeirceRing P A C :=
  Subring.subset_closure (by simp)

/-- The upper arrow belongs to the generated ring. -/
theorem conePlus_mem_generatedPeirceRing (P A C : B) :
    conePlus P A ∈ generatedPeirceRing P A C :=
  Subring.subset_closure (by simp)

/-- The lower arrow belongs to the generated ring. -/
theorem coneMinus_mem_generatedPeirceRing (P A C : B) :
    coneMinus P C ∈ generatedPeirceRing P A C :=
  Subring.subset_closure (by simp)

/-- The metric is an actual element of the generated ring. -/
theorem genV_mem_generatedPeirceRing (P A C : B) :
    genV P A C ∈ generatedPeirceRing P A C := by
  exact (generatedPeirceRing P A C).add_mem
    ((generatedPeirceRing P A C).mul_mem
      (conePlus_mem_generatedPeirceRing P A C)
      (coneMinus_mem_generatedPeirceRing P A C))
    ((generatedPeirceRing P A C).mul_mem
      (coneMinus_mem_generatedPeirceRing P A C)
      (conePlus_mem_generatedPeirceRing P A C))

/-- The skew generator belongs to the same generated ring. -/
theorem genJ_mem_generatedPeirceRing (P A C : B) :
    genJ P A C ∈ generatedPeirceRing P A C :=
  (generatedPeirceRing P A C).sub_mem
    (conePlus_mem_generatedPeirceRing P A C)
    (coneMinus_mem_generatedPeirceRing P A C)

variable {P : B} (hP : P * P = P)

/-- Centrality is proved only inside the generated ring. -/
theorem genV_commute_of_mem_generated (hP : P * P = P) (A C : B) {X : B}
    (hX : X ∈ generatedPeirceRing P A C) : Commute (genV P A C) X := by
  have hc : generatedPeirceRing P A C ≤ Subring.centralizer {genV P A C} := by
    apply Subring.closure_le.mpr
    intro Y hY
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hY
    rcases hY with rfl | rfl | rfl
    all_goals
      apply Subring.mem_centralizer_iff.mpr
      intro Z hZ
      obtain rfl := Set.mem_singleton_iff.mp hZ
      peirce_nf hP
  exact Subring.mem_centralizer_iff.mp (hc hX) _ (by simp)

/-- Idempotence of the total metric is equivalent to idempotence of both
ordered corner cycles, without a star or characteristic restriction. -/
theorem genV_idempotent_iff_qgt_idempotent (hP : P * P = P) (A C : B) :
    genV P A C * genV P A C = genV P A C ↔
      qgtPlus P A C * qgtPlus P A C = qgtPlus P A C ∧
      qgtMinus P A C * qgtMinus P A C = qgtMinus P A C := by
  constructor
  · intro hV
    have hd : idempotencyDefect (genV P A C) = 0 := sub_eq_zero.mpr hV
    have hp := genV_defect_iterates_left_projection hP A C 1
    have hm := genV_defect_iterates_complement_left hP A C 1
    simp only [Function.iterate_one] at hp hm
    rw [hd, mul_zero] at hp hm
    exact ⟨sub_eq_zero.mp hp.symm, sub_eq_zero.mp hm.symm⟩
  · rintro ⟨hp, hm⟩
    have hd := genV_defect_cycle_split hP A C
    simp only [idempotencyDefect, hp, hm, sub_self, add_zero] at hd
    exact sub_eq_zero.mp hd

/-- The residual kernel element is idempotent on the metric's idempotent locus. -/
theorem onShell_kernel_idempotent (A C : B)
    (hV : genV P A C * genV P A C = genV P A C) :
    (1 - genV P A C) * (1 - genV P A C) = 1 - genV P A C := by
  noncomm_ring [hV]

/-- The singular metric annihilates its residual kernel in both orders. -/
theorem onShell_genV_kernel_products (A C : B)
    (hV : genV P A C * genV P A C = genV P A C) :
    genV P A C * (1 - genV P A C) = 0 ∧
    (1 - genV P A C) * genV P A C = 0 := by
  constructor <;> noncomm_ring [hV]

/-- Adding the identity fixes the residual kernel rather than erasing it. -/
theorem onShell_shift_fixes_kernel (A C : B)
    (hV : genV P A C * genV P A C = genV P A C) :
    (1 + genV P A C) * (1 - genV P A C) = 1 - genV P A C := by
  noncomm_ring [hV]

/-- Every transition in the shifted multiplicative system retains the same
kernel representative. This statement does not require a faithful star. -/
theorem onShell_shift_pow_fixes_kernel (A C : B)
    (hV : genV P A C * genV P A C = genV P A C) (n : ℕ) :
    (1 + genV P A C) ^ n * (1 - genV P A C) = 1 - genV P A C := by
  induction n with
  | zero => simp
  | succ n hn =>
      rw [pow_succ', mul_assoc, hn, onShell_shift_fixes_kernel A C hV]

/-- The three idempotents sum to the ambient identity. -/
theorem onShell_partition_sum (P A C : B) :
    qgtPlus P A C + (1 - genV P A C) + qgtMinus P A C = 1 := by
  simp only [genV, anticomm, qgtPlus, qgtMinus]
  abel

/-- The kernel annihilates both ordered cycles in both orders. -/
theorem onShell_kernel_cycle_products (hP : P * P = P) (A C : B)
    (hV : genV P A C * genV P A C = genV P A C) :
    qgtPlus P A C * (1 - genV P A C) = 0 ∧
    (1 - genV P A C) * qgtPlus P A C = 0 ∧
    qgtMinus P A C * (1 - genV P A C) = 0 ∧
    (1 - genV P A C) * qgtMinus P A C = 0 := by
  obtain ⟨hp, hm⟩ := (genV_idempotent_iff_qgt_idempotent hP A C).mp hV
  obtain ⟨hpm, hmp⟩ := qgt_cycles_orthogonal hP A C
  change qgtPlus P A C * (1 - (qgtPlus P A C + qgtMinus P A C)) = 0 ∧
    (1 - (qgtPlus P A C + qgtMinus P A C)) * qgtPlus P A C = 0 ∧
    qgtMinus P A C * (1 - (qgtPlus P A C + qgtMinus P A C)) = 0 ∧
    (1 - (qgtPlus P A C + qgtMinus P A C)) * qgtMinus P A C = 0
  refine ⟨?_, ?_, ?_, ?_⟩ <;> noncomm_ring [hp, hm, hpm, hmp]

/-- The signed difference squares to the active metric on shell. -/
theorem onShell_genSig_square (hP : P * P = P) (A C : B)
    (hV : genV P A C * genV P A C = genV P A C) :
    genSig P A C * genSig P A C = genV P A C := by
  calc
    genSig P A C * genSig P A C = genV P A C * genV P A C := by
      peirce_nf hP
    _ = genV P A C := hV

/-- The signed difference of the two corner cycles is tripotent on shell. -/
theorem onShell_genSig_cube (hP : P * P = P) (A C : B)
    (hV : genV P A C * genV P A C = genV P A C) :
    genSig P A C * genSig P A C * genSig P A C = genSig P A C := by
  obtain ⟨hp, hm⟩ := (genV_idempotent_iff_qgt_idempotent hP A C).mp hV
  obtain ⟨hpm, hmp⟩ := qgt_cycles_orthogonal hP A C
  exact InfoGeometry.Algebra.PeirceRegularityIdentities.orthogonal_difference_cube
    hp hm hpm hmp

section Star

variable [StarRing B]

/-- Star stability of the ordinary generated subring follows from star
reversal of the two Peirce arrows. -/
theorem star_mem_generatedPeirceRing (hPs : star P = P) (A : B) {X : B}
    (hX : X ∈ generatedPeirceRing P A (star A)) :
    star X ∈ generatedPeirceRing P A (star A) := by
  induction hX using Subring.closure_induction with
  | mem Y hY =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hY
      rcases hY with hY | hY | hY
      · rw [hY, hPs]
        exact cut_mem_generatedPeirceRing P A (star A)
      · rw [hY, star_conePlus hPs]
        exact coneMinus_mem_generatedPeirceRing P A (star A)
      · rw [hY, star_coneMinus hPs, star_star]
        exact conePlus_mem_generatedPeirceRing P A (star A)
  | zero => simpa only [star_zero] using (generatedPeirceRing P A (star A)).zero_mem
  | one => simpa only [star_one] using (generatedPeirceRing P A (star A)).one_mem
  | add X Y _ _ hX hY =>
      simpa only [star_add] using (generatedPeirceRing P A (star A)).add_mem hX hY
  | neg X _ hX =>
      simpa only [star_neg] using (generatedPeirceRing P A (star A)).neg_mem hX
  | mul X Y _ _ hX hY =>
      simpa only [star_mul] using (generatedPeirceRing P A (star A)).mul_mem hY hX

/-- The inherited star is constructed on the generated ring, rather than
assuming a separate star-compatible carrier. -/
instance generatedPeirceRingStarRing (P A : B) [Fact (star P = P)] :
    StarRing (generatedPeirceRing P A (star A)) where
  star X := ⟨star (X : B), star_mem_generatedPeirceRing (Fact.out : star P = P) A X.property⟩
  star_involutive X := Subtype.ext (star_star (X : B))
  star_mul X Y := Subtype.ext (star_mul (X : B) (Y : B))
  star_add X Y := Subtype.ext (star_add (X : B) (Y : B))

/-- The constructed star is literally the ambient star on representatives. -/
@[simp] theorem coe_star_generatedPeirceRing (P A : B) [Fact (star P = P)]
    (X : generatedPeirceRing P A (star A)) :
    ((star X : generatedPeirceRing P A (star A)) : B) = star (X : B) := rfl

end Star

end InfoGeometry.OperatorAlgebra.PeirceSpine
