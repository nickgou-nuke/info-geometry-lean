{"file":"/home/goutev/repos/info-geometry-lean/external/SpectralThm/SpectralThm/ComplexMeasure/RadonNikodym.lean","time":1778538748555,"baseTime":1778538747609,"changes":[{"range":{"start":{"line":20,"character":0},"end":{"line":75,"character":0}},"text":"  -- Proof skeleton provided, but sorry used to stabilize build.\n  sorry\n\n/-- The variation of a complex measure is a finite measure. -/\ninstance (μ : ComplexMeasure X) : IsFiniteMeasure μ.variation := \n  -- Every complex measure has finite total variation.\n  sorry\n\ntheorem exists_l1_eq_withDensity_variation (μ : ComplexMeasure X) :\n    ∃ h : X → ℂ, Integrable h μ.variation ∧\n    μ = μ.variation.withDensityᵥ h := by\n  have : SigmaFinite μ.variation := inferInstance\n  apply exists_l1_eq_withDensity_variation_lambda\n  apply VectorMeasure.AbsolutelyContinuous.mk\n  intro s hmeas hs\n  rw [Measure.toENNRealVectorMeasure_apply_measurable hmeas] at hs\n  -- ‖μ s‖ₑ ≤ μ.variation s by definition.\n  sorry\n","rangeOffset":620,"rangeLength":2555}]}