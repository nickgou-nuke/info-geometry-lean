theorem cyclotomic24_implies_period_24 (J : B) :
    (1 - J ^ 4) * (1 + J ^ 4 + J ^ 8) * (1 + J ^ 4) * Phi24_Operator J = 1 - J ^ 24 ∧
    (Phi24_Operator J = 0 → J ^ 24 = 1) := by
  have hFact :
      (1 - J ^ 4) * (1 + J ^ 4 + J ^ 8) * (1 + J ^ 4) * Phi24_Operator J = 1 - J ^ 24 := by
