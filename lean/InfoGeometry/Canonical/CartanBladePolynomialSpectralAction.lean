import Mathlib.Tactic
import Mathlib.LinearAlgebra.ExteriorAlgebra.Basic

import InfoGeometry.Canonical.KahlerAtiyahCartanForms
import InfoGeometry.Canonical.Cl11BipartitePolynomialSpectralAction

/-!
# Exterior-blade companion to the bipartite polynomial spectral action

This module adds a genuine exterior-algebra realization of the blade language
used alongside the finite matrix spectral-action decomposition.

The matrix theorem and the exterior theorem are kept distinct:

* matrix side:
    Tr(P(Delta_L tensor I + I tensor Delta_R));
* exterior side:
    c0 (B_L wedge B_R)
      + c1 (R_L wedge B_R + B_L wedge R_R)
      + c2 (R_L wedge R_L + 2 R_L wedge R_R + R_R wedge R_R).

No theorem here identifies matrix trace with a Berezin/top-degree projection.
Such an identification requires a separately specified spinor trace / symbol
map and normalization theorem.

No physical interpretation of the mixed 4-blade as mutual information,
entanglement energy, Einstein-Hilbert density, or Yang-Mills density is
asserted.
-/

noncomputable section

namespace InfoGeometry.Canonical.CartanBladePolynomialSpectralAction

open ExteriorAlgebra
open InfoGeometry.Canonical.KahlerAtiyahCartanForms

universe u

variable {V : Type u} [AddCommGroup V] [Module ℝ V]

abbrev Forms := ExteriorAlgebra ℝ V

/-- A decomposable exterior 2-blade generated by two vectors. -/
def simpleBlade2 (u v : V) : Forms :=
  ExteriorAlgebra.ι ℝ u * ExteriorAlgebra.ι ℝ v

/-- Every decomposable 2-blade wedges with itself to zero. -/
theorem simpleBlade2_sq_zero (u v : V) :
    simpleBlade2 u v * simpleBlade2 u v = 0 := by
  unfold simpleBlade2
  calc
    ExteriorAlgebra.ι ℝ u * ExteriorAlgebra.ι ℝ v *
        (ExteriorAlgebra.ι ℝ u * ExteriorAlgebra.ι ℝ v)
        =
      ExteriorAlgebra.ι ℝ u *
        (ExteriorAlgebra.ι ℝ v * ExteriorAlgebra.ι ℝ u) *
        ExteriorAlgebra.ι ℝ v := by
          simp [mul_assoc]
    _ =
      - ExteriorAlgebra.ι ℝ u *
        (ExteriorAlgebra.ι ℝ u * ExteriorAlgebra.ι ℝ v) *
        ExteriorAlgebra.ι ℝ v := by
          rw [ExteriorAlgebra.ι_mul_ι_swap]
          simp [mul_assoc]
    _ = 0 := by
      rw [← mul_assoc, ExteriorAlgebra.ι_sq_zero]
      simp

/-- Exterior product of two 2-blades, interpreted algebraically as a 4-blade. -/
def wedge4 (B C : Forms) : Forms :=
  B * C

/-- Package of longitudinal/transverse coframe and curvature 2-blades. -/
structure CartanBladeSystem where
  BL : Forms
  BR : Forms
  RL : Forms
  RR : Forms

namespace CartanBladeSystem

variable (G : CartanBladeSystem (V := V))

/-- Background volume 4-blade. -/
def volumeBlade : Forms :=
  wedge4 G.BL G.BR

/-- Linear Cartan 4-blade combination. -/
def linearCurvatureBlade : Forms :=
  wedge4 G.RL G.BR + wedge4 G.BL G.RR

/-- Quadratic curvature 4-blade combination. -/
def quadraticCurvatureBlade : Forms :=
  wedge4 G.RL G.RL +
    (2 : ℝ) • wedge4 G.RL G.RR +
    wedge4 G.RR G.RR

/-- Polynomial exterior-blade action. -/
def bladePolynomialAction
    (c0 c1 c2 : ℝ) : Forms :=
  c0 • G.volumeBlade +
    c1 • G.linearCurvatureBlade +
    c2 • G.quadraticCurvatureBlade

/-- Pure algebraic expansion of the quadratic blade sector. -/
theorem quadraticCurvatureBlade_eq_square
    (hcomm : G.RR * G.RL = G.RL * G.RR) :
    G.quadraticCurvatureBlade =
      (G.RL + G.RR) * (G.RL + G.RR) := by
  unfold quadraticCurvatureBlade wedge4
  rw [add_mul, mul_add, hcomm]
  module

/-- If the left and right curvature 2-blades are individually decomposable,
their self-wedge terms vanish and only the mixed 4-blade remains. -/
theorem quadraticCurvatureBlade_of_self_wedge_zero
    (hL : G.RL * G.RL = 0)
    (hR : G.RR * G.RR = 0) :
    G.quadraticCurvatureBlade =
      (2 : ℝ) • wedge4 G.RL G.RR := by
  unfold quadraticCurvatureBlade
  rw [hL, hR]
  simp

/-- Isolation of the mixed exterior 4-blade. -/
theorem mixedBlade_term :
    G.quadraticCurvatureBlade -
      (wedge4 G.RL G.RL + wedge4 G.RR G.RR) =
      (2 : ℝ) • wedge4 G.RL G.RR := by
  unfold quadraticCurvatureBlade
  module

end CartanBladeSystem

/-! ## Explicit comparison interface to scalar trace readouts -/

/-- A scalar readout of exterior 4-blades.

This is deliberately an explicit hypothesis-bearing interface; it is not
silently identified with matrix trace or a Berezin integral. -/
structure BladeReadout where
  toLinear : Forms →ₗ[ℝ] ℝ

namespace BladeReadout

variable (rho : BladeReadout (V := V))

/-- The scalar polynomial generated from the three exterior blade sectors. -/
def scalarBladeAction
    (G : CartanBladeSystem (V := V))
    (c0 c1 c2 : ℝ) : ℝ :=
  rho.toLinear
    (G.bladePolynomialAction c0 c1 c2)

/-- Termwise scalar expansion of the exterior-blade polynomial action. -/
theorem scalarBladeAction_expand
    (G : CartanBladeSystem (V := V))
    (c0 c1 c2 : ℝ) :
    rho.scalarBladeAction G c0 c1 c2 =
      c0 * rho.toLinear G.volumeBlade +
      c1 * rho.toLinear G.linearCurvatureBlade +
      c2 * rho.toLinear G.quadraticCurvatureBlade := by
  unfold scalarBladeAction CartanBladeSystem.bladePolynomialAction
  simp
  ring

/-- Abstract interoperability theorem.

If a chosen exterior 4-blade readout reproduces the three scalar sectors of
the finite matrix theorem, then the blade action equals the native polynomial
spectral trace.  The comparison hypotheses are explicit rather than assumed.
-/
theorem equals_matrix_polynomial_action_of_sector_readout
    (G : CartanBladeSystem (V := V))
    (c0 c1 c2 : ℝ)
    (DeltaL : InfoGeometry.Canonical.Cl11BipartitePolynomialSpectralAction.StageOne)
    (DeltaR : InfoGeometry.Canonical.Cl11BipartitePolynomialSpectralAction.Atom)
    (h0 : rho.toLinear G.volumeBlade = 4)
    (h1 : rho.toLinear G.linearCurvatureBlade =
      2 * (Matrix.trace DeltaL + Matrix.trace DeltaR))
    (h2 : rho.toLinear G.quadraticCurvatureBlade =
      2 * (Matrix.trace (DeltaL * DeltaL) +
        Matrix.trace DeltaL * Matrix.trace DeltaR +
        Matrix.trace (DeltaR * DeltaR))) :
    rho.scalarBladeAction G c0 c1 c2 =
      InfoGeometry.Canonical.Cl11BipartitePolynomialSpectralAction.polynomialSpectralAction
        c0 c1 c2
        (InfoGeometry.Canonical.Cl11BipartitePolynomialSpectralAction.tensorSum
          DeltaL DeltaR) := by
  rw [scalarBladeAction_expand, h0, h1, h2]
  rw [InfoGeometry.Canonical.Cl11BipartitePolynomialSpectralAction.polynomialSpectralAction_tensorSum]
  ring

end BladeReadout

end InfoGeometry.Canonical.CartanBladePolynomialSpectralAction
