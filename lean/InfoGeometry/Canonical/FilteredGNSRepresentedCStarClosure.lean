import InfoGeometry.Canonical.FilteredGNSAlgebraicColimitRepresentation
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Canonical.FilteredGNSHilbertNontrivial
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# Represented C-star closure of a filtered GNS colimit

The algebraic filtered star-colimit acts on the global GNS Hilbert space by
bounded operators.  Taking the operator-norm topological closure of the range
produces a concrete C-star algebra.  This construction automatically removes
the kernel of the representation and completes the represented image; it
does not assert that the raw algebraic colimit already carries a C-star norm.
-/

noncomputable section

namespace CStarStateColimit.Native.FilteredGNSRepresentedCStarClosure

set_option synthInstance.maxHeartbeats 80000
set_option linter.unusedSectionVars false

open CStarStateColimit.Native
open CStarStateColimit.Native.FilteredGNSHilbertColimit
open CStarStateColimit.Native.FilteredGNSGlobalStageRepresentation
open CStarStateColimit.Native.FilteredStarAlgebraDirectLimit
open CStarStateColimit.Native.FilteredGNSAlgebraicColimitRepresentation
open CStarStateColimit.Native.FilteredGNSHilbertNontrivial

universe u

variable {I : Type u} [Preorder I] [Nonempty I] [IsDirectedOrder I]
variable [DecidableEq I]
variable (Stage : I → Type u)
variable [∀ i, CStarAlgebra (Stage i)]
variable [∀ i, PartialOrder (Stage i)]
variable [∀ i, StarOrderedRing (Stage i)]
variable (sys : ContinuousStarInductiveSystem Stage)
variable
  (ω :
    ContinuousStarInductiveSystem.CompatibleStateFamily
      Stage sys)
/-- Mathlib supplies all operator-algebra components separately; this local
bundle exposes their combined unital C-star structure. -/
local instance globalBoundedOperatorCStarAlgebra :
    CStarAlgebra
      (GNSHilbertColimit Stage sys ω →L[ℂ]
        GNSHilbertColimit Stage sys ω) where

/-- Operator-norm closed star subalgebra generated by the represented
algebraic filtered colimit. -/
def representedCStarClosure :
    StarSubalgebra ℂ
      (GNSHilbertColimit Stage sys ω →L[ℂ]
        GNSHilbertColimit Stage sys ω) :=
  (algebraicColimitGNSRepresentation
    Stage sys ω).range.topologicalClosure

/-- The represented closure inherits Mathlib's native concrete
`CStarAlgebra` structure. -/
instance representedCStarClosureCStarAlgebra :
    CStarAlgebra
      (representedCStarClosure Stage sys ω) :=
  StarSubalgebra.cstarAlgebra
    (representedCStarClosure Stage sys ω)
    (h_closed := by
      exact StarSubalgebra.isClosed_topologicalClosure _)

/-- The algebraic colimit representation with codomain restricted to its
concrete C-star closure. -/
def algebraicColimitToRepresentedClosure :
    AlgebraicStarDirectLimit Stage sys →⋆ₐ[ℂ]
      representedCStarClosure Stage sys ω :=
  (algebraicColimitGNSRepresentation
    Stage sys ω).codRestrict
    (representedCStarClosure Stage sys ω)
    (fun a =>
      StarSubalgebra.le_topologicalClosure _
        ⟨a, rfl⟩)

@[simp] theorem algebraicColimitToRepresentedClosure_coe
    (a : AlgebraicStarDirectLimit Stage sys) :
    (algebraicColimitToRepresentedClosure
        Stage sys ω a :
      GNSHilbertColimit Stage sys ω →L[ℂ]
        GNSHilbertColimit Stage sys ω) =
      algebraicColimitGNSRepresentation
        Stage sys ω a :=
  StarAlgHom.coe_codRestrict _ _ _ a

/-- Every finite-stage represented observable belongs to the represented
C-star closure. -/
theorem globalStageRepresentation_mem_representedCStarClosure
    (i : I) (a : Stage i) :
    globalStageRepresentationStarAlgHom
        Stage sys ω i a ∈
      representedCStarClosure Stage sys ω := by
  apply StarSubalgebra.le_topologicalClosure
  exact
    ⟨algebraicStarDirectLimitOf Stage sys i a,
      algebraicColimitGNSRepresentation_of
        Stage sys ω i a⟩

/-- The represented algebraic colimit is dense in its concrete C-star
closure by construction. -/
theorem algebraicColimitToRepresentedClosure_denseRange :
    DenseRange
      (algebraicColimitToRepresentedClosure
        Stage sys ω) := by
  let R :=
    (algebraicColimitGNSRepresentation
      Stage sys ω).range
  have hd :
      DenseRange
        (Set.inclusion
          (StarSubalgebra.le_topologicalClosure R)) := by
    simp [-SetLike.coe_sort_coe]
  apply Dense.mono _ hd
  intro y hy
  rcases hy with ⟨x, rfl⟩
  rcases x.property with ⟨a, ha⟩
  refine
    ⟨a, Subtype.ext ?_⟩
  exact ha

end CStarStateColimit.Native.FilteredGNSRepresentedCStarClosure
