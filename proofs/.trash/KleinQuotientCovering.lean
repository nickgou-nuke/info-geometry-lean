import proofs.KleinBottleOrbitQuotient
import Mathlib.Topology.Covering.Quotient

/-!
# Conditional local trivializations for the Klein quotient

Mathlib's quotient-covering API constructs a local trivialization from a
quotient map, an orbit description, and a disjoint neighborhood.  This owner
exposes that theorem for the concrete Klein glide; it intentionally does not
invent a global chart selection.
-/

noncomputable section
namespace KleinQuotientCovering

open KleinBrillouinBase KleinBottleOrbitQuotient

abbrev Deck := ZMod 2

/-- The concrete additive deck action generated by the torus glide. -/
def deckVAdd (g : Deck) (k : BrillouinTorus) : BrillouinTorus :=
  if g = 0 then k else torusGlide k

instance : AddAction Deck BrillouinTorus where
  vadd := deckVAdd
  zero_vadd := by intro k; simp [deckVAdd]
  add_vadd := by
    intro g h k
    fin_cases g <;> fin_cases h <;>
      simp [deckVAdd, torusGlide_involutive]

theorem deckVAdd_eq_orbit (k q : BrillouinTorus) :
    q ∈ AddAction.orbit Deck k ↔ q = k ∨ q = torusGlide k := by
  constructor
  · rintro ⟨g, rfl⟩
    fin_cases g <;> simp [deckVAdd]
  · rintro (rfl | rfl)
    · exact ⟨0, by simp [deckVAdd]
    · exact ⟨1, by simp [deckVAdd]

theorem quotientMap_eq_iff_orbit (k q : BrillouinTorus) :
    quotientMap k = quotientMap q ↔ k ∈ AddAction.orbit Deck q := by
  rw [quotientMap_eq_iff]
  simpa [deckVAdd_eq_orbit] using (deckVAdd_eq_orbit q k).symm

/-- Conditional local trivialization over the image of a disjoint open set. -/
noncomputable def localTrivializationOfDisjoint
    (U : Set BrillouinTorus) (hU : IsOpen U)
    (hdisj : ∀ g : Deck,
      ((g +ᵥ ·) '' U ∩ U).Nonempty → g = 0) :
    Trivialization Deck quotientMap :=
  Topology.IsQuotientMap.trivializationOfSMulDisjoint
    quotientMap_isQuotient quotientMap_eq_iff_orbit U hU hdisj

theorem localTrivialization_baseSet
    (U : Set BrillouinTorus) (hU : IsOpen U)
    (hdisj : ∀ g : Deck,
      ((g +ᵥ ·) '' U ∩ U).Nonempty → g = 0) :
    (localTrivializationOfDisjoint U hU hdisj).baseSet = quotientMap '' U := rfl

end KleinQuotientCovering
end noncomputable section
