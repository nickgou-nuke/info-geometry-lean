# Ultra-low profile: single 7B model served on one endpoint.
# Use this if dual-endpoint deployment still OOMs.
#
# NOTE:
# - Set both proposer/formalizer endpoints to the same model and same limits.
# - For true single-process serving, launch one vLLM server manually and
#   point both agent roles to it in your orchestrator config.

PROPOSER_MODEL=deepseek-ai/DeepSeek-Prover-V2-7B
FORMALIZER_MODEL=deepseek-ai/DeepSeek-Prover-V2-7B

PROPOSER_SERVED_NAME=deepseek-prover-v2-7b-proposer
FORMALIZER_SERVED_NAME=deepseek-prover-v2-7b-formalizer

PROPOSER_PORT=8000
FORMALIZER_PORT=8001

PROPOSER_LIMIT=--gpu-memory-utilization 0.26 --max-model-len 8192 --max-num-seqs 2
FORMALIZER_LIMIT=--gpu-memory-utilization 0.26 --max-model-len 8192 --max-num-seqs 2

STARTUP_TIMEOUT_SEC=1200
STARTUP_POLL_SEC=5
