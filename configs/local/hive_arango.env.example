# Copy to configs/local/hive_arango.env (gitignored) and fill values.
# Use a dedicated scoped service account, not root.
ARANGO_ENDPOINT=http://127.0.0.1:8530
ARANGO_DATABASE=infogeometry
# Hive queue and agent packet memory are separate from the AST/AQL DAG.
HIVE_ARANGO_ENDPOINT=http://127.0.0.1:8540
HIVE_ARANGO_DATABASE=hive_live
ARANGO_USER=hive_agent
ARANGO_PASS=CHANGE_ME
