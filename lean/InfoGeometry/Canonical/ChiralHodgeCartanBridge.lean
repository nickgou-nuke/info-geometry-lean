import InfoGeometry.Meta.Architecture
import Mathlib.Tactic.NoncommRing

/-!
# InfoGeometry.Canonical.ChiralHodgeCartanBridge

Representation dictionary for the Hodge phase, chirality axis, and Cartan
involution.

This file deliberately separates:

* Hodge/Hestenes phase candidates, which may satisfy `*² = -1` only after a
  degree/signature convention is supplied;
* chirality/grading involutions `Γ`, which satisfy `Γ² = 1`;
* Cartan involutions `θΓ(X) = Γ X Γ`, which split operators into even and odd
  sectors;
* phase-induced Cartan involutions `θK(X) = -K X K` when the supplied Hodge
  phase satisfies `K² = -1`.

The theorem-level payload is purely algebraic:

```text
D Γ = -Γ D  ->  D² Γ = Γ D².
```

Thus a Dirac/supercharge candidate is Cartan-odd while its square is
Cartan-even, once the chirality involution is supplied.

The file also records the sign correction for square-minus-one Hodge phases:
`K` itself is not a chirality involution, but `X ↦ -K X K` is an involution when
`K² = -1`.
-/

namespace ChiralHodgeCartanBridge

/-- Carrier for the representation dictionary. -/
@[rep_depth operator]
structure ChiralHodgeCartanCarrier (Op : Type*) where
  /-- Hodge/Hestenes phase axis, usually square-minus-one. -/
  hodgePhase : Op

  /-- Chirality / spectral grading axis. -/
  gamma : Op

  /-- Dirac/supercharge candidate. -/
  dirac : Op

  /-- Laplacian / even Hamiltonian candidate. -/
  laplacian : Op

/--
Hodge/Hestenes phase convention.

This is external because `*² = -1` depends on dimension, degree, and signature.
-/
@[rep_depth operator]
def IsHodgePhase {Op : Type*} [Ring Op] (C : ChiralHodgeCartanCarrier Op) : Prop :=
  C.hodgePhase * C.hodgePhase = -(1 : Op)

/-- Chirality axis is an involution. -/
@[rep_depth operator]
def IsChiralityInvolution {Op : Type*} [Ring Op]
    (C : ChiralHodgeCartanCarrier Op) : Prop :=
  C.gamma * C.gamma = 1

/-- Dirac/supercharge is odd for the chirality axis. -/
@[rep_depth operator]
def IsDiracOddForChirality {Op : Type*} [Ring Op]
    (C : ChiralHodgeCartanCarrier Op) : Prop :=
  C.dirac * C.gamma = -(C.gamma * C.dirac)

/-- Laplacian/even Hamiltonian is the square of the Dirac/supercharge. -/
@[rep_depth operator]
def IsLaplacianFromDirac {Op : Type*} [Ring Op]
    (C : ChiralHodgeCartanCarrier Op) : Prop :=
  C.laplacian = C.dirac * C.dirac

/-- Cartan involution generated by a chirality axis. -/
@[rep_depth operator]
def thetaGamma {Op : Type*} [Ring Op] (gamma X : Op) : Op :=
  gamma * X * gamma

/-- Backwards-compatible name for the chirality-generated Cartan involution. -/
@[rep_depth operator]
def theta {Op : Type*} [Ring Op] (gamma X : Op) : Op :=
  thetaGamma gamma X

/-- Cartan involution induced by a square-minus-one Hodge/Hestenes phase. -/
@[rep_depth operator]
def thetaPhase {Op : Type*} [Ring Op] (K X : Op) : Op :=
  -(K * X * K)

/-- Cartan-even sector: fixed by `θ`. -/
@[rep_depth operator]
def IsCartanEven {Op : Type*} [Ring Op] (gamma X : Op) : Prop :=
  thetaGamma gamma X = X

/-- Cartan-odd sector: negated by `θ`. -/
@[rep_depth operator]
def IsCartanOdd {Op : Type*} [Ring Op] (gamma X : Op) : Prop :=
  thetaGamma gamma X = -X

/-- Phase-Cartan-even sector: fixed by `θK(X) = -KXK`. -/
@[rep_depth operator]
def IsPhaseCartanEven {Op : Type*} [Ring Op] (K X : Op) : Prop :=
  thetaPhase K X = X

/-- Phase-Cartan-odd sector: negated by `θK(X) = -KXK`. -/
@[rep_depth operator]
def IsPhaseCartanOdd {Op : Type*} [Ring Op] (K X : Op) : Prop :=
  thetaPhase K X = -X

/-- A chirality involution produces an involutive Cartan action. -/
@[rep_depth operator]
theorem theta_involutive
    {Op : Type*} [Ring Op]
    (gamma X : Op)
    (hGamma : gamma * gamma = 1) :
    thetaGamma gamma (thetaGamma gamma X) = X := by
  unfold thetaGamma
  calc
    gamma * (gamma * X * gamma) * gamma =
        (gamma * gamma) * X * (gamma * gamma) := by
      noncomm_ring
    _ = 1 * X * 1 := by
      rw [hGamma]
    _ = X := by
      simp

/-- Compatibility readback for the legacy `theta` spelling. -/
@[rep_depth operator]
theorem theta_alias_eq_thetaGamma
    {Op : Type*} [Ring Op]
    (gamma X : Op) :
    theta gamma X = thetaGamma gamma X := by
  rfl

/-- A square-minus-one Hodge phase produces an involutive Cartan action. -/
@[rep_depth operator]
theorem thetaPhase_involutive
    {Op : Type*} [Ring Op]
    (K X : Op)
    (hK : K * K = -(1 : Op)) :
    thetaPhase K (thetaPhase K X) = X := by
  unfold thetaPhase
  calc
    -(K * (-(K * X * K)) * K) =
        (K * K) * X * (K * K) := by
      noncomm_ring
    _ = (-(1 : Op)) * X * (-(1 : Op)) := by
      rw [hK]
    _ = X := by
      simp

/-- Anticommutation with `Γ` is equivalent to Cartan-oddness under `θ(X)=ΓXΓ`. -/
@[rep_depth operator]
theorem cartanOdd_of_anticommutes_gamma
    {Op : Type*} [Ring Op]
    (gamma D : Op)
    (hGamma : gamma * gamma = 1)
    (hOdd : D * gamma = -(gamma * D)) :
    IsCartanOdd gamma D := by
  unfold IsCartanOdd thetaGamma
  calc
    gamma * D * gamma = gamma * (D * gamma) := by
      rw [mul_assoc]
    _ = gamma * (-(gamma * D)) := by
      rw [hOdd]
    _ = -((gamma * gamma) * D) := by
      simp [mul_assoc]
    _ = -D := by
      rw [hGamma]
      simp

/-- Algebraic core: a chiral-odd Dirac/supercharge has a chirality-even square. -/
@[rep_depth operator]
theorem dirac_square_commutes_gamma
    {Op : Type*} [Ring Op]
    (D gamma : Op)
    (hOdd : D * gamma = -(gamma * D)) :
    (D * D) * gamma = gamma * (D * D) := by
  calc
    (D * D) * gamma = D * (D * gamma) := by
      rw [mul_assoc]
    _ = D * (-(gamma * D)) := by
      rw [hOdd]
    _ = -(D * (gamma * D)) := by
      simp
    _ = -((D * gamma) * D) := by
      rw [mul_assoc]
    _ = -((-(gamma * D)) * D) := by
      rw [hOdd]
    _ = gamma * (D * D) := by
      simp [mul_assoc]

/-- Commutation with `Γ` implies Cartan-evenness under `θΓ(X)=ΓXΓ`. -/
@[rep_depth operator]
theorem cartanEven_of_commutes_gamma
    {Op : Type*} [Ring Op]
    (gamma X : Op)
    (hGamma : gamma * gamma = 1)
    (hComm : X * gamma = gamma * X) :
    IsCartanEven gamma X := by
  unfold IsCartanEven thetaGamma
  calc
    gamma * X * gamma = gamma * (X * gamma) := by
      rw [mul_assoc]
    _ = gamma * (gamma * X) := by
      rw [hComm]
    _ = (gamma * gamma) * X := by
      rw [mul_assoc]
    _ = X := by
      rw [hGamma]
      simp

/-- Anticommutation with a square-minus-one phase is phase-Cartan-odd. -/
@[rep_depth operator]
theorem phaseCartanOdd_of_anticommutes
    {Op : Type*} [Ring Op]
    (K X : Op)
    (hK : K * K = -(1 : Op))
    (hAnti : X * K = -(K * X)) :
    IsPhaseCartanOdd K X := by
  unfold IsPhaseCartanOdd thetaPhase
  calc
    -(K * X * K) = -(K * (X * K)) := by
      rw [mul_assoc]
    _ = -(K * (-(K * X))) := by
      rw [hAnti]
    _ = (K * K) * X := by
      simp [mul_assoc]
    _ = (-(1 : Op)) * X := by
      rw [hK]
    _ = -X := by
      simp

/-- Commutation with a square-minus-one phase is phase-Cartan-even. -/
@[rep_depth operator]
theorem phaseCartanEven_of_commutes
    {Op : Type*} [Ring Op]
    (K X : Op)
    (hK : K * K = -(1 : Op))
    (hComm : X * K = K * X) :
    IsPhaseCartanEven K X := by
  unfold IsPhaseCartanEven thetaPhase
  calc
    -(K * X * K) = -(K * (X * K)) := by
      rw [mul_assoc]
    _ = -(K * (K * X)) := by
      rw [hComm]
    _ = -((K * K) * X) := by
      rw [mul_assoc]
    _ = -((-(1 : Op)) * X) := by
      rw [hK]
    _ = X := by
      simp

/-- If `D` is chiral-odd, then `D²` is Cartan-even. -/
@[rep_depth operator]
theorem dirac_square_cartanEven_of_dirac_odd
    {Op : Type*} [Ring Op]
    (D gamma : Op)
    (hGamma : gamma * gamma = 1)
    (hOdd : D * gamma = -(gamma * D)) :
    IsCartanEven gamma (D * D) :=
  cartanEven_of_commutes_gamma gamma (D * D) hGamma
    (dirac_square_commutes_gamma D gamma hOdd)

/-- Carrier-level readback: `dirac` is Cartan-odd. -/
@[rep_depth operator]
theorem carrier_dirac_cartanOdd
    {Op : Type*} [Ring Op]
    (C : ChiralHodgeCartanCarrier Op)
    (hGamma : IsChiralityInvolution C)
    (hOdd : IsDiracOddForChirality C) :
    IsCartanOdd C.gamma C.dirac :=
  cartanOdd_of_anticommutes_gamma C.gamma C.dirac hGamma hOdd

/-- Carrier-level readback: the Dirac square is Cartan-even. -/
@[rep_depth operator]
theorem carrier_dirac_square_cartanEven
    {Op : Type*} [Ring Op]
    (C : ChiralHodgeCartanCarrier Op)
    (hGamma : IsChiralityInvolution C)
    (hOdd : IsDiracOddForChirality C) :
    IsCartanEven C.gamma (C.dirac * C.dirac) :=
  dirac_square_cartanEven_of_dirac_odd C.dirac C.gamma hGamma hOdd

/-- Carrier-level readback: if `Δ = D²`, then `Δ` is Cartan-even. -/
@[rep_depth operator]
theorem laplacian_even_of_dirac_odd
    {Op : Type*} [Ring Op]
    (C : ChiralHodgeCartanCarrier Op)
    (hGamma : IsChiralityInvolution C)
    (hOdd : IsDiracOddForChirality C)
    (hLap : IsLaplacianFromDirac C) :
    IsCartanEven C.gamma C.laplacian := by
  rw [hLap]
  exact carrier_dirac_square_cartanEven C hGamma hOdd

/-- Carrier for left/right anomaly charge readout. -/
@[rep_depth operator]
structure ChiralAnomalyChargeCarrier (Op : Type*) where
  /-- Right/range anomaly current. -/
  chiR : Op

  /-- Left/domain anomaly current. -/
  chiL : Op

  /-- Net chiral supercharge. -/
  Q : Op

/-- Net chiral charge law `Q = χ_R - χ_L`. -/
@[rep_depth operator]
def IsNetChiralCharge {Op : Type*} [Sub Op]
    (C : ChiralAnomalyChargeCarrier Op) : Prop :=
  C.Q = C.chiR - C.chiL

/-- Direct readback of the supplied net chiral charge law. -/
@[rep_depth operator]
theorem netChiralCharge_eq_chiR_sub_chiL
    {Op : Type*} [Sub Op]
    (C : ChiralAnomalyChargeCarrier Op)
    (hQ : IsNetChiralCharge C) :
    C.Q = C.chiR - C.chiL :=
  hQ

end ChiralHodgeCartanBridge
