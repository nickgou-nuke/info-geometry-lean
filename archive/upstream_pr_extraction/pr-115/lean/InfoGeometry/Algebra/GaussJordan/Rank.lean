import Mathlib

open Matrix

namespace InfoGeometry.Algebra.GaussJordan

/-- Rational matrices with zero-based finite row and column indices. -/
abbrev RatMatrix (m n : ℕ) := Matrix (Fin m) (Fin n) ℚ

/-- Embed one of the first `p` rows into all `m` rows. -/
def rowIndex {p m : ℕ} (hp : p ≤ m) (i : Fin p) : Fin m :=
  ⟨i.1, lt_of_lt_of_le i.2 hp⟩

@[simp] theorem rowIndex_val {p m : ℕ} (hp : p ≤ m) (i : Fin p) :
    (rowIndex hp i).1 = i.1 :=
  rfl

theorem rowIndex_injective {p m : ℕ} (hp : p ≤ m) :
    Function.Injective (rowIndex hp : Fin p → Fin m) := by
  intro i j hij
  apply Fin.ext
  simpa [rowIndex] using congrArg (fun x : Fin m => x.1) hij

/--
A proof-relevant certificate of reduced row-echelon form.

The first `p` rows are the pivot rows; `pivot s` is the pivot column of row `s`.
The remaining rows are zero. Keeping the pivot function in `Type` avoids hiding
computational data in a proposition.
-/
structure ReducedRowEchelon {m n : ℕ} (A : RatMatrix m n) (p : ℕ) where
  rows_le : p ≤ m
  pivot : Fin p → Fin n
  pivot_strict : StrictMono pivot
  pivot_one : ∀ s, A (rowIndex rows_le s) (pivot s) = 1
  pivot_zero : ∀ s i, i ≠ rowIndex rows_le s → A i (pivot s) = 0
  left_zero : ∀ s j, j.1 < (pivot s).1 → A (rowIndex rows_le s) j = 0
  zero_rows : ∀ i, p ≤ i.1 → A i = 0

/-- Propositional wrapper around the proof-relevant RREF certificate. -/
def IsReducedRowEchelon {m n : ℕ} (A : RatMatrix m n) (p : ℕ) : Prop :=
  Nonempty (ReducedRowEchelon A p)

namespace ReducedRowEchelon

variable {m n p : ℕ} {A : RatMatrix m n}

/-- Every witnessed pivot row is nonzero. -/
theorem row_ne_zero (h : ReducedRowEchelon A p) (s : Fin p) :
    A (rowIndex h.rows_le s) ≠ 0 := by
  intro hz
  have hz' := congrFun hz (h.pivot s)
  rw [h.pivot_one s] at hz'
  exact one_ne_zero hz'

/-- The row span is generated by the first `p` rows. -/
theorem row_span_le_pivot_row_span (h : ReducedRowEchelon A p) :
    Submodule.span ℚ (Set.range A.row) ≤
      Submodule.span ℚ (Set.range (fun s : Fin p => A (rowIndex h.rows_le s))) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨i, rfl⟩
  change A i ∈ Submodule.span ℚ (Set.range (fun s : Fin p => A (rowIndex h.rows_le s)))
  by_cases hi : i.1 < p
  · let s : Fin p := ⟨i.1, hi⟩
    have hieq : i = rowIndex h.rows_le s := by
      apply Fin.ext
      rfl
    rw [hieq]
    exact Submodule.subset_span (Set.mem_range_self s)
  · have hip : p ≤ i.1 := Nat.le_of_not_gt hi
    rw [h.zero_rows i hip]
    exact Submodule.zero_mem _

/-- An RREF witness with `p` pivots has rank at most `p`. -/
theorem rank_le_pivots (h : ReducedRowEchelon A p) : A.rank ≤ p := by
  let rows : Fin p → (Fin n → ℚ) := fun s => A (rowIndex h.rows_le s)
  have hspan : Submodule.span ℚ (Set.range A.row) ≤
      Submodule.span ℚ (Set.range rows) := by
    simpa [rows] using h.row_span_le_pivot_row_span
  calc
    A.rank = Module.finrank ℚ (Submodule.span ℚ (Set.range A.row)) :=
      A.rank_eq_finrank_span_row
    _ ≤ Module.finrank ℚ (Submodule.span ℚ (Set.range rows)) :=
      Submodule.finrank_mono hspan
    _ ≤ Fintype.card (Fin p) := by
      simpa [Set.finrank] using (finrank_range_le_card (R := ℚ) rows)
    _ = p := Fintype.card_fin p

/-- The pivot columns contain `p` independent standard basis vectors. -/
theorem pivots_le_rank (h : ReducedRowEchelon A p) : p ≤ A.rank := by
  let e : Fin p → Fin m := rowIndex h.rows_le
  let std : Fin p → (Fin m → ℚ) := (Pi.basisFun ℚ (Fin m)) ∘ e
  have he : Function.Injective e := by
    simpa [e] using rowIndex_injective h.rows_le
  have hli : LinearIndependent ℚ std := by
    exact (Pi.basisFun ℚ (Fin m)).linearIndependent.comp e he
  have hmem : ∀ s : Fin p, std s ∈ A.mulVecLin.range := by
    intro s
    refine LinearMap.mem_range.mpr ⟨Pi.basisFun ℚ (Fin n) (h.pivot s), ?_⟩
    rw [Matrix.mulVecLin_apply]
    ext i
    by_cases hi : i = e s
    · subst i
      simp [std, e, Matrix.mulVec, h.pivot_one]
    · simp [std, e, Matrix.mulVec, hi, h.pivot_zero s i hi]
  have hspan : Submodule.span ℚ (Set.range std) ≤ A.mulVecLin.range :=
    Submodule.span_le.mpr (Set.range_subset_iff.mpr hmem)
  calc
    p = Fintype.card (Fin p) := by simp
    _ = Module.finrank ℚ (Submodule.span ℚ (Set.range std)) := by
      symm
      exact finrank_span_eq_card hli
    _ ≤ Module.finrank ℚ A.mulVecLin.range := Submodule.finrank_mono hspan
    _ = A.rank := rfl

/-- For an RREF witness, the number of pivots is exactly `Matrix.rank`. -/
theorem rank_eq_pivots (h : ReducedRowEchelon A p) : A.rank = p :=
  Nat.le_antisymm h.rank_le_pivots h.pivots_le_rank

/-- The nonzero rows of an RREF certificate are exactly its pivot rows. -/
theorem nonzero_row_count (h : ReducedRowEchelon A p) :
    (Finset.univ.filter fun i : Fin m => A i ≠ 0).card = p := by
  let e : Fin p → Fin m := rowIndex h.rows_le
  have he : Function.Injective e := by
    simpa [e] using rowIndex_injective h.rows_le
  have hfinset :
      (Finset.univ.filter fun i : Fin m => A i ≠ 0) = Finset.univ.image e := by
    ext i
    constructor
    · intro hi
      have hine : A i ≠ 0 := (Finset.mem_filter.mp hi).2
      have hip : i.1 < p := by
        by_contra hnot
        exact hine (h.zero_rows i (Nat.le_of_not_gt hnot))
      let s : Fin p := ⟨i.1, hip⟩
      have his : e s = i := by
        apply Fin.ext
        rfl
      exact Finset.mem_image.mpr ⟨s, Finset.mem_univ _, his⟩
    · intro hi
      obtain ⟨s, -, rfl⟩ := Finset.mem_image.mp hi
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, h.row_ne_zero s⟩
  rw [hfinset, Finset.card_image_iff.mpr he.injOn]
  simp

end ReducedRowEchelon

end InfoGeometry.Algebra.GaussJordan
