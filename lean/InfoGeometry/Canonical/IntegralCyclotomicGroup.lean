import InfoGeometry.Canonical.IntegralCyclotomicTransvection

/-! # An infinite group generated by two finite-order integral units

Exact orders are proved only for these integer matrices. No presentation or
identification with SL₂(ℤ) is asserted.
-/
namespace InfoGeometry.Canonical.IntegralCyclotomicGroup
open GrassmannianBundleCyclotomicOrientability IntegralCyclotomicTransvection

/-- The fourth-cyclotomic matrix as an actual unit. -/
def fourthUnit : Mat2Zˣ where
  val := cyclotomic4Op matD matB
  inv := -cyclotomic4Op matD matB
  val_inv := by decide
  inv_val := by decide

/-- The third-cyclotomic matrix, with inverse its square. -/
def thirdUnit : Mat2Zˣ where
  val := cyclotomic3Op matD matB
  inv := cyclotomic3Op matD matB ^ 2
  val_inv := by decide
  inv_val := by decide

theorem fourthUnit_order : orderOf fourthUnit = 4 := by
  apply (orderOf_eq_iff (by decide : 0 < (4 : ℕ))).2
  constructor
  · decide
  · intro m hm hp
    interval_cases m <;> decide

theorem thirdUnit_order : orderOf thirdUnit = 3 := by
  apply (orderOf_eq_iff (by decide : 0 < (3 : ℕ))).2
  constructor
  · decide
  · intro m hm hp
    interval_cases m <;> decide

/-- The universal transvection-recovery theorem, now lifted to units. -/
theorem inverse_fourth_mul_third : fourthUnit⁻¹ * thirdUnit = matGUnit := by
  apply Units.ext
  exact cyclotomic_product_eq_shear

/-- The subgroup generated by the two specified units. -/
def generated : Subgroup Mat2Zˣ := Subgroup.closure {fourthUnit, thirdUnit}

theorem matGUnit_mem_generated : matGUnit ∈ generated := by
  have hj : fourthUnit ∈ generated := Subgroup.subset_closure (by simp)
  have hw : thirdUnit ∈ generated := Subgroup.subset_closure (by simp)
  rw [← inverse_fourth_mul_third]
  exact generated.mul_mem (generated.inv_mem hj) hw

/-- The infinite transvection powers lie in the finitely generated subgroup. -/
theorem generated_infinite : Set.Infinite (generated : Set Mat2Zˣ) := by
  apply infinite_matGUnit_powers.mono
  rintro x ⟨n,rfl⟩
  exact generated.pow_mem matGUnit_mem_generated n

end InfoGeometry.Canonical.IntegralCyclotomicGroup
