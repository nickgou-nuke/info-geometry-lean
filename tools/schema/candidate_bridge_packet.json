{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CandidateBridgePacket",
  "description": "Typed candidate-bridge packet for classifying symbolic correspondences as equivalence, obstruction, or discard.",
  "type": "object",
  "required": [
    "packet_id",
    "created_at",
    "source_owner_surfaces",
    "target_owner_surfaces",
    "claimed_invariant",
    "proposed_map",
    "outcome_class",
    "unresolved_assumptions",
    "status"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_owner_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "target_owner_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "claimed_invariant": {
      "type": "string",
      "minLength": 1
    },
    "proposed_map": {
      "type": "object",
      "required": [
        "map_kind",
        "map_expression"
      ],
      "properties": {
        "map_kind": {
          "type": "string",
          "enum": [
            "equivalence",
            "intertwiner",
            "functor",
            "natural_transformation",
            "translator",
            "coherence"
          ]
        },
        "map_expression": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "outcome_class": {
      "type": "string",
      "enum": [
        "equivalence",
        "obstruction",
        "discard"
      ]
    },
    "theorem_target": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "theorem",
            "lemma",
            "coherence",
            "definition"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mismatch_object": {
      "type": "object",
      "required": [
        "name",
        "preservation_gap"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preservation_gap": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "discard_reason": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_moves": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_packet": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stabilization",
        "admitted",
        "rejected"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome_class": {
            "const": "equivalence"
          }
        }
      },
      "then": {
        "required": [
          "theorem_target"
        ],
        "not": {
          "required": [
            "mismatch_object"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome_class": {
            "const": "obstruction"
          }
        }
      },
      "then": {
        "required": [
          "theorem_target",
          "mismatch_object"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome_class": {
            "const": "discard"
          }
        }
      },
      "then": {
        "required": [
          "discard_reason"
        ]
      }
    }
  ],
  "additionalProperties": true
}
