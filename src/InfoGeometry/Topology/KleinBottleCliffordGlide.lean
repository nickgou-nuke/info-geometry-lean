import Mathlib.Topology.Algebra.Module.FiniteDimension

/-!
# The Klein glide and the existing split Clifford action

The derivative of the affine glide on the covering plane agrees with the
reflection already used by the canonical `Cl(1,1)` Clifford owner. This file
proves that their actions agree on every Clifford generator. It then defines
the quotient by the equivalence relation generated by the diagonal glide and
transverse-period steps on the covering plane times the Clifford fiber. The
fiber-forgetting map descends continuously and surjectively to the existing
Klein orbit quotient. A theorem identifies the generated relation with the
presented group's orbit relation. This does not construct an associated vector
bundle, identify the total quotient with a Möbius gluing, or prove a surface
classification theorem.
-/

namespace InfoGeometry.Topology.KleinBottleCliffordGlide

open InfoGeometry.Clifford.Cl11Matrix
open InfoGeometry.Topology.KleinBottleTangentHolonomy
open InfoGeometry.Canonical.KleinPresentedGroup
open KleinBottleOrbitQuotient

/-! The fiber topology is the standard finite-dimensional real module topology.
Its finite-dimensionality is transported through the existing algebra
equivalence `Cl(1,1) ≃ₐ[ℝ] M₂(ℝ)`. -/

noncomputable instance cl11FiniteDimensional :
    FiniteDimensional ℝ (CliffordAlgebra q11) :=
  LinearEquiv.finiteDimensional cl11EquivMat.toLinearEquiv.symm

noncomputable instance cl11TopologicalSpace :
    TopologicalSpace (CliffordAlgebra q11) :=
  moduleTopology ℝ (CliffordAlgebra q11)

noncomputable instance cl11IsModuleTopology :
    IsModuleTopology ℝ (CliffordAlgebra q11) :=
  ⟨rfl⟩

noncomputable instance cl11IsTopologicalRing :
    IsTopologicalRing (CliffordAlgebra q11) := by
  apply IsModuleTopology.isTopologicalRing ℝ

/-- The canonical `Cl(1,1)` reflection and the derivative of the Klein glide
are the same linear map on the tangent carrier. -/
theorem splitReflection_eq_glideLinearPart (v : Vec11) :
    splitReflection v = glideLinearPart v := by
  rcases v with ⟨x, y⟩
  ext <;> simp [splitReflection, glideLinearPart]

/-- The canonical product-coordinate interchange reverses the sign of the
split quadratic form, so it is an anti-isometry rather than a `q11` isometry. -/
theorem q11_prodComm_neg (v : Vec11) :
    q11 (LinearEquiv.prodComm ℝ ℝ ℝ v) = -q11 v := by
  rcases v with ⟨x, y⟩
  simp [q11_apply]

/-- The two reflection conventions are conjugate as linear maps by coordinate
interchange: the covering derivative `(x,y) ↦ (x,-y)` is carried to
`(-x,y)`, the convention used by the exterior-orientation deck model. -/
theorem prodComm_conjugates_glide_reflections (v : Vec11) :
    LinearEquiv.prodComm ℝ ℝ ℝ (splitReflection v) =
      splitReflectionFirstCoordinate (LinearEquiv.prodComm ℝ ℝ ℝ v) := by
  rcases v with ⟨x, y⟩
  rfl

/-- Product-coordinate interchange does not preserve `q11`, as witnessed by
the positive basis vector. -/
theorem prodComm_not_q11_isometry :
    ¬ ∀ v : Vec11, q11 (LinearEquiv.prodComm ℝ ℝ ℝ v) = q11 v := by
  intro h
  have h₁ := h (1, 0)
  norm_num [q11_apply] at h₁

/-- The pre-existing Clifford automorphism acts on generators by the actual
derivative of the affine Klein glide. -/
@[simp] theorem kleinGlide_clifford_generator_action (v : Vec11) :
    splitReflectionCliffordAuto (CliffordAlgebra.ι q11 v) =
      CliffordAlgebra.ι q11 (glideLinearPart v) := by
  rw [splitReflectionCliffordAuto_ι, splitReflection_eq_glideLinearPart]

/-! ## The affine deck action with its Clifford fibre action

The repository separately owns the affine deck representation in
`KleinUniversalAffineAction`.  The following construction reuses the base
maps and Klein relation from `KleinBrillouinBase`, then constructs product
permutations with the existing Clifford reflection on the glide fibre and
the specified trivial fibre action for the transverse translation.  It
defines an action on the product carrier; it does not assert that the orbit
space is a vector bundle.
-/

/-- The glide generator acts on the total carrier by its affine deck map on
the base and the induced `Cl(1,1)` reflection on the fibre. -/
noncomputable def glideCliffordTotalPerm :
    Equiv.Perm (KleinBrillouinBase.Cover × CliffordAlgebra q11) where
  toFun x := (KleinBrillouinBase.glide x.1, splitReflectionCliffordAuto x.2)
  invFun x :=
    (KleinBrillouinBase.glideInv x.1, splitReflectionCliffordAuto.symm x.2)
  left_inv x := by
    rcases x with ⟨k, c⟩
    exact Prod.ext (KleinBrillouinBase.glide_left_inverse k)
      (splitReflectionCliffordAuto.symm_apply_apply c)
  right_inv x := by
    rcases x with ⟨k, c⟩
    exact Prod.ext (KleinBrillouinBase.glide_right_inverse k)
      (splitReflectionCliffordAuto.apply_symm_apply c)

/-- The transverse-period generator acts on the base by the existing deck
translation and trivially on the Clifford fibre. -/
noncomputable def transverseCliffordTotalPerm :
    Equiv.Perm (KleinBrillouinBase.Cover × CliffordAlgebra q11) where
  toFun x := (KleinBrillouinBase.ty x.1, x.2)
  invFun x := (KleinBrillouinBase.tyInv x.1, x.2)
  left_inv x := by
    rcases x with ⟨k, c⟩
    exact Prod.ext (by simp [KleinBrillouinBase.ty, KleinBrillouinBase.tyInv]) rfl
  right_inv x := by
    rcases x with ⟨k, c⟩
    exact Prod.ext (by simp [KleinBrillouinBase.ty, KleinBrillouinBase.tyInv]) rfl

/-- The two total-space permutations satisfy the Klein conjugation relation.
The base component is the existing affine deck relation; the fibre component
uses that the transverse generator is the identity on the fibre. -/
theorem glideCliffordTotalPerm_conj_transverse :
    glideCliffordTotalPerm * transverseCliffordTotalPerm *
        glideCliffordTotalPerm⁻¹ = transverseCliffordTotalPerm⁻¹ := by
  apply Equiv.ext
  intro x
  rcases x with ⟨k, c⟩
  apply Prod.ext
  · change KleinBrillouinBase.glide
      (KleinBrillouinBase.ty (KleinBrillouinBase.glideInv k)) =
      KleinBrillouinBase.tyInv k
    exact KleinBrillouinBase.glide_conj_ty k
  · simp [glideCliffordTotalPerm, transverseCliffordTotalPerm,
      Equiv.Perm.mul_apply]

/-- The presented Klein group acts by the concrete affine deck maps together
with their specified Clifford-fibre actions. -/
noncomputable def presentedKleinCliffordTotalAction :
    KleinGroup →* Equiv.Perm
      (KleinBrillouinBase.Cover × CliffordAlgebra q11) :=
  kleinRep glideCliffordTotalPerm transverseCliffordTotalPerm
    glideCliffordTotalPerm_conj_transverse

/-- Readback of the total action at the glide generator. -/
theorem presentedKleinCliffordTotalAction_glide (k : KleinBrillouinBase.Cover)
    (c : CliffordAlgebra q11) :
    presentedKleinCliffordTotalAction (toKlein genA) (k, c) =
      (KleinBrillouinBase.glide k, splitReflectionCliffordAuto c) := by
  change (kleinRep glideCliffordTotalPerm transverseCliffordTotalPerm
    glideCliffordTotalPerm_conj_transverse (toKlein genA)) (k, c) = _
  rw [(kleinRep_relator_relation glideCliffordTotalPerm
    transverseCliffordTotalPerm glideCliffordTotalPerm_conj_transverse).1]
  rfl

/-- Readback of the total action at the transverse-period generator. -/
theorem presentedKleinCliffordTotalAction_transverse (k : KleinBrillouinBase.Cover)
    (c : CliffordAlgebra q11) :
    presentedKleinCliffordTotalAction (toKlein genB) (k, c) =
      (KleinBrillouinBase.ty k, c) := by
  change (kleinRep glideCliffordTotalPerm transverseCliffordTotalPerm
    glideCliffordTotalPerm_conj_transverse (toKlein genB)) (k, c) = _
  rw [(kleinRep_relator_relation glideCliffordTotalPerm
    transverseCliffordTotalPerm glideCliffordTotalPerm_conj_transverse).2]
  rfl

/-- Permutation-level readback of the presented glide generator. -/
theorem presentedKleinCliffordTotalAction_glide_perm :
    presentedKleinCliffordTotalAction (toKlein genA) =
      glideCliffordTotalPerm := by
  apply Equiv.ext
  intro x
  rcases x with ⟨k, c⟩
  exact presentedKleinCliffordTotalAction_glide k c

/-- Permutation-level readback of the presented transverse generator. -/
theorem presentedKleinCliffordTotalAction_transverse_perm :
    presentedKleinCliffordTotalAction (toKlein genB) =
      transverseCliffordTotalPerm := by
  apply Equiv.ext
  intro x
  rcases x with ⟨k, c⟩
  exact presentedKleinCliffordTotalAction_transverse k c

private noncomputable def freeKleinCliffordTotalAction :
    KleinFree →* Equiv.Perm
      (KleinBrillouinBase.Cover × CliffordAlgebra q11) :=
  FreeGroup.lift fun
    | .a => glideCliffordTotalPerm
    | .b => transverseCliffordTotalPerm

/-- The action of the presented group, pulled back to the free group, is the
free action generated by the two total-space permutations. -/
private theorem presentedAction_toKlein_eq_free (w : KleinFree) :
    presentedKleinCliffordTotalAction (toKlein w) =
      freeKleinCliffordTotalAction w := by
  have hhom :
      presentedKleinCliffordTotalAction.comp toKlein =
        freeKleinCliffordTotalAction := by
    apply FreeGroup.ext_hom
    intro g
    cases g with
    | a =>
        change kleinRep glideCliffordTotalPerm transverseCliffordTotalPerm
          glideCliffordTotalPerm_conj_transverse (toKlein genA) =
          freeKleinCliffordTotalAction (FreeGroup.of .a)
        rw [(kleinRep_relator_relation glideCliffordTotalPerm
          transverseCliffordTotalPerm glideCliffordTotalPerm_conj_transverse).1]
        simp [freeKleinCliffordTotalAction]
    | b =>
        change kleinRep glideCliffordTotalPerm transverseCliffordTotalPerm
          glideCliffordTotalPerm_conj_transverse (toKlein genB) =
          freeKleinCliffordTotalAction (FreeGroup.of .b)
        rw [(kleinRep_relator_relation glideCliffordTotalPerm
          transverseCliffordTotalPerm glideCliffordTotalPerm_conj_transverse).2]
        simp [freeKleinCliffordTotalAction]
  exact DFunLike.congr_fun hhom w

/-! ## Quotient by the generated diagonal relation

The action above is diagonal: the affine Klein generators act on the cover,
and the glide differential acts on the Clifford fibre. The quotient below is
the equivalence relation generated by those two generator actions and their
reverses. It is not a product of the base quotient with the fibre, nor does it
assert local triviality of a vector bundle.
-/

abbrev CliffordTotalCarrier :=
  KleinBrillouinBase.Cover × CliffordAlgebra q11

/-- An elementary orbit step for either presented Klein generator, in either
direction, on the covering carrier with its Clifford fibre. -/
def cliffordTotalActionStep (x y : CliffordTotalCarrier) : Prop :=
  y = glideCliffordTotalPerm x ∨
  y = transverseCliffordTotalPerm x ∨
  x = glideCliffordTotalPerm y ∨
  x = transverseCliffordTotalPerm y

private theorem cliffordTotalActionStep_symmetric {x y : CliffordTotalCarrier}
    (h : cliffordTotalActionStep x y) : cliffordTotalActionStep y x := by
  rcases h with h | h | h | h
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inr (Or.inr (Or.inr h))
  · exact Or.inl h
  · exact Or.inr (Or.inl h)

/-- The equivalence relation generated by the diagonal glide and transverse
period actions on the cover-times-Clifford carrier. -/
def cliffordTotalOrbitRel (x y : CliffordTotalCarrier) : Prop :=
  Relation.ReflTransGen cliffordTotalActionStep x y

private theorem cliffordTotalOrbitRel_symm {x y : CliffordTotalCarrier}
    (h : cliffordTotalOrbitRel x y) : cliffordTotalOrbitRel y x := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | @tail b c hxb hbc ih =>
      exact (Relation.ReflTransGen.single
        (cliffordTotalActionStep_symmetric hbc)).trans ih

/-- The setoid defined by the equivalence relation generated by the two
diagonal deck steps and their reverses. -/
def cliffordTotalOrbitSetoid : Setoid CliffordTotalCarrier where
  r := cliffordTotalOrbitRel
  iseqv := by
    constructor
    · intro x
      exact Relation.ReflTransGen.refl
    · intro x y h
      induction h with
      | refl => exact Relation.ReflTransGen.refl
      | @tail b c hxb hbc ih =>
          exact (Relation.ReflTransGen.single
            (cliffordTotalActionStep_symmetric hbc)).trans ih
    · intro x y z hxy hyz
      exact Relation.ReflTransGen.trans hxy hyz

private theorem cliffordTotalActionStep_exists (x y : CliffordTotalCarrier)
    (h : cliffordTotalActionStep x y) :
    ∃ g : KleinGroup, presentedKleinCliffordTotalAction g x = y := by
  rcases h with h | h | h | h
  · refine ⟨toKlein genA, ?_⟩
    rw [presentedKleinCliffordTotalAction_glide_perm]
    exact h.symm
  · refine ⟨toKlein genB, ?_⟩
    rw [presentedKleinCliffordTotalAction_transverse_perm]
    exact h.symm
  · refine ⟨(toKlein genA)⁻¹, ?_⟩
    rw [map_inv, presentedKleinCliffordTotalAction_glide_perm]
    change glideCliffordTotalPerm.symm x = y
    rw [h]
    exact glideCliffordTotalPerm.symm_apply_apply y
  · refine ⟨(toKlein genB)⁻¹, ?_⟩
    rw [map_inv, presentedKleinCliffordTotalAction_transverse_perm]
    change transverseCliffordTotalPerm.symm x = y
    rw [h]
    exact transverseCliffordTotalPerm.symm_apply_apply y

private theorem freeKleinCliffordTotalAction_orbit (w : KleinFree)
    (x : CliffordTotalCarrier) :
    cliffordTotalOrbitRel x (freeKleinCliffordTotalAction w x) := by
  induction w using FreeGroup.induction_on generalizing x with
  | one =>
      exact Relation.ReflTransGen.refl
  | of g =>
      cases g with
      | a =>
          exact Relation.ReflTransGen.single (Or.inl rfl)
      | b =>
          exact Relation.ReflTransGen.single (Or.inr (Or.inl rfl))
  | inv_of g ih =>
      apply cliffordTotalOrbitRel_symm
      cases g with
      | a =>
          simpa [freeKleinCliffordTotalAction] using
            ih (glideCliffordTotalPerm.symm x)
      | b =>
          simpa [freeKleinCliffordTotalAction] using
            ih (transverseCliffordTotalPerm.symm x)
  | mul u v ihu ihv =>
      simpa only [cliffordTotalOrbitRel, map_mul, Equiv.Perm.mul_apply] using
        (ihv x).trans (ihu (freeKleinCliffordTotalAction v x))

/-- The generator-step equivalence is exactly the orbit relation of the
presented Klein-group action on the total carrier. -/
theorem cliffordTotalOrbitRel_iff_exists_group_action (x y : CliffordTotalCarrier) :
    cliffordTotalOrbitRel x y ↔
      ∃ g : KleinGroup, presentedKleinCliffordTotalAction g x = y := by
  constructor
  · intro h
    induction h with
    | refl => exact ⟨1, by simp [presentedKleinCliffordTotalAction]⟩
    | @tail b c hxb hbc ih =>
        obtain ⟨g, hg⟩ := ih
        obtain ⟨k, hk⟩ := cliffordTotalActionStep_exists b c hbc
        refine ⟨k * g, ?_⟩
        rw [map_mul]
        change presentedKleinCliffordTotalAction k
          (presentedKleinCliffordTotalAction g x) = c
        rw [hg]
        exact hk
  · rintro ⟨g, rfl⟩
    obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective g
    have hact := congrArg (fun f : Equiv.Perm CliffordTotalCarrier => f x)
      (presentedAction_toKlein_eq_free w)
    change cliffordTotalOrbitRel x
      ((presentedKleinCliffordTotalAction (toKlein w)) x)
    simpa only [hact] using freeKleinCliffordTotalAction_orbit w x

/-- The total-space quotient by the generated diagonal relation. -/
abbrev KleinCliffordTotalQuotient :=
  Quotient cliffordTotalOrbitSetoid

/-- Canonical projection from the covering carrier to its diagonal orbit
quotient. -/
def cliffordTotalQuotientMap :
    CliffordTotalCarrier → KleinCliffordTotalQuotient :=
  @Quotient.mk' CliffordTotalCarrier cliffordTotalOrbitSetoid

theorem cliffordTotalQuotientMap_surjective :
    Function.Surjective cliffordTotalQuotientMap :=
  Quotient.mk_surjective

theorem cliffordTotalQuotientMap_continuous :
    Continuous cliffordTotalQuotientMap :=
  continuous_quotient_mk'

theorem cliffordTotalQuotientMap_isQuotient :
    Topology.IsQuotientMap cliffordTotalQuotientMap :=
  isQuotientMap_quotient_mk'

private theorem coverToTorus_continuous :
    Continuous KleinBrillouinBase.coverToTorus := by
  change Continuous
    (fun p : ℝ × ℝ =>
      ((p.1 : KleinBrillouinBase.MomentumCircle),
       (p.2 : KleinBrillouinBase.MomentumCircle)))
  have h₁ : Continuous
      (fun p : ℝ × ℝ => (p.1 : KleinBrillouinBase.MomentumCircle)) := by
    exact (AddCircle.continuous_mk' (2 * Real.pi)).comp continuous_fst
  have h₂ : Continuous
      (fun p : ℝ × ℝ => (p.2 : KleinBrillouinBase.MomentumCircle)) := by
    exact (AddCircle.continuous_mk' (2 * Real.pi)).comp continuous_snd
  exact h₁.prodMk h₂

private noncomputable def cliffordTotalRepresentativeBase
    (x : CliffordTotalCarrier) : KleinBrillouinQuotient :=
  KleinBottleOrbitQuotient.quotientMap
    (KleinBrillouinBase.coverToTorus x.1)

private theorem cliffordTotalRepresentativeBase_step
    (x y : CliffordTotalCarrier) (h : cliffordTotalActionStep x y) :
    cliffordTotalRepresentativeBase x = cliffordTotalRepresentativeBase y := by
  rcases h with h | h | h | h
  · subst y
    simpa [cliffordTotalRepresentativeBase, glideCliffordTotalPerm] using
      (KleinBottleOrbitQuotient.quotientMap_coverToTorus_glide x.1).symm
  · subst y
    simpa [cliffordTotalRepresentativeBase, transverseCliffordTotalPerm] using
      (KleinBottleOrbitQuotient.quotientMap_coverToTorus_ty x.1).symm
  · subst x
    simpa [cliffordTotalRepresentativeBase, glideCliffordTotalPerm] using
      KleinBottleOrbitQuotient.quotientMap_coverToTorus_glide y.1
  · subst x
    simpa [cliffordTotalRepresentativeBase, transverseCliffordTotalPerm] using
      KleinBottleOrbitQuotient.quotientMap_coverToTorus_ty y.1

private theorem cliffordTotalRepresentativeBase_respects
    (x y : CliffordTotalCarrier) (h : cliffordTotalOrbitRel x y) :
    cliffordTotalRepresentativeBase x = cliffordTotalRepresentativeBase y := by
  induction h with
  | refl => rfl
  | @tail b c hxb hbc ih =>
      exact ih.trans (cliffordTotalRepresentativeBase_step b c hbc)

/-- The diagonal total-space quotient projects to the existing Klein orbit
quotient. The projection forgets the fibre only after quotient invariance has
been proved for both affine generators. -/
noncomputable def cliffordTotalBaseProjection :
    KleinCliffordTotalQuotient → KleinBrillouinQuotient :=
  Quotient.lift cliffordTotalRepresentativeBase
    cliffordTotalRepresentativeBase_respects

@[simp] theorem cliffordTotalBaseProjection_mk (x : CliffordTotalCarrier) :
    cliffordTotalBaseProjection (cliffordTotalQuotientMap x) =
      KleinBottleOrbitQuotient.quotientMap
        (KleinBrillouinBase.coverToTorus x.1) := rfl

theorem cliffordTotalBaseProjection_continuous :
    Continuous cliffordTotalBaseProjection := by
  change Continuous (Quotient.lift cliffordTotalRepresentativeBase
    cliffordTotalRepresentativeBase_respects)
  apply Continuous.quotient_lift
  exact KleinBottleOrbitQuotient.quotientMap_continuous.comp
    (coverToTorus_continuous.comp continuous_fst)

theorem coverToTorus_surjective :
    Function.Surjective KleinBrillouinBase.coverToTorus := by
  rintro ⟨x, y⟩
  obtain ⟨x', rfl⟩ := Quotient.exists_rep x
  obtain ⟨y', rfl⟩ := Quotient.exists_rep y
  exact ⟨(x', y'), rfl⟩

theorem cliffordTotalBaseProjection_surjective :
    Function.Surjective cliffordTotalBaseProjection := by
  intro q
  obtain ⟨p, rfl⟩ := KleinBottleOrbitQuotient.quotientMap_surjective q
  obtain ⟨k, rfl⟩ := coverToTorus_surjective p
  exact ⟨cliffordTotalQuotientMap (k, 0), rfl⟩

end InfoGeometry.Topology.KleinBottleCliffordGlide
