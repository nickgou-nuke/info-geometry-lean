{"type":"new","contents":"import Mathlib.Algebra.Ring.Basic\nimport Mathlib.Algebra.Star.Basic\nimport Mathlib.Analysis.InnerProductSpace.Adjoint\nimport Mathlib.Analysis.InnerProductSpace.Projection.Basic\nimport Mathlib.Analysis.InnerProductSpace.Projection.Submodule\nimport Mathlib.Analysis.Normed.Operator.Banach\n\nnamespace InfoGeometry.Singular.MoorePenrose\n\nsection MP\n\nvariable {R : Type*} [Ring R] [StarRing R]\n\ndef IsMoorePenroseInverse (A B : R) : Prop :=\n  A * B * A = A ∧\n  B * A * B = B ∧\n  star (A * B) = A * B ∧\n  star (B * A) = B * A\n\nend MP\n\nsection Hilbert\n\nopen InnerProductSpace ContinuousLinearMap\nopen scoped InnerProduct ComplexConjugate\n\nvariable {𝕜 E : Type*}\nvariable [RCLike 𝕜]\nvariable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\n\ntheorem exists_moorePenroseInverse_of_closedRange\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    ∃ (B : E →L[𝕜] E), IsMoorePenroseInverse A B := by\n  classical\n\n  let K : Submodule 𝕜 E := A.kerᗮ\n\n  haveI : CompleteSpace A.range := hClosedRange.completeSpace_coe\n  haveI : A.range.HasOrthogonalProjection := inferInstance\n\n  haveI : CompleteSpace K := by\n    dsimp [K]\n    infer_instance\n  haveI : K.HasOrthogonalProjection := inferInstance\n\n  have hKerClosed : IsClosed (A.ker : Set E) := A.isClosed_ker\n  haveI : CompleteSpace A.ker := hKerClosed.completeSpace_coe\n  haveI : A.ker.HasOrthogonalProjection := inferInstance\n\n  have hkerOO : Kᗮ ≤ A.ker := by\n    dsimp [K]\n    rw [Submodule.orthogonal_orthogonal (A.ker)]\n\n  have hAproj : ∀ x : E, A (K.starProjection x) = A x := by\n    intro x\n    have hsum : K.starProjection x + Kᗮ.starProjection x = x :=\n      Submodule.starProjection_add_starProjection_orthogonal x\n    have hkerPart_mem : Kᗮ.starProjection x ∈ A.ker :=\n      hkerOO (Submodule.coe_mem _)\n    have hkerPart_zero : A (Kᗮ.starProjection x) = 0 :=\n      (LinearMap.mem_ker.1 hkerPart_mem)\n    calc\n      A (K.starProjection x) = A (K.starProjection x) + 0 := (add_zero _).symm\n      _ = A (K.starProjection x) + A (Kᗮ.starProjection x) := by rw [hkerPart_zero]\n      _ = A (K.starProjection x + Kᗮ.starProjection x) := (map_add A _ _).symm\n      _ = A x := by rw [hsum]\n\n  let T : K →L[𝕜] A.range :=\n    (A.comp K.subtypeL).codRestrict A.range (fun x => ⟨(x : E), rfl⟩)\n\n  have hTker : (T : K →ₗ[𝕜] A.range).ker = ⊥ := by\n    rw [Submodule.eq_bot_iff]\n    intro x hx\n    have hxA : A (x : E) = 0 := by\n      have hxT : T x = 0 := hx\n      exact Subtype.ext_iff.1 hxT\n    have hker : (x : E) ∈ A.ker := hxA\n    have horth : (x : E) ∈ A.kerᗮ := x.property\n    have hbot : (x : E) ∈ (⊥ : Submodule 𝕜 E) := by\n      simpa [Submodule.inf_orthogonal_eq_bot (A.ker)] using Submodule.mem_inf.2 ⟨hker, horth⟩\n    exact Subtype.ext hbot\n\n  have hTsurj : (T : K →ₗ[𝕜] A.range).range = ⊤ := by\n    rw [Submodule.eq_top_iff']\n    intro y\n    rcases y.property with ⟨x, hx⟩\n    let z : K := ⟨K.starProjection x, Submodule.starProjection_apply_mem K x⟩\n    refine ⟨z, Subtype.ext ?_⟩\n    calc\n      ((T z : A.range) : E) = A (K.starProjection x) := rfl\n      _ = A x := hAproj x\n      _ = (y : E) := hx\n\n  let e : K ≃L[𝕜] A.range := ContinuousLinearEquiv.ofBijective T hTker hTsurj\n\n  let B : E →L[𝕜] E :=\n    K.subtypeL.comp ((e.symm : A.range →L[𝕜] K).comp A.range.orthogonalProjection)\n\n  have hAB : A * B = A.range.starProjection := by\n    ext x\n    have h := ContinuousLinearEquiv.ofBijective_apply_symm_apply T hTker hTsurj (A.range.orthogonalProjection x)\n    exact Subtype.ext_iff.1 h\n\n  have hBA : B * A = K.starProjection := by\n    ext x\n    let z : K := ⟨K.starProjection x, Submodule.starProjection_apply_mem K x⟩\n    let y : A.range := ⟨A x, ⟨x, rfl⟩⟩\n    have hproj : A.range.orthogonalProjection (A x) = y := by\n      exact Submodule.orthogonalProjection_mem_subspace_eq_self y\n    have hTz : T z = y := by\n      apply Subtype.ext\n      exact hAproj x\n    have hinv := ContinuousLinearEquiv.ofBijective_symm_apply_apply T hTker hTsurj z\n    calc\n      B (A x) = K.subtypeL (e.symm (A.range.orthogonalProjection (A x))) := rfl\n      _ = K.subtypeL (e.symm y) := by rw [hproj]\n      _ = K.subtypeL (e.symm (T z)) := by rw [hTz]\n      _ = K.subtypeL z := by rw [hinv]\n      _ = K.starProjection x := rfl\n\n  have hABA : A * B * A = A := by\n    rw [hAB]\n    ext x\n    exact (Submodule.starProjection_eq_self_iff (K := A.range)).2 ⟨x, rfl⟩\n\n  have hBAB : B * A * B = B := by\n    rw [hBA]\n    ext x\n    have hBmem : B x ∈ K := (e.symm (A.range.orthogonalProjection x)).property\n    exact (Submodule.starProjection_eq_self_iff (K := K)).2 hBmem\n\n  have hABstar : star (A * B) = A * B := by\n    rw [hAB]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection A.range)\n\n  have hBAstar : star (B * A) = B * A := by\n    rw [hBA]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection K)\n\n  exact ⟨B, hABA, hBAB, hABstar, hBAstar⟩\n\nend Hilbert\n\nend InfoGeometry.Singular.MoorePenrose\n","mtime":1778366069783}