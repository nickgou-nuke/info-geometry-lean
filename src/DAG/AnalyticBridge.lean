import DAG.CocycleBridgeActivation
import InfoGeometry.Clifford.CliffordBott
import InfoGeometry.Canonical.SplitCliffordDirectLimit

/-!
# DAG.AnalyticBridge

Checked readout of the DAG cocycle bridge into the repo-owned split Clifford
direct-limit tower.  The direct-limit construction and Bott-step maps are owned
by `InfoGeometry.Canonical.SplitCliffordDirectLimit`; this file only exposes the
names needed by the DAG layer.
-/

noncomputable section

namespace DAG.AnalyticBridge

open InfoGeometry.Canonical.SplitCliffordDirectLimit
open InfoGeometry.Canonical.SplitCliffordTensorBridge
open InfoGeometry.Clifford.CliffordBott

/-- DAG-facing alias for the repo-owned split Clifford direct limit. -/
abbrev UHFAlgebra : Type :=
  SplitCliffordInfinity

/-- DAG-facing alias for the owner stage map into the direct limit. -/
def uhfOf (n : ℕ) : SplitClNNAlg n →+* UHFAlgebra :=
  ofStage n

@[simp]
theorem uhfOf_map (m n : ℕ) (h : m ≤ n) (x : SplitClNNAlg m) :
    uhfOf n (splitCliffordMap m n h x) = uhfOf m x :=
  ofStage_map m n h x

/-! The flow below is algebraic conjugation by a square-zero exponential
truncation. No norm, topology, or analytic modular operator is asserted. -/

/-- A linear polynomial unit generated by a square-zero element. -/
def nilpotentUnit {A : Type*} [Ring A] [Algebra ℝ A] (ε : A) (t : ℝ) : A :=
  1 + t • ε

/-- Multiplication of the polynomial units adds their real parameters. -/
theorem nilpotentUnit_mul {A : Type*} [Ring A] [Algebra ℝ A]
    (ε : A) (hε : ε * ε = 0) (s t : ℝ) :
    nilpotentUnit ε s * nilpotentUnit ε t = nilpotentUnit ε (s + t) := by
  unfold nilpotentUnit
  rw [add_mul, one_mul, mul_add, mul_one]
  have h_smul_mul : (s • ε) * (t • ε) = (s * t) • (ε * ε) := by
    rw [smul_mul_assoc, mul_smul_comm, smul_smul]
  rw [h_smul_mul, hε, smul_zero, add_zero, add_smul]
  abel

/-- Conjugation by the nilpotent polynomial unit on an algebra element. -/
def nilpotentInnerAction {A : Type*} [Ring A] [Algebra ℝ A]
    (ε : A) (t : ℝ) (x : A) : A :=
  nilpotentUnit ε t * x * nilpotentUnit ε (-t)

/-- The square-zero polynomial conjugations compose by addition of parameters. -/
theorem nilpotentInnerAction_add {A : Type*} [Ring A] [Algebra ℝ A]
    (ε : A) (hε : ε * ε = 0) (s t : ℝ) (x : A) :
    nilpotentInnerAction ε s (nilpotentInnerAction ε t x) =
      nilpotentInnerAction ε (s + t) x := by
  unfold nilpotentInnerAction
  calc
    (nilpotentUnit ε s * (nilpotentUnit ε t * x * nilpotentUnit ε (-t))) *
        nilpotentUnit ε (-s)
      = (nilpotentUnit ε s * nilpotentUnit ε t) * x *
          (nilpotentUnit ε (-t) * nilpotentUnit ε (-s)) := by noncomm_ring
    _ = nilpotentUnit ε (s + t) * x * nilpotentUnit ε (-(s + t)) := by
      rw [nilpotentUnit_mul ε hε s t, nilpotentUnit_mul ε hε (-t) (-s)]
      congr 2
      calc
        -t + -s = -(t + s) := (neg_add t s).symm
        _ = -(s + t) := by rw [add_comm t s]

/-- The finite-stage flow, represented at stage `1 + n` with its lifted seed. -/
def finiteFlow (n : ℕ) (t : ℝ) (x : SplitClNNAlg (1 + n)) :
    SplitClNNAlg (1 + n) :=
  nilpotentInnerAction (stableNilpotentShieldStage n) t x

/-- Finite-stage composition law for the noncommutative inner action. -/
theorem finiteFlow_add (n : ℕ) (s t : ℝ) (x : SplitClNNAlg (1 + n)) :
    finiteFlow n s (finiteFlow n t x) = finiteFlow n (s + t) x := by
  exact nilpotentInnerAction_add (stableNilpotentShieldStage n)
    (stableNilpotentShieldStage_sq n) s t x

/-- The direct-limit flow is conjugation by the lifted square-zero shield. -/
def uhfModularFlow (t : ℝ) : UHFAlgebra → UHFAlgebra :=
  nilpotentInnerAction clInfinityNilpotentShield t

/-- The finite-stage action commutes with the tower maps. -/
theorem flow_commutes_with_splitCliffordMap
    (m n : ℕ) (h : m ≤ n) (t : ℝ) (x : SplitClNNAlg (1 + m)) :
    finiteFlow n t (splitCliffordMap (1 + m) (1 + n)
      (Nat.add_le_add_left h 1) x) =
      splitCliffordMap (1 + m) (1 + n) (Nat.add_le_add_left h 1)
        (finiteFlow m t x) := by
  let f := splitCliffordMap (1 + m) (1 + n) (Nat.add_le_add_left h 1)
  have hseed : f (stableNilpotentShieldStage m) = stableNilpotentShieldStage n := by
    simpa [f, stableNilpotentShieldStage] using
      (splitCliffordMap_apply_trans 1 (1 + m) (1 + n)
        (Nat.le_add_right 1 m) (Nat.add_le_add_left h 1) finiteNilpotentShield).symm
  change nilpotentInnerAction (stableNilpotentShieldStage n) t (f x) =
    f (nilpotentInnerAction (stableNilpotentShieldStage m) t x)
  simp [nilpotentInnerAction, nilpotentUnit, hseed]

/-- The direct-limit action agrees with its finite-stage representative. -/
theorem uhfModularFlow_stage (n : ℕ) (t : ℝ) (x : SplitClNNAlg (1 + n)) :
    uhfModularFlow t (uhfOf (1 + n) x) = uhfOf (1 + n) (finiteFlow n t x) := by
  simp [uhfModularFlow, finiteFlow, nilpotentInnerAction, nilpotentUnit,
    uhfOf, stableNilpotentShieldStage_lifts, ofStage_add, ofStage_one,
    ofStage_mul, ofStage_smul]

/-- Composition law for the direct-limit algebraic inner action. -/
theorem uhfModularFlow_add (s t : ℝ) :
    uhfModularFlow (s + t) = uhfModularFlow s ∘ uhfModularFlow t := by
  funext z
  exact (nilpotentInnerAction_add clInfinityNilpotentShield
    clInfinityNilpotentShield_sq s t z).symm

/-- The owner direct-limit nilpotent shield is available through the DAG bridge. -/
theorem analytic_completion_has_nilpotent_lift :
    ∃ ε : UHFAlgebra, ε * ε = 0 :=
  cl_infty_has_nilpotent_lift

/-- Build the existing three-layer cocycle bridge from a finite two-complex. -/
def fromTwoComplex {α : Type} [BEq α] [Hashable α] (tc : TwoComplex α) :
    DAG.CocycleBridgeActivation.CocycleBridge α :=
  DAG.CocycleBridgeActivation.fromTwoComplex tc

end DAG.AnalyticBridge
