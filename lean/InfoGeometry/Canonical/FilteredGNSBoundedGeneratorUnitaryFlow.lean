import InfoGeometry.Canonical.FilteredGNSRepresentedCStarModularAutomorphism
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Analysis.CStarAlgebra.Exponential

/-!
# Bounded self-adjoint generator flow on the represented GNS closure

This is the theorem-safe bounded-generator construction used by the repository;
it is not Stone's theorem for arbitrary strongly continuous unitary groups.
A self-adjoint element `G` of the concrete represented C⋆-closure determines

`U t = exp (I • (t • G))`,

a native Mathlib unitary one-parameter group.  The existing represented-flow
owner then transports its conjugation action to the completed carrier.
-/

noncomputable section

namespace CStarStateColimit.Native.FilteredGNSBoundedGeneratorUnitaryFlow

set_option synthInstance.maxHeartbeats 80000
set_option maxHeartbeats 400000
set_option linter.unusedSectionVars false

open CStarStateColimit.Native
open CStarStateColimit.Native.FilteredGNSRepresentedCStarClosure
open CStarStateColimit.Native.FilteredGNSRepresentedCStarModularAutomorphism

universe u

variable {I : Type u} [Preorder I] [Nonempty I] [IsDirectedOrder I]
variable [DecidableEq I]
variable (Stage : I → Type u)
variable [∀ i, CStarAlgebra (Stage i)]
variable [∀ i, PartialOrder (Stage i)]
variable [∀ i, StarOrderedRing (Stage i)]
variable (sys : ContinuousStarInductiveSystem Stage)
variable
  (ω : ContinuousStarInductiveSystem.CompatibleStateFamily Stage sys)

abbrev ClosureCarrier : Type _ :=
  representedCStarClosure Stage sys ω

/-- Native exponential unitary generated by a bounded self-adjoint element. -/
def boundedGeneratorUnitary
    (G : selfAdjoint (ClosureCarrier Stage sys ω))
    (t : ℝ) : unitary (ClosureCarrier Stage sys ω) :=
  selfAdjoint.expUnitary (t • G)

@[simp] theorem boundedGeneratorUnitary_zero
    (G : selfAdjoint (ClosureCarrier Stage sys ω)) :
    boundedGeneratorUnitary Stage sys ω G 0 = 1 := by
  simp [boundedGeneratorUnitary]

/-- The exponential unitary satisfies the standard additive one-parameter
law. -/
theorem boundedGeneratorUnitary_add
    (G : selfAdjoint (ClosureCarrier Stage sys ω))
    (t s : ℝ) :
    boundedGeneratorUnitary Stage sys ω G (t + s) =
      boundedGeneratorUnitary Stage sys ω G t *
        boundedGeneratorUnitary Stage sys ω G s := by
  have hcomm : Commute
      ((t • G : selfAdjoint (ClosureCarrier Stage sys ω)) :
        ClosureCarrier Stage sys ω)
      ((s • G : selfAdjoint (ClosureCarrier Stage sys ω)) :
        ClosureCarrier Stage sys ω) := by
    exact ((Commute.refl (G : ClosureCarrier Stage sys ω)).smul_left t).smul_right s
  simpa [boundedGeneratorUnitary, add_smul] using hcomm.expUnitary_add

/-- The bounded generator yields the existing standard-orientation concrete
unitary-flow packet. -/
def boundedGeneratorClosureUnitaryFlow
    (G : selfAdjoint (ClosureCarrier Stage sys ω)) :
    ClosureUnitaryFlowStd Stage sys ω where
  U := boundedGeneratorUnitary Stage sys ω G
  map_zero := boundedGeneratorUnitary_zero Stage sys ω G
  map_add := boundedGeneratorUnitary_add Stage sys ω G

/-- Completed represented modular flow generated by the concrete bounded
self-adjoint element. -/
def boundedGeneratorCompletionFlow
    (G : selfAdjoint (ClosureCarrier Stage sys ω)) :
    CompletionModularFlow Stage sys ω :=
  closureUnitaryFlowStdToCompletionFlow Stage sys ω
    (boundedGeneratorClosureUnitaryFlow Stage sys ω G)

/-- Every generated completed time-slice is isometric. -/
theorem boundedGeneratorCompletionFlow_isometry
    (G : selfAdjoint (ClosureCarrier Stage sys ω))
    (t : ℝ) :
    Isometry ((boundedGeneratorCompletionFlow Stage sys ω G).toAut t) := by
  exact liftedCompletionFlow_isometry Stage sys ω
    (closureModularFlowOfUnitaryFlow Stage sys ω
      ((boundedGeneratorClosureUnitaryFlow Stage sys ω G).toClosureUnitaryFlow)) t

@[simp] theorem norm_boundedGeneratorCompletionFlow
    (G : selfAdjoint (ClosureCarrier Stage sys ω))
    (t : ℝ)
    (x : CompletedCarrier Stage sys ω) :
    ‖(boundedGeneratorCompletionFlow Stage sys ω G).toAut t x‖ = ‖x‖ :=
  StarAlgEquiv.norm_map
    ((boundedGeneratorCompletionFlow Stage sys ω G).toAut t) x

end CStarStateColimit.Native.FilteredGNSBoundedGeneratorUnitaryFlow
