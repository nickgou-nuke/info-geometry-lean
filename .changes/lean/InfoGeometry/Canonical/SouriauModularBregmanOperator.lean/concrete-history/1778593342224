{"type":"new","contents":"import InfoGeometry.Canonical.OperatorDictionary\nimport InfoGeometry.Canonical.OperatorModularTemperatureDuality\nimport InfoGeometry.Meta.Architecture\nimport Mathlib.Analysis.Normed.Algebra.Exponential\n\nopen scoped InnerProductSpace\n\nnoncomputable section\n\n/-!\n# InfoGeometry.Canonical.SouriauModularBregmanOperator\n\nBounded operator socket for the Souriau / modular / Bregman dictionary.\n\nThis file deliberately stays in the bounded doubled-carrier lane:\n\n* `phaseAxisK = J ∘ ε` remains the internal real phase axis owned by\n  `OperatorDictionary`;\n* `modularHamiltonianK` is a separate modular/surprisal generator;\n* `Δ - I` is formalized as deviation from the identity operator, not as a trace\n  regularization;\n* Bregman/Fenchel duality is routed through an operator product together with a\n  scalar readout/pairing, not through an unpaired product alone.\n-/\n\nnamespace InfoGeometry.Canonical.SouriauModularBregmanOperator\n\nopen InfoGeometry.Krein\nopen InfoGeometry.Canonical.OperatorDictionary\nopen InfoGeometry.Canonical.OperatorModularTemperatureDuality\n\n/-! ## Product/readout sockets for operatorial Bregman geometry -/\n\nsection GenericOperatorBregman\n\nvariable {Op : Type*} [AddGroup Op]\n\n/--\nMinimal primal/dual operator socket.\n\nThe product supplies the algebraic composition channel. The readout turns that\nproduct into the scalar pairing required by convex duality.\n-/\n@[rep_depth operator]\nstructure OperatorPrimalDualSocket (Op : Type*) [AddGroup Op] where\n  /-- Operator product/composition channel. -/\n  product : Op → Op → Op\n  /-- Scalar readout; in concrete lanes this can be trace, weight, KMS state,\n      vector expectation, or a regularized functional. -/\n  readout : Op → ℝ\n  /-- Right-zero law needed for the diagonal Bregman identity. -/\n  product_zero_right_readout : ∀ X : Op, readout (product X 0) = 0\n\nnamespace OperatorPrimalDualSocket\n\nvariable (S : OperatorPrimalDualSocket Op)\n\n/-- Scalar pairing induced by product plus readout. -/\n@[rep_depth operator]\ndef pairing (X Y : Op) : ℝ :=\n  S.readout (S.product X Y)\n\n@[simp, rep_depth operator]\ntheorem pairing_zero_right (X : Op) :\n    S.pairing X 0 = 0 :=\n  S.product_zero_right_readout X\n\n@[rep_depth operator]\ntheorem pairing_eq_readout_product (X Y : Op) :\n    S.pairing X Y = S.readout (S.product X Y) :=\n  rfl\n\nend OperatorPrimalDualSocket\n\n/--\nFrobenius trace/product closures already present in the repo produce a Bregman\nsocket once the trace-readout of right multiplication by zero is supplied.\n-/\n@[rep_depth operator]\ndef operatorPrimalDualSocketOfFrobeniusClosure\n    (F : OperatorFrobeniusClosure Op)\n    (hzero : ∀ X : Op, F.trace (F.product X 0) = 0) :\n    OperatorPrimalDualSocket Op where\n  product := F.product\n  readout := F.trace\n  product_zero_right_readout := hzero\n\n/-- Operatorial Bregman divergence generated by a scalar potential and gradient. -/\n@[rep_depth operator]\ndef operatorBregman\n    (S : OperatorPrimalDualSocket Op)\n    (Φ : Op → ℝ)\n    (gradientΦ : Op → Op)\n    (X Y : Op) : ℝ :=\n  Φ X - Φ Y - S.pairing (gradientΦ Y) (X - Y)\n\n@[simp, rep_depth operator]\ntheorem operatorBregman_self\n    (S : OperatorPrimalDualSocket Op)\n    (Φ : Op → ℝ)\n    (gradientΦ : Op → Op)\n    (X : Op) :\n    operatorBregman S Φ gradientΦ X X = 0 := by\n  simp [operatorBregman]\n\n/-- Fenchel gap through the same scalar pairing socket. -/\n@[rep_depth operator]\ndef operatorFenchelGap\n    (S : OperatorPrimalDualSocket Op)\n    (Φ Ψ : Op → ℝ)\n    (X Y : Op) : ℝ :=\n  Φ X + Ψ Y - S.pairing X Y\n\n@[rep_depth operator]\ntheorem operatorFenchelGap_eq_zero_of_contact\n    (S : OperatorPrimalDualSocket Op)\n    (Φ Ψ : Op → ℝ)\n    (X Y : Op)\n    (hcontact : Φ X + Ψ Y = S.pairing X Y) :\n    operatorFenchelGap S Φ Ψ X Y = 0 := by\n  simp [operatorFenchelGap, hcontact]\n\nend GenericOperatorBregman\n\n/-! ## Bounded modular beta family on the doubled real carrier -/\n\nsection BoundedDoubledModular\n\nvariable {E : Type 0}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\n\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : CompleteSpace EndH := inferInstance\nlocal instance : SMulCommClass ℝ EndH EndH := inferInstance\nlocal instance : IsScalarTower ℝ EndH EndH := inferInstance\n\n/--\nThe identity sector `I` in the bounded doubled-carrier lane.\n\nType III removes trace-normalized density matrices as owner objects; it does not\nremove the identity operator of the standard representation.\n-/\n@[rep_depth operator]\nnoncomputable def modularIdentity : EndH :=\n  (1 : EndH)\n\n@[simp, rep_depth operator]\ntheorem modularIdentity_apply (u : H₂) :\n    modularIdentity (E := E) u = u := by\n  simp [modularIdentity]\n\n/-- Alias for the already-owned internal phase axis `K_phase = J ∘ ε`. -/\n@[rep_depth operator]\nnoncomputable def internalPhaseAxisK : EndH :=\n  InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E)\n\n/-- The internal phase axis is the old `J ∘ ε` clock axis, not the modular Hamiltonian. -/\n@[rep_depth operator]\ntheorem internalPhaseAxisK_eq_phaseAxisK :\n    internalPhaseAxisK (E := E)\n      = InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E) :=\n  rfl\n\n/-- The internal phase axis squares to `-I`. -/\n@[rep_depth operator]\ntheorem internalPhaseAxisK_sq_eq_neg_id :\n    (internalPhaseAxisK (E := E)).comp (internalPhaseAxisK (E := E))\n      = -(ContinuousLinearMap.id ℝ H₂) := by\n  simpa [internalPhaseAxisK] using\n    InfoGeometry.Canonical.OperatorDictionary.phaseAxisK_sq_eq_neg_id (E := E)\n\n/-- `Δ - I`: bounded modular deviation from the identity sector. -/\n@[rep_depth operator]\nnoncomputable def modularDeviation (Δ : EndH) : EndH :=\n  Δ - modularIdentity (E := E)\n\n@[simp, rep_depth operator]\ntheorem modularDeviation_identity :\n    modularDeviation (E := E) (modularIdentity (E := E)) = 0 := by\n  simp [modularDeviation, modularIdentity]\n\n/-- `exp(-Kmod)` as a bounded modular operator proxy. -/\n@[rep_depth operator]\nnoncomputable def modularDeltaFromHamiltonian (Kmod : EndH) : EndH :=\n  NormedSpace.exp ((-1 : ℝ) • Kmod)\n\n@[rep_depth operator]\ntheorem modularDeltaFromHamiltonian_eq_exp_neg (Kmod : EndH) :\n    modularDeltaFromHamiltonian (E := E) Kmod = NormedSpace.exp (-Kmod) := by\n  simp [modularDeltaFromHamiltonian]\n\n/-- Modular beta family `β ↦ exp(-β Kmod)`. -/\n@[rep_depth operator]\nnoncomputable def modularBetaFlow (Kmod : EndH) (β : ℝ) : EndH :=\n  NormedSpace.exp ((-β) • Kmod)\n\n@[simp, rep_depth operator]\ntheorem modularBetaFlow_zero (Kmod : EndH) :\n    modularBetaFlow (E := E) Kmod 0 = modularIdentity (E := E) := by\n  simp [modularBetaFlow, modularIdentity]\n\n@[simp, rep_depth operator]\ntheorem modularBetaFlow_one (Kmod : EndH) :\n    modularBetaFlow (E := E) Kmod 1 = modularDeltaFromHamiltonian (E := E) Kmod := by\n  simp [modularBetaFlow, modularDeltaFromHamiltonian]\n\n/-- Deviation of the beta family from the identity sector. -/\n@[rep_depth operator]\nnoncomputable def modularBetaDeviation (Kmod : EndH) (β : ℝ) : EndH :=\n  modularBetaFlow (E := E) Kmod β - modularIdentity (E := E)\n\n@[simp, rep_depth operator]\ntheorem modularBetaDeviation_zero (Kmod : EndH) :\n    modularBetaDeviation (E := E) Kmod 0 = 0 := by\n  simp [modularBetaDeviation, modularIdentity]\n\n@[rep_depth operator]\ntheorem modularBetaDeviation_one_eq_modularDeviation_delta\n    (Kmod : EndH) :\n    modularBetaDeviation (E := E) Kmod 1\n      = modularDeviation (E := E) (modularDeltaFromHamiltonian (E := E) Kmod) := by\n  simp [modularBetaDeviation, modularDeviation, modularIdentity]\n\n/-- State/operator readout on the positive Hilbert metric. -/\n@[rep_depth operator]\nnoncomputable def operatorStateExpectation (ψ : H₂) (A : EndH) : ℝ :=\n  ⟪ψ, A ψ⟫_ℝ\n\n@[simp, rep_depth operator]\ntheorem operatorStateExpectation_zero (ψ : H₂) :\n    operatorStateExpectation (E := E) ψ 0 = 0 := by\n  simp [operatorStateExpectation]\n\n/-- Product/readout socket from vector-state expectation and operator product. -/\n@[rep_depth operator]\nnoncomputable def stateExpectationProductSocket (ψ : H₂) :\n    OperatorPrimalDualSocket EndH where\n  product := fun A B => A * B\n  readout := operatorStateExpectation (E := E) ψ\n  product_zero_right_readout := by\n    intro A\n    simp [operatorStateExpectation]\n\n/-- First-quantized surprisal readout of a bounded modular Hamiltonian proxy. -/\n@[rep_depth operator]\nnoncomputable def modularSurprisalReadout (ψ : H₂) (Kmod : EndH) : ℝ :=\n  operatorStateExpectation (E := E) ψ Kmod\n\n/-- State readout of the deviation `Δ - I`. -/\n@[rep_depth operator]\nnoncomputable def modularDeviationReadout (ψ : H₂) (Δ : EndH) : ℝ :=\n  operatorStateExpectation (E := E) ψ (modularDeviation (E := E) Δ)\n\n@[simp, rep_depth operator]\ntheorem modularDeviationReadout_identity (ψ : H₂) :\n    modularDeviationReadout (E := E) ψ (modularIdentity (E := E)) = 0 := by\n  simp [modularDeviationReadout, modularDeviation, modularIdentity, operatorStateExpectation]\n\n/--\nBounded Souriau/modular family: a Lie/Souriau generator is read as a modular\nHamiltonian `Kmod`, while the associated modular operator is `exp(-Kmod)`.\n-/\n@[rep_depth thermo]\nstructure BoundedSouriauModularFamily (LieAlgebra : Type*) where\n  /-- Operator-valued moment/Hamiltonian observable. -/\n  lieObservable : LieAlgebra → EndH\n  /-- Souriau inverse-temperature / Lie-algebra coordinate. -/\n  beta : LieAlgebra\n  /-- Modular Hamiltonian / relative surprisal generator. -/\n  modularHamiltonianK : EndH\n  /-- Calibration: the modular Hamiltonian is the beta-selected Souriau observable. -/\n  modularHamiltonianK_eq_lieObservable_beta :\n    modularHamiltonianK = lieObservable beta\n\nnamespace BoundedSouriauModularFamily\n\nvariable {LieAlgebra : Type*}\nvariable (F : BoundedSouriauModularFamily (E := E) LieAlgebra)\n\n/-- Associated bounded modular operator proxy `Δ = exp(-Kmod)`. -/\n@[rep_depth operator]\nnoncomputable def modularDelta : EndH :=\n  modularDeltaFromHamiltonian (E := E) F.modularHamiltonianK\n\n@[rep_depth operator]\ntheorem modularDelta_eq_betaFlow_one :\n    F.modularDelta = modularBetaFlow (E := E) F.modularHamiltonianK 1 := by\n  simp [modularDelta]\n\n/-- The family-level `Δ - I` deviation. -/\n@[rep_depth operator]\nnoncomputable def deltaDeviation : EndH :=\n  modularDeviation (E := E) F.modularDelta\n\n@[rep_depth operator]\ntheorem deltaDeviation_eq_betaOneDeviation :\n    F.deltaDeviation = modularBetaDeviation (E := E) F.modularHamiltonianK 1 := by\n  simp [deltaDeviation, modularDelta, modularBetaDeviation, modularDeviation, modularIdentity]\n\n@[rep_depth thermo]\ntheorem modularHamiltonianK_eq_lieObservable_beta_theorem :\n    F.modularHamiltonianK = F.lieObservable F.beta :=\n  F.modularHamiltonianK_eq_lieObservable_beta\n\nend BoundedSouriauModularFamily\n\n/--\nSouriau/Bregman packet on the bounded modular operator lane.\n\nThe Bregman divergence is operatorial, but scalar-valued only after the chosen\nproduct/readout socket is supplied.\n-/\n@[rep_depth thermo]\nstructure SouriauOperatorialBregmanPacket (LieAlgebra : Type*) where\n  family : BoundedSouriauModularFamily (E := E) LieAlgebra\n  socket : OperatorPrimalDualSocket EndH\n  potential : EndH → ℝ\n  gradient : EndH → EndH\n\nnamespace SouriauOperatorialBregmanPacket\n\nvariable {LieAlgebra : Type*}\nvariable (P : SouriauOperatorialBregmanPacket (E := E) LieAlgebra)\n\n/-- Operatorial Bregman divergence for the packet potential. -/\n@[rep_depth thermo]\ndef divergence (X Y : EndH) : ℝ :=\n  operatorBregman P.socket P.potential P.gradient X Y\n\n@[simp, rep_depth thermo]\ntheorem divergence_self (X : EndH) :\n    P.divergence X X = 0 := by\n  simp [divergence]\n\n/-- Bregman divergence after passing to the modular deviations `Δ - I`. -/\n@[rep_depth thermo]\nnoncomputable def modularDeviationDivergence (Δ₁ Δ₀ : EndH) : ℝ :=\n  P.divergence (modularDeviation (E := E) Δ₁) (modularDeviation (E := E) Δ₀)\n\n@[simp, rep_depth thermo]\ntheorem modularDeviationDivergence_self (Δ : EndH) :\n    P.modularDeviationDivergence Δ Δ = 0 := by\n  simp [modularDeviationDivergence]\n\n/-- Family-level modular deviation divergence at the same Souriau beta point is zero. -/\n@[simp, rep_depth thermo]\ntheorem family_deltaDeviation_divergence_self :\n    P.divergence P.family.deltaDeviation P.family.deltaDeviation = 0 := by\n  simp [divergence]\n\nend SouriauOperatorialBregmanPacket\n\nend BoundedDoubledModular\n\nend InfoGeometry.Canonical.SouriauModularBregmanOperator\n","mtime":1778593342224}