import Mathlib.Algebra.Polynomial.Eval.Defs
import Mathlib.Algebra.Ring.Subring.Basic
import Mathlib.Tactic.NoncommRing

/-!
# Polynomial evaluation and the Klein inversion relation

Ordinary polynomial variables are central. Evaluating them in a noncommutative
ring is multiplicative precisely when the evaluation point commutes with the
coefficient image. The ordered identities below instead assume `x*u=u⁻¹*x`;
`x` need not be invertible. Their explicit residuals prevent confusing these
two conventions. Centrality is stated only for the generated subring.
-/

namespace InfoGeometry.Algebra.KleinInversionPolynomial

open Polynomial

/-- The native sufficient condition for multiplicative evaluation is also necessary. -/
theorem eval₂_mul_forall_iff {R A : Type*} [Semiring R] [Semiring A]
    (f : R →+* A) (x : A) :
    (∀ p q : R[X], (p * q).eval₂ f x = p.eval₂ f x * q.eval₂ f x) ↔
      ∀ a : R, Commute (f a) x := by
  constructor
  · intro h a
    change f a * x = x * f a
    simpa only [eval₂_X_mul, eval₂_X, eval₂_C] using h X (C a)
  · intro h p q
    exact eval₂_mul_noncomm f x (fun k => h (q.coeff k))

/-- A central formal variable produces exactly the commutator defect on evaluation. -/
theorem eval₂_X_mul_C_defect {R A : Type*} [Semiring R] [Ring A]
    (f : R →+* A) (x : A) (a : R) :
    ((X : R[X]) * C a).eval₂ f x - X.eval₂ f x * (C a).eval₂ f x =
      f a * x - x * f a := by
  simp only [eval₂_X_mul, eval₂_X, eval₂_C]

section Ring

variable {A : Type*} [Ring A]

/-- Inversion transport holds for a possibly noninvertible skew element. -/
theorem inversion_inverse (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    x * (↑(u⁻¹) : A) = (u : A) * x := by
  have h' := congrArg (fun z : A => (u : A) * z * (↑(u⁻¹) : A)) h
  simpa only [mul_assoc, Units.mul_inv_cancel_left, Units.mul_inv, mul_one] using h'.symm

theorem symmetric_commutes (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    x * ((u : A) + (↑(u⁻¹) : A)) = ((u : A) + (↑(u⁻¹) : A)) * x := by
  rw [mul_add, h, inversion_inverse u x h, add_mul]
  exact add_comm _ _

theorem antisymmetric_anticommutes (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    x * ((u : A) - (↑(u⁻¹) : A)) = -((u : A) - (↑(u⁻¹) : A)) * x := by
  rw [mul_sub, h, inversion_inverse u x h]
  noncomm_ring

theorem square_commutes (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    x ^ 2 * (u : A) = (u : A) * x ^ 2 := by
  calc
    x ^ 2 * (u : A) = x * (x * (u : A)) := by rw [pow_two, mul_assoc]
    _ = x * ((↑(u⁻¹) : A) * x) := by rw [h]
    _ = (x * (↑(u⁻¹) : A)) * x := (mul_assoc _ _ _).symm
    _ = ((u : A) * x) * x := by rw [inversion_inverse u x h]
    _ = (u : A) * x ^ 2 := by rw [pow_two, mul_assoc]

/-- The symmetric element centralizes the subring generated by the supplied elements. -/
theorem generated_le_symmetric_centralizer (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    Subring.closure ({(u : A), (↑(u⁻¹) : A), x} : Set A) ≤
      Subring.centralizer ({(u : A) + (↑(u⁻¹) : A)} : Set A) := by
  apply Subring.closure_le.mpr
  intro y hy
  apply Subring.mem_centralizer_iff.mpr
  intro z hz
  have hz' : z = (u : A) + (↑(u⁻¹) : A) := Set.mem_singleton_iff.mp hz
  subst z
  rcases hy with rfl | rfl | rfl
  · simp only [add_mul, mul_add, Units.mul_inv, Units.inv_mul]
  · simp only [add_mul, mul_add, Units.mul_inv, Units.inv_mul]
  · exact (symmetric_commutes u _ h).symm

/-- The square centralizes the same generated subring, without an ambient-center claim. -/
theorem generated_le_square_centralizer (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    Subring.closure ({(u : A), (↑(u⁻¹) : A), x} : Set A) ≤
      Subring.centralizer ({x ^ 2} : Set A) := by
  apply Subring.closure_le.mpr
  intro y hy
  apply Subring.mem_centralizer_iff.mpr
  intro z hz
  have hz' : z = x ^ 2 := Set.mem_singleton_iff.mp hz
  subst z
  rcases hy with rfl | rfl | rfl
  · exact square_commutes u x h
  · simpa only [inv_inv] using square_commutes u⁻¹ x (inversion_inverse u x h)
  · simp only [pow_two, mul_assoc]

/-- The general conclusion is involutivity, not equality to a scalar sign. -/
theorem commute_iff_square_eq_one (u g : Aˣ)
    (h : (g : A) * (u : A) = (↑(u⁻¹) : A) * (g : A)) :
    Commute (g : A) (u : A) ↔ (u : A) ^ 2 = 1 := by
  constructor
  · intro hc
    have hi : (u : A) = (↑(u⁻¹) : A) := by
      have he := congrArg (fun z : A => z * (↑(g⁻¹) : A)) (hc.eq.symm.trans h)
      simpa only [mul_assoc, Units.mul_inv, mul_one] using he
    calc
      (u : A) ^ 2 = (u : A) * (↑(u⁻¹) : A) := by rw [pow_two, ← hi]
      _ = 1 := Units.mul_inv u
  · intro hs
    have hi : (↑(u⁻¹) : A) = (u : A) := by
      calc
        (↑(u⁻¹) : A) = (↑(u⁻¹) : A) * (u : A) ^ 2 := by rw [hs, mul_one]
        _ = (u : A) := by rw [pow_two, ← mul_assoc, Units.inv_mul, one_mul]
    change (g : A) * (u : A) = (u : A) * (g : A)
    simpa only [hi] using h

/-- The central formal variable has the usual inverse-root factorization. -/
theorem central_inverse_factorization (u : Aˣ) :
    (X - C (u : A)) * (X - C (↑(u⁻¹) : A)) =
      (X : A[X]) ^ 2 - C ((u : A) + (↑(u⁻¹) : A)) * X + 1 := by
  simp only [sub_mul, mul_sub, X_mul, ← C_mul, Units.mul_inv, C_1, C_add, add_mul]
  noncomm_ring

/-- The skew product with the inverse and a plus sign really does factor `x²-1`. -/
theorem skew_inverse_plus_factorization (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    (x - (u : A)) * (x + (↑(u⁻¹) : A)) = x ^ 2 - 1 := by
  simp only [sub_mul, mul_add, Units.mul_inv, inversion_inverse u x h]
  noncomm_ring

/-- Two minus signs in the skew convention give `2*u`, not `u+u⁻¹`. -/
theorem skew_inverse_minus_factorization (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    (x - (u : A)) * (x - (↑(u⁻¹) : A)) = x ^ 2 - 2 * (u : A) * x + 1 := by
  simp only [sub_mul, mul_sub, Units.mul_inv, inversion_inverse u x h]
  noncomm_ring

/-- Exact residual when a central-variable quadratic is substituted into the skew convention. -/
theorem skew_inverse_minus_residual (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    (x - (u : A)) * (x - (↑(u⁻¹) : A)) -
        (x ^ 2 - ((u : A) + (↑(u⁻¹) : A)) * x + 1) =
      ((↑(u⁻¹) : A) - (u : A)) * x := by
  rw [skew_inverse_minus_factorization u x h]
  noncomm_ring

/-- The same-root product has both a commutator term and the actual square `u²`. -/
theorem skew_same_root_factorization (u : Aˣ) (x : A)
    (h : x * (u : A) = (↑(u⁻¹) : A) * x) :
    (x - (u : A)) * (x + (u : A)) =
      x ^ 2 - (u : A) ^ 2 + ((↑(u⁻¹) : A) - (u : A)) * x := by
  simp only [sub_mul, mul_add, h]
  noncomm_ring

/-- Central scalar factors retain their ordinary identity in every ring. -/
theorem scalar_tripotent_factorization (x : A) :
    x * (x - 1) * (x + 1) = x ^ 3 - x := by
  noncomm_ring

end Ring

end InfoGeometry.Algebra.KleinInversionPolynomial
