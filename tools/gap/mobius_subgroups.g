# Construct SL(2, 11) using GAP's matrix group constructors
sl2_11 := SL(2, 11);

# Construct PSL(2, 11)
psl2_11 := PSL(2, 11);

# Calculate the size of PSL(2, 11)
size_psl := Size(psl2_11);
Print("Size of PSL(2, 11): ", size_psl, "\n");

# Verify it matches the theoretical order 11*(11^2-1)/2 = 660
theory_size := 11 * (11^2 - 1) / 2;
Print("Theoretical size: ", theory_size, "\n");
if size_psl = theory_size then
    Print("Size matches theoretical order.\n");
else
    Print("Size DOES NOT match theoretical order.\n");
fi;

# Elements modulo 11
Z11 := Z(11);
one := Z11^0;
zero := 0 * Z11;

# S = [0, -1; 1, 0] mod 11
S_mat := [ [ zero, -one ],
           [ one, zero ] ];

# T = [1, 1; 0, 1] mod 11
T_mat := [ [ one, one ],
           [ zero, one ] ];

# Modular subgroup generated by S and T
mod_subgroup := Group(S_mat, T_mat);

# Calculate its size within PSL(2, 11)
# The image of mod_subgroup in PSL(2, 11) is its quotient by its intersection with the center of SL(2, 11).
# The center of SL(2, 11) is generated by -I
minus_I := [ [ -one, zero ],
             [ zero, -one ] ];
center_sl2_11 := Group(minus_I);

intersection := Intersection(mod_subgroup, center_sl2_11);
size_in_psl := Size(mod_subgroup) / Size(intersection);

Print("Size of modular subgroup in PSL(2, 11): ", size_in_psl, "\n");

quit;
