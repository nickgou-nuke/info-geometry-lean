import InfoGeometry.OperatorAlgebra.LieJordanBoundaryCalculus
import InfoGeometry.OperatorAlgebra.LieJordanBoundaryComposition
import InfoGeometry.Core.IdempotentCartan

/-!
# Peirce dissipator trinity as native noncommutative endomorphisms

All channels here are elements of `Module.End R A`. Their multiplication is
composition, and their coefficients live in the existing associative algebra.
The only hypothesis for the Peirce specialization is idempotence of `p`.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceDissipatorTrinity

open InfoGeometry.Core.PeirceDecomposition
open InfoGeometry.OperatorAlgebra.LieJordanBoundaryCalculus
open InfoGeometry.OperatorAlgebra.LieJordan

attribute [local instance 100] LieRing.ofAssociativeRing

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

private theorem squareZero_nested (u : A) (hu : u * u = 0) (x : A) :
    u * (u * x) = 0 := by
  rw [← mul_assoc, hu, zero_mul]

/-- The two directed Peirce operators carry opposite root weights under the
Cartan reflection, in an arbitrary associative operator algebra. -/
theorem cartan_reflection_corner_root_weights {p a b : A} (hp : p * p = p) :
    ⁅InfoGeometry.Core.IdempotentCartan.reflection p, component10 p a⁆ =
      (2 : ℕ) • component10 p a ∧
    ⁅InfoGeometry.Core.IdempotentCartan.reflection p, component01 p b⁆ =
      -((2 : ℕ) • component01 p b) := by
  constructor
  · change InfoGeometry.Core.IdempotentCartan.reflection p * component10 p a -
      component10 p a * InfoGeometry.Core.IdempotentCartan.reflection p = _
    simp only [InfoGeometry.Core.IdempotentCartan.reflection, two_nsmul,
      component10, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]
  · change InfoGeometry.Core.IdempotentCartan.reflection p * component01 p b -
      component01 p b * InfoGeometry.Core.IdempotentCartan.reflection p = _
    simp only [InfoGeometry.Core.IdempotentCartan.reflection, two_nsmul,
      component01, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]

/-- The Jordan mass and commutator spin of opposite Peirce corners have
Cartan weight zero: both commute with the idempotent reflection. -/
theorem cartan_reflection_commutes_mass_spin {p a b : A} (hp : p * p = p) :
    ⁅InfoGeometry.Core.IdempotentCartan.reflection p,
      component10 p a * component01 p b + component01 p b * component10 p a⁆ = 0 ∧
    ⁅InfoGeometry.Core.IdempotentCartan.reflection p,
      component10 p a * component01 p b - component01 p b * component10 p a⁆ = 0 := by
  constructor <;>
    change InfoGeometry.Core.IdempotentCartan.reflection p * _ - _ *
      InfoGeometry.Core.IdempotentCartan.reflection p = 0 <;>
    simp only [InfoGeometry.Core.IdempotentCartan.reflection, two_nsmul,
      component10, component01, complementIdempotent] <;>
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]

/-- The two same-corner sandwich operators. -/
def sameCornerChannel (u v : A) : Module.End R A :=
  LieJordan.sandwichOp R u u + LieJordan.sandwichOp R v v

/-- Cross-corner dissipator, represented as an endomorphism. This includes
the loss anticommutator in addition to the cross-branch gain term; the gain
term alone is `LieJordan.crossTransport`. In particular, its action on an
off-diagonal generator need not vanish even when the gain term does. -/
def crossDissipator (u v : A) : Module.End R A :=
  (2 : ℕ) • LieJordan.crossTransport R u v -
    InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R) (u * v + v * u)

/-- Sum-channel dissipator on the noncommutative algebra. -/
def sumDissipator (u v : A) : Module.End R A :=
  (2 : ℕ) • (LieJordan.crossTransport R u v + sameCornerChannel (R := R) u v) -
    InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R) (u * v + v * u)

/-- Difference-channel dissipator on the noncommutative algebra. -/
def differenceDissipator (u v : A) : Module.End R A :=
  (2 : ℕ) • (LieJordan.crossTransport R u v - sameCornerChannel (R := R) u v) -
    InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R) (u * v + v * u)

/-- Signed Peirce spin dissipator: the oriented two-sided channel plus the
Jordan loss term generated by the commutator spin. -/
def spinDissipator (u v : A) : Module.End R A :=
  (2 : ℕ) • InfoGeometry.OperatorAlgebra.LieJordanBoundaryCalculus.orientedTransport
      (R := R) u v +
    InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R) (u * v - v * u)

/-- The cross and same-corner operators combine to the sandwich by `u + v`. -/
theorem cross_add_sameCorner (u v : A) :
    LieJordan.crossTransport R u v + sameCornerChannel (R := R) u v =
      LieJordan.sandwichOp R (u + v) (u + v) := by
  ext x
  change (u * x * v + v * x * u) + (u * x * u + v * x * v) =
    (u + v) * x * (u + v)
  noncomm_ring

/-- The signed channel is the negative sandwich by `u - v`. -/
theorem cross_sub_sameCorner (u v : A) :
    LieJordan.crossTransport R u v - sameCornerChannel (R := R) u v =
      -(LieJordan.sandwichOp R (u - v) (u - v)) := by
  ext x
  change (u * x * v + v * x * u) - (u * x * u + v * x * v) =
    -((u - v) * x * (u - v))
  noncomm_ring

/-- Opposite square-zero Peirce corners make the sum coefficient square to
their Jordan product. -/
theorem even_coefficient_sq {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    (u + v) * (u + v) = u * v + v * u := by
  noncomm_ring [hu, hv]

/-- The difference coefficient has the opposite square. -/
theorem odd_coefficient_sq {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    (u - v) * (u - v) = -(u * v + v * u) := by
  noncomm_ring [hu, hv]

/-- The sum-channel operator is the negative composed inner derivation. -/
theorem sumDissipator_eq_neg_doubleLie {u v : A} (hu : u * u = 0)
    (hv : v * v = 0) :
    sumDissipator (R := R) u v =
      -(LieJordan.lieOp R (u + v) * LieJordan.lieOp R (u + v)) := by
  rw [sumDissipator, cross_add_sameCorner]
  rw [two_nsmul]
  ext x
  change ((u + v) * x * (u + v) + (u + v) * x * (u + v)) -
      ((u * v + v * u) * x + x * (u * v + v * u)) =
    -((u + v) * ((u + v) * x - x * (u + v)) -
      ((u + v) * x - x * (u + v)) * (u + v))
  noncomm_ring [hu, hv, squareZero_nested u hu x, squareZero_nested v hv x]

/-- The difference-channel operator is the composed inner derivation. -/
theorem differenceDissipator_eq_doubleLie {u v : A} (hu : u * u = 0)
    (hv : v * v = 0) :
    differenceDissipator (R := R) u v =
      LieJordan.lieOp R (u - v) * LieJordan.lieOp R (u - v) := by
  rw [differenceDissipator, cross_sub_sameCorner]
  rw [two_nsmul]
  ext x
  change (-((u - v) * x * (u - v)) + -((u - v) * x * (u - v))) -
      ((u * v + v * u) * x + x * (u * v + v * u)) =
    (u - v) * ((u - v) * x - x * (u - v)) -
      ((u - v) * x - x * (u - v)) * (u - v)
  noncomm_ring [hu, hv, squareZero_nested u hu x, squareZero_nested v hv x]

/-- A cyclic additive functional annihilates every inner commutator. -/
theorem cyclicFunctional_lieOp_apply_eq_zero {S : Type*} [AddCommGroup S]
    (τ : A →+ S) (hτ : ∀ x y : A, τ (x * y) = τ (y * x)) (q x : A) :
    τ (LieJordan.lieOp R q x) = 0 := by
  change τ (q * x - x * q) = 0
  rw [map_sub, hτ q x]
  exact sub_self _

/-- Under the square-zero channel hypotheses, the mass dissipator is an outer
Lie divergence and vanishes under every cyclic additive functional. -/
theorem sumDissipator_cyclicFunctional_eq_zero {S : Type*} [AddCommGroup S]
    (τ : A →+ S) (hτ : ∀ x y : A, τ (x * y) = τ (y * x))
    {u v : A} (hu : u * u = 0) (hv : v * v = 0) (x : A) :
    τ (sumDissipator (R := R) u v x) = 0 := by
  rw [sumDissipator_eq_neg_doubleLie (R := R) hu hv]
  change τ (-LieJordan.lieOp R (u + v)
    (LieJordan.lieOp R (u + v) x)) = 0
  rw [map_neg]
  exact neg_eq_zero.mpr (cyclicFunctional_lieOp_apply_eq_zero τ hτ _ _)

/-- Under the square-zero channel hypotheses, the spin dissipator is an outer
Lie divergence and vanishes under every cyclic additive functional. -/
theorem differenceDissipator_cyclicFunctional_eq_zero {S : Type*}
    [AddCommGroup S] (τ : A →+ S)
    (hτ : ∀ x y : A, τ (x * y) = τ (y * x))
    {u v : A} (hu : u * u = 0) (hv : v * v = 0) (x : A) :
    τ (differenceDissipator (R := R) u v x) = 0 := by
  rw [differenceDissipator_eq_doubleLie (R := R) hu hv]
  change τ (LieJordan.lieOp R (u - v)
    (LieJordan.lieOp R (u - v) x)) = 0
  exact cyclicFunctional_lieOp_apply_eq_zero τ hτ _ _

/-- Exact algebraic action of the signed Peirce mirror
(`differenceDissipator`) on five elements generated by a reflexive
square-zero pair. The displayed rates are left multiplication by the mass
operator; this statement alone does not assert a scalar spectrum or a
numerical spectral gap. -/
theorem differenceDissipator_reflexive_pair_actions {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    differenceDissipator (R := R) u v 1 = 0 ∧
    differenceDissipator (R := R) u v (u * v + v * u) = 0 ∧
    differenceDissipator (R := R) u v (u - v) = 0 ∧
    differenceDissipator (R := R) u v (u + v) =
      -((4 : ℕ) • ((u * v + v * u) * (u + v))) ∧
    differenceDissipator (R := R) u v (u * v - v * u) =
      -((4 : ℕ) • ((u * v + v * u) * (u * v - v * u))) := by
  have hMass : (u * v + v * u) * (u * v + v * u) = u * v + v * u := by
    have hUV : (u * v) * (u * v) = u * v := by
      calc
        _ = (u * v * u) * v := by simp only [mul_assoc]
        _ = u * v := by rw [huv]
    have hVU : (v * u) * (v * u) = v * u := by
      calc
        _ = (v * u * v) * u := by simp only [mul_assoc]
        _ = v * u := by rw [hvu]
    have hUVVU : (u * v) * (v * u) = 0 := by
      calc
        _ = u * ((v * v) * u) := by simp only [mul_assoc]
        _ = 0 := by rw [hv]; simp
    have hVUUV : (v * u) * (u * v) = 0 := by
      calc
        _ = v * ((u * u) * v) := by simp only [mul_assoc]
        _ = 0 := by rw [hu]; simp
    simp only [add_mul, mul_add]
    rw [hUV, hUVVU, hVUUV, hVU]
    abel
  have hUUV : u * (u * v) = 0 := by rw [← mul_assoc, hu, zero_mul]
  have hVVU : v * (v * u) = 0 := by rw [← mul_assoc, hv, zero_mul]
  have hUVV : (u * v) * v = 0 := by rw [mul_assoc, hv, mul_zero]
  have hVUU : (v * u) * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have huvu' : u * (v * u) = u := by rw [← mul_assoc, huv]
  have hvuv' : v * (u * v) = v := by rw [← mul_assoc, hvu]
  have hAction (x : A) :
      differenceDissipator (R := R) u v x =
        (2 : ℕ) • (u * x * v + v * x * u - (u * x * u + v * x * v)) -
          ((u * v + v * u) * x + x * (u * v + v * u)) := by
    simp [differenceDissipator, sameCornerChannel,
      InfoGeometry.OperatorAlgebra.LieJordan.sandwichOp,
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [hAction 1]
    noncomm_ring [hu, hv]
  · rw [hAction (u * v + v * u)]
    noncomm_ring [hu, hv, huv, hvu, hMass, hUUV, hVVU, hUVV, hVUU, huvu', hvuv']
  · rw [hAction (u - v)]
    noncomm_ring [hu, hv, huv, hvu, hUUV, hVVU, hUVV, hVUU, huvu', hvuv']
  · rw [hAction (u + v)]
    noncomm_ring [hu, hv, huv, hvu, hUUV, hVVU, hUVV, hVUU, huvu', hvuv']
  · rw [hAction (u * v - v * u)]
    noncomm_ring [hu, hv, huv, hvu, hMass, hUUV, hVVU, hUVV, hVUU, huvu', hvuv']

/-- Twice the cross operator is the sum of the two full channel operators. -/
theorem twice_crossDissipator_eq_sum_add_difference (u v : A) :
    (2 : ℕ) • crossDissipator (R := R) u v =
      sumDissipator (R := R) u v + differenceDissipator (R := R) u v := by
  rw [crossDissipator, sumDissipator, differenceDissipator]
  simp only [two_nsmul]
  abel

/-- Their operator difference isolates four times the same-corner channel. -/
theorem sum_sub_difference_eq_four_sameCorner (u v : A) :
    sumDissipator (R := R) u v - differenceDissipator (R := R) u v =
      (4 : ℕ) • sameCornerChannel (R := R) u v := by
  rw [sumDissipator, differenceDissipator]
  rw [show (4 : ℕ) = 2 + 2 from rfl, add_nsmul, two_nsmul]
  simp only [two_nsmul]
  abel

/-- The chiral dissipator trinity decomposition for arbitrary operators in
an associative algebra. The symmetric cross channel is the midpoint of the
sum and difference channels, while their difference isolates four times the
same-corner channel. This is an identity in `Module.End R A`; it does not
assert a scalar spectrum or a numerical spectral gap. -/
theorem chiral_dissipator_trinity_decomposition (u v : A) :
    (2 : ℕ) • crossDissipator (R := R) u v =
        sumDissipator (R := R) u v + differenceDissipator (R := R) u v ∧
      sumDissipator (R := R) u v - differenceDissipator (R := R) u v =
        (4 : ℕ) • sameCornerChannel (R := R) u v := by
  exact ⟨twice_crossDissipator_eq_sum_add_difference (R := R) u v,
    sum_sub_difference_eq_four_sameCorner (R := R) u v⟩

/-- The symmetric Peirce cross channel annihilates the sum of two
square-zero directed corners. -/
theorem crossTransport_apply_add_eq_zero {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    LieJordan.crossTransport R u v (u + v) = 0 := by
  change u * (u + v) * v + v * (u + v) * u = 0
  noncomm_ring [hu, hv]

/-- The same cross channel annihilates the difference of two square-zero
directed corners. -/
theorem crossTransport_apply_sub_eq_zero {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    LieJordan.crossTransport R u v (u - v) = 0 := by
  change u * (u - v) * v + v * (u - v) * u = 0
  noncomm_ring [hu, hv]

/-- Exact symmetric cross-dissipator actions on the sum and difference of a
square-zero pair. The rate remains left multiplication by the Jordan mass;
it need not be a scalar eigenvalue. -/
theorem crossDissipator_apply_add_sub_of_squareZero {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    crossDissipator (R := R) u v (u + v) =
        -((2 : ℕ) • ((u * v + v * u) * (u + v))) ∧
    crossDissipator (R := R) u v (u - v) =
        -((2 : ℕ) • ((u * v + v * u) * (u - v))) := by
  have hMassComm (x : A) (hx : x = u + v ∨ x = u - v) :
      (u * v + v * u) * x = x * (u * v + v * u) := by
    have huuV := squareZero_nested u hu v
    have hvvU := squareZero_nested v hv u
    rcases hx with h | h
    · subst x
      noncomm_ring [hu, hv, huuV, hvvU]
    · subst x
      noncomm_ring [hu, hv, huuV, hvvU]
  constructor
  · have hcomm := hMassComm (u + v) (Or.inl rfl)
    change (2 : ℕ) • LieJordan.crossTransport R u v (u + v) -
      ((u * v + v * u) * (u + v) + (u + v) * (u * v + v * u)) = _
    rw [crossTransport_apply_add_eq_zero hu hv, hcomm]
    simp only [two_nsmul]
    abel
  · have hcomm := hMassComm (u - v) (Or.inr rfl)
    change (2 : ℕ) • LieJordan.crossTransport R u v (u - v) -
      ((u * v + v * u) * (u - v) + (u - v) * (u * v + v * u)) = _
    rw [crossTransport_apply_sub_eq_zero hu hv, hcomm]
    simp only [two_nsmul]
    abel

/-- The signed spin dissipator annihilates the Dirac sum and axial difference
of every square-zero pair. -/
theorem spinDissipator_annihilates_sum_difference {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    spinDissipator (R := R) u v (u + v) = 0 ∧
    spinDissipator (R := R) u v (u - v) = 0 := by
  have hAction (x : A) : spinDissipator (R := R) u v x =
      (2 : ℕ) • (u * x * v - v * x * u) +
        ((u * v - v * u) * x + x * (u * v - v * u)) := by
    change (2 : ℕ) •
        (InfoGeometry.OperatorAlgebra.LieJordanBoundaryCalculus.orientedTransport
          (R := R) u v x) +
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R)
        (u * v - v * u) x = _
    simp [InfoGeometry.OperatorAlgebra.LieJordanBoundaryCalculus.orientedTransport_apply,
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft]
  have huuV := squareZero_nested u hu v
  have hvvU := squareZero_nested v hv u
  have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
  have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have hVuuV : v * (u * (u * v)) = 0 := by rw [huuV, mul_zero]
  have hUvvU : u * (v * (v * u)) = 0 := by rw [hvvU, mul_zero]
  constructor
  · rw [hAction (u + v)]
    noncomm_ring [hu, hv, huuV, hvvU, hUVV, hVUU, hVuuV, hUvvU]
  · rw [hAction (u - v)]
    noncomm_ring [hu, hv, huuV, hvvU]

/-- The signed spin dissipator fixes the commutator sector of every
square-zero operator pair. The two horizon gain actions retain their exact
operator products, without selecting coordinates or scalar eigenvalues. -/
theorem squareZero_pair_spin_and_horizon_actions {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    spinDissipator (R := R) u v (u * v - v * u) = 0 ∧
    crossTransport R u v (u * v + v * u) =
      (u * v + v * u) * (u * v + v * u) ∧
    InfoGeometry.OperatorAlgebra.LieJordanBoundaryCalculus.orientedTransport
        (R := R) u v (u * v - v * u) =
      -((u * v - v * u) * (u * v - v * u)) := by
  have huuV := squareZero_nested u hu v
  have hvvU := squareZero_nested v hv u
  have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
  have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have hVuuV : v * (u * (u * v)) = 0 := by rw [huuV, mul_zero]
  have hUvvU : u * (v * (v * u)) = 0 := by rw [hvvU, mul_zero]
  refine ⟨?_, ?_, ?_⟩
  · change (2 : ℕ) • (u * (u * v - v * u) * v -
        v * (u * v - v * u) * u) +
      ((u * v - v * u) * (u * v - v * u) +
        (u * v - v * u) * (u * v - v * u)) = 0
    simp only [two_nsmul]
    noncomm_ring [hu, hv, huuV, hvvU, hUVV, hVUU]
  · change u * (u * v + v * u) * v +
      v * (u * v + v * u) * u = _
    noncomm_ring [hu, hv, hUVV, hVUU, hVuuV, hUvvU]
  · change u * (u * v - v * u) * v -
      v * (u * v - v * u) * u = _
    noncomm_ring [hu, hv, hUVV, hVUU, hVuuV, hUvvU]

/-- Exact sum/difference dissipator actions for the directed corners of an
idempotent. The symmetric channel retains its operator-valued mass factor;
the signed spin channel annihilates both sectors. -/
theorem peirce_corner_dissipator_sector_actions {p a b : A}
    (hp : p * p = p) :
    crossDissipator (R := R) (component10 p a) (component01 p b)
        (component10 p a + component01 p b) =
      -((2 : ℕ) •
        ((component10 p a * component01 p b + component01 p b * component10 p a) *
          (component10 p a + component01 p b))) ∧
    crossDissipator (R := R) (component10 p a) (component01 p b)
        (component10 p a - component01 p b) =
      -((2 : ℕ) •
        ((component10 p a * component01 p b + component01 p b * component10 p a) *
          (component10 p a - component01 p b))) ∧
    spinDissipator (R := R) (component10 p a) (component01 p b)
        (component10 p a + component01 p b) = 0 ∧
    spinDissipator (R := R) (component10 p a) (component01 p b)
        (component10 p a - component01 p b) = 0 := by
  have ha := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp a
  have hb := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp b
  rcases crossDissipator_apply_add_sub_of_squareZero (R := R) ha.1 hb.2 with
    ⟨hAdd, hSub⟩
  rcases spinDissipator_annihilates_sum_difference (R := R) ha.1 hb.2 with
    ⟨hSpinAdd, hSpinSub⟩
  exact ⟨hAdd, hSub, hSpinAdd, hSpinSub⟩

/-- Exact action of the two directed-corner dissipators on the Cartan
reflection and the identity. These are arbitrary associative-algebra
identities: the symmetric channel sends the reflection to minus four times
the commutator spin, while the signed channel fixes the reflection and sends
the identity to four times the commutator spin. -/
theorem peirce_corner_reflection_dissipator_actions {p a b : A}
    (hp : p * p = p) :
    spinDissipator (R := R) (component10 p a) (component01 p b)
        (InfoGeometry.Core.IdempotentCartan.reflection p) = 0 ∧
    spinDissipator (R := R) (component10 p a) (component01 p b) 1 =
      (4 : ℕ) •
        (component10 p a * component01 p b - component01 p b * component10 p a) ∧
    crossDissipator (R := R) (component10 p a) (component01 p b)
        (InfoGeometry.Core.IdempotentCartan.reflection p) =
      -((4 : ℕ) •
        (component10 p a * component01 p b - component01 p b * component10 p a)) := by
  let u := component10 p a
  let v := component01 p b
  let r := InfoGeometry.Core.IdempotentCartan.reflection p
  let m := u * v + v * u
  let s := u * v - v * u
  have hpu : p * u = u := by
    change p * component10 p a = component10 p a
    simp only [component10, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]
  have hup : u * p = 0 := by
    change component10 p a * p = 0
    simp only [component10, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]
  have hpv : p * v = 0 := by
    change p * component01 p b = 0
    simp only [component01, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]
  have hvp : v * p = v := by
    change component01 p b * p = component01 p b
    simp only [component01, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]
  have hru : r * u = u := by
    change InfoGeometry.Core.IdempotentCartan.reflection p * component10 p a =
      component10 p a
    simp only [InfoGeometry.Core.IdempotentCartan.reflection, two_nsmul,
      component10, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]
  have hur : u * r = -u := by
    change component10 p a * InfoGeometry.Core.IdempotentCartan.reflection p =
      -component10 p a
    simp only [InfoGeometry.Core.IdempotentCartan.reflection, two_nsmul,
      component10, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]
  have hrv : r * v = -v := by
    change InfoGeometry.Core.IdempotentCartan.reflection p * component01 p b =
      -component01 p b
    simp only [InfoGeometry.Core.IdempotentCartan.reflection, two_nsmul,
      component01, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]
  have hvr : v * r = v := by
    change component01 p b * InfoGeometry.Core.IdempotentCartan.reflection p =
      component01 p b
    simp only [InfoGeometry.Core.IdempotentCartan.reflection, two_nsmul,
      component01, complementIdempotent]
    noncomm_ring [hp, InfoGeometry.Core.PeirceDecomposition.idempotent_mul_nested p hp]
  have huRv : u * r * v = -(u * v) := by
    calc
      u * r * v = u * (r * v) := by rw [mul_assoc]
      _ = u * (-v) := by rw [hrv]
      _ = -(u * v) := by rw [mul_neg]
  have hvRu : v * r * u = v * u := by
    rw [hvr]
  have hCross : crossTransport R u v r = -s := by
    change u * r * v + v * r * u = _
    rw [huRv, hvRu]
    dsimp [s]
    abel
  have hOriented : orientedTransport (R := R) u v r = -m := by
    change u * r * v - v * r * u = _
    rw [huRv, hvRu]
    dsimp [m]
    abel
  have hmRight : m * r = s := by
    dsimp [m, s]
    calc
      (u * v + v * u) * r = u * (v * r) + v * (u * r) := by noncomm_ring
      _ = u * v - v * u := by rw [hvr, hur, mul_neg]; abel
  have hrm : r * m = s := by
    dsimp [m, s]
    calc
      r * (u * v + v * u) = (r * u) * v + (r * v) * u := by noncomm_ring
      _ = u * v - v * u := by rw [hru, hrv, neg_mul]; abel
  have hMassJordan : m * r + r * m = (2 : ℕ) • s := by
    rw [hmRight, hrm, two_nsmul]
  have hsRight : s * r = m := by
    dsimp [s, m]
    calc
      (u * v - v * u) * r = u * (v * r) - v * (u * r) := by noncomm_ring
      _ = u * v + v * u := by rw [hvr, hur, mul_neg, sub_neg_eq_add]
  have hrs : r * s = m := by
    dsimp [s, m]
    calc
      r * (u * v - v * u) = (r * u) * v - (r * v) * u := by noncomm_ring
      _ = u * v + v * u := by rw [hru, hrv, neg_mul, sub_neg_eq_add]
  have hSpinJordan : s * r + r * s = (2 : ℕ) • m := by
    rw [hsRight, hrs, two_nsmul]
  have hOrientedOne : orientedTransport (R := R) u v 1 = s := by
    change u * 1 * v - v * 1 * u = _
    simp only [one_mul, mul_one]
    rfl
  refine ⟨?_, ?_, ?_⟩
  · change (2 : ℕ) • orientedTransport (R := R) u v r +
      (s * r + r * s) = 0
    rw [hOriented, hSpinJordan]
    simp only [two_nsmul]
    abel
  · change (2 : ℕ) • orientedTransport (R := R) u v 1 +
      (s * 1 + 1 * s) = (4 : ℕ) • s
    rw [hOrientedOne]
    simp only [one_mul, mul_one, two_nsmul,
      show (4 : ℕ) = 2 + 2 by rfl, add_nsmul]
  · change (2 : ℕ) • crossTransport R u v r -
      (m * r + r * m) = -((4 : ℕ) • s)
    rw [hCross, hMassJordan]
    simp only [two_nsmul, show (4 : ℕ) = 2 + 2 by rfl, add_nsmul]
    abel

/-- Exact action of the complementary same-corner Kraus channel on the
reflexive-pair operator sectors. Together with the cross-channel formulas,
this gives the operator-valued sector complementarity without choosing
coordinates or a scalar spectrum. -/
theorem sameCornerChannel_reflexive_modes {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    sameCornerChannel (R := R) u v 1 = 0 ∧
    sameCornerChannel (R := R) u v (u * v + v * u) = 0 ∧
    sameCornerChannel (R := R) u v (u + v) = u + v ∧
    sameCornerChannel (R := R) u v (u - v) = -(u - v) ∧
    sameCornerChannel (R := R) u v (u * v - v * u) = 0 := by
  have hAction (x : A) : sameCornerChannel (R := R) u v x =
      u * x * u + v * x * v := by
    simp [sameCornerChannel, LieJordan.sandwichOp]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [hAction 1]
    noncomm_ring [hu, hv]
  · rw [hAction (u * v + v * u)]
    noncomm_ring [hu, hv, huv, hvu]
  · rw [hAction (u + v)]
    noncomm_ring [hu, hv, huv, hvu]
  · rw [hAction (u - v)]
    noncomm_ring [hu, hv, huv, hvu]
  · rw [hAction (u * v - v * u)]
    noncomm_ring [hu, hv, huv, hvu]

/-- The symmetric gain channel annihilates the sum and difference modes of a
square-zero pair. For a reflexive pair, the Jordan mass fixes both modes, so
the gain channel alone cannot have the mass eigenvalues claimed in the XLIX
transcript on any nonzero such mode. The loss term in the GKSL dissipator is
essential to its nonzero damping action. -/
theorem crossTransport_reflexive_modes_are_not_mass_eigenvectors {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v)
    (hSum : u + v ≠ 0) (hDiff : u - v ≠ 0) :
    LieJordan.crossTransport R u v (u + v) = 0 ∧
    LieJordan.crossTransport R u v (u - v) = 0 ∧
    (u * v + v * u) * (u + v) = u + v ∧
    (u * v + v * u) * (u - v) = u - v ∧
    LieJordan.crossTransport R u v (u + v) ≠
      (u * v + v * u) * (u + v) ∧
    LieJordan.crossTransport R u v (u - v) ≠
      -((u * v + v * u) * (u - v)) := by
  have hMu : (u * v + v * u) * u = u := by
    have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
    calc
      _ = u * v * u + v * u * u := by noncomm_ring
      _ = u := by rw [huv, hVUU]; simp
  have hMv : (u * v + v * u) * v = v := by
    have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
    calc
      _ = u * v * v + v * u * v := by noncomm_ring
      _ = v := by rw [hUVV, hvu]; simp
  have hMassSum : (u * v + v * u) * (u + v) = u + v := by
    rw [mul_add, hMu, hMv]
  have hMassDiff : (u * v + v * u) * (u - v) = u - v := by
    rw [mul_sub, hMu, hMv]
  have hGainSum := crossTransport_apply_add_eq_zero (R := R) hu hv
  have hGainDiff := crossTransport_apply_sub_eq_zero (R := R) hu hv
  refine ⟨hGainSum, hGainDiff, hMassSum, hMassDiff, ?_, ?_⟩
  · intro h
    rw [hGainSum, hMassSum] at h
    exact hSum h.symm
  · intro h
    rw [hGainDiff, hMassDiff] at h
    exact hDiff (neg_eq_zero.mp h.symm)

/-- A nonzero reflexive square-zero transition cannot commute with its
oppositely directed transition. This records genuine operator
noncommutativity as a consequence of the Peirce hypotheses. -/
theorem not_commute_of_reflexive_squareZero {u v : A}
    (hu : u * u = 0) (huv : u * v * u = u) (hu_ne : u ≠ 0) :
    ¬ Commute u v := by
  intro hcomm
  have hcycle : u * v * u = 0 := by
    rw [hcomm.eq, mul_assoc, hu, mul_zero]
  exact hu_ne (huv.symm.trans hcycle)

/-- Reflexive opposite square-zero transitions and their spin commutator
realize the three `sl₂` root relations in any associative operator algebra.
The hypotheses imply a genuine two-sided ladder, without choosing matrix
coordinates. -/
theorem reflexive_pair_sl2_relations {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    ⁅u, v⁆ = u * v - v * u ∧
      ⁅⁅u, v⁆, u⁆ = (2 : ℕ) • u ∧
      ⁅⁅u, v⁆, v⁆ = -((2 : ℕ) • v) := by
  have huuV : u * (u * v) = 0 := by rw [← mul_assoc, hu, zero_mul]
  have hvvU : v * (v * u) = 0 := by rw [← mul_assoc, hv, zero_mul]
  have huVu : u * (v * u) = u := by rw [← mul_assoc, huv]
  have hvUv : v * (u * v) = v := by rw [← mul_assoc, hvu]
  constructor
  · rfl
  constructor
  · change (u * v - v * u) * u - u * (u * v - v * u) = _
    noncomm_ring [hu, hv, huv, hvu, huuV, hvvU, huVu, hvUv]
  · change (u * v - v * u) * v - v * (u * v - v * u) = _
    noncomm_ring [hu, hv, huv, hvu, huuV, hvvU, huVu, hvUv]

/-- The two directed products of a reflexive square-zero pair are orthogonal
idempotents. -/
theorem reflexive_pair_product_relations {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (u * v) * (u * v) = u * v ∧ (v * u) * (v * u) = v * u ∧
      (u * v) * (v * u) = 0 ∧ (v * u) * (u * v) = 0 := by
  have hUV : (u * v) * (u * v) = u * v := by
    calc
      _ = (u * v * u) * v := by simp only [mul_assoc]
      _ = u * v := by rw [huv]
  have hVU : (v * u) * (v * u) = v * u := by
    calc
      _ = (v * u * v) * u := by simp only [mul_assoc]
      _ = v * u := by rw [hvu]
  have hUVVU : (u * v) * (v * u) = 0 := by
    calc
      _ = u * ((v * v) * u) := by simp only [mul_assoc]
      _ = 0 := by rw [hv, zero_mul, mul_zero]
  have hVUUV : (v * u) * (u * v) = 0 := by
    calc
      _ = v * ((u * u) * v) := by simp only [mul_assoc]
      _ = 0 := by rw [hu, zero_mul, mul_zero]
  exact ⟨hUV, hVU, hUVVU, hVUUV⟩

/-- The Jordan mass operator of a reflexive square-zero pair is idempotent. -/
theorem reflexive_pair_mass_idempotent {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (u * v + v * u) * (u * v + v * u) = u * v + v * u := by
  rcases reflexive_pair_product_relations hu hv huv hvu with
    ⟨hUV, hVU, hUVVU, hVUUV⟩
  simp only [add_mul, mul_add]
  rw [hUV, hUVVU, hVUUV, hVU]
  abel

/-- The spin commutator square equals the Jordan mass operator, giving the
quadratic Casimir identity for the reflexive `sl₂` pair. -/
theorem reflexive_pair_spin_square {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (u * v - v * u) * (u * v - v * u) = u * v + v * u := by
  rcases reflexive_pair_product_relations hu hv huv hvu with
    ⟨hUV, hVU, hUVVU, hVUUV⟩
  simp only [sub_mul, mul_sub]
  rw [hUV, hUVVU, hVUUV, hVU]
  abel

/-- The spin commutator rotates the Dirac sum into the axial difference for a
reflexive square-zero pair. This is an identity in the ambient associative
algebra, with no matrix-coordinate or commutativity assumptions. -/
theorem reflexive_pair_spin_precesses_dirac {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (u * v - v * u) * (u + v) - (u + v) * (u * v - v * u) =
      (2 : ℕ) • (u - v) := by
  have h := (reflexive_pair_sl2_relations hu hv huv hvu).2.1
  calc
    _ = ((u * v - v * u) * u - u * (u * v - v * u)) +
        ((u * v - v * u) * v - v * (u * v - v * u)) := by noncomm_ring
    _ = (2 : ℕ) • u + -((2 : ℕ) • v) := by
      change (u * v - v * u) * u - u * (u * v - v * u) = _ at h
      have hv' := (reflexive_pair_sl2_relations hu hv huv hvu).2.2
      change (u * v - v * u) * v - v * (u * v - v * u) = _ at hv'
      rw [h, hv']
    _ = (2 : ℕ) • (u - v) := by simp only [two_nsmul]; abel

/-- The spin commutator rotates the axial difference back into the Dirac sum
for a reflexive square-zero pair. This is the companion operator identity to
`reflexive_pair_spin_precesses_dirac`. -/
theorem reflexive_pair_spin_precesses_axial {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (u * v - v * u) * (u - v) - (u - v) * (u * v - v * u) =
      (2 : ℕ) • (u + v) := by
  have h := (reflexive_pair_sl2_relations hu hv huv hvu).2.2
  calc
    _ = ((u * v - v * u) * u - u * (u * v - v * u)) -
        ((u * v - v * u) * v - v * (u * v - v * u)) := by noncomm_ring
    _ = (2 : ℕ) • u + (2 : ℕ) • v := by
      have hu' := (reflexive_pair_sl2_relations hu hv huv hvu).2.1
      change (u * v - v * u) * u - u * (u * v - v * u) = _ at hu'
      change (u * v - v * u) * v - v * (u * v - v * u) = _ at h
      rw [hu', h]
      rw [sub_neg_eq_add]
    _ = (2 : ℕ) • (u + v) := by simp only [two_nsmul]; abel

/-- The quadratic Casimir expression of a reflexive square-zero pair is three
times its mass support. -/
theorem reflexive_pair_casimir {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (u * v - v * u) * (u * v - v * u) +
      (2 : ℕ) • (u * v + v * u) = (3 : ℕ) • (u * v + v * u) := by
  rw [reflexive_pair_spin_square hu hv huv hvu, two_nsmul, three_nsmul]

/-- A reflexive square-zero pair has a tripotent Dirac sum supported by its
idempotent Jordan mass operator; subtracting the mass support produces an
involution in the ambient operator algebra. -/
theorem reflexive_pair_dirac_support_and_involution {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (u + v) * (u + v) = u * v + v * u ∧
    (u + v) * (u * v + v * u) = u + v ∧
    (u * v + v * u) * (u + v) = u + v ∧
    ((1 - (u * v + v * u)) + (u + v)) *
      ((1 - (u * v + v * u)) + (u + v)) = 1 := by
  have hE2 := even_coefficient_sq hu hv
  have hUUV : u * u * v = 0 := by rw [hu, zero_mul]
  have hVVU : v * v * u = 0 := by rw [hv, zero_mul]
  have hUVV : u * (v * v) = 0 := by rw [hv, mul_zero]
  have hVUU : v * (u * u) = 0 := by rw [hu, mul_zero]
  have hEM : (u + v) * (u * v + v * u) = u + v := by
    calc
      _ = u * u * v + u * v * u + v * u * v + v * v * u := by
        noncomm_ring
      _ = _ := by rw [hUUV, huv, hvu, hVVU]; abel
  have hME : (u * v + v * u) * (u + v) = u + v := by
    calc
      _ = u * v * u + u * (v * v) + v * (u * u) + v * u * v := by
        noncomm_ring
      _ = _ := by rw [huv, hUVV, hVUU, hvu]; abel
  have hM : (u * v + v * u) * (u * v + v * u) = u * v + v * u :=
    reflexive_pair_mass_idempotent hu hv huv hvu
  have hCompSq : (1 - (u * v + v * u)) * (1 - (u * v + v * u)) =
      1 - (u * v + v * u) := by
    calc
      _ = 1 - (u * v + v * u) - (u * v + v * u) +
          (u * v + v * u) * (u * v + v * u) := by noncomm_ring
      _ = _ := by rw [hM]; abel
  have hCompE : (1 - (u * v + v * u)) * (u + v) = 0 := by
    calc
      _ = (u + v) - (u * v + v * u) * (u + v) := by noncomm_ring
      _ = _ := by rw [hME, sub_self]
  have hEComp : (u + v) * (1 - (u * v + v * u)) = 0 := by
    calc
      _ = (u + v) - (u + v) * (u * v + v * u) := by noncomm_ring
      _ = _ := by rw [hEM, sub_self]
  refine ⟨hE2, hEM, hME, ?_⟩
  calc
    _ = (1 - (u * v + v * u)) * (1 - (u * v + v * u)) +
          (1 - (u * v + v * u)) * (u + v) +
          (u + v) * (1 - (u * v + v * u)) + (u + v) * (u + v) := by
      noncomm_ring
    _ = 1 := by rw [hCompSq, hCompE, hEComp, hE2]; simp

/-- The spin commutator has the same mass support as the Dirac sum. Completing
it with the complementary mass projection therefore gives a second involution
in the ambient, possibly noncommutative operator algebra. -/
theorem reflexive_pair_spin_support_and_involution {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (u * v - v * u) * (u * v - v * u) = u * v + v * u ∧
    ((1 - (u * v + v * u)) + (u * v - v * u)) *
      ((1 - (u * v + v * u)) + (u * v - v * u)) = 1 := by
  let mass : A := u * v + v * u
  let spin : A := u * v - v * u
  rcases reflexive_pair_product_relations hu hv huv hvu with
    ⟨hUV, hVU, hUVVU, hVUUV⟩
  have hMassSq : mass * mass = mass := by
    exact reflexive_pair_mass_idempotent hu hv huv hvu
  have hSpinSq : spin * spin = mass := by
    exact reflexive_pair_spin_square hu hv huv hvu
  have hSpinMass : spin * mass = spin := by
    dsimp [spin, mass]
    noncomm_ring [hUV, hVU, hUVVU, hVUUV]
  have hMassSpin : mass * spin = spin := by
    dsimp [spin, mass]
    noncomm_ring [hUV, hVU, hUVVU, hVUUV]
  have hComplementSq : (1 - mass) * (1 - mass) = 1 - mass := by
    noncomm_ring [hMassSq]
  have hComplementSpin : (1 - mass) * spin = 0 := by
    calc
      (1 - mass) * spin = spin - mass * spin := by noncomm_ring
      _ = 0 := by rw [hMassSpin]; simp
  have hSpinComplement : spin * (1 - mass) = 0 := by
    calc
      spin * (1 - mass) = spin - spin * mass := by noncomm_ring
      _ = 0 := by rw [hSpinMass]; simp
  constructor
  · exact hSpinSq
  · change ((1 - mass) + spin) * ((1 - mass) + spin) = 1
    calc
      ((1 - mass) + spin) * ((1 - mass) + spin) =
          (1 - mass) * (1 - mass) + (1 - mass) * spin +
            spin * (1 - mass) + spin * spin := by noncomm_ring
      _ = 1 := by rw [hComplementSq, hComplementSpin, hSpinComplement,
        hSpinSq]; noncomm_ring

/-- The shifted Dirac product factors through its idempotent mass support for
any spectral parameter operator commuting with the Dirac and mass operators. -/
theorem shifted_dirac_product_factorization {E M c : A}
    (hE2 : E * E = M) (hCE : Commute c E) (hCM : Commute c M) :
    (c - E) * (c + E) = c * c * (1 - M) + (c * c - 1) * M := by
  have hC2M : c * c * M = M * (c * c) := by
    calc
      _ = c * (c * M) := by rw [mul_assoc]
      _ = c * (M * c) := by rw [hCM.eq]
      _ = (c * M) * c := by rw [mul_assoc]
      _ = (M * c) * c := by rw [hCM.eq]
      _ = M * (c * c) := by rw [mul_assoc]
  calc
    _ = c * c - E * E := by
      have hCE' : c * E = E * c := hCE.eq
      noncomm_ring [hCE']
    _ = c * c - M := by rw [hE2]
    _ = c * c * (1 - M) + (c * c - 1) * M := by
      noncomm_ring [hC2M]

/-- The shifted Dirac product factorization commutes with every unital ring
homomorphism, including each bonding map in an inductive operator tower. -/
theorem ringHom_preserves_shifted_dirac_product {B : Type*} [Ring B]
    (f : A →+* B) (E M c : A) (hE2 : E * E = M)
    (hCE : Commute c E) (hCM : Commute c M) :
    (f c - f E) * (f c + f E) =
      f c * f c * (1 - f M) + (f c * f c - 1) * f M := by
  simpa only [map_sub, map_add, map_mul, map_one] using
    congrArg f (shifted_dirac_product_factorization hE2 hCE hCM)

/-- The Jordan mass commutes with the sum, difference, and commutator sectors
of any square-zero pair. -/
theorem squareZero_pair_mass_commutes_sectors {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    (u * v + v * u) * (u + v) = (u + v) * (u * v + v * u) ∧
    (u * v + v * u) * (u - v) = (u - v) * (u * v + v * u) ∧
    (u * v + v * u) * (u * v - v * u) =
      (u * v - v * u) * (u * v + v * u) := by
  have huuV := squareZero_nested u hu v
  have hvvU := squareZero_nested v hv u
  refine ⟨?_, ?_, ?_⟩ <;> noncomm_ring [hu, hv, huuV, hvvU]

/-- The anticommutator cross dissipator fixes the Jordan mass of any
square-zero operator pair. Reflexivity is not needed for this fixed point. -/
theorem crossDissipator_apply_mass_of_squareZero {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    crossDissipator (R := R) u v (u * v + v * u) = 0 := by
  let m : A := u * v + v * u
  have huuV : u * (u * v) = 0 := by rw [← mul_assoc, hu, zero_mul]
  have hvvU : v * (v * u) = 0 := by rw [← mul_assoc, hv, zero_mul]
  have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
  have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have hCross : LieJordan.crossTransport R u v m = m * m := by
    change u * m * v + v * m * u = m * m
    dsimp [m]
    noncomm_ring [hu, hv, huuV, hvvU, hUVV, hVUU]
  change (2 : ℕ) • LieJordan.crossTransport R u v m -
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R) m m = 0
  change (2 : ℕ) • LieJordan.crossTransport R u v m - (m * m + m * m) = 0
  rw [hCross, two_nsmul]
  simp

/-- The symmetric cross dissipator acts on the commutator spin by negative
fourfold left multiplication by the Jordan mass for every square-zero pair. -/
theorem crossDissipator_apply_spin_of_squareZero {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    crossDissipator (R := R) u v (u * v - v * u) =
      -((4 : ℕ) • ((u * v + v * u) * (u * v - v * u))) := by
  have huuV := squareZero_nested u hu v
  have hvvU := squareZero_nested v hv u
  have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
  have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have hMassComm := (squareZero_pair_mass_commutes_sectors hu hv).2.2
  have hCross : LieJordan.crossTransport R u v (u * v - v * u) =
      -((u * v + v * u) * (u * v - v * u)) := by
    change u * (u * v - v * u) * v + v * (u * v - v * u) * u = _
    noncomm_ring [hu, hv, huuV, hvvU, hUVV, hVUU]
  change (2 : ℕ) • LieJordan.crossTransport R u v (u * v - v * u) -
      ((u * v + v * u) * (u * v - v * u) +
        (u * v - v * u) * (u * v + v * u)) = _
  rw [hCross, hMassComm, two_nsmul]
  abel

/-- Compatibility form for callers that already have a reflexive pair. -/
theorem crossDissipator_apply_mass_of_reflexive {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (_huv : u * v * u = u) (_hvu : v * u * v = v) :
    crossDissipator (R := R) u v (u * v + v * u) = 0 :=
  crossDissipator_apply_mass_of_squareZero (R := R) hu hv

/-- For a reflexive square-zero pair, the cross dissipator acts on the sum
as `-2` times that sum. Thus the claimed zero mode in the supplied XLIX
snippet does not follow from its stated Kraus channel. -/
theorem crossDissipator_apply_add_of_reflexive {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    crossDissipator (R := R) u v (u + v) = -((2 : ℕ) • (u + v)) := by
  have hJordan :
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R)
          (u * v + v * u) (u + v) = (2 : ℕ) • (u + v) := by
    change (u * v + v * u) * (u + v) + (u + v) * (u * v + v * u) = _
    have huv₂ : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
    have hvu₂ : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
    have hu₂v : u * u * v = 0 := by rw [hu, zero_mul]
    have hv₂u : v * v * u = 0 := by rw [hv, zero_mul]
    have hME : (u * v + v * u) * (u + v) = u + v := by
      calc
        _ = u * v * u + u * v * v + v * u * u + v * u * v := by
          noncomm_ring
        _ = u + v := by rw [huv₂, hvu₂, huv, hvu]; abel
    have hEM : (u + v) * (u * v + v * u) = u + v := by
      calc
        _ = u * u * v + u * v * u + v * u * v + v * v * u := by
          simp only [add_mul, mul_add, mul_assoc]
          abel
        _ = u + v := by rw [hu₂v, hv₂u, huv, hvu]; abel
    rw [hME, hEM, two_nsmul]
  change (2 : ℕ) • LieJordan.crossTransport R u v (u + v) -
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R)
        (u * v + v * u) (u + v) = -((2 : ℕ) • (u + v))
  rw [crossTransport_apply_add_eq_zero hu hv, hJordan]
  simp

/-- The corresponding reflexive-pair action on the difference is also
`-2` times the difference for the channel defined in this file. -/
theorem crossDissipator_apply_sub_of_reflexive {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    crossDissipator (R := R) u v (u - v) = -((2 : ℕ) • (u - v)) := by
  have hJordan :
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R)
          (u * v + v * u) (u - v) = (2 : ℕ) • (u - v) := by
    change (u * v + v * u) * (u - v) + (u - v) * (u * v + v * u) = _
    have huv₂ : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
    have hvu₂ : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
    have hu₂v : u * u * v = 0 := by rw [hu, zero_mul]
    have hv₂u : v * v * u = 0 := by rw [hv, zero_mul]
    have hMJ : (u * v + v * u) * (u - v) = u - v := by
      calc
        _ = u * v * u - u * v * v + v * u * u - v * u * v := by
          noncomm_ring
        _ = u - v := by rw [huv₂, hvu₂, huv, hvu]; abel
    have hJM : (u - v) * (u * v + v * u) = u - v := by
      calc
        _ = u * u * v + u * v * u - v * u * v - v * v * u := by
          noncomm_ring
        _ = u - v := by rw [hu₂v, hv₂u, huv, hvu]; abel
    rw [hMJ, hJM, two_nsmul]
  change (2 : ℕ) • LieJordan.crossTransport R u v (u - v) -
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft (R := R)
        (u * v + v * u) (u - v) = -((2 : ℕ) • (u - v))
  rw [crossTransport_apply_sub_eq_zero hu hv, hJordan]
  simp

/-- Exact algebraic action of the symmetric cross-branch dissipator on five
elements of a reflexive square-zero pair. The gain term `crossTransport`
annihilates the off-diagonal pair, while the included loss anticommutator gives
the displayed `-2` mass action there. The formulas retain left multiplication
by the mass operator; they do not assert scalar eigenvalues or a numerical
spectral gap. -/
theorem crossDissipator_reflexive_pair_actions {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    crossDissipator (R := R) u v 1 = 0 ∧
    crossDissipator (R := R) u v (u * v + v * u) = 0 ∧
    crossDissipator (R := R) u v (u + v) =
      -((2 : ℕ) • ((u * v + v * u) * (u + v))) ∧
    crossDissipator (R := R) u v (u - v) =
      -((2 : ℕ) • ((u * v + v * u) * (u - v))) ∧
    crossDissipator (R := R) u v (u * v - v * u) =
      -((4 : ℕ) • ((u * v + v * u) * (u * v - v * u))) := by
  have hOne : crossDissipator (R := R) u v 1 = 0 := by
    change (2 : ℕ) • (u * 1 * v + v * 1 * u) -
      ((u * v + v * u) * 1 + 1 * (u * v + v * u)) = 0
    simp only [mul_one, one_mul]
    rw [two_nsmul]
    abel
  have hMass := crossDissipator_apply_mass_of_reflexive (R := R) hu hv huv hvu
  have hMu : (u * v + v * u) * u = u := by
    have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
    calc
      _ = u * v * u + v * u * u := by noncomm_ring
      _ = u := by rw [huv, hVUU, add_zero]
  have hMv : (u * v + v * u) * v = v := by
    have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
    calc
      _ = u * v * v + v * u * v := by noncomm_ring
      _ = v := by rw [hUVV, hvu, zero_add]
  have hME : (u * v + v * u) * (u + v) = u + v := by
    rw [mul_add, hMu, hMv]
  have hMJ : (u * v + v * u) * (u - v) = u - v := by
    rw [mul_sub, hMu, hMv]
  have hProducts := reflexive_pair_product_relations hu hv huv hvu
  rcases hProducts with ⟨hUV, hVU, hUVVU, hVUUV⟩
  have hMuv : (u * v + v * u) * (u * v) = u * v := by
    rw [← mul_assoc, hMu]
  have hMvu : (u * v + v * u) * (v * u) = v * u := by
    rw [← mul_assoc, hMv]
  have huvM : (u * v) * (u * v + v * u) = u * v := by
    rw [mul_add, hUV, hUVVU, add_zero]
  have hvuM : (v * u) * (u * v + v * u) = v * u := by
    rw [mul_add, hVUUV, hVU, zero_add]
  have hMS : (u * v + v * u) * (u * v - v * u) = u * v - v * u := by
    rw [mul_sub, hMuv, hMvu]
  have hSM : (u * v - v * u) * (u * v + v * u) = u * v - v * u := by
    rw [sub_mul, huvM, hvuM]
  have hPhiS : LieJordan.crossTransport R u v (u * v - v * u) =
      -(u * v - v * u) := by
    change u * (u * v - v * u) * v + v * (u * v - v * u) * u = _
    noncomm_ring [hu, hv, huv, hvu]
  have hSpin : crossDissipator (R := R) u v (u * v - v * u) =
      -((4 : ℕ) • ((u * v + v * u) * (u * v - v * u))) := by
    change (2 : ℕ) • LieJordan.crossTransport R u v (u * v - v * u) -
      ((u * v + v * u) * (u * v - v * u) +
        (u * v - v * u) * (u * v + v * u)) = _
    rw [hPhiS, hMS, hSM]
    simp only [two_nsmul]
    rw [show (4 : ℕ) = 2 + 2 by rfl, add_nsmul]
    simp only [two_nsmul]
    abel
  refine ⟨hOne, hMass, ?_, ?_, hSpin⟩
  · rw [crossDissipator_apply_add_of_reflexive hu hv huv hvu, hME]
  · rw [crossDissipator_apply_sub_of_reflexive hu hv huv hvu, hMJ]

/-- Exact algebraic action of the full Dirac dissipator, represented by
`sumDissipator`, on five elements of a reflexive square-zero pair. The
displayed mass factors are operators in `A`, not numerical eigenvalues. -/
theorem sumDissipator_reflexive_pair_actions {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    sumDissipator (R := R) u v 1 = 0 ∧
    sumDissipator (R := R) u v (u * v + v * u) = 0 ∧
    sumDissipator (R := R) u v (u + v) = 0 ∧
    sumDissipator (R := R) u v (u - v) =
      -((4 : ℕ) • ((u * v + v * u) * (u - v))) ∧
    sumDissipator (R := R) u v (u * v - v * u) =
      -((4 : ℕ) • ((u * v + v * u) * (u * v - v * u))) := by
  have hAction (x : A) : sumDissipator (R := R) u v x =
      (2 : ℕ) • ((u * x * v + v * x * u) + (u * x * u + v * x * v)) -
        ((u * v + v * u) * x + x * (u * v + v * u)) := by
    simp [sumDissipator, sameCornerChannel,
      LieJordan.crossTransport, LieJordan.sandwichOp,
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft]
  have hProducts := reflexive_pair_product_relations hu hv huv hvu
  rcases hProducts with ⟨hUV, hVU, hUVVU, hVUUV⟩
  have hMassIdem := reflexive_pair_mass_idempotent hu hv huv hvu
  have hUUV : u * (u * v) = 0 := by rw [← mul_assoc, hu, zero_mul]
  have hVVU : v * (v * u) = 0 := by rw [← mul_assoc, hv, zero_mul]
  have hUVV : (u * v) * v = 0 := by rw [mul_assoc, hv, mul_zero]
  have hVUU : (v * u) * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have hUVu : u * (v * u) = u := by rw [← mul_assoc, huv]
  have hVuv : v * (u * v) = v := by rw [← mul_assoc, hvu]
  have hME : (u * v + v * u) * (u + v) = u + v := by
    have hMu : (u * v + v * u) * u = u := by
      have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
      calc
        _ = u * v * u + v * u * u := by noncomm_ring
        _ = u := by rw [huv, hVUU]; simp
    have hMv : (u * v + v * u) * v = v := by
      have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
      calc
        _ = u * v * v + v * u * v := by noncomm_ring
        _ = v := by rw [hUVV, hvu]; simp
    rw [mul_add, hMu, hMv]
  have hMJ : (u * v + v * u) * (u - v) = u - v := by
    have hMu : (u * v + v * u) * u = u := by
      have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
      calc
        _ = u * v * u + v * u * u := by noncomm_ring
        _ = u := by rw [huv, hVUU]; simp
    have hMv : (u * v + v * u) * v = v := by
      have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
      calc
        _ = u * v * v + v * u * v := by noncomm_ring
        _ = v := by rw [hUVV, hvu]; simp
    rw [mul_sub, hMu, hMv]
  have hMS : (u * v + v * u) * (u * v - v * u) = u * v - v * u := by
    have hLeftUV : (u * v + v * u) * (u * v) = u * v := by
      calc _ = ((u * v + v * u) * u) * v := by simp only [mul_assoc]
        _ = u * v := by
          have hMu : (u * v + v * u) * u = u := by
            have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
            calc
              _ = u * v * u + v * u * u := by noncomm_ring
              _ = u := by rw [huv, hVUU]; simp
          rw [hMu]
    have hLeftVU : (u * v + v * u) * (v * u) = v * u := by
      calc _ = ((u * v + v * u) * v) * u := by simp only [mul_assoc]
        _ = v * u := by
          have hMv : (u * v + v * u) * v = v := by
            have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
            calc
              _ = u * v * v + v * u * v := by noncomm_ring
              _ = v := by rw [hUVV, hvu]; simp
          rw [hMv]
    have hRightUV : (u * v) * (u * v + v * u) = u * v := by
      rw [mul_add, hUV, hUVVU, add_zero]
    have hRightVU : (v * u) * (u * v + v * u) = v * u := by
      rw [mul_add, hVUUV, hVU, zero_add]
    calc
      _ = (u * v + v * u) * (u * v) - (u * v + v * u) * (v * u) := by
        simp only [mul_sub]
      _ = u * v - v * u := by rw [hLeftUV, hLeftVU]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [hAction 1]
    noncomm_ring [hu, hv]
  · rw [hAction (u * v + v * u)]
    noncomm_ring [hu, hv, huv, hvu, hMassIdem, hUV, hVU, hUVVU, hVUUV,
      hUUV, hVVU, hUVV, hVUU, hUVu, hVuv]
  · rw [hAction (u + v), hME]
    noncomm_ring [hu, hv, huv, hvu, hUUV, hVVU, hUVV, hVUU, hUVu, hVuv]
  · rw [hAction (u - v), hMJ]
    noncomm_ring [hu, hv, huv, hvu, hUUV, hVVU, hUVV, hVUU, hUVu, hVuv]
  · rw [hAction (u * v - v * u), hMS]
    noncomm_ring [hu, hv, huv, hvu, hUV, hVU, hUVVU, hVUUV,
      hUUV, hVVU, hUVV, hVUU, hUVu, hVuv]

/-- The mass-commutator GKSL generator combines the inner derivation of the
Jordan mass with the symmetric sum-channel dissipator. -/
def massGkslGenerator (u v : A) : Module.End R A :=
  LieJordan.lieOp R (u * v + v * u) + crossDissipator (R := R) u v

/-- Exact Tetraktys-sector action of the mass-commutator generator for every
square-zero operator pair. The rates are left multiplication by the Jordan
mass, so they do not assert scalar eigenvalues or a numerical spectral gap. -/
theorem massGksl_squareZero_pair_actions {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    massGkslGenerator (R := R) u v 1 = 0 ∧
    massGkslGenerator (R := R) u v (u * v + v * u) = 0 ∧
    massGkslGenerator (R := R) u v (u + v) =
      -((2 : ℕ) • ((u * v + v * u) * (u + v))) ∧
    massGkslGenerator (R := R) u v (u - v) =
      -((2 : ℕ) • ((u * v + v * u) * (u - v))) ∧
    massGkslGenerator (R := R) u v (u * v - v * u) =
      -((4 : ℕ) • ((u * v + v * u) * (u * v - v * u))) := by
  have hMassComm := squareZero_pair_mass_commutes_sectors hu hv
  have hDAddSub := crossDissipator_apply_add_sub_of_squareZero (R := R) hu hv
  have hDSpin := crossDissipator_apply_spin_of_squareZero (R := R) hu hv
  have hDMass := crossDissipator_apply_mass_of_squareZero (R := R) hu hv
  have hDOne : crossDissipator (R := R) u v 1 = 0 := by
    change (2 : ℕ) • (u * 1 * v + v * 1 * u) -
      ((u * v + v * u) * 1 + 1 * (u * v + v * u)) = 0
    simp only [mul_one, one_mul, two_nsmul]
    abel
  have hLieE : LieJordan.lieOp R (u * v + v * u) (u + v) = 0 := by
    change (u * v + v * u) * (u + v) - (u + v) * (u * v + v * u) = 0
    exact sub_eq_zero.mpr hMassComm.1
  have hLieJ : LieJordan.lieOp R (u * v + v * u) (u - v) = 0 := by
    change (u * v + v * u) * (u - v) - (u - v) * (u * v + v * u) = 0
    exact sub_eq_zero.mpr hMassComm.2.1
  have hLieSpin : LieJordan.lieOp R (u * v + v * u) (u * v - v * u) = 0 := by
    change (u * v + v * u) * (u * v - v * u) -
      (u * v - v * u) * (u * v + v * u) = 0
    exact sub_eq_zero.mpr hMassComm.2.2
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simpa [massGkslGenerator, LieJordan.lieOp_apply] using hDOne
  · simpa [massGkslGenerator, LieJordan.lieOp_apply] using hDMass
  · simpa [massGkslGenerator, LieJordan.lieOp_apply, hLieE] using hDAddSub.1
  · simpa [massGkslGenerator, LieJordan.lieOp_apply, hLieJ] using hDAddSub.2
  · simpa [massGkslGenerator, LieJordan.lieOp_apply, hLieSpin] using hDSpin

/-- The mass-commutator GKSL generator fixes the Jordan mass for every
square-zero pair, without a reflexivity assumption. -/
theorem massGkslGenerator_fixes_mass_of_squareZero {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    massGkslGenerator (R := R) u v (u * v + v * u) = 0 := by
  change LieJordan.lieOp R (u * v + v * u) (u * v + v * u) +
    crossDissipator (R := R) u v (u * v + v * u) = 0
  rw [crossDissipator_apply_mass_of_squareZero (R := R) hu hv]
  simp [LieJordan.lieOp_apply]

/-- In a reflexive square-zero operator pair, the mass commutes with each
Tetraktys sector. These are algebraic consequences of the pair relations. -/
theorem reflexive_pair_mass_commutes_sectors {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (u * v + v * u) * (u + v) = (u + v) * (u * v + v * u) ∧
    (u * v + v * u) * (u - v) = (u - v) * (u * v + v * u) ∧
    (u * v + v * u) * (u * v - v * u) =
      (u * v - v * u) * (u * v + v * u) := by
  have hMu : (u * v + v * u) * u = u := by
    have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
    calc
      _ = u * v * u + v * u * u := by noncomm_ring
      _ = u := by rw [huv, hVUU]; simp
  have hMv : (u * v + v * u) * v = v := by
    have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
    calc
      _ = u * v * v + v * u * v := by noncomm_ring
      _ = v := by rw [hUVV, hvu]; simp
  have hUV : (u * v) * (u * v) = u * v := by
    calc
      _ = (u * v * u) * v := by simp only [mul_assoc]
      _ = u * v := by rw [huv]
  have hVU : (v * u) * (v * u) = v * u := by
    calc
      _ = (v * u * v) * u := by simp only [mul_assoc]
      _ = v * u := by rw [hvu]
  have hUVVU : (u * v) * (v * u) = 0 := by
    calc
      _ = u * ((v * v) * u) := by simp only [mul_assoc]
      _ = 0 := by rw [hv]; simp
  have hVUUV : (v * u) * (u * v) = 0 := by
    calc
      _ = v * ((u * u) * v) := by simp only [mul_assoc]
      _ = 0 := by rw [hu]; simp
  have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
  have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have huM : u * (u * v + v * u) = u := by
    calc
      _ = (u * u) * v + u * v * u := by simp only [mul_add, mul_assoc]
      _ = u := by rw [hu, zero_mul, huv]; simp
  have hvM : v * (u * v + v * u) = v := by
    calc
      _ = v * u * v + (v * v) * u := by simp only [mul_add, mul_assoc]
      _ = v := by rw [hvu, hv, zero_mul]; simp
  refine ⟨?_, ?_, ?_⟩
  · have hRight : (u + v) * (u * v + v * u) = u + v := by
      rw [add_mul, huM, hvM]
    rw [mul_add, hMu, hMv, hRight]
  · have hRight : (u - v) * (u * v + v * u) = u - v := by
      rw [sub_mul, huM, hvM]
    rw [mul_sub, hMu, hMv, hRight]
  · have hLeftUV : (u * v + v * u) * (u * v) = u * v := by
      calc _ = ((u * v + v * u) * u) * v := by simp only [mul_assoc]
        _ = u * v := by rw [hMu]
    have hLeftVU : (u * v + v * u) * (v * u) = v * u := by
      calc _ = ((u * v + v * u) * v) * u := by simp only [mul_assoc]
        _ = v * u := by rw [hMv]
    have hRightUV : (u * v) * (u * v + v * u) = u * v := by
      rw [mul_add, hUV, hUVVU, add_zero]
    have hRightVU : (v * u) * (u * v + v * u) = v * u := by
      rw [mul_add, hVUUV, hVU, zero_add]
    rw [mul_sub, sub_mul, hLeftUV, hLeftVU, hRightUV, hRightVU]

/-- Exact algebraic action of the mass-commutator GKSL generator using the
cross-branch symmetric horizon dissipator on five elements of a reflexive
square-zero pair. The formulas retain left multiplication by the mass
operator; no scalar spectral gap is asserted. -/
theorem mass_gksl_reflexive_pair_actions {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    massGkslGenerator (R := R) u v 1 = 0 ∧
    massGkslGenerator (R := R) u v (u * v + v * u) = 0 ∧
    massGkslGenerator (R := R) u v (u + v) =
      -((2 : ℕ) • ((u * v + v * u) * (u + v))) ∧
    massGkslGenerator (R := R) u v (u - v) =
      -((2 : ℕ) • ((u * v + v * u) * (u - v))) ∧
    massGkslGenerator (R := R) u v (u * v - v * u) =
      -((4 : ℕ) • ((u * v + v * u) * (u * v - v * u))) := by
  exact massGksl_squareZero_pair_actions (R := R) hu hv

/-- The finite-dimensional-looking Tetraktys sector is defined here as a
submodule of the ambient noncommutative operator algebra. -/
def reflexivePairTetraktysSector (u v : A) : Submodule R A :=
  Submodule.span R
    ({(1 : A), u * v + v * u, u + v, u - v, u * v - v * u} : Set A)

/-- The mass-commutator GKSL endomorphism preserves the span of the identity,
Jordan mass, Dirac sum, axial difference, and spin commutator for every
reflexive square-zero pair. This is an operator-sector invariance theorem;
it makes no diagonalization or numerical spectral-gap claim. -/
theorem mass_gksl_preserves_reflexivePairTetraktysSector {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v)
    (x : A) (hx : x ∈ reflexivePairTetraktysSector (R := R) u v) :
    massGkslGenerator (R := R) u v x ∈
      reflexivePairTetraktysSector (R := R) u v := by
  let S := reflexivePairTetraktysSector (R := R) u v
  have hActions := mass_gksl_reflexive_pair_actions (R := R) hu hv huv hvu
  rcases hActions with ⟨hOne, hMass, hDirac, hAxial, hSpin⟩
  have hMu : (u * v + v * u) * u = u := by
    have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
    calc
      _ = u * v * u + v * u * u := by noncomm_ring
      _ = u := by rw [huv, hVUU]; simp
  have hMv : (u * v + v * u) * v = v := by
    have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
    calc
      _ = u * v * v + v * u * v := by noncomm_ring
      _ = v := by rw [hUVV, hvu]; simp
  have hMassDirac : (u * v + v * u) * (u + v) = u + v := by
    rw [mul_add, hMu, hMv]
  have hMassAxial : (u * v + v * u) * (u - v) = u - v := by
    rw [mul_sub, hMu, hMv]
  have hMassSpin : (u * v + v * u) * (u * v - v * u) =
      u * v - v * u := by
    rcases reflexive_pair_product_relations hu hv huv hvu with
      ⟨hUV, hVU, hUVVU, hVUUV⟩
    simp only [add_mul, mul_sub]
    rw [hUV, hUVVU, hVUUV, hVU]
    abel
  have hNsmul (n : ℕ) {y : A} (hy : y ∈ S) : n • y ∈ S := by
    induction n with
    | zero => simp
    | succ n ih =>
        simpa only [succ_nsmul] using S.add_mem ih hy
  change x ∈ S at hx
  change massGkslGenerator (R := R) u v x ∈ S
  refine Submodule.span_induction
    (p := fun y _ => massGkslGenerator (R := R) u v y ∈ S)
    ?_ ?_ ?_ ?_ hx
  · intro y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
    rcases hy with rfl | rfl | rfl | rfl | rfl
    · rw [hOne]
      exact S.zero_mem
    · rw [hMass]
      exact S.zero_mem
    · rw [hDirac, hMassDirac]
      exact S.neg_mem (hNsmul 2 (Submodule.subset_span (by simp)))
    · rw [hAxial, hMassAxial]
      exact S.neg_mem (hNsmul 2 (Submodule.subset_span (by simp)))
    · rw [hSpin, hMassSpin]
      exact S.neg_mem (hNsmul 4 (Submodule.subset_span (by simp)))
  · simp [massGkslGenerator, S]
  · intro y z _ _ hy hz
    simpa only [map_add] using S.add_mem hy hz
  · intro c y _ hy
    simpa only [map_smul] using S.smul_mem c hy

/-- The cross-only mass GKSL generator does not fix the Dirac operator when
twice that operator is nonzero. This records the obstruction to the proposed
zero-mode claim: the cross gain vanishes on `u + v`, while its loss term
remains. -/
theorem mass_gksl_not_fixed_dirac_of_two_ne {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v)
    (hE : (2 : ℕ) • (u + v) ≠ 0) :
    massGkslGenerator (R := R) u v (u + v) ≠ 0 := by
  rcases mass_gksl_reflexive_pair_actions (R := R) hu hv huv hvu with
    ⟨_, _, hDirac, _, _⟩
  have hMu : (u * v + v * u) * u = u := by
    have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
    calc
      _ = u * v * u + v * u * u := by noncomm_ring
      _ = u := by rw [huv, hVUU]; simp
  have hMv : (u * v + v * u) * v = v := by
    have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
    calc
      _ = u * v * v + v * u * v := by noncomm_ring
      _ = v := by rw [hUVV, hvu]; simp
  have hME : (u * v + v * u) * (u + v) = u + v := by
    rw [mul_add, hMu, hMv]
  rw [hDirac, hME]
  exact neg_ne_zero.mpr hE

/-- Square-zero operators commute with their Jordan mass product, while each
square-zero operator anticommutes with their commutator spin product. -/
theorem squareZero_pair_mass_spin_compatibility {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    u * (u * v + v * u) - (u * v + v * u) * u = 0 ∧
    v * (u * v + v * u) - (u * v + v * u) * v = 0 ∧
    u * (u * v - v * u) + (u * v - v * u) * u = 0 ∧
    v * (u * v - v * u) + (u * v - v * u) * v = 0 := by
  have huuV := squareZero_nested u hu v
  have hvvU := squareZero_nested v hv u
  refine ⟨?_, ?_, ?_, ?_⟩ <;> noncomm_ring [hu, hv, huuV, hvvU]

/-- The boundary Lie and Jordan actions on the Dirac sum and axial difference
of any two square-zero operators. These sector identities require no
reflexivity or commutativity assumption. -/
theorem squareZero_pair_electron_axial_actions {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    u * (u + v) - (u + v) * u = u * v - v * u ∧
    v * (u + v) - (u + v) * v = -(u * v - v * u) ∧
    u * (u + v) + (u + v) * u = u * v + v * u ∧
    v * (u + v) + (u + v) * v = u * v + v * u ∧
    u * (u - v) - (u - v) * u = -(u * v - v * u) ∧
    v * (u - v) - (u - v) * v = -(u * v - v * u) ∧
    u * (u - v) + (u - v) * u = -(u * v + v * u) ∧
    v * (u - v) + (u - v) * v = u * v + v * u := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> noncomm_ring [hu, hv]

/-- The commutator spin of a square-zero operator pair acts on each directed
corner by its cubic transition product. Reflexivity is needed to reduce these
products to the corners themselves, but not for the displayed identities. -/
theorem squareZero_pair_spin_corner_actions {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    (u * v - v * u) * u - u * (u * v - v * u) =
      (2 : ℕ) • (u * v * u) ∧
    (u * v - v * u) * v - v * (u * v - v * u) =
      -((2 : ℕ) • (v * u * v)) := by
  refine ⟨?_, ?_⟩
  · have huuV := squareZero_nested u hu v
    have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
    change (u * v - v * u) * u - u * (u * v - v * u) = _
    rw [show (2 : ℕ) • (u * v * u) = u * v * u + u * v * u by rw [two_nsmul]]
    noncomm_ring [hu, huuV, hVUU]
  · have hvvU := squareZero_nested v hv u
    have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
    change (u * v - v * u) * v - v * (u * v - v * u) = _
    rw [show (2 : ℕ) • (v * u * v) = v * u * v + v * u * v by rw [two_nsmul]]
    noncomm_ring [hv, hvvU, hUVV]

/-- The commutator spin of a square-zero pair exchanges its sum and
difference sectors with operator-valued Jordan mass coefficient. Applying
the spin commutator twice gives the corresponding mass-square action; no
scalar frequency or matrix coordinates are chosen. -/
theorem squareZero_pair_spin_precession {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    (u * v - v * u) * (u + v) - (u + v) * (u * v - v * u) =
      (2 : ℕ) • ((u * v + v * u) * (u - v)) ∧
    (u * v - v * u) * (u - v) - (u - v) * (u * v - v * u) =
      (2 : ℕ) • ((u * v + v * u) * (u + v)) ∧
    (u * v - v * u) *
        ((u * v - v * u) * (u + v) - (u + v) * (u * v - v * u)) -
      ((u * v - v * u) * (u + v) - (u + v) * (u * v - v * u)) *
        (u * v - v * u) =
      (4 : ℕ) • ((u * v + v * u) * (u * v + v * u) * (u + v)) := by
  have huuV := squareZero_nested u hu v
  have hvvU := squareZero_nested v hv u
  have hUVV : u * v * v = 0 := by rw [mul_assoc, hv, mul_zero]
  have hVUU : v * u * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have hUUvu : u * (u * (v * u)) = 0 := by
    calc
      u * (u * (v * u)) = (u * u) * (v * u) := by simp only [← mul_assoc]
      _ = 0 := by rw [hu, zero_mul]
  have hVVuv : v * (v * (u * v)) = 0 := by
    calc
      v * (v * (u * v)) = (v * v) * (u * v) := by simp only [← mul_assoc]
      _ = 0 := by rw [hv, zero_mul]
  refine ⟨?_, ?_, ?_⟩ <;>
    noncomm_ring [hu, hv, huuV, hvvU, hUVV, hVUU, hUUvu, hVVuv]

/-- The mass commutator and spin anticommutator identities for the two
opposite Peirce corners of an arbitrary idempotent. No reflexivity condition
on the corner operators is required. -/
theorem peirce_corner_mass_spin_compatibility {p a b : A}
    (hp : p * p = p) :
    component10 p a *
        (component10 p a * component01 p b + component01 p b * component10 p a) -
      (component10 p a * component01 p b + component01 p b * component10 p a) *
        component10 p a = 0 ∧
    component01 p b *
        (component10 p a * component01 p b + component01 p b * component10 p a) -
      (component10 p a * component01 p b + component01 p b * component10 p a) *
        component01 p b = 0 ∧
    component10 p a *
        (component10 p a * component01 p b - component01 p b * component10 p a) +
      (component10 p a * component01 p b - component01 p b * component10 p a) *
        component10 p a = 0 ∧
    component01 p b *
        (component10 p a * component01 p b - component01 p b * component10 p a) +
      (component10 p a * component01 p b - component01 p b * component10 p a) *
        component01 p b = 0 := by
  have ha := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp a
  have hb := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp b
  exact squareZero_pair_mass_spin_compatibility ha.1 hb.2

/-- Electron/axial boundary actions specialized to the opposite corners of an
idempotent. -/
theorem peirce_corner_electron_axial_actions {p a b : A}
    (hp : p * p = p) :
    component10 p a * (component10 p a + component01 p b) -
        (component10 p a + component01 p b) * component10 p a =
      component10 p a * component01 p b - component01 p b * component10 p a ∧
    component01 p b * (component10 p a + component01 p b) -
        (component10 p a + component01 p b) * component01 p b =
      -(component10 p a * component01 p b - component01 p b * component10 p a) ∧
    component10 p a * (component10 p a + component01 p b) +
        (component10 p a + component01 p b) * component10 p a =
      component10 p a * component01 p b + component01 p b * component10 p a ∧
    component01 p b * (component10 p a + component01 p b) +
        (component10 p a + component01 p b) * component01 p b =
      component10 p a * component01 p b + component01 p b * component10 p a ∧
    component10 p a * (component10 p a - component01 p b) -
        (component10 p a - component01 p b) * component10 p a =
      -(component10 p a * component01 p b - component01 p b * component10 p a) ∧
    component01 p b * (component10 p a - component01 p b) -
        (component10 p a - component01 p b) * component01 p b =
      -(component10 p a * component01 p b - component01 p b * component10 p a) ∧
    component10 p a * (component10 p a - component01 p b) +
        (component10 p a - component01 p b) * component10 p a =
      -(component10 p a * component01 p b + component01 p b * component10 p a) ∧
    component01 p b * (component10 p a - component01 p b) +
        (component10 p a - component01 p b) * component01 p b =
      component10 p a * component01 p b + component01 p b * component10 p a := by
  have ha := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp a
  have hb := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp b
  exact squareZero_pair_electron_axial_actions ha.1 hb.2

/-- Cubic spin-bracket actions for opposite Peirce corners of any idempotent. -/
theorem peirce_corner_spin_corner_actions {p a b : A} (hp : p * p = p) :
    (component10 p a * component01 p b - component01 p b * component10 p a) *
        component10 p a - component10 p a *
        (component10 p a * component01 p b - component01 p b * component10 p a) =
      (2 : ℕ) •
        (component10 p a * component01 p b * component10 p a) ∧
    (component10 p a * component01 p b - component01 p b * component10 p a) *
        component01 p b - component01 p b *
        (component10 p a * component01 p b - component01 p b * component10 p a) =
      -((2 : ℕ) •
        (component01 p b * component10 p a * component01 p b)) := by
  have ha := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp a
  have hb := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp b
  exact squareZero_pair_spin_corner_actions ha.1 hb.2

/-- Spin precession of the Dirac and axial combinations of opposite Peirce
corners. The amplitude is the operator-valued Jordan mass of those corners. -/
theorem peirce_corner_spin_precession {p a b : A} (hp : p * p = p) :
    (component10 p a * component01 p b - component01 p b * component10 p a) *
        (component10 p a + component01 p b) -
      (component10 p a + component01 p b) *
        (component10 p a * component01 p b - component01 p b * component10 p a) =
      (2 : ℕ) •
        ((component10 p a * component01 p b + component01 p b * component10 p a) *
          (component10 p a - component01 p b)) ∧
    (component10 p a * component01 p b - component01 p b * component10 p a) *
        (component10 p a - component01 p b) -
      (component10 p a - component01 p b) *
        (component10 p a * component01 p b - component01 p b * component10 p a) =
      (2 : ℕ) •
        ((component10 p a * component01 p b + component01 p b * component10 p a) *
          (component10 p a + component01 p b)) ∧
    (component10 p a * component01 p b - component01 p b * component10 p a) *
        ((component10 p a * component01 p b - component01 p b * component10 p a) *
            (component10 p a + component01 p b) -
          (component10 p a + component01 p b) *
            (component10 p a * component01 p b - component01 p b * component10 p a)) -
      ((component10 p a * component01 p b - component01 p b * component10 p a) *
            (component10 p a + component01 p b) -
          (component10 p a + component01 p b) *
            (component10 p a * component01 p b - component01 p b * component10 p a)) *
        (component10 p a * component01 p b - component01 p b * component10 p a) =
      (4 : ℕ) •
        ((component10 p a * component01 p b + component01 p b * component10 p a) *
          (component10 p a * component01 p b + component01 p b * component10 p a) *
          (component10 p a + component01 p b)) := by
  have ha := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp a
  have hb := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp b
  exact squareZero_pair_spin_precession ha.1 hb.2

/-- The dissipator trinity holds for the opposite Peirce corner operators of
an idempotent in the existing noncommutative algebra. -/
theorem peirce_corner_trinity {p a b : A} (hp : p * p = p) :
    (2 : ℕ) • crossDissipator (R := R) (component10 p a) (component01 p b) =
      sumDissipator (R := R) (component10 p a) (component01 p b) +
        differenceDissipator (R := R) (component10 p a) (component01 p b) ∧
    sumDissipator (R := R) (component10 p a) (component01 p b) =
      -(LieJordan.lieOp R (component10 p a + component01 p b) *
        LieJordan.lieOp R (component10 p a + component01 p b)) ∧
    differenceDissipator (R := R) (component10 p a) (component01 p b) =
      LieJordan.lieOp R (component10 p a - component01 p b) *
        LieJordan.lieOp R (component10 p a - component01 p b) := by
  have ha := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp a
  have hb := InfoGeometry.Core.IdempotentCartan.corners_square_zero hp b
  exact ⟨twice_crossDissipator_eq_sum_add_difference (R := R) _ _,
    sumDissipator_eq_neg_doubleLie (R := R) ha.1 hb.2,
    differenceDissipator_eq_doubleLie (R := R) ha.1 hb.2⟩

/-- The same-corner sandwich operator is natural under an algebra homomorphism. -/
theorem map_sameCornerChannel {B : Type*} [Ring B] [Algebra R B]
    (f : A →ₐ[R] B) (u v : A) :
    f.toLinearMap.comp (sameCornerChannel (R := R) u v) =
      (sameCornerChannel (R := R) (f u) (f v)).comp f.toLinearMap := by
  ext x
  simp [sameCornerChannel, LieJordan.sandwichOp]

/-- All three endomorphism dissipators intertwine with algebra homomorphisms.
This is the finite-stage naturality law used by directed-system maps. -/
theorem map_dissipator_trinity {B : Type*} [Ring B] [Algebra R B]
    (f : A →ₐ[R] B) (u v : A) :
    f.toLinearMap.comp (crossDissipator (R := R) u v) =
        (crossDissipator (R := R) (f u) (f v)).comp f.toLinearMap ∧
    f.toLinearMap.comp (sumDissipator (R := R) u v) =
        (sumDissipator (R := R) (f u) (f v)).comp f.toLinearMap ∧
    f.toLinearMap.comp (differenceDissipator (R := R) u v) =
        (differenceDissipator (R := R) (f u) (f v)).comp f.toLinearMap := by
  refine ⟨?_, ?_, ?_⟩ <;> ext x <;>
    simp [crossDissipator, sumDissipator, differenceDissipator,
      sameCornerChannel, LieJordan.crossTransport, LieJordan.sandwichOp,
      InfoGeometry.Core.JordanMultiplicationClosure.jordanLeft, map_ofNat]

/-- Algebra homomorphisms carry the directed Peirce corners to the corners
of the image idempotent. -/
theorem map_peirce_components {B : Type*} [Ring B] [Algebra R B]
    (f : A →ₐ[R] B) (p a : A) :
    f (component10 p a) = component10 (f p) (f a) ∧
      f (component01 p a) = component01 (f p) (f a) := by
  constructor <;>
    simp [component10, component01, complementIdempotent, map_mul, map_sub]

/-- Ring homomorphisms preserve the primitive relations defining a reflexive
Peirce horizon pair. This is the algebraic transport law used by directed
operator towers. -/
theorem ringHom_preserves_reflexive_pair {B : Type*} [Ring B]
    (f : A →+* B) (p u v : A)
    (hp : p * p = p) (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    f p * f p = f p ∧ f u * f u = 0 ∧ f v * f v = 0 ∧
      f u * f v * f u = f u ∧ f v * f u * f v = f v := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [← map_mul, hp]
  · rw [← map_mul, hu, map_zero]
  · rw [← map_mul, hv, map_zero]
  · rw [← map_mul, ← map_mul, huv]
  · rw [← map_mul, ← map_mul, hvu]

/-- The idempotent Jordan mass support of a reflexive pair remains idempotent
under every ring homomorphism. -/
theorem ringHom_preserves_reflexive_pair_mass_idempotent {B : Type*} [Ring B]
    (f : A →+* B) (u v : A)
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (f u * f v + f v * f u) * (f u * f v + f v * f u) =
      f u * f v + f v * f u := by
  simpa only [map_add, map_mul] using
    congrArg f (reflexive_pair_mass_idempotent hu hv huv hvu)

/-- An injective stage homomorphism preserves nonzero Jordan mass support.
Injectivity is a sufficient stage-wide condition for transporting
nonvanishing; for one particular mass, the exact condition is simply that its
image be nonzero. Idempotence and the operator root relations alone do not
imply preservation of nonvanishing. -/
theorem ringHom_preserves_nonzero_jordan_mass {B : Type*} [Ring B]
    (f : A →+* B) (hf : Function.Injective f) (u v : A)
    (hMass : u * v + v * u ≠ 0) :
    f u * f v + f v * f u ≠ 0 := by
  intro hImage
  apply hMass
  apply hf
  simpa only [map_add, map_mul, map_zero] using hImage

/-- Every unital ring image of a reflexive square-zero pair retains its full
operator `sl₂` root triad and quadratic Casimir. This is the root-system
transport law for arbitrary noncommutative algebra towers. -/
theorem ringHom_preserves_reflexive_pair_sl2 {B : Type*} [Ring B]
    (f : A →+* B) (u v : A)
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (f u * f v - f v * f u) * f u - f u * (f u * f v - f v * f u) =
      (2 : ℕ) • f u ∧
    (f u * f v - f v * f u) * f v - f v * (f u * f v - f v * f u) =
      -((2 : ℕ) • f v) ∧
    (f u * f v - f v * f u) * (f u * f v - f v * f u) +
      (2 : ℕ) • (f u * f v + f v * f u) =
        (3 : ℕ) • (f u * f v + f v * f u) := by
  have hu' : f u * f u = 0 := by rw [← map_mul, hu, map_zero]
  have hv' : f v * f v = 0 := by rw [← map_mul, hv, map_zero]
  have huv' : f u * f v * f u = f u := by
    rw [← map_mul, ← map_mul, huv]
  have hvu' : f v * f u * f v = f v := by
    rw [← map_mul, ← map_mul, hvu]
  have hRoot := reflexive_pair_sl2_relations hu' hv' huv' hvu'
  have hCasimir := reflexive_pair_casimir hu' hv' huv' hvu'
  exact ⟨hRoot.2.1, hRoot.2.2, hCasimir⟩

/-- Every algebra image of a reflexive horizon pair carries its mapped Jordan
mass operator as a stationary state of the corresponding cross dissipator. -/
theorem map_reflexive_pair_mass_stationary {B : Type*} [Ring B] [Algebra R B]
    (f : A →ₐ[R] B) (u v : A)
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    crossDissipator (R := R) (f u) (f v) (f (u * v + v * u)) = 0 := by
  have hu' : f u * f u = 0 := by rw [← map_mul, hu, map_zero]
  have hv' : f v * f v = 0 := by rw [← map_mul, hv, map_zero]
  have huv' : f u * f v * f u = f u := by
    rw [← map_mul, ← map_mul, huv]
  have hvu' : f v * f u * f v = f v := by
    rw [← map_mul, ← map_mul, hvu]
  rw [map_add, map_mul, map_mul]
  exact crossDissipator_apply_mass_of_reflexive (R := R) hu' hv' huv' hvu'

/-- Every ring-homomorphic stage image inherits the Dirac support and global
involution identities of a reflexive horizon pair. -/
theorem ringHom_preserves_reflexive_pair_dirac_support {B : Type*} [Ring B]
    (f : A →+* B) (u v : A)
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    (f u + f v) * (f u + f v) = f u * f v + f v * f u ∧
    (f u + f v) * (f u * f v + f v * f u) = f u + f v ∧
    (f u * f v + f v * f u) * (f u + f v) = f u + f v ∧
    ((1 - (f u * f v + f v * f u)) + (f u + f v)) *
      ((1 - (f u * f v + f v * f u)) + (f u + f v)) = 1 := by
  have hu' : f u * f u = 0 := by rw [← map_mul, hu, map_zero]
  have hv' : f v * f v = 0 := by rw [← map_mul, hv, map_zero]
  have huv' : f u * f v * f u = f u := by rw [← map_mul, ← map_mul, huv]
  have hvu' : f v * f u * f v = f v := by rw [← map_mul, ← map_mul, hvu]
  exact reflexive_pair_dirac_support_and_involution hu' hv' huv' hvu'

/-- The Peirce dissipator trinity is transported to every algebra image of an
idempotent, including finite stages of an inductive operator tower. -/
theorem peirce_trinity_natural {B : Type*} [Ring B] [Algebra R B]
    (f : A →ₐ[R] B) {p a b : A} (hp : p * p = p) :
    (2 : ℕ) • crossDissipator (R := R) (f (component10 p a))
        (f (component01 p b)) =
      sumDissipator (R := R) (f (component10 p a)) (f (component01 p b)) +
        differenceDissipator (R := R) (f (component10 p a)) (f (component01 p b)) ∧
    sumDissipator (R := R) (f (component10 p a)) (f (component01 p b)) =
      -(LieJordan.lieOp R (f (component10 p a) + f (component01 p b)) *
        LieJordan.lieOp R (f (component10 p a) + f (component01 p b))) ∧
    differenceDissipator (R := R) (f (component10 p a)) (f (component01 p b)) =
      LieJordan.lieOp R (f (component10 p a) - f (component01 p b)) *
        LieJordan.lieOp R (f (component10 p a) - f (component01 p b)) := by
  have hp' : f p * f p = f p := by rw [← map_mul, hp]
  rcases map_peirce_components f p a with ⟨ha, _⟩
  rcases map_peirce_components f p b with ⟨_, hb⟩
  simpa only [← ha, ← hb] using
    peirce_corner_trinity (R := R) (p := f p) (a := f a) (b := f b) hp'

end InfoGeometry.OperatorAlgebra.PeirceDissipatorTrinity
