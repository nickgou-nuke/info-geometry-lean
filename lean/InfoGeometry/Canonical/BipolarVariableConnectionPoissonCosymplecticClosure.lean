/-- Analytically witnessed flatness as an equality of native operator-valued
alternating two-forms. -/
theorem pristine_bundled_variable_curvature_core
    {s : ℂ} (hs : s ∈ punctured01)
    (u v : ℂ) (i j : Fin 2) :
    HasDerivAt
      (fun t : ℂ => variableCartanConnection (s + t * u) v i j)
      (connectionDirectionalDerivative s u v i j) 0 ∧
      variableExteriorDerivativeForm s = 0 ∧
      variableCartanCurvatureForm s = 0 := by
  exact bipolar_variable_curvature_form_packet hs u v i j

/-- The actual half-log lift differentiates to the displayed local primitive. -/
theorem pristine_analytic_pure_gauge_core
    {s : ℂ} (hs : s ∈ punctured01)
    (hslit : crossRatio01 s ∈ Complex.slitPlane)
    (v : ℂ) (i j : Fin 2) :
    HasDerivAt (fun t : ℂ => halfLogLift (s + t * v) i j)
      (halfLogLiftAnalyticDifferential s v i j) 0 ∧
      halfLogLiftInv s * halfLogLiftAnalyticDifferential s v =
        variableCartanConnection s v := by
  exact bipolar_half_log_pure_gauge_packet hs hslit v i j

/-- The observable bracket generated by commuting derivations satisfies the
three defining Poisson identities used at this frontier. -/
theorem pristine_commuting_derivation_poisson_core
    {A : Type*} [CommRing A] [Algebra ℝ A]
    (D : CommutingDerivationPair A) (F G H : A) :
    poissonBracket D F G = -poissonBracket D G F ∧
      poissonBracket D F (G * H) =
        poissonBracket D F G * H + G * poissonBracket D F H ∧
      poissonBracket D (poissonBracket D F G) H +
        poissonBracket D (poissonBracket D G H) F +
        poissonBracket D (poissonBracket D H F) G = 0 := by
  exact bipolar_poisson_algebra_packet D F G H

/-- The eta Casimir forces a skew cotangent map on the two-coordinate carrier
to vanish. -/
theorem pristine_two_coordinate_obstruction_core
    (L : Covector State2 →ₗ[ℝ] State2)
    (hskew : ∀ α β : Covector State2,
      α (L β) = -β (L α))
    (heta : L etaCovector2 = 0) :
    etaCovector2 ≠ 0 ∧ L thetaCovector2 = 0 ∧ L = 0 := by
  exact bipolar_two_dimensional_obstruction_packet L hskew heta

/-- The genuine linear cosymplectic datum on the completed carrier. -/
theorem pristine_linear_cosymplectic_core :
    cosymplecticVolume etaBasis3 thetaBasis3 auxiliaryBasis3 = 1 ∧
      etaCovector reebVector = 1 ∧
      (∀ v, horizontalTwoForm reebVector v = 0) ∧
      reversibleOperator etaCovector = 0 ∧
      horizontalTwoForm thetaBasis3 auxiliaryBasis3 = 1 := by
  exact bipolar_linear_cosymplectic_packet

/-- The completed GENERIC system retains both nontrivial lanes and satisfies the
energy/entropy laws. -/
theorem pristine_completed_GENERIC_core :
    bipolarGENERIC.L bipolarGENERIC.dS = 0 ∧
      bipolarGENERIC.M bipolarGENERIC.dH = 0 ∧
      bipolarGENERIC.L bipolarGENERIC.dH = -auxiliaryBasis3 ∧
      bipolarGENERIC.M bipolarGENERIC.dS = -etaBasis3 ∧
      bipolarGENERIC.dH bipolarGENERIC.flow = 0 ∧
      bipolarGENERIC.dS bipolarGENERIC.flow = 1 := by
  exact bipolar_GENERIC_packet

/-- Master closure theorem for the new development boundary. -/
theorem pristine_variable_poisson_cosymplectic_master
    {s : ℂ} (hs : s ∈ punctured01)
    (v : ℂ) :
    variableCartanCurvatureForm s = 0 ∧
      halfLogLiftInv s * halfLogLiftAnalyticDifferential s v =
        variableCartanConnection s v ∧
      cotangentPoissonPairing thetaCovector auxiliaryCovector = 1 ∧
      cosymplecticVolume etaBasis3 thetaBasis3 auxiliaryBasis3 = 1 ∧
      bipolarGENERIC.dH bipolarGENERIC.flow = 0 ∧
      bipolarGENERIC.dS bipolarGENERIC.flow = 1 := by
  exact ⟨variableCartanCurvatureForm_eq_zero s,
    halfLogLift_local_pure_gauge hs v,
    cotangentPoissonPairing_theta_auxiliary,
    cosymplecticVolume_basis,
    bipolarGENERIC_energy_rate,
    bipolarGENERIC_entropy_rate⟩

end InfoGeometry.Canonical.BipolarVariableConnectionPoissonCosymplecticClosure
