{"type":"new","contents":"import InfoGeometry.Canonical.GraphDiracPresentation\nimport InfoGeometry.Canonical.ThermodynamicChiralGraphCalculus\n\n/-!\n# Thermodynamic elaborator bridge\n\nThis module is the conservative compiler-facing bridge from thermodynamic\nλ-terms to graph-Dirac presentations.\n\nIt deliberately does not implement Lean metaprogramming yet.  Instead it\nprovides the proof-carrying target that an elaborator must produce:\n\n* a `ThermoTerm`;\n* a linear-resource certificate;\n* a decorated de Bruijn memory graph;\n* a `GraphMetricDirac` presentation;\n* thermodynamic and Dirac semantic certificates;\n* syntax-level Landauer cost readouts that reduce on concrete terms.\n-/\n\nnamespace InfoGeometry.Canonical\n\nopen InfoGeometry.Canonical.GraphDiracPresentation\nopen InfoGeometry.Canonical.ThermodynamicChiralGraphCalculus\n\nnamespace ThermodynamicChiralGraphCalculus\nnamespace ThermoTerm\n\n/-! ## Compile-time resource-cost readouts -/\n\n/-- Number of syntactic binders whose bound variable is unused in their body. -/\ndef erasedBinderCount : ThermoTerm → Nat\n  | db _ => 0\n  | lam body => (if body.freeVarCount 0 = 0 then 1 else 0) + body.erasedBinderCount\n  | app fn arg => fn.erasedBinderCount + arg.erasedBinderCount\n  | nu body => (if body.freeVarCount 0 = 0 then 1 else 0) + body.erasedBinderCount\n  | edge _ _ _ _ => 0\n  | tensor left right => left.erasedBinderCount + right.erasedBinderCount\n  | trace body => body.erasedBinderCount\n\n/-- Number of extra syntactic uses of binder variables beyond the first use. -/\ndef duplicatedBinderCount : ThermoTerm → Nat\n  | db _ => 0\n  | lam body => (body.freeVarCount 0 - 1) + body.duplicatedBinderCount\n  | app fn arg => fn.duplicatedBinderCount + arg.duplicatedBinderCount\n  | nu body => (body.freeVarCount 0 - 1) + body.duplicatedBinderCount\n  | edge _ _ _ _ => 0\n  | tensor left right => left.duplicatedBinderCount + right.duplicatedBinderCount\n  | trace body => body.duplicatedBinderCount\n\n/-- Total syntactic nonlinear binder pressure: erased binders plus duplicated uses. -/\ndef nonlinearBinderCount (t : ThermoTerm) : Nat :=\n  t.erasedBinderCount + t.duplicatedBinderCount\n\n/-- `log 2` is nonnegative, the scalar kernel of Landauer-style costs. -/\ntheorem log_two_nonneg : 0 ≤ Real.log 2 :=\n  Real.log_nonneg (by norm_num)\n\n/-- Landauer erasure cost in a caller-supplied nonnegative temperature scale.\n\nThe scale packages constants such as `kT`; this bridge records the algebraic\n`scale * log 2 * erasedBinderCount` readout. -/\nnoncomputable def landauerErasureCost (t : ThermoTerm) (scale : ℝ) : ℝ :=\n  scale * Real.log 2 * (t.erasedBinderCount : ℝ)\n\n/-- Syntactic nonlinear-resource cost using the same `scale * log 2` unit. -/\nnoncomputable def nonlinearResourceCost (t : ThermoTerm) (scale : ℝ) : ℝ :=\n  scale * Real.log 2 * (t.nonlinearBinderCount : ℝ)\n\n/-- Landauer erasure cost is nonnegative for nonnegative temperature scale. -/\ntheorem landauerErasureCost_nonneg\n    (t : ThermoTerm) {scale : ℝ} (hscale : 0 ≤ scale) :\n    0 ≤ t.landauerErasureCost scale := by\n  unfold landauerErasureCost\n  exact mul_nonneg (mul_nonneg hscale log_two_nonneg) (Nat.cast_nonneg _)\n\n/-- The total syntactic nonlinear-resource cost is nonnegative for nonnegative scale. -/\ntheorem nonlinearResourceCost_nonneg\n    (t : ThermoTerm) {scale : ℝ} (hscale : 0 ≤ scale) :\n    0 ≤ t.nonlinearResourceCost scale := by\n  unfold nonlinearResourceCost\n  exact mul_nonneg (mul_nonneg hscale log_two_nonneg) (Nat.cast_nonneg _)\n\nend ThermoTerm\nend ThermodynamicChiralGraphCalculus\n\nnamespace ThermodynamicElaboratorBridge\n\nopen ThermodynamicChiralGraphCalculus\n\n/-! ## Certified compilation target -/\n\n/-- Semantic witness that a term has been compiled into a graph-Dirac lane.\n\nThe two semantic predicates are supplied by an owner/compiler.  This bridge\nonly records that the accepted term is linear and that the semantic obligations\nare carried as proof fields. -/\nstructure ThermoGraphDiracCompilation (t : ThermoTerm) (D : GraphMetricDirac) where\n  linear : t.IsLinear\n  thermodynamicSemantics : Prop\n  thermodynamicSemantics_cert : thermodynamicSemantics\n  diracSemantics : Prop\n  diracSemantics_cert : diracSemantics\n\nnamespace ThermoGraphDiracCompilation\n\n@[simp] theorem linear_valid\n    {t : ThermoTerm} {D : GraphMetricDirac} (C : ThermoGraphDiracCompilation t D) :\n    t.IsLinear :=\n  C.linear\n\n@[simp] theorem thermodynamicSemantics_valid\n    {t : ThermoTerm} {D : GraphMetricDirac} (C : ThermoGraphDiracCompilation t D) :\n    C.thermodynamicSemantics :=\n  C.thermodynamicSemantics_cert\n\n@[simp] theorem diracSemantics_valid\n    {t : ThermoTerm} {D : GraphMetricDirac} (C : ThermoGraphDiracCompilation t D) :\n    C.diracSemantics :=\n  C.diracSemantics_cert\n\nend ThermoGraphDiracCompilation\n\n/-- Full proof-carrying target produced by a future thermodynamic elaborator. -/\nstructure CompiledThermoTerm where\n  term : ThermoTerm\n  dirac : GraphMetricDirac\n  compilation : ThermoGraphDiracCompilation term dirac\n  Alphabet : Type\n  alphabetDecidableEq : DecidableEq Alphabet\n  order : Nat\n  memoryGraph : DecoratedDeBruijnGraph Alphabet order\n  ThermoVertex : Type\n  ThermoEdge : Type\n  thermoGraph : DirectedThermoGraph ThermoVertex ThermoEdge\n  memoryGraphSemantics : Prop\n  memoryGraphSemantics_cert : memoryGraphSemantics\n  thermoGraphSemantics : Prop\n  thermoGraphSemantics_cert : thermoGraphSemantics\n\nnamespace CompiledThermoTerm\n\n/-- Accepted compiled terms satisfy the linear resource discipline. -/\n@[simp] theorem linear (C : CompiledThermoTerm) :\n    C.term.IsLinear :=\n  C.compilation.linear\n\n/-- The compiled graph-Dirac lane exposes its generic quantum presentation. -/\ndef quantumPresentation (C : CompiledThermoTerm) :=\n  C.dirac.toQuantumPresentation\n\n/-- The compiled graph-Dirac metric readout is nonnegative by the target contract. -/\ntheorem metricReadout_nonneg (C : CompiledThermoTerm) (ψ : C.dirac.State) :\n    0 ≤ C.dirac.metricReadout ψ :=\n  GraphMetricDirac.metricReadout_nonneg C.dirac ψ\n\n/-- Landauer erasure cost of the compiled source term. -/\nnoncomputable def landauerErasureCost (C : CompiledThermoTerm) (scale : ℝ) : ℝ :=\n  C.term.landauerErasureCost scale\n\n/-- Syntactic nonlinear-resource cost of the compiled source term. -/\nnoncomputable def nonlinearResourceCost (C : CompiledThermoTerm) (scale : ℝ) : ℝ :=\n  C.term.nonlinearResourceCost scale\n\n/-- Compiled-term Landauer cost is nonnegative for nonnegative scale. -/\ntheorem landauerErasureCost_nonneg\n    (C : CompiledThermoTerm) {scale : ℝ} (hscale : 0 ≤ scale) :\n    0 ≤ C.landauerErasureCost scale :=\n  C.term.landauerErasureCost_nonneg hscale\n\n/-- Compiled-term nonlinear-resource cost is nonnegative for nonnegative scale. -/\ntheorem nonlinearResourceCost_nonneg\n    (C : CompiledThermoTerm) {scale : ℝ} (hscale : 0 ≤ scale) :\n    0 ≤ C.nonlinearResourceCost scale :=\n  C.term.nonlinearResourceCost_nonneg hscale\n\n@[simp] theorem memoryGraphSemantics_valid (C : CompiledThermoTerm) :\n    C.memoryGraphSemantics :=\n  C.memoryGraphSemantics_cert\n\n@[simp] theorem thermoGraphSemantics_valid (C : CompiledThermoTerm) :\n    C.thermoGraphSemantics :=\n  C.thermoGraphSemantics_cert\n\nend CompiledThermoTerm\n\n/-! ## Strict compiler interface -/\n\n/-- Abstract strict compiler interface.\n\nAn executable elaborator may later instantiate `compile`.  The soundness field\nis the important boundary: if compilation succeeds, the returned package really\nbelongs to the input term and the input term is linear. -/\nstructure StrictThermoCompiler where\n  compile : ThermoTerm → Option CompiledThermoTerm\n  sound : ∀ t C, compile t = some C → C.term = t ∧ t.IsLinear\n\nnamespace StrictThermoCompiler\n\n/-- Extract only the compiled graph-Dirac target from a strict compiler. -/\ndef compileDirac (K : StrictThermoCompiler) (t : ThermoTerm) : Option GraphMetricDirac :=\n  (K.compile t).map (fun C => C.dirac)\n\n/-- A successful strict compilation accepts only linear terms. -/\ntheorem linear_of_compile_eq_some\n    (K : StrictThermoCompiler) {t : ThermoTerm} {C : CompiledThermoTerm}\n    (h : K.compile t = some C) :\n    t.IsLinear :=\n  (K.sound t C h).2\n\n/-- A successful strict compilation returns a package for exactly the input term. -/\ntheorem compiled_term_eq_of_compile_eq_some\n    (K : StrictThermoCompiler) {t : ThermoTerm} {C : CompiledThermoTerm}\n    (h : K.compile t = some C) :\n    C.term = t :=\n  (K.sound t C h).1\n\n/-- Successful full compilation yields the same graph-Dirac target via `compileDirac`. -/\ntheorem compileDirac_eq_some_of_compile_eq_some\n    (K : StrictThermoCompiler) {t : ThermoTerm} {C : CompiledThermoTerm}\n    (h : K.compile t = some C) :\n    K.compileDirac t = some C.dirac := by\n  simp [compileDirac, h]\n\nend StrictThermoCompiler\n\n/-! ## Small executable cost examples -/\n\nnamespace Examples\n\n/-- Identity λ-term `λx. x`. -/\ndef identityTerm : ThermoTerm :=\n  ThermoTerm.lam (ThermoTerm.db 0)\n\n/-- Erasing λ-term `λx. edge`, used as a Landauer-cost sanity example. -/\ndef erasingEdgeTerm : ThermoTerm :=\n  ThermoTerm.lam (ThermoTerm.edge 0 0 1 1)\n\n@[simp] theorem identityTerm_linear :\n    identityTerm.IsLinear := by\n  simp [identityTerm, ThermoTerm.IsLinear, ThermoTerm.IsLinearAt, ThermoTerm.freeVarCount]\n\n@[simp] theorem erasingEdgeTerm_linear :\n    erasingEdgeTerm.IsLinear := by\n  simp [erasingEdgeTerm, ThermoTerm.IsLinear, ThermoTerm.IsLinearAt,\n    ThermoTerm.freeVarCount]\n\n@[simp] theorem identityTerm_erasedBinderCount :\n    identityTerm.erasedBinderCount = 0 := by\n  simp [identityTerm, ThermoTerm.erasedBinderCount, ThermoTerm.freeVarCount]\n\n@[simp] theorem erasingEdgeTerm_erasedBinderCount :\n    erasingEdgeTerm.erasedBinderCount = 1 := by\n  simp [erasingEdgeTerm, ThermoTerm.erasedBinderCount, ThermoTerm.freeVarCount]\n\n@[simp] theorem identityTerm_landauerErasureCost_eq_zero (scale : ℝ) :\n    identityTerm.landauerErasureCost scale = 0 := by\n  simp [ThermoTerm.landauerErasureCost]\n\n@[simp] theorem erasingEdgeTerm_landauerErasureCost_eq (scale : ℝ) :\n    erasingEdgeTerm.landauerErasureCost scale = scale * Real.log 2 := by\n  simp [ThermoTerm.landauerErasureCost]\n\nend Examples\n\nend ThermodynamicElaboratorBridge\nend InfoGeometry.Canonical\n","mtime":1778316652685}