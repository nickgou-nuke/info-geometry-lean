{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TranslationControlPacket.schema.json",
  "title": "TranslationControlPacket",
  "allOf": [
    {
      "$ref": "common_envelope.schema.json"
    },
    {
      "$ref": "authority.schema.json"
    },
    {
      "$ref": "representation.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "packet_version",
        "packet_hash",
        "source_class",
        "control_scope",
        "purpose",
        "rules",
        "symbol_controls",
        "forbidden_uses",
        "not_proof_authority",
        "promotion_allowed"
      ],
      "properties": {
        "kind": {
          "const": "TranslationControlPacket"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "superseded",
            "archived"
          ]
        },
        "authority": {
          "const": "semantic"
        },
        "authority_origin": {
          "const": "translation_control"
        },
        "packet_version": {
          "type": "string",
          "minLength": 1
        },
        "packet_hash": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_ref.schema.json"
          }
        },
        "control_scope": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "symbol_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_symbol",
              "classification",
              "inference_required",
              "lean_strategy"
            ],
            "properties": {
              "source_symbol": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "type": "string",
                "minLength": 1
              },
              "inference_required": {
                "type": "string",
                "enum": [
                  "target_type",
                  "local_class_context",
                  "binder_scope",
                  "choice_semantics",
                  "operator_substrate",
                  "none"
                ]
              },
              "lean_strategy": {
                "type": "string",
                "minLength": 1
              },
              "forbidden_mappings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "choice_controls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_construct",
              "lean_strategy",
              "guard"
            ],
            "properties": {
              "source_construct": {
                "type": "string",
                "minLength": 1
              },
              "lean_strategy": {
                "type": "string",
                "minLength": 1
              },
              "guard": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "forbidden_uses": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "proof"
          },
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_uses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_proof_authority": {
          "const": true
        },
        "promotion_allowed": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  ]
}
