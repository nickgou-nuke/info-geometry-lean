{"type":"new","contents":"import Lean\nimport DAG.Basic\nimport DAG.Hydrate\nimport DAG.Analysis\n\n/-!\n# Docs.emit_blueprint_tex\n\nLaTeX blueprint emission from DAG-derived skeletons.\n-/\n\nopen Lean\nopen DAG\n\nnamespace Docs\n\n/-- Escapes Lean names for LaTeX (e.g., replaces underscores with \\_). -/\ndef escapeLatex (s : String) : String :=\n  s.replace \"_\" \"\\\\_\"\n\n/-- Generates a LaTeX section for a specific node in the True Skeleton. -/\ndef emitSkeletonNode (env : Environment) (name : Name) (vulSrcs : Nat) : IO String := do\n  let nameStr := escapeLatex name.toString\n  let mut out := \"\\\\subsection{\" ++ nameStr ++ \"}\\n\"\n\n  -- Add a metric badge showing its topological importance\n  out := out ++\n    \"\\\\noindent\\\\textbf{Topological Vulnerability:} \" ++\n    toString vulSrcs ++ \" downstream dependencies.\\\\\\\\ \\n\\n\"\n\n  -- Extract docstring if available\n  if let some doc ← Lean.findDocString? env name then\n    out := out ++ doc ++ \"\\n\\n\"\n\n  -- Extract type signature\n  if let some ci := env.find? name then\n    let typeStr := toString ci.type\n    let kind := match ci with\n      | .thmInfo _ => \"theorem\"\n      | .defnInfo _ => \"definition\"\n      | _ => \"remark\"\n\n    out := out ++ \"\\\\begin{\" ++ kind ++ \"}[\" ++ nameStr ++ \"]\\n\"\n    out := out ++ \"\\\\begin{verbatim}\\n\" ++ typeStr ++ \"\\n\\\\end{verbatim}\\n\"\n    out := out ++ \"\\\\end{\" ++ kind ++ \"}\\n\\n\"\n\n  return out\n\n/-- Generates the full LaTeX Blueprint document. -/\ndef emitBlueprint (env : Environment) (nsPrefix : String) (outPath : String) : IO Unit := do\n  IO.println \"[Blueprint] Hydrating DAG and extracting True Skeleton...\"\n  let g := buildGraphFromEnv env (some nsPrefix)\n  let h := hydrate g\n  let skeleton := extractTheorySkeleton h 1\n\n  let mut tex := \"% Auto-generated by InfoGeometry DAG Engine\\n\"\n  tex := tex ++ \"\\\\documentclass{article}\\n\"\n  tex := tex ++ \"\\\\usepackage{amsmath, amssymb, amsthm}\\n\"\n  tex := tex ++ \"\\\\usepackage[colorlinks=true]{hyperref}\\n\"\n  tex := tex ++ \"\\\\newtheorem{theorem}{Theorem}[section]\\n\"\n  tex := tex ++ \"\\\\newtheorem{definition}{Definition}[section]\\n\"\n  tex := tex ++ \"\\\\begin{document}\\n\"\n  tex := tex ++ \"\\\\title{InfoGeometry: Automated Blueprint}\\n\"\n  tex := tex ++ \"\\\\author{Socratic AI \\\\& Lean 4}\\n\"\n  tex := tex ++ \"\\\\maketitle\\n\\n\"\n\n  tex := tex ++ \"\\\\section{The Core Topological Skeleton}\\n\"\n  tex := tex ++\n    \"The following concepts form the structural load-bearing pillars of the theory, \" ++\n    \"ranked by their downstream impact.\\n\\n\"\n\n  for (n, _, vulSrcs) in skeleton do\n    let nodeTex ← emitSkeletonNode env n vulSrcs\n    tex := tex ++ nodeTex\n\n  tex := tex ++ \"\\\\end{document}\\n\"\n\n  IO.FS.writeFile (System.FilePath.mk outPath) tex\n  IO.println s!\"[Blueprint] Successfully wrote LaTeX blueprint to {outPath}\"\n\nend Docs\n\n/-- Top-level `--run` entry point for blueprint emission. -/\ndef emit_blueprint_main (args : List String) : IO UInt32 := do\n  let ns := args.headD \"InfoGeometry\"\n  let outPath := if args.length > 1 then args[1]! else \"blueprint.tex\"\n\n  Lean.initSearchPath (← Lean.findSysroot)\n  let env ← Lean.importModules #[{ module := `InfoGeometry }] {}\n\n  Docs.emitBlueprint env ns outPath\n  return 0\n\n/-- `lake env lean --run` entrypoint. -/\ndef main (args : List String) : IO UInt32 :=\n  emit_blueprint_main args\n","mtime":1776602621962}