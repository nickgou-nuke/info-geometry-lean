import Mathlib.Topology.Homeomorph.Defs
import Mathlib.Data.Real.Basic
import Mathlib.Tactic

namespace InfoGeometry.Topology.Weyl

/-- The momentum space equipped with a non-symmorphic glide reflection. -/
structure GlideBrillouinZone (BZ : Type*) [TopologicalSpace BZ] where
  -- The glide reflection operator
  glide : BZ ≃ₜ BZ
  -- The glide reflection is an involution on the momentum space
  h_involution : ∀ k, glide (glide k) = k

variable {BZ : Type*} [TopologicalSpace BZ]
variable (gbz : GlideBrillouinZone BZ)

/-- The Berry Curvature as a generic real-valued function over the BZ.
In a non-orientable Weyl semimetal, the Berry curvature is pseudo-scalar,
meaning it flips sign under the glide reflection. -/
structure TwistedBerryCurvature (gbz : GlideBrillouinZone BZ) where
  curvature : BZ → ℝ
  -- Z_2 Charge Cancellation: The curvature is odd under glide reflection
  h_twisted : ∀ k, curvature (gbz.glide k) = - curvature k

/-- Explicit oddness predicate for a Berry-curvature readout on the glide Brillouin zone. -/
def IsGlideOddCurvature (ω : BZ → ℝ) : Prop :=
  ∀ k, ω (gbz.glide k) = -ω k

variable (F : TwistedBerryCurvature gbz)

/-- Explicit theorem surface: a glide-odd Berry curvature flips sign under the glide. -/
@[simp] theorem glide_odd_curvature_strictly_odd
    (ω : BZ → ℝ) (hω : IsGlideOddCurvature gbz ω) (k : BZ) :
    ω (gbz.glide k) = - ω k :=
  hω k

/-- The structure-field witness promotes to the explicit oddness predicate. -/
theorem twistedBerryCurvature_isGlideOdd : IsGlideOddCurvature gbz F.curvature := by
  exact F.h_twisted

/-- Owner readout for the packaged `TwistedBerryCurvature` surface. -/
@[simp] theorem berry_curvature_strictly_odd (k : BZ) :
    F.curvature (gbz.glide k) = - F.curvature k :=
  F.h_twisted k

/--
THEOREM: Z_2 Charge Cancellation on Non-Orientable Manifolds.
Because the Berry curvature is odd under the glide reflection,
the total integral over the orientable double cover cancels exactly to zero.
This forces the Nielsen-Ninomiya total chirality to be measured
in twisted (co)homology (modulo 2) rather than Z.

Mathlib root:
* `glide_odd_curvature_strictly_odd` is the explicit oddness hypothesis readout;
* `Mathlib.Data.Real.Basic` supplies `add_neg_cancel`, closing the cancellation.
-/
theorem glide_odd_curvature_cancellation
    (ω : BZ → ℝ) (hω : IsGlideOddCurvature gbz ω) (k : BZ) :
    ω k + ω (gbz.glide k) = (0 : ℝ) := by
  calc
    ω k + ω (gbz.glide k) = ω k + (- ω k : ℝ) := by
      exact congrArg (fun x => ω k + x) (glide_odd_curvature_strictly_odd gbz ω hω k)
    _ = (0 : ℝ) := add_neg_cancel (ω k)

/-- Packaged cancellation theorem for the `TwistedBerryCurvature` owner surface. -/
theorem berry_curvature_odd_cancellation (k : BZ) :
    F.curvature k + F.curvature (gbz.glide k) = (0 : ℝ) := by
  calc
    F.curvature k + F.curvature (gbz.glide k)
        = F.curvature k + (-F.curvature k : ℝ) := by
            exact congrArg (fun x => F.curvature k + x) (F.h_twisted k)
    _ = (0 : ℝ) := add_neg_cancel (F.curvature k)

/-! ## Two-sheet finite Berry connection owner surface -/

/-- The two sheets of the orientable/chiral double cover. -/
inductive ChiralSheet where
  | plus
  | minus
  deriving DecidableEq, Repr

namespace ChiralSheet

/-- The deck involution exchanging the two chiral sheets. -/
def swap : ChiralSheet → ChiralSheet
  | plus => minus
  | minus => plus

@[simp] theorem swap_plus : swap plus = minus := rfl

@[simp] theorem swap_minus : swap minus = plus := rfl

@[simp] theorem swap_swap (s : ChiralSheet) : s.swap.swap = s := by
  cases s <;> rfl

end ChiralSheet

/-- A finite two-sheet Berry connection represented by a real potential on each sheet. -/
abbrev BerryConnection (gbz : GlideBrillouinZone BZ) := ChiralSheet → BZ → ℝ

namespace BerryConnection

abbrev potential {gbz : GlideBrillouinZone BZ}
    (A : BerryConnection gbz) : ChiralSheet → BZ → ℝ := A

end BerryConnection

/-- A finite two-sheet Berry curvature represented by a real curvature on each sheet. -/
abbrev SheetBerryCurvature (gbz : GlideBrillouinZone BZ) := ChiralSheet → BZ → ℝ

namespace SheetBerryCurvature

abbrev curvature {gbz : GlideBrillouinZone BZ}
    (Ω : SheetBerryCurvature gbz) : ChiralSheet → BZ → ℝ := Ω

end SheetBerryCurvature

/-- The curvature induced by the finite glide difference of a Berry potential. -/
def IsInducedCurvature (A : BerryConnection gbz) (Ω : SheetBerryCurvature gbz) : Prop :=
  ∀ s k, Ω.curvature s k = A.potential s (gbz.glide k) - A.potential s k

/-! ## Constructed sheet/glide-odd owner -/

/-- A sheet/glide-odd potential generated from a base real function on the Brillouin zone. -/
def oddSheetPotential (φ : BZ → ℝ) : ChiralSheet → BZ → ℝ
  | .plus, k => φ k
  | .minus, k => -φ (gbz.glide k)

/-- The Berry connection generated by a sheet/glide-odd base potential. -/
def oddSheetConnection (φ : BZ → ℝ) : BerryConnection gbz :=
  oddSheetPotential gbz φ

/-- The curvature obtained by the finite glide-difference of a Berry connection. -/
def inducedSheetBerryCurvature (A : BerryConnection gbz) : SheetBerryCurvature gbz :=
  fun s k => A.potential s (gbz.glide k) - A.potential s k

@[simp] theorem inducedSheetBerryCurvature_isInduced
    (A : BerryConnection gbz) :
    IsInducedCurvature gbz A (inducedSheetBerryCurvature gbz A) := by
  intro s k
  rfl

/-- The generated potential is odd under the combined sheet/glide involution. -/
theorem oddSheetConnection_owner_odd (φ : BZ → ℝ) :
    ∀ s k,
      (oddSheetConnection gbz φ).potential s.swap (gbz.glide k) =
        -(oddSheetConnection gbz φ).potential s k := by
  intro s k
  cases s
  · simp [oddSheetConnection, oddSheetPotential, gbz.h_involution k]
  · simp [oddSheetConnection, oddSheetPotential]

/--
With sheet/glide-even potential transport, the induced two-sheet curvature is even under
simultaneously swapping sheets and applying the glide.
-/
theorem sheet_berry_curvature_owner_even
    (A : BerryConnection gbz) (Ω : SheetBerryCurvature gbz)
    (h_induced : IsInducedCurvature gbz A Ω)
    (h_owner : ∀ s k, A.potential s.swap (gbz.glide k) = A.potential s k)
    (s : ChiralSheet) (k : BZ) :
    Ω.curvature s.swap (gbz.glide k) = Ω.curvature s k := by
  calc
    Ω.curvature s.swap (gbz.glide k)
        = A.potential s.swap (gbz.glide (gbz.glide k)) -
            A.potential s.swap (gbz.glide k) := by
          exact h_induced s.swap (gbz.glide k)
    _ = A.potential s.swap k - A.potential s k := by
          rw [gbz.h_involution k, h_owner s k]
    _ = A.potential s (gbz.glide k) - A.potential s k := by
          rw [← h_owner s.swap k, ChiralSheet.swap_swap]
    _ = Ω.curvature s k := by
          exact (h_induced s k).symm

/--
With sheet/glide-odd potential transport, the induced two-sheet curvature is odd under
simultaneously swapping sheets and applying the glide.
-/
theorem sheet_berry_curvature_owner_odd
    (A : BerryConnection gbz) (Ω : SheetBerryCurvature gbz)
    (h_induced : IsInducedCurvature gbz A Ω)
    (h_owner : ∀ s k, A.potential s.swap (gbz.glide k) = -A.potential s k)
    (s : ChiralSheet) (k : BZ) :
    Ω.curvature s.swap (gbz.glide k) = -Ω.curvature s k := by
  calc
    Ω.curvature s.swap (gbz.glide k)
        = A.potential s.swap (gbz.glide (gbz.glide k)) -
            A.potential s.swap (gbz.glide k) := by
          exact h_induced s.swap (gbz.glide k)
    _ = A.potential s.swap k - (-A.potential s k) := by
          rw [gbz.h_involution k, h_owner s k]
    _ = -A.potential s (gbz.glide k) - (-A.potential s k) := by
          have hs₁ : A.potential s (gbz.glide k) = -A.potential s.swap k := by
            simpa [ChiralSheet.swap_swap] using h_owner s.swap k
          have hs : A.potential s.swap k = -A.potential s (gbz.glide k) := by
            simpa using (congrArg Neg.neg hs₁).symm
          rw [hs]
    _ = -(A.potential s (gbz.glide k) - A.potential s k) := by
          rw [sub_eq_add_neg, sub_eq_add_neg, neg_add_rev, neg_neg, add_comm]
    _ = -Ω.curvature s k := by
          rw [h_induced s k]

/--
Odd sheet/glide curvature cancels on each two-point orbit.

This is the theorem-safe finite readout of the oddness law.  It is only an
additive cancellation statement over `ℝ`; no analytic integral, Chern class, or
smooth Berry bundle is asserted here.
-/
theorem sheet_berry_curvature_owner_odd_cancellation
    (A : BerryConnection gbz) (Ω : SheetBerryCurvature gbz)
    (h_induced : IsInducedCurvature gbz A Ω)
    (h_owner : ∀ s k, A.potential s.swap (gbz.glide k) = -A.potential s k)
    (s : ChiralSheet) (k : BZ) :
    Ω.curvature s k + Ω.curvature s.swap (gbz.glide k) = 0 := by
  rw [sheet_berry_curvature_owner_odd gbz A Ω h_induced h_owner s k]
  exact add_neg_cancel (Ω.curvature s k)

/-- Fully constructed finite two-sheet Berry curvature is odd under sheet/glide. -/
theorem induced_oddSheetBerryCurvature_owner_odd (φ : BZ → ℝ)
    (s : ChiralSheet) (k : BZ) :
    (inducedSheetBerryCurvature gbz (oddSheetConnection gbz φ)).curvature s.swap (gbz.glide k) =
      -(inducedSheetBerryCurvature gbz (oddSheetConnection gbz φ)).curvature s k := by
  exact sheet_berry_curvature_owner_odd gbz (oddSheetConnection gbz φ)
    (inducedSheetBerryCurvature gbz (oddSheetConnection gbz φ))
    (inducedSheetBerryCurvature_isInduced gbz (oddSheetConnection gbz φ))
    (oddSheetConnection_owner_odd gbz φ) s k

/-- Fully constructed finite two-sheet Berry curvature cancels on each sheet/glide pair. -/
theorem induced_oddSheetBerryCurvature_owner_odd_cancellation (φ : BZ → ℝ)
    (s : ChiralSheet) (k : BZ) :
    (inducedSheetBerryCurvature gbz (oddSheetConnection gbz φ)).curvature s k +
      (inducedSheetBerryCurvature gbz (oddSheetConnection gbz φ)).curvature s.swap
        (gbz.glide k) = 0 := by
  rw [induced_oddSheetBerryCurvature_owner_odd gbz φ s k]
  exact add_neg_cancel ((inducedSheetBerryCurvature gbz (oddSheetConnection gbz φ)).curvature s k)

end InfoGeometry.Topology.Weyl
