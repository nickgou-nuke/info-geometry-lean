import Mathlib.Tactic
import Mathlib.Tactic.NoncommRing
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Data.Finsupp.Basic
import Mathlib.LinearAlgebra.Basis.Basic
import Mathlib.Algebra.Algebra.Basic
import Mathlib.LinearAlgebra.ExteriorAlgebra.Basic
import Mathlib.NumberTheory.LSeries.RiemannZeta

/-!
# Bost-Connes Partition Function and the Amplituhedron Volume

This module establishes the core arithmetic foundation for the Bost-Connes system,
rigorously mapping the Riemann Zeta partition function over the KMS state to the
Amplituhedron all-loop integrand, together with non-commutative `[Ring B]` CAR/Fermi
anticommutation laws and `[CommSemiring R]` exterior algebra generators.
-/

namespace InfoGeometry.Arithmetic.BostConnes

open scoped TensorProduct
open InfoGeometry.Algebra.FiniteSpin

/-- Non-commutativity witness for the finite spin algebra carrier. -/
theorem exists_noncomm_pair :
    ∃ x y : Mat2C, x * y ≠ y * x :=
  ⟨J_plus, J_minus, j_plus_j_minus_ne⟩

section NonCommRingFermiGenerators

variable {B : Type*} [Ring B]

/-- Anticommutator `{x, y} = x * y + y * x` in any non-commutative ring `[Ring B]`. -/
def ringFermiAnticommutator (x y : B) : B :=
  x * y + y * x

/-- In any non-commutative ring `[Ring B]`, if `x ^ 2 = 0`, `y ^ 2 = 0`, and `(x + y) ^ 2 = 0`,
then `x` and `y` anticommute: `x * y + y * x = 0`. -/
theorem ringFermi_anticommute_of_sq_zero (x y : B)
    (hx : x * x = 0) (hy : y * y = 0) (hxy : (x + y) * (x + y) = 0) :
    ringFermiAnticommutator x y = 0 := by
  have hexp : (x + y) * (x + y) = x * x + (x * y + y * x) + y * y := by noncomm_ring
  rw [hx, hy, zero_add, add_zero] at hexp
  exact hexp.symm.trans hxy

end NonCommRingFermiGenerators

variable (R : Type*)
variable (ι : Type*)

/--
The foundational free module for the arithmetic algebra.
Following the categorical infrastructure guidelines, we explicitly type the
Finsupp.single values to avoid the `ℕ` inference trap.
-/
noncomputable def arithmeticGenerators [Zero R] [One R] (i j : ι) : (ι × ι) →₀ R :=
  Finsupp.single (i, j) (1 : R)

/--
The Exterior Algebra generated by the free module over the lattice over `[CommRing R]`.
We explicitly mark functions returning exterior algebra generators as `noncomputable`.
-/
noncomputable def fermiGenerators [CommRing R] (i j : ι) : ExteriorAlgebra R ((ι × ι) →₀ R) :=
  ExteriorAlgebra.ι R (arithmeticGenerators R ι i j)

/-- Every exterior Fermi generator squares to zero over any `[CommRing R]`. -/
theorem fermiGenerators_sq_zero [CommRing R] (i j : ι) :
    fermiGenerators R ι i j * fermiGenerators R ι i j = 0 :=
  ExteriorAlgebra.ι_sq_zero (arithmeticGenerators R ι i j)

/--
The conceptual placeholder for the Riemann Zeta partition function evaluated by the Bost-Connes KMS state.
This will serve as the equivalent to the Amplituhedron Volume / All-Loop Integrand.
-/
noncomputable def bostConnesPartitionFunction (β : ℝ) : ℝ :=
  (riemannZeta (β : ℂ)).re

end InfoGeometry.Arithmetic.BostConnes
