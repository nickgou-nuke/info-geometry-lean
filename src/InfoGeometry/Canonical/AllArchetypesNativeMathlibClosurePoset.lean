/-! ===========================================================================
    Part I: The 3-Stage Simplex & Convex Optimization Archetype Poset
    (`𝔖𝔒₁ ≺ 𝔖𝔒₂ ≺ 𝔖𝔒₃`)
    =========================================================================== -/

/-- The 3 causal stages of the Native Mathlib Simplex & Convex Optimization Archetypes:
- `SO1_CompactSimplexFiniteMaximumAttainment`: Weierstrass extreme-value theorem on `stdSimplex ℝ ι`,
- `SO2_ConvexSimplexCenterMassVertexBound`: Jensen / center-of-mass upper bound by simplex vertices,
- `SO3_StrictUniqueMaximumExtremePoint`: Bauer maximum principle — a strict unique maximum of a
  convex function on `stdSimplex ℝ ι` is an extreme point. -/
inductive SimplexOptimizationArchetype : Type
  | SO1_CompactSimplexFiniteMaximumAttainment
  | SO2_ConvexSimplexCenterMassVertexBound
  | SO3_StrictUniqueMaximumExtremePoint
  deriving DecidableEq, Repr, Inhabited

namespace SimplexOptimizationArchetype

def rank : SimplexOptimizationArchetype → Fin 3
  | .SO1_CompactSimplexFiniteMaximumAttainment => 0
  | .SO2_ConvexSimplexCenterMassVertexBound => 1
  | .SO3_StrictUniqueMaximumExtremePoint => 2

theorem rank_bijective : Function.Bijective rank := by
  constructor
  · intro a b h
    cases a <;> cases b <;> simp [rank] at h ⊢
  · intro i
    fin_cases i
    · exact ⟨.SO1_CompactSimplexFiniteMaximumAttainment, rfl⟩
    · exact ⟨.SO2_ConvexSimplexCenterMassVertexBound, rfl⟩
    · exact ⟨.SO3_StrictUniqueMaximumExtremePoint, rfl⟩

instance : LinearOrder SimplexOptimizationArchetype :=
  LinearOrder.lift' rank rank_bijective.injective

instance : Fintype SimplexOptimizationArchetype where
  elems := {
    .SO1_CompactSimplexFiniteMaximumAttainment,
    .SO2_ConvexSimplexCenterMassVertexBound,
    .SO3_StrictUniqueMaximumExtremePoint
  }
  complete x := by cases x <;> simp

end SimplexOptimizationArchetype

/-- Native Mathlib proposition attached to each `SimplexOptimizationArchetype` stage
(instantiated concretely on `Fin 3`). -/
def simplexOptimizationClaim : SimplexOptimizationArchetype → Prop
  | .SO1_CompactSimplexFiniteMaximumAttainment =>
      ∀ (f : Convexity.StdSimplex ℝ (Fin 3) → ℝ), Continuous f →
        ∃ x : Convexity.StdSimplex ℝ (Fin 3),
          ∀ y : Convexity.StdSimplex ℝ (Fin 3), f y ≤ f x
  | .SO2_ConvexSimplexCenterMassVertexBound =>
      ∀ (f : (Fin 3 → ℝ) → ℝ), ConvexOn ℝ (stdSimplex ℝ (Fin 3)) f →
        ∀ x ∈ stdSimplex ℝ (Fin 3), ∀ M : ℝ,
          (∀ i : Fin 3, f (Pi.single i 1) ≤ M) → f x ≤ M
  | .SO3_StrictUniqueMaximumExtremePoint =>
      ∀ (f : (Fin 3 → ℝ) → ℝ) (x : Fin 3 → ℝ),
        ConvexOn ℝ (stdSimplex ℝ (Fin 3)) f →
        x ∈ stdSimplex ℝ (Fin 3) →
        (∀ y ∈ stdSimplex ℝ (Fin 3), y ≠ x → f y < f x) →
        x ∈ Set.extremePoints ℝ (stdSimplex ℝ (Fin 3))

/-- **Theorem (`simplexOptimizationClaim_all`)**:
Discharges all three native Mathlib simplex & convex optimization archetypes. -/
theorem simplexOptimizationClaim_all (s : SimplexOptimizationArchetype) :
    simplexOptimizationClaim s := by
  cases s with
  | SO1_CompactSimplexFiniteMaximumAttainment =>
      intro f hf
      exact continuous_attains_finiteMaximum f hf
  | SO2_ConvexSimplexCenterMassVertexBound =>
      intro f hf x hx M hM
      exact convexOn_stdSimplex_bound hf hx hM
  | SO3_StrictUniqueMaximumExtremePoint =>
      intro f x hconv hx hmax
      exact uniqueMaximum_is_extremePoint f x hconv hx hmax

/-- Promoted `.proved` `TypedArchetype` for the 3-stage Simplex Optimization family. -/
def simplexOptimizationProvedArchetype :
    TypedArchetype SimplexOptimizationArchetype .proved where
  name := `InfoGeometry.Canonical.AllArchetypesNativeMathlibClosurePoset.simplexOptimizationProvedArchetype
  phase := 5
  claim := simplexOptimizationClaim
  evidence := simplexOptimizationClaim_all

#register_archetype simplexOptimizationProvedArchetype
#audit_archetype simplexOptimizationProvedArchetype

