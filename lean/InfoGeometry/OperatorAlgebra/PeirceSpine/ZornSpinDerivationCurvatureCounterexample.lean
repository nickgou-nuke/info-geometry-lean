import Mathlib.Data.Matrix.Basis
import Mathlib.Tactic.NoncommRing
import InfoGeometry.OperatorAlgebra.PeirceSpine.IdempotentZornChainArchetypes
import InfoGeometry.OperatorAlgebra.PeirceSpine.PlabicVertexContraction

/-!
# A concrete obstruction to universal flatness of Zorn link-spin derivations

Ground-truth contract: the owner `IdempotentZornChainArchetypes` defines
`ringComm`, `linkSpin12`, and `linkSpin23`, and proves
`zorn_link_spin_derivation_curvature`: the commutator of the two inner
derivations is controlled by the inner derivation of the link-spin
commutator. This file supplies a concrete finite matrix instance where that
correction is nonzero. It refutes universal zero curvature; it does not assert
a general classification of when the correction vanishes.

Carrier: `Matrix (Fin 4) (Fin 4) ℤ`, with mutually orthogonal diagonal
Peirce shells of ranks 1, 2, and 1. The left and right link-spin generators
are respectively `e₀₀ - e₁₁` and `e₁₂`; their commutator acts nontrivially on
`e₂₃`.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine.ZornSpinDerivationCurvatureCounterexample

open InfoGeometry.OperatorAlgebra.PeirceSpine.IdempotentZornChainArchetypes

abbrev Mat := Matrix (Fin 4) (Fin 4) ℤ

def e (i j : Fin 4) : Mat := Matrix.single i j 1

def zornSpinE01 : Matrix (Fin 4) (Fin 4) ℤ := Matrix.single 0 1 1

def zornSpinE10 : Matrix (Fin 4) (Fin 4) ℤ := Matrix.single 1 0 1

/-- Opposite matrix units witness noncommutativity in this exact `Fin 4`
operator carrier. -/
theorem matrix_noncommutative_witness :
    zornSpinE01 * zornSpinE10 ≠ zornSpinE10 * zornSpinE01 := by
  intro h
  simp only [zornSpinE01, zornSpinE10] at h
  rw [Matrix.single_mul_single_same, Matrix.single_mul_single_same] at h
  have h00 := congrArg (fun M : Matrix (Fin 4) (Fin 4) ℤ => M 0 0) h
  norm_num [Matrix.single] at h00

private lemma e_mul (i j k l : Fin 4) :
    e i j * e k l = if j = k then e i l else 0 := by
  by_cases h : j = k
  · subst k
    simp [e]
  · rw [ite_eq_right h]
    simpa [e] using
      (@Matrix.single_mul_single_of_ne (Fin 4) (Fin 4) (Fin 4) ℤ
        inferInstance inferInstance inferInstance inferInstance inferInstance
        1 i j k l h 1)

/-- The Zorn link-spin curvature correction is nonzero in a genuine
noncommutative operator matrix algebra. -/
theorem zorn_link_spin_derivation_curvature_nonzero :
    let E₁ := e (0 : Fin 4) 0
    let E₂ := e (1 : Fin 4) 1 + e 2 2
    let E₃ := e (3 : Fin 4) 3
    let A₁ := e (0 : Fin 4) 1
    let C₁ := e (1 : Fin 4) 0
    let A₂ := e (1 : Fin 4) 3
    let C₂ := e (3 : Fin 4) 2
    let X := e (2 : Fin 4) 3
    ringComm
        (ringComm (linkSpin12 E₁ E₂ A₁ C₁)
          (linkSpin23 E₂ E₃ A₂ C₂)) X = -e 1 3 ∧
      ringComm
        (ringComm (linkSpin12 E₁ E₂ A₁ C₁)
          (linkSpin23 E₂ E₃ A₂ C₂)) X ≠ 0 := by
  dsimp
  have hcurv :
      ringComm
          (ringComm
            (linkSpin12 (e (0 : Fin 4) 0) (e 1 1 + e 2 2) (e 0 1) (e 1 0))
            (linkSpin23 (e 1 1 + e 2 2) (e 3 3) (e 1 3) (e 3 2)))
          (e 2 3) = -e 1 3 := by
    have h₁₂ :
        linkSpin12 (e (0 : Fin 4) 0) (e 1 1 + e 2 2) (e 0 1) (e 1 0) =
          e 0 0 - e 1 1 := by
      simp [linkSpin12, root12, root21, e_mul, add_mul, mul_add]
    have h₂₃ :
        linkSpin23 (e (1 : Fin 4) 1 + e 2 2) (e 3 3) (e 1 3) (e 3 2) =
          e 1 2 := by
      simp [linkSpin23, root23, root32, e_mul, add_mul, mul_add]
    rw [h₁₂, h₂₃]
    have hst : (e 0 0 - e 1 1) * e 1 2 = -e 1 2 := by
      simp [sub_mul, e_mul]
    have hts : e 1 2 * (e 0 0 - e 1 1) = 0 := by
      simp [mul_sub, e_mul]
    have hspin : ringComm (e 0 0 - e 1 1) (e 1 2) = -e 1 2 := by
      unfold ringComm
      rw [hst, hts]
      simp
    have hleft : (-e 1 2) * e 2 3 = -e 1 3 := by
      simp [e_mul]
    have hright : e 2 3 * (-e 1 2) = 0 := by
      simp [e_mul]
    rw [hspin]
    unfold ringComm
    rw [hleft, hright]
    simp
  constructor
  · exact hcurv
  · intro h
    have hentry := congrArg (fun M : Mat => M 1 3) h
    rw [hcurv] at hentry
    norm_num [e] at hentry

/-- The sum and difference inner derivations generated by the two Zorn
link-spin operators have a nonzero commutator on the same interior matrix
unit. Thus the proposed universal zero-curvature law fails for the actual
Peirce-supported link operators, not only for abstract generators. -/
theorem zorn_link_spin_covariant_derivations_do_not_commute :
    let E₁ := e (0 : Fin 4) 0
    let E₂ := e (1 : Fin 4) 1 + e 2 2
    let E₃ := e (3 : Fin 4) 3
    let A₁ := e (0 : Fin 4) 1
    let C₁ := e (1 : Fin 4) 0
    let A₂ := e (1 : Fin 4) 3
    let C₂ := e (3 : Fin 4) 2
    let X := e (2 : Fin 4) 3
    ringComm (linkSpin12 E₁ E₂ A₁ C₁ + linkSpin23 E₂ E₃ A₂ C₂)
        (ringComm (linkSpin12 E₁ E₂ A₁ C₁ - linkSpin23 E₂ E₃ A₂ C₂) X) -
      ringComm (linkSpin12 E₁ E₂ A₁ C₁ - linkSpin23 E₂ E₃ A₂ C₂)
        (ringComm (linkSpin12 E₁ E₂ A₁ C₁ + linkSpin23 E₂ E₃ A₂ C₂) X) =
      (2 : ℤ) • e 1 3 ∧
    ringComm (linkSpin12 E₁ E₂ A₁ C₁ + linkSpin23 E₂ E₃ A₂ C₂)
        (ringComm (linkSpin12 E₁ E₂ A₁ C₁ - linkSpin23 E₂ E₃ A₂ C₂) X) -
      ringComm (linkSpin12 E₁ E₂ A₁ C₁ - linkSpin23 E₂ E₃ A₂ C₂)
        (ringComm (linkSpin12 E₁ E₂ A₁ C₁ + linkSpin23 E₂ E₃ A₂ C₂) X) ≠ 0 := by
  dsimp
  have hInner := zorn_link_spin_derivation_curvature_nonzero.1
  rw [zorn_link_spin_derivation_curvature, hInner]
  constructor
  · norm_num [e]
  · intro h
    have hentry := congrArg (fun M : Mat => M 1 3) h
    norm_num [e] at hentry

/-- The signed middle-vertex contraction retains the negative *symmetric*
sum of its two endpoint paths. It cannot in general be rewritten using the
skew edge coordinate `edgeMajoranaJ13`: this nested-idempotent matrix
instance has `x*u = 0` and `v*y = e₃₀`, so the two proposed right sides differ
by `2 * e₃₀`. -/
theorem signed_plabic_contraction_is_not_skew_edge_rhs :
    let E₁ := e (0 : Fin 4) 0
    let E₂ := e (1 : Fin 4) 1 + e 2 2
    let E₃ := e (3 : Fin 4) 3
    let x := root12 E₁ E₂ (0 : Mat)
    let y := root21 E₂ E₁ (e 1 0)
    let u := root23 E₂ E₃ (0 : Mat)
    let v := root32 E₃ E₂ (e 3 1)
    (1 - x + v) * (E₂ + x - y + u - v) * (1 + y - u) = E₂ - e 3 0 ∧
    E₂ + (x * y + v * u) - edgeMajoranaJ13 E₁ E₂ E₃ (0 : Mat) (e 1 0)
        (0 : Mat) (e 3 1) = E₂ + e 3 0 ∧
    (1 - x + v) * (E₂ + x - y + u - v) * (1 + y - u) ≠
      E₂ + (x * y + v * u) - edgeMajoranaJ13 E₁ E₂ E₃ (0 : Mat) (e 1 0)
        (0 : Mat) (e 3 1) := by
  dsimp
  have hleft :
      (1 - root12 (e (0 : Fin 4) 0) (e 1 1 + e 2 2) (0 : Mat) +
          root32 (e 3 3) (e 1 1 + e 2 2) (e 3 1)) *
        (e 1 1 + e 2 2 + root12 (e 0 0) (e 1 1 + e 2 2) (0 : Mat) -
            root21 (e 1 1 + e 2 2) (e 0 0) (e 1 0) +
            root23 (e 1 1 + e 2 2) (e 3 3) (0 : Mat) -
            root32 (e 3 3) (e 1 1 + e 2 2) (e 3 1)) *
        (1 + root21 (e 1 1 + e 2 2) (e 0 0) (e 1 0) -
            root23 (e 1 1 + e 2 2) (e 3 3) (0 : Mat)) =
        e 1 1 + e 2 2 - e 3 0 := by
    have h₂y : (e 1 1 + e 2 2) * e 1 0 = e 1 0 := by
      simp [e_mul, add_mul]
    have hv₂ : e 3 1 * (e 1 1 + e 2 2) = e 3 1 := by
      simp [e_mul, mul_add]
    have hySq : e 1 0 * e 1 0 = 0 := by simp [e_mul]
    have hvSq : e 3 1 * e 3 1 = 0 := by simp [e_mul]
    have hcontract :=
      PlabicVertexContraction.middle_vertex_signed_contraction
        (e := e 1 1 + e 2 2) (q := -e 3 1) (s := e 1 0)
        (by rw [neg_mul, hv₂]) h₂y (by rw [neg_mul, mul_neg, hvSq]; simp)
        hySq
    have horder : e 1 1 + e 2 2 - e 1 0 - e 3 1 =
        e 1 1 + e 2 2 - e 3 1 - e 1 0 := by abel
    rw [show root12 (e (0 : Fin 4) 0) (e 1 1 + e 2 2) (0 : Mat) = 0 by
        simp [root12],
      show root21 (e 1 1 + e 2 2) (e 0 0) (e 1 0) = e 1 0 by
        simp [root21, e_mul, add_mul],
      show root23 (e 1 1 + e 2 2) (e 3 3) (0 : Mat) = 0 by
        simp [root23],
      show root32 (e 3 3) (e 1 1 + e 2 2) (e 3 1) = e 3 1 by
        simp [root32, e_mul, mul_add]]
    simp only [zero_add, add_zero, sub_zero]
    rw [horder]
    simpa [sub_eq_add_neg, e_mul] using hcontract
  have hright :
      e 1 1 + e 2 2 +
          (root12 (e 0 0) (e 1 1 + e 2 2) (0 : Mat) *
              root21 (e 1 1 + e 2 2) (e 0 0) (e 1 0) +
            root32 (e 3 3) (e 1 1 + e 2 2) (e 3 1) *
              root23 (e 1 1 + e 2 2) (e 3 3) (0 : Mat)) -
          edgeMajoranaJ13 (e 0 0) (e 1 1 + e 2 2) (e 3 3)
            (0 : Mat) (e 1 0) (0 : Mat) (e 3 1) =
        e 1 1 + e 2 2 + e 3 0 := by
    simp [edgeMajoranaJ13, edgeRoot13, edgeRoot31,
      root12, root21, root23, root32, e_mul, add_mul, mul_add]
  refine ⟨hleft, hright, ?_⟩
  rw [hleft, hright]
  intro h
  have hentry := congrArg (fun M : Mat => M 3 0) h
  norm_num [e] at hentry

end InfoGeometry.OperatorAlgebra.PeirceSpine.ZornSpinDerivationCurvatureCounterexample
