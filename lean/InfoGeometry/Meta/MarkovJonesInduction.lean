import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra

/-!
# InfoGeometry.Meta.MarkovJonesInduction

Finite Markov-trace and Jones-projector interfaces for algebraic inductive
systems.

This module records the safe finite/category-theoretic part of the
Clifford/Cantor tensor-tower story:

* one-step algebra embeddings generate finite iterated embeddings;
* a normalized finite trace stable under each one-step embedding is stable under
  every finite iterated embedding;
* Jones/Temperley--Lieb interface projectors can be tracked at finite stages,
  with trace readbacks stable under one-step embedding.

No infinite matrix is constructed here.  No completed trace, determinant,
factor-algebra, topology-level completion, or current-algebra central-charge
result is asserted here.
-/

noncomputable section

namespace InfoGeometry.Meta.MarkovJonesInduction

variable {𝕜 : Type*} [CommSemiring 𝕜]
variable {A : Nat → Type*} [∀ n, Semiring (A n)] [∀ n, Algebra 𝕜 (A n)]

/--
A finite-stage algebraic inductive net.

The only structure is the one-step algebra embedding.  This is an algebraic
interface for finite iterates; it is not a completed infinite algebra.
-/
structure InductiveAlgebraNet where
  /-- One-step bonding homomorphism between finite algebra stages. -/
  embed : ∀ n : Nat, A n →ₐ[𝕜] A (n + 1)

namespace InductiveAlgebraNet

/-- The underlying one-step ring homomorphism of the algebraic bonding map. -/
def embedRingHom (Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A))
    (n : Nat) : A n →+* A (n + 1) :=
  (Net.embed n).toRingHom

/-- Iterated finite-stage embedding generated by one-step embeddings. -/
def embedMap (Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A))
    (m n : Nat) (h : m ≤ n) : A m →+* A n :=
  Nat.leRecOn h
    (C := fun n => A m →+* A n)
    (fun {k} ih => (Net.embedRingHom k).comp ih)
    (RingHom.id (A m))

@[simp]
theorem embedMap_refl
    (Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A))
    (m : Nat) :
    Net.embedMap m m le_rfl = RingHom.id (A m) := by
  simpa [embedMap] using
    (Nat.leRecOn_self
      (C := fun n => A m →+* A n)
      (next := fun {k} ih => (Net.embedRingHom k).comp ih)
      (x := RingHom.id (A m)))

@[simp]
theorem embedMap_succ
    (Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A))
    (m n : Nat) (h : m ≤ n) :
    Net.embedMap m (n + 1) (Nat.le_trans h (Nat.le_succ n)) =
      (Net.embedRingHom n).comp (Net.embedMap m n h) := by
  unfold embedMap
  rw [Nat.leRecOn_trans h (Nat.le_succ n)]
  rw [Nat.leRecOn_succ']

/-- Pointwise composition law for finite iterated embeddings. -/
theorem embedMap_apply_trans
    (Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A))
    (m n k : Nat) (hmn : m ≤ n) (hnk : n ≤ k)
    (x : A m) :
    Net.embedMap m k (hmn.trans hnk) x =
      Net.embedMap n k hnk (Net.embedMap m n hmn x) := by
  refine Nat.le_induction
    (m := n)
    (P := fun t ht =>
      Net.embedMap m t (Nat.le_trans hmn ht) x =
        Net.embedMap n t ht (Net.embedMap m n hmn x))
    ?base ?succ k hnk
  · simp
  · intro t ht ih
    have hmt : m ≤ t := Nat.le_trans hmn ht
    rw [Net.embedMap_succ m t hmt, Net.embedMap_succ n t ht]
    exact congrArg (fun y => Net.embedRingHom t y) ih

end InductiveAlgebraNet

/--
A finite normalized trace/readout compatible with the algebraic inductive net.

The stability field is the finite Markov property: the normalized finite trace
is unchanged by one-step embedding.  This is not a claim that a completed trace
exists.
-/
structure MarkovTraceNet (Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A)) where
  /-- Normalized finite-stage trace/readout. -/
  trace : ∀ n : Nat, A n →ₗ[𝕜] 𝕜
  /-- Normalization of the finite-stage identity. -/
  trace_one : ∀ n : Nat, trace n 1 = 1
  /-- One-step Markov stability of the normalized finite-stage trace. -/
  trace_stable : ∀ n : Nat, ∀ a : A n, trace (n + 1) (Net.embed n a) = trace n a

namespace MarkovTraceNet

/-- Trace normalization at every finite stage. -/
theorem map_one
    {Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A)}
    (Tr : MarkovTraceNet Net) (n : Nat) :
    Tr.trace n 1 = 1 :=
  Tr.trace_one n

/-- One-step trace stability readback. -/
theorem stable_one_step
    {Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A)}
    (Tr : MarkovTraceNet Net) (n : Nat) (a : A n) :
    Tr.trace (n + 1) (Net.embed n a) = Tr.trace n a :=
  Tr.trace_stable n a

/--
Finite Markov stability along every iterated algebraic embedding.

This is the safe theorem-level replacement for informal determinant-limit
language: the normalized finite readout is constant along finite embedding
chains.
-/
theorem stable_embedMap
    {Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A)}
    (Tr : MarkovTraceNet Net)
    (m n : Nat) (h : m ≤ n) (a : A m) :
    Tr.trace n (Net.embedMap m n h a) = Tr.trace m a := by
  refine Nat.le_induction
    (m := m)
    (P := fun t ht => Tr.trace t (Net.embedMap m t ht a) = Tr.trace m a)
    ?base ?succ n h
  · change Tr.trace m (Net.embedMap m m le_rfl a) = Tr.trace m a
    rw [Net.embedMap_refl]
    rfl
  · intro t hmt ih
    rw [Net.embedMap_succ m t hmt]
    exact (Tr.trace_stable t (Net.embedMap m t hmt a)).trans ih

/-- Two finite stages have the same trace readout when related by the iterated embedding. -/
theorem stable_embedMap_eq
    {Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A)}
    (Tr : MarkovTraceNet Net)
    (m n : Nat) (h : m ≤ n) (a : A m) :
    Tr.trace n (Net.embedMap m n h a) = Tr.trace m a :=
  Tr.stable_embedMap m n h a

end MarkovTraceNet

/--
Finite Jones/Temperley--Lieb interface data over an algebraic inductive net.

The optional adjacent relation is stated after embedding `e_n` into the next
finite stage, so both factors live in the same algebra.  This is finite-stage
interface algebra only; it is not a subfactor-limit theorem.
-/
structure JonesProjectorNet
    (Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A))
    (Tr : MarkovTraceNet Net) where
  /-- Finite Jones scaling parameter. -/
  lambda : 𝕜
  /-- Interface projector at stage `n + 1`. -/
  e : ∀ n : Nat, A (n + 1)
  /-- Projector/idempotent relation at each finite interface. -/
  e_idempotent : ∀ n : Nat, e n * e n = e n
  /-- Finite trace of each interface projector. -/
  trace_e : ∀ n : Nat, Tr.trace (n + 1) (e n) = lambda
  /-- Finite adjacent Jones relation after embedding the previous interface forward. -/
  adjacent_relation : ∀ n : Nat,
    e (n + 1) * Net.embed (n + 1) (e n) * e (n + 1) = lambda • e (n + 1)

namespace JonesProjectorNet

/-- Projector/idempotent readback for a finite Jones interface. -/
theorem idempotent
    {Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A)}
    {Tr : MarkovTraceNet Net}
    (J : JonesProjectorNet Net Tr) (n : Nat) :
    J.e n * J.e n = J.e n :=
  J.e_idempotent n

/-- Trace readback for a finite Jones interface. -/
theorem trace_projector
    {Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A)}
    {Tr : MarkovTraceNet Net}
    (J : JonesProjectorNet Net Tr) (n : Nat) :
    Tr.trace (n + 1) (J.e n) = J.lambda :=
  J.trace_e n

/-- The trace of an interface projector is stable after one finite embedding. -/
theorem trace_embedded_projector
    {Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A)}
    {Tr : MarkovTraceNet Net}
    (J : JonesProjectorNet Net Tr) (n : Nat) :
    Tr.trace (n + 2) (Net.embed (n + 1) (J.e n)) = J.lambda := by
  rw [Tr.trace_stable]
  exact J.trace_e n

/-- Adjacent finite Jones relation readback. -/
theorem adjacent
    {Net : InductiveAlgebraNet (𝕜 := 𝕜) (A := A)}
    {Tr : MarkovTraceNet Net}
    (J : JonesProjectorNet Net Tr) (n : Nat) :
    J.e (n + 1) * Net.embed (n + 1) (J.e n) * J.e (n + 1) =
      J.lambda • J.e (n + 1) :=
  J.adjacent_relation n

end JonesProjectorNet

end InfoGeometry.Meta.MarkovJonesInduction
