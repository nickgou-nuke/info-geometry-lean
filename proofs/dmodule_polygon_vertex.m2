-- Macaulay2 Script for D-module mapping

needsPackage "Dmodules"

-- Create a Weyl algebra mapping discrete vertex coordinates
W = QQ[x1, y1, x2, y2, x3, y3, dx1, dy1, dx2, dy2, dx3, dy3, WeylAlgebra => {x1=>dx1, y1=>dy1, x2=>dx2, y2=>dy2, x3=>dx3, y3=>dy3}]

-- The determinant polynomial for the orientation matrix
detPol = x1*y2 - x1*y3 - y1*x2 + y1*x3 + x2*y3 - x3*y2

-- D-module generated by the determinant
-- We can look at the annihilator of the polynomial detPol
-- fs computes the D-module generator for a polynomial
I = ann fs(detPol)

-- Print the annihilator ideal (D-module)
print I
