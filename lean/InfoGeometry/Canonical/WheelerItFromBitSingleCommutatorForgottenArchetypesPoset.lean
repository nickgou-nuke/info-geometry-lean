-/

/-- Theorem 3.1 (`DecadicSingleCommutatorResolventCrystal`, Turn 0096):
    In any non-commutative `[Ring B]` with idempotent `P` (`P² = P`), the Cayley
    factors `1 ± J_1` and `1 ± J_2` factorize the diagonal Casimir resolvent cores
    `1 + Z_bridge` and `1 - Z_bridge`, while the truncated Neumann series
    `1 + J_1 + J_1²` reduces any inverse of `1 - J_1` to inverting `1 + Z_bridge`:
    1. `(1 - J_1 P X) * (1 + J_1 P X) = 1 + Z_bridge P X`,
    2. `(1 - J_2 P X) * (1 + J_2 P X) = 1 - Z_bridge P X`,
    3. `(1 - J_1 P X) * (1 + J_1 P X + J_1 P X * J_1 P X) = 1 + Z_bridge P X * J_1 P X`,
    4. `(1 - J_1 P X) * (1 + J_1 P X) + (1 - J_2 P X) * (1 + J_2 P X) = 2`. -/
theorem decadic_single_commutator_resolvent_crystal {P : B} (hP : P * P = P) (X : B) :
    (1 - J_1 P X) * (1 + J_1 P X) = 1 + Z_bridge P X ∧
    (1 - J_2 P X) * (1 + J_2 P X) = 1 - Z_bridge P X ∧
    (1 - J_1 P X) * (1 + J_1 P X + J_1 P X * J_1 P X) =
      1 + Z_bridge P X * J_1 P X ∧
    (1 - J_1 P X) * (1 + J_1 P X) + (1 - J_2 P X) * (1 + J_2 P X) = 1 + 1 := by
  have hLad := single_commutator_power_ladder hP X
  have h1 : (1 - J_1 P X) * (1 + J_1 P X) = 1 + Z_bridge P X := by
    simp only [mul_add, sub_mul, mul_one, one_mul, hLad.2.1]
    abel
  have h2 : (1 - J_2 P X) * (1 + J_2 P X) = 1 - Z_bridge P X := by
    simp only [mul_add, sub_mul, mul_one, one_mul, hLad.2.2.1]
    abel
  refine ⟨h1, h2, ?_, ?_⟩
  · simp only [mul_add, sub_mul, mul_one, one_mul, ← mul_assoc, hLad.2.2.2.2.2.2.2.2.2.2.1]
    abel
  · rw [h1, h2]
    abel

