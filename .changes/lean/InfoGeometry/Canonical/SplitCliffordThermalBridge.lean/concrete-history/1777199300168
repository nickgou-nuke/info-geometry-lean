{"type":"new","contents":"import InfoGeometry.Canonical.BogoliubovFockSuper\nimport InfoGeometry.Canonical.InformationPartitionCore\nimport InfoGeometry.Canonical.KreinDiracSpectralLift\n\n/-!\n# Split Clifford Thermal Bridge\n\nThin canonical bridge placing the existing grand-canonical/Bogoliubov thermal\nsurface on the same transported Dirac--Clifford--Krein carrier.\n\nThis file does not introduce a new bundled state ontology. It only packages\nexisting owners so the thermal reading stays on the correct carrier:\n\n- strict symmetry transports polarization and chirality weights,\n- the transported Dirac operator remains the ambient spectral generator,\n- grand-canonical deformation is taken relative to that transported Dirac\n  generator on the same doubled carrier,\n- and the existing partition/log-partition calculus applies to the deformed\n  generator.\n-/\n\nnamespace InfoGeometry.Canonical.SplitCliffordThermalBridge\n\nopen InfoGeometry.Quantum.RealMajorana\nopen InfoGeometry.Canonical.BogoliubovFockSuper\nopen InfoGeometry.Canonical.BogoliubovPolarizationBridge\nopen InfoGeometry.Canonical.KreinDiracPolarizationBridge\nopen InfoGeometry.Canonical.KreinDiracSpectralLift\nopen InfoGeometry.Canonical.SpectralInference\nopen InfoGeometry.Canonical.InformationCalculus.ModularRadonNikodymData\nopen InfoGeometry.Canonical.RicciMongeAmpere\nopen InfoGeometry.Krein\n\nsection Doubled\n\nvariable {E : Type}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\nvariable {M : RealMajoranaDatum (S := DoubledSpace E)}\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\n\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nnoncomputable local instance : NormedSpace ℝ EndH := inferInstance\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : CompleteSpace EndH := inferInstance\n\n/-- Grand-canonical thermal deformation of the transported Dirac generator. -/\nnoncomputable def transportedThermalGenerator\n    (B : HyperbolicMixingParams)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M) (μ : ℝ) : EndH :=\n  grandCanonicalFockGenerator (E := E) B (transportDirac IST T) μ\n\n@[simp] theorem transportedThermalGenerator_eq_transportDirac_of_zeroChemicalPotential\n    (B : HyperbolicMixingParams)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M) :\n    transportedThermalGenerator (E := E) B IST T 0 = transportDirac IST T := by\n  change grandCanonicalFockGenerator (E := E) B (transportDirac IST T) 0 = transportDirac IST T\n  change transportDirac IST T - 0 • bogoliubovNumberOperator (E := E) B = transportDirac IST T\n  simp\n\n/-- Exponential flow generated by the transported thermal deformation. -/\nnoncomputable def transportedThermalFlow\n    (B : HyperbolicMixingParams)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M)\n    (μ τ : ℝ) : EndH :=\n  NormedSpace.exp (τ • transportedThermalGenerator (E := E) B IST T μ)\n\n@[simp] theorem transportedThermalFlow_zero\n    (B : HyperbolicMixingParams)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M)\n    (μ : ℝ) :\n    transportedThermalFlow (E := E) B IST T μ 0 = (1 : EndH) := by\n  simp [transportedThermalFlow]\n\n/-- Additive-time law for the transported thermal flow. -/\ntheorem transportedThermalFlow_add\n    (B : HyperbolicMixingParams)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M)\n    (μ s t : ℝ) :\n    transportedThermalFlow (E := E) B IST T μ (s + t)\n      = transportedThermalFlow (E := E) B IST T μ s\n          * transportedThermalFlow (E := E) B IST T μ t := by\n  have hComm :\n      Commute\n        (s • transportedThermalGenerator (E := E) B IST T μ)\n        (t • transportedThermalGenerator (E := E) B IST T μ) := by\n    exact ((Commute.refl (transportedThermalGenerator (E := E) B IST T μ)).smul_left s).smul_right t\n  calc\n    transportedThermalFlow (E := E) B IST T μ (s + t)\n        = NormedSpace.exp\n            ((s + t) • transportedThermalGenerator (E := E) B IST T μ) := rfl\n    _ = NormedSpace.exp\n          (s • transportedThermalGenerator (E := E) B IST T μ\n            + t • transportedThermalGenerator (E := E) B IST T μ) := by\n          simp [add_smul]\n    _ = NormedSpace.exp (s • transportedThermalGenerator (E := E) B IST T μ)\n          * NormedSpace.exp (t • transportedThermalGenerator (E := E) B IST T μ) := by\n          rw [NormedSpace.exp_add_of_commute hComm]\n    _ = transportedThermalFlow (E := E) B IST T μ s\n          * transportedThermalFlow (E := E) B IST T μ t := rfl\n\n/-- The partition calculus applies to the transported thermal generator. -/\ntheorem hasDerivAt_transportedThermalPartitionFunction_zero\n    (ω : EndH →L[ℝ] ℝ)\n    (B : HyperbolicMixingParams)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M)\n    (μ : ℝ) :\n    HasDerivAt\n      (fun τ : ℝ =>\n        informationPartitionFunction ω\n          (transportedThermalGenerator (E := E) B IST T μ) τ)\n      (ω (transportedThermalGenerator (E := E) B IST T μ)) 0 :=\n  hasDerivAt_informationPartitionFunction_zero\n    (ω := ω) (K := transportedThermalGenerator (E := E) B IST T μ)\n\n/-- Normalized log-partition calculus for the transported thermal generator. -/\ntheorem hasDerivAt_logTransportedThermalPartitionFunction_zero_of_normalized\n    (ω : EndH →L[ℝ] ℝ)\n    (hω1 : ω (1 : EndH) = 1)\n    (B : HyperbolicMixingParams)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M)\n    (μ : ℝ) :\n    HasDerivAt\n      (fun τ : ℝ =>\n        logInformationPartitionFunction ω\n          (transportedThermalGenerator (E := E) B IST T μ) τ)\n      (ω (transportedThermalGenerator (E := E) B IST T μ)) 0 :=\n  hasDerivAt_logInformationPartitionFunction_zero_of_normalized\n    (ω := ω) (K := transportedThermalGenerator (E := E) B IST T μ) hω1\n\n/-- Vacuum transport kills the Einstein-induced thermal deformation gauge term. -/\ntheorem transportedThermalGenerator_eq_transportDirac_of_vacuumTransported\n    (B : HyperbolicMixingParams)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M)\n    (R : RicciTensor E)\n    (K : InfoGeometry.Canonical.KaehlerGeometry.KaehlerInformationGeometry E)\n    (x : E) (scalar Λ : ℝ)\n    (V : SplitVielbein K x) (Γ : SpinConnection K x V)\n    (hVacSplit : VacuumEinsteinOnTransportedSplit R K x scalar Λ V Γ) :\n    transportedThermalGenerator (E := E) B IST T\n      (einsteinInducedChemicalPotential R K x scalar Λ V Γ) = transportDirac IST T := by\n  simpa [transportedThermalGenerator] using\n    grandCanonicalFockGenerator_eq_hamiltonian_of_vacuumTransported\n      (E := E) (B := B) (H := transportDirac IST T)\n      (R := R) (K := K) (x := x) (scalar := scalar) (Λ := Λ)\n      (V := V) (Γ := Γ) hVacSplit\n\n/--\nCanonical thermal bridge on the transported split-Clifford/Krein carrier.\nStrict symmetry transports polarization and chirality weights, the target\npolarization yields the projector-super pair, and the deformed thermal generator\nenters the existing partition calculus on the same carrier.\n-/\ntheorem splitCliffordThermalBridge_of_strictSymmetry\n    (ω : EndH →L[ℝ] ℝ)\n    (B : HyperbolicMixingParams)\n    (μ : ℝ)\n    (IST : InfoSpectralTriple H₂)\n    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :\n    (h.toBogoliubovTransform).transportP X.polarization = Y.polarization.P ∧\n    IsProjectorSuperPair\n      (KPolarization.splitOfPolarization (M := M) Y.polarization).Pminus\n      (KPolarization.splitOfPolarization (M := M) Y.polarization).Pplus ∧\n    Submodule.map h.f.toLinearMap M.weylPlus = (h.toBogoliubovTransform).transportWeylPlus ∧\n    Submodule.map h.f.toLinearMap M.weylMinus = (h.toBogoliubovTransform).transportWeylMinus ∧\n    HasDerivAt\n      (fun τ : ℝ =>\n        informationPartitionFunction ω\n          (transportedThermalGenerator (E := E) B IST h.toBogoliubovTransform μ) τ)\n      (ω (transportedThermalGenerator (E := E) B IST h.toBogoliubovTransform μ)) 0 := by\n  exact ⟨transportP_eq_targetPolarization_of_strictSymmetry h,\n    projectorSuperPair_of_targetPolarization (E := E) (M := M) Y,\n    (transportedChiralityWeights_of_strictSymmetry (M := M) h).1,\n    (transportedChiralityWeights_of_strictSymmetry (M := M) h).2,\n    hasDerivAt_transportedThermalPartitionFunction_zero\n      (ω := ω) (B := B) (IST := IST) (T := h.toBogoliubovTransform) (μ := μ)⟩\n\n/-- Normalized log-partition version of the transported thermal bridge. -/\ntheorem normalized_logSplitCliffordThermalBridge_of_strictSymmetry\n    (ω : EndH →L[ℝ] ℝ)\n    (hω1 : ω (1 : EndH) = 1)\n    (B : HyperbolicMixingParams)\n    (μ : ℝ)\n    (IST : InfoSpectralTriple H₂)\n    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :\n    HasDerivAt\n      (fun τ : ℝ =>\n        logInformationPartitionFunction ω\n          (transportedThermalGenerator (E := E) B IST h.toBogoliubovTransform μ) τ)\n      (ω (transportedThermalGenerator (E := E) B IST h.toBogoliubovTransform μ)) 0 :=\n  hasDerivAt_logTransportedThermalPartitionFunction_zero_of_normalized\n    (ω := ω) (hω1 := hω1) (B := B) (IST := IST)\n    (T := h.toBogoliubovTransform) (μ := μ)\n\nend Doubled\n\nend InfoGeometry.Canonical.SplitCliffordThermalBridge\n","mtime":1777199300168}