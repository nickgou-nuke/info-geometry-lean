import InfoGeometry.OperatorAlgebra.LieJordanBoundaryComposition

/-!
# The mass commutant of a square-zero operator pair

Let `u v` be square-zero elements of an arbitrary associative `R`-algebra `A`
(no commutativity, no matrix coordinates). Write

* `Φ = u + v`, `J = u - v` (the odd generators),
* `V = u * v + v * u` (the Jordan mass), `Σ = u * v - v * u` (the spin).

The mass `V` commutes with `u` and `v`, hence with every element generated by
the pair. At the operator level this says that left multiplication by `V`
commutes with the inner derivations `lieOp R Φ`, `lieOp R J`, `lieOp R Σ` in
`Module.End R A`. This file records those facts together with the
first-order actions of the three inner derivations on `Φ, J, V, Σ`; all
higher-order spectral identities in this folder are derived from them.

The Peirce-corner specialization `u = component10 p a`, `v = component01 p b`
is in `SquareZeroPairSpectral.Corner`.
-/

namespace InfoGeometry.OperatorAlgebra.SquareZeroPairSpectral

open InfoGeometry.OperatorAlgebra.LieJordan

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

section Elements

variable {u v : A}

theorem mul_mul_eq_zero_of_sq (hu : u * u = 0) (x : A) : u * (u * x) = 0 := by
  rw [← mul_assoc, hu, zero_mul]

/-- The mass commutes with the first generator of any square-zero pair. -/
theorem mass_commute_left (hu : u * u = 0) :
    Commute (u * v + v * u) u := by
  change (u * v + v * u) * u = u * (u * v + v * u)
  noncomm_ring [hu, mul_mul_eq_zero_of_sq hu]

/-- The mass commutes with the second generator of any square-zero pair. -/
theorem mass_commute_right (hv : v * v = 0) :
    Commute (u * v + v * u) v := by
  change (u * v + v * u) * v = v * (u * v + v * u)
  noncomm_ring [hv, mul_mul_eq_zero_of_sq hv]

theorem mass_commute_sum (hu : u * u = 0) (hv : v * v = 0) :
    Commute (u * v + v * u) (u + v) :=
  (mass_commute_left hu).add_right (mass_commute_right hv)

theorem mass_commute_difference (hu : u * u = 0) (hv : v * v = 0) :
    Commute (u * v + v * u) (u - v) :=
  (mass_commute_left hu).sub_right (mass_commute_right hv)

theorem mass_commute_spin (hu : u * u = 0) (hv : v * v = 0) :
    Commute (u * v + v * u) (u * v - v * u) :=
  (((mass_commute_left hu).mul_right (mass_commute_right hv))).sub_right
    ((mass_commute_right hv).mul_right (mass_commute_left hu))

/-- The Jordan mass and commutator spin of a square-zero pair have the same
square. This is an identity in every associative ring; it does not require
the pair to be reflexive or commuting. -/
theorem mass_spin_squares_equal (hu : u * u = 0) (hv : v * v = 0) :
    (u * v - v * u) * (u * v - v * u) =
      (u * v + v * u) * (u * v + v * u) := by
  have huuV := mul_mul_eq_zero_of_sq hu v
  have hvvU := mul_mul_eq_zero_of_sq hv u
  have hVuuV : v * (u * (u * v)) = 0 := by rw [huuV, mul_zero]
  have hUvvU : u * (v * (v * u)) = 0 := by rw [hvvU, mul_zero]
  noncomm_ring [hu, hv, huuV, hvvU, hVuuV, hUvvU]

/-- The mass absorbs a generator on either side: `V u = u v u`. -/
theorem mass_mul_left_gen (hu : u * u = 0) : (u * v + v * u) * u = u * v * u := by
  noncomm_ring [hu, mul_mul_eq_zero_of_sq hu]

theorem mass_mul_right_gen (hv : v * v = 0) : (u * v + v * u) * v = v * u * v := by
  noncomm_ring [hv, mul_mul_eq_zero_of_sq hv]

/-- Mixed Leibniz rule: the commutator is a twisted derivation for the
anticommutator, `[h, x y] = {h, x} y - x {h, y}` (any associative ring). -/
theorem lie_mul_eq_jordan_twisted (h x y : A) :
    h * (x * y) - x * y * h = (h * x + x * h) * y - x * (h * y + y * h) := by
  noncomm_ring

/-- Cubic laws of the odd generators. -/
theorem sum_cube (hu : u * u = 0) (hv : v * v = 0) :
    (u + v) * (u + v) * (u + v) = (u * v + v * u) * (u + v) := by
  noncomm_ring [hu, hv, mul_mul_eq_zero_of_sq hu, mul_mul_eq_zero_of_sq hv]

theorem difference_cube (hu : u * u = 0) (hv : v * v = 0) :
    (u - v) * (u - v) * (u - v) = -((u * v + v * u) * (u - v)) := by
  noncomm_ring [hu, hv, mul_mul_eq_zero_of_sq hu, mul_mul_eq_zero_of_sq hv]

/-- The `Φ`-sandwich exchanges the two generators, weighted by the mass. -/
theorem sum_sandwich_left (hu : u * u = 0) (hv : v * v = 0) :
    (u + v) * u * (u + v) = (u * v + v * u) * v := by
  noncomm_ring [hu, hv, mul_mul_eq_zero_of_sq hu, mul_mul_eq_zero_of_sq hv]

theorem sum_sandwich_right (hu : u * u = 0) (hv : v * v = 0) :
    (u + v) * v * (u + v) = (u * v + v * u) * u := by
  noncomm_ring [hu, hv, mul_mul_eq_zero_of_sq hu, mul_mul_eq_zero_of_sq hv]

/-! ### First-order inner-derivation actions on `(Φ, J, V, Σ)` -/

theorem lie_sum_difference (hu : u * u = 0) (hv : v * v = 0) :
    (u + v) * (u - v) - (u - v) * (u + v) = -((2 : ℕ) • (u * v - v * u)) := by
  rw [two_nsmul]; noncomm_ring [hu, hv]

theorem lie_difference_sum (hu : u * u = 0) (hv : v * v = 0) :
    (u - v) * (u + v) - (u + v) * (u - v) = (2 : ℕ) • (u * v - v * u) := by
  rw [two_nsmul]; noncomm_ring [hu, hv]

theorem lie_spin_sum (hu : u * u = 0) (hv : v * v = 0) :
    (u * v - v * u) * (u + v) - (u + v) * (u * v - v * u) =
      (2 : ℕ) • ((u * v + v * u) * (u - v)) := by
  rw [two_nsmul]
  noncomm_ring [hu, hv, mul_mul_eq_zero_of_sq hu, mul_mul_eq_zero_of_sq hv]

theorem lie_spin_difference (hu : u * u = 0) (hv : v * v = 0) :
    (u * v - v * u) * (u - v) - (u - v) * (u * v - v * u) =
      (2 : ℕ) • ((u * v + v * u) * (u + v)) := by
  rw [two_nsmul]
  noncomm_ring [hu, hv, mul_mul_eq_zero_of_sq hu, mul_mul_eq_zero_of_sq hv]

end Elements

/-! ### Operator level: `L_V` lies in the commutant of the inner derivations -/

section Operators

variable (R)

/-- Left multiplication by an element commuting with `a` commutes with the
inner derivation `lieOp R a` in the operator ring `Module.End R A`. -/
theorem lieOp_commute_mulLeft {a m : A} (h : Commute m a) :
    Commute (lieOp R a) (LinearMap.mulLeft R m) := by
  ext x
  change a * (m * x) - m * x * a = m * (a * x - x * a)
  rw [mul_sub, ← mul_assoc, ← mul_assoc, ← mul_assoc, h.eq]

/-- Pointwise form: an inner derivation by an element commuting with `m`
passes through left multiplication by `m`. -/
theorem lieOp_mulLeft_apply {a m : A} (h : Commute m a) (x : A) :
    lieOp R a (m * x) = m * lieOp R a x := by
  have := LinearMap.congr_fun (lieOp_commute_mulLeft R h).eq x
  simpa using this

variable {R} {u v : A}

theorem lieOp_sum_commute_mass (hu : u * u = 0) (hv : v * v = 0) :
    Commute (lieOp R (u + v)) (LinearMap.mulLeft R (u * v + v * u)) :=
  lieOp_commute_mulLeft R (mass_commute_sum hu hv)

theorem lieOp_difference_commute_mass (hu : u * u = 0) (hv : v * v = 0) :
    Commute (lieOp R (u - v)) (LinearMap.mulLeft R (u * v + v * u)) :=
  lieOp_commute_mulLeft R (mass_commute_difference hu hv)

theorem lieOp_spin_commute_mass (hu : u * u = 0) (hv : v * v = 0) :
    Commute (lieOp R (u * v - v * u)) (LinearMap.mulLeft R (u * v + v * u)) :=
  lieOp_commute_mulLeft R (mass_commute_spin hu hv)

end Operators

end InfoGeometry.OperatorAlgebra.SquareZeroPairSpectral
