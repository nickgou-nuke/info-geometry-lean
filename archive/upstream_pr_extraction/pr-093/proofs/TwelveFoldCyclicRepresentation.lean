import proofs.TwelveFoldOrderHierarchy
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The faithful cyclic representation generated by the twelvefold operator

This file packages the exact-order matrix `masterTwelve` as a native group
homomorphism from `C₁₂ = Multiplicative (ZMod 12)` into the unit group of
`M₆(ℂ)`.  The construction uses the integral powers universal property and
`ZMod.lift`; faithfulness follows from `orderOf masterTwelve = 12`.
-/

noncomputable section
namespace TwelveFoldCyclicRepresentation

open TwoSheetThreeColorWeyl TwelveFoldSheetColorOmega
open TwelveFoldSpectralBridge TwelveFoldOrderHierarchy

/-- The master matrix bundled with its explicit inverse `W¹¹`. -/
def masterTwelveUnit : M6Cˣ where
  val := masterTwelve
  inv := masterTwelve ^ 11
  val_inv := by
    rw [← pow_succ']
    exact masterTwelve_twelve
  inv_val := by
    rw [← pow_succ]
    exact masterTwelve_twelve

@[simp]
theorem masterTwelveUnit_val :
    (masterTwelveUnit : M6C) = masterTwelve := rfl

theorem masterTwelveUnit_order : orderOf masterTwelveUnit = 12 := by
  rw [← orderOf_injective (Units.coeHom M6C) Units.val_injective]
  exact masterTwelve_orderOf

/-- Integral powers of the master unit, written additively for `ZMod.lift`. -/
def masterIntegerAction : ℤ →+ Additive M6Cˣ :=
  MonoidHom.toAdditive (zpowersHom M6Cˣ masterTwelveUnit)

theorem masterIntegerAction_twelve : masterIntegerAction 12 = 0 := by
  change masterTwelveUnit ^ (12 : ℤ) = 1
  rw [← orderOf_dvd_iff_zpow_eq_one, masterTwelveUnit_order]
  norm_num

/-- The additive `ZMod 12` action before changing type tags to multiplication. -/
def cyclicActionAdd : ZMod 12 →+ Additive M6Cˣ :=
  ZMod.lift 12 ⟨masterIntegerAction, masterIntegerAction_twelve⟩

/-- The faithful six-dimensional complex representation of `C₁₂`. -/
def cyclicRepresentation : Multiplicative (ZMod 12) →* M6Cˣ :=
  AddMonoidHom.toMultiplicative cyclicActionAdd

theorem cyclicActionAdd_injective : Function.Injective cyclicActionAdd := by
  unfold cyclicActionAdd
  rw [ZMod.lift_injective]
  intro m hm
  change masterTwelveUnit ^ m = 1 at hm
  rw [← orderOf_dvd_iff_zpow_eq_one, masterTwelveUnit_order] at hm
  exact (CharP.intCast_eq_zero_iff (ZMod 12) 12 m).2 hm

theorem cyclicRepresentation_injective :
    Function.Injective cyclicRepresentation := by
  change Function.Injective cyclicActionAdd
  exact cyclicActionAdd_injective

theorem cyclicRepresentation_ker : cyclicRepresentation.ker = ⊥ :=
  cyclicRepresentation.ker_eq_bot_iff.mpr cyclicRepresentation_injective

/-- The abstract cyclic group is canonically equivalent to its concrete image. -/
def cyclicEquivRange :
    Multiplicative (ZMod 12) ≃* cyclicRepresentation.range :=
  MonoidHom.ofInjective cyclicRepresentation_injective

theorem faithful_cyclic_twelve_packet :
    orderOf masterTwelveUnit = 12 ∧
    Function.Injective cyclicRepresentation ∧
    cyclicRepresentation.ker = ⊥ :=
  ⟨masterTwelveUnit_order, cyclicRepresentation_injective,
    cyclicRepresentation_ker⟩

end TwelveFoldCyclicRepresentation
end noncomputable section
