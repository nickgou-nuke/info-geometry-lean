import Mathlib.Tactic

/-!
# Noncommutative Operator-Based Geometry and Graded Adjoint Actions

This file formalizes the transition from classical state carriers to 
noncommutative operator-based geometry. We move the geometry directly into 
the algebra of transformations, bypassing scalar diagonal models.

1. **Operator Algebra Grading**: The chirality operator `Γ` splits the full
   operator algebra into even and odd sectors: 
   `A_even = {X | ΓX = XΓ}`
   `A_odd = {X | ΓX = -XΓ}`
2. **Adjoint Action**: The Lorentz group action is lifted to the inner 
   automorphism `Ad_U(X) = U X U⁻¹`.
3. **Lorentz Grading Preservation**: Since the Lorentz generators are quadratic 
   CAR operators, they are intrinsically `even`. We prove that the Adjoint 
   action generated by any even operator identically preserves the `even/odd`
   observable grading.
-/

variable {A : Type*} [Ring A]
variable (Γ : A)

/-- The grading operator is an involution. -/
class OperatorChirality (Γ : A) where
  inv_sq : Γ * Γ = 1

namespace NoncommutativeGeometry

/-- The Even sector of the noncommutative observable algebra. 
    Defined by commutativity with the chiral grading operator. -/
def isEven (X : A) : Prop := Γ * X = X * Γ

/-- The Odd sector of the noncommutative observable algebra. 
    Defined by anticommutativity with the chiral grading operator. -/
def isOdd (X : A) : Prop := Γ * X + X * Γ = 0

variable [OperatorChirality Γ]

/-- The inner Adjoint action of a group element U on the operator algebra. -/
def Ad (U U_inv X : A) : A := U * X * U_inv

/-- A Lorentz transformation U is generated by even quadratic operators,
    hence U itself must belong to the even sector. -/
class IsLorentzAutomorphism (U U_inv : A) where
  inv_right : U * U_inv = 1
  inv_left : U_inv * U = 1
  is_even : isEven Γ U

lemma lorentz_inv_is_even (U U_inv : A) [L : IsLorentzAutomorphism Γ U U_inv] :
    isEven Γ U_inv := by
  unfold isEven
  calc
    Γ * U_inv = 1 * Γ * U_inv := by rw [one_mul]
    _ = (U_inv * U) * Γ * U_inv := by rw [L.inv_left]
    _ = U_inv * (U * Γ) * U_inv := by simp only [mul_assoc]
    _ = U_inv * (Γ * U) * U_inv := by
      have he : Γ * U = U * Γ := L.is_even
      rw [he]
    _ = U_inv * Γ * (U * U_inv) := by simp only [mul_assoc]
    _ = U_inv * Γ * 1 := by rw [L.inv_right]
    _ = U_inv * Γ := by rw [mul_one]

/-- The Lorentz Adjoint action universally preserves the even observable sector. -/
theorem lorentz_ad_preserves_even (U U_inv X : A) [L : IsLorentzAutomorphism Γ U U_inv]
    (hX : isEven Γ X) : isEven Γ (Ad U U_inv X) := by
  unfold isEven Ad
  have hu : Γ * U = U * Γ := L.is_even
  have hinv : Γ * U_inv = U_inv * Γ := lorentz_inv_is_even Γ U U_inv
  calc
    Γ * (U * X * U_inv) = (Γ * U) * X * U_inv := by simp only [mul_assoc]
    _ = (U * Γ) * X * U_inv := by rw [hu]
    _ = U * (Γ * X) * U_inv := by simp only [mul_assoc]
    _ = U * (X * Γ) * U_inv := by rw [hX]
    _ = (U * X) * (Γ * U_inv) := by simp only [mul_assoc]
    _ = (U * X) * (U_inv * Γ) := by rw [hinv]
    _ = (U * X * U_inv) * Γ := by simp only [mul_assoc]

/-- The Lorentz Adjoint action universally preserves the odd observable sector. -/
theorem lorentz_ad_preserves_odd (U U_inv X : A) [L : IsLorentzAutomorphism Γ U U_inv]
    (hX : isOdd Γ X) : isOdd Γ (Ad U U_inv X) := by
  unfold isOdd Ad
  have hu : Γ * U = U * Γ := L.is_even
  have hinv : Γ * U_inv = U_inv * Γ := lorentz_inv_is_even Γ U U_inv
  have hX2 : Γ * X = - (X * Γ) := by
    calc
      Γ * X = Γ * X + X * Γ - X * Γ := by rw [add_sub_cancel_right]
      _ = 0 - X * Γ := by rw [hX]
      _ = - (X * Γ) := by rw [zero_sub]
  calc
    Γ * (U * X * U_inv) + (U * X * U_inv) * Γ
      = (Γ * U) * X * U_inv + (U * X * U_inv) * Γ := by simp only [mul_assoc]
    _ = (U * Γ) * X * U_inv + (U * X * U_inv) * Γ := by rw [hu]
    _ = U * (Γ * X) * U_inv + (U * X * U_inv) * Γ := by simp only [mul_assoc]
    _ = U * (- (X * Γ)) * U_inv + (U * X * U_inv) * Γ := by rw [hX2]
    _ = - (U * (X * Γ)) * U_inv + (U * X * U_inv) * Γ := by rw [mul_neg]
    _ = - (U * (X * Γ) * U_inv) + (U * X * U_inv) * Γ := by rw [neg_mul]
    _ = - (U * X * Γ * U_inv) + (U * X * U_inv) * Γ := by simp only [mul_assoc]
    _ = - (U * X * (Γ * U_inv)) + (U * X * U_inv) * Γ := by simp only [mul_assoc]
    _ = - (U * X * (U_inv * Γ)) + (U * X * U_inv) * Γ := by rw [hinv]
    _ = - ((U * X * U_inv) * Γ) + (U * X * U_inv) * Γ := by simp only [mul_assoc]
    _ = 0 := by rw [neg_add_cancel]

end NoncommutativeGeometry
