-- tools/macaulay2/bergman_d_modules.m2
needsPackage "Dmodules"

-- =========================================================================
-- Bergman D-Module Transforms over Kähler Potential Metrics
-- =========================================================================

-- 1. Setup the Weyl Algebra for local coordinates z, zbar
W = QQ[z, zbar, dz, dzbar, WeylAlgebra => {{z, dz}, {zbar, dzbar}}]

print "------------------------------------------------------------"
print "Weyl Algebra W defined for variables (z, zbar) and derivations (dz, dzbar)"
print W
print "------------------------------------------------------------"

-- 2. Kähler Potential Metric K = z * zbar (Euclidean/Gaussian)
-- The Bergman space measure involves the weight exp(-K).
-- The D-module associated to this measure is generated by operators
-- annihilating exp(-z*zbar).
-- d/dz (exp(-z*zbar)) = -zbar * exp(-z*zbar)  => (dz + zbar) * exp(-K) = 0
-- d/dzbar (exp(-z*zbar)) = -z * exp(-z*zbar)  => (dzbar + z) * exp(-K) = 0

-- Define the Weyl operator ideal
I_Bergman = ideal(dz + zbar, dzbar + z)

print "Bergman D-Module Ideal I_Bergman for Kaehler potential K = z*zbar:"
print I_Bergman

-- Calculate the holonomic rank (dimension of the space of solutions)
r = holonomicRank I_Bergman
print "Holonomic rank of I_Bergman:"
print r

-- Calculate the characteristic ideal (defining the characteristic variety)
CV = charIdeal I_Bergman
print "Characteristic Ideal of I_Bergman (Symbols of the differential operators):"
print CV
print "------------------------------------------------------------"

-- 3. Structurally mirroring the continuous differential operations algebraically
-- 3a. Fourier Transform (Momentum space representation)
-- The Fourier transform in D-modules maps:
-- z -> dz, dz -> -z
-- zbar -> dzbar, dzbar -> -zbar
-- We define this automorphism of the Weyl algebra:
fourierTransformMap = map(W, W, {dz, dzbar, -z, -zbar})

I_Fourier = fourierTransformMap(I_Bergman)

print "Fourier Transform of the Bergman Ideal (momentum representation):"
print I_Fourier
print "Holonomic rank of the Fourier transformed ideal:"
print holonomicRank I_Fourier
print "------------------------------------------------------------"

-- 3b. Deformation of the Kaehler Metric
-- Consider a perturbed metric K_def = z*zbar + 1/2 * z^2 * zbar^2
-- The operators annihilating exp(-K_def) are:
-- dz + d/dz(K_def) = dz + zbar + z*zbar^2
-- dzbar + d/dzbar(K_def) = dzbar + z + z^2*zbar

I_def = ideal(dz + zbar + z*zbar^2, dzbar + z + z^2*zbar)

print "Deformed Bergman D-Module Ideal I_def for K_def = z*zbar + 1/2 z^2 zbar^2:"
print I_def
print "Holonomic rank of I_def:"
print holonomicRank I_def
print "Characteristic Ideal of I_def:"
print charIdeal I_def

print "------------------------------------------------------------"
print "Bergman D-Module Transform calculations completed successfully."
exit 0
