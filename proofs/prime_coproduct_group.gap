# GAP: Discrete coproduct structure representing fundamental theorem of arithmetic

# We represent the multiplicative group of positive rationals as a free abelian group
# generated by the primes. The coproduct (direct sum) over primes.

LoadPackage("polycyclic");

# Generate a free abelian group of rank 10 as an approximation for the infinite coproduct
F := FreeAbelianGroup(10);
gens := GeneratorsOfGroup(F);

# Mapping prime indices to generators
Print("Fundamental Theorem of Arithmetic Coproduct Structure Limit\n");
for i in [1..10] do
    p := Primes[i];
    Print("Prime ", p, " -> Generator f", i, "\n");
od;

# A number like 12 = 2^2 * 3^1 maps to gens[1]^2 * gens[2]^1
num := 12;
Print("Number ", num, " is represented as ", gens[1]^2 * gens[2]^1, "\n");
