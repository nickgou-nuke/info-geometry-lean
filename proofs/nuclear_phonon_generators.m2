R = QQ[m,lambda,omega,n,Eexact,Eadapt,delta];
s=1; d=5; modes=s+d;
u6=modes*modes;
ibmPartition=1+d+d+d*d;
sym3=3*(3+1)//2;
anti3=3*(3-1)//2;
sp6=sym3+sym3+3*3;
collective=anti3+sym3+sym3+sym3;
assert(modes==6);
assert(u6==36);
assert(ibmPartition==36);
assert(sym3==6 and anti3==3);
assert(sp6==21 and collective==21);
assert(1/2 + 1/2 == 1);
assert(-1/2 + -1/2 == -1);
assert(1/2 + -1/2 == 0);
assert(1/2 - (-1/2) == 1);
C1=-m^2;
stiffness=-C1;
bracket=2*C1;
assert(stiffness == m^2);
assert(sub(stiffness,m=>0)==0);
assert(sub(m^2*lambda^2/2,{m=>3,lambda=>2})==18);
assert(bracket == -2*m^2);
assert(sub((n+1/2)*omega,{omega=>5,n=>1})==15/2);
uDim6=6*6;
suDim3=3*3-1;
soDim6=6*(6-1)//2;
soDim5=5*(5-1)//2;
soDim3=3*(3-1)//2;
sp6RDim=3*(2*3+1);
assert(uDim6==36 and suDim3==8);
assert(soDim6==15 and soDim5==10 and soDim3==3);
assert(sp6RDim==21);
assert((1)==1 and (0)==0 and (-1)==-1);
W = QQ[x,dx, WeylAlgebra => {x=>dx}];
I = ideal(x*dx - dx*x - 1);
assert(numgens I == 1);
M = coker matrix{{Eexact*delta - Eexact + Eadapt}};
edges={"represented_by","counted_by","represented_by_sp6","decomposes_into","quantizes"};
assert(#edges==5);
print {"ibmModes",modes,"u6Generators",u6,"sp6Generators",sp6,"collectiveTensorCertificate",collective,"raisingPlusLowering","(1,-1,0)","raisingMinusLoweringT",1,"springPotentialSample",18,"onePhononEnergy",15/2,"u6Dim",uDim6,"su3Dim",suDim3,"so6Dim",soDim6,"so5Dim",soDim5,"so3Dim",soDim3,"sp6RDim",sp6RDim,"matrixE12E23","(1,0)","matrixE12E21","(1,-1)","dmoduleCCRGenerators",numgens I,"graphEdges",#edges};
