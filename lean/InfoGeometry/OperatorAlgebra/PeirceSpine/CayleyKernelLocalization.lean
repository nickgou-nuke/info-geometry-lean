import InfoGeometry.Algebra.CentralPowerLocalizationStar
import InfoGeometry.Algebra.CentralPowerLocalizationColimit
import InfoGeometry.OperatorAlgebra.PeirceSpine.CayleyKernelRegularity
import InfoGeometry.Analysis.RealStarSquareFaithfulness

/-!
# Faithful Cayley localization of the generated Peirce ring

Only the ring generated by the seed cut and the two arrows is localized.
The metric is proved central there; no ambient commutativity is imposed.
The inverse and unitary are explicit Ore fractions. Singular localization
kills the residual on-shell kernel, whereas the shifted localization
preserves it. Three-square faithfulness gives injectivity on the entire
generated ring, and is discharged for full bounded real Hilbert operators.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine.CayleyKernelLocalization

open InfoGeometry.Algebra.CentralPowerLocalization

variable {B : Type*} [Ring B] [StarRing B]

/-- The original cut, as an element of its actual generated ring. -/
def seed (P A : B) : generatedPeirceRing P A (star A) :=
  ⟨P, cut_mem_generatedPeirceRing P A (star A)⟩

/-- The metric belongs to the generated ring by its ordered product formula. -/
def metric (P A : B) : generatedPeirceRing P A (star A) :=
  ⟨genV P A (star A), genV_mem_generatedPeirceRing P A (star A)⟩

/-- The regular Cayley denominator. -/
def shift (P A : B) : generatedPeirceRing P A (star A) := 1 + metric P A

/-- The polynomial numerator is already present before localization. -/
def numerator (P A : B) : generatedPeirceRing P A (star A) :=
  ⟨cayleyKernelNumerator P A (star A),
    cayleyKernelNumerator_mem_generated P A (star A)⟩

/-- The lower active support, with its actual ordered arrow product. -/
def lowerCycle (P A : B) : generatedPeirceRing P A (star A) :=
  ⟨qgtMinus P A (star A), (generatedPeirceRing P A (star A)).mul_mem
    (coneMinus_mem_generatedPeirceRing P A (star A))
    (conePlus_mem_generatedPeirceRing P A (star A))⟩

variable (P A : B) [hP : Fact (P * P = P)] [hPs : Fact (star P = P)]

/-- Centrality is derived in the generated ring from the seed equation. -/
instance metricCentral : Fact (∀ X : generatedPeirceRing P A (star A),
    Commute (metric P A) X) where
  out X := by
    apply Subtype.ext
    exact (genV_commute_of_mem_generated hP.out A (star A) X.property).eq

/-- Adding the identity retains centrality in the same ring. -/
instance shiftCentral : Fact (∀ X : generatedPeirceRing P A (star A),
    Commute (shift P A) X) where
  out X := (Commute.one_left X).add_left ((metricCentral P A).out X)

/-- The singular denominator is self-adjoint. -/
instance metricSelfAdjoint : Fact (star (metric P A) = metric P A) where
  out := Subtype.ext (star_genV hPs.out A)

/-- The shifted denominator is self-adjoint. -/
instance shiftSelfAdjoint : Fact (star (shift P A) = shift P A) where
  out := by
    unfold shift
    rw [star_add, star_one, (metricSelfAdjoint P A).out]

/-- The Cayley element is the explicit stage-one fraction. -/
def localizedCayley : Away (shift P A) :=
  cayley (shift P A) (numerator P A)

/-- Its unitarity follows from the two proved polynomial numerator identities. -/
theorem localizedCayley_unitary :
    star (localizedCayley P A) * localizedCayley P A = 1 ∧
      localizedCayley P A * star (localizedCayley P A) = 1 := by
  apply cayley_unitary
  · apply Subtype.ext
    exact (cayleyKernelNumerator_star_products hP.out hPs.out A).1
  · apply Subtype.ext
    exact (cayleyKernelNumerator_star_products hP.out hPs.out A).2

/-- The conjugated seed is an actual element of the constructed localization. -/
def localizedProjection : Away (shift P A) :=
  localizedCayley P A * of (shift P A) (seed P A) * star (localizedCayley P A)

/-- The conjugated seed is a native self-adjoint idempotent. -/
theorem localizedProjection_isStarProjection :
    IsStarProjection (localizedProjection P A) := by
  have hp : seed P A * seed P A = seed P A := Subtype.ext hP.out
  have hps : star (seed P A) = seed P A := Subtype.ext hPs.out
  have hi : of (shift P A) (seed P A) * of (shift P A) (seed P A) =
      of (shift P A) (seed P A) := by rw [← map_mul, hp]
  have his : star (of (shift P A) (seed P A)) = of (shift P A) (seed P A) := by
    rw [star_of, hps]
  refine ⟨?_, ?_⟩
  · change localizedProjection P A * localizedProjection P A = localizedProjection P A
    unfold localizedProjection
    calc
      _ = localizedCayley P A * of (shift P A) (seed P A) *
          (star (localizedCayley P A) * localizedCayley P A) *
          of (shift P A) (seed P A) * star (localizedCayley P A) := by
            simp only [mul_assoc]
      _ = localizedCayley P A *
          (of (shift P A) (seed P A) * of (shift P A) (seed P A)) *
          star (localizedCayley P A) := by
            rw [(localizedCayley_unitary P A).1]
            simp only [mul_one, mul_assoc]
      _ = _ := by rw [hi]
  · change star (localizedProjection P A) = localizedProjection P A
    simp only [localizedProjection, star_mul, star_star, his, mul_assoc]

/-- The denominator-cleared polynomial identity descends to the exact
on-shell partial flip, retaining the original kernel corner. -/
theorem localizedProjection_partial_flip
    (hproper : ∀ X : B, star X * X = 0 → X = 0)
    (hV : genV P A (star A) * genV P A (star A) = genV P A (star A)) :
    localizedProjection P A = of (shift P A)
      (lowerCycle P A + seed P A * (1 - metric P A)) := by
  let target := lowerCycle P A + seed P A * (1 - metric P A)
  have hn : numerator P A * seed P A * star (numerator P A) =
      shift P A ^ 2 * target := by
    apply Subtype.ext
    exact onShell_cayleyKernelNumerator_partial_flip hP.out hPs.out hproper A hV
  change repr (shift P A) 1 (numerator P A) * of (shift P A) (seed P A) *
    star (repr (shift P A) 1 (numerator P A)) = of (shift P A) target
  rw [← repr_zero (shift P A) (seed P A), star_repr, repr_mul, repr_mul, hn]
  simpa only [Nat.add_zero, Nat.reduceAdd, repr_zero, zero_add] using
    (repr_bond (shift P A) 0 2 target).symm

omit hPs in
/-- Singular localization annihilates the residual idempotent. -/
theorem singular_kills_kernel
    (hV : genV P A (star A) * genV P A (star A) = genV P A (star A)) :
    of (metric P A) (1 - metric P A) = 0 := by
  apply of_eq_zero_of_mul_eq_zero
  apply Subtype.ext
  exact (onShell_genV_kernel_products A (star A) hV).1

omit hPs in
/-- A nonzero on-shell kernel proves that singular localization is not faithful. -/
theorem singular_not_injective
    (hV : genV P A (star A) * genV P A (star A) = genV P A (star A))
    (hzero : (1 : B) - genV P A (star A) ≠ 0) :
    ¬ Function.Injective (of (metric P A)) := by
  apply not_injective_of_annihilator (metric P A) (1 - metric P A)
  · intro h
    exact hzero (congrArg Subtype.val h)
  · apply Subtype.ext
    exact (onShell_genV_kernel_products A (star A) hV).1

omit hPs in
/-- The shifted localization preserves the residual kernel even without
assuming global star faithfulness: every denominator power fixes it. -/
theorem shifted_kernel_ne_zero
    (hV : genV P A (star A) * genV P A (star A) = genV P A (star A))
    (hzero : (1 : B) - genV P A (star A) ≠ 0) :
    of (shift P A) (1 - metric P A) ≠ 0 := by
  intro h
  obtain ⟨n, hn⟩ := (of_eq_zero_iff (shift P A) (1 - metric P A)).mp h
  have hfix : shift P A ^ n * (1 - metric P A) = 1 - metric P A := by
    apply Subtype.ext
    exact onShell_shift_pow_fixes_kernel A (star A) hV n
  rw [hfix] at hn
  exact hzero (congrArg Subtype.val hn)

/-- Three-square faithfulness preserves the entire generated ring under
shifted localization, not just its on-shell kernel. -/
theorem shifted_injective
    (hfaith : ∀ X Y Z : B, star X * X + star Y * Y + star Z * Z = 0 → X = 0) :
    Function.Injective (of (shift P A)) := by
  apply of_injective
  intro X hX
  apply Subtype.ext
  apply (one_add_genV_mul_eq_zero_iff hPs.out hfaith A (X : B)).mp
  exact congrArg Subtype.val hX

section RealHilbert

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- On the full bounded real operator algebra the required faithfulness
hypothesis is discharged by positivity of the Hilbert adjoint. -/
theorem shifted_injective_real_hilbert (P A : E →L[ℝ] E)
    [Fact (P * P = P)] [Fact (star P = P)] :
    Function.Injective (of (shift P A)) :=
  shifted_injective P A
    InfoGeometry.Analysis.RealStarSquareFaithfulness.three_star_squares_first

end RealHilbert

end InfoGeometry.OperatorAlgebra.PeirceSpine.CayleyKernelLocalization
