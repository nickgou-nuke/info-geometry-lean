set_option maxHeartbeats 0

namespace InfoGeometry.Exceptional.CFSGPort.Chevalley

/-- A torus operator and its inverse each preserve every root-module basis
line. This property is stable under multiplication and inversion of units. -/
private def IsBasisDiagonalUnit {τ : Tag} {K : Type*} [CommRing K]
    (g : (Module.End K (RootModule τ K))ˣ) : Prop :=
  ∀ b : Label τ, ∃ c d : K,
    (g : Module.End K (RootModule τ K)) (Finsupp.single b 1) =
        c • Finsupp.single b 1 ∧
      ((g⁻¹ : (Module.End K (RootModule τ K))ˣ) : Module.End K (RootModule τ K))
          (Finsupp.single b 1) =
        d • Finsupp.single b 1

private theorem torusElt_inv_param {τ : Tag} {K : Type*} [CommRing K]
    (i : Fin τ.rank) (t : Kˣ) :
    torusElt τ K i t⁻¹ = (torusElt τ K i t)⁻¹ := by
  have hmul : torusElt τ K i t * torusElt τ K i t⁻¹ = 1 := by
    calc
      torusElt τ K i t * torusElt τ K i t⁻¹ =
          torusElt τ K i (t * t⁻¹) :=
        (torusElt_mul (τ := τ) (R := K) i t t⁻¹).symm
      _ = 1 := by rw [mul_inv_cancel, torusElt_one (τ := τ) (R := K) i]
  simpa using congrArg Inv.inv (inv_eq_of_mul_eq_one_left hmul)

private theorem torusElt_isBasisDiagonalUnit {τ : Tag} {K : Type*} [CommRing K]
    (i : Fin τ.rank) (t : Kˣ) : IsBasisDiagonalUnit (torusElt τ K i t) := by
  intro b
  exact ⟨_, _, torusElt_single_eq i t b,
    by
      rw [← torusElt_inv_param i t]
      exact torusElt_single_eq i t⁻¹ b⟩

/-- Every element of the generated root torus preserves each basis line, as
does its inverse. -/
private theorem rootTorusSubgroup_isBasisDiagonalUnit {τ : Tag} {K : Type*} [CommRing K]
    (g : rootTorusSubgroup τ K) :
    IsBasisDiagonalUnit (g : (Module.End K (RootModule τ K))ˣ) := by
  refine Subgroup.closure_induction ?_ ?_ ?_ ?_ g.property
  · rintro x ⟨⟨i, t⟩, rfl⟩
    exact torusElt_isBasisDiagonalUnit i t
  · intro b
    exact ⟨1, 1, by simp, by simp⟩
  · intro x y hx hy hxdiag hydiag b
    obtain ⟨cx, dx, hcx, hdx⟩ := hxdiag b
    obtain ⟨cy, dy, hcy, hdy⟩ := hydiag b
    refine ⟨cy * cx, dx * dy, ?_, ?_⟩
    · rw [Units.val_mul, Module.End.mul_apply, hcy, map_smul, hcx, mul_smul]
    · rw [mul_inv_rev, Units.val_mul, Module.End.mul_apply, hdx, map_smul,
        hdy, mul_smul]
  · intro x hx hxdiag b
    obtain ⟨c, d, hc, hd⟩ := hxdiag b
    exact ⟨d, c, hd, hc⟩

private theorem raisesPos_zero_sub_one_of_basisDiagonal {τ : Tag} {K : Type*} [CommRing K]
    {g : (Module.End K (RootModule τ K))ˣ}
    (hg : IsBasisDiagonalUnit g) :
    RaisesPos Label.position 0 ((g : Module.End K (RootModule τ K)) - 1) := by
  intro a b hab
  by_contra hle
  have hne : a ≠ b := by
    intro hab'
    subst a
    omega
  obtain ⟨c, _, hline, _⟩ := hg b
  have hcoord := congrArg (fun z : RootModule τ K => z a) hline
  have hzero : ((g : Module.End K (RootModule τ K)) - 1)
      (Finsupp.single b 1) a ≠ 0 := hab
  apply hzero
  change ((g : Module.End K (RootModule τ K)) (Finsupp.single b 1)) a -
    (Finsupp.single b 1) a = 0
  rw [hcoord]
  simp [hne]

private theorem rootTorusSubgroup_le_posFiltration_zero (τ : Tag) (K : Type*) [Field K] :
    rootTorusSubgroup τ K ≤ posFiltration Label.position 0 := by
  apply (Subgroup.closure_le _).2
  rintro g ⟨⟨i, t⟩, rfl⟩
  have hdiag := torusElt_isBasisDiagonalUnit i t
  have hinv : IsBasisDiagonalUnit ((torusElt τ K i t)⁻¹) := by
    rw [← torusElt_inv_param]
    exact torusElt_isBasisDiagonalUnit i t⁻¹
  refine ⟨raisesPos_zero_sub_one_of_basisDiagonal hdiag,
    raisesPos_zero_sub_one_of_basisDiagonal hinv⟩

/-- The root torus generated by all simple-coroot operators is the supremum
of the individual rank-one operator tori. -/
theorem iSup_simpleRootTorusSubgroup_eq_rootTorusSubgroup (τ : Tag) (K : Type*) [Field K] :
    (⨆ i : Fin τ.rank, simpleRootTorusSubgroup (τ := τ) (K := K) i) =
      rootTorusSubgroup τ K := by
  apply le_antisymm
  · apply iSup_le
    intro i
    apply (Subgroup.closure_le _).2
    rintro _ ⟨t, rfl⟩
    exact Subgroup.subset_closure ⟨⟨i, t⟩, rfl⟩
  · apply (Subgroup.closure_le _).2
    rintro _ ⟨⟨i, t⟩, rfl⟩
    change torusElt τ K i t ∈
      (⨆ j : Fin τ.rank, simpleRootTorusSubgroup (τ := τ) (K := K) j)
    exact (le_iSup (fun j : Fin τ.rank =>
      simpleRootTorusSubgroup (τ := τ) (K := K) j) i)
      (Subgroup.subset_closure (Set.mem_range_self t))

private theorem posUnipotent_le_posFiltration_zero (τ : Tag) (K : Type*) [Field K] :
    posUnipotent τ K ≤ posFiltration Label.position 0 := by
  intro g hg
  refine ⟨(posUnipotent_le_posFiltration τ K hg).1.mono (Nat.zero_le 1),
    (posUnipotent_le_posFiltration τ K hg).2.mono (Nat.zero_le 1)⟩

/-- The operator Borel subgroup generated by the actual root torus and positive
root operators. Its elements preserve the finite positive-root filtration. -/
@[expose] noncomputable def operatorBorelSubgroup (τ : Tag) (K : Type*) [Field K] :
    Subgroup (Module.End K (RootModule τ K))ˣ :=
  rootTorusSubgroup τ K ⊔ posUnipotent τ K

private theorem torusElt_map_posUnipotent_le (τ : Tag) (K : Type*) [Field K]
    (i : Fin τ.rank) (t : Kˣ) :
    (posUnipotent τ K).map (MulAut.conj (torusElt τ K i t)).toMonoidHom ≤
      posUnipotent τ K := by
  change (rootSpan τ K {α | IsRoot τ α ∧ 0 < height α}).map
      (MulAut.conj (torusElt τ K i t)).toMonoidHom ≤ _
  simp only [rootSpan, Subgroup.map_iSup, Subgroup.map_iSup]
  refine iSup₂_le fun α hα => ?_
  have hnorm := torusElt_mem_normalizer_rootSubgroup i hα.1 t
  have hroot : (rootSubgroup τ K α).map
      (MulAut.conj (torusElt τ K i t)).toMonoidHom ≤ rootSubgroup τ K α := by
    rw [Subgroup.map_le_iff_le_comap]
    intro x hx
    exact (Subgroup.mem_set_normalizer_iff.mp hnorm x).mp hx
  exact le_iSup₂_of_le α hα hroot

private theorem torusElt_mem_normalizer_posUnipotent (τ : Tag) (K : Type*) [Field K]
    (i : Fin τ.rank) (t : Kˣ) :
    torusElt τ K i t ∈ Subgroup.normalizer (posUnipotent τ K : Set (Module.End K (RootModule τ K))ˣ) := by
  rw [Subgroup.mem_set_normalizer_iff]
  intro x
  constructor
  · intro hx
    have hmap := torusElt_map_posUnipotent_le τ K i t
      (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩)
    exact hmap
  · intro hx
    have hmap : x ∈ posUnipotent τ K :=
      torusElt_map_posUnipotent_le τ K i t⁻¹
        (Subgroup.mem_map.mpr
          ⟨torusElt τ K i t * x * (torusElt τ K i t)⁻¹, hx, by
            change torusElt τ K i t⁻¹ *
              (torusElt τ K i t * x * (torusElt τ K i t)⁻¹) *
              (torusElt τ K i t⁻¹)⁻¹ = x
            rw [torusElt_inv_param]
            group⟩)
    exact hmap

private theorem rootTorusSubgroup_le_normalizer_posUnipotent
    (τ : Tag) (K : Type*) [Field K] :
    rootTorusSubgroup τ K ≤
      Subgroup.normalizer (posUnipotent τ K : Set (Module.End K (RootModule τ K))ˣ) := by
  apply (Subgroup.closure_le _).2
  rintro _ ⟨⟨i, t⟩, rfl⟩
  exact torusElt_mem_normalizer_posUnipotent τ K i t

/-- The Borel operator group is solvable: its positive unipotent subgroup is
solvable, and the quotient by it is an image of the abelian root torus. -/
theorem operatorBorelSubgroup_isSolvable (τ : Tag) (K : Type*) [Field K] :
    Group.IsSolvable (operatorBorelSubgroup τ K) := by
  let T := rootTorusSubgroup τ K
  let U := posUnipotent τ K
  let B := operatorBorelSubgroup τ K
  letI : IsMulCommutative T := rootTorusSubgroup_isMulCommutative τ K
  letI : Group.IsSolvable T := inferInstance
  have hnormalizer : B ≤ Subgroup.normalizer (U : Set (Module.End K (RootModule τ K))ˣ) := by
    change T ⊔ U ≤ _
    exact sup_le (rootTorusSubgroup_le_normalizer_posUnipotent τ K)
      (Subgroup.le_normalizer : U ≤ Subgroup.normalizer (U : Set _))
  letI : (U.subgroupOf B).Normal := Subgroup.normal_subgroupOf_of_le_normalizer hnormalizer
  letI : Group.IsSolvable U := posUnipotent_isSolvable τ K
  let eU : U.subgroupOf B ≃* U := Subgroup.subgroupOfEquivOfLe le_sup_right
  letI : Group.IsSolvable (U.subgroupOf B) :=
    Group.isSolvable_of_isSolvable_injective
      (f := eU.toMonoidHom) eU.injective
  have hjoin : (T.subgroupOf B) ⊔ (U.subgroupOf B) = ⊤ := by
    change (T.subgroupOf (T ⊔ U)) ⊔ (U.subgroupOf (T ⊔ U)) = ⊤
    rw [← Subgroup.subgroupOf_sup le_sup_left le_sup_right]
    exact Subgroup.subgroupOf_self (T ⊔ U)
  let f : T →* B ⧸ U.subgroupOf B :=
    (QuotientGroup.mk' (U.subgroupOf B)).comp
      ((T.subgroupOf B).subtype.comp (Subgroup.subgroupOfEquivOfLe le_sup_left).symm.toMonoidHom)
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (U.subgroupOf B) y
    have hb : b ∈ (T.subgroupOf B) ⊔ (U.subgroupOf B) := by
      rw [hjoin]
      exact Subgroup.mem_top b
    rcases (Subgroup.mem_sup_of_normal_right
      (s := T.subgroupOf B) (t := U.subgroupOf B) (x := b)).mp hb with
      ⟨t, ht, u, hu, htu⟩
    refine ⟨⟨t.1, ht⟩, ?_⟩
    change QuotientGroup.mk' (U.subgroupOf B) t =
      QuotientGroup.mk' (U.subgroupOf B) b
    rw [← htu]
    simp [QuotientGroup.mk'_apply, QuotientGroup.mk_mul, QuotientGroup.eq_one_iff, hu]
  letI : Group.IsSolvable (B ⧸ U.subgroupOf B) := Group.isSolvable_of_surjective hf
  apply Group.isSolvable_of_ker_le_range (U.subgroupOf B).subtype
    (QuotientGroup.mk' (U.subgroupOf B))
  rw [QuotientGroup.ker_mk']
  rw [Subgroup.range_subtype]

/-- Rank-one torus decomposition of the local operator Borel, matching the
indexed torus-plus-positive-unipotent shape in the external Bruhat API. -/
theorem operatorBorelSubgroup_eq_rankOneTorusJoin (τ : Tag) (K : Type*) [Field K] :
    operatorBorelSubgroup τ K =
      (⨆ i : Fin τ.rank, simpleRootTorusSubgroup (τ := τ) (K := K) i) ⊔
        posUnipotent τ K := by
  rw [operatorBorelSubgroup, iSup_simpleRootTorusSubgroup_eq_rootTorusSubgroup]

private theorem operatorBorelSubgroup_le_posFiltration_zero (τ : Tag) (K : Type*) [Field K] :
    operatorBorelSubgroup τ K ≤ posFiltration Label.position 0 := by
  exact sup_le (rootTorusSubgroup_le_posFiltration_zero τ K)
    (posUnipotent_le_posFiltration_zero τ K)

/-- The Borel subgroup and negative unipotent subgroup meet trivially in the
actual root-module operator group. The proof uses upper/lower filtration
relations on the represented operators, not a coordinate subgroup surrogate. -/
theorem operatorBorelSubgroup_inf_negUnipotent (τ : Tag) (K : Type*) [Field K] :
    operatorBorelSubgroup τ K ⊓ negUnipotent τ K = ⊥ := by
  refine eq_bot_iff.2 fun g hg => Subgroup.mem_bot.2 (Units.ext ?_)
  have hB := operatorBorelSubgroup_le_posFiltration_zero τ K hg.1
  have hN := isLowerUnitriangular_of_mem (negUnipotent_le_posFiltration τ K hg.2)
  have hupper : RaisesPos Label.position 0 (g : Module.End K (RootModule τ K)) := by
    rw [← sub_add_cancel (g : Module.End K (RootModule τ K)) 1]
    exact hB.1.add RaisesPos.one
  rw [Units.val_one]
  refine Finsupp.lhom_ext' fun b => LinearMap.ext_ring (Finsupp.ext fun a => ?_)
  simp only [LinearMap.comp_apply, Finsupp.lsingle_apply]
  rcases eq_or_ne a b with rfl | hab
  · simpa using hN.1 a
  · rcases Label.precedes_or_precedes hab with hab' | hba'
    · simpa [Finsupp.single_apply, hab] using hN.2 a b hab'
    · by_contra hcoeff
      have hval : (g : Module.End K (RootModule τ K)) (Finsupp.single b 1) a ≠ 0 := by
        intro hz
        apply hcoeff
        simpa [Finsupp.single_apply, hab] using hz
      have hpos := hupper a b hval
      have hlt := Label.position_lt_position hba'
      omega

/-- The Borel/negative-unipotent intersection on the restricted adjoint
operator group. This is the local carrier form of the external
`BruhatExtras.borel_inf_negUnipotent` field. -/
theorem adjointGroup_borel_inf_negUnipotent (τ : Tag) (K : Type*) [Field K] :
    (operatorBorelSubgroup τ K).subgroupOf (adjointGroup τ K) ⊓
      (negUnipotent τ K).subgroupOf (adjointGroup τ K) = ⊥ := by
  rw [eq_bot_iff]
  intro g hg
  apply Subtype.ext
  apply Subgroup.mem_bot.mp
  rw [← operatorBorelSubgroup_inf_negUnipotent τ K]
  exact ⟨Subgroup.mem_subgroupOf.mp hg.1, Subgroup.mem_subgroupOf.mp hg.2⟩

/-- The positive and negative root-generated operator subgroups still
intersect trivially after restricting both carriers to the adjoint group.
This is the local adjoint-carrier form of
`SteinbergExtras.posPart_inf_negPart`. -/
theorem adjointGroup_posUnipotent_inf_negUnipotent (τ : Tag) (K : Type*) [Field K] :
    (posUnipotent τ K).subgroupOf (adjointGroup τ K) ⊓
      (negUnipotent τ K).subgroupOf (adjointGroup τ K) = ⊥ := by
  rw [eq_bot_iff]
  intro g hg
  apply Subtype.ext
  apply Subgroup.mem_bot.mp
  rw [← posUnipotent_inf_negUnipotent τ K]
  exact ⟨Subgroup.mem_subgroupOf.mp hg.1, Subgroup.mem_subgroupOf.mp hg.2⟩

/-- The actual root torus operators intersect the positive pinned-root
unipotent operators trivially. The proof uses diagonal action on the root
basis and the unit-diagonal filtration of the positive subgroup. -/
theorem rootTorusSubgroup_inf_posUnipotent (τ : Tag) (K : Type*) [Field K] :
    rootTorusSubgroup τ K ⊓ posUnipotent τ K = ⊥ := by
  refine eq_bot_iff.2 fun g hg => Subgroup.mem_bot.2 ?_
  apply Units.ext
  have hdiag := rootTorusSubgroup_isBasisDiagonalUnit (τ := τ) (K := K) ⟨g, hg.1⟩
  have hupper := posUnipotent_le_posFiltration τ K hg.2
  have hupperUnit := isUpperUnitriangular_of_mem hupper
  have hval : (g : Module.End K (RootModule τ K)) = 1 := by
    refine Finsupp.lhom_ext' fun b => LinearMap.ext_ring (Finsupp.ext fun a => ?_)
    obtain ⟨c, d, hc, hd⟩ := hdiag b
    have hcoeff :
        ((g : Module.End K (RootModule τ K)) (Finsupp.single b 1)) b = 1 :=
      hupperUnit.1 b
    have hc_one : c = 1 := by
      have hline := congrArg (fun z : RootModule τ K => z b) hc
      calc
        c = ((g : Module.End K (RootModule τ K)) (Finsupp.single b 1)) b := by
          simpa using hline.symm
        _ = 1 := hcoeff
    have hvec : (g : Module.End K (RootModule τ K)) (Finsupp.single b 1) =
        Finsupp.single b 1 := by
      simpa [hc_one] using hc
    simpa using congrArg (fun z : RootModule τ K => z a) hvec
  exact hval

/-- The supremum of the simple-root tori intersects the positive unipotent
operator subgroup trivially. This is the local operator-carrier form of the
`SteinbergExtras.torus_inf_posPart` field. -/
theorem simpleRootTori_inf_posUnipotent (τ : Tag) (K : Type*) [Field K] :
    (⨆ i : Fin τ.rank, simpleRootTorusSubgroup (τ := τ) (K := K) i) ⊓
      posUnipotent τ K = ⊥ := by
  rw [iSup_simpleRootTorusSubgroup_eq_rootTorusSubgroup]
  exact rootTorusSubgroup_inf_posUnipotent τ K

end InfoGeometry.Exceptional.CFSGPort.Chevalley

