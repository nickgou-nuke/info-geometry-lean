import InfoGeometry.Canonical.BogoliubovOptimalTransport
import InfoGeometry.Canonical.SouriauKreinMetriplecticContext
import InfoGeometry.Canonical.SouriauMetriplecticOptimalTransport
import InfoGeometry.SuperMetriplectic.Flow
import InfoGeometry.Meta.Architecture

/-!
# InfoGeometry.Canonical.BogoliubovRGFlowBridge

Typed equilibrium bridge between Bogoliubov transport and metriplectic flow.

Both sides of the bridge live in the same operator space `EndH`.  The
reversible component of a supplied metriplectic flow is identified with the
canonical exponential generated by `Kambient`.  At dissipative equilibrium,
the already-proved metriplectic kernel theorem removes the dissipative
component, so the total flow is exactly the canonical Bogoliubov flow.

No density-valued Wasserstein flow is identified with an operator-valued
Bogoliubov flow here; such a statement would require an additional typed
intertwiner.
-/

noncomputable section

namespace InfoGeometry.Canonical.BogoliubovRGFlowBridge

open InfoGeometry.Canonical
open InfoGeometry.Canonical.OnsagerCasimirJ
open InfoGeometry.Canonical.RelativeModularPotential
open BogoliubovOptimalTransport
open InfoGeometry.SuperMetriplectic
open InfoGeometry.Canonical.SouriauKreinMetriplectic
open InfoGeometry.Canonical.SouriauMetriplecticOptimalTransport

variable {E : Type}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/--
Operator-valued bridge connecting the canonical Bogoliubov flow with a
metriplectic flow on the same endomorphism space.
-/
@[rep_depth transport]
structure Bridge
    (E : Type)
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] where
  /-- The property regular lane reduction. -/
  reduction :
    CertifiedModularReduction (E := InfoGeometry.Krein.DoubledSpace E)

  /-- Time at which the operator-valued metriplectic flow is compared. -/
  time : ℝ

  /-- Operatorial potential owning the response probe. -/
  potential : PotentialDatum (E := E)

  /-- Reference and comparison vectors for the operatorial response. -/
  reference : InfoGeometry.Krein.DoubledSpace E
  comparison : InfoGeometry.Krein.DoubledSpace E
  ψ : InfoGeometry.Krein.DoubledSpace E

  /-- Entropy and comparison perturbation channels. -/
  X :
    (InfoGeometry.Krein.DoubledSpace E) →L[ℝ]
      (InfoGeometry.Krein.DoubledSpace E)
  Y :
    (InfoGeometry.Krein.DoubledSpace E) →L[ℝ]
      (InfoGeometry.Krein.DoubledSpace E)

  /-- Weyl weight of the operatorial response context. -/
  weight : ℝ

  /-- Onsager-Casimir parity hypotheses for the response channels. -/
  X_jInvariant :
    InfoGeometry.Canonical.OnsagerCasimirJ.IsJInvariant (E := E) X
  Y_jInvariant :
    InfoGeometry.Canonical.OnsagerCasimirJ.IsJInvariant (E := E) Y

  /-- Genuine Onsager metric acting on doubled-space endomorphisms. -/
  metric :
    OnsagerMetricData
      (InfoGeometry.Krein.DoubledSpace E →L[ℝ]
        InfoGeometry.Krein.DoubledSpace E)

  /-- Energy force for the metriplectic decomposition. -/
  energyForce :
    InfoGeometry.Krein.DoubledSpace E →L[ℝ]
      InfoGeometry.Krein.DoubledSpace E

  /-- Onsager degeneracy preserves the energy channel. -/
  energy_degeneracy :
    metric.onsager energyForce = 0

namespace Bridge

variable (B : Bridge E)

/--
Canonical operatorial Souriau/Onsager context.  Its observable is
definitionally the property regular BdG generator.
-/
@[rep_depth transport]
noncomputable def onsagerContext :
    OperatorialMetriplecticContext (E := E) where
  P := B.potential
  reference := B.reference
  comparison := B.comparison
  ψ := B.ψ
  A := B.reduction.Kambient
  X := B.X
  Y := B.Y
  weight := B.weight
  X_jInvariant := B.X_jInvariant
  Y_jInvariant := B.Y_jInvariant

/--
Canonical metriplectic flow attached to the bridge.

The reversible flow is the Bogoliubov exponential, while the dissipative and
total flows are constructed from the supplied Onsager metric rather than
related by stored equality fields.
-/
@[rep_depth transport]
noncomputable def metriplecticFlow :
    MetriplecticFlow
      (InfoGeometry.Krein.DoubledSpace E →L[ℝ]
        InfoGeometry.Krein.DoubledSpace E) where
  metric := B.metric
  entropyForce := B.X
  energyForce := B.energyForce
  reversibleFlow := canonicalBogoliubovFlow B.reduction B.time
  dissipativeFlow := B.metric.onsager B.X
  totalFlow :=
    canonicalBogoliubovFlow B.reduction B.time + B.metric.onsager B.X
  entropyProduction := B.metric.pairing B.X (B.metric.onsager B.X)
  dissipativeFlow_eq_onsager_entropy := rfl
  totalFlow_eq_reversible_add_dissipative := rfl
  energy_degeneracy := B.energy_degeneracy
  entropyProduction_eq_quadratic := rfl

/-- The operator probed by the Onsager context is the regular BdG generator. -/
@[rep_depth transport]
theorem onsager_observable_eq_Kambient :
    B.onsagerContext.A = B.reduction.Kambient :=
  rfl

/-- The metriplectic entropy force is the operatorial Onsager force channel. -/
@[rep_depth transport]
theorem entropy_force_eq_onsager_channel :
    B.metriplecticFlow.entropyForce = B.onsagerContext.X :=
  rfl

/-- The reversible component is definitionally the canonical Bogoliubov flow. -/
@[rep_depth transport]
theorem reversible_flow_is_bogoliubov :
    B.metriplecticFlow.reversibleFlow =
      canonicalBogoliubovFlow B.reduction B.time :=
  rfl

/-- The canonical flow used by the bridge is generated by `Kambient`. -/
@[rep_depth transport]
theorem generator_eq_Kambient
    (B : Bridge E) :
    canonicalBogoliubovFlow B.reduction B.time =
      NormedSpace.exp (B.time • B.reduction.Kambient) :=
  rfl

/--
At dissipative equilibrium the total operator flow is exactly the canonical
Bogoliubov flow.
-/
@[rep_depth transport, capstone]
theorem rg_fixed_point_is_pure_bogoliubov_flow
    (B : Bridge E)
    (hEq : B.metriplecticFlow.IsDissipativeEquilibrium) :
    B.metriplecticFlow.totalFlow =
      canonicalBogoliubovFlow B.reduction B.time := by
  have hDissipative :
      B.metriplecticFlow.dissipativeFlow = 0 :=
    B.metriplecticFlow.dissipativeFlow_eq_zero_of_equilibrium hEq
  calc
    B.metriplecticFlow.totalFlow =
        B.metriplecticFlow.reversibleFlow +
          B.metriplecticFlow.dissipativeFlow :=
      B.metriplecticFlow.totalFlow_eq_reversible_add_dissipative
    _ = B.metriplecticFlow.reversibleFlow := by
      rw [hDissipative, add_zero]
    _ = canonicalBogoliubovFlow B.reduction B.time :=
      B.reversible_flow_is_bogoliubov

/--
The operatorial entropy production associated with the bridge is nonnegative
when the existing comparison-state Cramer--Rao response supplies the Onsager
positive-semidefinite form.
-/
@[rep_depth transport]
theorem operatorial_entropyProduction_nonneg_of_cramerRao
    (B : Bridge E)
    (R :
      OperatorialMetriplecticContext.CramerRaoOperatorialResponseContext
        B.onsagerContext) :
    0 ≤ InfoGeometry.Canonical.Operators.entropyProduction
      B.onsagerContext.P B.onsagerContext.X B.reduction.Kambient := by
  rw [← B.onsager_observable_eq_Kambient]
  exact B.onsagerContext.canonicalEntropyProduction_nonneg_of_cramerRaoResponse R

/-- The pure equilibrium flow remains regular-lane optimal. -/
@[rep_depth transport]
theorem rg_fixed_point_flow_isOptimal
    (B : Bridge E) :
    IsOptimalBogoliubovFlow B.reduction
      (canonicalBogoliubovFlow B.reduction) :=
  canonicalBogoliubovFlow_isOptimal B.reduction

end Bridge

/-! ## Typed density-flow realization -/

/--
A typed realization of a Souriau/JKO density flow inside the doubled
Bogoliubov carrier.

This is the missing mathematical content behind the historical untyped
`otFlow` field.  The encoder is a genuine real-linear map, and the reversible
and dissipative compatibility laws compare maps with matching codomains.
Compatibility with the total flow is derived below from the two owner
decomposition theorems.
-/
@[rep_depth transport]
structure DensityOTIntertwiner
    (B : Bridge E)
    (State LieGroup LieAlgebra LieDual Observable : Type*)
    [AddMonoid LieAlgebra]
    [NormedRing Observable] [NormedAlgebra ℝ Observable] [CompleteSpace Observable] where
  /-- The genuine Souriau/metriplectic/JKO density flow. -/
  otFlow :
    SouriauMetriplecticOTFlow
      State LieGroup LieAlgebra LieDual Observable

  /-- Linear realization of density states in the doubled Krein carrier. -/
  encodeDensity :
    Density State →ₗ[ℝ] InfoGeometry.Krein.DoubledSpace E

  /-- The density-side reversible flow is represented by the BdG flow. -/
  reversible_intertwines :
    ∀ ρ : Density State,
      encodeDensity (otFlow.reversibleFlow ρ) =
        B.metriplecticFlow.reversibleFlow (encodeDensity ρ)

  /-- The JKO dissipative leg is represented by the Onsager operator. -/
  dissipative_intertwines :
    ∀ ρ : Density State,
      encodeDensity (otFlow.dissipativeFlow ρ) =
        B.metriplecticFlow.dissipativeFlow (encodeDensity ρ)

namespace DensityOTIntertwiner

variable
    {State LieGroup LieAlgebra LieDual Observable : Type*}
    [AddMonoid LieAlgebra]
    [NormedRing Observable] [NormedAlgebra ℝ Observable] [CompleteSpace Observable]

variable (B : Bridge E)

variable
    (I :
      DensityOTIntertwiner B
        State LieGroup LieAlgebra LieDual Observable)

/--
The encoded Souriau/JKO total density flow is the operatorial metriplectic
total flow on the doubled carrier.

This is a theorem from linearity and the two native total-flow decomposition
laws; it is not stored as a third compatibility field.
-/
@[rep_depth transport]
theorem total_intertwines
    (ρ : Density State) :
    I.encodeDensity (I.otFlow.totalFlow ρ) =
      B.metriplecticFlow.totalFlow (I.encodeDensity ρ) := by
  change I.encodeDensity (I.otFlow.reversibleFlow ρ + I.otFlow.dissipativeFlow ρ) = _
  rw [map_add]
  rw [I.reversible_intertwines, I.dissipative_intertwines]
  rw [B.metriplecticFlow.totalFlow_eq_reversible_add_dissipative]
  rfl

/--
At operatorial dissipative equilibrium, the encoded density total flow is the
canonical Bogoliubov evolution of the encoded density.
-/
@[rep_depth transport, capstone]
theorem total_intertwines_bogoliubov_at_equilibrium
    (ρ : Density State)
    (hEq : B.metriplecticFlow.IsDissipativeEquilibrium) :
    I.encodeDensity (I.otFlow.totalFlow ρ) =
      canonicalBogoliubovFlow B.reduction B.time (I.encodeDensity ρ) := by
  rw [I.total_intertwines]
  rw [B.rg_fixed_point_is_pure_bogoliubov_flow hEq]

/--
A stationary JKO leg is sent to the kernel of the operatorial dissipative
channel.
-/
@[rep_depth transport]
theorem dissipative_stationary_maps_to_operator_kernel
    (ρ : Density State)
    (hρ : I.otFlow.dissipativeFlow ρ = 0) :
    B.metriplecticFlow.dissipativeFlow (I.encodeDensity ρ) = 0 := by
  rw [← I.dissipative_intertwines]
  rw [hρ, map_zero]

end DensityOTIntertwiner

end InfoGeometry.Canonical.BogoliubovRGFlowBridge
