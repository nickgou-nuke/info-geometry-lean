import Mathlib.Tactic

/-!
# Information-geometric cutoff facts

Finite scalar facts for the thermodynamic UV cutoff picture:

* Massieu/log barrier `Φ(x)=-log x`;
* scalar Itakura--Saito divergence `x/y - log(x/y) - 1`;
* scale invariance of the IS divergence;
* Landauer cost at the golden/Penrose KMS unit;
* the Cramér--Rao inequality gives a strictly positive phase-space pixel.
-/

noncomputable section

namespace InformationGeometricCutoff

/-- Golden ratio. -/
def phi : ℝ := (1 + Real.sqrt 5) / 2

/-- Penrose/Fibonacci KMS inverse temperature. -/
def penroseBeta : ℝ := Real.log phi

/-- Scalar Massieu--Planck/log-barrier potential. -/
def MassieuBarrier (x : ℝ) : ℝ := - Real.log x

/-- Scalar Itakura--Saito divergence generated by the log barrier. -/
def ItakuraSaito (x y : ℝ) : ℝ := x / y - Real.log (x / y) - 1

/-- The scalar IS divergence is scale invariant. -/
theorem itakuraSaito_scale_invariant {x y c : ℝ} (hc : c ≠ 0) :
    ItakuraSaito (c * x) (c * y) = ItakuraSaito x y := by
  unfold ItakuraSaito
  rw [mul_div_mul_left _ _ hc]

/-- The scalar IS divergence vanishes on the diagonal. -/
@[simp] theorem itakuraSaito_self {x : ℝ} (hx : x ≠ 0) :
    ItakuraSaito x x = 0 := by
  unfold ItakuraSaito
  field_simp [hx]
  simp

/-- Landauer cost for erasing one ordinary bit at temperature `T`, with
Boltzmann's constant absorbed into units. -/
def LandauerBitCost (T : ℝ) : ℝ := T * Real.log 2

/-- Golden/Fibonacci Landauer cost for erasing one Fibonacci anyon/defect. -/
def GoldenAnyonEraseCost (T : ℝ) : ℝ := T * penroseBeta

/-- Cramér--Rao datum for variance/phase-space volume and Fisher information. -/
structure CramerRaoQuantumInequality where
  phaseSpaceVariance : ℝ
  fisherInformation : ℝ
  fisher_pos : 0 < fisherInformation
  variance_ge_inv_fisher : fisherInformation⁻¹ ≤ phaseSpaceVariance

/-- The Cramér--Rao inequality forces a strictly positive minimum resolution. -/
theorem fractal_resolution_limit (cr : CramerRaoQuantumInequality) :
    0 < cr.phaseSpaceVariance := by
  calc
    0 < cr.fisherInformation⁻¹ := inv_pos.mpr cr.fisher_pos
    _ ≤ cr.phaseSpaceVariance := cr.variance_ge_inv_fisher

/-- Minimal phase-space pixel induced by Fisher information. -/
def MinimalPhaseSpaceVolume (cr : CramerRaoQuantumInequality) : ℝ :=
  cr.fisherInformation⁻¹

/-- The minimal Fisher/Cramér--Rao volume is positive. -/
theorem minimal_phase_space_volume_pos (cr : CramerRaoQuantumInequality) :
    0 < MinimalPhaseSpaceVolume cr := by
  exact inv_pos.mpr cr.fisher_pos

end InformationGeometricCutoff
