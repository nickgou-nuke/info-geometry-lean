import Mathlib.Data.Real.Basic
import Mathlib.Algebra.Algebra.Basic
import Mathlib.Algebra.Star.Basic
import Mathlib.Tactic

namespace InfoGeometry.Parahyperkahler.KreinCuntzBridge

variable {A : Type*} [Ring A] [Algebra ℝ A]

/-!
# Archetype 601: Krein Fundamental Symmetry
A Krein space is equipped with a fundamental symmetry J where J² = 1.
-/
class KreinSymmetry (A : Type*) [Ring A] [Algebra ℝ A] where
  J : A
  h_J_sq : J * J = 1

variable [K : KreinSymmetry A]

/-!
# Archetype 602: Krein Projectors (The DeWitt Split)
The fundamental symmetry J generates two orthogonal Peirce projectors.
-/
def half : A := algebraMap ℝ A (1/2)

def PL : A := half * (1 + K.J)
def PR : A := half * (1 - K.J)

lemma half_comm (x : A) : half * x = x * half := Algebra.commutes (1/2) x

/-!
# Archetype 603: Krein Chiral Split Identity
We prove that P_L + P_R = 1 and P_L P_R = 0, fracturing the space into
two discrete, orthogonal chiral sectors.
-/
/-- Master Theorem 1: The Peirce projectors form a partition of unity. -/
theorem PL_add_PR_eq_one : (PL : A) + (PR : A) = 1 := by
  dsimp [PL, PR]
  calc half * (1 + K.J) + half * (1 - K.J)
    _ = half * ((1 + K.J) + (1 - K.J)) := by rw [←mul_add]
    _ = half * 2 := by
      have : (1 + K.J) + (1 - K.J) = 2 := by noncomm_ring
      rw [this]
    _ = algebraMap ℝ A (1/2) * algebraMap ℝ A 2 := by
      have : (2 : A) = algebraMap ℝ A 2 := by simp
      rw [this]
    _ = algebraMap ℝ A (1/2 * 2) := by rw [←RingHom.map_mul]
    _ = algebraMap ℝ A 1 := by norm_num
    _ = 1 := by simp

/-- Master Theorem 2: The Peirce projectors are strictly orthogonal. -/
theorem PL_mul_PR_eq_zero : (PL : A) * (PR : A) = 0 := by
  dsimp [PL, PR]
  calc (half * (1 + K.J)) * (half * (1 - K.J))
    _ = half * ((1 + K.J) * half) * (1 - K.J) := by noncomm_ring
    _ = half * (half * (1 + K.J)) * (1 - K.J) := by rw [half_comm (1 + K.J)]
    _ = (half * half) * ((1 + K.J) * (1 - K.J)) := by noncomm_ring
    _ = (half * half) * (1 - K.J * K.J) := by
      have : (1 + K.J) * (1 - K.J) = 1 - K.J * K.J := by noncomm_ring
      rw [this]
    _ = (half * half) * (1 - 1) := by rw [K.h_J_sq]
    _ = (half * half) * 0 := by simp
    _ = 0 := by simp


/-!
# Archetype 604: Cuntz Algebra 𝒪₂
The Cuntz algebra is generated by two isometries S₁ and S₂ whose range
projections sum to identity.
-/
class CuntzO2 (A : Type*) [Ring A] [StarRing A] where
  S1 : A
  S2 : A
  h_S1_iso : star S1 * S1 = 1
  h_S2_iso : star S2 * S2 = 1
  h_Cuntz  : S1 * star S1 + S2 * star S2 = 1

variable [StarRing A] [C : CuntzO2 A]

/-!
# Archetype 605: The Krein-Cuntz Bridge
We map the Cuntz range projections natively onto the Krein projectors
and prove their structural identity.
-/
def CuntzPL : A := C.S1 * star C.S1
def CuntzPR : A := C.S2 * star C.S2

/-- Master Theorem 3: Cuntz Range Projections form a Chiral Split. -/
theorem CuntzPL_add_CuntzPR_eq_one : (CuntzPL : A) + (CuntzPR : A) = 1 := by
  exact C.h_Cuntz

/-- Lemma: Cuntz isometries strictly annihilate each other radially. -/
theorem S1_star_mul_S2_eq_zero : star C.S1 * C.S2 = 0 := by
  have h1 : star C.S1 * (C.S1 * star C.S1 + C.S2 * star C.S2) = star C.S1 * 1 := by
    rw [C.h_Cuntz]
  have h2 : star C.S1 * (C.S1 * star C.S1 + C.S2 * star C.S2) = star C.S1 + (star C.S1 * C.S2) * star C.S2 := by
    calc star C.S1 * (C.S1 * star C.S1 + C.S2 * star C.S2)
      _ = (star C.S1 * C.S1) * star C.S1 + star C.S1 * C.S2 * star C.S2 := by noncomm_ring
      _ = 1 * star C.S1 + star C.S1 * C.S2 * star C.S2 := by rw [C.h_S1_iso]
      _ = star C.S1 + star C.S1 * C.S2 * star C.S2 := by rw [one_mul]
  rw [mul_one] at h1
  have h3 : star C.S1 + (star C.S1 * C.S2) * star C.S2 = star C.S1 := by
    rw [←h1, h2]
  have h4 : (star C.S1 * C.S2) * star C.S2 = 0 := by
    calc (star C.S1 * C.S2) * star C.S2
      _ = (star C.S1 + (star C.S1 * C.S2) * star C.S2) - star C.S1 := by noncomm_ring
      _ = star C.S1 - star C.S1 := by rw [h3]
      _ = 0 := by ring
  calc star C.S1 * C.S2
    _ = star C.S1 * C.S2 * 1 := by rw [mul_one]
    _ = star C.S1 * C.S2 * (star C.S2 * C.S2) := by rw [C.h_S2_iso]
    _ = ((star C.S1 * C.S2) * star C.S2) * C.S2 := by noncomm_ring
    _ = 0 * C.S2 := by rw [h4]
    _ = 0 := by ring

/-- Master Theorem 4: Orthogonality of Cuntz Range Projections matches Krein projectors. -/
theorem CuntzPL_mul_CuntzPR_eq_zero : (CuntzPL : A) * (CuntzPR : A) = 0 := by
  dsimp [CuntzPL, CuntzPR]
  calc (C.S1 * star C.S1) * (C.S2 * star C.S2)
    _ = C.S1 * (star C.S1 * C.S2) * star C.S2 := by noncomm_ring
    _ = C.S1 * 0 * star C.S2 := by rw [S1_star_mul_S2_eq_zero]
    _ = 0 := by ring

end InfoGeometry.Parahyperkahler.KreinCuntzBridge
