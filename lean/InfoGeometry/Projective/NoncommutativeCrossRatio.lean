import Mathlib.Tactic

/-!
# InfoGeometry.Projective.NoncommutativeCrossRatio

Kernel-checked noncommutative projective algebra.

This file deliberately does not import the commutative Klein cross-ratio theorem
and does not claim full fractional-linear invariance in a noncommutative
operator algebra.  The safe theorem proved here is the parabolic/translation
lane: differences are unchanged by adding the same element, so the ordered
noncommutative cross-ratio is invariant without any commutativity property.

The file also records the coordinate-free inner-derivation law used by the
operator lane: commutator derivations satisfy Leibniz in any noncommutative
ring.
-/

namespace InfoGeometry.Projective.NoncommutativeCrossRatio

/-! ## Inner derivations -/

section InnerDerivation

variable {R : Type*} [Ring R]

/-- Inner commutator derivation generated by `H`. -/
def innerDerivation (H A : R) : R :=
  H * A - A * H

/-- Commutator derivations satisfy the Leibniz rule in any noncommutative ring. -/
theorem innerDerivation_mul (H A B : R) :
    innerDerivation H (A * B) =
      innerDerivation H A * B + A * innerDerivation H B := by
  unfold innerDerivation
  noncomm_ring

theorem innerDerivation_add_right (H A B : R) :
    innerDerivation H (A + B) =
      innerDerivation H A + innerDerivation H B := by
  unfold innerDerivation
  noncomm_ring

theorem innerDerivation_add_left (H K A : R) :
    innerDerivation (H + K) A =
      innerDerivation H A + innerDerivation K A := by
  unfold innerDerivation
  noncomm_ring

@[simp] theorem innerDerivation_self (H : R) :
    innerDerivation H H = 0 := by
  simp [innerDerivation]

end InnerDerivation

/-! ## Ordered noncommutative cross-ratio -/

section CrossRatio

variable {R : Type*} [DivisionRing R]

/--
Ordered affine cross-ratio over a possibly noncommutative division ring.

The multiplication order is part of the definition:
`(P1 - P3) * (P1 - P4)^{-1} * (P2 - P4) * (P2 - P3)^{-1}`.
-/
def ncCrossRatio (P1 P2 P3 P4 : R) : R :=
  (P1 - P3) * (P1 - P4)⁻¹ * (P2 - P4) * (P2 - P3)⁻¹

/-- Right translation on the affine chart. -/
def rightTranslate (c P : R) : R :=
  P + c

/-- Left translation on the affine chart. -/
def leftTranslate (c P : R) : R :=
  c + P

/-- Right affine action `P ↦ P * a + b` on a noncommutative affine chart. -/
def rightAffine (a b P : R) : R :=
  P * a + b

/-- Left affine action `P ↦ a * P + b` on a noncommutative affine chart. -/
def leftAffine (a b P : R) : R :=
  a * P + b

theorem rightAffine_comp
    (a b c d P : R) :
    rightAffine a b (rightAffine c d P) =
      rightAffine (c * a) (d * a + b) P := by
  unfold rightAffine
  noncomm_ring

theorem leftAffine_comp
    (a b c d P : R) :
    leftAffine a b (leftAffine c d P) =
      leftAffine (a * c) (a * d + b) P := by
  unfold leftAffine
  noncomm_ring

@[simp] theorem rightAffine_identity (P : R) :
    rightAffine 1 0 P = P := by
  simp [rightAffine]

@[simp] theorem leftAffine_identity (P : R) :
    leftAffine 1 0 P = P := by
  simp [leftAffine]

/-- Inner conjugation by `a`, used for the noncommutative left-affine law. -/
def conjugateBy (a x : R) : R :=
  a * x * a⁻¹

/--
The finite defect of inner conjugation from strict invariance.

In the noncommutative affine lane, left scaling does not erase this term; it is
the extra internal degree of freedom carried by the commutator.
-/
def conjugationDefect (a x : R) : R :=
  conjugateBy a x - x

/--
After multiplying on the right by the scale factor, the finite conjugation
defect is exactly the commutator with that scale factor.
-/
theorem conjugationDefect_mul_eq_innerDerivation (a x : R) (ha : a ≠ 0) :
    conjugationDefect a x * a = innerDerivation a x := by
  unfold conjugationDefect conjugateBy innerDerivation
  rw [sub_mul]
  simp [ha, mul_assoc]

/--
Conjugation fixes an element exactly when the corresponding inner derivation
vanishes.
-/
theorem conjugateBy_eq_self_iff_innerDerivation_eq_zero (a x : R) (ha : a ≠ 0) :
    conjugateBy a x = x ↔ innerDerivation a x = 0 := by
  constructor
  · intro h
    unfold conjugateBy at h
    have hmul : (a * x * a⁻¹) * a = x * a := by rw [h]
    have hax : a * x = x * a := by simpa [ha, mul_assoc] using hmul
    exact sub_eq_zero.mpr hax
  · intro h
    have hax : a * x = x * a := sub_eq_zero.mp h
    unfold conjugateBy
    calc
      a * x * a⁻¹ = x * a * a⁻¹ := by rw [hax]
      _ = x := by simp [ha]

/--
Right translations preserve the ordered noncommutative cross-ratio.

No commutativity is used: all four differences reduce additively before any
noncommutative multiplication happens.
-/
theorem ncCrossRatio_rightTranslate (c P1 P2 P3 P4 : R) :
    ncCrossRatio
        (rightTranslate c P1) (rightTranslate c P2)
        (rightTranslate c P3) (rightTranslate c P4) =
      ncCrossRatio P1 P2 P3 P4 := by
  have h13 : rightTranslate c P1 - rightTranslate c P3 = P1 - P3 := by
    unfold rightTranslate
    abel
  have h14 : rightTranslate c P1 - rightTranslate c P4 = P1 - P4 := by
    unfold rightTranslate
    abel
  have h24 : rightTranslate c P2 - rightTranslate c P4 = P2 - P4 := by
    unfold rightTranslate
    abel
  have h23 : rightTranslate c P2 - rightTranslate c P3 = P2 - P3 := by
    unfold rightTranslate
    abel
  simp [ncCrossRatio, h13, h14, h24, h23]

/--
Left translations preserve the ordered noncommutative cross-ratio.

This is the same parabolic invariance, written for the other additive
presentation of the affine chart.
-/
theorem ncCrossRatio_leftTranslate (c P1 P2 P3 P4 : R) :
    ncCrossRatio
        (leftTranslate c P1) (leftTranslate c P2)
        (leftTranslate c P3) (leftTranslate c P4) =
      ncCrossRatio P1 P2 P3 P4 := by
  have h13 : leftTranslate c P1 - leftTranslate c P3 = P1 - P3 := by
    unfold leftTranslate
    abel
  have h14 : leftTranslate c P1 - leftTranslate c P4 = P1 - P4 := by
    unfold leftTranslate
    abel
  have h24 : leftTranslate c P2 - leftTranslate c P4 = P2 - P4 := by
    unfold leftTranslate
    abel
  have h23 : leftTranslate c P2 - leftTranslate c P3 = P2 - P3 := by
    unfold leftTranslate
    abel
  simp [ncCrossRatio, h13, h14, h24, h23]

/-- Difference law for right-affine transformations. -/
theorem rightAffine_sub (a b P Q : R) :
    rightAffine a b P - rightAffine a b Q = (P - Q) * a := by
  unfold rightAffine
  noncomm_ring

/-- Difference law for left-affine transformations. -/
theorem leftAffine_sub (a b P Q : R) :
    leftAffine a b P - leftAffine a b Q = a * (P - Q) := by
  unfold leftAffine
  noncomm_ring

/--
Right affine transformations preserve the ordered noncommutative cross-ratio.

This is strict invariance because the right multiplier cancels between each
ordered adjacent factor.
-/
theorem ncCrossRatio_rightAffine (a b P1 P2 P3 P4 : R) (ha : a ≠ 0) :
    ncCrossRatio
        (rightAffine a b P1) (rightAffine a b P2)
        (rightAffine a b P3) (rightAffine a b P4) =
      ncCrossRatio P1 P2 P3 P4 := by
  have h13 : rightAffine a b P1 - rightAffine a b P3 = (P1 - P3) * a :=
    rightAffine_sub a b P1 P3
  have h14 : rightAffine a b P1 - rightAffine a b P4 = (P1 - P4) * a :=
    rightAffine_sub a b P1 P4
  have h24 : rightAffine a b P2 - rightAffine a b P4 = (P2 - P4) * a :=
    rightAffine_sub a b P2 P4
  have h23 : rightAffine a b P2 - rightAffine a b P3 = (P2 - P3) * a :=
    rightAffine_sub a b P2 P3
  simp [ncCrossRatio, h13, h14, h24, h23, ha, mul_assoc]

/--
Left affine transformations conjugate the ordered noncommutative cross-ratio.

This is the precise noncommutative replacement for the scalar cancellation
argument: left scaling does not give strict invariance in general, only
inner-conjugacy by the multiplier.
-/
theorem ncCrossRatio_leftAffine_conjugate (a b P1 P2 P3 P4 : R) :
    ncCrossRatio
        (leftAffine a b P1) (leftAffine a b P2)
        (leftAffine a b P3) (leftAffine a b P4) =
      conjugateBy a (ncCrossRatio P1 P2 P3 P4) := by
  have h13 : leftAffine a b P1 - leftAffine a b P3 = a * (P1 - P3) :=
    leftAffine_sub a b P1 P3
  have h14 : leftAffine a b P1 - leftAffine a b P4 = a * (P1 - P4) :=
    leftAffine_sub a b P1 P4
  have h24 : leftAffine a b P2 - leftAffine a b P4 = a * (P2 - P4) :=
    leftAffine_sub a b P2 P4
  have h23 : leftAffine a b P2 - leftAffine a b P3 = a * (P2 - P3) :=
    leftAffine_sub a b P2 P3
  by_cases ha : a = 0
  · subst a
    simp [ncCrossRatio, h13, h14, h24, h23, conjugateBy]
  · simp [ncCrossRatio, h13, h14, h24, h23, conjugateBy, ha, mul_assoc]

/-- If an element commutes with `a`, conjugation by `a` fixes it. -/
theorem conjugateBy_eq_self_of_commute {a x : R} (ha : a ≠ 0) (hax : Commute a x) :
    conjugateBy a x = x := by
  unfold conjugateBy
  calc
    a * x * a⁻¹ = x * a * a⁻¹ := by rw [hax.eq]
    _ = x := by simp [ha]

/--
Strict left-affine invariance is recovered only under an explicit commutation
property with the ordered cross-ratio.
-/
theorem ncCrossRatio_leftAffine_of_commute
    (a b P1 P2 P3 P4 : R)
    (ha : a ≠ 0)
    (hcomm : Commute a (ncCrossRatio P1 P2 P3 P4)) :
    ncCrossRatio
        (leftAffine a b P1) (leftAffine a b P2)
        (leftAffine a b P3) (leftAffine a b P4) =
      ncCrossRatio P1 P2 P3 P4 := by
  rw [ncCrossRatio_leftAffine_conjugate]
  exact conjugateBy_eq_self_of_commute ha hcomm

/--
The noncommutative part of left affine scaling is the commutator defect of the
ordered cross-ratio.

This is the precise algebraic replacement for the false scalar cancellation
argument: strict invariance fails by an inner derivation unless the scale
commutes with the cross-ratio.
-/
theorem ncCrossRatio_leftAffine_defect_mul_eq_innerDerivation
    (a b P1 P2 P3 P4 : R) (ha : a ≠ 0) :
    (ncCrossRatio
          (leftAffine a b P1) (leftAffine a b P2)
          (leftAffine a b P3) (leftAffine a b P4) -
        ncCrossRatio P1 P2 P3 P4) *
      a =
    innerDerivation a (ncCrossRatio P1 P2 P3 P4) := by
  rw [ncCrossRatio_leftAffine_conjugate]
  exact conjugationDefect_mul_eq_innerDerivation a
    (ncCrossRatio P1 P2 P3 P4) ha

/--
Strict left-affine invariance is equivalent to vanishing of the commutator
defect.
-/
theorem ncCrossRatio_leftAffine_eq_iff_innerDerivation_eq_zero
    (a b P1 P2 P3 P4 : R) (ha : a ≠ 0) :
    ncCrossRatio
        (leftAffine a b P1) (leftAffine a b P2)
        (leftAffine a b P3) (leftAffine a b P4) =
      ncCrossRatio P1 P2 P3 P4 ↔
    innerDerivation a (ncCrossRatio P1 P2 P3 P4) = 0 := by
  rw [ncCrossRatio_leftAffine_conjugate]
  exact conjugateBy_eq_self_iff_innerDerivation_eq_zero a
    (ncCrossRatio P1 P2 P3 P4) ha

/--
Right fractional-linear action on a noncommutative affine chart.

This is only a definition.  Full noncommutative Mobius invariance requires
additional hypotheses; it is not a consequence of scalar determinant
cancellation.
-/
def rightFractionalLinear (A B C D P : R) : R :=
  (A * P + B) * (C * P + D)⁻¹

/-- The upper parabolic fractional-linear element acts as right translation. -/
@[simp] theorem rightFractionalLinear_parabolic (c P : R) :
    rightFractionalLinear 1 c 0 1 P = rightTranslate c P := by
  simp [rightFractionalLinear, rightTranslate]

/--
The noncommutative parabolic projective action preserves the ordered
cross-ratio.
-/
theorem ncCrossRatio_rightFractionalLinear_parabolic (c P1 P2 P3 P4 : R) :
    ncCrossRatio
        (rightFractionalLinear 1 c 0 1 P1)
        (rightFractionalLinear 1 c 0 1 P2)
        (rightFractionalLinear 1 c 0 1 P3)
        (rightFractionalLinear 1 c 0 1 P4) =
      ncCrossRatio P1 P2 P3 P4 := by
  simpa using ncCrossRatio_rightTranslate c P1 P2 P3 P4

end CrossRatio

end InfoGeometry.Projective.NoncommutativeCrossRatio
