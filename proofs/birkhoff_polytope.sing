// Singular script for the algebraic geometry of the Birkhoff polytope
LIB "poly.lib";

// Consider 3x3 doubly stochastic matrices
ring r = 0, (x11, x12, x13, x21, x22, x23, x31, x32, x33), dp;

// The Birkhoff polytope is defined by row sums = 1, col sums = 1, and x_ij >= 0
// We define the affine hull (the linear variety)
ideal I =
  x11 + x12 + x13 - 1,
  x21 + x22 + x23 - 1,
  x31 + x32 + x33 - 1,
  x11 + x21 + x31 - 1,
  x12 + x22 + x32 - 1,
  x13 + x23 + x33 - 1;

// The ideal generated by these defines a linear space.
// We can compute its Groebner basis and dimension
ideal J = std(I);
dim(J);

print("Dimension of the 3x3 Birkhoff polytope affine hull:");
print(dim(J));

// For the Birkhoff polytope itself, it is the intersection of this affine hull with the positive orthant.
// The vertices are permutation matrices. We can find the algebraic dependencies.

// Compute syzygies
module S = syz(J);
print("Syzygies of the affine hull ideal:");
print(S);

quit;
