import Mathlib.Algebra.Ring.Idempotent
import Mathlib.Algebra.Star.Basic
import Mathlib.Algebra.Algebra.Basic
import Mathlib.Tactic.Abel
import Mathlib.Order.Hom.Basic
import InfoGeometry.OperatorAlgebra.PeirceSpine.Basic

/-!
# Stage D₃₆ (Archetypes C₁ → C₅): Inner Derivations, Unipotent Conjugation, Lower-Triangular Peirce Subalgebra, Star-Adjoint Parity, and Defect-Tower Centralizers

1. **Archetype C₁ (`C1_chiralInnerDerivation`)**:
   The inner derivation `chiralInnerDeriv P A C X = comm (genSig P A C) X` generated by the
   corner commutator `genSig P A C = [N₊, N₋]`, which annihilates the even blocks `genSig` and
   `genV` while exchanging the odd blocks `genPhi` and `genJ` with factor `2 • genV`.
2. **Archetype C₂ (`C2_unipotentCornerConjugation`)**:
   The `ℤ`-indexed unipotent corner group `unipotentCornerOp k P A = 1 + k • conePlus P A`,
   its inverse `1 - k • conePlus P A`, the conjugation action `unipotentConjugation k P A X`,
   and the anticommutator identity `{U_k⁻¹ [P, U_k], N₋(C)} = k • genV P A C`.
3. **Archetype C₃ (`C3_lowerTriangularPeirceSubalgebra`)**:
   The lower-triangular Peirce subalgebra `lowerTriangularPeirceOp P F B_ret D = P F P + (1 - P) B_ret P + (1 - P) D (1 - P)`,
   satisfying upper-right corner annihilation `P * T * (1 - P) = 0` and multiplicative closure.
4. **Archetype C₄ (`C4_starParityDoubleCommutatorSplit`)**:
   In `[Ring B] [StarRing B]` with `star P = P`, the inner derivation `chiralInnerDeriv P A (star A)`
   is `⋆`-odd (`star [Σ, X] = -[Σ, star X]`), whereas the double commutator
   `oddDoubleCommutator P A (star A) X = [J, [J, X]]` is `⋆`-even (`star [J, [J, X]] = +[J, [J, star X]]`).
5. **Archetype C₅ (`C5_idempotentDefectTowerCentralizer`)**:
   The polynomial defect tower `defectPolyTower n (genV P A C)` generated by `X ↦ X² - X`
   lies in the centralizer of both `genSig P A C` and `genJ P A C` for every `n : ℕ`.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine.NonCommutativeOperatorTimePoset

open InfoGeometry.OperatorAlgebra.PeirceSpine

variable {B : Type*} [Ring B] [StarRing B]

/-! ### Causal Poset of Stage D₃₆ Archetypes (C₁ → C₅) -/

/-- The 5-stage causal poset of non-commutative derivation, unipotent conjugation,
lower-triangular Peirce closure, star-parity split, and defect-tower centralizer archetypes (`C₁ → C₅`). -/
inductive StageD36Archetype
  | C1_chiralInnerDerivation
  | C2_unipotentCornerConjugation
  | C3_lowerTriangularPeirceSubalgebra
  | C4_starParityDoubleCommutatorSplit
  | C5_idempotentDefectTowerCentralizer
  deriving DecidableEq, Repr

instance instInhabitedStageD36Archetype : Inhabited StageD36Archetype :=
  ⟨.C1_chiralInnerDerivation⟩

/-- Topological rank in the 5-stage causal poset. -/
def stageD36Rank : StageD36Archetype → ℕ
  | .C1_chiralInnerDerivation => 0
  | .C2_unipotentCornerConjugation => 1
  | .C3_lowerTriangularPeirceSubalgebra => 2
  | .C4_starParityDoubleCommutatorSplit => 3
  | .C5_idempotentDefectTowerCentralizer => 4

theorem stageD36Rank_injective : Function.Injective stageD36Rank := by
  intro a b h
  cases a <;> cases b <;> cases h <;> rfl

instance instPartialOrderStageD36Archetype : PartialOrder StageD36Archetype :=
  PartialOrder.lift stageD36Rank stageD36Rank_injective

theorem stageD36_strict_causal_chain :
    StageD36Archetype.C1_chiralInnerDerivation < .C2_unipotentCornerConjugation ∧
    StageD36Archetype.C2_unipotentCornerConjugation < .C3_lowerTriangularPeirceSubalgebra ∧
    StageD36Archetype.C3_lowerTriangularPeirceSubalgebra < .C4_starParityDoubleCommutatorSplit ∧
    StageD36Archetype.C4_starParityDoubleCommutatorSplit < .C5_idempotentDefectTowerCentralizer := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> decide

/-! ### Stage 0: Core Operator Primitives for Archetypes C₁ → C₅ -/

/-- Idempotency defect polynomial `X² - X`. -/
def idemDefect (X : B) : B := X * X - X

/-- **Archetype C₁: Inner Derivation by the Corner Commutator (`chiralInnerDeriv`):**
`δ_Σ(X) = [Σ(A, C), X]`. -/
def chiralInnerDeriv (P A C X : B) : B :=
  comm (genSig P A C) X

/-- **Archetype C₂: Integer-Indexed Unipotent Corner Element (`unipotentCornerOp`, `unipotentCornerOpInv`)
and Conjugation Action (`unipotentConjugation`):** -/
def unipotentCornerOp (k : ℤ) (P A : B) : B := 1 + k • conePlus P A

def unipotentCornerOpInv (k : ℤ) (P A : B) : B := 1 - k • conePlus P A

def unipotentConjugation (k : ℤ) (P A X : B) : B :=
  unipotentCornerOpInv k P A * X * unipotentCornerOp k P A

/-- **Archetype C₃: Lower-Triangular Peirce Block Element (`lowerTriangularPeirceOp`):**
`P F P + (1 - P) B_ret P + (1 - P) D (1 - P)`. -/
def lowerTriangularPeirceOp (P F B_ret D : B) : B :=
  P * F * P + (1 - P) * B_ret * P + (1 - P) * D * (1 - P)

/-- **Archetype C₄: Skew-Corner Double Commutator (`oddDoubleCommutator`)
and Combined Derivation–Double-Commutator Sum (`combinedBracketGen`):** -/
def oddDoubleCommutator (P A C X : B) : B :=
  comm (genJ P A C) (comm (genJ P A C) X)

def combinedBracketGen (P A C X : B) : B :=
  chiralInnerDeriv P A C X + oddDoubleCommutator P A C X

/-- **Archetype C₅: Iterated Idempotency-Defect Polynomial Tower (`defectPolyTower`):** -/
def defectPolyTower : ℕ → B → B
  | 0, X => idemDefect X
  | n + 1, X => idemDefect (defectPolyTower n X)

/-- Constructor-indexed operator realization mapping each `StageD36Archetype` stage to its
canonical operator in `[Ring B]`. -/
def stageD36Operator (k : ℤ) (n : ℕ) (P A C X F B_ret D : B) : StageD36Archetype → B
  | .C1_chiralInnerDerivation => chiralInnerDeriv P A C X
  | .C2_unipotentCornerConjugation => unipotentConjugation k P A X
  | .C3_lowerTriangularPeirceSubalgebra => lowerTriangularPeirceOp P F B_ret D
  | .C4_starParityDoubleCommutatorSplit => oddDoubleCommutator P A C X
  | .C5_idempotentDefectTowerCentralizer => defectPolyTower n (genV P A C)

omit [StarRing B] in
theorem P_assoc {P : B} (hP : P * P = P) (X : B) : P * (P * X) = P * X := by
  rw [← mul_assoc, hP]

macro "time_abel" hP:ident : tactic =>
  `(tactic| (
    simp only [combinedBracketGen, oddDoubleCommutator, lowerTriangularPeirceOp,
               unipotentConjugation, unipotentCornerOp, unipotentCornerOpInv,
               chiralInnerDeriv,
               genPhi, genJ, genV, genSig,
               conePlus, coneMinus, comm, anticomm, idemDefect,
               smul_mul_assoc, mul_smul_comm, smul_add, smul_sub, smul_neg,
               smul_smul, smul_zero, zero_smul, add_smul, sub_smul,
               zsmul_add, zsmul_sub, neg_zsmul, two_zsmul,
               sub_neg_eq_add, neg_mul, mul_neg, neg_neg,
               add_mul, mul_add, sub_mul, mul_sub, one_mul, mul_one,
               sub_self, mul_zero, zero_mul, add_zero, zero_add, neg_zero,
               mul_assoc, $hP:ident, P_assoc $hP:ident]
    try abel))

/-! ### Individual Theorems for Archetypes C₁ → C₅ -/

omit [StarRing B] in
/-- **Theorem C₁.1 (Inner Derivation Identities of the Corner Commutator `Σ = [N₊, N₋]`):**
For any idempotent `P` (`P * P = P`) and any `A, C : B`:
1. `chiralInnerDeriv P A C (genPhi P A C) = (2 : ℤ) • (genV P A C * genJ P A C)` and
   `chiralInnerDeriv P A C (genJ P A C) = (2 : ℤ) • (genV P A C * genPhi P A C)`;
2. `chiralInnerDeriv P A C (chiralInnerDeriv P A C (genPhi P A C)) = (4 : ℤ) • (genV P A C * genV P A C * genPhi P A C)`;
3. `chiralInnerDeriv P A C (genSig P A C) = 0` and `chiralInnerDeriv P A C (genV P A C) = 0`. -/
theorem chiral_inner_derivation_identities {P : B} (hP : P * P = P) (A C : B) :
    chiralInnerDeriv P A C (genPhi P A C) = (2 : ℤ) • (genV P A C * genJ P A C) ∧
    chiralInnerDeriv P A C (genJ P A C) = (2 : ℤ) • (genV P A C * genPhi P A C) ∧
    chiralInnerDeriv P A C (chiralInnerDeriv P A C (genPhi P A C)) =
      (4 : ℤ) • (genV P A C * genV P A C * genPhi P A C) ∧
    chiralInnerDeriv P A C (genSig P A C) = 0 ∧
    chiralInnerDeriv P A C (genV P A C) = 0 := by
  refine ⟨by time_abel hP, by time_abel hP, by time_abel hP, by time_abel hP, by time_abel hP⟩

omit [StarRing B] in
/-- **Theorem C₂.1 (Unipotent Corner Conjugation Group Law & Corner Anticommutator Pairing):**
For any idempotent `P` (`P * P = P`), any `A, C, X : B`, and any `k, k₁, k₂ : ℤ`:
1. `unipotentConjugation k₂ P A (unipotentConjugation k₁ P A X) = unipotentConjugation (k₁ + k₂) P A X`
   and `unipotentConjugation 0 P A X = X`;
2. `anticomm (unipotentCornerOpInv k P A * comm P (unipotentCornerOp k P A)) (coneMinus P C) = k • genV P A C`;
3. `unipotentConjugation k P A (genV P A C) = genV P A C`. -/
theorem unipotent_conjugation_action_and_corner_bracket
    {P : B} (hP : P * P = P) (A C X : B) (k k₁ k₂ : ℤ) :
    unipotentConjugation k₂ P A (unipotentConjugation k₁ P A X) =
      unipotentConjugation (k₁ + k₂) P A X ∧
    unipotentConjugation 0 P A X = X ∧
    anticomm (unipotentCornerOpInv k P A * comm P (unipotentCornerOp k P A)) (coneMinus P C) =
      k • genV P A C ∧
    unipotentConjugation k P A (genV P A C) = genV P A C := by
  refine ⟨by time_abel hP, by time_abel hP, by time_abel hP, by time_abel hP⟩

omit [StarRing B] in
/-- **Theorem C₃.1 (Lower-Triangular Peirce Subalgebra: Upper-Right Annihilation & Multiplicative Closure):**
For any idempotent `P` (`P * P = P`) and any `F₁, B₁, D₁, F₂, B₂, D₂ : B`:
1. `P * lowerTriangularPeirceOp P F₁ B₁ D₁ * (1 - P) = 0`;
2. `lowerTriangularPeirceOp P F₁ B₁ D₁ * lowerTriangularPeirceOp P F₂ B₂ D₂ =`
   `lowerTriangularPeirceOp P (F₁ * P * F₂) (B₁ * P * F₂ + D₁ * (1 - P) * B₂) (D₁ * (1 - P) * D₂)`. -/
theorem lower_triangular_peirce_annihilation_and_closure
    {P : B} (hP : P * P = P) (F₁ B₁ D₁ F₂ B₂ D₂ : B) :
    P * lowerTriangularPeirceOp P F₁ B₁ D₁ * (1 - P) = 0 ∧
    lowerTriangularPeirceOp P F₁ B₁ D₁ * lowerTriangularPeirceOp P F₂ B₂ D₂ =
      lowerTriangularPeirceOp P (F₁ * P * F₂) (B₁ * P * F₂ + D₁ * (1 - P) * B₂) (D₁ * (1 - P) * D₂) := by
  refine ⟨by time_abel hP, by time_abel hP⟩

/-- **Theorem C₄.1 (Star-Adjoint Parity Split of Inner Derivation vs. Double Commutator):**
For any self-adjoint idempotent `P` (`story: P * P = P`, `star P = P`) and any `A, X : B`:
1. `star (chiralInnerDeriv P A (star A) X) = -chiralInnerDeriv P A (star A) (star X)`;
2. `star (oddDoubleCommutator P A (star A) X) = oddDoubleCommutator P A (star A) (star X)`;
3. `star (combinedBracketGen P A (star A) X) + combinedBracketGen P A (star A) (star X) =`
   `(2 : ℤ) • oddDoubleCommutator P A (star A) (star X)`. -/
theorem star_parity_of_inner_and_double_commutators
    (hPsym : star (P : B) = P) (A X : B) :
    star (chiralInnerDeriv P A (star A) X) =
      -chiralInnerDeriv P A (star A) (star X) ∧
    star (oddDoubleCommutator P A (star A) X) =
      oddDoubleCommutator P A (star A) (star X) ∧
    star (combinedBracketGen P A (star A) X) + combinedBracketGen P A (star A) (star X) =
      (2 : ℤ) • oddDoubleCommutator P A (star A) (star X) := by
  have hStarCone : star (conePlus P A) = coneMinus P (star A) := by
    unfold conePlus coneMinus
    rw [star_mul, star_mul, star_sub, star_one, hPsym, mul_assoc]
  have hStarConeM : star (coneMinus P (star A)) = conePlus P A := by
    rw [← hStarCone, star_star]
  have hStarSig : star (genSig P A (star A)) = genSig P A (star A) := by
    unfold genSig comm
    rw [star_sub, star_mul, star_mul, hStarCone, hStarConeM]
  have hStarJ : star (genJ P A (star A)) = -genJ P A (star A) := by
    unfold genJ; rw [star_sub, hStarCone, hStarConeM, neg_sub]
  have hCommHerm : ∀ H Z : B, star H = H → star (comm H Z) = -comm H (star Z) := by
    intro H Z hH
    unfold comm
    rw [star_sub, star_mul, star_mul, hH, neg_sub]
  have hCommSkew : ∀ U Z : B, star U = -U → star (comm U Z) = comm U (star Z) := by
    intro U Z hU
    unfold comm
    rw [star_sub, star_mul, star_mul, hU, mul_neg, neg_mul]
    abel
  have hModOdd : star (chiralInnerDeriv P A (star A) X) =
      -chiralInnerDeriv P A (star A) (star X) := by
    unfold chiralInnerDeriv
    exact hCommHerm (genSig P A (star A)) X hStarSig
  have hDissEven : star (oddDoubleCommutator P A (star A) X) =
      oddDoubleCommutator P A (star A) (star X) := by
    unfold oddDoubleCommutator
    rw [hCommSkew (genJ P A (star A)) (comm (genJ P A (star A)) X) hStarJ,
        hCommSkew (genJ P A (star A)) X hStarJ]
  refine ⟨hModOdd, hDissEven, ?_⟩
  unfold combinedBracketGen
  rw [star_add, hModOdd, hDissEven]
  abel

omit [StarRing B] in
/-- **Theorem C₅.1 (Centralizer Invariance of the Iterated Defect Polynomial Tower):**
For any idempotent `P` (`P * P = P`), any `A, C : B`, and any `n : ℕ`, the iterate
`defectPolyTower n (genV P A C)` commutes with both `genSig P A C` and `genJ P A C`, and is
annihilated by `chiralInnerDeriv`, `oddDoubleCommutator`, and `combinedBracketGen`. -/
theorem defect_tower_centralizer_invariance
    {P : B} (hP : P * P = P) (A C : B) (n : ℕ) :
    chiralInnerDeriv P A C (defectPolyTower n (genV P A C)) = 0 ∧
    oddDoubleCommutator P A C (defectPolyTower n (genV P A C)) = 0 ∧
    combinedBracketGen P A C (defectPolyTower n (genV P A C)) = 0 := by
  have hCommLeib : ∀ H U W : B, comm H U = 0 → comm H W = 0 → comm H (U * W) = 0 := by
    intro H U W hU hW
    have h1 : comm H (U * W) = comm H U * W + U * comm H W := by
      unfold comm; simp only [sub_mul, mul_sub, mul_assoc]; abel
    rw [h1, hU, hW, zero_mul, mul_zero, add_zero]
  have hCommSub : ∀ H U W : B, comm H U = 0 → comm H W = 0 → comm H (U - W) = 0 := by
    intro H U W hU hW
    have h1 : comm H (U - W) = comm H U - comm H W := by
      unfold comm; simp only [sub_mul, mul_sub]; abel
    rw [h1, hU, hW, sub_self]
  have hInd : ∀ m : ℕ,
      comm (genSig P A C) (defectPolyTower m (genV P A C)) = 0 ∧
      comm (genJ P A C) (defectPolyTower m (genV P A C)) = 0 := by
    intro m
    induction m with
    | zero =>
      simp only [defectPolyTower]
      exact ⟨by time_abel hP, by time_abel hP⟩
    | succ m ih =>
      rcases ih with ⟨ihSig, ihJ⟩
      simp only [defectPolyTower, idemDefect]
      exact ⟨hCommSub _ _ _ (hCommLeib _ _ _ ihSig ihSig) ihSig,
             hCommSub _ _ _ (hCommLeib _ _ _ ihJ ihJ) ihJ⟩
  rcases hInd n with ⟨hSigVn, hJVn⟩
  have hMod : chiralInnerDeriv P A C (defectPolyTower n (genV P A C)) = 0 := hSigVn
  have hDiss : oddDoubleCommutator P A C (defectPolyTower n (genV P A C)) = 0 := by
    unfold oddDoubleCommutator
    rw [hJVn]
    unfold comm; rw [mul_zero, zero_mul, sub_self]
  refine ⟨hMod, hDiss, ?_⟩
  unfold combinedBracketGen
  rw [hMod, hDiss, add_zero]

/-! ### Master Theorem D₃₆: Complete Synthesis of Archetypes C₁ → C₅ -/

/-- **Master Theorem D₃₆ (Chiral Inner Derivation, Unipotent Corner Conjugation,
Lower-Triangular Peirce Subalgebra, Star-Parity Double-Commutator Split & Defect-Tower Centralizer):**
Unifies all 5 archetypes (`C₁ → C₅`) and `stageD36Operator` in native Mathlib4 with zero `sorry`s. -/
theorem stage_D36_noncommutative_derivation_unipotent_triangular_star_tower_master_synthesis
    {P A C X F₁ B₁ D₁ F₂ B₂ D₂ : B}
    (hP : P * P = P) (hPsym : star P = P) (k k₁ k₂ : ℤ) (n : ℕ) :
    stageD36Operator k n P A C (genPhi P A C) F₁ B₁ D₁ .C1_chiralInnerDerivation =
      (2 : ℤ) • (genV P A C * genJ P A C) ∧
    chiralInnerDeriv P A C (chiralInnerDeriv P A C (genPhi P A C)) =
      (4 : ℤ) • (genV P A C * genV P A C * genPhi P A C) ∧
    unipotentConjugation k₂ P A
      (stageD36Operator k₁ n P A C X F₁ B₁ D₁ .C2_unipotentCornerConjugation) =
      unipotentConjugation (k₁ + k₂) P A X ∧
    anticomm (unipotentCornerOpInv k P A * comm P (unipotentCornerOp k P A)) (coneMinus P C) =
      k • genV P A C ∧
    P * stageD36Operator k n P A C X F₁ B₁ D₁ .C3_lowerTriangularPeirceSubalgebra * (1 - P) = 0 ∧
    lowerTriangularPeirceOp P F₁ B₁ D₁ * lowerTriangularPeirceOp P F₂ B₂ D₂ =
      lowerTriangularPeirceOp P (F₁ * P * F₂) (B₁ * P * F₂ + D₁ * (1 - P) * B₂) (D₁ * (1 - P) * D₂) ∧
    star (chiralInnerDeriv P A (star A) X) = -chiralInnerDeriv P A (star A) (star X) ∧
    star (stageD36Operator k n P A (star A) X F₁ B₁ D₁ .C4_starParityDoubleCommutatorSplit) =
      oddDoubleCommutator P A (star A) (star X) ∧
    star (combinedBracketGen P A (star A) X) + combinedBracketGen P A (star A) (star X) =
      (2 : ℤ) • oddDoubleCommutator P A (star A) (star X) ∧
    combinedBracketGen P A C
      (stageD36Operator k n P A C X F₁ B₁ D₁ .C5_idempotentDefectTowerCentralizer) = 0 := by
  dsimp only [stageD36Operator]
  rcases chiral_inner_derivation_identities hP A C with ⟨hM1, _, hM3, _, _⟩
  rcases unipotent_conjugation_action_and_corner_bracket hP A C X k k₁ k₂ with
    ⟨hR1, _, hR3, _⟩
  rcases lower_triangular_peirce_annihilation_and_closure hP F₁ B₁ D₁ F₂ B₂ D₂ with ⟨hC1, hC2⟩
  rcases star_parity_of_inner_and_double_commutators hPsym A X with
    ⟨hA1, hA2, hA3⟩
  rcases defect_tower_centralizer_invariance hP A C n with ⟨_, _, hE3⟩
  exact ⟨hM1, hM3, hR1, hR3, hC1, hC2, hA1, hA2, hA3, hE3⟩

end InfoGeometry.OperatorAlgebra.PeirceSpine.NonCommutativeOperatorTimePoset
