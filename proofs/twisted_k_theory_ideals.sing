// Singular Script: Twisted K-theory Ideals and Fixed Planes
ring r = 0, (x1,x2,x3,x4,x5, y1,y2,y3,y4,y5), dp;

// Define the ideal for the orbifold fixed points/planes
// For T^5 / Z_2, coordinates undergo x_i -> -x_i. 
// Fixed planes correspond to x_i = 0 or pi (represented algebraically by x_i(x_i - 1) = 0)
ideal I = x1*(x1-1), x2*(x2-1), x3*(x3-1), x4*(x4-1), x5*(x5-1);

// The Global Witten Anomaly can be analyzed by looking at the singular locus 
// and the algebraic topology of the defect ideals.
print("Orbifold Fixed Point Ideal:");
I;

// Compute the Groebner basis to study the variety
ideal G = std(I);
print("Groebner basis of the defect ideal (Fixed Points):");
G;

// Dimension of the variety of fixed points
int dim_I = dim(G);
print("Dimension of the fixed point variety:");
dim_I;

// In a full T-dual setup, y_i coordinates correspond to the dual torus.
// Twisted K-theory resolves these singularities via B-field turning on.
ideal twisted_I = I + ideal(y1, y2, y3, y4, y5); 
print("Twisted K-theory ideal resolution (simplified):");
twisted_I;
