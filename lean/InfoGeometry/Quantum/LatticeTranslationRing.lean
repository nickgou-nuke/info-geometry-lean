import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.Algebra.Group.Units.Hom
import Mathlib.Algebra.Group.TypeTags.Basic
import Mathlib.Algebra.Module.NatInt
import Mathlib.LinearAlgebra.StdBasis
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Data.Matrix.Mul

/-!
# Translation coefficients and the one-cell periodic quotient

The translation coefficient ring of a lattice CSS presentation is the actual
finite-support group algebra `k[ℤᴰ]`. Spatial inversion negates lattice
exponents, and the matrix dagger combines inversion with transpose.

The augmentation is proved to have kernel generated by the coordinate
translations minus one. Thus its target is the actual one-cell periodic
quotient, not an unrelated scalar model. No representation of Pauli operators
or classification of quantum codes is asserted by this coefficient module.
-/

namespace InfoGeometry.Quantum.LatticeTranslationRing

noncomputable section

universe u

abbrev Lattice (D : ℕ) := Fin D → ℤ

abbrev Coefficients (k : Type u) [Semiring k] (D : ℕ) :=
  AddMonoidAlgebra k (Lattice D)

variable (k : Type u) [CommRing k] (D : ℕ)

/-- A unit lattice translation, retained as a monomial in the group algebra. -/
def translation (g : Lattice D) : Coefficients k D :=
  AddMonoidAlgebra.single g 1

/-- Translation by one lattice cell along the selected coordinate. -/
def coordinate (i : Fin D) : Coefficients k D :=
  translation k D (Pi.single i 1)

/-- The ordinary periodic-boundary ideal for the prescribed coordinate lengths. -/
def periodicIdeal (L : Fin D → ℕ) : Ideal (Coefficients k D) :=
  Ideal.span (Set.range fun i => coordinate k D i ^ L i - 1)

/-- The ideal imposing one cell in every lattice direction. -/
def oneCellIdeal : Ideal (Coefficients k D) :=
  Ideal.span (Set.range fun i => coordinate k D i - 1)

theorem periodicIdeal_one : periodicIdeal k D (fun _ => 1) = oneCellIdeal k D := by
  simp [periodicIdeal, oneCellIdeal]

/-- Evaluation of every translation at one, constructed by the group-algebra
universal property. -/
def augmentation : Coefficients k D →ₐ[k] k :=
  AddMonoidAlgebra.lift k k (Lattice D) 1

@[simp] theorem augmentation_single (g : Lattice D) (c : k) :
    augmentation k D (AddMonoidAlgebra.single g c) = c := by
  simp [augmentation]

@[simp] theorem augmentation_translation (g : Lattice D) :
    augmentation k D (translation k D g) = 1 := by
  simp [translation]

@[simp] theorem augmentation_coordinate (i : Fin D) :
    augmentation k D (coordinate k D i) = 1 := by
  simp [coordinate]

/-- Spatial inversion acts on the lattice, not on the coefficient field. -/
def inversion : Coefficients k D ≃ₐ[k] Coefficients k D :=
  AddMonoidAlgebra.domCongr k k (AddEquiv.neg (Lattice D))

@[simp] theorem inversion_single (g : Lattice D) (c : k) :
    inversion k D (AddMonoidAlgebra.single g c) = AddMonoidAlgebra.single (-g) c := by
  simp [inversion]

@[simp] theorem inversion_inversion (p : Coefficients k D) :
    inversion k D (inversion k D p) = p := by
  ext g
  simp [inversion, AddMonoidAlgebra.coeff_domCongr]

@[simp] theorem augmentation_inversion (p : Coefficients k D) :
    augmentation k D (inversion k D p) = augmentation k D p := by
  induction p using AddMonoidAlgebra.induction with
  | zero => simp
  | single_add g c p _ _ ih => simp [ih]

/-- Every coordinate relation lies in the augmentation kernel. -/
theorem oneCellIdeal_le_ker :
    oneCellIdeal k D ≤ RingHom.ker (augmentation k D).toRingHom := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  change augmentation k D (coordinate k D i - 1) = 0
  simp

set_option backward.isDefEq.respectTransparency false in
/-- Killing coordinate translations kills every lattice translation.
The proof uses the genuine integral basis of the full lattice. -/
theorem quotient_translation_eq_one (g : Lattice D) :
    Ideal.Quotient.mk (oneCellIdeal k D) (translation k D g) = 1 := by
  let q := Ideal.Quotient.mk (oneCellIdeal k D)
  let χ : Multiplicative (Lattice D) →* (Coefficients k D ⧸ oneCellIdeal k D) :=
    q.toMonoidHom.comp (AddMonoidAlgebra.of k (Lattice D))
  let h := χ.toHomUnits.toAdditiveRight
  have hh (i : Fin D) : h (Pi.single i 1) = 0 := by
    change χ.toHomUnits (Multiplicative.ofAdd (Pi.single i 1)) = 1
    apply Units.ext
    change q (translation k D (Pi.single i 1)) = 1
    have hi : q (coordinate k D i - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
    exact sub_eq_zero.mp (by simpa only [map_sub, map_one, coordinate] using hi)
  have hv : g = ∑ i, (g i) • Pi.single i (1 : ℤ) := by
    ext j
    simp [Finset.sum_apply, Pi.single_apply]
  have hg : h g = 0 := by
    rw [hv, map_sum]
    apply Finset.sum_eq_zero
    intro i _
    rw [map_zsmul, hh, zsmul_zero]
  change χ.toHomUnits (Multiplicative.ofAdd g) = 1 at hg
  exact congrArg Units.val hg

/-- In the coordinate quotient, a polynomial equals its augmented constant. -/
theorem quotient_eq_augmentation (p : Coefficients k D) :
    Ideal.Quotient.mk (oneCellIdeal k D) p =
      Ideal.Quotient.mk (oneCellIdeal k D)
        (AddMonoidAlgebra.single 0 (augmentation k D p)) := by
  let q := Ideal.Quotient.mk (oneCellIdeal k D)
  have heq : q = (q.comp AddMonoidAlgebra.singleZeroRingHom).comp
      (augmentation k D).toRingHom := by
    apply AddMonoidAlgebra.ringHom_ext
    · intro c
      simp
    · intro g
      simpa [translation, q, ← AddMonoidAlgebra.one_def] using
        quotient_translation_eq_one k D g
  exact RingHom.congr_fun heq p

/-- The augmentation kernel is exactly the coordinate periodic ideal. -/
theorem augmentation_ker :
    RingHom.ker (augmentation k D).toRingHom = oneCellIdeal k D := by
  apply le_antisymm _ (oneCellIdeal_le_ker k D)
  intro p hp
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  rw [quotient_eq_augmentation]
  change augmentation k D p = 0 at hp
  simp [hp]

/-- The actual one-cell periodic translation quotient is the coefficient ring. -/
noncomputable def oneCellEquiv :
    (Coefficients k D ⧸ oneCellIdeal k D) ≃+* k :=
  (Ideal.quotEquivOfEq (augmentation_ker k D).symm).trans
    (RingHom.quotientKerEquivOfRightInverse
      (f := (augmentation k D).toRingHom)
      (g := fun c => AddMonoidAlgebra.single 0 c) (by intro c; simp))

@[simp] theorem oneCellEquiv_mk (p : Coefficients k D) :
    oneCellEquiv k D (Ideal.Quotient.mk (oneCellIdeal k D) p) =
      augmentation k D p := rfl

/-- The coefficient dagger of a rectangular lattice matrix. -/
def dagger {m n : Type*} (M : Matrix m n (Coefficients k D)) :
    Matrix n m (Coefficients k D) := (M.map (inversion k D)).transpose

@[simp] theorem dagger_apply {m n : Type*}
    (M : Matrix m n (Coefficients k D)) (i : n) (j : m) :
    dagger k D M i j = inversion k D (M j i) := rfl

@[simp] theorem dagger_dagger {m n : Type*} (M : Matrix m n (Coefficients k D)) :
    dagger k D (dagger k D M) = M := by
  ext i j
  simp

@[simp] theorem dagger_zero {m n : Type*} :
    dagger k D (0 : Matrix m n (Coefficients k D)) = 0 := by
  ext i j
  simp

/-- The dagger reverses matrix composition even though the matrices need not commute. -/
theorem dagger_mul {m n p : Type*} [Fintype n]
    (M : Matrix m n (Coefficients k D)) (N : Matrix n p (Coefficients k D)) :
    dagger k D (M * N) = dagger k D N * dagger k D M := by
  ext i j
  simp [dagger, Matrix.mul_apply, mul_comm]

end

end InfoGeometry.Quantum.LatticeTranslationRing
