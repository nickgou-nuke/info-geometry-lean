import InfoGeometry.Algebra.Zorn.MatrixCayleyDicksonSeparation
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Clifford.Cl11Matrix

/-!
# The actual quadratic inverse and regular Cayley domain of the native Zorn algebra

A Zorn display is not an ordinary block matrix. Its inverse is computed in
its composition algebra: `X⁻¹ = (N X)⁻¹ (tr(X) I - X)`, for `N X ≠ 0`.
Both inverse identities are proved with native Zorn multiplication.

The resulting Cayley expression is a rational map on the explicit regular
locus `N(X+I) ≠ 0`. It does not provide a bounded symmetric domain or a
positive Euclidean Jordan cone. A nonzero native element with square `-I`
exhibits a concrete failure of the formally-real sum-of-squares condition.
-/

noncomputable section

namespace InfoGeometry.Algebra.Zorn.QuadraticCayleyDomain

open InfoGeometry.Algebra
open InfoGeometry.Algebra.Zorn.MatrixCayleyDicksonSeparation
open InfoGeometry.Clifford.Cl11Matrix

/-- Conjugation reconstructed from the native quadratic trace polynomial. -/
def quadraticConjugate (X : SplitCarrier) : SplitCarrier :=
  ZornMatrix.zornTrace X • ZornMatrix.I - X

/-- Quadratic inverse readout; a two-sided inverse only when the norm is nonzero. -/
def quadraticInverse (X : SplitCarrier) : SplitCarrier :=
  (ZornMatrix.zornNorm X)⁻¹ • quadraticConjugate X

/-- The right quadratic inverse identity, with its genuine regularity condition. -/
theorem mul_quadraticInverse (X : SplitCarrier) (hX : ZornMatrix.zornNorm X ≠ 0) :
    X * quadraticInverse X = ZornMatrix.I := by
  apply ZornMatrix.ext <;>
    first | (funext i; fin_cases i) | skip
  all_goals
    simp [quadraticInverse, quadraticConjugate, ZornMatrix.zornTrace,
      ZornMatrix.mul, ZornMatrix.smul, ZornMatrix.sub, ZornMatrix.I,
      Vec3.dot, Vec3.cross, Vec3.add, Vec3.sub, Vec3.smul]
  all_goals
    field_simp [hX] <;> simp [ZornMatrix.zornNorm, Vec3.dot] <;> ring

/-- The left inverse identity is established independently; reassociation is not assumed. -/
theorem quadraticInverse_mul (X : SplitCarrier) (hX : ZornMatrix.zornNorm X ≠ 0) :
    quadraticInverse X * X = ZornMatrix.I := by
  apply ZornMatrix.ext <;>
    first | (funext i; fin_cases i) | skip
  all_goals
    simp [quadraticInverse, quadraticConjugate, ZornMatrix.zornTrace,
      ZornMatrix.mul, ZornMatrix.smul, ZornMatrix.sub, ZornMatrix.I,
      Vec3.dot, Vec3.cross, Vec3.add, Vec3.sub, Vec3.smul]
  all_goals
    field_simp [hX] <;> simp [ZornMatrix.zornNorm, Vec3.dot] <;> ring

/-- Regularity of the Cayley denominator in the native composition norm. -/
def CayleyRegular (X : SplitCarrier) : Prop :=
  ZornMatrix.zornNorm (X + ZornMatrix.I) ≠ 0

/-- Native Zorn Cayley readout; no associative matrix inverse is installed. -/
def nativeCayley (X : SplitCarrier) : SplitCarrier :=
  (X - ZornMatrix.I) * quadraticInverse (X + ZornMatrix.I)

/-- Both denominator inverse identities follow from the checked regularity predicate. -/
theorem cayley_denominator_inverse (X : SplitCarrier) (hX : CayleyRegular X) :
    (X + ZornMatrix.I) * quadraticInverse (X + ZornMatrix.I) = ZornMatrix.I ∧
      quadraticInverse (X + ZornMatrix.I) * (X + ZornMatrix.I) = ZornMatrix.I :=
  ⟨mul_quadraticInverse _ hX, quadraticInverse_mul _ hX⟩

/-- Exact quadratic polynomial controlling the Cayley domain. -/
theorem cayley_denominator_norm (X : SplitCarrier) :
    ZornMatrix.zornNorm (X + ZornMatrix.I) =
      ZornMatrix.zornNorm X + ZornMatrix.zornTrace X + 1 := by
  simp [ZornMatrix.zornNorm, ZornMatrix.zornTrace, ZornMatrix.I,
    ZornMatrix.add, Vec3.dot, Vec3.add]
  ring

/-- The native diagonal Peirce plane generated by the two existing idempotents. -/
def diagonal (a b : ℝ) : SplitCarrier :=
  a • ZornMatrix.E11 + b • ZornMatrix.E22

/-- On the diagonal plane, regularity means BOTH scalar denominators are nonzero. -/
theorem diagonal_cayley_regular_iff (a b : ℝ) :
    CayleyRegular (diagonal a b) ↔ a + 1 ≠ 0 ∧ b + 1 ≠ 0 := by
  simp [CayleyRegular, diagonal, ZornMatrix.zornNorm, ZornMatrix.I,
    ZornMatrix.E11, ZornMatrix.E22, ZornMatrix.add, ZornMatrix.smul,
    Vec3.dot, Vec3.add, Vec3.smul, mul_ne_zero_iff]

/-- The native rational map restricts to the two ordinary scalar Cayley maps. -/
theorem nativeCayley_diagonal (a b : ℝ) (ha : a + 1 ≠ 0) (hb : b + 1 ≠ 0) :
    nativeCayley (diagonal a b) =
      diagonal ((a - 1) / (a + 1)) ((b - 1) / (b + 1)) := by
  apply ZornMatrix.ext <;>
    first | (funext i; fin_cases i) | skip
  all_goals
    simp [nativeCayley, quadraticInverse, quadraticConjugate, diagonal,
      ZornMatrix.zornNorm, ZornMatrix.zornTrace, ZornMatrix.I,
      ZornMatrix.E11, ZornMatrix.E22, ZornMatrix.mul, ZornMatrix.add,
      ZornMatrix.sub, ZornMatrix.smul,
      Vec3.dot, Vec3.cross, Vec3.add, Vec3.sub, Vec3.smul]
  all_goals field_simp [ha, hb] <;> ring

/-- A specific nonzero native element has square minus the identity. -/
theorem core_elliptic_negative_square :
    core Eminus ≠ 0 ∧ core Eminus * core Eminus = -ZornMatrix.I := by
  constructor
  · intro h
    have hv : (1 : ℝ) = 0 := by
      simpa [core, Eminus, ZornMatrix.zero] using
        congrArg (fun Z : SplitCarrier => Z.v 0) h
    norm_num at hv
  · rw [← core_mul]
    rw [Eminus_sq]
    rw [neg_one_smul]
    apply add_right_cancel (b := ZornMatrix.I)
    rw [ZornMatrixRealModule.neg_add_cancel]
    all_goals
      apply ZornMatrix.ext <;>
        first | (funext i; fin_cases i) | skip
      all_goals
        simp [core, ZornMatrix.I, ZornMatrix.zero, ZornMatrix.add,
          Vec3.add, Vec3.smul]

/-- An explicit nontrivial sum of squares vanishes. Thus no Euclidean Jordan
positivity follows from merely symmetrizing this split algebra. -/
theorem nontrivial_sum_of_squares_zero :
    core Eminus ≠ 0 ∧
      core Eminus * core Eminus + ZornMatrix.I * ZornMatrix.I = (0 : SplitCarrier) := by
  have hI : ZornMatrix.I * ZornMatrix.I = (ZornMatrix.I : SplitCarrier) := by
    apply ZornMatrix.ext <;>
      first | (funext i; fin_cases i) | skip
    all_goals
      simp [ZornMatrix.I, ZornMatrix.mul, Vec3.dot, Vec3.cross,
        Vec3.add, Vec3.sub, Vec3.smul]
  exact ⟨core_elliptic_negative_square.1, by
    rw [core_elliptic_negative_square.2, hI]
    exact neg_add_cancel _⟩

end InfoGeometry.Algebra.Zorn.QuadraticCayleyDomain
