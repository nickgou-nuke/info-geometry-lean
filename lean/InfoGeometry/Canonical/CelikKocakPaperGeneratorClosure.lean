import InfoGeometry.Canonical.CelikKocakPaperCliffordLift

/-!
# Generator closure for the finite Çelik--Koçak paper family

This owner records the first genuine generation consequences of the paper
operators.  The product of the odd and even generator at one slot is the
local pair term, and induction then places every prefix product in the
subalgebra generated by the paper family.  No matrix-dimension argument is
used here.
-/

noncomputable section

open scoped BigOperators

namespace InfoGeometry.Canonical.CelikKocakPaperFormalism

open InfoGeometry.Canonical.CelikKocakCantorOperators
open FunctionSpace

abbrev paperGeneratorSubalgebra (n : ℕ) :
    Subalgebra ℂ (PaperOperator n) :=
  Algebra.adjoin ℂ (Set.range (paperGamma n))

private lemma paperOdd_mul_even_eq_pairTerm {n j : ℕ} (hj : j < n) :
    paperOddGenerator (n := n) j hj * paperEvenGenerator (n := n) j hj =
      FunctionSpace.pairTerm (n := n) j := by
  let T := FunctionSpace.tilt (n := n) ⟨j, hj⟩
  let U := FunctionSpace.switch (n := n) ⟨j, hj⟩
  let Q := FunctionSpace.pairPrefix (n := n) j
  have hUQ : Commute U Q := by
    exact switch_comm_pairPrefix (n := n) (m := j) (j := j) (Nat.le_refl j) hj
  have hfactor : (T * Q) * (U * Q) = (T * U) * (Q * Q) := by
    simpa [mul_assoc] using hUQ.symm.mul_mul_mul_comm T Q
  have hpair : Q * Q = ((-1 : ℂ) ^ j) •
      (1 : (((Fin n) → Bool) → ℂ) →ₗ[ℂ] (((Fin n) → Bool) → ℂ)) :=
    pairPrefix_sq (n := n) (m := j) (Nat.le_of_lt hj)
  rw [paperOddGenerator, paperEvenGenerator,
    InfoGeometry.Canonical.CelikKocakPaperFormalism.FunctionSpace.pairTerm_of_lt hj]
  change (paperPhase j • (T * Q)) * (paperPhase j • (U * Q)) = T * U
  calc
    (paperPhase j • (T * Q)) * (paperPhase j • (U * Q)) =
        (paperPhase j * paperPhase j) • ((T * Q) * (U * Q)) := by
          simp [T, U, Q, mul_smul]
    _ = ((-1 : ℂ) ^ j) • ((T * U) * (Q * Q)) := by
          rw [paperPhase_sq, hfactor]
    _ = ((-1 : ℂ) ^ j) •
          ((T * U) * (((-1 : ℂ) ^ j) •
            (1 : (((Fin n) → Bool) → ℂ) →ₗ[ℂ] (((Fin n) → Bool) → ℂ)))) := by
          rw [hpair]
    _ = T * U := by
          simp [smul_smul]
          have hs : (-1 : ℂ) ^ j * (-1 : ℂ) ^ j = 1 := by
            rw [← mul_pow]
            simp
          rw [hs]
          simp

theorem paperPairTerm_mem_adjoin {n j : ℕ} (hj : j < n) :
    FunctionSpace.pairTerm (n := n) j ∈ paperGeneratorSubalgebra n := by
  let S := paperGeneratorSubalgebra n
  have ho : paperOddGenerator (n := n) j hj ∈ S := by
    exact Algebra.subset_adjoin ⟨Sum.inl ⟨j, hj⟩, rfl⟩
  have he : paperEvenGenerator (n := n) j hj ∈ S := by
    exact Algebra.subset_adjoin ⟨Sum.inr ⟨j, hj⟩, rfl⟩
  rw [← paperOdd_mul_even_eq_pairTerm hj]
  exact S.mul_mem ho he

theorem paperPairPrefix_mem_adjoin {n m : ℕ} (hm : m ≤ n) :
    FunctionSpace.pairPrefix (n := n) m ∈ paperGeneratorSubalgebra n := by
  induction m with
  | zero =>
      exact (paperGeneratorSubalgebra n).one_mem
  | succ m ih =>
      rw [FunctionSpace.pairPrefix_succ]
      exact (paperGeneratorSubalgebra n).mul_mem (ih (Nat.le_of_succ_le hm))
        (paperPairTerm_mem_adjoin (n := n) (j := m)
          (Nat.lt_of_succ_le hm))

theorem paperTilt_mem_adjoin {n j : ℕ} (hj : j < n) :
    FunctionSpace.tilt (n := n) ⟨j, hj⟩ ∈ paperGeneratorSubalgebra n := by
  let S := paperGeneratorSubalgebra n
  let T := FunctionSpace.tilt (n := n) ⟨j, hj⟩
  let Q := FunctionSpace.pairPrefix (n := n) j
  have hQ : Q ∈ S :=
    paperPairPrefix_mem_adjoin (n := n) (m := j) (Nat.le_of_lt hj)
  have ho : paperOddGenerator (n := n) j hj ∈ S := by
    exact Algebra.subset_adjoin ⟨Sum.inl ⟨j, hj⟩, rfl⟩
  have hprod := S.mul_mem ho hQ
  have hpair : Q * Q = ((-1 : ℂ) ^ j) •
      (1 : (((Fin n) → Bool) → ℂ) →ₗ[ℂ] (((Fin n) → Bool) → ℂ)) :=
    pairPrefix_sq (n := n) (m := j) (Nat.le_of_lt hj)
  have hscaled :
      (paperPhase j * ((-1 : ℂ) ^ j)) • T =
        paperOddGenerator (n := n) j hj * Q := by
    rw [paperOddGenerator]
    change (paperPhase j * ((-1 : ℂ) ^ j)) • T =
      (paperPhase j • (T * Q)) * Q
    calc
      (paperPhase j * ((-1 : ℂ) ^ j)) • T =
          paperPhase j • (((-1 : ℂ) ^ j) • T) := by rw [smul_smul]
      _ = paperPhase j •
          (T * (((-1 : ℂ) ^ j) •
            (1 : (((Fin n) → Bool) → ℂ) →ₗ[ℂ] (((Fin n) → Bool) → ℂ)))) := by
          simp
      _ = (paperPhase j • (T * Q)) * Q := by
          rw [← hpair]
          simp [mul_assoc]
  have hc : paperPhase j * ((-1 : ℂ) ^ j) ≠ 0 := by
    exact mul_ne_zero (pow_ne_zero j Complex.I_ne_zero)
      (pow_ne_zero j (by norm_num))
  have hscaled_mem : (paperPhase j * ((-1 : ℂ) ^ j)) • T ∈ S := by
    rw [hscaled]
    exact hprod
  change T ∈ S
  rw [← inv_smul_smul₀ hc T]
  exact S.smul_mem hscaled_mem _

theorem paperSwitch_mem_adjoin {n j : ℕ} (hj : j < n) :
    FunctionSpace.switch (n := n) ⟨j, hj⟩ ∈ paperGeneratorSubalgebra n := by
  let S := paperGeneratorSubalgebra n
  let U := FunctionSpace.switch (n := n) ⟨j, hj⟩
  let Q := FunctionSpace.pairPrefix (n := n) j
  have hQ : Q ∈ S :=
    paperPairPrefix_mem_adjoin (n := n) (m := j) (Nat.le_of_lt hj)
  have he : paperEvenGenerator (n := n) j hj ∈ S := by
    exact Algebra.subset_adjoin ⟨Sum.inr ⟨j, hj⟩, rfl⟩
  have hprod := S.mul_mem he hQ
  have hpair : Q * Q = ((-1 : ℂ) ^ j) •
      (1 : (((Fin n) → Bool) → ℂ) →ₗ[ℂ] (((Fin n) → Bool) → ℂ)) :=
    pairPrefix_sq (n := n) (m := j) (Nat.le_of_lt hj)
  have hscaled :
      (paperPhase j * ((-1 : ℂ) ^ j)) • U =
        paperEvenGenerator (n := n) j hj * Q := by
    rw [paperEvenGenerator]
    change (paperPhase j * ((-1 : ℂ) ^ j)) • U =
      (paperPhase j • (U * Q)) * Q
    calc
      (paperPhase j * ((-1 : ℂ) ^ j)) • U =
          paperPhase j • (((-1 : ℂ) ^ j) • U) := by rw [smul_smul]
      _ = paperPhase j •
          (U * (((-1 : ℂ) ^ j) •
            (1 : (((Fin n) → Bool) → ℂ) →ₗ[ℂ] (((Fin n) → Bool) → ℂ)))) := by
          simp
      _ = (paperPhase j • (U * Q)) * Q := by
          rw [← hpair]
          simp [mul_assoc]
  have hc : paperPhase j * ((-1 : ℂ) ^ j) ≠ 0 := by
    exact mul_ne_zero (pow_ne_zero j Complex.I_ne_zero)
      (pow_ne_zero j (by norm_num))
  have hscaled_mem : (paperPhase j * ((-1 : ℂ) ^ j)) • U ∈ S := by
    rw [hscaled]
    exact hprod
  change U ∈ S
  rw [← inv_smul_smul₀ hc U]
  exact S.smul_mem hscaled_mem _

end InfoGeometry.Canonical.CelikKocakPaperFormalism
