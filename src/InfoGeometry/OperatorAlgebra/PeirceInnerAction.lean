import InfoGeometry.OperatorAlgebra.PeircePairGeometry
import InfoGeometry.OperatorAlgebra.MatrixSquareZeroPairs

/-!
# Inner action of an idempotent and its directed corners

The native adjoint action reconstructs the directed Peirce corners and obeys
a cubic identity as an endomorphism of the full matrix algebra. Quadratic
vanishing equivalences follow from the already-owned associative Leibniz rule.
No evolution parameter, periodicity, or scalar normalization is introduced.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceInnerAction

open Matrix InfoGeometry.Core.PeirceDecomposition InfoGeometry.Core.IdempotentCartan
open PeirceChiralGeometry MatrixSquareZeroPairs

attribute [local instance 100] LieRing.ofAssociativeRing

variable {n : Type*} [Fintype n] [DecidableEq n]
variable {p : Matrix n n ℂ}

/-- The forward corner is recovered by left multiplication of the native bracket. -/
theorem component10_eq_mul_lie (hp : IsIdempotentElem p) (A : Matrix n n ℂ) :
    component10 p A = p * ⁅p, A⁆ := by
  simp only [component10, complementIdempotent, Ring.lie_def]
  noncomm_ring [hp.eq, idempotent_mul_nested p hp.eq]

/-- The reverse corner is recovered by the opposite right action. -/
theorem component01_eq_neg_lie_mul (hp : IsIdempotentElem p) (A : Matrix n n ℂ) :
    component01 p A = -(⁅p, A⁆ * p) := by
  simp only [component01, complementIdempotent, Ring.lie_def]
  noncomm_ring [hp.eq, idempotent_mul_nested p hp.eq]

/-- The corner difference is a commutator even before imposing idempotence. -/
theorem lie_eq_component_sub (p A : Matrix n n ℂ) :
    ⁅p, A⁆ = component10 p A - component01 p A := by
  simp only [Ring.lie_def, component10, component01, complementIdempotent]
  noncomm_ring

theorem lie_oddPart (hp : IsIdempotentElem p) (A : Matrix n n ℂ) :
    ⁅p, oddPart p A⁆ = ⁅p, A⁆ := by
  rw [oddPart, lie_add, lie_component10 hp, lie_component01 hp,
    lie_eq_component_sub, sub_eq_add_neg]

/-- The third inner action agrees with the first on every matrix. -/
theorem triple_lie (hp : IsIdempotentElem p) (A : Matrix n n ℂ) :
    ⁅p, ⁅p, ⁅p, A⁆⁆⁆ = ⁅p, A⁆ := by
  have h : oddPart p A = ⁅p, ⁅p, A⁆⁆ := odd_eq_double_commutator hp.eq A
  rw [← h, lie_oddPart hp]

/-- The cubic law holds as an equality of native complex-linear endomorphisms. -/
theorem ad_cube (hp : IsIdempotentElem p) :
    (LieAlgebra.ad ℂ (Matrix n n ℂ) p) ^ 3 = LieAlgebra.ad ℂ (Matrix n n ℂ) p := by
  apply LinearMap.ext
  intro A
  change ⁅p, ⁅p, ⁅p, A⁆⁆⁆ = ⁅p, A⁆
  exact triple_lie hp A

/-- Independent opposite inputs also form the reciprocal inner-action pair. -/
theorem lie_pair_add (hp : IsIdempotentElem p) (A B : Matrix n n ℂ) :
    ⁅p, component10 p A + component01 p B⁆ = component10 p A - component01 p B := by
  rw [lie_add, lie_component10 hp, lie_component01 hp, sub_eq_add_neg]

theorem lie_pair_sub (hp : IsIdempotentElem p) (A B : Matrix n n ℂ) :
    ⁅p, component10 p A - component01 p B⁆ = component10 p A + component01 p B := by
  rw [lie_sub, lie_component10 hp, lie_component01 hp, sub_neg_eq_add]

/-- The quadratic corner bracket is generated by the first two native inner actions. -/
theorem pair_lie_eq_lie_mul_double_lie (hp : IsIdempotentElem p) (A : Matrix n n ℂ) :
    ⁅component10 p A, component01 p A⁆ = ⁅p, A⁆ * ⁅p, ⁅p, A⁆⁆ := by
  have h : component10 p A + component01 p A = ⁅p, ⁅p, A⁆⁆ :=
    odd_eq_double_commutator hp.eq A
  rw [← sub_mul_add_eq_lie (corners_square_zero hp.eq A).1
    (corners_square_zero hp.eq A).2, ← lie_eq_component_sub, h]

/-- Under a reciprocal pair of inner actions, product conservation is exactly
the cancellation of the two squares. -/
theorem lie_product_eq_zero_iff_of_two_cycle {H J E : Matrix n n ℂ}
    (hJ : ⁅H, J⁆ = E) (hE : ⁅H, E⁆ = J) :
    ⁅H, J * E⁆ = 0 ↔ E * E + J * J = 0 := by
  rw [MatrixOperatorIdentities.lie_mul, hJ, hE]

/-- Square conservation is exactly anticommutation with the first inner action. -/
theorem lie_square_eq_zero_iff {H E J : Matrix n n ℂ} (hE : ⁅H, E⁆ = J) :
    ⁅H, E * E⁆ = 0 ↔ J * E + E * J = 0 := by
  rw [MatrixOperatorIdentities.lie_mul, hE]

end InfoGeometry.OperatorAlgebra.PeirceInnerAction
