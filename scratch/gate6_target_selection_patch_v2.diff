 # Core Evaluation API
 # -----------------------------------------------------------------------------
 
+TARGET_NAME_FIELDS = ("theorem_name", "target_symbol", "target_declaration", "decl")
+
+
+def _target_names(spec: dict[str, Any]) -> tuple[list[str], list[str]]:
+    """Collect target aliases and reject malformed or conflicting identifiers."""
+    supplied: list[tuple[str, str]] = []
+    errors: list[str] = []
+    for field_name in TARGET_NAME_FIELDS:
+        if field_name not in spec or spec[field_name] is None:
+            continue
+        value = spec[field_name]
+        if not isinstance(value, str) or not value.strip():
+            errors.append(f"{field_name} must be a non-empty declaration-name string")
+            continue
+        supplied.append((field_name, value.strip()))
+
+    distinct = list(dict.fromkeys(value for _, value in supplied))
+    if len(distinct) > 1:
+        errors.append(
+            "conflicting target identifiers: "
+            + ", ".join(f"{field}={value!r}" for field, value in supplied)
+        )
+    return distinct, errors
+
+
+def _select_target_declaration(
+    declarations: list[ParsedDeclaration], spec: dict[str, Any]
+) -> tuple[ParsedDeclaration | None, str | None, str | None]:
+    """Resolve an explicit declaration name; never rely on source order by default."""
+    names, errors = _target_names(spec)
+    if errors:
+        return None, "TARGET_DECLARATION_AMBIGUOUS", "; ".join(errors)
+    if not names:
+        if spec.get("allow_first_declaration") is True:
+            return declarations[0], None, None
+        return (
+            None,
+            "TARGET_DECLARATION_REQUIRED",
+            "No target identifier supplied. Set one of theorem_name, target_symbol, "
+            "target_declaration, or decl; first-declaration selection requires "
+            "allow_first_declaration=true.",
+        )
+
+    target = names[0]
+    exact = [d for d in declarations if d.name == target]
+    if len(exact) == 1:
+        return exact[0], None, None
+    if len(exact) > 1:
+        return None, "TARGET_DECLARATION_AMBIGUOUS", f"Multiple declarations named {target!r}."
+
+    # A short name is allowed only if unique across namespace-qualified names.
+    if "." not in target:
+        short = [d for d in declarations if d.name.rsplit(".", 1)[-1] == target]
+        if len(short) == 1:
+            return short[0], None, None
+        if len(short) > 1:
+            return (
+                None,
+                "TARGET_DECLARATION_AMBIGUOUS",
+                f"Unqualified target {target!r} matches multiple declarations: {[d.name for d in short]}.",
+            )
+
+    return (
+        None,
+        "TARGET_DECLARATION_NOT_FOUND",
+        f"Target declaration {target!r} was not found among parsed declarations: {[d.name for d in declarations]}.",
+    )
