import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Bridge.QuaternionicPauliDiracSoldering

/-! The finite algebraic sphere of complex structures generated by the
existing quaternionic matrix triple.  No bundle or holonomy claim is made. -/

noncomputable section
namespace InfoGeometry.Bridge.QuaternionicTwistorSphere

open InfoGeometry.Canonical.BiQuaternionKahlerFinite
open InfoGeometry.Bridge.QuaternionicPauliDiracSoldering

def twistorMatrix (a b c : ℝ) : Mat4 := a • I4c + b • J4c + c • K4c

theorem twistorMatrix_sq (a b c : ℝ) :
    twistorMatrix a b c * twistorMatrix a b c =
      (-(a ^ 2 + b ^ 2 + c ^ 2)) • (1 : Mat4) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [twistorMatrix, I4c, J4c, K4c, Matrix.mul_apply,
      Fin.sum_univ_four] <;> ring

def twistorAxis (a b c : ℝ) :
    Module.End ℝ QuaternionicOperators.Carrier :=
  (twistorMatrix a b c).mulVecLin

theorem twistorAxis_sq (a b c : ℝ) :
    (twistorAxis a b c).comp (twistorAxis a b c) =
      (-(a ^ 2 + b ^ 2 + c ^ 2)) •
        (LinearMap.id : Module.End ℝ QuaternionicOperators.Carrier) := by
  apply LinearMap.ext
  intro x
  change (twistorMatrix a b c).mulVec ((twistorMatrix a b c).mulVec x) = _
  rw [Matrix.mulVec_mulVec, twistorMatrix_sq]
  ext i
  simp [LinearMap.smul_apply, Matrix.mulVec, Fin.sum_univ_four,
    Matrix.one_apply, dotProduct, Finset.sum_ite_eq']

def OnTwistorSphere (a b c : ℝ) : Prop := a ^ 2 + b ^ 2 + c ^ 2 = 1

theorem twistorAxis_isComplexStructure {a b c : ℝ}
    (h : OnTwistorSphere a b c) :
    (twistorAxis a b c).comp (twistorAxis a b c) =
      -(LinearMap.id : Module.End ℝ QuaternionicOperators.Carrier) := by
  rw [twistorAxis_sq, h]
  ext i
  simp [LinearMap.smul_apply, Matrix.mulVec, Fin.sum_univ_four,
    Matrix.one_apply, dotProduct, Finset.sum_ite_eq']

end InfoGeometry.Bridge.QuaternionicTwistorSphere
