{"type":"new","contents":"import InfoGeometry.Canonical.MoorePenrose\nimport InfoGeometry.Canonical.Drazin\nimport InfoGeometry.Canonical.GrandCanonicalExperts\nimport Mathlib.Algebra.Star.Basic\n\nnamespace InfoGeometry.Canonical.ChiralAnomaly\n\nopen InfoGeometry.Canonical.MoorePenrose\nopen InfoGeometry.Canonical.Drazin\nopen InfoGeometry.Canonical.MoE\n\nsection InverseLayer\n\nvariable {R : Type*} [SeminormedRing R]\n\n/--\nThe Chiral Anomaly Operator (χ).\nDefined as the commutator between the geometric (Penrose) inverse \nand the spectral (Drazin) inverse.\nχ = [a⁺, aᴰ].\n-/\ndef inverseCommutator (_a : R) (a_mp a_d : R) : R :=\n  a_mp * a_d - a_d * a_mp\n\n/--\nThe Chiral Scale ε.\nGenerated by the divergence between geometry and spectrum.\nε = || [a⁺, aᴰ] ||.\n-/\nnoncomputable def epsilon (a a_mp a_d : R) : ℝ :=\n  nnnorm (inverseCommutator a a_mp a_d)\n\n/--\nTheorem: If an information operator is normal, its Chiral Anomaly \n(in the inverse sense) vanishes for index 1.\nThis provides the inverse-level bridge to the projector-level proof.\n-/\ntheorem normal_inverse_anomaly_vanishes (_a a_mp a_d : R)\n    (h_comm : a_mp * a_d = a_d * a_mp) :\n    inverseCommutator _a a_mp a_d = 0 := by\n  simpa [inverseCommutator, sub_eq_zero] using h_comm\n\nend InverseLayer\n\nsection RoutingClifford\n\nopen scoped BigOperators\n\n/-- Routing chiral anomaly from the split `Cl(1,1)` mode masses. -/\nnoncomputable def routingChiralAnomaly {n : Nat}\n    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) : ℝ :=\n  plusMass w label - minusMass w label\n\n/-- Emergent routing chiral scale `ε` from the split mass imbalance. -/\nnoncomputable def routingEpsilon {n : Nat}\n    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) : ℝ :=\n  |routingChiralAnomaly w label|\n\n/-- Lemma `routingChiralAnomaly_eq_semantic_coord_gap`. -/\nlemma routingChiralAnomaly_eq_semantic_coord_gap {n : Nat}\n    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) :\n    routingChiralAnomaly w label\n      = (cliffordSemanticState w label).1 - (cliffordSemanticState w label).2 := by\n  unfold routingChiralAnomaly\n  rw [cliffordSemanticState_fst_eq_plusMass, cliffordSemanticState_snd_eq_minusMass]\n\n/-- Lemma `routingEpsilon_nonneg`. -/\nlemma routingEpsilon_nonneg {n : Nat}\n    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) :\n    0 ≤ routingEpsilon w label := by\n  unfold routingEpsilon\n  exact abs_nonneg _\n\n/-- Lemma `routingEpsilon_le_one_of_simplex`. -/\nlemma routingEpsilon_le_one_of_simplex {n : Nat}\n    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel)\n    (hw_nonneg : ∀ σ, 0 ≤ w σ)\n    (hw_sum : ∑ σ, w σ = 1) :\n    routingEpsilon w label ≤ 1 := by\n  have hp : 0 ≤ plusMass w label := plusMass_nonneg hw_nonneg\n  have hq : 0 ≤ minusMass w label := minusMass_nonneg hw_nonneg\n  have hsum_pm : plusMass w label + minusMass w label = 1 := by\n    rw [plusMass_add_minusMass_eq_sum, hw_sum]\n  have htri :\n      |plusMass w label - minusMass w label|\n        ≤ |plusMass w label| + |minusMass w label| := by\n    simpa [sub_eq_add_neg, abs_neg] using\n      (abs_add_le (plusMass w label) (-(minusMass w label)))\n  unfold routingEpsilon routingChiralAnomaly\n  calc\n    |plusMass w label - minusMass w label|\n        ≤ |plusMass w label| + |minusMass w label| := htri\n    _ = plusMass w label + minusMass w label := by\n          simp [abs_of_nonneg hp, abs_of_nonneg hq]\n    _ = 1 := hsum_pm\n\n/-- Lemma `routingEpsilon_eq_semantic_gap_abs`. -/\nlemma routingEpsilon_eq_semantic_gap_abs {n : Nat}\n    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) :\n    routingEpsilon w label\n      = |(cliffordSemanticState w label).1 - (cliffordSemanticState w label).2| := by\n  unfold routingEpsilon\n  rw [routingChiralAnomaly_eq_semantic_coord_gap]\n\nsection FromBistochastic\n\nvariable {V : Type*} [NormedAddCommGroup V]\nvariable (n : Nat) [Nonempty (Fin n)]\n\n/--\nFor a bistochastic router, the Birkhoff decomposition admits a canonical\nsplit-`Cl(1,1)` chiral scale `ε` bounded by `1`.\n-/\ntheorem exists_routingEpsilon_of_bistochastic\n    (β : ℝ) (x : Fin n → V) (hcol : IsBistochasticSwitch n β x)\n    (label : PermMode n → CliffordLabel) :\n    ∃ w : PermMode n → ℝ,\n      (∀ σ, 0 ≤ w σ) ∧\n      ∑ σ, w σ = 1 ∧\n      ∑ σ, w σ • σ.permMatrix ℝ = switchMatrix n β x ∧\n      routingEpsilon w label ≤ 1 := by\n  rcases exists_perm_decomposition_of_bistochastic (n := n) β x hcol with\n    ⟨w, hw_nonneg, hw_sum, hw_matrix⟩\n  refine ⟨w, hw_nonneg, hw_sum, hw_matrix, ?_⟩\n  exact routingEpsilon_le_one_of_simplex w label hw_nonneg hw_sum\n\nend FromBistochastic\n\nsection SinkhornDynamics\n\nvariable (n : Nat)\n\n/--\nFor any doubly-stochastic coupling matrix, there is a Birkhoff mode decomposition\nwith routing chiral scale bounded by `1`.\n-/\ntheorem exists_routingEpsilon_of_mem_doublyStochastic\n    (M : SinkhornMatrix n)\n    (hM : M ∈ doublyStochastic ℝ (Fin n))\n    (label : PermMode n → CliffordLabel) :\n    ∃ w : PermMode n → ℝ,\n      (∀ σ, 0 ≤ w σ) ∧\n      ∑ σ, w σ = 1 ∧\n      ∑ σ, w σ • σ.permMatrix ℝ = M ∧\n      routingEpsilon w label ≤ 1 := by\n  rcases exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM with\n    ⟨w, hw_nonneg, hw_sum, hw_matrix⟩\n  refine ⟨w, hw_nonneg, hw_sum, hw_matrix, ?_⟩\n  exact routingEpsilon_le_one_of_simplex w label hw_nonneg hw_sum\n\n/--\nChosen Birkhoff decomposition weights for a doubly-stochastic matrix.\n-/\nnoncomputable def sinkhornPermutationWeights\n    (M : SinkhornMatrix n)\n    (hM : M ∈ doublyStochastic ℝ (Fin n)) : PermMode n → ℝ :=\n  Classical.choose (exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM)\n\n/-- Lemma `sinkhornPermutationWeights_nonneg`. -/\nlemma sinkhornPermutationWeights_nonneg\n    (M : SinkhornMatrix n)\n    (hM : M ∈ doublyStochastic ℝ (Fin n)) :\n    ∀ σ, 0 ≤ sinkhornPermutationWeights n M hM σ := by\n  classical\n  exact (Classical.choose_spec (exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM)).1\n\n/-- Lemma `sinkhornPermutationWeights_sum_one`. -/\nlemma sinkhornPermutationWeights_sum_one\n    (M : SinkhornMatrix n)\n    (hM : M ∈ doublyStochastic ℝ (Fin n)) :\n    ∑ σ, sinkhornPermutationWeights n M hM σ = 1 := by\n  classical\n  exact (Classical.choose_spec (exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM)).2.1\n\n/-- Lemma `sinkhornPermutationWeights_decomposition`. -/\nlemma sinkhornPermutationWeights_decomposition\n    (M : SinkhornMatrix n)\n    (hM : M ∈ doublyStochastic ℝ (Fin n)) :\n    ∑ σ, sinkhornPermutationWeights n M hM σ • σ.permMatrix ℝ = M := by\n  classical\n  exact (Classical.choose_spec (exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM)).2.2\n\n/--\nSelected routing chiral scale `ε` for a doubly-stochastic matrix\nusing the chosen Birkhoff coefficients.\n-/\nnoncomputable def selectedRoutingEpsilon\n    (M : SinkhornMatrix n)\n    (hM : M ∈ doublyStochastic ℝ (Fin n))\n    (label : PermMode n → CliffordLabel) : ℝ :=\n  routingEpsilon (sinkhornPermutationWeights n M hM) label\n\n/-- Lemma `selectedRoutingEpsilon_le_one`. -/\nlemma selectedRoutingEpsilon_le_one\n    (M : SinkhornMatrix n)\n    (hM : M ∈ doublyStochastic ℝ (Fin n))\n    (label : PermMode n → CliffordLabel) :\n    selectedRoutingEpsilon n M hM label ≤ 1 := by\n  unfold selectedRoutingEpsilon\n  exact routingEpsilon_le_one_of_simplex\n    (sinkhornPermutationWeights n M hM) label\n    (sinkhornPermutationWeights_nonneg (n := n) M hM)\n    (sinkhornPermutationWeights_sum_one (n := n) M hM)\n\n/--\nSinkhorn trajectory constrained to remain in the Birkhoff polytope at every step.\n-/\nstructure DoublyStochasticSinkhornTrajectory where\n  traj : SinkhornTrajectory n\n  mem_doublyStochastic : ∀ k : Nat, traj.state k ∈ doublyStochastic ℝ (Fin n)\n\n/--\nPer-iteration selected routing chiral scale along a doubly-stochastic Sinkhorn trajectory.\n-/\nnoncomputable def trajectorySelectedRoutingEpsilon\n    (T : DoublyStochasticSinkhornTrajectory n) (k : Nat)\n    (label : PermMode n → CliffordLabel) : ℝ :=\n  selectedRoutingEpsilon n (T.traj.state k) (T.mem_doublyStochastic k) label\n\n/-- Lemma `trajectorySelectedRoutingEpsilon_le_one`. -/\nlemma trajectorySelectedRoutingEpsilon_le_one\n    (T : DoublyStochasticSinkhornTrajectory n) (k : Nat)\n    (label : PermMode n → CliffordLabel) :\n    trajectorySelectedRoutingEpsilon n T k label ≤ 1 := by\n  unfold trajectorySelectedRoutingEpsilon\n  exact selectedRoutingEpsilon_le_one (n := n) (M := T.traj.state k)\n    (hM := T.mem_doublyStochastic k) label\n\n/--\nCombined Sinkhorn dynamic control:\n- phase Lyapunov is monotone across the step;\n- the selected routing chiral scale on the next iterate is bounded by `1`.\n-/\ntheorem sinkhorn_dynamics_step_control\n    (T : DoublyStochasticSinkhornTrajectory n) (k : Nat)\n    (label : PermMode n → CliffordLabel) :\n    trajectoryLyapunovNext n T.traj k ≤ trajectoryLyapunov n T.traj k ∧\n      trajectorySelectedRoutingEpsilon n T (k + 1) label ≤ 1 := by\n  refine ⟨trajectoryLyapunov_monotone (n := n) T.traj k, ?_⟩\n  exact trajectorySelectedRoutingEpsilon_le_one (n := n) T (k + 1) label\n\n/--\nGenerator-level Sinkhorn dynamic control:\n- phase Radon-Nikodym log-barrier is monotone across the step;\n- the selected routing chiral scale on the next iterate is bounded by `1`.\n-/\ntheorem sinkhorn_dynamics_generator_step_control\n    (T : DoublyStochasticSinkhornTrajectory n) (k : Nat)\n    (label : PermMode n → CliffordLabel) :\n    trajectoryRNBarrierNext n T.traj k ≤ trajectoryRNBarrier n T.traj k ∧\n      trajectorySelectedRoutingEpsilon n T (k + 1) label ≤ 1 := by\n  refine ⟨trajectoryRNBarrier_monotone (n := n) T.traj k, ?_⟩\n  exact trajectorySelectedRoutingEpsilon_le_one (n := n) T (k + 1) label\n\n/--\nConstructive alternating Sinkhorn iterate from explicit positivity hypotheses.\n-/\nnoncomputable def sinkhornIterate\n    (M0 : SinkhornMatrix n)\n    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)\n    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M) :\n    Nat → SinkhornMatrix n\n  | 0 => M0\n  | k + 1 =>\n      let Mk := sinkhornIterate M0 hrow hcol k\n      match phaseAt k with\n      | .row => rowNormalize n Mk (hrow Mk)\n      | .col => colNormalize n Mk (hcol Mk)\n\n/-- Lemma `sinkhornIterate_step`. -/\nlemma sinkhornIterate_step\n    (M0 : SinkhornMatrix n)\n    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)\n    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M)\n    (k : Nat) :\n    SinkhornStep n (phaseAt k)\n      (sinkhornIterate (n := n) M0 hrow hcol k)\n      (sinkhornIterate (n := n) M0 hrow hcol (k + 1)) := by\n  let Mk := sinkhornIterate (n := n) M0 hrow hcol k\n  cases hphase : phaseAt k with\n  | row =>\n      refine ⟨hrow Mk, ?_⟩\n      simp [sinkhornIterate, hphase]\n  | col =>\n      refine ⟨hcol Mk, ?_⟩\n      simp [sinkhornIterate, hphase]\n\n/-- Generated Sinkhorn trajectory from the recursive iterate map. -/\nnoncomputable def sinkhornIterateTrajectory\n    (M0 : SinkhornMatrix n)\n    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)\n    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M) :\n    SinkhornTrajectory n where\n  state := sinkhornIterate (n := n) M0 hrow hcol\n  step := sinkhornIterate_step (n := n) M0 hrow hcol\n\n/--\nGenerated doubly-stochastic Sinkhorn trajectory from explicit balancing hypothesis\nalong the recursive iterate sequence.\n-/\nnoncomputable def sinkhornIterateDoublyStochasticTrajectory\n    (M0 : SinkhornMatrix n)\n    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)\n    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M)\n    (hbal : ∀ k : Nat,\n      sinkhornIterate (n := n) M0 hrow hcol k ∈ doublyStochastic ℝ (Fin n)) :\n    DoublyStochasticSinkhornTrajectory n where\n  traj := sinkhornIterateTrajectory (n := n) M0 hrow hcol\n  mem_doublyStochastic := hbal\n\n/--\nStepwise control theorem for the constructive iterate generator:\nLyapunov monotonicity and next-step routing chiral bound `ε ≤ 1`.\n-/\ntheorem sinkhornIterate_step_control\n    (M0 : SinkhornMatrix n)\n    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)\n    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M)\n    (hbal : ∀ k : Nat,\n      sinkhornIterate (n := n) M0 hrow hcol k ∈ doublyStochastic ℝ (Fin n))\n    (k : Nat) (label : PermMode n → CliffordLabel) :\n    trajectoryLyapunovNext n (sinkhornIterateTrajectory (n := n) M0 hrow hcol) k\n      ≤ trajectoryLyapunov n (sinkhornIterateTrajectory (n := n) M0 hrow hcol) k ∧\n      trajectorySelectedRoutingEpsilon n\n        (sinkhornIterateDoublyStochasticTrajectory (n := n) M0 hrow hcol hbal)\n        (k + 1) label ≤ 1 := by\n  simpa [sinkhornIterateDoublyStochasticTrajectory, sinkhornIterateTrajectory] using\n    (sinkhorn_dynamics_step_control (n := n)\n      (T := sinkhornIterateDoublyStochasticTrajectory (n := n) M0 hrow hcol hbal)\n      (k := k) (label := label))\n\n/--\nGenerator-level control theorem for the constructive iterate:\nRN-barrier monotonicity plus next-step routing chiral bound `ε ≤ 1`.\n-/\ntheorem sinkhornIterate_generator_step_control\n    (M0 : SinkhornMatrix n)\n    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)\n    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M)\n    (hbal : ∀ k : Nat,\n      sinkhornIterate (n := n) M0 hrow hcol k ∈ doublyStochastic ℝ (Fin n))\n    (k : Nat) (label : PermMode n → CliffordLabel) :\n    trajectoryRNBarrierNext n (sinkhornIterateTrajectory (n := n) M0 hrow hcol) k\n      ≤ trajectoryRNBarrier n (sinkhornIterateTrajectory (n := n) M0 hrow hcol) k ∧\n      trajectorySelectedRoutingEpsilon n\n        (sinkhornIterateDoublyStochasticTrajectory (n := n) M0 hrow hcol hbal)\n        (k + 1) label ≤ 1 := by\n  simpa [sinkhornIterateDoublyStochasticTrajectory, sinkhornIterateTrajectory] using\n    (sinkhorn_dynamics_generator_step_control (n := n)\n      (T := sinkhornIterateDoublyStochasticTrajectory (n := n) M0 hrow hcol hbal)\n      (k := k) (label := label))\n\nend SinkhornDynamics\nend RoutingClifford\n\nend InfoGeometry.Canonical.ChiralAnomaly\n","mtime":1777199300138}