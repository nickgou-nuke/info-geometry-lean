import Mathlib.Tactic
import Mathlib.Analysis.SpecialFunctions.Complex.Arg
import Mathlib.Analysis.SpecialFunctions.Log.Deriv
import Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus
import InfoGeometry.Canonical.CayleyCriticalLineCircleBridge

/-!
# Apollonius logarithmic coordinates

This file defines the logarithmic coordinates generated by the Cayley ratio
`q(s) = s / (1 - s)` on the twice-punctured complex plane.  It proves the
critical-line zero locus, the non-vanishing normal derivative, the exact
source--sink inversion, the branch-aware conjugation symmetry of the principal
argument, and a finite metric tail toward infinity.

The angle theorem explicitly excludes the negative-real branch cut.  No global
single-valued logarithm or argument is asserted on the punctured plane.
-/

noncomputable section

open MeasureTheory
open scoped Interval

namespace InfoGeometry.Apollonius

open InfoGeometry.Canonical.CayleyCriticalLineCircleBridge

/-- The twice-punctured complex plane `ℂ \ {0, 1}`. -/
def PuncturedPlane := {s : ℂ // s ≠ 0 ∧ s ≠ 1}

/-- Cayley/cross-ratio coordinate `q(s) = s / (1 - s)`. -/
def crossRatio (s : PuncturedPlane) : ℂ :=
  cayleyToFugacity s.1

theorem crossRatio_ne_zero (s : PuncturedPlane) :
    crossRatio s ≠ 0 := by
  unfold crossRatio cayleyToFugacity
  exact div_ne_zero s.property.1 (sub_ne_zero.mpr (Ne.symm s.property.2))

/-- Longitudinal logarithmic coordinate `η = log |q|`. -/
def eta (s : PuncturedPlane) : ℝ :=
  Real.log ‖crossRatio s‖

/-- Principal transverse angle `θ = arg q`. -/
def theta (s : PuncturedPlane) : ℝ :=
  Complex.arg (crossRatio s)

/-- Principal-coordinate representative `η + i θ`. -/
def complexPotential (s : PuncturedPlane) : ℂ :=
  (eta s : ℂ) + Complex.I * (theta s : ℂ)

/-! The logarithmic coordinate is an actual logarithm of the Cayley carrier,
not merely a pair of scalar readouts. -/

theorem exp_complexPotential (s : PuncturedPlane) :
    Complex.exp (complexPotential s) = crossRatio s := by
  rw [complexPotential]
  change Complex.exp
      ((Real.log ‖crossRatio s‖ : ℝ) + Complex.I * Complex.arg (crossRatio s)) =
    crossRatio s
  have hlog :
      (Real.log ‖crossRatio s‖ : ℂ) + Complex.I * Complex.arg (crossRatio s) =
        Complex.log (crossRatio s) := by
    rw [Complex.log]
    ring
  rw [hlog, Complex.exp_log (crossRatio_ne_zero s)]

/-- The critical line is exactly the zero locus of the logarithmic radius. -/
theorem eta_zero_iff_re_eq_half (s : PuncturedPlane) :
    eta s = 0 ↔ s.1.re = 1 / 2 := by
  have hq : crossRatio s ≠ 0 := crossRatio_ne_zero s
  have hqpos : 0 < ‖crossRatio s‖ := norm_pos_iff.mpr hq
  constructor
  · intro heta
    have habs : ‖crossRatio s‖ = 1 :=
      Real.eq_one_of_pos_of_log_eq_zero hqpos heta
    have hnormSq : Complex.normSq (crossRatio s) = 1 := by
      rw [← Complex.sq_norm, habs]
      norm_num
    exact (criticalLine_iff_cayley_unitCircle s.1).mpr hnormSq
  · intro hcrit
    have hnormSq : Complex.normSq (crossRatio s) = 1 :=
      (criticalLine_iff_cayley_unitCircle s.1).mp hcrit
    have hsquare : ‖crossRatio s‖ ^ 2 = 1 := by
      rw [Complex.sq_norm]
      exact hnormSq
    have habs : ‖crossRatio s‖ = 1 := by
      nlinarith [norm_nonneg (crossRatio s)]
    simp [eta, habs]

/-- The inverse Cayley coordinate is on the unit-circle locus exactly when
    the original coordinate is on the critical line.  The excluded value
    `z = -1` is the pole of the inverse chart. -/
theorem cayley_inverse_unitCircle_iff_criticalLine
    (s : PuncturedPlane) :
    OnLeeYangCircle (crossRatio s) ↔
      OnCriticalLine s.1 := by
  exact criticalLine_iff_cayley_unitCircle s.1 |>.symm

/-- The inverse chart recovers every Apollonius point from its Cayley
    coordinate.  The denominator is nonzero because `s ≠ 1`. -/
theorem inverse_cayley_coordinate (s : PuncturedPlane) :
    cayleyToTemperature (crossRatio s) = s.1 := by
  apply cayleyToTemperature_cayleyToFugacity
  exact sub_ne_zero.mpr (Ne.symm s.property.2)

/-- A Cartesian representative of `η`, written as a difference of logarithms
of squared distances. -/
def etaCartesian (x y : ℝ) : ℝ :=
  (1 / 2 : ℝ) *
    (Real.log (x ^ 2 + y ^ 2) -
      Real.log ((x - 1) ^ 2 + y ^ 2))

/-- The normal derivative on the critical line is
`∂ₓη(1/2,y) = 1 / (1/4 + y²)`. -/
theorem deriv_x_eta_at_half (y : ℝ) :
    HasDerivAt (fun x => etaCartesian x y)
      (1 / ((1 / 4 : ℝ) + y ^ 2)) (1 / 2) := by
  have hpos : 0 < (1 / 4 : ℝ) + y ^ 2 := by positivity
  have hnum :
      HasDerivAt (fun x : ℝ => x ^ 2 + y ^ 2) 1 (1 / 2) := by
    convert (((hasDerivAt_id (1 / 2 : ℝ)).pow 2).add_const (y ^ 2)) using 1 <;>
      norm_num
  have hden :
      HasDerivAt (fun x : ℝ => (x - 1) ^ 2 + y ^ 2) (-1) (1 / 2) := by
    convert ((((hasDerivAt_id (1 / 2 : ℝ)).sub_const 1).pow 2).add_const (y ^ 2))
      using 1 <;> norm_num
  have hlogNum :
      HasDerivAt (fun x : ℝ => Real.log (x ^ 2 + y ^ 2))
        (1 / ((1 / 4 : ℝ) + y ^ 2)) (1 / 2) := by
    convert hnum.log (by positivity) using 1 <;> norm_num
  have hlogDen :
      HasDerivAt (fun x : ℝ => Real.log ((x - 1) ^ 2 + y ^ 2))
        (-1 / ((1 / 4 : ℝ) + y ^ 2)) (1 / 2) := by
    convert hden.log (by positivity) using 1 <;> norm_num
  convert (hlogNum.sub hlogDen).const_mul (1 / 2 : ℝ) using 1 <;>
    simp <;>
    field_simp [ne_of_gt hpos] <;>
    ring

theorem normal_force_nonzero (y : ℝ) :
    (1 / ((1 / 4 : ℝ) + y ^ 2)) ≠ 0 := by
  exact one_div_ne_zero (ne_of_gt (by positivity : 0 < (1 / 4 : ℝ) + y ^ 2))

/-- Conjugating the input conjugates the Cayley ratio. -/
theorem crossRatio_conj
    (s : PuncturedPlane)
    (hs : (starRingEnd ℂ) s.1 ≠ 0 ∧
      (starRingEnd ℂ) s.1 ≠ 1) :
    crossRatio ⟨(starRingEnd ℂ) s.1, hs⟩ =
      (starRingEnd ℂ) (crossRatio s) := by
  unfold crossRatio cayleyToFugacity
  simp

/-- Real-axis reflection leaves `η` invariant. -/
theorem symmetry_real_reflection_eta
    (s : PuncturedPlane)
    (hs : (starRingEnd ℂ) s.1 ≠ 0 ∧
      (starRingEnd ℂ) s.1 ≠ 1) :
    eta ⟨(starRingEnd ℂ) s.1, hs⟩ = eta s := by
  rw [eta, crossRatio_conj s hs]
  simp [eta]

/-- Away from the principal branch cut, real-axis reflection negates `θ`. -/
theorem symmetry_real_reflection_theta
    (s : PuncturedPlane)
    (hs : (starRingEnd ℂ) s.1 ≠ 0 ∧
      (starRingEnd ℂ) s.1 ≠ 1)
    (hcut : (crossRatio s).im ≠ 0 ∨ 0 < (crossRatio s).re) :
    theta ⟨(starRingEnd ℂ) s.1, hs⟩ = -theta s := by
  rw [theta, crossRatio_conj s hs, Complex.arg_conj]
  by_cases hpi : Complex.arg (crossRatio s) = Real.pi
  · exfalso
    have hneg := Complex.arg_eq_pi_iff.mp hpi
    rcases hcut with him | hre
    · exact him hneg.2
    · linarith [hneg.1]
  · simp [hpi, theta]

/-- Source--sink exchange sends the Cayley ratio to its inverse. -/
theorem chiral_inversion
    (s : PuncturedPlane)
    (hs : 1 - s.1 ≠ 0 ∧ 1 - s.1 ≠ 1) :
    crossRatio ⟨1 - s.1, hs⟩ = (crossRatio s)⁻¹ := by
  exact cayleyToFugacity_one_sub_eq_inv s.1

/-- Critical reflection reverses `η`. -/
theorem symmetry_critical_reflection
    (s : PuncturedPlane)
    (hs : 1 - (starRingEnd ℂ) s.1 ≠ 0 ∧
      1 - (starRingEnd ℂ) s.1 ≠ 1) :
    eta ⟨1 - (starRingEnd ℂ) s.1, hs⟩ = -eta s := by
  have hsconj :
      (starRingEnd ℂ) s.1 ≠ 0 ∧
        (starRingEnd ℂ) s.1 ≠ 1 := by
    constructor
    · intro h
      apply s.property.1
      have := congrArg (starRingEnd ℂ) h
      simpa using this
    · intro h
      apply s.property.2
      have := congrArg (starRingEnd ℂ) h
      simpa using this
  rw [eta, chiral_inversion ⟨(starRingEnd ℂ) s.1, hsconj⟩ hs]
  rw [norm_inv, Real.log_inv]
  simp [eta, crossRatio_conj s hsconj]

/-- The pullback line element has finite length from `2` to arbitrarily
large real `R`; in particular infinity is at finite metric distance. -/
theorem metric_finite_distance_to_infinity :
    ∃ C : ℝ, ∀ R : ℝ, 2 ≤ R →
      (∫ t in (2 : ℝ)..R, 1 / (t * (t - 1))) ≤ C := by
  refine ⟨1, ?_⟩
  intro R hR
  let F : ℝ → ℝ := fun t => Real.log (t - 1) - Real.log t
  have hderiv :
      ∀ t ∈ Set.uIcc (2 : ℝ) R,
        HasDerivAt F (1 / (t * (t - 1))) t := by
    intro t ht
    have ht2 : 2 ≤ t := by
      rw [Set.uIcc_of_le hR] at ht
      exact ht.1
    have ht0 : t ≠ 0 := by linarith
    have ht10 : t - 1 ≠ 0 := by linarith
    have h :=
      (((hasDerivAt_id t).sub_const 1).log ht10).sub
        ((hasDerivAt_id t).log ht0)
    convert h using 1 <;>
      dsimp [F] <;>
      field_simp [ht0, ht10] <;>
      ring
  have hint :
      IntervalIntegrable (fun t : ℝ => 1 / (t * (t - 1)))
        volume 2 R := by
    apply ContinuousOn.intervalIntegrable
    intro t ht
    have ht2 : 2 ≤ t := by
      rw [Set.uIcc_of_le hR] at ht
      exact ht.1
    have ht0 : t ≠ 0 := by linarith
    have ht10 : t - 1 ≠ 0 := by linarith
    apply ContinuousAt.continuousWithinAt
    apply ContinuousAt.div₀
    · fun_prop
    · fun_prop
    · exact mul_ne_zero ht0 ht10
  have hftc :
      (∫ t in (2 : ℝ)..R, 1 / (t * (t - 1))) = F R - F 2 :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint
  rw [hftc]
  have hlogR : Real.log (R - 1) ≤ Real.log R := by
    exact Real.log_le_log (by linarith) (by linarith)
  have hlogTwo : Real.log 2 ≤ 1 := by
    have := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 2 by norm_num)
    norm_num at this ⊢
    exact this
  dsimp [F]
  norm_num
  linarith

end InfoGeometry.Apollonius
