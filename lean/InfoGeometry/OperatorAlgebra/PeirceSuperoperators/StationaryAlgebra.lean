import InfoGeometry.OperatorAlgebra.PeirceSuperoperators.Crossover
import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-!
# Stationary generated subalgebras for paired inner actions

The common centralizer is annihilated by the double inner action and by any
scalar multiple of the Gram inner action added to it. Square-zero coefficients
place the algebra generated by their symmetric product in this centralizer.
The mixed Lie–Jordan action has a different, generally nonzero, readout there.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSuperoperators

open InfoGeometry.Core.JordanMultiplicationClosure

attribute [local instance] LieRing.ofAssociativeRing

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

local notation "D" => LieAlgebra.ad R A
local notation "J" => jordanLeft (R := R)

/-- Every scalar commutator perturbation annihilates the actual common centralizer. -/
theorem commutator_perturbation_eq_zero_of_mem_centralizer
    (c : R) (u v X : A) (hX : X ∈ Subalgebra.centralizer R ({u, v} : Set A)) :
    (c • D (u * v + v * u) - (D u * D v + D v * D u)) X = 0 := by
  have hpair : Commute u X ∧ Commute v X := by
    simpa only [Subalgebra.mem_centralizer_iff, Set.forall_mem_insert,
      Set.forall_mem_singleton] using hX
  have hH : Commute (u * v + v * u) X :=
    (hpair.1.mul_left hpair.2).add_left (hpair.2.mul_left hpair.1)
  have hu : D u X = 0 := sub_eq_zero.mpr hpair.1.eq
  have hv : D v X = 0 := sub_eq_zero.mpr hpair.2.eq
  have hh : D (u * v + v * u) X = 0 := sub_eq_zero.mpr hH.eq
  change c • D (u * v + v * u) X - (D u (D v X) + D v (D u X)) = 0
  rw [hu, hv, hh, smul_zero, map_zero, map_zero, add_zero, sub_self]

/-- The unit belongs to the stationary common centralizer for arbitrary coefficients. -/
theorem commutator_perturbation_one (c : R) (u v : A) :
    (c • D (u * v + v * u) - (D u * D v + D v * D u)) 1 = 0 := by
  apply commutator_perturbation_eq_zero_of_mem_centralizer
  exact (Subalgebra.centralizer R ({u, v} : Set A)).one_mem

/-- Square-zero charges put the algebra generated by their symmetric product in their centralizer. -/
theorem square_zero_pair_adjoin_le_centralizer {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    Algebra.adjoin R ({u * v + v * u} : Set A) ≤
      Subalgebra.centralizer R ({u, v} : Set A) := by
  apply Algebra.adjoin_le
  intro X hX
  rw [Set.mem_singleton_iff] at hX
  subst X
  simp only [Subalgebra.mem_centralizer_iff, Set.forall_mem_insert,
    Set.forall_mem_singleton]
  constructor
  · noncomm_ring [hu]
  · noncomm_ring [hv]

/-- The generated algebra is a native submodule of stationary vectors. -/
theorem square_zero_pair_adjoin_le_ker (c : R) {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) :
    (Algebra.adjoin R ({u * v + v * u} : Set A)).toSubmodule ≤
      (c • D (u * v + v * u) - (D u * D v + D v * D u)).ker := by
  intro X hX
  apply LinearMap.mem_ker.mpr
  exact commutator_perturbation_eq_zero_of_mem_centralizer c u v X
    (square_zero_pair_adjoin_le_centralizer (R := R) hu hv hX)

/-- Every central-coefficient polynomial in the symmetric product is stationary. -/
theorem square_zero_pair_polynomial_stationary (c : R) {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) (f : Polynomial R) :
    (c • D (u * v + v * u) - (D u * D v + D v * D u))
      (Polynomial.aeval (u * v + v * u) f) = 0 := by
  apply square_zero_pair_adjoin_le_ker c hu hv
  exact Polynomial.aeval_mem_adjoin_singleton R (u * v + v * u)

/-- On the same centralizer the mixed action generally survives as multiplication by the bracket. -/
theorem mixed_difference_of_mem_centralizer (u v X : A)
    (hX : X ∈ Subalgebra.centralizer R ({u, v} : Set A)) :
    (D u * J v - D v * J u) X = 4 • (⁅u, v⁆ * X) := by
  have hpair : Commute u X ∧ Commute v X := by
    simpa only [Subalgebra.mem_centralizer_iff, Set.forall_mem_insert,
      Set.forall_mem_singleton] using hX
  have hK : Commute (u * v - v * u) X :=
    (hpair.1.mul_left hpair.2).sub_left (hpair.2.mul_left hpair.1)
  rw [lie_jordan_difference]
  change (u * v - v * u) * X + X * (u * v - v * u) +
    2 • (u * (X * v) - v * (X * u)) = 4 • ((u * v - v * u) * X)
  rw [← hpair.1.eq, ← hpair.2.eq, ← hK.eq]
  simp only [nsmul_eq_mul]
  noncomm_ring

end InfoGeometry.OperatorAlgebra.PeirceSuperoperators

