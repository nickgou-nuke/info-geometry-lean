import Mathlib.Tactic
import InfoGeometry.Canonical.TensorTowerColimit
import InfoGeometry.Clifford.ChiralGrandCanonicalOperatorGeometry

/-!
# Chiral Modular Flow Colimit Bridge

This module transports the exact algebraic inner flow generated by a finite-stage
unit through a compatible algebra-homomorphism cone into a target algebra.

Because time evolution in the operator algebra is represented here by inner
conjugation and the map is an `AlgHom`, the finite flow is transported exactly.
No universal property of a categorical colimit, analytic limit, or KMS existence
theorem is asserted by this file.
-/

namespace InfoGeometry.Canonical.ChiralModularFlowColimitBridge

variable {A_inf : Type*} [Ring A_inf] [Algebra ℂ A_inf]
variable {A : ℕ → Type*} [∀ n, Ring (A n)] [∀ n, Algebra ℂ (A n)]
variable (psi : ∀ n, A n →ₐ[ℂ] A_inf)

/-- 
The finite-stage modular flow generated by an arbitrary unitary operator `U`,
representing $U(t) = e^{i t H}$. 
Implemented rigorously as a pure inner automorphism `Ad_U(x) = U x U^{-1}`.
-/
def modularFlow (n : ℕ) (U : (A n)ˣ) (x : A n) : A n :=
  (U : A n) * x * (↑U⁻¹ : A n)

/-- 
Because `psi` is an `AlgHom`, it structurally preserves invertible elements,
mapping the finite-stage modular generator unit perfectly into the continuum. 
-/
def mapUnit (n : ℕ) (U : (A n)ˣ) : A_infˣ :=
  Units.map (psi n : A n →* A_inf) U

/-- 
The resulting macroscopic continuous modular flow in the $A_\infty$ boundary. 
-/
def continuumModularFlow (n : ℕ) (U : (A n)ˣ) (x_inf : A_inf) : A_inf :=
  (mapUnit psi n U : A_inf) * x_inf * (↑(mapUnit psi n U)⁻¹ : A_inf)

/-- 
**Colimit Transport of the Modular Flow**
The modular inner automorphism at any finite stage transports exactly to the 
macroscopic modular flow at the continuum boundary. The topology of time 
evolution is strictly invariant under the `AlgHom` functor.
-/
theorem colimit_modular_flow_transport (n : ℕ) (U : (A n)ˣ) (x : A n) :
    psi n (modularFlow n U x) = continuumModularFlow psi n U (psi n x) := by
  dsimp [modularFlow, continuumModularFlow, mapUnit]
  rw [map_mul, map_mul]

end InfoGeometry.Canonical.ChiralModularFlowColimitBridge
