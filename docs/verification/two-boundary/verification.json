  "compatibility_helper_source": "#define _GNU_SOURCE\n#include <dlfcn.h>\n#include <errno.h>\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\n/* Adapt only the current process executable lookup to the host PID layout. */\nssize_t readlink(const char *path, char *buffer, size_t size) {\n    static ssize_t (*next_readlink)(const char *, char *, size_t) = NULL;\n    if (next_readlink == NULL)\n        next_readlink = dlsym(RTLD_NEXT, \"readlink\");\n    if (next_readlink == NULL) {\n        errno = ENOSYS;\n        return -1;\n    }\n    char own_executable[80];\n    snprintf(own_executable, sizeof(own_executable), \"/proc/%ld/exe\", (long)getpid());\n    if (strcmp(path, own_executable) == 0)\n        path = \"/proc/self/exe\";\n    return next_readlink(path, buffer, size);\n}\n",
