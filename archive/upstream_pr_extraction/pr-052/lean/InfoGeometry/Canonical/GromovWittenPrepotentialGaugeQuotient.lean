import InfoGeometry.Canonical.GromovWittenPrepotential

/-!
# Finite permutation gauge quotient for prepotential coefficient data

The existing prepotential owner stores a finite symmetric third-order tensor
and its WDVV equations.  This file adds the finite gauge quotient generated by
coordinate permutations.  It does not identify this quotient with a manifold,
a stack, or an enumerative Gromov--Witten moduli space.
-/

namespace InfoGeometry.Canonical

open scoped BigOperators

abbrev PrepotentialTripleIndex (dim : ℕ) := Fin dim × Fin dim × Fin dim

def prepotentialTriplePerm {dim : ℕ}
    (σ : Equiv.Perm (Fin dim)) :
    PrepotentialTripleIndex dim ≃ PrepotentialTripleIndex dim where
  toFun t := (σ t.1, σ t.2.1, σ t.2.2)
  invFun t := (σ.symm t.1, σ.symm t.2.1, σ.symm t.2.2)
  left_inv := by
    intro t
    rcases t with ⟨i, j, k⟩
    simp
  right_inv := by
    intro t
    rcases t with ⟨i, j, k⟩
    simp

def permutePrepotentialCoefficients {dim : ℕ}
    (σ : Equiv.Perm (Fin dim)) (F : GromovWittenPrepotential dim) :
    Fin dim → Fin dim → Fin dim → ℝ :=
  fun i j k => F.F3 (σ.symm i) (σ.symm j) (σ.symm k)

def prepotentialGaugeRel {dim : ℕ}
    (F G : GromovWittenPrepotential dim) : Prop :=
  ∃ σ : Equiv.Perm (Fin dim),
    ∀ i j k, G.F3 i j k = permutePrepotentialCoefficients σ F i j k

def prepotentialGaugeSetoid (dim : ℕ) :
    Setoid (GromovWittenPrepotential dim) where
  r := prepotentialGaugeRel
  iseqv := by
    constructor
    · intro F
      refine ⟨Equiv.refl _, ?_⟩
      intro i j k
      rfl
    · intro F G hFG
      rcases hFG with ⟨σ, hσ⟩
      refine ⟨σ.symm, ?_⟩
      intro i j k
      simpa [permutePrepotentialCoefficients] using
        (hσ (σ i) (σ j) (σ k)).symm
    · intro F G H hFG hGH
      rcases hFG with ⟨σ, hσ⟩
      rcases hGH with ⟨τ, hτ⟩
      refine ⟨σ.trans τ, ?_⟩
      intro i j k
      calc
        H.F3 i j k = G.F3 (τ.symm i) (τ.symm j) (τ.symm k) := by
          simpa [permutePrepotentialCoefficients] using hτ i j k
        _ = F.F3 (σ.symm (τ.symm i))
            (σ.symm (τ.symm j)) (σ.symm (τ.symm k)) := by
          simpa [permutePrepotentialCoefficients] using
            hσ (τ.symm i) (τ.symm j) (τ.symm k)
        _ = permutePrepotentialCoefficients (σ.trans τ) F i j k := by
          rfl

abbrev GromovWittenPrepotentialGaugeQuotient (dim : ℕ) :=
  Quotient (prepotentialGaugeSetoid dim)

def totalPrepotentialCoefficient {dim : ℕ}
    (F : GromovWittenPrepotential dim) : ℝ :=
  ∑ t : PrepotentialTripleIndex dim, F.F3 t.1 t.2.1 t.2.2

theorem totalPrepotentialCoefficient_gauge_invariant {dim : ℕ}
    {F G : GromovWittenPrepotential dim}
    (hFG : prepotentialGaugeRel F G) :
    totalPrepotentialCoefficient G = totalPrepotentialCoefficient F := by
  rcases hFG with ⟨σ, hσ⟩
  unfold totalPrepotentialCoefficient
  calc
    (∑ t : PrepotentialTripleIndex dim, G.F3 t.1 t.2.1 t.2.2) =
        ∑ t : PrepotentialTripleIndex dim,
          F.F3 (σ.symm t.1) (σ.symm t.2.1) (σ.symm t.2.2) := by
      apply Finset.sum_congr rfl
      intro t ht
      exact hσ t.1 t.2.1 t.2.2
    _ = ∑ t : PrepotentialTripleIndex dim, F.F3 t.1 t.2.1 t.2.2 := by
      simpa [PrepotentialTripleIndex, permutePrepotentialCoefficients] using
        (Fintype.sum_equiv
          (prepotentialTriplePerm σ.symm)
          (fun t : PrepotentialTripleIndex dim =>
            F.F3 (σ.symm t.1) (σ.symm t.2.1) (σ.symm t.2.2))
          (fun t : PrepotentialTripleIndex dim =>
            F.F3 t.1 t.2.1 t.2.2)
          (fun _ => rfl))

def totalPrepotentialCoefficientOnGaugeQuotient {dim : ℕ} :
    GromovWittenPrepotentialGaugeQuotient dim → ℝ :=
  Quotient.lift totalPrepotentialCoefficient (by
    intro F G hFG
    exact (totalPrepotentialCoefficient_gauge_invariant hFG).symm)

theorem totalPrepotentialCoefficientOnGaugeQuotient_mk {dim : ℕ}
    (F : GromovWittenPrepotential dim) :
    totalPrepotentialCoefficientOnGaugeQuotient
        (Quotient.mk (prepotentialGaugeSetoid dim) F) =
      totalPrepotentialCoefficient F :=
  rfl

def prepotentialCoefficientEnergy {dim : ℕ}
    (F : GromovWittenPrepotential dim) : ℝ :=
  ∑ t : PrepotentialTripleIndex dim, (F.F3 t.1 t.2.1 t.2.2) ^ 2

theorem prepotentialCoefficientEnergy_gauge_invariant {dim : ℕ}
    {F G : GromovWittenPrepotential dim}
    (hFG : prepotentialGaugeRel F G) :
    prepotentialCoefficientEnergy G = prepotentialCoefficientEnergy F := by
  rcases hFG with ⟨σ, hσ⟩
  unfold prepotentialCoefficientEnergy
  calc
    (∑ t : PrepotentialTripleIndex dim, (G.F3 t.1 t.2.1 t.2.2) ^ 2) =
        ∑ t : PrepotentialTripleIndex dim,
          (F.F3 (σ.symm t.1) (σ.symm t.2.1) (σ.symm t.2.2)) ^ 2 := by
      apply Finset.sum_congr rfl
      intro t ht
      change (G.F3 t.1 t.2.1 t.2.2) ^ 2 =
        (F.F3 (σ.symm t.1) (σ.symm t.2.1) (σ.symm t.2.2)) ^ 2
      exact congrArg (fun x : ℝ => x ^ 2) (hσ t.1 t.2.1 t.2.2)
    _ = ∑ t : PrepotentialTripleIndex dim, (F.F3 t.1 t.2.1 t.2.2) ^ 2 := by
      simpa using
        (Fintype.sum_equiv
          (prepotentialTriplePerm σ.symm)
          (fun t : PrepotentialTripleIndex dim =>
            (F.F3 (σ.symm t.1) (σ.symm t.2.1) (σ.symm t.2.2)) ^ 2)
          (fun t : PrepotentialTripleIndex dim =>
            (F.F3 t.1 t.2.1 t.2.2) ^ 2)
          (fun _ => rfl))

def prepotentialCoefficientEnergyOnGaugeQuotient {dim : ℕ} :
    GromovWittenPrepotentialGaugeQuotient dim → ℝ :=
  Quotient.lift prepotentialCoefficientEnergy (by
    intro F G hFG
    exact (prepotentialCoefficientEnergy_gauge_invariant hFG).symm)

theorem prepotentialCoefficientEnergyOnGaugeQuotient_mk {dim : ℕ}
    (F : GromovWittenPrepotential dim) :
    prepotentialCoefficientEnergyOnGaugeQuotient
        (Quotient.mk (prepotentialGaugeSetoid dim) F) =
      prepotentialCoefficientEnergy F :=
  rfl

end InfoGeometry.Canonical
