import Mathlib

import InfoGeometry.Canonical.CanonicalZornFiveGradeReversal

/-!
# Native symmetry-group closure of the canonical five-grade reversal

The canonical five-grade carrier already owns a bracket-preserving
involutive Lie automorphism.  This file packages its generated symmetry as a
native subgroup of permutations of the conformal carrier and proves that the
whole generated action preserves the noncommutative Lie bracket.

The subgroup is intentionally defined by closure of the existing reversal;
no scalar or diagonal surrogate is introduced.
-/

noncomputable section

namespace CanonicalZornFiveGradedClosure

open TKKJordanPairData

abbrev FiveGradeCarrier := ConformalMatrix

/-- The existing grade reversal as an involutive permutation. -/
noncomputable def gradeReversalPerm : Equiv.Perm FiveGradeCarrier where
  toFun := conformalGradeReversal
  invFun := conformalGradeReversal
  left_inv := by
    intro A
    exact conformalGradeReversal_involutive A
  right_inv := by
    intro A
    exact conformalGradeReversal_involutive A

@[simp] theorem gradeReversalPerm_apply (A : FiveGradeCarrier) :
    gradeReversalPerm A = conformalGradeReversal A :=
  rfl

@[simp] theorem gradeReversalPerm_mul_self :
    gradeReversalPerm * gradeReversalPerm =
      (1 : Equiv.Perm FiveGradeCarrier) := by
  apply Equiv.ext
  intro A
  simp [gradeReversalPerm]

/-- Permutations preserving the native Lie bracket. -/
def bracketPreservingPermSubgroup :
    Subgroup (Equiv.Perm FiveGradeCarrier) where
  carrier := {e | ∀ A B,
    e ⁅A, B⁆ = ⁅e A, e B⁆}
  one_mem' := by
    intro A B
    rfl
  mul_mem' := by
    intro e f he hf A B
    change e (f ⁅A, B⁆) = ⁅e (f A), e (f B)⁆
    rw [hf A B, he (f A) (f B)]
  inv_mem' := by
    intro e he A B
    have h := he (e.symm A) (e.symm B)
    have h' := congrArg e.symm h
    simpa using h'.symm

theorem gradeReversalPerm_mem_bracketPreserving :
    gradeReversalPerm ∈ bracketPreservingPermSubgroup := by
  intro A B
  exact conformalGradeReversal_bracket A B

/-- The native five-grade symmetry group generated by grade reversal. -/
def fiveGradeSymmetryGroup :
    Subgroup (Equiv.Perm FiveGradeCarrier) :=
  Subgroup.closure {e | e = gradeReversalPerm}

/--
Every element of the generated five-grade symmetry subgroup is either the
identity or the original grade reversal.  This is the concrete normal form
of the subgroup closure, obtained from the involutive noncommutative
generator rather than from a scalar surrogate.
-/
theorem fiveGradeSymmetryGroup_eq_one_or_reversal
    (g : fiveGradeSymmetryGroup) :
      g.1 = (1 : Equiv.Perm FiveGradeCarrier) ∨
      g.1 = gradeReversalPerm := by
  refine Subgroup.closure_induction ?_ ?_ ?_ ?_ g.2
  · intro e he
    rcases he with rfl
    exact Or.inr rfl
  · exact Or.inl rfl
  · intro e f he hf he' hf'
    rcases he' with rfl | rfl <;> rcases hf' with rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact Or.inr rfl
    · left
      rw [gradeReversalPerm_mul_self]
  · intro e he he'
    rcases he' with rfl | rfl
    · exact Or.inl rfl
    · right
      rfl

theorem fiveGradeSymmetryGroup_le_bracketPreserving :
    fiveGradeSymmetryGroup ≤ bracketPreservingPermSubgroup := by
  rw [fiveGradeSymmetryGroup, Subgroup.closure_le]
  intro e he
  rcases he with rfl
  exact gradeReversalPerm_mem_bracketPreserving

theorem fiveGradeSymmetryGroup_preserves_bracket
    (g : fiveGradeSymmetryGroup) (A B : FiveGradeCarrier) :
    g.1 ⁅A, B⁆ = ⁅g.1 A, g.1 B⁆ := by
  exact fiveGradeSymmetryGroup_le_bracketPreserving g.2 A B

/-- Native permutation representation of the generated five-grade group. -/
noncomputable def fiveGradeSymmetryRepresentation :
    fiveGradeSymmetryGroup →* Function.End FiveGradeCarrier where
  toFun := fun g A => g.1 A
  map_one' := by
    funext A
    rfl
  map_mul' := by
    intro g h
    funext A
    rfl

@[simp] theorem fiveGradeSymmetryRepresentation_apply
    (g : fiveGradeSymmetryGroup) (A : FiveGradeCarrier) :
    fiveGradeSymmetryRepresentation g A = g.1 A :=
  rfl

theorem fiveGradeSymmetryRepresentation_preserves_bracket
    (g : fiveGradeSymmetryGroup) (A B : FiveGradeCarrier) :
    fiveGradeSymmetryRepresentation g ⁅A, B⁆ =
      ⁅fiveGradeSymmetryRepresentation g A,
        fiveGradeSymmetryRepresentation g B⁆ := by
  exact fiveGradeSymmetryGroup_preserves_bracket g A B

/-! ## Linearity and Cartan-sector invariance -/

def linearPermSubgroup :
    Subgroup (Equiv.Perm FiveGradeCarrier) where
  carrier := {e |
    (∀ A B, e (A + B) = e A + e B) ∧
    (∀ (a : ℝ) A, e (a • A) = a • e A)}
  one_mem' := by
    constructor <;> intros <;> rfl
  mul_mem' := by
    intro e f he hf
    constructor
    · intro A B
      simp only [Equiv.Perm.mul_apply]
      rw [hf.1 A B, he.1]
    · intro a A
      simp only [Equiv.Perm.mul_apply]
      rw [hf.2 a A, he.2]
  inv_mem' := by
    intro e he
    constructor
    · intro A B
      have h := he.1 (e.symm A) (e.symm B)
      have h' := congrArg e.symm h
      simpa using h'.symm
    · intro a A
      have h := he.2 a (e.symm A)
      have h' := congrArg e.symm h
      simpa using h'.symm

theorem gradeReversalPerm_mem_linearPermSubgroup :
    gradeReversalPerm ∈ linearPermSubgroup := by
  constructor
  · intro A B
    exact conformalGradeReversal.map_add A B
  · intro a A
    exact conformalGradeReversal.map_smul a A

theorem fiveGradeSymmetryGroup_le_linearPermSubgroup :
    fiveGradeSymmetryGroup ≤ linearPermSubgroup := by
  rw [fiveGradeSymmetryGroup, Subgroup.closure_le]
  intro e he
  rcases he with rfl
  exact gradeReversalPerm_mem_linearPermSubgroup

theorem fiveGradeSymmetryGroup_is_linear
    (g : fiveGradeSymmetryGroup) :
    (∀ A B, g.1 (A + B) = g.1 A + g.1 B) ∧
      (∀ (a : ℝ) A, g.1 (a • A) = a • g.1 A) :=
  fiveGradeSymmetryGroup_le_linearPermSubgroup g.2

/-- Native Lie-equivalence readout of every generated symmetry. -/
noncomputable def fiveGradeSymmetryLieEquiv
    (g : fiveGradeSymmetryGroup) :
    FiveGradeCarrier ≃ₗ⁅ℝ⁆ FiveGradeCarrier where
  toFun := g.1
  invFun := g.1.symm
  left_inv := g.1.left_inv
  right_inv := g.1.right_inv
  map_add' := by
    exact (fiveGradeSymmetryGroup_is_linear g).1
  map_smul' := by
    exact (fiveGradeSymmetryGroup_is_linear g).2
  map_lie' := by
    intro A B
    exact fiveGradeSymmetryGroup_preserves_bracket g A B

@[simp] theorem fiveGradeSymmetryLieEquiv_apply
    (g : fiveGradeSymmetryGroup) (A : FiveGradeCarrier) :
    fiveGradeSymmetryLieEquiv g A = g.1 A :=
  rfl

theorem fiveGradeSymmetryLieEquiv_agrees_with_representation
    (g : fiveGradeSymmetryGroup) (A : FiveGradeCarrier) :
    fiveGradeSymmetryLieEquiv g A =
      fiveGradeSymmetryRepresentation g A := by
  rfl

/-- The Lie-equivalence readout is multiplicative on the generated group. -/
theorem fiveGradeSymmetryLieEquiv_mul_apply
    (g h : fiveGradeSymmetryGroup) (A : FiveGradeCarrier) :
    fiveGradeSymmetryLieEquiv (g * h) A =
      fiveGradeSymmetryLieEquiv g
        (fiveGradeSymmetryLieEquiv h A) := by
  rw [fiveGradeSymmetryLieEquiv_agrees_with_representation,
    fiveGradeSymmetryLieEquiv_agrees_with_representation,
    fiveGradeSymmetryLieEquiv_agrees_with_representation]
  rw [map_mul]
  rfl

def thetaCommutingPermSubgroup :
    Subgroup (Equiv.Perm FiveGradeCarrier) where
  carrier := {e |
    ∀ A,
      e ((conformalGradeReversalSymmetricLie).θ A) =
        (conformalGradeReversalSymmetricLie).θ (e A)}
  one_mem' := by
    intro A
    rfl
  mul_mem' := by
    intro e f he hf A
    change e (f ((conformalGradeReversalSymmetricLie).θ A)) =
      (conformalGradeReversalSymmetricLie).θ (e (f A))
    rw [hf A, he]
  inv_mem' := by
    intro e he A
    have h := he (e.symm A)
    have h' := congrArg e.symm h
    simpa using h'.symm

theorem gradeReversalPerm_mem_thetaCommutingPermSubgroup :
    gradeReversalPerm ∈ thetaCommutingPermSubgroup := by
  intro A
  simp [gradeReversalPerm,
    conformalGradeReversalSymmetricLie_theta_apply]

theorem fiveGradeSymmetryGroup_le_thetaCommutingPermSubgroup :
    fiveGradeSymmetryGroup ≤ thetaCommutingPermSubgroup := by
  rw [fiveGradeSymmetryGroup, Subgroup.closure_le]
  intro e he
  rcases he with rfl
  exact gradeReversalPerm_mem_thetaCommutingPermSubgroup

theorem fiveGradeSymmetryGroup_commutes_with_theta
    (g : fiveGradeSymmetryGroup) (A : FiveGradeCarrier) :
    g.1 ((conformalGradeReversalSymmetricLie).θ A) =
      (conformalGradeReversalSymmetricLie).θ (g.1 A) :=
  fiveGradeSymmetryGroup_le_thetaCommutingPermSubgroup g.2 A

theorem fiveGradeSymmetryGroup_preserves_even
    (g : fiveGradeSymmetryGroup) {A : FiveGradeCarrier}
    (hA : A ∈ (conformalGradeReversalSymmetricLie).evenLieSubalgebra) :
    g.1 A ∈ (conformalGradeReversalSymmetricLie).evenLieSubalgebra := by
  rw [(conformalGradeReversalSymmetricLie).mem_even_iff] at hA ⊢
  calc
    (conformalGradeReversalSymmetricLie).θ (g.1 A) =
        g.1 ((conformalGradeReversalSymmetricLie).θ A) :=
      (fiveGradeSymmetryGroup_commutes_with_theta g A).symm
    _ = g.1 A := by rw [hA]

theorem fiveGradeSymmetryGroup_preserves_odd
    (g : fiveGradeSymmetryGroup) {A : FiveGradeCarrier}
    (hA : A ∈ (conformalGradeReversalSymmetricLie).oddSubmodule) :
    g.1 A ∈ (conformalGradeReversalSymmetricLie).oddSubmodule := by
  rw [(conformalGradeReversalSymmetricLie).mem_oddSubmodule_iff] at hA ⊢
  calc
    (conformalGradeReversalSymmetricLie).θ (g.1 A) =
        g.1 ((conformalGradeReversalSymmetricLie).θ A) :=
      (fiveGradeSymmetryGroup_commutes_with_theta g A).symm
    _ = g.1 (-A) := by rw [hA]
    _ = -g.1 A := by
      have hg := fiveGradeSymmetryGroup_is_linear g
      simpa using hg.2 (-1 : ℝ) A

theorem gradeReversalPerm_reverses_grade
    {g : TKKGrade} {A : FiveGradeCarrier}
    (hA : A ∈ conformalGrade g) :
    gradeReversalPerm A ∈ conformalGrade (gradeNeg g) := by
  rw [gradeReversalPerm_apply]
  exact conformalGradeReversal_mem_grade_neg hA

/-! ## Native action of the generated five-grade symmetry group -/

/-- The generated bracket-preserving symmetries act natively on the carrier. -/
noncomputable instance fiveGradeSymmetryMulAction :
    MulAction fiveGradeSymmetryGroup FiveGradeCarrier where
  smul := fun g A => fiveGradeSymmetryRepresentation g A
  one_smul := by
    intro A
    change fiveGradeSymmetryRepresentation
        (1 : fiveGradeSymmetryGroup) A = A
    rw [map_one]
    rfl
  mul_smul := by
    intro g h A
    change fiveGradeSymmetryRepresentation (g * h) A =
      fiveGradeSymmetryRepresentation g
        (fiveGradeSymmetryRepresentation h A)
    rw [map_mul]
    rfl

@[simp]
theorem fiveGradeSymmetry_smul_eq
    (g : fiveGradeSymmetryGroup) (A : FiveGradeCarrier) :
    g • A = fiveGradeSymmetryRepresentation g A :=
  rfl

/-- Action notation preserves the native Lie bracket. -/
theorem fiveGradeSymmetry_smul_preserves_bracket
    (g : fiveGradeSymmetryGroup)
    (A B : FiveGradeCarrier) :
    g • ⁅A, B⁆ = ⁅g • A, g • B⁆ := by
  simpa only [fiveGradeSymmetry_smul_eq] using
    fiveGradeSymmetryRepresentation_preserves_bracket g A B

/-- The native action commutes with the Cartan involution. -/
theorem fiveGradeSymmetry_smul_commutes_with_theta
    (g : fiveGradeSymmetryGroup) (A : FiveGradeCarrier) :
    g • (conformalGradeReversalSymmetricLie).θ A =
      (conformalGradeReversalSymmetricLie).θ (g • A) := by
  simpa only [fiveGradeSymmetry_smul_eq] using
    fiveGradeSymmetryGroup_commutes_with_theta g A

/-- Every generated symmetry has an inverse action on the carrier. -/
theorem fiveGradeSymmetry_inv_smul_smul
    (g : fiveGradeSymmetryGroup) (A : FiveGradeCarrier) :
    g⁻¹ • g • A = A := by
  exact inv_smul_smul g A

/-- Action notation preserves the even symmetric-pair sector. -/
theorem fiveGradeSymmetry_smul_preserves_even
    (g : fiveGradeSymmetryGroup)
    {A : FiveGradeCarrier}
    (hA : A ∈ (conformalGradeReversalSymmetricLie).evenLieSubalgebra) :
    g • A ∈ (conformalGradeReversalSymmetricLie).evenLieSubalgebra := by
  simpa only [fiveGradeSymmetry_smul_eq] using
    fiveGradeSymmetryGroup_preserves_even g hA

/-- Action notation preserves the odd symmetric-pair sector. -/
theorem fiveGradeSymmetry_smul_preserves_odd
    (g : fiveGradeSymmetryGroup)
    {A : FiveGradeCarrier}
    (hA : A ∈ (conformalGradeReversalSymmetricLie).oddSubmodule) :
    g • A ∈ (conformalGradeReversalSymmetricLie).oddSubmodule := by
  simpa only [fiveGradeSymmetry_smul_eq] using
    fiveGradeSymmetryGroup_preserves_odd g hA

/-- The group action transports the mixed symmetric-pair bracket into the odd
sector. -/
theorem fiveGradeSymmetry_smul_even_odd_bracket_mem_odd
    (g : fiveGradeSymmetryGroup)
    (A : (conformalGradeReversalSymmetricLie).evenLieSubalgebra)
    (B : (conformalGradeReversalSymmetricLie).oddSubmodule) :
    g • ⁅A.1, B.1⁆ ∈
      (conformalGradeReversalSymmetricLie).oddSubmodule := by
  apply fiveGradeSymmetry_smul_preserves_odd g
  exact (conformalGradeReversal_symmetric_pair_properties).2.1
    A.2 B.2

/-- The group action transports the odd-odd symmetric-pair bracket into the
even Lie subalgebra. -/
theorem fiveGradeSymmetry_smul_odd_odd_bracket_mem_even
    (g : fiveGradeSymmetryGroup)
    (A B : (conformalGradeReversalSymmetricLie).oddSubmodule) :
    g • ⁅A.1, B.1⁆ ∈
      (conformalGradeReversalSymmetricLie).evenLieSubalgebra := by
  apply fiveGradeSymmetry_smul_preserves_even g
  exact (conformalGradeReversal_symmetric_pair_properties).2.2
    A.2 B.2

/-! ## Native actions on the symmetric-pair sectors -/

/-- The generated symmetry group acts on the even Lie subalgebra itself. -/
noncomputable instance evenLieSubalgebraMulAction :
    MulAction fiveGradeSymmetryGroup
      (conformalGradeReversalSymmetricLie).evenLieSubalgebra where
  smul := fun g A =>
    ⟨g • A.1, fiveGradeSymmetry_smul_preserves_even g A.2⟩
  one_smul := by
    intro A
    apply Subtype.ext
    change (1 : fiveGradeSymmetryGroup) • A.1 = A.1
    exact one_smul fiveGradeSymmetryGroup A.1
  mul_smul := by
    intro g h A
    apply Subtype.ext
    change (g * h) • A.1 = g • h • A.1
    exact mul_smul g h A.1

@[simp]
theorem evenLieSubalgebra_smul_val
    (g : fiveGradeSymmetryGroup)
    (A : (conformalGradeReversalSymmetricLie).evenLieSubalgebra) :
    (g • A).1 = g • A.1 :=
  rfl

/-- The induced action preserves the Lie bracket inside the even sector. -/
theorem evenLieSubalgebra_smul_preserves_bracket
    (g : fiveGradeSymmetryGroup)
    (A B : (conformalGradeReversalSymmetricLie).evenLieSubalgebra) :
    g • ⁅A, B⁆ = ⁅g • A, g • B⁆ := by
  apply Subtype.ext
  change g • ⁅A.1, B.1⁆ = ⁅g • A.1, g • B.1⁆
  exact fiveGradeSymmetry_smul_preserves_bracket g A.1 B.1

/-- Each generated symmetry induces a genuine Lie equivalence of the even
sector. -/
noncomputable def evenLieSubalgebraLieEquiv
    (g : fiveGradeSymmetryGroup) :
    (conformalGradeReversalSymmetricLie).evenLieSubalgebra ≃ₗ⁅ℝ⁆
      (conformalGradeReversalSymmetricLie).evenLieSubalgebra where
  toFun := fun A => g • A
  invFun := fun A => g⁻¹ • A
  left_inv := by
    intro A
    apply Subtype.ext
    change g⁻¹ • g • A.1 = A.1
    exact inv_smul_smul g A.1
  right_inv := by
    intro A
    apply Subtype.ext
    change g • g⁻¹ • A.1 = A.1
    exact inv_smul_smul g⁻¹ A.1
  map_add' := by
    intro A B
    apply Subtype.ext
    change g • (A.1 + B.1) = g • A.1 + g • B.1
    exact map_add (fiveGradeSymmetryLieEquiv g) A.1 B.1
  map_smul' := by
    intro a A
    apply Subtype.ext
    change g • (a • A.1) = a • g • A.1
    exact map_smul (fiveGradeSymmetryLieEquiv g) a A.1
  map_lie' := by
    intro A B
    exact evenLieSubalgebra_smul_preserves_bracket g A B

/-- The even-sector Lie equivalences are multiplicative under group
composition. -/
theorem evenLieSubalgebraLieEquiv_mul_apply
    (g h : fiveGradeSymmetryGroup)
    (A : (conformalGradeReversalSymmetricLie).evenLieSubalgebra) :
    evenLieSubalgebraLieEquiv (g * h) A =
      evenLieSubalgebraLieEquiv g
        (evenLieSubalgebraLieEquiv h A) := by
  apply Subtype.ext
  change (g * h) • A.1 = g • h • A.1
  exact fiveGradeSymmetryLieEquiv_mul_apply g h A.1

/-- The inverse generated symmetry acts as the inverse even-sector Lie
equivalence. -/
theorem evenLieSubalgebraLieEquiv_inv_apply
    (g : fiveGradeSymmetryGroup)
    (A : (conformalGradeReversalSymmetricLie).evenLieSubalgebra) :
    evenLieSubalgebraLieEquiv g⁻¹
        (evenLieSubalgebraLieEquiv g A) = A := by
  apply Subtype.ext
  change g⁻¹ • g • A.1 = A.1
  exact inv_smul_smul g A.1

/-- The generated symmetry group acts on the odd Cartan sector itself. -/
noncomputable instance oddSubmoduleMulAction :
    MulAction fiveGradeSymmetryGroup
      (conformalGradeReversalSymmetricLie).oddSubmodule where
  smul := fun g A =>
    ⟨g • A.1, fiveGradeSymmetry_smul_preserves_odd g A.2⟩
  one_smul := by
    intro A
    apply Subtype.ext
    change (1 : fiveGradeSymmetryGroup) • A.1 = A.1
    exact one_smul fiveGradeSymmetryGroup A.1
  mul_smul := by
    intro g h A
    apply Subtype.ext
    change (g * h) • A.1 = g • h • A.1
    exact mul_smul g h A.1

@[simp]
theorem oddSubmodule_smul_val
    (g : fiveGradeSymmetryGroup)
    (A : (conformalGradeReversalSymmetricLie).oddSubmodule) :
    (g • A).1 = g • A.1 :=
  rfl

end CanonicalZornFiveGradedClosure

end noncomputable section
