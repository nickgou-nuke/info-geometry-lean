import InfoGeometry.OperatorAlgebra.PeirceSpine.Basic
import Mathlib.Algebra.GroupWithZero.Units.Basic
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Basic
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Projection
import Mathlib.Analysis.SpecialFunctions.ContinuousFunctionalCalculus.ExpLog.Basic
import Mathlib.FieldTheory.IsAlgClosed.Spectrum
import Mathlib.Tactic.Module

/-!
# The actual relative logarithm of commuting Peirce sheet densities

For an arbitrary self-adjoint projection `P` in a possibly noncommutative
C-star algebra, `twoSheet P p q = p • P + q • (1 - P)` has a two-point
functional calculus. Positive reference weights give a native `Ring.inverse`,
and the density ratio has the exact negative CFC logarithm computed below.
The centered expression uses the existing grading `invS P = P - (1 - P)`.

These two operators lie in the commutative algebra generated by `P`. They
are not assumed to be normalized states. The ambient algebra is never assumed
commutative, and no identification with a general relative modular operator
is asserted.

The proof evaluates the genuine continuous functional calculus on the finite
spectrum of a projection; the relative ratio uses the native ring inverse.
The associated theorem contract records source provenance and domain limits.
-/

noncomputable section

namespace InfoGeometry.OperatorAlgebra.PeirceSpine.TwoSheetRelativeLog

section Algebra

variable {B : Type*} [Ring B] [Algebra ℝ B]

/-- Independently weighted complementary Peirce sheets in the ambient algebra. -/
def twoSheet (P : B) (a b : ℝ) : B := a • P + b • (1 - P)

theorem twoSheet_affine (P : B) (a b : ℝ) :
    twoSheet P a b = b • (1 : B) + (a - b) • P := by
  simp only [twoSheet, smul_sub, sub_smul]
  abel

/-- The central mean and the oriented sheet difference in the native grading. -/
theorem twoSheet_centered (P : B) (a b : ℝ) :
    twoSheet P a b = ((a + b) / 2) • (1 : B) + ((a - b) / 2) • invS P := by
  simp only [twoSheet, invS, smul_sub]
  module

@[simp] theorem twoSheet_one (P : B) : twoSheet P 1 1 = (1 : B) := by
  simp only [twoSheet, one_smul]
  abel

/-- Orthogonality of the complementary sheets makes their coefficients multiply. -/
theorem twoSheet_mul (P : B) (hP : P * P = P) (a b c d : ℝ) :
    twoSheet P a b * twoSheet P c d = twoSheet P (a * c) (b * d) := by
  simp only [twoSheet, add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
    mul_sub, sub_mul, mul_one, one_mul, hP]
  module

/-- The sheet difference sends the original odd deformation to its ordered current. -/
theorem comm_twoSheet_phi (P : B) (hP : P * P = P) (A C : B) (a b : ℝ) :
    comm (twoSheet P a b) (genPhi P A C) = (a - b) • genJ P A C := by
  have hcomm : comm P (genPhi P A C) = genJ P A C := by peirce_nf hP
  calc
    comm (twoSheet P a b) (genPhi P A C) =
        (a - b) • comm P (genPhi P A C) := by
      simp only [twoSheet, comm, add_mul, mul_add, smul_mul_assoc,
        mul_smul_comm, sub_mul, mul_sub, one_mul, mul_one, smul_sub, sub_smul]
      abel
    _ = (a - b) • genJ P A C := by rw [hcomm]

/-- The reverse action retains the same oriented sheet difference. -/
theorem comm_twoSheet_current (P : B) (hP : P * P = P) (A C : B) (a b : ℝ) :
    comm (twoSheet P a b) (genJ P A C) = (a - b) • genPhi P A C := by
  have hcomm : comm P (genJ P A C) = genPhi P A C := by peirce_nf hP
  calc
    comm (twoSheet P a b) (genJ P A C) =
        (a - b) • comm P (genJ P A C) := by
      simp only [twoSheet, comm, add_mul, mul_add, smul_mul_assoc,
        mul_smul_comm, sub_mul, mul_sub, one_mul, mul_one, smul_sub, sub_smul]
      abel
    _ = (a - b) • genPhi P A C := by rw [hcomm]

/-- Nonzero weights give a genuine unit, using both multiplication orders. -/
theorem twoSheet_isUnit (P : B) (hP : P * P = P)
    (a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0) : IsUnit (twoSheet P a b) := by
  refine isUnit_iff_exists.mpr ⟨twoSheet P a⁻¹ b⁻¹, ?_, ?_⟩
  · rw [twoSheet_mul P hP]
    simp [ha, hb]
  · rw [twoSheet_mul P hP]
    simp [ha, hb]

/-- The computed inverse is Mathlib's native total ring inverse at a unit. -/
theorem twoSheet_inverse (P : B) (hP : P * P = P)
    (a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0) :
    Ring.inverse (twoSheet P a b) = twoSheet P a⁻¹ b⁻¹ := by
  have hunit := twoSheet_isUnit P hP a b ha hb
  have hright : twoSheet P a b * twoSheet P a⁻¹ b⁻¹ = 1 := by
    rw [twoSheet_mul P hP]
    simp [ha, hb]
  calc
    Ring.inverse (twoSheet P a b) =
        Ring.inverse (twoSheet P a b) *
          (twoSheet P a b * twoSheet P a⁻¹ b⁻¹) := by rw [hright, mul_one]
    _ = twoSheet P a⁻¹ b⁻¹ :=
      Ring.inverse_mul_cancel_left (twoSheet P a b) (twoSheet P a⁻¹ b⁻¹) hunit

/-- The ordered density ratio has the corresponding scalar ratios on its sheets. -/
theorem twoSheet_mul_inverse (P : B) (hP : P * P = P)
    (p q p₀ q₀ : ℝ) (hp₀ : p₀ ≠ 0) (hq₀ : q₀ ≠ 0) :
    twoSheet P p q * Ring.inverse (twoSheet P p₀ q₀) =
      twoSheet P (p / p₀) (q / q₀) := by
  rw [twoSheet_inverse P hP p₀ q₀ hp₀ hq₀, twoSheet_mul P hP]
  simp only [div_eq_mul_inv]

end Algebra

section FunctionalCalculus

variable {B : Type*} [CStarAlgebra B] {P : B}

/-- A scalar function on a projection equals its exact two-point interpolant. -/
theorem cfc_projection_twoSheet (hP : IsStarProjection P) (f : ℝ → ℝ) :
    cfc f P = twoSheet P (f 1) (f 0) := by
  have heq : (spectrum ℝ P).EqOn f (fun x => f 0 + (f 1 - f 0) * x) := by
    intro x hx
    have hx' := hP.isIdempotentElem.spectrum_subset ℝ hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx'
    rcases hx' with rfl | rfl <;> simp
  rw [cfc_congr heq,
    cfc_const_add (f 0) (fun x => (f 1 - f 0) * x) P (by fun_prop) hP.isSelfAdjoint,
    cfc_const_mul_id (f 1 - f 0) P hP.isSelfAdjoint,
    Algebra.algebraMap_eq_smul_one, twoSheet_affine]

/-- Native CFC evaluation, including coincident sheet weights. Every function
restricted to the finite spectrum is continuous. -/
theorem cfc_twoSheet (hP : IsStarProjection P) (a b : ℝ) (f : ℝ → ℝ) :
    cfc f (twoSheet P a b) = twoSheet P (f a) (f b) := by
  let g : ℝ → ℝ := fun x => b + (a - b) * x
  have hg : cfc g P = twoSheet P a b := by
    rw [cfc_projection_twoSheet hP]
    simp [g]
  have hf : ContinuousOn f (g '' spectrum ℝ P) :=
    ((hP.isIdempotentElem.finite_spectrum ℝ).image g).continuousOn f
  rw [← hg, ← cfc_comp f g P hP.isSelfAdjoint hf,
    cfc_projection_twoSheet hP]
  simp [g]

/-- The actual negative CFC logarithm, with total `Real.log` at arbitrary weights. -/
theorem neg_log_twoSheet (hP : IsStarProjection P) (p q : ℝ) :
    -CFC.log (twoSheet P p q) = twoSheet P (-Real.log p) (-Real.log q) := by
  rw [CFC.log, cfc_twoSheet hP]
  simp only [twoSheet, neg_smul, neg_add_rev]
  abel

/-- The logarithm of the native ordered ratio, not a formally assigned log label. -/
theorem neg_log_relative_ratio (hP : IsStarProjection P)
    (p q p₀ q₀ : ℝ) (hp₀ : p₀ ≠ 0) (hq₀ : q₀ ≠ 0) :
    -CFC.log (twoSheet P p q * Ring.inverse (twoSheet P p₀ q₀)) =
      twoSheet P (-Real.log (p / p₀)) (-Real.log (q / q₀)) := by
  rw [twoSheet_mul_inverse P hP.isIdempotentElem.eq p q p₀ q₀ hp₀ hq₀,
    neg_log_twoSheet hP]

/-- The actual relative logarithm acts on arbitrary ordered wings through the
negative difference of the two log ratios. -/
theorem comm_neg_log_relative_ratio_phi (hP : IsStarProjection P) (A C : B)
    (p q p₀ q₀ : ℝ) (hp₀ : p₀ ≠ 0) (hq₀ : q₀ ≠ 0) :
    comm (-CFC.log (twoSheet P p q * Ring.inverse (twoSheet P p₀ q₀)))
        (genPhi P A C) =
      -(Real.log (p / p₀) - Real.log (q / q₀)) • genJ P A C := by
  rw [neg_log_relative_ratio hP p q p₀ q₀ hp₀ hq₀,
    comm_twoSheet_phi P hP.isIdempotentElem.eq A C]
  congr 1
  abel

/-- The same native logarithm sends the ordered current back to the odd deformation. -/
theorem comm_neg_log_relative_ratio_current (hP : IsStarProjection P) (A C : B)
    (p q p₀ q₀ : ℝ) (hp₀ : p₀ ≠ 0) (hq₀ : q₀ ≠ 0) :
    comm (-CFC.log (twoSheet P p q * Ring.inverse (twoSheet P p₀ q₀)))
        (genJ P A C) =
      -(Real.log (p / p₀) - Real.log (q / q₀)) • genPhi P A C := by
  rw [neg_log_relative_ratio hP p q p₀ q₀ hp₀ hq₀,
    comm_twoSheet_current P hP.isIdempotentElem.eq A C]
  congr 1
  abel

/-- The central mean and oriented difference of the actual relative log ratios. -/
theorem neg_log_relative_ratio_centered (hP : IsStarProjection P)
    (p q p₀ q₀ : ℝ) (hp₀ : p₀ ≠ 0) (hq₀ : q₀ ≠ 0) :
    -CFC.log (twoSheet P p q * Ring.inverse (twoSheet P p₀ q₀)) =
      (-((Real.log (p / p₀) + Real.log (q / q₀)) / 2)) • (1 : B) -
        ((Real.log (p / p₀) - Real.log (q / q₀)) / 2) • invS P := by
  rw [neg_log_relative_ratio hP p q p₀ q₀ hp₀ hq₀, twoSheet_centered]
  module

section Positive

variable [PartialOrder B] [StarOrderedRing B]

/-- Positive sheet weights give a strictly positive operator by spectral mapping. -/
theorem twoSheet_isStrictlyPositive (hP : IsStarProjection P)
    {p q : ℝ} (hp : 0 < p) (hq : 0 < q) :
    IsStrictlyPositive (twoSheet P p q) := by
  let g : ℝ → ℝ := fun x => q + (p - q) * x
  have hg : cfc g P = twoSheet P p q := by
    rw [cfc_projection_twoSheet hP]
    simp [g]
  rw [← hg]
  apply (cfc_isStrictlyPositive_iff g P (by fun_prop) hP.isSelfAdjoint).2
  intro x hx
  have hx' := hP.isIdempotentElem.spectrum_subset ℝ hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx'
  rcases hx' with rfl | rfl
  · simpa [g] using hq
  · simpa [g] using hp

/-- The positive ratio remains strictly positive in the ambient C-star algebra. -/
theorem relative_ratio_isStrictlyPositive (hP : IsStarProjection P)
    {p q p₀ q₀ : ℝ} (hp : 0 < p) (hq : 0 < q)
    (hp₀ : 0 < p₀) (hq₀ : 0 < q₀) :
    IsStrictlyPositive (twoSheet P p q * Ring.inverse (twoSheet P p₀ q₀)) := by
  rw [twoSheet_mul_inverse P hP.isIdempotentElem.eq p q p₀ q₀ hp₀.ne' hq₀.ne']
  exact twoSheet_isStrictlyPositive hP (div_pos hp hp₀) (div_pos hq hq₀)

/-- Strict positivity and the centered normal form certify a genuine commuting-sheet
relative logarithm. `invS P` is exactly the grading `P - (1 - P) = 2P - 1`. -/
theorem positive_relative_log_normal_form (hP : IsStarProjection P)
    {p q p₀ q₀ : ℝ} (hp : 0 < p) (hq : 0 < q)
    (hp₀ : 0 < p₀) (hq₀ : 0 < q₀) :
    IsStrictlyPositive (twoSheet P p q * Ring.inverse (twoSheet P p₀ q₀)) ∧
      -CFC.log (twoSheet P p q * Ring.inverse (twoSheet P p₀ q₀)) =
        (-((Real.log (p / p₀) + Real.log (q / q₀)) / 2)) • (1 : B) -
          ((Real.log (p / p₀) - Real.log (q / q₀)) / 2) • invS P := by
  exact ⟨relative_ratio_isStrictlyPositive hP hp hq hp₀ hq₀,
    neg_log_relative_ratio_centered hP p q p₀ q₀ hp₀.ne' hq₀.ne'⟩

end Positive

end FunctionalCalculus

end InfoGeometry.OperatorAlgebra.PeirceSpine.TwoSheetRelativeLog
