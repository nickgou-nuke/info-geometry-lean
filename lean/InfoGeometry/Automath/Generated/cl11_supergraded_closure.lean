import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Algebra.Cl11OSp12
import InfoGeometry.Canonical.ErlangenInductiveClosure

/-!
# Clifford Cl(1,1) Supergraded Inductive Closure Bridge

This module instantiates the abstract `SupergradedClosureAt` invariant packet
for the concrete Clifford algebra `Cl(1,1)` generated by the split-null metric `q11`.
-/

open InfoGeometry.Algebra.Cl11OSp12
open InfoGeometry.Canonical.ErlangenInductiveClosure

namespace InfoGeometry.Automath.Generated

/-- Odd elements are in the isotropic generator lines of the ladders b and bdag. -/
def cl11_is_odd (x : CliffordAlgebra q11) : Prop :=
  (∃ r : ℚ, x = r • b) ∨ (∃ s : ℚ, x = s • bdag)

/-- Even elements are in the span of the identity and the pseudoscalar e₀ * e₁. -/
def cl11_is_even (x : CliffordAlgebra q11) : Prop :=
  ∃ r s : ℚ, x = algebraMap ℚ _ r + s • (e₀ * e₁)

/-- Central elements are the scalars. -/
def cl11_is_central (x : CliffordAlgebra q11) : Prop :=
  ∃ r : ℚ, x = algebraMap ℚ _ r

lemma odd_nilpotency_proof (x : CliffordAlgebra q11) (h : cl11_is_odd x) : x * x = 0 := by
  rcases h with ⟨r, rfl⟩ | ⟨s, rfl⟩
  · simp [b_sq]
  · simp [bdag_sq]

lemma odd_odd_closure_proof (x y : CliffordAlgebra q11) (hx : cl11_is_odd x) (hy : cl11_is_odd y) :
    cl11_is_even (x * y + y * x) := by
  rcases hx with ⟨r, rfl⟩ | ⟨s, rfl⟩ <;> rcases hy with ⟨u, rfl⟩ | ⟨v, rfl⟩
  · -- x = r • b, y = u • b
    have h1 : r • b * (u • b) = (r * u) • (b * b) := by
      rw [smul_mul_assoc, mul_smul_comm, smul_smul]
    have h2 : u • b * (r • b) = (u * r) • (b * b) := by
      rw [smul_mul_assoc, mul_smul_comm, smul_smul]
    rw [h1, h2, b_sq]
    use 0, 0
    simp
  · -- x = r • b, y = v • bdag
    have h1 : r • b * (v • bdag) + v • bdag * (r • b) = algebraMap ℚ _ (r * v) := by
      rw [smul_mul_assoc, mul_smul_comm, smul_smul, smul_mul_assoc, mul_smul_comm, smul_smul]
      rw [mul_comm v r]
      rw [← smul_add, anticomm_bbdag, Algebra.algebraMap_eq_smul_one]
    rw [h1]
    use r * v, 0
    simp
  · -- x = s • bdag, y = u • b
    have h1 : s • bdag * (u • b) + u • b * (s • bdag) = algebraMap ℚ _ (s * u) := by
      rw [smul_mul_assoc, mul_smul_comm, smul_smul, smul_mul_assoc, mul_smul_comm, smul_smul]
      rw [mul_comm u s]
      rw [← smul_add, add_comm, anticomm_bbdag, Algebra.algebraMap_eq_smul_one]
    rw [h1]
    use s * u, 0
    simp
  · -- x = s • bdag, y = v • bdag
    have h1 : s • bdag * (v • bdag) = (s * v) • (bdag * bdag) := by
      rw [smul_mul_assoc, mul_smul_comm, smul_smul]
    have h2 : v • bdag * (s • bdag) = (v * s) • (bdag * bdag) := by
      rw [smul_mul_assoc, mul_smul_comm, smul_smul]
    rw [h1, h2, bdag_sq]
    use 0, 0
    simp

lemma central_lane_proof (c x : CliffordAlgebra q11) (hc : cl11_is_central c) : c * x = x * c := by
  rcases hc with ⟨r, rfl⟩
  exact Algebra.commutes r x

/-- Projector P = b * bdag is even and idempotent. -/
lemma projector_identity_proof : ∃ P : CliffordAlgebra q11, cl11_is_even P ∧ P * P = P := by
  use b * bdag
  constructor
  · -- Prove b * bdag is even.
    have h_expand : b * bdag = algebraMap ℚ _ (1/2) + (-1/2 : ℚ) • (e₀ * e₁) := by
      unfold b bdag
      have h1 : (1/2 : ℚ) • (e₀ + e₁) * ((1/2 : ℚ) • (e₀ - e₁)) = (1/4 : ℚ) • ((e₀ + e₁) * (e₀ - e₁)) := by
        rw [smul_mul_assoc, mul_smul_comm, smul_smul]
        have h_frac : (1 / 2 * (1 / 2) : ℚ) = 1 / 4 := by norm_num
        rw [h_frac]
      rw [h1]
      have h_anticomm : e₁ * e₀ = - (e₀ * e₁) := by
        have h_sum := anticomm
        rw [← add_zero (e₁ * e₀), ← add_neg_cancel (e₀ * e₁), ← add_assoc]
        rw [add_comm (e₁ * e₀) (e₀ * e₁), h_sum, zero_add]
      have h2 : (e₀ + e₁) * (e₀ - e₁) = algebraMap ℚ _ 2 + (-2 : ℚ) • (e₀ * e₁) := by
        calc (e₀ + e₁) * (e₀ - e₁) = e₀ * e₀ - e₀ * e₁ + e₁ * e₀ - e₁ * e₁ := by noncomm_ring
          _ = 1 - e₀ * e₁ + e₁ * e₀ - (-1) := by rw [e₀_sq, e₁_sq]
          _ = 1 - e₀ * e₁ - (e₀ * e₁) - (-1) := by rw [h_anticomm]; abel
          _ = algebraMap ℚ _ 2 + (-2 : ℚ) • (e₀ * e₁) := by
            simp [two_smul, sub_eq_add_neg, Algebra.algebraMap_eq_smul_one]
            abel
      rw [h2]
      simp [smul_add, smul_smul, Algebra.algebraMap_eq_smul_one]; norm_num
    rw [h_expand]
    use 1/2, -1/2
  · -- Prove (b * bdag) * (b * bdag) = b * bdag
    have h_car : bdag * b = 1 - b * bdag := by
      rw [← anticomm_bbdag]
      abel
    calc b * bdag * (b * bdag) = b * (bdag * b) * bdag := by simp [mul_assoc]
      _ = b * (1 - b * bdag) * bdag := by rw [h_car]
      _ = (b * 1 - b * (b * bdag)) * bdag := by rw [mul_sub]
      _ = (b - 0) * bdag := by rw [mul_one, ← mul_assoc b b bdag, b_sq, zero_mul]
      _ = b * bdag := by rw [sub_zero]

/-- Instantiates the `SupergradedClosureAt` structure for `CliffordAlgebra q11`. -/
def cl11_supergraded_closure : SupergradedClosureAt (CliffordAlgebra q11) where
  is_odd := cl11_is_odd
  is_even := cl11_is_even
  is_central := cl11_is_central
  odd_nilpotency := odd_nilpotency_proof
  odd_odd_closure := odd_odd_closure_proof
  central_lane := central_lane_proof
  projector_identity := projector_identity_proof

end InfoGeometry.Automath.Generated
