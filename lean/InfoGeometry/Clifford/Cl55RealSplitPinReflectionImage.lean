import InfoGeometry.Clifford.Cl55RealSplitPinAction
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Clifford.Cl55WittPinAction
import InfoGeometry.Clifford.Cl55WittReflectionSubgroup

namespace InfoGeometry.Clifford.Clifford55

/-!
# Explicit reflection images of the real split Pin subgroup

The subgroup generated by normalized vectors of either split norm contains
the negative Witt-coordinate reflection lifts.  This is an image statement
for the explicit reflection subsystem; it is not a surjectivity theorem for
the full orthogonal group.
-/

theorem normalizedVector_mem_realSplitPin
    (v : V55) (hv : Q55 v = 1 ∨ Q55 v = -1) :
    ∃ g : realSplitPin55, ((g : Cl55ˣ) : Cl55) = ι55 v := by
  have hq : IsUnit (Q55 v) := by
    rcases hv with h | h
    · rw [h]
      exact ⟨1, by simp⟩
    · rw [h]
      exact ⟨-1, by simp⟩
  let u := normalizedVectorUnit v hq
  have hu : u ∈ normalizedVectorUnitSet := by
    refine ⟨v, hv, ?_⟩
    exact (normalizedVectorUnit_coe v hq).symm
  exact ⟨⟨u, Subgroup.subset_closure hu⟩,
    normalizedVectorUnit_coe v hq⟩

theorem realSplitPin_exists_coordinateReflection (i : Fin 5) :
    ∃ g : realSplitPin55,
      realSplitPinOrthogonalAction g = coordinateReflectionGenerator i := by
  rcases fNeg_mem_realSplitPin i with ⟨g, hg⟩
  refine ⟨g, ?_⟩
  apply Subtype.ext
  apply LinearEquiv.ext
  intro v
  change realSplitPinTwistedActionEquiv g v =
    negativeReflectionLinearEquiv i v
  change realSplitPinTwistedAction g v =
    negativeReflectionLinearEquiv i v
  apply ι55_injective
  change ι55 (realSplitPinTwistedAction g v) =
    ι55 (negativeReflectionLinearEquiv i v)
  rw [realSplitPinTwistedAction_apply_ι]
  have hunit : (g : Cl55ˣ) = fNegUnit i := by
    apply Units.ext
    rw [hg, fNegUnit_coe]
  change realSplitPinTwistedAdj g v =
    ι55 (negativeReflectionLinearEquiv i v)
  have hunitPin : (g : Cl55ˣ) = pinToUnits (fNegPin i) := by
    exact hunit.trans (pinToUnits_f_neg i).symm
  have hpin : realSplitPinTwistedAdj g v =
      pinTwistedAdj (fNegPin i) v := by
    simp [realSplitPinTwistedAdj, pinTwistedAdj, hunitPin]
  rw [hpin]
  have hneg : pinTwistedAdj (fNegPin i) v =
      negativeReflectionAlg i (ι55 v) := by
    simpa [fNegPin] using pinTwistedAdj_f_neg_eq_negativeReflectionAlg i v
  rw [hneg, negativeReflectionAlg_apply_ι]
  rfl

theorem coordinateReflectionGenerator_mem_realSplitPinImage (i : Fin 5) :
    coordinateReflectionGenerator i ∈
      Subgroup.map realSplitPinOrthogonalAction ⊤ := by
  rcases realSplitPin_exists_coordinateReflection i with ⟨g, hg⟩
  exact ⟨g, by simpa [hg]⟩

theorem coordinateReflectionSubgroup_le_realSplitPinImage :
    coordinateReflectionSubgroup ≤
      Subgroup.map realSplitPinOrthogonalAction ⊤ := by
  change Subgroup.closure (Set.range coordinateReflectionGenerator) ≤ _
  refine (Subgroup.closure_le _).2 ?_
  rintro _ ⟨i, rfl⟩
  exact coordinateReflectionGenerator_mem_realSplitPinImage i

theorem globalSheetReflectionGenerator_mem_realSplitPinImage :
    globalSheetReflectionGenerator ∈
      Subgroup.map realSplitPinOrthogonalAction ⊤ :=
  coordinateReflectionSubgroup_le_realSplitPinImage
    globalSheetReflectionGenerator_mem_coordinateReflectionSubgroup

def normalizedVectorReflectionSet : Set orthogonalGroup55 :=
  {r | ∃ (u : Cl55ˣ) (hu : u ∈ normalizedVectorUnitSet),
      r = realSplitPinOrthogonalAction
        ⟨u, Subgroup.subset_closure hu⟩}

def normalizedVectorReflectionSubgroup : Subgroup orthogonalGroup55 :=
  Subgroup.closure normalizedVectorReflectionSet

theorem realSplitPinImage_eq_normalizedVectorReflectionSubgroup :
    Subgroup.map realSplitPinOrthogonalAction ⊤ =
      normalizedVectorReflectionSubgroup := by
  apply le_antisymm
  · refine (Subgroup.map_le_iff_le_comap).2 ?_
    intro g hg
    have hgen : ∀ (u : Cl55ˣ) (hu : u ∈ realSplitPin55),
        realSplitPinOrthogonalAction ⟨u, hu⟩ ∈
          normalizedVectorReflectionSubgroup := by
      intro u hu
      induction hu using Subgroup.closure_induction'' with
      | mem u hu =>
          exact Subgroup.subset_closure ⟨u, hu, rfl⟩
      | inv_mem u hu =>
          have hu' : u ∈ realSplitPin55 :=
            Subgroup.subset_closure hu
          have hmem :
              realSplitPinOrthogonalAction (⟨u, hu'⟩ : realSplitPin55) ∈
                normalizedVectorReflectionSubgroup :=
            Subgroup.subset_closure ⟨u, hu, rfl⟩
          have hsub :
              (⟨u⁻¹, Subgroup.inv_mem _ hu'⟩ : realSplitPin55) =
                (⟨u, hu'⟩ : realSplitPin55)⁻¹ := by
            rfl
          rw [hsub, map_inv]
          exact Subgroup.inv_mem _ hmem
      | one =>
          have hsub :
              (⟨1, Subgroup.one_mem realSplitPin55⟩ : realSplitPin55) =
                (1 : realSplitPin55) := by
            rfl
          rw [hsub, map_one]
          exact Subgroup.one_mem _
      | mul u v hu hv hU hV =>
          have hsub :
              (⟨u * v, Subgroup.mul_mem realSplitPin55 hu hv⟩ : realSplitPin55) =
                (⟨u, hu⟩ : realSplitPin55) * ⟨v, hv⟩ := by
            rfl
          rw [hsub, map_mul]
          exact Subgroup.mul_mem _ hU hV
    exact hgen (g : Cl55ˣ) g.property
  · refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨u, hu, rfl⟩
    exact ⟨⟨u, Subgroup.subset_closure hu⟩, trivial, rfl⟩

end InfoGeometry.Clifford.Clifford55
