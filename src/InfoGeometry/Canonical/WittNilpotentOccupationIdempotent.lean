import InfoGeometry.Canonical.Cl55WittCAR
import InfoGeometry.Clifford.Cl11GeometricCompass

/-!
# Isotropic Witt modes generate nilpotents and occupation idempotents

This finite real matrix result records the concrete algebraic direction
`Witt creation/annihilation pair → square-zero generators → CAR occupation
idempotents → idempotent corner operation`.  The cyclotomic/Galois charge
actions are deliberately not identified with this construction: their current
owners establish charge-sector transport, not a general noncommutative
cyclotomic-to-idempotent theorem.
-/

namespace InfoGeometry.Canonical.WittNilpotentOccupationIdempotent

noncomputable section

open InfoGeometry.Canonical.Cl55WittCAR
open InfoGeometry.Clifford.Cl11TensorTower
open InfoGeometry.Clifford.Cl11GeometricCompass

/-- In any associative ring, a square-zero pair normalized by the CAR
anticommutator produces an idempotent in the stated multiplication order. -/
theorem squareZero_pair_product_idempotent
    {A : Type*} [Ring A] (u v : A)
    (hu : u * u = 0)
    (hcar : u * v + v * u = 1) :
    (u * v) * (u * v) = u * v := by
  have hvu : v * u = 1 - u * v := by
    rw [← hcar]
    abel
  calc
    (u * v) * (u * v) = u * (v * u) * v := by simp only [mul_assoc]
    _ = u * (1 - u * v) * v := by rw [hvu]
    _ = u * v := by
      calc
        _ = u * v - (u * u) * v * v := by noncomm_ring
        _ = u * v := by rw [hu]; simp

/-- The complementary ordered product is also idempotent; the two supports
annihilate each other in both orders. -/
theorem squareZero_pair_complementary_idempotents
    {A : Type*} [Ring A] (u v : A)
    (hu : u * u = 0) (hv : v * v = 0)
    (hcar : u * v + v * u = 1) :
    ((u * v) * (u * v) = u * v) ∧
    ((v * u) * (v * u) = v * u) ∧
    (u * v) * (v * u) = 0 ∧ (v * u) * (u * v) = 0 := by
  have huv := squareZero_pair_product_idempotent u v hu hcar
  have hcar' : v * u + u * v = 1 := by rw [add_comm]; exact hcar
  have hvuIdem := squareZero_pair_product_idempotent v u hv hcar'
  refine ⟨huv, ?_, ?_, ?_⟩
  · exact hvuIdem
  · calc
      (u * v) * (v * u) = u * (v * v) * u := by simp only [mul_assoc]
      _ = 0 := by rw [hv]; simp
  · calc
      (v * u) * (u * v) = v * (u * u) * v := by simp only [mul_assoc]
      _ = 0 := by rw [hu]; simp

/-- A two-sided corner induced by an idempotent is itself an idempotent
operator on the ambient ring. -/
def idempotentCorner {A : Type*} [Ring A] (e x : A) : A := e * x * e

theorem idempotentCorner_idempotent
    {A : Type*} [Ring A] (e x : A) (he : e * e = e) :
    idempotentCorner e (idempotentCorner e x) = idempotentCorner e x := by
  unfold idempotentCorner
  calc
    e * (e * x * e) * e = (e * e) * x * (e * e) := by simp only [mul_assoc]
    _ = e * x * e := by rw [he]

/-- Ring homomorphisms transport idempotents. This is the precise general
Galois-action consequence; it does not assert that a cyclotomic relation
creates an idempotent. -/
theorem ringHom_preserves_idempotent
    {A C : Type*} [Ring A] [Ring C] (f : A →+* C) (e : A)
    (he : e * e = e) : f e * f e = f e := by
  rw [← map_mul, he]

/-- The third cyclotomic polynomial, evaluated in an associative ring using
central integer coefficients. -/
def operatorCyclotomicThree {A : Type*} [Ring A] (x : A) : A :=
  x * x + x + 1

/-- At a square-zero operator, `Φ₃(x) = 1 + x` is a two-sided unit with
inverse `1 - x`; nilpotence alone therefore does not make this evaluation a
projector. -/
theorem squareZero_cyclotomicThree_is_unit
    {A : Type*} [Ring A] (n : A) (hn : n * n = 0) :
    operatorCyclotomicThree n * (1 - n) = 1 ∧
    (1 - n) * operatorCyclotomicThree n = 1 := by
  have hcube : n * n * n = 0 := by rw [hn]; simp
  constructor
  · calc
      operatorCyclotomicThree n * (1 - n) = 1 - n * n * n := by
        unfold operatorCyclotomicThree
        noncomm_ring
      _ = 1 := by rw [hcube]; simp
  · calc
      (1 - n) * operatorCyclotomicThree n = 1 - n * n * n := by
        unfold operatorCyclotomicThree
        noncomm_ring
      _ = 1 := by rw [hcube]; simp

/-- The ordered occupation operator generated by a real Witt mode. -/
def occupation (i : Fin 5) : MatStage 5 := creation i * annihilation i

/-- The primitive Cl(1,1) null directions are the square-zero Witt pair;
their normalized creation/annihilation representatives satisfy CAR and yield
the local occupation idempotent. -/
theorem isotropic_witt_pair_generates_local_idempotent :
    nullPlus * nullPlus = 0 ∧
    nullMinus * nullMinus = 0 ∧
    wittCreationBase * wittAnnihilationBase +
        wittAnnihilationBase * wittCreationBase = 1 ∧
    (wittCreationBase * wittAnnihilationBase) *
        (wittCreationBase * wittAnnihilationBase) =
      wittCreationBase * wittAnnihilationBase := by
  have hcreate := wittCreationBase_sq
  have hcar : wittCreationBase * wittAnnihilationBase +
      wittAnnihilationBase * wittCreationBase =
        (1 : Matrix (Fin 2) (Fin 2) ℝ) := by
    simpa [realEncodedWittCreationBase_eq, realEncodedWittAnnihilationBase_eq] using
      realEncodedWitt_anticomm
  refine ⟨nullPlus_sq, nullMinus_sq, hcar, ?_⟩
  exact squareZero_pair_product_idempotent _ _ hcreate hcar

/-- A nilpotent isotropic Witt creation mode paired with its CAR annihilator
produces an idempotent occupation operator. -/
theorem occupation_idempotent (i : Fin 5) :
    occupation i * occupation i = occupation i := by
  have hc := creation_same_site_sq i
  have ha := annihilation_same_site_sq i
  have hcar := creation_annihilation_same_site i
  have hac : annihilation i * creation i =
      1 - creation i * annihilation i := by
    rw [← hcar]
    abel
  change (creation i * annihilation i) *
      (creation i * annihilation i) = creation i * annihilation i
  calc
    _ = creation i * (annihilation i * creation i) * annihilation i := by
      simp only [mul_assoc]
    _ = creation i * (1 - creation i * annihilation i) *
        annihilation i := by rw [hac]
    _ = creation i * annihilation i := by
      simp [sub_mul, mul_sub, mul_assoc, ha]

/-- The complementary vacancy operator is idempotent and orthogonal to
occupation in both multiplication orders. -/
theorem occupation_vacancy_pair (i : Fin 5) :
    (annihilation i * creation i) * (annihilation i * creation i) =
        annihilation i * creation i ∧
    occupation i * (annihilation i * creation i) = 0 ∧
    (annihilation i * creation i) * occupation i = 0 := by
  have hc := creation_same_site_sq i
  have ha := annihilation_same_site_sq i
  have hcar := creation_annihilation_same_site i
  unfold occupation
  have hac : annihilation i * creation i =
      1 - creation i * annihilation i := by
    rw [← hcar]
    abel
  refine ⟨?_, ?_, ?_⟩
  · calc
      (annihilation i * creation i) * (annihilation i * creation i) =
          annihilation i * (creation i * annihilation i) * creation i := by
        simp only [mul_assoc]
      _ = annihilation i * (1 - annihilation i * creation i) * creation i := by
        rw [show creation i * annihilation i =
          1 - annihilation i * creation i by rw [← hcar]; abel]
      _ = annihilation i * creation i := by
        simp [sub_mul, mul_sub, mul_assoc, hc]
  · change (creation i * annihilation i) *
      (annihilation i * creation i) = 0
    calc
      _ = creation i * (annihilation i * annihilation i) * creation i := by
        simp only [mul_assoc]
      _ = 0 := by rw [ha]; simp
  · change (annihilation i * creation i) *
      (creation i * annihilation i) = 0
    calc
      _ = annihilation i * (creation i * creation i) * annihilation i := by
        simp only [mul_assoc]
      _ = 0 := by rw [hc]; simp

/-- The idempotent induces an idempotent two-sided corner operation on the
operator algebra. This is the meta-level projection generated by the mode. -/
def cornerOperation (i : Fin 5) (X : MatStage 5) : MatStage 5 :=
  occupation i * X * occupation i

theorem cornerOperation_idempotent (i : Fin 5) (X : MatStage 5) :
    cornerOperation i (cornerOperation i X) = cornerOperation i X := by
  unfold cornerOperation
  calc
    occupation i * (occupation i * X * occupation i) * occupation i =
        (occupation i * occupation i) * X *
          (occupation i * occupation i) := by simp only [mul_assoc]
    _ = occupation i * X * occupation i := by rw [occupation_idempotent]

/-- Master chain: nilpotence and CAR produce complementary support
idempotents, whose corner action is itself idempotent. -/
theorem nilpotent_CAR_to_metaidempotent (i : Fin 5) :
    creation i * creation i = 0 ∧
    annihilation i * annihilation i = 0 ∧
    creation i * annihilation i + annihilation i * creation i = 1 ∧
    occupation i * occupation i = occupation i ∧
    cornerOperation i (cornerOperation i (1 : MatStage 5)) =
      cornerOperation i (1 : MatStage 5) := by
  exact ⟨creation_same_site_sq i, annihilation_same_site_sq i,
    creation_annihilation_same_site i, occupation_idempotent i,
    cornerOperation_idempotent i 1⟩

end
end InfoGeometry.Canonical.WittNilpotentOccupationIdempotent
