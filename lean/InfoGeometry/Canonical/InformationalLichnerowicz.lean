import InfoGeometry.Canonical.QuasilatticeDirac
import InfoGeometry.Canonical.RelationalInformationDynamics
import InfoGeometry.Meta.Architecture

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.InformationalLichnerowicz

Weak-owner operatorial Lichnerowicz test on the doubled carrier.

This file does not introduce a decorative geometric shell. It records the
actual diagonal transport split already supported by the repo on `EndH`:

- the diagonal operatorial Hessian is the symmetric metric sector,
- the diagonal curvature sector vanishes by the owned bilinear map theorem,
- and the second quasilattice-Dirac transport derivative is exactly that
  diagonal operatorial Hessian.

So the current repo-native Lichnerowicz statement is an `EndH` theorem about
owned transport operators, not yet a curved triality palace.
-/

namespace InfoGeometry.Canonical.InformationalLichnerowicz

open InfoGeometry.Canonical.BogoliubovTransport
open InfoGeometry.Canonical.RelationalInformationDynamics
open InfoGeometry.Canonical.QuasilatticeDirac
open InfoGeometry.Krein

section Core

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
noncomputable local instance : NormedSpace ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance

/-- The diagonal operatorial Hessian is exactly the symmetric metric part. -/
@[rep_depth transport]
theorem operatorInformationHessian_eq_metricPart
    (X A : EndH) :
    operatorInformationHessian (E := E) X A
      =
    operatorInformationMetricPart (E := E) X X A := by
  symm
  simpa [operatorInformationMetricPartMap_apply] using
    operatorInformationMetricPartMap_diag (E := E) (A := A) (X := X)

/-- The diagonal curvature channel vanishes identically. -/
@[rep_depth transport]
theorem operatorInformationCurvaturePart_diag_eq_zero
    (X A : EndH) :
    operatorInformationCurvaturePart (E := E) X X A = 0 := by
  simpa [operatorInformationCurvaturePartMap_apply] using
    operatorInformationCurvaturePartMap_diag (E := E) (A := A) (X := X)

/--
Weak-owner informational Lichnerowicz split:
the diagonal second variation is the metric part plus a vanishing diagonal
curvature correction.
-/
@[rep_depth transport]
theorem operatorInformationHessian_eq_metricPart_add_half_curvaturePart
    (X A : EndH) :
    operatorInformationHessian (E := E) X A
      =
    operatorInformationMetricPart (E := E) X X A
      + ((2 : ℝ)⁻¹) • operatorInformationCurvaturePart (E := E) X X A := by
  rw [operatorInformationHessian_eq_metricPart (E := E) (X := X) (A := A),
    operatorInformationCurvaturePart_diag_eq_zero (E := E) (X := X) (A := A)]
  simp

/--
The second quasilattice-Dirac transport derivative at the reference point is
exactly the diagonal operatorial Hessian generated by the connection channel.
-/
@[rep_depth transport]
theorem deriv2_quasilatticeDirac_at_zero_eq_operatorInformationHessian
    (V : BogoliubovVielbein.BogoliubovVielbeinBundle (E := E))
    (D : EndH) :
    let X := V.connectionGenerator
    deriv (fun t => deriv (fun s => quasilatticeDirac V D s) t) 0
      =
    operatorInformationHessian (E := E) X D := by
  dsimp [operatorInformationHessian, operatorInformationMixedSecondVariation,
    operatorInformationFirstVariation]
  exact QuasilatticeDirac.deriv2_quasilatticeDirac_at_zero (E := E) V D

/--
Diagonal Lichnerowicz form of the quasilattice-Dirac second transport
derivative: on the weak owner, the second derivative lands on the symmetric
metric sector.
-/
@[rep_depth transport]
theorem deriv2_quasilatticeDirac_at_zero_eq_operatorInformationMetricPart
    (V : BogoliubovVielbein.BogoliubovVielbeinBundle (E := E))
    (D : EndH) :
    let X := V.connectionGenerator
    deriv (fun t => deriv (fun s => quasilatticeDirac V D s) t) 0
      =
    operatorInformationMetricPart (E := E) X X D := by
  dsimp
  rw [deriv2_quasilatticeDirac_at_zero_eq_operatorInformationHessian
    (E := E) (V := V) (D := D)]
  exact operatorInformationHessian_eq_metricPart
    (E := E) (X := V.connectionGenerator) (A := D)

/--
Diagonal weak-owner Lichnerowicz split for the quasilattice Dirac operator.
The curvature correction is present formally but vanishes on the diagonal.
-/
@[rep_depth transport]
theorem deriv2_quasilatticeDirac_at_zero_eq_metricPart_add_half_curvaturePart
    (V : BogoliubovVielbein.BogoliubovVielbeinBundle (E := E))
    (D : EndH) :
    let X := V.connectionGenerator
    deriv (fun t => deriv (fun s => quasilatticeDirac V D s) t) 0
      =
    operatorInformationMetricPart (E := E) X X D
      + ((2 : ℝ)⁻¹) • operatorInformationCurvaturePart (E := E) X X D := by
  dsimp
  rw [deriv2_quasilatticeDirac_at_zero_eq_operatorInformationHessian
    (E := E) (V := V) (D := D)]
  exact operatorInformationHessian_eq_metricPart_add_half_curvaturePart
    (E := E) (X := V.connectionGenerator) (A := D)

end Core

end InfoGeometry.Canonical.InformationalLichnerowicz
