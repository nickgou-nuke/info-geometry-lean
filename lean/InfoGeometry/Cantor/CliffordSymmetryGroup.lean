import InfoGeometry.Cantor.CliffordMarkovOperators

/-!
# Cantor finite-mode Clifford symmetry group

The carrier is generated by the represented Clifford operators as units in
the endomorphism algebra of the primal-sheet Fock module. This records a
noncommutative operator group; it does not by itself assert a stochastic
action or a Markov averaging law.
-/

noncomputable section

namespace InfoGeometry.Cantor.CliffordSymmetryGroup

open InfoGeometry.Clifford.ClNNFockRepresentation
open InfoGeometry.Clifford.FockSpaceCAR
open InfoGeometry.Cantor.CliffordMarkovOperators

variable (n : ℕ)

/-- The ambient group of invertible operators on the finite Fock carrier. -/
abbrev ModeUnits := (Module.End ℝ (FockSpace (PrimalSheet n)))ˣ

/-- A finite Cantor-mode Clifford operator, packaged as an invertible
endomorphism using its proved square-one law. -/
def modeUnit (i : Fin n) :
    (Module.End ℝ (FockSpace (PrimalSheet n)))ˣ where
  val := cantorModeCliffordOperator n i
  inv := cantorModeCliffordOperator n i
  val_inv := cantorModeCliffordOperator_sq n i
  inv_val := cantorModeCliffordOperator_sq n i

/-- The operator group generated by all finite Cantor-mode Clifford units. -/
def group : Subgroup (Module.End ℝ (FockSpace (PrimalSheet n)))ˣ :=
  Subgroup.closure (Set.range (modeUnit n))

/-- Every represented mode is in the generated operator group. -/
theorem modeUnit_mem_group (i : Fin n) : modeUnit n i ∈ group n :=
  Subgroup.subset_closure ⟨i, rfl⟩

/-- Distinct mode units retain the Clifford anticommutation relation after
passing from operators to units. -/
theorem modeUnit_cross_CAR {i j : Fin n} (hij : i ≠ j) :
    ((InfoGeometry.Cantor.CliffordSymmetryGroup.modeUnit n i *
        InfoGeometry.Cantor.CliffordSymmetryGroup.modeUnit n j : ModeUnits n) :
        Module.End ℝ (FockSpace (PrimalSheet n))) +
      ((InfoGeometry.Cantor.CliffordSymmetryGroup.modeUnit n j *
        InfoGeometry.Cantor.CliffordSymmetryGroup.modeUnit n i : ModeUnits n) :
        Module.End ℝ (FockSpace (PrimalSheet n))) = 0 := by
  change cantorModeCliffordOperator n i * cantorModeCliffordOperator n j +
    cantorModeCliffordOperator n j * cantorModeCliffordOperator n i = 0
  exact cantorModeCliffordOperator_cross_CAR n hij

/-- Distinct finite-mode operators do not commute.  Thus, as soon as there
are two modes, the generated symmetry group is genuinely nonabelian; this
uses the represented Clifford operators themselves, not a coordinate model. -/
theorem cantorModeCliffordOperator_ne_mul_swap {i j : Fin n} (hij : i ≠ j) :
    cantorModeCliffordOperator n i * cantorModeCliffordOperator n j ≠
      cantorModeCliffordOperator n j * cantorModeCliffordOperator n i := by
  intro hcomm
  have hcar := cantorModeCliffordOperator_cross_CAR n hij
  rw [hcomm] at hcar
  have htwice : (2 : ℝ) •
      (cantorModeCliffordOperator n j * cantorModeCliffordOperator n i) = 0 := by
    simpa [two_smul] using hcar
  have hprod : cantorModeCliffordOperator n j * cantorModeCliffordOperator n i ≠ 0 := by
    exact Units.ne_zero (modeUnit n j * modeUnit n i)
  rcases (smul_eq_zero.mp htwice) with htwo | hprod'
  · norm_num at htwo
  · exact hprod hprod'

/-- The finite-mode units themselves retain noncommutative multiplication. -/
theorem modeUnit_ne_mul_swap {i j : Fin n} (hij : i ≠ j) :
    modeUnit n i * modeUnit n j ≠ modeUnit n j * modeUnit n i := by
  intro h
  apply cantorModeCliffordOperator_ne_mul_swap n hij
  exact congrArg (fun u : ModeUnits n =>
    (u : Module.End ℝ (FockSpace (PrimalSheet n)))) h

/-- With at least two finite modes, the generated Clifford operator group
contains an explicit noncommuting pair. This makes noncommutativity a theorem
about the group carrier itself, rather than only about its ambient operators. -/
theorem group_noncommutative (hn : 2 ≤ n) :
    ∃ U V : ↥(group n), U * V ≠ V * U := by
  let i : Fin n := ⟨0, by omega⟩
  let j : Fin n := ⟨1, by omega⟩
  have hij : i ≠ j := by
    intro h
    have := congrArg Fin.val h
    norm_num [i, j] at this
  refine ⟨⟨modeUnit n i, modeUnit_mem_group n i⟩,
    ⟨modeUnit n j, modeUnit_mem_group n j⟩, ?_⟩
  intro h
  apply modeUnit_ne_mul_swap n hij
  exact congrArg Subtype.val h

end InfoGeometry.Cantor.CliffordSymmetryGroup
