import InfoGeometry.OperatorAlgebra.CantorBernoulliSpatialNativeStateBridge
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.OperatorAlgebra.CantorBernoulliSpatialNonSeparatingBridge
import InfoGeometry.OperatorAlgebra.CantorBernoulliCuntzCStarRealization
import InfoGeometry.OperatorAlgebra.CantorBernoulliKMSStateBridge
import InfoGeometry.Physics.CStarCuntzTensorQuotient
import InfoGeometry.Canonical.CStarAlgebraStateColimit
import InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum

/-!
# Native spatial state on the generated Bernoulli C⋆-subalgebra

The constant-vector functional is already a genuine state on the ambient
bounded-operator C⋆-algebra.  This owner restricts it to the closed C⋆-
subalgebra generated by the concrete Bernoulli Cuntz family.

This is deliberately a spatial state result.  It does not identify the
restriction with the distinct gauge-invariant word kernel.
-/

noncomputable section
set_option maxHeartbeats 1600000

open scoped ComplexOrder
open scoped InnerProductSpace

namespace InfoGeometry.OperatorAlgebra.CantorBernoulliGeneratedCStarSpatialStateBridge

open InfoGeometry.OperatorAlgebra.CantorBernoulliCuntzCStarRealization
open InfoGeometry.Canonical.CantorBernoulliL2OperatorTransport
open InfoGeometry.OperatorAlgebra.CantorBernoulliSpatialNativeStateBridge
open InfoGeometry.OperatorAlgebra.CantorBernoulliSpatialNonSeparatingBridge
open InfoGeometry.Physics.CStarCuntzTensorQuotient
open CStarStateColimit.Native
open InfoGeometry.OperatorAlgebra.CantorBernoulliKMSStateBridge

abbrev Generated := cantorL2CuntzFamily.generatedCStarSubalgebra
abbrev Ambient := BoundedL2Operator

local instance generatedPartialOrder : PartialOrder Generated :=
  CStarAlgebra.spectralOrder Generated

local instance generatedStarOrderedRing : StarOrderedRing Generated :=
  CStarAlgebra.spectralOrderedRing Generated

/-- The inclusion of the generated C⋆-subalgebra into its ambient operator algebra. -/
def generatedInclusion : Generated →⋆ₐ[ℂ] Ambient where
  toFun := fun A => A.1
  map_one' := rfl
  map_mul' := by intro A B; rfl
  map_zero' := rfl
  map_add' := by intro A B; rfl
  commutes' := by intro c; rfl
  map_star' := by intro A; rfl

/-- The spatial state restricted to the concrete generated C⋆-subalgebra. -/
def generatedSpatialState : State Generated :=
  spatialState.restrict generatedInclusion

@[simp] theorem generatedSpatialState_apply (A : Generated) :
    generatedSpatialState.functional A =
      spatialPositiveFunctional (A : Ambient) := by
  rfl

theorem generatedSpatialState_projector (b : Bool) :
    generatedSpatialState.functional
        (⟨cantorL2CuntzFamily.S b,
          cantorL2CuntzFamily.S_mem_generatedCStarSubalgebra b⟩ : Generated) =
      cantorVacuumState (cantorL2CuntzFamily.S b) := by
  rw [generatedSpatialState_apply]
  rfl

/-!
The ambient spatial non-faithfulness witness is already built from the two
generators, so it also belongs to the concrete generated `StarSubalgebra`.
This keeps the witness separate from the gauge/KMS state while making the
non-faithfulness statement native to the generated carrier.
-/
theorem spatialAnnihilator_mem_generated :
    (spatialAnnihilator : Ambient) ∈ Generated := by
  have hfalse : cantorL2CuntzFamily.S false ∈ Generated :=
    cantorL2CuntzFamily.S_mem_generatedCStarSubalgebra false
  have htrue : cantorL2CuntzFamily.S true ∈ Generated :=
    cantorL2CuntzFamily.S_mem_generatedCStarSubalgebra true
  have hfalseStar : star (cantorL2CuntzFamily.S false) ∈ Generated :=
    Generated.star_mem' hfalse
  have htrueStar : star (cantorL2CuntzFamily.S true) ∈ Generated :=
    Generated.star_mem' htrue
  have hsub :
      star (cantorL2CuntzFamily.S false) - star (cantorL2CuntzFamily.S true) ∈ Generated :=
    Generated.toSubalgebra.sub_mem hfalseStar htrueStar
  simpa [spatialAnnihilator, cantorL2CuntzFamily_apply_false,
    cantorL2CuntzFamily_apply_true] using hsub

theorem generatedSpatialState_not_faithful_witness :
    (⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩ : Generated) ≠ 0 ∧
      generatedSpatialState.functional
          (star (⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩ : Generated) *
            (⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩ : Generated)) = 0 := by
  let A : Generated := ⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩
  constructor
  · intro hA
    apply spatialAnnihilator_ne_zero
    exact congrArg Subtype.val hA
  · change spatialPositiveFunctional (star spatialAnnihilator * spatialAnnihilator) = 0
    exact spatialState_star_annihilator_mul_self_eq_zero

theorem generatedSpatialState_normalized :
    generatedSpatialState.functional (1 : Generated) = 1 := by
  exact generatedSpatialState.normalized

noncomputable abbrev generatedGNS := generatedSpatialState.functional.GNS

noncomputable def generatedGNSVacuum : generatedGNS :=
  InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum.gnsVacuum
    generatedSpatialState.functional

theorem generatedGNSVacuum_norm : ‖generatedGNSVacuum‖ = 1 := by
  exact
    InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum.gnsVacuum_norm_eq_one
      generatedSpatialState.functional generatedSpatialState_normalized

noncomputable abbrev generatedGNSRepresentation :=
  generatedSpatialState.functional.gnsStarAlgHom

theorem generatedGNS_expectation_recovery (A : Generated) :
    ⟪generatedGNSVacuum,
      (generatedGNSRepresentation A) (generatedGNSVacuum)⟫_ℂ =
      generatedSpatialState.functional A := by
  exact
    InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum.gns_state_expectation_recovery
      generatedSpatialState.functional A

theorem generatedGNS_cyclic :
    DenseRange (fun A : Generated =>
      (generatedGNSRepresentation A) (generatedGNSVacuum)) := by
  rw [show (fun A : Generated =>
      (generatedSpatialState.functional.gnsStarAlgHom A) generatedGNSVacuum) =
      fun A : Generated =>
        InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum.gnsOrbitMap
          generatedSpatialState.functional A by
    funext A
    exact
      (InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum.gnsOrbitMap_eq_gnsRepresentation
        generatedSpatialState.functional A).symm]
  exact
    InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum.gnsOrbitMap_denseRange
      generatedSpatialState.functional

/-!
The ambient annihilator has a stronger algebraic property than merely killing
the vacuum: its product with the left Cuntz generator is the identity.  This
is the concrete orbit witness needed before making any statement about
separating vectors in the generated GNS representation.
-/
theorem spatialAnnihilator_mul_vLeft_eq_one :
    spatialAnnihilator * vLeft = 1 := by
  rw [spatialAnnihilator]
  rw [sub_mul]
  change (normalizedPrependBitLpAdjoint false).comp vLeft -
      (normalizedPrependBitLpAdjoint true).comp vLeft =
      ContinuousLinearMap.id ℂ L2Boundary
  rw [vLeft_adjoint_comp_vLeft, vRight_adjoint_comp_vLeft]
  simp

set_option maxHeartbeats 1000000 in
set_option synthInstance.maxHeartbeats 100000 in
theorem generatedSpatialGNS_annihilator_orbit :
    let A : Generated :=
      ⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩
    let V : Generated :=
      ⟨vLeft, cantorL2CuntzFamily.S_mem_generatedCStarSubalgebra false⟩
    (generatedGNSRepresentation A)
        ((generatedGNSRepresentation V) generatedGNSVacuum) =
      generatedGNSVacuum := by
  let A : Generated :=
    ⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩
  let V : Generated :=
    ⟨vLeft, cantorL2CuntzFamily.S_mem_generatedCStarSubalgebra false⟩
  have hAV : A * V = 1 := by
    apply Subtype.ext
    exact spatialAnnihilator_mul_vLeft_eq_one
  calc
    (generatedGNSRepresentation A)
        ((generatedGNSRepresentation V) generatedGNSVacuum) =
        ((generatedGNSRepresentation A) *
          (generatedGNSRepresentation V)) generatedGNSVacuum := rfl
    _ = (generatedGNSRepresentation (A * V)) generatedGNSVacuum := by
      rw [← map_mul generatedGNSRepresentation]
    _ = (generatedGNSRepresentation (1 : Generated)) generatedGNSVacuum := by
      rw [hAV]
    _ = generatedGNSVacuum := by
      rw [map_one generatedGNSRepresentation]
      rfl

theorem generatedSpatialGNS_annihilator_vacuum_eq_zero :
    (generatedGNSRepresentation
        (⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩ : Generated))
        generatedGNSVacuum = 0 := by
  let A : Generated :=
    ⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩
  change (generatedSpatialState.functional.gnsStarAlgHom A)
      (InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum.gnsVacuum
        generatedSpatialState.functional) = 0
  rw [← InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum.gnsOrbitMap_eq_gnsRepresentation
    generatedSpatialState.functional A]
  apply (inner_self_eq_zero (𝕜 := ℂ)).mp
  rw [show InfoGeometry.OperatorAlgebra.PositiveLinearMapGNSVacuum.gnsOrbitMap
      generatedSpatialState.functional A =
      (generatedSpatialState.functional.toPreGNS A : generatedGNS) by rfl]
  rw [UniformSpace.Completion.inner_coe]
  rw [PositiveLinearMap.preGNS_inner_def]
  simp only [PositiveLinearMap.ofPreGNS_toPreGNS]
  change spatialPositiveFunctional (star spatialAnnihilator * spatialAnnihilator) = 0
  exact spatialState_star_annihilator_mul_self_eq_zero

theorem generatedSpatialGNS_annihilator_representation_ne_zero :
    generatedGNSRepresentation
        (⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩ : Generated) ≠ 0 := by
  intro hzero
  have hzero_apply : (generatedGNSRepresentation
        (⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩ : Generated))
        ((generatedGNSRepresentation
          (⟨vLeft, cantorL2CuntzFamily.S_mem_generatedCStarSubalgebra false⟩ : Generated))
          generatedGNSVacuum) = 0 := by
    rw [hzero]
    exact ContinuousLinearMap.zero_apply _
  have hvac : generatedGNSVacuum ≠ 0 := by
    intro hvac
    have hnorm := generatedGNSVacuum_norm
    rw [hvac, norm_zero] at hnorm
    norm_num at hnorm
  have horbit : (generatedGNSRepresentation
        (⟨spatialAnnihilator, spatialAnnihilator_mem_generated⟩ : Generated))
        ((generatedGNSRepresentation
          (⟨vLeft, cantorL2CuntzFamily.S_mem_generatedCStarSubalgebra false⟩ : Generated))
          generatedGNSVacuum) = generatedGNSVacuum :=
    generatedSpatialGNS_annihilator_orbit
  rw [hzero_apply] at horbit
  exact hvac horbit.symm

end InfoGeometry.OperatorAlgebra.CantorBernoulliGeneratedCStarSpatialStateBridge
