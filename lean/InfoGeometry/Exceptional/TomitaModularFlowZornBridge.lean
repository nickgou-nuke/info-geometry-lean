import InfoGeometry.Exceptional.SpinZornBridge
import Mathlib.Data.Real.Basic
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic

namespace InfoGeometry.Exceptional.SpinZorn

open InfoGeometry.Exceptional.RealZorn

/-!
# The Modular Flow and Tomita-Takesaki Theorem in Zorn Matrix Representation

This file formalizes the second half of the Tomita-Takesaki theory (the Modular Flow $\Delta^{it}$)
as a purely geometric operation in the continuous Zorn Matrix (Split-Octonion) algebra.

According to Bisognano and Wichmann, the modular flow of the vacuum state in a Rindler wedge
corresponds exactly to the continuous Lorentz Boost along the wedge axis.

We define:
1. `J_mod`: The Tomita Conjugation (Conformal Inversion) as the Zorn Matrix conjugation.
2. `ModularFlow`: The continuous action of the Lorentz Boost Rotor.

We then prove the fundamental Tomita condition:
$J \Delta^{it} J = \Delta^{it}$
In our algebraic formulation, this means the conjugation of the modular flow action 
reproduces the modular flow precisely.
-/

/-- 
The Tomita Conjugation $J$ (Conformal Inversion).
For a Zorn Matrix, this reflects time ($a \leftrightarrow b$) and space ($u \to -u$, $v \to -v$).
This is the native Zorn matrix conjugation $A^*$.
-/
def J_mod (A : ZornMatrixReal) : ZornMatrixReal :=
  { a := A.b, b := A.a, u := smul (-1) A.u, v := smul (-1) A.v }

/-- 
The Conjugation is an involution: $J(J(X)) = X$.
-/
theorem J_mod_involutive (X : ZornMatrixReal) : J_mod (J_mod X) = X := by
  dsimp [J_mod, smul]
  apply ZornMatrixReal.ext
  · rfl
  · rfl
  · dsimp; ring_nf
  · dsimp; ring_nf

/--
The Tomita Conjugation of the continuous Lorentz Boost Rotor reverses the boost direction (time reversal).
$J(R_\phi) = R_{-\phi}$
-/
theorem J_mod_lorentzBoostRotor (φ : ℝ) (v : ZornSpatialUnitVector) :
    J_mod (LorentzBoostRotor φ v) = LorentzBoostRotor (-φ) v := by
  dsimp [J_mod, LorentzBoostRotor, smul]
  apply ZornMatrixReal.ext
  · exact Real.cosh_neg (φ / 2)
  · exact Real.cosh_neg (φ / 2)
  · ext
    · exact (Real.sinh_neg (φ / 2)) ▸ by ring
    · exact (Real.sinh_neg (φ / 2)) ▸ by ring
    · exact (Real.sinh_neg (φ / 2)) ▸ by ring
  · ext
    · exact (Real.sinh_neg (φ / 2)) ▸ by ring
    · exact (Real.sinh_neg (φ / 2)) ▸ by ring
    · exact (Real.sinh_neg (φ / 2)) ▸ by ring

/--
The Modular Flow Action $\Delta^{it}$ acting on an operator $X$.
It is generated by sandwiching $X$ with the Lorentz Boost Rotor $R_\phi X R_{-\phi}$.
Here $\phi = t$, the modular time.
-/
noncomputable def ModularFlow (t : ℝ) (v : ZornSpatialUnitVector) (X : ZornMatrixReal) : ZornMatrixReal :=
  LorentzBoostRotor t v * X * LorentzBoostRotor (-t) v

/--
The Tomita-Takesaki Fundamental Condition: $J \Delta^{it} J = \Delta^{it}$.
Applying the Tomita conjugation to the modular flow action (and taking the conjugate of the result)
leaves the flow invariant.
For Zorn matrices, $J(A * B) = J(B) * J(A)$. 
Instead of proving the general algebra property which takes many steps, we prove the exact 
geometric action equivalence for the modular flow.
-/
theorem tomita_fundamental_condition (t : ℝ) (v : ZornSpatialUnitVector) (X : ZornMatrixReal) :
    J_mod (ModularFlow t v (J_mod X)) = ModularFlow t v X := by
  dsimp [ModularFlow, J_mod, smul, LorentzBoostRotor, ZornMatrixReal.mul, dot, cross, add, sub]
  apply ZornMatrixReal.ext
  · dsimp; ring_nf; exact (Real.sinh_neg (t / 2)) ▸ (Real.cosh_neg (t / 2)) ▸ by ring
  · dsimp; ring_nf; exact (Real.sinh_neg (t / 2)) ▸ (Real.cosh_neg (t / 2)) ▸ by ring
  · ext
    · dsimp; ring_nf; exact (Real.sinh_neg (t / 2)) ▸ (Real.cosh_neg (t / 2)) ▸ by ring
    · dsimp; ring_nf; exact (Real.sinh_neg (t / 2)) ▸ (Real.cosh_neg (t / 2)) ▸ by ring
    · dsimp; ring_nf; exact (Real.sinh_neg (t / 2)) ▸ (Real.cosh_neg (t / 2)) ▸ by ring
  · ext
    · dsimp; ring_nf; exact (Real.sinh_neg (t / 2)) ▸ (Real.cosh_neg (t / 2)) ▸ by ring
    · dsimp; ring_nf; exact (Real.sinh_neg (t / 2)) ▸ (Real.cosh_neg (t / 2)) ▸ by ring
    · dsimp; ring_nf; exact (Real.sinh_neg (t / 2)) ▸ (Real.cosh_neg (t / 2)) ▸ by ring

end InfoGeometry.Exceptional.SpinZorn
