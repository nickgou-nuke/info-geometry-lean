import Mathlib.Analysis.Complex.Trigonometric
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.MeasureTheory.Integral.Bochner.ContinuousLinearMap
import InfoGeometry.Arithmetic.RiemannZetaEquivalences
import InfoGeometry.Geometry.RealRotorCore
import InfoGeometry.Compatibility.MathlibUpperHalfPlaneShadow

/-!
# Centered completed-zeta twin kernel

This owner contains only the algebraic twin representation.  It reuses
`RiemannZetaEquivalences.symmetryAdaptedXi` and its proved evenness; it does
not assert a theta-kernel integral representation.  The latter remains an
explicit analytic target.

The nonzero-scale hypothesis in the affinity converse is intentional:
`(2 * z.re) * 0 = 0` contains no information about `z.re`.
-/

noncomputable section

namespace InfoGeometry.Arithmetic.CenteredXiTwinKernel

open Complex
open MeasureTheory
open InfoGeometry.Arithmetic.RiemannZetaEquivalences
open InfoGeometry.Compatibility

/-- The expanding member of the centered twin pair. -/
def twinPlus (z : ℂ) (u : ℝ) : ℂ := Complex.exp (z * (u : ℂ))

/-- The reflected member of the centered twin pair. -/
def twinMinus (z : ℂ) (u : ℝ) : ℂ := Complex.exp (-z * (u : ℂ))

/-- The algebraic hyperbolic imbalance of the twin pair. -/
def twinAffinity (z : ℂ) (u : ℝ) : ℝ := 2 * z.re * u

theorem twin_cosh (z : ℂ) (u : ℝ) :
    (twinPlus z u + twinMinus z u) / 2 = Complex.cosh (z * (u : ℂ)) := by
  simp [twinPlus, twinMinus, Complex.cosh]

theorem twinPlus_norm (z : ℂ) (u : ℝ) :
    ‖twinPlus z u‖ = Real.exp (z.re * u) := by
  simp [twinPlus, Complex.norm_exp, mul_re]

theorem twinMinus_norm (z : ℂ) (u : ℝ) :
    ‖twinMinus z u‖ = Real.exp (-z.re * u) := by
  simp [twinMinus, Complex.norm_exp, mul_re]

theorem twinAffinity_eq_log_norm_ratio (z : ℂ) (u : ℝ) :
    twinAffinity z u =
      Real.log (‖twinPlus z u‖ / ‖twinMinus z u‖) := by
  rw [twinPlus_norm, twinMinus_norm, ← Real.exp_sub]
  rw [Real.log_exp]
  simp [twinAffinity]
  ring

theorem twinAffinity_eq_zero_iff (z : ℂ) {u : ℝ} (hu : u ≠ 0) :
    twinAffinity z u = 0 ↔ z.re = 0 := by
  unfold twinAffinity
  constructor
  · intro h
    rcases mul_eq_zero.mp h with h | h
    · linarith
    · exact (hu h).elim
  · intro h
    simp [h]

theorem critical_twinAffinity (s : ℂ) (u : ℝ) :
    twinAffinity (s - (1 / 2 : ℂ)) u = (2 * s.re - 1) * u := by
  unfold twinAffinity
  have hhalf : ((1 / 2 : ℂ).re) = (1 / 2 : ℝ) := by norm_num
  rw [sub_re, hhalf]
  ring

theorem zero_affinity_iff_critical_line (s : ℂ) {u : ℝ} (hu : u ≠ 0) :
    twinAffinity (s - (1 / 2 : ℂ)) u = 0 ↔ s.re = 1 / 2 := by
  rw [critical_twinAffinity]
  constructor
  · intro h
    have hfac : 2 * s.re - 1 = 0 :=
      (mul_eq_zero.mp h).resolve_right hu
    linarith
  · intro h
    rw [h]
    ring

theorem balanced_twin_eq_cos (E u : ℝ) :
    (twinPlus ((E : ℂ) * Complex.I) u +
      twinMinus ((E : ℂ) * Complex.I) u) / 2 =
      (Real.cos (E * u) : ℂ) := by
  rw [twin_cosh]
  have harg : (E : ℂ) * Complex.I * (u : ℂ) =
      ((E * u : ℝ) : ℂ) * Complex.I := by
    push_cast
    ring
  rw [harg, Complex.cosh_mul_I, Complex.ofReal_cos]

/-! The unsymmetrized ancestor has both Fourier quadratures.  The previous
`balanced_twin_eq_cos` is its even projection, not the whole exponential mode. -/

theorem twinPlus_imaginary_axis_eq_cos_add_sin (E u : ℝ) :
    twinPlus ((E : ℂ) * Complex.I) u =
      (Real.cos (E * u) : ℂ) + (Real.sin (E * u) : ℂ) * Complex.I := by
  unfold twinPlus
  have harg : (E : ℂ) * Complex.I * (u : ℂ) =
      ((E * u : ℝ) : ℂ) * Complex.I := by
    push_cast
    ring
  rw [harg, Complex.exp_mul_I, Complex.ofReal_cos, Complex.ofReal_sin]

theorem twinMinus_imaginary_axis_eq_cos_sub_sin (E u : ℝ) :
    twinMinus ((E : ℂ) * Complex.I) u =
      (Real.cos (E * u) : ℂ) - (Real.sin (E * u) : ℂ) * Complex.I := by
  unfold twinMinus
  have harg : -((E : ℂ) * Complex.I) * (u : ℂ) =
      -((E * u : ℝ) : ℂ) * Complex.I := by
    push_cast
    ring
  rw [harg]
  have hneg : -((E * u : ℝ) : ℂ) * Complex.I =
      ((-(E * u) : ℝ) : ℂ) * Complex.I := by
    push_cast
    ring
  rw [hneg, Complex.exp_mul_I, Complex.ofReal_cos, Complex.ofReal_sin]
  simp
  ring

/-! ## One-sided Fourier ancestor: an actual Bochner quadrature theorem -/

/-- The one-sided complex Fourier mode generated by a real kernel. -/
def oneSidedFourierAncestor (Phi : ℝ → ℝ) (t : ℝ) : ℂ :=
  ∫ y : ℝ, (Phi y : ℂ) *
    Complex.exp (Complex.I * ((t * y : ℝ) : ℂ))

/-- The cosine quadrature of a real kernel. -/
def cosineQuadrature (Phi : ℝ → ℝ) (t : ℝ) : ℝ :=
  ∫ y : ℝ, Phi y * Real.cos (t * y)

/-- The sine quadrature of a real kernel. -/
def sineQuadrature (Phi : ℝ → ℝ) (t : ℝ) : ℝ :=
  ∫ y : ℝ, Phi y * Real.sin (t * y)

private lemma oneSidedFourierAncestor_integrable
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    Integrable (fun y : ℝ => (Phi y : ℂ) *
      Complex.exp (Complex.I * ((t * y : ℝ) : ℂ))) := by
  have hPhiC : Integrable (fun y : ℝ => (Phi y : ℂ)) := hPhi.ofReal
  refine hPhiC.mul_bdd
    (f := fun y : ℝ => (Phi y : ℂ))
    (g := fun y : ℝ => Complex.exp (Complex.I * ((t * y : ℝ) : ℂ)))
    (c := 1) ?_ ?_
  · fun_prop
  · exact Filter.Eventually.of_forall (fun y => by
    change ‖Complex.exp (Complex.I * ((t * y : ℝ) : ℂ))‖ ≤ 1
    have harg : Complex.I * ((t * y : ℝ) : ℂ) =
        ((t * y : ℝ) : ℂ) * Complex.I := by ring
    rw [harg, Complex.norm_exp]
    simp)

private lemma oneSidedFourierAncestor_integrand_eq
    (Phi : ℝ → ℝ) (t y : ℝ) :
    (Phi y : ℂ) * Complex.exp (Complex.I * ((t * y : ℝ) : ℂ)) =
      ((Phi y * Real.cos (t * y) : ℝ) : ℂ) +
        ((Phi y * Real.sin (t * y) : ℝ) : ℂ) * Complex.I := by
  have harg : Complex.I * ((t * y : ℝ) : ℂ) =
      ((t * y : ℝ) : ℂ) * Complex.I := by ring
  rw [harg, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
  push_cast
  ring

theorem oneSidedFourierAncestor_re
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    (oneSidedFourierAncestor Phi t).re = cosineQuadrature Phi t := by
  have hInt := oneSidedFourierAncestor_integrable (t := t) hPhi
  unfold oneSidedFourierAncestor cosineQuadrature
  calc
    (∫ y : ℝ, (Phi y : ℂ) *
        Complex.exp (Complex.I * ((t * y : ℝ) : ℂ))).re =
        ∫ y : ℝ, ((Phi y : ℂ) *
          Complex.exp (Complex.I * ((t * y : ℝ) : ℂ))).re :=
      (integral_re hInt).symm
    _ = ∫ y : ℝ, Phi y * Real.cos (t * y) := by
      apply integral_congr_ae
      filter_upwards [] with y
      rw [oneSidedFourierAncestor_integrand_eq]
      simp only [Complex.add_re, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, Complex.I_re, Complex.I_im, mul_zero, sub_zero,
        add_zero, zero_mul]

theorem oneSidedFourierAncestor_im
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    (oneSidedFourierAncestor Phi t).im = sineQuadrature Phi t := by
  have hInt := oneSidedFourierAncestor_integrable (t := t) hPhi
  unfold oneSidedFourierAncestor sineQuadrature
  calc
    (∫ y : ℝ, (Phi y : ℂ) *
        Complex.exp (Complex.I * ((t * y : ℝ) : ℂ))).im =
        ∫ y : ℝ, ((Phi y : ℂ) *
          Complex.exp (Complex.I * ((t * y : ℝ) : ℂ))).im :=
      (integral_im hInt).symm
    _ = ∫ y : ℝ, Phi y * Real.sin (t * y) := by
      apply integral_congr_ae
      filter_upwards [] with y
      rw [oneSidedFourierAncestor_integrand_eq]
      simp only [Complex.add_im, Complex.mul_im, Complex.ofReal_re,
        Complex.ofReal_im, Complex.I_re, Complex.I_im, mul_zero,
        add_zero]
      ring

theorem oneSidedFourierAncestor_eq_quadratures
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    oneSidedFourierAncestor Phi t =
      (cosineQuadrature Phi t : ℂ) +
        (sineQuadrature Phi t : ℂ) * Complex.I := by
  apply Complex.ext
  · simp [Complex.add_re, Complex.mul_re, oneSidedFourierAncestor_re hPhi]
  · simp [Complex.add_im, Complex.mul_im, oneSidedFourierAncestor_im hPhi]

theorem cosineQuadrature_neg (Phi : ℝ → ℝ) (t : ℝ) :
    cosineQuadrature Phi (-t) = cosineQuadrature Phi t := by
  unfold cosineQuadrature
  apply integral_congr_ae
  filter_upwards [] with y
  rw [neg_mul, Real.cos_neg]

theorem sineQuadrature_neg (Phi : ℝ → ℝ) (t : ℝ) :
    sineQuadrature Phi (-t) = -sineQuadrature Phi t := by
  unfold sineQuadrature
  rw [← integral_neg]
  apply integral_congr_ae
  filter_upwards [] with y
  rw [neg_mul, Real.sin_neg]
  ring

/-! A bilateral transform of an even real kernel has no sine channel.  This
separates the already-formalized centered projection from a future genuinely
oriented half-line transform. -/

theorem sineQuadrature_eq_zero_of_even
    (Phi : ℝ → ℝ) (hEven : ∀ y, Phi (-y) = Phi y) (t : ℝ) :
    sineQuadrature Phi t = 0 := by
  unfold sineQuadrature
  let g : ℝ → ℝ := fun y => Phi y * Real.sin (t * y)
  have hchange :
      (∫ y : ℝ, g (-y)) = ∫ y : ℝ, g y := by
    exact (Measure.measurePreserving_neg (volume : Measure ℝ)).integral_comp
      measurableEmbedding_neg g
  have hanti :
      (∫ y : ℝ, g y) = -(∫ y : ℝ, g y) := by
    calc
      (∫ y : ℝ, g y) = ∫ y : ℝ, g (-y) := hchange.symm
      _ = ∫ y : ℝ, -(g y) := by
        apply integral_congr_ae
        filter_upwards [] with y
        dsimp [g]
        rw [hEven]
        have hty : t * -y = -(t * y) := by ring
        rw [hty, Real.sin_neg]
        ring
      _ = -(∫ y : ℝ, g y) := MeasureTheory.integral_neg g
  linarith

theorem oneSidedFourierAncestor_eq_cosine_of_even
    {Phi : ℝ → ℝ} (hPhi : Integrable Phi)
    (hEven : ∀ y, Phi (-y) = Phi y) (t : ℝ) :
    oneSidedFourierAncestor Phi t = (cosineQuadrature Phi t : ℂ) := by
  rw [oneSidedFourierAncestor_eq_quadratures hPhi,
    sineQuadrature_eq_zero_of_even Phi hEven t]
  simp

theorem oneSidedFourierAncestor_neg_eq_conj
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    oneSidedFourierAncestor Phi (-t) =
      star (oneSidedFourierAncestor Phi t) := by
  rw [oneSidedFourierAncestor_eq_quadratures (t := -t) hPhi,
    cosineQuadrature_neg, sineQuadrature_neg,
    oneSidedFourierAncestor_eq_quadratures hPhi]
  simp [Complex.conj_ofReal]

/-! ## Even and odd frequency projections of the ancestor -/

/-- The even frequency projection of the oriented Fourier ancestor. -/
def oneSidedFourierAncestorEven (Phi : ℝ → ℝ) (t : ℝ) : ℂ :=
  (oneSidedFourierAncestor Phi t + oneSidedFourierAncestor Phi (-t)) / 2

/-- The odd frequency projection of the oriented Fourier ancestor. -/
def oneSidedFourierAncestorOdd (Phi : ℝ → ℝ) (t : ℝ) : ℂ :=
  (oneSidedFourierAncestor Phi t - oneSidedFourierAncestor Phi (-t)) / 2

theorem oneSidedFourierAncestorEven_eq_cosine
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    oneSidedFourierAncestorEven Phi t = (cosineQuadrature Phi t : ℂ) := by
  rw [oneSidedFourierAncestorEven,
    oneSidedFourierAncestor_eq_quadratures hPhi,
    oneSidedFourierAncestor_eq_quadratures (t := -t) hPhi,
    cosineQuadrature_neg, sineQuadrature_neg]
  push_cast
  ring

theorem oneSidedFourierAncestorOdd_eq_sine
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    oneSidedFourierAncestorOdd Phi t =
      (sineQuadrature Phi t : ℂ) * Complex.I := by
  rw [oneSidedFourierAncestorOdd,
    oneSidedFourierAncestor_eq_quadratures hPhi,
    oneSidedFourierAncestor_eq_quadratures (t := -t) hPhi,
    cosineQuadrature_neg, sineQuadrature_neg]
  push_cast
  ring

/-! ## The real Hestenes/Krein form of the same ancestor -/

open InfoGeometry.Geometry

/-- The real two-component ancestor: cosine channel plus oriented sine channel.
The coordinates are the scalar and bivector coefficients in the existing
`RealChiralPhase` carrier. -/
def hestenesAncestor (Phi : ℝ → ℝ) (t : ℝ) : RealChiralPhase where
  scalar := cosineQuadrature Phi t
  bivector := sineQuadrature Phi t

/-! The Madelung-style quadratic amplitude of the oriented real ancestor.
This is only the native rotor norm readout: it does not assert a wave equation
or identify the ancestor with a quantum state. -/
theorem hestenesAncestor_neg (Phi : ℝ → ℝ) (t : ℝ) :
    hestenesAncestor Phi (-t) =
      { scalar := cosineQuadrature Phi t, bivector := -sineQuadrature Phi t } := by
  ext
  · exact cosineQuadrature_neg Phi t
  · exact sineQuadrature_neg Phi t

/-- Complexification of the real Hestenes ancestor is the one-sided Fourier
ancestor already defined above. -/
theorem hestenesAncestor_complexification
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    ((hestenesAncestor Phi t).scalar : ℂ) +
        (hestenesAncestor Phi t).bivector * Complex.I =
      oneSidedFourierAncestor Phi t := by
  rw [oneSidedFourierAncestor_eq_quadratures hPhi]
  rfl

/-! The Madelung density is the squared norm of the two real quadratures. -/

theorem hestenesAncestor_density_eq_complexification_normSq
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    RealChiralPhase.normSq (hestenesAncestor Phi t) =
      Complex.normSq (oneSidedFourierAncestor Phi t) := by
  rw [← hestenesAncestor_complexification hPhi]
  simp [RealChiralPhase.normSq, Complex.normSq, pow_two]

theorem hestenesAncestor_density_nonneg
    (Phi : ℝ → ℝ) (t : ℝ) :
    0 ≤ RealChiralPhase.normSq (hestenesAncestor Phi t) := by
  exact RealChiralPhase.normSq_nonneg _

/-! The density derivative is conditional only on the two native quadrature
derivatives; no differentiability of the integral is hidden here. -/

theorem hasDerivAt_hestenesAncestor_density
    {Phi : ℝ → ℝ} {t dcos dsin : ℝ}
    (hcos : HasDerivAt (cosineQuadrature Phi) dcos t)
    (hsin : HasDerivAt (sineQuadrature Phi) dsin t) :
    HasDerivAt
      (fun u => RealChiralPhase.normSq (hestenesAncestor Phi u))
      (2 * cosineQuadrature Phi t * dcos +
        2 * sineQuadrature Phi t * dsin) t := by
  exact RealChiralPhase.hasDerivAt_normSq_of_components
    (cosineQuadrature Phi) (sineQuadrature Phi) dcos dsin t hcos hsin

theorem hestenesAncestor_compatibility_complexification
    {Phi : ℝ → ℝ} {t : ℝ} (hPhi : Integrable Phi) :
    chiralToComplex (realChiralPhaseEquiv (hestenesAncestor Phi t)) =
      oneSidedFourierAncestor Phi t := by
  rw [chiralToComplex_eq_scalar_add_bivector_I]
  simp only [realChiralPhaseEquiv_scalar, realChiralPhaseEquiv_bivector]
  exact hestenesAncestor_complexification hPhi

theorem oneSidedFourierAncestor_eq_even_add_odd
    (Phi : ℝ → ℝ) (t : ℝ) :
    oneSidedFourierAncestorEven Phi t + oneSidedFourierAncestorOdd Phi t =
      oneSidedFourierAncestor Phi t := by
  unfold oneSidedFourierAncestorEven oneSidedFourierAncestorOdd
  ring

theorem centeredXi_twin_reflection (z : ℂ) :
    symmetryAdaptedXi z = symmetryAdaptedXi (-z) :=
  symmetryAdaptedXi_is_even z

/-! ## Algebraic Weyl projections -/

/-- The Weyl-even part of a function under `s ↦ 1 - s`. -/
def weylEvenPart (F : ℂ → ℂ) (s : ℂ) : ℂ :=
  (F s + F (1 - s)) / 2

/-- The Weyl-odd part of a function under `s ↦ 1 - s`. -/
def weylOddPart (F : ℂ → ℂ) (s : ℂ) : ℂ :=
  (F s - F (1 - s)) / 2

theorem weylEvenPart_one_sub (F : ℂ → ℂ) (s : ℂ) :
    weylEvenPart F (1 - s) = weylEvenPart F s := by
  unfold weylEvenPart
  ring_nf

theorem weylOddPart_one_sub (F : ℂ → ℂ) (s : ℂ) :
    weylOddPart F (1 - s) = -weylOddPart F s := by
  unfold weylOddPart
  ring_nf

theorem weylEvenPart_add_weylOddPart (F : ℂ → ℂ) (s : ℂ) :
    weylEvenPart F s + weylOddPart F s = F s := by
  unfold weylEvenPart weylOddPart
  ring

theorem riemannXi_weylEvenPart (s : ℂ) :
    weylEvenPart riemannXi s = riemannXi s := by
  unfold weylEvenPart
  rw [InfoGeometry.Arithmetic.RiemannZetaEquivalences.riemannXi_one_sub]
  ring

theorem riemannXi_weylOddPart (s : ℂ) :
    weylOddPart riemannXi s = 0 := by
  unfold weylOddPart
  rw [InfoGeometry.Arithmetic.RiemannZetaEquivalences.riemannXi_one_sub]
  ring

/-! ## Abstract analytic target -/

/--
The theorem-honest interface for a future centered `Xi`/theta integral
representation.  This definition records the target without asserting that a
particular kernel or integration functional realizes it.
-/
theorem centeredXiTwinIntegral_eq_cosh_iff
    (Xi : ℂ → ℂ)
    (Phi : ℝ → ℂ)
    (integral : (ℝ → ℂ) → ℂ) :
    (∀ z : ℂ,
      Xi z = integral (fun u => Phi u *
        ((twinPlus z u + twinMinus z u) / 2))) ↔
      ∀ z : ℂ,
        Xi z = integral (fun u => Phi u * Complex.cosh (z * (u : ℂ))) := by
  constructor
  · intro h z
    simpa only [twin_cosh] using h z
  · intro h z
    simpa only [twin_cosh] using h z

end InfoGeometry.Arithmetic.CenteredXiTwinKernel
