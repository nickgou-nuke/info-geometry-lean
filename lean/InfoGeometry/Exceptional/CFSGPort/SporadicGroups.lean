@[expose] def asciiWhitespace (c : Char) : Bool :=
  c == ' ' || c == '\t' || c == '\n' || c == '\r' || c.toNat == 11 || c.toNat == 12

@[expose] def decode (p d mode : ℕ) (s : String) : Matrix (Fin d) (Fin d) (ZMod p) :=
  let body := (s.toList.dropWhile (· != '\n')).drop 1
  let entries : List ℕ := if mode = 1 then
    (body.filter fun c => !asciiWhitespace c).map fun c =>
      if '0' ≤ c && c ≤ '9' then c.toNat - '0'.toNat else 0
    else
      ((String.ofList (body.map fun c => if asciiWhitespace c then ' ' else c)).splitOn " ").filter
        (· != "") |>.map fun token =>
          if token.toList.all (fun c => '0' ≤ c && c ≤ '9') then token.toNat?.getD 0 else 0
  fun i j => (entries[i.val * d + j.val]?.getD 0 : ZMod p)

@[expose] def seedMonoid (p d mode : ℕ) (s₁ s₂ : String) :
    Submonoid (Matrix (Fin d) (Fin d) (ZMod p)) :=
  Submonoid.closure {decode p d mode s₁, decode p d mode s₂}

abbrev MatrixSeedGroup (p d mode : ℕ) (s₁ s₂ : String) :=
  (seedMonoid p d mode s₁ s₂)ˣ

/-- For a finite matrix monoid, the unit group generated by two matrices is
isomorphic to the subgroup of the general linear group generated by the
corresponding units. This ports CFSG's seed-carrier identification without
importing its incompatible toolchain or proof dependencies. -/
theorem unit_seed_closure_eq_ofUnits {M : Type*} [Monoid M] [Finite M]
    (a b : Mˣ) :
    Submonoid.closure ({(a : M), (b : M)} : Set M) =
      (Subgroup.closure ({a, b} : Set Mˣ)).ofUnits := by
  change Submonoid.closure ({(a : M), (b : M)} : Set M) =
    (Subgroup.closure ({a, b} : Set Mˣ)).toSubmonoid.map (Units.coeHom M)
  rw [Subgroup.closure_toSubmonoid_of_finite, MonoidHom.map_mclosure]
  simp

noncomputable def unitSeedEquiv {M : Type*} [Monoid M] [Finite M]
    (a b : Mˣ) :
    (Submonoid.closure ({(a : M), (b : M)} : Set M))ˣ ≃*
      Subgroup.closure ({a, b} : Set Mˣ) :=
  (Submonoid.unitsEquivUnitsType _).symm.trans
    (MulEquiv.subgroupCongr (by
      rw [unit_seed_closure_eq_ofUnits, Subgroup.units_ofUnits_eq]))

noncomputable def matrixSeedEquiv (p d mode : ℕ) [Fact p.Prime]
    (s₁ s₂ : String) (h₁ : (decode p d mode s₁).det ≠ 0)
    (h₂ : (decode p d mode s₂).det ≠ 0) :
    MatrixSeedGroup p d mode s₁ s₂ ≃*
      Subgroup.closure
        ({Matrix.GeneralLinearGroup.mkOfDetNeZero (decode p d mode s₁) h₁,
          Matrix.GeneralLinearGroup.mkOfDetNeZero (decode p d mode s₂) h₂} :
          Set (Matrix.GeneralLinearGroup (Fin d) (ZMod p))) := by
  exact unitSeedEquiv
    (Matrix.GeneralLinearGroup.mkOfDetNeZero (decode p d mode s₁) h₁)
    (Matrix.GeneralLinearGroup.mkOfDetNeZero (decode p d mode s₂) h₂)

/-- The seed-carrier equivalence for two explicitly supplied matrices. -/
noncomputable def matrixPairSeedEquiv {p d : ℕ} [Fact p.Prime]
    (A B : Matrix (Fin d) (Fin d) (ZMod p)) (hA : A.det ≠ 0) (hB : B.det ≠ 0) :
    (Submonoid.closure ({A, B} : Set (Matrix (Fin d) (Fin d) (ZMod p))))ˣ ≃*
      Subgroup.closure
        ({Matrix.GeneralLinearGroup.mkOfDetNeZero A hA,
          Matrix.GeneralLinearGroup.mkOfDetNeZero B hB} :
          Set (Matrix.GeneralLinearGroup (Fin d) (ZMod p))) :=
  unitSeedEquiv (Matrix.GeneralLinearGroup.mkOfDetNeZero A hA)
    (Matrix.GeneralLinearGroup.mkOfDetNeZero B hB)

@[expose] def M11 : Subgroup (Equiv.Perm (Fin 11)) :=
  Subgroup.closure {(List.formPerm [1, 9] * List.formPerm [3, 10] *
      List.formPerm [4, 6] * List.formPerm [7, 8]),
    (List.formPerm [0, 3, 2, 7] * List.formPerm [1, 4, 5, 8])}

/-- The first seed permutation in the external CFSG M₁₁ realization. -/
def m11SeedA : M11 :=
  ⟨List.formPerm [1, 9] * List.formPerm [3, 10] *
      List.formPerm [4, 6] * List.formPerm [7, 8],
    Subgroup.subset_closure (by simp)⟩

/-- The second seed permutation in the external CFSG M₁₁ realization. -/
def m11SeedB : M11 :=
  ⟨List.formPerm [0, 3, 2, 7] * List.formPerm [1, 4, 5, 8],
    Subgroup.subset_closure (by simp)⟩

/-- The two local M₁₁ seed permutations do not commute. This is a small
carrier-level fact used to rule out abelian degeneracies in later simplicity
ports. -/
theorem m11Seed_noncommute : m11SeedA * m11SeedB ≠ m11SeedB * m11SeedA := by
  decide

theorem m11SeedA_sq : m11SeedA ^ 2 = 1 := by
  decide

set_option maxRecDepth 10000 in
theorem m11SeedB_fourth : m11SeedB ^ 4 = 1 := by
  decide

private theorem m11SeedA_ne_one : m11SeedA ≠ 1 := by
  decide

theorem m11SeedA_order : orderOf m11SeedA = 2 := by
  let _ : Fact (Nat.Prime 2) := ⟨by norm_num⟩
  exact orderOf_eq_prime m11SeedA_sq m11SeedA_ne_one

theorem m11SeedB_order : orderOf m11SeedB = 4 := by
  let _ : Fact (Nat.Prime 2) := ⟨by norm_num⟩
  apply orderOf_eq_prime_pow (p := 2) (n := 1)
  · intro h
    have hnot : m11SeedB ^ 2 ≠ (1 : M11) := by decide
    exact hnot (by simpa using h)
  · simpa [pow_mul] using m11SeedB_fourth

/-- If a subgroup is generated by two elements, the corresponding two
elements generate its subtype group. -/
theorem closure_pair_eq_top_of_eq_closure {M : Type*} [Group M] {K : Subgroup M}
    {x y : M} (hK : K = Subgroup.closure ({x, y} : Set M))
    (hx : x ∈ K) (hy : y ∈ K) :
    Subgroup.closure ({⟨x, hx⟩, ⟨y, hy⟩} : Set K) = ⊤ := by
  subst hK
  refine Eq.trans ?_ (Subgroup.closure_closure_coe_preimage (k := {x, y}))
  congr 1
  ext ⟨g, hg⟩
  simp [Subtype.ext_iff]

/-- The canonical M₁₁ seed pair generates the local permutation carrier. -/
theorem m11Seed_closure_eq_top :
    Subgroup.closure ({m11SeedA, m11SeedB} : Set M11) = ⊤ := by
  exact closure_pair_eq_top_of_eq_closure rfl
    (Subgroup.subset_closure (by simp))
    (Subgroup.subset_closure (by simp))

/-- The local M₁₁ carrier is finite as a subgroup of the finite permutation
group on eleven points. -/
theorem m11_finite : Finite M11 := inferInstance

/-- The local M₁₁ carrier is nontrivial, witnessed by its first seed. -/
theorem m11_nontrivial : Nontrivial M11 :=
  nontrivial_of_ne m11SeedA 1 m11SeedA_ne_one

