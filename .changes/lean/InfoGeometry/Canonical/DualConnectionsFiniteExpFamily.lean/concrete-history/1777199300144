{"type":"new","contents":"import InfoGeometry.Canonical.DualConnectionsCore\nimport InfoGeometry.Information.MultiLogPotential\nimport Mathlib.Tactic.Ring\nset_option linter.unusedSimpArgs false\n\nopen scoped BigOperators\n\n/-!\n# Canonical.DualConnectionsFiniteExpFamily\n\nConcrete bridge between finite exponential-family Fisher/covariance objects and\nthe `alphaConnectionTensor` API.\n-/\n\nnamespace InfoGeometry.Canonical.DualConnections\n\nopen InfoGeometry.Information\n\nvariable {α : Type*} [Fintype α] [Nonempty α]\nvariable {d : ℕ}\n\n/-- The finite-exponential-family density at `θ` packaged as `FinProb`. -/\nnoncomputable def finiteExpFamilyFinProb\n    (F : FiniteExpFamily (α := α) d)\n    (θ : Fin d → ℝ) : InfoGeometry.FinProb α := by\n  classical\n  have hnonneg :\n      ∀ x ∈ (Finset.univ : Finset α), 0 ≤ density F θ x := by\n    intro x hx\n    exact density_nonneg (F := F) (θ := θ) (x := x)\n  have hsum :\n      ∑ x, ENNReal.ofReal (density F θ x) = 1 := by\n    calc\n      ∑ x, ENNReal.ofReal (density F θ x)\n          = ENNReal.ofReal (∑ x, density F θ x) := by\n              simpa using\n                (ENNReal.ofReal_sum_of_nonneg\n                  (s := (Finset.univ : Finset α))\n                  (f := fun x => density F θ x)\n                  hnonneg).symm\n      _ = ENNReal.ofReal 1 := by\n            simp [density_sum_one (F := F) (θ := θ)]\n      _ = 1 := by simp\n  exact InfoGeometry.FinProb.of_fintype (fun x => ENNReal.ofReal (density F θ x)) hsum\n\n/-- Probability map induced by a finite exponential family. -/\nnoncomputable def finiteExpFamilyProbMap\n    (F : FiniteExpFamily (α := α) d) :\n    (Fin d → ℝ) → InfoGeometry.FinProb α :=\n  finiteExpFamilyFinProb F\n\n@[simp] lemma finiteExpFamilyProbMap_apply\n    (F : FiniteExpFamily (α := α) d)\n    (θ : Fin d → ℝ) (x : α) :\n    finiteExpFamilyProbMap F θ x = ENNReal.ofReal (density F θ x) := by\n  simp [finiteExpFamilyProbMap, finiteExpFamilyFinProb, InfoGeometry.FinProb.of_fintype]\n\nlemma finiteExpFamilyProbMap_apply_toReal\n    (F : FiniteExpFamily (α := α) d)\n    (θ : Fin d → ℝ) (x : α) :\n    (finiteExpFamilyProbMap F θ x).toReal = density F θ x := by\n  have hnonneg : 0 ≤ density F θ x := density_nonneg (F := F) (θ := θ) (x := x)\n  simpa [finiteExpFamilyProbMap_apply] using (ENNReal.toReal_ofReal hnonneg)\n\n/-- Fisher/covariance bilinear form in parameter coordinates. -/\nnoncomputable def fisherCovarianceBilinear\n    (F : FiniteExpFamily (α := α) d)\n    (θ : Fin d → ℝ)\n    (u v : Fin d → ℝ) : ℝ :=\n  ∑ i, ∑ j, u i * InfoGeometry.Information.fisherMetric F θ i j * v j\n\nomit [Nonempty α] in\n@[simp] lemma fisherMetric_eq_covariance\n    (F : FiniteExpFamily (α := α) d)\n    (θ : Fin d → ℝ)\n    (i j : Fin d) :\n    InfoGeometry.Information.fisherMetric F θ i j = covariance F θ i j := rfl\n\n/-- Score field generated by a parameter direction using centered statistics. -/\nnoncomputable def centeredScore\n    (F : FiniteExpFamily (α := α) d)\n    (θ : Fin d → ℝ)\n    (v : Fin d → ℝ) : FiberTangent α :=\n  fun x => centeredLinearStat F θ v x\n\n/-- `fisherBilinear` specializes to expectation of pointwise products for this family. -/\nlemma fisherBilinear_eq_expectation_mul\n    (F : FiniteExpFamily (α := α) d)\n    (θ : Fin d → ℝ)\n    (u v : FiberTangent α) :\n    fisherBilinear (p := finiteExpFamilyProbMap F) θ u v\n      = InfoGeometry.Information.expectation F θ (fun x => u x * v x) := by\n  unfold fisherBilinear InfoGeometry.Information.expectation\n  refine Finset.sum_congr rfl ?_\n  intro x _hx\n  have hnonneg : 0 ≤ density F θ x := density_nonneg (F := F) (θ := θ) (x := x)\n  simp [finiteExpFamilyProbMap_apply, ENNReal.toReal_ofReal, hnonneg, mul_assoc, mul_comm, mul_left_comm]\n\n/--\nConcrete Fisher bridge:\nthe finite-family Fisher quadratic form equals `fisherBilinear` evaluated on the\ncentered score field induced by the same direction.\n-/\nlemma fisherQuadratic_eq_fisherBilinear_centeredScore\n    (F : FiniteExpFamily (α := α) d)\n    (θ v : Fin d → ℝ) :\n    InfoGeometry.Information.fisherQuadratic F θ v\n      = fisherBilinear (p := finiteExpFamilyProbMap F) θ\n          (centeredScore F θ v) (centeredScore F θ v) := by\n  rw [InfoGeometry.Information.fisher_as_variance (F := F) (θ := θ) (v := v)]\n  have hsq :\n      InfoGeometry.Information.expectation F θ\n          (fun x => InfoGeometry.Information.centeredLinearStat F θ v x ^ (2 : ℕ))\n        =\n      InfoGeometry.Information.expectation F θ\n          (fun x => centeredScore F θ v x * centeredScore F θ v x) := by\n    unfold InfoGeometry.Information.expectation centeredScore\n    refine Finset.sum_congr rfl ?_\n    intro x _hx\n    ring\n  rw [hsq]\n  rw [← fisherBilinear_eq_expectation_mul (F := F) (θ := θ)\n      (u := centeredScore F θ v) (v := centeredScore F θ v)]\n\n/-- `alphaConnectionTensor` specialized to the finite-family probability map. -/\nnoncomputable def finiteExpFamilyAlphaConnectionTensor\n    (F : FiniteExpFamily (α := α) d)\n    (Gamma0 : ConnectionTensor (Fin d → ℝ) α)\n    (αc : ℝ) : ConnectionTensor (Fin d → ℝ) α :=\n  alphaConnectionTensor Gamma0 (finiteExpFamilyProbMap F) αc\n\n/-- Canonical bundled `α`-connection carried by a finite exponential family. -/\nnoncomputable def finiteExpFamilyAlphaConnection\n    (F : FiniteExpFamily (α := α) d)\n    (Gamma0 : ConnectionTensor (Fin d → ℝ) α)\n    (αc : ℝ) :\n    alphaConnection (p := finiteExpFamilyProbMap F) αc :=\n  alphaConnection.mkFromReference\n    (p := finiteExpFamilyProbMap F)\n    (αc := αc)\n    (Gamma0 := Gamma0)\n    (hFisher := fisherMetric_of_finProb (p := finiteExpFamilyProbMap F))\n    (hChentsov := amariChentsovTensor_of_finProb (p := finiteExpFamilyProbMap F))\n\n@[simp] lemma finiteExpFamilyAlphaConnection_deformation\n    (F : FiniteExpFamily (α := α) d)\n    (Gamma0 : ConnectionTensor (Fin d → ℝ) α)\n    (αc : ℝ) :\n    (finiteExpFamilyAlphaConnection (F := F) Gamma0 αc).Gamma\n      = finiteExpFamilyAlphaConnectionTensor (F := F) Gamma0 αc := by\n  rfl\n\nend InfoGeometry.Canonical.DualConnections\n","mtime":1777199300144}