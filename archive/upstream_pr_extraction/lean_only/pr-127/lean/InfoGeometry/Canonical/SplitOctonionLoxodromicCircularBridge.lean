import Mathlib.Tactic
import Mathlib.Analysis.Complex.Exponential
import InfoGeometry.Canonical.SplitOctonionQuaternionChart
import InfoGeometry.Canonical.SplitOctonionExpLog
import InfoGeometry.Canonical.SplitOctonionQuaternionPolar
import InfoGeometry.Canonical.SplitOctonionHyperbolicPolarStructure

noncomputable section

namespace SplitOctonion

/-- Compact imaginary generator I_g = (g, 0). -/
def I_gen (g : H) : SplitOctonion :=
  ⟨g, 0⟩

@[simp]
theorem I_gen_sq (g : H) (hg : star g = -g) (hn : Quaternion.normSq g = 1) :
    I_gen g * I_gen g = -1 := by
  apply SplitOctonion.ext
  · dsimp [Mul.mul, Zero.zero, One.one, I_gen]
    simp
    have h_star : star g * g = (Quaternion.normSq g : ℝ) • (1 : H) := H_star_mul_self g
    rw [hn, one_smul] at h_star
    have h_sq : g * g = -1 := by
      calc g * g = - (- (g * g)) := by rw [neg_neg]
        _ = - ((-g) * g) := by rw [neg_mul g g]
        _ = - (star g * g) := by rw [hg]
        _ = -1 := by rw [h_star]
    exact h_sq
  · dsimp [Mul.mul, Zero.zero, One.one, I_gen]
    simp

/-- I_gen and J_g actually anticommute as elements of SplitOctonion. -/
theorem I_gen_J_g_anticommute (g h : H) (hg : star g = -g) :
    I_gen g * J_g h = - (J_g h * I_gen g) := by
  apply SplitOctonion.ext
  · dsimp [Mul.mul, Zero.zero, One.one, I_gen, J_g]
    simp
  · dsimp [Mul.mul, Zero.zero, One.one, I_gen, J_g]
    simp
    have h1 : h * -g = -(h * g) := mul_neg h g
    rw [hg, h1, neg_neg]

/-- The circular exponential sector generated by I_gen g. -/
theorem exp_elliptic_I_gen (theta : ℝ) (g : H) :
    expElliptic 1 theta (I_gen g) = ⟨Real.cos theta • (1 : H) + Real.sin theta • g, 0⟩ := by
  unfold expElliptic I_gen
  apply SplitOctonion.ext
  · dsimp [Add.add, SMul.smul, Zero.zero, One.one]
    simp
  · dsimp [Add.add, SMul.smul, Zero.zero, One.one]
    simp

end SplitOctonion
