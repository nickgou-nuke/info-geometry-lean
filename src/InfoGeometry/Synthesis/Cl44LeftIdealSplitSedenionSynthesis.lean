/-!
## Section 1: The $\mathrm{Cl}(4,4)$ Witt Null Basis & Four-Mode Vacuum Idempotent
-/

/-- The $k$-th Witt mode projector $P_k = a_k a_k^\dagger \in \mathrm{Cl}(4,4)$ ($k \in \mathrm{Fin}\, 4$). -/
def wittModeProj (k : Fin 4) : Cl44 :=
  a k * adag k

/-- The four-mode vacuum idempotent candidate $f = P_0 P_1 P_2 P_3 \in \mathrm{Cl}(4,4)$. -/
def cl44VacuumIdempotent : Cl44 :=
  wittModeProj 0 * wittModeProj 1 * wittModeProj 2 * wittModeProj 3

/-- Distinct number projectors commute, by the four cross-mode CAR swaps. -/
theorem wittModeProj_commute (i j : Fin 4) :
    wittModeProj i * wittModeProj j = wittModeProj j * wittModeProj i := by
  by_cases hij : i = j
  · subst j
    rfl
  · have haa : a i * a j = -(a j * a i) :=
      eq_neg_of_add_eq_zero_left (witt_annihilation_anticomm i j)
    have hdd : adag i * adag j = -(adag j * adag i) :=
      eq_neg_of_add_eq_zero_left (witt_creation_anticomm i j)
    have hda : adag i * a j = -(a j * adag i) :=
      eq_neg_of_add_eq_zero_left (by
        simpa [add_comm] using witt_CAR_ne j i (Ne.symm hij))
    have had : a i * adag j = -(adag j * a i) :=
      eq_neg_of_add_eq_zero_left (witt_CAR_ne i j hij)
    dsimp [wittModeProj]
    change (a i * adag i) * (a j * adag j) =
      (a j * adag j) * (a i * adag i)
    calc
      a i * adag i * (a j * adag j) =
          a i * (adag i * a j) * adag j := by noncomm_ring
      _ = a i * (-(a j * adag i)) * adag j := by rw [hda]
      _ = -(a i * a j * adag i * adag j) := by noncomm_ring
      _ = a j * a i * adag i * adag j := by rw [haa]; noncomm_ring
      _ = -(a j * a i * (adag j * adag i)) := by
        rw [mul_assoc (a j * a i) (adag i) (adag j), hdd]
        rw [mul_neg]
      _ = a j * (-(a i * adag j)) * adag i := by noncomm_ring
      _ = a j * (adag j * a i) * adag i := by rw [had]; noncomm_ring
      _ = (a j * adag j) * (a i * adag i) := by noncomm_ring

/-- An annihilation generator commutes with a number projector belonging to
a different mode. -/
theorem annihilation_commute_wittModeProj {i j : Fin 4} (hij : i ≠ j) :
    a i * wittModeProj j = wittModeProj j * a i := by
  have haa : a i * a j = -(a j * a i) :=
    eq_neg_of_add_eq_zero_left (witt_annihilation_anticomm i j)
  have had : a i * adag j = -(adag j * a i) :=
    eq_neg_of_add_eq_zero_left (witt_CAR_ne i j hij)
  dsimp [wittModeProj]
  change a i * (a j * adag j) = (a j * adag j) * a i
  calc
    a i * (a j * adag j) = (a i * a j) * adag j := by rw [mul_assoc]
    _ = -(a j * a i) * adag j := by rw [haa]
    _ = a j * (adag j * a i) := by
      calc
        _ = a j * (-(a i * adag j)) := by noncomm_ring
        _ = a j * (adag j * a i) := by rw [had]; simp
    _ = a j * adag j * a i := by rw [← mul_assoc]

/-- The ordered product of the four mode projectors is idempotent. -/
theorem cl44VacuumIdempotent_idempotent :
    cl44VacuumIdempotent * cl44VacuumIdempotent = cl44VacuumIdempotent := by
  have hp : ∀ i : Fin 4, wittModeProj i * wittModeProj i = wittModeProj i := by
    intro i
    exact P_plus_sq (a i) (adag i) (a_sq_zero i) (witt_CAR_eq i)
  have h01 := wittModeProj_commute (0 : Fin 4) 1
  have h02 := wittModeProj_commute (0 : Fin 4) 2
  have h03 := wittModeProj_commute (0 : Fin 4) 3
  have h12 := wittModeProj_commute (1 : Fin 4) 2
  have h13 := wittModeProj_commute (1 : Fin 4) 3
  have h23 := wittModeProj_commute (2 : Fin 4) 3
  let p0 := wittModeProj (0 : Fin 4)
  let p1 := wittModeProj (1 : Fin 4)
  let p2 := wittModeProj (2 : Fin 4)
  let p3 := wittModeProj (3 : Fin 4)
  have h01 : p0 * p1 = p1 * p0 := h01
  have h02 : p0 * p2 = p2 * p0 := h02
  have h03 : p0 * p3 = p3 * p0 := h03
  have h12 : p1 * p2 = p2 * p1 := h12
  have h13 : p1 * p3 = p3 * p1 := h13
  have h23 : p2 * p3 = p3 * p2 := h23
  have hc01 : Commute p0 p1 := h01
  have hc02 : Commute p0 p2 := h02
  have hc03 : Commute p0 p3 := h03
  have hc12 : Commute p1 p2 := h12
  have hc13 : Commute p1 p3 := h13
  have hc23 : Commute p2 p3 := h23
  have hp0 : IsIdempotentElem p0 := hp 0
  have hp1 : IsIdempotentElem p1 := hp 1
  have hp2 : IsIdempotentElem p2 := hp 2
  have hp3 : IsIdempotentElem p3 := hp 3
  have hq01 : IsIdempotentElem (p0 * p1) :=
    IsIdempotentElem.mul_of_commute hc01 hp0 hp1
  have hq012 : IsIdempotentElem ((p0 * p1) * p2) :=
    IsIdempotentElem.mul_of_commute (Commute.mul_left hc02 hc12) hq01 hp2
  have hq0123 : IsIdempotentElem (((p0 * p1) * p2) * p3) :=
    IsIdempotentElem.mul_of_commute
      (Commute.mul_left (Commute.mul_left hc03 hc13) hc23) hq012 hp3
  change (((p0 * p1) * p2) * p3) * (((p0 * p1) * p2) * p3) =
      ((p0 * p1) * p2) * p3
  exact hq0123

private theorem annihilation_mul_wittModeProj_self (i : Fin 4) :
    a i * wittModeProj i = 0 := by
  change a i * (a i * adag i) = 0
  rw [← mul_assoc, a_sq_zero, zero_mul]

private theorem cl44VacuumIdempotent_rightAssoc :
    cl44VacuumIdempotent = wittModeProj 0 *
      (wittModeProj 1 * (wittModeProj 2 * wittModeProj 3)) := by
  unfold cl44VacuumIdempotent
  noncomm_ring

/-- Every one of the four annihilation generators kills the composite
vacuum idempotent. -/
theorem cl44VacuumIdempotent_annihilated (i : Fin 4) :
    a i * cl44VacuumIdempotent = 0 := by
  fin_cases i
  · have ha := annihilation_mul_wittModeProj_self 0
    unfold cl44VacuumIdempotent
    calc
      a 0 * (wittModeProj 0 * wittModeProj 1 * wittModeProj 2 * wittModeProj 3) =
          (a 0 * wittModeProj 0) * wittModeProj 1 * wittModeProj 2 * wittModeProj 3 := by noncomm_ring
      _ = 0 := by rw [ha]; noncomm_ring
  · have ha := annihilation_mul_wittModeProj_self 1
    have h0 := annihilation_commute_wittModeProj (i := 1) (j := 0) (by decide)
    rw [cl44VacuumIdempotent_rightAssoc]
    have hc0 : Commute (a 1) (wittModeProj 0) := h0
    change a 1 * (wittModeProj 0 * (wittModeProj 1 * (wittModeProj 2 * wittModeProj 3))) = 0
    rw [hc0.left_comm, ← mul_assoc (a 1) (wittModeProj 1)
      (wittModeProj 2 * wittModeProj 3), ha]
    simp
  · have ha := annihilation_mul_wittModeProj_self 2
    have h0 := annihilation_commute_wittModeProj (i := 2) (j := 0) (by decide)
    have h1 := annihilation_commute_wittModeProj (i := 2) (j := 1) (by decide)
    rw [cl44VacuumIdempotent_rightAssoc]
    have hc0 : Commute (a 2) (wittModeProj 0) := h0
    have hc1 : Commute (a 2) (wittModeProj 1) := h1
    change a 2 * (wittModeProj 0 * (wittModeProj 1 * (wittModeProj 2 * wittModeProj 3))) = 0
    rw [hc0.left_comm, hc1.left_comm,
      ← mul_assoc (a 2) (wittModeProj 2) (wittModeProj 3), ha]
    simp
  · have ha := annihilation_mul_wittModeProj_self 3
    have h0 := annihilation_commute_wittModeProj (i := 3) (j := 0) (by decide)
    have h1 := annihilation_commute_wittModeProj (i := 3) (j := 1) (by decide)
    have h2 := annihilation_commute_wittModeProj (i := 3) (j := 2) (by decide)
    rw [cl44VacuumIdempotent_rightAssoc]
    have hc0 : Commute (a 3) (wittModeProj 0) := h0
    have hc1 : Commute (a 3) (wittModeProj 1) := h1
    have hc2 : Commute (a 3) (wittModeProj 2) := h2
    change a 3 * (wittModeProj 0 * (wittModeProj 1 * (wittModeProj 2 * wittModeProj 3))) = 0
    rw [hc0.left_comm, hc1.left_comm, hc2.left_comm, ha]
    simp

/-- **Theorem 1.1 ($\mathrm{Cl}(4,4)$ Orthonormal & Witt Null CAR Packet)**:
1. The orthonormal generators $e_k, f_k \in \mathrm{Cl}(4,4)$ satisfy $e_k^2 = +1$, $f_k^2 = -1$,
   and $e_j f_k + f_k e_j = 0$.
2. The Witt lightcone generators $a_k, a_k^\dagger \in \mathrm{Cl}(4,4)$ are totally isotropic
   ($a_k^2 = 0$, $(a_k^\dagger)^2 = 0$) and satisfy the canonical anticommutation relations
   $\{a_j, a_k\} = 0$, $\{a_j^\dagger, a_k^\dagger\} = 0$, and $\{a_j, a_k^\dagger\} = \delta_{jk}\mathbf{1}$. -/
theorem cl44_witt_null_car_synthesis :
    (∀ k : Fin 4, e k * e k = 1) ∧
    (∀ k : Fin 4, f k * f k = -(1 : Cl44)) ∧
    (∀ j k : Fin 4, e j * f k + f k * e j = 0) ∧
    (∀ k : Fin 4, a k * a k = 0) ∧
    (∀ k : Fin 4, adag k * adag k = 0) ∧
    (∀ j k : Fin 4, a j * a k + a k * a j = 0) ∧
    (∀ j k : Fin 4, adag j * adag k + adag k * adag j = 0) ∧
    (∀ j k : Fin 4, a j * adag k + adag k * a j = if j = k then 1 else 0) :=
  ⟨e_sq, f_sq, e_mul_f_add_swap, a_sq_zero, adag_sq_zero,
   witt_annihilation_anticomm, witt_creation_anticomm, witt_CAR⟩

/-- **Theorem 1.2 (Witt Mode Projector Idempotency & Vacuum Annihilation)**:
For each mode $k \in \mathrm{Fin}\, 4$:
1. $P_k^2 = P_k$ (`wittModeProj k * wittModeProj k = wittModeProj k`),
2. $a_k P_k = 0$ (annihilation operator kills the mode projector),
3. $P_k a_k = a_k$ (left absorption of annihilation operator),
4. $a_0 f = 0$ (the first annihilation operator kills the composite vacuum idempotent
   $f = P_0 P_1 P_2 P_3$). -/
theorem wittModeProj_and_vacuum_annihilation_synthesis :
    (∀ k : Fin 4, wittModeProj k * wittModeProj k = wittModeProj k) ∧
    (∀ k : Fin 4, a k * wittModeProj k = 0) ∧
    (∀ k : Fin 4, wittModeProj k * a k = a k) ∧
    a 0 * cl44VacuumIdempotent = 0 := by
  have h_idem : ∀ k : Fin 4, wittModeProj k * wittModeProj k = wittModeProj k := by
    intro k
    exact P_plus_sq (a k) (adag k) (a_sq_zero k) (witt_CAR_eq k)
  have h_ann : ∀ k : Fin 4, a k * wittModeProj k = 0 := by
    intro k
    exact n_mul_P_plus (a k) (adag k) (a_sq_zero k)
  have h_abs : ∀ k : Fin 4, wittModeProj k * a k = a k := by
    intro k
    exact P_plus_mul_n (a k) (adag k) (a_sq_zero k) (witt_CAR_eq k)
  refine ⟨h_idem, h_ann, h_abs, ?_⟩
  unfold cl44VacuumIdempotent
  calc
    a 0 * (wittModeProj 0 * wittModeProj 1 * wittModeProj 2 * wittModeProj 3) =
        (a 0 * wittModeProj 0) * wittModeProj 1 * wittModeProj 2 * wittModeProj 3 := by
      noncomm_ring
    _ = 0 * wittModeProj 1 * wittModeProj 2 * wittModeProj 3 := by
      rw [h_ann 0]
    _ = 0 := by noncomm_ring

/-!
## Section 2: Left/Right Ideal Ranges and Separate Occupation-Label Counts
-/

/-- The left ideal range $\{x f \mid x \in \mathrm{Cl}(4,4)\}$. Minimality is not asserted. -/
def cl44LeftPrincipalIdeal : Set Cl44 :=
  Set.range (fun x : Cl44 => x * cl44VacuumIdempotent)

/-- The right ideal range $\{f x \mid x \in \mathrm{Cl}(4,4)\}$. Minimality is not asserted. -/
def cl44RightPrincipalIdeal : Set Cl44 :=
  Set.range (fun x : Cl44 => cl44VacuumIdempotent * x)

/-- The left principal ideal as a genuine real submodule, obtained as the
range of right multiplication by the four-mode idempotent. -/
abbrev cl44LeftIdealSubmodule : Submodule ℝ Cl44 :=
  LinearMap.range (LinearMap.mulRight ℝ cl44VacuumIdempotent)

/-- The right principal ideal as a genuine real submodule, obtained as the
range of left multiplication by the four-mode idempotent. -/
abbrev cl44RightIdealSubmodule : Submodule ℝ Cl44 :=
  LinearMap.range (LinearMap.mulLeft ℝ cl44VacuumIdempotent)

/-- Membership in the left submodule range is exactly membership in the
corresponding set of Clifford products. -/
theorem cl44LeftIdealSubmodule_mem_iff (x : Cl44) :
    x ∈ cl44LeftIdealSubmodule ↔ x ∈ cl44LeftPrincipalIdeal := by
  simp [cl44LeftIdealSubmodule, cl44LeftPrincipalIdeal, LinearMap.mem_range,
    LinearMap.mulRight_apply]

/-- Membership in the right submodule range is exactly membership in the
corresponding set of Clifford products. -/
theorem cl44RightIdealSubmodule_mem_iff (x : Cl44) :
    x ∈ cl44RightIdealSubmodule ↔ x ∈ cl44RightPrincipalIdeal := by
  simp [cl44RightIdealSubmodule, cl44RightPrincipalIdeal, LinearMap.mem_range,
    LinearMap.mulLeft_apply]

/-- Right multiplication by an idempotent is a projection on the finite
Clifford carrier. -/
theorem cl44_right_vacuum_action_idempotent :
    (LinearMap.mulRight ℝ cl44VacuumIdempotent).comp
      (LinearMap.mulRight ℝ cl44VacuumIdempotent) =
      LinearMap.mulRight ℝ cl44VacuumIdempotent := by
  apply LinearMap.ext
  intro x
  simp only [LinearMap.comp_apply, LinearMap.mulRight_apply]
  change (x * cl44VacuumIdempotent) * cl44VacuumIdempotent =
    x * cl44VacuumIdempotent
  calc
    (x * cl44VacuumIdempotent) * cl44VacuumIdempotent =
        x * (cl44VacuumIdempotent * cl44VacuumIdempotent) := by rw [mul_assoc]
    _ = x * cl44VacuumIdempotent := by rw [cl44VacuumIdempotent_idempotent]

/-- Left multiplication by an idempotent is a projection on the finite
Clifford carrier. -/
theorem cl44_left_vacuum_action_idempotent :
    (LinearMap.mulLeft ℝ cl44VacuumIdempotent).comp
      (LinearMap.mulLeft ℝ cl44VacuumIdempotent) =
      LinearMap.mulLeft ℝ cl44VacuumIdempotent := by
  apply LinearMap.ext
  intro x
  simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply]
  change cl44VacuumIdempotent * (cl44VacuumIdempotent * x) =
    cl44VacuumIdempotent * x
  calc
    cl44VacuumIdempotent * (cl44VacuumIdempotent * x) =
        (cl44VacuumIdempotent * cl44VacuumIdempotent) * x := by rw [← mul_assoc]
    _ = cl44VacuumIdempotent * x := by rw [cl44VacuumIdempotent_idempotent]

/-- Every element of the left principal ideal is fixed by right multiplication
by the generating idempotent. -/
theorem cl44LeftIdealSubmodule_fixed (x : Cl44)
    (hx : x ∈ cl44LeftIdealSubmodule) :
    LinearMap.mulRight ℝ cl44VacuumIdempotent x = x := by
  rcases LinearMap.mem_range.mp hx with ⟨y, rfl⟩
  change (y * cl44VacuumIdempotent) * cl44VacuumIdempotent =
    y * cl44VacuumIdempotent
  calc
    (y * cl44VacuumIdempotent) * cl44VacuumIdempotent =
        y * (cl44VacuumIdempotent * cl44VacuumIdempotent) := by rw [mul_assoc]
    _ = y * cl44VacuumIdempotent := by rw [cl44VacuumIdempotent_idempotent]

/-- Every element of the right principal ideal is fixed by left multiplication
by the generating idempotent. -/
theorem cl44RightIdealSubmodule_fixed (x : Cl44)
    (hx : x ∈ cl44RightIdealSubmodule) :
    LinearMap.mulLeft ℝ cl44VacuumIdempotent x = x := by
  rcases LinearMap.mem_range.mp hx with ⟨y, rfl⟩
  change cl44VacuumIdempotent * (cl44VacuumIdempotent * y) =
    cl44VacuumIdempotent * y
  calc
    cl44VacuumIdempotent * (cl44VacuumIdempotent * y) =
        (cl44VacuumIdempotent * cl44VacuumIdempotent) * y := by rw [← mul_assoc]
    _ = cl44VacuumIdempotent * y := by rw [cl44VacuumIdempotent_idempotent]

/-- **Theorem 2.1 (Left/Right Ideal Closure & Corner Product)**:
1. $\mathcal{S}_L = \mathrm{Cl}(4,4) f$ is closed under left multiplication by arbitrary
   Clifford multivectors $A \in \mathrm{Cl}(4,4)$.
2. $\mathcal{S}_R = f \mathrm{Cl}(4,4)$ is closed under right multiplication by arbitrary
   Clifford multivectors $A \in \mathrm{Cl}(4,4)$.
3. Multiplying an element $\Phi$ in the right ideal range by an element $\Psi$ in the left ideal range
   lands in the vacuum corner $f \mathrm{Cl}(4,4) f$: $\Phi \Psi = f c f$ for some $c \in \mathrm{Cl}(4,4)$. -/
theorem cl44_left_right_spinor_ideal_corner_synthesis :
    (∀ (A Ψ : Cl44), Ψ ∈ cl44LeftPrincipalIdeal → A * Ψ ∈ cl44LeftPrincipalIdeal) ∧
    (∀ (A Φ : Cl44), Φ ∈ cl44RightPrincipalIdeal → Φ * A ∈ cl44RightPrincipalIdeal) ∧
    (∀ {Φ Ψ : Cl44}, Φ ∈ cl44RightPrincipalIdeal → Ψ ∈ cl44LeftPrincipalIdeal →
      ∃ c : Cl44, Φ * Ψ = cl44VacuumIdempotent * c * cl44VacuumIdempotent) := by
  refine ⟨?_, ?_, ?_⟩
  · intro A Ψ hΨ
    rcases hΨ with ⟨x, rfl⟩
    exact ⟨A * x, by dsimp; rw [mul_assoc]⟩
  · intro A Φ hΦ
    rcases hΦ with ⟨x, rfl⟩
    exact ⟨x * A, by dsimp; rw [← mul_assoc]⟩
  · intro Φ Ψ hΦ hΨ
    rcases hΦ with ⟨x, rfl⟩
    rcases hΨ with ⟨y, rfl⟩
    refine ⟨x * y, ?_⟩
    noncomm_ring

/-- **Theorem 2.2 (Finite Four-Mode Occupation Counts)**:
1. The occupation-label type `Occ4 = Fin 4 → Bool` has total
   cardinality $2^4 = 16 = \sum_{p=0}^4 \binom{4}{p} = 1 + 4 + 6 + 4 + 1$.
2. Its even-parity subtype has cardinality
   $\operatorname{card}\{w : \mathrm{Occ4} \mid \operatorname{Even}(\operatorname{fermionNumber} w)\} = 8 = \binom{4}{0} + \binom{4}{2} + \binom{4}{4} = 1 + 6 + 1$.
3. Its odd-parity subtype has cardinality
   $\operatorname{card}\{w : \mathrm{Occ4} \mid \neg \operatorname{Even}(\operatorname{fermionNumber} w)\} = 8 = \binom{4}{1} + \binom{4}{3} = 4 + 4$.
4. The integer difference between the even- and odd-label counts is zero. No parity operator or
   trace on the Clifford ideal is defined by this theorem. -/
theorem cl44_fock_occupation_count_packet :
    (Fintype.card Occ4 = 16 ∧
     Nat.choose 4 0 + Nat.choose 4 1 + Nat.choose 4 2 + Nat.choose 4 3 + Nat.choose 4 4 = 16) ∧
    (Fintype.card {w : Occ4 // Even (fermionNumber w)} = 8 ∧
     Nat.choose 4 0 + Nat.choose 4 2 + Nat.choose 4 4 = 8) ∧
    (Fintype.card {w : Occ4 // ¬ Even (fermionNumber w)} = 8 ∧
     Nat.choose 4 1 + Nat.choose 4 3 = 8) ∧
    ((8 : ℤ) - 8 = 0) :=
  ⟨⟨card_total, rfl⟩, ⟨card_even, rfl⟩, ⟨card_odd, rfl⟩, witten_index_zero⟩

/-!
## Section 3: Clifford Grading Identities and a Separate Occupation Toggle
-/

/-- The compact Cayley–Dickson doubling generator $\ell_- = a_3^\dagger - a_3 \in \mathrm{Cl}(4,4)$
(satisfying $\ell_-^2 = -\mathbf{1}$). -/
def cl44CompactDoublingEll : Cl44 :=
  adag 3 - a 3

/-- The split Cayley–Dickson doubling generator $\ell_+ = a_3 + a_3^\dagger \in \mathrm{Cl}(4,4)$
(satisfying $\ell_+^2 = +\mathbf{1}$). -/
def cl44SplitDoublingEll : Cl44 :=
  a 3 + adag 3

/-- The mode-3 Chevalley chiral grading involution $\varepsilon_3 = [a_3, a_3^\dagger] = a_3 a_3^\dagger - a_3^\dagger a_3$. -/
def cl44Mode3ChiralGrading : Cl44 :=
  chiralGrading (a 3) (adag 3)

/-- **Theorem 3.1 (Odd Clifford Doubling Generators Square to $\pm\mathbf{1}$ and Flip Chiral Parity)**:
1. The compact doubling generator $\ell_- = a_3^\dagger - a_3$ satisfies $\ell_-^2 = -\mathbf{1}$,
   while the split doubling generator $\ell_+ = a_3 + a_3^\dagger$ satisfies $\ell_+^2 = +\mathbf{1}$,
   and they anticommute: $\ell_- \ell_+ + \ell_+ \ell_- = 0$.
2. Both $\ell_-$ and $\ell_+$ anticommute with the chiral grading operator
   $\varepsilon_3 = a_3 a_3^\dagger - a_3^\dagger a_3$ ($\varepsilon_3^2 = +\mathbf{1}$):
   $$\ell_- \varepsilon_3 + \varepsilon_3 \ell_- = 0, \qquad \ell_+ \varepsilon_3 + \varepsilon_3 \ell_+ = 0,$$
   so multiplication by $\ell_\pm$ exchanges the two eigenspaces of this grading on any
   invariant carrier. No identification of these eigenspaces with the principal ideals or the
   occupation-label parity sectors is made here.
3. On the 16-state Fock occupation basis `Occ4`, the single-mode reflection `toggle0` is an
   involution (`toggle0 (toggle0 w) = w`) that reverses fermion-number parity
   (`Even (fermionNumber (toggle0 w)) ↔ ¬ Even (fermionNumber w)`). -/
theorem cl44_doubling_ell_chiral_reflection_synthesis :
    (cl44CompactDoublingEll * cl44CompactDoublingEll = -(1 : Cl44) ∧
     cl44SplitDoublingEll * cl44SplitDoublingEll = (1 : Cl44) ∧
     cl44CompactDoublingEll * cl44SplitDoublingEll +
       cl44SplitDoublingEll * cl44CompactDoublingEll = 0) ∧
    (cl44Mode3ChiralGrading * cl44Mode3ChiralGrading = 1 ∧
     cl44CompactDoublingEll * cl44Mode3ChiralGrading +
       cl44Mode3ChiralGrading * cl44CompactDoublingEll = 0 ∧
     cl44SplitDoublingEll * cl44Mode3ChiralGrading +
       cl44Mode3ChiralGrading * cl44SplitDoublingEll = 0) ∧
    (Function.Involutive toggle0 ∧
     ∀ w : Occ4, Even (fermionNumber (toggle0 w)) ↔ ¬ Even (fermionNumber w)) := by
  have ha : a 3 * a 3 = 0 := a_sq_zero 3
  have hd : adag 3 * adag 3 = 0 := adag_sq_zero 3
  have hcar : a 3 * adag 3 + adag 3 * a 3 = 1 := witt_CAR_eq 3
  refine ⟨⟨?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩, ⟨toggle0_involutive, parity_flip⟩⟩
  · unfold cl44CompactDoublingEll
    calc
      (adag 3 - a 3) * (adag 3 - a 3) =
          adag 3 * adag 3 - (a 3 * adag 3 + adag 3 * a 3) + a 3 * a 3 := by noncomm_ring
      _ = 0 - 1 + 0 := by rw [hd, hcar, ha]
      _ = -(1 : Cl44) := by noncomm_ring
  · unfold cl44SplitDoublingEll
    calc
      (a 3 + adag 3) * (a 3 + adag 3) =
          a 3 * a 3 + (a 3 * adag 3 + adag 3 * a 3) + adag 3 * adag 3 := by noncomm_ring
      _ = 0 + 1 + 0 := by rw [ha, hcar, hd]
      _ = (1 : Cl44) := by simp
  · unfold cl44CompactDoublingEll cl44SplitDoublingEll
    calc
      (adag 3 - a 3) * (a 3 + adag 3) + (a 3 + adag 3) * (adag 3 - a 3) =
          (2 : Cl44) * (adag 3 * adag 3) - (2 : Cl44) * (a 3 * a 3) := by noncomm_ring
      _ = (2 : Cl44) * 0 - (2 : Cl44) * 0 := by rw [hd, ha]
      _ = 0 := by noncomm_ring
  · exact chiralGrading_sq (a 3) (adag 3) ha hd hcar
  · unfold cl44CompactDoublingEll cl44Mode3ChiralGrading chiralGrading
    calc
      (adag 3 - a 3) * (a 3 * adag 3 - adag 3 * a 3) +
          (a 3 * adag 3 - adag 3 * a 3) * (adag 3 - a 3) =
          adag 3 * (a 3 * adag 3) - (adag 3 * adag 3) * a 3 -
          (a 3 * a 3) * adag 3 + a 3 * (adag 3 * a 3) +
          a 3 * (adag 3 * adag 3) - a 3 * (adag 3 * a 3) -
          adag 3 * (a 3 * adag 3) + adag 3 * (a 3 * a 3) := by noncomm_ring
      _ = adag 3 * (a 3 * adag 3) - 0 * a 3 - 0 * adag 3 + a 3 * (adag 3 * a 3) +
          a 3 * 0 - a 3 * (adag 3 * a 3) -
          adag 3 * (a 3 * adag 3) + adag 3 * 0 := by
        rw [hd, ha]
      _ = 0 := by noncomm_ring
  · unfold cl44SplitDoublingEll cl44Mode3ChiralGrading chiralGrading
    calc
      (a 3 + adag 3) * (a 3 * adag 3 - adag 3 * a 3) +
          (a 3 * adag 3 - adag 3 * a 3) * (a 3 + adag 3) =
          (a 3 * a 3) * adag 3 - a 3 * (adag 3 * a 3) +
          adag 3 * (a 3 * adag 3) - (adag 3 * adag 3) * a 3 +
          a 3 * (adag 3 * a 3) + a 3 * (adag 3 * adag 3) -
          adag 3 * (a 3 * a 3) - adag 3 * (a 3 * adag 3) := by noncomm_ring
      _ = 0 * adag 3 - a 3 * (adag 3 * a 3) +
          adag 3 * (a 3 * adag 3) - 0 * a 3 +
          a 3 * (adag 3 * a 3) + a 3 * 0 -
          adag 3 * 0 - adag 3 * (a 3 * adag 3) := by
        rw [ha, hd]
      _ = 0 := by noncomm_ring

/-!
## Section 4: Separately Defined Non-Associative Zorn Pair Product
-/

/-- The 16-component split-sedenion pair carrier, parameterized as pairs `(a, b)` of
Zorn split-octonions over a commutative ring `R`. No equivalence to a `Cl44` ideal is asserted. -/
abbrev SplitSedenion (R : Type*) :=
  ZornSplitOctonion R × ZornSplitOctonion R

/-- Zero element of `SplitSedenion R`. -/
def sedenionZero {R : Type*} [CommRing R] : SplitSedenion R :=
  (zornZero, zornZero)

/-- Multiplicative identity $(1_{\mathbb{O}_s}, 0)$ of `SplitSedenion R`. -/
def sedenionOne {R : Type*} [CommRing R] : SplitSedenion R :=
  (zornOne, zornZero)

/-- The Cayley–Dickson doubling unit $\ell = (0, 1_{\mathbb{O}_s}) \in S^-$. -/
def sedenionEll {R : Type*} [CommRing R] : SplitSedenion R :=
  (zornZero, zornOne)

/-- Componentwise addition on `SplitSedenion R`. -/
def sedenionAdd {R : Type*} [CommRing R] (X Y : SplitSedenion R) : SplitSedenion R :=
  (zornAdd X.1 Y.1, zornAdd X.2 Y.2)

/-- Componentwise negation on `SplitSedenion R`. -/
def sedenionNeg {R : Type*} [CommRing R] (X : SplitSedenion R) : SplitSedenion R :=
  (zornSmul (-1 : R) X.1, zornSmul (-1 : R) X.2)

/-- Componentwise subtraction on `SplitSedenion R`. -/
def sedenionSub {R : Type*} [CommRing R] (X Y : SplitSedenion R) : SplitSedenion R :=
  sedenionAdd X (sedenionNeg Y)

/-- Zorn split-octonion involution (conjugation)
$\begin{pmatrix} a & \mathbf{u} \\ \mathbf{v} & b \end{pmatrix}^\star =
 \begin{pmatrix} b & -\mathbf{u} \\ -\mathbf{v} & a \end{pmatrix}$ on `ZornSplitOctonion R`. -/
def zornConj {R : Type*} [CommRing R] (x : ZornSplitOctonion R) : ZornSplitOctonion R :=
  ⟨x.b, fun k => -x.u k, fun k => -x.v k, x.a⟩

/-- Cayley–Dickson involution $(a, b)^\star = (a^\star, -b)$ on `SplitSedenion R`. -/
def sedenionConj {R : Type*} [CommRing R] (X : SplitSedenion R) : SplitSedenion R :=
  (zornConj X.1, zornSmul (-1 : R) X.2)

/-- **Split-Sedenion Cayley–Dickson/Zorn Pair Multiplication**
($X \circ Y$ with split parameter $\lambda = +1$):
$$(a_1, b_1) \circ (a_2, b_2) =
  \Big(\underbrace{a_1 \star a_2 + b_2^\star \star b_1}_{\in S^+},\;
       \underbrace{b_2 \star a_1 + b_1 \star a_2^\star}_{\in S^-}\Big),$$
where $\star$ is the non-associative Zorn split-octonion product `zornMul`. -/
def sedenionMul {R : Type*} [CommRing R] (X Y : SplitSedenion R) : SplitSedenion R :=
  (zornAdd (zornMul X.1 Y.1) (zornMul (zornConj Y.2) X.2),
   zornAdd (zornMul Y.2 X.1) (zornMul X.2 (zornConj Y.1)))

/-- Split quadratic expression $N(a, b) = N_{\mathbb{O}_s}(a) - N_{\mathbb{O}_s}(b)$
on the separately defined `SplitSedenion R` pair carrier. -/
def sedenionNorm {R : Type*} [CommRing R] (X : SplitSedenion R) : R :=
  zornNorm X.1 - zornNorm X.2

/-- **Theorem 4.1 (Cayley–Dickson Pair Shift Laws)**:
1. Embedding the first factor via $a \mapsto (a, 0)$ is a multiplicative
   homomorphism: $(a_1, 0) \circ (a_2, 0) = (a_1 \star a_2, 0)$.
2. Right multiplication by $\ell = (0, 1)$ shifts $S^+$ onto $S^-$: $(a, 0) \circ \ell = (0, a)$.
3. The doubling unit $\ell = (0, 1)$ squares to $+\mathbf{1} = (1, 0)$:
   $\ell \circ \ell = (1_{\mathbb{O}_s}, 0)$. -/
theorem splitSedenion_chiral_sheet_shift_laws {R : Type*} [CommRing R]
    (a₁ a₂ : ZornSplitOctonion R) :
    sedenionMul (a₁, zornZero) (a₂, zornZero) = (zornMul a₁ a₂, zornZero) ∧
    sedenionMul (a₁, zornZero) sedenionEll = (zornZero, a₁) ∧
    sedenionMul (sedenionEll : SplitSedenion R) sedenionEll = sedenionOne := by
  have h_conj_zero : zornConj (zornZero : ZornSplitOctonion R) = zornZero := by
    ext <;> simp [zornConj, zornZero]
  have h_conj_one : zornConj (zornOne : ZornSplitOctonion R) = zornOne := by
    ext <;> simp [zornConj, zornOne]
  have h_add_zero : ∀ x : ZornSplitOctonion R, zornAdd x zornZero = x := by
    intro x
    ext <;> simp [zornAdd, zornZero]
  have h_zero_add : ∀ x : ZornSplitOctonion R, zornAdd zornZero x = x := by
    intro x
    ext <;> simp [zornAdd, zornZero]
  refine ⟨?_, ?_, ?_⟩ <;>
    simp only [sedenionMul, sedenionEll, sedenionOne, h_conj_zero, h_conj_one,
      zornZero_mul, zornMul_zornZero, zornOne_mul, h_add_zero, h_zero_add]

/-- **Theorem 4.2 (Associative Clifford Product and Non-Associative Pair Product)**:
1. Raw Clifford multiplication in $\mathrm{Cl}(4,4)$ is strictly associative:
   $(A B) C = A (B C)$ for all $A, B, C \in \mathrm{Cl}(4,4)$.
2. The separately defined split-sedenion pair product `sedenionMul` is **non-associative**:
   there exist explicit $X, Y, Z \in \mathrm{SplitSedenion}\, \mathbb{R}$ such that
   $$(X \circ Y) \circ Z \neq X \circ (Y \circ Z).$$ -/
theorem cl44_associative_vs_splitSedenion_nonAssociative :
    (∀ A B C : Cl44, (A * B) * C = A * (B * C)) ∧
    ∃ X Y Z : SplitSedenion ℝ,
      sedenionMul (sedenionMul X Y) Z ≠ sedenionMul X (sedenionMul Y Z) := by
  refine ⟨fun A B C => mul_assoc A B C, ?_⟩
  let x₁ : ZornSplitOctonion ℝ := embedVec (primalSheet (![1, 0, 0] : Fin 3 → ℝ))
  let x₂ : ZornSplitOctonion ℝ := embedVec (dualSheet (![1, 0, 0] : Fin 3 → ℝ))
  let x₃ : ZornSplitOctonion ℝ := ⟨2, ![0, 1, 0], ![0, 0, 1], 3⟩
  refine ⟨(x₁, zornZero), (x₂, zornZero), (x₃, zornZero), ?_⟩
  rw [(splitSedenion_chiral_sheet_shift_laws x₁ x₂).1,
      (splitSedenion_chiral_sheet_shift_laws (zornMul x₁ x₂) x₃).1,
      (splitSedenion_chiral_sheet_shift_laws x₂ x₃).1,
      (splitSedenion_chiral_sheet_shift_laws x₁ (zornMul x₂ x₃)).1]
  intro h
  have h1 : zornMul (zornMul x₁ x₂) x₃ = zornMul x₁ (zornMul x₂ x₃) :=
    congrArg Prod.fst h
  exact zorn_leftAct_comp_ne_leftAct_mul h1.symm

/-!
## Section 5: Isotropic Creation-Sheet Saturation & Split-Sedenion Zero Divisors
-/

/-- **Theorem 5.1 (Isotropic Creation-Sheet Bivector Saturation in $\mathrm{Cl}(4,4)$)**:
Whenever two Witt creation bivectors $a_i^\dagger a_j^\dagger$ and $a_i^\dagger a_k^\dagger$
on the maximal totally isotropic sheet $N^- = \operatorname{span}\{a_0^\dagger, a_1^\dagger, a_2^\dagger, a_3^\dagger\}$
share a common null generator $a_i^\dagger$, their Clifford product vanishes identically:
1. $(a_i^\dagger a_j^\dagger)(a_i^\dagger a_k^\dagger) = 0$ for all $i, j, k \in \mathrm{Fin}\, 4$,
2. $(a_j^\dagger a_i^\dagger)(a_k^\dagger a_i^\dagger) = 0$ for all $i, j, k \in \mathrm{Fin}\, 4$,
3. In particular, for the 4-mode creation operators $(a_0^\dagger, a_1^\dagger, a_2^\dagger, a_3^\dagger)$,
   $$(a_0^\dagger a_1^\dagger)(a_0^\dagger a_2^\dagger) = 0 \quad \text{and} \quad
     (a_2^\dagger a_3^\dagger)(a_1^\dagger a_3^\dagger) = 0.$$ -/
theorem cl44_isotropic_creation_bivector_saturation :
    (∀ i j k : Fin 4, (adag i * adag j) * (adag i * adag k) = 0) ∧
    (∀ i j k : Fin 4, (adag j * adag i) * (adag k * adag i) = 0) ∧
    ((adag 0 * adag 1) * (adag 0 * adag 2) = 0 ∧
     (adag 2 * adag 3) * (adag 1 * adag 3) = 0) := by
  have h_left : ∀ i j k : Fin 4, (adag i * adag j) * (adag i * adag k) = 0 := by
    intro i j k
    have h_anti : adag j * adag i = -(adag i * adag j) :=
      eq_neg_of_add_eq_zero_left (witt_creation_anticomm j i)
    have h_nil : adag i * adag i = 0 := adag_sq_zero i
    calc
      (adag i * adag j) * (adag i * adag k) =
          adag i * (adag j * adag i) * adag k := by noncomm_ring
      _ = adag i * (-(adag i * adag j)) * adag k := by rw [h_anti]
      _ = -((adag i * adag i) * adag j * adag k) := by noncomm_ring
      _ = -(0 * adag j * adag k) := by rw [h_nil]
      _ = 0 := by noncomm_ring
  have h_right : ∀ i j k : Fin 4, (adag j * adag i) * (adag k * adag i) = 0 := by
    intro i j k
    have h_anti : adag i * adag k = -(adag k * adag i) :=
      eq_neg_of_add_eq_zero_left (witt_creation_anticomm i k)
    have h_nil : adag i * adag i = 0 := adag_sq_zero i
    calc
      (adag j * adag i) * (adag k * adag i) =
          adag j * (adag i * adag k) * adag i := by noncomm_ring
      _ = adag j * (-(adag k * adag i)) * adag i := by rw [h_anti]
      _ = -(adag j * adag k * (adag i * adag i)) := by noncomm_ring
      _ = -(adag j * adag k * 0) := by rw [h_nil]
      _ = 0 := by noncomm_ring
  exact ⟨h_left, h_right, ⟨h_left 0 1 2, h_right 3 2 1⟩⟩

/-- **Theorem 5.2 (Explicit Non-Zero Split-Sedenion Pair Zero Divisors)**:
The two nonzero pairs built from the complementary Peirce idempotents
$e_0, e_1 \in \mathbb{O}_s$ satisfy
$X \neq 0$, $Y \neq 0$, and $X \circ Y = (0, 0)$; the pair
$Z_{\text{null}} = (1_{\mathbb{O}_s}, 1_{\mathbb{O}_s})$ has vanishing $(8,8)$
split norm $N_{\mathbb{S}_s}(Z_{\text{null}}) = 0$. -/
theorem splitSedenion_explicit_zero_divisors_and_null_norm :
    sedenionMul ((zornE0 : ZornSplitOctonion ℝ), (zornZero : ZornSplitOctonion ℝ))
        ((zornE1 : ZornSplitOctonion ℝ), (zornZero : ZornSplitOctonion ℝ)) = sedenionZero ∧
    ((zornE0 : ZornSplitOctonion ℝ), (zornZero : ZornSplitOctonion ℝ)) ≠ sedenionZero ∧
    ((zornE1 : ZornSplitOctonion ℝ), (zornZero : ZornSplitOctonion ℝ)) ≠ sedenionZero ∧
    sedenionNorm ((zornOne : ZornSplitOctonion ℝ), (zornOne : ZornSplitOctonion ℝ)) = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [(splitSedenion_chiral_sheet_shift_laws (zornE0 : ZornSplitOctonion ℝ) zornE1).1,
        zornE0_mul_zornE1]
    rfl
  · intro h
    have h1 : (zornE0 : ZornSplitOctonion ℝ).a = (zornZero : ZornSplitOctonion ℝ).a :=
      congrArg (fun p : SplitSedenion ℝ => p.1.a) h
    norm_num [zornE0, zornZero] at h1
  · intro h
    have h1 : (zornE1 : ZornSplitOctonion ℝ).b = (zornZero : ZornSplitOctonion ℝ).b :=
      congrArg (fun p : SplitSedenion ℝ => p.1.b) h
    norm_num [zornE1, zornZero] at h1
  · unfold sedenionNorm
    rw [sub_self]

end InfoGeometry.Synthesis.Cl44LeftIdealSplitSedenionSynthesis
