-- Part 11:  Finite Verifications
---------------------------------------------------------------

/-- Verify the chiral algebra: N₊² = N₊. -/
example : chiral_N_plus * chiral_N_plus = chiral_N_plus := N_plus_idempotent

/-- Verify: S₊ S₋ + S₋ S₊ = I (the tunneling loop). -/
example : chiral_S_plus * chiral_S_minus + chiral_S_minus * chiral_S_plus = chiral_identity :=
  braiding_sum_eq_I

/-- Verify: S = 2|W| when E_R = E_L. -/
example (E : ℝ) (W : ℂ) : chiralSpacing E E W = 2 * abs W :=
  spacing_degenerate_nonorientable E W

/-- Verify: S = 0 when E_R = E_L and W = 0 (orientable, no repulsion). -/
example (E : ℝ) : chiralSpacing E E 0 = 0 :=
  spacing_zero_when_degenerate_orientable E

/-- Verify: S > 0 when W ≠ 0, even if E_R = E_L (non-orientable, repulsion). -/
example (E : ℝ) (W : ℂ) (hW : W ≠ 0) : 0 < chiralSpacing E E W := by
  rw [spacing_degenerate_nonorientable E W]
  have h_abs_pos : 0 < abs W := Complex.abs_pos.mpr hW
  nlinarith

/-- Tr(H²) = E_R² + E_L² + 2|W|². -/
example (E_R E_L : ℝ) (W : ℂ) :
    Matrix.trace (chiralHamiltonian E_R E_L W * chiralHamiltonian E_R E_L W) =
      (E_R : ℂ)^2 + (E_L : ℂ)^2 + 2 * Complex.normSq W :=
  trace_H_squared E_R E_L W

/-- The chiral discriminant is non-negative — eigenvalues are always real. -/
example (E_R E_L : ℝ) (W : ℂ) : 0 ≤ chiralDiscriminant E_R E_L W :=
  chiralDiscriminant_nonneg E_R E_L W

/-- The spacing formula: S² = (E_R − E_L)² + 4|W|². -/
example (E_R E_L : ℝ) (W : ℂ) :
    (chiralSpacing E_R E_L W)^2 = (E_R - E_L)^2 + 4 * Complex.normSq W :=
  spacing_squared_eq E_R E_L W

end
