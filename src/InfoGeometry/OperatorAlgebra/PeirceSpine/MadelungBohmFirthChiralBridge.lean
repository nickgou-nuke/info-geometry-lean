import InfoGeometry.OperatorAlgebra.PeirceSpine.Basic
import Mathlib.Algebra.Module.LinearMap.Basic

/-!
# Peirce identities for phase/amplitude and even/odd action

This file packages finite ring identities for the Peirce generators. The
names “phase”, “amplitude”, and “gauge” are interpretations supplied by a
model; these theorems alone do not construct a Madelung field, a gauge theory,
or a gravitational dynamics.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine

variable {B : Type*} [Ring B] {P : B} (hP : P * P = P)
include hP

/-- The algebraic phase/amplitude square and commutator relations. -/
theorem phase_amplitude_peirce_relations (A C : B) :
    genPhi P A C * genPhi P A C = genV P A C ∧
    genJ P A C * genJ P A C = -genV P A C ∧
    comm (genPhi P A C) (genJ P A C) = -((2 : ℤ) • genSig P A C) := by
  peirce_nf hP
  exact ⟨trivial, trivial, trivial⟩

/-- The nested amplitude commutator is the negative fourfold mass-current
term. This is an algebraic identity, with no differential or physical
interpretation built into its statement. -/
theorem amplitude_double_commutator (A C : B) :
    -comm (genPhi P A C) (comm (genPhi P A C) (genJ P A C)) =
      -((4 : ℤ) • (genV P A C * genJ P A C)) := by
  peirce_nf hP

/-- The same Peirce involution commutes with the even projection and acts by
twice the phase generator on the odd projection. -/
theorem peirce_even_odd_action (X : B) :
    comm (invS P) (evenGrade P X) = 0 ∧
    comm (invS P) (oddGrade P X) = (2 : ℤ) • comm P (oddGrade P X) := by
  peirce_nf hP
  exact ⟨trivial, trivial⟩

/-- The odd component anticommutes with the Peirce involution. -/
theorem peirce_odd_anticommutes (X : B) :
    anticomm (invS P) (oddGrade P X) = 0 := by
  peirce_nf hP

/-- Iterating the Peirce action twice on an odd component gives four times that
component. The conclusion is stated without claiming a spacetime curvature. -/
theorem peirce_odd_double_action (X : B) :
    comm (invS P) (comm (invS P) (oddGrade P X)) =
      (4 : ℤ) • oddGrade P X := by
  peirce_nf hP

/-- Case-free chiral super-adjoint for an involution `S` and an odd element
`Q`. The parity of `X` is encoded by conjugation with `S`, so no homogeneous
case split is needed. -/
def chiralSuperAdjoint (S Q X : B) : B := Q * X - S * X * S * Q

omit hP in
/-- The square of the chiral super-adjoint is the ordinary inner derivation
generated by `Q²`. -/
theorem chiralSuperAdjoint_sq (S Q X : B)
    (hS : S * S = 1) (hQ : S * Q * S = -Q) :
    chiralSuperAdjoint S Q (chiralSuperAdjoint S Q X) =
      comm (Q * Q) X := by
  unfold chiralSuperAdjoint comm
  calc
    Q * (Q * X - S * X * S * Q) -
        S * (Q * X - S * X * S * Q) * S * Q
      = Q * Q * X - Q * S * X * S * Q -
        (S * Q * X * S * Q - S * S * X * S * Q * S * Q) := by noncomm_ring
    _ = Q * Q * X - X * Q * Q := by
      have hQS : S * Q = -Q * S := by
        calc
          S * Q = (S * Q * S) * S := by simp [mul_assoc, hS]
          _ = -Q * S := by rw [hQ]
      have hT : S * Q * S * Q = -(Q * Q) := by
        calc
          S * Q * S * Q = (S * Q * S) * Q := rfl
          _ = (-Q) * Q := by rw [hQ]
          _ = -(Q * Q) := by noncomm_ring
      have hXT : X * S * Q * S * Q = -(X * Q * Q) := by
        calc
          X * S * Q * S * Q = X * (S * Q * S * Q) := by noncomm_ring
          _ = X * (-(Q * Q)) := by rw [hT]
          _ = -(X * Q * Q) := by noncomm_ring
      rw [hQS, hS]
      simp only [one_mul]
      rw [hXT]
      noncomm_ring
    _ = Q * Q * X - X * (Q * Q) := by simp [mul_assoc]

omit hP in
/-- Exact difference between the ordinary iterated commutator and the
chiral-super-adjoint square. In general it is not just a sandwich through the
odd Peirce projection: the `X * Q²` term remains. -/
theorem ordinary_adjoint_sq_sub_chiralSuperAdjoint_sq (S Q X : B)
    (hS : S * S = 1) (hQ : S * Q * S = -Q) :
    comm Q (comm Q X) - chiralSuperAdjoint S Q
        (chiralSuperAdjoint S Q X) =
      (2 : ℤ) • (X * Q * Q - Q * X * Q) := by
  rw [chiralSuperAdjoint_sq S Q X hS hQ]
  unfold comm
  noncomm_ring

omit hP in
/-- The four compositions of commutator and anticommutator with `Q`. The
opposite-sign compositions both reduce to the commutator by `Q²`; the
like-sign compositions differ by the bilateral sandwich. -/
theorem second_order_bracket_diamond (Q X : B) :
    comm Q (comm Q X) = anticomm (Q * Q) X - (2 : ℤ) • (Q * X * Q) ∧
    anticomm Q (anticomm Q X) = anticomm (Q * Q) X + (2 : ℤ) • (Q * X * Q) ∧
    comm Q (anticomm Q X) = comm (Q * Q) X ∧
    anticomm Q (comm Q X) = comm (Q * Q) X ∧
    comm Q (comm Q X) - anticomm Q (anticomm Q X) =
      -((4 : ℤ) • (Q * X * Q)) ∧
    comm Q (comm Q X) + anticomm Q (anticomm Q X) =
      (2 : ℤ) • anticomm (Q * Q) X := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    (simp only [comm, anticomm]; noncomm_ring)

omit hP in
/-- A square-zero odd element has square-zero chiral super-adjoint. -/
theorem chiralSuperAdjoint_sq_eq_zero_of_square_eq_zero (S Q X : B)
    (hS : S * S = 1) (hQ : S * Q * S = -Q) (hQ2 : Q * Q = 0) :
    chiralSuperAdjoint S Q (chiralSuperAdjoint S Q X) = 0 := by
  rw [chiralSuperAdjoint_sq S Q X hS hQ, hQ2]
  simp [comm]

/-- Integer-scaled grade-zero polynomial for a linear operator. This is the
division-free numerator of the rational Lagrange projector at eigenvalue 0
for the five nodes `-2,-1,0,1,2`. -/
def gradeZero24 {A : Type*} [AddCommGroup A] (D : A →ₗ[ℤ] A) (x : A) : A :=
  (6 : ℤ) • D (D (D (D x))) - (30 : ℤ) • D (D x) + (24 : ℤ) • x

/-- Integer-scaled grade `+1` polynomial. -/
def gradePosOne24 {A : Type*} [AddCommGroup A] (D : A →ₗ[ℤ] A) (x : A) : A :=
  -((4 : ℤ) • D (D (D (D x))) + (4 : ℤ) • D (D (D x))) +
    (16 : ℤ) • D (D x) + (16 : ℤ) • D x

/-- Integer-scaled grade `-1` polynomial. -/
def gradeNegOne24 {A : Type*} [AddCommGroup A] (D : A →ₗ[ℤ] A) (x : A) : A :=
  -((4 : ℤ) • D (D (D (D x)))) + (4 : ℤ) • D (D (D x)) +
    (16 : ℤ) • D (D x) - (16 : ℤ) • D x

/-- Integer-scaled grade `+2` polynomial. -/
def gradePosTwo24 {A : Type*} [AddCommGroup A] (D : A →ₗ[ℤ] A) (x : A) : A :=
  D (D (D (D x))) + (2 : ℤ) • D (D (D x)) -
    D (D x) - (2 : ℤ) • D x

/-- Integer-scaled grade `-2` polynomial. -/
def gradeNegTwo24 {A : Type*} [AddCommGroup A] (D : A →ₗ[ℤ] A) (x : A) : A :=
  D (D (D (D x))) - (2 : ℤ) • D (D (D x)) -
    D (D x) + (2 : ℤ) • D x

omit [Ring B] hP in
/-- The five integer-scaled Lagrange numerators sum to `24` times the
identity. This is a polynomial cancellation valid for every linear `D`; the
quintic annihilator is needed for projector and orthogonality laws, not for
this completeness numerator. -/
theorem scaled_five_grade_polynomials_sum_24
    {A : Type*} [AddCommGroup A] (D : A →ₗ[ℤ] A) (x : A) :
    gradeNegTwo24 D x + gradeNegOne24 D x + gradeZero24 D x +
      gradePosOne24 D x + gradePosTwo24 D x = (24 : ℤ) • x := by
  simp only [gradeNegTwo24, gradeNegOne24, gradeZero24,
    gradePosOne24, gradePosTwo24]
  abel

omit [Ring B] hP in
/-- Under the five-grade quintic, the scaled grade-zero numerator lands in
the zero eigenspace. This is a polynomial eigen-relation; it does not assert
that the scaled numerator is an idempotent over `ℤ`. -/
theorem gradeZero24_eigen_relation
    {A : Type*} [AddCommGroup A] (D : A →ₗ[ℤ] A)
    (hD : ∀ x, D (D (D (D (D x)))) - (5 : ℤ) • D (D (D x)) +
      (4 : ℤ) • D x = 0) (x : A) :
    D (gradeZero24 D x) = 0 := by
  calc
    D (gradeZero24 D x) =
        (6 : ℤ) • (D (D (D (D (D x)))) - (5 : ℤ) • D (D (D x)) +
          (4 : ℤ) • D x) := by
            simp only [gradeZero24, map_sub, map_add, map_zsmul]
            abel
    _ = 0 := by rw [hD x]; simp

omit [Ring B] hP in
/-- Polynomial defect identities for the five signed 24-scaled grade
numerators. Each defect is an integer multiple of the quintic annihilator. -/
theorem scaled_five_grade_polynomial_defects
    {A : Type*} [AddCommGroup A] (D : A →ₗ[ℤ] A) (x : A) :
    D (gradeZero24 D x) =
        (6 : ℤ) • (D (D (D (D (D x)))) - (5 : ℤ) • D (D (D x)) +
          (4 : ℤ) • D x) ∧
    D (gradePosOne24 D x) - gradePosOne24 D x =
        -((4 : ℤ) • (D (D (D (D (D x)))) - (5 : ℤ) • D (D (D x)) +
          (4 : ℤ) • D x)) ∧
    D (gradeNegOne24 D x) + gradeNegOne24 D x =
        -((4 : ℤ) • (D (D (D (D (D x)))) - (5 : ℤ) • D (D (D x)) +
          (4 : ℤ) • D x)) ∧
    D (gradePosTwo24 D x) - (2 : ℤ) • gradePosTwo24 D x =
        D (D (D (D (D x)))) - (5 : ℤ) • D (D (D x)) +
          (4 : ℤ) • D x ∧
    D (gradeNegTwo24 D x) + (2 : ℤ) • gradeNegTwo24 D x =
        D (D (D (D (D x)))) - (5 : ℤ) • D (D (D x)) +
          (4 : ℤ) • D x := by
  simp only [gradeZero24, gradePosOne24, gradeNegOne24,
    gradePosTwo24, gradeNegTwo24, map_sub, map_add, map_zsmul, map_neg]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> abel_nf

end InfoGeometry.OperatorAlgebra.PeirceSpine
