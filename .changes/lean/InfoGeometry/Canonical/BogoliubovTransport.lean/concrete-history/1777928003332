{"type":"new","contents":"import InfoGeometry.Canonical.TomitaTakesaki\nimport InfoGeometry.Canonical.TransportLieDerivative\nimport Mathlib.Analysis.Normed.Algebra.Exponential\nimport Mathlib.Tactic.Abel\nimport Mathlib.Analysis.InnerProductSpace.Adjoint\nimport Mathlib.Analysis.InnerProductSpace.Basic\n\n/-!\n# Bogoliubov Transport\n\nCanonical doubled-carrier transport layer for the internal phase axis `Jε`.\n\nThis file is written directly on `DoubledSpace E`. It introduces no complex\nscalars and no Euclidean proxy carrier. The owner surface consists of:\n\n- the doubled-carrier Krein expectation,\n- the exact Heisenberg commutator transport operator,\n- the concrete phase-linear / phase-antilinear splitting relative to `Jε`,\n- the operator-valued phase force generated by transport of the `Jε` axis,\n- and the induced scalar Krein transport law.\n-/\n\nnamespace InfoGeometry.Canonical.BogoliubovTransport\n\nopen InfoGeometry.Canonical.TomitaTakesaki\nopen InfoGeometry.Krein\nopen scoped InnerProductSpace\n\nsection Basic\n\nvariable {E : Type*}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\nlocal notation \"Kop\" => InfoGeometry.Krein.clockAxis (E := E)\n\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : CompleteSpace EndH := inferInstance\n\n/-- Krein evaluation of an endomorphism on the doubled real carrier. -/\nnoncomputable def kreinExpectation\n    (ψ : H₂) (A : EndH) : ℝ :=\n  KreinSpace.kreinInner (H := H₂) ψ (A ψ)\n\n/-- Endomorphisms commuting with the doubled-space phase axis `K = Jε`. -/\ndef IsPhaseLinear (A : EndH) : Prop :=\n  A.comp Kop = (InfoGeometry.Krein.clockAxis (E := E)).comp A\n\nomit [CompleteSpace E] in\ntheorem isPhaseLinear_iff_comp_complex_i\n    (A : EndH) :\n    IsPhaseLinear (E := E) A\n      ↔\n    A.comp (complex_i (E := E)) = (complex_i (E := E)).comp A := by\n  simp [IsPhaseLinear, InfoGeometry.Krein.clockAxis]\n\n/-- Endomorphisms anticommuting with the doubled-space phase axis `K = Jε`. -/\ndef IsPhaseAntilinear (A : EndH) : Prop :=\n  A.comp Kop = -((InfoGeometry.Krein.clockAxis (E := E)).comp A)\n\nomit [CompleteSpace E] in\ntheorem isPhaseAntilinear_iff_comp_complex_i\n    (A : EndH) :\n    IsPhaseAntilinear (E := E) A\n      ↔\n    A.comp (complex_i (E := E)) = -((complex_i (E := E)).comp A) := by\n  simp [IsPhaseAntilinear, InfoGeometry.Krein.clockAxis]\n\n/-- Conjugation of an endomorphism by the doubled-space phase axis `K = Jε`. -/\nnoncomputable def phaseConjugate (A : EndH) : EndH :=\n  (InfoGeometry.Krein.clockAxis (E := E)).comp (A.comp Kop)\n\n/-- The phase-linear projection of a doubled-space endomorphism. -/\nnoncomputable def phaseLinearPart (A : EndH) : EndH :=\n  (1 / 2 : ℝ) • (A - phaseConjugate (E := E) A)\n\n/-- The phase-antilinear projection of a doubled-space endomorphism. -/\nnoncomputable def phaseAntilinearPart (A : EndH) : EndH :=\n  (1 / 2 : ℝ) • (A + phaseConjugate (E := E) A)\n\nomit [CompleteSpace E] in\n@[simp] theorem phaseLinearPart_add_phaseAntilinearPart\n    (A : EndH) :\n    phaseLinearPart (E := E) A + phaseAntilinearPart (E := E) A = A := by\n  unfold phaseLinearPart phaseAntilinearPart\n  calc\n    (1 / 2 : ℝ) • (A - phaseConjugate (E := E) A) +\n        (1 / 2 : ℝ) • (A + phaseConjugate (E := E) A)\n      = ((1 / 2 : ℝ) • A - (1 / 2 : ℝ) • phaseConjugate (E := E) A) +\n          ((1 / 2 : ℝ) • A + (1 / 2 : ℝ) • phaseConjugate (E := E) A) := by\n            simp [smul_sub, smul_add]\n    _ = (1 / 2 : ℝ) • A + (1 / 2 : ℝ) • A := by\n          abel\n    _ = (2 : ℝ) • ((1 / 2 : ℝ) • A) := by\n          simpa [two_smul] using (two_smul ℝ ((1 / 2 : ℝ) • A)).symm\n    _ = ((2 : ℝ) * (1 / 2 : ℝ)) • A := by\n          simp [smul_smul]\n    _ = (1 : ℝ) • A := by\n          norm_num\n    _ = A := by\n          simp\n\nomit [CompleteSpace E] in\nlemma phaseConjugate_comp_phaseAxis\n    (A : EndH) :\n    (phaseConjugate (E := E) A).comp Kop = -((InfoGeometry.Krein.clockAxis (E := E)).comp A) := by\n  apply ContinuousLinearMap.ext\n  intro x\n  have hK2x : Kop (Kop x) = -x := by\n    apply DoubledSpace.ext <;> simp [InfoGeometry.Krein.clockAxis]\n  unfold phaseConjugate\n  calc\n    (InfoGeometry.Krein.clockAxis (E := E)) (A (Kop (Kop x)))\n      = (InfoGeometry.Krein.clockAxis (E := E)) (A (-x)) := by rw [hK2x]\n    _ = -((InfoGeometry.Krein.clockAxis (E := E)) (A x)) := by\n          apply DoubledSpace.ext <;> simp [InfoGeometry.Krein.clockAxis]\n\nomit [CompleteSpace E] in\nlemma phaseAxis_comp_phaseConjugate\n    (A : EndH) :\n    (InfoGeometry.Krein.clockAxis (E := E)).comp (phaseConjugate (E := E) A) = -(A.comp Kop) := by\n  apply ContinuousLinearMap.ext\n  intro x\n  have hK2Ax : Kop (Kop (A (Kop x))) = -(A (Kop x)) := by\n    apply DoubledSpace.ext <;> simp [InfoGeometry.Krein.clockAxis]\n  unfold phaseConjugate\n  simpa [ContinuousLinearMap.comp_apply] using hK2Ax\n\nomit [CompleteSpace E] in\nlemma neg_phaseConjugate_comp_phaseAxis\n    (A : EndH) :\n    -((phaseConjugate (E := E) A).comp Kop) = (InfoGeometry.Krein.clockAxis (E := E)).comp A := by\n  simpa using congrArg Neg.neg (phaseConjugate_comp_phaseAxis (E := E) A)\n\nomit [CompleteSpace E] in\nlemma neg_phaseAxis_comp_phaseConjugate\n    (A : EndH) :\n    -((InfoGeometry.Krein.clockAxis (E := E)).comp (phaseConjugate (E := E) A)) = A.comp Kop := by\n  simpa using congrArg Neg.neg (phaseAxis_comp_phaseConjugate (E := E) A)\n\nomit [CompleteSpace E] in\ntheorem phaseLinearPart_isPhaseLinear\n    (A : EndH) :\n    IsPhaseLinear (E := E) (phaseLinearPart (E := E) A) := by\n  unfold IsPhaseLinear phaseLinearPart\n  rw [ContinuousLinearMap.smul_comp, ContinuousLinearMap.comp_smul]\n  apply congrArg (fun T => (1 / 2 : ℝ) • T)\n  calc\n    (A - phaseConjugate (E := E) A).comp Kop\n        = A.comp Kop - (phaseConjugate (E := E) A).comp Kop := by\n            simp [ContinuousLinearMap.sub_comp]\n    _ = A.comp Kop + (InfoGeometry.Krein.clockAxis (E := E)).comp A := by\n          rw [phaseConjugate_comp_phaseAxis (E := E)]\n          abel\n    _ = (InfoGeometry.Krein.clockAxis (E := E)).comp A + A.comp Kop := by\n          abel\n    _ = (InfoGeometry.Krein.clockAxis (E := E)).comp A - (InfoGeometry.Krein.clockAxis (E := E)).comp (phaseConjugate (E := E) A) := by\n          rw [← neg_phaseAxis_comp_phaseConjugate (E := E)]\n          abel\n    _ = (InfoGeometry.Krein.clockAxis (E := E)).comp (A - phaseConjugate (E := E) A) := by\n          simp [ContinuousLinearMap.comp_sub]\n\nomit [CompleteSpace E] in\ntheorem phaseAntilinearPart_isPhaseAntilinear\n    (A : EndH) :\n    IsPhaseAntilinear (E := E) (phaseAntilinearPart (E := E) A) := by\n  unfold IsPhaseAntilinear phaseAntilinearPart\n  rw [ContinuousLinearMap.smul_comp, ContinuousLinearMap.comp_smul, ← smul_neg]\n  apply congrArg (fun T => (1 / 2 : ℝ) • T)\n  calc\n    (A + phaseConjugate (E := E) A).comp Kop\n        = A.comp Kop + (phaseConjugate (E := E) A).comp Kop := by\n            simp [ContinuousLinearMap.add_comp]\n    _ = A.comp Kop - (InfoGeometry.Krein.clockAxis (E := E)).comp A := by\n          rw [phaseConjugate_comp_phaseAxis (E := E)]\n          abel\n    _ = -((InfoGeometry.Krein.clockAxis (E := E)).comp A - A.comp Kop) := by\n          abel\n    _ = -((InfoGeometry.Krein.clockAxis (E := E)).comp A + (InfoGeometry.Krein.clockAxis (E := E)).comp (phaseConjugate (E := E) A)) := by\n          rw [← neg_phaseAxis_comp_phaseConjugate (E := E)]\n          abel\n    _ = -((InfoGeometry.Krein.clockAxis (E := E)).comp (A + phaseConjugate (E := E) A)) := by\n          simp [ContinuousLinearMap.comp_add]\n\nlemma phaseConjugate_eq_neg_of_IsPhaseLinear\n    (A : EndH) (hA : IsPhaseLinear (E := E) A) :\n    phaseConjugate (E := E) A = -A := by\n  apply ContinuousLinearMap.ext\n  intro x\n  have hK2 : (InfoGeometry.Krein.clockAxis (E := E)) ((InfoGeometry.Krein.clockAxis (E := E)) x) = -x := by\n    exact congrArg (fun F : EndH => F x) (InfoGeometry.Krein.clockAxis_sq (E := E))\n  have hAatKx :\n      A ((InfoGeometry.Krein.clockAxis (E := E)) ((InfoGeometry.Krein.clockAxis (E := E)) x))\n        =\n      (InfoGeometry.Krein.clockAxis (E := E)) (A ((InfoGeometry.Krein.clockAxis (E := E)) x)) := by\n    exact congrArg (fun F : EndH => F ((InfoGeometry.Krein.clockAxis (E := E)) x)) hA\n  unfold phaseConjugate\n  calc\n    (InfoGeometry.Krein.clockAxis (E := E)) (A ((InfoGeometry.Krein.clockAxis (E := E)) x))\n      = A ((InfoGeometry.Krein.clockAxis (E := E)) ((InfoGeometry.Krein.clockAxis (E := E)) x)) := by\n          symm\n          exact hAatKx\n    _ = A (-x) := by rw [hK2]\n    _ = -(A x) := by simp\n\nlemma phaseConjugate_eq_self_of_IsPhaseAntilinear\n    (A : EndH) (hA : IsPhaseAntilinear (E := E) A) :\n    phaseConjugate (E := E) A = A := by\n  apply ContinuousLinearMap.ext\n  intro x\n  have hK2 : (InfoGeometry.Krein.clockAxis (E := E)) ((InfoGeometry.Krein.clockAxis (E := E)) x) = -x := by\n    exact congrArg (fun F : EndH => F x) (InfoGeometry.Krein.clockAxis_sq (E := E))\n  have hAatKx :\n      A ((InfoGeometry.Krein.clockAxis (E := E)) ((InfoGeometry.Krein.clockAxis (E := E)) x))\n        =\n      -((InfoGeometry.Krein.clockAxis (E := E)) (A ((InfoGeometry.Krein.clockAxis (E := E)) x))) := by\n    exact congrArg (fun F : EndH => F ((InfoGeometry.Krein.clockAxis (E := E)) x)) hA\n  unfold phaseConjugate\n  calc\n    (InfoGeometry.Krein.clockAxis (E := E)) (A ((InfoGeometry.Krein.clockAxis (E := E)) x))\n      = -A ((InfoGeometry.Krein.clockAxis (E := E)) ((InfoGeometry.Krein.clockAxis (E := E)) x)) := by\n          have hNeg : -A ((InfoGeometry.Krein.clockAxis (E := E)) ((InfoGeometry.Krein.clockAxis (E := E)) x))\n              = (InfoGeometry.Krein.clockAxis (E := E)) (A ((InfoGeometry.Krein.clockAxis (E := E)) x)) := by\n            simpa using congrArg Neg.neg hAatKx\n          exact hNeg.symm\n    _ = -A (-x) := by rw [hK2]\n    _ = A x := by simp\n\ntheorem phaseLinearPart_eq_self_of_IsPhaseLinear\n    (A : EndH) (hA : IsPhaseLinear (E := E) A) :\n    phaseLinearPart (E := E) A = A := by\n  rw [phaseLinearPart]\n  rw [phaseConjugate_eq_neg_of_IsPhaseLinear (E := E) A hA]\n  calc\n    (1 / 2 : ℝ) • (A - -A) = (1 / 2 : ℝ) • A + (1 / 2 : ℝ) • A := by\n      simp [smul_add]\n    _ = (2 : ℝ) • ((1 / 2 : ℝ) • A) := by\n      simpa [two_smul] using (two_smul ℝ ((1 / 2 : ℝ) • A)).symm\n    _ = ((2 : ℝ) * (1 / 2 : ℝ)) • A := by simp [smul_smul]\n    _ = A := by norm_num\n\ntheorem phaseAntilinearPart_eq_self_of_IsPhaseAntilinear\n    (A : EndH) (hA : IsPhaseAntilinear (E := E) A) :\n    phaseAntilinearPart (E := E) A = A := by\n  rw [phaseAntilinearPart]\n  rw [phaseConjugate_eq_self_of_IsPhaseAntilinear (E := E) A hA]\n  calc\n    (1 / 2 : ℝ) • (A + A) = (1 / 2 : ℝ) • A + (1 / 2 : ℝ) • A := by\n      simp [smul_add]\n    _ = (2 : ℝ) • ((1 / 2 : ℝ) • A) := by\n      simpa [two_smul] using (two_smul ℝ ((1 / 2 : ℝ) • A)).symm\n    _ = ((2 : ℝ) * (1 / 2 : ℝ)) • A := by simp [smul_smul]\n    _ = A := by norm_num\n\ntheorem phaseLinearPart_eq_zero_of_IsPhaseAntilinear\n    (A : EndH) (hA : IsPhaseAntilinear (E := E) A) :\n    phaseLinearPart (E := E) A = 0 := by\n  rw [phaseLinearPart]\n  rw [phaseConjugate_eq_self_of_IsPhaseAntilinear (E := E) A hA]\n  simp\n\ntheorem phaseAntilinearPart_eq_zero_of_IsPhaseLinear\n    (A : EndH) (hA : IsPhaseLinear (E := E) A) :\n    phaseAntilinearPart (E := E) A = 0 := by\n  rw [phaseAntilinearPart]\n  rw [phaseConjugate_eq_neg_of_IsPhaseLinear (E := E) A hA]\n  simp\n\ntheorem phaseLinearPart_idempotent\n    (A : EndH) :\n    phaseLinearPart (E := E) (phaseLinearPart (E := E) A)\n      = phaseLinearPart (E := E) A := by\n  exact phaseLinearPart_eq_self_of_IsPhaseLinear\n    (E := E)\n    (phaseLinearPart (E := E) A)\n    (phaseLinearPart_isPhaseLinear (E := E) A)\n\ntheorem phaseAntilinearPart_idempotent\n    (A : EndH) :\n    phaseAntilinearPart (E := E) (phaseAntilinearPart (E := E) A)\n      = phaseAntilinearPart (E := E) A := by\n  exact phaseAntilinearPart_eq_self_of_IsPhaseAntilinear\n    (E := E)\n    (phaseAntilinearPart (E := E) A)\n    (phaseAntilinearPart_isPhaseAntilinear (E := E) A)\n\n/-- Exact Heisenberg commutator transport on the doubled real carrier. -/\nnoncomputable def transportCommutator (H A : EndH) : EndH :=\n  H.comp A - A.comp H\n\n/-- The induced dynamics of an observable A under the Bogoliubov flow of X. -/\nnoncomputable abbrev inducedDynamics (X A : EndH) : EndH :=\n  transportCommutator (E := E) X A\n\nomit [CompleteSpace E] in\n/--\nOn endomorphisms, the associative-ring Lie bracket is exactly the doubled-space\ncommutator transport operator.\n-/\nlemma lieBracket_eq_transportCommutator (H A : EndH) :\n    ⁅H, A⁆ = transportCommutator (E := E) H A := by\n  rfl\n\n/--\nInfinitesimal phase-axis conjugation law at `t = 0`:\nthe Lie derivative equals the `K = Jε` commutator.\n-/\ntheorem deriv_KRotation_transport_at_zero\n    (A : EndH) :\n    deriv\n      (fun t =>\n        InfoGeometry.Canonical.expTransport\n          (A := EndH) (InfoGeometry.Krein.clockAxis (E := E)) A t)\n      0\n      =\n    transportCommutator (E := E) (InfoGeometry.Krein.clockAxis (E := E)) A := by\n  rw [← lieBracket_eq_transportCommutator (E := E) (InfoGeometry.Krein.clockAxis (E := E)) A]\n  simpa using\n    (InfoGeometry.Canonical.deriv_expTransport_at_zero\n      (A := EndH) (X := InfoGeometry.Krein.clockAxis (E := E)) (A₀ := A))\n\n/-- The doubled-space phase force generated by transport of the internal axis `Jε`. -/\nnoncomputable def phaseAxisForce (H : EndH) : EndH :=\n  transportCommutator (E := E) H Kop\n\nomit [CompleteSpace E] in\ntheorem phaseAxisForce_eq_transportCommutator_complex_i\n    (H : EndH) :\n    phaseAxisForce (E := E) H\n      =\n    transportCommutator (E := E) H (complex_i (E := E)) := by\n  unfold phaseAxisForce transportCommutator\n  rw [InfoGeometry.Krein.clockAxis_eq_complex_i]\n\n/-- The geometric response of the phase axis K to the generator X. -/\nnoncomputable abbrev phaseAxisResponse (X : EndH) : EndH :=\n  phaseAxisForce (E := E) X\n\nomit [CompleteSpace E] in\ntheorem phaseAxisForce_add (H1 H2 : EndH) :\n    phaseAxisForce (E := E) (H1 + H2) = phaseAxisForce (E := E) H1 + phaseAxisForce (E := E) H2 := by\n  unfold phaseAxisForce transportCommutator\n  simp only [ContinuousLinearMap.add_comp, ContinuousLinearMap.comp_add]\n  abel\n\nomit [CompleteSpace E] in\ntheorem phaseAxisForce_smul (c : ℝ) (H : EndH) :\n    phaseAxisForce (E := E) (c • H) = c • phaseAxisForce (E := E) H := by\n  unfold phaseAxisForce transportCommutator\n  simp only [ContinuousLinearMap.smul_comp, ContinuousLinearMap.comp_smul, smul_sub]\n\n/-- Scalar Krein transport observable associated to the commutator transport term. -/\nnoncomputable def heisenbergKreinTransport\n    (ψ : H₂) (H A : EndH) : ℝ :=\n  kreinExpectation (E := E) ψ (transportCommutator (E := E) H A)\n\n/-- Scalar Krein transport observable for the internal phase axis `Jε`. -/\nnoncomputable def phaseAxisTransport\n    (ψ : H₂) (H : EndH) : ℝ :=\n  kreinExpectation (E := E) ψ (phaseAxisForce (E := E) H)\n\nomit [CompleteSpace E] in\ntheorem transportCommutator_split_generator\n    (H A : EndH) :\n    transportCommutator (E := E) H A\n      = transportCommutator (E := E) (phaseLinearPart (E := E) H) A\n        + transportCommutator (E := E) (phaseAntilinearPart (E := E) H) A := by\n  have h_add_left (H1 H2 A : EndH) :\n      transportCommutator (E := E) (H1 + H2) A\n        = transportCommutator (E := E) H1 A + transportCommutator (E := E) H2 A := by\n    apply ContinuousLinearMap.ext\n    intro x\n    simp [transportCommutator, sub_eq_add_neg]\n    abel\n  calc\n    transportCommutator (E := E) H A\n      = transportCommutator (E := E)\n          (phaseLinearPart (E := E) H + phaseAntilinearPart (E := E) H) A := by\n            rw [phaseLinearPart_add_phaseAntilinearPart (E := E) H]\n    _ = transportCommutator (E := E) (phaseLinearPart (E := E) H) A\n          + transportCommutator (E := E) (phaseAntilinearPart (E := E) H) A := by\n            simpa using h_add_left (phaseLinearPart (E := E) H) (phaseAntilinearPart (E := E) H) A\n\nomit [CompleteSpace E] in\ntheorem phaseAxisForce_eq_zero_of_IsPhaseLinear\n    (H : EndH) (hH : IsPhaseLinear (E := E) H) :\n    phaseAxisForce (E := E) H = 0 := by\n  unfold phaseAxisForce transportCommutator IsPhaseLinear at *\n  rw [hH]\n  abel\n\nomit [CompleteSpace E] in\ntheorem phaseAxisForce_eq_two_smul_comp_of_IsPhaseAntilinear\n    (H : EndH) (hH : IsPhaseAntilinear (E := E) H) :\n    phaseAxisForce (E := E) H = (2 : ℝ) • (H.comp Kop) := by\n  unfold phaseAxisForce transportCommutator IsPhaseAntilinear at *\n  rw [hH]\n  simp [two_smul, sub_eq_add_neg]\n\nomit [CompleteSpace E] in\ntheorem phaseAxisForce_of_phaseLinearPart_eq_zero\n    (H : EndH) :\n    phaseAxisForce (E := E) (phaseLinearPart (E := E) H) = 0 := by\n  exact phaseAxisForce_eq_zero_of_IsPhaseLinear\n    (E := E) (phaseLinearPart (E := E) H) (phaseLinearPart_isPhaseLinear (E := E) H)\n\nomit [CompleteSpace E] in\ntheorem phaseAxisForce_of_phaseAntilinearPart_eq_two_smul\n    (H : EndH) :\n    phaseAxisForce (E := E) (phaseAntilinearPart (E := E) H)\n      = (2 : ℝ) • ((phaseAntilinearPart (E := E) H).comp Kop) := by\n  exact phaseAxisForce_eq_two_smul_comp_of_IsPhaseAntilinear\n    (E := E) (phaseAntilinearPart (E := E) H) (phaseAntilinearPart_isPhaseAntilinear (E := E) H)\n\nomit [CompleteSpace E] in\n/-- Decisive split: the phase-axis response vanishes for phase-linear generators. -/\ntheorem phaseAxisResponse_linear_vanishing\n    (X : EndH) (hX : IsPhaseLinear (E := E) X) :\n    phaseAxisResponse (E := E) X = 0 := by\n  exact phaseAxisForce_eq_zero_of_IsPhaseLinear (E := E) X hX\n\nomit [CompleteSpace E] in\n/--\nDecisive split: the phase-axis response of a phase-antilinear generator is\ntwice its own action rotated by K, living entirely in the source/dilation branch.\n-/\ntheorem phaseAxisResponse_antilinear_source\n    (X : EndH) (hX : IsPhaseAntilinear (E := E) X) :\n    phaseAxisResponse (E := E) X = (2 : ℝ) • (X.comp Kop) := by\n  exact phaseAxisForce_eq_two_smul_comp_of_IsPhaseAntilinear (E := E) X hX\n\nomit [CompleteSpace E] in\n/--\nThe transport of the internal phase axis is sourced entirely by the\nphase-antilinear part of the generator.\n-/\ntheorem phaseAxisForce_eq_from_phaseAntilinearPart\n    (H : EndH) :\n    phaseAxisForce (E := E) H\n      = (2 : ℝ) • ((phaseAntilinearPart (E := E) H).comp Kop) := by\n  unfold phaseAxisForce\n  rw [transportCommutator_split_generator (E := E) H Kop]\n  have hlin : transportCommutator (E := E) (phaseLinearPart (E := E) H) Kop = 0 := by\n    simpa [phaseAxisForce] using (phaseAxisForce_of_phaseLinearPart_eq_zero (E := E) H)\n  have hanti : transportCommutator (E := E) (phaseAntilinearPart (E := E) H) Kop\n      = (2 : ℝ) • ((phaseAntilinearPart (E := E) H).comp Kop) := by\n    simpa [phaseAxisForce] using (phaseAxisForce_of_phaseAntilinearPart_eq_two_smul (E := E) H)\n  rw [hlin, hanti]\n  simp\n\n/-- The concrete doubled Heisenberg/Krein transport splits through the phase parity decomposition. -/\ntheorem heisenbergKreinTransport_split_generator\n    (ψ : H₂) (H A : EndH) :\n    heisenbergKreinTransport (E := E) ψ H A\n      = heisenbergKreinTransport (E := E) ψ (phaseLinearPart (E := E) H) A\n        + heisenbergKreinTransport (E := E) ψ (phaseAntilinearPart (E := E) H) A := by\n  unfold heisenbergKreinTransport kreinExpectation\n  rw [transportCommutator_split_generator (E := E) H A]\n  rw [ContinuousLinearMap.add_apply]\n  rw [KreinSpace.kreinInner_add_right]\n\n/-- The scalar phase-axis transport vanishes for phase-linear generators. -/\ntheorem phaseAxisTransport_eq_zero_of_IsPhaseLinear\n    (ψ : H₂) (H : EndH) (hH : IsPhaseLinear (E := E) H) :\n    phaseAxisTransport (E := E) ψ H = 0 := by\n  unfold phaseAxisTransport kreinExpectation\n  rw [phaseAxisForce_eq_zero_of_IsPhaseLinear (E := E) H hH]\n  simp\n\n/--\nThe scalar phase-axis transport is exactly the Krein expectation of the\nBogoliubov force term coming from the phase-antilinear sector.\n-/\ntheorem phaseAxisTransport_eq_from_phaseAntilinearPart\n    (ψ : H₂) (H : EndH) :\n    phaseAxisTransport (E := E) ψ H\n      = kreinExpectation (E := E) ψ\n          ((2 : ℝ) • ((phaseAntilinearPart (E := E) H).comp Kop)) := by\n  unfold phaseAxisTransport kreinExpectation\n  rw [phaseAxisForce_eq_from_phaseAntilinearPart (E := E) H]\n\n\n/-- Real Bogoliubov boost generated by the concrete doubled-space modular conjugation `J`. -/\nnoncomputable def JBoost (t : ℝ) : EndH :=\n  NormedSpace.exp (t • modularConjugationJ (E := E))\n\n/-- Real Bogoliubov boost generated by the concrete doubled-space signature operator `ε`. -/\nnoncomputable def epsilonBoost (t : ℝ) : EndH :=\n  NormedSpace.exp (t • modularSignEpsilon (E := E))\n\n/-- Internal phase rotation generated by the concrete doubled-space axis `K = Jε`. -/\nnoncomputable def KRotation (t : ℝ) : EndH :=\n  NormedSpace.exp (t • InfoGeometry.Krein.clockAxis (E := E))\n\nomit [CompleteSpace E] in\n@[simp] theorem JBoost_zero :\n    JBoost (E := E) 0 = (1 : EndH) := by\n  simp [JBoost]\n\nomit [CompleteSpace E] in\n@[simp] theorem epsilonBoost_zero :\n    epsilonBoost (E := E) 0 = (1 : EndH) := by\n  simp [epsilonBoost]\n\nomit [CompleteSpace E] in\n@[simp] theorem KRotation_zero :\n    KRotation (E := E) 0 = (1 : EndH) := by\n  simp [KRotation]\n\ntheorem JBoost_add (s t : ℝ) :\n    JBoost (E := E) (s + t) = JBoost (E := E) s * JBoost (E := E) t := by\n  have hComm : Commute (s • modularConjugationJ (E := E)) (t • modularConjugationJ (E := E)) := by\n    exact ((Commute.refl (modularConjugationJ (E := E))).smul_left s).smul_right t\n  calc\n    JBoost (E := E) (s + t)\n        = NormedSpace.exp ((s + t) • modularConjugationJ (E := E)) := rfl\n    _ = NormedSpace.exp (s • modularConjugationJ (E := E) + t • modularConjugationJ (E := E)) := by\n          simp [add_smul]\n    _ = NormedSpace.exp (s • modularConjugationJ (E := E)) *\n          NormedSpace.exp (t • modularConjugationJ (E := E)) := by\n          rw [NormedSpace.exp_add_of_commute hComm]\n    _ = JBoost (E := E) s * JBoost (E := E) t := rfl\n\ntheorem epsilonBoost_add (s t : ℝ) :\n    epsilonBoost (E := E) (s + t) = epsilonBoost (E := E) s * epsilonBoost (E := E) t := by\n  have hComm : Commute (s • modularSignEpsilon (E := E)) (t • modularSignEpsilon (E := E)) := by\n    exact ((Commute.refl (modularSignEpsilon (E := E))).smul_left s).smul_right t\n  calc\n    epsilonBoost (E := E) (s + t)\n        = NormedSpace.exp ((s + t) • modularSignEpsilon (E := E)) := rfl\n    _ = NormedSpace.exp (s • modularSignEpsilon (E := E) + t • modularSignEpsilon (E := E)) := by\n          simp [add_smul]\n    _ = NormedSpace.exp (s • modularSignEpsilon (E := E)) *\n          NormedSpace.exp (t • modularSignEpsilon (E := E)) := by\n          rw [NormedSpace.exp_add_of_commute hComm]\n    _ = epsilonBoost (E := E) s * epsilonBoost (E := E) t := rfl\n\ntheorem KRotation_add (s t : ℝ) :\n    KRotation (E := E) (s + t) = KRotation (E := E) s * KRotation (E := E) t := by\n  have hComm : Commute (s • InfoGeometry.Krein.clockAxis (E := E)) (t • InfoGeometry.Krein.clockAxis (E := E)) := by\n    exact ((Commute.refl (InfoGeometry.Krein.clockAxis (E := E))).smul_left s).smul_right t\n  calc\n    KRotation (E := E) (s + t)\n        = NormedSpace.exp ((s + t) • InfoGeometry.Krein.clockAxis (E := E)) := rfl\n    _ = NormedSpace.exp (s • InfoGeometry.Krein.clockAxis (E := E) + t • InfoGeometry.Krein.clockAxis (E := E)) := by\n          simp [add_smul]\n    _ = NormedSpace.exp (s • InfoGeometry.Krein.clockAxis (E := E)) *\n          NormedSpace.exp (t • InfoGeometry.Krein.clockAxis (E := E)) := by\n          rw [NormedSpace.exp_add_of_commute hComm]\n    _ = KRotation (E := E) s * KRotation (E := E) t := rfl\n\n/-- Modular transport generator `A := hMod ∘ Kop`. -/\nnoncomputable def modularTransportGenerator (hMod : EndH) : EndH :=\n  hMod.comp Kop\n\n/--\nModular derivation on doubled-space operators generated by the true modular\ntransport generator `hMod ∘ K`.\n-/\nnoncomputable def modularDeriv (hMod A : EndH) : EndH :=\n  transportCommutator (E := E) (modularTransportGenerator (E := E) hMod) A\n\n/-- Volume-preserving (phase-linear / gauge) sector of the modular generator. -/\nnoncomputable def modularGeneratorGaugePart (hMod : EndH) : EndH :=\n  phaseLinearPart (E := E) (modularTransportGenerator (E := E) hMod)\n\n/-- Dissipative (phase-antilinear / scaling) sector of the modular generator. -/\nnoncomputable def modularGeneratorScalePart (hMod : EndH) : EndH :=\n  phaseAntilinearPart (E := E) (modularTransportGenerator (E := E) hMod)\n\n/-! ### General operator channel split for modular transport -/\n\n/-- Gauge-channel contribution to the modular derivation. -/\nnoncomputable def modularGaugeDeriv (hMod A : EndH) : EndH :=\n  transportCommutator (E := E) (modularGeneratorGaugePart (E := E) hMod) A\n\n/-- Scaling-channel contribution to the modular derivation. -/\nnoncomputable def modularScaleDeriv (hMod A : EndH) : EndH :=\n  transportCommutator (E := E) (modularGeneratorScalePart (E := E) hMod) A\n\n/--\nRelative-modular `K`-generator: canonical alias for the geometric transport\ndriver `hMod ∘ K` on doubled space.\n-/\nnoncomputable abbrev relativeModularKGenerator (hMod : EndH) : EndH :=\n  modularTransportGenerator (E := E) hMod\n\n/-- Relative-modular derivation channel on operator observables. -/\nnoncomputable abbrev relativeModularDeriv (hMod A : EndH) : EndH :=\n  modularDeriv (E := E) hMod A\n\n/-- Source channel: dissipative scaling derivation in the modular split. -/\nnoncomputable abbrev relativeModularSourceDeriv (hMod A : EndH) : EndH :=\n  modularScaleDeriv (E := E) hMod A\n\n/-- Potential-preserving channel (Krein-isometric / gauge sector) of relative-modular transport. -/\nnoncomputable abbrev relativeModularPotentialPreservingDeriv (hMod A : EndH) : EndH :=\n  modularGaugeDeriv (E := E) hMod A\n\n/-- Potential-changing channel (Weyl/dilation/source sector) of relative-modular transport. -/\nnoncomputable abbrev relativeModularPotentialChangingDeriv (hMod A : EndH) : EndH :=\n  relativeModularSourceDeriv (E := E) hMod A\n\n/-- Weyl-dilation anomaly channel alias for the potential-changing sector. -/\nnoncomputable abbrev weylDilationAnomalyDeriv (hMod A : EndH) : EndH :=\n  relativeModularPotentialChangingDeriv (E := E) hMod A\n\n/-- Sink channel: reverse of the dissipative scaling derivation. -/\nnoncomputable def relativeModularSinkDeriv (hMod A : EndH) : EndH :=\n  -modularScaleDeriv (E := E) hMod A\n\nomit [CompleteSpace E] in\n/-- Source and sink scaling channels cancel exactly. -/\ntheorem relativeModularSourceDeriv_add_relativeModularSinkDeriv\n    (hMod A : EndH) :\n    relativeModularSourceDeriv (E := E) hMod A\n      +\n    relativeModularSinkDeriv (E := E) hMod A\n      =\n    0 := by\n  unfold relativeModularSourceDeriv relativeModularSinkDeriv\n  abel\n\nomit [CompleteSpace E] in\n/--\nRelative-modular derivation in potential language:\nthe full channel splits into potential-preserving plus potential-changing parts.\n-/\ntheorem relativeModularDeriv_eq_potentialPreserving_add_potentialChanging\n    (hMod A : EndH) :\n    relativeModularDeriv (E := E) hMod A\n      =\n    relativeModularPotentialPreservingDeriv (E := E) hMod A\n      +\n    relativeModularPotentialChangingDeriv (E := E) hMod A := by\n  unfold relativeModularDeriv\n  unfold relativeModularPotentialPreservingDeriv relativeModularPotentialChangingDeriv\n  unfold relativeModularSourceDeriv\n  unfold modularDeriv modularGaugeDeriv modularScaleDeriv\n  unfold modularGeneratorGaugePart modularGeneratorScalePart\n  simpa using\n    transportCommutator_split_generator\n      (E := E) (modularTransportGenerator (E := E) hMod) A\n\nomit [CompleteSpace E] in\n/--\nIf the gauge channel commutes with the seed, relative-modular transport is\npurely potential-changing.\n-/\ntheorem relativeModularDeriv_eq_potentialChanging_of_commute_potentialPreserving\n    (hMod A : EndH)\n    (hCommGauge : Commute A (modularGeneratorGaugePart (E := E) hMod)) :\n    relativeModularDeriv (E := E) hMod A\n      =\n    relativeModularPotentialChangingDeriv (E := E) hMod A := by\n  rw [relativeModularDeriv_eq_potentialPreserving_add_potentialChanging\n    (E := E) hMod A]\n  unfold relativeModularPotentialPreservingDeriv modularGaugeDeriv\n  have hZero :\n      transportCommutator (E := E) (modularGeneratorGaugePart (E := E) hMod) A = 0 := by\n    unfold transportCommutator\n    exact sub_eq_zero.mpr hCommGauge.eq.symm\n  simp [hZero, relativeModularPotentialChangingDeriv, relativeModularSourceDeriv]\n\nomit [CompleteSpace E] in\n/-- Potential-changing and sink channels cancel exactly. -/\ntheorem relativeModularPotentialChangingDeriv_add_relativeModularSinkDeriv\n    (hMod A : EndH) :\n    relativeModularPotentialChangingDeriv (E := E) hMod A\n      +\n    relativeModularSinkDeriv (E := E) hMod A\n      =\n    0 := by\n  exact relativeModularSourceDeriv_add_relativeModularSinkDeriv\n    (E := E) hMod A\n\nomit [CompleteSpace E] in\n/--\nRelative-modular derivation decomposes into the gauge channel plus the source\nchannel (scaling sector).\n-/\ntheorem relativeModularDeriv_eq_modularGaugeDeriv_add_relativeModularSourceDeriv\n    (hMod A : EndH) :\n    relativeModularDeriv (E := E) hMod A\n      =\n    modularGaugeDeriv (E := E) hMod A\n      +\n    relativeModularSourceDeriv (E := E) hMod A := by\n  unfold relativeModularDeriv relativeModularSourceDeriv\n  unfold modularDeriv modularGaugeDeriv modularScaleDeriv\n  unfold modularGeneratorGaugePart modularGeneratorScalePart\n  simpa using\n    transportCommutator_split_generator\n      (E := E) (modularTransportGenerator (E := E) hMod) A\n\nomit [CompleteSpace E] in\n/--\nIf an operator commutes with the gauge channel, the relative-modular derivation\nis purely source-driven.\n-/\ntheorem relativeModularDeriv_eq_relativeModularSourceDeriv_of_commute_gaugePart\n    (hMod A : EndH)\n    (hCommGauge : Commute A (modularGeneratorGaugePart (E := E) hMod)) :\n    relativeModularDeriv (E := E) hMod A = relativeModularSourceDeriv (E := E) hMod A := by\n  rw [relativeModularDeriv_eq_modularGaugeDeriv_add_relativeModularSourceDeriv\n    (E := E) hMod A]\n  unfold modularGaugeDeriv\n  have hZero :\n      transportCommutator (E := E) (modularGeneratorGaugePart (E := E) hMod) A = 0 := by\n    unfold transportCommutator\n    exact sub_eq_zero.mpr hCommGauge.eq.symm\n  simp [hZero, relativeModularSourceDeriv]\n\nomit [CompleteSpace E] in\n/--\nIf an operator commutes with the full relative-modular `K`-generator, the\nrelative-modular derivation vanishes.\n-/\ntheorem relativeModularDeriv_eq_zero_of_commute_generator\n    (hMod A : EndH)\n    (hComm : Commute A (relativeModularKGenerator (E := E) hMod)) :\n    relativeModularDeriv (E := E) hMod A = 0 := by\n  have hComm' : Commute A (modularTransportGenerator (E := E) hMod) := by\n    simpa [relativeModularKGenerator] using hComm\n  unfold relativeModularDeriv modularDeriv transportCommutator\n  exact sub_eq_zero.mpr hComm'.eq.symm\n\nomit [CompleteSpace E] in\n/-- The gauge part of the modular generator is phase-linear. -/\ntheorem modularGeneratorGaugePart_isPhaseLinear\n    (hMod : EndH) :\n    IsPhaseLinear (E := E) (modularGeneratorGaugePart (E := E) hMod) := by\n  unfold modularGeneratorGaugePart\n  exact phaseLinearPart_isPhaseLinear\n    (E := E) (modularTransportGenerator (E := E) hMod)\n\nomit [CompleteSpace E] in\n/-- The scaling part of the modular generator is phase-antilinear. -/\ntheorem modularGeneratorScalePart_isPhaseAntilinear\n    (hMod : EndH) :\n    IsPhaseAntilinear (E := E) (modularGeneratorScalePart (E := E) hMod) := by\n  unfold modularGeneratorScalePart\n  exact phaseAntilinearPart_isPhaseAntilinear\n    (E := E) (modularTransportGenerator (E := E) hMod)\n\nomit [CompleteSpace E] in\n/-- The modular generator splits into gauge and scaling sectors. -/\ntheorem modularTransportGenerator_split\n    (hMod : EndH) :\n    modularTransportGenerator (E := E) hMod\n      = modularGeneratorGaugePart (E := E) hMod\n        + modularGeneratorScalePart (E := E) hMod := by\n  unfold modularGeneratorGaugePart modularGeneratorScalePart\n  symm\n  exact phaseLinearPart_add_phaseAntilinearPart\n    (E := E) (modularTransportGenerator (E := E) hMod)\n\nomit [CompleteSpace E] in\n/--\nPhase-linearity forces commutation with the canonical doubled-space clock axis.\n-/\ntheorem commute_clockAxis_of_IsPhaseLinear\n    {A : EndH}\n    (hPhase : IsPhaseLinear (E := E) A) :\n    Commute A (InfoGeometry.Krein.clockAxis (E := E)) := by\n  simpa [IsPhaseLinear] using hPhase\n\nomit [CompleteSpace E] in\n/--\nIf the scaling (Cartan-odd) part vanishes, the full modular transport generator\nis phase-linear.\n-/\ntheorem modularTransportGenerator_isPhaseLinear_of_scalePart_eq_zero\n    (hMod : EndH)\n    (hScaleZero : modularGeneratorScalePart (E := E) hMod = 0) :\n    IsPhaseLinear (E := E) (modularTransportGenerator (E := E) hMod) := by\n  have hSplit := modularTransportGenerator_split (E := E) hMod\n  have hEqGauge :\n      modularTransportGenerator (E := E) hMod\n        =\n      modularGeneratorGaugePart (E := E) hMod := by\n    calc\n      modularTransportGenerator (E := E) hMod\n          =\n        modularGeneratorGaugePart (E := E) hMod\n          +\n        modularGeneratorScalePart (E := E) hMod := hSplit\n      _ = modularGeneratorGaugePart (E := E) hMod := by simp [hScaleZero]\n  rw [hEqGauge]\n  exact modularGeneratorGaugePart_isPhaseLinear (E := E) hMod\n\nomit [CompleteSpace E] in\n/--\nCommutator-forcing form of the Cartan closure:\nif the scaling (Cartan-odd) part vanishes, then the modular generator commutes\nwith the clock axis.\n-/\ntheorem modularTransportGenerator_commutes_clockAxis_of_scalePart_eq_zero\n    (hMod : EndH)\n    (hScaleZero : modularGeneratorScalePart (E := E) hMod = 0) :\n    Commute\n      (modularTransportGenerator (E := E) hMod)\n      (InfoGeometry.Krein.clockAxis (E := E)) := by\n  exact commute_clockAxis_of_IsPhaseLinear (E := E)\n    (modularTransportGenerator_isPhaseLinear_of_scalePart_eq_zero\n      (E := E) hMod hScaleZero)\n\nomit [CompleteSpace E] in\n/--\nThe modular derivation splits as the sum of its gauge-sector and scaling-sector\ncommutator channels.\n-/\ntheorem modularDeriv_split\n    (hMod A : EndH) :\n    modularDeriv (E := E) hMod A\n      =\n    modularGaugeDeriv (E := E) hMod A\n      +\n    modularScaleDeriv (E := E) hMod A := by\n  unfold modularDeriv modularGaugeDeriv modularScaleDeriv\n  unfold modularGeneratorGaugePart modularGeneratorScalePart\n  simpa using\n    transportCommutator_split_generator\n      (E := E) (modularTransportGenerator (E := E) hMod) A\n\ntheorem modularGeneratorGaugePart_eq_zero_of_generator_IsPhaseAntilinear\n    (hMod : EndH)\n    (hAnti : IsPhaseAntilinear (E := E) (modularTransportGenerator (E := E) hMod)) :\n    modularGeneratorGaugePart (E := E) hMod = 0 := by\n  unfold modularGeneratorGaugePart\n  exact phaseLinearPart_eq_zero_of_IsPhaseAntilinear\n    (E := E) (modularTransportGenerator (E := E) hMod) hAnti\n\nomit [CompleteSpace E] in\ntheorem modularDeriv_eq_modularScaleDeriv_of_gaugePart_eq_zero\n    (hMod A : EndH)\n    (hGaugeZero : modularGeneratorGaugePart (E := E) hMod = 0) :\n    modularDeriv (E := E) hMod A = modularScaleDeriv (E := E) hMod A := by\n  rw [modularDeriv_split]\n  unfold modularGaugeDeriv\n  have hZeroComm : transportCommutator (E := E) (0 : EndH) A = 0 := by\n    unfold transportCommutator\n    simp\n  rw [hGaugeZero]\n  simp [hZeroComm]\n\ntheorem modularDeriv_eq_modularScaleDeriv_of_generator_IsPhaseAntilinear\n    (hMod A : EndH)\n    (hAnti : IsPhaseAntilinear (E := E) (modularTransportGenerator (E := E) hMod)) :\n    modularDeriv (E := E) hMod A = modularScaleDeriv (E := E) hMod A := by\n  exact modularDeriv_eq_modularScaleDeriv_of_gaugePart_eq_zero\n    (E := E) hMod A\n    (modularGeneratorGaugePart_eq_zero_of_generator_IsPhaseAntilinear\n      (E := E) hMod hAnti)\n\nomit [CompleteSpace E] in\n/--\nIf an operator commutes with the gauge sector of the modular generator, the\nfull modular derivation reduces to the scaling channel.\n-/\ntheorem modularDeriv_eq_modularScaleDeriv_of_commute_gaugePart\n    (hMod A : EndH)\n    (hCommGauge : Commute A (modularGeneratorGaugePart (E := E) hMod)) :\n    modularDeriv (E := E) hMod A = modularScaleDeriv (E := E) hMod A := by\n  rw [modularDeriv_split]\n  unfold modularGaugeDeriv\n  have hZero :\n      transportCommutator (E := E) (modularGeneratorGaugePart (E := E) hMod) A = 0 := by\n    unfold transportCommutator\n    exact sub_eq_zero.mpr hCommGauge.eq.symm\n  simp [hZero, modularScaleDeriv]\n\nomit [CompleteSpace E] in\n/--\nIf an operator commutes with the scaling sector of the modular generator, the\nfull modular derivation reduces to the gauge channel.\n-/\ntheorem modularDeriv_eq_modularGaugeDeriv_of_commute_scalePart\n    (hMod A : EndH)\n    (hCommScale : Commute A (modularGeneratorScalePart (E := E) hMod)) :\n    modularDeriv (E := E) hMod A = modularGaugeDeriv (E := E) hMod A := by\n  rw [modularDeriv_split]\n  unfold modularScaleDeriv\n  have hZero :\n      transportCommutator (E := E) (modularGeneratorScalePart (E := E) hMod) A = 0 := by\n    unfold transportCommutator\n    exact sub_eq_zero.mpr hCommScale.eq.symm\n  simp [hZero, modularGaugeDeriv]\n\nomit [CompleteSpace E] in\n/--\nIf an operator commutes with both gauge and scaling sectors, its modular\nderivation vanishes.\n-/\ntheorem modularDeriv_eq_zero_of_commute_parts\n    (hMod A : EndH)\n    (hCommGauge : Commute A (modularGeneratorGaugePart (E := E) hMod))\n    (hCommScale : Commute A (modularGeneratorScalePart (E := E) hMod)) :\n    modularDeriv (E := E) hMod A = 0 := by\n  rw [modularDeriv_eq_modularScaleDeriv_of_commute_gaugePart\n    (E := E) (hMod := hMod) (A := A) hCommGauge]\n  unfold modularScaleDeriv transportCommutator\n  exact sub_eq_zero.mpr hCommScale.eq.symm\n\nomit [CompleteSpace E] in\n/--\nIf an operator commutes with the true modular transport generator, its modular\nderivation vanishes.\n-/\ntheorem modularDeriv_eq_zero_of_commute_generator\n    (hMod A : EndH)\n    (hComm : Commute A (modularTransportGenerator (E := E) hMod)) :\n    modularDeriv (E := E) hMod A = 0 := by\n  unfold modularDeriv transportCommutator\n  exact sub_eq_zero.mpr hComm.eq.symm\n\n/-- Modular transport flow `U(t) := exp(t • A)`. -/\nnoncomputable def modularTransportFlow (hMod : EndH) (t : ℝ) : EndH :=\n  NormedSpace.exp (t • modularTransportGenerator hMod)\n\n/--\nInfinitesimal modular conjugation law at `t = 0` for the true Cartan generator\n`A = hMod ∘ K`.\n-/\ntheorem deriv_modularTransport_conjugation_at_zero\n    (hMod A : EndH) :\n    deriv\n      (fun t =>\n        InfoGeometry.Canonical.expTransport\n          (A := EndH) (modularTransportGenerator (E := E) hMod) A t)\n      0\n      =\n    transportCommutator (E := E) (modularTransportGenerator (E := E) hMod) A := by\n  rw [← lieBracket_eq_transportCommutator\n      (E := E) (modularTransportGenerator (E := E) hMod) A]\n  simpa using\n    (InfoGeometry.Canonical.deriv_expTransport_at_zero\n      (A := EndH) (X := modularTransportGenerator (E := E) hMod) (A₀ := A))\n\n/--\nGlobal modular conjugation flow equation (arbitrary `t`) in operator form:\nthe derivative is the exponential transport of the modular derivation seed.\n-/\ntheorem deriv_modularTransport_conjugation_eq_expTransport_modularDeriv\n    (hMod A : EndH) (t : ℝ) :\n    deriv\n      (fun s =>\n        InfoGeometry.Canonical.expTransport\n          (A := EndH) (modularTransportGenerator (E := E) hMod) A s)\n      t\n      =\n    InfoGeometry.Canonical.expTransport\n      (A := EndH)\n      (modularTransportGenerator (E := E) hMod)\n      (modularDeriv (E := E) hMod A)\n      t := by\n  simpa [modularDeriv, transportCommutator] using\n    (InfoGeometry.Canonical.hasDerivAt_expTransport\n      (A := EndH)\n      (X := modularTransportGenerator (E := E) hMod)\n      (A₀ := A)\n      t).deriv\n\ntheorem deriv_modularTransport_conjugation_eq_expTransport_modularScaleDeriv_of_gaugePart_eq_zero\n    (hMod A : EndH)\n    (hGaugeZero : modularGeneratorGaugePart (E := E) hMod = 0)\n    (t : ℝ) :\n    deriv\n      (fun s =>\n        InfoGeometry.Canonical.expTransport\n          (A := EndH) (modularTransportGenerator (E := E) hMod) A s)\n      t\n      =\n    InfoGeometry.Canonical.expTransport\n      (A := EndH)\n      (modularTransportGenerator (E := E) hMod)\n      (modularScaleDeriv (E := E) hMod A)\n      t := by\n  rw [deriv_modularTransport_conjugation_eq_expTransport_modularDeriv\n    (E := E) hMod A t]\n  rw [modularDeriv_eq_modularScaleDeriv_of_gaugePart_eq_zero\n    (E := E) hMod A hGaugeZero]\n\ntheorem deriv_modularTransport_conjugation_eq_expTransport_modularScaleDeriv_of_generator_IsPhaseAntilinear\n    (hMod A : EndH)\n    (hAnti : IsPhaseAntilinear (E := E) (modularTransportGenerator (E := E) hMod))\n    (t : ℝ) :\n    deriv\n      (fun s =>\n        InfoGeometry.Canonical.expTransport\n          (A := EndH) (modularTransportGenerator (E := E) hMod) A s)\n      t\n      =\n    InfoGeometry.Canonical.expTransport\n      (A := EndH)\n      (modularTransportGenerator (E := E) hMod)\n      (modularScaleDeriv (E := E) hMod A)\n      t := by\n  exact deriv_modularTransport_conjugation_eq_expTransport_modularScaleDeriv_of_gaugePart_eq_zero\n    (E := E) hMod A\n    (modularGeneratorGaugePart_eq_zero_of_generator_IsPhaseAntilinear (E := E) hMod hAnti)\n    t\n\n/--\nGlobal operator split at arbitrary `t`: modular evolution decomposes into\npotential-preserving and potential-changing transported channels.\n-/\ntheorem deriv_modularTransport_conjugation_eq_expTransport_potentialPreserving_add_expTransport_potentialChanging\n    (hMod A : EndH) (t : ℝ) :\n    deriv\n      (fun s =>\n        InfoGeometry.Canonical.expTransport\n          (A := EndH) (modularTransportGenerator (E := E) hMod) A s)\n      t\n      =\n    InfoGeometry.Canonical.expTransport\n      (A := EndH)\n      (modularTransportGenerator (E := E) hMod)\n      (relativeModularPotentialPreservingDeriv (E := E) hMod A)\n      t\n      +\n    InfoGeometry.Canonical.expTransport\n      (A := EndH)\n      (modularTransportGenerator (E := E) hMod)\n      (relativeModularPotentialChangingDeriv (E := E) hMod A)\n      t := by\n  rw [deriv_modularTransport_conjugation_eq_expTransport_modularDeriv\n    (E := E) hMod A t]\n  have hsplit :\n      modularDeriv (E := E) hMod A\n        =\n      relativeModularPotentialPreservingDeriv (E := E) hMod A\n        +\n      relativeModularPotentialChangingDeriv (E := E) hMod A := by\n    simpa [relativeModularDeriv] using\n      relativeModularDeriv_eq_potentialPreserving_add_potentialChanging\n        (E := E) hMod A\n  rw [hsplit]\n  rw [InfoGeometry.Canonical.expTransport_add_seed\n    (A := EndH)\n    (X := modularTransportGenerator (E := E) hMod)\n    (A₁ := relativeModularPotentialPreservingDeriv (E := E) hMod A)\n    (A₂ := relativeModularPotentialChangingDeriv (E := E) hMod A)]\n\n/--\nGlobal gauge-commuting reduction at arbitrary `t`: if the potential-preserving\nchannel commutes with the seed, the modular evolution is purely\npotential-changing.\n-/\ntheorem deriv_modularTransport_conjugation_eq_expTransport_potentialChanging_of_commute_potentialPreserving\n    (hMod A : EndH)\n    (hCommGauge : Commute A (modularGeneratorGaugePart (E := E) hMod))\n    (t : ℝ) :\n    deriv\n      (fun s =>\n        InfoGeometry.Canonical.expTransport\n          (A := EndH) (modularTransportGenerator (E := E) hMod) A s)\n      t\n      =\n    InfoGeometry.Canonical.expTransport\n      (A := EndH)\n      (modularTransportGenerator (E := E) hMod)\n      (relativeModularPotentialChangingDeriv (E := E) hMod A)\n      t := by\n  rw [deriv_modularTransport_conjugation_eq_expTransport_modularDeriv\n    (E := E) hMod A t]\n  have hreduce :\n      modularDeriv (E := E) hMod A\n        =\n      relativeModularPotentialChangingDeriv (E := E) hMod A := by\n    simpa [relativeModularDeriv] using\n      relativeModularDeriv_eq_potentialChanging_of_commute_potentialPreserving\n        (E := E) hMod A hCommGauge\n  rw [hreduce]\n\nomit [CompleteSpace E] in\n/-- The modular transport flow at t=0 is the identity. -/\n@[simp] theorem modularTransportFlow_zero (hMod : EndH) :\n    modularTransportFlow hMod 0 = 1 := by\n  unfold modularTransportFlow\n  simp\n\n/-- The modular transport flow satisfies the group additive law. -/\ntheorem modularTransportFlow_add (hMod : EndH) (s t : ℝ) :\n    modularTransportFlow hMod (s + t) =\n      modularTransportFlow hMod s * modularTransportFlow hMod t := by\n  set A := modularTransportGenerator hMod with hA\n  have hComm : Commute (s • A) (t • A) := by\n    exact ((Commute.refl A).smul_left s).smul_right t\n  unfold modularTransportFlow\n  rw [add_smul, NormedSpace.exp_add_of_commute hComm]\n\n/--\nIf the transport seed is self-adjoint and phase-linear relative to the local\nCartan involution, then the true flow generator `hMod ∘ K` is skew-adjoint on\nthe positive doubled-space Hilbert metric.\n-/\ntheorem modularTransportGenerator_mem_skewAdjoint_of_isSelfAdjoint_of_IsPhaseLinear\n    (hMod : EndH)\n    (hSelf : IsSelfAdjoint hMod)\n    (hPhase : IsPhaseLinear (E := E) hMod) :\n    modularTransportGenerator (E := E) hMod ∈ skewAdjoint EndH := by\n  have hPhaseEq :\n      hMod.comp (InfoGeometry.Krein.clockAxis (E := E))\n        =\n      (InfoGeometry.Krein.clockAxis (E := E)).comp hMod := by\n    simpa [IsPhaseLinear] using hPhase\n  rw [skewAdjoint.mem_iff, ContinuousLinearMap.star_eq_adjoint]\n  apply ContinuousLinearMap.ext\n  intro u\n  refine ext_inner_left ℝ fun v => ?_\n  rw [ContinuousLinearMap.adjoint_inner_right]\n  have hPhaseEval :\n      (InfoGeometry.Krein.clockAxis (E := E)) (hMod u)\n        =\n      hMod ((InfoGeometry.Krein.clockAxis (E := E)) u) := by\n    simpa [ContinuousLinearMap.comp_apply] using\n      (congrArg (fun T : EndH => T u) hPhaseEq).symm\n  calc inner ℝ (modularTransportGenerator (E := E) hMod v) u\n      = inner ℝ (hMod ((InfoGeometry.Krein.clockAxis (E := E)) v)) u := by\n          rfl\n    _ = inner ℝ ((InfoGeometry.Krein.clockAxis (E := E)) v) (hMod u) := by\n          rw [← ContinuousLinearMap.adjoint_inner_left, IsSelfAdjoint.adjoint_eq hSelf]\n    _ = -inner ℝ v ((InfoGeometry.Krein.clockAxis (E := E)) (hMod u)) := by\n          exact clockAxis_inner_skew (E := E) v (hMod u)\n    _ = -inner ℝ v (hMod ((InfoGeometry.Krein.clockAxis (E := E)) u)) := by\n          rw [hPhaseEval]\n    _ = -inner ℝ v (modularTransportGenerator (E := E) hMod u) := by\n          rfl\n    _ = inner ℝ v (-(modularTransportGenerator (E := E) hMod u)) := by\n          simp\n\nomit [CompleteSpace E] in\n/--\nThe true Cartan transport generator commutes with the local phase axis whenever\nthe seed is phase-linear.\n-/\ntheorem modularComplexI_commutes_modularTransportGenerator_of_IsPhaseLinear\n    (hMod : EndH)\n    (hPhase : IsPhaseLinear (E := E) hMod) :\n    Commute (InfoGeometry.Krein.clockAxis (E := E)) (modularTransportGenerator (E := E) hMod) := by\n  have hPhaseEq :\n      hMod.comp (InfoGeometry.Krein.clockAxis (E := E))\n        =\n      (InfoGeometry.Krein.clockAxis (E := E)).comp hMod := by\n    simpa [IsPhaseLinear] using hPhase\n  change\n    (InfoGeometry.Krein.clockAxis (E := E)).comp (hMod.comp (InfoGeometry.Krein.clockAxis (E := E)))\n      =\n    (hMod.comp (InfoGeometry.Krein.clockAxis (E := E))).comp (InfoGeometry.Krein.clockAxis (E := E))\n  calc\n    (InfoGeometry.Krein.clockAxis (E := E)).comp (hMod.comp (InfoGeometry.Krein.clockAxis (E := E)))\n      = ((InfoGeometry.Krein.clockAxis (E := E)).comp hMod).comp (InfoGeometry.Krein.clockAxis (E := E)) := by\n          simp [ContinuousLinearMap.comp_assoc]\n    _ = (hMod.comp (InfoGeometry.Krein.clockAxis (E := E))).comp (InfoGeometry.Krein.clockAxis (E := E)) := by\n          rw [← hPhaseEq]\n\nomit [CompleteSpace E] in\ntheorem complex_i_commutes_modularTransportGenerator_of_IsPhaseLinear\n    (hMod : EndH)\n    (hPhase : IsPhaseLinear (E := E) hMod) :\n    Commute (complex_i (E := E)) (modularTransportGenerator (E := E) hMod) := by\n  simpa [InfoGeometry.Krein.clockAxis_eq_complex_i] using\n    modularComplexI_commutes_modularTransportGenerator_of_IsPhaseLinear (E := E) hMod hPhase\n\n/--\nIf the transport seed is self-adjoint and phase-linear, the corresponding exact\nmodular flow preserves the positive doubled-space Hilbert inner product.\n-/\ntheorem modularTransportFlow_preserves_inner_of_isSelfAdjoint_of_IsPhaseLinear\n    (hMod : EndH)\n    (hSelf : IsSelfAdjoint hMod)\n    (hPhase : IsPhaseLinear (E := E) hMod)\n    (t : ℝ) (u v : H₂) :\n    inner ℝ (modularTransportFlow (E := E) hMod t u)\n      (modularTransportFlow (E := E) hMod t v)\n      =\n    inner ℝ u v := by\n  have hGenSkew :\n      modularTransportGenerator (E := E) hMod ∈ skewAdjoint EndH :=\n    modularTransportGenerator_mem_skewAdjoint_of_isSelfAdjoint_of_IsPhaseLinear\n      (E := E) hMod hSelf hPhase\n  have hSkew :\n      t • modularTransportGenerator (E := E) hMod ∈ skewAdjoint EndH := by\n    have hGenStar :\n        star (modularTransportGenerator (E := E) hMod)\n          =\n        -(modularTransportGenerator (E := E) hMod) := by\n      simpa [ContinuousLinearMap.star_eq_adjoint] using hGenSkew\n    rw [skewAdjoint.mem_iff]\n    calc\n      star (t • modularTransportGenerator (E := E) hMod)\n        = t • star (modularTransportGenerator (E := E) hMod) := by\n            simp\n      _ = t • (-(modularTransportGenerator (E := E) hMod)) := by rw [hGenStar]\n      _ = -(t • modularTransportGenerator (E := E) hMod) := by\n            simp\n  have hUnitary :\n      modularTransportFlow (E := E) hMod t ∈ unitary EndH := by\n    simpa [modularTransportFlow] using NormedSpace.exp_mem_unitary_of_mem_skewAdjoint hSkew\n  simpa using ContinuousLinearMap.inner_map_map_of_mem_unitary hUnitary u v\n\n@[simp] theorem inner_modularSignEpsilon_apply_eq_kreinInner\n    (u v : H₂) :\n    ⟪(modularSignEpsilon (E := E)) u, v⟫_ℝ\n      =\n    KreinSpace.kreinInner (H := H₂) u v := by\n  rw [krein_inner_prod_l2]\n  simp [modularSignEpsilon, spectral_epsilon, WithLp.prod_inner_apply, sub_eq_add_neg]\n\nomit [CompleteSpace E] in\ntheorem modularSignEpsilon_comp_modularTransportFlow_eq_modularTransportFlow_comp_modularSignEpsilon_of_commute_generator\n    (hMod : EndH)\n    (hCommSign : Commute (modularSignEpsilon (E := E)) (modularTransportGenerator (E := E) hMod))\n    (t : ℝ) :\n    (modularSignEpsilon (E := E)).comp (modularTransportFlow (E := E) hMod t)\n      =\n    (modularTransportFlow (E := E) hMod t).comp (modularSignEpsilon (E := E)) := by\n  have hComm :\n      Commute (modularSignEpsilon (E := E)) (modularTransportFlow (E := E) hMod t) := by\n    simpa [modularTransportFlow] using (hCommSign.smul_right t).exp_right\n  apply ContinuousLinearMap.ext\n  intro x\n  exact congrArg (fun f : EndH => f x) hComm.eq\n\n/--\nKrein-metric invariance of modular transport under explicit axis-compatibility:\nthe flow is Hilbert-unitary and commutes with the doubled Krein symmetry `ε`.\n-/\ntheorem modularTransportFlow_preserves_kreinInner_of_isSelfAdjoint_of_IsPhaseLinear_of_commute_modularSign\n    (hMod : EndH)\n    (hSelf : IsSelfAdjoint hMod)\n    (hPhase : IsPhaseLinear (E := E) hMod)\n    (hCommSign : Commute (modularSignEpsilon (E := E)) (modularTransportGenerator (E := E) hMod))\n    (t : ℝ) (u v : H₂) :\n    KreinSpace.kreinInner (H := H₂)\n      (modularTransportFlow (E := E) hMod t u)\n      (modularTransportFlow (E := E) hMod t v)\n      =\n    KreinSpace.kreinInner (H := H₂) u