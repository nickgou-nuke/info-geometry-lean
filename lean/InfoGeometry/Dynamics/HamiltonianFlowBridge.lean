import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Thermodynamics.SouriauWeylPartitionBridge
import InfoGeometry.Canonical.SouriauTomitaModularFlowBridge
import InfoGeometry.OperatorAlgebra.OperatorThermodynamics
import InfoGeometry.Krein.DoubledSpace
import InfoGeometry.Meta.Architecture

/-!
# InfoGeometry.Dynamics.HamiltonianFlowBridge

Dynamic layer of the Information Crystal.

This bridge connects the static thermodynamic partition (Souriau-Weyl) with the
dynamic Hamiltonian flow (Tomita-Takesaki). The modular flow is explicitly
generated by a self-adjoint modular Hamiltonian whose spectrum encodes the
Euler product.

Boundary: this file only transports fields supplied by the owner structures.
It does not fabricate a dynamical flow from missing data.
-/

noncomputable section

set_option linter.dupNamespace false

namespace InfoGeometry.Dynamics.HamiltonianFlowBridge

open InfoGeometry.Thermodynamics
open InfoGeometry.Canonical.SouriauTomitaModularFlowBridge
open InfoGeometry.OperatorAlgebra.Thermodynamics
open InfoGeometry.Krein

/--
Dynamic layer of the Information Crystal.

Brings together the static partition function identity and the modular
time-evolution.
-/
@[rep_depth transport]
structure HamiltonianFlowBridge
    (E Op H Finite Alg Symmetry : Type)
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] [Module ℝ E]
    [Ring Op] [StarRing Op]
    [NormedAddCommGroup H] [NormedSpace ℂ H] [SMul Op H] [CompleteSpace H]
    [InnerProductSpace ℝ H]
    [AddCommGroup Finite] [Module ℝ Finite] [LieRing Finite] [LieAlgebra ℝ Finite]
    [AddCommGroup Alg] [Module ℝ Alg] [LieRing Alg] [LieAlgebra ℝ Alg] where

  /-- The static Souriau-Weyl thermodynamic bridge. -/
  partition :
    SouriauWeylPartitionBridge E Op H Finite Alg

  /-- The Tomita-Takesaki/Souriau modular Hamiltonian flow context. -/
  modularContext :
    SouriauTomitaKMSContext (H := H) (Symmetry := Symmetry)

  /-- The self-adjoint Modular Hamiltonian on the doubled space. -/
  selfAdjointHamiltonian :
    DoubledSpace H →L[ℝ] DoubledSpace H

  /-- The Hamiltonian matches the Souriau thermal generator. -/
  hamiltonian_eq_thermalGenerator :
    selfAdjointHamiltonian = modularContext.logContext.modularHamiltonian

  /--
  The KMS inverse temperature `β` in the modular flow context matches
  the real part of the Souriau complex temperature parameter `s`.
  -/
  beta_eq_re_s :
    modularContext.beta = partition.temperature.s.re

  /--
  Spectral compatibility with the Weyl packet:
  The spectrum of the Hamiltonian encodes the positive roots of the Cantor-Cuntz
  symmetry group, completing the dynamical generation of the Euler product.
  -/
  spectralCompatibility :
    ∀ p ∈ partition.positiveRoots,
      ∃ (energy : ℝ), energy = Real.log (p : ℝ)

namespace HamiltonianFlowBridge

variable
    {E Op H Finite Alg Symmetry : Type}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] [Module ℝ E]
    [Ring Op] [StarRing Op]
    [NormedAddCommGroup H] [NormedSpace ℂ H] [SMul Op H] [CompleteSpace H]
    [InnerProductSpace ℝ H]
    [AddCommGroup Finite] [Module ℝ Finite] [LieRing Finite] [LieAlgebra ℝ Finite]
    [AddCommGroup Alg] [Module ℝ Alg] [LieRing Alg] [LieAlgebra ℝ Alg]

variable (B : HamiltonianFlowBridge E Op H Finite Alg Symmetry)

/-- The Hamiltonian strictly identifies with the Tomita thermal generator. -/
@[rep_depth transport]
theorem hamiltonian_is_souriau_generator :
    B.selfAdjointHamiltonian = B.modularContext.logContext.modularHamiltonian :=
  B.hamiltonian_eq_thermalGenerator

/--
The modular flow `σ_t` is the physical time evolution under the Hamiltonian.
Because `β = Re(s)`, the KMS boundary condition holds at the inverse temperature
given by the geometric evaluation of the positive roots.
-/
@[rep_depth transport]
theorem kms_inverse_temperature_eq_real_part_of_s :
    B.modularContext.beta = B.partition.temperature.s.re :=
  B.beta_eq_re_s

/-- The spectrum of the Hamiltonian explicitly encodes the positive roots. -/
@[rep_depth transport]
theorem positive_roots_spectral_encoding (p : ℕ) (hp : p ∈ B.partition.positiveRoots) :
    ∃ (energy : ℝ), energy = Real.log (p : ℝ) :=
  B.spectralCompatibility p hp

end HamiltonianFlowBridge

end InfoGeometry.Dynamics.HamiltonianFlowBridge
