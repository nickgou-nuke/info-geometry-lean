LIB "primdec.lib";
ring r = 0, (v1,v2,v3,v4,v5,v6,v7,v8,v9,v10), dp;

// Formulate the algebraic ideal generated by the split quadratic form
ideal I = v1^2 + v2^2 + v3^2 + v4^2 + v5^2 - v6^2 - v7^2 - v8^2 - v9^2 - v10^2;

// Compute the radical
ideal radI = radical(I);
print("Radical of I:");
print(radI);

// Show that the intersection with the Clifford algebra generators yields exactly F^2 = 0
// We evaluate a null vector F = v1 + v6
ideal F_eval = v1-1, v6-1, v2, v3, v4, v5, v7, v8, v9, v10;
ideal intersection = intersect(I, F_eval);
print("Intersection demonstrating F^2 = 0 on the null cone:");
print(intersection);
exit;
