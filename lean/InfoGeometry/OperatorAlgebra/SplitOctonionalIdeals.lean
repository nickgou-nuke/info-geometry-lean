import InfoGeometry.OperatorAlgebra.SplitOctonionMultiplication
import InfoGeometry.OperatorAlgebra.SplitOctonionSymplecticFoundation

namespace InfoGeometry.OperatorAlgebra.SplitOctonions.Multiplication
open InfoGeometry.OperatorAlgebra.SplitOctonions.SymplecticFoundation

/-- Left ideal generated by the ePlus Peirce projector. -/
def leftIdeal (X : SplitOct) : SplitOct := mulZ ePlus X

/-- Right ideal generated by the eMinus Peirce projector. -/
def rightIdeal (X : SplitOct) : SplitOct := mulZ X eMinus

@[simp] theorem leftIdeal_up (i : Fin 3) : leftIdeal (up i) = up i := by
  exact ePlus_mul_up i

@[simp] theorem rightIdeal_up (i : Fin 3) : rightIdeal (up i) = up i := by
  exact up_mul_eMinus i

@[simp] theorem leftIdeal_down (i : Fin 3) : leftIdeal (down i) = zeroZ := by
  exact ePlus_mul_down_zero i

@[simp] theorem rightIdeal_down (i : Fin 3) : rightIdeal (down i) = zeroZ := by
  exact down_mul_eMinus_zero i

theorem leftIdeal_up_eq_rightIdeal_up (i : Fin 3) :
    leftIdeal (up i) = rightIdeal (up i) := by
  dsimp [leftIdeal, rightIdeal]
  rw [ePlus_mul_up, up_mul_eMinus]

theorem up_ne_zero (i : Fin 3) : up i ≠ zeroZ := by
  fin_cases i <;> decide

theorem ePlus_not_central :
    ¬ (∀ X : SplitOct, mulZ ePlus X = mulZ X ePlus) := by
  intro h
  have hu := h (up 0)
  rw [ePlus_mul_up, up_mul_ePlus_zero] at hu
  exact up_ne_zero 0 hu

theorem leftIdeal_down_eq_rightIdeal_down (i : Fin 3) :
    leftIdeal (down i) = rightIdeal (down i) := by
  dsimp [leftIdeal, rightIdeal]
  rw [ePlus_mul_down_zero, down_mul_eMinus_zero]

theorem down_ne_zero (i : Fin 3) : down i ≠ zeroZ := by
  fin_cases i <;> decide

theorem eMinus_not_central :
    ¬ (∀ X : SplitOct, mulZ eMinus X = mulZ X eMinus) := by
  intro h
  have hd := h (down 0)
  rw [eMinus_mul_down, down_mul_eMinus_zero] at hd
  exact down_ne_zero 0 hd

/-- Two-sided ideal / corner generated by both projectors. -/
def twoSidedIdeal (X : SplitOct) : SplitOct := mulZ (mulZ ePlus X) eMinus

theorem twoSidedIdeal_up_eq_up (i : Fin 3) :
    twoSidedIdeal (up i) = up i := by
  dsimp [twoSidedIdeal]
  rw [ePlus_mul_up, up_mul_eMinus]

theorem twoSidedIdeal_down_eq_zero (i : Fin 3) :
    twoSidedIdeal (down i) = zeroZ := by
  dsimp [twoSidedIdeal]
  rw [ePlus_mul_down_zero, zeroZ_mulZ]

/-- The left ideal action is idempotent. -/
theorem leftIdeal_idempotent (X : SplitOct) : leftIdeal (leftIdeal X) = leftIdeal X := by
  cases X
  dsimp [leftIdeal, mulZ, ePlus]
  ext <;> ring

/-- The right ideal action is idempotent. -/
theorem rightIdeal_idempotent (X : SplitOct) : rightIdeal (rightIdeal X) = rightIdeal X := by
  cases X
  dsimp [rightIdeal, mulZ, eMinus]
  ext <;> ring

/-- Annihilation of the trace-one diagonal unit by the two-sided ideal map. -/
theorem twoSidedIdeal_annihilation : twoSidedIdeal (addZ ePlus eMinus) = zeroZ := rfl

end InfoGeometry.OperatorAlgebra.SplitOctonions.Multiplication
