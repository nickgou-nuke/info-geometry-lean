-- tools/macaulay2/derham_score.m2

-- 1. Define a polynomial ring over Q
R = QQ[x, y, z]

-- 2. Define a polynomial potential function (analogous to a Kahler potential)
Phi = x^3 + y^3 + z^3 + x*y*z

-- 3. The Score Function components are the first derivatives (gradient)
scoreX = diff(x, Phi)
scoreY = diff(y, Phi)
scoreZ = diff(z, Phi)

-- 4. The metric components (Fisher information / Hessian of potential)
gXX = diff(x, scoreX)
gXY = diff(y, scoreX)
gXZ = diff(z, scoreX)
gYY = diff(y, scoreY)
gYZ = diff(z, scoreY)
gZZ = diff(z, scoreZ)

-- 5. Formulate algebraic constraints natively inside polynomial ideals
-- We define an ideal generated by the score functions (critical points)
-- and some metric constraints (e.g., setting off-diagonal elements to zero to find orthogonal coordinates)
scoreIdeal = ideal(scoreX, scoreY, scoreZ)

-- Constraints for the metric to be diagonal:
metricConstraints = ideal(gXY, gXZ, gYZ)

-- Combine the ideals
totalIdeal = scoreIdeal + metricConstraints

-- 6. Compute properties of the ideal
gbTotal = gb(totalIdeal)
dimTotal = dim(totalIdeal)
degTotal = degree(totalIdeal)

print("Score Ideal:")
print toString(scoreIdeal)

print("Metric Constraints Ideal:")
print toString(metricConstraints)

print("Dimension of total ideal:")
print toString(dimTotal)

print("Degree of total ideal:")
print toString(degTotal)
