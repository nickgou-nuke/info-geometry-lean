import Mathlib.Tactic
import InfoGeometry.Canonical.Cl55OperatorProjectiveBoundary

/-!
# Native Clifford Reflection Actions

This file formalizes twisted-conjugation identities generated by an abstract
`OperatorCl55` family in an associative ring.  It does not define a Pin group,
an orthogonal group, or a covering homomorphism.
-/

variable {A : Type*} [Ring A] [Algebra ℚ A]

namespace NoncommutativeGeometry

open InfoGeometry.Canonical.Cl55OperatorProjectiveBoundary

variable {e f : Fin 5 → A} [hCl : OperatorCl55 e f]

/--
Twisted conjugation by a generator and a specified inverse candidate.
-/
def abstractReflection (u inv_u v : A) : A := - (u * v * inv_u)

/-- Positive generators square to +1, so they are their own inverse. -/
def e_reflect (e f : Fin 5 → A) (i : Fin 5) (v : A) : A := abstractReflection (e i) (e i) v

/-- Negative generators square to -1, so their inverse is -f_i. -/
def f_reflect (e f : Fin 5 → A) (i : Fin 5) (v : A) : A := abstractReflection (f i) (- f i) v

/--
Twisted conjugation preserves square-zero operators.  The minus sign in
`abstractReflection` means this is a square-zero statement, rather than a
claim that the twisted action is a multiplicative homomorphism.
-/
lemma abstractReflection_sq_zero (u inv_u x : A) (h_inv : inv_u * u = 1)
    (hx : x * x = 0) :
    abstractReflection u inv_u x * abstractReflection u inv_u x = 0 := by
  unfold abstractReflection
  calc
    (- (u * x * inv_u)) * (- (u * x * inv_u)) =
        u * x * (inv_u * u) * x * inv_u := by noncomm_ring
    _ = u * x * 1 * x * inv_u := by rw [h_inv]
    _ = u * (x * x) * inv_u := by simp only [mul_one, mul_assoc]
    _ = 0 := by simp [hx]

theorem e_reflect_preserves_boundary_annihilator_sq (i : Fin 5) :
    e_reflect e f i (boundaryAnnihilator e f) *
        e_reflect e f i (boundaryAnnihilator e f) = 0 := by
  apply abstractReflection_sq_zero
  · exact hCl.e_sq i
  · exact boundaryAnnihilator_sq (e := e) (f := f)

theorem f_reflect_preserves_boundary_annihilator_sq (i : Fin 5) :
    f_reflect e f i (boundaryAnnihilator e f) *
        f_reflect e f i (boundaryAnnihilator e f) = 0 := by
  apply abstractReflection_sq_zero
  · calc
      (- f i) * f i = - (f i * f i) := by rw [neg_mul]
      _ = - (-1) := by rw [hCl.f_sq i]
      _ = 1 := by simp
  · exact boundaryAnnihilator_sq (e := e) (f := f)

/--
A reflection generated by `e i` preserves `e i` itself.
-/
theorem e_reflect_self (i : Fin 5) : e_reflect e f i (e i) = - e i := by
  unfold e_reflect abstractReflection
  have h_sq : e i * e i = 1 := hCl.e_sq i
  calc
    - (e i * e i * e i) = - ((e i * e i) * e i) := by rfl
    _ = - (1 * e i) := by rw [h_sq]
    _ = - e i := by rw [one_mul]

theorem e_reflect_orthogonal_e (i j : Fin 5) (hij : i ≠ j) : e_reflect e f i (e j) = e j := by
  unfold e_reflect abstractReflection
  have h_anti : e i * e j = - (e j * e i) := by
    have h := hCl.e_anti i j hij
    calc
      e i * e j = e i * e j + e j * e i - e j * e i := by rw [add_sub_cancel_right]
      _ = 0 - e j * e i := by rw [h]
      _ = - (e j * e i) := by rw [zero_sub]
  have h_sq : e i * e i = 1 := hCl.e_sq i
  calc
    - (e i * e j * e i) = - (- (e j * e i) * e i) := by rw [h_anti]
    _ = - (- (e j * (e i * e i))) := by rw [neg_mul, mul_assoc]
    _ = e j * (e i * e i) := by rw [neg_neg]
    _ = e j * 1 := by rw [h_sq]
    _ = e j := by rw [mul_one]

theorem e_reflect_orthogonal_f (i j : Fin 5) : e_reflect e f i (f j) = f j := by
  unfold e_reflect abstractReflection
  have h_anti : e i * f j = - (f j * e i) := ef_anti_symm_55 i j
  have h_sq : e i * e i = 1 := hCl.e_sq i
  calc
    - (e i * f j * e i) = - (- (f j * e i) * e i) := by rw [h_anti]
    _ = - (- (f j * (e i * e i))) := by rw [neg_mul, mul_assoc]
    _ = f j * (e i * e i) := by rw [neg_neg]
    _ = f j * 1 := by rw [h_sq]
    _ = f j := by rw [mul_one]

/-- The positive-generator twisted conjugation is involutive. -/
theorem e_reflect_is_involution (i : Fin 5) (v : A) : e_reflect e f i (e_reflect e f i v) = v := by
  unfold e_reflect abstractReflection
  have h_sq : e i * e i = 1 := hCl.e_sq i
  calc
    - (e i * (- (e i * v * e i)) * e i) = - (e i * - (e i * v * e i) * e i) := by rfl
    _ = - (- (e i * (e i * v * e i)) * e i) := by rw [mul_neg]
    _ = e i * (e i * v * e i) * e i := by rw [neg_mul, neg_neg]
    _ = (e i * e i) * v * (e i * e i) := by simp only [mul_assoc]
    _ = 1 * v * 1 := by rw [h_sq]
    _ = v := by rw [one_mul, mul_one]

theorem f_reflect_is_involution (i : Fin 5) (v : A) :
    f_reflect e f i (f_reflect e f i v) = v := by
  unfold f_reflect abstractReflection
  have h_sq : f i * f i = -1 := hCl.f_sq i
  simp only [mul_neg, neg_neg]
  calc
    f i * (f i * v * f i) * f i =
        (f i * f i) * v * (f i * f i) := by simp only [mul_assoc]
    _ = (-1) * v * (-1) := by rw [h_sq]
    _ = v := by simp

end NoncommutativeGeometry
