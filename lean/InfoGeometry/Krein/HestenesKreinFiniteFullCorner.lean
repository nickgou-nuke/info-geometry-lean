import InfoGeometry.Algebra.IdempotentTwoSidedSpan
import InfoGeometry.Krein.HestenesKreinFinite

/-!
# Concrete fullness of the finite Hestenes sheet corner

The two-sided ideal generated by the native chiral projector `fPlus` is the
whole finite sheet matrix algebra.  The proof uses the existing nilpotent
transition operators `cPlus` and `cMinus`; no abstract primitivity or Morita
claim is introduced.
-/

namespace InfoGeometry.Krein.HestenesKreinFinite

open InfoGeometry.Algebra.IdempotentTwoSidedSpan
open InfoGeometry.Canonical.ChiralStokesPauliBasis

noncomputable section

theorem fPlus_mem_twoSidedSpan_fPlus :
    fPlus ∈ twoSidedSpan fPlus := by
  simpa using (generator_mem_twoSidedSpan fPlus (1 : Sheet) (1 : Sheet))

theorem fMinus_mem_twoSidedSpan_fPlus :
    fMinus ∈ twoSidedSpan fPlus := by
  have h := generator_mem_twoSidedSpan fPlus cMinus cPlus
  simpa [fPlus, fMinus, cMinus_mul_uPlus, cMinus_mul_cPlus] using h

theorem one_mem_twoSidedSpan_fPlus :
    (1 : Sheet) ∈ twoSidedSpan fPlus := by
  rw [← fPlus_add_fMinus]
  exact (twoSidedSpan fPlus).add_mem
    fPlus_mem_twoSidedSpan_fPlus fMinus_mem_twoSidedSpan_fPlus

theorem twoSidedSpan_fPlus_eq_top :
    twoSidedSpan fPlus = ⊤ := by
  apply le_antisymm
  · exact le_top
  · intro x _
    have hplus := generator_mem_twoSidedSpan fPlus x (1 : Sheet)
    have hminus := generator_mem_twoSidedSpan fPlus (x * cMinus) cPlus
    have hplus' : x * fPlus ∈ twoSidedSpan fPlus := by
      simpa using hplus
    have hsum : x * fPlus + x * fMinus ∈ twoSidedSpan fPlus :=
      (twoSidedSpan fPlus).add_mem hplus' (by
        simpa [fPlus, fMinus, cMinus_mul_uPlus, cMinus_mul_cPlus,
          mul_assoc] using hminus)
    have hdecomp : x = x * fPlus + x * fMinus := by
      rw [← mul_add, fPlus_add_fMinus, mul_one]
    rw [hdecomp]
    exact hsum

theorem fPlus_mem_twoSidedSpan_fMinus :
    fPlus ∈ twoSidedSpan fMinus := by
  have h := generator_mem_twoSidedSpan fMinus cPlus cMinus
  simpa [fPlus, fMinus, cPlus_mul_uMinus, cPlus_mul_cMinus] using h

theorem one_mem_twoSidedSpan_fMinus :
    (1 : Sheet) ∈ twoSidedSpan fMinus := by
  rw [← fPlus_add_fMinus]
  exact (twoSidedSpan fMinus).add_mem
    fPlus_mem_twoSidedSpan_fMinus
    (by simpa using
      (generator_mem_twoSidedSpan fMinus (1 : Sheet) (1 : Sheet)))

theorem twoSidedSpan_fMinus_eq_top :
    twoSidedSpan fMinus = ⊤ := by
  apply le_antisymm
  · exact le_top
  · intro x _
    have hminus := generator_mem_twoSidedSpan fMinus x (1 : Sheet)
    have hplus := generator_mem_twoSidedSpan fMinus (x * cPlus) cMinus
    have hminus' : x * fMinus ∈ twoSidedSpan fMinus := by
      simpa using hminus
    have hsum : x * fPlus + x * fMinus ∈ twoSidedSpan fMinus :=
      (twoSidedSpan fMinus).add_mem (by
        simpa [fPlus, fMinus, cPlus_mul_uMinus, cPlus_mul_cMinus,
          mul_assoc] using hplus) hminus'
    have hdecomp : x = x * fPlus + x * fMinus := by
      rw [← mul_add, fPlus_add_fMinus, mul_one]
    rw [hdecomp]
    exact hsum

/-! The generic idempotent-corner carrier agrees with the native Peirce
scalar-line readout at the two finite sheets. -/

theorem fPlus_generic_corner_eq_scalar_line
    (c : InfoGeometry.Algebra.IdempotentCornerCommutant.corner
      fPlus fPlus_idempotent) :
    ∃ z : ℂ, c.1 = z • fPlus := by
  apply fPlus_corner_eq_scalar_line
  change fPlus * c.1 * fPlus = c.1
  calc
    fPlus * c.1 * fPlus = (fPlus * c.1) * fPlus := by rfl
    _ = c.1 * fPlus := by rw [c.2.2]
    _ = c.1 := c.2.1

theorem fMinus_generic_corner_eq_scalar_line
    (c : InfoGeometry.Algebra.IdempotentCornerCommutant.corner
      fMinus fMinus_idempotent) :
    ∃ z : ℂ, c.1 = z • fMinus := by
  apply fMinus_corner_eq_scalar_line
  change fMinus * c.1 * fMinus = c.1
  calc
    fMinus * c.1 * fMinus = (fMinus * c.1) * fMinus := by rfl
    _ = c.1 * fMinus := by rw [c.2.2]
    _ = c.1 := c.2.1

theorem fPlus_endomorphism_eq_scalar_rightCornerMap
    (T : Module.End Sheet
      (InfoGeometry.Algebra.IdempotentCornerCommutant.principalLeftIdeal
        fPlus fPlus_idempotent)) :
    ∃ z : ℂ,
      T = InfoGeometry.Algebra.IdempotentCornerCommutant.rightCornerMap
        fPlus fPlus_idempotent
        ⟨z • fPlus, by
          constructor
          · simp [fPlus_idempotent]
          · simp [fPlus_idempotent]⟩ := by
  let c :=
    InfoGeometry.Algebra.IdempotentCornerCommutant.corner_of_idempotent_endomorphism
      fPlus fPlus_idempotent T
  obtain ⟨z, hz⟩ := fPlus_generic_corner_eq_scalar_line c
  have hc : c =
      ⟨z • fPlus, by
        constructor
        · simp [fPlus_idempotent]
        · simp [fPlus_idempotent]⟩ := by
    apply Subtype.ext
    exact hz
  refine ⟨z, ?_⟩
  rw [← hc]
  exact InfoGeometry.Algebra.IdempotentCornerCommutant.corner_endomorphism_eq_rightCornerMap
    fPlus fPlus_idempotent T

theorem fMinus_endomorphism_eq_scalar_rightCornerMap
    (T : Module.End Sheet
      (InfoGeometry.Algebra.IdempotentCornerCommutant.principalLeftIdeal
        fMinus fMinus_idempotent)) :
    ∃ z : ℂ,
      T = InfoGeometry.Algebra.IdempotentCornerCommutant.rightCornerMap
        fMinus fMinus_idempotent
        ⟨z • fMinus, by
          constructor
          · simp [fMinus_idempotent]
          · simp [fMinus_idempotent]⟩ := by
  let c :=
    InfoGeometry.Algebra.IdempotentCornerCommutant.corner_of_idempotent_endomorphism
      fMinus fMinus_idempotent T
  obtain ⟨z, hz⟩ := fMinus_generic_corner_eq_scalar_line c
  have hc : c =
      ⟨z • fMinus, by
        constructor
        · simp [fMinus_idempotent]
        · simp [fMinus_idempotent]⟩ := by
    apply Subtype.ext
    exact hz
  refine ⟨z, ?_⟩
  rw [← hc]
  exact InfoGeometry.Algebra.IdempotentCornerCommutant.corner_endomorphism_eq_rightCornerMap
    fMinus fMinus_idempotent T

end

end InfoGeometry.Krein.HestenesKreinFinite
