ring r = 0, (z1,z2,d1,d2,D1,D2), dp;
matrix C[6][6];
matrix D[6][6];
int i, j;
for(i=1; i<=6; i++) {
  for(j=i+1; j<=6; j++) {
    C[i,j] = 1;
    D[i,j] = 0;
  }
}
D[1,3] = 1;
D[2,4] = 1;

def W = nc_algebra(C, D);
setring W;

poly Wm1 = d1 + d2;
poly W0 = z1*d1 + z2*d2 + D1 + D2;
poly W1 = z1^2*d1 + z2^2*d2 + 2*D1*z1 + 2*D2*z2;

poly comm1 = W0*Wm1 - Wm1*W0;
poly comm2 = W0*W1 - W1*W0;
poly comm3 = Wm1*W1 - W1*Wm1;

if (comm1 == -Wm1) {
    print("[W0, W_{-1}] = -W_{-1} holds");
} else {
    print("Error: [W0, W_{-1}] != -W_{-1}");
}

if (comm2 == W1) {
    print("[W0, W_1] = W_1 holds");
} else {
    print("Error: [W0, W_1] != W_1");
}

if (comm3 == 2*W0) {
    print("[W_1, W_{-1}] = 2W_0 holds"); // via [W_{-1}, W_1]
} else {
    print("Error: [W_{-1}, W_1] != 2W_0");
}

quit;
