import Mathlib.Algebra.Module.LinearMap.Basic
import Mathlib.Algebra.Algebra.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Abel

namespace InfoGeometry.Exceptional.Bigrading

/-!
# The V₄ Contact-Chiral Bigrading

This module formalizes the Klein four-group ($V_4 \cong \mathbb{Z}_2 \times \mathbb{Z}_2$) action
generated by:
1. The Peirce circular chiral involution ($\chi$)
2. The contact lane flip involution ($C$)

It establishes the complete orthogonal resolution of the identity into four projector components:
$P_{++}, P_{+-}, P_{-+}, P_{--}$.
-/

variable {R V : Type*} [CommRing R] [Invertible (2 : R)] [AddCommGroup V] [Module R V]

/-- The V₄ Symmetry contract on an endomorphism ring. -/
structure V4Symmetry (R V : Type*) [CommRing R] [AddCommGroup V] [Module R V] where
  C : Module.End R V
  chi : Module.End R V
  C_sq : C * C = 1
  chi_sq : chi * chi = 1
  comm : C * chi = chi * C

namespace V4Symmetry

variable (v4 : V4Symmetry R V)

/-- The scalar factor 1/4 in R. -/
def fourth : R := ⅟(2 : R) * ⅟(2 : R)

lemma four_mul_fourth : (4 : R) * (fourth (R := R)) = (1 : R) := by
  dsimp [fourth]
  calc (4 : R) * (⅟(2 : R) * ⅟(2 : R)) = (2 * 2 : R) * (⅟(2 : R) * ⅟(2 : R)) := by ring
    _ = (2 * ⅟(2 : R)) * (2 * ⅟(2 : R)) := by ring
    _ = 1 * 1 := by rw [mul_invOf_self]
    _ = 1 := mul_one 1

lemma fourth_mul_four : (fourth (R := R)) * (4 : R) = (1 : R) := by
  rw [mul_comm, four_mul_fourth]

lemma fourth_mul_fourth_mul_four : (fourth (R := R)) * (fourth (R := R)) * (4 : R) = (fourth (R := R)) := by
  calc (fourth (R := R)) * (fourth (R := R)) * (4 : R)
    _ = (fourth (R := R)) * ((fourth (R := R)) * (4 : R)) := by rw [mul_assoc]
    _ = (fourth (R := R)) * 1 := by rw [fourth_mul_four]
    _ = (fourth (R := R)) := mul_one _

omit [Invertible (2 : R)] in
lemma four_smul_one_eq : (4 : R) • (1 : Module.End R V) = 1 + 1 + 1 + 1 := by
  rw [show (4 : R) = 1 + 1 + 1 + 1 by ring, add_smul, add_smul, add_smul, one_smul]

/-! ### 1. Definition of the Four Projectors -/

def P_plus_plus : Module.End R V := (fourth (R := R)) • ((1 + v4.C) * (1 + v4.chi))
def P_plus_minus : Module.End R V := (fourth (R := R)) • ((1 + v4.C) * (1 - v4.chi))
def P_minus_plus : Module.End R V := (fourth (R := R)) • ((1 - v4.C) * (1 + v4.chi))
def P_minus_minus : Module.End R V := (fourth (R := R)) • ((1 - v4.C) * (1 - v4.chi))

/-! ### 2. Algebraic Commutation and Factorization Lemmas -/

omit [Invertible (2 : R)] in
lemma chi_comm_one_add_C : (1 + v4.chi) * (1 + v4.C) = (1 + v4.C) * (1 + v4.chi) := by
  calc (1 + v4.chi) * (1 + v4.C)
    _ = 1 + v4.C + v4.chi + v4.chi * v4.C := by
        simp only [mul_add, add_mul, mul_one, one_mul]
        abel
    _ = 1 + v4.C + v4.chi + v4.C * v4.chi := by rw [← v4.comm]
    _ = (1 + v4.C) * (1 + v4.chi) := by
        simp only [mul_add, add_mul, mul_one, one_mul]
        abel

omit [Invertible (2 : R)] in
lemma chi_comm_one_sub_C : (1 + v4.chi) * (1 - v4.C) = (1 - v4.C) * (1 + v4.chi) := by
  calc (1 + v4.chi) * (1 - v4.C)
    _ = 1 - v4.C + v4.chi - v4.chi * v4.C := by
        simp only [mul_sub, add_mul, mul_one, one_mul]
        abel
    _ = 1 - v4.C + v4.chi - v4.C * v4.chi := by rw [← v4.comm]
    _ = (1 - v4.C) * (1 + v4.chi) := by
        simp only [sub_mul, mul_add, mul_one, one_mul]
        abel

omit [Invertible (2 : R)] in
lemma one_sub_chi_comm_one_add_C : (1 - v4.chi) * (1 + v4.C) = (1 + v4.C) * (1 - v4.chi) := by
  calc (1 - v4.chi) * (1 + v4.C)
    _ = 1 + v4.C - v4.chi - v4.chi * v4.C := by
        simp only [sub_mul, mul_add, mul_one, one_mul]
        abel
    _ = 1 + v4.C - v4.chi - v4.C * v4.chi := by rw [← v4.comm]
    _ = (1 + v4.C) * (1 - v4.chi) := by
        simp only [mul_sub, add_mul, mul_one, one_mul]
        abel

omit [Invertible (2 : R)] in
lemma chi_mul_chi_sub_one : (1 + v4.chi) * (1 - v4.chi) = 0 := by
  calc (1 + v4.chi) * (1 - v4.chi)
    _ = 1 - v4.chi * v4.chi := by
        simp only [mul_sub, add_mul, mul_one, one_mul]
        abel
    _ = 1 - 1 := by rw [v4.chi_sq]
    _ = 0 := sub_self 1

omit [Invertible (2 : R)] in
lemma C_mul_C_sub_one : (1 + v4.C) * (1 - v4.C) = 0 := by
  calc (1 + v4.C) * (1 - v4.C)
    _ = 1 - v4.C * v4.C := by
        simp only [mul_sub, add_mul, mul_one, one_mul]
        abel
    _ = 1 - 1 := by rw [v4.C_sq]
    _ = 0 := sub_self 1

omit [Invertible (2 : R)] in
lemma one_add_C_sq : (1 + v4.C) * (1 + v4.C) = (2 : R) • (1 + v4.C) := by
  calc (1 + v4.C) * (1 + v4.C)
    _ = 1 + (2 : R) • v4.C + v4.C * v4.C := by
        simp only [mul_add, add_mul, mul_one, one_mul]
        rw [two_smul]
        abel
    _ = 1 + (2 : R) • v4.C + 1 := by rw [v4.C_sq]
    _ = (2 : R) • (1 + v4.C) := by
        simp only [two_smul, smul_add]
        abel

omit [Invertible (2 : R)] in
lemma one_sub_C_sq : (1 - v4.C) * (1 - v4.C) = (2 : R) • (1 - v4.C) := by
  calc (1 - v4.C) * (1 - v4.C)
    _ = 1 - (2 : R) • v4.C + v4.C * v4.C := by
        simp only [mul_sub, sub_mul, mul_one, one_mul]
        rw [two_smul]
        abel
    _ = 1 - (2 : R) • v4.C + 1 := by rw [v4.C_sq]
    _ = (2 : R) • (1 - v4.C) := by
        simp only [two_smul, smul_sub]
        abel

omit [Invertible (2 : R)] in
lemma one_add_chi_sq : (1 + v4.chi) * (1 + v4.chi) = (2 : R) • (1 + v4.chi) := by
  calc (1 + v4.chi) * (1 + v4.chi)
    _ = 1 + (2 : R) • v4.chi + v4.chi * v4.chi := by
        simp only [mul_add, add_mul, mul_one, one_mul]
        rw [two_smul]
        abel
    _ = 1 + (2 : R) • v4.chi + 1 := by rw [v4.chi_sq]
    _ = (2 : R) • (1 + v4.chi) := by
        simp only [two_smul, smul_add]
        abel

omit [Invertible (2 : R)] in
lemma one_sub_chi_sq : (1 - v4.chi) * (1 - v4.chi) = (2 : R) • (1 - v4.chi) := by
  calc (1 - v4.chi) * (1 - v4.chi)
    _ = 1 - (2 : R) • v4.chi + v4.chi * v4.chi := by
        simp only [mul_sub, sub_mul, mul_one, one_mul]
        rw [two_smul]
        abel
    _ = 1 - (2 : R) • v4.chi + 1 := by rw [v4.chi_sq]
    _ = (2 : R) • (1 - v4.chi) := by
        simp only [two_smul, smul_sub]
        abel

/-! ### 3. Orthogonality -/

theorem P_plus_plus_mul_P_plus_minus : v4.P_plus_plus * v4.P_plus_minus = 0 := by
  dsimp [P_plus_plus, P_plus_minus]
  rw [smul_mul_smul]
  have h_inner : ((1 + v4.C) * (1 + v4.chi)) * ((1 + v4.C) * (1 - v4.chi)) = 0 := by
    calc ((1 + v4.C) * (1 + v4.chi)) * ((1 + v4.C) * (1 - v4.chi))
      _ = (1 + v4.C) * ((1 + v4.chi) * (1 + v4.C)) * (1 - v4.chi) := by
          simp only [mul_assoc]
      _ = (1 + v4.C) * ((1 + v4.C) * (1 + v4.chi)) * (1 - v4.chi) := by
          rw [chi_comm_one_add_C]
      _ = (1 + v4.C) * (1 + v4.C) * ((1 + v4.chi) * (1 - v4.chi)) := by
          simp only [mul_assoc]
      _ = (1 + v4.C) * (1 + v4.C) * 0 := by
          rw [chi_mul_chi_sub_one]
      _ = 0 := mul_zero _
  rw [h_inner, smul_zero]

theorem P_plus_plus_mul_P_minus_plus : v4.P_plus_plus * v4.P_minus_plus = 0 := by
  dsimp [P_plus_plus, P_minus_plus]
  rw [smul_mul_smul]
  have h_inner : ((1 + v4.C) * (1 + v4.chi)) * ((1 - v4.C) * (1 + v4.chi)) = 0 := by
    calc ((1 + v4.C) * (1 + v4.chi)) * ((1 - v4.C) * (1 + v4.chi))
      _ = (1 + v4.C) * ((1 + v4.chi) * (1 - v4.C)) * (1 + v4.chi) := by
          simp only [mul_assoc]
      _ = (1 + v4.C) * ((1 - v4.C) * (1 + v4.chi)) * (1 + v4.chi) := by
          rw [chi_comm_one_sub_C]
      _ = ((1 + v4.C) * (1 - v4.C)) * ((1 + v4.chi) * (1 + v4.chi)) := by
          simp only [mul_assoc]
      _ = 0 * ((1 + v4.chi) * (1 + v4.chi)) := by
          rw [C_mul_C_sub_one]
      _ = 0 := zero_mul _
  rw [h_inner, smul_zero]

theorem P_plus_plus_mul_P_minus_minus : v4.P_plus_plus * v4.P_minus_minus = 0 := by
  dsimp [P_plus_plus, P_minus_minus]
  rw [smul_mul_smul]
  have h_inner : ((1 + v4.C) * (1 + v4.chi)) * ((1 - v4.C) * (1 - v4.chi)) = 0 := by
    calc ((1 + v4.C) * (1 + v4.chi)) * ((1 - v4.C) * (1 - v4.chi))
      _ = (1 + v4.C) * ((1 + v4.chi) * (1 - v4.C)) * (1 - v4.chi) := by
          simp only [mul_assoc]
      _ = (1 + v4.C) * ((1 - v4.C) * (1 + v4.chi)) * (1 - v4.chi) := by
          rw [chi_comm_one_sub_C]
      _ = ((1 + v4.C) * (1 - v4.C)) * ((1 + v4.chi) * (1 - v4.chi)) := by
          simp only [mul_assoc]
      _ = 0 * ((1 + v4.chi) * (1 - v4.chi)) := by
          rw [C_mul_C_sub_one]
      _ = 0 := zero_mul _
  rw [h_inner, smul_zero]

/-! ### 4. Idempotency -/

theorem P_plus_plus_sq : v4.P_plus_plus * v4.P_plus_plus = v4.P_plus_plus := by
  dsimp [P_plus_plus]
  rw [smul_mul_smul]
  have h_inner : ((1 + v4.C) * (1 + v4.chi)) * ((1 + v4.C) * (1 + v4.chi)) =
      (4 : R) • ((1 + v4.C) * (1 + v4.chi)) := by
    calc ((1 + v4.C) * (1 + v4.chi)) * ((1 + v4.C) * (1 + v4.chi))
      _ = (1 + v4.C) * ((1 + v4.chi) * (1 + v4.C)) * (1 + v4.chi) := by
          simp only [mul_assoc]
      _ = (1 + v4.C) * ((1 + v4.C) * (1 + v4.chi)) * (1 + v4.chi) := by
          rw [chi_comm_one_add_C]
      _ = ((1 + v4.C) * (1 + v4.C)) * ((1 + v4.chi) * (1 + v4.chi)) := by
          simp only [mul_assoc]
      _ = ((2 : R) • (1 + v4.C)) * ((2 : R) • (1 + v4.chi)) := by
          rw [one_add_C_sq, one_add_chi_sq]
      _ = (2 * 2 : R) • ((1 + v4.C) * (1 + v4.chi)) := by
          rw [smul_mul_smul]
      _ = (4 : R) • ((1 + v4.C) * (1 + v4.chi)) := by
          norm_num
  rw [h_inner, smul_smul, fourth_mul_fourth_mul_four]

theorem P_plus_minus_sq : v4.P_plus_minus * v4.P_plus_minus = v4.P_plus_minus := by
  dsimp [P_plus_minus]
  rw [smul_mul_smul]
  have h_inner : ((1 + v4.C) * (1 - v4.chi)) * ((1 + v4.C) * (1 - v4.chi)) =
      (4 : R) • ((1 + v4.C) * (1 - v4.chi)) := by
    calc ((1 + v4.C) * (1 - v4.chi)) * ((1 + v4.C) * (1 - v4.chi))
      _ = (1 + v4.C) * ((1 - v4.chi) * (1 + v4.C)) * (1 - v4.chi) := by
          simp only [mul_assoc]
      _ = (1 + v4.C) * ((1 + v4.C) * (1 - v4.chi)) * (1 - v4.chi) := by
          rw [one_sub_chi_comm_one_add_C]
      _ = ((1 + v4.C) * (1 + v4.C)) * ((1 - v4.chi) * (1 - v4.chi)) := by
          simp only [mul_assoc]
      _ = ((2 : R) • (1 + v4.C)) * ((2 : R) • (1 - v4.chi)) := by
          rw [one_add_C_sq, one_sub_chi_sq]
      _ = (2 * 2 : R) • ((1 + v4.C) * (1 - v4.chi)) := by
          rw [smul_mul_smul]
      _ = (4 : R) • ((1 + v4.C) * (1 - v4.chi)) := by
          norm_num
  rw [h_inner, smul_smul, fourth_mul_fourth_mul_four]

/-! ### 5. Completeness: Resolution of the Identity -/

theorem sum_projectors_eq_one :
    v4.P_plus_plus + v4.P_plus_minus + v4.P_minus_plus + v4.P_minus_minus = 1 := by
  dsimp [P_plus_plus, P_plus_minus, P_minus_plus, P_minus_minus]
  rw [← smul_add, ← smul_add, ← smul_add]
  have h_inner : (1 + v4.C) * (1 + v4.chi) + (1 + v4.C) * (1 - v4.chi) +
      (1 - v4.C) * (1 + v4.chi) + (1 - v4.C) * (1 - v4.chi) = (4 : R) • (1 : Module.End R V) := by
    rw [four_smul_one_eq]
    simp only [mul_add, add_mul, mul_sub, sub_mul, mul_one, one_mul]
    abel
  rw [h_inner, smul_smul, fourth_mul_four, one_smul]

end V4Symmetry
end InfoGeometry.Exceptional.Bigrading
