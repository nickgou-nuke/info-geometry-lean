import Mathlib

/-!
# Chiral channels in an associative operator algebra

The carrier is any associative algebra. The channel and dissipator identities
retain the order of all operator products; no matrix coordinates, coefficient
commutativity, positivity, or scalar-spectrum claim is used.
-/

namespace InfoGeometry.OperatorAlgebra.NoncommutativeChiralChannels

variable {A : Type*} [Ring A]

/-- Symmetric cross-channel generated by a pair of operators. -/
def crossChannel (u v x : A) : A := u * x * v + v * x * u

/-- Same-branch channel generated by a pair of operators. -/
def sameChannel (u v x : A) : A := u * x * u + v * x * v

/-- The sum and difference modes. -/
def diracMode (u v : A) : A := u + v
def axialMode (u v : A) : A := u - v

/-- The commutator spin associated with a channel pair. -/
def spinMode (u v : A) : A := u * v - v * u

/-- The Jordan mass coefficient, with its operator order exposed. -/
def massMode (u v : A) : A := u * v + v * u

/-- Associative commutator and anticommutator. -/
def commutator (x y : A) : A := x * y - y * x
def anticommutator (x y : A) : A := x * y + y * x

/-- The sum of the two channels is the sandwich by the sum mode. This identity
holds without hypotheses on the operators or their commutation. -/
theorem channels_add_eq_dirac_sandwich (u v x : A) :
    crossChannel u v x + sameChannel u v x =
      diracMode u v * x * diracMode u v := by
  unfold crossChannel sameChannel diracMode
  noncomm_ring

/-- The difference of the channels is the negative sandwich by the difference
mode. -/
theorem channels_sub_eq_neg_axial_sandwich (u v x : A) :
    crossChannel u v x - sameChannel u v x =
      -(axialMode u v * x * axialMode u v) := by
  unfold crossChannel sameChannel axialMode
  noncomm_ring

/-- For square-zero channels, the Jordan mass is the square of the Dirac
mode, and the negative of the axial-mode square. -/
theorem mode_squares {u v : A} (hu : u * u = 0) (hv : v * v = 0) :
    diracMode u v * diracMode u v = massMode u v ∧
    axialMode u v * axialMode u v = -massMode u v := by
  constructor
  · change (u + v) * (u + v) = u * v + v * u
    noncomm_ring [hu, hv]
  · change (u - v) * (u - v) = -(u * v + v * u)
    noncomm_ring [hu, hv]

/-- The full Dirac dissipator built from both channels. -/
def diracDissipator (u v x : A) : A :=
  (2 : ℕ) • (crossChannel u v x + sameChannel u v x) -
    anticommutator (massMode u v) x

/-- The symmetric cross dissipator. -/
def symmetricDissipator (u v x : A) : A :=
  (2 : ℕ) • crossChannel u v x - anticommutator (massMode u v) x

/-- The axial dissipator built from the difference of the channels. -/
def axialDissipator (u v x : A) : A :=
  (2 : ℕ) • (crossChannel u v x - sameChannel u v x) -
    anticommutator (massMode u v) x

/-- For square-zero channel operators, the full two-channel dissipator is the
negative double commutator by the Dirac mode. -/
theorem diracDissipator_eq_neg_double_commutator {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) (x : A) :
    diracDissipator u v x =
      -commutator (diracMode u v) (commutator (diracMode u v) x) := by
  unfold diracDissipator crossChannel sameChannel anticommutator massMode
    commutator diracMode
  have huuL : u * (u * x) = 0 := by rw [← mul_assoc, hu, zero_mul]
  have huuR : (x * u) * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have hvvL : v * (v * x) = 0 := by rw [← mul_assoc, hv, zero_mul]
  have hvvR : (x * v) * v = 0 := by rw [mul_assoc, hv, mul_zero]
  noncomm_ring [hu, hv, huuL, huuR, hvvL, hvvR]

/-- The symmetric dissipator is a mixed double commutator. The mass factor
remains an operator. -/
theorem symmetricDissipator_eq_mixed_commutators (u v x : A) :
    symmetricDissipator u v x =
      -(commutator u (commutator v x) + commutator v (commutator u x)) := by
  unfold symmetricDissipator crossChannel anticommutator massMode
    commutator
  noncomm_ring

/-- The axial dissipator is the positive double commutator by the axial mode
for square-zero channel operators. -/
theorem axialDissipator_eq_double_commutator {u v : A}
    (hu : u * u = 0) (hv : v * v = 0) (x : A) :
    axialDissipator u v x =
      commutator (axialMode u v) (commutator (axialMode u v) x) := by
  unfold axialDissipator crossChannel sameChannel anticommutator massMode
    commutator axialMode
  have huuL : u * (u * x) = 0 := by rw [← mul_assoc, hu, zero_mul]
  have huuR : (x * u) * u = 0 := by rw [mul_assoc, hu, mul_zero]
  have hvvL : v * (v * x) = 0 := by rw [← mul_assoc, hv, zero_mul]
  have hvvR : (x * v) * v = 0 := by rw [mul_assoc, hv, mul_zero]
  noncomm_ring [hu, hv, huuL, huuR, hvvL, hvvR]

/-- The symmetric channel is exactly the midpoint of the full Dirac and axial
dissipators. -/
theorem dissipator_midpoint_identity (u v x : A) :
    (2 : ℕ) • symmetricDissipator u v x =
      diracDissipator u v x + axialDissipator u v x := by
  unfold symmetricDissipator diracDissipator axialDissipator
    anticommutator massMode crossChannel sameChannel
  simp only [two_nsmul]
  abel

/-- Exact operator actions of the full Dirac dissipator on the four modes
generated by a reflexive square-zero pair. The decay factors are left
multiplication by the Jordan mass operator; this theorem asserts no scalar
eigenvalues or numerical spectral gap. -/
theorem diracDissipator_reflexive_pair_actions {u v : A}
    (hu : u * u = 0) (hv : v * v = 0)
    (huv : u * v * u = u) (hvu : v * u * v = v) :
    diracDissipator u v 1 = 0 ∧
    diracDissipator u v (massMode u v) = 0 ∧
    diracDissipator u v (diracMode u v) = 0 ∧
    diracDissipator u v (axialMode u v) =
      -((4 : ℕ) • (massMode u v * axialMode u v)) ∧
    diracDissipator u v (spinMode u v) =
      -((4 : ℕ) • (massMode u v * spinMode u v)) := by
  have hD := diracDissipator_eq_neg_double_commutator hu hv
  have hMassSq : massMode u v = diracMode u v * diracMode u v :=
    (mode_squares hu hv).1.symm
  have huv' : u * (v * u) = u := by simpa [mul_assoc] using huv
  have hvu' : v * (u * v) = v := by simpa [mul_assoc] using hvu
  have huuV : u * (u * v) = 0 := by rw [← mul_assoc, hu, zero_mul]
  have hvvU : v * (v * u) = 0 := by rw [← mul_assoc, hv, zero_mul]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [hD]
    simp [commutator]
  · rw [hD]
    rw [hMassSq]
    unfold commutator diracMode
    noncomm_ring
  · rw [hD]
    simp [commutator]
  · rw [hD]
    unfold commutator diracMode axialMode massMode
    noncomm_ring [hu, hv, huv, hvu, huv', hvu', huuV, hvvU]
  · rw [hD]
    unfold commutator diracMode spinMode massMode
    noncomm_ring [hu, hv, huv, hvu, huv', hvu', huuV, hvvU]

end InfoGeometry.OperatorAlgebra.NoncommutativeChiralChannels
