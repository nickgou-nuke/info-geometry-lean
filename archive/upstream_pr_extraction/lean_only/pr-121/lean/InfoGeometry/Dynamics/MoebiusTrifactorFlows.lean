import Mathlib
import InfoGeometry.Lie.CayleyTransformBridge

/-!
# Cyclotomic, Hyperbolic, and Parabolic Lie-Möbius Flows

This module formalizes finite evolution operators generated by the symmetric and
antisymmetric completions (cos/sin and cosh/sinh) under the algebraic minimal polynomials:
1. **Elliptic (Cyclotomic) Flows**: $J^2 = -1 \implies R_J(t) = \cos(t) \cdot I + \sin(t) \cdot J$.
2. **Hyperbolic (Scale/Boost) Flows**: $H^2 = 1 \implies B_H(t) = \cosh(t) \cdot I + \sinh(t) \cdot H$.
3. **Parabolic (Light Cone) Flows**: $N^2 = 0 \implies U_N(t) = I + t \cdot N$.
4. **Loxodromic Flows**: $L_{J, H}(\theta, s) = R_J(\theta) \cdot B_H(s)$, forming a 2-parameter group when $[J, H] = 0$.

All proofs are complete in native Lean 4 + Mathlib with **0 sorrys, 0 admits, and 0 custom axioms**.
-/

namespace InfoGeometry.Dynamics.MoebiusFlow

noncomputable section

variable {A : Type*} [Ring A] [Algebra ℝ A]

lemma smul_mul_smul (r1 r2 : ℝ) (x y : A) :
    (r1 • x) * (r2 • y) = (r1 * r2) • (x * y) := by
  rw [smul_mul_assoc, mul_smul_comm, smul_smul]

/-- 1. Elliptic (Cyclotomic) Flow: $J^2 = -1$. -/
def ellipticFlow (J : A) (t : ℝ) : A :=
  (Real.cos t) • (1 : A) + (Real.sin t) • J

@[simp] theorem ellipticFlow_zero (J : A) : ellipticFlow J 0 = 1 := by
  dsimp [ellipticFlow]
  simp

theorem ellipticFlow_mul (J : A) (hJ : J * J = -1) (s t : ℝ) :
    ellipticFlow J s * ellipticFlow J t = ellipticFlow J (s + t) := by
  dsimp [ellipticFlow]
  have h_exp :
      (Real.cos s • (1 : A) + Real.sin s • J) * (Real.cos t • (1 : A) + Real.sin t • J) =
      (Real.cos s * Real.cos t) • (1 : A) +
      (Real.cos s * Real.sin t) • J +
      (Real.sin s * Real.cos t) • J +
      (Real.sin s * Real.sin t) • (J * J) := by
    simp only [add_mul, mul_add, smul_mul_smul, mul_one, one_mul]
    abel
  rw [h_exp, hJ]
  have h_neg : (Real.sin s * Real.sin t) • (-1 : A) = - ((Real.sin s * Real.sin t) • (1 : A)) := by
    simp [smul_neg]
  rw [h_neg]
  have h_cos : (Real.cos s * Real.cos t) • (1 : A) + -((Real.sin s * Real.sin t) • (1 : A)) =
      (Real.cos (s + t)) • (1 : A) := by
    rw [← sub_eq_add_neg, ← sub_smul, Real.cos_add]
  have h_sin : (Real.cos s * Real.sin t) • J + (Real.sin s * Real.cos t) • J =
      (Real.sin (s + t)) • J := by
    rw [← add_smul]
    have hst : Real.cos s * Real.sin t + Real.sin s * Real.cos t = Real.sin (s + t) := by
      rw [Real.sin_add]
      ring
    rw [hst]
  calc
    (Real.cos s * Real.cos t) • (1 : A) + (Real.cos s * Real.sin t) • J +
        (Real.sin s * Real.cos t) • J + -((Real.sin s * Real.sin t) • (1 : A)) =
      ((Real.cos s * Real.cos t) • (1 : A) + -((Real.sin s * Real.sin t) • (1 : A))) +
        ((Real.cos s * Real.sin t) • J + (Real.sin s * Real.cos t) • J) := by abel
    _ = (Real.cos (s + t)) • (1 : A) + (Real.sin (s + t)) • J := by rw [h_cos, h_sin]

/-- 2. Hyperbolic Flow: $H^2 = 1$. -/
def hyperbolicFlow (H : A) (t : ℝ) : A :=
  (Real.cosh t) • (1 : A) + (Real.sinh t) • H

@[simp] theorem hyperbolicFlow_zero (H : A) : hyperbolicFlow H 0 = 1 := by
  dsimp [hyperbolicFlow]
  simp

theorem hyperbolicFlow_mul (H : A) (hH : H * H = 1) (s t : ℝ) :
    hyperbolicFlow H s * hyperbolicFlow H t = hyperbolicFlow H (s + t) := by
  dsimp [hyperbolicFlow]
  have h_exp :
      (Real.cosh s • (1 : A) + Real.sinh s • H) * (Real.cosh t • (1 : A) + Real.sinh t • H) =
      (Real.cosh s * Real.cosh t) • (1 : A) +
      (Real.cosh s * Real.sinh t) • H +
      (Real.sinh s * Real.cosh t) • H +
      (Real.sinh s * Real.sinh t) • (H * H) := by
    simp only [add_mul, mul_add, smul_mul_smul, mul_one, one_mul]
    abel
  rw [h_exp, hH]
  have h_cosh : (Real.cosh s * Real.cosh t) • (1 : A) + (Real.sinh s * Real.sinh t) • (1 : A) =
      (Real.cosh (s + t)) • (1 : A) := by
    rw [← add_smul, Real.cosh_add]
  have h_sinh : (Real.cosh s * Real.sinh t) • H + (Real.sinh s * Real.cosh t) • H =
      (Real.sinh (s + t)) • H := by
    rw [← add_smul]
    have hst : Real.cosh s * Real.sinh t + Real.sinh s * Real.cosh t = Real.sinh (s + t) := by
      rw [Real.sinh_add]
      ring
    rw [hst]
  calc
    (Real.cosh s * Real.cosh t) • (1 : A) + (Real.cosh s * Real.sinh t) • H +
        (Real.sinh s * Real.cosh t) • H + (Real.sinh s * Real.sinh t) • (1 : A) =
      ((Real.cosh s * Real.cosh t) • (1 : A) + (Real.sinh s * Real.sinh t) • (1 : A)) +
        ((Real.cosh s * Real.sinh t) • H + (Real.sinh s * Real.cosh t) • H) := by abel
    _ = (Real.cosh (s + t)) • (1 : A) + (Real.sinh (s + t)) • H := by rw [h_cosh, h_sinh]

/-- 3. Parabolic Flow: $N^2 = 0$. -/
def parabolicFlow (N : A) (t : ℝ) : A :=
  (1 : A) + t • N

@[simp] theorem parabolicFlow_zero (N : A) : parabolicFlow N 0 = 1 := by
  dsimp [parabolicFlow]
  simp

theorem parabolicFlow_mul (N : A) (hN : N * N = 0) (s t : ℝ) :
    parabolicFlow N s * parabolicFlow N t = parabolicFlow N (s + t) := by
  dsimp [parabolicFlow]
  have h_exp : (1 + s • N) * (1 + t • N) = (1 : A) + t • N + s • N + (s * t) • (N * N) := by
    have h1 : (1 + s • N) * (1 + t • N) = (1 : A) * (1 : A) + (1 : A) * (t • N) + (s • N) * (1 : A) + (s • N) * (t • N) := by
      simp only [add_mul, mul_add]
      abel
    rw [h1]
    simp only [one_mul, mul_one, smul_mul_smul]
  rw [h_exp, hN, smul_zero, add_zero]
  have h_add : t • N + s • N = (s + t) • N := by
    rw [← add_smul, add_comm]
  rw [add_assoc, h_add]

/-- 4. Loxodromic Flow: Synthesis of Elliptic Rotation and Hyperbolic Dilation. -/
def loxodromicFlow (J H : A) (theta s : ℝ) : A :=
  ellipticFlow J theta * hyperbolicFlow H s

@[simp] theorem loxodromicFlow_zero (J H : A) : loxodromicFlow J H 0 0 = 1 := by
  dsimp [loxodromicFlow]
  simp

theorem loxodromicFlow_mul (J H : A) (hJ : J * J = -1) (hH : H * H = 1)
    (hComm : J * H = H * J) (theta1 s1 theta2 s2 : ℝ) :
    loxodromicFlow J H theta1 s1 * loxodromicFlow J H theta2 s2 =
    loxodromicFlow J H (theta1 + theta2) (s1 + s2) := by
  dsimp [loxodromicFlow]
  have h_comm_flows : hyperbolicFlow H s1 * ellipticFlow J theta2 =
      ellipticFlow J theta2 * hyperbolicFlow H s1 := by
    dsimp [hyperbolicFlow, ellipticFlow]
    have h_exp1 : (Real.cosh s1 • (1 : A) + Real.sinh s1 • H) * (Real.cos theta2 • (1 : A) + Real.sin theta2 • J) =
        (Real.cosh s1 * Real.cos theta2) • (1 : A) +
        (Real.cosh s1 * Real.sin theta2) • J +
        (Real.sinh s1 * Real.cos theta2) • H +
        (Real.sinh s1 * Real.sin theta2) • (H * J) := by
      simp only [add_mul, mul_add, smul_mul_smul, one_mul, mul_one]
      abel
    have h_exp2 : (Real.cos theta2 • (1 : A) + Real.sin theta2 • J) * (Real.cosh s1 • (1 : A) + Real.sinh s1 • H) =
        (Real.cos theta2 * Real.cosh s1) • (1 : A) +
        (Real.cos theta2 * Real.sinh s1) • H +
        (Real.sin theta2 * Real.cosh s1) • J +
        (Real.sin theta2 * Real.sinh s1) • (J * H) := by
      simp only [add_mul, mul_add, smul_mul_smul, one_mul, mul_one]
      abel
    rw [h_exp1, h_exp2]
    have h_1 : (Real.cosh s1 * Real.cos theta2) • (1 : A) = (Real.cos theta2 * Real.cosh s1) • (1 : A) := by
      rw [mul_comm]
    have h_J : (Real.cosh s1 * Real.sin theta2) • J = (Real.sin theta2 * Real.cosh s1) • J := by
      rw [mul_comm]
    have h_H : (Real.sinh s1 * Real.cos theta2) • H = (Real.cos theta2 * Real.sinh s1) • H := by
      rw [mul_comm]
    have h_JH : (Real.sinh s1 * Real.sin theta2) • (H * J) = (Real.sin theta2 * Real.sinh s1) • (J * H) := by
      rw [mul_comm (Real.sinh s1), hComm]
    rw [h_1, h_J, h_H, h_JH]
    abel
  calc
    (ellipticFlow J theta1 * hyperbolicFlow H s1) * (ellipticFlow J theta2 * hyperbolicFlow H s2) =
      ellipticFlow J theta1 * (hyperbolicFlow H s1 * ellipticFlow J theta2) * hyperbolicFlow H s2 := by
        simp only [mul_assoc]
    _ = ellipticFlow J theta1 * (ellipticFlow J theta2 * hyperbolicFlow H s1) * hyperbolicFlow H s2 := by
        rw [h_comm_flows]
    _ = (ellipticFlow J theta1 * ellipticFlow J theta2) * (hyperbolicFlow H s1 * hyperbolicFlow H s2) := by
        simp only [mul_assoc]
    _ = ellipticFlow J (theta1 + theta2) * hyperbolicFlow H (s1 + s2) := by
        rw [ellipticFlow_mul J hJ theta1 theta2, hyperbolicFlow_mul H hH s1 s2]

/-- 5. Inversion Theorems (One-parameter subgroups) -/
theorem ellipticFlow_inv (J : A) (hJ : J * J = -1) (t : ℝ) :
    ellipticFlow J (-t) * ellipticFlow J t = 1 := by
  rw [ellipticFlow_mul J hJ, neg_add_cancel, ellipticFlow_zero]

theorem hyperbolicFlow_inv (H : A) (hH : H * H = 1) (t : ℝ) :
    hyperbolicFlow H (-t) * hyperbolicFlow H t = 1 := by
  rw [hyperbolicFlow_mul H hH, neg_add_cancel, hyperbolicFlow_zero]

theorem parabolicFlow_inv (N : A) (hN : N * N = 0) (t : ℝ) :
    parabolicFlow N (-t) * parabolicFlow N t = 1 := by
  rw [parabolicFlow_mul N hN, neg_add_cancel, parabolicFlow_zero]

end
end InfoGeometry.Dynamics.MoebiusFlow
