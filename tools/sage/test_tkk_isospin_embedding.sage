from sage.all import *

def main():
    print("==========================================================")
    print("Testing TKK Isospin Embedding in D_4 (SO(8)) Proxy Algebra")
    print("==========================================================\n")
    
    # 1. Define the 5-graded TKK proxy algebra D_4
    print("1. Defining the 5-graded TKK proxy algebra (D_4)...")
    L = LieAlgebra(QQ, cartan_type=['D', 4])
    e1, e2, e3, e4, f1, f2, f3, f4, h1, h2, h3, h4 = list(L.gens())
    
    # The grading is determined by a grading element H_grad.
    # To get a 5-grading, we want max eigenvalue 2.
    # We solve for H_grad such that alpha_1 and alpha_3 have degree 1, and alpha_2, alpha_4 have degree 0.
    A = CartanMatrix(['D', 4])
    v = vector(QQ, [1, 0, 1, 0])
    x = A.solve_left(v)
    H_grad = x[0]*h1 + x[1]*h2 + x[2]*h3 + x[3]*h4
    
    grades = {-2: [], -1: [], 0: [], 1: [], 2: []}
    for b in L.basis():
        val = L([H_grad, b])
        if val == L.zero():
            grades[0].append(b)
        else:
            d = val.monomial_coefficients()
            eig = QQ(list(d.values())[0])
            grades[eig].append(b)
            
    print("  Dimensions of graded blocks:")
    for i in range(-2, 3):
        print(f"    g_{{{i}}}: {len(grades[i])} generators")
        
    if sum(len(g) for g in grades.values()) == L.dimension():
        print("  [PASS] 5-grading completely decomposes the algebra.\n")
    else:
        print("  [FAIL] 5-grading incomplete.\n")

    # 2. Extract SU(2) Isospin residing strictly inside g_0
    print("2. Extracting the SU(2) (isospin) subalgebra strictly inside g_0...")
    # We choose the SU(2) generated by alpha_4, which has degree 0.
    isospin_gens = [e4, f4, h4]
    
    in_g0 = all(b in grades[0] for b in isospin_gens)
    if in_g0:
        print("  [PASS] SU(2) Isospin generators {e4, f4, h4} are strictly inside g_0.\n")
    else:
        print("  [FAIL] SU(2) Isospin generators are NOT strictly inside g_0.\n")

    # 3. Verify graded bracket relations for SU(2)
    print("3. Verifying graded bracket relations: [SU(2), g_k] \\subset g_k...")
    def check_bracket(gens, target_space_list, target_grade):
        for g in gens:
            for b in target_space_list:
                res = L([g, b])
                if res == L.zero():
                    continue
                val = L([H_grad, res])
                if val != target_grade * res:
                    return False
        return True

    pass_g1 = check_bracket(isospin_gens, grades[1], 1)
    if pass_g1:
        print("  [PASS] [SU(2), g_1] \\subset g_1")
    else:
        print("  [FAIL] [SU(2), g_1] \\subset g_1")

    pass_g2 = check_bracket(isospin_gens, grades[2], 2)
    if pass_g2:
        print("  [PASS] [SU(2), g_2] \\subset g_2\n")
    else:
        print("  [FAIL] [SU(2), g_2] \\subset g_2\n")
        
    # 4. Compute action of D_4 Triality on SU(2) Isospin
    print("4. Computing the action of D_4 Triality on the SU(2) Isospin generators...")
    # Standard D_4 triality automorphism acts on Chevalley generators by cyclic permutation
    # of the outer nodes {1, 3, 4}, fixing the central node 2.
    print("  Applying Triality map rho (alpha_4 -> alpha_1):")
    rho_map = {
        'e4': (e4, e1),
        'f4': (f4, f1),
        'h4': (h4, h1)
    }
    
    broken = False
    for name, (gen, rho_gen) in rho_map.items():
        grade_rho = None
        for i in range(-2, 3):
            if rho_gen in grades[i]:
                grade_rho = i
                break
        print(f"    rho({name}) is mapped to grade {grade_rho}")
        if grade_rho != 0:
            broken = True

    if broken:
        print("  [PASS] Triality maps the SU(2) generators outside of the pure g_0 block.")
        print("         -> This demonstrates Isospin Symmetry Breaking geometrically!\n")
    else:
        print("  [FAIL] Triality did not map SU(2) generators outside g_0.\n")

main()
