import InfoGeometry.Krein.KreinSpace

open scoped InnerProductSpace

namespace InfoGeometry.Quantum

/-!
# Real Split Clifford Atom

Primitive real split-`Cl(1,1)` data on a real carrier.

Policy note: any surviving `complex_i` language elsewhere in the repository is
legacy compatibility terminology only. The canonical internal square-minus-one
axis is the derived operator `K := J.comp eps`.
-/

/-- Primitive real split-`Cl(1,1)` action generated by `eps` and `J`. -/
structure RealSplitCl11Action
    (H : Type*)
    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] where
  eps : H →L[ℝ] H
  J : H →L[ℝ] H
  eps_sq : eps.comp eps = ContinuousLinearMap.id ℝ H
  J_sq : J.comp J = ContinuousLinearMap.id ℝ H
  J_eps_anti : J.comp eps = -(eps.comp J)

namespace RealSplitCl11Action

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The internal square-minus-one axis `K := J ∘ eps`. -/
noncomputable def K (X : RealSplitCl11Action H) : H →L[ℝ] H :=
  X.J.comp X.eps

@[simp] theorem eps_sq_apply (X : RealSplitCl11Action H) (x : H) :
    X.eps (X.eps x) = x := by
  have h := congrArg (fun T : H →L[ℝ] H => T x) X.eps_sq
  simpa [ContinuousLinearMap.comp_apply] using h

@[simp] theorem J_sq_apply (X : RealSplitCl11Action H) (x : H) :
    X.J (X.J x) = x := by
  have h := congrArg (fun T : H →L[ℝ] H => T x) X.J_sq
  simpa [ContinuousLinearMap.comp_apply] using h

@[simp] theorem J_eps_anti_apply (X : RealSplitCl11Action H) (x : H) :
    X.J (X.eps x) = -(X.eps (X.J x)) := by
  have h := congrArg (fun T : H →L[ℝ] H => T x) X.J_eps_anti
  simpa [ContinuousLinearMap.comp_apply] using h

/-- The derived axis squares to `-Id`. -/
theorem K_sq (X : RealSplitCl11Action H) :
    X.K.comp X.K = -(ContinuousLinearMap.id ℝ H) := by
  ext x
  have hanti := X.J_eps_anti_apply (x := X.J (X.eps x))
  unfold K
  calc
    X.J (X.eps (X.J (X.eps x))) = -(X.eps (X.J (X.J (X.eps x)))) := by
      exact hanti
    _ = -(X.eps (X.eps x)) := by rw [X.J_sq_apply]
    _ = -x := by rw [X.eps_sq_apply]
    _ = (-(ContinuousLinearMap.id ℝ H)) x := by simp

end RealSplitCl11Action

end InfoGeometry.Quantum
