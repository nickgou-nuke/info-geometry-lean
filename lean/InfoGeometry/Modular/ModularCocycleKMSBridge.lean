/-!
# Non-Commutative Logarithmic Derivation Cocycle to KMS Modular Flow Bridge

This module establishes the exact mathematical bridge between the non-commutative
logarithmic Radon–Nikodym derivation `dlogL` / `dlogR` (Maurer–Cartan gauge cocycles)
and the Tomita–Takesaki / KMS modular flow in non-commutative operator algebras and matrix rings.

## Theoretical Foundations:
1. **Inner Adjoint Shifts and Modular Hamiltonians**:
   For a modular Hamiltonian $K \in A$ and an invertible unit $u \in A^	imes$, the similarity
   perturbation (inner gauge transformation) is:
   $$K_u := u^{-1} K u$$
   The infinitesimal inner logarithmic Radon–Nikodym derivation satisfies:
   $$\operatorname{dlogL}_{\operatorname{ad}_K}(u) = u^{-1} [K, u] = K_u - K$$
   Hence:
   $$K_u = K + \operatorname{dlogL}_{\operatorname{ad}_K}(u)$$

2. **Non-Abelian 2-Cocycle and Double Shift Identity**:
   Under composite transformations $u \cdot v$, the modular Hamiltonian acts as an associative groupoid action:
   $$K_{u \cdot v} = (K_u)_v$$
   Leading to the 1-cocycle identity with values in the affine space of modular Hamiltonians:
   $$\operatorname{dlogL}_{\operatorname{ad}_K}(u \cdot v) = \operatorname{dlogL}_{\operatorname{ad}_{K_u}}(v) + \operatorname{dlogL}_{\operatorname{ad}_K}(u)$$
   and the twisted Maurer–Cartan gauge cocycle rule:
   $$\operatorname{dlogL}_{\operatorname{ad}_K}(u \cdot v) = v^{-1} \operatorname{dlogL}_{\operatorname{ad}_K}(u) v + \operatorname{dlogL}_{\operatorname{ad}_K}(v)$$

3. **$n$-Fold Generalized Chain Rules**:
   - **Telescoping Sequential Shift**: The total shift for a list $\prod L$ telescopes along the orbit.
   - **Twisted Non-Abelian Gauge Cocycle**: Expansion into adjoint-twisted sums of individual shifts.

4. **Infinitesimal Modular Flow Intertwining**:
   $$\operatorname{ad}_{K_u}(X) = u^{-1} \operatorname{ad}_K(u X u^{-1}) u$$

5. **First-Order KMS Stationarity**:
   In any thermal state $
ho$ commuting with $K$, the commutator expectation identically vanishes:
   $$\operatorname{Tr}(
ho [K, X]) = 0$$

All proofs are complete in native Mathlib 4 with zero `sorry`s, zero wrappers, and zero custom axioms.
-/

namespace InfoGeometry.Modular.Bridge

open BigOperators

variable {A : Type*} [Ring A]

/-!
=============================================================================
PART 1: Non-Commutative Algebraic Operator Layer (`[Ring A]`)
=============================================================================
-/

/-- The standard Lie commutator bracket on a ring: `[X, Y] = X * Y - Y * X`. -/
def ringBracket (X Y : A) : A := X * Y - Y * X

/-- Inner derivation generated by an operator element: `ad_K(X) = [K, X]`. -/
def adOp (K : A) (X : A) : A := ringBracket K X

/-- Left non-commutative logarithmic derivation: `dlogL_D(u) = u⁻¹ * D(u)`. -/
def dlogL (D : A → A) (u : Aˣ) : A := (↑u⁻¹ : A) * D (u : A)

/-- Right non-commutative logarithmic derivation: `dlogR_D(u) = D(u) * u⁻¹`. -/
def dlogR (D : A → A) (u : Aˣ) : A := D (u : A) * (↑u⁻¹ : A)

/-- Perturbed Modular Hamiltonian generated by similarity transformation: `K_u = u⁻¹ * K * u`. -/
def perturbedModularHamiltonian (K : A) (u : Aˣ) : A :=
  (↑u⁻¹ : A) * K * (u : A)

/-- Infinitesimal modular generator (Heisenberg time derivative): `- ad_K(X)`. -/
def modularDeriv (K X : A) : A := - adOp K X

/--
  THEOREM: The inner logarithmic derivation computes the discrete modular shift:
  `dlogL_{ad_K}(u) = K_u - K`
-/
theorem dlogL_ad_eq_sub (K : A) (u : Aˣ) :
    dlogL (adOp K) u = perturbedModularHamiltonian K u - K := by
  dsimp [dlogL, adOp, ringBracket, perturbedModularHamiltonian]
  calc
    (↑u⁻¹ : A) * (K * (u : A) - (u : A) * K)
      = (↑u⁻¹ : A) * (K * (u : A)) - (↑u⁻¹ : A) * ((u : A) * K) := by
        rw [mul_sub]
    _ = (↑u⁻¹ : A) * K * (u : A) - ((↑u⁻¹ : A) * (u : A)) * K := by
        simp only [mul_assoc]
    _ = (↑u⁻¹ : A) * K * (u : A) - 1 * K := by
        rw [Units.inv_mul]
    _ = (↑u⁻¹ : A) * K * (u : A) - K := by
        rw [one_mul]

/--
  THEOREM: The perturbed modular Hamiltonian is the unperturbed Hamiltonian shifted
  by the logarithmic derivation:
  `K_u = K + dlogL_{ad_K}(u)`
-/
theorem perturbed_hamiltonian_eq_add_dlogL (K : A) (u : Aˣ) :
    perturbedModularHamiltonian K u = K + dlogL (adOp K) u := by
  rw [dlogL_ad_eq_sub]
  abel

/--
  Identity perturbation preserves the modular Hamiltonian:
  `K_1 = K`
-/
@[simp]
theorem perturbedModularHamiltonian_one (K : A) :
    perturbedModularHamiltonian K 1 = K := by
  dsimp [perturbedModularHamiltonian]
  simp only [Units.val_one, inv_one, mul_one, one_mul]

/--
  THEOREM (Functoriality of Modular Adjoint Shifts):
  Modular Hamiltonian transformations form an associative left action:
  `K_{u * v} = (K_u)_v`
-/
theorem perturbedModularHamiltonian_mul (K : A) (u v : Aˣ) :
    perturbedModularHamiltonian K (u * v) =
      perturbedModularHamiltonian (perturbedModularHamiltonian K u) v := by
  dsimp [perturbedModularHamiltonian]
  have h_inv : (↑(u * v)⁻¹ : A) = (↑v⁻¹ : A) * (↑u⁻¹ : A) := by
    rw [mul_inv_rev, Units.val_mul]
  rw [h_inv]
  simp only [mul_assoc]

/--
  THEOREM: Infinitesimal Intertwining of Modular Flows under Adjoint Perturbation:
  `ad_{K_u}(X) = u⁻¹ * ad_K(u * X * u⁻¹) * u`
-/
theorem modular_generator_intertwining (K : A) (u : Aˣ) (X : A) :
    adOp (perturbedModularHamiltonian K u) X =
      (↑u⁻¹ : A) * adOp K ((u : A) * X * (↑u⁻¹ : A)) * (u : A) := by
  dsimp [perturbedModularHamiltonian, adOp, ringBracket]
  have h1 : (↑u⁻¹ : A) * (K * ((u : A) * X * (↑u⁻¹ : A))) * (u : A) = (↑u⁻¹ : A) * K * (u : A) * X := by
    calc
      (↑u⁻¹ : A) * (K * ((u : A) * X * (↑u⁻¹ : A))) * (u : A)
        = (↑u⁻¹ : A) * K * (u : A) * X * ((↑u⁻¹ : A) * (u : A)) := by simp only [mul_assoc]
      _ = (↑u⁻¹ : A) * K * (u : A) * X * 1 := by rw [Units.inv_mul u]
      _ = (↑u⁻¹ : A) * K * (u : A) * X := by rw [mul_one]
  have h2 : (↑u⁻¹ : A) * (((u : A) * X * (↑u⁻¹ : A)) * K) * (u : A) = X * ((↑u⁻¹ : A) * K * (u : A)) := by
    calc
      (↑u⁻¹ : A) * (((u : A) * X * (↑u⁻¹ : A)) * K) * (u : A)
        = ((↑u⁻¹ : A) * (u : A)) * X * (↑u⁻¹ : A) * K * (u : A) := by simp only [mul_assoc]
      _ = 1 * X * (↑u⁻¹ : A) * K * (u : A) := by rw [Units.inv_mul u]
      _ = X * ((↑u⁻¹ : A) * K * (u : A)) := by simp only [one_mul, mul_assoc]
  rw [mul_sub, sub_mul, h1, h2]

/-!
=============================================================================
PART 2: Non-Abelian 2-Cocycle and Iterated Modular Shift Theorems
=============================================================================
-/

/--
  THEOREM: Iterated Modular Shift (Telescoping Sum).
  The combined shift decomposes into the shift relative to `K_u` plus the shift of `K`:
  `dlogL_{ad_K}(u * v) = dlogL_{ad_{K_u}}(v) + dlogL_{ad_K}(u)`
-/
theorem dlogL_ad_mul_double_shift (K : A) (u v : Aˣ) :
    dlogL (adOp K) (u * v) =
      dlogL (adOp (perturbedModularHamiltonian K u)) v + dlogL (adOp K) u := by
  rw [dlogL_ad_eq_sub, dlogL_ad_eq_sub, dlogL_ad_eq_sub, perturbedModularHamiltonian_mul]
  abel

/--
  THEOREM: Non-Commutative 2-Cocycle / Twisted Gauge Identity.
  Decomposes the composite shift into a twisted conjugate of the first shift and the second shift:
  `dlogL_{ad_K}(u * v) = v⁻¹ * dlogL_{ad_K}(u) * v + dlogL_{ad_K}(v)`
-/
theorem dlogL_ad_mul_cocycle (K : A) (u v : Aˣ) :
    dlogL (adOp K) (u * v) =
      (↑v⁻¹ : A) * dlogL (adOp K) u * (v : A) + dlogL (adOp K) v := by
  rw [dlogL_ad_eq_sub, dlogL_ad_eq_sub, dlogL_ad_eq_sub, perturbedModularHamiltonian_mul]
  dsimp [perturbedModularHamiltonian]
  calc
    (↑v⁻¹ : A) * ((↑u⁻¹ : A) * K * (u : A)) * (v : A) - K
      = (↑v⁻¹ : A) * ((↑u⁻¹ : A) * K * (u : A)) * (v : A) - (↑v⁻¹ : A) * K * (v : A) +
        ((↑v⁻¹ : A) * K * (v : A) - K) := by
        abel
    _ = ((↑v⁻¹ : A) * ((↑u⁻¹ : A) * K * (u : A)) - (↑v⁻¹ : A) * K) * (v : A) +
        ((↑v⁻¹ : A) * K * (v : A) - K) := by
        rw [sub_mul]
    _ = (↑v⁻¹ : A) * (((↑u⁻¹ : A) * K * (u : A)) - K) * (v : A) +
        ((↑v⁻¹ : A) * K * (v : A) - K) := by
        rw [mul_sub]

/--
  COROLLARY: Invariance under inverse composition:
  `dlogL_{ad_K}(u * u⁻¹) = 0`
-/
theorem dlogL_ad_mul_inv_self (K : A) (u : Aˣ) :
    dlogL (adOp K) (u * u⁻¹) = 0 := by
  rw [mul_inv_cancel, dlogL_ad_eq_sub, perturbedModularHamiltonian_one, sub_self]

/--
  COROLLARY: Inversion of inner logarithmic derivation:
  `dlogL_{ad_K}(u⁻¹) = - u * dlogL_{ad_K}(u) * u⁻¹`
-/
theorem dlogL_ad_inv (K : A) (u : Aˣ) :
    dlogL (adOp K) (u⁻¹) = - ((u : A) * dlogL (adOp K) u * (↑u⁻¹ : A)) := by
  have h := dlogL_ad_mul_cocycle K u (u⁻¹)
  rw [mul_inv_cancel, dlogL_ad_eq_sub, perturbedModularHamiltonian_one, sub_self] at h
  have h_inv_inv : (↑(u⁻¹)⁻¹ : A) = (u : A) := by rw [inv_inv]
  rw [h_inv_inv] at h
  exact eq_neg_of_add_eq_zero_right h.symm

/-!
=============================================================================
PART 3: n-Fold Generalized Chain Rules on Lists of Units (`List Aˣ`)
=============================================================================
-/

/--
  THEOREM: The modular action on a list product `L.prod` corresponds to the left fold
  of `perturbedModularHamiltonian` across the sequence:
  `K_{u₁ * u₂ * ⋯ * uₙ} = List.foldl perturbedModularHamiltonian K [u₁, u₂, ⋯, uₙ]`
-/
theorem perturbedModularHamiltonian_list_prod (K : A) (L : List Aˣ) :
    perturbedModularHamiltonian K L.prod = L.foldl perturbedModularHamiltonian K := by
  induction L generalizing K with
  | nil =>
    rw [List.prod_nil, List.foldl_nil, perturbedModularHamiltonian_one]
  | cons u us ih =>
    rw [List.prod_cons, perturbedModularHamiltonian_mul, ih, List.foldl_cons]

/-- Sequential accumulation of modular Hamiltonian shifts along an orbit. -/
def iteratedModularShifts (K : A) : List Aˣ → A
  | [] => 0
  | u :: us => dlogL (adOp K) u + iteratedModularShifts (perturbedModularHamiltonian K u) us

/--
  THEOREM: The sequential modular shift accumulation telescopes identically to `K_{L.prod} - K`.
-/
theorem iteratedModularShifts_eq_sub (K : A) (L : List Aˣ) :
    iteratedModularShifts K L = perturbedModularHamiltonian K L.prod - K := by
  induction L generalizing K with
  | nil =>
    rw [iteratedModularShifts, List.prod_nil, perturbedModularHamiltonian_one, sub_self]
  | cons u us ih =>
    rw [iteratedModularShifts, List.prod_cons, dlogL_ad_eq_sub, ih, perturbedModularHamiltonian_mul]
    abel

/--
  THEOREM (n-Fold Telescoping Chain Rule):
  The logarithmic derivation of an arbitrary finite product of units equals
  the iterated sequential shift along the trajectory:
  `dlogL_{ad_K}(∏ L) = ∑_{i=1}^n dlogL_{ad_{K_{i-1}}}(uᵢ)`
-/
theorem dlogL_ad_list_prod_eq_iteratedModularShifts (K : A) (L : List Aˣ) :
    dlogL (adOp K) L.prod = iteratedModularShifts K L := by
  rw [dlogL_ad_eq_sub, iteratedModularShifts_eq_sub]

/-- Non-abelian gauge cocycle sum over unit list representations. -/
def twistedCocycleSum (K : A) : List Aˣ → A
  | [] => 0
  | u :: us => (↑(us.prod)⁻¹ : A) * dlogL (adOp K) u * (↑us.prod : A) + twistedCocycleSum K us

/--
  THEOREM (n-Fold Maurer–Cartan / Gauge Cocycle Chain Rule):
  The composite logarithmic derivation expands into the adjoint-twisted sum of individual shifts:
  `dlogL_{ad_K}(u₁ ⋯ uₙ) = ∑_{i=1}^n (u_{i+1} ⋯ uₙ)⁻¹ · dlogL_{ad_K}(uᵢ) · (u_{i+1} ⋯ uₙ)`
-/
theorem dlogL_ad_list_prod_eq_twistedCocycleSum (K : A) (L : List Aˣ) :
    dlogL (adOp K) L.prod = twistedCocycleSum K L := by
  induction L with
  | nil =>
    rw [List.prod_nil, twistedCocycleSum, dlogL_ad_eq_sub, perturbedModularHamiltonian_one, sub_self]
  | cons u us ih =>
    rw [List.prod_cons, twistedCocycleSum, dlogL_ad_mul_cocycle, ih]

/-!
=============================================================================
PART 4: Matrix Trace KMS Stationarity and Expectation Identities
=============================================================================
-/

section MatrixKMS

variable {n : Type*} [Fintype n] [DecidableEq n]
variable {R : Type*} [CommRing R]

/-- Cyclic trace state evaluation: `traceState ρ X = Tr(ρ * X)`. -/
def traceState (rho X : Matrix n n R) : R :=
  Matrix.trace (rho * X)

/--
  THEOREM: First-order KMS stationarity condition under the modular flow.
  Commutator expectation with the modular Hamiltonian vanishes in the thermal state:
  `Tr(ρ * [K, X]) = 0` whenever `ρ` and `K` commute (e.g. `ρ = exp(-K)`).
-/
theorem kms_stationarity_commutator_zero (rho K X : Matrix n n R)
    (h_comm : rho * K = K * rho) :
    traceState rho (ringBracket K X) = 0 := by
  dsimp [traceState, ringBracket]
  have h_tr_comm : Matrix.trace (rho * (K * X)) = Matrix.trace (rho * (X * K)) := by
    calc
      Matrix.trace (rho * (K * X)) = Matrix.trace ((rho * K) * X) := by rw [Matrix.mul_assoc]
      _ = Matrix.trace ((K * rho) * X) := by rw [h_comm]
      _ = Matrix.trace (K * (rho * X)) := by rw [Matrix.mul_assoc]
      _ = Matrix.trace ((rho * X) * K) := by rw [Matrix.trace_mul_comm]
      _ = Matrix.trace (rho * (X * K)) := by rw [Matrix.mul_assoc]
  calc
    Matrix.trace (rho * (K * X - X * K))
      = Matrix.trace (rho * (K * X) - rho * (X * K)) := by rw [Matrix.mul_sub]
    _ = Matrix.trace (rho * (K * X)) - Matrix.trace (rho * (X * K)) := by rw [Matrix.trace_sub]
    _ = 0 := sub_eq_zero.mpr h_tr_comm

/--
  THEOREM: Shifted Modular Hamiltonian trace expectation identity:
  `Tr(ρ * K_u) - Tr(ρ * K) = Tr(ρ * dlogL_{ad_K}(u))`
-/
theorem trace_perturbed_hamiltonian_diff (rho : Matrix n n R) (K : Matrix n n R) (u : (Matrix n n R)ˣ) :
    traceState rho (perturbedModularHamiltonian K u) - traceState rho K =
      traceState rho (dlogL (adOp K) u) := by
  dsimp [traceState]
  rw [← Matrix.trace_sub, ← Matrix.mul_sub]
  congr 1
  rw [← dlogL_ad_eq_sub]

end MatrixKMS

end InfoGeometry.Modular.Bridge
