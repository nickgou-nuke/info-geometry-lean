{"type":"new","contents":"/-\nInfoGeometry/Canonical/ModularRegularSupport.lean\n\nRegular modular support persistence.\n\nThe regular support P_D is the invariant carrier of modular transport.\nThe complement (1 - P_D) is the noise/defect support, which is also\nalgebraically preserved by the modular flow but excluded from the\nregular transport lane.\n-/\n\nimport Mathlib\nimport InfoGeometry.Canonical.DrazinDilationGap\nimport InfoGeometry.OperatorAlgebra.OperatorThermodynamics\n\nnoncomputable section\n\nnamespace InfoGeometry.Canonical.ModularRegularSupport\n\nopen InfoGeometry.Canonical.DrazinDilationGap\nopen InfoGeometry.OperatorAlgebra.OperatorThermodynamics\n\n/--\nA modular flow that is a ring homomorphism for each time t.\n-/\nstructure ModularRingFlow\n    (Op : Type*) [Ring Op] extends OperatorFlow Op where\n  /-- The flow is a ring homomorphism for each t. -/\n  is_ring_hom :\n    ∀ t : ℝ,\n      flow t 1 = 1 ∧\n      (∀ x y, flow t (x * y) = flow t x * flow t y) ∧\n      (∀ x y, flow t (x + y) = flow t x + flow t y)\n\n/--\nThe regular support P_D is the modularly invariant carrier.\n-/\nstructure RegularSupportPersistence\n    (Op : Type*) [Ring Op] [Star Op] where\n  drazin : DrazinData Op\n  flow   : ModularRingFlow Op\n  invariant : ∀ t : ℝ, flow.flow t drazin.P_D = drazin.P_D\n\n/--\nIf the regular support P_D is modularly invariant, then the noise/defect\nsupport Q₀ = 1 - P_D is also modularly invariant.\n-/\ntheorem noise_invariant\n    {Op : Type*} [Ring Op] [Star Op]\n    (P : RegularSupportPersistence Op) :\n    ∀ t : ℝ, P.flow.flow t P.drazin.Q₀ = P.drazin.Q₀ := by\n  intro t\n  have h1 := (P.flow.is_ring_hom t).1\n  have hadd := (P.flow.is_ring_hom t).2.2\n  -- subtraction is addition with neg, which is preserved by ring hom\n  have hsub : ∀ x y, P.flow.flow t (x - y) = P.flow.flow t x - P.flow.flow t y := by\n    intro x y\n    rw [sub_eq_add_neg, hadd]\n    congr\n    -- flow t (-y) = -flow t y\n    have hneg : P.flow.flow t (-y) = -P.flow.flow t y := by\n      have h0 : P.flow.flow t (y + (-y)) = P.flow.flow t 0 := by rw [add_neg_self]\n      rw [hadd] at h0\n      -- flow t 0 = 0\n      have hflow0 : P.flow.flow t 0 = 0 := by\n        have hz : P.flow.flow t (0 + 0) = P.flow.flow t 0 + P.flow.flow t 0 := hadd 0 0\n        rw [add_zero] at hz\n        exact (add_self_eq_self.mp hz.symm).symm\n      rw [hflow0] at h0\n      exact eq_neg_of_add_eq_zero_right h0\n    exact hneg\n  \n  rw [P.drazin.Q₀_def, hsub, h1, P.invariant t]\n\n/--\nThe regular support is the invariant kinetic lane.\n-/\ntheorem regular_invariant\n    {Op : Type*} [Ring Op] [Star Op]\n    (P : RegularSupportPersistence Op) :\n    ∀ t : ℝ, P.flow.flow t P.drazin.P_D = P.drazin.P_D :=\n  P.invariant\n\nend InfoGeometry.Canonical.ModularRegularSupport\n","mtime":1778820577711}