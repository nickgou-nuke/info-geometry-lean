import Mathlib.Tactic

/-!
# Pin(5,5) spinor glide core

This module gives a small, exact, kernel-checked `32 × 32` real-spinor core for
one positive-norm and one negative-norm Clifford generator in the finite
`Pin(5,5)` lane.

It is the Lean twin of `tools/sympy/pin55_glide_reflections.py`.

#### BUCKET 1: CLOSED FINITE THEOREMS
The concrete matrices below prove:

* `γ_space² = 1`;
* `γ_time² = -1`;
* `γ_space γ_time = - γ_time γ_space`;
* the glide core `γ_space γ_time` has square `1`;
* `γ_space * (γ_space * γ_time) = γ_time` and the opposite multiplication gives
  the sign-flipped readout.

#### SIGN AUDIT
The SymPy twin verifies the full ten-generator `Cl(5,5)` real gamma system and
finds the volume element square `K² = +I₃₂`, not `-I₃₂`.  This module therefore
locks only the true two-generator glide core and does not encode the false
`K² = -I` claim.
-/

namespace InfoGeometry.OperatorAlgebra.Pin55

open Matrix

abbrev Spin32Matrix := Matrix (Fin 32) (Fin 32) ℤ

/-- Upper-right `16 × 16` identity block inside a `32 × 32` matrix. -/
def upperRightId32 : Spin32Matrix :=
  fun i j => if i.val < 16 ∧ j.val = i.val + 16 then 1 else 0

/-- Lower-left `16 × 16` identity block inside a `32 × 32` matrix. -/
def lowerLeftId32 : Spin32Matrix :=
  fun i j => if 16 ≤ i.val ∧ j.val + 16 = i.val then 1 else 0

/-- Positive-norm spinor reflection generator, with square `+1`. -/
def gamma_space : Spin32Matrix := upperRightId32 + lowerLeftId32

/-- Negative-norm spinor reflection generator, with square `-1`. -/
def gamma_time : Spin32Matrix := upperRightId32 - lowerLeftId32

/-- Structure packaging a two-generator `Pin(5,5)` spinor reflection core. -/
structure Pin55SpinorCore where
  gamma_space : Spin32Matrix
  gamma_time : Spin32Matrix
  h_space_sq : gamma_space * gamma_space = 1
  h_time_sq : gamma_time * gamma_time = -1
  h_anticomm : gamma_space * gamma_time = - (gamma_time * gamma_space)

/-- The concrete `32 × 32` two-generator spinor core. -/
def concreteSpinorCore : Pin55SpinorCore where
  gamma_space := gamma_space
  gamma_time := gamma_time
  h_space_sq := by
    unfold gamma_space upperRightId32 lowerLeftId32
    native_decide
  h_time_sq := by
    unfold gamma_time upperRightId32 lowerLeftId32
    native_decide
  h_anticomm := by
    unfold gamma_space gamma_time upperRightId32 lowerLeftId32
    native_decide

/-- The concrete positive-norm spinor generator squares to `+1`. -/
theorem gamma_space_sq : gamma_space * gamma_space = 1 :=
  concreteSpinorCore.h_space_sq

/-- The concrete negative-norm spinor generator squares to `-1`. -/
theorem gamma_time_sq : gamma_time * gamma_time = -1 :=
  concreteSpinorCore.h_time_sq

/-- The two concrete spinor generators anticommute. -/
theorem gamma_space_time_anticomm : gamma_space * gamma_time = - (gamma_time * gamma_space) :=
  concreteSpinorCore.h_anticomm

/-- Spinor glide core generated by one positive and one negative reflection. -/
def spinorGlideCore : Spin32Matrix := gamma_space * gamma_time

/-- Left multiplication by `γ_space` collapses the glide core to `γ_time`. -/
theorem spinor_glide_composition_anticommutes :
    gamma_space * spinorGlideCore = gamma_time := by
  unfold spinorGlideCore
  rw [← Matrix.mul_assoc, gamma_space_sq, Matrix.one_mul]

/-- Right multiplication by `γ_space` produces the sign-flipped readout. -/
theorem spinor_glide_right_sign :
    spinorGlideCore * gamma_space = -gamma_time := by
  unfold spinorGlideCore gamma_space gamma_time upperRightId32 lowerLeftId32
  native_decide

/-- The two-reflection glide core squares to `+1` in the finite spinor core. -/
theorem spinor_glide_core_sq : spinorGlideCore * spinorGlideCore = 1 := by
  unfold spinorGlideCore gamma_space gamma_time upperRightId32 lowerLeftId32
  native_decide

/-- Finite kernel-checked packet for the concrete Pin(5,5) spinor glide core. -/
theorem pin55_spinor_glide_packet :
    gamma_space * gamma_space = 1 ∧
      gamma_time * gamma_time = -1 ∧
      gamma_space * gamma_time = - (gamma_time * gamma_space) ∧
      gamma_space * spinorGlideCore = gamma_time ∧
      spinorGlideCore * gamma_space = -gamma_time ∧
      spinorGlideCore * spinorGlideCore = 1 := by
  exact ⟨gamma_space_sq, gamma_time_sq, gamma_space_time_anticomm,
    spinor_glide_composition_anticommutes, spinor_glide_right_sign, spinor_glide_core_sq⟩

end InfoGeometry.OperatorAlgebra.Pin55
