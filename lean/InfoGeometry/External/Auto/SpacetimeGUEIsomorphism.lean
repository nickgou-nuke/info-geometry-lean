-- Part 1:  The Spacetime 2×2 Hermitian Matrix
---------------------------------------------------------------

/-- Pauli matrices (standard representation). -/
def pauli_1 : Matrix (Fin 2) (Fin 2) ℂ := !![0, 1; 1, 0]
def pauli_2 : Matrix (Fin 2) (Fin 2) ℂ := !![0, -I; I, 0]
def pauli_3 : Matrix (Fin 2) (Fin 2) ℂ := !![1, 0; 0, -1]
def identity_2 : Matrix (Fin 2) (Fin 2) ℂ := !![1, 0; 0, 1]

/-- A Minkowski spacetime 4-vector represented as a 2×2 Hermitian matrix:
    X(t, x, y, z) = t·I + x·σ₁ + y·σ₂ + z·σ₃

    This is the standard twistor incidence matrix. -/
def spacetimeMatrix (t x y z : ℝ) : Matrix (Fin 2) (Fin 2) ℂ :=
  (t : ℂ) • identity_2 +
  (x : ℂ) • pauli_1 +
  (y : ℂ) • pauli_2 +
  (z : ℂ) • pauli_3

/-- Explicit matrix form:
    X = [t+z   x−iy]
        [x+iy  t−z ] -/
theorem spacetimeMatrix_explicit (t x y z : ℝ) :
    spacetimeMatrix t x y z =
      !![(t + z : ℂ), (x : ℂ) - I * (y : ℂ); (x : ℂ) + I * (y : ℂ), (t - z : ℂ)] := by
  ext i j <;> fin_cases i <;> fin_cases j <;> simp [spacetimeMatrix, pauli_1, pauli_2, pauli_3, identity_2] <;> ring
theorem spacetimeMatrix_hermitian (t x y z : ℝ) :
    Matrix.conjTranspose (spacetimeMatrix t x y z) = spacetimeMatrix t x y z := by
  ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [spacetimeMatrix, pauli_1, pauli_2, pauli_3, identity_2]


theorem trace_spacetime_is_time (t x y z : ℝ) :
    Matrix.trace (spacetimeMatrix t x y z) = 2 * (t : ℂ) := by
  rw [spacetimeMatrix]
  norm_num [identity_2, pauli_1, pauli_2, pauli_3, Matrix.trace, Fin.sum_univ_two]
  ring
theorem det_spacetime_is_proper_time_sq (t x y z : ℝ) :
    Matrix.det (spacetimeMatrix t x y z) = (t : ℂ)^2 - (x : ℂ)^2 - (y : ℂ)^2 - (z : ℂ)^2 := by
  have hcast : Matrix.det (spacetimeMatrix t x y z) = ((t^2 - x^2 - y^2 - z^2 : ℝ) : ℂ) := by
    rw [Matrix.det_fin_two]
    simp [spacetimeMatrix, pauli_1, pauli_2, pauli_3, identity_2]
    ring_nf
    simp [Complex.I_sq]
    ring
  simpa [sub_eq_add_neg, add_assoc, add_comm, add_left_comm] using hcast
theorem det_spacetime_real (t x y z : ℝ) :
    (Matrix.det (spacetimeMatrix t x y z)).im = 0 := by
  have hcast : Matrix.det (spacetimeMatrix t x y z) = ((t^2 - x^2 - y^2 - z^2 : ℝ) : ℂ) := by
    rw [Matrix.det_fin_two]
    simp [spacetimeMatrix, pauli_1, pauli_2, pauli_3, identity_2]
    ring_nf
    simp [Complex.I_sq]
    ring
  rw [hcast]
  norm_num [sub_eq_add_neg, pow_two]

def isLightCone (t x y z : ℝ) : Prop :=
  t^2 = x^2 + y^2 + z^2

theorem lightCone_iff_det_zero (t x y z : ℝ) :
    isLightCone t x y z ↔ Matrix.det (spacetimeMatrix t x y z) = 0 := by
  constructor
  · intro h
    have h' : t^2 - x^2 - y^2 - z^2 = 0 := by
      calc
        t^2 - x^2 - y^2 - z^2 = t^2 - (x^2 + y^2 + z^2) := by ring
        _ = 0 := by exact sub_eq_zero.mpr h
    have hcast : Matrix.det (spacetimeMatrix t x y z) = ((t^2 - x^2 - y^2 - z^2 : ℝ) : ℂ) := by
      rw [Matrix.det_fin_two]
      simp [spacetimeMatrix, pauli_1, pauli_2, pauli_3, identity_2]
      ring_nf
      simp [Complex.I_sq]
      ring
    rw [hcast]
    exact_mod_cast h'
  · intro h
    have hcast : Matrix.det (spacetimeMatrix t x y z) = ((t^2 - x^2 - y^2 - z^2 : ℝ) : ℂ) := by
      rw [Matrix.det_fin_two]
      simp [spacetimeMatrix, pauli_1, pauli_2, pauli_3, identity_2]
      ring_nf
      simp [Complex.I_sq]
      ring
    have h0 : ((t^2 - x^2 - y^2 - z^2 : ℝ) : ℂ) = 0 := by simpa [hcast] using h
    have hreal : t^2 - x^2 - y^2 - z^2 = 0 := by
      exact_mod_cast h0
    have hsq : t^2 = x^2 + y^2 + z^2 := by
      nlinarith [hreal]
    exact hsq

