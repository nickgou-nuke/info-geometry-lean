import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Physics.ChiralSUSYBlockFactorization

/-!
# Finite split-Cartan chiral nilpotent block

This owner records the concrete real `2 x 2` block algebra generated by one
upper and one lower chiral nilpotent block.  It is deliberately finite: the
grading matrix is an auxiliary block grading, and no identification with a
Tomita operator, a native Krein fundamental symmetry, or an `osp` Lie
superalgebra is made here.
-/

namespace InfoGeometry.Canonical.SplitCartanChiralNilpotentBlock

open InfoGeometry.Physics

abbrev Block := ChiralBlock ℝ

noncomputable def qPlus : Block := chiralQPlus (1 : ℝ)

noncomputable def qMinus : Block := chiralQMinus (1 : ℝ)

noncomputable def dirac : Block := qPlus + qMinus

noncomputable def qAnticomm : Block := qPlus * qMinus + qMinus * qPlus

noncomputable def gamma : Block := chiralParity

noncomputable def kAxis : Block := qMinus - qPlus

noncomputable def commutator (x y : Block) : Block := x * y - y * x

theorem qPlus_sq_zero : qPlus * qPlus = 0 := by
  exact chiralQPlus_sq 1

theorem qMinus_sq_zero : qMinus * qMinus = 0 := by
  exact chiralQMinus_sq 1

theorem dirac_sq_eq_qAnticomm : dirac * dirac = qAnticomm := by
  simpa [dirac, qAnticomm] using chiralDirac_sq_eq_susyHamiltonian (1 : ℝ) 1

/-! ## Chiral Hodge--Dirac readout -/

/-- The finite chiral Hodge--Dirac operator is the sum of the two nilpotent channels. -/
noncomputable def hodgeDirac : Block := qPlus + qMinus

/-- The finite even Hodge--Laplacian is the square of `hodgeDirac`. -/
noncomputable def hodgeLaplacian : Block := hodgeDirac * hodgeDirac

theorem hodgeDirac_sq_eq_cross_terms :
    hodgeDirac * hodgeDirac = qPlus * qMinus + qMinus * qPlus := by
  simpa [hodgeDirac, qAnticomm] using dirac_sq_eq_qAnticomm

theorem hodgeDirac_sq_eq_qAnticomm :
    hodgeDirac * hodgeDirac = qAnticomm := by
  change dirac * dirac = qAnticomm
  exact dirac_sq_eq_qAnticomm

theorem qAnticomm_eq_one : qAnticomm = (1 : Block) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [qAnticomm, qPlus, qMinus, chiralQPlus, chiralQMinus,
      Matrix.mul_apply, Fin.sum_univ_two]

theorem hodgeLaplacian_eq_qAnticomm : hodgeLaplacian = qAnticomm := by
  change hodgeDirac * hodgeDirac = qAnticomm
  exact hodgeDirac_sq_eq_qAnticomm

theorem hodgeLaplacian_commutes_gamma :
    hodgeLaplacian * gamma = gamma * hodgeLaplacian := by
  rw [hodgeLaplacian_eq_qAnticomm, qAnticomm_eq_one]
  simp

theorem gamma_eq_q_commutator :
    gamma = commutator qPlus qMinus := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [gamma, commutator, qPlus, qMinus, chiralParity,
      chiralQPlus, chiralQMinus, Matrix.mul_apply, Fin.sum_univ_two]

theorem gamma_sq : gamma * gamma = (1 : Block) := by
  exact chiralParity_sq

theorem kAxis_sq : kAxis * kAxis = -(1 : Block) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [kAxis, qPlus, qMinus, chiralQPlus, chiralQMinus,
      Matrix.mul_apply, Fin.sum_univ_two]

theorem kAxis_gamma_anticomm :
    kAxis * gamma + gamma * kAxis = 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [kAxis, gamma, qPlus, qMinus, chiralParity,
      chiralQPlus, chiralQMinus, Matrix.mul_apply, Fin.sum_univ_two]

theorem dirac_mul_kAxis_eq_gamma : dirac * kAxis = gamma := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [dirac, kAxis, gamma, qPlus, qMinus, chiralParity,
      chiralQPlus, chiralQMinus, Matrix.mul_apply, Fin.sum_univ_two]

theorem kAxis_mul_dirac_eq_neg_gamma : kAxis * dirac = -gamma := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [dirac, kAxis, gamma, qPlus, qMinus, chiralParity,
      chiralQPlus, chiralQMinus, Matrix.mul_apply, Fin.sum_univ_two]

theorem dirac_kAxis_anticommute : dirac * kAxis + kAxis * dirac = 0 := by
  rw [dirac_mul_kAxis_eq_gamma, kAxis_mul_dirac_eq_neg_gamma]
  simp

theorem gamma_dirac_anticommute : gamma * dirac + dirac * gamma = 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [dirac, gamma, qPlus, qMinus, chiralParity,
      chiralQPlus, chiralQMinus, Matrix.mul_apply, Fin.sum_univ_two]

theorem hodgeDirac_anticommutes_gamma :
    hodgeDirac * gamma + gamma * hodgeDirac = 0 := by
  simpa [hodgeDirac, dirac, add_comm] using gamma_dirac_anticommute

noncomputable def relativeSurprisal (κ a : ℝ) : Block :=
  !![κ + a, 0; 0, κ - a]

theorem relativeSurprisal_eq_scalar_grade (κ a : ℝ) :
    relativeSurprisal κ a = κ • (1 : Block) + a • gamma := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [relativeSurprisal, gamma, chiralParity, Matrix.one_apply]
    <;> ring

theorem relativeSurprisal_comm_qPlus (κ a : ℝ) :
    commutator (relativeSurprisal κ a) qPlus = (2 * a) • qPlus := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [commutator, relativeSurprisal, gamma, qPlus,
      chiralParity, chiralQPlus, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

theorem relativeSurprisal_comm_qMinus (κ a : ℝ) :
    commutator (relativeSurprisal κ a) qMinus = (-2 * a) • qMinus := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [commutator, relativeSurprisal, gamma, qMinus,
      chiralParity, chiralQMinus, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

theorem relativeSurprisal_trace (κ a : ℝ) :
    Matrix.trace (relativeSurprisal κ a) = 2 * κ := by
  simp [relativeSurprisal, Matrix.trace, Fin.sum_univ_two]
  ring

theorem relativeSurprisal_centered (κ a : ℝ) :
    relativeSurprisal κ a -
        ((1 / 2 : ℝ) * Matrix.trace (relativeSurprisal κ a)) • (1 : Block) =
      a • gamma := by
  rw [relativeSurprisal_trace]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [relativeSurprisal, gamma, chiralParity, Matrix.one_apply]
    <;> ring

noncomputable def relativeDensity (κ a : ℝ) : Block :=
  !![Real.exp (-(κ + a)), 0; 0, Real.exp (-(κ - a))]

theorem relativeDensity_det (κ a : ℝ) :
    Matrix.det (relativeDensity κ a) = Real.exp (-2 * κ) := by
  simp [relativeDensity, Matrix.det_fin_two]
  rw [← Real.exp_add]
  congr 1
  ring

theorem neg_log_det_relativeDensity_eq_trace_surprisal (κ a : ℝ) :
    -Real.log (Matrix.det (relativeDensity κ a)) =
      Matrix.trace (relativeSurprisal κ a) := by
  rw [relativeDensity_det, Real.log_exp, relativeSurprisal_trace]
  ring

theorem centeredRelativeDensity_det_eq_one (a : ℝ) :
    Matrix.det (relativeDensity 0 a) = 1 := by
  simpa using relativeDensity_det 0 a

theorem relativeDensity_factorization (κ a : ℝ) :
    relativeDensity κ a =
      (Real.exp (-κ) • (1 : Block)) * relativeDensity 0 a := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [relativeDensity, Matrix.mul_apply, Fin.sum_univ_two]
    <;> rw [← Real.exp_add]
    <;> congr 1 <;> ring

/-! ## Finite unipotent and compact companion laws -/

noncomputable def nPlus (t : ℝ) : Block :=
  !![1, t; 0, 1]

noncomputable def nMinus (t : ℝ) : Block :=
  !![1, 0; t, 1]

theorem nPlus_add (s t : ℝ) :
    nPlus s * nPlus t = nPlus (s + t) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [nPlus, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

theorem nMinus_add (s t : ℝ) :
    nMinus s * nMinus t = nMinus (s + t) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [nMinus, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

theorem nPlus_inverse (t : ℝ) :
    nPlus t * nPlus (-t) = (1 : Block) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [nPlus, Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply]
    <;> ring

theorem nMinus_inverse (t : ℝ) :
    nMinus t * nMinus (-t) = (1 : Block) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [nMinus, Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply]
    <;> ring

noncomputable def phaseRotation (θ : ℝ) : Block :=
  !![Real.cos θ, -(Real.sin θ); Real.sin θ, Real.cos θ]

theorem phaseRotation_eq_cos_smul_add_sin_smul (θ : ℝ) :
    phaseRotation θ = Real.cos θ • (1 : Block) + Real.sin θ • kAxis := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [phaseRotation, kAxis, qPlus, qMinus, chiralQPlus,
      chiralQMinus, Matrix.one_apply]

theorem phaseRotation_add (s t : ℝ) :
    phaseRotation s * phaseRotation t = phaseRotation (s + t) := by
  unfold phaseRotation
  rw [Real.cos_add, Real.sin_add]
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [phaseRotation, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

theorem phaseRotation_inverse (θ : ℝ) :
    phaseRotation θ * phaseRotation (-θ) = (1 : Block) := by
  unfold phaseRotation
  rw [Real.cos_neg, Real.sin_neg]
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply]
    <;> nlinarith [Real.sin_sq_add_cos_sq θ]

/-! ## Finite Cartan action and hyperbolic readout -/

noncomputable def cartanAction (a : ℝ) : Block :=
  !![Real.exp a, 0; 0, Real.exp (-a)]

theorem cartanAction_eq_cosh_sinh_grade (a : ℝ) :
    cartanAction a =
      Real.cosh a • (1 : Block) + Real.sinh a • gamma := by
  ext i j
  fin_cases i <;> fin_cases j
  · simp [cartanAction, gamma, chiralParity, Matrix.one_apply,
      Real.cosh_eq, Real.sinh_eq]
    ring
  · simp [cartanAction, gamma, chiralParity]
  · simp [cartanAction, gamma, chiralParity]
  · simp [cartanAction, gamma, chiralParity, Matrix.one_apply,
      Real.cosh_eq, Real.sinh_eq]
    ring

theorem cartanAction_zero : cartanAction 0 = (1 : Block) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [cartanAction, Matrix.one_apply]

theorem cartanAction_add (s t : ℝ) :
    cartanAction (s + t) = cartanAction s * cartanAction t := by
  ext i j
  fin_cases i <;> fin_cases j
  · simp [cartanAction, Real.exp_add]
  · simp [cartanAction]
  · simp [cartanAction]
  · simp [cartanAction, Real.exp_add, mul_comm]

end InfoGeometry.Canonical.SplitCartanChiralNilpotentBlock
