import Mathlib
import InfoGeometry.SuperGrassmannian.SuperconformalOSpJordanPair
import InfoGeometry.Physics.NuclearFiveGradeSolovievCommonCompression
import InfoGeometry.Physics.NuclearBdGSolovievAffineBridge

/-!
# Section 87: the OSp even corner in the finite Soloviev QPNM compression

The `M₃(ℝ)` generators and their superbracket relations are owned by
`SuperconformalOSpJordanPair`. The finite Soloviev matrix and its same-carrier
compression are owned by `NuclearQuasiphononKreinSUSY` and
`NuclearFiveGradeSolovievCommonCompression`.

This file proves the concrete bridge between those existing constructions:
restricting the OSp even element to the even-index corner `{0, 2}` gives the
traceless BdG block, and the existing compressed QPNM action is the scalar
center plus that corner action. No equivalence of the full carriers, no
Jordan-pair inner-derivation identification, and no spectral theorem is
asserted.
-/

namespace InfoGeometry.Nuclear.NuclearQuasiphononJordanPairBridge

open Matrix
open InfoGeometry.SuperGrassmannian.SuperconformalOSpJordanPair
open InfoGeometry.Physics.NuclearFiveGradeSolovievCommonCompression

abbrev M₃ := Matrix (Fin 3) (Fin 3) ℝ
abbrev M₂ := Matrix (Fin 2) (Fin 2) ℝ

/-- The two even indices in the `2|1` ordered OSp carrier. -/
def evenIndex : Fin 2 → Fin 3 := ![0, 2]

/-- Restriction of an endomorphism to the two even basis indices. -/
def evenCorner (X : M₃) : M₂ := fun i j => X (evenIndex i) (evenIndex j)

/-- The OSp even element generated by the canonical Section 86 basis. -/
def ospPairingElement (ε Δ : ℝ) : M₃ :=
  ε • H_gen ℝ + Δ • (E_gen ℝ + F_gen ℝ)

theorem evenCorner_H : evenCorner (H_gen ℝ) = !![1, 0; 0, -1] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [evenCorner, evenIndex, H_gen, E]

theorem evenCorner_E : evenCorner (E_gen ℝ) = !![0, 1; 0, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [evenCorner, evenIndex, E_gen, E]

theorem evenCorner_F : evenCorner (F_gen ℝ) = !![0, 0; 1, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [evenCorner, evenIndex, F_gen, E]

/-- The even corner of the OSp element is exactly the existing nuclear BdG block. -/
theorem evenCorner_ospPairingElement (ε Δ : ℝ) :
    evenCorner (ospPairingElement ε Δ) =
      InfoGeometry.Physics.NuclearBdGTwoLevelExact.bdgBlock ε Δ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [evenCorner, evenIndex, ospPairingElement,
      InfoGeometry.Physics.NuclearBdGTwoLevelExact.bdgBlock,
      H_gen, E_gen, F_gen, E]

/--
The OSp even element is reconstructed from Section 86's odd superbrackets.
The coefficients are over `ℝ`, so division by two is legitimate here.
-/
theorem ospPairingElement_from_superbrackets (ε Δ : ℝ) :
    ospPairingElement ε Δ =
      ε • InfoGeometry.Algebra.SupergradedBracket.superBracket true true
        (Q_plus ℝ) (Q_minus ℝ) +
      (Δ / 2) • (InfoGeometry.Algebra.SupergradedBracket.superBracket true true
        (Q_plus ℝ) (Q_plus ℝ) -
        InfoGeometry.Algebra.SupergradedBracket.superBracket true true
          (Q_minus ℝ) (Q_minus ℝ)) := by
  rw [superBracket_Qplus_Qminus, superBracket_Qplus_Qplus,
    superBracket_Qminus_Qminus]
  unfold ospPairingElement
  ext i j
  simp [H_gen, E_gen, F_gen, E]

/--
The existing two-level Soloviev QPNM matrix is its scalar center plus the
even corner of the canonical OSp element with parameters `(-ω/2, V)`.
-/
theorem qpnmMatrix_eq_center_add_ospCorner (Eqp ω V : ℝ) :
    InfoGeometry.Physics.SolovievQPNMEigenproblem.qpnmMatrix Eqp ω V =
      InfoGeometry.Physics.NuclearBdGSolovievAffineBridge.solovievCenter Eqp ω •
          (1 : M₂) +
        evenCorner (ospPairingElement
          (InfoGeometry.Physics.NuclearBdGSolovievAffineBridge.solovievBdGCoordinate ω) V) := by
  rw [evenCorner_ospPairingElement]
  exact InfoGeometry.Physics.NuclearBdGSolovievAffineBridge.qpnm_eq_center_add_bdg
    Eqp ω V

/--
The common-carrier compressed Soloviev action is the center plus the OSp
corner action. This composes the Section 86 corner theorem with the existing
same-carrier compression theorem, on each model vector.
-/
theorem compressedAction_eq_center_add_ospCorner
    (Eqp ω V C D : ℝ) :
    compressedAction Eqp ω V ![C, D] =
      Matrix.mulVec
        (InfoGeometry.Physics.NuclearBdGSolovievAffineBridge.solovievCenter Eqp ω •
          (1 : M₂) +
          evenCorner (ospPairingElement
            (InfoGeometry.Physics.NuclearBdGSolovievAffineBridge.solovievBdGCoordinate ω) V))
        ![C, D] := by
  rw [compressedAction_eq_qpnm_mulVec,
    qpnmMatrix_eq_center_add_ospCorner]

end InfoGeometry.Nuclear.NuclearQuasiphononJordanPairBridge
