import Mathlib

/-!
# Braid ideal descent

Constructive tensor-braid maps for quadratic creation/annihilation ideals.
The finite tensor maps `tauL` and `tauR`, the q-scaled swap exchange map, and
the source/target submodules give explicit Lean data for quotient descent.
-/

noncomputable section

namespace BraidIdealDescent

open TensorProduct

variable {K H H_dual : Type*} [CommRing K]
variable [AddCommGroup H] [Module K H]
variable [AddCommGroup H_dual] [Module K H_dual]

/-- Single-particle exchange map type `H* ⊗ H → H ⊗ H*`. -/
abbrev CrossMap := (H_dual ⊗[K] H) →ₗ[K] (H ⊗[K] H_dual)

/-- Left braid: move one annihilator past two creators, using the cross map on
adjacent tensor factors. -/
def tauL (C : CrossMap (K := K) (H := H) (H_dual := H_dual)) :
    (H_dual ⊗[K] (H ⊗[K] H)) →ₗ[K] ((H ⊗[K] H) ⊗[K] H_dual) :=
  let step1 := (TensorProduct.assoc K H_dual H H).symm.toLinearMap
  let step2 := TensorProduct.map C (LinearMap.id : H →ₗ[K] H)
  let step3 := (TensorProduct.assoc K H H_dual H).toLinearMap
  let step4 := TensorProduct.map (LinearMap.id : H →ₗ[K] H)
    (TensorProduct.comm K H_dual H).toLinearMap
  let step5 := (TensorProduct.assoc K H H H_dual).symm.toLinearMap
  step5.comp (step4.comp (step3.comp (step2.comp step1)))

/-- Right braid: move two annihilators past one creator, using the cross map on
adjacent tensor factors. -/
def tauR (C : CrossMap (K := K) (H := H) (H_dual := H_dual)) :
    ((H_dual ⊗[K] H_dual) ⊗[K] H) →ₗ[K] (H ⊗[K] (H_dual ⊗[K] H_dual)) :=
  let step1 := (TensorProduct.assoc K H_dual H_dual H).toLinearMap
  let step2 := TensorProduct.map (LinearMap.id : H_dual →ₗ[K] H_dual)
    (TensorProduct.comm K H_dual H).toLinearMap
  let step3 := (TensorProduct.assoc K H_dual H H_dual).symm.toLinearMap
  let step4 := TensorProduct.map C (LinearMap.id : H_dual →ₗ[K] H_dual)
  let step5 := (TensorProduct.assoc K H H_dual H_dual).toLinearMap
  step5.comp (step4.comp (step3.comp (step2.comp step1)))

/-- Target submodule `R ⊗ H*` inside `(H⊗H)⊗H*`. -/
def leftTarget (R : Submodule K (H ⊗[K] H)) : Submodule K ((H ⊗[K] H) ⊗[K] H_dual) :=
  LinearMap.range (TensorProduct.map R.subtype (LinearMap.id : H_dual →ₗ[K] H_dual))

/-- Target submodule `H ⊗ S` inside `H⊗(H*⊗H*)`. -/
def rightTarget (S : Submodule K (H_dual ⊗[K] H_dual)) : Submodule K (H ⊗[K] (H_dual ⊗[K] H_dual)) :=
  LinearMap.range (TensorProduct.map (LinearMap.id : H →ₗ[K] H) S.subtype)

/-- Left quadratic `τ`-ideal condition. -/
def IsLeftTauIdeal (R : Submodule K (H ⊗[K] H))
    (C : CrossMap (K := K) (H := H) (H_dual := H_dual)) : Prop :=
  ∀ (eta : H_dual) (r : R),
    tauL C (eta ⊗ₜ[K] (r : H ⊗[K] H)) ∈ leftTarget (H_dual := H_dual) R

/-- Right quadratic `τ`-ideal condition. -/
def IsRightTauIdeal (S : Submodule K (H_dual ⊗[K] H_dual))
    (C : CrossMap (K := K) (H := H) (H_dual := H_dual)) : Prop :=
  ∀ (s : S) (v : H),
    tauR C ((s : H_dual ⊗[K] H_dual) ⊗ₜ[K] v) ∈ rightTarget (H := H) S

/-- q-scaled swap exchange map: `C_q(η⊗x)=q • (x⊗η)`. -/
def qCrossMap (q : K) : CrossMap (K := K) (H := H) (H_dual := H_dual) :=
  q • (TensorProduct.comm K H_dual H).toLinearMap

@[simp] theorem qCrossMap_tmul (q : K) (eta : H_dual) (x : H) :
    qCrossMap (K := K) (H := H) (H_dual := H_dual) q (eta ⊗ₜ[K] x) =
      q • (x ⊗ₜ[K] eta) := by
  simp [qCrossMap]

/-! ## Proved: left/right τ-ideal ⇒ submodule span preservation

We define `leftSource R` as the submodule generated by `eta ⊗ r` for `r ∈ R`
(the `LinearMap.range` of `id ⊗ R.subtype`), and prove that `IsLeftTauIdeal R C`
implies `tauL C` maps `leftSource R` into `leftTarget R`. Same for right.

The proof uses `TensorProduct.induction_on`: linearity lifts the generator
condition to the full submodule span, supplying the `Submodule.mapQ`
preservation condition used by quotient Yang--Baxter descent. -/

/-- The submodule `H_dual ⊗ R` in `H_dual ⊗ (H ⊗ H)`, generated by `{eta ⊗ r | r ∈ R}`. -/
def leftSource (R : Submodule K (H ⊗[K] H)) : Submodule K (H_dual ⊗[K] (H ⊗[K] H)) :=
  (TensorProduct.map (LinearMap.id : H_dual →ₗ[K] H_dual) R.subtype).range

/-- The submodule `S ⊗ H` in `(H_dual ⊗ H_dual) ⊗ H`, generated by `{s ⊗ v | s ∈ S}`. -/
def rightSource (S : Submodule K (H_dual ⊗[K] H_dual)) : Submodule K ((H_dual ⊗[K] H_dual) ⊗[K] H) :=
  (TensorProduct.map S.subtype (LinearMap.id : H →ₗ[K] H)).range

/-- `tauL C` preserves generators: for all `eta`, `r ∈ R`,
`tauL C (eta ⊗ r)` ∈ `leftTarget R`. This is exactly `IsLeftTauIdeal`. -/
lemma tauL_on_generator (R : Submodule K (H ⊗[K] H))
    (C : CrossMap (K := K) (H := H) (H_dual := H_dual))
    (h : IsLeftTauIdeal R C) (eta : H_dual) {r : H ⊗[K] H} (hr : r ∈ R) :
    tauL C (eta ⊗ₜ[K] r) ∈ leftTarget (H := H) (H_dual := H_dual) R :=
  h eta ⟨r, hr⟩

/-- `tauL C` maps `leftSource R` into `leftTarget R`.
Tensor induction lifts the generator condition `IsLeftTauIdeal` to the full span. -/
theorem tauL_maps_leftSource_to_leftTarget
    (R : Submodule K (H ⊗[K] H))
    (C : CrossMap (K := K) (H := H) (H_dual := H_dual))
    (h : IsLeftTauIdeal R C) (x : H_dual ⊗[K] (H ⊗[K] H))
    (hx : x ∈ leftSource (H := H) (H_dual := H_dual) R) :
    tauL C x ∈ leftTarget (H := H) (H_dual := H_dual) R := by
  rcases hx with ⟨y, rfl⟩
  refine TensorProduct.induction_on y ?_ ?_ ?_
  · -- zero
    simp [tauL, leftTarget]
  · -- tmul: y = eta ⊗ₜ r where r : R (as subtype)
    intro eta r
    -- r is a Subtype (· ∈ R); h expects an element of R
    -- (id ⊗ R.subtype)(eta ⊗ₜ r) = eta ⊗ₜ (r : H⊗H)
    simpa using h eta r
  · -- add
    intro y₁ y₂ hy₁ hy₂
    -- hyᵢ: tauL C ((id ⊗ R.subtype) yᵢ) ∈ leftTarget R
    -- tauL C is linear, so tauL C ((id ⊗ R.subtype)(y₁+y₂))
    --   = tauL C ((id ⊗ R.subtype) y₁ + (id ⊗ R.subtype) y₂)
    --   = tauL C (...)₁ + tauL C (...)₂, which is in leftTarget R by submodule add
    simpa [map_add] using add_mem hy₁ hy₂

/-- `tauR C` maps `rightSource S` into `rightTarget S`.
Same proof structure: tensor induction + `IsRightTauIdeal`. -/
theorem tauR_maps_rightSource_to_rightTarget
    (S : Submodule K (H_dual ⊗[K] H_dual))
    (C : CrossMap (K := K) (H := H) (H_dual := H_dual))
    (h : IsRightTauIdeal S C) (x : (H_dual ⊗[K] H_dual) ⊗[K] H)
    (hx : x ∈ rightSource (H := H) (H_dual := H_dual) S) :
    tauR C x ∈ rightTarget (H := H) (H_dual := H_dual) S := by
  rcases hx with ⟨y, rfl⟩
  refine TensorProduct.induction_on y ?_ ?_ ?_
  · simp [tauR, rightTarget]
  · intro s v
    -- s is a Subtype (· ∈ S); h expects an element of S
    simpa using h s v
  · intro y₁ y₂ hy₁ hy₂
    simpa [map_add] using add_mem hy₁ hy₂

/-! ## Quotient-level descended braid maps -/

/-- The left braid descends to the quotient by the quadratic source/target
submodules whenever the explicit generator condition `IsLeftTauIdeal` holds.
The preservation theorem supplies the `Submodule.mapQ` condition for quotient
Yang--Baxter descent. -/
def tauLDesc
    (R : Submodule K (H ⊗[K] H))
    (C : CrossMap (K := K) (H := H) (H_dual := H_dual))
    (h : IsLeftTauIdeal R C) :
    (H_dual ⊗[K] (H ⊗[K] H)) ⧸ leftSource (H := H) (H_dual := H_dual) R →ₗ[K]
      ((H ⊗[K] H) ⊗[K] H_dual) ⧸ leftTarget (H := H) (H_dual := H_dual) R :=
  Submodule.mapQ (leftSource (H := H) (H_dual := H_dual) R)
    (leftTarget (H := H) (H_dual := H_dual) R)
    (tauL C)
    (by
      intro x hx
      exact tauL_maps_leftSource_to_leftTarget R C h x hx)

@[simp] theorem tauLDesc_mk
    (R : Submodule K (H ⊗[K] H))
    (C : CrossMap (K := K) (H := H) (H_dual := H_dual))
    (h : IsLeftTauIdeal R C) (x : H_dual ⊗[K] (H ⊗[K] H)) :
    tauLDesc R C h (Submodule.Quotient.mk x) = Submodule.Quotient.mk (tauL C x) := by
  rfl

/-- The right braid descends to the quotient by the quadratic source/target
submodules whenever the explicit generator condition `IsRightTauIdeal` holds. -/
def tauRDesc
    (S : Submodule K (H_dual ⊗[K] H_dual))
    (C : CrossMap (K := K) (H := H) (H_dual := H_dual))
    (h : IsRightTauIdeal S C) :
    ((H_dual ⊗[K] H_dual) ⊗[K] H) ⧸ rightSource (H := H) (H_dual := H_dual) S →ₗ[K]
      (H ⊗[K] (H_dual ⊗[K] H_dual)) ⧸ rightTarget (H := H) (H_dual := H_dual) S :=
  Submodule.mapQ (rightSource (H := H) (H_dual := H_dual) S)
    (rightTarget (H := H) (H_dual := H_dual) S)
    (tauR C)
    (by
      intro x hx
      exact tauR_maps_rightSource_to_rightTarget S C h x hx)

@[simp] theorem tauRDesc_mk
    (S : Submodule K (H_dual ⊗[K] H_dual))
    (C : CrossMap (K := K) (H := H) (H_dual := H_dual))
    (h : IsRightTauIdeal S C) (x : (H_dual ⊗[K] H_dual) ⊗[K] H) :
    tauRDesc S C h (Submodule.Quotient.mk x) = Submodule.Quotient.mk (tauR C x) := by
  rfl



#check tauLDesc
#check tauLDesc_mk
#check tauRDesc
#check tauRDesc_mk

end BraidIdealDescent
