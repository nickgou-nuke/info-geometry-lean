{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ResonanceCluster.schema.json",
  "title": "ResonanceCluster",
  "allOf": [
    {
      "$ref": "common_envelope.schema.json"
    },
    {
      "$ref": "authority.schema.json"
    },
    {
      "$ref": "representation.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "cluster_method",
        "cluster_signature",
        "member_count",
        "invariant_hypothesis",
        "distinguishing_axes"
      ],
      "properties": {
        "kind": {
          "const": "ResonanceCluster"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "stabilized",
            "translated",
            "formalized",
            "retired",
            "archived"
          ]
        },
        "authority": {
          "const": "semantic"
        },
        "cluster_method": {
          "type": "string",
          "minLength": 1
        },
        "cluster_signature": {
          "type": "string",
          "minLength": 1
        },
        "member_count": {
          "type": "integer",
          "minimum": 1
        },
        "invariant_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "distinguishing_axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
