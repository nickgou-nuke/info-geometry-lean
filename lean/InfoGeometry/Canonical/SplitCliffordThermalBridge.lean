import InfoGeometry.Canonical.BogoliubovFockSuper
import InfoGeometry.Canonical.InformationPartitionCore
import InfoGeometry.Canonical.KreinDiracSpectralLift

/-!
# Split Clifford Thermal Bridge

Thin canonical bridge placing the existing grand-canonical/Bogoliubov thermal
surface on the same transported Dirac--Clifford--Krein carrier.

This file does not introduce a new bundled state ontology. It only packages
existing owners so the thermal reading stays on the correct carrier:

- strict symmetry transports polarization and chirality weights,
- the transported Dirac operator remains the ambient spectral generator,
- grand-canonical deformation is taken relative to that transported Dirac
  generator on the same doubled carrier,
- and the existing partition/log-partition calculus applies to the deformed
  generator.
-/

namespace SplitCliffordThermalBridge

open InfoGeometry.Quantum.RealMajorana
open InfoGeometry.Canonical.BogoliubovFockSuper
open InfoGeometry.Canonical.BogoliubovPolarizationBridge
open InfoGeometry.Canonical.KreinDiracPolarizationBridge
open InfoGeometry.Canonical.KreinDiracSpectralLift
open InfoGeometry.Canonical.SpectralInference
open InfoGeometry.Canonical.InformationCalculus.ModularRadonNikodymData
open InfoGeometry.Canonical.RicciMongeAmpere
open InfoGeometry.Krein

section Doubled

variable {E : Type}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {M : RealMajoranaDatum (S := DoubledSpace E)}

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
noncomputable local instance : NormedSpace ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance

/-- Grand-canonical thermal deformation of the transported Dirac generator. -/
noncomputable def transportedThermalGenerator
    (B : HyperbolicMixingParams)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M) (μ : ℝ) : EndH :=
  grandCanonicalFockGenerator (E := E) B (transportDirac IST T) μ

@[simp] theorem transportedThermalGenerator_eq_transportDirac_of_zeroChemicalPotential
    (B : HyperbolicMixingParams)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M) :
    transportedThermalGenerator (E := E) B IST T 0 = transportDirac IST T := by
  change grandCanonicalFockGenerator (E := E) B (transportDirac IST T) 0 = transportDirac IST T
  change transportDirac IST T - 0 • bogoliubovNumberOperator (E := E) B = transportDirac IST T
  simp

/-- Exponential flow generated by the transported thermal deformation. -/
noncomputable def transportedThermalFlow
    (B : HyperbolicMixingParams)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M)
    (μ τ : ℝ) : EndH :=
  NormedSpace.exp (τ • transportedThermalGenerator (E := E) B IST T μ)

@[simp] theorem transportedThermalFlow_zero
    (B : HyperbolicMixingParams)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M)
    (μ : ℝ) :
    transportedThermalFlow (E := E) B IST T μ 0 = (1 : EndH) := by
  simp [transportedThermalFlow]

/-- Additive-time law for the transported thermal flow. -/
theorem transportedThermalFlow_add
    (B : HyperbolicMixingParams)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M)
    (μ s t : ℝ) :
    transportedThermalFlow (E := E) B IST T μ (s + t)
      = transportedThermalFlow (E := E) B IST T μ s
          * transportedThermalFlow (E := E) B IST T μ t := by
  have hComm :
      Commute
        (s • transportedThermalGenerator (E := E) B IST T μ)
        (t • transportedThermalGenerator (E := E) B IST T μ) := by
    exact ((Commute.refl (transportedThermalGenerator (E := E) B IST T μ)).smul_left s).smul_right t
  calc
    transportedThermalFlow (E := E) B IST T μ (s + t)
        = NormedSpace.exp
            ((s + t) • transportedThermalGenerator (E := E) B IST T μ) := rfl
    _ = NormedSpace.exp
          (s • transportedThermalGenerator (E := E) B IST T μ
            + t • transportedThermalGenerator (E := E) B IST T μ) := by
          simp [add_smul]
    _ = NormedSpace.exp (s • transportedThermalGenerator (E := E) B IST T μ)
          * NormedSpace.exp (t • transportedThermalGenerator (E := E) B IST T μ) := by
          rw [NormedSpace.exp_add_of_commute hComm]
    _ = transportedThermalFlow (E := E) B IST T μ s
          * transportedThermalFlow (E := E) B IST T μ t := rfl

/-- The partition calculus applies to the transported thermal generator. -/
theorem hasDerivAt_transportedThermalPartitionFunction_zero
    (ω : EndH →L[ℝ] ℝ)
    (B : HyperbolicMixingParams)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M)
    (μ : ℝ) :
    HasDerivAt
      (fun τ : ℝ =>
        informationPartitionFunction ω
          (transportedThermalGenerator (E := E) B IST T μ) τ)
      (ω (transportedThermalGenerator (E := E) B IST T μ)) 0 :=
  hasDerivAt_informationPartitionFunction_zero
    (ω := ω) (K := transportedThermalGenerator (E := E) B IST T μ)

/-- Normalized log-partition calculus for the transported thermal generator. -/
theorem hasDerivAt_logTransportedThermalPartitionFunction_zero_of_normalized
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1)
    (B : HyperbolicMixingParams)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M)
    (μ : ℝ) :
    HasDerivAt
      (fun τ : ℝ =>
        logInformationPartitionFunction ω
          (transportedThermalGenerator (E := E) B IST T μ) τ)
      (ω (transportedThermalGenerator (E := E) B IST T μ)) 0 :=
  hasDerivAt_logInformationPartitionFunction_zero_of_normalized
    (ω := ω) (K := transportedThermalGenerator (E := E) B IST T μ) hω1

/-- Vacuum transport kills the Einstein-induced thermal deformation gauge term. -/
theorem transportedThermalGenerator_eq_transportDirac_of_vacuumTransported
    (B : HyperbolicMixingParams)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M)
    (R : RicciTensor E)
    (K : InfoGeometry.Canonical.KaehlerGeometry.KaehlerInformationGeometry E)
    (x : E) (scalar Λ : ℝ)
    (V : SplitVielbein K x) (Γ : SpinConnection K x V)
    (hVacSplit : VacuumEinsteinOnTransportedSplit R K x scalar Λ V Γ) :
    transportedThermalGenerator (E := E) B IST T
      (einsteinInducedChemicalPotential R K x scalar Λ V Γ) = transportDirac IST T := by
  simpa [transportedThermalGenerator] using
    grandCanonicalFockGenerator_eq_hamiltonian_of_vacuumTransported
      (E := E) (B := B) (H := transportDirac IST T)
      (R := R) (K := K) (x := x) (scalar := scalar) (Λ := Λ)
      (V := V) (Γ := Γ) hVacSplit

/--
Canonical thermal bridge on the transported split-Clifford/Krein carrier.
Strict symmetry transports polarization and chirality weights, the target
polarization yields the projector-super pair, and the deformed thermal generator
enters the existing partition calculus on the same carrier.
-/
theorem splitCliffordThermalBridge_of_strictSymmetry
    (ω : EndH →L[ℝ] ℝ)
    (B : HyperbolicMixingParams)
    (μ : ℝ)
    (IST : InfoSpectralTriple H₂)
    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :
    (h.toBogoliubovTransform).transportP X.polarization = Y.polarization.P ∧
    IsProjectorSuperPair
      (KPolarization.splitOfPolarization (M := M) Y.polarization).Pminus
      (KPolarization.splitOfPolarization (M := M) Y.polarization).Pplus ∧
    Submodule.map h.f.toLinearMap M.weylPlus = (h.toBogoliubovTransform).transportWeylPlus ∧
    Submodule.map h.f.toLinearMap M.weylMinus = (h.toBogoliubovTransform).transportWeylMinus ∧
    HasDerivAt
      (fun τ : ℝ =>
        informationPartitionFunction ω
          (transportedThermalGenerator (E := E) B IST h.toBogoliubovTransform μ) τ)
      (ω (transportedThermalGenerator (E := E) B IST h.toBogoliubovTransform μ)) 0 := by
  exact ⟨transportP_eq_targetPolarization_of_strictSymmetry h,
    projectorSuperPair_of_targetPolarization (E := E) (M := M) Y,
    (transportedChiralityWeights_of_strictSymmetry (M := M) h).1,
    (transportedChiralityWeights_of_strictSymmetry (M := M) h).2,
    hasDerivAt_transportedThermalPartitionFunction_zero
      (ω := ω) (B := B) (IST := IST) (T := h.toBogoliubovTransform) (μ := μ)⟩

/-- Normalized log-partition version of the transported thermal bridge. -/
theorem normalized_logSplitCliffordThermalBridge_of_strictSymmetry
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1)
    (B : HyperbolicMixingParams)
    (μ : ℝ)
    (IST : InfoSpectralTriple H₂)
    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :
    HasDerivAt
      (fun τ : ℝ =>
        logInformationPartitionFunction ω
          (transportedThermalGenerator (E := E) B IST h.toBogoliubovTransform μ) τ)
      (ω (transportedThermalGenerator (E := E) B IST h.toBogoliubovTransform μ)) 0 :=
  hasDerivAt_logTransportedThermalPartitionFunction_zero_of_normalized
    (ω := ω) (hω1 := hω1) (B := B) (IST := IST)
    (T := h.toBogoliubovTransform) (μ := μ)

end Doubled

end SplitCliffordThermalBridge
