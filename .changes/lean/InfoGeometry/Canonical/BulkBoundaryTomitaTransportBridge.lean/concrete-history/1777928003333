{"type":"new","contents":"import InfoGeometry.Canonical.BulkBoundaryZeroModeOwner\nimport InfoGeometry.Canonical.BogoliubovTransport\nimport InfoGeometry.Canonical.RealTomitaCore\nimport InfoGeometry.Canonical.StandardFormCore\nimport InfoGeometry.Canonical.WedgeBoostModularBridge\nimport InfoGeometry.Dynamics.UnruhKMS\nimport InfoGeometry.Meta.Architecture\n\nopen scoped InnerProductSpace\n\n/-!\n# InfoGeometry.Canonical.BulkBoundaryTomitaTransportBridge\n\nOperator-first bridge between the real Tomita modular transport lane and the\ndimension-agnostic bulk-boundary zero-mode owner lane.\n\nThis file does not claim a full holographic reconstruction theorem. It records\nthe honest transport statement currently supported by the repo:\n\n- a boundary-localized zero-mode owner on the doubled real carrier,\n- a real modular-log packet providing the transport flow,\n- an explicit realization of that flow by parity-even Bogoliubov transforms,\n- and the induced persistence of the zero mode under modular transport.\n-/\n\nnamespace InfoGeometry.Canonical.BulkBoundaryTomitaTransportBridge\n\nopen InfoGeometry.Krein\nopen InfoGeometry.Canonical.StandardFormCore\nopen InfoGeometry.Canonical.RealTomitaCore\nopen InfoGeometry.Canonical.BulkBoundaryZeroModeOwner\nopen InfoGeometry.Quantum.BulkBoundary\nopen InfoGeometry.Quantum.KitaevChain\nopen InfoGeometry.Quantum.RealMajorana\nopen InfoGeometry.Canonical.WedgeBoostModularBridge\n\nsection Core\n\nvariable {E : Type 0}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\n\n/--\nCanonical operator bridge joining:\n\n- a standard-form carrier,\n- a real modular-log transport packet,\n- a Majorana/chirality bulk-boundary owner,\n- and a Bogoliubov realization of the modular flow.\n-/\n@[rep_depth operator]\nstructure ModularBulkBoundaryBridge where\n  carrier : StandardFormCarrier E\n  logData : RealModularLogData (E := E)\n  delta_agrees : carrier.Delta = logData.Delta\n  majorana : RealMajoranaDatum (S := H₂)\n  localOp : KitaevCell → EndH\n  chain : List KitaevCell\n  owner :\n    DimensionAgnosticBoundaryZeroModeOwner\n      (S := H₂) majorana majorana.chiralityPolarization localOp chain\n  transport : ℝ → RealBogoliubovTransform (S := H₂) majorana\n  transport_eq_flow : ∀ t : ℝ, (transport t).B = logData.flow t\n  transport_eq_inverseFlow : ∀ t : ℝ, (transport t).Binv = logData.flow (-t)\n  transport_preserves_chirality :\n    ∀ t : ℝ, (transport t).preservesPolarization majorana.chiralityPolarization\n\nnamespace ModularBulkBoundaryBridge\n\nvariable (B : ModularBulkBoundaryBridge (E := E))\n\n/-- The standard-form carrier flow is generated by the same `Δ` as the real-log packet. -/\n@[rep_depth operator]\ntheorem carrier_modularFlow_eq_logData_generator :\n    B.carrier.seed.modularFlow\n      = InfoGeometry.Volume.ConnesCocycle.additiveModularFlowOfGenerator\n          (H := E) B.logData.Delta := by\n  simpa [B.delta_agrees] using B.carrier.modularFlow_eq_generator\n\n/-- The owned open-chain operator before modular transport. -/\n@[rep_depth operator]\nnoncomputable def ownedOperator : EndH :=\n  globalChainOperatorFromOpenChain (S := H₂) B.localOp B.chain\n\n/-- The modular/Bogoliubov transported open-chain operator. -/\n@[rep_depth operator]\nnoncomputable def transportedOperator (t : ℝ) : EndH :=\n  (B.transport t).B.comp (B.ownedOperator.comp (B.transport t).Binv)\n\n/-- The owner packet immediately yields the boundary-localized pair predicate. -/\n@[rep_depth krein]\ntheorem owner_boundaryPair :\n    BoundaryLocalizedZeroModePair\n      (M := B.majorana) (P0 := B.majorana.chiralityPolarization) B.localOp B.chain := by\n  refine ⟨B.owner.boundaryWitness.psiPlus, B.owner.boundaryWitness.psiMinus, ?_, ?_, ?_, ?_, ?_, ?_⟩\n  · exact B.owner.boundaryWitness.psiPlus_ne_zero\n  · exact B.owner.boundaryWitness.psiMinus_ne_zero\n  · exact B.owner.boundaryWitness.psiPlus_mem\n  · exact B.owner.boundaryWitness.psiMinus_mem\n  · exact B.owner.boundaryWitness.psiPlus_zeroMode\n  · exact B.owner.boundaryWitness.psiMinus_zeroMode\n\n/-- The untransported owner already certifies a genuine operator zero mode. -/\n@[rep_depth operator]\ntheorem owner_hasZeroMode :\n    HasZeroMode (S := H₂) B.ownedOperator := by\n  simpa [ModularBulkBoundaryBridge.ownedOperator] using\n    InfoGeometry.Canonical.BulkBoundaryZeroModeOwner.owner_hasZeroMode B.owner\n\n/-- The untransported owner already exports an explicit nonzero zero-mode vector. -/\n@[rep_depth operator]\ntheorem owner_exists_zeroMode :\n    ∃ v : H₂, B.ownedOperator v = 0 ∧ v ≠ 0 := by\n  simpa [ModularBulkBoundaryBridge.ownedOperator] using\n    InfoGeometry.Canonical.BulkBoundaryZeroModeOwner.owner_exists_zeroMode B.owner\n\n/-- Any Bogoliubov realization of the modular flow preserves the owned zero mode. -/\n@[rep_depth operator]\ntheorem transported_hasZeroMode (t : ℝ) :\n    HasZeroMode (S := H₂) (B.transportedOperator t) := by\n  exact hasZeroMode_conjugate_of_hasZeroMode\n    (M := B.majorana)\n    (T := B.transport t)\n    (H := B.ownedOperator)\n    B.owner_hasZeroMode\n\n/-- Explicit witness form of modularly transported zero-mode persistence. -/\n@[rep_depth operator]\ntheorem transported_exists_zeroMode (t : ℝ) :\n    ∃ v : H₂, (B.transportedOperator t) v = 0 ∧ v ≠ 0 := by\n  exact exists_zeroMode_of_hasZeroMode_conjugate\n    (M := B.majorana)\n    (T := B.transport t)\n    (H := B.ownedOperator)\n    B.owner_hasZeroMode\n\n/-- The transported operator is exactly the real modular flow conjugation of the owner. -/\n@[rep_depth operator]\ntheorem transportedOperator_eq_flow_conjugate (t : ℝ) :\n    B.transportedOperator t\n      = (B.logData.flow t).comp (B.ownedOperator.comp (B.logData.flow (-t))) := by\n  unfold transportedOperator\n  rw [B.transport_eq_flow t, B.transport_eq_inverseFlow t]\n\n/--\nIf the real modular transport generator commutes with the doubled Krein sign,\nthen the implemented transport commutes with that sign at every modular time.\n-/\n@[rep_depth transport]\ntheorem transport_commutes_modularSign_of_commute_generator\n    (hCommSign :\n      Commute\n        (InfoGeometry.Canonical.TomitaTakesaki.modularSignEpsilon (E := E))\n        (InfoGeometry.Canonical.BogoliubovTransport.modularTransportGenerator\n          (E := E) B.logData.deltaLog))\n    (t : ℝ) :\n    (InfoGeometry.Canonical.TomitaTakesaki.modularSignEpsilon (E := E)).comp\n        ((B.transport t).B)\n      =\n    ((B.transport t).B).comp\n        (InfoGeometry.Canonical.TomitaTakesaki.modularSignEpsilon (E := E)) := by\n  rw [B.transport_eq_flow t]\n  simpa [RealModularLogData.flow] using\n    InfoGeometry.Canonical.BogoliubovTransport.modularSignEpsilon_comp_modularTransportFlow_eq_modularTransportFlow_comp_modularSignEpsilon_of_commute_generator\n        (E := E) B.logData.deltaLog hCommSign t\n\n/--\nUnder explicit self-adjointness, phase-linearity, and sign-commutation\nhypotheses, the implemented modular transport preserves the doubled Krein inner\nproduct.\n-/\n@[rep_depth transport]\ntheorem transport_preserves_kreinInner_of_isSelfAdjoint_of_IsPhaseLinear_of_commute_modularSign\n    (hSelf : IsSelfAdjoint B.logData.deltaLog)\n    (hPhase :\n      InfoGeometry.Canonical.BogoliubovTransport.IsPhaseLinear\n        (E := E) B.logData.deltaLog)\n    (hCommSign :\n      Commute\n        (InfoGeometry.Canonical.TomitaTakesaki.modularSignEpsilon (E := E))\n        (InfoGeometry.Canonical.BogoliubovTransport.modularTransportGenerator\n          (E := E) B.logData.deltaLog))\n    (t : ℝ) (u v : H₂) :\n    KreinSpace.kreinInner (H := H₂) ((B.transport t).B u) ((B.transport t).B v)\n      =\n    KreinSpace.kreinInner (H := H₂) u v := by\n  rw [B.transport_eq_flow t]\n  simpa [RealModularLogData.flow] using\n    InfoGeometry.Canonical.BogoliubovTransport.modularTransportFlow_preserves_kreinInner_of_isSelfAdjoint_of_IsPhaseLinear_of_commute_modularSign\n        (E := E) B.logData.deltaLog hSelf hPhase hCommSign t u v\n\n/--\nWedge/boost reparameterization of the transported operator:\nevaluating at the modular time extracted from a wedge boost parameter is the\nsame operator conjugation, expressed in the wedge-normalized clock.\n-/\n@[rep_depth transport]\ntheorem transportedOperator_eq_wedgeBoost_conjugate (τwedge : ℝ) :\n    B.transportedOperator (modularTimeOfWedgeBoost τwedge)\n      =\n    (B.logData.flow (modularTimeOfWedgeBoost τwedge)).comp\n      (B.ownedOperator.comp (B.logData.flow (-modularTimeOfWedgeBoost τwedge))) := by\n  simpa using B.transportedOperator_eq_flow_conjugate (modularTimeOfWedgeBoost τwedge)\n\n/--\nThe wedge/boost normalization is exact on the transported operator surface.\n-/\n@[rep_depth transport]\ntheorem transportedOperator_wedge_roundtrip (τmod : ℝ) :\n    B.transportedOperator (modularTimeOfWedgeBoost (wedgeBoostParameter τmod))\n      = B.transportedOperator τmod := by\n  simp [modularTimeOfWedgeBoost_wedgeBoostParameter]\n\n/--\nRound-tripping through the wedge/boost clock leaves the conjugation formula\nunchanged.\n-/\n@[rep_depth transport]\ntheorem transportedOperator_eq_wedge_roundtrip_conjugate (τmod : ℝ) :\n    B.transportedOperator (modularTimeOfWedgeBoost (wedgeBoostParameter τmod))\n      =\n    (B.logData.flow τmod).comp (B.ownedOperator.comp (B.logData.flow (-τmod))) := by\n  simpa [modularTimeOfWedgeBoost_wedgeBoostParameter] using\n    B.transportedOperator_eq_wedgeBoost_conjugate (wedgeBoostParameter τmod)\n\n/--\nChirality-specialized transport theorem:\nthe modularly transported owner still has nonzero Weyl plus/minus zero modes.\n-/\n@[rep_depth krein]\ntheorem transported_weylZeroModePair (t : ℝ) :\n    ∃ ψplus ψminus : H₂,\n      ψplus ≠ 0 ∧ ψminus ≠ 0\n        ∧ ψplus ∈ B.majorana.weylPlus ∧ ψminus ∈ B.majorana.weylMinus\n        ∧ (B.transportedOperator t) ψplus = 0\n        ∧ (B.transportedOperator t) ψminus = 0 := by\n  simpa [ModularBulkBoundaryBridge.transportedOperator, ModularBulkBoundaryBridge.ownedOperator]\n    using\n      weylZeroModePair_under_bogoliubov_of_preservesChiralityPolarization\n        (M := B.majorana)\n        (T := B.transport t)\n        (hpres := B.transport_preserves_chirality t)\n        (localOp := B.localOp)\n        (chain := B.chain)\n        B.owner_boundaryPair\n\nend ModularBulkBoundaryBridge\n\nend Core\n\nend InfoGeometry.Canonical.BulkBoundaryTomitaTransportBridge\n","mtime":1777928003333}