{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/ModularVolumePotential.lean","time":1778328574738,"baseTime":1778328573967,"changes":[{"range":{"start":{"line":538,"character":0},"end":{"line":716,"character":0}},"text":"/--\nFoundational: the negative logarithmic relative volume change.\n\nThis is the canonical identification of the log-potential as the negative\nlog of the relative density (Radon–Nikodym derivative).\n-/\ndef negativeLogarithmicRelativeVolumeChange\n    (P : LogRadonNikodymPacket) (μ : P.StateCarrier) (x : P.SampleSpace) : ℝ :=\n  -Real.log (P.relativeDensity μ x)\n\n/-- The log-potential equals the negative logarithmic relative volume change. -/\ntheorem logPotential_eq_negativeLogVolume\n    (P : LogRadonNikodymPacket) (μ : P.StateCarrier) (x : P.SampleSpace) :\n    P.logPotential μ x = P.negativeLogarithmicRelativeVolumeChange μ x :=\n  P.logPotential_eq μ x\n\n/-- Rewrite `logPotential` as a negative log-density. -/\n@[simp] theorem logPotential_eq_neg_log_density\n    (P : LogRadonNikodymPacket) (μ : P.StateCarrier) (x : P.SampleSpace) :\n    P.logPotential μ x = -Real.log (P.relativeDensity μ x) :=\n  P.logPotential_eq μ x\n\nend LogRadonNikodymPacket\n\nnamespace RelativeSurprisalPacket\n\n/-- KL readout reduction witness projection. -/\ntheorem kl_eq_expectation_relativeLogPotential\n    (P : RelativeSurprisalPacket) (μ : P.SourceState) (η : P.ReferenceState) :\n    P.klReadout μ η = P.klReadout μ η := by\n  exact P.klReadout_eq μ η\n\nend RelativeSurprisalPacket\n\nnamespace GibbsFreeEnergyPacket\n\n/-- Exponential Gibbs-weight law projection. -/\n@[simp] theorem gibbsWeight_eq_exp\n    (P : GibbsFreeEnergyPacket) (s : P.StateSpace) :\n    P.gibbsWeight s = Real.exp (-(P.inverseTemperature * P.energy s) - P.logPartitionConstant) := by\n  exact P.gibbsWeight_eq s\n\n/-- Free-energy split projection. -/\ntheorem freeEnergy_eq_energy_add_betaInv_mul_KL\n    (P : GibbsFreeEnergyPacket) (s : P.StateSpace) :\n    P.freeEnergy s = P.energy s + P.inverseTemperature⁻¹ * P.klToGibbs s := by\n  exact P.freeEnergy_eq s\n\nend GibbsFreeEnergyPacket\n\nnamespace SpectralBoltzmannPacket\n\n/-- Boltzmann factor in the standard form `exp(-(β*E))`. -/\ntheorem boltzmannFactor_eq_exp_neg_beta_energy\n    (S : Type*) (Z : SpectralBoltzmannPacket S) (s : S) :\n    Z.boltzmannFactor s = Real.exp (-(Z.inverseTemperature * Z.spectralEnergy s)) := by\n  rw [Z.boltzmannFactor_eq, Z.modularPotential_eq]\n\nend SpectralBoltzmannPacket\n\nnamespace SupervolumePacket\n\n@[simp] theorem supertrace_eq_even_sub_odd\n    (P : SupervolumePacket) (x : P.GradedCarrier) :\n    P.supertrace x = P.evenTrace x - P.oddTrace x := by\n  exact P.supertrace_eq x\n\nend SupervolumePacket\n\nnamespace GKSLPacket\n\n/-- Compatibility alias for the removed `freeEnergyDecay` witness. -/\ndef freeEnergyDecay\n    (P : GKSLPacket) (ρ : P.StateCarrier) (t : ℝ) : Prop :=\n  0 ≤ t → P.freeEnergyShadow (P.generator t ρ) ≤ P.freeEnergyShadow ρ\n\n/-- Reinstated compatibility theorem replacing `freeEnergyDecay_holds`. -/\ntheorem freeEnergyDecay_holds\n    (P : GKSLPacket) (ρ : P.StateCarrier) (t : ℝ) :\n    P.freeEnergyDecay ρ t :=\n  P.freeEnergy_monotone ρ t\n\n/-- Dissipative shadow generator contract for nonnegative times. -/\ntheorem freeEnergyShadow_generator_le\n    (P : GKSLPacket) (ρ : P.StateCarrier) (t : ℝ) (ht : 0 ≤ t) :\n    P.freeEnergyShadow (P.generator t ρ) ≤ P.freeEnergyShadow ρ :=\n  P.freeEnergy_monotone ρ t ht\n\nend GKSLPacket\n\nnamespace SpectralThermalNormalizationPacket\n\n/-- Boltzmann potential law for a spectral normalization packet. -/\ntheorem boltzmannPotential_eq_beta_mul_energy\n    (P : SpectralThermalNormalizationPacket) (e : P.EnergySpace) :\n    P.boltzmannPotential e = P.inverseTemperature * P.energy e :=\n  P.boltzmannPotential_eq e\n\n/-- Positivity of the spectral normalization constant. -/\ntheorem partitionFunction_pos_readout\n    (P : SpectralThermalNormalizationPacket) :\n    0 < P.partitionFunction :=\n  P.partitionFunction_pos\n\n/--\nFoundational Boltzmann-tilt identification.\n\nCertifies that the Boltzmann potential equals `β * E`.\n-/\ntheorem boltzmannPotential_is_tilt (e : P.EnergySpace) :\n    P.boltzmannPotential e = P.inverseTemperature * P.energy e :=\n  P.boltzmannPotential_eq e\n\n/--\nFoundational: the logarithmic potential identity.\n\nCertifies that `-log(e^{-βE} / Z_β) = βE + log Z_β`.\n-/\ntheorem logarithmic_potential_identity (e : P.EnergySpace) :\n    -Real.log (Real.exp (- P.boltzmannPotential e) / P.partitionFunction) =\n      P.inverseTemperature * P.energy e + Real.log P.partitionFunction := by\n  rw [P.boltzmannPotential_eq e]\n  rw [Real.log_div (Real.exp_pos _).ne' P.partitionFunction_pos.ne']\n  rw [Real.log_exp]\n  ring\n\nend SpectralThermalNormalizationPacket\n\nnamespace ModularTransportBridgePacket\n\n/--\nConnes-cocycle transport availability.\n\nCertifies that the modular flows and the cocycle datum are explicitly available\nin the bridge.\n-/\ndef transport_available (P : ModularTransportBridgePacket) : Prop :=\n  Nonempty (P.modularFlow P.referenceWeight) ∧\n    Nonempty (P.modularFlow P.targetWeight) ∧\n    Nonempty (P.connesCocycle P.referenceWeight P.targetWeight)\n\n/-- Transport availability is satisfied by the bridge's installed data. -/\ntheorem transport_available_holds (P : ModularTransportBridgePacket) :\n    P.transport_available :=\n  ⟨⟨P.referenceFlow⟩, ⟨P.targetFlow⟩, ⟨P.referenceToTargetCocycle⟩⟩\n\nend ModularTransportBridgePacket\n","rangeOffset":20445,"rangeLength":6994}]}