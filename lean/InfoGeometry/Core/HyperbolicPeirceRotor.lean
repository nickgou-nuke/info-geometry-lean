import InfoGeometry.Core.PeirceRotor

/-!
# Hyperbolic Peirce squeeze rotors and moving idempotents

Parallel to the circular rotor `phaseRotor c s d b` (`c^2 + s^2 = 1`), the
hyperbolic squeeze rotor `hyperbolicRotor u v d b` (`u^2 - v^2 = 1`) is
generated by `transitionVelocity d b = d + b` (`Q_1^2 = +Delta`) and conjugates
`polePlus d b` into the hyperbolic moving idempotent `hyperbolicPolePlus u v d b`.
-/

namespace InfoGeometry.Core.HyperbolicPeirceRotor

open InfoGeometry.Core.DualSeedPeirce
open InfoGeometry.Core.PeirceRotor
open InfoGeometry.Singular.MoorePenrose
open InfoGeometry.Core.DiracSuperalgebra

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]
variable {d b : A}

/-- The hyperbolic squeeze rotor, equal to `P_0 + u • Delta + v • Q_1`. -/
def hyperbolicRotor (u v : R) (d b : A) : A := completedBlock d b u v v u

/-- Explicit formula on the harmonic complement, active carrier, and velocity. -/
theorem hyperbolicRotor_formula (u v : R) :
    hyperbolicRotor u v d b = zeroModeSupport d b +
      u • carrierSupport d b + v • transitionVelocity d b := by
  unfold hyperbolicRotor completedBlock peirceBlock carrierSupport activeSupport
    transitionVelocity majoranaPlus
  module

/-- Hyperbolic addition law before imposing the unit-hyperbola constraint. -/
theorem hyperbolicRotor_mul (h : IsDualSeedPair d b) (u v e f : R) :
    hyperbolicRotor u v d b * hyperbolicRotor e f d b =
      hyperbolicRotor (u * e + v * f) (u * f + v * e) d b := by
  unfold hyperbolicRotor
  rw [completedBlock_mul h]
  congr 1 <;> ring

/-- Identity squeeze rotor at `(u, v) = (1, 0)`. -/
theorem hyperbolicRotor_one_zero : hyperbolicRotor (1 : R) 0 d b = 1 := by
  simp only [hyperbolicRotor, completedBlock, peirceBlock, one_smul, zero_smul, add_zero]
  change (1 - polePlus d b - poleMinus d b) + (polePlus d b + poleMinus d b) = 1
  abel

/-- Two-sided inverse law on the scalar unit hyperbola `u^2 - v^2 = 1`. -/
theorem hyperbolicRotor_inverse (h : IsDualSeedPair d b) {u v : R}
    (huv : u * u - v * v = 1) :
    hyperbolicRotor u v d b * hyperbolicRotor u (-v) d b = 1 ∧
    hyperbolicRotor u (-v) d b * hyperbolicRotor u v d b = 1 := by
  have h₁ : u * u + v * (-v) = 1 := by linear_combination huv
  have h₂ : u * u + (-v) * v = 1 := by linear_combination huv
  constructor
  · rw [hyperbolicRotor_mul h, h₁, show u * (-v) + v * u = 0 by ring]
    exact hyperbolicRotor_one_zero
  · rw [hyperbolicRotor_mul h, h₂, show u * v + (-v) * u = 0 by ring]
    exact hyperbolicRotor_one_zero

/-- Native ambient unit on the unit hyperbola `u^2 - v^2 = 1`. -/
def hyperbolicRotorUnit (h : IsDualSeedPair d b) {u v : R}
    (huv : u * u - v * v = 1) : Aˣ where
  val := hyperbolicRotor u v d b
  inv := hyperbolicRotor u (-v) d b
  val_inv := (hyperbolicRotor_inverse h huv).1
  inv_val := (hyperbolicRotor_inverse h huv).2

/-- The hyperbolic moving positive pole `u^2 • P_+ - v^2 • P_- - (u * v) • J`. -/
def hyperbolicPolePlus (u v : R) (d b : A) : A :=
  peirceBlock d b (u * u) (-(u * v)) (u * v) (-(v * v))

/-- The complementary hyperbolic moving negative pole. -/
def hyperbolicPoleMinus (u v : R) (d b : A) : A :=
  peirceBlock d b (-(v * v)) (u * v) (-(u * v)) (u * u)

theorem hyperbolicPolePlus_formula (u v : R) :
    hyperbolicPolePlus u v d b = (u * u) • polePlus d b - (v * v) • poleMinus d b -
      (u * v) • wheelGenerator d b := by
  unfold hyperbolicPolePlus peirceBlock wheelGenerator majoranaMinus
  module

theorem hyperbolicPoleMinus_formula (u v : R) :
    hyperbolicPoleMinus u v d b = -(v * v) • polePlus d b + (u * u) • poleMinus d b +
      (u * v) • wheelGenerator d b := by
  unfold hyperbolicPoleMinus peirceBlock wheelGenerator majoranaMinus
  module

/-- Squeeze conjugation of `polePlus d b` yields `hyperbolicPolePlus u v d b`. -/
theorem hyperbolicRotor_conjugates_plus (h : IsDualSeedPair d b) (u v : R) :
    hyperbolicRotor u v d b * polePlus d b * hyperbolicRotor u (-v) d b =
      hyperbolicPolePlus u v d b := by
  have hp : polePlus d b = peirceBlock d b (1 : R) 0 0 0 := by simp [peirceBlock]
  rw [hp]
  unfold hyperbolicRotor completedBlock
  rw [add_mul, (harmonic_block h (1 : R) 0 0 0).1, zero_add, peirceBlock_mul h,
    mul_add, (harmonic_block h _ _ _ _).2, zero_add, peirceBlock_mul h]
  unfold hyperbolicPolePlus
  congr 1 <;> ring

/-- Squeeze conjugation of `poleMinus d b` yields `hyperbolicPoleMinus u v d b`. -/
theorem hyperbolicRotor_conjugates_minus (h : IsDualSeedPair d b) (u v : R) :
    hyperbolicRotor u v d b * poleMinus d b * hyperbolicRotor u (-v) d b =
      hyperbolicPoleMinus u v d b := by
  have hq : poleMinus d b = peirceBlock d b (0 : R) 0 0 1 := by simp [peirceBlock]
  rw [hq]
  unfold hyperbolicRotor completedBlock
  rw [add_mul, (harmonic_block h (0 : R) 0 0 1).1, zero_add, peirceBlock_mul h,
    mul_add, (harmonic_block h _ _ _ _).2, zero_add, peirceBlock_mul h]
  unfold hyperbolicPoleMinus
  congr 1 <;> ring

/-- Both idempotences and mutual orthogonality follow from hyperbolic conjugation. -/
theorem hyperbolic_projector_relations (h : IsDualSeedPair d b) {u v : R}
    (huv : u * u - v * v = 1) :
    IsIdempotentElem (hyperbolicPolePlus u v d b) ∧
    IsIdempotentElem (hyperbolicPoleMinus u v d b) ∧
    hyperbolicPolePlus u v d b * hyperbolicPoleMinus u v d b = 0 ∧
    hyperbolicPoleMinus u v d b * hyperbolicPolePlus u v d b = 0 := by
  have hi := (hyperbolicRotor_inverse h huv).2
  have transport (x y : A) :
      (hyperbolicRotor u v d b * x * hyperbolicRotor u (-v) d b) *
        (hyperbolicRotor u v d b * y * hyperbolicRotor u (-v) d b) =
      hyperbolicRotor u v d b * (x * y) * hyperbolicRotor u (-v) d b := by
    calc
      _ = hyperbolicRotor u v d b * x *
          (hyperbolicRotor u (-v) d b * hyperbolicRotor u v d b) * y *
          hyperbolicRotor u (-v) d b := by noncomm_ring
      _ = _ := by rw [hi]; simp only [mul_one, mul_assoc]
  change _ * _ = _ ∧ _ * _ = _ ∧ _ ∧ _
  rw [← hyperbolicRotor_conjugates_plus h, ← hyperbolicRotor_conjugates_minus h]
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [transport, h.pp]
  · rw [transport, h.qq]
  · rw [transport, h.pq, mul_zero, zero_mul]
  · rw [transport, h.qp, mul_zero, zero_mul]

/-- The hyperbolic moving poles partition the active carrier support. -/
theorem hyperbolic_poles_sum {u v : R} (huv : u * u - v * v = 1) :
    hyperbolicPolePlus u v d b + hyperbolicPoleMinus u v d b = carrierSupport d b := by
  rw [hyperbolicPolePlus_formula, hyperbolicPoleMinus_formula]
  calc
    _ = (u * u - v * v) • (polePlus d b + poleMinus d b) := by module
    _ = carrierSupport d b := by rw [huv, one_smul]; rfl

end InfoGeometry.Core.HyperbolicPeirceRotor
