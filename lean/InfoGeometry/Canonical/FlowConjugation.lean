import Mathlib.Algebra.Group.End
import Mathlib.GroupTheory.GroupAction.FixingSubgroup
import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Conjugation of flows and centralizers

A flow here is a native monoid homomorphism `T →* G`. Conjugating its values
uses `MulAut.conj`, and the resulting action is scoped to this namespace.
For real additive time, take `T = Multiplicative ℝ`.

The stabilizer of a flow is the centralizer of its image. The pointwise
fixing subgroup of a family is the centralizer of the subgroup generated by
all its images. `Subgroup.closure` is algebraic generation, not topological
closure. No differentiability, time continuity or classification of all
smooth flows is asserted here.
-/

namespace InfoGeometry.Canonical.FlowConjugation

variable {T G : Type*} [Group G]

section Monoid

variable [Monoid T]

/-- Conjugate every value of a native flow homomorphism. This instance is
available only after opening this namespace or its scope. -/
scoped instance conjugationAction : MulAction G (T →* G) where
  smul g Φ := (MulAut.conj g).toMonoidHom.comp Φ
  one_smul Φ := by
    apply MonoidHom.ext
    intro t
    change (1 : G) * Φ t * (1 : G)⁻¹ = Φ t
    simp
  mul_smul g h Φ := by
    apply MonoidHom.ext
    intro t
    change (g * h) * Φ t * (g * h)⁻¹ = g * (h * Φ t * h⁻¹) * g⁻¹
    simp [mul_assoc]

/-- Evaluation is the native inner automorphism on the target group. -/
@[simp] theorem conjugation_smul_apply (g : G) (Φ : T →* G) (t : T) :
    (g • Φ) t = g * Φ t * g⁻¹ := rfl

/-- A conjugation fixes the whole flow exactly when it commutes at every time. -/
theorem conjugation_eq_self_iff (g : G) (Φ : T →* G) :
    g • Φ = Φ ↔ ∀ t, g * Φ t = Φ t * g := by
  constructor
  · intro h t
    have ht := congrArg (fun Ψ : T →* G => Ψ t) h
    change g * Φ t * g⁻¹ = Φ t at ht
    exact mul_inv_eq_iff_eq_mul.mp ht
  · intro h
    apply MonoidHom.ext
    intro t
    change g * Φ t * g⁻¹ = Φ t
    exact mul_inv_eq_iff_eq_mul.mpr (h t)

/-- The actual action stabilizer equals the centralizer of the time-map image. -/
theorem stabilizer_eq_centralizer_range (Φ : T →* G) :
    MulAction.stabilizer G Φ = Subgroup.centralizer (Set.range Φ) := by
  ext g
  rw [MulAction.mem_stabilizer_iff, conjugation_eq_self_iff,
    Subgroup.mem_centralizer_iff]
  constructor
  · intro h y hy
    rcases hy with ⟨t, rfl⟩
    exact (h t).symm
  · intro h t
    exact (h (Φ t) ⟨t, rfl⟩).symm

/-- All time maps occurring in a specified family of flows. -/
def flowImages (F : Set (T →* G)) : Set G :=
  ⋃ Φ ∈ F, Set.range Φ

theorem mem_flowImages_iff (F : Set (T →* G)) (g : G) :
    g ∈ flowImages F ↔ ∃ Φ ∈ F, ∃ t, Φ t = g := by
  simp [flowImages]

/-- The native subgroup generated by all time maps in the family. -/
def generatedFlowSubgroup (F : Set (T →* G)) : Subgroup G :=
  Subgroup.closure (flowImages F)

/-- Every time map of every selected flow belongs to the generated subgroup. -/
theorem flow_value_mem_generatedFlowSubgroup (F : Set (T →* G))
    (Φ : T →* G) (hΦ : Φ ∈ F) (t : T) :
    Φ t ∈ generatedFlowSubgroup F :=
  Subgroup.subset_closure ((mem_flowImages_iff F (Φ t)).mpr ⟨Φ, hΦ, t, rfl⟩)

/-- Generation satisfies exactly the subgroup constraints imposed on every
time map. This exposes the universal property used by invariant carriers. -/
theorem generatedFlowSubgroup_le_iff (F : Set (T →* G)) (H : Subgroup G) :
    generatedFlowSubgroup F ≤ H ↔ ∀ Φ ∈ F, ∀ t, Φ t ∈ H := by
  constructor
  · intro h Φ hΦ t
    exact h (flow_value_mem_generatedFlowSubgroup F Φ hΦ t)
  · intro h
    apply (Subgroup.closure_le H).mpr
    intro g hg
    rcases (mem_flowImages_iff F g).mp hg with ⟨Φ, hΦ, t, rfl⟩
    exact h Φ hΦ t

/-- The pointwise family fixer centralizes exactly the union of all time-map images. -/
theorem fixingSubgroup_eq_centralizer_flowImages (F : Set (T →* G)) :
    fixingSubgroup G F = Subgroup.centralizer (flowImages F) := by
  ext g
  rw [mem_fixingSubgroup_iff, Subgroup.mem_centralizer_iff]
  constructor
  · intro h y hy
    rcases (mem_flowImages_iff F y).mp hy with ⟨Φ, hΦ, t, rfl⟩
    exact ((conjugation_eq_self_iff g Φ).mp (h Φ hΦ) t).symm
  · intro h Φ hΦ
    apply (conjugation_eq_self_iff g Φ).mpr
    intro t
    exact (h (Φ t) ((mem_flowImages_iff F (Φ t)).mpr ⟨Φ, hΦ, t, rfl⟩)).symm

/-- Algebraic generation does not change the centralizer of the time maps. -/
theorem centralizer_generatedFlowSubgroup (F : Set (T →* G)) :
    Subgroup.centralizer (generatedFlowSubgroup F : Set G) =
      Subgroup.centralizer (flowImages F) :=
  Subgroup.centralizer_closure (flowImages F)

/-- Fixing each chosen flow pointwise is equivalent to centralizing the whole
subgroup generated by their time maps. This is not a setwise family stabilizer. -/
theorem fixingSubgroup_eq_centralizer_generatedFlowSubgroup (F : Set (T →* G)) :
    fixingSubgroup G F = Subgroup.centralizer (generatedFlowSubgroup F : Set G) := by
  rw [centralizer_generatedFlowSubgroup, fixingSubgroup_eq_centralizer_flowImages]

end Monoid

section CommMonoid

variable [CommMonoid T]

/-- Every time map of a flow with commutative time fixes that same flow by
conjugation, without requiring that the ambient group be commutative. -/
theorem flow_value_mem_stabilizer (Φ : T →* G) (t : T) :
    Φ t ∈ MulAction.stabilizer G Φ := by
  rw [MulAction.mem_stabilizer_iff, conjugation_eq_self_iff]
  intro r
  rw [← map_mul, ← map_mul, mul_comm]

/-- The image of a commutative-time flow centralizes itself. -/
theorem flow_value_mem_centralizer_range (Φ : T →* G) (t : T) :
    Φ t ∈ Subgroup.centralizer (Set.range Φ) := by
  rw [← stabilizer_eq_centralizer_range]
  exact flow_value_mem_stabilizer Φ t

end CommMonoid

end InfoGeometry.Canonical.FlowConjugation
