/-- Native Mathlib proposition attached to each `TwistorAmplituhedronArchetypeStage`. -/
def twistorAmplituhedronClaim : TwistorAmplituhedronArchetypeStage → Prop
  | .TA1_NonCommutativeMat4PluckerHodgeAndNambuKleinAnomaly =>
      ∀ (u v : InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3 (Matrix (Fin 2) (Fin 2) ℤ)),
        (-(pluckerMat4 u v * pluckerHodge4 u v)).m00 =
          InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3.dot u v ∧
        InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3.dot u
          (InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3.cross u u) =
          InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3.nambu3 u ∧
        InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.ZornMatrix.associator
          (InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.ZornMatrix.zornConePlus u)
          (InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.ZornMatrix.zornConePlus u)
          (InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.ZornMatrix.zornConePlus u) =
          ⟨-InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3.nambu3 u, 0, 0,
            InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3.nambu3 u⟩
  | .TA2_KleinQuadricAndZornNilpotencyOfTwistorLines =>
      ∀ (u v : InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3 ℝ) (ZA ZB : Twistor4 ℝ),
        -(pluckerMat4 u v * pluckerHodge4 u v) =
          Mat4.smul (InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3.dot u v) (1 : Mat4 ℝ) ∧
        InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3.dot
          (Twistor4.pluckerU ZA ZB) (Twistor4.pluckerV ZA ZB) = 0 ∧
        zornPlucker ZA ZB * zornPlucker ZA ZB = 0
  | .TA3_AmplituhedronFourBracketAndZornBaryonBoundary =>
      ∀ (Z0 Z1 Z2 Z3 : Twistor4 ℝ) (u0 u1 u2 u3 : InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3 ℝ),
        zornPlucker Z0 Z1 * zornPlucker Z2 Z3 + zornPlucker Z2 Z3 * zornPlucker Z0 Z1 =
          InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.ZornMatrix.smul
            (twistorBracket4 Z0 Z1 Z2 Z3)
            (1 : InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.ZornMatrix ℝ) ∧
        twistorBracket4 (Twistor4.affineTwistor u0) (Twistor4.affineTwistor u1)
          (Twistor4.affineTwistor u2) (Twistor4.affineTwistor u3) =
          InfoGeometry.Archetypes.TwistorAmplituhedronZornBaryon.Vec3.baryonDet3 (u1 - u0) (u2 - u0) (u3 - u0)

