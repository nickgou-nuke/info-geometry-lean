import InfoGeometry.Lie.SplitOctonionPeirceFermionParityBridge
import InfoGeometry.Core.TripotentEigenspaces

/-!
# Native Zorn left/right tripotent and its full operator-algebra five-grading

The normalized difference of regular left and right multiplication on the
canonical split-octonion carrier is an actual tripotent in its full real
endomorphism algebra.  This file specializes the existing tripotent
decomposition and adjoint-eigenspace theorems to that operator.  It does not
identify the Lie algebra generated by left multiplications with the full
endomorphism algebra; that is a different subalgebra statement.
-/

namespace InfoGeometry.Lie.SplitOctonionFiveGradeOperatorBridge

open InfoGeometry.Lie.SplitOctonionPeirceFermionParityBridge
open InfoGeometry.Physics.Algebra

attribute [local instance 100] LieRing.ofAssociativeRing

/-- Multiplicative-cube form `t * t * t = t` of `peirceDefect_tripotent`. -/
theorem peirceDefect_mul_cube :
    peirceDefectOperator * peirceDefectOperator * peirceDefectOperator =
      peirceDefectOperator := by
  calc
    peirceDefectOperator * peirceDefectOperator * peirceDefectOperator =
      peirceDefectOperator ^ 3 := by noncomm_ring
    _ = peirceDefectOperator := peirceDefect_tripotent

/-- The full Zorn operator algebra is linearly equivalent to the product of
the five actual projector ranges for the canonical left/right tripotent. -/
noncomputable def zornFiveGradeEquiv :
    CarrierEnd ≃ₗ[ℝ] FiveGradeCoordinates peirceDefectOperator :=
  tripotentFiveGradeLinearEquiv peirceDefectOperator peirceDefect_mul_cube

/-- The five projector components reconstruct every endomorphism on the
canonical Zorn carrier. -/
theorem zornFiveGrade_recompose_decompose (T : CarrierEnd) :
    fiveGradeRecomposeLinear peirceDefectOperator
      (fiveGradeDecomposeLinear peirceDefectOperator T) = T :=
  fiveGrade_recompose_decompose peirceDefectOperator T

/-- Each Zorn five-grade projector range is exactly the corresponding native
eigenspace of the inner derivation generated by the left/right tripotent. -/
theorem zornFiveGradeRange_eq_adjointEigenspace (k : FiveGrade) :
    fiveGradeRange peirceDefectOperator k =
      (LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator).eigenspace
        (fiveGradeValue k : ℝ) :=
  InfoGeometry.Core.TripotentAdjoint.fiveGradeRange_eq_eigenspace
    peirceDefect_mul_cube k

/-- Multiplication of Zorn operator five-grade components adds grades:
`E_i · E_j ⊆ E_{i+j}`. -/
theorem zornFiveGrade_mul_mem {x y : CarrierEnd} {i j k : FiveGrade}
    (hk : fiveGradeValue i + fiveGradeValue j = fiveGradeValue k)
    (hx : x ∈ fiveGradeRange peirceDefectOperator i)
    (hy : y ∈ fiveGradeRange peirceDefectOperator j) :
    x * y ∈ fiveGradeRange peirceDefectOperator k :=
  InfoGeometry.Core.TripotentAdjoint.mul_mem_fiveGradeRange
    peirceDefect_mul_cube hk hx hy

/-- Commutator Lie bracket of Zorn operator five-grade components adds grades:
`[E_i, E_j] ⊆ E_{i+j}`. -/
theorem zornFiveGrade_lie_mem {x y : CarrierEnd} {i j k : FiveGrade}
    (hk : fiveGradeValue i + fiveGradeValue j = fiveGradeValue k)
    (hx : x ∈ fiveGradeRange peirceDefectOperator i)
    (hy : y ∈ fiveGradeRange peirceDefectOperator j) :
    ⁅x, y⁆ ∈ fiveGradeRange peirceDefectOperator k :=
  InfoGeometry.Core.TripotentAdjoint.lie_mem_fiveGradeRange
    peirceDefect_mul_cube hk hx hy

/-- Products of Zorn endomorphisms vanish when the sum of their adjoint weights
lies outside `{-2, -1, 0, 1, 2}`. -/
theorem zornFiveGrade_mul_eq_zero_of_weight_not_mem
    {x y : CarrierEnd} {r s : ℝ}
    (hx : x ∈ (LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator).eigenspace r)
    (hy : y ∈ (LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator).eigenspace s)
    (hrs : r + s ∉ Set.range (fun k : FiveGrade => (fiveGradeValue k : ℝ))) :
    x * y = 0 :=
  InfoGeometry.Core.TripotentAdjoint.mul_eq_zero_of_weight_not_mem
    peirceDefect_mul_cube hx hy hrs

/-- Commutator brackets of Zorn endomorphisms vanish when the sum of their
adjoint weights lies outside `{-2, -1, 0, 1, 2}`. -/
theorem zornFiveGrade_lie_eq_zero_of_weight_not_mem
    {x y : CarrierEnd} {r s : ℝ}
    (hx : x ∈ (LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator).eigenspace r)
    (hy : y ∈ (LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator).eigenspace s)
    (hrs : r + s ∉ Set.range (fun k : FiveGrade => (fiveGradeValue k : ℝ))) :
    ⁅x, y⁆ = 0 :=
  InfoGeometry.Core.TripotentAdjoint.lie_eq_zero_of_weight_not_mem
    peirceDefect_mul_cube hx hy hrs

/-- The inner derivation on the complete Zorn endomorphism algebra obeys its
five-weight annihilating polynomial. -/
theorem zornPeirceDefect_ad_quintic :
    LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator ^ 5 -
      (5 : ℝ) • LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator ^ 3 +
      (4 : ℝ) • LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator = 0 :=
  InfoGeometry.Core.TripotentAdjoint.ad_quintic peirceDefect_mul_cube

/-- The grade projectors commute with the native adjoint action on all
endomorphisms of the Zorn carrier. -/
theorem zornFiveGradeProjector_commutes_with_ad (k : FiveGrade) :
    Commute (fiveGradeProjector peirceDefectOperator k)
      (LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator) :=
  InfoGeometry.Core.TripotentAdjoint.fiveGradeProjector_commute_ad
    peirceDefect_mul_cube k

/-- **Master Zorn Tripotent 5-Grade Operator Synthesis**:
On the full endomorphism algebra `E = Module.End ℝ Carrier` of the canonical
real Zorn algebra:
1. `peirceDefectOperator` equals `(1 / 2) • (L_ℓ - R_ℓ)` and satisfies `t³ = t`;
2. `peirceFermionNumber = t²` is idempotent and `peirceWittenParity = 1 - 2 t²`
   is an involution;
3. Every `T : E` is reconstructed from its five projector components
   `fiveGradeDecomposeLinear peirceDefectOperator T`;
4. Each projector range `fiveGradeRange peirceDefectOperator k` coincides with
   the native adjoint eigenspace `(ad_t).eigenspace (fiveGradeValue k)`;
5. The adjoint action satisfies `(ad_t)⁵ - 5 (ad_t)³ + 4 ad_t = 0` on `E`. -/
theorem zorn_tripotent_five_grade_operator_synthesis
    (T : CarrierEnd) (k : FiveGrade) :
    peirceDefectOperator =
      (1 / 2 : ℝ) •
        (InfoGeometry.Lie.SplitOctonionEllCircularPeirceBasis.leftMultiplication
          InfoGeometry.Algebra.Zorn.SplitQuaternionCore.lUnit -
         InfoGeometry.Lie.SplitOctonionEllCircularPeirceBasis.rightMultiplication
          InfoGeometry.Algebra.Zorn.SplitQuaternionCore.lUnit) ∧
    peirceDefectOperator * peirceDefectOperator * peirceDefectOperator =
      peirceDefectOperator ∧
    peirceFermionNumber * peirceFermionNumber = peirceFermionNumber ∧
    peirceWittenParity * peirceWittenParity = (1 : CarrierEnd) ∧
    fiveGradeRecomposeLinear peirceDefectOperator
      (fiveGradeDecomposeLinear peirceDefectOperator T) = T ∧
    fiveGradeRange peirceDefectOperator k =
      (LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator).eigenspace
        (fiveGradeValue k : ℝ) ∧
    LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator ^ 5 -
      (5 : ℝ) • LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator ^ 3 +
      (4 : ℝ) • LieAlgebra.ad ℝ CarrierEnd peirceDefectOperator = 0 :=
  ⟨peirceDefectOperator_eq_normalized_left_sub_right,
   peirceDefect_mul_cube,
   peirceFermionNumber_idempotent,
   peirceWittenParity_sq,
   zornFiveGrade_recompose_decompose T,
   zornFiveGradeRange_eq_adjointEigenspace k,
   zornPeirceDefect_ad_quintic⟩

end InfoGeometry.Lie.SplitOctonionFiveGradeOperatorBridge
