import InfoGeometry.Convex.Bregman

/-!
# Log Potential

Minimal abstraction for log-partition style potentials.
-/

namespace InfoGeometry

/-- A log-partition style potential on parameter space `θ`. -/
structure LogPotential (θ : Type _) where
  ψ : θ → ℝ

namespace LogPotential

/-- Canonical Bregman divergence generated by a 1D log potential. -/
noncomputable def bregman (L : LogPotential ℝ) (η θ₀ : ℝ) : ℝ :=
  bregmanDiv L.ψ η θ₀

@[simp]
lemma bregman_def (L : LogPotential ℝ) (η θ₀ : ℝ) :
    L.bregman η θ₀ = bregmanDiv L.ψ η θ₀ := rfl

end LogPotential

end InfoGeometry
