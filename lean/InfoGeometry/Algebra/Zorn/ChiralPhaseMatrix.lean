import Mathlib

namespace InfoGeometry.Algebra.Zorn

/-!
# Chiral Phase Matrix Identity and Cyclotomic Polynomial Bounds

This module formalizes the exact polynomial matrix identity $U^6 = -I$ and $U^{12} = I$
for a matrix operator constructed from an abstract algebraic bivector $B^2 = -I$ and scalar root $s^2 = 3$
with explicit half-witness $2 \cdot \text{half} = 1$.

Boundaries & Epistemic Separation:
- This is a purely polynomial matrix identity in the commutative subalgebra generated by $I$ and $B$.
- It does NOT assume split-octonion or Clifford algebra identification without explicit morphisms.
- It does NOT assert that the permutation root action has $C^6 = -I$ (permutation action alone gives $C^6 = I$).
- Explicit phase grading tables for $B_s, B_\ell$ remain separate and strictly typed.
-/

variable {R : Type*} [CommRing R]

abbrev RootCarrier := Fin 8
abbrev RootOperator (R : Type*) [CommRing R] := Matrix RootCarrier RootCarrier R

/-- An algebraic bivector on the 8D carrier with $B^2 = -I$. -/
structure ChiralBivector (R : Type*) [CommRing R] where
  B : RootOperator R
  B_sq : B * B = -(1 : RootOperator R)

/-- The algebraic phase operator $U = \text{half} \cdot (s \cdot 1 + B)$. -/
def phaseMatrix (B_op : ChiralBivector R) (s half : R) : RootOperator R :=
  half • (s • (1 : RootOperator R) + B_op.B)

theorem bivector_shift_matrix_sq (B_op : ChiralBivector R) (s : R) (hs : s ^ 2 = 3) :
    (s • (1 : RootOperator R) + B_op.B) ^ 2 = (2 : R) • (1 : RootOperator R) + (2 * s) • B_op.B := by
  have h_sq : (s • (1 : RootOperator R) + B_op.B) ^ 2 =
      (s • 1 + B_op.B) * (s • 1 + B_op.B) := by rw [sq]
  rw [h_sq, add_mul, mul_add, mul_add]
  simp only [smul_mul_assoc, mul_smul_comm, one_mul, mul_one, smul_smul, B_op.B_sq]
  have hs2 : (s * s) • (1 : RootOperator R) = (3 : R) • 1 := by
    rw [← sq, hs]
  have h_two_s : (2 * s) • B_op.B = s • B_op.B + s • B_op.B := by
    calc
      (2 * s) • B_op.B = (s + s) • B_op.B := by ring_nf
      _ = s • B_op.B + s • B_op.B := by rw [add_smul]
  have h_three_one : (3 : R) • (1 : RootOperator R) + -1 = (2 : R) • 1 := by
    calc
      (3 : R) • 1 + -(1 : RootOperator R) = (3 : R) • 1 - (1 : R) • 1 := by rw [one_smul, sub_eq_add_neg]
      _ = (3 - 1 : R) • 1 := by rw [sub_smul]
      _ = (2 : R) • 1 := by ring_nf
  calc
    (s * s) • (1 : RootOperator R) + s • B_op.B + (s • B_op.B + -1) =
        ((s * s) • (1 : RootOperator R) + -1) + (s • B_op.B + s • B_op.B) := by module
    _ = ((3 : R) • 1 + -1) + (s • B_op.B + s • B_op.B) := by rw [hs2]
    _ = (2 : R) • 1 + (2 * s) • B_op.B := by rw [h_three_one, ← h_two_s]

theorem bivector_shift_matrix_cube (B_op : ChiralBivector R) (s : R) (hs : s ^ 2 = 3) :
    (s • (1 : RootOperator R) + B_op.B) ^ 3 = (8 : R) • B_op.B := by
  have h3 : (s • (1 : RootOperator R) + B_op.B) ^ 3 =
      (s • 1 + B_op.B) * (s • 1 + B_op.B) ^ 2 := by
    calc
      (s • (1 : RootOperator R) + B_op.B) ^ 3 = (s • 1 + B_op.B) ^ (1 + 2) := rfl
      _ = (s • 1 + B_op.B) ^ 1 * (s • 1 + B_op.B) ^ 2 := by rw [pow_add]
      _ = _ := by rw [pow_one]
  rw [h3, bivector_shift_matrix_sq B_op s hs]
  rw [mul_add, add_mul, add_mul]
  simp only [smul_mul_assoc, mul_smul_comm, one_mul, mul_one, smul_smul, B_op.B_sq]
  have hs2 : (2 * s * s) • B_op.B = (6 : R) • B_op.B := by
    calc
      (2 * s * s) • B_op.B = (2 * (s * s)) • B_op.B := by ring_nf
      _ = (2 * (s ^ 2)) • B_op.B := by rw [sq]
      _ = (2 * 3 : R) • B_op.B := by rw [hs]
      _ = (6 : R) • B_op.B := by ring_nf
  calc
    (2 * s) • (1 : RootOperator R) + (2 : R) • B_op.B + ((2 * s * s) • B_op.B + (2 * s) • -1) =
        ((2 * s) • 1 + (2 * s) • -1) + ((2 : R) • B_op.B + (2 * s * s) • B_op.B) := by module
    _ = 0 + ((2 : R) • B_op.B + (6 : R) • B_op.B) := by
      rw [smul_neg, add_neg_cancel, hs2]
    _ = (8 : R) • B_op.B := by
      have h8 : (2 : R) • B_op.B + (6 : R) • B_op.B = (8 : R) • B_op.B := by
        calc
          (2 : R) • B_op.B + (6 : R) • B_op.B = (2 + 6 : R) • B_op.B := by rw [add_smul]
          _ = (8 : R) • B_op.B := by ring_nf
      rw [zero_add, h8]

/-- 🏆 THEOREM 1: The polynomial matrix defect $U^6 = -I$. -/
theorem phaseMatrix_pow_six
    (B_op : ChiralBivector R) (s half : R)
    (hhalf : (2 : R) * half = 1)
    (hs : s ^ 2 = 3) :
    phaseMatrix B_op s half ^ 6 = -(1 : RootOperator R) := by
  dsimp [phaseMatrix]
  have h6 : (half • (s • (1 : RootOperator R) + B_op.B)) ^ 6 =
      (half ^ 6) • ((s • 1 + B_op.B) ^ 6) := by
    rw [smul_pow]
  have hT6 : (s • (1 : RootOperator R) + B_op.B) ^ 6 = -(64 : R) • (1 : RootOperator R) := by
    have h_pow6 : (s • (1 : RootOperator R) + B_op.B) ^ 6 =
        ((s • 1 + B_op.B) ^ 3) ^ 2 := by
      have h_mul : (3 : ℕ) * 2 = 6 := rfl
      rw [← pow_mul, h_mul]
    rw [h_pow6, bivector_shift_matrix_cube B_op s hs, sq, smul_mul_smul, B_op.B_sq]
    calc
      (8 * 8 : R) • -(1 : RootOperator R) = (64 : R) • -(1 : RootOperator R) := by ring_nf
      _ = -(64 : R) • 1 := by rw [smul_neg, neg_smul]
  rw [h6, hT6, smul_smul, mul_neg, neg_smul]
  have h_coeff : half ^ 6 * (64 : R) = 1 := by
    calc
      half ^ 6 * (64 : R) = (half * 2) ^ 6 := by ring
      _ = (2 * half) ^ 6 := by rw [mul_comm]
      _ = 1 ^ 6 := by rw [hhalf]
      _ = 1 := by ring
  rw [h_coeff, one_smul]

/-- 🏆 THEOREM 2: The cyclotomic closure $U^{12} = I$. -/
theorem phaseMatrix_pow_twelve {U : RootOperator R}
    (h : U ^ 6 = -(1 : RootOperator R)) :
    U ^ 12 = 1 := by
  have h12 : U ^ 12 = (U ^ 6) ^ 2 := by
    have h_mul : (6 : ℕ) * 2 = 12 := rfl
    rw [← pow_mul, h_mul]
  rw [h12, h]
  have h_neg_sq : (-(1 : RootOperator R)) ^ 2 = 1 := by
    rw [sq, neg_mul_neg, mul_one]
  exact h_neg_sq

end InfoGeometry.Algebra.Zorn
