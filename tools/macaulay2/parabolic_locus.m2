-- tools/macaulay2/parabolic_locus.m2
-- Define the parabolic matrix H(beta; gamma) acting on the projective line over a generic field
-- Compute the fixed point locus geometrically by intersecting the graph with the diagonal
-- Verify using degrees/multiplicities that it has a double root at gamma (multiplicity 2)

K = frac(QQ[beta, gamma])

-- Affine coordinates: x = X0/X1, y = Y0/Y1
A = K[x, y]

-- Entries of H(beta; gamma)
-- Determinant is 1, Trace is 2, Fixed point is gamma
H00 = 1 - beta*gamma
H01 = beta*gamma^2
H10 = -beta
H11 = 1 + beta*gamma

-- The action on P1 is given by z |-> (H00*z + H01) / (H10*z + H11)
-- In affine coordinates (x, y) on P1 x P1, the graph Gamma_H is defined by:
-- y = (H00*x + H01) / (H10*x + H11)
-- which gives the equation: y * (H10*x + H11) - (H00*x + H01) = 0
GraphEq = y * (H10*x + H11) - (H00*x + H01)
GammaH = ideal(GraphEq)

-- The diagonal Delta is defined by y = x
Delta = ideal(y - x)

-- The fixed point locus is the intersection of the graph and the diagonal
FixedLocus = GammaH + Delta

-- Calculate the multiplicity (degree) of the fixed point locus
mult = degree(FixedLocus)

-- Verify that the intersection multiplicity is 2
assert(mult == 2)
print("Intersection multiplicity: " | toString(mult))

-- Verify the ideal is generated by (x-gamma)^2 and y-x
ExpectedIdeal = ideal((x - gamma)^2, y - x)

assert(FixedLocus == ExpectedIdeal)
print("The fixed locus ideal matches the expected ideal with a double root at gamma.")

print("All verifications passed!")
