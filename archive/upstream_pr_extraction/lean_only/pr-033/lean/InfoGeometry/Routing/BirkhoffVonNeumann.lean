import Mathlib.Analysis.Convex.Birkhoff

/-!
# Birkhoff-von Neumann routing

This file is now a thin, honest bridge to the canonical mathlib statements
about doubly stochastic matrices and their permutation decompositions.
It does not restate unproved convergence claims.
-/

noncomputable section

namespace BirkhoffRouting

open Matrix
open scoped Matrix.Norms.L2Operator

/-- A matrix is doubly stochastic if all entries are nonnegative and each row and column sums to 1. -/
def IsDoublyStochastic {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : Prop :=
  (∀ i j, 0 ≤ A i j) ∧
  (∀ i, ∑ j, A i j = 1) ∧
  (∀ j, ∑ i, A i j = 1)

/-- The Birkhoff polytope: the set of doubly stochastic matrices. -/
def BirkhoffPolytope (n : ℕ) : Set (Matrix (Fin n) (Fin n) ℝ) :=
  {A | IsDoublyStochastic A}

/-- A matrix is a permutation matrix if it is the matrix of a permutation. -/
def IsPermutationMatrix {n : ℕ} (P : Matrix (Fin n) (Fin n) ℝ) : Prop :=
  ∃ σ : Equiv.Perm (Fin n), P = σ.permMatrix ℝ

theorem perm_matrix_is_doubly_stochastic {n : ℕ} {P : Matrix (Fin n) (Fin n) ℝ} :
    IsPermutationMatrix P → IsDoublyStochastic P := by
  rintro ⟨σ, rfl⟩
  simpa [IsDoublyStochastic, mem_doublyStochastic_iff_sum] using
    (permMatrix_mem_doublyStochastic (R := ℝ) (n := Fin n) (σ := σ))

theorem birkhoff_polytope_convex {n : ℕ} :
    Convex ℝ (BirkhoffPolytope n) := by
  intro A hA B hB a b ha hb hab
  have hA' : A ∈ doublyStochastic ℝ (Fin n) := by
    simpa [BirkhoffPolytope, IsDoublyStochastic, mem_doublyStochastic_iff_sum] using hA
  have hB' : B ∈ doublyStochastic ℝ (Fin n) := by
    simpa [BirkhoffPolytope, IsDoublyStochastic, mem_doublyStochastic_iff_sum] using hB
  have hC' :
      a • A + b • B ∈ doublyStochastic ℝ (Fin n) := by
    exact convex_doublyStochastic (R := ℝ) (n := Fin n) hA' hB' ha hb hab
  simpa [BirkhoffPolytope, IsDoublyStochastic, mem_doublyStochastic_iff_sum] using hC'

/-!
## Birkhoff-von Neumann decomposition
-/

/-- The positive cone generated by permutation matrices. -/
def permMatrixCone {n : ℕ} : Set (Matrix (Fin n) (Fin n) ℝ) :=
  {M | ∃ w : Equiv.Perm (Fin n) → ℝ,
      (∀ σ, 0 ≤ w σ) ∧
      ∑ σ, w σ • σ.permMatrix ℝ = M}

@[simp] theorem mem_permMatrixCone_iff {n : ℕ}
    (M : Matrix (Fin n) (Fin n) ℝ) :
    M ∈ permMatrixCone (n := n) ↔
      ∃ w : Equiv.Perm (Fin n) → ℝ,
        (∀ σ, 0 ≤ w σ) ∧
        ∑ σ, w σ • σ.permMatrix ℝ = M := by
  rfl

/-- Every permutation matrix lies in the generated positive cone. -/
theorem permMatrix_mem_permMatrixCone {n : ℕ}
    (σ : Equiv.Perm (Fin n)) :
    σ.permMatrix ℝ ∈ permMatrixCone (n := n) := by
  have hσ : σ.permMatrix ℝ ∈ doublyStochastic ℝ (Fin n) :=
    permMatrix_mem_doublyStochastic (R := ℝ) (n := Fin n) (σ := σ)
  rcases exists_eq_sum_perm_of_mem_doublyStochastic (M := σ.permMatrix ℝ) hσ with
    ⟨w, hw_nonneg, _hw_sum, hw_matrix⟩
  exact ⟨w, hw_nonneg, hw_matrix⟩

/-- Every doubly stochastic matrix lies in the generated positive cone. -/
theorem doublyStochastic_mem_permMatrixCone {n : ℕ}
    (M : Matrix (Fin n) (Fin n) ℝ)
    (hM : M ∈ doublyStochastic ℝ (Fin n)) :
    M ∈ permMatrixCone (n := n) := by
  rcases exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM with
    ⟨w, hw_nonneg, _hw_sum, hw_matrix⟩
  exact ⟨w, hw_nonneg, hw_matrix⟩

/-- Birkhoff-von Neumann decomposition in direct theorem form. -/
theorem birkhoff_von_neumann_decomposition {n : ℕ} (W : Matrix (Fin n) (Fin n) ℝ) :
    IsDoublyStochastic W →
    ∃ w : Equiv.Perm (Fin n) → ℝ,
      (∀ σ, 0 ≤ w σ) ∧
      ∑ σ, w σ = 1 ∧
      ∑ σ, w σ • σ.permMatrix ℝ = W := by
  intro hW
  have hWM : W ∈ doublyStochastic ℝ (Fin n) := by
    simpa [IsDoublyStochastic, mem_doublyStochastic_iff_sum] using hW
  simpa using (exists_eq_sum_perm_of_mem_doublyStochastic (M := W) hWM)

/-!
## Sinkhorn normalization

The file only records the elementary one-step normalization facts that are
actually proved here; convergence is delegated to the broader literature.
-/

def sinkhorn_step_row {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => A i j / (∑ k, A i k)

def sinkhorn_step_col {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => A i j / (∑ k, A k j)

theorem sinkhorn_step_row_nonneg {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
    (hA : ∀ i j, 0 ≤ A i j) (hrow : ∀ i, 0 < ∑ k, A i k) :
    ∀ i j, 0 ≤ sinkhorn_step_row A i j := by
  intro i j
  unfold sinkhorn_step_row
  exact div_nonneg (hA i j) (le_of_lt (hrow i))

theorem sinkhorn_step_col_nonneg {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
    (hA : ∀ i j, 0 ≤ A i j) (hcol : ∀ j, 0 < ∑ k, A k j) :
    ∀ i j, 0 ≤ sinkhorn_step_col A i j := by
  intro i j
  unfold sinkhorn_step_col
  exact div_nonneg (hA i j) (le_of_lt (hcol j))

theorem sinkhorn_step_row_sum_one {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
    (hrow : ∀ i, 0 < ∑ k, A i k) (i : Fin n) :
    ∑ j, sinkhorn_step_row A i j = 1 := by
  unfold sinkhorn_step_row
  have hne : (∑ k : Fin n, A i k) ≠ 0 := (hrow i).ne'
  calc
    ∑ j : Fin n, A i j / ∑ k : Fin n, A i k
        = (∑ j : Fin n, A i j) / ∑ k : Fin n, A i k := by
            symm
            simpa using
              (Finset.sum_div
                (s := (Finset.univ : Finset (Fin n)))
                (f := fun j : Fin n => A i j)
                (a := ∑ k : Fin n, A i k))
    _ = 1 := by
      rw [div_self hne]

theorem sinkhorn_step_col_sum_one {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
    (hcol : ∀ j, 0 < ∑ k, A k j) (j : Fin n) :
    ∑ i, sinkhorn_step_col A i j = 1 := by
  unfold sinkhorn_step_col
  have hne : (∑ k : Fin n, A k j) ≠ 0 := (hcol j).ne'
  calc
    ∑ i : Fin n, A i j / ∑ k : Fin n, A k j
        = (∑ i : Fin n, A i j) / ∑ k : Fin n, A k j := by
            symm
            simpa using
              (Finset.sum_div
                (s := (Finset.univ : Finset (Fin n)))
                (f := fun i : Fin n => A i j)
                (a := ∑ k : Fin n, A k j))
    _ = 1 := by
      rw [div_self hne]

/-!
## Stability
-/

/-- The operator norm of a doubly stochastic matrix is at most `1`. -/
theorem doubly_stochastic_is_contraction {n : ℕ} {A : Matrix (Fin n) (Fin n) ℝ} :
    IsDoublyStochastic A →
    ‖A‖ ≤ 1 := by
  intro hA
  have hM : A ∈ doublyStochastic ℝ (Fin n) := by
    simpa [IsDoublyStochastic, mem_doublyStochastic_iff_sum] using hA
  simpa using (Matrix.l2_opNorm_le_one_of_mem_doublyStochastic (M := A) hM)

end BirkhoffRouting
