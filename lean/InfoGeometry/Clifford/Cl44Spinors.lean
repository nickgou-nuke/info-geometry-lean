import InfoGeometry.Clifford.Cl44Witt
import InfoGeometry.Clifford.Cl44VolumeElement
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.OperatorAlgebra.ChiralProjectorFromInvolution

namespace InfoGeometry.Clifford.Cl44Spinors

open Cl44Witt
open InfoGeometry.Clifford

/--
Primitive vacuum idempotent built from the Witt basis.

Usually `p = ∏ᵢ aᵢ adagᵢ` or the opposite convention.
-/
noncomputable def vacuumIdempotent : Cl44 :=
  a11 * adag11

/--
Idempotency target for the vacuum projector.
-/
theorem vacuumIdempotent_idem :
    vacuumIdempotent * vacuumIdempotent = vacuumIdempotent := by
  unfold vacuumIdempotent
  have hCAR : a11 * adag11 + adag11 * a11 = 1 := cl11_witt_CAR_eq
  have hCAR' : adag11 * a11 + a11 * adag11 = 1 := by
    simpa [add_comm] using hCAR
  have hada : adag11 * a11 = 1 - a11 * adag11 := eq_sub_of_add_eq hCAR'
  calc
    (a11 * adag11) * (a11 * adag11)
        = a11 * (adag11 * a11) * adag11 := by simp [mul_assoc]
    _ = a11 * (1 - a11 * adag11) * adag11 := by rw [hada]
    _ = (a11 * adag11) - (a11 * (a11 * adag11)) * adag11 := by
          simp [sub_eq_add_neg, mul_add, add_mul, mul_assoc]
    _ = a11 * adag11 - ((a11 * a11) * adag11) * adag11 := by simp [mul_assoc]
    _ = a11 * adag11 - (0 * adag11) * adag11 := by rw [cl11_a_sq_zero]
    _ = a11 * adag11 := by simp

/--
The real minimal left ideal generated by the vacuum idempotent.
-/
def MinimalSpinor :=
  { x : Cl44 // x * vacuumIdempotent = x }

/-! The chirality operator is the genuine ordered pseudoscalar in `Cl(4,4)`. -/

noncomputable abbrev volumeElement : Cl44 := Cl44VolumeElement.volumeElement

theorem volumeElement_sq : volumeElement * volumeElement = 1 :=
  Cl44VolumeElement.volumeElement_sq

theorem volumeElement_anticommutes_e (i : Fin 4) :
    volumeElement * e i = -(e i * volumeElement) :=
  Cl44VolumeElement.volumeElement_anticommutes_e i

theorem volumeElement_anticommutes_f (i : Fin 4) :
    volumeElement * f i = -(f i * volumeElement) :=
  Cl44VolumeElement.volumeElement_anticommutes_f i

noncomputable def chiralInvolution :
    InfoGeometry.OperatorAlgebra.ChiralInvolution Cl44 where
  chi := volumeElement
  chi_sq := volumeElement_sq

noncomputable abbrev evenSemiSpinorProj : Cl44 := chiralInvolution.Pleft

noncomputable abbrev oddSemiSpinorProj : Cl44 := chiralInvolution.Pright

theorem evenSemiSpinorProj_idem :
    evenSemiSpinorProj * evenSemiSpinorProj = evenSemiSpinorProj :=
  chiralInvolution.Pleft_idem

theorem oddSemiSpinorProj_idem :
    oddSemiSpinorProj * oddSemiSpinorProj = oddSemiSpinorProj :=
  chiralInvolution.Pright_idem

theorem evenSemiSpinorProj_mul_oddSemiSpinorProj :
    evenSemiSpinorProj * oddSemiSpinorProj = 0 :=
  chiralInvolution.Pleft_mul_Pright

theorem oddSemiSpinorProj_mul_evenSemiSpinorProj :
    oddSemiSpinorProj * evenSemiSpinorProj = 0 :=
  chiralInvolution.Pright_mul_Pleft

theorem semiSpinorProjectors_complement :
    evenSemiSpinorProj + oddSemiSpinorProj = 1 :=
  chiralInvolution.Pleft_add_Pright

end InfoGeometry.Clifford.Cl44Spinors
