import Mathlib.Tactic

/-!
# Products of basic doubly stochastic matrices over a field

Theorem-safe Lean scaffold for Peter M. Gibson,
"Products of Basic Doubly Stochastic Matrices over a Field",
Linear Algebra Appl. 15, 99--118 (1976).

The paper studies matrices over a field whose row and column sums are `1`,
and the subgroup/semigroup generated by *basic* doubly stochastic matrices.
The main field-characteristic classification and rank factorization statements
are represented here as explicit certificates.  The concrete `3 × 3` basic
matrix identities are proved directly.
-/

namespace InfoGeometry.Canonical.GibsonBasicDoublyStochastic

noncomputable section

universe u

variable {R : Type u}

/-- A square matrix is doubly stochastic in the algebraic sense: every row and
column sum is `1`.  No positivity/order is involved. -/
def IsAlgebraicDoublyStochastic {n : ℕ} [Semiring R]
    (A : Matrix (Fin n) (Fin n) R) : Prop :=
  (∀ i, ∑ j, A i j = 1) ∧ (∀ j, ∑ i, A i j = 1)

/-- The visible `3 × 3` basic matrix `M₁₂(x)`: a nontrivial `2 × 2` stochastic
block and an untouched third coordinate. -/
def basic12 [Ring R] (x : R) : Matrix (Fin 3) (Fin 3) R :=
  !![x, 1 - x, 0;
     1 - x, x, 0;
     0, 0, 1]

/-- Row sums of the explicit basic matrix. -/
theorem basic12_row_sums [Ring R] (x : R) :
    ∀ i, ∑ j, basic12 (R := R) x i j = 1 := by
  intro i
  fin_cases i <;> simp [basic12, Fin.sum_univ_three]

/-- Column sums of the explicit basic matrix. -/
theorem basic12_col_sums [Ring R] (x : R) :
    ∀ j, ∑ i, basic12 (R := R) x i j = 1 := by
  intro j
  fin_cases j <;> simp [basic12, Fin.sum_univ_three]

/-- The explicit basic matrix is algebraically doubly stochastic. -/
theorem basic12_is_doubly_stochastic [Ring R] (x : R) :
    IsAlgebraicDoublyStochastic (basic12 (R := R) x) :=
  ⟨basic12_row_sums x, basic12_col_sums x⟩

/-- Determinant readout for the explicit `3 × 3` basic matrix. -/
theorem basic12_det [CommRing R] (x : R) :
    Matrix.det (basic12 (R := R) x) = 2 * x - 1 := by
  simp [basic12, Matrix.det_fin_three]
  ring_nf

/-- Product closure of algebraic doubly stochastic matrices. -/
theorem doublyStochastic_mul {n : ℕ} [CommSemiring R]
    {A B : Matrix (Fin n) (Fin n) R}
    (hA : IsAlgebraicDoublyStochastic A)
    (hB : IsAlgebraicDoublyStochastic B) :
    IsAlgebraicDoublyStochastic (A * B) := by
  constructor
  · intro i
    calc
      ∑ j, (A * B) i j
          = ∑ j, ∑ k, A i k * B k j := by simp [Matrix.mul_apply]
      _ = ∑ k, A i k * ∑ j, B k j := by
          rw [Finset.sum_comm]
          simp [Finset.mul_sum]
      _ = ∑ k, A i k * 1 := by simp [hB.1]
      _ = 1 := by simp [hA.1]
  · intro j
    calc
      ∑ i, (A * B) i j
          = ∑ i, ∑ k, A i k * B k j := by simp [Matrix.mul_apply]
      _ = ∑ k, (∑ i, A i k) * B k j := by
          rw [Finset.sum_comm]
          simp [Finset.sum_mul]
      _ = ∑ k, 1 * B k j := by simp [hA.2]
      _ = 1 := by simp [hB.2]

/--
Gibson's field condition: the characteristic is not two and the field has an
element distinct from `0`, `1`, and `-1`. For a field this is the concrete
algebraic form of “characteristic not two and more than three elements”.
-/
def GibsonFieldCondition (F : Type u) [Field F] : Prop :=
  ringChar F ≠ 2 ∧ ∃ a : F, a ≠ 0 ∧ a ≠ 1 ∧ a ≠ -1

/--
An order-`n` basic doubly stochastic matrix acts nontrivially only on two
distinct coordinates, where its block is `[[t, 1-t], [1-t, t]]`.
-/
def IsBasicDoublyStochastic
    {F : Type u} [Field F] {n : ℕ}
    (B : Matrix (Fin n) (Fin n) F) : Prop :=
  ∃ i j : Fin n, i ≠ j ∧ ∃ t : F, ∀ r c,
    B r c =
      if r = i ∧ c = i then t
      else if r = i ∧ c = j then 1 - t
      else if r = j ∧ c = i then 1 - t
      else if r = j ∧ c = j then t
      else if r = c then 1 else 0

/-- Native finite-product closure of the basic matrices. -/
def GeneratedByBasicDoublyStochastic
    {F : Type u} [Field F] {n : ℕ}
    (A : Matrix (Fin n) (Fin n) F) : Prop :=
  ∃ factors : List (Matrix (Fin n) (Fin n) F),
    (∀ B ∈ factors, IsBasicDoublyStochastic B) ∧ factors.prod = A

/-- Native nonsingularity predicate over a field. -/
def IsNonsingular
    {F : Type u} [Field F] {n : ℕ}
    (A : Matrix (Fin n) (Fin n) F) : Prop :=
  Matrix.det A ≠ 0

/--
Exact proposition of Gibson Theorem 2.8. It is no longer a structure carrying
three arbitrary predicates: every term has a fixed matrix- or field-theoretic
meaning.
-/
def NonsingularBasicGenerationCertificate
    (F : Type u) [Field F] (n : ℕ) : Prop :=
  (∀ A : Matrix (Fin n) (Fin n) F,
      IsAlgebraicDoublyStochastic A →
      IsNonsingular A →
      GeneratedByBasicDoublyStochastic A) ↔
    GibsonFieldCondition F

namespace NonsingularBasicGenerationCertificate

variable {F : Type u} [Field F] {n : ℕ}
variable (C : NonsingularBasicGenerationCertificate F n)

/-- Historical projection name, now fixed to Gibson's native field predicate. -/
def fieldCondition (_C : NonsingularBasicGenerationCertificate F n) : Prop :=
  GibsonFieldCondition F

/-- Historical projection name for the native finite-product predicate. -/
def generatedByBasics (_C : NonsingularBasicGenerationCertificate F n)
    (A : Matrix (Fin n) (Fin n) F) : Prop :=
  GeneratedByBasicDoublyStochastic A

/-- Historical projection name for determinant nonvanishing. -/
def nonsingular (_C : NonsingularBasicGenerationCertificate F n)
    (A : Matrix (Fin n) (Fin n) F) : Prop :=
  IsNonsingular A

/-- Gibson Theorem 2.8, reverse direction, as a property readout. -/
theorem all_nonsingular_generated_of_fieldCondition (h : C.fieldCondition) :
    ∀ A, IsAlgebraicDoublyStochastic A → C.nonsingular A → C.generatedByBasics A :=
  C.mpr h

end NonsingularBasicGenerationCertificate

/--
Exact proposition of Gibson Theorem 3.4 for the fixed native notions of field
condition and generation by basic factors.
-/
def FullBasicGenerationCertificate
    (F : Type u) [Field F] (n : ℕ) : Prop :=
  (∀ A : Matrix (Fin n) (Fin n) F,
      IsAlgebraicDoublyStochastic A →
      GeneratedByBasicDoublyStochastic A) ↔
    GibsonFieldCondition F

namespace FullBasicGenerationCertificate

variable {F : Type u} [Field F] {n : ℕ}
variable (C : FullBasicGenerationCertificate F n)

/-- Historical projection name, now fixed to Gibson's native field predicate. -/
def fieldCondition (_C : FullBasicGenerationCertificate F n) : Prop :=
  GibsonFieldCondition F

/-- Historical projection name for the native finite-product predicate. -/
def generatedByBasics (_C : FullBasicGenerationCertificate F n)
    (A : Matrix (Fin n) (Fin n) F) : Prop :=
  GeneratedByBasicDoublyStochastic A

/-- Gibson Theorem 3.4, reverse direction, as a property readout. -/
theorem all_generated_of_fieldCondition (h : C.fieldCondition) :
    ∀ A, IsAlgebraicDoublyStochastic A → C.generatedByBasics A :=
  C.mpr h

/-- Gibson Theorem 3.4, forward direction, as a property readout. -/
theorem fieldCondition_of_all_generated
    (h : ∀ A, IsAlgebraicDoublyStochastic A → C.generatedByBasics A) :
    C.fieldCondition :=
  C.mp h

end FullBasicGenerationCertificate

/-- Rank-refined factorization socket for Gibson Theorem 3.5. -/
structure RankDefectBasicFactorizationCertificate
    (F : Type u) [Field F] (n : ℕ) where
  rank : Matrix (Fin n) (Fin n) F → ℕ
  generatedByBasics : Matrix (Fin n) (Fin n) F → Prop
  singularBasicFactorCount : Matrix (Fin n) (Fin n) F → ℕ
  factorization_exists :
    ∀ A, IsAlgebraicDoublyStochastic A → generatedByBasics A
  lower_bound :
    ∀ A, IsAlgebraicDoublyStochastic A →
      n - rank A ≤ singularBasicFactorCount A
  exact_rank_defect_factorization :
    ∀ A, IsAlgebraicDoublyStochastic A →
      ∃ count, count = n - rank A ∧ count = singularBasicFactorCount A

namespace RankDefectBasicFactorizationCertificate

variable {F : Type u} [Field F] {n : ℕ}
variable (C : RankDefectBasicFactorizationCertificate F n)

/-- Any supplied Gibson 3.5 property yields exact rank-defect singular count. -/
theorem exact_singular_count_readout
    (A : Matrix (Fin n) (Fin n) F) (hA : IsAlgebraicDoublyStochastic A) :
    ∃ count, count = n - C.rank A ∧ count = C.singularBasicFactorCount A :=
  C.exact_rank_defect_factorization A hA

end RankDefectBasicFactorizationCertificate

/-- Characteristic-two orthogonal/symmetric inverse socket for Gibson Theorem 3.7. -/
structure CharacteristicTwoTransposeInverseCertificate
    (F : Type u) [Field F] (n : ℕ) where
  generatedByBasics : Matrix (Fin n) (Fin n) F → Prop
  nonsingular : Matrix (Fin n) (Fin n) F → Prop
  transposeInverseCondition : Matrix (Fin n) (Fin n) F → Prop
  theorem37_forward :
    ∀ A, IsAlgebraicDoublyStochastic A → generatedByBasics A →
      transposeInverseCondition A
  theorem37_reverse :
    ∀ A, IsAlgebraicDoublyStochastic A → nonsingular A →
      transposeInverseCondition A → generatedByBasics A

namespace CharacteristicTwoTransposeInverseCertificate

variable {F : Type u} [Field F] {n : ℕ}
variable (C : CharacteristicTwoTransposeInverseCertificate F n)

/-- Gibson Theorem 3.7 reverse readout. -/
theorem generated_of_transposeInverse
    (A : Matrix (Fin n) (Fin n) F)
    (hA : IsAlgebraicDoublyStochastic A) (hns : C.nonsingular A)
    (hT : C.transposeInverseCondition A) :
    C.generatedByBasics A :=
  C.theorem37_reverse A hA hns hT

end CharacteristicTwoTransposeInverseCertificate

end

end InfoGeometry.Canonical.GibsonBasicDoublyStochastic
