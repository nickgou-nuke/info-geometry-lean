import Mathlib.Analysis.Complex.Basic
import InfoGeometry.Cocycle.MatrixDetExpTrace.Diagonal
import InfoGeometry.Meta.FiniteToInfiniteTransitionSOP

/-!
# Fredholm Closure Ledger

This module keeps the finite determinant material and the analytic Fredholm
target separated.

What is proved here:

* the finite diagonal identity
  `det (exp (diagonal v)) = exp (trace (diagonal v))`;
* the finite product recurrence for cutoff determinants.

What is not proved here:

* construction of `e^{-sH}` on `ℓ²(ℕ⁺)`;
* proof that it is trace-class;
* construction/continuity of the infinite Fredholm determinant;
* analytic continuation or nonvanishing in the critical half-plane.

Those analytic facts must be supplied by an explicit property until the
trace-class owner file constructs them from first principles.
-/

open Complex
open scoped BigOperators

namespace InfoGeometry.Arithmetic.FredholmClosure

open InfoGeometry.Cocycle.MatrixDetExpTrace.Diagonal

/- ## The Finite Trace-Determinant Identity -/

/--
**Theorem (Finite trace-determinant, PROVED).** For any finite set of
"energies" v_i (e.g., v_n = -β·log n), the determinant of the diagonal
exponential equals the exponential of the trace:

    det(exp(diag(v))) = exp(tr(diag(v)))

Proved in `MatrixDetExpTrace/Diagonal.lean` for all `Fintype ι`.
-/
theorem finite_diagonal_det_exp_trace
    {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → ℂ) :
    Matrix.det (NormedSpace.exp (Matrix.diagonal v)) =
    NormedSpace.exp (Matrix.trace (Matrix.diagonal v)) :=
  det_exp_diagonal_eq_exp_trace_complex v

/- ## The SOP Ladder — From Finite to Infinite -/

/-!
The SOP theorem `readout_stable_along_finite_chain` proves finite-chain
transport only.  It deliberately does not assert convergence or a completed
Fredholm determinant.  The cutoff determinant below records the finite product
recurrence that the Hestenes--Krein/categorical colimit owner must refine.
-/

/--
Finite cutoff determinant generated by a sequence of local factors.

For the primon/Fredholm application, `factor n` is intended to be the local
factor `1 - exp (-s log mode_n)` after the colimit owner defines the mode
enumeration.
-/
noncomputable def regularizedDetStage (factor : ℕ → ℂ) (N : ℕ) : ℂ :=
  (Finset.range N).prod factor

/--
Adding one more finite mode multiplies the cutoff determinant by the new local
factor.  This is the finite algebraic recurrence; it is not an infinite
trace-class statement.
-/
theorem regularizedDetStage_succ (factor : ℕ → ℂ) (N : ℕ) :
    regularizedDetStage factor (N + 1) =
      regularizedDetStage factor N * factor N := by
  simp [regularizedDetStage, Finset.prod_range_succ]

/- ## The Fredholm Closure Data -/

/--
Colimit-owner data required to promote the finite determinant recurrence to the
infinite Fredholm-style readout.

This is intentionally data, not a proof of trace-class operator
theory.  A future Hestenes--Krein/categorical owner theorem should construct
this data from the finite-stage tower.
-/
structure FredholmClosureData where
  /-- Concrete trace-class-style ideal used by the colimit owner, if that route is instantiated. -/
  TraceIdeal : Type
  /-- Ambient operator space, e.g. bounded operators on `ℓ²(ℕ⁺)`. -/
  AmbientOperator : Type
  /-- Inclusion of the trace-class ideal into the ambient operator space. -/
  idealToAmbient : TraceIdeal → AmbientOperator
  /-- Ambient predicate for being trace-class. -/
  isTraceClass : AmbientOperator → Prop
  /-- Ambient predicate for compactness. -/
  isCompact : AmbientOperator → Prop
  /--
  The ideal inclusion really lands in the trace-class predicate.  This prevents
  confusing the trace-class lane with merely compact or bounded operators.
  -/
  idealToAmbient_isTraceClass : ∀ T : TraceIdeal, isTraceClass (idealToAmbient T)
  /-- Trace-class operators are compact in the chosen analytic backend. -/
  traceClass_isCompact : ∀ T : AmbientOperator, isTraceClass T → isCompact T
  /-- Finite cutoff operators `T_N(s)`. -/
  finiteCutoff : ℂ → ℕ → TraceIdeal
  /-- Infinite diagonal operator `T(s) = -e^{-sH}` inside the trace-class ideal. -/
  limitOperator : ℂ → TraceIdeal
  /-- Trace-norm distance on the supplied trace-class ideal. -/
  traceNormDist : TraceIdeal → TraceIdeal → ℝ
  /-- Trace-norm distance is nonnegative. -/
  traceNormDist_nonneg : ∀ A B : TraceIdeal, 0 ≤ traceNormDist A B
  /--
  Trace-norm convergence of finite cutoffs to the infinite diagonal operator.

  This is deliberately restricted to `1 < s.re`, the half-plane where the
  p-series `∑ n, n^{-s.re}` is absolutely summable and the diagonal operator is
  trace-class.
  -/
  traceNorm_cutoff_tendsto :
    ∀ s : ℂ, 1 < s.re →
      Filter.Tendsto
        (fun N : ℕ => traceNormDist (finiteCutoff s N) (limitOperator s))
        Filter.atTop (nhds 0)
  /-- Fredholm determinant functional on the trace-class ideal. -/
  determinantOnIdeal : TraceIdeal → ℂ
  /-- Candidate Fredholm determinant readout on spectral parameters. -/
  determinant : ℂ → ℂ
  /-- The parameter readout is the determinant of the trace-class limit. -/
  determinant_eq_limit :
    ∀ s : ℂ, determinant s = determinantOnIdeal (limitOperator s)
  /--
  Continuity of the Fredholm determinant along the finite cutoff sequence in
  the trace-norm topology, again only on `Re s > 1`.
  -/
  determinant_cutoff_tendsto :
    ∀ s : ℂ, 1 < s.re →
      Filter.Tendsto
        (fun N : ℕ => determinantOnIdeal (finiteCutoff s N))
        Filter.atTop (nhds (determinantOnIdeal (limitOperator s)))
  /-- Candidate Fredholm determinant readout. -/
  zeta : ℂ → ℂ
  /-- Right-half-plane determinant/zeta calibration. -/
  determinant_mul_zeta_eq_one :
    ∀ s : ℂ, 1 < s.re → determinant s * zeta s = 1
  /-- Nonvanishing of the determinant on the absolutely convergent half-plane. -/
  determinant_ne_zero_on_abs_convergence :
    ∀ s : ℂ, 1 < s.re → determinant s ≠ 0

namespace FredholmClosureData

/-- The infinite diagonal operator lands in the trace-class ideal by construction. -/
theorem limitOperator_isTraceClass
    (C : FredholmClosureData) (s : ℂ) :
    C.isTraceClass (C.idealToAmbient (C.limitOperator s)) :=
  C.idealToAmbient_isTraceClass (C.limitOperator s)

/-- The infinite diagonal operator is compact because trace-class implies compact. -/
theorem limitOperator_isCompact
    (C : FredholmClosureData) (s : ℂ) :
    C.isCompact (C.idealToAmbient (C.limitOperator s)) :=
  C.traceClass_isCompact _ (C.limitOperator_isTraceClass s)

/-- Finite cutoff operators land in the trace-class ideal by construction. -/
theorem finiteCutoff_isTraceClass
    (C : FredholmClosureData) (s : ℂ) (N : ℕ) :
    C.isTraceClass (C.idealToAmbient (C.finiteCutoff s N)) :=
  C.idealToAmbient_isTraceClass (C.finiteCutoff s N)

/-- Trace-norm convergence of the finite cutoffs, exposed as a theorem. -/
theorem traceNorm_cutoff_converges
    (C : FredholmClosureData) {s : ℂ} (hs : 1 < s.re) :
    Filter.Tendsto
      (fun N : ℕ => C.traceNormDist (C.finiteCutoff s N) (C.limitOperator s))
      Filter.atTop (nhds 0) :=
  C.traceNorm_cutoff_tendsto s hs

/-- Continuity of the Fredholm determinant along the trace-norm cutoff path. -/
theorem determinant_cutoff_converges
    (C : FredholmClosureData) {s : ℂ} (hs : 1 < s.re) :
    Filter.Tendsto
      (fun N : ℕ => C.determinantOnIdeal (C.finiteCutoff s N))
      Filter.atTop (nhds (C.determinantOnIdeal (C.limitOperator s))) :=
  C.determinant_cutoff_tendsto s hs

end FredholmClosureData

/- ## The Fredholm Closure Theorem -/

/--
Projection from an explicit Fredholm closure property.

The theorem intentionally does not manufacture the property.  It states the
only kernel-checked consequence available once the Hestenes--Krein/categorical
colimit owner supplies the determinant-style readout data.
-/
theorem fredholm_closure_theorem
    (C : FredholmClosureData) {s : ℂ} (hs : 1 < s.re) :
    C.determinant s ≠ 0 :=
  C.determinant_ne_zero_on_abs_convergence s hs

/--
On the guarded side, the supplied determinant/zeta calibration gives the
multiplicative inverse relation.
-/
theorem fredholm_determinant_mul_zeta_eq_one
    (C : FredholmClosureData) {s : ℂ} (hs : 1 < s.re) :
    C.determinant s * C.zeta s = 1 :=
  C.determinant_mul_zeta_eq_one s hs

end InfoGeometry.Arithmetic.FredholmClosure
