{"type":"new","contents":"import InfoGeometry.Canonical.OperatorDictionary\nimport InfoGeometry.Meta.Architecture\nimport Mathlib.Tactic.Linarith\n\nopen scoped InnerProductSpace\n\n/-!\n# InfoGeometry.Canonical.HestenesKramersBridge\n\nReal-carrier Kramers translation in the repo's doubled Hestenes language.\n\nThis file does not introduce complex antiunitary primitives. The Kramers partner\nis the internal phase-axis image `K ψ`, where `K = J ∘ ε`.\n-/\n\nnamespace InfoGeometry.Canonical.HestenesKramersBridge\n\nopen InfoGeometry.Krein\nopen InfoGeometry.Canonical.OperatorDictionary\nopen InfoGeometry.Canonical.TomitaTakesaki\n\nsection Core\n\nvariable {E : Type 0}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\n\n/-- Real-carrier Kramers partner generated by the internal phase axis `K = J ∘ ε`. -/\n@[rep_depth krein]\nnoncomputable def phasePartner (ψ : H₂) : H₂ :=\n  InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E) ψ\n\n/-- Kramers partner in repo language: `(ψ, Kψ)`. -/\n@[rep_depth krein]\nnoncomputable def kramersPair (ψ : H₂) : H₂ × H₂ :=\n  (ψ, phasePartner (E := E) ψ)\n\nsection\n\nomit [CompleteSpace E]\n\n/-- The phase partner is exactly the internal phase-axis action `K ψ`. -/\n@[rep_depth krein, simp]\ntheorem phasePartner_eq_phaseAxisK (ψ : H₂) :\n    phasePartner (E := E) ψ =\n      InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E) ψ := by\n  rfl\n\nend\n\n/-- `K² = -Id` on the doubled carrier. -/\n@[rep_depth krein, simp]\ntheorem phasePartner_phasePartner_eq_neg (ψ : H₂) :\n    phasePartner (E := E) (phasePartner (E := E) ψ) = -ψ := by\n  change (InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E)).comp\n      (InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E)) ψ = -ψ\n  simpa using\n    congrArg (fun F : H₂ →L[ℝ] H₂ => F ψ) (phaseAxisK_sq_eq_neg_id (E := E))\n\n/--\nHilbert-orthogonality of the real Kramers pair:\n`⟪ψ, Kψ⟫ = 0`.\n-/\n@[rep_depth krein]\ntheorem inner_first_second_eq_zero (ψ : H₂) :\n    ⟪(kramersPair (E := E) ψ).1, (kramersPair (E := E) ψ).2⟫_ℝ = 0 := by\n  have hSkew :\n      ⟪phasePartner (E := E) ψ, ψ⟫_ℝ = -⟪ψ, phasePartner (E := E) ψ⟫_ℝ := by\n    simpa [phasePartner] using phaseAxisK_inner_skew (E := E) ψ ψ\n  have hComm :\n      ⟪phasePartner (E := E) ψ, ψ⟫_ℝ = ⟪ψ, phasePartner (E := E) ψ⟫_ℝ := by\n    simp [real_inner_comm]\n  have hSelf :\n      ⟪ψ, phasePartner (E := E) ψ⟫_ℝ = -⟪ψ, phasePartner (E := E) ψ⟫_ℝ := by\n    linarith [hSkew, hComm]\n  have : ⟪ψ, phasePartner (E := E) ψ⟫_ℝ = 0 := by linarith [hSelf]\n  simpa [kramersPair] using this\n\n/--\nThe partner map is nontrivial on nonzero states:\n`ψ ≠ 0 → Kψ ≠ ψ`.\n-/\n@[rep_depth krein]\ntheorem phasePartner_ne_self_of_ne_zero {ψ : H₂} (hψ : ψ ≠ 0) :\n    phasePartner (E := E) ψ ≠ ψ := by\n  intro hEq\n  have hSq := phasePartner_phasePartner_eq_neg (E := E) ψ\n  have hApply : phasePartner (E := E) (phasePartner (E := E) ψ) = phasePartner (E := E) ψ := by\n    exact congrArg (phasePartner (E := E)) hEq\n  have hNeg : -ψ = ψ := by\n    calc\n      -ψ = phasePartner (E := E) (phasePartner (E := E) ψ) := by exact hSq.symm\n      _ = phasePartner (E := E) ψ := hApply\n      _ = ψ := hEq\n  have hTwoSum : ψ + ψ = 0 := by\n    calc\n      ψ + ψ = ψ + (-ψ) := by rw [hNeg]\n      _ = 0 := by simp\n  have hTwoSmul : (2 : ℝ) • ψ = 0 := by\n    simpa [two_smul] using hTwoSum\n  have hψ0 : ψ = 0 := by\n    exact (smul_eq_zero.mp hTwoSmul).resolve_left (by norm_num)\n  exact hψ hψ0\n\n/--\nKrein-sign rule for the Kramers partner:\n`[Kψ, Kφ] = -[ψ, φ]`.\n-/\n@[rep_depth krein]\ntheorem kreinInner_phasePartner_phasePartner (ψ φ : H₂) :\n    KreinSpace.kreinInner (H := H₂) (phasePartner (E := E) ψ) (phasePartner (E := E) φ)\n      =\n    -KreinSpace.kreinInner (H := H₂) ψ φ := by\n  simpa [phasePartner] using phaseAxisK_kreinInner_comp (E := E) ψ φ\n\nend Core\n\nend InfoGeometry.Canonical.HestenesKramersBridge\n","mtime":1777928003335}