chi_L = Matrix([1, 0])   # Weyl left
chi_R = Matrix([0, 1])   # Weyl right
# Boson field: phi = chi^dagger_L chi_L - chi^dagger_R chi_R
phi_L = (chi_L.H * chi_L)[0]
