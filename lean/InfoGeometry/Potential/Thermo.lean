import InfoGeometry.Potential.LogPotential
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.Analysis.Calculus.Deriv.Slope

/-!
# Log Potential Thermodynamics

A structural layer over `LogPotential` for Jaynes / convex-thermo workflows:

- `ψ` (Massieu / log-partition potential)
- Fenchel gap
- Legendre-contact packaging
- entropy/free-energy style derived quantities
- primal/dual Bregman divergences
-/

namespace InfoGeometry
namespace LogPotential

/-- A Legendre-style package over a scalar log-potential `ψ`. -/
structure LegendreModel where
  L : LogPotential ℝ
  /-- Candidate dual coordinate map `η = ∇ψ(θ)` (kept abstract at this layer). -/
  grad : ℝ → ℝ
  /-- Candidate dual potential `φ(η)`. -/
  φ : ℝ → ℝ
  /-- Fenchel inequality `θη ≤ ψ(θ) + φ(η)`. -/
  fenchel_ineq : ∀ θ η, θ * η ≤ L.ψ θ + φ η
  /-- Contact equality at the chosen dual coordinate `η = grad θ`. -/
  contact : ∀ θ, φ (grad θ) = θ * grad θ - L.ψ θ

namespace LegendreModel

/-- Massieu potential (log-partition in statistical mechanics conventions). -/
def massieu (M : LegendreModel) (θ : ℝ) : ℝ :=
  M.L.ψ θ

/-- Partition function recovered from the log-potential: `Z = exp ψ`. -/
noncomputable def partition (M : LegendreModel) (θ : ℝ) : ℝ :=
  Real.exp (M.massieu θ)

/-- Dual coordinate (typically the expectation parameter). -/
def dualCoord (M : LegendreModel) (θ : ℝ) : ℝ :=
  M.grad θ

/-- Fenchel gap `ψ(θ) + φ(η) - θη`, nonnegative by Fenchel inequality. -/
def fenchelGap (M : LegendreModel) (θ η : ℝ) : ℝ :=
  M.massieu θ + M.φ η - θ * η

/-- Generic "entropy-like" quantity from the contact identity: `S = θη - ψ`. -/
def entropy (M : LegendreModel) (θ : ℝ) : ℝ :=
  θ * M.dualCoord θ - M.massieu θ

/-- A scaled free-energy convention: `F_ε = - ε ψ`. -/
def freeEnergy (M : LegendreModel) (ε θ : ℝ) : ℝ :=
  -ε * M.massieu θ

/-- Primal Bregman divergence generated by `ψ`. -/
noncomputable def primalBregman (M : LegendreModel) (θ θ₀ : ℝ) : ℝ :=
  InfoGeometry.LogPotential.bregman M.L θ θ₀

/-- Dual Bregman divergence generated by `φ`. -/
noncomputable def dualBregman (M : LegendreModel) (η η₀ : ℝ) : ℝ :=
  bregmanDiv M.φ η η₀

@[simp] lemma massieu_def (M : LegendreModel) (θ : ℝ) :
    M.massieu θ = M.L.ψ θ := rfl

@[simp] lemma partition_def (M : LegendreModel) (θ : ℝ) :
    M.partition θ = Real.exp (M.L.ψ θ) := rfl

@[simp] lemma dualCoord_def (M : LegendreModel) (θ : ℝ) :
    M.dualCoord θ = M.grad θ := rfl

@[simp] lemma fenchelGap_def (M : LegendreModel) (θ η : ℝ) :
    M.fenchelGap θ η = M.L.ψ θ + M.φ η - θ * η := rfl

lemma fenchelGap_nonneg (M : LegendreModel) (θ η : ℝ) :
    0 ≤ M.fenchelGap θ η := by
  unfold fenchelGap massieu
  linarith [M.fenchel_ineq θ η]

/--
Fenchel gap is invariant under any symmetry that preserves the primal
potential, the dual potential, and the primal-dual pairing.
-/
lemma fenchelGap_invariant_of_preserves_potentials_and_pairing
    (M : LegendreModel)
    {G : Type*} [Group G]
    (actθ : G → ℝ → ℝ)
    (actη : G → ℝ → ℝ)
    (hψ :
      ∀ g θ,
        M.massieu (actθ g θ) = M.massieu θ)
    (hφ :
      ∀ g η,
        M.φ (actη g η) = M.φ η)
    (hpair :
      ∀ g θ η,
        actθ g θ * actη g η = θ * η)
    (g : G) (θ η : ℝ) :
    M.fenchelGap (actθ g θ) (actη g η) =
      M.fenchelGap θ η := by
  unfold fenchelGap
  rw [hψ g θ, hφ g η, hpair g θ η]

/-- Contact identity rewritten as `entropy = φ(η)` at `η = grad θ`. -/
lemma entropy_eq_dual_at_contact (M : LegendreModel) (θ : ℝ) :
    M.entropy θ = M.φ (M.dualCoord θ) := by
  unfold entropy dualCoord massieu
  simpa using (M.contact θ).symm

/-- Fenchel gap vanishes on the Legendre contact locus. -/
lemma fenchelGap_eq_zero_at_contact (M : LegendreModel) (θ : ℝ) :
    M.fenchelGap θ (M.dualCoord θ) = 0 := by
  unfold fenchelGap dualCoord massieu
  rw [M.contact θ]
  ring

/-- Equivalent form of the contact identity: `ψ + φ = θη` at `η = grad θ`. -/
lemma contact_balance (M : LegendreModel) (θ : ℝ) :
    M.massieu θ + M.φ (M.dualCoord θ) = θ * M.dualCoord θ := by
  unfold massieu dualCoord
  have h := M.contact θ
  linarith

/--
Fenchel gap measured from the Legendre contact locus.
-/
lemma fenchelGap_eq_dual_defect_add_pairing_defect
    (M : LegendreModel) (θ η : ℝ) :
    M.fenchelGap θ η =
      M.φ η - M.φ (M.dualCoord θ)
        + θ * (M.dualCoord θ - η) := by
  unfold fenchelGap dualCoord massieu
  rw [M.contact θ]
  ring

/-- Free energy is just a scaled negative Massieu potential by definition. -/
@[simp] lemma freeEnergy_def (M : LegendreModel) (ε θ : ℝ) :
    M.freeEnergy ε θ = -ε * M.L.ψ θ := rfl

/-- Canonical-ensemble energy convention:
for Gibbs weights `exp(-θ f)`, one usually has `U = -∂ψ/∂θ`,
so from the abstract dual coordinate `η = grad θ` we define `U := -η`. -/
def canonicalEnergy (M : LegendreModel) (θ : ℝ) : ℝ :=
  -M.dualCoord θ

/-- Canonical entropy in Gibbs sign convention:
`S = ψ + θ U = ψ - θη`. -/
def canonicalEntropy (M : LegendreModel) (θ : ℝ) : ℝ :=
  M.massieu θ + θ * M.canonicalEnergy θ

/-- Canonical free-energy notation (same scalar definition as `freeEnergy`). -/
def canonicalFreeEnergy (M : LegendreModel) (ε θ : ℝ) : ℝ :=
  -ε * M.massieu θ

/-- `ε`-scaled Fenchel gap, useful as a thermodynamic defect at scale `ε`. -/
def scaledFenchelGap (M : LegendreModel) (ε θ η : ℝ) : ℝ :=
  ε * M.fenchelGap θ η

/--
Temperature-regularized Hamiltonian defect.

This is the scaled Fenchel/Bregman defect attached to the Legendre/Massieu
potential.  It is the proof-carrying scalar Hamiltonian defect used by the
thermodynamic bridges in the repo.
-/
def temperatureRegularizedHamiltonian
    (M : LegendreModel) (β θ η : ℝ) : ℝ :=
  M.scaledFenchelGap β θ η

@[simp] lemma canonicalEnergy_def (M : LegendreModel) (θ : ℝ) :
    M.canonicalEnergy θ = -M.dualCoord θ := rfl

@[simp] lemma canonicalEntropy_def (M : LegendreModel) (θ : ℝ) :
    M.canonicalEntropy θ = M.massieu θ - θ * M.dualCoord θ := by
  unfold canonicalEntropy canonicalEnergy
  ring

@[simp] lemma canonicalFreeEnergy_def (M : LegendreModel) (ε θ : ℝ) :
    M.canonicalFreeEnergy ε θ = -ε * M.massieu θ := rfl

@[simp] lemma scaledFenchelGap_def (M : LegendreModel) (ε θ η : ℝ) :
    M.scaledFenchelGap ε θ η = ε * (M.massieu θ + M.φ η - θ * η) := by
  simp [scaledFenchelGap, fenchelGap]

@[simp] lemma temperatureRegularizedHamiltonian_def
    (M : LegendreModel) (β θ η : ℝ) :
    M.temperatureRegularizedHamiltonian β θ η = M.scaledFenchelGap β θ η := rfl

/-- The abstract convex-conjugate entropy and canonical entropy are opposites
under the Gibbs-sign convention. -/
lemma canonicalEntropy_eq_neg_entropy (M : LegendreModel) (θ : ℝ) :
    M.canonicalEntropy θ = -M.entropy θ := by
  unfold canonicalEntropy canonicalEnergy entropy dualCoord massieu
  ring

/-- Contact identity in canonical sign convention:
`S = -φ(η)` at `η = grad θ`. -/
lemma canonicalEntropy_eq_neg_dual_at_contact (M : LegendreModel) (θ : ℝ) :
    M.canonicalEntropy θ = -M.φ (M.dualCoord θ) := by
  calc
    M.canonicalEntropy θ = -M.entropy θ := M.canonicalEntropy_eq_neg_entropy θ
    _ = -M.φ (M.dualCoord θ) := by
      rw [M.entropy_eq_dual_at_contact]

/-- Fenchel gap is nonnegative; scaled gap is nonnegative for nonnegative scale `ε`. -/
lemma scaledFenchelGap_nonneg
    (M : LegendreModel) (ε θ η : ℝ) (hε : 0 ≤ ε) :
    0 ≤ M.scaledFenchelGap ε θ η := by
  unfold scaledFenchelGap
  exact mul_nonneg hε (M.fenchelGap_nonneg θ η)

/-- Temperature-regularized Hamiltonian defect is nonnegative for nonnegative temperature scale. -/
lemma temperatureRegularizedHamiltonian_nonneg
    (M : LegendreModel) (β θ η : ℝ) (hβ : 0 ≤ β) :
    0 ≤ M.temperatureRegularizedHamiltonian β θ η := by
  simpa [temperatureRegularizedHamiltonian] using
    (M.scaledFenchelGap_nonneg β θ η hβ)

/-- Scaled Fenchel gap vanishes on the contact locus. -/
lemma scaledFenchelGap_eq_zero_at_contact
    (M : LegendreModel) (ε θ : ℝ) :
    M.scaledFenchelGap ε θ (M.dualCoord θ) = 0 := by
  unfold scaledFenchelGap
  rw [M.fenchelGap_eq_zero_at_contact]
  ring

/-- Temperature-regularized Hamiltonian defect vanishes on the contact locus. -/
lemma temperatureRegularizedHamiltonian_eq_zero_at_contact
    (M : LegendreModel) (β θ : ℝ) :
    M.temperatureRegularizedHamiltonian β θ (M.dualCoord θ) = 0 := by
  simpa [temperatureRegularizedHamiltonian] using
    (M.scaledFenchelGap_eq_zero_at_contact β θ)

/-- Contact balance rewritten with canonical energy:
`ψ = S - θ U` (Massieu form). -/
lemma massieu_eq_canonicalEntropy_minus_theta_energy
    (M : LegendreModel) (θ : ℝ) :
    M.massieu θ = M.canonicalEntropy θ - θ * M.canonicalEnergy θ := by
  unfold canonicalEntropy
  ring

/-- Canonical free energy is `-ε ψ`, so equivalently `-ε (S - θU)` in this sign convention. -/
lemma canonicalFreeEnergy_eq_scaled_entropy_energy
    (M : LegendreModel) (ε θ : ℝ) :
    M.canonicalFreeEnergy ε θ
      = -ε * (M.canonicalEntropy θ - θ * M.canonicalEnergy θ) := by
  unfold canonicalFreeEnergy
  rw [M.massieu_eq_canonicalEntropy_minus_theta_energy]

/--
Primal Bregman divergence is the Fenchel gap at the dual coordinate of the
base point.

`D_ψ(θ ‖ θ₀) = ψ(θ) + φ(η₀) - θη₀`,
where `η₀ = grad θ₀ = deriv ψ θ₀`.
-/
lemma primalBregman_eq_fenchelGap_at_dualCoord_of_grad_eq_deriv
    (M : LegendreModel) (θ θ₀ : ℝ)
  (hgrad : M.grad θ₀ = deriv M.L.ψ θ₀) :
    M.primalBregman θ θ₀ = M.fenchelGap θ (M.dualCoord θ₀) := by
  unfold primalBregman fenchelGap massieu dualCoord
  unfold InfoGeometry.LogPotential.bregman InfoGeometry.bregmanDiv
  rw [M.contact θ₀]
  rw [← hgrad]
  ring

/--
Nonnegativity of primal Bregman divergence via the Fenchel gap bridge.
-/
lemma primalBregman_nonneg_of_grad_eq_deriv
    (M : LegendreModel) (θ θ₀ : ℝ)
    (hgrad : M.grad θ₀ = deriv M.L.ψ θ₀) :
    0 ≤ M.primalBregman θ θ₀ := by
  rw [M.primalBregman_eq_fenchelGap_at_dualCoord_of_grad_eq_deriv θ θ₀ hgrad]
  exact M.fenchelGap_nonneg θ (M.dualCoord θ₀)

/-- 1D subgradient uniqueness under differentiability. -/
theorem unique_subgradient_of_differentiable {f : ℝ → ℝ} {x y g : ℝ}
    (hd : HasDerivAt f g x)
    (hsub : ∀ z, y * (z - x) ≤ f z - f x) :
    y = g := by
  have h_left_right := hasDerivAt_iff_tendsto_slope_left_right.mp hd
  have h_left := h_left_right.1
  have h_right := h_left_right.2
  
  have h_ge : y ≤ g := by
    have h_slope_ge : ∀ z ∈ Set.Ioi x, y ≤ slope f x z := by
      intro z hz
      have hz_gt : x < z := hz
      have hsub_z := hsub z
      have h_pos : 0 < z - x := sub_pos.mpr hz_gt
      rw [slope_def_field]
      exact (le_div_iff₀ h_pos).mpr hsub_z
    have h_eventually : ∀ᶠ z in nhdsWithin x (Set.Ioi x), y ≤ slope f x z := by
      filter_upwards [self_mem_nhdsWithin] with z hz
      exact h_slope_ge z hz
    exact ge_of_tendsto h_right h_eventually

  have h_le : g ≤ y := by
    have h_slope_le : ∀ z ∈ Set.Iio x, slope f x z ≤ y := by
      intro z hz
      have hz_lt : z < x := hz
      have hsub_z := hsub z
      have h_neg : z - x < 0 := sub_neg.mpr hz_lt
      rw [slope_def_field]
      exact (div_le_iff_of_neg h_neg).mpr hsub_z
    have h_eventually : ∀ᶠ z in nhdsWithin x (Set.Iio x), slope f x z ≤ y := by
      filter_upwards [self_mem_nhdsWithin] with z hz
      exact h_slope_le z hz
    exact le_of_tendsto h_left h_eventually

  exact le_antisymm h_ge h_le

/-- Fenchel gap vanishes if and only if η matches the gradient under differentiability. -/
theorem fenchelGap_eq_zero_iff_eq_grad_of_hasDerivAt
    (M : LegendreModel) (θ η : ℝ)
    (hd : HasDerivAt M.L.ψ (M.grad θ) θ) :
    M.fenchelGap θ η = 0 ↔ η = M.grad θ := by
  constructor
  · intro hGap
    have hsub : ∀ z, η * (z - θ) ≤ M.L.ψ z - M.L.ψ θ := by
      intro z
      have h_ineq := M.fenchel_ineq z η
      have h_gap_eq : M.L.ψ θ + M.φ η - θ * η = 0 := hGap
      have h_phi : M.φ η = θ * η - M.L.ψ θ := by linarith
      rw [h_phi] at h_ineq
      calc
        η * (z - θ) = z * η - θ * η := by ring
        _ ≤ M.L.ψ z - M.L.ψ θ := by linarith
    exact unique_subgradient_of_differentiable hd hsub
  · intro h
    rw [h]
    exact M.fenchelGap_eq_zero_at_contact θ

end LegendreModel

end LogPotential
end InfoGeometry
