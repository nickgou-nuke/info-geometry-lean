import InfoGeometry.Synthesis.Cl22ModularClosureWave2
import InfoGeometry.Synthesis.Cl22ReverseRotor
import InfoGeometry.Canonical.FiniteMatrixGibbsFunctional

noncomputable section

open scoped Matrix
open Matrix
open InfoGeometry.Synthesis.Cl22RealDiracCarrier
open InfoGeometry.Synthesis.Cl22ModularClosureWave2
open InfoGeometry.Canonical.FiniteMatrixGibbsFunctional

namespace InfoGeometry.Synthesis.Cl22ModularWave18

abbrev M4R := Matrix (Fin 4) (Fin 4) ℝ
abbrev M4C := Matrix (Fin 4) (Fin 4) ℂ

/-- Coefficient extension of the real doubled Clifford carrier to the complex
matrix carrier used by the finite Gibbs functional. -/
noncomputable def castM4 (A : M4R) : M4C :=
  RingHom.mapMatrix (algebraMap ℝ ℂ) A

private theorem volumeOmega_hermitian :
    (castM4 volumeOmega).IsHermitian := by
  rw [volumeOmega_explicit]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [castM4, RingHom.mapMatrix, Matrix.IsHermitian]

private theorem normalized_rotor_cast_mul_reverse (c s : ℝ)
    (h_norm : c ^ 2 + s ^ 2 = 1) :
    castM4 (andreevRotor c s) * castM4 (andreevRotorRev c s) = 1 := by
  change (RingHom.mapMatrix (algebraMap ℝ ℂ) (andreevRotor c s)) *
      (RingHom.mapMatrix (algebraMap ℝ ℂ) (andreevRotorRev c s)) = 1
  rw [← (RingHom.mapMatrix (algebraMap ℝ ℂ)).map_mul,
    andreevRotor_planar_sheet_rotation c s |>.1, h_norm]
  simpa using (RingHom.mapMatrix (algebraMap ℝ ℂ)).map_one

private theorem normalized_reverse_mul_rotor_cast (c s : ℝ)
    (h_norm : c ^ 2 + s ^ 2 = 1) :
    castM4 (andreevRotorRev c s) * castM4 (andreevRotor c s) = 1 := by
  change (RingHom.mapMatrix (algebraMap ℝ ℂ) (andreevRotorRev c s)) *
      (RingHom.mapMatrix (algebraMap ℝ ℂ) (andreevRotor c s)) = 1
  rw [← (RingHom.mapMatrix (algebraMap ℝ ℂ)).map_mul,
    andreevRotorRev_mul_andreevRotor c s, h_norm]
  simpa using (RingHom.mapMatrix (algebraMap ℝ ℂ)).map_one

private theorem volumeOmega_commutes_with_rotor (c s : ℝ) :
    volumeOmega * andreevRotor c s = andreevRotor c s * volumeOmega := by
  have hJ := cl22_volume_and_bivector_commutation.2.2.1
  unfold andreevRotor
  rw [mul_add, add_mul, Matrix.mul_smul, Matrix.smul_mul,
    Matrix.mul_smul, Matrix.smul_mul, hJ]
  simp only [mul_one, one_mul]

private theorem cast_volumeOmega_commutes_with_rotor (c s : ℝ) :
    Commute (castM4 volumeOmega) (castM4 (andreevRotor c s)) := by
  change (RingHom.mapMatrix (algebraMap ℝ ℂ) volumeOmega) *
      (RingHom.mapMatrix (algebraMap ℝ ℂ) (andreevRotor c s)) =
    (RingHom.mapMatrix (algebraMap ℝ ℂ) (andreevRotor c s)) *
      (RingHom.mapMatrix (algebraMap ℝ ℂ) volumeOmega)
  rw [← (RingHom.mapMatrix (algebraMap ℝ ℂ)).map_mul,
    ← (RingHom.mapMatrix (algebraMap ℝ ℂ)).map_mul]
  exact congrArg castM4 (volumeOmega_commutes_with_rotor c s)

/-- The finite Gibbs state generated by the doubled Clifford volume element is
invariant under conjugation by every normalized Andreev rotor.  The proof uses
only the existing matrix functional-calculus Gibbs owner, the existing Cl(2,2)
rotor inverse laws, and cyclicity of the native matrix trace. -/
theorem cl22_volume_gibbs_rotor_invariant
    (β c s : ℝ) (h_norm : c ^ 2 + s ^ 2 = 1)
    (X : M4C) :
    gibbsFunctional (castM4 volumeOmega) volumeOmega_hermitian β
      (castM4 (andreevRotor c s) * X * castM4 (andreevRotorRev c s)) =
    gibbsFunctional (castM4 volumeOmega) volumeOmega_hermitian β X := by
  let H : M4C := castM4 volumeOmega
  let R : M4C := castM4 (andreevRotor c s)
  let Rrev : M4C := castM4 (andreevRotorRev c s)
  let D := gibbsDensity H volumeOmega_hermitian β
  have hRR : R * Rrev = 1 := by
    exact normalized_rotor_cast_mul_reverse c s h_norm
  have hRrevR : Rrev * R = 1 := by
    exact normalized_reverse_mul_rotor_cast c s h_norm
  have hHR : Commute H R := cast_volumeOmega_commutes_with_rotor c s
  have hD : Commute D R := by
    unfold D gibbsDensity
    have hsa : IsSelfAdjoint H := volumeOmega_hermitian
    rw [← volumeOmega_hermitian.cfc_eq]
    exact hsa.commute_cfc hHR (expWeight β)
  rw [gibbsFunctional_apply, gibbsFunctional_apply]
  congr 1
  have htrace : Matrix.trace (D * (R * X * Rrev)) = Matrix.trace (D * X) := by
    calc
      Matrix.trace (D * (R * X * Rrev)) =
          Matrix.trace (R * (D * X * Rrev)) := by
        rw [show D * (R * X * Rrev) = (D * R) * X * Rrev by
          simp [mul_assoc], hD.eq]
        simp only [mul_assoc]
      _ = Matrix.trace ((D * X * Rrev) * R) := Matrix.trace_mul_comm _ _
      _ = Matrix.trace (D * X) := by
        rw [mul_assoc, hRrevR, mul_one]
  exact htrace

end InfoGeometry.Synthesis.Cl22ModularWave18
