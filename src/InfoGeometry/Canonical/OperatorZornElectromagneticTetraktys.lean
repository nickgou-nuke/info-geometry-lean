import InfoGeometry.Canonical.OperatorZornGaugeCovariance
import InfoGeometry.Canonical.OperatorZornMaxwellDivergence
import InfoGeometry.OperatorAlgebra.OperatorZornPeirceTetraktysBridge
import InfoGeometry.OperatorAlgebra.PeirceSpine.Tetraktys
import InfoGeometry.OperatorAlgebra.PeirceSpine.RingHomTransport
import InfoGeometry.Lie.SplitOctonionTetraktysAutomorphismCovariance
import Mathlib.Algebra.Algebra.Equiv

/-!
# Gauge-covariant operator electromagnetic curvature in the Zorn–Peirce basis

The coefficient ring is an arbitrary (possibly noncommutative) operator ring.
The Zorn carrier, its ordered cross products, and the Peirce tetraktys
superoperators are all retained.  This module connects coefficient-unit gauge
transport of the full Zorn curvature and Maxwell source equation to the
spatial `2 × 2` Peirce planes and their tetraktys double-commutator operators.
-/

namespace InfoGeometry.Canonical.OperatorZornElectromagneticTetraktys

open InfoGeometry.Canonical.OperatorZornFourPotentialGauge
open InfoGeometry.Canonical.OperatorZornGaugeCovariance
open InfoGeometry.Canonical.OperatorZornRepresentationCurvatureBridge
open InfoGeometry.OperatorAlgebra.OperatorZornPeirceTetraktysBridge
open InfoGeometry.OperatorAlgebra.PeirceSpine
open InfoGeometry.Physics.NCG
open scoped Matrix

variable {A : Type*} [Ring A]

/-- Entrywise coefficient conjugation on the full `2 × 2` chiral-plane operator ring. -/
def chiralPlaneGaugeHom (g : Aˣ) :
    Matrix (Fin 2) (Fin 2) A →+* Matrix (Fin 2) (Fin 2) A :=
  (coefficientConjugation g).mapMatrix (m := Fin 2)

theorem chiralPlaneGaugeHom_peirceSheetProj (g : Aˣ) :
    chiralPlaneGaugeHom g (peirceSheetProj (A := A)) = peirceSheetProj := by
  ext r s
  fin_cases r <;> fin_cases s <;>
    simp [chiralPlaneGaugeHom, peirceSheetProj, RingHom.mapMatrix_apply,
      coefficientConjugation]

theorem chiralPlaneGaugeHom_zornChiralPlane (g : Aˣ) (i : Fin 3)
    (X : OperatorZornMatrix A) :
    chiralPlaneGaugeHom g (zornChiralPlaneMatrix i X) =
      zornChiralPlaneMatrix i (OperatorZornGaugeCovariance.gauge g X) := by
  ext r s
  fin_cases r <;> fin_cases s <;>
    simp [chiralPlaneGaugeHom, zornChiralPlaneMatrix, RingHom.mapMatrix_apply,
      OperatorZornGaugeCovariance.gauge, mapCoefficients, mapOperatorVector, operatorZornCoordinates,
      coefficientConjugation]

/-- The three double-commutator superoperators generated by the Peirce
tetraktys basis are equivariant on every Zorn spatial plane.  Thus gauge
transport acts on the generators and on the operator being acted upon by the
same coefficient-ring automorphism. -/
theorem gauge_zorn_plane_tetraktys_superoperators (g : Aˣ) (i : Fin 3)
    (X Y : OperatorZornMatrix A) (T : Matrix (Fin 2) (Fin 2) A) :
    chiralPlaneGaugeHom g
        (derivSqPhi (peirceSheetProj (A := A))
          (zornChiralPlaneMatrix i X) (zornChiralPlaneMatrix i Y) T) =
      derivSqPhi (peirceSheetProj (A := A))
        (zornChiralPlaneMatrix i (OperatorZornGaugeCovariance.gauge g X))
        (zornChiralPlaneMatrix i (OperatorZornGaugeCovariance.gauge g Y)) (chiralPlaneGaugeHom g T) ∧
    chiralPlaneGaugeHom g
        (derivSqJ (peirceSheetProj (A := A))
          (zornChiralPlaneMatrix i X) (zornChiralPlaneMatrix i Y) T) =
      derivSqJ (peirceSheetProj (A := A))
        (zornChiralPlaneMatrix i (OperatorZornGaugeCovariance.gauge g X))
        (zornChiralPlaneMatrix i (OperatorZornGaugeCovariance.gauge g Y)) (chiralPlaneGaugeHom g T) ∧
    chiralPlaneGaugeHom g
        (derivSqSig (peirceSheetProj (A := A))
          (zornChiralPlaneMatrix i X) (zornChiralPlaneMatrix i Y) T) =
      derivSqSig (peirceSheetProj (A := A))
        (zornChiralPlaneMatrix i (OperatorZornGaugeCovariance.gauge g X))
        (zornChiralPlaneMatrix i (OperatorZornGaugeCovariance.gauge g Y)) (chiralPlaneGaugeHom g T) := by
  have hP := chiralPlaneGaugeHom_peirceSheetProj (A := A) g
  have hX := chiralPlaneGaugeHom_zornChiralPlane (A := A) g i X
  have hY := chiralPlaneGaugeHom_zornChiralPlane (A := A) g i Y
  exact ⟨by
      simpa only [hP, hX, hY] using
        (map_derivSqPhi (chiralPlaneGaugeHom g)
          (peirceSheetProj (A := A)) (zornChiralPlaneMatrix i X)
          (zornChiralPlaneMatrix i Y) T),
    by
      simpa only [hP, hX, hY] using
        (map_derivSqJ (chiralPlaneGaugeHom g)
          (peirceSheetProj (A := A)) (zornChiralPlaneMatrix i X)
          (zornChiralPlaneMatrix i Y) T),
    by
      simpa only [hP, hX, hY] using
        (map_derivSqSig (chiralPlaneGaugeHom g)
          (peirceSheetProj (A := A)) (zornChiralPlaneMatrix i X)
          (zornChiralPlaneMatrix i Y) T)⟩

/-- The repository's existing `3+1` electric and magnetic projections inherit
the same coefficient-unit gauge covariance as the full Zorn curvature. -/
theorem gauge_electric_magnetic_components (g : Aˣ)
    (p : Fin 4 → A) (Phi : FourPotential A) :
    (∀ i : Fin 3,
      OperatorZornGaugeCovariance.gauge g (electric p Phi i) =
        electric (fun k => coefficientConjugation g (p k))
          (fun k => OperatorZornGaugeCovariance.gauge g (Phi k)) i) ∧
    (∀ i : Fin 3,
      OperatorZornGaugeCovariance.gauge g (magnetic p Phi i) =
        magnetic (fun k => coefficientConjugation g (p k))
          (fun k => OperatorZornGaugeCovariance.gauge g (Phi k)) i) := by
  constructor
  · intro i
    exact gauge_fieldStrength g p Phi 0 i.succ
  · intro i
    fin_cases i <;> exact gauge_fieldStrength g p Phi _ _

/-- The operator-valued curvature is an alternating covariant two-form in its
spacetime indices.  Its gauge transport intertwines the tetraktys
superoperators on every spatial chiral plane. -/
theorem gauge_curvature_form_tetraktys_covariance (g : Aˣ)
    (p : Fin 4 → A) (Phi : FourPotential A) (mu nu : Fin 4)
    (i : Fin 3) (T : Matrix (Fin 2) (Fin 2) A) :
    fieldStrength p Phi nu mu = -fieldStrength p Phi mu nu ∧
    OperatorZornGaugeCovariance.gauge g (fieldStrength p Phi mu nu) =
      fieldStrength (fun k => coefficientConjugation g (p k))
        (fun k => OperatorZornGaugeCovariance.gauge g (Phi k)) mu nu ∧
    chiralPlaneGaugeHom g
        (derivSqPhi (peirceSheetProj (A := A))
          (zornChiralPlaneMatrix i (fieldStrength p Phi mu nu))
          (zornChiralPlaneMatrix i (fieldStrength p Phi mu nu)) T) =
      derivSqPhi (peirceSheetProj (A := A))
        (zornChiralPlaneMatrix i
          (fieldStrength
            (fun k => coefficientConjugation g (p k))
            (fun k => OperatorZornGaugeCovariance.gauge g (Phi k)) mu nu))
        (zornChiralPlaneMatrix i
          (fieldStrength
            (fun k => coefficientConjugation g (p k))
            (fun k => OperatorZornGaugeCovariance.gauge g (Phi k)) mu nu)) (chiralPlaneGaugeHom g T) ∧
    chiralPlaneGaugeHom g
        (derivSqJ (peirceSheetProj (A := A))
          (zornChiralPlaneMatrix i (fieldStrength p Phi mu nu))
          (zornChiralPlaneMatrix i (fieldStrength p Phi mu nu)) T) =
      derivSqJ (peirceSheetProj (A := A))
        (zornChiralPlaneMatrix i
          (fieldStrength
            (fun k => coefficientConjugation g (p k))
            (fun k => OperatorZornGaugeCovariance.gauge g (Phi k)) mu nu))
        (zornChiralPlaneMatrix i
          (fieldStrength
            (fun k => coefficientConjugation g (p k))
            (fun k => OperatorZornGaugeCovariance.gauge g (Phi k)) mu nu)) (chiralPlaneGaugeHom g T) ∧
    chiralPlaneGaugeHom g
        (derivSqSig (peirceSheetProj (A := A))
          (zornChiralPlaneMatrix i (fieldStrength p Phi mu nu))
          (zornChiralPlaneMatrix i (fieldStrength p Phi mu nu)) T) =
      derivSqSig (peirceSheetProj (A := A))
        (zornChiralPlaneMatrix i
          (fieldStrength
            (fun k => coefficientConjugation g (p k))
            (fun k => OperatorZornGaugeCovariance.gauge g (Phi k)) mu nu))
        (zornChiralPlaneMatrix i
          (fieldStrength
            (fun k => coefficientConjugation g (p k))
            (fun k => OperatorZornGaugeCovariance.gauge g (Phi k)) mu nu)) (chiralPlaneGaugeHom g T) := by
  have hPlane := gauge_zorn_plane_tetraktys_superoperators (A := A)
    g i (fieldStrength p Phi mu nu) (fieldStrength p Phi mu nu) T
  have hCurv := gauge_fieldStrength g p Phi mu nu
  refine ⟨fieldStrength_swap p Phi mu nu, hCurv, ?_⟩
  rcases hPlane with ⟨hPhi, hJ, hSig⟩
  rw [hCurv] at hPhi hJ hSig
  exact ⟨hPhi, hJ, hSig⟩

/-- Gauge covariance transports the full operator-valued Maxwell source equation,
with the current transformed in the same Zorn representation. -/
theorem gauge_maxwell_zorn_solution
    (g : Aˣ) (p : Fin 4 → A) (Phi : FourPotential A)
    (J : FourCurrent A)
    (hMaxwell : IsMaxwellZornSolution p Phi J) :
    IsMaxwellZornSolution
      (fun k => coefficientConjugation g (p k))
      (fun k => OperatorZornGaugeCovariance.gauge g (Phi k))
      (fun k => OperatorZornGaugeCovariance.gauge g (J k)) := by
  simpa [OperatorZornGaugeCovariance.gauge] using
    (mapCoefficients_maxwell_solution (coefficientConjugation g) p Phi J hMaxwell)

/-! ### The real `G₂` action as an operator-coefficient gauge action

The coefficient ring is now the full endomorphism algebra of the real Zorn
carrier.  The existing split-octonion automorphism acts on that ring by
conjugation.  Applying the already-proved coefficient transport to this ring
automorphism lifts the action to the maintained noncommutative operator-Zorn
product, its associator, and its electromagnetic curvature.
-/

abbrev RealZorn := InfoGeometry.Canonical.ZornMatrix ℝ
abbrev RealZornOperators := Module.End ℝ RealZorn
abbrev G2OperatorZorn := OperatorZornMatrix RealZornOperators

/-- The action of a real split-octonion automorphism on endomorphism
coefficients, expressed as the existing algebra equivalence by conjugation. -/
noncomputable def g2CoefficientAutomorphism
    (φ : InfoGeometry.Canonical.RealSplitOctonionAut) :
    RealZornOperators ≃ₐ[ℝ] RealZornOperators :=
  φ.1.conjAlgEquiv ℝ

/-- Lift the real `G₂` action to the full operator-Zorn carrier by the existing
entrywise ring-hom transport.  The Zorn multiplication remains the maintained
ordered noncommutative product. -/
noncomputable def g2OperatorZornAction
    (φ : InfoGeometry.Canonical.RealSplitOctonionAut) :
    G2OperatorZorn → G2OperatorZorn :=
  mapCoefficients (g2CoefficientAutomorphism φ).toRingHom

theorem g2OperatorZornAction_mul
    (φ : InfoGeometry.Canonical.RealSplitOctonionAut)
    (X Y : G2OperatorZorn) :
    g2OperatorZornAction φ (X * Y) =
      g2OperatorZornAction φ X * g2OperatorZornAction φ Y :=
  mapCoefficients_mul (g2CoefficientAutomorphism φ).toRingHom X Y

theorem g2OperatorZornAction_associator
    (φ : InfoGeometry.Canonical.RealSplitOctonionAut)
    (X Y Z : G2OperatorZorn) :
    g2OperatorZornAction φ (associator X Y Z) =
      associator (g2OperatorZornAction φ X)
        (g2OperatorZornAction φ Y) (g2OperatorZornAction φ Z) :=
  mapCoefficients_associator (g2CoefficientAutomorphism φ).toRingHom X Y Z

/-- The lifted split-octonion automorphism commutes with extraction of each
spatial chiral plane.  This is the carrier-level wire from the coefficient
action to the existing `2 × 2` Peirce representation. -/
theorem g2OperatorZornAction_chiralPlane (φ : InfoGeometry.Canonical.RealSplitOctonionAut)
    (i : Fin 3) (X : G2OperatorZorn) :
    (g2CoefficientAutomorphism φ).toRingHom.mapMatrix (zornChiralPlaneMatrix i X) =
      zornChiralPlaneMatrix i (g2OperatorZornAction φ X) := by
  apply Matrix.ext
  intro r
  intro s
  fin_cases r <;> fin_cases s <;>
    simp [g2OperatorZornAction, mapCoefficients, operatorZornCoordinates,
      mapOperatorVector, zornChiralPlaneMatrix]

/-- The (G₂)-lift fixes the Peirce sheet projector, so the universal
ring-hom transport laws for tetraktys superoperators apply to its action. -/
theorem g2OperatorZornAction_tetraktys_superoperators
    (φ : InfoGeometry.Canonical.RealSplitOctonionAut) (i : Fin 3)
    (X Y : G2OperatorZorn)
    (T : Matrix (Fin 2) (Fin 2) RealZornOperators) :
    (g2CoefficientAutomorphism φ).toRingHom.mapMatrix
        (derivSqPhi (peirceSheetProj (A := RealZornOperators))
          (zornChiralPlaneMatrix i X) (zornChiralPlaneMatrix i Y) T) =
      derivSqPhi (peirceSheetProj (A := RealZornOperators))
        (zornChiralPlaneMatrix i (g2OperatorZornAction φ X))
        (zornChiralPlaneMatrix i (g2OperatorZornAction φ Y))
        ((g2CoefficientAutomorphism φ).toRingHom.mapMatrix T) ∧
    (g2CoefficientAutomorphism φ).toRingHom.mapMatrix
        (derivSqJ (peirceSheetProj (A := RealZornOperators))
          (zornChiralPlaneMatrix i X) (zornChiralPlaneMatrix i Y) T) =
      derivSqJ (peirceSheetProj (A := RealZornOperators))
        (zornChiralPlaneMatrix i (g2OperatorZornAction φ X))
        (zornChiralPlaneMatrix i (g2OperatorZornAction φ Y))
        ((g2CoefficientAutomorphism φ).toRingHom.mapMatrix T) ∧
    (g2CoefficientAutomorphism φ).toRingHom.mapMatrix
        (derivSqSig (peirceSheetProj (A := RealZornOperators))
          (zornChiralPlaneMatrix i X) (zornChiralPlaneMatrix i Y) T) =
      derivSqSig (peirceSheetProj (A := RealZornOperators))
        (zornChiralPlaneMatrix i (g2OperatorZornAction φ X))
        (zornChiralPlaneMatrix i (g2OperatorZornAction φ Y))
        ((g2CoefficientAutomorphism φ).toRingHom.mapMatrix T) := by
  have hProj : (g2CoefficientAutomorphism φ).toRingHom.mapMatrix
      (peirceSheetProj (A := RealZornOperators)) = peirceSheetProj := by
    apply Matrix.ext
    intro r
    intro s
    fin_cases r <;> fin_cases s <;>
      simp [peirceSheetProj, RingHom.mapMatrix_apply]
  have hX := g2OperatorZornAction_chiralPlane φ i X
  have hY := g2OperatorZornAction_chiralPlane φ i Y
  exact ⟨by
      simpa only [hProj, hX, hY] using
        (map_derivSqPhi ((g2CoefficientAutomorphism φ).toRingHom.mapMatrix)
          (peirceSheetProj (A := RealZornOperators))
          (zornChiralPlaneMatrix i X) (zornChiralPlaneMatrix i Y) T),
    by
      simpa only [hProj, hX, hY] using
        (map_derivSqJ ((g2CoefficientAutomorphism φ).toRingHom.mapMatrix)
          (peirceSheetProj (A := RealZornOperators))
          (zornChiralPlaneMatrix i X) (zornChiralPlaneMatrix i Y) T),
    by
      simpa only [hProj, hX, hY] using
        (map_derivSqSig ((g2CoefficientAutomorphism φ).toRingHom.mapMatrix)
          (peirceSheetProj (A := RealZornOperators))
          (zornChiralPlaneMatrix i X) (zornChiralPlaneMatrix i Y) T)⟩

theorem g2OperatorZornAction_fieldStrength
    (φ : InfoGeometry.Canonical.RealSplitOctonionAut)
    (p : Fin 4 → RealZornOperators)
    (Phi : FourPotential RealZornOperators) (mu nu : Fin 4) :
    g2OperatorZornAction φ (fieldStrength p Phi mu nu) =
      fieldStrength
        (fun i => g2CoefficientAutomorphism φ (p i))
        (fun i => g2OperatorZornAction φ (Phi i)) mu nu :=
  mapCoefficients_fieldStrength (g2CoefficientAutomorphism φ).toRingHom
    p Phi mu nu

theorem g2OperatorZornAction_bianchi
    (φ : InfoGeometry.Canonical.RealSplitOctonionAut)
    (p : Fin 4 → RealZornOperators)
    (Phi : FourPotential RealZornOperators) (mu nu rho : Fin 4) :
    g2OperatorZornAction φ (bianchi p Phi mu nu rho) =
      bianchi
        (fun i => g2CoefficientAutomorphism φ (p i))
        (fun i => g2OperatorZornAction φ (Phi i)) mu nu rho :=
  mapCoefficients_bianchi (g2CoefficientAutomorphism φ).toRingHom
    p Phi mu nu rho

end InfoGeometry.Canonical.OperatorZornElectromagneticTetraktys
