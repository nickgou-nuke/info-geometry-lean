import Mathlib.Algebra.Ring.Basic
import Mathlib.Algebra.Module.Basic
import Mathlib.Algebra.Algebra.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Tactic.NoncommRing

/-!
# Tripotent adjoint derivation calculus

This file records the generic algebraic layer for the commutator derivation
`ad_e = L_e - R_e`.  It proves additive grade closure for multiplication and
for the commutator bracket.  It does not construct Peirce projectors, a five
grading, or a TKK algebra.
-/

namespace InfoGeometry.Physics.Algebra

variable {A : Type*} [Ring A] [Algebra ℝ A]

/-- The polynomial relation defining a tripotent element. -/
def IsTripotent (e : A) : Prop :=
  e * e * e = e

/-- The inner commutator derivation generated by `e`. -/
def adOp (e x : A) : A :=
  e * x - x * e

/-- Compatibility name for the inner commutator action. -/
abbrev commutatorAction (e x : A) : A := adOp e x

/-- Predicate saying that `x` is an eigenvector of the commutator action. -/
def IsCommutatorComponent (e x : A) (r : ℝ) : Prop :=
  commutatorAction e x = r • x

/-- An inner commutator is a derivation of the associative product. -/
theorem adOp_mul (e x y : A) :
    adOp e (x * y) = adOp e x * y + x * adOp e y := by
  unfold adOp
  noncomm_ring

@[simp] theorem commutatorAction_add (e x y : A) :
    commutatorAction e (x + y) =
      commutatorAction e x + commutatorAction e y := by
  unfold commutatorAction adOp
  noncomm_ring

@[simp] theorem commutatorAction_sub (e x y : A) :
    commutatorAction e (x - y) =
      commutatorAction e x - commutatorAction e y := by
  unfold commutatorAction adOp
  noncomm_ring

@[simp] theorem commutatorAction_smul (e : A) (r : ℝ) (x : A) :
    commutatorAction e (r • x) = r • commutatorAction e x := by
  simp only [commutatorAction, adOp]
  rw [Algebra.mul_smul_comm r e x,
    Algebra.smul_mul_assoc r x e, smul_sub]

theorem commutatorAction_product_component
    {e x y : A} {r s : ℝ}
    (hx : IsCommutatorComponent e x r)
    (hy : IsCommutatorComponent e y s) :
    IsCommutatorComponent e (x * y) (r + s) := by
  unfold IsCommutatorComponent at hx hy ⊢
  change adOp e x = r • x at hx
  change adOp e y = s • y at hy
  change adOp e (x * y) = (r + s) • (x * y)
  rw [adOp_mul, hx, hy]
  rw [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, ← add_smul]

theorem commutatorAction_bracket_component
    {e x y : A} {r s : ℝ}
    (hx : IsCommutatorComponent e x r)
    (hy : IsCommutatorComponent e y s) :
    IsCommutatorComponent e (x * y - y * x) (r + s) := by
  have hxy :
      commutatorAction e (x * y) = (r + s) • (x * y) :=
    commutatorAction_product_component hx hy
  have hyx :
      commutatorAction e (y * x) = (r + s) • (y * x) := by
    simpa [add_comm] using commutatorAction_product_component hy hx
  unfold IsCommutatorComponent
  rw [commutatorAction_sub, hxy, hyx, smul_sub]

/-- Left multiplication by `e`, as an `ℝ`-linear map. -/
def leftMulLinear (e : A) : A →ₗ[ℝ] A where
  toFun x := e * x
  map_add' x y := mul_add e x y
  map_smul' c x := Algebra.mul_smul_comm c e x

@[simp] theorem leftMulLinear_apply (e x : A) : leftMulLinear e x = e * x := rfl

/-- Right multiplication by `e`, as an `ℝ`-linear map. -/
def rightMulLinear (e : A) : A →ₗ[ℝ] A where
  toFun x := x * e
  map_add' x y := add_mul x y e
  map_smul' c x := Algebra.smul_mul_assoc c x e

@[simp] theorem rightMulLinear_apply (e x : A) : rightMulLinear e x = x * e := rfl

/-- The bundled inner derivation `L_e - R_e`. -/
def adLinear (e : A) : A →ₗ[ℝ] A :=
  leftMulLinear e - rightMulLinear e

/-- The commutator action as a bundled real-linear map. -/
abbrev commutatorActionLinear (e : A) : A →ₗ[ℝ] A := adLinear e

@[simp] theorem commutatorActionLinear_apply (e x : A) :
    commutatorActionLinear e x = commutatorAction e x := rfl

@[simp] theorem adLinear_apply (e x : A) :
    adLinear e x = adOp e x := rfl

/-- The eigenspace of `ad_e` with integer grade `k`. -/
def adGrade (e : A) (k : ℤ) : Submodule ℝ A :=
  LinearMap.ker (adLinear e - (k : ℝ) • (LinearMap.id : A →ₗ[ℝ] A))

theorem mem_adGrade_iff {e x : A} {k : ℤ} :
    x ∈ adGrade e k ↔ adOp e x = (k : ℝ) • x := by
  change ((adLinear e - (k : ℝ) • (LinearMap.id : A →ₗ[ℝ] A)) x) = 0 ↔ _
  simp only [LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply,
    sub_eq_zero]
  rfl

/-- Product of homogeneous elements has the sum of their grades. -/
theorem mul_mem_adGrade_add {e x y : A} {i j : ℤ}
    (hx : x ∈ adGrade e i) (hy : y ∈ adGrade e j) :
    x * y ∈ adGrade e (i + j) := by
  rw [mem_adGrade_iff] at hx hy ⊢
  rw [adOp_mul, hx, hy]
  rw [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, ← add_smul]
  rw [Int.cast_add]

/-- The commutator bracket has the sum of the input grades. -/
theorem commutator_mem_adGrade_add {e x y : A} {i j : ℤ}
    (hx : x ∈ adGrade e i) (hy : y ∈ adGrade e j) :
    x * y - y * x ∈ adGrade e (i + j) := by
  have hxy : x * y ∈ adGrade e (i + j) :=
    mul_mem_adGrade_add hx hy
  have hyx : y * x ∈ adGrade e (j + i) :=
    mul_mem_adGrade_add hy hx
  rw [add_comm j i] at hyx
  exact (adGrade e (i + j)).sub_mem hxy hyx

end InfoGeometry.Physics.Algebra
