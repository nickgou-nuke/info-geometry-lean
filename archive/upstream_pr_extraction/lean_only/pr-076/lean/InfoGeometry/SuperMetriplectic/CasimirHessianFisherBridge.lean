import Mathlib.Analysis.CStarAlgebra.GelfandNaimarkSegal
import InfoGeometry.OperatorAlgebra.ConstructiveCasimir
import InfoGeometry.Algebra.CuntzNativeGNSBridge

/-!
# Noncommutative Casimir--BKM/Fisher bridge

This owner uses the observable algebra as the primary carrier.  It does not
introduce a scalar coordinate plane, a diagonal metric, or a scalar Casimir
potential.

The Casimir is an actual element of an associative algebra and its centrality
is obtained from the explicit quadratic cancellation law owned by
`VerifiedQuadraticCasimir`.  The Fisher positivity statement is the native
positive-functional statement

`Re (φ (a⋆ * a)) ≥ 0`.

The GNS expectation and modular derivation are downstream readouts of the same
observable algebra.  No commutativity or diagonalisation is used.
-/

noncomputable section

open scoped ComplexOrder InnerProductSpace

namespace InfoGeometry.SuperMetriplectic.CasimirHessianFisher

open InfoGeometry.OperatorAlgebra.ConstructiveCasimir

universe u v

variable {A : Type u}
variable {ι : Type v} [Fintype ι]

/-! ## Observable-algebra Casimir and modular derivation -/

/-- The inner modular derivation generated by `H`. -/
def modularDerivation {A : Type u} [Ring A] (H a : A) : A := H * a - a * H

theorem modularDerivation_mul {A : Type u} [Ring A] (H a b : A) :
    modularDerivation H (a * b) =
      modularDerivation H a * b + a * modularDerivation H b := by
  simpa [modularDerivation] using assocCommutator_mul_right H a b

theorem modularDerivation_add {A : Type u} [Ring A] (H a b : A) :
    modularDerivation H (a + b) =
      modularDerivation H a + modularDerivation H b := by
  simpa [modularDerivation] using assocCommutator_add_right H a b

/-- A noncommutative Casimir datum together with a positive state. -/
structure NoncommutativeCasimirFisherData
    (A : Type u) (ι : Type v)
    [Fintype ι]
    [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A] where
  casimir : VerifiedQuadraticCasimir A ι
  state : A →ₚ[ℂ] ℂ
  modularGenerator : A

namespace NoncommutativeCasimirFisherData

variable [Fintype ι]
variable [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
variable (D : NoncommutativeCasimirFisherData A ι)

/-- The actual quadratic Casimir element in the observable algebra. -/
def casimirElement : A := D.casimir.element

/-- Centrality is inherited from the explicit quadratic cancellation theorem. -/
theorem casimirElement_isCentral :
    IsCentral D.casimirElement := by
  exact D.casimir.isCentral

/-- The Casimir is fixed by the modular derivation generated by any observable. -/
theorem modularDerivation_casimir_zero (H : A) :
    modularDerivation H D.casimirElement = 0 := by
  simpa [modularDerivation] using (casimirElement_isCentral D) H

/-- Every unit conjugation fixes the noncommutative Casimir. -/
theorem casimirElement_unitConjugationInvariant :
    IsUnitConjugationInvariant D.casimirElement := by
  exact VerifiedQuadraticCasimir.unitConjugationInvariant D.casimir

/-! ## Positive Fisher quadratic on the native C*-algebra -/

/-- The Fisher/BKM quadratic readout of an observable variation. -/
def fisherQuadratic (a : A) : ℝ :=
  (D.state (star a * a)).re

theorem fisherQuadratic_nonneg (a : A) :
    0 ≤ D.fisherQuadratic a := by
  exact (Complex.nonneg_iff.mp
    (PositiveLinearMap.map_nonneg D.state
      (CStarAlgebra.nonneg_iff_eq_star_mul_self.mpr ⟨a, rfl⟩))).1

theorem fisherQuadratic_real (a : A) :
    (D.state (star a * a)).im = 0 := by
  exact (Complex.nonneg_iff.mp
    (PositiveLinearMap.map_nonneg D.state
      (CStarAlgebra.nonneg_iff_eq_star_mul_self.mpr ⟨a, rfl⟩))).2.symm

/-! ## Native GNS realization -/

theorem gns_expectation_of (a : A) :
    ⟪InfoGeometry.Algebra.CuntzNativeGNSBridge.gnsVacuum D.state,
      InfoGeometry.Algebra.CuntzNativeGNSBridge.cuntzGNSRepresentation D.state a
        (InfoGeometry.Algebra.CuntzNativeGNSBridge.gnsVacuum D.state)⟫_ℂ = D.state a := by
  exact InfoGeometry.Algebra.CuntzNativeGNSBridge.gns_state_expectation_recovery D.state a

theorem gns_fisherQuadratic_nonneg (a : A) :
    0 ≤ (⟪InfoGeometry.Algebra.CuntzNativeGNSBridge.gnsVacuum D.state,
      InfoGeometry.Algebra.CuntzNativeGNSBridge.cuntzGNSRepresentation D.state
        (star a * a)
        (InfoGeometry.Algebra.CuntzNativeGNSBridge.gnsVacuum D.state)⟫_ℂ).re := by
  rw [gns_expectation_of D (star a * a)]
  exact fisherQuadratic_nonneg D a

end NoncommutativeCasimirFisherData

end InfoGeometry.SuperMetriplectic.CasimirHessianFisher
