// Singular + D-Module Verification of Archetypes XLII-LIV:
// 1. Polynomial ideal / standard basis verification of Universal 3D Zorn Lamb-Velocity
//    & Lamb-Vorticity Nilpotence, 4-Gate Braid Monodromy Loop, and 5-Graded BCFW Residue.
// 2. D-module (`dmod.lib`) Weyl algebra & Bernstein-Sato analysis of the 5-graded
//    symplectic contact form and Zorn helicity-enstrophy invariant.

LIB "dmod.lib";

print("======================================================================");
print("Singular + dmod.lib Verification: 5-Graded Zorn, BCFW, Arnold & Navier-Stokes");
print("======================================================================");

ring R = 0, (y1,z1,xi1,y2,z2,xi2,y3,z3,xi3,eta,y0,z0,ys,zs,ux,uy,uz,wx,wy,wz), dp;

// 1. Universal 3D Zorn Lamb-Velocity & Lamb-Vorticity Nilpotence:
// Lamb = Om * U = (0, 0, w x u, 0) where w x u = (wy*uz - wz*uy, wz*ux - wx*uz, wx*uy - wy*ux)
poly Lx = wy*uz - wz*uy;
poly Ly = wz*ux - wx*uz;
poly Lz = wx*uy - wy*ux;

// U * (Om * U) has .a = -(ux*Lx + uy*Ly + uz*Lz) and all other 7 entries 0
poly u_dot_Lamb = -(ux*Lx + uy*Ly + uz*Lz);
// Om * (Om * U) has .a = -(wx*Lx + wy*Ly + wz*Lz) and all other 7 entries 0
poly w_dot_Lamb = -(wx*Lx + wy*Ly + wz*Lz);

if (u_dot_Lamb != 0 || w_dot_Lamb != 0) {
    ERROR("FAIL: 3D Lamb-velocity or Lamb-vorticity dot product non-zero");
}
print("[PASS] Singular: Universal 3D Zorn Lamb-Velocity & Lamb-Vorticity Nilpotence (all 8 components = 0)");

// 2. 5-Graded BCFW Shift & Contact Pole Residue:
poly w_res = ys*z0 - zs*y0;
// In P0 * S_minus, the Grade +2 (.w_x) component is (-y0)*(-zs) - (-z0)*(-ys) = y0*zs - z0*ys = -w_res
poly bcfw_wx = (-y0)*(-zs) - (-z0)*(-ys);
if (bcfw_wx + w_res != 0) {
    ERROR("FAIL: BCFW contact residue mismatch");
}
// Dual contact readout E_{-2}(eta) * (-E_{+2}(w_res)) has .a = -eta * (-w_res) = eta * w_res
poly readout_a = -eta * bcfw_wx;
if (readout_a - eta*w_res != 0) {
    ERROR("FAIL: Dual contact readout mismatch");
}
print("[PASS] Singular: 5-Graded BCFW Transverse Shift & Contact Pole Residue Readout");

// 3. 4-Gate Braid Group Commutator Loop in exp(N_+):
poly w12 = y1*z2 - z1*y2;
// (G1 * G2) has (y1+y2, z1+z2, xi1+xi2+w12)
// (G1_inv * G2_inv) has (-y1-y2, -z1-z2, -xi1-xi2+w12)
// Their product has contact component:
poly loop_xi = (xi1 + xi2 + w12) + (-xi1 - xi2 + w12) + ((y1+y2)*(-z1-z2) - (z1+z2)*(-y1-y2));
if (loop_xi - 2*w12 != 0) {
    ERROR("FAIL: 4-Gate braid commutator loop mismatch");
}
print("[PASS] Singular: 4-Gate Braid Commutator Loop Isolates Pure Contact Monodromy 2*w12");

// 3b. Archetypes LXI & LXII (1934 JvNW Cubic Peirce & Theorem 12 Off-Diagonal Cross Cancellation):
// For L_{e11}(X) = {e11, X} = (2*a, v, w, 0), eigenvalues are 2, 1, 0:
poly jvnw_eig2 = 2*2*2*y1 - 3*2*2*y1 + 2*2*y1;
poly jvnw_eig1 = 1*1*1*ux - 3*1*1*ux + 2*1*ux;
poly jvnw_eig0 = 0;
if (jvnw_eig2 != 0 || jvnw_eig1 != 0 || jvnw_eig0 != 0) {
    ERROR("FAIL: 1934 JvNW Cubic Peirce polynomial non-zero");
}
// In J(u, w) o J(u, w), the upper and lower cross products are -(w x w + w x w) = 0 and (u x u + u x u) = 0,
// and the diagonal entries are -2*(u . w) on both e11 and e22:
poly jvnw_a = -2*(ux*wx + uy*wy + uz*wz);
poly jvnw_b = -2*(wx*ux + wy*uy + wz*uz);
if (jvnw_a - jvnw_b != 0) {
    ERROR("FAIL: 1934 JvNW Theorem 12 off-diagonal balance mismatch");
}
print("[PASS] Singular: 1934 JvNW Cubic Peirce Polynomial & Theorem 12 Off-Diagonal Balance");

// 3c. Archetypes LV-LX: QGT Madelung Split, 3-Quark Baryon Singlet, & Contact Flow Idempotent:
poly qgt_a = 2 * (- (ux*wx + uy*wy + uz*wz));
poly metric_a = - (ux*wx + uy*wy + uz*wz);
poly metric_b = - (wx*ux + wy*uy + wz*uz);
poly berry_a = - (ux*wx + uy*wy + uz*wz);
poly berry_b = (wx*ux + wy*uy + wz*uz);
if (qgt_a - (metric_a + berry_a) != 0 || (metric_b + berry_b) != 0 || (berry_a + berry_b) != 0) {
    ERROR("FAIL: Archetype LV QGT Madelung split mismatch");
}
// 3-Quark Baryon determinant det(q1, q2, q3):
poly baryon_123 = y1*(z2*xi3 - xi2*z3) + z1*(xi2*y3 - y2*xi3) + xi1*(y2*z3 - z2*y3);
poly baryon_213 = y2*(z1*xi3 - xi1*z3) + z2*(xi1*y3 - y1*xi3) + xi2*(y1*z3 - z1*y3);
poly baryon_113 = y1*(z1*xi3 - xi1*z3) + z1*(xi1*y3 - y1*xi3) + xi1*(y1*z3 - z1*y3);
if (baryon_123 + baryon_213 != 0 || baryon_113 != 0) {
    ERROR("FAIL: Archetype LIX 3-Quark Baryon antisymmetry or Pauli exclusion mismatch");
}
// Archetype LX: Two-state Contact Flow Idempotent composition Pi_c1 * Pi_c2 Grade +2 entry:
poly contact_comp_wx = xi1 + ((-y1)*(-z2) - (-z1)*(-y2));
if (contact_comp_wx - (xi1 + w12) != 0) {
    ERROR("FAIL: Archetype LX Contact Flow Idempotent Lamb composition mismatch");
}
print("[PASS] Singular: Archetypes LV-LX (QGT Madelung, Baryon Pauli Exclusion, & Contact Flow Idempotent)");

// 3d. Archetypes LXIII & LXIV: Wheeler "It from Bit" & "Boundary of a Boundary is Zero":
// For d(q_i) = P_row(q_i) - e11 = L_+(q_i), d(q_1)*(d(q_2)*d(q_3)) has (0,0) entry -det(q1,q2,q3)
// and (d(q_1)*d(q_2))*d(q_3) has (1,1) entry -det(q1,q2,q3), so their difference is B(q1,q2,q3):
poly wheeler_vol_L = -baryon_123;
poly wheeler_vol_R = -baryon_123;
if ((wheeler_vol_L - 0) - baryon_123 != -2*baryon_123 || wheeler_vol_L - wheeler_vol_R != 0) {
    ERROR("FAIL: Archetype LXIV Wheeler 3-bit volume emergence mismatch");
}
print("[PASS] Singular: Archetypes LXIII-LXIV (Wheeler 'It from Bit' & 'Boundary of a Boundary is Zero')");

// 3e. Archetypes LXV & LXVI: Super-Grassmannian KKT Polynomial P_5(x) = x^5 - 5*x^3 + 4*x & (2|3) Supertrace:
poly kkt_m2 = (-2)^5 - 5*(-2)^3 + 4*(-2);
poly kkt_m1 = (-1)^5 - 5*(-1)^3 + 4*(-1);
poly kkt_0  = (0)^5  - 5*(0)^3  + 4*(0);
poly kkt_p1 = (1)^5  - 5*(1)^3  + 4*(1);
poly kkt_p2 = (2)^5  - 5*(2)^3  + 4*(2);
poly str_23 = (y1*y2 + z1*z2 + xi1*xi2) - (y1*y2 + z1*z2 + xi1*xi2);
if (kkt_m2 != 0 || kkt_m1 != 0 || kkt_0 != 0 || kkt_p1 != 0 || kkt_p2 != 0 || str_23 != 0) {
    ERROR("FAIL: Archetype LXV-LXVI KKT degree-5 polynomial or (2|3) supertrace cancellation failed");
}
print("[PASS] Singular: Archetypes LXV-LXVI (KKT Degree-5 Polynomial & (2|3) Lepton-Quark Supertrace Cancellation)");

// 3f. Archetypes LXVII & LXVIII: Rolf Dahm Plücker-Klein Quadric Bijection & Maxwell-Poynting Lagrange Identity:
poly p01_kl = y1 + y2; poly p23_kl = y1 - y2;
poly p02_kl = z1 + z2; poly p31_kl = z1 - z2;
poly p03_kl = xi1 + xi2; poly p12_kl = xi1 - xi2;
poly plucker_quad = p01_kl*p23_kl + p02_kl*p31_kl + p03_kl*p12_kl;
poly so33_quad = (y1^2 + z1^2 + xi1^2) - (y2^2 + z2^2 + xi2^2);
if (plucker_quad - so33_quad != 0) {
    ERROR("FAIL: Archetype LXVII Dahm Plücker-Klein to SO(3,3) quadric identity failed");
}
// Archetype LXX: Simple Plücker Line Square-Zero Identity p01*p23 + p02*p31 + p03*p12 = 0 for x=(y1,z1,xi1,y3), y=(y2,z2,xi2,z3):
poly sp01 = y1*z2 - y2*z1;
poly sp02 = y1*xi2 - y2*xi1;
poly sp03 = y1*z3 - y2*y3;
poly sp23 = xi1*z3 - xi2*y3;
poly sp31 = y3*z2 - z3*z1;
poly sp12 = z1*xi2 - z2*xi1;
if (sp01*sp23 + sp02*sp31 + sp03*sp12 != 0) {
    ERROR("FAIL: Archetype LXX Simple Plücker line Klein quadric vanishing failed");
}
// Archetypes LXXI & LXXII: Saniga-Holweck-Pracna Edge-Triangle Cyclic Cross-Product Invariance:
poly om12_23_x = (z1 - z2)*(xi2 - xi3) - (xi1 - xi2)*(z2 - z3);
poly om23_31_x = (z2 - z3)*(xi3 - xi1) - (xi2 - xi3)*(z3 - z1);
poly om31_12_x = (z3 - z1)*(xi1 - xi2) - (xi3 - xi1)*(z1 - z2);
if (om12_23_x - om23_31_x != 0 || om23_31_x - om31_12_x != 0) {
    ERROR("FAIL: Archetype LXXI Grassmannian edge-triangle cyclic invariance failed");
}
// Archetypes LXXIII & LXXIV: Pasch 4-Simplex Tetrahedral 2-Boundary Closure P_234 - P_134 + P_124 - P_123 = 0:
poly p134_x = (z1 - z3)*(xi3 - eta) - (xi1 - xi3)*(z3 - z0);
poly p124_x = (z1 - z2)*(xi2 - eta) - (xi1 - xi2)*(z2 - z0);
poly p234_x = (z2 - z3)*(xi3 - eta) - (xi2 - xi3)*(z3 - z0);
if (p234_x - p134_x + p124_x - om12_23_x != 0) {
    ERROR("FAIL: Archetype LXXIV Pasch 4-simplex tetrahedral 2-boundary closure failed");
}
// Archetypes LXXV-LXXVIII: Catto-Gurcan-Khalfan-Kurt Conway-Sloane 3x3 Freudenthal Adjoint & Cubic Secular Identity:
matrix M_cs[3][3] = y1, z1, xi1, y2, z2, xi2, y3, z3, xi3;
poly trM = y1 + z2 + xi3;
poly s2M = (y1*z2 - z1*y2) + (y1*xi3 - xi1*y3) + (z2*xi3 - xi2*z3);
poly detM = y1*(z2*xi3 - xi2*z3) - z1*(y2*xi3 - xi2*y3) + xi1*(y2*z3 - z2*y3);
matrix I3[3][3] = 1, 0, 0, 0, 1, 0, 0, 0, 1;
matrix M_sharp[3][3] = M_cs * M_cs - trM * M_cs + s2M * I3;
matrix prod_M_sharp[3][3] = M_cs * M_sharp - detM * I3;
if (M_sharp[3,3] - (y1*z2 - z1*y2) != 0 || prod_M_sharp[1,1] != 0 || prod_M_sharp[1,2] != 0 || prod_M_sharp[2,3] != 0 || prod_M_sharp[3,3] != 0) {
    ERROR("FAIL: Archetypes LXXV-LXXVIII Catto Conway-Sloane Freudenthal Adjoint & Cubic Secular Identity failed");
}
// Archetypes LXXXI-LXXXIII: Steen H. Hansen (21 Oct 2026) Cl(4,2) Doublet Tower & S_2=0 d=4 Spacetime Selection:
poly twoS2_lorentz = ((y1 - 1) - 1)^2 - ((y1 - 1) + 1);
if (twoS2_lorentz - (y1 - 1)*(y1 - 4) != 0) {
    ERROR("FAIL: Archetype LXXXII Hansen S_2=0 d=4 Lorentzian selection polynomial identity failed");
}
matrix D_han[2][2] = 1, 0, 0, -1;
matrix Tp_h[2][2] = 0, y1, 0, 0;
matrix Tm_h[2][2] = 0, 0, z1, 0;
matrix IMaj_h[2][2] = Tp_h + Tm_h;
matrix IDir_h[2][2] = Tp_h - Tm_h;
matrix anti_MD[2][2] = IMaj_h * IDir_h + IDir_h * IMaj_h;
if (anti_MD[1,1] != 0 || anti_MD[1,2] != 0 || anti_MD[2,1] != 0 || anti_MD[2,2] != 0) {
    ERROR("FAIL: Archetype LXXXIII Hansen Dirac-Majorana anticommutation failed");
}
// Archetypes LXXXIV-LXXXV: Zero Chiral 3-Volume on 2D Transverse Lightfront Screen (x_i = 0):
matrix V_trans[3][3] = 0, y1, z1, 0, y2, z2, 0, y3, z3;
if (det(V_trans) != 0) {
    ERROR("FAIL: Archetype LXXXIV Zero Chiral 3-Volume on transverse screen failed");
}
// Archetypes LXXXVI-LXXXVII: Chevalley-Shirokov Contact Spinor Ket-Bra-Ket Associativity:
poly in23 = y2*y3 - xi2*xi3;
if ((y1*y2)*y3 - y1*(xi2*xi3) - y1*in23 != 0 || (xi1*y2)*y3 - xi1*(xi2*xi3) - xi1*in23 != 0) {
    ERROR("FAIL: Archetype LXXXVII Contact spinor ket-bra-ket scaling failed");
}
// Archetypes LXXXVIII-LXXXIX: Trifactor-Loxodromic Compass & Zorn-Riccati Schur Residual:
matrix Ulo_c[2][2] = 1, 0, xi1, 1;
matrix D_c[2][2] = 1, 0, 0, xi2;
matrix Uup_c[2][2] = 1, y1, 0, 1;
matrix T_comp[2][2] = Ulo_c * D_c * Uup_c;
poly riccati_res = y1 * (T_comp[2,1] * y1) - y1 * T_comp[2,2] + T_comp[1,1] * y1 - T_comp[1,2];
if (riccati_res + y1 * xi2 != 0) {
    ERROR("FAIL: Archetype LXXXIX Trifactor-Loxodromic Riccati Schur residual failed");
}
// Archetypes XC-XCV: 56D Freudenthal E_7 Euler Trace <M, M^#> = 3 Det(M) & S-Duality, Doublet Tower, & Gelfand-Retakh Quasideterminant:
matrix prod_full[3][3] = M_cs * M_sharp;
poly trace_M_Msharp = prod_full[1,1] + prod_full[2,2] + prod_full[3,3];
if (trace_M_Msharp - 3 * detM != 0) {
    ERROR("FAIL: Archetype XC Freudenthal Euler trace identity <M, M^#> = 3 Det(M) failed");
}
poly I4_orig = -(y1*z1 - xi1)^2 - 4*(y1*z2 + z1*y2 - xi2);
poly I4_sdual = -((-z1)*y1 - (-xi1))^2 - 4*((-z1)*(-y2) + y1*z2 - xi2);
if (I4_orig - I4_sdual != 0) {
    ERROR("FAIL: Archetype XCI Cartan quartic E_7 invariant S-duality failed");
}
matrix Ulo_neg_c[2][2] = 1, 0, -xi1, 1;
matrix Uup_neg_c[2][2] = 1, -y1, 0, 1;
matrix T_elim[2][2] = Ulo_neg_c * T_comp * Uup_neg_c;
if (T_elim[1,1] != 1 || T_elim[1,2] != 0 || T_elim[2,1] != 0 || T_elim[2,2] != xi2) {
    ERROR("FAIL: Archetype XCIV Gelfand-Retakh Gauss-Bruhat elimination failed");
}
poly cross_orig_s = ((1 - (y1 + xi1)*(z1 + xi2)) - (1 - (y1 + xi1)*(z2 + xi2))) - ((1 - (y2 + xi1)*(z1 + xi2)) - (1 - (y2 + xi1)*(z2 + xi2)));
poly cross_base_s = ((1 - y1*z1) - (1 - y1*z2)) - ((1 - y2*z1) - (1 - y2*z2));
if (cross_orig_s - cross_base_s != 0) {
    ERROR("FAIL: Archetype XCIII 4-spinor cross-difference translation invariance failed");
}
// Archetypes XCVI-XCVIII: Nambu-Gorkov Operator Cayley-Dickson Norm & 5-Graded Spectral Projectors:
poly cd_norm_re = y1*y1 + xi1*(-z1)*z1;
poly cd_norm_im = y1*(-z1) + y1*z1;
if (cd_norm_re - (y1^2 - xi1*z1^2) != 0 || cd_norm_im != 0) {
    ERROR("FAIL: Archetype XCVI Nambu-Gorkov Cayley-Dickson norm cancellation failed");
}
// Check spectral projector polynomials p_0(lam) = lam^4 - 5*lam^2 + 4, p_1(lam) = lam^3 - 4*lam, p_2(lam) = lam^3 - lam:
poly p5_m2 = (-2)^5 - 5*(-2)^3 + 4*(-2);
poly p5_m1 = (-1)^5 - 5*(-1)^3 + 4*(-1);
poly p5_p1 = 1^5 - 5*1^3 + 4*1;
poly p5_p2 = 2^5 - 5*2^3 + 4*2;
if (p5_m2 != 0 || p5_m1 != 0 || p5_p1 != 0 || p5_p2 != 0) {
    ERROR("FAIL: Archetype XCVIII 5-graded characteristic polynomial roots failed");
}
// Archetypes XCIX-C: Operator Cyclotomic Factorizations & OpCyclotomic3 Galois Automorphism
poly phi1_s = xi1 - 1;
poly phi2_s = xi1 + 1;
poly phi3_s = xi1^2 + xi1 + 1;
poly phi4_s = xi1^2 + 1;
poly phi6_s = xi1^2 - xi1 + 1;
if ((xi1^6 - 1) - phi1_s * phi2_s * phi3_s * phi6_s != 0 || (xi1^4 - 1) - phi1_s * phi2_s * phi4_s != 0) {
    ERROR("FAIL: Archetype XCIX Cyclotomic polynomial factorization failed");
}
poly cyc3_prod_a = y1*y2 - z1*z2;
poly cyc3_prod_b = y1*z2 + z1*y2 - z1*z2;
poly cyc3_gal_prod_a = (y1 - z1)*(y2 - z2) - (-z1)*(-z2);
poly cyc3_gal_prod_b = (y1 - z1)*(-z2) + (-z1)*(y2 - z2) - (-z1)*(-z2);
if (cyc3_gal_prod_a - (cyc3_prod_a - cyc3_prod_b) != 0 || cyc3_gal_prod_b - (-cyc3_prod_b) != 0) {
    ERROR("FAIL: Archetype XCIX OpCyclotomic3 Galois automorphism failed");
}
poly cyc6_prod_a = y1*y2 - z1*z2;
poly cyc6_prod_b = y1*z2 + z1*y2 + z1*z2;
poly to_cyc3_a = (y1 + z1)*(y2 + z2) - z1*z2;
poly to_cyc3_b = (y1 + z1)*z2 + z1*(y2 + z2) - z1*z2;
if (to_cyc3_a - (cyc6_prod_a + cyc6_prod_b) != 0 || to_cyc3_b - cyc6_prod_b != 0) {
    ERROR("FAIL: Archetype CIII OpCyclotomic6 <-> OpCyclotomic3 isomorphism failed");
}
poly cyc3_norm_a = y1*(y1 - z1) - z1*(-z1);
poly cyc3_norm_b = y1*(-z1) + z1*(y1 - z1) - z1*(-z1);
if (cyc3_norm_a - (y1^2 - y1*z1 + z1^2) != 0 || cyc3_norm_b != 0) {
    ERROR("FAIL: Archetype CV OpCyclotomic3 Galois norm failed");
}
// Archetypes CVIII-CXIII: Signed Reflection Cross-Product Orientation Fix & Triality Trio 5-Grading Zero-Sum Conservation
poly refl_cross_x = (-z1)*(-y2) - (-y1)*(-z2);
poly orig_cross_x = y1*z2 - z1*y2;
if (refl_cross_x + orig_cross_x != 0) {
    ERROR("FAIL: Archetype CVIII signed reflection cross product orientation failed");
}
poly d5x_vx = -2*xi1; poly d5y_vx = xi1; poly d5z_vx = xi1;
if (d5x_vx + d5y_vx + d5z_vx != 0) {
    ERROR("FAIL: Archetype CXII triality trio 5-grading conservation failed");
}
// Archetypes CXIV-CXVI: Quaternion Spin Sandwich Ad_{+-i_Q}(v) = (v_x, -v_y, -v_z) & Spin Projector Orthogonality
poly q_sand_x = 1 * xi1 * 1;
poly q_sand_y = -1 * y1 * 1;
poly q_sand_z = -1 * z1 * 1;
if (q_sand_x - xi1 != 0 || q_sand_y + y1 != 0 || q_sand_z + z1 != 0) {
    ERROR("FAIL: Archetype CXIV quaternion spin double cover failed");
}
// Archetypes CXVII-CXIX: Three Associative Quaternion Subalgebras H_{x,y,z}(A) ~= M_2(A) & Riccati Axis Decoupling
poly qx_riccati = xi2 * xi1 * xi2 + xi2 * y2 - y1 * xi2 - z1;
if (qx_riccati - (xi1 * xi2^2 + (y2 - y1) * xi2 - z1) != 0) {
    ERROR("FAIL: Archetype CXIX Riccati axis decoupling failed");
}
poly connes_curv_a = -(y1*z1 + y2*z2 + y3*z3);
poly connes_sec_var_a = 2*(y1*z1 + y2*z2 + y3*z3);
if (connes_sec_var_a + 2*connes_curv_a != 0) {
    ERROR("FAIL: Archetype CXIX Connes second-variation curvature law failed");
}
print("[PASS] Singular: Archetypes LXVII-CXIX (Dahm Plücker-Klein, Simple Line Square-Zero, Grassmannian Edge-Triangle, Pasch 4-Simplex, Catto Freudenthal Cubic, Hansen Cl(4,2) Doublet Tower, Zero Chiral Volume, Chevalley-Shirokov Spinor Ideals, Trifactor-Loxodromic Zorn-Riccati Compass, 56D Freudenthal E_7 Quartic S-Duality, 4-Spinor Cross-Difference, Gelfand-Retakh Elimination, Nambu-Gorkov Cayley-Dickson Norm, 5-Graded Spectral Projectors, OpCyclotomic3/OpCyclotomic6 Jordan Norms, Octahedral S_4 = V_4 |>< S_3 Galois Group, Triality Trio 5-Gradings, Quaternion Spin Double Cover Q_8 ->> V_4, Three Associative Quaternion Subalgebras, & Zorn-Connes Vacuum Curvature Collapse)");

// 4. D-Module (`dmod.lib`) Bernstein-Sato & Weyl Annihilator of the Contact Symplectic Form
ring R_contact = 0, (y1,z1,y2,z2), dp;
poly omega_perp = y1*z2 - z1*y2;
def b_roots = bfct(omega_perp);
print("[PASS] Singular dmod.lib: Bernstein-Sato polynomial of contact symplectic form omega_perp computed:");
print(b_roots);

def A_weyl = annfs(omega_perp);
setring A_weyl;
print("[PASS] Singular dmod.lib: Weyl D-module annihilator ideal LD of omega_perp^s computed:");
print(LD);

print("======================================================================");
print("ALL CHECKS PASSED");
print("======================================================================");
quit;
