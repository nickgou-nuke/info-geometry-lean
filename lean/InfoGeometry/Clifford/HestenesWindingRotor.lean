import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Algebra.EulerLaurentDerivation

/-!
# Finite Hestenes winding transport

The primary winding carrier is the additive group `ℤ`.  A chosen element of
any multiplicative group transports that charge by integer powers.  A real
elliptic Hestenes rotor is an instance of this interface, but the interface
does not require a complex scalar or an analytic exponential.
-/

noncomputable section

namespace InfoGeometry.Clifford.HestenesWindingRotor

open InfoGeometry.Algebra.EulerLaurentDerivation

variable {G : Type*} [Group G]
variable {R : Type*} [Ring R]

/-- Integer winding transport generated by a group element. -/
def winding (r : G) (n : ℤ) : G :=
  r ^ n

@[simp]
theorem winding_zero (r : G) :
    winding r 0 = 1 := by
  simp [winding]

theorem winding_add (r : G) (m n : ℤ) :
    winding r (m + n) = winding r m * winding r n := by
  exact zpow_add r m n

theorem winding_neg (r : G) (n : ℤ) :
    winding r (-n) = (winding r n)⁻¹ := by
  simp [winding]

theorem winding_sub (r : G) (m n : ℤ) :
    winding r (m - n) = winding r m * (winding r n)⁻¹ := by
  rw [sub_eq_add_neg, winding_add, winding_neg]

theorem winding_charge (r : G) (D : LocalDivisorData R) :
    winding r (charge D) = r ^ D.order := by
  rfl

/-! The divisor index transports to the product of the marked windings. -/

def divisorWinding
    {ι : Type*} (r : G) (marks : Finset ι) (order : ι → ℤ) : G :=
  winding r (divisorIndex marks order)

theorem divisorWinding_eq_winding_divisorIndex
    {ι : Type*} (r : G) (marks : Finset ι) (order : ι → ℤ) :
    divisorWinding r marks order = winding r (divisorIndex marks order) :=
  rfl

@[simp]
theorem divisorWinding_empty
    {ι : Type*} (r : G) (order : ι → ℤ) :
    divisorWinding r (∅ : Finset ι) order = 1 := by
  simp [divisorWinding, divisorIndex, winding]

theorem divisorWinding_insert
    {ι : Type*} [DecidableEq ι]
    (r : G) (marks : Finset ι) (order : ι → ℤ) (a : ι) (ha : a ∉ marks) :
    divisorWinding r (insert a marks) order =
      winding r (order a) * divisorWinding r marks order := by
  rw [divisorWinding, divisorIndex_insert marks order a ha,
    divisorWinding, winding_add]

/-- Reflection-invariant divisor orders have reflection-invariant finite
winding transport. -/
theorem divisorWinding_reflection_invariant
    {ι : Type*} [Fintype ι] (r : G)
    (D : DivisorData ι) :
    divisorWinding r Finset.univ (fun a => D.order (D.reflect a)) =
      divisorWinding r Finset.univ D.order := by
  unfold divisorWinding
  rw [divisorIndex_reflection_invariant D]

end InfoGeometry.Clifford.HestenesWindingRotor

end noncomputable section
