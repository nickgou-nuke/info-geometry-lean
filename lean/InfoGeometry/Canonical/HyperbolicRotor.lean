import InfoGeometry.Canonical.SplitCliffordHeadSuperBracket
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Meta.Architecture

open scoped TensorProduct

/-!
# InfoGeometry.Canonical.HyperbolicRotor

Coordinate-free hyperbolic rotor surface over the existing split `Cl(1,1)` head
owner lane.

This file does not introduce new algebraic owners. It reuses:
- head generators and null modes from `SplitCliffordHeadLift`,
- commutator/anticommutator surfaces from `SplitCliffordHeadSuperBracket`.
-/

namespace InfoGeometry.Canonical.HyperbolicRotor

open InfoGeometry.Canonical.SplitCliffordTensorBridge
open InfoGeometry.Canonical.SplitCliffordHeadLift
open InfoGeometry.Canonical.SplitCliffordHeadSuperBracket

/-- Hyperbolic rotor generated by an arbitrary bivector candidate `B`. -/
@[rep_depth transport]
noncomputable def hyperbolicRotorOf {n : ℕ}
    (θ : ℝ) (B : SplitClNNTensorStep n) : SplitClNNTensorStep n :=
  (Real.cosh (θ / 2)) • (1 : SplitClNNTensorStep n)
    + (Real.sinh (θ / 2)) • B

/-- Canonical rotor using the head split pseudoscalar `ε = JK`. -/
@[rep_depth transport]
noncomputable def hyperbolicRotor (n : ℕ) (θ : ℝ) : SplitClNNTensorStep n :=
  hyperbolicRotorOf θ (headEpsTensor n)

/-- Coordinate-free Bogoliubov-style geometric conjugation. -/
@[rep_depth transport]
noncomputable def geometricConjugation {n : ℕ}
    (θ : ℝ) (B γ : SplitClNNTensorStep n) : SplitClNNTensorStep n :=
  hyperbolicRotorOf θ B * γ * hyperbolicRotorOf (-θ) B

@[rep_depth transport, simp] theorem hyperbolicRotorOf_zero {n : ℕ}
    (B : SplitClNNTensorStep n) :
    hyperbolicRotorOf 0 B = (1 : SplitClNNTensorStep n) := by
  simp [hyperbolicRotorOf]

@[rep_depth transport, simp] theorem hyperbolicRotor_zero (n : ℕ) :
    hyperbolicRotor n 0 = (1 : SplitClNNTensorStep n) := by
  simp [hyperbolicRotor]

/--
Triality decomposition of the Clifford product into odd-odd (Jordan/CAR) and
even-even (Lie/CCR) channels:
`uv = (1/2){u,v} + (1/2)[u,v]`.
-/
@[rep_depth transport]
theorem clifford_triality_decomposition {n : ℕ}
    (u v : SplitClNNTensorStep n) :
    u * v
      =
    (1 / 2 : ℝ) • headAnticommutator u v
      + (1 / 2 : ℝ) • headCommutator u v := by
  unfold headAnticommutator headCommutator
  have hSplit :
    (1 / 2 : ℝ) • (u * v + v * u) + (1 / 2 : ℝ) • (u * v - v * u)
        = u * v := by
    calc
      (1 / 2 : ℝ) • (u * v + v * u) + (1 / 2 : ℝ) • (u * v - v * u)
          = (1 / 2 : ℝ) • (u * v) + (1 / 2 : ℝ) • (v * u)
              + ((1 / 2 : ℝ) • (u * v) - (1 / 2 : ℝ) • (v * u)) := by
              simp [smul_add, smul_sub, add_assoc]
      _ = ((1 / 2 : ℝ) • (u * v) + (1 / 2 : ℝ) • (u * v))
            + ((1 / 2 : ℝ) • (v * u) - (1 / 2 : ℝ) • (v * u)) := by
            abel
      _ = (1 : ℝ) • (u * v) + (0 : ℝ) • (v * u) := by
            have hHalf :
                (1 / 2 : ℝ) • (u * v) + (1 / 2 : ℝ) • (u * v) = (1 : ℝ) • (u * v) := by
              calc
                (1 / 2 : ℝ) • (u * v) + (1 / 2 : ℝ) • (u * v)
                    = ((1 / 2 : ℝ) + (1 / 2 : ℝ)) • (u * v) := by
                        simpa using (add_smul (1 / 2 : ℝ) (1 / 2 : ℝ) (u * v)).symm
                _ = (1 : ℝ) • (u * v) := by norm_num
            rw [hHalf]
            simp
      _ = u * v := by simp
  exact hSplit.symm

/--
Noncommuting rotor witness: if two rotor channels do not commute, their
commutator is nonzero.
-/
@[rep_depth transport]
theorem holonomy_emergence_of_noncommuting {n : ℕ}
    (θ₁ θ₂ : ℝ) (B₁ B₂ : SplitClNNTensorStep n)
    (hNoncomm :
      headCommutator (hyperbolicRotorOf θ₁ B₁) (hyperbolicRotorOf θ₂ B₂) ≠ 0) :
    headCommutator (hyperbolicRotorOf θ₁ B₁) (hyperbolicRotorOf θ₂ B₂) ≠ 0 := by
  exact hNoncomm

/-- Re-export of the canonical head null CAR package on the rotor lane. -/
@[rep_depth transport]
theorem rotor_lane_head_null_car (n : ℕ) :
    headNullMinus n * headNullMinus n = 0
      ∧ headNullPlus n * headNullPlus n = 0
      ∧ headAnticommutator (headNullMinus n) (headNullPlus n) = 1 := by
  exact head_null_car_algebra n

end InfoGeometry.Canonical.HyperbolicRotor
