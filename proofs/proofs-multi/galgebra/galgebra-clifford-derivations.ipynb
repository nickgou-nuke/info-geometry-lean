# ------- Cell 4: Galgebra multivector and grades -------
# In [4]
# We define a minimal multivector class consistent with galgebra API.
class MV:
    """
    Minimal galgebra-like multivector.
    Fields: .grade(i) -> coefficient of grade i (0,1,2)
    """
    def __init__(self, coeffs):
        self.coeffs = coeffs  # dict: grade -> list of scalars

    def __repr__(self):
        s = []
        for g, c in self.coeffs.items():
            s.append(f"<{g}>: {c}")
        return "MV(" + ", ".join(s) + ")"

    def scalar(self):
        return self.coeffs.get(0, [0])[0]

    def __add__(self, other):
        r = {}
        for g in set(list(self.coeffs.keys()) + list(other.coeffs.keys())):
            a = self.coeffs.get(g, [0])
            b = other.coeffs.get(g, [0])
            n = max(len(a), len(b))
            a = a + [0]*(n-len(a))
            b = b + [0]*(n-len(b))
            r[g] = [a[i]+b[i] for i in range(n)]
        return MV(r)

    def __rmul__(self, s):
        r = {}
        for g, c in self.coeffs.items():
            r[g] = [s*cc for cc in c]
        return MV(r)

# basis vectors as grade-1 MV objects
def mv_e(n):
    mc = {1: [0]*4}
    mc[1][n] = 1
    return MV(mc)

E = [mv_e(i) for i in range(4)]
# display basis
print("\n--- basis multivectors ---")
for i, e in enumerate(E):
    print(f"  e_{i} = {e}")

# ------- Cell 5: Clifford derivations (galgebra derivations) -------
# In [5]
# A derivation d of grade p is a linear map on MV such that
#     d(v^w) = d(v)^w + (-1)^p v^d(w)   (graded Leibniz).
# We verify for the adjoint action of a bivector B:
#     d(v) = (1/2)(B v - v B)
class BivectorDerivation:
    def __init__(self, B):
        self.B = B  # MV grade-2

    def __call__(self, v):
        # using geometric product levels
        bv   = self.B   # MV
        bv_c = bv.coeffs.get(2, [0]*6)
        # extract bivector components (6 for Cl(2,2))
        # we reconstruct the 4x4 matrix for action on spinor
        from sympy import zeros
        M = zeros(4)
        # encode 4x4 gamma matrices list
        cl_gammas = _conformal_basis()
        G = [cl_gammas[1], cl_gammas[2], cl_gammas['+'], cl_gammas['-']]
        # 6 independent bivector structure constants: e_i e_j - e_j e_i
        idx = 0
        for i in range(4):
            for j in range(i+1, 4):
                # e_i e_j - e_j e_i
                bij = (G[i]*G[j] - G[j]*G[i]).applyfunc(simplify)
                M += bv_c[idx] * bij
                idx += 1
        # Left-multiply by M to yield bivector adjoint on 4-spinor
        return lambda vv: (M * vv).applyfunc(simplify)

# construct derivation via bivector B = e_1^e_2
B = MV({2: [1] + [0]*5})   # simplest grade-2 basis
Bderiv = BivectorDerivation(B)
# apply to spinor via standard (Dirac) representation
spinor = Matrix([1,0,0,0])
print("\n--- derivation on spinor ---")
result = Bderiv(spinor)
print(f"  B(sigma) = {result.tolist()}")

# higher-order commutator: [d, d] must vanish on scalars
# For a grade-2 derivation, [d,d] is trivial.
print(f"  d^2 = 0: {all((result - Bderiv(result)).applyfunc(simplify).applyfunc(lambda z: z==0))}")

# ------- Cell 6: Rotor (conformal rotation) -------
# In [6]
# Rotor R = exp(-theta B/2)  acts as v -> R v R~.
# For theta=pi/4, show the rotation.
theta = pi/4
# bivector in 4D has many components; we take the e_1^e_2 subalgebra.
# Generator M_12 in so(2,2) -- one generator.
# In the (1,2) subspace:
M = Bderiv.B.coeffs.get(2,[0]*6)[0]
# exponential via series
def exp_rot(t):
    return (eye(4) - t*M + t**2*M**2/2 - t**3*M**3/6).applyfunc(simplify)

Rmat = exp_rot(theta/2)
spinor2 = Matrix([0,1,0,0])
rotated = Rmat * spinor2
print("\n--- rotor rotation on spinor (1,0,0,0) ---")
print(f"  R(pi/8) spinor = {rotated.applyfunc(lambda z: simplify(z)).tolist()}")

# ------- Cell 7: Mandelstam chiral boson from spinors -------
