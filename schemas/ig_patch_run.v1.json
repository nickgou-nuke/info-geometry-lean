{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ig.patch_run.v1",
  "type": "object",
  "required": [
    "_key",
    "run_id",
    "schema_version",
    "created_at",
    "source_graph_hash",
    "algorithm_version",
    "authority_level",
    "claim_scope",
    "non_overclaim"
  ],
  "properties": {
    "_key": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "ig.patch_run.v1"},
    "created_at": {"type": "string", "minLength": 1},
    "source_graph_hash": {"type": "string", "minLength": 1},
    "algorithm_version": {"type": "string", "minLength": 1},
    "authority_level": {"enum": ["heuristic", "derived", "formal-adjacent", "formal"]},
    "claim_scope": {"type": "string", "minLength": 1},
    "non_overclaim": {"const": true},
    "proof_link": {"type": "string"}
  },
  "additionalProperties": true
}
