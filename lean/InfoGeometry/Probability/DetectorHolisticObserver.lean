/-! ### 1. Spatial First-Collision Integral Annihilation (Bypassing Monte Carlo) -/

/-- Single photopeak rate generated by spatial volume integration:
    $L_i(I) = A \cdot P_i \cdot \varepsilon_i \cdot I$. -/
def spatialSingles (A P ε I : ℝ) : ℝ := A * P * ε * I

/-- Coincidence sum-peak rate generated by joint spatial volume integration:
    $Q(I) = A \cdot P_{12} \cdot W \cdot \varepsilon_1 \cdot \varepsilon_2 \cdot I^2$. -/
def spatialCoincidence (A P₁₂ W ε₁ ε₂ I : ℝ) : ℝ := A * P₁₂ * W * ε₁ * ε₂ * I ^ 2

/-- Bilinear cross-ratio of singles products to coincidence:
    $\mathcal{C}(L_1, L_2, Q) = (L_1 \cdot L_2) / Q$. -/
def crossRatio (L₁ L₂ Q : ℝ) : ℝ := (L₁ * L₂) / Q

/-- Pure nuclear cascade activity quotient:
    $\mathcal{A}(A, P_1, P_2, P_{12}, W) = A \cdot (P_1 \cdot P_2) / (P_{12} \cdot W)$. -/
def cascadeActivityQuotient (A P₁ P₂ P₁₂ W : ℝ) : ℝ := A * (P₁ * P₂) / (P₁₂ * W)

/-- 🏆 THEOREM 1: Spatial Volume Integral Annihilation.
    For ANY arbitrary detector active volume, crystal shape, or spatial attenuation profile
    with non-zero integral $I \ne 0$, the cross-ratio $(L_1 L_2) / Q$ identically annihilates
    $I$ and $I^2$, recovering the pure nuclear cascade activity quotient without Monte Carlo. -/
theorem spatial_integral_annihilation
    (A P₁ P₂ P₁₂ W ε₁ ε₂ I : ℝ)
    (hA : A ≠ 0) (hP₁₂ : P₁₂ ≠ 0) (hW : W ≠ 0)
    (hε₁ : ε₁ ≠ 0) (hε₂ : ε₂ ≠ 0) (hI : I ≠ 0) :
    crossRatio (spatialSingles A P₁ ε₁ I) (spatialSingles A P₂ ε₂ I)
      (spatialCoincidence A P₁₂ W ε₁ ε₂ I) =
      cascadeActivityQuotient A P₁ P₂ P₁₂ W := by
  dsimp [crossRatio, spatialSingles, spatialCoincidence, cascadeActivityQuotient]
  field_simp [hA, hP₁₂, hW, hε₁, hε₂, hI]

/-- 🏆 THEOREM 2: Monte Carlo Geometry Redundancy.
    Two different detector geometries, volume discretizations, or crystal profiles $I_A$ and $I_B$
    yield identically equal coincidence cross-ratios. -/
theorem monte_carlo_geometry_redundancy
    (A P₁ P₂ P₁₂ W ε₁ ε₂ IA IB : ℝ)
    (hA : A ≠ 0) (hP₁₂ : P₁₂ ≠ 0) (hW : W ≠ 0)
    (hε₁ : ε₁ ≠ 0) (hε₂ : ε₂ ≠ 0) (hIA : IA ≠ 0) (hIB : IB ≠ 0) :
    crossRatio (spatialSingles A P₁ ε₁ IA) (spatialSingles A P₂ ε₂ IA)
      (spatialCoincidence A P₁₂ W ε₁ ε₂ IA) =
    crossRatio (spatialSingles A P₁ ε₁ IB) (spatialSingles A P₂ ε₂ IB)
      (spatialCoincidence A P₁₂ W ε₁ ε₂ IB) := by
  rw [spatial_integral_annihilation A P₁ P₂ P₁₂ W ε₁ ε₂ IA hA hP₁₂ hW hε₁ hε₂ hIA]
  rw [spatial_integral_annihilation A P₁ P₂ P₁₂ W ε₁ ε₂ IB hA hP₁₂ hW hε₁ hε₂ hIB]

/-! ### 2. Zero-Intercept Linear Product-Coincidence Law ($L_1 L_2 = H \cdot Q$) -/

/-- Restored linear singles rate in natural coupling coordinate $X$: $L_i(X) = C_i \cdot X$. -/
def restoredSingles (C X : ℝ) : ℝ := C * X

/-- Coincidence sum-peak rate in natural coupling coordinate $X$: $Q(X) = \kappa \cdot X^2$. -/
def coincidenceRate (κ X : ℝ) : ℝ := κ * X ^ 2

/-- Product-to-coincidence global slope: $H = (C_1 \cdot C_2) / \kappa$. -/
def globalSlope (C₁ C₂ κ : ℝ) : ℝ := (C₁ * C₂) / κ

/-- 🏆 THEOREM 3: Restored Product Linear Law ($L_1 L_2 = H \cdot Q$).
    Across ALL distances and scale values $X$, the restored singles product is strictly
    proportional to the coincidence sum-peak rate with ZERO constant intercept. -/
theorem restored_product_linear_law (C₁ C₂ κ X : ℝ) (hκ : κ ≠ 0) :
    (restoredSingles C₁ X) * (restoredSingles C₂ X) =
      (globalSlope C₁ C₂ κ) * (coincidenceRate κ X) := by
  dsimp [restoredSingles, coincidenceRate, globalSlope]
  field_simp [hκ]

/-- 🏆 THEOREM 4: Far-Field Zero-Intercept Invariance.
    At infinite distance ($X = 0$), both the singles product and the coincidence rate vanish identically,
    enforcing zero intercept: $(L_1 \cdot L_2)(0) = 0 = H \cdot Q(0)$. -/
theorem far_field_zero_intercept (C₁ C₂ κ : ℝ) :
    (restoredSingles C₁ 0) * (restoredSingles C₂ 0) = 0 ∧
    (globalSlope C₁ C₂ κ) * (coincidenceRate κ 0) = 0 := by
  dsimp [restoredSingles, coincidenceRate, globalSlope]
  exact ⟨by ring, by ring⟩

/-- 🏆 THEOREM 5: Global Slope Identifies Nuclear Cascade Activity Quotient.
    When expressing $C_1, C_2, \kappa$ in terms of microscopic efficiencies and cascade factors:
    $C_1 = A P_1 \varepsilon_1$, $C_2 = A P_2 \varepsilon_2$, $\kappa = A P_{12} W \varepsilon_1 \varepsilon_2$,
    the slope $H$ identically equals the cascade activity quotient $A (P_1 P_2) / (P_{12} W)$. -/
theorem global_slope_identifies_cascade
    (A P₁ P₂ P₁₂ W ε₁ ε₂ : ℝ)
    (hA : A ≠ 0) (hP₁₂ : P₁₂ ≠ 0) (hW : W ≠ 0) (hε₁ : ε₁ ≠ 0) (hε₂ : ε₂ ≠ 0) :
    let C₁ := A * P₁ * ε₁
    let C₂ := A * P₂ * ε₂
    let κ := A * P₁₂ * W * ε₁ * ε₂
    globalSlope C₁ C₂ κ = cascadeActivityQuotient A P₁ P₂ P₁₂ W := by
  intro C₁ C₂ κ
  dsimp [globalSlope, cascadeActivityQuotient, C₁, C₂, κ]
  have hκ_nonzero : A * P₁₂ * W * ε₁ * ε₂ ≠ 0 := by
    apply mul_ne_zero
    · apply mul_ne_zero
      · apply mul_ne_zero
        · apply mul_ne_zero hA hP₁₂
        · exact hW
      · exact hε₁
    · exact hε₂
  field_simp [hκ_nonzero, hA, hP₁₂, hW, hε₁, hε₂]

/-- 🏆 THEOREM 6: Absolute Source Activity Recovery from Regression Slope.
    The source activity $A$ is recovered from the global slope $H$ without detector efficiencies:
    $A = H \cdot (P_{12} W) / (P_1 P_2)$. -/
theorem activity_recovered_from_slope
    (A P₁ P₂ P₁₂ W ε₁ ε₂ : ℝ)
    (hA : A ≠ 0) (hP₁ : P₁ ≠ 0) (hP₂ : P₂ ≠ 0) (hP₁₂ : P₁₂ ≠ 0) (hW : W ≠ 0)
    (hε₁ : ε₁ ≠ 0) (hε₂ : ε₂ ≠ 0) :
    let C₁ := A * P₁ * ε₁
    let C₂ := A * P₂ * ε₂
    let κ := A * P₁₂ * W * ε₁ * ε₂
    let H := globalSlope C₁ C₂ κ
    H * (P₁₂ * W) / (P₁ * P₂) = A := by
  intro C₁ C₂ κ H
  dsimp [H, globalSlope, C₁, C₂, κ]
  have h_cancel : A * P₁₂ * W * ε₁ * ε₂ ≠ 0 := by
    apply mul_ne_zero
    · apply mul_ne_zero
      · apply mul_ne_zero
        · apply mul_ne_zero hA hP₁₂
        · exact hW
      · exact hε₁
    · exact hε₂
  field_simp [h_cancel, hA, hP₁, hP₂, hP₁₂, hW, hε₁, hε₂]

/-! ### 3. Multi-Point Profile Regression (No Division by Small Numbers) -/

/-- Profile residual sum of squares (RSS) for the zero-intercept linear model:
    $\mathcal{R}(H) = \sum_{j \in s} (L_{1,j} L_{2,j} - H Q_j)^2$. -/
def profileResidualRSS {ι : Type*} (s : Finset ι) (L₁ L₂ Q : ι → ℝ) (H : ℝ) : ℝ :=
  ∑ j ∈ s, (L₁ j * L₂ j - H * Q j) ^ 2

/-- 🏆 THEOREM 7: The profile residual sum of squares is universally non-negative: $\mathcal{R}(H) \ge 0$. -/
theorem profileResidualRSS_nonneg {ι : Type*} (s : Finset ι) (L₁ L₂ Q : ι → ℝ) (H : ℝ) :
    0 ≤ profileResidualRSS s L₁ L₂ Q H := by
  dsimp [profileResidualRSS]
  exact Finset.sum_nonneg (fun _ _ => sq_nonneg _)

/-- 🏆 THEOREM 8: Multi-Point Zero Residual at True Slope.
    If each geometric configuration $j$ follows the natural coordinate scaling
    $L_{1,j} = C_1 X_j$, $L_{2,j} = C_2 X_j$, and $Q_j = \kappa X_j^2$, then the multi-point
    residual sum of squares vanishes identically at the global slope $H_0 = (C_1 C_2) / \kappa$. -/
theorem regression_profile_residual_zero {ι : Type*} (s : Finset ι)
    (C₁ C₂ κ : ℝ) (X : ι → ℝ) (hκ : κ ≠ 0) :
    let L₁ := fun j => restoredSingles C₁ (X j)
    let L₂ := fun j => restoredSingles C₂ (X j)
    let Q := fun j => coincidenceRate κ (X j)
    let H := globalSlope C₁ C₂ κ
    profileResidualRSS s L₁ L₂ Q H = 0 := by
  intro L₁ L₂ Q H
  dsimp [profileResidualRSS, L₁, L₂, Q, H]
  have h_term : ∀ j ∈ s, (restoredSingles C₁ (X j) * restoredSingles C₂ (X j) - globalSlope C₁ C₂ κ * coincidenceRate κ (X j)) ^ 2 = 0 := by
    intro j _
    have h_lin := restored_product_linear_law C₁ C₂ κ (X j) hκ
    rw [h_lin]
    ring
  exact Finset.sum_eq_zero h_term

/-- Normal equation residual for zero-intercept least-squares regression:
    $\Phi(H) = \sum_{j \in s} Q_j (Y_j - H Q_j)$. -/
def normalEquationResidual {ι : Type*} (s : Finset ι) (Q Y : ι → ℝ) (H : ℝ) : ℝ :=
  ∑ j ∈ s, Q j * (Y j - H * Q j)

/-- 🏆 THEOREM 9: Stationarity of Zero-Intercept Linear Regression.
    The normal equation $\Phi(H) = 0$ is satisfied if and only if $H$ equals the Gauss-Markov
    least-squares estimator $\hat{H} = (\sum Q_j Y_j) / (\sum Q_j^2)$, weighting observations
    by $Q_j^2 \propto X_j^4$ and completely eliminating singular division by small numbers. -/
theorem normal_equation_stationarity {ι : Type*} (s : Finset ι) (Q Y : ι → ℝ) (H : ℝ)
    (hQ_denom : ∑ j ∈ s, (Q j) ^ 2 ≠ 0) :
    normalEquationResidual s Q Y H = 0 ↔ H = (∑ j ∈ s, Q j * Y j) / (∑ j ∈ s, (Q j) ^ 2) := by
  dsimp [normalEquationResidual]
  have h_expand : (∑ j ∈ s, Q j * (Y j - H * Q j)) =
      (∑ j ∈ s, Q j * Y j) - H * (∑ j ∈ s, (Q j) ^ 2) := by
    have h_distrib : (∑ j ∈ s, Q j * (Y j - H * Q j)) = ∑ j ∈ s, (Q j * Y j - H * (Q j ^ 2)) := by
      apply Finset.sum_congr rfl
      intro j _
      ring
    rw [h_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
  rw [h_expand, sub_eq_zero]
  constructor
  · intro h
    rw [h]
    exact (mul_div_cancel_right₀ H hQ_denom).symm
  · intro h
    rw [h]
    exact (div_mul_cancel₀ (∑ j ∈ s, Q j * Y j) hQ_denom).symm

/-! ### 4. Holistic Macroscopic Observer & Rank-One Quantum Factorization -/

/-- Joint detection matrix $M_{ij} = u_i \cdot v_j$ describing the absorption
    of the cascade photons by the macroscopic detector apparatus. -/
def jointDetectionMatrix (u : Fin 2 → ℝ) (v : Fin 2 → ℝ) : Fin 2 → Fin 2 → ℝ :=
  fun i j => u i * v j

/-- 🏆 THEOREM 10: Holistic Rank-One Minor Vanishing.
    The 2×2 determinant of the holistic joint detection matrix identically vanishes:
    $M_{00} M_{11} - M_{01} M_{10} = 0$.
    This enforces complete statistical separability of the macroscopic observer's marginals. -/
theorem holistic_rank_one_minor_vanishing (u v : Fin 2 → ℝ) :
    (jointDetectionMatrix u v 0 0) * (jointDetectionMatrix u v 1 1) -
    (jointDetectionMatrix u v 0 1) * (jointDetectionMatrix u v 1 0) = 0 := by
  dsimp [jointDetectionMatrix]
  ring

/-! ### 5. Master Synthesis Certificate -/

/-- 🏆 MASTER SYNTHESIS THEOREM: Complete Certificate of Holistic Detector Observability.
    Bundles all core mathematical certifications into a single pristine proposition:
    1. Spatial volume integral annihilation bypassing Monte Carlo.
    2. Restored product linear law $L_1 L_2 = H \cdot Q$.
    3. Far-field boundary condition $L_1(0) L_2(0) = 0$.
    4. Exact nuclear cascade activity extraction $A = H \cdot (P_{12} W) / (P_1 P_2)$.
    5. Multi-point profile residual annihilation $\mathcal{R}(H) = 0$.
    6. Holistic quantum observer rank-one minor vanishing. -/
theorem certified_holistic_detector_observer_synthesis
    (A P₁ P₂ P₁₂ W ε₁ ε₂ I : ℝ)
    (hA : A ≠ 0) (hP₁ : P₁ ≠ 0) (hP₂ : P₂ ≠ 0) (hP₁₂ : P₁₂ ≠ 0) (hW : W ≠ 0)
    (hε₁ : ε₁ ≠ 0) (hε₂ : ε₂ ≠ 0) (hI : I ≠ 0)
    {ι : Type*} (s : Finset ι) (X : ι → ℝ) (u v : Fin 2 → ℝ) :
    let C₁ := A * P₁ * ε₁
    let C₂ := A * P₂ * ε₂
    let κ := A * P₁₂ * W * ε₁ * ε₂
    -- 1. Spatial integral cancellation
    crossRatio (spatialSingles A P₁ ε₁ I) (spatialSingles A P₂ ε₂ I)
      (spatialCoincidence A P₁₂ W ε₁ ε₂ I) = cascadeActivityQuotient A P₁ P₂ P₁₂ W ∧
    -- 2. Restored product linear law
    (∀ x, (restoredSingles C₁ x) * (restoredSingles C₂ x) = (globalSlope C₁ C₂ κ) * (coincidenceRate κ x)) ∧
    -- 3. Far-field zero intercept
    ((restoredSingles C₁ 0) * (restoredSingles C₂ 0) = 0) ∧
    -- 4. Activity recovery
    ((globalSlope C₁ C₂ κ) * (P₁₂ * W) / (P₁ * P₂) = A) ∧
    -- 5. Multi-point residual zero
    (profileResidualRSS s (fun j => restoredSingles C₁ (X j)) (fun j => restoredSingles C₂ (X j))
      (fun j => coincidenceRate κ (X j)) (globalSlope C₁ C₂ κ) = 0) ∧
    -- 6. Rank-one minor vanishing
    ((jointDetectionMatrix u v 0 0) * (jointDetectionMatrix u v 1 1) -
     (jointDetectionMatrix u v 0 1) * (jointDetectionMatrix u v 1 0) = 0) := by
  intro C₁ C₂ κ
  have hκ_nonzero : κ ≠ 0 := by
    dsimp [κ]
    apply mul_ne_zero
    · apply mul_ne_zero
      · apply mul_ne_zero
        · apply mul_ne_zero hA hP₁₂
        · exact hW
      · exact hε₁
    · exact hε₂
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact spatial_integral_annihilation A P₁ P₂ P₁₂ W ε₁ ε₂ I hA hP₁₂ hW hε₁ hε₂ hI
  · intro x
    exact restored_product_linear_law C₁ C₂ κ x hκ_nonzero
  · exact (far_field_zero_intercept C₁ C₂ κ).1
  · exact activity_recovered_from_slope A P₁ P₂ P₁₂ W ε₁ ε₂ hA hP₁ hP₂ hP₁₂ hW hε₁ hε₂
  · exact regression_profile_residual_zero s C₁ C₂ κ X hκ_nonzero
  · exact holistic_rank_one_minor_vanishing u v

end

