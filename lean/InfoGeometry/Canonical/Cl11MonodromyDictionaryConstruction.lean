import InfoGeometry.Clifford.Cl11InfiniteCarrier

set_option autoImplicit false

/-!
# Cl(1,1) monodromy construction

This owner file records the noncommutative facts that are actually generated by
the `Cl(1,1)` tensor tower:

* the first Jordan--Wigner Witt creation operator is square-zero;
* its image in the algebraic direct-limit carrier is square-zero;
* the associated inner commutator is a derivation;
* the second commutator is not vacuously zero: it is the explicit middle term
  `-(K X K) - (K X K)`, and vanishes only under the corresponding annihilation
  hypothesis.
-/

noncomputable section

namespace InfoGeometry.Canonical.Cl11MonodromyDictionaryConstruction

open InfoGeometry.Clifford.Cl11InfiniteCarrier

/-- First tensor-stage Witt creation operator in the `Cl(1,1)` tower. -/
def wittCreationStage1 : Stage 1 :=
  InfoGeometry.Clifford.Cl11TensorTower.jwCreation 1 ⟨0, by norm_num⟩

/-- The first tensor-stage Witt creation operator is square-zero. -/
theorem wittCreationStage1_sq :
    wittCreationStage1 * wittCreationStage1 = 0 := by
  dsimp [wittCreationStage1, InfoGeometry.Clifford.Cl11TensorTower.jwCreation,
    InfoGeometry.Clifford.Cl11TensorTower.jwStringWithBase,
    InfoGeometry.Clifford.Cl11TensorTower.globalChirality,
    InfoGeometry.Clifford.TowerMatrix.kronPow]
  rw [← Matrix.mul_kronecker_mul]
  ext i j
  rcases i with ⟨i0, i1⟩
  rcases j with ⟨j0, j1⟩
  have h0 : i0 = j0 := Subsingleton.elim _ _
  subst h0
  fin_cases i1 <;> fin_cases j1 <;>
    simp [InfoGeometry.Clifford.Cl11TensorTower.wittCreationBase]

/-- The direct-limit modular generator is the canonical image of the
stage-one Witt creation operator. -/
def modularHamiltonian : CompatibleCarrier :=
  intoCarrier 1 wittCreationStage1

/-- The direct-limit modular generator remains square-zero. -/
theorem modularHamiltonian_sq :
    modularHamiltonian * modularHamiltonian = 0 := by
  change intoCarrier 1 wittCreationStage1 * intoCarrier 1 wittCreationStage1 = 0
  exact InfoGeometry.Clifford.Cl11TensorTowerLimit.limit_square_zero
    (n := 1) wittCreationStage1_sq

/-- Carrier-level residue/monodromy operator generated by the nilpotent
`Cl(1,1)` Witt element. -/
def carrierResidue (X : CompatibleCarrier) : CompatibleCarrier :=
  ringCommutator modularHamiltonian X

/-- The carrier residue is additive. -/
theorem carrierResidue_add (X Y : CompatibleCarrier) :
    carrierResidue (X + Y) = carrierResidue X + carrierResidue Y := by
  unfold carrierResidue ringCommutator
  noncomm_ring

/-- The carrier residue is the inner-commutator derivation generated by the
direct-limit Witt creation operator. -/
theorem carrierResidue_mul (X Y : CompatibleCarrier) :
    carrierResidue (X * Y) = carrierResidue X * Y + X * carrierResidue Y := by
  exact carrier_ringCommutator_isDerivation modularHamiltonian X Y

/-- For a square-zero generator `K`, the second inner commutator is not
automatically zero in a noncommutative ring; it is the explicit middle term. -/
theorem carrierResidue_iterate_formula (X : CompatibleCarrier) :
    carrierResidue (carrierResidue X) =
      -(modularHamiltonian * X * modularHamiltonian) -
        (modularHamiltonian * X * modularHamiltonian) := by
  unfold carrierResidue ringCommutator
  calc
    modularHamiltonian * (modularHamiltonian * X - X * modularHamiltonian) -
        (modularHamiltonian * X - X * modularHamiltonian) * modularHamiltonian
        =
      (modularHamiltonian * modularHamiltonian) * X -
        modularHamiltonian * X * modularHamiltonian -
        modularHamiltonian * X * modularHamiltonian +
        X * (modularHamiltonian * modularHamiltonian) := by
          noncomm_ring
    _ =
      0 * X - modularHamiltonian * X * modularHamiltonian -
        modularHamiltonian * X * modularHamiltonian + X * 0 := by
          rw [modularHamiltonian_sq]
    _ =
      -(modularHamiltonian * X * modularHamiltonian) -
        (modularHamiltonian * X * modularHamiltonian) := by
          noncomm_ring

/-- The second carrier residue vanishes precisely when the middle term selected
by the square-zero generator vanishes. -/
theorem carrierResidue_iterate_eq_zero_of_middle_annihilation
    (X : CompatibleCarrier)
    (hX : modularHamiltonian * X * modularHamiltonian = 0) :
    carrierResidue (carrierResidue X) = 0 := by
  rw [carrierResidue_iterate_formula, hX]
  simp

/-- Finite induction does not change the direct-limit image of the stage-one
generator. -/
theorem modularHamiltonian_finiteAdvance (k : ℕ) :
    intoCarrier (1 + k) (finiteAdvance 1 k wittCreationStage1) =
      modularHamiltonian := by
  exact intoCarrier_finiteAdvance 1 k wittCreationStage1

/-- The finite-stage commutator generated by the advanced Witt creation
operator has the same direct-limit image as the carrier residue. -/
theorem finiteAdvance_commutator_reads_carrierResidue
    (k : ℕ) (X : Stage 1) :
    intoCarrier (1 + k)
        (ringCommutator (finiteAdvance 1 k wittCreationStage1)
          (finiteAdvance 1 k X)) =
      carrierResidue (intoCarrier 1 X) := by
  rw [intoCarrier_finiteAdvance_ringCommutator]
  unfold carrierResidue ringCommutator modularHamiltonian
  simp [map_mul, map_sub]

/--
The nonzero carrier residue is globally parabolic exactly when the middle term
selected by the square-zero `Cl(1,1)` generator has doubled additive value zero
for every carrier element.

This replaces the earlier false global dictionary construction: square-zero of
`modularHamiltonian` alone does not imply `carrierResidue² = 0` in a
noncommutative carrier.
-/
theorem carrierResidue_globally_parabolic_iff_middle_doubled_zero :
    (∀ X : CompatibleCarrier, carrierResidue (carrierResidue X) = 0) ↔
      ∀ X : CompatibleCarrier,
        -(modularHamiltonian * X * modularHamiltonian) -
          (modularHamiltonian * X * modularHamiltonian) = 0 := by
  constructor
  · intro h X
    rw [← carrierResidue_iterate_formula X]
    exact h X
  · intro h X
    rw [carrierResidue_iterate_formula X]
    exact h X

/--
If the middle term is annihilated for every carrier element, then the
commutator residue generated by `modularHamiltonian` is a genuinely parabolic
operator.
-/
theorem carrierResidue_globally_parabolic_of_middle_annihilation
    (h : ∀ X : CompatibleCarrier, modularHamiltonian * X * modularHamiltonian = 0) :
    ∀ X : CompatibleCarrier, carrierResidue (carrierResidue X) = 0 := by
  intro X
  exact carrierResidue_iterate_eq_zero_of_middle_annihilation X (h X)

end InfoGeometry.Canonical.Cl11MonodromyDictionaryConstruction
