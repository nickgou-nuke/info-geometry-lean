      },
      "required_hypotheses": [
        {
          "name": "is_certified",
          "pattern": "IsCertified|proj \\* x = x",
          "description": "Certified truth subspace invariant condition"
        }
      ],
      "target_relation": {
        "type": "conjunction",
        "pattern": "P\\.projCompl\\s*\\*\\s*x\\s*=\\s*0\\s*∧\\s*x\\s*\\*\\s*P\\.projCompl\\s*=\\s*0"
