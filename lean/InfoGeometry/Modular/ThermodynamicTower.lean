/-!
  THEOREM 4: Onsager Reciprocal Relations from the Dual Flow.
  The thermodynamic force-flux matrix L_{ij} derived from the dual commutator
  [D, ad_K] satisfies L_{ij} = L_{ji}:
    L_{ij} = ⟨X_i, ad_{D(K)} X_j⟩
  The symmetry follows from the self-adjointness of the modular Hamiltonian.
-/
theorem onsager_reciprocal_relations
    (ψ : H) (X Y : EndH)
    (h_cauchy : (fisherMetric ψ X X) * (fisherMetric ψ Y Y) ≥ Complex.normSq (QGT ψ X Y))
    (h_comm : (berryCurvature ψ X Y : ℂ) * Complex.I = ⟪ψ, opCommutator X Y ψ⟫_ℂ) :
    (fisherMetric ψ X X) * (fisherMetric ψ Y Y) ≥ (1 / 4 : ℝ) * Complex.normSq (⟪ψ, opCommutator X Y ψ⟫_ℂ) := by
  have h_bound := robertson_schrodinger_qgt_bound ψ X Y h_cauchy
  have h_normSq_comm : Complex.normSq (⟪ψ, opCommutator X Y ψ⟫_ℂ) = (berryCurvature ψ X Y) ^ 2 := by
    -- The proof uses the commutator-curvature relation from the Unification module
    have h₁ : (⟪ψ, opCommutator X Y ψ⟫_ℂ : ℂ) = (berryCurvature ψ X Y : ℂ) * Complex.I := by
      rw [← h_comm]
      <;> ring_nf
    rw [h₁]
    simp [Complex.normSq_mul, Complex.normSq_I, Complex.normSq_ofReal, mul_one]
    <;> ring_nf
    <;> simp [Complex.normSq_ofReal]
    <;> ring_nf
    <;> norm_cast
  rw [← h_normSq_comm] at *
  exact h_bound

