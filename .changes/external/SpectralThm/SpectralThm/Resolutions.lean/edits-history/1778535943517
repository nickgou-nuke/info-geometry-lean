{"file":"/home/goutev/repos/info-geometry-lean/external/SpectralThm/SpectralThm/Resolutions.lean","time":1778535943517,"baseTime":1778535942575,"changes":[{"range":{"start":{"line":85,"character":0},"end":{"line":86,"character":0}},"text":"    have h_diff : w₂ = w₁ ∪ (w₂ \\ w₁) := (Set.union_diff_cancel h).symm\n    have h_disj : Disjoint w₁ (w₂ \\ w₁) := Set.disjoint_sdiff_right\n    have h_meas_w1 : MeasurableSet w₁ := measurable_of_not_measureOf_zero E (toOuterMeasure E x) w₁\n    -- Wait, I need measurable sets for the additivity.\n    -- Outer measures are defined on all sets, but the ROI properties are for measurable sets.\n    -- If they are not measurable, the measure is 0.\n    by_cases h1 : MeasurableSet w₁\n    · by_cases h2 : MeasurableSet w₂\n      · rw [h_diff, E.m_Union' h1 (h2.diff h1) h_disj]\n        simp only [ContinuousLinearMap.add_apply]\n        have h1p := E.isOrthogonalProjection' w₁\n        have h2p := E.isOrthogonalProjection' (w₂ \\ w₁)\n        have : ‖E w₁ x + E (w₂ \\ w₁) x‖^2 = ‖E w₁ x‖^2 + ‖E (w₂ \\ w₁) x‖^2 := by\n          rw [norm_add_pow_two_re]\n          have : ⟪E w₁ x, E (w₂ \\ w₁) x⟫_ℂ = 0 := by\n            have : E w₁ * E (w₂ \\ w₁) = 0 := by\n              rw [← Set.inter_diff_self, E.m_Inter' h1 (h2.diff h1)]\n              simp\n            calc ⟪E w₁ x, E (w₂ \\ w₁) x⟫_ℂ \n              _ = ⟪x, (E w₁).adjoint (E (w₂ \\ w₁) x)⟫_ℂ := (E w₁).adjoint_inner_left x (E (w₂ \\ w₁) x)\n              _ = ⟪x, (E w₁ * E (w₂ \\ w₁)) x⟫_ℂ := by rw [h1p.2, ContinuousLinearMap.mul_apply]\n              _ = 0 := by rw [this]; simp\n          simp [this]\n        rw [← norm_le_norm_pow_two_iff (norm_nonneg _) (norm_nonneg _)]\n        rw [this]\n        exact le_add_of_nonneg_right (sq_nonneg _)\n      · rw [E.not_measurable' h2]\n        simp only [ContinuousLinearMap.zero_apply, norm_zero]\n        have : w₁ = ∅ := by\n          -- If w₂ is not measurable, and w₁ ⊆ w₂, is w₁ also 0 measure?\n          -- In this ROI definition, not_measurable' makes it 0.\n          -- But if w₁ is measurable and w₂ is not, we might have E w₁ ≠ 0?\n          -- Actually, the definition of outer measure usually requires monotonicity.\n          -- If E is only defined on measurable sets, we should define the outer measure by infimum.\n          -- The current definition `measureOf w := ENNReal.ofReal ‖E.measureOf' w x‖`\n          -- combined with `not_measurable' h := measureOf' h = 0` means that\n          -- if w₁ is measurable and w₂ is not, then E w₁ could be non-zero while E w₂ = 0.\n          -- This BREAKS monotonicity.\n          sorry\n    · rw [E.not_measurable' h1]\n      simp only [ContinuousLinearMap.zero_apply, norm_zero]\n      positivity\n","rangeOffset":3446,"rangeLength":10}]}