import Mathlib.Algebra.Group.Defs
import InfoGeometry.Lie.KantorPairContract

/-!
# Kantor TKK 5-Graded Symmetry Closure

This file distills the pristine algebraic carrier of the Tits-Kantor-Koecher (TKK)
construction for 5-graded Lie algebras from a generic Kantor Triple System (or Kantor Pair),
isolating the abstract mathematics from the physical string/brane conflations (e.g.
conflating the graded components natively with RR fields or NS5 charges in T-duality).

A 5-graded Lie algebra $\mathfrak{g} = \mathfrak{g}_{-2} \oplus \mathfrak{g}_{-1} \oplus \mathfrak{g}_0 \oplus \mathfrak{g}_1 \oplus \mathfrak{g}_2$
is canonically generated by a Kantor Pair $(V_+, V_-)$.
-/

namespace InfoGeometry.Lie.KantorTKK

open InfoGeometry.Lie

variable {V_plus V_minus : Type*} [AddCommGroup V_plus] [AddCommGroup V_minus]

/-- The abstract components of the derivation algebra $\mathfrak{g}_0$.
    It is spanned by inner derivations $D(x, y)$ acting on both $V_+$ and $V_-$. -/
structure DerivationAlgebra0 (V_plus V_minus : Type*)
    [AddCommGroup V_plus] [AddCommGroup V_minus] where
  op_plus : V_plus → V_plus
  op_minus : V_minus → V_minus

/-- The abstract components of the outer grades $\mathfrak{g}_{-2}$ and $\mathfrak{g}_2$.
    Generated by the Kantor $K$-operators which map the opposite space into the primary space. -/
structure OuterGrade2Plus (V_plus V_minus : Type*)
    [AddCommGroup V_plus] [AddCommGroup V_minus] where
  k_map : V_minus → V_plus

structure OuterGrade2Minus (V_plus V_minus : Type*)
    [AddCommGroup V_plus] [AddCommGroup V_minus] where
  k_map : V_plus → V_minus

/-- The pristine 5-graded carrier vector space for the TKK construction.
    This exactly isolates the algebraic degrees from physical interpretations. -/
structure KantorTKKCarrier (V_plus V_minus : Type*)
    [AddCommGroup V_plus] [AddCommGroup V_minus] where
  g_minus_2 : OuterGrade2Minus V_plus V_minus
  g_minus_1 : V_minus
  g_zero    : DerivationAlgebra0 V_plus V_minus
  g_plus_1  : V_plus
  g_plus_2  : OuterGrade2Plus V_plus V_minus

/-- The canonical embedding of the Kantor Pair $V_+$ into grade +1. -/
def embedPlus1 (x : V_plus) : KantorTKKCarrier V_plus V_minus :=
  ⟨⟨fun _ => 0⟩, 0, ⟨fun _ => 0, fun _ => 0⟩, x, ⟨fun _ => 0⟩⟩

/-- The canonical embedding of the Kantor Pair $V_-$ into grade -1. -/
def embedMinus1 (y : V_minus) : KantorTKKCarrier V_plus V_minus :=
  ⟨⟨fun _ => 0⟩, y, ⟨fun _ => 0, fun _ => 0⟩, 0, ⟨fun _ => 0⟩⟩

/-- The inner derivation generated by x ∈ V_+ and y ∈ V_- acting on the Kantor pair.
    This creates the g_0 grading element D(x,y) = L(x,y). -/
def innerDerivation (K : KantorPairSkeleton V_plus V_minus)
    (x : V_plus) (y : V_minus) : DerivationAlgebra0 V_plus V_minus where
  op_plus := fun z => K.triplePlus x y z
  op_minus := fun w => - K.tripleMinus y x w

/-- The TKK algebraic 5-graded bracket of an element in grade +1 with an element in grade -1 
    yields the inner derivation D(x, y) in grade 0. This structurally isolates 
    the RR / NS5 string charge commutators into their pristine derivation algebra form. -/
def bracketPlus1Minus1 (K : KantorPairSkeleton V_plus V_minus)
    (x : V_plus) (y : V_minus) : KantorTKKCarrier V_plus V_minus :=
  ⟨⟨fun _ => 0⟩, 0, innerDerivation K x y, 0, ⟨fun _ => 0⟩⟩

/-- The grade +2 operator is generated by the Kantor K-operator acting on V_+. -/
def bracketPlus1Plus1 (K : KantorPairSkeleton V_plus V_minus)
    (x y : V_plus) : KantorTKKCarrier V_plus V_minus :=
  let k_op : OuterGrade2Plus V_plus V_minus := ⟨fun z => K.kPlus x y z⟩
  ⟨⟨fun _ => 0⟩, 0, ⟨fun _ => 0, fun _ => 0⟩, 0, k_op⟩

/-- The grade -2 operator is generated by the Kantor K-operator acting on V_-. -/
def bracketMinus1Minus1 (K : KantorPairSkeleton V_plus V_minus)
    (x y : V_minus) : KantorTKKCarrier V_plus V_minus :=
  let k_op : OuterGrade2Minus V_plus V_minus := ⟨fun z => K.kMinus x y z⟩
  ⟨k_op, 0, ⟨fun _ => 0, fun _ => 0⟩, 0, ⟨fun _ => 0⟩⟩

end InfoGeometry.Lie.KantorTKK
