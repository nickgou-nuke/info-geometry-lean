import InfoGeometry.SuperMetriplectic.Axioms
import InfoGeometry.Canonical.InverseKernelCartanCore
import InfoGeometry.Core.SymmetricLie
import InfoGeometry.Core.UnifiedGeometry
import InfoGeometry.Meta.Architecture

open scoped InnerProductSpace

/-!
# SuperMetriplectic Cartan Bridge

Small theorem-backed bridge from the certified inverse-kernel spectral Cartan lane
into the conservative `SuperMetriplectic.CartanOnsagerSplit` interface.

This file does not derive a new Onsager law. It packages the already owned
spectral Cartan involution generated by `Γ_S` as a symmetric Lie algebra on the
operator lane, then reads off the `𝔨 ⊕ 𝔭` split as the Drazin core / dissipative
range shadow required by `CartanOnsagerSplit`.
-/

namespace CartanBridge

open InfoGeometry.Canonical
open InfoGeometry.Core

section Core

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "EndH" => E →L[ℝ] E

/--
The spectral Cartan grading is involutive as an endomorphism of the carrier.
-/
@[rep_depth transport]
theorem GammaS_comp_GammaS
    (CIK : CertifiedInverseKernel E) :
    CIK.GammaS.comp CIK.GammaS = ContinuousLinearMap.id ℝ E := by
  ext x
  have h := congrArg (fun T : EndH => T x) (CIK.GammaS_sq_eq_one)
  simpa using h

/--
The spectral Cartan involution on operators viewed as a linear Onsager-style map.
-/
@[rep_depth transport]
noncomputable def spectralOnsagerMap
    (CIK : CertifiedInverseKernel E) :
    EndH →ₗ[ℝ] EndH :=
  InfoGeometry.Core.conjugationMap CIK.GammaS

/--
The spectral Cartan involution generated by `Γ_S`, packaged in the generic
symmetric-Lie interface on the operator lane.
-/
@[rep_depth transport]
noncomputable def spectralCartanSymmetricLieAlgebra
    (CIK : CertifiedInverseKernel E) :
    InfoGeometry.Core.SymmetricLieAlgebra EndH := by
  let θ : InfoGeometry.Core.InvolutiveLieAut EndH :=
    ⟨InfoGeometry.Core.conjugationLieEquiv CIK.GammaS (GammaS_comp_GammaS (CIK := CIK)),
      InfoGeometry.Core.conjugationMap_involutive CIK.GammaS (GammaS_comp_GammaS (CIK := CIK))⟩
  exact InfoGeometry.Core.SymmetricLieAlgebra.ofInvolutiveLieAut θ

/--
Bridge object packaging the repo-owned spectral Cartan split as a conservative
`CartanOnsagerSplit`.
-/
@[rep_depth transport]
structure DrazinCartanOnsagerBridge where
  CIK : CertifiedInverseKernel E

namespace DrazinCartanOnsagerBridge

variable (B : DrazinCartanOnsagerBridge (E := E))

/--
The spectral Cartan `𝔨 ⊕ 𝔭` split read as the Drazin core / dissipative range
shadow demanded by `SuperMetriplectic.CartanOnsagerSplit`.
-/
@[rep_depth transport]
noncomputable def toCartanOnsagerSplit :
    InfoGeometry.SuperMetriplectic.CartanOnsagerSplit EndH where
  S := spectralCartanSymmetricLieAlgebra B.CIK
  onsager := spectralOnsagerMap B.CIK
  drazinCore := (spectralCartanSymmetricLieAlgebra B.CIK).𝔨
  dissipativeRange := (spectralCartanSymmetricLieAlgebra B.CIK).𝔭
  drazinCore_eq_k := rfl
  dissipativeRange_eq_p := rfl

@[rep_depth transport]
theorem toCartanOnsagerSplit_drazinCore_eq_k :
    (toCartanOnsagerSplit B).drazinCore
      = (toCartanOnsagerSplit B).S.𝔨 := by
  exact (toCartanOnsagerSplit B).drazinCore_eq_k

@[rep_depth transport]
theorem toCartanOnsagerSplit_dissipativeRange_eq_p :
    (toCartanOnsagerSplit B).dissipativeRange
      = (toCartanOnsagerSplit B).S.𝔭 := by
  exact (toCartanOnsagerSplit B).dissipativeRange_eq_p

end DrazinCartanOnsagerBridge

end Core

end CartanBridge
