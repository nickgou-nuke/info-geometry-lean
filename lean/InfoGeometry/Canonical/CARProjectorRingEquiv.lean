import InfoGeometry.Canonical.CarrierMasterAlgebraicLemmasCapstone
import InfoGeometry.Krein.SplitCliffordNN

/-!
# Ring automorphisms transport CAR occupation projectors

This bridge starts after a concrete cyclotomic/Galois construction has supplied
a ring equivalence of the operator algebra and a CAR pair preserved by that
equivalence. It proves transport of the occupation idempotent and its corner
operation. It does not assert that a cyclotomic relation alone constructs a
CAR pair or determines a Galois action on an arbitrary noncommutative ring.
-/

namespace InfoGeometry.Canonical.CARProjectorRingEquiv

noncomputable section

open InfoGeometry.Canonical.CarrierMasterLemmas
open InfoGeometry.Krein.SplitCliffordNN

variable {A : Type*} [Ring A]

/-! ## Isotropic Witt head modes at each finite Clifford stage -/

/-- The concrete CAR pair generated by the two normalized isotropic head
vectors in the split `Cl(n,n)` Clifford algebra. -/
def headNullCARPair (n : ℕ) : CARCarrierPair (Alg (n + 1)) where
  c := InfoGeometry.Clifford.ClNN.gammaHeadNullPlus n
  c_dag := InfoGeometry.Clifford.ClNN.gammaHeadNullMinus n
  anticomm := InfoGeometry.Clifford.ClNN.gammaHeadNullPlus_mul_gammaHeadNullMinus_add_swap n
  nilpotent := InfoGeometry.Clifford.ClNN.gammaHeadNullPlus_sq n
  nilpotent_dag := InfoGeometry.Clifford.ClNN.gammaHeadNullMinus_sq n

/-- The finite-stage occupation projector is generated from the isotropic
head modes, through the Clifford representation and their CAR relation. -/
noncomputable def headNullOccupation (n : ℕ) : Alg (n + 1) :=
  (headNullCARPair n).c_dag * (headNullCARPair n).c

/-- Isotropy of both head vectors, square-zero of their Clifford images, CAR,
and idempotency of the resulting occupation operator hold at each stage. -/
theorem isotropic_head_pair_generates_occupation_idempotent (n : ℕ) :
    Quad (n + 1) (InfoGeometry.Clifford.ClNN.headNullMinus n) = 0 ∧
    Quad (n + 1) (InfoGeometry.Clifford.ClNN.headNullPlus n) = 0 ∧
    InfoGeometry.Clifford.ClNN.gammaHeadNullMinus n *
      InfoGeometry.Clifford.ClNN.gammaHeadNullMinus n = 0 ∧
    InfoGeometry.Clifford.ClNN.gammaHeadNullPlus n *
      InfoGeometry.Clifford.ClNN.gammaHeadNullPlus n = 0 ∧
    InfoGeometry.Clifford.ClNN.gammaHeadNullMinus n *
      InfoGeometry.Clifford.ClNN.gammaHeadNullPlus n +
      InfoGeometry.Clifford.ClNN.gammaHeadNullPlus n *
      InfoGeometry.Clifford.ClNN.gammaHeadNullMinus n = 1 ∧
    headNullOccupation n * headNullOccupation n = headNullOccupation n := by
  refine ⟨InfoGeometry.Clifford.ClNN.headNullMinus_isotropic n,
    InfoGeometry.Clifford.ClNN.headNullPlus_isotropic n,
    InfoGeometry.Clifford.ClNN.gammaHeadNullMinus_sq n,
    InfoGeometry.Clifford.ClNN.gammaHeadNullPlus_sq n,
    InfoGeometry.Clifford.ClNN.gammaHeadNullMinus_mul_gammaHeadNullPlus_add_swap n,
    ?_⟩
  exact car_number_operator_idempotent (headNullCARPair n)

/-- Transport of a CAR pair along a ring equivalence. -/
def transportCAR (σ : A ≃+* A) (C : CARCarrierPair A) : CARCarrierPair A where
  c := σ C.c
  c_dag := σ C.c_dag
  anticomm := by
    have h := congrArg σ C.anticomm
    simpa only [map_add, map_mul, map_one] using h
  nilpotent := by
    have h := congrArg σ C.nilpotent
    simpa only [map_mul, map_zero] using h
  nilpotent_dag := by
    have h := congrArg σ C.nilpotent_dag
    simpa only [map_mul, map_zero] using h

/-- The transported occupation operator is the image of the original one. -/
theorem map_occupation (σ : A ≃+* A) (C : CARCarrierPair A) :
    (transportCAR σ C).c_dag * (transportCAR σ C).c = σ (C.c_dag * C.c) :=
  (map_mul σ C.c_dag C.c).symm

/-- Ring-equivalence transport preserves the CAR occupation idempotent. -/
theorem transported_occupation_idempotent (σ : A ≃+* A) (C : CARCarrierPair A) :
    ((transportCAR σ C).c_dag * (transportCAR σ C).c) *
      ((transportCAR σ C).c_dag * (transportCAR σ C).c) =
        (transportCAR σ C).c_dag * (transportCAR σ C).c := by
  exact car_number_operator_idempotent (transportCAR σ C)

/-- A representation by ring automorphisms transports every CAR occupation
operator to an idempotent. This applies to a Galois group once its action on
the associative operator algebra is supplied as such a representation. -/
theorem ringAutomorphismRepresentation_occupation_idempotent
    {G : Type*} [Monoid G] (ρ : G →* A ≃+* A) (g : G)
    (C : CARCarrierPair A) :
    (ρ g (C.c_dag * C.c)) * (ρ g (C.c_dag * C.c)) =
      ρ g (C.c_dag * C.c) := by
  calc
    _ = ρ g ((C.c_dag * C.c) * (C.c_dag * C.c)) :=
      (map_mul (ρ g) (C.c_dag * C.c) (C.c_dag * C.c)).symm
    _ = ρ g (C.c_dag * C.c) :=
      congrArg (ρ g) (car_number_operator_idempotent C)

/-- The occupation corner operation generated by a CAR pair. -/
def occupationCorner (C : CARCarrierPair A) (X : A) : A :=
  C.c_dag * C.c * X * (C.c_dag * C.c)

/-- The occupation corner operation is idempotent as an operation. -/
theorem occupationCorner_idempotent (C : CARCarrierPair A) (X : A) :
    occupationCorner C (occupationCorner C X) = occupationCorner C X := by
  unfold occupationCorner
  have hp := car_number_operator_idempotent C
  calc
    _ = ((C.c_dag * C.c) * (C.c_dag * C.c)) * X *
          ((C.c_dag * C.c) * (C.c_dag * C.c)) := by
            simp only [mul_assoc]
    _ = (C.c_dag * C.c) * X * (C.c_dag * C.c) := by rw [hp]

/-- The occupation corner is a second-level idempotent generated by the
finite-stage isotropic CAR pair. -/
theorem headNull_occupation_metaidempotent (n : ℕ) (X : Alg (n + 1)) :
    occupationCorner (headNullCARPair n)
      (occupationCorner (headNullCARPair n) X) =
        occupationCorner (headNullCARPair n) X :=
  occupationCorner_idempotent (headNullCARPair n) X

/-- A ring equivalence intertwines the occupation corner operations. -/
theorem map_occupationCorner (σ : A ≃+* A) (C : CARCarrierPair A) (X : A) :
    occupationCorner (transportCAR σ C) (σ X) = σ (occupationCorner C X) := by
  unfold occupationCorner
  rw [show (transportCAR σ C).c_dag = σ C.c_dag by rfl,
      show (transportCAR σ C).c = σ C.c by rfl]
  simp only [map_mul]

/-- The meta-idempotent corner operation is stable along a represented
automorphism orbit, and remains idempotent at each orbit point. -/
theorem ringAutomorphismRepresentation_metaidempotent
    {G : Type*} [Monoid G] (ρ : G →* A ≃+* A) (g : G)
    (C : CARCarrierPair A) (X : A) :
    occupationCorner (transportCAR (ρ g) C)
      (occupationCorner (transportCAR (ρ g) C) (ρ g X)) =
        occupationCorner (transportCAR (ρ g) C) (ρ g X) :=
  occupationCorner_idempotent (transportCAR (ρ g) C) (ρ g X)

end

end InfoGeometry.Canonical.CARProjectorRingEquiv
