import InfoGeometry.Canonical.MatrixTwoNoncommutativity
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.Polynomial.Inductions
import Mathlib.Data.Matrix.Basis
import Mathlib.LinearAlgebra.Matrix.Basis
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.Tactic.Ring

/-!
# A concrete integral polynomial Peirce order

For a commutative ring `R` and `v : R`, `parameterOrder v` is the native
subalgebra of `Matrix (Fin 2) (Fin 2) R` whose lower-left entry is divisible
by `v`. If `v` is a unit, this subalgebra is the full matrix algebra; no
invertibility assumption on `2` is involved.

For the polynomial parameter `X`, the map
`(a,b,c,d) ↦ !![a+b,c;X*d,a]` is a linear equivalence onto this subalgebra.
Its inverse extracts the three evident entries and uses `Polynomial.divX`
for the lower-left entry. This constructs a native basis indexed by `Fin 4`,
with vectors `(1, E₀₀, E₀₁, X E₁₀)`, over any commutative coefficient ring.
In particular, taking `R = ℤ` gives an integral polynomial matrix order.

The coordinates of `(1, N₊+N₋, N₊-N₋, N₊N₋-N₋N₊)` have determinant
`-4 * X`. This is a change-of-generators determinant, not a statement that
the displayed family is always a basis or that the algebra fails to split
in characteristic two. No abstract universal presentation, base-change
identification, or Azumaya property is asserted here.
-/

set_option autoImplicit false

noncomputable section

open Polynomial

namespace InfoGeometry.OperatorAlgebra.PeirceSpine.IntegralOrder

section Parameter

variable {R : Type*} [CommRing R]

/-- A concrete matrix order: the lower-left entry belongs to the principal
ideal generated by the parameter. -/
def parameterOrder (v : R) : Subalgebra R (Matrix (Fin 2) (Fin 2) R) where
  carrier := {M | v ∣ M 1 0}
  add_mem' := by
    intro M N hM hN
    exact dvd_add hM hN
  mul_mem' := by
    intro M N hM hN
    rcases hM with ⟨a, ha⟩
    rcases hN with ⟨b, hb⟩
    refine ⟨a * N 0 0 + M 1 1 * b, ?_⟩
    rw [Matrix.mul_apply, Fin.sum_univ_two, ha, hb, mul_add, mul_assoc,
      mul_left_comm (M 1 1) v b]
  algebraMap_mem' := by
    intro r
    simp [Matrix.algebraMap_matrix_apply]

@[simp]
theorem mem_parameterOrder (v : R) (M : Matrix (Fin 2) (Fin 2) R) :
    M ∈ parameterOrder v ↔ v ∣ M 1 0 := Iff.rfl

/-- The order itself is noncommutative over a nontrivial coefficient ring,
including when the parameter vanishes: the cut and upper arrow do not commute. -/
theorem parameterOrder_noncommutative [Nontrivial R] (v : R) :
    ∃ M N : parameterOrder v, M * N ≠ N * M := by
  let P : parameterOrder v := ⟨Matrix.single 0 0 1, by
    simp [mem_parameterOrder, Matrix.single_apply]⟩
  let N : parameterOrder v := ⟨Matrix.single 0 1 1, by
    simp [mem_parameterOrder, Matrix.single_apply]⟩
  refine ⟨P, N, ?_⟩
  intro h
  have h01 := congrArg
    (fun M : parameterOrder v => (M : Matrix (Fin 2) (Fin 2) R) 0 1) h
  simpa [P, N, Matrix.mul_apply, Fin.sum_univ_two, Matrix.single_apply] using h01

/-- A unit parameter gives every matrix, in every characteristic. -/
theorem parameterOrder_eq_top_of_isUnit {v : R} (hv : IsUnit v) :
    parameterOrder v = ⊤ := by
  apply top_unique
  intro M _
  change v ∣ M 1 0
  rcases hv with ⟨u, rfl⟩
  refine ⟨↑(u⁻¹) * M 1 0, ?_⟩
  simp [mul_assoc]

/-- The missing matrix unit detects exactly whether the parameter is a unit. -/
theorem parameterOrder_eq_top_iff {v : R} :
    parameterOrder v = ⊤ ↔ IsUnit v := by
  refine ⟨?_, parameterOrder_eq_top_of_isUnit⟩
  intro h
  have hm : Matrix.single (1 : Fin 2) (0 : Fin 2) (1 : R) ∈ parameterOrder v := by
    rw [h]
    exact Subalgebra.mem_top
  have hd : v ∣ (1 : R) := by
    simpa only [mem_parameterOrder, Matrix.single_apply_same] using hm
  exact isUnit_of_dvd_one hd

/-- The full-matrix splitting is a native algebra equivalence. -/
def unitParameterAlgEquiv {v : R} (hv : IsUnit v) :
    parameterOrder v ≃ₐ[R] Matrix (Fin 2) (Fin 2) R :=
  (Subalgebra.equivOfEq _ _ (parameterOrder_eq_top_of_isUnit hv)).trans
    Subalgebra.topEquiv

@[simp]
theorem unitParameterAlgEquiv_apply {v : R} (hv : IsUnit v)
    (M : parameterOrder v) :
    unitParameterAlgEquiv hv M = (M : Matrix (Fin 2) (Fin 2) R) := rfl

/-- Coordinates of the sum/difference frame relative to `(1,P,N₊,N₋)`.
These are columns; the last generator is `v * (2 * P - 1)`. -/
def cliffordCoordinateMatrix (v : R) : Matrix (Fin 4) (Fin 4) R :=
  !![1, 0, 0, -v;
     0, 0, 0, 2 * v;
     0, 1, 1, 0;
     0, 1, -1, 0]

/-- The factor `2` belongs to this frame change. It is absent from the
full-matrix splitting criterion `parameterOrder_eq_top_iff`. -/
theorem cliffordCoordinateMatrix_det (v : R) :
    (cliffordCoordinateMatrix v).det = -4 * v := by
  rw [Matrix.det_succ_column_zero]
  simp [cliffordCoordinateMatrix, Fin.sum_univ_succ, Matrix.det_fin_three]
  <;> ring

end Parameter

section Polynomial

variable (R : Type*) [CommRing R]

/-- The concrete polynomial order; `R = ℤ` is the integral specialization. -/
def polynomialOrder : Subalgebra R[X] (Matrix (Fin 2) (Fin 2) R[X]) :=
  parameterOrder (X : R[X])

private theorem divX_X_mul (p : R[X]) : (X * p).divX = p := by
  ext n
  simp only [Polynomial.coeff_divX, Polynomial.coeff_X_mul]

/-- Four independent polynomial coordinates for the concrete order.
Injectivity comes from polynomial coefficient extraction, without a
non-zero-divisor hypothesis on coefficients in `R`. -/
def coordinateEquiv : (Fin 4 → R[X]) ≃ₗ[R[X]] polynomialOrder R where
  toFun c := ⟨!![c 0 + c 1, c 2; X * c 3, c 0], ⟨c 3, rfl⟩⟩
  invFun M := ![(M : Matrix (Fin 2) (Fin 2) R[X]) 1 1,
    (M : Matrix (Fin 2) (Fin 2) R[X]) 0 0 - (M : Matrix (Fin 2) (Fin 2) R[X]) 1 1,
    (M : Matrix (Fin 2) (Fin 2) R[X]) 0 1,
    ((M : Matrix (Fin 2) (Fin 2) R[X]) 1 0).divX]
  left_inv c := by
    funext i
    fin_cases i <;> simp [divX_X_mul] <;> ring
  right_inv M := by
    apply Subtype.ext
    rcases M.property with ⟨d, hd⟩
    apply Matrix.ext
    intro i j
    fin_cases i <;> fin_cases j
    · change (M : Matrix (Fin 2) (Fin 2) R[X]) 1 1 +
        ((M : Matrix (Fin 2) (Fin 2) R[X]) 0 0 -
          (M : Matrix (Fin 2) (Fin 2) R[X]) 1 1) = _
      ring
    · rfl
    · change X * ((M : Matrix (Fin 2) (Fin 2) R[X]) 1 0).divX =
        (M : Matrix (Fin 2) (Fin 2) R[X]) 1 0
      rw [hd, divX_X_mul]
    · rfl
  map_add' c d := by
    apply Subtype.ext
    apply Matrix.ext
    intro i j
    fin_cases i <;> fin_cases j <;> simp [mul_add] <;> ring
  map_smul' a c := by
    apply Subtype.ext
    apply Matrix.ext
    intro i j
    fin_cases i <;> fin_cases j <;> simp [smul_eq_mul] <;> ring

@[simp]
theorem coordinateEquiv_apply (c : Fin 4 → R[X]) :
    (coordinateEquiv R c : Matrix (Fin 2) (Fin 2) R[X]) =
      !![c 0 + c 1, c 2; X * c 3, c 0] := rfl

/-- The inverse is explicit, including division by the formal variable only
on the lower-left entry, which is known to be divisible by it. -/
theorem coordinateEquiv_symm_apply (M : polynomialOrder R) :
    (coordinateEquiv R).symm M =
      ![(M : Matrix (Fin 2) (Fin 2) R[X]) 1 1,
        (M : Matrix (Fin 2) (Fin 2) R[X]) 0 0 -
          (M : Matrix (Fin 2) (Fin 2) R[X]) 1 1,
        (M : Matrix (Fin 2) (Fin 2) R[X]) 0 1,
        ((M : Matrix (Fin 2) (Fin 2) R[X]) 1 0).divX] := rfl

/-- Every coefficient of the fourth coordinate is recovered from the next
coefficient of the lower-left polynomial entry. -/
theorem coefficient_fourth_coordinate (M : polynomialOrder R) (n : ℕ) :
    ((coordinateEquiv R).symm M 3).coeff n =
      ((M : Matrix (Fin 2) (Fin 2) R[X]) 1 0).coeff (n + 1) :=
  Polynomial.coeff_divX

/-- A native four-element basis of the concrete polynomial matrix order. -/
def basis : Module.Basis (Fin 4) R[X] (polynomialOrder R) :=
  Module.Basis.ofEquivFun (coordinateEquiv R).symm

/-- The basis is exactly `(1, E₀₀, E₀₁, X E₁₀)`, with native matrix units. -/
theorem basis_coe (i : Fin 4) :
    (basis R i : Matrix (Fin 2) (Fin 2) R[X]) =
      ![(1 : Matrix (Fin 2) (Fin 2) R[X]),
        Matrix.single 0 0 (1 : R[X]),
        Matrix.single 0 1 (1 : R[X]),
        Matrix.single 1 0 (X : R[X])] i := by
  fin_cases i <;> apply Matrix.ext <;> intro j k <;> fin_cases j <;> fin_cases k <;>
    simp [basis, Module.Basis.coe_ofEquivFun, coordinateEquiv,
      Pi.single_apply, Matrix.single_apply, Matrix.one_apply]

/-- The polynomial coordinates of any order element are its native basis
coordinates; this exposes the complete representation map. -/
theorem basis_repr (M : polynomialOrder R) (i : Fin 4) :
    (basis R).repr M i = (coordinateEquiv R).symm M i := rfl

/-- The sum/difference frame in the concrete order. Its coordinates are
defined relative to the constructed basis, with no basis claim for this frame. -/
def cliffordFrame (j : Fin 4) : polynomialOrder R :=
  coordinateEquiv R ((cliffordCoordinateMatrix (X : R[X])).col j)

/-- The displayed frame consists of the identity, the two signed off-diagonal
sums, and their commutator. -/
theorem cliffordFrame_coe (i : Fin 4) :
    (cliffordFrame R i : Matrix (Fin 2) (Fin 2) R[X]) =
      ![(1 : Matrix (Fin 2) (Fin 2) R[X]),
        Matrix.single 0 1 (1 : R[X]) + Matrix.single 1 0 (X : R[X]),
        Matrix.single 0 1 (1 : R[X]) - Matrix.single 1 0 (X : R[X]),
        Matrix.single 0 1 (1 : R[X]) * Matrix.single 1 0 (X : R[X]) -
          Matrix.single 1 0 (X : R[X]) * Matrix.single 0 1 (1 : R[X])] i := by
  fin_cases i <;> apply Matrix.ext <;> intro j k <;> fin_cases j <;> fin_cases k <;>
    simp [cliffordFrame, coordinateEquiv_apply, cliffordCoordinateMatrix,
      Matrix.col, Matrix.single_apply, Matrix.one_apply, Matrix.mul_apply,
      Fin.sum_univ_two] <;> ring

/-- The change-of-generators matrix is an actual native `Basis.toMatrix`. -/
theorem basis_toMatrix_cliffordFrame :
    (basis R).toMatrix (cliffordFrame R) =
      cliffordCoordinateMatrix (X : R[X]) := by
  apply Matrix.ext
  intro i j
  change (coordinateEquiv R).symm
    (coordinateEquiv R ((cliffordCoordinateMatrix (X : R[X])).col j)) i = _
  rw [LinearEquiv.symm_apply_apply]
  rfl

/-- The determinant `-4 * X` concerns this frame relative to the integral
basis. It does not impose an invertibility condition on `2` for splitting. -/
theorem cliffordFrame_det :
    ((basis R).toMatrix (cliffordFrame R)).det = -4 * (X : R[X]) := by
  rw [basis_toMatrix_cliffordFrame, cliffordCoordinateMatrix_det]

end Polynomial

section PolynomialNoncommutativity

variable {R : Type*} [CommRing R]

private def polynomialCut : Matrix (Fin 2) (Fin 2) R[X] := basis R 1

private def polynomialUpper : Matrix (Fin 2) (Fin 2) R[X] := basis R 2

/-- The polynomial coordinate model keeps noncommuting basis vectors in its
actual ambient matrix ring. The public order witness above also applies here. -/
private theorem polynomial_basis_noncommutative [Nontrivial R] :
    polynomialCut (R := R) * polynomialUpper ≠ polynomialUpper * polynomialCut := by
  change (basis R 1 : Matrix (Fin 2) (Fin 2) R[X]) * (basis R 2) ≠
    (basis R 2 : Matrix (Fin 2) (Fin 2) R[X]) * (basis R 1)
  intro h
  have h01 := congrArg (fun M : Matrix (Fin 2) (Fin 2) R[X] => M 0 1) h
  simpa [basis_coe, Matrix.mul_apply, Fin.sum_univ_two, Matrix.single_apply] using h01

end PolynomialNoncommutativity

end InfoGeometry.OperatorAlgebra.PeirceSpine.IntegralOrder
