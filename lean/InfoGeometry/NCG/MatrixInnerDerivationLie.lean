import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Tactic.NoncommRing

/-!
# Inner derivations of noncommutative matrix operator algebras

For matrices over an arbitrary associative, possibly noncommutative ring, the
commutator is a Lie bracket and each adjoint map is a product derivation. The
commutator of two such operator derivations is again inner, with generator the
matrix commutator. No commutativity or scalar-matrix reduction is assumed.
-/

namespace InfoGeometry.NCG.MatrixInnerDerivationLie

open Matrix

variable {ι R : Type*} [Fintype ι] [DecidableEq ι] [Ring R]

/-- The element commutator in the associative matrix operator algebra. -/
def commutator (X Y : Matrix ι ι R) : Matrix ι ι R := X * Y - Y * X

/-- The inner operator derivation `ad X`, acting on the full matrix algebra. -/
def inner (X : Matrix ι ι R) : Matrix ι ι R → Matrix ι ι R :=
  fun Y => commutator X Y

/-- The matrix commutator satisfies Jacobi over every possibly noncommutative ring. -/
theorem commutator_jacobi (X Y Z : Matrix ι ι R) :
    commutator (commutator X Y) Z +
      commutator (commutator Y Z) X +
      commutator (commutator Z X) Y = 0 := by
  simp only [commutator]
  noncomm_ring

omit [DecidableEq ι] in
/-- Over noncommutative coefficients the trace of a commutator is the
difference of the two ordered coefficient contractions. This is the valid
replacement for an unjustified cyclic-trace-zero claim. -/
theorem trace_commutator_expansion (X Y : Matrix ι ι R) :
    Matrix.trace (commutator X Y) =
      (∑ i, ∑ j, X i j * Y j i) - (∑ i, ∑ j, Y i j * X j i) := by
  unfold commutator
  simp only [Matrix.trace, Matrix.diag_apply, Matrix.sub_apply, Matrix.mul_apply,
    Finset.sum_sub_distrib]

/-! ### A genuinely noncommutative coefficient witness -/

abbrev CoefficientOperator := Matrix (Fin 2) (Fin 2) ℤ

/-- Two matrix units in the coefficient operator ring. -/
def coefficientRaise : CoefficientOperator := !![0, 1; 0, 0]
def coefficientLower : CoefficientOperator := !![0, 0; 1, 0]

/-- The coefficient operators are genuinely noncommuting matrix operators. -/
theorem coefficient_operators_noncommute :
    coefficientRaise * coefficientLower ≠ coefficientLower * coefficientRaise := by
  decide

/-- Outer operators supported on the first channel, with noncommuting
coefficient operators as their only nonzero entries. -/
def nestedRaise : Matrix (Fin 2) (Fin 2) CoefficientOperator :=
  !![coefficientRaise, 0; 0, 0]
def nestedLower : Matrix (Fin 2) (Fin 2) CoefficientOperator :=
  !![coefficientLower, 0; 0, 0]

/-- The outer matrix trace of a commutator need not vanish when its coefficient
ring is itself a matrix operator algebra. -/
theorem nested_matrix_trace_commutator_value :
    Matrix.trace (commutator nestedRaise nestedLower) =
      !![1, 0; 0, -1] := by
  decide

theorem nested_matrix_trace_commutator_ne_zero :
    Matrix.trace (commutator nestedRaise nestedLower) ≠ 0 := by
  rw [nested_matrix_trace_commutator_value]
  decide

/-- The nested outer matrix operators themselves also fail to commute. -/
theorem nested_matrix_operators_noncommute :
    nestedRaise * nestedLower ≠ nestedLower * nestedRaise := by
  decide

/-- Every inner commutator map obeys the Leibniz rule on matrix products. -/
theorem inner_leibniz (X Y Z : Matrix ι ι R) :
    inner X (Y * Z) = inner X Y * Z + Y * inner X Z := by
  simp only [inner, commutator]
  noncomm_ring

/-- Each inner product derivation is also a derivation of the induced Lie
commutator. This follows at the operator level without assuming that any
matrix entries commute. -/
theorem inner_commutator_leibniz (X Y Z : Matrix ι ι R) :
    inner X (commutator Y Z) =
      commutator (inner X Y) Z + commutator Y (inner X Z) := by
  simp only [inner, commutator]
  noncomm_ring

/-- The commutator of inner derivation operators is inner, generated by the
commutator of their generators. This is composition of endomorphisms, distinct
from an element commutator in a nonassociative carrier. -/
theorem inner_commutator_closure (X Y Z : Matrix ι ι R) :
    inner X (inner Y Z) - inner Y (inner X Z) =
      inner (commutator X Y) Z := by
  simp only [inner, commutator]
  noncomm_ring

omit [DecidableEq ι] in
/-- The inner map sends a central generator to the zero derivation. -/
theorem inner_eq_zero_of_commutes (X : Matrix ι ι R)
    (hX : ∀ Y : Matrix ι ι R, X * Y = Y * X) :
    inner X = fun _ => 0 := by
  funext Y
  simp [inner, commutator, hX Y]

omit [DecidableEq ι] in
/-- The kernel of the adjoint action consists exactly of matrices commuting
with every matrix. Thus inner derivations identify generators modulo the
center, without requiring a field or commutative coefficient ring. -/
theorem inner_eq_zero_iff_commutes (X : Matrix ι ι R) :
    (inner X = fun _ => 0) ↔ ∀ Y : Matrix ι ι R, X * Y = Y * X := by
  constructor
  · intro h Y
    have hY := congrFun h Y
    exact sub_eq_zero.mp (by simpa [inner, commutator] using hY)
  · exact inner_eq_zero_of_commutes X

/-! ### Similarity transport on the full operator algebra

These identities use units in the matrix operator algebra itself.  The
coefficient ring `R` remains arbitrary and may be noncommutative. -/

/-- Conjugation by mutually inverse matrix operators. -/
def conjugate (U Uinv X : Matrix ι ι R) : Matrix ι ι R := U * X * Uinv

/-- Conjugation transports products, with no commutation assumption on entries. -/
theorem conjugate_mul (U Uinv X Y : Matrix ι ι R)
    (hleft : Uinv * U = 1) :
    conjugate U Uinv (X * Y) = conjugate U Uinv X * conjugate U Uinv Y := by
  change U * (X * Y) * Uinv = (U * X * Uinv) * (U * Y * Uinv)
  calc
    U * (X * Y) * Uinv = U * X * (Y * Uinv) := by noncomm_ring
    _ = U * X * ((Uinv * U) * (Y * Uinv)) := by rw [hleft]; simp
    _ = (U * X * Uinv) * (U * Y * Uinv) := by noncomm_ring

/-- Conjugation carries the matrix commutator to the commutator of the
conjugated operators. -/
theorem conjugate_commutator (U Uinv X Y : Matrix ι ι R)
    (hleft : Uinv * U = 1) :
    conjugate U Uinv (commutator X Y) =
      commutator (conjugate U Uinv X) (conjugate U Uinv Y) := by
  change U * (X * Y - Y * X) * Uinv =
    (U * X * Uinv) * (U * Y * Uinv) - (U * Y * Uinv) * (U * X * Uinv)
  calc
    U * (X * Y - Y * X) * Uinv =
        U * (X * Y) * Uinv - U * (Y * X) * Uinv := by noncomm_ring
    _ = (U * X * Uinv) * (U * Y * Uinv) -
        (U * Y * Uinv) * (U * X * Uinv) := by
      change conjugate U Uinv (X * Y) - conjugate U Uinv (Y * X) =
        conjugate U Uinv X * conjugate U Uinv Y -
          conjugate U Uinv Y * conjugate U Uinv X
      rw [← conjugate_mul U Uinv X Y hleft,
        ← conjugate_mul U Uinv Y X hleft]

/-- Similarity transport intertwines inner derivations.  This is an
operator-algebra covariance statement, not a claim that arbitrary linear
changes of coordinates preserve the product. -/
theorem conjugate_inner (U Uinv X Y : Matrix ι ι R)
    (hleft : Uinv * U = 1) :
    conjugate U Uinv (inner X Y) =
      inner (conjugate U Uinv X) (conjugate U Uinv Y) := by
  exact conjugate_commutator U Uinv X Y hleft

end InfoGeometry.NCG.MatrixInnerDerivationLie
