{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Singular/MoorePenrose.lean","time":1778389936185,"baseTime":1778389935319,"changes":[{"range":{"start":{"line":136,"character":0},"end":{"line":320,"character":0}},"text":"    rw [← map_sub, hzero]\n  exact (sub_eq_zero.mp hsub).symm\n\n/-- The restricted map `T : (ker A)ᗮ → range A` is injective. -/\nlemma restricted_injective (A : E →L[𝕜] F) :\n    Function.Injective (restricted A) := by\n  intro x y hxy\n  apply Subtype.ext\n  have hAxy : A (x : E) = A (y : E) := by\n    have hval := congrArg (fun z : A.range => (z : F)) hxy\n    exact hval\n  have hker : (x : E) - (y : E) ∈ A.ker := by\n    rw [LinearMap.mem_ker, map_sub, hAxy, sub_self]\n  have horth : (x : E) - (y : E) ∈ A.kerᗮ :=\n    Submodule.sub_mem (A.kerᗮ) x.property y.property\n  have hbot : (x : E) - (y : E) = 0 := by\n    have hmem : (x : E) - (y : E) ∈ A.ker ⊓ A.kerᗮ := ⟨hker, horth⟩\n    simpa [Submodule.inf_orthogonal_eq_bot (K := A.ker)] using hmem\n  exact sub_eq_zero.1 hbot\n\n/-- The restricted map `T : (ker A)ᗮ → range A` is surjective. -/\nlemma restricted_surjective (A : E →L[𝕜] F) :\n    Function.Surjective (restricted A) := by\n  intro y\n  rcases y.property with ⟨x, hx⟩\n  refine ⟨(A.kerᗮ).orthogonalProjection x, ?_⟩\n  apply Subtype.ext\n  change A ((A.kerᗮ).starProjection x) = (y : F)\n  rw [← hx]\n  exact map_starProjection_ker_orthogonal A x\n\nlemma restricted_ker_eq_bot (A : E →L[𝕜] F) :\n    (restricted A).ker = ⊥ := by\n  rw [LinearMap.ker_eq_bot]\n  exact restricted_injective A\n\nlemma restricted_range_eq_top (A : E →L[𝕜] F) :\n    (restricted A).range = ⊤ := by\n  rw [LinearMap.range_eq_top]\n  exact restricted_surjective A\n\n/-- The continuous linear equivalence `T : (ker A)ᗮ ≃L[𝕜] range A`.\n\nClosedness of `range A` is used here to make the inverse continuous via the Banach inverse theorem. -/\nnoncomputable def restrictedEquiv (A : E →L[𝕜] F) (hA : IsClosed (A.range : Set F)) :\n    A.kerᗮ ≃L[𝕜] A.range := by\n  haveI : CompleteSpace A.range := hA.completeSpace_coe\n  exact ContinuousLinearEquiv.ofBijective\n    (restricted A)\n    (restricted_ker_eq_bot A)\n    (restricted_range_eq_top A)\n\n/-- The Moore-Penrose inverse candidate for a closed-range bounded operator:\n`B = inclusion_K ∘ T⁻¹ ∘ projection_R`, where\n`K = (ker A)ᗮ` and `R = range A`. -/\nnoncomputable def inverse (A : E →L[𝕜] F) (hA : IsClosed (A.range : Set F)) :\n    F →L[𝕜] E :=\n  letI : CompleteSpace A.range := hA.completeSpace_coe\n  (A.kerᗮ).subtypeL ∘L (restrictedEquiv A hA).symm.toContinuousLinearMap ∘L A.range.orthogonalProjection\n\nlemma inverse_apply_mem_ker_orthogonal\n    (A : E →L[𝕜] F) (hA : IsClosed (A.range : Set F)) (y : F) :\n    inverse A hA y ∈ A.kerᗮ := by\n  letI : CompleteSpace A.range := hA.completeSpace_coe\n  exact ((restrictedEquiv A hA).symm (A.range.orthogonalProjection y)).property\n\n/-- First main operator identity: `A ∘ B` is the orthogonal projection onto `range A`. -/\ntheorem comp_inverse_eq_rangeProjection\n    (A : E →L[𝕜] F) (hA : IsClosed (A.range : Set F)) :\n    A ∘L inverse A hA = A.range.starProjection := by\n  letI : CompleteSpace A.range := hA.completeSpace_coe\n  apply ContinuousLinearMap.ext\n  intro y\n  have h :=\n    (restrictedEquiv A hA).apply_symm_apply (A.range.orthogonalProjection y)\n  have hcoe : A (inverse A hA y) = (A.range.orthogonalProjection y : F) := by\n    simp [inverse]\n    exact congr_arg (fun z : A.range => (z : F)) h\n  exact hcoe\n\n/-- Second main operator identity: `B ∘ A` is the orthogonal projection onto `(ker A)ᗮ`. -/\ntheorem inverse_comp_eq_kerOrthogonalProjection\n    (A : E →L[𝕜] F) (hA : IsClosed (A.range : Set F)) :\n    inverse A hA ∘L A = A.kerᗮ.starProjection := by\n  letI : CompleteSpace A.range := hA.completeSpace_coe\n  apply ContinuousLinearMap.ext\n  intro x\n  let kx : A.kerᗮ := (A.kerᗮ).orthogonalProjection x\n  have hproj :\n      A.range.orthogonalProjection (A x) =\n        (⟨A x, ⟨x, rfl⟩⟩ : A.range) := by\n    apply Subtype.ext\n    exact Submodule.starProjection_mem_subspace_eq_self (K := A.range) (⟨A x, ⟨x, rfl⟩⟩ : A.range)\n  have hT : restricted A kx = (⟨A x, ⟨x, rfl⟩⟩ : A.range) := by\n    apply Subtype.ext\n    simp [restricted, kx]\n    rw [map_starProjection_ker_orthogonal]\n  have hsymm :\n      (restrictedEquiv A hA).symm (A.range.orthogonalProjection (A x)) = kx := by\n    rw [hproj, ← hT]\n    exact (restrictedEquiv A hA).symm_apply_apply kx\n  simp [inverse, hsymm]\n  rfl\n\n/-- Moore-Penrose identity `A B A = A`. -/\ntheorem comp_inverse_comp_eq_self\n    (A : E →L[𝕜] F) (hA : IsClosed (A.range : Set F)) :\n    (A ∘L inverse A hA) ∘L A = A := by\n  rw [comp_inverse_eq_rangeProjection A hA]\n  apply ContinuousLinearMap.ext\n  intro x\n  exact Submodule.starProjection_mem_subspace_eq_self (K := A.range) (⟨A x, ⟨x, rfl⟩⟩ : A.range)\n\n/-- Moore-Penrose identity `B A B = B`. -/\ntheorem inverse_comp_self_comp_eq_self\n    (A : E →L[𝕜] F) (hA : IsClosed (A.range : Set F)) :\n    (inverse A hA ∘L A) ∘L inverse A hA = inverse A hA := by\n  rw [inverse_comp_eq_kerOrthogonalProjection A hA]\n  apply ContinuousLinearMap.ext\n  intro y\n  exact Submodule.starProjection_eq_self_iff.mpr\n    (inverse_apply_mem_ker_orthogonal A hA y)\n\n/-- Existence package for the Hilbert-space closed-range Moore-Penrose section. -/\ntheorem exists_inverse\n    (A : E →L[𝕜] F) (hA : IsClosed (A.range : Set F)) :\n    ∃ B : F →L[𝕜] E,\n      A ∘L B = A.range.starProjection ∧\n      B ∘L A = A.kerᗮ.starProjection ∧\n      (A ∘L B) ∘L A = A ∧\n      (B ∘L A) ∘L B = B := by\n  refine ⟨inverse A hA, ?_, ?_, ?_, ?_⟩\n  · exact comp_inverse_eq_rangeProjection A hA\n  · exact inverse_comp_eq_kerOrthogonalProjection A hA\n  · exact comp_inverse_comp_eq_self A hA\n  · exact inverse_comp_self_comp_eq_self A hA\n\nend ClosedRange\n\n/--\nExistence of Moore-Penrose inverse for bounded operators with closed range in Hilbert spaces.\n\nThis is the endomorphism version compatible with the `IsMoorePenroseInverse` predicate.\n-/\ntheorem exists_moorePenroseInverse_of_closedRange\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    ∃ (B : E →L[𝕜] E), IsMoorePenroseInverse A B := by\n  rcases ClosedRange.exists_inverse A hClosedRange with ⟨B, hAB, hBA, hABA, hBAB⟩\n  refine ⟨B, ?_, ?_, ?_, ?_⟩\n  · -- A * B * A = A\n    apply ContinuousLinearMap.ext\n    intro x\n    simpa using ContinuousLinearMap.congr_fun hABA x\n  · -- B * A * B = B\n    apply ContinuousLinearMap.ext\n    intro x\n    simpa using ContinuousLinearMap.congr_fun hBAB x\n  · -- (A * B)† = A * B\n    change star (A * B) = A * B\n    rw [← ContinuousLinearMap.coe_mul] at hAB ⊢\n    rw [hAB]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection A.range)\n  · -- (B * A)† = B * A\n    change star (B * A) = B * A\n    rw [← ContinuousLinearMap.coe_mul] at hBA ⊢\n","rangeOffset":5064,"rangeLength":7137}]}