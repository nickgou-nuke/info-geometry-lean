import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Canonical.TrifactorDecomposition

/-!
# Trifactor Zeta Bridge

This file formalizes a conditional algebraic projector-collapse lemma in the
three-sector geometry generated by a tripotent operator `O^3 = O`.

It does not prove the Riemann hypothesis. The theorems below state that once an
active-channel annihilation premise `(P_plus O_scale + P_minus O_scale) • ρ = 0` is
explicitly supplied, the state lies in the `P_zero` sector by partition of unity.

- BUCKET 1 (Established Mathematical Target & Existing Owners):
  * `InfoGeometry.Canonical.TrifactorDecomposition`: `P_zero`, `P_plus`, `P_minus`,
    `partition_of_unity`.
- BUCKET 2 (Deconfabulation):
  * Eliminated the disallowed `Prop`-valued `def JSymmetricMode` wrapper and used the
    explicit fixed-point hypothesis `J ρ = ρ` constructively in
    `riemann_zeros_in_vacuum_sector`.
- BUCKET 3 (Constructive Lean 4 Theorems Proved Here):
  * `state_in_vacuum_sector_of_active_channels_vanish`,
    `riemann_zeros_in_vacuum_sector`.
-/

namespace InfoGeometry.GrandUnification.TrifactorZeta

open InfoGeometry.Canonical.TrifactorDecomposition

variable {R : Type*} [Ring R] [Invertible (2 : R)]
variable {H : Type*} [AddCommGroup H] [Module R H]

/-- If the active `P_plus + P_minus` channels annihilate a state `ρ`, the partition of
unity for the tripotent projectors forces `ρ` to lie in the `P_zero` vacuum sector. -/
theorem state_in_vacuum_sector_of_active_channels_vanish (O_scale : R) (ρ : H)
    (h_chiral_anomaly : (P_plus O_scale + P_minus O_scale) • ρ = 0) :
    P_zero O_scale • ρ = ρ := by
  have h_part := partition_of_unity O_scale
  have h_sum : (P_zero O_scale + (P_plus O_scale + P_minus O_scale)) • ρ = ρ := by
    calc
      (P_zero O_scale + (P_plus O_scale + P_minus O_scale)) • ρ =
          (P_zero O_scale + P_plus O_scale + P_minus O_scale) • ρ := by rw [add_assoc]
      _ = 1 • ρ := congrArg (fun x => x • ρ) h_part
      _ = ρ := by rw [one_smul]
  rw [add_smul, h_chiral_anomaly, add_zero] at h_sum
  exact h_sum

/-- If a `J`-symmetric state `J ρ = ρ` has vanishing active `P_plus + P_minus` channel
projection, then `P_zero O_scale • ρ = ρ` and `J` fixes the `P_zero`-projected state. -/
theorem riemann_zeros_in_vacuum_sector (O_scale : R) (J : H → H) (ρ : H) (h_zero : J ρ = ρ)
    (h_chiral_anomaly : (P_plus O_scale + P_minus O_scale) • ρ = 0) :
    P_zero O_scale • ρ = ρ ∧ J (P_zero O_scale • ρ) = ρ := by
  have hvac : P_zero O_scale • ρ = ρ :=
    state_in_vacuum_sector_of_active_channels_vanish O_scale ρ h_chiral_anomaly
  refine ⟨hvac, ?_⟩
  rw [hvac]
  exact h_zero

end InfoGeometry.GrandUnification.TrifactorZeta
