    2. **Schwinger Quantum Action Principle (Leibniz Derivation Law)**:
       `J_1 P (X * Y) = J_1 P X * Y + X * J_1 P Y`,
    3. **Tomita-Takesaki Modular Conjugation Anti-Parity**:
       `S_P P * J_1 P X * S_P P = - J_1 P X` and `S_P P * J_2 P X * S_P P = - J_2 P X`,
    4. **Pascual Jordan Homotope / Kantor Triple Self-Reproduction**:
       `Q_pos P X * Q_neg P X * Q_pos P X = V_P P X * Q_pos P X` and
       `Q_pos P X * Q_neg P X * Q_pos P X = Q_pos P X * Sigma_P P X`,
    5. **Takesaki Conditional Expectation Idempotence & Bimodule Property**:
       `E_diag P (E_diag P X) = E_diag P X` and
       `E_diag P (E_diag P X * Y) = E_diag P X * E_diag P Y`,
    6. **Wheeler "Law Without Law" Boundary-of-a-Boundary (`∂ ∂ = 0`)**:
       `Q_pos P X * Q_pos P X = 0` and `Q_neg P X * Q_neg P X = 0`. -/
theorem ten_forgotten_archetypes_and_wheeler_it_from_bit
    {P : B} (hP : P * P = P) (X Y : B) :
    -- 1. Born-Jordan / Weyl quantization anomaly
    anticomm P X - 2 • X_11 P X = J_2 P X ∧
    -- 2. Schwinger action principle derivation rule
    J_1 P (X * Y) = J_1 P X * Y + X * J_1 P Y ∧
    -- 3. Tomita-Takesaki modular conjugation anti-parity
    (S_P P * J_1 P X * S_P P = - J_1 P X ∧
     S_P P * J_2 P X * S_P P = - J_2 P X) ∧
    -- 4. Pascual Jordan triple self-reproduction
    (Q_pos P X * Q_neg P X * Q_pos P X = V_P P X * Q_pos P X ∧
     Q_pos P X * Q_neg P X * Q_pos P X = Q_pos P X * Sigma_P P X) ∧
    -- 5. Takesaki conditional expectation idempotence & bimodule projection
    (E_diag P (E_diag P X) = E_diag P X ∧
     E_diag P (E_diag P X * Y) = E_diag P X * E_diag P Y) ∧
    -- 6. Wheeler boundary-of-a-boundary nilpotency
    (Q_pos P X * Q_pos P X = 0 ∧ Q_neg P X * Q_neg P X = 0) := by
  refine ⟨?_, ?_, ⟨?_, ?_⟩, ⟨rfl, by dsimp [Sigma_P]; rw [mul_assoc]⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
  · dsimp [anticomm, X_11, J_2, J_1, comm]
    simp only [mul_sub, sub_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [J_1, comm]
