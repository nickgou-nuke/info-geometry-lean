{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://info-geometry.local/schema/hive_runtime/GoalPacket.schema.json",
  "title": "GoalPacket",
  "type": "object",
  "required": ["schema", "goal_id", "formal_target", "queue_name", "priority", "created_at", "source_regime"],
  "properties": {
    "schema": { "const": "hive.runtime.goal.v1" },
    "goal_id": { "type": "string", "minLength": 1 },
    "formal_target": { "type": "string", "minLength": 1 },
    "module_hint": { "type": "string" },
    "queue_name": { "type": "string", "minLength": 1 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "source_regime": {
      "type": "string",
      "enum": ["symbolic", "research", "theorem_lane", "synthetic_smoke", "infrastructure", "unknown"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" },
    "lineage_id": { "type": "string" }
  },
  "additionalProperties": true
}
