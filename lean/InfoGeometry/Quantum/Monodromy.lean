/--
CLOSED THEOREM: the nilpotent Jordan power/monodromy step.

If `N² = 0` and `u` commutes with `N`, then the non-diagonal Jordan cell
`u + N` satisfies the exact finite power formula

`(u + N)^(n + 1) = u^(n + 1) + (n + 1) • (u^n * N)`.
-/
theorem nilpotent_jordan_power
    (u N : A)
    (h_comm : Commute u N)
    (h_nil : N * N = 0)
    (n : ℕ) :
    (u + N) ^ (n + 1) = u ^ (n + 1) + (n + 1) • (u ^ n * N) := by
  induction n with
  | zero =>
      simp
  | succ k ih =>
      have h_pow_L : (u + N) ^ (k + 2) = (u + N) ^ (k + 1) * (u + N) := by
        simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
          (pow_succ (u + N) (k + 1))
      rw [h_pow_L, ih]
      rw [add_mul, mul_add, mul_add]
      have h_pow_succ : u ^ (k + 1) * u = u ^ (k + 2) := by
        simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
          (pow_succ u (k + 1)).symm
      rw [h_pow_succ]
      have h_smul_mul1 :
          ((k + 1) • (u ^ k * N)) * u = (k + 1) • (u ^ (k + 1) * N) := by
        have hcore : (u ^ k * N) * u = u ^ (k + 1) * N := by
          calc
            u ^ k * N * u = u ^ k * (N * u) := by rw [mul_assoc]
            _ = u ^ k * (u * N) := by rw [h_comm.symm.eq]
            _ = (u ^ k * u) * N := by rw [← mul_assoc]
            _ = u ^ (k + 1) * N := by rw [pow_succ]
        simpa [nsmul_eq_mul, mul_assoc] using
          congrArg (fun x => ((k + 1 : ℕ) : A) * x) hcore
      have h_smul_mul2 : ((k + 1) • (u ^ k * N)) * N = 0 := by
        have h_zero : u ^ k * N * N = 0 := by
          calc
            u ^ k * N * N = u ^ k * (N * N) := by rw [mul_assoc]
            _ = u ^ k * 0 := by rw [h_nil]
            _ = 0 := by rw [mul_zero]
        simpa [nsmul_eq_mul, mul_assoc] using
          congrArg (fun x => ((k + 1 : ℕ) : A) * x) h_zero
      rw [h_smul_mul1, h_smul_mul2, add_zero]
      simp only [nsmul_eq_mul]
      calc
        u ^ (k + 2) + u ^ (k + 1) * N + ((k + 1 : ℕ) : A) * (u ^ (k + 1) * N)
            = u ^ (k + 2) +
                (u ^ (k + 1) * N + ((k + 1 : ℕ) : A) * (u ^ (k + 1) * N)) := by
              rw [add_assoc]
        _ = u ^ (k + 2) +
                ((1 : A) * (u ^ (k + 1) * N) +
                  ((k + 1 : ℕ) : A) * (u ^ (k + 1) * N)) := by
              rw [one_mul]
        _ = u ^ (k + 2) +
                (((1 : A) + ((k + 1 : ℕ) : A)) * (u ^ (k + 1) * N)) := by
              rw [add_mul]
        _ = u ^ (k + 1 + 1) +
                (((k + 1 + 1 : ℕ) : A) * (u ^ (k + 1) * N)) := by
              have hpow : u ^ (k + 2) = u ^ (k + 1 + 1) := by
                have hk : k + 2 = k + 1 + 1 := by omega
                rw [hk]
              have hcast :
                  (1 : A) + ((k + 1 : ℕ) : A) = ((k + 1 + 1 : ℕ) : A) := by
                calc
                  (1 : A) + ((k + 1 : ℕ) : A)
                      = 1 + (((k : ℕ) : A) + 1) := by
                        rw [Nat.cast_add, Nat.cast_one]
                  _ = (1 + ((k : ℕ) : A)) + 1 := by
                        rw [add_assoc]
                  _ = ((1 + k : ℕ) : A) + 1 := by
                        rw [Nat.cast_add, Nat.cast_one]
                  _ = ((1 + k + 1 : ℕ) : A) := by
                        have h :
                            (((1 + k) + 1 : ℕ) : A) =
                              ((1 + k : ℕ) : A) + ((1 : ℕ) : A) :=
                          Nat.cast_add (1 + k) 1
                        rw [Nat.cast_one] at h
                        exact h.symm
                  _ = ((k + 1 + 1 : ℕ) : A) := by
                        exact congrArg (fun m : ℕ => (m : A)) (by omega)
              rw [hpow]
              rw [hcast]

end InfoGeometry.QuantumMonodromy
