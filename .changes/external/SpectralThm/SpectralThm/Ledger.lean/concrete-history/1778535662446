{"type":"new","contents":"module\n\npublic import Mathlib.Algebra.Ring.Basic\npublic import Mathlib.Algebra.Star.Basic\npublic import Mathlib.Analysis.InnerProductSpace.Adjoint\npublic import Mathlib.Analysis.InnerProductSpace.Projection.Basic\npublic import Mathlib.Analysis.InnerProductSpace.Projection.Submodule\npublic import Mathlib.Analysis.Normed.Operator.Banach\npublic import SpectralThm.MoorePenrose\n\n/-!\n# Spectral / Schur / Drazin / Moore--Penrose projector ledger\n\nThis module records the four-layer singular-operator split for architectural stability:\n\n* Spectral resolution: orthogonal mode split for normal/self-adjoint regular sectors.\n* Schur form: triangular substitute when normality fails.\n* Drazin inverse: dynamical split into regular and generalized zero sectors.\n* Moore--Penrose inverse: metric split into orthogonal range/coimage sectors.\n\nThis file provides the witness-gated ledger structures and algebraic projector wrappers.\nThe \"solid\" analytic constructors are intentionally deferred to ensure API stability.\n-/\n\nopen scoped BigOperators\n\n@[expose] public section\n\nnamespace SpectralThm.MoorePenrose\n\n/-! ## 1. Drazin Inverse Predicate -/\n\nsection Drazin\n\nvariable {R : Type*} [Ring R]\n\n/-- The three equations defining the Drazin inverse of index k. -/\ndef IsDrazinInverse (A D : R) (k : ℕ) : Prop :=\n  D * A * D = D ∧\n  A * D = D * A ∧\n  A^k = A^(k + 1) * D\n\nnamespace IsDrazinInverse\n\nvariable {A D : R} {k : ℕ}\n\ntheorem mk\n    (h1 : D * A * D = D)\n    (h2 : A * D = D * A)\n    (h3 : A^k = A^(k + 1) * D) :\n    IsDrazinInverse A D k :=\n  ⟨h1, h2, h3⟩\n\ntheorem dad_eq_d (h : IsDrazinInverse A D k) : D * A * D = D := h.1\ntheorem comm (h : IsDrazinInverse A D k) : A * D = D * A := h.2.1\ntheorem pow_eq_pow_succ_mul (h : IsDrazinInverse A D k) : A^k = A^(k + 1) * D := h.2.2\n\nend IsDrazinInverse\n\n/-- The spectral/core projector P_D = A * D. -/\ndef drazinProjector (A D : R) (k : ℕ) (_h : IsDrazinInverse A D k) : R := A * D\n\nlemma drazinProjector_idempotent {A D : R} {k : ℕ} (h : IsDrazinInverse A D k) :\n    drazinProjector A D k h * drazinProjector A D k h = drazinProjector A D k h := by\n  unfold drazinProjector\n  calc\n    (A * D) * (A * D) = A * (D * A * D) := by simp [mul_assoc]\n    _ = A * D := by rw [h.dad_eq_d]\n\nend Drazin\n\n/-! ## 2. Resolution of Identity Ledger -/\n\n/--\nWitness-gated spectral resolution for a normal/self-adjoint sector.\nThis structure acts as an architectural contract for spectral decomposition data.\n-/\nstructure ResolutionOfIdentityLedger\n    (R Mode Scalar : Type*) [Ring R] [StarRing R] [SMul Scalar R] where\n  /-- Operator being spectrally resolved. -/\n  A : R\n  /-- Eigenvalue readout for each mode. -/\n  eigenvalue : Mode → Scalar\n  /-- Spectral projector for each mode. -/\n  spectralProjector : Mode → R\n  /-- Distinguished zero/singular spectral modes. -/\n  is_zero_mode : Mode → Prop\n\n  /-- Projectors are idempotent. -/\n  projector_idempotent : ∀ i : Mode,\n    spectralProjector i * spectralProjector i = spectralProjector i\n  /-- Distinct projectors are orthogonal. -/\n  projector_orthogonal : ∀ i j : Mode, i ≠ j →\n    spectralProjector i * spectralProjector j = 0\n  /-- Sum of projectors is the identity. -/\n  projector_sum_identity : ∀ [Fintype Mode],\n    ∑ i : Mode, spectralProjector i = 1\n  /-- Spectral projectors are self-adjoint. -/\n  projector_self_adjoint : ∀ i : Mode,\n    star (spectralProjector i) = spectralProjector i\n  /-- Spectral expansion law: A = Σ λᵢ Pᵢ. -/\n  spectral_expansion_law : ∀ [Fintype Mode],\n    A = ∑ i : Mode, eigenvalue i • spectralProjector i\n\n/-- Target property for existence of a spectral resolution. -/\ndef ResolutionOfIdentityLedgerOwnerTarget\n    (R Mode Scalar : Type*) [Ring R] [StarRing R] [SMul Scalar R] : Prop :=\n  Nonempty (ResolutionOfIdentityLedger R Mode Scalar)\n\n/-! ## 3. Moore-Penrose Projector Wrappers -/\n\nsection MoorePenroseWrappers\n\nvariable {R : Type*} [Ring R] [StarRing R]\n\n/-- The range projector A * B from a Moore-Penrose pair. -/\ndef moorePenroseRangeProjector (A B : R) (hMP : IsMoorePenroseInverse A B) : R :=\n  mpProjector A B hMP\n\n/-- The coimage projector B * A from a Moore-Penrose pair. -/\ndef moorePenroseCoimageProjector (A B : R) (_hMP : IsMoorePenroseInverse A B) : R :=\n  B * A\n\ntheorem moorePenroseRangeProjector_idempotent {A B : R} (hMP : IsMoorePenroseInverse A B) :\n    moorePenroseRangeProjector A B hMP * moorePenroseRangeProjector A B hMP =\n      moorePenroseRangeProjector A B hMP :=\n  mpProjector_idempotent hMP\n\ntheorem moorePenroseRangeProjector_self_adjoint {A B : R} (hMP : IsMoorePenroseInverse A B) :\n    star (moorePenroseRangeProjector A B hMP) = moorePenroseRangeProjector A B hMP :=\n  mpProjector_self_adjoint hMP\n\ntheorem moorePenroseCoimageProjector_idempotent {A B : R} (hMP : IsMoorePenroseInverse A B) :\n    moorePenroseCoimageProjector A B hMP * moorePenroseCoimageProjector A B hMP =\n      moorePenroseCoimageProjector A B hMP := by\n  unfold moorePenroseCoimageProjector\n  calc\n    (B * A) * (B * A) = B * (A * B * A) := by rw [← mul_assoc]\n    _ = B * A := by rw [hMP.aba_eq_a]\n\ntheorem moorePenroseCoimageProjector_self_adjoint {A B : R} (hMP : IsMoorePenroseInverse A B) :\n    star (moorePenroseCoimageProjector A B hMP) = moorePenroseCoimageProjector A B hMP :=\n  hMP.ba_star_eq\n\nend MoorePenroseWrappers\n\n/-! ## 4. Combined Drazin and Moore-Penrose Ledger -/\n\n/--\nWitness-gated structure recording both the dynamical (Drazin) and metric (MP)\nsplits for an operator.\n-/\nstructure DrazinMoorePenroseLedger\n    (R : Type*) [Ring R] [StarRing R] where\n  A : R\n  D : R\n  k : ℕ\n  drazin : IsDrazinInverse A D k\n  B : R\n  moorePenrose : IsMoorePenroseInverse A B\n\n/-- Schur normal form socket structure. -/\nstructure SchurDrazinNormalForm\n    (R : Type*) [Ring R] [StarRing R] where\n  A : R\n  U : R\n  T : R\n  hSchur : A = U * T * star U\n  hUnitary : U * star U = 1 ∧ star U * U = 1\n\n/-- SVD normal form socket structure. -/\nstructure SVDMoorePenroseNormalForm\n    (𝕜 E : Type*) [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E] where\n  A : E →L[𝕜] E\n  U : E ≃L[𝕜] E\n  V : E ≃L[𝕜] E\n  s : E →L[𝕜] E\n  hSVD : A = (U.toContinuousLinearMap.comp s).comp V.symm.toContinuousLinearMap\n  hU_unitary : star U.toContinuousLinearMap * U.toContinuousLinearMap = 1\n  hV_unitary : star V.toContinuousLinearMap * V.toContinuousLinearMap = 1\n\nend SpectralThm.MoorePenrose\n","mtime":1778535662446}