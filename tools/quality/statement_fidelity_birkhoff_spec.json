      },
      "required_hypotheses": [
        {
          "name": "peirce_idempotents",
          "pattern": "PeirceIdempotents",
          "description": "Orthogonal idempotent decomposition structure"
        }
      ],
      "target_relation": {
        "type": "equality",
        "relation_symbol": "=",
        "pattern": "\\(P\\.pL\\s*-\\s*P\\.pR\\)\\s*\\*\\s*\\(P\\.pL\\s*-\\s*P\\.pR\\)\\s*=\\s*1"
      }
