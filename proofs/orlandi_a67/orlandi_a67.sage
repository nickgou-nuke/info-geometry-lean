tau_As=QQ(7)/QQ(10)
tau_Se=QQ(13)/QQ(10)
BE1_As_1=QQ(13)/QQ(10)
BE1_Se_1=QQ(1)
BE1_As_2=QQ(81)/QQ(10)*QQ(1)/QQ(10^6)
BE1_Se_2=QQ(17)/QQ(10)*QQ(1)/QQ(10^6)
assert tau_Se/tau_As == QQ(13)/QQ(7)
assert BE1_As_1/BE1_Se_1 == QQ(13)/QQ(10)
assert BE1_As_2/BE1_Se_2 == QQ(81)/QQ(17)
assert BE1_As_2-BE1_Se_2 == QQ(32)/QQ(5)*QQ(1)/QQ(10^6)
print((tau_Se/tau_As, BE1_As_1/BE1_Se_1, BE1_As_2/BE1_Se_2, BE1_As_2-BE1_Se_2))
