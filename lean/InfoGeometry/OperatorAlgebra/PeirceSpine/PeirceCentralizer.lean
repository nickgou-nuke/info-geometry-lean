import InfoGeometry.OperatorAlgebra.PeirceSpine.IntegralWeyl
import InfoGeometry.OperatorAlgebra.PeirceSpine.StarGrading
import InfoGeometry.Physics.Algebra.TripotentFiveGradingDecomposition
import Mathlib.Algebra.Star.Subalgebra

/-!
# The Gram centralizer and its Peirce parity

The centralizer is Mathlib's native star subalgebra of the actual ambient
ring. Its self-adjoint denominator `1 + V` is central internally, without
assuming that `V` is central in the ambient ring. On the idempotent-support
locus the centralizer is exactly the existing even Peirce range. The ring
generated by a binary cut and its two adjoint corners is contained in this
centralizer, and therefore contains no nonzero odd Peirce element.

Over a real algebra, the existing tripotent projectors identify this even
part with the sum of adjoint grades `-2`, `0`, and `2`. The corresponding
odd grade intersections vanish. These are statements about the ambient
operator algebra and its native subspaces, not physical statistics or an
anomaly-cancellation theorem.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine.PeirceCentralizer

open _root_.OperatorAlgebra.PeirceSpine.RealBdGKreinChiralIdealBridge
open InfoGeometry.Core.PeirceGrading

variable {B : Type*} [Ring B] [StarRing B]

/-- The native star subalgebra centralizing the self-adjoint Gram support. -/
def supportCentralizer (N : B) : StarSubalgebra ℤ B :=
  StarSubalgebra.centralizer ℤ {V N}

@[simp] theorem mem_supportCentralizer {N X : B} :
    X ∈ supportCentralizer N ↔ Commute (V N) X := by
  change X ∈ StarSubalgebra.centralizer ℤ ({V N} : Set B) ↔ _
  rw [StarSubalgebra.mem_centralizer_iff]
  constructor
  · intro h
    exact (h (V N) (by simp)).1
  · intro h g hg
    rcases Set.mem_singleton_iff.mp hg with rfl
    exact ⟨h.eq, by simpa only [V_star] using h.eq⟩

/-- Self-adjointness makes the star centralizer the ordinary ring centralizer. -/
theorem supportCentralizer_toSubring (N : B) :
    (supportCentralizer N).toSubalgebra.toSubring =
      Subring.centralizer ({V N} : Set B) := by
  ext X
  change X ∈ supportCentralizer N ↔ X ∈ Subring.centralizer ({V N} : Set B)
  rw [mem_supportCentralizer, Subring.mem_centralizer_iff]
  change (V N * X = X * V N) ↔
    ∀ g ∈ ({V N} : Set B), g * X = X * g
  simp only [Set.mem_singleton_iff, forall_eq]

/-- The actual denominator as an element of its lawful star subalgebra. -/
def denominator (N : B) : supportCentralizer N :=
  ⟨1 + V N, mem_supportCentralizer.mpr (by
    change V N * (1 + V N) = (1 + V N) * V N
    noncomm_ring)⟩

@[simp] theorem coe_denominator (N : B) :
    (denominator N : B) = 1 + V N := rfl

theorem denominator_central (N : B) (X : supportCentralizer N) :
    Commute (denominator N) X := by
  change denominator N * X = X * denominator N
  apply Subtype.ext
  change (1 + V N) * (X : B) = (X : B) * (1 + V N)
  have hx := (mem_supportCentralizer.mp X.property).eq
  simp only [add_mul, mul_add, one_mul, mul_one, hx]

theorem denominator_selfAdjoint (N : B) : IsSelfAdjoint (denominator N) := by
  change star (denominator N) = denominator N
  apply Subtype.ext
  change star (1 + V N) = 1 + V N
  simp only [star_add, star_one, V_star]

theorem denominator_left_injective (hF : ThreeSumStarFaithful B) (N : B) :
    Function.Injective (fun X : supportCentralizer N => denominator N * X) := by
  intro X Y hXY
  apply Subtype.ext
  apply hF.one_add_gram_left_injective N
  exact congrArg (fun Z : supportCentralizer N => (Z : B)) hXY

/-- On shell the ordinary centralizer is the actual even Peirce range. -/
theorem mem_supportCentralizer_iff_even {N X : B} (hV : V N * V N = V N) :
    X ∈ supportCentralizer N ↔ X ∈ LinearMap.range (even (V N)) := by
  rw [mem_supportCentralizer]
  exact (mem_even_iff hV).symm

/-- The even and odd Peirce ranges meet only at zero, without a torsion hypothesis. -/
theorem eq_zero_of_mem_supportCentralizer_of_mem_odd {N X : B}
    (hV : V N * V N = V N) (hC : X ∈ supportCentralizer N)
    (hO : X ∈ LinearMap.range (odd (V N))) : X = 0 :=
  (Submodule.disjoint_def.mp (isCompl hV).disjoint) X
    ((mem_supportCentralizer_iff_even hV).mp hC) hO

/-- Faithfulness supplies the precise cancellation required by the reflection criterion. -/
theorem reflection_fixed_iff_mem_supportCentralizer (hF : ThreeSumStarFaithful B)
    {N X : B} (hV : V N * V N = V N) :
    reflection (V N) * X * reflection (V N) = X ↔ X ∈ supportCentralizer N := by
  rw [mem_supportCentralizer_iff_even hV]
  constructor
  · intro hX
    apply (eigenspace_criteria hV hF.doubling_injective).1.mpr
    have h := congrArg (fun Y : B => Y * reflection (V N)) hX
    simpa only [mul_assoc, reflection_sq hV, mul_one] using h
  · intro hX
    have h := (eigenspace_criteria hV hF.doubling_injective).1.mp hX
    rw [h, mul_assoc, reflection_sq hV, mul_one]

theorem seed_mem_supportCentralizer {N : B} (hN : N * N = 0) :
    N ∈ supportCentralizer N :=
  mem_supportCentralizer.mpr (IntegralWeyl.support_commute_seed hN)

theorem star_seed_mem_supportCentralizer {N : B} (hN : N * N = 0) :
    star N ∈ supportCentralizer N :=
  star_mem (seed_mem_supportCentralizer hN)

/-- The original binary cut commutes with the Gram support before normalization. -/
theorem support_commute_cut {p : B} (hp : p * p = p) (hps : star p = p) (A : B) :
    Commute (V (conePlus p A)) p := by
  change V (conePlus p A) * p = p * V (conePlus p A)
  simp only [V, star_conePlus hps]
  peirce_nf hp

/-- All words in the cut and its two adjoint corners stay in the ordinary centralizer. -/
theorem generated_le_centralizer {p : B} (hp : p * p = p)
    (hps : star p = p) (A : B) :
    Subring.closure ({p, conePlus p A, star (conePlus p A)} : Set B) ≤
      Subring.centralizer ({V (conePlus p A)} : Set B) := by
  have hN := conePlus_mul_conePlus hp A A
  have to_mem {X : B} (h : Commute (V (conePlus p A)) X) :
      X ∈ Subring.centralizer ({V (conePlus p A)} : Set B) := by
    rw [Subring.mem_centralizer_iff]
    intro g hg
    rcases Set.mem_singleton_iff.mp hg with rfl
    exact h.eq
  apply Subring.closure_le.mpr
  intro X hX
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hX
  rcases hX with rfl | rfl | rfl
  · exact to_mem (support_commute_cut hp hps A)
  · exact to_mem (IntegralWeyl.support_commute_seed hN)
  · exact to_mem (IntegralWeyl.support_commute_star_seed hN)

theorem generated_mem_supportCentralizer {p A X : B} (hp : p * p = p)
    (hps : star p = p)
    (hX : X ∈ Subring.closure ({p, conePlus p A, star (conePlus p A)} : Set B)) :
    X ∈ supportCentralizer (conePlus p A) := by
  change X ∈ (supportCentralizer (conePlus p A)).toSubalgebra.toSubring
  rw [supportCentralizer_toSubring]
  exact generated_le_centralizer hp hps A hX

/-- The generated ring has no nonzero odd Peirce element on shell. -/
theorem generated_odd_eq_zero {p A X : B} (hp : p * p = p) (hps : star p = p)
    (hV : V (conePlus p A) * V (conePlus p A) = V (conePlus p A))
    (hX : X ∈ Subring.closure ({p, conePlus p A, star (conePlus p A)} : Set B))
    (hO : X ∈ LinearMap.range (odd (V (conePlus p A)))) : X = 0 :=
  eq_zero_of_mem_supportCentralizer_of_mem_odd hV
    (generated_mem_supportCentralizer hp hps hX) hO

section RealFiveGrades

open InfoGeometry.Physics.Algebra

/-- The attachment's support hypothesis discharges the existing tripotent prerequisite. -/
theorem sigma_tripotent (hF : ThreeSumStarFaithful B) {N : B}
    (hN : N * N = 0) (hV : V N * V N = V N) :
    Sigma N * Sigma N * Sigma N = Sigma N := by
  have hr := IntegralWeyl.regular_of_support_idempotent hF hN hV
  rw [Sigma_sq_eq_V N hN hr, V_mul_Sigma N hN hr]

theorem projZero_sigma (hF : ThreeSumStarFaithful B) {N : B}
    (hN : N * N = 0) (hV : V N * V N = V N) :
    projZero (Sigma N) = 1 - V N := by
  unfold projZero
  rw [Sigma_sq_eq_V N hN (IntegralWeyl.regular_of_support_idempotent hF hN hV)]

variable [Algebra ℝ B]

/-- The existing even support projection is exactly the sum of the three even grades. -/
theorem even_support_eq_even_grades (hF : ThreeSumStarFaithful B) {N : B}
    (hN : N * N = 0) (hV : V N * V N = V N) (X : B) :
    even (V N) X = gradeNegTwoProjector (Sigma N) X +
      gradeZeroProjector (Sigma N) X + gradePosTwoProjector (Sigma N) X := by
  have hPN : projPos (Sigma N) + projNeg (Sigma N) = V N := by
    rw [projPos_add_projNeg, Sigma_sq_eq_V N hN
      (IntegralWeyl.regular_of_support_idempotent hF hN hV)]
  simp only [even_apply, gradeNegTwoProjector, gradeZeroProjector,
    gradePosTwoProjector, LinearMap.add_apply, jointPeirceProjector_apply,
    peirceProjector_zero, peirceProjector_pos, peirceProjector_neg,
    projZero_sigma hF hN hV, ← hPN]
  noncomm_ring

/-- Centralizing `V` is equivalent to being the sum of grades `-2`, `0`, and `2`. -/
theorem commute_support_iff_even_grades (hF : ThreeSumStarFaithful B) {N X : B}
    (hN : N * N = 0) (hV : V N * V N = V N) :
    Commute (V N) X ↔
      gradeNegTwoProjector (Sigma N) X + gradeZeroProjector (Sigma N) X +
        gradePosTwoProjector (Sigma N) X = X := by
  rw [← mem_supportCentralizer, mem_supportCentralizer_iff_even hV,
    LinearMap.IsIdempotentElem.mem_range_iff (even_idempotent hV),
    even_support_eq_even_grades hF hN hV]

/-- Each native odd grade has trivial intersection with the support centralizer. -/
theorem centralizer_mem_odd_fiveGrade_eq_zero (hF : ThreeSumStarFaithful B)
    {N X : B} (hN : N * N = 0) (hV : V N * V N = V N)
    (hC : X ∈ supportCentralizer N) (k : FiveGrade)
    (hk : k = .negOne ∨ k = .posOne) (hX : X ∈ fiveGradeRange (Sigma N) k) : X = 0 := by
  rcases hX with ⟨Y, rfl⟩
  have hT := sigma_tripotent hF hN hV
  have hfixed := (commute_support_iff_even_grades hF hN hV).mp
    (mem_supportCentralizer.mp hC)
  have hkill (i : FiveGrade) (hi : i ≠ k) :
      fiveGradeProjector (Sigma N) i (fiveGradeProjector (Sigma N) k Y) = 0 := by
    exact congrArg (fun f : Module.End ℝ B => f Y)
      (fiveGradeProjector_mul_eq_zero_of_ne hT hi)
  apply hfixed.symm.trans
  change fiveGradeProjector (Sigma N) .negTwo (fiveGradeProjector (Sigma N) k Y) +
    fiveGradeProjector (Sigma N) .zero (fiveGradeProjector (Sigma N) k Y) +
    fiveGradeProjector (Sigma N) .posTwo (fiveGradeProjector (Sigma N) k Y) = 0
  rcases hk with rfl | rfl <;>
    simp only [hkill .negTwo (by decide), hkill .zero (by decide),
      hkill .posTwo (by decide), zero_add]

/-- The binary generated subring contains no nonzero native grade `-1` or `1` element. -/
theorem generated_odd_fiveGrade_eq_zero (hF : ThreeSumStarFaithful B)
    {p A X : B} (hp : p * p = p) (hps : star p = p)
    (hV : V (conePlus p A) * V (conePlus p A) = V (conePlus p A))
    (hX : X ∈ Subring.closure ({p, conePlus p A, star (conePlus p A)} : Set B))
    (k : FiveGrade) (hk : k = .negOne ∨ k = .posOne)
    (hg : X ∈ fiveGradeRange (Sigma (conePlus p A)) k) : X = 0 :=
  centralizer_mem_odd_fiveGrade_eq_zero hF (conePlus_mul_conePlus hp A A) hV
    (generated_mem_supportCentralizer hp hps hX) k hk hg

end RealFiveGrades

end InfoGeometry.OperatorAlgebra.PeirceSpine.PeirceCentralizer
