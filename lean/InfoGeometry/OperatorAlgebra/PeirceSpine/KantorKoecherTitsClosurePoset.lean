import Mathlib.Algebra.Ring.Basic
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Algebra.Star.Basic

namespace OperatorAlgebra.PeirceSpine.KantorKoecherTitsClosurePoset

variable {B : Type*} [Ring B] [StarRing B]

attribute [local instance 100] LieRing.ofAssociativeRing

/-!
### 0. Universal Additive & Ring Helpers
-/

omit [StarRing B] in
private theorem add_add_add_comm' (a b c d : B) :
    (a + b) + (c + d) = (a + c) + (b + d) := by
  calc (a + b) + (c + d)
    _ = a + (b + (c + d)) := by rw [add_assoc a b (c + d)]
    _ = a + ((b + c) + d) := by rw [← add_assoc b c d]
    _ = a + ((c + b) + d) := by rw [add_comm b c]
    _ = a + (c + (b + d)) := by rw [add_assoc c b d]
    _ = (a + c) + (b + d) := by rw [← add_assoc a c (b + d)]

/-- Fourfold additive multiple `4x = (x + x) + (x + x)`. -/
def quad (x : B) : B := (x + x) + (x + x)

/-!
### 1. Core Operators & Anomaly-First Foundation (`KKT₁`)
-/

/-- Ring commutator `[X, Y] = X Y - Y X` (Lie bracket). -/
def comm (X Y : B) : B := X * Y - Y * X

omit [StarRing B] in
/-- The adjoint action of any element of an associative ring is a derivation
of the commutator bracket. -/
theorem comm_ad_derivation (S X Y : B) :
    comm S (comm X Y) = comm (comm S X) Y + comm X (comm S Y) := by
  simpa [comm, LieRing.of_associative_ring_bracket] using
    (LieRing.leibniz_lie S X Y)

omit [StarRing B] in
/-- Eigenvalues of the adjoint action add under the commutator bracket.
This is the reusable grading-closure law behind the concrete KKT sectors. -/
theorem comm_grade_addition (S X Y : B) (m n : ℤ)
    (hX : comm S X = m • X) (hY : comm S Y = n • Y) :
    comm S (comm X Y) = (m + n) • comm X Y := by
  rw [comm_ad_derivation, hX, hY]
  change ⁅m • X, Y⁆ + ⁅X, n • Y⁆ = (m + n) • ⁅X, Y⁆
  rw [zsmul_lie, lie_zsmul, ← add_zsmul]

/-- Ring anticommutator `{X, Y} = X Y + Y X` (Jordan product). -/
def anticomm (X Y : B) : B := X * Y + Y * X

/-- The Grade-3 Jordan Associator `JordanAssoc X Y Z = {{X, Y}, Z} - {X, {Y, Z}}`. -/
def JordanAssoc (X Y Z : B) : B :=
  anticomm (anticomm X Y) Z - anticomm X (anticomm Y Z)

/-- Foundational parity anomaly / KKT Cartan grading generator `Σ = [N_+, N_-]`. -/
def Sigma (N_plus : B) : B := comm N_plus (star N_plus)

/-- Downstream gapped support `Gap = Σ²`. -/
def Gap (N_plus : B) : B := Sigma N_plus * Sigma N_plus

/-- Positive chiral Peirce idempotent `P = N_+ N_-`. -/
def P (N_plus : B) : B := N_plus * star N_plus

/-- Negative chiral Peirce idempotent `Q = N_- N_+`. -/
def Q (N_plus : B) : B := star N_plus * N_plus

/-- Transverse / exterior idempotent `R = 1 - Gap`. -/
def R (N_plus : B) : B := 1 - Gap N_plus

/-- **Grade `+2` KKT Generator (`KKT₁`):**
    Generated by the Jordan associator `K_{+2}(X) := JordanAssoc(X, N_+, N_+)`. -/
def K_plus2 (N_plus X : B) : B := JordanAssoc X N_plus N_plus

/-- **Grade `-2` KKT Generator (`KKT₁`):**
    Generated by the dual Jordan associator `K_{-2}(X) := JordanAssoc(X, N_-, N_-)`. -/
def K_minus2 (N_plus X : B) : B := JordanAssoc X (star N_plus) (star N_plus)

theorem star_N_plus_sq (N_plus : B) (h_nil : N_plus * N_plus = 0) :
    star N_plus * star N_plus = 0 := by
  rw [← star_mul, h_nil, star_zero]

theorem star_N_plus_reg (N_plus : B) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    star N_plus * N_plus * star N_plus = star N_plus := by
  have h := congrArg star h_reg
  rw [star_mul, star_mul, star_star, ← mul_assoc] at h
  exact h

theorem Sigma_mul_N_plus (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * N_plus = N_plus := by
  dsimp [Sigma, comm]
  rw [sub_mul, h_reg, mul_assoc (star N_plus) N_plus N_plus, h_nil, mul_zero, sub_zero]

theorem N_plus_mul_Sigma (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    N_plus * Sigma N_plus = -N_plus := by
  dsimp [Sigma, comm]
  rw [mul_sub, ← mul_assoc N_plus N_plus (star N_plus), h_nil, zero_mul,
      ← mul_assoc N_plus (star N_plus) N_plus, h_reg, zero_sub]

theorem Sigma_mul_star_N_plus (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * star N_plus = -star N_plus := by
  dsimp [Sigma, comm]
  rw [sub_mul, mul_assoc N_plus (star N_plus) (star N_plus),
      star_N_plus_sq N_plus h_nil, mul_zero,
      star_N_plus_reg N_plus h_reg, zero_sub]

theorem star_N_plus_mul_Sigma (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    star N_plus * Sigma N_plus = star N_plus := by
  dsimp [Sigma, comm]
  rw [mul_sub, ← mul_assoc (star N_plus) N_plus (star N_plus),
      star_N_plus_reg N_plus h_reg,
      ← mul_assoc (star N_plus) (star N_plus) N_plus,
      star_N_plus_sq N_plus h_nil, zero_mul, sub_zero]

/-!
### 2. Quadratic Sandwich & Double-Commutator Form of `K_plus2` and `K_minus2` (`KKT₂`)
-/

omit [StarRing B] in
/-- **`KKT₂` Grade `+2` Jordan Associator Sandwich Identity:**
    For any `X ∈ B`, `K_{+2}(X) = JordanAssoc(X, N_+, N_+) = 2 N_+ X N_+`. -/
theorem K_plus2_eq_two_sandwich (N_plus X : B) (h_nil : N_plus * N_plus = 0) :
    K_plus2 N_plus X = N_plus * X * N_plus + N_plus * X * N_plus := by
  have h_right : anticomm X (anticomm N_plus N_plus) = 0 := by
    dsimp [anticomm]
    rw [h_nil, add_zero, mul_zero, zero_mul, add_zero]
  have h_left : anticomm (anticomm X N_plus) N_plus =
      N_plus * X * N_plus + N_plus * X * N_plus := by
    dsimp [anticomm]
    calc (X * N_plus + N_plus * X) * N_plus + N_plus * (X * N_plus + N_plus * X)
      _ = (X * N_plus * N_plus + N_plus * X * N_plus) +
          (N_plus * (X * N_plus) + N_plus * (N_plus * X)) := by
          rw [add_mul, mul_add]
      _ = (X * (N_plus * N_plus) + N_plus * X * N_plus) +
          (N_plus * X * N_plus + (N_plus * N_plus) * X) := by
          rw [mul_assoc X N_plus N_plus, ← mul_assoc N_plus X N_plus,
              ← mul_assoc N_plus N_plus X]
      _ = (0 + N_plus * X * N_plus) + (N_plus * X * N_plus + 0) := by
          rw [h_nil, mul_zero, zero_mul]
      _ = N_plus * X * N_plus + N_plus * X * N_plus := by
          rw [zero_add, add_zero]
  dsimp [K_plus2, JordanAssoc]
  rw [h_left, h_right, sub_zero]

/-- **`KKT₂` Grade `-2` Jordan Associator Sandwich Identity:**
    For any `X ∈ B`, `K_{-2}(X) = JordanAssoc(X, N_-, N_-) = 2 N_- X N_-`. -/
theorem K_minus2_eq_two_sandwich (N_plus X : B) (h_nil : N_plus * N_plus = 0) :
    K_minus2 N_plus X =
      star N_plus * X * star N_plus + star N_plus * X * star N_plus :=
  K_plus2_eq_two_sandwich (star N_plus) X (star_N_plus_sq N_plus h_nil)

omit [StarRing B] in
/-- **`KKT₂` Double-Commutator Realization of `K_plus2` (`K_{+2}(X) = [[N_+, X], N_+]`):** -/
theorem K_plus2_eq_comm_comm (N_plus X : B) (h_nil : N_plus * N_plus = 0) :
    K_plus2 N_plus X = comm (comm N_plus X) N_plus := by
  rw [K_plus2_eq_two_sandwich N_plus X h_nil]
  dsimp [comm]
  calc N_plus * X * N_plus + N_plus * X * N_plus
    _ = (N_plus * X * N_plus - 0) - (0 - N_plus * X * N_plus) := by
        rw [sub_zero, zero_sub, sub_eq_add_neg, neg_neg]
    _ = (N_plus * X * N_plus - X * (N_plus * N_plus)) -
        ((N_plus * N_plus) * X - N_plus * X * N_plus) := by
        rw [h_nil, mul_zero, zero_mul]
    _ = (N_plus * X * N_plus - X * N_plus * N_plus) -
        (N_plus * (N_plus * X) - N_plus * (X * N_plus)) := by
        rw [← mul_assoc X N_plus N_plus, mul_assoc N_plus N_plus X,
            mul_assoc N_plus X N_plus]
    _ = (N_plus * X - X * N_plus) * N_plus - N_plus * (N_plus * X - X * N_plus) := by
        rw [← sub_mul, ← mul_sub]

/-- **`KKT₂` Double-Commutator Realization of `K_minus2` (`K_{-2}(X) = [[N_-, X], N_-]`):** -/
theorem K_minus2_eq_comm_comm (N_plus X : B) (h_nil : N_plus * N_plus = 0) :
    K_minus2 N_plus X = comm (comm (star N_plus) X) (star N_plus) :=
  K_plus2_eq_comm_comm (star N_plus) X (star_N_plus_sq N_plus h_nil)

/-- **`KKT₂` Hermitian Star Duality (`star (K_{+2} X) = K_{-2} (star X)`):** -/
theorem star_K_plus2 (N_plus X : B) (h_nil : N_plus * N_plus = 0) :
    star (K_plus2 N_plus X) = K_minus2 N_plus (star X) := by
  rw [K_plus2_eq_two_sandwich N_plus X h_nil,
      K_minus2_eq_two_sandwich N_plus (star X) h_nil,
      star_add, star_mul, star_mul, ← mul_assoc]

/-- **`KKT₂` Seed Reconstruction (`K_{+2}(N_-) = 2 N_+` and `K_{-2}(N_+) = 2 N_-`):** -/
theorem K_plus2_seed (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    K_plus2 N_plus (star N_plus) = N_plus + N_plus := by
  rw [K_plus2_eq_two_sandwich N_plus (star N_plus) h_nil, h_reg]

theorem K_minus2_seed (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    K_minus2 N_plus N_plus = star N_plus + star N_plus := by
  rw [K_minus2_eq_two_sandwich N_plus N_plus h_nil, star_N_plus_reg N_plus h_reg]

/-!
### 3. Grade `+2` and Grade `-2` Eigenvalue Equations under `ad(Σ)` (`KKT₃–KKT₄`)
-/

theorem Sigma_mul_sandwich_plus (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * (N_plus * X * N_plus) = N_plus * X * N_plus := by
  calc Sigma N_plus * (N_plus * X * N_plus)
    _ = ((Sigma N_plus * N_plus) * X) * N_plus := by
        rw [← mul_assoc (Sigma N_plus) (N_plus * X) N_plus,
            ← mul_assoc (Sigma N_plus) N_plus X]
    _ = N_plus * X * N_plus := by rw [Sigma_mul_N_plus N_plus h_nil h_reg]

theorem sandwich_plus_mul_Sigma (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    (N_plus * X * N_plus) * Sigma N_plus = -(N_plus * X * N_plus) := by
  calc (N_plus * X * N_plus) * Sigma N_plus
    _ = (N_plus * X) * (N_plus * Sigma N_plus) := by rw [mul_assoc]
    _ = (N_plus * X) * (-N_plus) := by rw [N_plus_mul_Sigma N_plus h_nil h_reg]
    _ = -(N_plus * X * N_plus) := by rw [mul_neg]

theorem Sigma_mul_sandwich_minus (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * (star N_plus * X * star N_plus) =
      -(star N_plus * X * star N_plus) := by
  calc Sigma N_plus * (star N_plus * X * star N_plus)
    _ = ((Sigma N_plus * star N_plus) * X) * star N_plus := by
        rw [← mul_assoc (Sigma N_plus) (star N_plus * X) (star N_plus),
            ← mul_assoc (Sigma N_plus) (star N_plus) X]
    _ = ((-star N_plus) * X) * star N_plus := by
        rw [Sigma_mul_star_N_plus N_plus h_nil h_reg]
    _ = -(star N_plus * X * star N_plus) := by rw [neg_mul, neg_mul]

theorem sandwich_minus_mul_Sigma (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    (star N_plus * X * star N_plus) * Sigma N_plus =
      star N_plus * X * star N_plus := by
  calc (star N_plus * X * star N_plus) * Sigma N_plus
    _ = (star N_plus * X) * (star N_plus * Sigma N_plus) := by rw [mul_assoc]
    _ = star N_plus * X * star N_plus := by
        rw [star_N_plus_mul_Sigma N_plus h_nil h_reg]

theorem Sigma_mul_K_plus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * K_plus2 N_plus X = K_plus2 N_plus X := by
  rw [K_plus2_eq_two_sandwich N_plus X h_nil, mul_add,
      Sigma_mul_sandwich_plus N_plus X h_nil h_reg]

theorem K_plus2_mul_Sigma (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    K_plus2 N_plus X * Sigma N_plus = -K_plus2 N_plus X := by
  rw [K_plus2_eq_two_sandwich N_plus X h_nil, add_mul,
      sandwich_plus_mul_Sigma N_plus X h_nil h_reg, ← neg_add_rev]

theorem Sigma_mul_K_minus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * K_minus2 N_plus X = -K_minus2 N_plus X := by
  rw [K_minus2_eq_two_sandwich N_plus X h_nil, mul_add,
      Sigma_mul_sandwich_minus N_plus X h_nil h_reg, ← neg_add_rev]

theorem K_minus2_mul_Sigma (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    K_minus2 N_plus X * Sigma N_plus = K_minus2 N_plus X := by
  rw [K_minus2_eq_two_sandwich N_plus X h_nil, add_mul,
      sandwich_minus_mul_Sigma N_plus X h_nil h_reg]

/-- **`KKT₃` Grade `+2` Eigenvalue Theorem (`[Σ, K_{+2}(X)] = +2 K_{+2}(X)`):** -/
theorem comm_Sigma_K_plus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (K_plus2 N_plus X) =
      K_plus2 N_plus X + K_plus2 N_plus X := by
  dsimp [comm]
  rw [Sigma_mul_K_plus2 N_plus X h_nil h_reg,
      K_plus2_mul_Sigma N_plus X h_nil h_reg,
      sub_eq_add_neg, neg_neg]

/-- **`KKT₄` Grade `-2` Eigenvalue Theorem (`[Σ, K_{-2}(X)] = -2 K_{-2}(X)`):** -/
theorem comm_Sigma_K_minus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (K_minus2 N_plus X) =
      -(K_minus2 N_plus X + K_minus2 N_plus X) := by
  dsimp [comm]
  rw [Sigma_mul_K_minus2 N_plus X h_nil h_reg,
      K_minus2_mul_Sigma N_plus X h_nil h_reg,
      sub_eq_add_neg, ← neg_add_rev]

/-!
### 4. Lie Closure of the Grade `+2` and Grade `-2` KKT Sectors (`KKT₅–KKT₇`)
-/

omit [StarRing B] in
theorem sandwich_plus_mul_sandwich_plus (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) :
    (N_plus * X * N_plus) * (N_plus * Y * N_plus) = 0 := by
  calc (N_plus * X * N_plus) * (N_plus * Y * N_plus)
    _ = (N_plus * X) * (N_plus * (N_plus * Y * N_plus)) := by
        rw [mul_assoc (N_plus * X) N_plus (N_plus * Y * N_plus)]
    _ = (N_plus * X) * (((N_plus * N_plus) * Y) * N_plus) := by
        rw [← mul_assoc N_plus (N_plus * Y) N_plus,
            ← mul_assoc N_plus N_plus Y]
    _ = (N_plus * X) * ((0 * Y) * N_plus) := by rw [h_nil]
    _ = 0 := by rw [zero_mul, zero_mul, mul_zero]

theorem sandwich_minus_mul_sandwich_minus (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) :
    (star N_plus * X * star N_plus) * (star N_plus * Y * star N_plus) = 0 :=
  sandwich_plus_mul_sandwich_plus (star N_plus) X Y (star_N_plus_sq N_plus h_nil)

omit [StarRing B] in
/-- **`KKT₅` Grade `+2` Associative & Lie Abelian Closure (`[K_{+2}(X), K_{+2}(Y)] = 0`):**
    Grades higher than `+2` vanish identically. -/
theorem K_plus2_mul_K_plus2 (N_plus X Y : B) (h_nil : N_plus * N_plus = 0) :
    K_plus2 N_plus X * K_plus2 N_plus Y = 0 := by
  rw [K_plus2_eq_two_sandwich N_plus X h_nil,
      K_plus2_eq_two_sandwich N_plus Y h_nil,
      mul_add, add_mul,
      sandwich_plus_mul_sandwich_plus N_plus X Y h_nil,
      add_zero, add_zero]

omit [StarRing B] in
theorem comm_K_plus2_K_plus2 (N_plus X Y : B) (h_nil : N_plus * N_plus = 0) :
    comm (K_plus2 N_plus X) (K_plus2 N_plus Y) = 0 := by
  dsimp [comm]
  rw [K_plus2_mul_K_plus2 N_plus X Y h_nil,
      K_plus2_mul_K_plus2 N_plus Y X h_nil, sub_self]

/-- **`KKT₅` Grade `-2` Associative & Lie Abelian Closure (`[K_{-2}(X), K_{-2}(Y)] = 0`):**
    Grades lower than `-2` vanish identically. -/
theorem K_minus2_mul_K_minus2 (N_plus X Y : B) (h_nil : N_plus * N_plus = 0) :
    K_minus2 N_plus X * K_minus2 N_plus Y = 0 := by
  rw [K_minus2_eq_two_sandwich N_plus X h_nil,
      K_minus2_eq_two_sandwich N_plus Y h_nil,
      mul_add, add_mul,
      sandwich_minus_mul_sandwich_minus N_plus X Y h_nil,
      add_zero, add_zero]

theorem comm_K_minus2_K_minus2 (N_plus X Y : B) (h_nil : N_plus * N_plus = 0) :
    comm (K_minus2 N_plus X) (K_minus2 N_plus Y) = 0 := by
  dsimp [comm]
  rw [K_minus2_mul_K_minus2 N_plus X Y h_nil,
      K_minus2_mul_K_minus2 N_plus Y X h_nil, sub_self]

/-- **`KKT₆` Opposite Extremal Bracket Closes into Grade `0` (`[Σ, [K_{+2}(X), K_{-2}(Y)]] = 0`):**
    For arbitrary `X, Y ∈ B`, the Lie bracket of a Grade `+2` generator and a Grade `-2`
    generator commutes with the grading operator `Σ` (has Grade `+2 - 2 = 0`). -/
theorem comm_Sigma_bracket_plus2_minus2 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (comm (K_plus2 N_plus X) (K_minus2 N_plus Y)) = 0 := by
  have h1 : Sigma N_plus * (K_plus2 N_plus X * K_minus2 N_plus Y) =
            (K_plus2 N_plus X * K_minus2 N_plus Y) * Sigma N_plus := by
    rw [← mul_assoc (Sigma N_plus), Sigma_mul_K_plus2 N_plus X h_nil h_reg,
        mul_assoc (K_plus2 N_plus X), K_minus2_mul_Sigma N_plus Y h_nil h_reg]
  have h2 : Sigma N_plus * (K_minus2 N_plus Y * K_plus2 N_plus X) =
            (K_minus2 N_plus Y * K_plus2 N_plus X) * Sigma N_plus := by
    rw [← mul_assoc (Sigma N_plus), Sigma_mul_K_minus2 N_plus Y h_nil h_reg,
        neg_mul,
        mul_assoc (K_minus2 N_plus Y), K_plus2_mul_Sigma N_plus X h_nil h_reg,
        mul_neg]
  dsimp [comm]
  rw [mul_sub, sub_mul, h1, h2, sub_self]

/-- **`KKT₇` Seed Extremal Commutator (`[K_{+2}(N_-), K_{-2}(N_+)] = 4 Σ`):**
    The Lie bracket of the Grade `+2` seed `K_{+2}(N_-)` and Grade `-2` seed `K_{-2}(N_+)`
    regenerates four times the Grade `0` Cartan anomaly `Σ`. -/
theorem comm_K_plus2_seed_K_minus2_seed (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (K_plus2 N_plus (star N_plus)) (K_minus2 N_plus N_plus) =
      quad (Sigma N_plus) := by
  rw [K_plus2_seed N_plus h_nil h_reg, K_minus2_seed N_plus h_nil h_reg]
  dsimp [comm, Sigma, quad]
  calc (N_plus + N_plus) * (star N_plus + star N_plus) -
       (star N_plus + star N_plus) * (N_plus + N_plus)
    _ = ((N_plus * star N_plus + N_plus * star N_plus) +
         (N_plus * star N_plus + N_plus * star N_plus)) -
        ((star N_plus * N_plus + star N_plus * N_plus) +
         (star N_plus * N_plus + star N_plus * N_plus)) := by
        rw [mul_add, add_mul, mul_add, add_mul]
    _ = ((N_plus * star N_plus - star N_plus * N_plus) +
         (N_plus * star N_plus - star N_plus * N_plus)) +
        ((N_plus * star N_plus - star N_plus * N_plus) +
         (N_plus * star N_plus - star N_plus * N_plus)) := by
        have h_sub : ∀ a b : B, ((a + a) + (a + a)) - ((b + b) + (b + b)) =
                     ((a - b) + (a - b)) + ((a - b) + (a - b)) := by
          intro a b
          rw [sub_eq_add_neg ((a + a) + (a + a)),
              neg_add_rev, neg_add_rev,
              add_add_add_comm' (a + a) (a + a) (-b + -b) (-b + -b),
              add_add_add_comm' a a (-b) (-b),
              ← sub_eq_add_neg a b]
        exact h_sub (N_plus * star N_plus) (star N_plus * N_plus)

/-!
### 5. Complete 5-Graded Peirce–KKT Tower (`G_{-2}, G_{-1}, G_0, G_{+1}, G_{+2}`) (`KKT₈–KKT₁₀`)
-/

/-- Grade `+2` Peirce subspace `G_{+2}(X) = P X Q`. -/
def G_plus2 (N_plus X : B) : B := P N_plus * X * Q N_plus

/-- Grade `-2` Peirce subspace `G_{-2}(X) = Q X P`. -/
def G_minus2 (N_plus X : B) : B := Q N_plus * X * P N_plus

/-- Left Grade `+1` Peirce subspace `G_{+1}^L(X) = P X R`. -/
def G_plus1_L (N_plus X : B) : B := P N_plus * X * R N_plus

/-- Right Grade `+1` Peirce subspace `G_{+1}^R(X) = R X Q`. -/
def G_plus1_R (N_plus X : B) : B := R N_plus * X * Q N_plus

/-- Left Grade `-1` Peirce subspace `G_{-1}^L(X) = R X P`. -/
def G_minus1_L (N_plus X : B) : B := R N_plus * X * P N_plus

/-- Right Grade `-1` Peirce subspace `G_{-1}^R(X) = Q X R`. -/
def G_minus1_R (N_plus X : B) : B := Q N_plus * X * R N_plus

/-- Von Neumann regularity makes the positive nilpotent a left identity for
its positive Peirce support. -/
theorem P_mul_N_plus (N_plus : B)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    P N_plus * N_plus = N_plus := h_reg

/-- Von Neumann regularity makes the negative Peirce support a right identity
for the positive nilpotent. -/
theorem N_plus_mul_Q (N_plus : B)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    N_plus * Q N_plus = N_plus := by
  dsimp [Q]
  rw [← mul_assoc, h_reg]

/-- The Jordan `+2` sandwich is supported in the Peirce corner `P B Q`.
This is a containment statement; the sandwich need not equal an arbitrary
element of that corner. -/
theorem K_plus2_in_G_plus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    G_plus2 N_plus (K_plus2 N_plus X) = K_plus2 N_plus X := by
  have h_left : P N_plus * (N_plus * X * N_plus) = N_plus * X * N_plus := by
    have hPN : P N_plus * N_plus = N_plus := by
      dsimp [P]
      exact h_reg
    calc P N_plus * (N_plus * X * N_plus)
        = P N_plus * (N_plus * (X * N_plus)) := by rw [mul_assoc N_plus X N_plus]
      _ = (P N_plus * N_plus) * (X * N_plus) := by rw [← mul_assoc]
      _ = N_plus * (X * N_plus) := by rw [hPN]
      _ = N_plus * X * N_plus := by rw [← mul_assoc N_plus X N_plus]
  have h_right : (N_plus * X * N_plus) * Q N_plus = N_plus * X * N_plus := by
    have hNQ := N_plus_mul_Q N_plus h_reg
    calc (N_plus * X * N_plus) * Q N_plus
        = (N_plus * X) * (N_plus * Q N_plus) := by rw [mul_assoc]
      _ = (N_plus * X) * N_plus := by rw [hNQ]
  change P N_plus * K_plus2 N_plus X * Q N_plus = K_plus2 N_plus X
  rw [K_plus2_eq_two_sandwich N_plus X h_nil, mul_add, add_mul]
  simp only [h_left, h_right]

/-- The adjoint Jordan `-2` sandwich is supported in the Peirce corner
`Q B P`. -/
theorem K_minus2_in_G_minus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    G_minus2 N_plus (K_minus2 N_plus X) = K_minus2 N_plus X := by
  have h_left : Q N_plus * (star N_plus * X * star N_plus) =
      star N_plus * X * star N_plus := by
    calc Q N_plus * (star N_plus * X * star N_plus)
        = Q N_plus * (star N_plus * (X * star N_plus)) := by rw [mul_assoc]
      _ = (Q N_plus * star N_plus) * (X * star N_plus) := by rw [← mul_assoc]
      _ = star N_plus * (X * star N_plus) := by
        dsimp [Q]
        rw [star_N_plus_reg N_plus h_reg]
      _ = star N_plus * X * star N_plus := by rw [← mul_assoc]
  have h_right : (star N_plus * X * star N_plus) * P N_plus =
      star N_plus * X * star N_plus := by
    have hsNP : star N_plus * P N_plus = star N_plus := by
      dsimp [P]
      rw [← mul_assoc, star_N_plus_reg N_plus h_reg]
    calc (star N_plus * X * star N_plus) * P N_plus
        = (star N_plus * X) * (star N_plus * P N_plus) := by rw [mul_assoc]
      _ = (star N_plus * X) * star N_plus := by rw [hsNP]
  change Q N_plus * K_minus2 N_plus X * P N_plus = K_minus2 N_plus X
  rw [K_minus2_eq_two_sandwich N_plus X h_nil, mul_add, add_mul]
  simp only [h_left, h_right]

theorem Sigma_mul_P (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * P N_plus = P N_plus := by
  dsimp [P]
  rw [← mul_assoc, Sigma_mul_N_plus N_plus h_nil h_reg]

theorem P_mul_Sigma (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    P N_plus * Sigma N_plus = P N_plus := by
  dsimp [P]
  rw [mul_assoc, star_N_plus_mul_Sigma N_plus h_nil h_reg]

theorem Sigma_mul_Q (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * Q N_plus = -Q N_plus := by
  dsimp [Q]
  rw [← mul_assoc, Sigma_mul_star_N_plus N_plus h_nil h_reg, neg_mul]

theorem Q_mul_Sigma (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Q N_plus * Sigma N_plus = -Q N_plus := by
  dsimp [Q]
  rw [mul_assoc, N_plus_mul_Sigma N_plus h_nil h_reg, mul_neg]

/-- The `P B Q` Peirce corner has adjoint grade `+2`. -/
theorem comm_Sigma_G_plus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_plus2 N_plus X) =
      G_plus2 N_plus X + G_plus2 N_plus X := by
  have h_left : Sigma N_plus * (P N_plus * X * Q N_plus) =
      P N_plus * X * Q N_plus := by
    calc Sigma N_plus * (P N_plus * X * Q N_plus)
        = Sigma N_plus * (P N_plus * (X * Q N_plus)) := by
          rw [mul_assoc (P N_plus) X (Q N_plus)]
      _ = (Sigma N_plus * P N_plus) * (X * Q N_plus) := by rw [← mul_assoc]
      _ = P N_plus * (X * Q N_plus) := by rw [Sigma_mul_P N_plus h_nil h_reg]
      _ = P N_plus * X * Q N_plus := by rw [← mul_assoc]
  have h_right : (P N_plus * X * Q N_plus) * Sigma N_plus =
      -(P N_plus * X * Q N_plus) := by
    calc (P N_plus * X * Q N_plus) * Sigma N_plus
        = (P N_plus * X) * (Q N_plus * Sigma N_plus) := by rw [mul_assoc]
      _ = (P N_plus * X) * (-Q N_plus) := by rw [Q_mul_Sigma N_plus h_nil h_reg]
      _ = -(P N_plus * X * Q N_plus) := by rw [mul_neg]
  dsimp [comm, G_plus2]
  rw [h_left, h_right, sub_eq_add_neg, neg_neg]

/-- The `Q B P` Peirce corner has adjoint grade `-2`. -/
theorem comm_Sigma_G_minus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_minus2 N_plus X) =
      -(G_minus2 N_plus X + G_minus2 N_plus X) := by
  have h_left : Sigma N_plus * (Q N_plus * X * P N_plus) =
      -(Q N_plus * X * P N_plus) := by
    calc Sigma N_plus * (Q N_plus * X * P N_plus)
        = Sigma N_plus * (Q N_plus * (X * P N_plus)) := by
          rw [mul_assoc (Q N_plus) X (P N_plus)]
      _ = (Sigma N_plus * Q N_plus) * (X * P N_plus) := by rw [← mul_assoc]
      _ = (-Q N_plus) * (X * P N_plus) := by rw [Sigma_mul_Q N_plus h_nil h_reg]
      _ = -(Q N_plus * (X * P N_plus)) := by rw [neg_mul]
      _ = -(Q N_plus * X * P N_plus) := by
        congr 1
        rw [← mul_assoc]
  have h_right : (Q N_plus * X * P N_plus) * Sigma N_plus =
      Q N_plus * X * P N_plus := by
    calc (Q N_plus * X * P N_plus) * Sigma N_plus
        = (Q N_plus * X) * (P N_plus * Sigma N_plus) := by rw [mul_assoc]
      _ = (Q N_plus * X) * P N_plus := by rw [P_mul_Sigma N_plus h_nil h_reg]
  dsimp [comm, G_minus2]
  rw [h_left, h_right, sub_eq_add_neg, ← neg_add]

theorem Q_mul_P (N_plus : B) (h_nil : N_plus * N_plus = 0) :
    Q N_plus * P N_plus = 0 := by
  dsimp [P, Q]
  calc (star N_plus * N_plus) * (N_plus * star N_plus)
    _ = star N_plus * ((N_plus * N_plus) * star N_plus) := by
        rw [mul_assoc (star N_plus) N_plus (N_plus * star N_plus),
            ← mul_assoc N_plus N_plus (star N_plus)]
    _ = 0 := by rw [h_nil, zero_mul, mul_zero]

theorem P_mul_Q (N_plus : B) (h_nil : N_plus * N_plus = 0) :
    P N_plus * Q N_plus = 0 := by
  dsimp [P, Q]
  calc (N_plus * star N_plus) * (star N_plus * N_plus)
    _ = N_plus * ((star N_plus * star N_plus) * N_plus) := by
        rw [mul_assoc N_plus (star N_plus) (star N_plus * N_plus),
            ← mul_assoc (star N_plus) (star N_plus) N_plus]
    _ = 0 := by rw [star_N_plus_sq N_plus h_nil, zero_mul, mul_zero]

theorem P_idem (N_plus : B) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    P N_plus * P N_plus = P N_plus := by
  dsimp [P]
  rw [← mul_assoc (N_plus * star N_plus) N_plus (star N_plus), h_reg]

theorem Q_idem (N_plus : B) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Q N_plus * Q N_plus = Q N_plus := by
  dsimp [Q]
  rw [← mul_assoc (star N_plus * N_plus) (star N_plus) N_plus,
      star_N_plus_reg N_plus h_reg]

theorem Sigma_sq_eq_P_add_Q (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * Sigma N_plus = P N_plus + Q N_plus := by
  have hS : Sigma N_plus = P N_plus - Q N_plus := rfl
  rw [hS, mul_sub, sub_mul, sub_mul]
  rw [P_idem N_plus h_reg, Q_mul_P N_plus h_nil,
      P_mul_Q N_plus h_nil, Q_idem N_plus h_reg]
  simp [sub_eq_add_neg]

theorem Sigma_mul_Gap (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * Gap N_plus = Sigma N_plus := by
  rw [show Gap N_plus = P N_plus + Q N_plus by
    dsimp [Gap]; exact Sigma_sq_eq_P_add_Q N_plus h_nil h_reg]
  have hS : Sigma N_plus = P N_plus - Q N_plus := rfl
  rw [hS, mul_add, sub_mul, sub_mul]
  rw [P_idem N_plus h_reg, Q_mul_P N_plus h_nil,
      P_mul_Q N_plus h_nil, Q_idem N_plus h_reg]
  simp [sub_eq_add_neg]

theorem Gap_mul_Sigma (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Gap N_plus * Sigma N_plus = Sigma N_plus := by
  rw [show Gap N_plus = P N_plus + Q N_plus by
    dsimp [Gap]; exact Sigma_sq_eq_P_add_Q N_plus h_nil h_reg]
  have hS : Sigma N_plus = P N_plus - Q N_plus := rfl
  rw [hS, add_mul, mul_sub, mul_sub]
  rw [P_idem N_plus h_reg, Q_mul_P N_plus h_nil,
      P_mul_Q N_plus h_nil, Q_idem N_plus h_reg]
  simp [sub_eq_add_neg]

theorem Sigma_mul_R (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * R N_plus = 0 := by
  dsimp [R]
  rw [mul_sub, mul_one, Sigma_mul_Gap N_plus h_nil h_reg, sub_self]

theorem R_mul_Sigma (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    R N_plus * Sigma N_plus = 0 := by
  dsimp [R]
  rw [sub_mul, one_mul, Gap_mul_Sigma N_plus h_nil h_reg, sub_self]

/-- **`KKT₈` Grade `+1` Eigenvalue Equations (`[Σ, G_{+1}^{L,R}(X)] = +G_{+1}^{L,R}(X)`):** -/
theorem comm_Sigma_G_plus1_L (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_plus1_L N_plus X) = G_plus1_L N_plus X := by
  dsimp [comm, G_plus1_L]
  rw [← mul_assoc (Sigma N_plus) (P N_plus * X) (R N_plus),
      ← mul_assoc (Sigma N_plus) (P N_plus) X,
      Sigma_mul_P N_plus h_nil h_reg,
      mul_assoc (P N_plus * X) (R N_plus) (Sigma N_plus),
      R_mul_Sigma N_plus h_nil h_reg,
      mul_zero, sub_zero]

theorem comm_Sigma_G_plus1_R (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_plus1_R N_plus X) = G_plus1_R N_plus X := by
  dsimp [comm, G_plus1_R]
  rw [← mul_assoc (Sigma N_plus) (R N_plus * X) (Q N_plus),
      ← mul_assoc (Sigma N_plus) (R N_plus) X,
      Sigma_mul_R N_plus h_nil h_reg, zero_mul, zero_mul,
      mul_assoc (R N_plus * X) (Q N_plus) (Sigma N_plus),
      Q_mul_Sigma N_plus h_nil h_reg,
      mul_neg, zero_sub, neg_neg]

/-- **`KKT₈` Grade `-1` Eigenvalue Equations (`[Σ, G_{-1}^{L,R}(X)] = -G_{-1}^{L,R}(X)`):** -/
theorem comm_Sigma_G_minus1_L (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_minus1_L N_plus X) = -G_minus1_L N_plus X := by
  dsimp [comm, G_minus1_L]
  rw [← mul_assoc (Sigma N_plus) (R N_plus * X) (P N_plus),
      ← mul_assoc (Sigma N_plus) (R N_plus) X,
      Sigma_mul_R N_plus h_nil h_reg, zero_mul, zero_mul,
      mul_assoc (R N_plus * X) (P N_plus) (Sigma N_plus),
      P_mul_Sigma N_plus h_nil h_reg, zero_sub]

theorem comm_Sigma_G_minus1_R (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_minus1_R N_plus X) = -G_minus1_R N_plus X := by
  dsimp [comm, G_minus1_R]
  rw [← mul_assoc (Sigma N_plus) (Q N_plus * X) (R N_plus),
      ← mul_assoc (Sigma N_plus) (Q N_plus) X,
      Sigma_mul_Q N_plus h_nil h_reg, neg_mul, neg_mul,
      mul_assoc (Q N_plus * X) (R N_plus) (Sigma N_plus),
      R_mul_Sigma N_plus h_nil h_reg, mul_zero, sub_zero]

theorem R_idem (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    R N_plus * R N_plus = R N_plus := by
  have hG_idem : Gap N_plus * Gap N_plus = Gap N_plus := by
    calc Gap N_plus * Gap N_plus
        = (Gap N_plus * Sigma N_plus) * Sigma N_plus := by
          dsimp [Gap]; rw [← mul_assoc]
      _ = Sigma N_plus * Sigma N_plus := by
          rw [Gap_mul_Sigma N_plus h_nil h_reg]
      _ = Gap N_plus := rfl
  dsimp [R]
  calc (1 - Gap N_plus) * (1 - Gap N_plus)
      = (1 - Gap N_plus) - (1 - Gap N_plus) * Gap N_plus := by
        rw [mul_sub, mul_one]
    _ = (1 - Gap N_plus) - (Gap N_plus - Gap N_plus * Gap N_plus) := by
        rw [sub_mul, one_mul]
    _ = 1 - Gap N_plus := by rw [hG_idem, sub_self, sub_zero]

/-- **`KKT₉` Grade `+1` Bracket Closes into Grade `+2` (`[G_{+1}^L(X), G_{+1}^R(Y)] = G_{+2}(X R Y)`):** -/
theorem comm_G_plus1_into_G_plus2 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_plus1_L N_plus X) (G_plus1_R N_plus Y) =
      G_plus2 N_plus (X * R N_plus * Y) := by
  dsimp [comm, G_plus1_L, G_plus1_R, G_plus2]
  have h1 : (P N_plus * X * R N_plus) * (R N_plus * Y * Q N_plus) =
            P N_plus * (X * R N_plus * Y) * Q N_plus := by
    calc (P N_plus * X * R N_plus) * (R N_plus * Y * Q N_plus)
      _ = ((P N_plus * X) * (R N_plus * (R N_plus * Y))) * Q N_plus := by
          rw [← mul_assoc (P N_plus * X * R N_plus) (R N_plus * Y) (Q N_plus),
              mul_assoc (P N_plus * X) (R N_plus) (R N_plus * Y)]
      _ = ((P N_plus * X) * ((R N_plus * R N_plus) * Y)) * Q N_plus := by
          rw [← mul_assoc (R N_plus) (R N_plus) Y]
      _ = ((P N_plus * X) * (R N_plus * Y)) * Q N_plus := by
          rw [R_idem N_plus h_nil h_reg]
      _ = (P N_plus * (X * R N_plus * Y)) * Q N_plus := by
          rw [mul_assoc (P N_plus) X (R N_plus * Y),
              ← mul_assoc X (R N_plus) Y]
  have h2 : (R N_plus * Y * Q N_plus) * (P N_plus * X * R N_plus) = 0 := by
    calc (R N_plus * Y * Q N_plus) * (P N_plus * X * R N_plus)
      _ = ((R N_plus * Y) * ((Q N_plus * P N_plus) * X)) * R N_plus := by
          rw [← mul_assoc (R N_plus * Y * Q N_plus) (P N_plus * X) (R N_plus),
              mul_assoc (R N_plus * Y) (Q N_plus) (P N_plus * X),
              ← mul_assoc (Q N_plus) (P N_plus) X]
      _ = 0 := by rw [Q_mul_P N_plus h_nil, zero_mul, mul_zero, zero_mul]
  rw [h1, h2, sub_zero]

/-- **`KKT₁₀` Grade `-1` Bracket Closes into Grade `-2` (`[G_{-1}^R(X), G_{-1}^L(Y)] = G_{-2}(X R Y)`):** -/
theorem comm_G_minus1_into_G_minus2 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_minus1_R N_plus X) (G_minus1_L N_plus Y) =
      G_minus2 N_plus (X * R N_plus * Y) := by
  dsimp [comm, G_minus1_R, G_minus1_L, G_minus2]
  have h1 : (Q N_plus * X * R N_plus) * (R N_plus * Y * P N_plus) =
            Q N_plus * (X * R N_plus * Y) * P N_plus := by
    calc (Q N_plus * X * R N_plus) * (R N_plus * Y * P N_plus)
      _ = ((Q N_plus * X) * (R N_plus * (R N_plus * Y))) * P N_plus := by
          rw [← mul_assoc (Q N_plus * X * R N_plus) (R N_plus * Y) (P N_plus),
              mul_assoc (Q N_plus * X) (R N_plus) (R N_plus * Y)]
      _ = ((Q N_plus * X) * ((R N_plus * R N_plus) * Y)) * P N_plus := by
          rw [← mul_assoc (R N_plus) (R N_plus) Y]
      _ = ((Q N_plus * X) * (R N_plus * Y)) * P N_plus := by
          rw [R_idem N_plus h_nil h_reg]
      _ = (Q N_plus * (X * R N_plus * Y)) * P N_plus := by
          rw [mul_assoc (Q N_plus) X (R N_plus * Y),
              ← mul_assoc X (R N_plus) Y]
  have h2 : (R N_plus * Y * P N_plus) * (Q N_plus * X * R N_plus) = 0 := by
    calc (R N_plus * Y * P N_plus) * (Q N_plus * X * R N_plus)
      _ = ((R N_plus * Y) * ((P N_plus * Q N_plus) * X)) * R N_plus := by
          rw [← mul_assoc (R N_plus * Y * P N_plus) (Q N_plus * X) (R N_plus),
              mul_assoc (R N_plus * Y) (P N_plus) (Q N_plus * X),
              ← mul_assoc (P N_plus) (Q N_plus) X]
      _ = 0 := by rw [P_mul_Q N_plus h_nil, zero_mul, mul_zero, zero_mul]
  rw [h1, h2, sub_zero]

end OperatorAlgebra.PeirceSpine.KantorKoecherTitsClosurePoset
