/-- Abstract divergence interface used by Bregman-triality attention bridges. -/
class BregmanDivergence (Q K : Type*) where
  D : Q → K → ℝ

/--
Construct a triadic core whose interaction score is `-D`.
This encodes the usual "larger similarity <-> smaller divergence" convention.
-/
def bregmanTriadicCore {Q K V : Type*} [BregmanDivergence Q K]
    (route : Q → K → V) : TriadicCore Q K V where
  interact := fun q k => - BregmanDivergence.D q k
  route := route

/-- Minimal 1D Hessian geometry package. -/
structure HessianGeometry1D where
  potential : ℝ → ℝ

namespace HessianGeometry1D

/-- Hessian metric in 1D (totalized second derivative). -/
noncomputable def metric (H : HessianGeometry1D) (x : ℝ) : ℝ :=
  deriv (deriv H.potential) x

@[simp] theorem metric_def (H : HessianGeometry1D) (x : ℝ) :
    H.metric x = deriv (deriv H.potential) x := rfl

/-- Dual coordinate map in 1D. -/
noncomputable def dualMap (H : HessianGeometry1D) (x : ℝ) : ℝ :=
  deriv H.potential x

@[simp] theorem dualMap_def (H : HessianGeometry1D) (x : ℝ) :
    H.dualMap x = deriv H.potential x := rfl

/-- Legendre dual potential (as supremum). -/
noncomputable def dualPotential (H : HessianGeometry1D) (θ : ℝ) : ℝ :=
  sSup { r : ℝ | ∃ x : ℝ, r = x * θ - H.potential x }

/-- Bregman divergence generated by the 1D potential. -/
noncomputable def divergence (H : HessianGeometry1D) (x y : ℝ) : ℝ :=
  H.potential x - H.potential y - (H.dualMap y) * (x - y)

@[simp] theorem divergence_def (H : HessianGeometry1D) (x y : ℝ) :
    H.divergence x y = H.potential x - H.potential y - (H.dualMap y) * (x - y) := rfl

/-- Any 1D `LogPotential` induces a 1D Hessian geometry. -/
noncomputable def ofLogPotential (L : InfoGeometry.LogPotential ℝ) : HessianGeometry1D where
  potential := L.ψ

/-- A named Bregman divergence instance attached to `H`. -/
noncomputable def bregmanDiv (H : HessianGeometry1D) : BregmanDivergence ℝ ℝ where
  D := fun x y => H.divergence x y

@[simp] theorem bregmanDiv_D (H : HessianGeometry1D) (x y : ℝ) :
    (bregmanDiv H).D x y = H.divergence x y := rfl

/--
Bregman-softmax attention over 1D Hessian systems.
The interaction score is definitionally `-H.divergence`.
-/
noncomputable def softmaxBregmanAttention
    {ι : Type _} [DecidableEq ι]
    (H : HessianGeometry1D) (I : Finset ι) (hI : I.Nonempty) (keys : ι → ℝ)
    (route : ℝ → ℝ → ℝ) :
    (letI : BregmanDivergence ℝ ℝ := bregmanDiv H
     GeometricAttentionMap (bregmanTriadicCore (Q := ℝ) (K := ℝ) (V := ℝ) route) ι) := by
  classical
  letI : BregmanDivergence ℝ ℝ := bregmanDiv H
  exact softmaxAttention (core := bregmanTriadicCore route) (I := I) (hI := hI) (keys := keys)

end HessianGeometry1D

/-- Multivariate Hessian geometry package on an inner product space `E`.
`grad` is the primal gradient and `metricOp` is recovered as `fderiv grad`.
The non-negativity witness for the induced Bregman divergence is carried
constructively as part of the datum.
-/
structure HessianGeometry (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] where
  potential : E → ℝ
  grad : E → E
  has_gradient : ∀ x, HasFDerivAt potential (InnerProductSpace.toDual ℝ E (grad x)) x
  divergence_form_nonneg :
    ∀ x y, 0 ≤ potential x - potential y - inner ℝ (grad y) (x - y)

namespace HessianGeometry

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable (H : HessianGeometry E)

/-- Dual coordinate map. -/
noncomputable def dualMap (x : E) : E := H.grad x

@[simp] theorem dualMap_def (x : E) : H.dualMap x = H.grad x := rfl

/-- Hessian metric operator, as totalized Fréchet derivative of `grad`. -/
noncomputable def metricOp (x : E) : E →L[ℝ] E :=
  fderiv ℝ H.grad x

/-- Bilinear metric induced by `metricOp`. -/
noncomputable def metric (x : E) (u v : E) : ℝ :=
  inner ℝ u (H.metricOp x v)

@[simp] theorem metric_def (x : E) (u v : E) :
    H.metric x u v = inner ℝ u (H.metricOp x v) := rfl

/-- Bregman divergence generated by the potential. -/
noncomputable def divergence (x y : E) : ℝ :=
  H.potential x - H.potential y - inner ℝ (H.dualMap y) (x - y)

/--
Non-negativity of the Bregman divergence.

This is not inferred from differentiability alone.  It is derived from the
convexity/first-order lower-bound witness carried by each concrete
`HessianGeometry` constructor.
-/
theorem divergence_nonneg (x y : E) :
    0 ≤ H.divergence x y := by
  simpa [HessianGeometry.divergence, HessianGeometry.dualMap] using
    H.divergence_form_nonneg x y

/-- Gradient pairing induced by the Hessian dual coordinate. -/
noncomputable def gradientPairing (x : E) : E →ₗ[ℝ] ℝ :=
  InnerProductSpace.toDual ℝ E (H.grad x)

@[simp] theorem gradientPairing_apply (x v : E) :
    H.gradientPairing x v = inner ℝ (H.grad x) v := rfl

/--
The Hessian divergence is exactly the Bregman divergence generated by the
potential and the gradient pairing.
-/
theorem divergence_eq_bregmanDivergence (x y : E) :
    H.divergence x y =
      _root_.InfoGeometry.bregmanDivergence
        H.potential H.gradientPairing x y := by
  simp [_root_.InfoGeometry.bregmanDivergence, _root_.InfoGeometry.pairing,
    HessianGeometry.divergence, HessianGeometry.dualMap,
    HessianGeometry.gradientPairing]

/--
Fenchel-Young gap at the Hessian dual coordinate equals the Hessian/Bregman
divergence, provided the proposed dual potential is attained at that
coordinate.
-/
theorem fenchel_gap_eq_divergence_at_dualMap
    (potentialStar : E → ℝ)
    (x y : E)
    (hstar :
      potentialStar (H.dualMap y) =
        inner ℝ y (H.dualMap y) - H.potential y) :
    H.potential x + potentialStar (H.dualMap y) -
        inner ℝ x (H.dualMap y) =
      H.divergence x y := by
  rw [hstar]
  simp [HessianGeometry.divergence, HessianGeometry.dualMap,
    sub_eq_add_neg, inner_add_left, inner_neg_left, real_inner_comm]
  ring_nf

/--
Consequently, an attained Fenchel-Young gap at a Hessian dual coordinate is
nonnegative.
-/
theorem fenchel_gap_nonneg_at_dualMap
    (potentialStar : E → ℝ)
    (x y : E)
    (hstar :
      potentialStar (H.dualMap y) =
        inner ℝ y (H.dualMap y) - H.potential y) :
    0 ≤
      H.potential x + potentialStar (H.dualMap y) -
        inner ℝ x (H.dualMap y) := by
  rw [H.fenchel_gap_eq_divergence_at_dualMap potentialStar x y hstar]
  exact H.divergence_nonneg x y

/--
Linear symmetries preserving the potential and gradient pairing preserve the
Hessian/Bregman divergence.
-/
theorem divergence_invariant_of_linear_symmetry
    (T : E →ₗ[ℝ] E)
    (hPotential : ∀ x : E, H.potential (T x) = H.potential x)
    (hGradientPairing :
      ∀ x v : E, inner ℝ (H.grad (T x)) (T v) = inner ℝ (H.grad x) v)
    (x y : E) :
    H.divergence (T x) (T y) = H.divergence x y := by
  unfold HessianGeometry.divergence HessianGeometry.dualMap
  have hsub : T x - T y = T (x - y) := by
    simp [map_sub]
  rw [hPotential x, hPotential y, hsub, hGradientPairing y (x - y)]

-- theorem-class: derived
/-- The gradient map is monotone because the two oriented Bregman divergences sum to the
quadratic monotonicity form. -/
theorem grad_monotone (x y : E) :
    0 ≤ inner ℝ (H.grad x - H.grad y) (x - y) := by
  have hxy : 0 ≤ H.divergence x y := H.divergence_nonneg x y
  have hyx : 0 ≤ H.divergence y x := H.divergence_nonneg y x
  have hsum : 0 ≤ H.divergence x y + H.divergence y x := add_nonneg hxy hyx
  have hsum_eq :
      H.divergence x y + H.divergence y x =
        inner ℝ (H.grad x - H.grad y) (x - y) := by
    simp [HessianGeometry.divergence, HessianGeometry.dualMap,
      sub_eq_add_neg, inner_add_left, inner_neg_left, real_inner_comm]
    ring
  simpa [hsum_eq] using hsum

-- theorem-class: derived
/-- The Hessian metric operator is symmetric, as it is the second derivative of the potential
whenever `grad` is differentiable, and otherwise totalizes to zero. -/
theorem metricOp_isSymmetric (x : E) :
    (H.metricOp x).toLinearMap.IsSymmetric := by
  by_cases hx : DifferentiableAt ℝ H.grad x
  · have hxGrad : HasFDerivAt H.grad (H.metricOp x) x := by
      simpa [HessianGeometry.metricOp] using hx.hasFDerivAt
    let f' : E → E →L[ℝ] ℝ := fun y => InnerProductSpace.toDual ℝ E (H.grad y)
    let f'' : E →L[ℝ] E →L[ℝ] ℝ :=
      (InnerProductSpace.toDualMap ℝ E).toContinuousLinearMap.comp (H.metricOp x)
    have hSecond : HasFDerivAt f' f'' x := by
      simpa [f', f''] using
        ((InnerProductSpace.toDualMap ℝ E).toContinuousLinearMap.hasFDerivAt.comp x hxGrad)
    intro u v
    have hsymm := second_derivative_symmetric
      (f := H.potential) (f' := f') (f'' := f'')
      (hf := H.has_gradient) hSecond u v
    simpa [f'', InnerProductSpace.toDual_apply_apply, real_inner_comm] using hsymm
  · simp [HessianGeometry.metricOp, fderiv_zero_of_not_differentiableAt hx]

-- theorem-class: derived
/-- The quadratic form of the Hessian metric operator is nonnegative because the gradient is
monotone along every affine ray. -/
theorem metric_quadratic_nonneg (x u : E) :
    0 ≤ inner ℝ u (H.metricOp x u) := by
  by_cases hx : DifferentiableAt ℝ H.grad x
  · let ray : ℝ → E := fun t => x + t • u
    let probe : ℝ → ℝ := fun t => inner ℝ (H.grad (ray t)) u
    have hprobe_mono : Monotone probe := by
      intro s t hst
      rcases lt_or_eq_of_le hst with hlt | rfl
      · have hmono := H.grad_monotone (ray t) (ray s)
        have hray_sub : ray t - ray s = (t - s) • u := by
          dsimp [ray]
          rw [add_sub_add_left_eq_sub]
          exact (sub_smul t s u).symm
        have hscaled :
            0 ≤ (t - s) * (probe t - probe s) := by
          have hmono' :
              0 ≤ inner ℝ (H.grad (ray t) - H.grad (ray s)) ((t - s) • u) := by
            simpa [hray_sub] using hmono
          have hprobe_sub :
              inner ℝ (H.grad (ray t) - H.grad (ray s)) u = probe t - probe s := by
            simp [probe, sub_eq_add_neg, inner_add_left, inner_neg_left]
          rw [inner_smul_right, hprobe_sub] at hmono'
          simpa [mul_assoc, mul_left_comm, mul_comm] using hmono'
        have hsub : 0 ≤ probe t - probe s :=
          nonneg_of_mul_nonneg_right (by simpa [mul_comm] using hscaled) (sub_pos.mpr hlt)
        exact sub_nonneg.mp hsub
      · rfl
    have hray : HasDerivAt ray u 0 := by
      simpa [ray] using (((hasDerivAt_id' (x := (0 : ℝ))).smul_const u).const_add x)
    have hxGrad : HasFDerivAt H.grad (H.metricOp x) x := by
      simpa [HessianGeometry.metricOp] using hx.hasFDerivAt
    have hgrad_ray_f :
        HasFDerivAt (H.grad ∘ ray)
          ((H.metricOp x).comp ((1 : ℝ →L[ℝ] ℝ).smulRight u)) 0 := by
      have hxGrad_at_ray0 : HasFDerivAt H.grad (H.metricOp x) (ray 0) := by
        simpa [ray] using hxGrad
      exact HasFDerivAt.comp (x := (0 : ℝ)) (f := ray) hxGrad_at_ray0 hray.hasFDerivAt
    have hgrad_ray : HasDerivAt (fun t : ℝ => H.grad (ray t)) (H.metricOp x u) 0 := by
      simpa using hgrad_ray_f.hasDerivAt
    have hu : HasDerivAt (fun _ : ℝ => u) 0 0 := by
      simpa using (hasDerivAt_const (x := (0 : ℝ)) u)
    have hprobe_deriv : HasDerivAt probe (inner ℝ (H.metricOp x u) u) 0 := by
      simpa [probe, ray] using hgrad_ray.inner (𝕜 := ℝ) hu
    simpa [real_inner_comm] using hprobe_deriv.nonneg_of_monotone hprobe_mono
  · simp [HessianGeometry.metricOp, fderiv_zero_of_not_differentiableAt hx]

-- theorem-class: derived
/-- The diagonal metric coefficient is nonnegative. -/
theorem metric_nonneg (x u : E) :
    0 ≤ H.metric x u u := by
  simpa [HessianGeometry.metric, real_inner_comm] using H.metric_quadratic_nonneg x u

/-- Bayesian Action (accumulated divergence). -/
noncomputable def bayesianAction (γ : ℕ → E) (N : ℕ) : ℝ :=
  Finset.sum (Finset.range N) (fun i => H.divergence (γ (i + 1)) (γ i))

/-- Theorem: Non-negativity of the Bayesian Action. -/
theorem bayesianAction_nonneg (γ : ℕ → E) (N : ℕ) :
    0 ≤ H.bayesianAction γ N := by
  unfold bayesianAction
  exact Finset.sum_nonneg (fun i _ => H.divergence_nonneg (γ (i + 1)) (γ i))

/-- Legendre dual potential (as supremum). -/
noncomputable def dualPotential (θ : E) : ℝ :=
  sSup { r : ℝ | ∃ x : E, r = inner ℝ x θ - H.potential x }

/-- A named Bregman divergence instance attached to `H`. -/
noncomputable def bregmanDiv (H : HessianGeometry E) : BregmanDivergence E E where
  D := fun x y => H.divergence x y

@[simp] theorem bregmanDiv_D (H : HessianGeometry E) (x y : E) :
    (bregmanDiv H).D x y = H.divergence x y := rfl

/--
Bregman-softmax attention over multivariate Hessian systems.
The interaction score is definitionally `-H.divergence`.
-/
noncomputable def softmaxBregmanAttention
    {ι : Type _} [DecidableEq ι]
    (H : HessianGeometry E)
    (I : Finset ι) (hI : I.Nonempty) (keys : ι → E)
    (route : E → E → E) :
    (letI : BregmanDivergence E E := bregmanDiv H
     GeometricAttentionMap (bregmanTriadicCore (Q := E) (K := E) (V := E) route) ι) := by
  classical
  letI : BregmanDivergence E E := bregmanDiv H
  exact softmaxAttention (core := bregmanTriadicCore route) (I := I) (hI := hI) (keys := keys)

end HessianGeometry

end InfoGeometry.Convex
