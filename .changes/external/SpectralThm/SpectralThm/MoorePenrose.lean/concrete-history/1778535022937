{"type":"new","contents":"module\n\npublic import Mathlib.Algebra.Ring.Basic\npublic import Mathlib.Algebra.Star.Basic\npublic import Mathlib.Analysis.InnerProductSpace.Adjoint\npublic import Mathlib.Analysis.InnerProductSpace.Projection.Basic\npublic import Mathlib.Analysis.InnerProductSpace.Projection.Submodule\npublic import Mathlib.Analysis.Normed.Operator.Banach\n\n/-!\n# Moore--Penrose inverse\n\nAlgebraic Penrose equations in a star ring, together with the rectangular\ncontinuous-linear-map predicate for bounded operators between Hilbert spaces.\n\nThis file intentionally contains only the low-risk interface layer. The constructive\nclosed-range inverse should be added in a second pass after the projection/coercion\nAPI lemmas are stabilized.\n-/\n\n@[expose] public section\n\nnamespace SpectralThm.MoorePenrose\n\nsection Algebraic\n\nvariable {R : Type*} [Ring R] [StarRing R]\n\n/-- The four Penrose equations in a star ring. -/\ndef IsMoorePenroseInverse (A B : R) : Prop :=\n  A * B * A = A ∧\n  B * A * B = B ∧\n  star (A * B) = A * B ∧\n  star (B * A) = B * A\n\nnamespace IsMoorePenroseInverse\n\nvariable {A B : R}\n\ntheorem mk\n    (h1 : A * B * A = A)\n    (h2 : B * A * B = B)\n    (h3 : star (A * B) = A * B)\n    (h4 : star (B * A) = B * A) :\n    IsMoorePenroseInverse A B :=\n  ⟨h1, h2, h3, h4⟩\n\ntheorem aba_eq_a (h : IsMoorePenroseInverse A B) : A * B * A = A := h.1\ntheorem bab_eq_b (h : IsMoorePenroseInverse A B) : B * A * B = B := h.2.1\ntheorem ab_star_eq (h : IsMoorePenroseInverse A B) : star (A * B) = A * B := h.2.2.1\ntheorem ba_star_eq (h : IsMoorePenroseInverse A B) : star (B * A) = B * A := h.2.2.2\n\n/-- Backward-compatible alias for the first Penrose equation. -/\ntheorem eq1 (h : IsMoorePenroseInverse A B) : A * B * A = A := h.aba_eq_a\n\n/-- Backward-compatible alias for the second Penrose equation. -/\ntheorem eq2 (h : IsMoorePenroseInverse A B) : B * A * B = B := h.bab_eq_b\n\n/-- Backward-compatible alias for the third Penrose equation. -/\ntheorem eq3 (h : IsMoorePenroseInverse A B) : star (A * B) = A * B := h.ab_star_eq\n\n/-- Backward-compatible alias for the fourth Penrose equation. -/\ntheorem eq4 (h : IsMoorePenroseInverse A B) : star (B * A) = B * A := h.ba_star_eq\n\nend IsMoorePenroseInverse\n\n/-- Star reverses a triple product. -/\nlemma star_mul_triple (X Y Z : R) : star (X * Y * Z) = star Z * star Y * star X := by\n  calc\n    star (X * Y * Z) = star (X * (Y * Z)) := by rw [mul_assoc]\n    _ = star (Y * Z) * star X := by rw [star_mul]\n    _ = star Z * star Y * star X := by rw [star_mul]\n\n/-- The range projector `A * B` from a Moore--Penrose pair. -/\ndef mpProjector (A B : R) (_h : IsMoorePenroseInverse A B) : R := A * B\n\nlemma mpProjector_idempotent {A B : R} (h : IsMoorePenroseInverse A B) :\n    mpProjector A B h * mpProjector A B h = mpProjector A B h := by\n  unfold mpProjector\n  calc\n    (A * B) * (A * B) = A * (B * (A * B)) := by rw [mul_assoc]\n    _ = A * (B * A * B) := by rw [← mul_assoc B A B]\n    _ = A * B := by rw [h.bab_eq_b]\n\nlemma mpProjector_self_adjoint {A B : R} (h : IsMoorePenroseInverse A B) :\n    star (mpProjector A B h) = mpProjector A B h := by\n  unfold mpProjector\n  exact h.ab_star_eq\n\n/-- The Moore--Penrose inverse is unique when it exists. -/\ntheorem MoorePenrose_unique {A B C : R}\n    (hB : IsMoorePenroseInverse A B)\n    (hC : IsMoorePenroseInverse A C) : B = C := by\n  have h1 : A * B = A * C := by\n    calc\n      A * B = star (A * B) := hB.ab_star_eq.symm\n      _ = star B * star A := star_mul _ _\n      _ = star B * star (A * C * A) := by rw [hC.aba_eq_a]\n      _ = star B * (star A * star C * star A) := by simp only [star_mul, mul_assoc]\n      _ = (star B * star A) * star C * star A := by simp only [mul_assoc]\n      _ = star (A * B) * star C * star A := by rw [star_mul]\n      _ = (A * B) * star C * star A := by rw [hB.ab_star_eq]\n      _ = A * B * (star C * star A) := by rw [mul_assoc]\n      _ = A * B * star (A * C) := by rw [star_mul]\n      _ = A * B * (A * C) := by rw [hC.ab_star_eq]\n      _ = (A * B * A) * C := by simp only [mul_assoc]\n      _ = A * C := by rw [hB.aba_eq_a]\n  have h2 : B * A = C * A := by\n    calc\n      B * A = star (B * A) := hB.ba_star_eq.symm\n      _ = star A * star B := star_mul _ _\n      _ = star (A * C * A) * star B := by rw [hC.aba_eq_a]\n      _ = (star A * star C * star A) * star B := by simp only [star_mul, mul_assoc]\n      _ = star A * star C * (star A * star B) := by simp only [mul_assoc]\n      _ = star A * star C * star (B * A) := by rw [star_mul]\n      _ = star A * star C * (B * A) := by rw [hB.ba_star_eq]\n      _ = star (C * A) * (B * A) := by rw [star_mul]\n      _ = (C * A) * (B * A) := by rw [hC.ba_star_eq]\n      _ = C * (A * B * A) := by simp only [mul_assoc]\n      _ = C * A := by rw [hB.aba_eq_a]\n  calc\n    B = B * A * B := hB.bab_eq_b.symm\n    _ = (B * A) * B := by rw [mul_assoc]\n    _ = (C * A) * B := by rw [h2]\n    _ = C * (A * B) := by rw [← mul_assoc]\n    _ = C * (A * C) := by rw [h1]\n    _ = C * A * C := by rw [mul_assoc]\n    _ = C := hC.bab_eq_b\n\nend Algebraic\n\nsection ContinuousLinearMap\n\nvariable {𝕜 E F : Type*} [RCLike 𝕜]\nvariable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\nvariable [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] [CompleteSpace F]\n\n/--\nThe four Penrose equations for bounded operators between possibly different Hilbert spaces.\n-/\ndef IsMoorePenroseInverseCLM (A : E →L[𝕜] F) (B : F →L[𝕜] E) : Prop :=\n  (A.comp B).comp A = A ∧\n  (B.comp A).comp B = B ∧\n  star (A.comp B) = A.comp B ∧\n  star (B.comp A) = B.comp A\n\nnamespace IsMoorePenroseInverseCLM\n\nvariable {A : E →L[𝕜] F} {B : F →L[𝕜] E}\n\ntheorem aba_eq_a (h : IsMoorePenroseInverseCLM A B) : (A.comp B).comp A = A := h.1\ntheorem bab_eq_b (h : IsMoorePenroseInverseCLM A B) : (B.comp A).comp B = B := h.2.1\ntheorem ab_star_eq (h : IsMoorePenroseInverseCLM A B) : star (A.comp B) = A.comp B := h.2.2.1\ntheorem ba_star_eq (h : IsMoorePenroseInverseCLM A B) : star (B.comp A) = B.comp A := h.2.2.2\n\nend IsMoorePenroseInverseCLM\n\nend ContinuousLinearMap\n\nend SpectralThm.MoorePenrose\n","mtime":1778535022937}