module

public import InfoGeometry.Exceptional.CFSGPort.ChevalleyRootTorusSubgroup
public import InfoGeometry.Exceptional.CFSGPort.ExceptionalCartanHelpers

/-!
# Operator rank-one data for the exceptional Chevalley groups

This file ports the rank-one carrier portion of the external Curtis--Tits
interface. All carriers are subgroups of units in the endomorphism algebra of
the actual root module.
-/

public section

namespace InfoGeometry.Exceptional.CFSGPort.Chevalley

variable {τ : Tag} {K : Type*} [Field K]

/-- The subgroup generated by the pinned simple Weyl operators on the actual
root module. Its carrier is a subgroup of endomorphism units, not the
coordinate permutation model of the Weyl group. -/
@[expose] noncomputable def simpleWeylOperatorSubgroup :
    Subgroup (Module.End K (RootModule τ K))ˣ :=
  Subgroup.closure (Set.range fun i : Fin τ.rank => weylElt τ K i 1)

/-- Each pinned simple reflection operator is in the operator Weyl subgroup. -/
theorem weylElt_one_mem_simpleWeylOperatorSubgroup (i : Fin τ.rank) :
    weylElt τ K i 1 ∈ simpleWeylOperatorSubgroup (τ := τ) (K := K) :=
  Subgroup.subset_closure ⟨i, rfl⟩

/-- A simple Weyl operator sends every certified root vector to the reflected
root vector with the coefficient dictated by its action on the root module.
This is the operator action underlying the generated subgroup. -/
theorem simpleWeylOperator_rootVec (i : Fin τ.rank)
    {α : Fin τ.rank → ℤ} (hα : IsRoot τ α) :
    (weylElt τ K i 1 : Module.End K (RootModule τ K)) (rootVec τ K α) =
      ((-1 : K) ^ stringDown τ i α) • rootVec τ K (reflect τ i α) := by
  simpa using weylElt_rootVec (τ := τ) (R := K) i 1 hα

/-- The noncommutative operator subgroup generated by the positive and
negative pinned simple-root groups. -/
@[expose] noncomputable def operatorRankOneSubgroup (i : Fin τ.rank) :
    Subgroup (Module.End K (RootModule τ K))ˣ :=
  rootSubgroup τ K (Pi.single i 1) ⊔ rootSubgroup τ K (-Pi.single i 1)

/-- The rank-one torus generated by the actual simple-coroot operators. -/
@[expose] noncomputable def simpleRootTorusSubgroup (i : Fin τ.rank) :
    Subgroup (Module.End K (RootModule τ K))ˣ :=
  Subgroup.closure (Set.range (torusElt τ K i))

theorem xUnit_mem_operatorRankOneSubgroup (i : Fin τ.rank) (c : K) :
    xUnit τ K i c ∈ operatorRankOneSubgroup (τ := τ) (K := K) i := by
  apply Subgroup.mem_sup_left
  rw [← pinnedX_single]
  exact Subgroup.subset_closure ⟨c, rfl⟩

theorem yUnit_mem_operatorRankOneSubgroup (i : Fin τ.rank) (c : K) :
    yUnit τ K i c ∈ operatorRankOneSubgroup (τ := τ) (K := K) i := by
  apply Subgroup.mem_sup_right
  rw [← pinnedX_neg_single]
  exact Subgroup.subset_closure ⟨c, rfl⟩

/-- The negative simple-root operators obey the additive root-parameter law
on the actual endomorphism-unit carrier. -/
theorem yUnit_add (i : Fin τ.rank) (c d : K) :
    yUnit τ K i (c + d) = yUnit τ K i c * yUnit τ K i d := by
  rw [← pinnedX_neg_single, ← pinnedX_neg_single, ← pinnedX_neg_single,
    pinnedX_add]

/-- The pinned simple Weyl operator belongs to its rank-one operator group. -/
theorem weylElt_mem_operatorRankOneSubgroup (i : Fin τ.rank) (t : Kˣ) :
    weylElt τ K i t ∈ operatorRankOneSubgroup (τ := τ) (K := K) i := by
  rw [weylElt_eq_xUnit_mul]
  exact mul_mem (mul_mem (xUnit_mem_operatorRankOneSubgroup (τ := τ) (K := K) i (t : K))
    (yUnit_mem_operatorRankOneSubgroup (τ := τ) (K := K) i (-((t⁻¹ : Kˣ) : K))))
    (xUnit_mem_operatorRankOneSubgroup (τ := τ) (K := K) i (t : K))

theorem torusElt_mem_operatorRankOneSubgroup (i : Fin τ.rank) (t : Kˣ) :
    torusElt τ K i t ∈ operatorRankOneSubgroup (τ := τ) (K := K) i := by
  exact mul_mem (weylElt_mem_operatorRankOneSubgroup (τ := τ) (K := K) i t)
    (weylElt_mem_operatorRankOneSubgroup (τ := τ) (K := K) i (-1))

theorem simpleRootTorusSubgroup_le_operatorRankOneSubgroup (i : Fin τ.rank) :
    simpleRootTorusSubgroup (τ := τ) (K := K) i ≤
      operatorRankOneSubgroup (τ := τ) (K := K) i := by
  apply (Subgroup.closure_le _).2
  rintro _ ⟨t, rfl⟩
  exact torusElt_mem_operatorRankOneSubgroup i t

theorem simpleRootTorusSubgroup_isMulCommutative (i : Fin τ.rank) :
    IsMulCommutative (simpleRootTorusSubgroup (τ := τ) (K := K) i) := by
  apply Subgroup.isMulCommutative_closure
  intro x hx y hy _
  obtain ⟨s, rfl⟩ := Set.mem_range.mp hx
  obtain ⟨t, rfl⟩ := Set.mem_range.mp hy
  exact torusElt_commute τ K i i s t

/-- Each simple-root torus is contained in the operator root torus generated
by all simple-coroot torus operators. -/
theorem simpleRootTorusSubgroup_le_rootTorusSubgroup (i : Fin τ.rank) :
    simpleRootTorusSubgroup (τ := τ) (K := K) i ≤ rootTorusSubgroup τ K := by
  apply (Subgroup.closure_le _).2
  rintro _ ⟨t, rfl⟩
  exact Subgroup.subset_closure ⟨(i, t), rfl⟩

/-- Each simple-root torus is a subgroup of the local adjoint Chevalley
group, not only a subgroup of the ambient endomorphism-unit group. This is
the carrier restriction needed for the torus part of the external
Curtis--Tits and Steinberg interfaces. -/
theorem simpleRootTorusSubgroup_le_adjointGroup (i : Fin τ.rank) :
    simpleRootTorusSubgroup (τ := τ) (K := K) i ≤ adjointGroup τ K :=
  (simpleRootTorusSubgroup_le_rootTorusSubgroup (τ := τ) (K := K) i).trans
    (rootTorusSubgroup_le_adjointGroup (τ := τ) (K := K))

/-- Elements of any two simple-root tori commute as endomorphism units. This
is the local operator-carrier form of the external `torus_commute` field. -/
theorem simpleRootTorusSubgroups_commute (i j : Fin τ.rank)
    {h : (Module.End K (RootModule τ K))ˣ}
    (hh : h ∈ simpleRootTorusSubgroup (τ := τ) (K := K) i)
    {h' : (Module.End K (RootModule τ K))ˣ}
    (hh' : h' ∈ simpleRootTorusSubgroup (τ := τ) (K := K) j) :
    Commute h h' := by
  let T := rootTorusSubgroup τ K
  letI : IsMulCommutative T := rootTorusSubgroup_isMulCommutative τ K
  let a : T := ⟨h, (simpleRootTorusSubgroup_le_rootTorusSubgroup (τ := τ) (K := K) i) hh⟩
  let b : T := ⟨h', (simpleRootTorusSubgroup_le_rootTorusSubgroup (τ := τ) (K := K) j) hh'⟩
  exact congrArg Subtype.val (IsMulCommutative.is_comm.comm a b)

/-- Equality between the two simple-coroot torus generators in G₂ forces both
parameters to be trivial. This is the rank-two character input for the
external adjoint-torus independence proof. -/
theorem torusElt_eq_one_of_torusElt_G2_eq {K : Type*} [Field K]
    (s t : Kˣ)
    (h : torusElt (τ := .G2) K ⟨0, by decide⟩ s =
      torusElt (τ := .G2) K ⟨1, by decide⟩ t) :
    s = 1 ∧ t = 1 := by
  let i0 : Fin (Tag.rank .G2) := ⟨0, by decide⟩
  let i1 : Fin (Tag.rank .G2) := ⟨1, by decide⟩
  have hmap : (torusElt (τ := .G2) K i0 s : Module.End K (RootModule .G2 K)) =
      (torusElt (τ := .G2) K i1 t : Module.End K (RootModule .G2 K)) :=
    congrArg Units.val h
  have hchar (m : Fin (Tag.rank .G2)) :
      s ^ Tag.cartan .G2 i0 m = t ^ Tag.cartan .G2 i1 m := by
    let b : Label .G2 := .inr ⟨Pi.single m 1, isRoot_single .G2 m⟩
    have hsingle := congrArg (fun f : Module.End K (RootModule .G2 K) =>
      f (Finsupp.single b 1)) hmap
    rw [torusElt_single_eq, torusElt_single_eq] at hsingle
    have hcoord := congrArg (fun z : RootModule .G2 K => z b) hsingle
    apply Units.ext
    simpa [b, Label.latticeWeight, Pi.single_apply, Finsupp.smul_apply,
      Finsupp.single_eq_same, smul_eq_mul] using hcoord
  have h0 : s ^ (2 : ℤ) = t ^ (-3 : ℤ) := by
    have hc := hchar i0
    norm_num [Tag.cartan, i0, i1] at hc ⊢
    exact hc
  have h1 : s⁻¹ = t ^ (2 : ℤ) := by
    have hc := hchar i1
    change s ^ (-1 : ℤ) = t ^ (2 : ℤ) at hc
    simpa only [zpow_neg, zpow_one] using hc
  have h1sq : (s⁻¹) ^ 2 = (t ^ 2) ^ 2 := congrArg (fun x : Kˣ => x ^ 2) h1
  have hmul : s ^ 2 * (s⁻¹) ^ 2 = t ^ (-3 : ℤ) * (t ^ 2) ^ 2 :=
    congrArg₂ (· * ·) h0 h1sq
  have ht : t = 1 := by
    have h' : 1 = t := by
      calc
        1 = s ^ 2 * (s⁻¹) ^ 2 := by group
        _ = t ^ (-3 : ℤ) * (t ^ 2) ^ 2 := hmul
        _ = t := by group
    exact h'.symm
  have hs : s = 1 := by
    have hs' : s⁻¹ = 1 := by simpa [ht] using h1
    exact inv_eq_one.mp hs'
  exact ⟨hs, ht⟩

/-- The simple Weyl operator exchanges the positive and negative pinned root
units, with the parameter rescaling given by the operator conjugation law. -/
theorem weylElt_conj_xUnit (i : Fin τ.rank) (t : Kˣ) (c : K) :
    weylElt τ K i t * xUnit τ K i c * (weylElt τ K i t)⁻¹ =
      yUnit τ K i (-c * ((t⁻¹ : Kˣ) : K) ^ 2) := by
  apply Units.ext
  exact weylElt_mul_xOp_mul_inv i t c

theorem weylElt_conj_yUnit (i : Fin τ.rank) (t : Kˣ) (c : K) :
    weylElt τ K i t * yUnit τ K i c * (weylElt τ K i t)⁻¹ =
      xUnit τ K i (-c * (t : K) ^ 2) := by
  apply Units.ext
  exact weylElt_mul_yOp_mul_inv i t c

/-- The rank-one torus conjugates the positive simple-root operators by the
square character on the actual endomorphism-unit carrier. -/
theorem torusElt_conj_xUnit (i : Fin τ.rank) (t : Kˣ) (a : K) :
    torusElt τ K i t * xUnit τ K i a * (torusElt τ K i t)⁻¹ =
      xUnit τ K i ((t : K) ^ 2 * a) := by
  have hneg : (weylElt τ K i (-(1 : Kˣ))) * xUnit τ K i a *
      (weylElt τ K i (-(1 : Kˣ)))⁻¹ = yUnit τ K i (-a) := by
    simpa using weylElt_conj_xUnit i (-(1 : Kˣ)) a
  calc
    torusElt τ K i t * xUnit τ K i a * (torusElt τ K i t)⁻¹ =
        weylElt τ K i t * ((weylElt τ K i (-(1 : Kˣ))) * xUnit τ K i a *
          (weylElt τ K i (-(1 : Kˣ)))⁻¹) * (weylElt τ K i t)⁻¹ := by
            rw [torusElt]
            group
    _ = weylElt τ K i t * yUnit τ K i (-a) * (weylElt τ K i t)⁻¹ := by rw [hneg]
    _ = xUnit τ K i (-(-a) * (t : K) ^ 2) := by rw [weylElt_conj_yUnit]
    _ = xUnit τ K i ((t : K) ^ 2 * a) := by congr 1; ring

/-- Rank-one root generators, their additive laws, and the Weyl conjugation
relation, all with values in the subgroup of actual root-module operators. -/
structure OperatorRankOneRels (i : Fin τ.rank) where
  x : K → operatorRankOneSubgroup (τ := τ) (K := K) i
  y : K → operatorRankOneSubgroup (τ := τ) (K := K) i
  x_val : ∀ c, (x c : (Module.End K (RootModule τ K))ˣ) = xUnit τ K i c
  y_val : ∀ c, (y c : (Module.End K (RootModule τ K))ˣ) = yUnit τ K i c
  w_val : ∀ t : Kˣ,
    ((x (t : K) * y (-((t⁻¹ : Kˣ) : K)) * x (t : K) :
      operatorRankOneSubgroup (τ := τ) (K := K) i) :
        (Module.End K (RootModule τ K))ˣ) = weylElt τ K i t
  x_add : ∀ c d, x (c + d) = x c * x d
  y_add : ∀ c d, y (c + d) = y c * y d
  w_conj_x : ∀ t : Kˣ, ∀ a,
    (weylElt τ K i t : (Module.End K (RootModule τ K))ˣ) *
      (x a : (Module.End K (RootModule τ K))ˣ) *
      (weylElt τ K i t)⁻¹ =
        y (-a * ((t⁻¹ : Kˣ) : K) ^ 2)

/-- The external `RankOneRels` generator interface, instantiated directly on
the noncommutative operator-unit subgroup. -/
noncomputable def operatorRankOneRels (i : Fin τ.rank) :
    OperatorRankOneRels (τ := τ) (K := K) i where
  x c := ⟨xUnit τ K i c, xUnit_mem_operatorRankOneSubgroup (τ := τ) (K := K) i c⟩
  y c := ⟨yUnit τ K i c, yUnit_mem_operatorRankOneSubgroup (τ := τ) (K := K) i c⟩
  x_val _ := rfl
  y_val _ := rfl
  w_val t := by
    change xUnit τ K i (t : K) * yUnit τ K i (-((t⁻¹ : Kˣ) : K)) *
      xUnit τ K i (t : K) = weylElt τ K i t
    exact (weylElt_eq_xUnit_mul i t).symm
  x_add c d := Subtype.ext (xUnit_add i c d)
  y_add c d := Subtype.ext (yUnit_add i c d)
  w_conj_x t a := by
    change weylElt τ K i t * xUnit τ K i a * (weylElt τ K i t)⁻¹ =
      yUnit τ K i (-a * ((t⁻¹ : Kˣ) : K) ^ 2)
    rw [weylElt_conj_xUnit]

namespace OperatorRankOneRels

variable {i : Fin τ.rank} (R : OperatorRankOneRels (τ := τ) (K := K) i)

/-- The rank-one Weyl element expressed from the two root generators. -/
@[expose] noncomputable def w (t : Kˣ) : operatorRankOneSubgroup (τ := τ) (K := K) i :=
  R.x (t : K) * R.y (-((t⁻¹ : Kˣ) : K)) * R.x (t : K)

/-- The rank-one torus element expressed from the Weyl generators. -/
@[expose] noncomputable def h (t : Kˣ) : operatorRankOneSubgroup (τ := τ) (K := K) i :=
  R.w t * (R.w 1)⁻¹

theorem coe_w (t : Kˣ) :
    (R.w t : (Module.End K (RootModule τ K))ˣ) = weylElt τ K i t :=
  R.w_val t

/-- Inversion of the Bruhat Weyl generator agrees with inversion of the
pinned root-module Weyl operator. -/
theorem w_inv (t : Kˣ) : (R.w t)⁻¹ = R.w (-t) := by
  apply Subtype.ext
  change ((R.w t : (Module.End K (RootModule τ K))ˣ)⁻¹) =
    (R.w (-t) : (Module.End K (RootModule τ K))ˣ)
  rw [R.coe_w, R.coe_w, weylElt_inv]

/-- The Weyl generator conjugates the negative root subgroup to the positive
root subgroup by the pinned rank-one parameter formula. -/
theorem w_conj_y (t : Kˣ) (a : K) :
    R.w t * R.y a * (R.w t)⁻¹ =
      R.x (-a * (t : K) ^ 2) := by
  apply Subtype.ext
  change (R.w t : (Module.End K (RootModule τ K))ˣ) *
      (R.y a : (Module.End K (RootModule τ K))ˣ) *
      (R.w t : (Module.End K (RootModule τ K))ˣ)⁻¹ =
    (R.x (-a * (t : K) ^ 2) : (Module.End K (RootModule τ K))ˣ)
  rw [R.coe_w, R.y_val, R.x_val]
  exact weylElt_conj_yUnit (τ := τ) (K := K) i t a

/-- Conjugation by the inverse Weyl generator sends a positive root operator
to the corresponding negative root operator. -/
theorem w_inv_conj_x (t : Kˣ) (a : K) :
    (R.w t)⁻¹ * R.x a * R.w t =
      R.y (-a * ((t⁻¹ : Kˣ) : K) ^ 2) := by
  apply Subtype.ext
  change ((R.w t : (Module.End K (RootModule τ K))ˣ)⁻¹) *
      (R.x a : (Module.End K (RootModule τ K))ˣ) *
      (R.w t : (Module.End K (RootModule τ K))ˣ) =
    (R.y (-a * ((t⁻¹ : Kˣ) : K) ^ 2) :
      (Module.End K (RootModule τ K))ˣ)
  rw [R.coe_w, R.x_val, R.y_val, weylElt_inv]
  have hconj := weylElt_conj_xUnit (τ := τ) (K := K) i (-t) a
  have hunit : (-t)⁻¹ = -(t⁻¹) := inv_neg
  have hinv : (((-t)⁻¹ : Kˣ) : K) = -((t⁻¹ : Kˣ) : K) :=
    congrArg (fun u : Kˣ => (u : K)) hunit
  rw [weylElt_inv] at hconj
  rw [hinv, neg_sq, neg_neg] at hconj
  exact hconj

/-- Moving a positive root operator across the Weyl generator gives a
negative root operator with the inverse-square parameter. -/
theorem x_mul_w (t : Kˣ) (a : K) :
    R.x a * R.w t = R.w t *
      R.y (-a * ((t⁻¹ : Kˣ) : K) ^ 2) := by
  calc
    R.x a * R.w t = R.w t * ((R.w t)⁻¹ * R.x a * R.w t) := by group
    _ = R.w t * R.y (-a * ((t⁻¹ : Kˣ) : K) ^ 2) := by
      rw [R.w_inv_conj_x]

/-- The Bruhat torus coordinate agrees with the pinned operator torus. -/
theorem coe_h (t : Kˣ) :
    (R.h t : (Module.End K (RootModule τ K))ˣ) = torusElt τ K i t := by
  change (R.w t : (Module.End K (RootModule τ K))ˣ) *
    ((R.w 1 : (Module.End K (RootModule τ K))ˣ)⁻¹) = torusElt τ K i t
  rw [R.coe_w, R.coe_w, torusElt, weylElt_inv]

/-- The Bruhat torus parameter is multiplicative in the operator-unit group. -/
theorem h_mul (s t : Kˣ) : R.h (s * t) = R.h s * R.h t := by
  apply Subtype.ext
  change (R.h (s * t) : (Module.End K (RootModule τ K))ˣ) =
    (R.h s : (Module.End K (RootModule τ K))ˣ) *
      (R.h t : (Module.End K (RootModule τ K))ˣ)
  rw [R.coe_h, R.coe_h, R.coe_h, torusElt_mul]

/-- The two rank-one Bruhat cells, expressed entirely in the operator-unit
subgroup: its Borel cell and its Weyl double coset. -/
@[expose] def bruhat : Set (operatorRankOneSubgroup (τ := τ) (K := K) i) :=
  {g | (∃ a t, g = R.x a * R.h t) ∨
    ∃ a b t, g = R.x a * R.w 1 * R.x b * R.h t}

/-- The operator torus acts on the positive rank-one root subgroup by the
square character, in the internal operator subgroup. -/
theorem h_conj_x (t : Kˣ) (a : K) :
    R.h t * R.x a * (R.h t)⁻¹ = R.x ((t : K) ^ 2 * a) := by
  apply Subtype.ext
  change (R.h t : (Module.End K (RootModule τ K))ˣ) *
      (R.x a : (Module.End K (RootModule τ K))ˣ) *
      (R.h t : (Module.End K (RootModule τ K))ˣ)⁻¹ =
    (R.x ((t : K) ^ 2 * a) : (Module.End K (RootModule τ K))ˣ)
  simp only [R.coe_h, R.x_val]
  exact torusElt_conj_xUnit (τ := τ) (K := K) i t a

/-- Moving a positive root operator across the torus changes its parameter
by the square character. -/
theorem h_mul_x (t : Kˣ) (a : K) :
    R.h t * R.x a = R.x ((t : K) ^ 2 * a) * R.h t := by
  calc
    R.h t * R.x a = (R.h t * R.x a * (R.h t)⁻¹) * R.h t := by group
    _ = R.x ((t : K) ^ 2 * a) * R.h t := by rw [R.h_conj_x]

/-- The two rank-one Bruhat cells are stable under right multiplication by
a positive root operator. -/
theorem mul_x_mem_bruhat {g : operatorRankOneSubgroup (τ := τ) (K := K) i}
    (hg : g ∈ R.bruhat) (c : K) : g * R.x c ∈ R.bruhat := by
  rcases hg with ⟨a, t, rfl⟩ | ⟨a, b, t, rfl⟩
  · left
    refine ⟨a + (t : K) ^ 2 * c, t, ?_⟩
    rw [mul_assoc _ (R.h t), R.h_mul_x]
    calc
      R.x a * (R.x ((t : K) ^ 2 * c) * R.h t) =
          (R.x a * R.x ((t : K) ^ 2 * c)) * R.h t := by group
      _ = R.x (a + (t : K) ^ 2 * c) * R.h t := by rw [← R.x_add]
  · right
    refine ⟨a, b + (t : K) ^ 2 * c, t, ?_⟩
    rw [mul_assoc _ (R.h t), R.h_mul_x]
    calc
      R.x a * R.w 1 * R.x b * (R.x ((t : K) ^ 2 * c) * R.h t) =
          R.x a * R.w 1 * (R.x b * R.x ((t : K) ^ 2 * c)) * R.h t := by group
      _ = R.x a * R.w 1 * R.x (b + (t : K) ^ 2 * c) * R.h t := by
        rw [← R.x_add]

/-- The two rank-one Bruhat cells are stable under right multiplication by
a rank-one torus operator. -/
theorem mul_h_mem_bruhat {g : operatorRankOneSubgroup (τ := τ) (K := K) i}
    (hg : g ∈ R.bruhat) (s : Kˣ) : g * R.h s ∈ R.bruhat := by
  rcases hg with ⟨a, t, rfl⟩ | ⟨a, b, t, rfl⟩
  · left
    refine ⟨a, t * s, ?_⟩
    calc
      R.x a * R.h t * R.h s = R.x a * (R.h t * R.h s) := by group
      _ = R.x a * R.h (t * s) := by rw [R.h_mul]
  · right
    refine ⟨a, b, t * s, ?_⟩
    calc
      R.x a * R.w 1 * R.x b * R.h t * R.h s =
          R.x a * R.w 1 * R.x b * (R.h t * R.h s) := by group
      _ = R.x a * R.w 1 * R.x b * R.h (t * s) := by rw [R.h_mul]

theorem x_zero : R.x 0 = 1 := by
  have h := R.x_add 0 0
  rw [add_zero] at h
  exact left_eq_mul.1 h

theorem y_zero : R.y 0 = 1 := by
  have h := R.y_add 0 0
  rw [add_zero] at h
  exact left_eq_mul.1 h

theorem x_neg (a : K) : R.x (-a) = (R.x a)⁻¹ :=
  eq_inv_of_mul_eq_one_left (by rw [← R.x_add, neg_add_cancel, R.x_zero])

theorem y_neg (a : K) : R.y (-a) = (R.y a)⁻¹ :=
  eq_inv_of_mul_eq_one_left (by rw [← R.y_add, neg_add_cancel, R.y_zero])

theorem h_one : R.h 1 = 1 := mul_inv_cancel _

/-- Inversion of the torus operator inverts its unit parameter. -/
theorem h_inv (t : Kˣ) : (R.h t)⁻¹ = R.h t⁻¹ :=
  (eq_inv_of_mul_eq_one_left (by
    rw [← R.h_mul, inv_mul_cancel, R.h_one])).symm

/-- The Weyl generator factors as its torus coordinate times the unit Weyl
generator, in the root-module operator group. -/
theorem w_eq_h_mul (t : Kˣ) : R.w t = R.h t * R.w 1 := by
  rw [h]
  group

/-- The square of the unit Weyl operator is the torus operator at `-1`.
This is the short-cell reduction used in rank-one Bruhat multiplication. -/
theorem w_one_mul_w_one : R.w 1 * R.w 1 = R.h (-1) := by
  have e : (R.w 1)⁻¹ = R.h (-1) * R.w 1 := by
    rw [R.w_inv, ← R.w_eq_h_mul]
  have e2 : R.h (-1) = (R.w 1)⁻¹ * (R.w 1)⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq, ← e]
  rw [← inv_inv (R.w 1 * R.w 1), mul_inv_rev, ← e2, R.h_inv,
    inv_neg, inv_one]

/-- The negative root operator is the Weyl conjugate of the positive root
operator, expressed inside the actual rank-one operator subgroup. -/
theorem y_eq_conj (a : K) :
    R.y a = R.w 1 * R.x (-a) * (R.w 1)⁻¹ := by
  apply Subtype.ext
  change (R.y a : (Module.End K (RootModule τ K))ˣ) =
    (R.w 1 : (Module.End K (RootModule τ K))ˣ) *
      (R.x (-a) : (Module.End K (RootModule τ K))ˣ) *
      (R.w 1 : (Module.End K (RootModule τ K))ˣ)⁻¹
  rw [R.coe_w, R.x_val, R.y_val]
  have h := R.w_conj_x 1 (-a)
  rw [R.x_val, R.y_val] at h
  simpa using h.symm

theorem one_mem_bruhat : (1 : operatorRankOneSubgroup (τ := τ) (K := K) i) ∈ R.bruhat := by
  left
  refine ⟨0, 1, ?_⟩
  rw [R.x_zero, R.h_one]
  simp

end OperatorRankOneRels

/-- The rank-one Bruhat torus expression `w(t) w(1)⁻¹` is the local torus
operator, so its parameter multiplication is inherited from `torusElt_mul`. -/
theorem weylElt_mul_weylElt_one_inv_eq_torusElt (i : Fin τ.rank) (t : Kˣ) :
    weylElt τ K i t * (weylElt τ K i 1)⁻¹ = torusElt τ K i t := by
  rw [weylElt_inv]
  rfl

/-- The rank-one Bruhat torus parameters multiply on the operator carrier. -/
theorem weylElt_mul_weylElt_one_inv_mul (i : Fin τ.rank) (s t : Kˣ) :
    weylElt τ K i (s * t) * (weylElt τ K i 1)⁻¹ =
      (weylElt τ K i s * (weylElt τ K i 1)⁻¹) *
        (weylElt τ K i t * (weylElt τ K i 1)⁻¹) := by
  rw [weylElt_mul_weylElt_one_inv_eq_torusElt,
    weylElt_mul_weylElt_one_inv_eq_torusElt,
    weylElt_mul_weylElt_one_inv_eq_torusElt, torusElt_mul]

/-- The rank-one torus acts on the negative simple-root operators by the
inverse square character on the actual endomorphism-unit carrier. -/
theorem torusElt_conj_yUnit (i : Fin τ.rank) (t : Kˣ) (a : K) :
    torusElt τ K i t * yUnit τ K i a * (torusElt τ K i t)⁻¹ =
      yUnit τ K i (((t⁻¹ : Kˣ) : K) ^ 2 * a) := by
  have hneg : (weylElt τ K i (-(1 : Kˣ))) * yUnit τ K i a *
      (weylElt τ K i (-(1 : Kˣ)))⁻¹ = xUnit τ K i (-a) := by
    simpa using weylElt_conj_yUnit i (-(1 : Kˣ)) a
  calc
    torusElt τ K i t * yUnit τ K i a * (torusElt τ K i t)⁻¹ =
        weylElt τ K i t * ((weylElt τ K i (-(1 : Kˣ))) * yUnit τ K i a *
          (weylElt τ K i (-(1 : Kˣ)))⁻¹) * (weylElt τ K i t)⁻¹ := by
            rw [torusElt]
            group
    _ = weylElt τ K i t * xUnit τ K i (-a) * (weylElt τ K i t)⁻¹ := by rw [hneg]
    _ = yUnit τ K i (-(-a) * ((t⁻¹ : Kˣ) : K) ^ 2) := by
      rw [weylElt_conj_xUnit]
    _ = yUnit τ K i (((t⁻¹ : Kˣ) : K) ^ 2 * a) := by congr 1; ring

namespace OperatorRankOneRels

variable {i : Fin τ.rank} (R : OperatorRankOneRels (τ := τ) (K := K) i)

/-- The rank-one torus conjugates negative root operators by the inverse
square character on the root-module operator subgroup. -/
theorem h_conj_y (t : Kˣ) (a : K) :
    R.h t * R.y a * (R.h t)⁻¹ =
      R.y (((t⁻¹ : Kˣ) : K) ^ 2 * a) := by
  apply Subtype.ext
  change (R.h t : (Module.End K (RootModule τ K))ˣ) *
      (R.y a : (Module.End K (RootModule τ K))ˣ) *
      (R.h t : (Module.End K (RootModule τ K))ˣ)⁻¹ =
    (R.y (((t⁻¹ : Kˣ) : K) ^ 2 * a) : (Module.End K (RootModule τ K))ˣ)
  simp only [R.coe_h, R.y_val]
  exact torusElt_conj_yUnit (τ := τ) (K := K) i t a

/-- Moving a negative root operator past the torus rescales its parameter
by the inverse square character. -/
theorem h_mul_y (t : Kˣ) (a : K) :
    R.h t * R.y a = R.y (((t⁻¹ : Kˣ) : K) ^ 2 * a) * R.h t :=
  mul_inv_eq_iff_eq_mul.mp (R.h_conj_y t a)

/-- Torus conjugation rescales the Weyl parameter on the root-module
operator group. -/
theorem h_conj_w (t u : Kˣ) :
    R.h t * R.w u * (R.h t)⁻¹ = R.w (t ^ 2 * u) := by
  have e : R.h t * R.w u * (R.h t)⁻¹ =
      (R.h t * R.x (u : K) * (R.h t)⁻¹) *
      (R.h t * R.y (-((u⁻¹ : Kˣ) : K)) * (R.h t)⁻¹) *
      (R.h t * R.x (u : K) * (R.h t)⁻¹) := by
    unfold w
    group
  rw [e, R.h_conj_x, R.h_conj_y, w]
  simp only [pow_two, mul_inv_rev, Units.val_mul]
  congr 3
  ring

end OperatorRankOneRels

/-- Conjugation by the simple Weyl operator sends the positive simple-root
subgroup into its negative counterpart on the actual root-module carrier. -/
theorem weylElt_conj_mem_negSimpleRootSubgroup (i : Fin τ.rank) (t : Kˣ)
    {x : (Module.End K (RootModule τ K))ˣ}
    (hx : x ∈ rootSubgroup τ K (Pi.single i 1)) :
    weylElt τ K i t * x * (weylElt τ K i t)⁻¹ ∈
      rootSubgroup τ K (-Pi.single i 1) := by
  obtain ⟨c, hc⟩ := mem_rootSubgroup.mp hx
  rw [← hc, pinnedX_single, weylElt_conj_xUnit, ← pinnedX_neg_single]
  exact Subgroup.subset_closure ⟨_, rfl⟩

/-- Conjugation by the simple Weyl operator sends the negative simple-root
subgroup into its positive counterpart on the actual root-module carrier. -/
theorem weylElt_conj_mem_posSimpleRootSubgroup (i : Fin τ.rank) (t : Kˣ)
    {x : (Module.End K (RootModule τ K))ˣ}
    (hx : x ∈ rootSubgroup τ K (-Pi.single i 1)) :
    weylElt τ K i t * x * (weylElt τ K i t)⁻¹ ∈
      rootSubgroup τ K (Pi.single i 1) := by
  obtain ⟨c, hc⟩ := mem_rootSubgroup.mp hx
  rw [← hc, pinnedX_neg_single, weylElt_conj_yUnit, ← pinnedX_single]
  exact Subgroup.subset_closure ⟨_, rfl⟩

set_option maxHeartbeats 0 in
private theorem torusElt_inv (i : Fin τ.rank) (t : Kˣ) :
    torusElt τ K i t⁻¹ = (torusElt τ K i t)⁻¹ := by
  have hmul : torusElt τ K i t * torusElt τ K i t⁻¹ = 1 := by
    calc
      torusElt τ K i t * torusElt τ K i t⁻¹ = torusElt τ K i (t * t⁻¹) :=
        (torusElt_mul (τ := τ) (R := K) i t t⁻¹).symm
      _ = 1 := by rw [mul_inv_cancel, torusElt_one (τ := τ) (R := K) i]
  simpa using congrArg Inv.inv (inv_eq_of_mul_eq_one_left hmul)

/-- Membership in a simple-root torus generated by `torusElt` has a single
field-unit parameter; this follows because `torusElt` is multiplicative in
that parameter. -/
theorem exists_torusElt_eq_of_mem_simpleRootTorusSubgroup (i : Fin τ.rank)
    {g : (Module.End K (RootModule τ K))ˣ}
    (hg : g ∈ simpleRootTorusSubgroup (τ := τ) (K := K) i) :
    ∃ t : Kˣ, g = torusElt τ K i t := by
  change g ∈ Subgroup.closure (Set.range fun t : Kˣ => torusElt τ K i t) at hg
  refine Subgroup.closure_induction
    (k := Set.range fun t : Kˣ => torusElt τ K i t)
    (p := fun g _ => ∃ t : Kˣ, g = torusElt τ K i t) ?_ ?_ ?_ ?_ hg
  · intro x hx
    rcases hx with ⟨t, rfl⟩
    exact ⟨t, rfl⟩
  · exact ⟨1, (torusElt_one (τ := τ) (R := K) i).symm⟩
  · rintro x y hx hy ⟨s, rfl⟩ ⟨t, rfl⟩
    exact ⟨s * t, by rw [torusElt_mul]⟩
  · rintro x hx ⟨t, rfl⟩
    exact ⟨t⁻¹, (torusElt_inv (τ := τ) (K := K) i t).symm⟩

/-- The two simple-coroot tori in G₂ are independent subgroups of units on
the root module. Their intersection is trivial because equality of their
operators forces both torus parameters to be one. -/
theorem simpleRootTorusSubgroup_iSupIndep_G2 {K : Type*} [Field K] :
    iSupIndep (fun i : Fin (Tag.rank .G2) =>
      simpleRootTorusSubgroup (τ := .G2) (K := K) i) := by
  let i0 : Fin (Tag.rank .G2) := ⟨0, by decide⟩
  let i1 : Fin (Tag.rank .G2) := ⟨1, by decide⟩
  rw [iSupIndep_pair (i := i0) (j := i1) (by decide) (by
    intro k
    fin_cases k <;> simp [i0, i1])]
  rw [disjoint_iff_inf_le]
  refine le_trans ?_ bot_le
  intro g hg
  obtain ⟨s, rfl⟩ := exists_torusElt_eq_of_mem_simpleRootTorusSubgroup
    (τ := .G2) (K := K) i0 hg.1
  obtain ⟨t, ht⟩ := exists_torusElt_eq_of_mem_simpleRootTorusSubgroup
    (τ := .G2) (K := K) i1 hg.2
  have hparams := torusElt_eq_one_of_torusElt_G2_eq (K := K) s t ht
  exact Subgroup.mem_bot.mpr (by rw [hparams.1, torusElt_one])

/-- The character by which a tuple of simple-root torus parameters acts on a
root-module weight. -/
@[expose] def torusWeightCharacter (t : Fin τ.rank → Kˣ)
    (μ : Fin τ.rank → ℤ) : Kˣ :=
  ∏ j, t j ^ (∑ l, τ.cartan j l * μ l)

private theorem torusWeightCharacter_one (μ : Fin τ.rank → ℤ) :
    torusWeightCharacter (τ := τ) (K := K) (fun _ => 1) μ = 1 := by
  simp [torusWeightCharacter]

private theorem torusWeightCharacter_mul (t u : Fin τ.rank → Kˣ)
    (μ : Fin τ.rank → ℤ) :
    torusWeightCharacter (τ := τ) (K := K) (t * u) μ =
      torusWeightCharacter t μ * torusWeightCharacter u μ := by
  simp only [torusWeightCharacter, Pi.mul_apply, mul_zpow, Finset.prod_mul_distrib]

private theorem torusWeightCharacter_inv (t : Fin τ.rank → Kˣ)
    (μ : Fin τ.rank → ℤ) :
    torusWeightCharacter (τ := τ) (K := K) t⁻¹ μ =
      (torusWeightCharacter t μ)⁻¹ := by
  simp only [torusWeightCharacter, Pi.inv_apply, inv_zpow, Finset.prod_inv_distrib]

private theorem torusWeightCharacter_mulSingle (j : Fin τ.rank) (s : Kˣ)
    (μ : Fin τ.rank → ℤ) :
    torusWeightCharacter (τ := τ) (K := K) (Pi.mulSingle j s) μ =
      s ^ (∑ l, τ.cartan j l * μ l) := by
  rw [torusWeightCharacter, Finset.prod_eq_single j]
  · rw [Pi.mulSingle_eq_same]
  · intro b _ hb
    rw [Pi.mulSingle_eq_of_ne hb, one_zpow]
  · intro h
    exact (h (Finset.mem_univ j)).elim

/-- Elements acting by a prescribed Cartan weight character, with trivial
parameter in the omitted simple-root direction. -/
private def torusWeightCharacterSubgroup (i : Fin τ.rank) :
    Subgroup (Module.End K (RootModule τ K))ˣ where
  carrier := {g | ∃ t : Fin τ.rank → Kˣ, t i = 1 ∧
    ∀ b : Label τ,
      (g : Module.End K (RootModule τ K)) (Finsupp.single b 1) =
        ((torusWeightCharacter t b.latticeWeight : Kˣ) : K) • Finsupp.single b 1}
  mul_mem' {g h} := by
    rintro ⟨t, ht, hg⟩ ⟨u, hu, hh⟩
    refine ⟨t * u, by simp [ht, hu], fun b => ?_⟩
    rw [Units.val_mul, Module.End.mul_apply, hh, map_smul, hg, smul_smul,
      torusWeightCharacter_mul, Units.val_mul]
    exact congrArg (fun r : K => r • Finsupp.single b 1)
      (mul_comm (↑(torusWeightCharacter u b.latticeWeight) : K)
        (↑(torusWeightCharacter t b.latticeWeight) : K))
  one_mem' := by
    refine ⟨fun _ => 1, rfl, fun b => ?_⟩
    simp [torusWeightCharacter_one]
  inv_mem' {g} := by
    rintro ⟨t, ht, hg⟩
    refine ⟨t⁻¹, by simp [ht], fun b => ?_⟩
    have hchar := hg b
    have h2 : (g : Module.End K (RootModule τ K))
        (((torusWeightCharacter t⁻¹ b.latticeWeight : Kˣ) : K) •
          Finsupp.single b 1) = Finsupp.single b 1 := by
      rw [map_smul, hg, smul_smul, torusWeightCharacter_inv]
      simp
    have h1 : (g : Module.End K (RootModule τ K))
        (((g⁻¹ : (Module.End K (RootModule τ K))ˣ) : Module.End K (RootModule τ K))
          (Finsupp.single b 1)) = Finsupp.single b 1 := by
      rw [← Module.End.mul_apply, Units.mul_inv, Module.End.one_apply]
    have hinj : Function.Injective (g : Module.End K (RootModule τ K)) := by
      intro x y hxy
      have h := congrArg
        (((g⁻¹ : (Module.End K (RootModule τ K))ˣ) : Module.End K (RootModule τ K))) hxy
      simpa only [LinearMap.comp_apply, ← Module.End.mul_apply, Units.inv_mul,
        Module.End.one_apply] using h
    exact hinj (h1.trans h2.symm)

private theorem simpleRootTorusSubgroup_le_torusWeightCharacterSubgroup
    (i j : Fin τ.rank) (hij : j ≠ i) :
    simpleRootTorusSubgroup (τ := τ) (K := K) j ≤
      torusWeightCharacterSubgroup (τ := τ) (K := K) i := by
  apply (Subgroup.closure_le _).2
  rintro _ ⟨s, rfl⟩
  refine ⟨Pi.mulSingle j s, by simp [hij.symm], fun b => ?_⟩
  rw [torusWeightCharacter_mulSingle, torusElt_single_eq]

/-- If the Cartan matrix has an integral right inverse, the simple-root
torus operator subgroups are independent. This ports the external
`torus_iSupIndep` argument on the actual endomorphism-unit carrier. -/
theorem simpleRootTorusSubgroup_iSupIndep_of_cartanRightInverse
    {B : Matrix (Fin τ.rank) (Fin τ.rank) ℤ}
    (hB : τ.cartan * B = 1) :
    iSupIndep (fun i : Fin τ.rank =>
      simpleRootTorusSubgroup (τ := τ) (K := K) i) := by
  intro i
  rw [disjoint_iff]
  refine eq_bot_iff.2 fun g hg => ?_
  obtain ⟨hgi, hgj⟩ := Subgroup.mem_inf.1 hg
  have hle : (⨆ j : Fin τ.rank, ⨆ (_ : j ≠ i),
      simpleRootTorusSubgroup (τ := τ) (K := K) j) ≤
      torusWeightCharacterSubgroup (τ := τ) (K := K) i :=
    iSup₂_le fun j hj => simpleRootTorusSubgroup_le_torusWeightCharacterSubgroup
      (τ := τ) (K := K) i j hj
  obtain ⟨t, ht, hchar⟩ := hle hgj
  obtain ⟨s, rfl⟩ := exists_torusElt_eq_of_mem_simpleRootTorusSubgroup
    (τ := τ) (K := K) i hgi
  have hm (m : Fin τ.rank) :
      s ^ τ.cartan i m = ∏ j, t j ^ τ.cartan j m := by
    let b : Label τ := .inr ⟨Pi.single m 1, isRoot_single τ m⟩
    have h1 := torusElt_single_eq (τ := τ) (R := K) i s b
    have h2 := hchar b
    have hsum (j : Fin τ.rank) :
        ∑ l, τ.cartan j l * b.latticeWeight l = τ.cartan j m := by
      simp [b, Label.latticeWeight, Pi.single_apply]
    rw [hsum] at h1
    simp only [torusWeightCharacter, hsum] at h2
    have hcoord := congrArg (fun z : RootModule τ K => z b) (h1.symm.trans h2)
    apply Units.ext
    simpa [b, Finsupp.smul_apply, Finsupp.single_eq_same, smul_eq_mul] using hcoord
  let u : Fin τ.rank → Kˣ := Function.update t i s⁻¹
  have hu : ∀ m, ∏ j, u j ^ τ.cartan j m = 1 := by
    intro m
    have heq : ∏ j, u j ^ τ.cartan j m =
        (s⁻¹) ^ τ.cartan i m * ∏ j, t j ^ τ.cartan j m := by
      rw [← Finset.mul_prod_erase Finset.univ (fun j => u j ^ τ.cartan j m)
          (Finset.mem_univ i),
        ← Finset.mul_prod_erase Finset.univ (fun j => t j ^ τ.cartan j m)
          (Finset.mem_univ i)]
      simp only [u, Function.update_self, ht, one_zpow, one_mul]
      congr 1
      refine Finset.prod_congr rfl fun j hj => ?_
      rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
    rw [heq, ← hm, inv_zpow, inv_mul_cancel]
  have hsInv : s⁻¹ = 1 := by
    simpa [u] using eq_one_of_prod_zpow_matrix τ.cartan B hB hu i
  have hs : s = 1 := inv_eq_one.mp hsInv
  exact Subgroup.mem_bot.mpr (by rw [hs, torusElt_one])

/-- Independence of the four F₄ simple-root tori, using the checked integral
right inverse of its Cartan matrix. -/
theorem simpleRootTorusSubgroup_iSupIndep_F4 {K : Type*} [Field K] :
    iSupIndep (fun i : Fin (Tag.rank .F4) =>
      simpleRootTorusSubgroup (τ := .F4) (K := K) i) :=
  simpleRootTorusSubgroup_iSupIndep_of_cartanRightInverse (τ := .F4) (K := K)
    cartan_mul_cartanInvF4

/-- Independence of the eight E₈ simple-root tori, using the checked integral
right inverse of its Cartan matrix. -/
theorem simpleRootTorusSubgroup_iSupIndep_E8 {K : Type*} [Field K] :
    iSupIndep (fun i : Fin (Tag.rank .E8) =>
      simpleRootTorusSubgroup (τ := .E8) (K := K) i) :=
  simpleRootTorusSubgroup_iSupIndep_of_cartanRightInverse (τ := .E8) (K := K)
    cartan_mul_cartanInvE8

/-- Each simple-root torus operator normalizes every pinned root subgroup;
the action is the parameter rescaling proved by `root_torus_conjugation`. -/
theorem torusElt_mem_normalizer_rootSubgroup (i : Fin τ.rank)
    {α : Fin τ.rank → ℤ} (hα : IsRoot τ α) (t : Kˣ) :
    torusElt τ K i t ∈
      Subgroup.normalizer (rootSubgroup τ K α : Set (Module.End K (RootModule τ K))ˣ) := by
  rw [Subgroup.mem_set_normalizer_iff]
  intro x
  constructor
  · intro hx
    obtain ⟨c, hc⟩ := mem_rootSubgroup.mp hx
    rw [← hc, root_torus_conjugation i hα t c]
    exact Subgroup.subset_closure ⟨_, rfl⟩
  · intro hx
    obtain ⟨c, hc⟩ := mem_rootSubgroup.mp hx
    have htrailing : torusElt τ K i t = (torusElt τ K i t⁻¹)⁻¹ := by
      rw [← torusElt_inv (τ := τ) (K := K) i t⁻¹]
      simp
    have hscaled : torusElt τ K i t⁻¹ *
        (torusElt τ K i t * x * (torusElt τ K i t)⁻¹) *
          (torusElt τ K i t⁻¹)⁻¹ ∈ rootSubgroup τ K α := by
      rw [← hc, root_torus_conjugation i hα t⁻¹ c]
      exact Subgroup.subset_closure ⟨_, rfl⟩
    have hleft : torusElt τ K i t⁻¹ = (torusElt τ K i t)⁻¹ :=
      torusElt_inv (τ := τ) (K := K) i t
    rw [hleft, htrailing] at hscaled
    simpa [mul_assoc] using hscaled

theorem simpleRootTorusSubgroup_le_normalizer_rootSubgroup (i : Fin τ.rank)
    {α : Fin τ.rank → ℤ} (hα : IsRoot τ α) :
    simpleRootTorusSubgroup (τ := τ) (K := K) i ≤
      Subgroup.normalizer (rootSubgroup τ K α : Set (Module.End K (RootModule τ K))ˣ) := by
  apply (Subgroup.closure_le _).2
  rintro _ ⟨t, rfl⟩
  exact torusElt_mem_normalizer_rootSubgroup i hα t

theorem simpleRootTorusSubgroup_conj_mem_rootSubgroup (i : Fin τ.rank)
    {α : Fin τ.rank → ℤ} (hα : IsRoot τ α)
    {h : (Module.End K (RootModule τ K))ˣ}
    (hh : h ∈ simpleRootTorusSubgroup (τ := τ) (K := K) i)
    {x : (Module.End K (RootModule τ K))ˣ} (hx : x ∈ rootSubgroup τ K α) :
    h * x * h⁻¹ ∈ rootSubgroup τ K α := by
  have hnorm := simpleRootTorusSubgroup_le_normalizer_rootSubgroup (τ := τ) (K := K) i hα hh
  exact (Subgroup.mem_set_normalizer_iff.mp hnorm x).mp hx

theorem nontrivial_operatorRankOneSubgroup (i : Fin τ.rank) :
    Nontrivial (operatorRankOneSubgroup (τ := τ) (K := K) i) := by
  refine ⟨⟨⟨xUnit τ K i 1,
    xUnit_mem_operatorRankOneSubgroup (τ := τ) (K := K) i 1⟩, 1, ?_⟩⟩
  intro h
  have h' : pinnedX τ K (Pi.single i 1) 1 = pinnedX τ K (Pi.single i 1) 0 := by
    simpa [pinnedX_single, pinnedX_zero] using h
  exact one_ne_zero (pinnedX_injective τ K (Pi.single i 1) h')

