import InfoGeometry.Core.PeirceGrading
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Tactic.NoncommRing

/-!
# Peirce quantum-geometric tensor in an associative operator algebra

For an idempotent, the commutator directions are odd and products of two such
directions are even. Their associative product splits into its Lie and Jordan
parts without imposing commutativity on the operator algebra.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceQuantumGeometricTensor

open InfoGeometry.Core.PeirceGrading
open InfoGeometry.Core.PeirceDecomposition

variable {A : Type*} [Ring A]

/-- Associative Lie bracket on the full operator algebra. -/
def operatorComm (x y : A) : A := x * y - y * x

/-- Associative Jordan product on the full operator algebra. -/
def operatorJordan (x y : A) : A := x * y + y * x

/-- The Grassmannian tangent direction generated by an operator and an
idempotent. -/
def peirceTangent (p a : A) : A := p * a - a * p

/-- The associative product decomposes into its Lie and Jordan parts. -/
theorem lie_jordan_product_split (x y : A) :
    (2 : ℕ) • (x * y) = operatorComm x y + operatorJordan x y := by
  simp only [operatorComm, operatorJordan, two_nsmul]
  abel

/-- Every inner commutator direction of an idempotent lies in the odd
Peirce submodule. -/
theorem peirceTangent_mem_odd {p : A} (hp : IsIdempotentElem p) (a : A) :
    peirceTangent p a ∈ LinearMap.range (odd p) := by
  rw [mem_odd_iff hp]
  simp only [peirceTangent]
  noncomm_ring [hp.eq, idempotent_mul_nested p hp.eq]

/-- Products of two idempotent tangent directions lie in the even Peirce
submodule. -/
theorem tangent_product_mem_even {p : A} (hp : IsIdempotentElem p) (a b : A) :
    peirceTangent p a * peirceTangent p b ∈ LinearMap.range (even p) := by
  exact odd_mul_odd hp (peirceTangent_mem_odd hp a) (peirceTangent_mem_odd hp b)

/-- The tangent product commutes with its defining idempotent. -/
theorem tangent_product_commutes {p : A} (hp : IsIdempotentElem p) (a b : A) :
    p * (peirceTangent p a * peirceTangent p b) =
      (peirceTangent p a * peirceTangent p b) * p := by
  exact (mem_even_iff hp).mp (tangent_product_mem_even hp a b)

/-- Both the Berry commutator and the symmetric metric product of tangent
directions are even. -/
theorem tangent_lie_jordan_products_mem_even {p : A} (hp : IsIdempotentElem p)
    (a b : A) :
    operatorComm (peirceTangent p a) (peirceTangent p b) ∈ LinearMap.range (even p) ∧
    operatorJordan (peirceTangent p a) (peirceTangent p b) ∈ LinearMap.range (even p) := by
  have hab := tangent_product_mem_even hp a b
  have hba := tangent_product_mem_even hp b a
  exact ⟨Submodule.sub_mem _ hab hba, Submodule.add_mem _ hab hba⟩

/-- The tangent-product curvature statement in commutator form. -/
theorem tangent_product_curvature_zero {p : A} (hp : IsIdempotentElem p)
    (a b : A) :
    operatorComm p (peirceTangent p a * peirceTangent p b) = 0 := by
  change p * (peirceTangent p a * peirceTangent p b) -
    (peirceTangent p a * peirceTangent p b) * p = 0
  rw [tangent_product_commutes hp a b, sub_self]

/-- A cyclic additive functional splits the value of an even operator across
the two diagonal Peirce compressions. The algebra itself remains fully
noncommutative; only the functional is assumed cyclic. -/
theorem cyclicFunctional_peirce_diagonal_split {S : Type*} [AddCommGroup S]
    (τ : A →+ S) (p f : A) (hp : p * p = p) (hpf : p * f = f * p) :
    τ (p * f * p) + τ ((1 - p) * f * (1 - p)) = τ f := by
  have hpq : p * (1 - p) = 0 := by simp [mul_sub, hp]
  have hqp : (1 - p) * p = 0 := by simp [sub_mul, hp]
  have hcross₁ : p * f * (1 - p) = 0 := by
    calc
      _ = (f * p) * (1 - p) := by rw [hpf]
      _ = f * (p * (1 - p)) := by rw [mul_assoc]
      _ = 0 := by rw [hpq, mul_zero]
  have hcross₂ : (1 - p) * f * p = 0 := by
    calc
      _ = (1 - p) * (f * p) := by rw [mul_assoc]
      _ = (1 - p) * (p * f) := by rw [← hpf]
      _ = ((1 - p) * p) * f := by rw [mul_assoc]
      _ = 0 := by rw [hqp, zero_mul]
  have hsum : p * f * p + (1 - p) * f * (1 - p) = f := by
    calc
      _ = (p + (1 - p)) * f * (p + (1 - p)) := by
        symm
        calc
          _ = p * f * p + p * f * (1 - p) + (1 - p) * f * p +
              (1 - p) * f * (1 - p) := by noncomm_ring
          _ = _ := by rw [hcross₁, hcross₂]; abel
      _ = f := by simp
  have hτ := congrArg τ hsum
  rw [map_add] at hτ
  exact hτ

/-- Berry curvature has zero total core-plus-complement flux under any cyclic
additive functional on an associative ring. -/
theorem cyclicFunctional_tangent_curvature_core_complement_cancel
    {S : Type*} [AddCommGroup S] (τ : A →+ S)
    (hcyclic : ∀ x y : A, τ (x * y) = τ (y * x))
    {p : A} (hp : IsIdempotentElem p) (a b : A) :
    τ (p * operatorComm (peirceTangent p a) (peirceTangent p b) * p) +
      τ ((1 - p) * operatorComm (peirceTangent p a) (peirceTangent p b) *
        (1 - p)) = 0 := by
  let f := operatorComm (peirceTangent p a) (peirceTangent p b)
  have hpf : p * f = f * p := by
    exact (mem_even_iff hp).mp
      (tangent_lie_jordan_products_mem_even hp a b).1
  have hsplit := cyclicFunctional_peirce_diagonal_split τ p f hp.eq hpf
  have hzero : τ f = 0 := by
    dsimp [f, operatorComm]
    rw [map_sub, hcyclic]
    simp
  change τ (p * f * p) + τ ((1 - p) * f * (1 - p)) = 0
  rw [hsplit, hzero]

/-- Matrix Berry-curvature flux in the two Peirce diagonal compressions cancels.
This is a finite algebraic trace identity and makes no continuum mass-gap claim. -/
theorem tangent_curvature_core_complement_trace_cancel {n : Type*}
    [Fintype n] [DecidableEq n] {R : Type*} [CommRing R]
    {p : Matrix n n R} (hp : p * p = p) (a b : Matrix n n R) :
    Matrix.trace (p * operatorComm (peirceTangent p a) (peirceTangent p b) * p) +
      Matrix.trace ((1 - p) * operatorComm (peirceTangent p a) (peirceTangent p b) *
        (1 - p)) = 0 := by
  simpa [Matrix.traceAddMonoidHom] using
    (cyclicFunctional_tangent_curvature_core_complement_cancel
      (τ := Matrix.traceAddMonoidHom n R)
      (hcyclic := fun x y => Matrix.trace_mul_comm x y) hp a b)

end InfoGeometry.OperatorAlgebra.PeirceQuantumGeometricTensor
