import Mathlib.Analysis.InnerProductSpace.Basic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Analysis.InnerProductSpace.Adjoint
import InfoGeometry.Canonical.CantorBernoulliL2OperatorTransport
import InfoGeometry.Physics.CStarCuntzTensorQuotient

/-!
# Canonical Bernoulli C*-Realization

This file provides the genuine, fully-specified Mathlib context for the C*-realization 
of the Bernoulli shift operators on the Cantor space $L^2$.

Rather than hiding the range-completeness issue behind an unspecified package,
this establishes the exact Mathlib target: a `CStarCuntzFamily` valued in the
C*-algebra of bounded continuous linear operators
$\mathcal{B}(L^2(\mathcal{C}, \mu)) \cong (E \to L[\mathbb{C}] E)$.

## Blueprint

1. Take the Hilbert shift operators `cantorL2Left` and `cantorL2Right` from 
   `CantorBernoulliL2OperatorTransport.lean`.
2. Package them as `ContinuousLinearMap` endomorphisms on `L2Boundary`.
3. Prove the exact `CStarCuntzFamily` relations using the Hilbert adjoint operation.
-/

noncomputable section

namespace InfoGeometry.OperatorAlgebra.CantorBernoulliCuntzCStarRealization

open MeasureTheory
open ContinuousLinearMap
open InfoGeometry.Canonical.CantorBernoulliL2OperatorTransport
open InfoGeometry.Physics.CStarCuntzTensorQuotient

/-!
### 1. Concrete Hilbert Space Context

We explicitly instantiate the operator algebra on the $L^2$ boundary.
-/

abbrev BoundedL2Operator := L2Boundary →L[ℂ] L2Boundary

/-!
### 2. Operator Definitions

The normalized branch maps are now the concrete `BoundedL2Operator`s supplied
by the L² transport owner.
-/

/-- The left continuous linear operator $V_L$. -/
def vLeft : BoundedL2Operator :=
  normalizedPrependBitLpContinuousLinearMap false

/-- The right continuous linear operator $V_R$. -/
def vRight : BoundedL2Operator :=
  normalizedPrependBitLpContinuousLinearMap true

theorem vLeft_isometry : Isometry vLeft := by
  exact normalizedPrependBitLpContinuousLinearMap_isometry

theorem vRight_isometry : Isometry vRight := by
  exact normalizedPrependBitLpContinuousLinearMap_isometry

theorem vLeft_adjoint_comp_vLeft :
    (normalizedPrependBitLpAdjoint false).comp vLeft =
      ContinuousLinearMap.id ℂ L2Boundary := by
  exact normalizedPrependBitLpAdjoint_comp_self false

theorem vRight_adjoint_comp_vRight :
    (normalizedPrependBitLpAdjoint true).comp vRight =
      ContinuousLinearMap.id ℂ L2Boundary := by
  exact normalizedPrependBitLpAdjoint_comp_self true

theorem vLeft_adjoint_comp_vRight :
    (normalizedPrependBitLpAdjoint false).comp vRight = 0 := by
  exact normalizedPrependBitLpAdjoint_comp_cross_eq_zero (by decide)

theorem vRight_adjoint_comp_vLeft :
    (normalizedPrependBitLpAdjoint true).comp vLeft = 0 := by
  exact normalizedPrependBitLpAdjoint_comp_cross_eq_zero (by decide)

/-!
### 3. Concrete C*-Realization

The genuine target is to populate the structure `CStarCuntzFamily` over `Bool`.
This requires exactly:
- `S : Bool → BoundedL2Operator`
- `ortho : ∀ i j, star (S i) * S j = if i = j then 1 else 0`
- `partition : (∑ i : Bool, S i * star (S i)) = 1`

The operators below are the normalized branch isometries, and the range
partition is supplied by the kernel-checked L² transport owner. Thus this is
an actual Cuntz-family inhabitant, not a schema parametrized by a missing
range-completeness hypothesis.
-/

/-- The concrete Cuntz family generated by the two normalized Cantor branch
isometries on `L²(Boundary, μC)`. -/
def cantorL2CuntzFamily : CStarCuntzFamily BoundedL2Operator Bool where
  S := fun b => match b with
    | false => vLeft
    | true  => vRight
  ortho := by
    intro i j
    cases i <;> cases j
    · change (normalizedPrependBitLpAdjoint false).comp vLeft =
        ContinuousLinearMap.id ℂ L2Boundary
      exact vLeft_adjoint_comp_vLeft
    · change (normalizedPrependBitLpAdjoint false).comp vRight = 0
      exact vLeft_adjoint_comp_vRight
    · change (normalizedPrependBitLpAdjoint true).comp vLeft = 0
      exact vRight_adjoint_comp_vLeft
    · change (normalizedPrependBitLpAdjoint true).comp vRight =
        ContinuousLinearMap.id ℂ L2Boundary
      exact vRight_adjoint_comp_vRight
  partition := by
    rw [Fintype.sum_bool]
    change vRight.comp (normalizedPrependBitLpAdjoint true) +
        vLeft.comp (normalizedPrependBitLpAdjoint false) =
      ContinuousLinearMap.id ℂ L2Boundary
    rw [add_comm]
    exact normalizedPrependBitLp_partition

@[simp] theorem cantorL2CuntzFamily_apply_false :
    cantorL2CuntzFamily.S false = vLeft := by
  rfl

@[simp] theorem cantorL2CuntzFamily_apply_true :
    cantorL2CuntzFamily.S true = vRight := by
  rfl

/-!
### 4. Concrete algebraic and generated C⋆ readouts

The generic `CStarCuntzFamily` interface already supplies the universal
algebra homomorphisms.  These definitions specialize those maps to the
Bernoulli boundary carrier; they do not assert an identification with the
universal Cuntz C⋆-algebra.
-/

/-- The canonical representation of the algebraic binary Cuntz quotient on
the Bernoulli boundary Hilbert space. -/
def canonicalCantorL2CuntzRepresentation :
    InfoGeometry.Topology.AlgebraicCuntzQuotient.CuntzAlg ℂ Bool →ₐ[ℂ]
      BoundedL2Operator :=
  cantorL2CuntzFamily.lift

@[simp] theorem canonicalCantorL2CuntzRepresentation_S (b : Bool) :
    canonicalCantorL2CuntzRepresentation
        (InfoGeometry.Topology.AlgebraicCuntzQuotient.S (R := ℂ) b) =
      cantorL2CuntzFamily.S b := by
  exact CStarCuntzFamily.lift_S cantorL2CuntzFamily b

@[simp] theorem canonicalCantorL2CuntzRepresentation_T (b : Bool) :
    canonicalCantorL2CuntzRepresentation
        (InfoGeometry.Topology.AlgebraicCuntzQuotient.T (R := ℂ) b) =
      star (cantorL2CuntzFamily.S b) := by
  exact CStarCuntzFamily.lift_T cantorL2CuntzFamily b

/-- Concrete Bernoulli-boundary readout of the defining algebraic Cuntz
relations.  This is an instantiation of the generic relation theorem and
does not identify the representation with the universal `𝓞₂`. -/
theorem canonicalCantorL2CuntzRepresentation_cuntz_relations :
    (∀ i j,
      canonicalCantorL2CuntzRepresentation
          (InfoGeometry.Topology.AlgebraicCuntzQuotient.T (R := ℂ) i *
            InfoGeometry.Topology.AlgebraicCuntzQuotient.S (R := ℂ) j) =
        if i = j then 1 else 0) ∧
      canonicalCantorL2CuntzRepresentation
          (∑ i : Bool,
            InfoGeometry.Topology.AlgebraicCuntzQuotient.S (R := ℂ) i *
              InfoGeometry.Topology.AlgebraicCuntzQuotient.T (R := ℂ) i) =
        1 := by
  simpa [canonicalCantorL2CuntzRepresentation] using
    (CStarCuntzFamily.represented_cuntz_relations cantorL2CuntzFamily)

/-- The same representation with codomain restricted to the generated
concrete C⋆ subalgebra of bounded boundary operators. -/
def canonicalCantorL2GeneratedRepresentation :
    InfoGeometry.Topology.AlgebraicCuntzQuotient.CuntzAlg ℂ Bool →ₐ[ℂ]
      cantorL2CuntzFamily.generatedCStarSubalgebra :=
  cantorL2CuntzFamily.liftToGenerated

@[simp] theorem canonicalCantorL2GeneratedRepresentation_S (b : Bool) :
    canonicalCantorL2GeneratedRepresentation
        (InfoGeometry.Topology.AlgebraicCuntzQuotient.S (R := ℂ) b) =
      ⟨cantorL2CuntzFamily.S b,
        cantorL2CuntzFamily.S_mem_generatedCStarSubalgebra b⟩ := by
  exact CStarCuntzFamily.liftToGenerated_S cantorL2CuntzFamily b

@[simp] theorem canonicalCantorL2GeneratedRepresentation_T (b : Bool) :
    canonicalCantorL2GeneratedRepresentation
        (InfoGeometry.Topology.AlgebraicCuntzQuotient.T (R := ℂ) b) =
      star ⟨cantorL2CuntzFamily.S b,
        cantorL2CuntzFamily.S_mem_generatedCStarSubalgebra b⟩ := by
  exact CStarCuntzFamily.liftToGenerated_T cantorL2CuntzFamily b

end InfoGeometry.OperatorAlgebra.CantorBernoulliCuntzCStarRealization
