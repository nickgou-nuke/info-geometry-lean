-- dmodule_dlnQ.m2
needsPackage "Dmodules"

-- Consider a polynomial Q. We study the D-module generated by 1/Q, 
-- which relates to d(log Q) = dQ / Q in de Rham cohomology.

R = QQ[x, y];
W = WeylAlgebra R;

-- Let Q = x^2 + y^2
Q = x^2 + y^2;

-- The D-module for 1/Q
-- Annihilator of 1/Q in the Weyl algebra
I = annFs(Q, -1);

-- D-module presentation M = W^1 / I
print("Generators of the annihilator ideal of 1/Q (related to d ln Q):");
print I;

-- Bregman divergence and Bregman kernel
-- Bregman kernel is related to the Hessian of a strictly convex function phi
phi = x^3 + y^3; 

-- Hessian matrix (Bregman kernel)
H = matrix{{diff(x, diff(x, phi)), diff(y, diff(x, phi))},
           {diff(x, diff(y, phi)), diff(y, diff(y, phi))}};
           
print("Hessian of phi (Bregman kernel):");
print H;
