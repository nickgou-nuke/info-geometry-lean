import Mathlib.Tactic.Abel

/-!
# Irreducible finite Peirce kernel

The polynomial identities generated by one idempotent and its two off-diagonal
corners. This is an abstract ring theorem; it does not identify repository
records or measured graph operators with these terms.
-/

namespace InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel

variable {B : Type*} [Ring B]

def comm (X Y : B) : B := X * Y - Y * X
def anticomm (X Y : B) : B := X * Y + Y * X
def defect (X : B) : B := X * X - X
def defectBar (X : B) : B := X * X + X
def u (P A : B) : B := P * A * (1 - P)
def v (P C : B) : B := (1 - P) * C * P

/-- The quadratic defect polarizes to the Jordan anticommutator, with no
commutativity assumption on the ring. -/
theorem defect_polarization (X Y : B) :
    defect (X + Y) - defect X - defect Y = anticomm X Y := by
  simp only [defect, anticomm, add_mul, mul_add]
  abel

/-- The signed defects multiply to the defect of the square. -/
theorem defectBar_mul_defect_eq_defect_square (X : B) :
    defectBar X * defect X = defect (X * X) := by
  calc
    defectBar X * defect X =
        (X * X) * (X * X) - (X * X) * X + X * (X * X) - X * X := by
          simp only [defect, defectBar, add_mul, mul_sub]
          abel
    _ = (X * X) * (X * X) - X * X := by
          rw [mul_assoc X X X]
          abel
    _ = defect (X * X) := rfl

lemma P_assoc {P : B} (hP : P * P = P) (X : B) :
    P * (P * X) = P * X := by
  rw [← mul_assoc, hP]

macro "peirce_abel" hP:ident : tactic =>
  `(tactic| (
    simp only [defect, anticomm, comm, u, v,
      add_mul, mul_add, sub_mul, mul_sub, one_mul, mul_one,
      mul_zero, zero_mul, mul_assoc, $hP:ident, P_assoc $hP:ident]
    abel))

/-- Polynomial closure identities for the two off-diagonal corners of an
idempotent. The last equation is a left-absorption law for two lower-corner
inputs. -/
theorem irreducible_peirce_identities {P : B} (hP : P * P = P)
    (A C X D : B) :
    let up := u P A
    let down := v P C
    let metric := up * down + down * up
    let spin := up * down - down * up
    let transfer := P + up + down
    let stone := P - spin
    let bridge := (1 + up) * (1 - down)
    let bridgeInv := (1 + down) * (1 - up)
    P * X * P + P * X * (1 - P) + (1 - P) * X * P + (1 - P) * X * (1 - P) = X ∧
    comm P (comm P X) = P * X * (1 - P) + (1 - P) * X * P ∧
    up * up = 0 ∧ down * down = 0 ∧
    bridge * bridgeInv = 1 ∧ bridgeInv * bridge = 1 ∧
    (up * down) * (down * up) = 0 ∧ (down * up) * (up * down) = 0 ∧
    spin * spin = metric * metric ∧
    defect transfer = metric ∧ defect stone = defect metric ∧
    bridge * P * bridgeInv = stone - (up + down) + up * (down * up) ∧
    (P + v P D) * (P + v P C) = P + v P D := by
  refine ⟨by peirce_abel hP, by peirce_abel hP, by peirce_abel hP,
    by peirce_abel hP, by peirce_abel hP, by peirce_abel hP,
    by peirce_abel hP, by peirce_abel hP, by peirce_abel hP,
    by peirce_abel hP, by peirce_abel hP, by peirce_abel hP,
    by peirce_abel hP⟩

/-- The double commutator with an idempotent is an idempotent linear
operator: its fourth iterate equals its second iterate. -/
theorem double_commutator_idempotent {P : B} (hP : P * P = P) (X : B) :
    comm P (comm P (comm P (comm P X))) = comm P (comm P X) := by
  peirce_abel hP

/-- The inner derivation generated by an idempotent satisfies the polynomial
identity `ad_P^3 = ad_P`. Thus its odd iterates stabilize after the first
iterate, while `ad_P^2` is the Peirce off-diagonal projection. -/
theorem triple_commutator_eq_commutator {P : B} (hP : P * P = P) (X : B) :
    comm P (comm P (comm P X)) = comm P X := by
  peirce_abel hP

end InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel
