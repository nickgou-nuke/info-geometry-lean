{"type":"new","contents":"import InfoGeometry.Meta.Architecture\nimport InfoGeometry.Canonical.TopologicalGapShadow\nimport Mathlib\n\n/-!\n# InfoGeometry.Canonical.SuperchargeHoppingBridge\n\nNaming bridge from the odd-odd anticommutator lane to the discrete hopping\noperator already owned by `TopologicalGapShadow`.\n\nThis file does not introduce new physics. It only records that the discrete\nSUSY hopping operator is exactly the repo-native odd-odd closure `{Q,Q}`.\n-/\n\nset_option linter.unusedSectionVars false\n\nnamespace InfoGeometry.Canonical.SuperchargeHoppingBridge\n\nopen InfoGeometry.Canonical.TopologicalGapShadow\n\nsection Core\n\nvariable {E : Type _} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"EndH\" => E →L[ℝ] E\n\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : CompleteSpace EndH := inferInstance\n\n/-- The odd-odd anticommutator lane. -/\n@[rep_depth krein]\nnoncomputable def oddOddBracket (Qi Qj : EndH) : EndH :=\n  Qi * Qj + Qj * Qi\n\n/-- The discrete hopping operator is the odd-odd self-closure `{Q,Q}`. -/\n@[rep_depth krein]\ntheorem susyHoppingOperator_eq_oddOddBracket_self\n    (Q : EndH) :\n    susyHoppingOperator Q = oddOddBracket Q Q := by\n  simp [InfoGeometry.Canonical.TopologicalGapShadow.susyHoppingOperator, oddOddBracket]\n\n/-- Naming alias for the hopping translation candidate generated by a supercharge. -/\n@[rep_depth krein]\nnoncomputable def hoppingTranslationCandidate (Q : EndH) : EndH :=\n  oddOddBracket Q Q\n\n/-- The naming alias agrees with the already-owned SUSY hopping operator. -/\n@[rep_depth krein]\ntheorem hoppingTranslationCandidate_eq_susyHoppingOperator\n    (Q : EndH) :\n    hoppingTranslationCandidate Q = susyHoppingOperator Q := by\n  rw [hoppingTranslationCandidate, susyHoppingOperator_eq_oddOddBracket_self]\n\nend Core\n\nend InfoGeometry.Canonical.SuperchargeHoppingBridge\n","mtime":1777928003339}