import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Canonical.HestenesCircularSheetCAR

/-!
# Quartic sheet phase and hyperbolic sheet action

This owner keeps the two constructions distinct: the quartic phase is an
associative complex matrix, while the boost is a real one-parameter matrix
action generated by the involution `sheetParity`.
-/

open scoped Matrix
noncomputable section

namespace InfoGeometry.Canonical.HestenesOmegaHyperbolic

open InfoGeometry.Canonical.ChiralStokesPauliBasis

abbrev SheetMatrix := ChiralStokesPauliBasis.SheetMatrix

def omegaSheet : SheetMatrix := uPlus + Complex.I • uMinus

theorem omegaSheet_sq : omegaSheet ^ 2 = sheetParity := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [omegaSheet, uPlus, uMinus, sheetParity, sheetIdentity,
      Matrix.mul_apply, Fin.sum_univ_two, pow_two]
  all_goals norm_num [Complex.I_sq]

theorem omegaSheet_fourth : omegaSheet ^ 4 = (1 : SheetMatrix) := by
  rw [show (4 : ℕ) = 2 * 2 by norm_num, pow_mul, omegaSheet_sq]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [pow_two, sheetParity, Matrix.mul_apply,
      Fin.sum_univ_two]

def omegaSheetInverse : SheetMatrix := uPlus - Complex.I • uMinus

theorem omegaSheet_left_inverse :
    omegaSheetInverse * omegaSheet = sheetIdentity := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [omegaSheetInverse, omegaSheet, uPlus, uMinus, sheetParity,
      sheetIdentity, Matrix.mul_apply, Fin.sum_univ_two] <;>
    norm_num

theorem omegaSheet_right_inverse :
    omegaSheet * omegaSheetInverse = sheetIdentity := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [omegaSheetInverse, omegaSheet, uPlus, uMinus, sheetParity,
      sheetIdentity, Matrix.mul_apply, Fin.sum_univ_two] <;>
    norm_num

theorem omegaSheet_conjugates_cPlus :
    omegaSheet * cPlus * omegaSheetInverse =
      (-Complex.I) • cPlus := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [omegaSheet, omegaSheetInverse, cPlus, uPlus, uMinus,
      sheetIdentity, sheetParity, sheetFlip, sheetPhase,
      Matrix.mul_apply, Fin.sum_univ_two, Complex.I_sq] <;>
    norm_num

theorem omegaSheet_conjugates_cMinus :
    omegaSheet * cMinus * omegaSheetInverse =
      Complex.I • cMinus := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [omegaSheet, omegaSheetInverse, cMinus, uPlus, uMinus,
      sheetIdentity, sheetParity, sheetFlip, sheetPhase,
      Matrix.mul_apply, Fin.sum_univ_two, Complex.I_sq] <;>
    norm_num

def sheetDiagonal (a b : ℂ) : SheetMatrix := a • uPlus + b • uMinus

theorem sheetDiagonal_mul (a b c d : ℂ) :
    sheetDiagonal a b * sheetDiagonal c d =
      sheetDiagonal (a * c) (b * d) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sheetDiagonal, uPlus, uMinus, sheetIdentity, sheetParity,
      Matrix.mul_apply, Fin.sum_univ_two] <;>
    ring

theorem sheetDiagonal_one :
    sheetDiagonal 1 1 = sheetIdentity := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sheetDiagonal, uPlus, uMinus, sheetIdentity, sheetParity] <;>
    norm_num

theorem sheetDiagonal_inverse (a b : ℂ) (ha : a ≠ 0) (hb : b ≠ 0) :
    sheetDiagonal a⁻¹ b⁻¹ * sheetDiagonal a b = sheetIdentity := by
  rw [sheetDiagonal_mul, inv_mul_cancel₀ ha, inv_mul_cancel₀ hb,
    sheetDiagonal_one]

theorem sheetDiagonal_conjugates_cPlus (a b : ℂ) (ha : a ≠ 0) (hb : b ≠ 0) :
    sheetDiagonal a b * cPlus * sheetDiagonal a⁻¹ b⁻¹ =
      (a * b⁻¹) • cPlus := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sheetDiagonal, cPlus, uPlus, uMinus, sheetIdentity,
      sheetParity, sheetFlip, sheetPhase, Matrix.mul_apply,
      Fin.sum_univ_two] <;>
    field_simp [ha, hb] <;> ring

theorem sheetDiagonal_conjugates_cMinus (a b : ℂ) (ha : a ≠ 0) (hb : b ≠ 0) :
    sheetDiagonal a b * cMinus * sheetDiagonal a⁻¹ b⁻¹ =
      (b * a⁻¹) • cMinus := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sheetDiagonal, cMinus, uPlus, uMinus, sheetIdentity,
      sheetParity, sheetFlip, sheetPhase, Matrix.mul_apply,
      Fin.sum_univ_two] <;>
    field_simp [ha, hb] <;> ring

end InfoGeometry.Canonical.HestenesOmegaHyperbolic
