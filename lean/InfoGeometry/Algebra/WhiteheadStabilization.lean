import InfoGeometry.Algebra.ElementaryMatrixOperators
import Mathlib.Data.Matrix.ColumnRowPartitioned

/-!
# Constructive Whitehead stabilization over arbitrary rings

The balanced block `diag(U, U⁻¹)` of a native matrix unit is explicitly the
product of four block shears. Each shear is in the subgroup generated by
scalar-entry elementary matrices, by `ElementaryMatrixOperators`.

Consequently, any rectangular change `U * M * V` becomes an elementary left
change after adjoining an identity block. The right multiplier remains an
arbitrary unit. This is the algebraic stabilization in Proposition 1,
equations (121)–(124), of arXiv:2608.09913v2; it does not identify a matrix
word with a physical Clifford circuit.
-/

namespace InfoGeometry.Algebra.WhiteheadStabilization

open Matrix
open InfoGeometry.Algebra.ElementaryMatrixOperators

section BlockUnits

variable {m n A : Type*} [Fintype m] [DecidableEq m]
  [Fintype n] [DecidableEq n] [Ring A]

/-- Block sum of native matrix units, with the block sum of inverses. -/
def blockDiagonalUnit (U : (Matrix m m A)ˣ) (V : (Matrix n n A)ˣ) :
    (Matrix (m ⊕ n) (m ⊕ n) A)ˣ where
  val := Matrix.fromBlocks (U : Matrix m m A) 0 0 (V : Matrix n n A)
  inv := Matrix.fromBlocks (↑U⁻¹ : Matrix m m A) 0 0 (↑V⁻¹ : Matrix n n A)
  val_inv := by simp [Matrix.fromBlocks_multiply]
  inv_val := by simp [Matrix.fromBlocks_multiply]

@[simp]
theorem coe_blockDiagonalUnit (U : (Matrix m m A)ˣ) (V : (Matrix n n A)ˣ) :
    (blockDiagonalUnit U V : Matrix (m ⊕ n) (m ⊕ n) A) =
      Matrix.fromBlocks (U : Matrix m m A) 0 0 (V : Matrix n n A) := rfl

@[simp]
theorem blockDiagonalUnit_one :
    blockDiagonalUnit (1 : (Matrix m m A)ˣ) (1 : (Matrix n n A)ˣ) = 1 := by
  apply Units.ext
  exact Matrix.fromBlocks_one

/-- Block sum preserves ordered multiplication in both factors. -/
theorem blockDiagonalUnit_mul (U₁ U₂ : (Matrix m m A)ˣ)
    (V₁ V₂ : (Matrix n n A)ˣ) :
    blockDiagonalUnit (U₁ * U₂) (V₁ * V₂) =
      blockDiagonalUnit U₁ V₁ * blockDiagonalUnit U₂ V₂ := by
  apply Units.ext
  simp [Matrix.fromBlocks_multiply]

@[simp]
theorem blockDiagonalUnit_inv (U : (Matrix m m A)ˣ) (V : (Matrix n n A)ˣ) :
    (blockDiagonalUnit U V)⁻¹ = blockDiagonalUnit U⁻¹ V⁻¹ := Units.ext rfl

end BlockUnits

section Whitehead

variable {m A : Type*} [Fintype m] [DecidableEq m] [Ring A]

/-- The balanced block of a matrix unit and its inverse. -/
def balancedUnit (U : (Matrix m m A)ˣ) : (Matrix (m ⊕ m) (m ⊕ m) A)ˣ :=
  blockDiagonalUnit U U⁻¹

@[simp]
theorem coe_balancedUnit (U : (Matrix m m A)ˣ) :
    (balancedUnit U : Matrix (m ⊕ m) (m ⊕ m) A) =
      Matrix.fromBlocks (U : Matrix m m A) 0 0 (↑U⁻¹ : Matrix m m A) := rfl

/-- The ordered four-shear Whitehead factorization; no entry division is used. -/
theorem balancedUnit_factorization (U : (Matrix m m A)ˣ) :
    balancedUnit U =
      upperUnit ((U : Matrix m m A) - 1) * lowerUnit (1 : Matrix m m A) *
        upperUnit ((↑U⁻¹ : Matrix m m A) - 1) * lowerUnit (-(U : Matrix m m A)) := by
  apply Units.ext
  change Matrix.fromBlocks (U : Matrix m m A) 0 0 (↑U⁻¹ : Matrix m m A) =
    Matrix.fromBlocks 1 ((U : Matrix m m A) - 1) 0 1 *
      Matrix.fromBlocks 1 0 (1 : Matrix m m A) 1 *
      Matrix.fromBlocks 1 ((↑U⁻¹ : Matrix m m A) - 1) 0 1 *
      Matrix.fromBlocks 1 0 (-(U : Matrix m m A)) 1
  simp only [Matrix.fromBlocks_multiply]
  apply Matrix.fromBlocks_inj.mpr
  simp [mul_sub]

/-- The balanced block is generated by actual scalar-entry elementary matrices. -/
theorem balancedUnit_mem_elementarySubgroup (U : (Matrix m m A)ˣ) :
    balancedUnit U ∈ elementarySubgroup (m ⊕ m) A := by
  rw [balancedUnit_factorization]
  exact (elementarySubgroup (m ⊕ m) A).mul_mem
    ((elementarySubgroup (m ⊕ m) A).mul_mem
      ((elementarySubgroup (m ⊕ m) A).mul_mem
        (upperUnit_mem_elementarySubgroup _)
        (lowerUnit_mem_elementarySubgroup _))
      (upperUnit_mem_elementarySubgroup _))
    (lowerUnit_mem_elementarySubgroup _)

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Stabilizing once makes an arbitrary left basis change elementary. -/
theorem stabilization_identity (M : Matrix m n A)
    (U : (Matrix m m A)ˣ) (V : (Matrix n n A)ˣ) :
    (balancedUnit U : Matrix (m ⊕ m) (m ⊕ m) A) *
        Matrix.fromBlocks M 0 0 (1 : Matrix m m A) *
        (blockDiagonalUnit V U : Matrix (n ⊕ m) (n ⊕ m) A) =
      Matrix.fromBlocks ((U : Matrix m m A) * M * (V : Matrix n n A)) 0 0
        (1 : Matrix m m A) := by
  simp [Matrix.fromBlocks_multiply]

/-- Zero-row stabilization also absorbs an arbitrary left basis change.
This variant preserves the order of identity and zero padding blocks. -/
theorem zeroRow_stabilization_identity (M : Matrix m n A)
    (U : (Matrix m m A)ˣ) (V : (Matrix n n A)ˣ) :
    (balancedUnit U : Matrix (m ⊕ m) (m ⊕ m) A) *
        Matrix.fromRows M (0 : Matrix m n A) * (V : Matrix n n A) =
      Matrix.fromRows ((U : Matrix m m A) * M * (V : Matrix n n A))
        (0 : Matrix m n A) := by
  simp [Matrix.fromBlocks_mul_fromRows, Matrix.fromRows_mul]

/-- Explicit elementary and invertible witnesses for the stabilized change. -/
theorem exists_elementary_stabilization (M : Matrix m n A)
    (U : (Matrix m m A)ˣ) (V : (Matrix n n A)ˣ) :
    ∃ (E : (Matrix (m ⊕ m) (m ⊕ m) A)ˣ)
      (T : (Matrix (n ⊕ m) (n ⊕ m) A)ˣ),
      E ∈ elementarySubgroup (m ⊕ m) A ∧
      (E : Matrix (m ⊕ m) (m ⊕ m) A) *
          Matrix.fromBlocks M 0 0 (1 : Matrix m m A) *
          (T : Matrix (n ⊕ m) (n ⊕ m) A) =
        Matrix.fromBlocks ((U : Matrix m m A) * M * (V : Matrix n n A)) 0 0
          (1 : Matrix m m A) :=
  ⟨balancedUnit U, blockDiagonalUnit V U,
    balancedUnit_mem_elementarySubgroup U, stabilization_identity M U V⟩

end Whitehead

end InfoGeometry.Algebra.WhiteheadStabilization
