import Mathlib

namespace InfoGeometry.Algebra.Clifford

/-!
# Clifford Ideals as Algebraic Spinors

This module formalizes the algebraic construction of spinors as minimal left and right ideals
in a Clifford algebra generated by idempotents (the algebraic vacuum).

- Left Ideal: $I_L = \{ x \in Cl \mid x P = x \}$ (kets / spinor states).
- Right Ideal: $I_R = \{ y \in Cl \mid P y = y \}$ (bras / dual spinor states).
- Dirac pairing / Vacuum projection: $P (y x) P$ for $y \in I_R, x \in I_L$.
- Gauge action: Multiplicative action of the algebra preserves the left ideal.
- Chiral / Peirce splitting: When $P_+ + P_- = 1$ and $P_+ P_- = 0$, the space splits into chiral spinor sectors.
-/

variable {Cl : Type*} [Ring Cl]

/-- Left ideal generated by idempotent P (spinor states / kets) -/
def LeftIdeal (P : Cl) := { x : Cl // x * P = x }

/-- Right ideal generated by idempotent P (dual spinors / bras) -/
def RightIdeal (P : Cl) := { y : Cl // P * y = y }

namespace LeftIdeal

variable {P : Cl}

@[ext] theorem ext (x y : LeftIdeal P) (h : x.val = y.val) : x = y :=
  Subtype.ext h

/-- The left multiplicative action of Cl preserves the left ideal. -/
def mulLeft (g : Cl) (x : LeftIdeal P) : LeftIdeal P :=
  ⟨g * x.val, by
    calc (g * x.val) * P = g * (x.val * P) := by rw [mul_assoc]
      _ = g * x.val := by rw [x.property]⟩

@[simp] theorem mulLeft_val (g : Cl) (x : LeftIdeal P) :
    (mulLeft g x).val = g * x.val := rfl

theorem mulLeft_one (x : LeftIdeal P) :
    mulLeft (1 : Cl) x = x := by
  apply Subtype.ext
  simp

theorem mulLeft_mul (g h : Cl) (x : LeftIdeal P) :
    mulLeft (g * h) x = mulLeft g (mulLeft h x) := by
  apply Subtype.ext
  simp [mul_assoc]

end LeftIdeal

namespace RightIdeal

variable {P : Cl}

@[ext] theorem ext (x y : RightIdeal P) (h : x.val = y.val) : x = y :=
  Subtype.ext h

/-- The right multiplicative action of Cl preserves the right ideal. -/
def mulRight (y : RightIdeal P) (g : Cl) : RightIdeal P :=
  ⟨y.val * g, by
    calc P * (y.val * g) = (P * y.val) * g := by rw [mul_assoc]
      _ = y.val * g := by rw [y.property]⟩

@[simp] theorem mulRight_val (y : RightIdeal P) (g : Cl) :
    (mulRight y g).val = y.val * g := rfl

theorem mulRight_one (y : RightIdeal P) :
    mulRight y (1 : Cl) = y := by
  apply Subtype.ext
  simp

theorem mulRight_mul (g h : Cl) (y : RightIdeal P) :
    mulRight (mulRight y g) h = mulRight y (g * h) := by
  apply Subtype.ext
  simp [mul_assoc]

end RightIdeal

section Pairing

variable {P : Cl}

/-- Dirac pairing / vacuum projection of a bra and ket. -/
theorem dirac_pairing_eq (x : LeftIdeal P) (y : RightIdeal P) :
    P * (y.val * x.val) * P = y.val * x.val := by
  calc P * (y.val * x.val) * P
    _ = (P * y.val) * (x.val * P) := by simp only [mul_assoc]
    _ = y.val * x.val := by rw [y.property, x.property]

/-- When P is idempotent, P itself belongs to both LeftIdeal and RightIdeal. -/
def idempotentToLeft (hP : IsIdempotentElem P) : LeftIdeal P :=
  ⟨P, hP.eq⟩

def idempotentToRight (hP : IsIdempotentElem P) : RightIdeal P :=
  ⟨P, hP.eq⟩

def dyadicProduct (x : LeftIdeal P) (y : RightIdeal P) : Cl :=
  x.1 * y.1

@[simp] theorem dyadicProduct_left_action
    (g : Cl) (x : LeftIdeal P) (y : RightIdeal P) :
    dyadicProduct (LeftIdeal.mulLeft g x) y =
      g * dyadicProduct x y := by
  simp only [dyadicProduct, LeftIdeal.mulLeft_val, mul_assoc]

@[simp] theorem dyadicProduct_right_action
    (g : Cl) (x : LeftIdeal P) (y : RightIdeal P) :
    dyadicProduct x (RightIdeal.mulRight y g) =
  dyadicProduct x y * g := by
  simp only [dyadicProduct, RightIdeal.mulRight_val]
  exact (mul_assoc _ _ _).symm

theorem dyadic_gauge_commutator
    (g : Cl) (x : LeftIdeal P) (y : RightIdeal P) :
    g * dyadicProduct x y - dyadicProduct x y * g =
      dyadicProduct (LeftIdeal.mulLeft g x) y -
        dyadicProduct x (RightIdeal.mulRight y g) := by
  simp only [dyadicProduct, LeftIdeal.mulLeft_val, RightIdeal.mulRight_val]
  rw [mul_assoc, mul_assoc]

end Pairing

section ChiralDecomposition

/-- Orthogonal chiral projectors decompose every element into left ideal components. -/
theorem chiral_left_decomposition (P_plus P_minus : Cl) (h_sum : P_plus + P_minus = 1) (x : Cl) :
    x = (x * P_plus) + (x * P_minus) := by
  calc x = x * 1 := (mul_one x).symm
    _ = x * (P_plus + P_minus) := by rw [h_sum]
    _ = x * P_plus + x * P_minus := mul_add x P_plus P_minus

/-- Orthogonal chiral projectors decompose every element into right ideal components. -/
theorem chiral_right_decomposition (P_plus P_minus : Cl) (h_sum : P_plus + P_minus = 1) (y : Cl) :
    y = (P_plus * y) + (P_minus * y) := by
  calc y = 1 * y := (one_mul y).symm
    _ = (P_plus + P_minus) * y := by rw [h_sum]
    _ = P_plus * y + P_minus * y := add_mul P_plus P_minus y

/-- The four Peirce / Dirac quadrant decomposition of the algebra carrier. -/
theorem peirce_four_block_decomposition (P_plus P_minus : Cl) (h_sum : P_plus + P_minus = 1) (a : Cl) :
    a = (P_plus * a * P_plus) + (P_plus * a * P_minus) +
        (P_minus * a * P_plus) + (P_minus * a * P_minus) := by
  have h1 := chiral_right_decomposition P_plus P_minus h_sum a
  have h2 := chiral_left_decomposition P_plus P_minus h_sum (P_plus * a)
  have h3 := chiral_left_decomposition P_plus P_minus h_sum (P_minus * a)
  calc a = P_plus * a + P_minus * a := h1
    _ = (P_plus * a * P_plus + P_plus * a * P_minus) + (P_minus * a * P_plus + P_minus * a * P_minus) :=
        congrArg₂ (· + ·) h2 h3
    _ = (P_plus * a * P_plus) + (P_plus * a * P_minus) + (P_minus * a * P_plus) + (P_minus * a * P_minus) :=
        (add_assoc _ _ _).symm

end ChiralDecomposition

end InfoGeometry.Algebra.Clifford
