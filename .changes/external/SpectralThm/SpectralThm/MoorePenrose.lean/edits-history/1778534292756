{"file":"/home/goutev/repos/info-geometry-lean/external/SpectralThm/SpectralThm/MoorePenrose.lean","time":1778534292756,"baseTime":1778534291829,"changes":[{"range":{"start":{"line":4,"character":0},"end":{"line":119,"character":0}},"text":"public import Mathlib.Analysis.InnerProductSpace.Adjoint\npublic import Mathlib.Analysis.InnerProductSpace.Projection.Basic\npublic import Mathlib.Analysis.InnerProductSpace.Projection.Submodule\npublic import Mathlib.Analysis.Normed.Operator.Banach\n\n/-!\n# Moore–Penrose inverse\n\nThis file contains the algebraic Penrose equations in a star ring, together with\nbasic projector lemmas and uniqueness of the Moore–Penrose inverse.\n-/\n\n@[expose] public section\n\nnamespace SpectralThm.MoorePenrose\n\nsection Algebraic\n\nvariable {R : Type*} [Ring R] [StarRing R]\n\n/-- The four Penrose equations in a star ring. -/\ndef IsMoorePenroseInverse (A B : R) : Prop :=\n  A * B * A = A ∧\n  B * A * B = B ∧\n  star (A * B) = A * B ∧\n  star (B * A) = B * A\n\nnamespace IsMoorePenroseInverse\n\nvariable {A B : R}\n\ntheorem mk\n    (h1 : A * B * A = A)\n    (h2 : B * A * B = B)\n    (h3 : star (A * B) = A * B)\n    (h4 : star (B * A) = B * A) :\n    IsMoorePenroseInverse A B :=\n  ⟨h1, h2, h3, h4⟩\n\ntheorem aba_eq_a (h : IsMoorePenroseInverse A B) : A * B * A = A := h.1\ntheorem bab_eq_b (h : IsMoorePenroseInverse A B) : B * A * B = B := h.2.1\ntheorem ab_star_eq (h : IsMoorePenroseInverse A B) : star (A * B) = A * B := h.2.2.1\ntheorem ba_star_eq (h : IsMoorePenroseInverse A B) : star (B * A) = B * A := h.2.2.2\n\n-- Backward-compatible aliases.\ntheorem eq1 (h : IsMoorePenroseInverse A B) : A * B * A = A := h.aba_eq_a\ntheorem eq2 (h : IsMoorePenroseInverse A B) : B * A * B = B := h.bab_eq_b\ntheorem eq3 (h : IsMoorePenroseInverse A B) : star (A * B) = A * B := h.ab_star_eq\ntheorem eq4 (h : IsMoorePenroseInverse A B) : star (B * A) = B * A := h.ba_star_eq\n\nend IsMoorePenroseInverse\n\n/-- Star distributes over a triple product. -/\nlemma star_mul_triple (X Y Z : R) :\n    star (X * Y * Z) = star Z * star Y * star X := by\n  calc\n    star (X * Y * Z) = star (X * (Y * Z)) := by rw [mul_assoc]\n    _ = star (Y * Z) * star X := by rw [star_mul]\n    _ = (star Z * star Y) * star X := by rw [star_mul]\n    _ = star Z * star Y * star X := by rw [mul_assoc]\n\n/-- The range projector `A * B` from a Moore–Penrose pair. -/\ndef mpProjector (A B : R) (_h : IsMoorePenroseInverse A B) : R :=\n  A * B\n\nlemma mpProjector_idempotent {A B : R} (h : IsMoorePenroseInverse A B) :\n    mpProjector A B h * mpProjector A B h = mpProjector A B h := by\n  unfold mpProjector\n  calc\n    (A * B) * (A * B) = A * (B * (A * B)) := by rw [mul_assoc]\n    _ = A * (B * A * B) := by rw [← mul_assoc B A B]\n    _ = A * B := by rw [h.bab_eq_b]\n\nlemma mpProjector_self_adjoint {A B : R} (h : IsMoorePenroseInverse A B) :\n    star (mpProjector A B h) = mpProjector A B h := by\n  unfold mpProjector\n  exact h.ab_star_eq\n\n/-- Uniqueness of Moore–Penrose inverses in a star ring. -/\ntheorem moorePenrose_unique {A B C : R}\n    (hB : IsMoorePenroseInverse A B)\n    (hC : IsMoorePenroseInverse A C) : B = C := by\n  have h1 : A * B = A * C := by\n    calc\n      A * B = star (A * B) := hB.ab_star_eq.symm\n      _ = star B * star A := by rw [star_mul]\n      _ = star B * star (A * C * A) := by rw [hC.aba_eq_a]\n      _ = star B * (star A * star C * star A) := by simp only [star_mul, mul_assoc]\n      _ = (star B * star A) * star C * star A := by simp only [mul_assoc]\n      _ = star (A * B) * star C * star A := by rw [star_mul]\n      _ = (A * B) * star C * star A := by rw [hB.ab_star_eq]\n      _ = A * B * (star C * star A) := by rw [mul_assoc]\n      _ = A * B * star (A * C) := by rw [star_mul]\n      _ = A * B * (A * C) := by rw [hC.ab_star_eq]\n      _ = (A * B * A) * C := by simp only [mul_assoc]\n      _ = A * C := by rw [hB.aba_eq_a]\n\n  have h2 : B * A = C * A := by\n    calc\n      B * A = star (B * A) := hB.ba_star_eq.symm\n      _ = star A * star B := by rw [star_mul]\n      _ = star (A * C * A) * star B := by rw [hC.aba_eq_a]\n      _ = (star A * star C * star A) * star B := by simp only [star_mul, mul_assoc]\n      _ = star A * star C * (star A * star B) := by simp only [mul_assoc]\n      _ = star A * star C * star (B * A) := by rw [star_mul]\n      _ = star A * star C * (B * A) := by rw [hB.ba_star_eq]\n      _ = star (C * A) * (B * A) := by rw [star_mul]\n      _ = (C * A) * (B * A) := by rw [hC.ba_star_eq]\n      _ = C * (A * B * A) := by simp only [mul_assoc]\n      _ = C * A := by rw [hB.aba_eq_a]\n\n  calc\n    B = B * A * B := hB.bab_eq_b.symm\n    _ = (B * A) * B := by rw [mul_assoc]\n    _ = (C * A) * B := by rw [h2]\n    _ = C * (A * B) := by rw [← mul_assoc]\n    _ = C * (A * C) := by rw [h1]\n    _ = C * A * C := by rw [mul_assoc]\n    _ = C := hC.bab_eq_b\n\n/-- \n  Moore--Penrose inverse property for continuous linear maps between distinct\n  Hilbert spaces (rectangular case).\n  -/\ndef IsMoorePenroseInverseCLM\n    {𝕜 E F : Type*} [RCLike 𝕜]\n    [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\n    [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] [CompleteSpace F]\n    (A : E →L[𝕜] F) (B : F →L[𝕜] E) : Prop :=\n  (A.comp B).comp A = A ∧\n  (B.comp A).comp B = B ∧\n  star (A.comp B) = A.comp B ∧\n  star (B.comp A) = B.comp A\n","rangeOffset":90,"rangeLength":4264}]}