import InfoGeometry.Algebra.KaplanskyZeroDivisorArchetype
import Mathlib.Algebra.Ring.Basic
import Mathlib.Tactic

/-!
# Idempotent Ideal Annihilation and Direct-Sum Kernel Triviality

This module formalizes structural consequences of idempotent decompositions in associative rings:
1. **Principal Ideal Annihilation**: Left ideal elements generated by an idempotent $e$ ($x = r e$)
   and right ideal elements generated by its complement ($y = (1 - e) s$) satisfy $x y = 0$.
2. **Direct-Sum Kernel Triviality**: For any idempotent $e$, the intersection of the left kernels
   of $e$ and $1 - e$ is trivial: $e x = 0 \wedge (1 - e) x = 0 \implies x = 0$.
3. **Nilpotent Sub-Complex Inclusion**: Any square-zero element $n$ ($n^2 = 0$) satisfies
   $\operatorname{im}(n) \subseteq \ker(n)$.

All definitions and theorems reuse the core idempotent and nilpotent definitions from
`InfoGeometry.Algebra.KaplanskyZeroDivisorArchetype` without code duplication.
-/

namespace InfoGeometry.Algebra.ChevalleyKaplansky

open InfoGeometry.Algebra.KaplanskyZeroDivisor

variable {R : Type*} [Ring R]

/-! ### I. Idempotent Left and Right Ideal Annihilation -/

/-- Left ideal element generated by an idempotent: $x = r \cdot e$. -/
def IsLeftPrincipalIdealMember (e x : R) : Prop := ∃ r : R, x = r * e

/-- Right ideal element generated by the orthogonal complement: $y = (1 - e) \cdot s$. -/
def IsRightComplementIdealMember (e y : R) : Prop := ∃ s : R, y = (1 - e) * s

/-- Multiplication of any left ideal element $r e$ by any right complement element $(1 - e) s$ vanishes:
$(r \cdot e) \cdot ((1 - e) \cdot s) = 0$. -/
theorem left_ideal_mul_right_complement_ideal_eq_zero {e x y : R} (he : IsIdempotent e)
    (hx : IsLeftPrincipalIdealMember e x) (hy : IsRightComplementIdealMember e y) :
    x * y = 0 := by
  obtain ⟨r, rfl⟩ := hx
  obtain ⟨s, rfl⟩ := hy
  calc
    (r * e) * ((1 - e) * s) = r * (e * (1 - e)) * s := by
      simp only [mul_assoc]
    _ = r * 0 * s := by rw [idempotent_mul_complement_self he]
    _ = 0 := by rw [mul_zero, zero_mul]

/-! ### II. State Decomposition and Kernel Triviality -/

/-- Direct-sum state reconstruction: any element decomposes into its projections
under $e$ and $1 - e$. -/
theorem idempotent_state_reconstruction (e x : R) :
    e * x + (1 - e) * x = x := by
  calc
    e * x + (1 - e) * x = (e + (1 - e)) * x := (add_mul e (1 - e) x).symm
    _ = 1 * x := by rw [add_sub_cancel e 1]
    _ = x := one_mul x

/-- The intersection of the left kernels of $e$ and $1 - e$ is trivial:
$e x = 0 \wedge (1 - e) x = 0 \implies x = 0$. -/
theorem idempotent_kernel_intersection_trivial {e x : R}
    (he_zero : e * x = 0) (hcomp_zero : (1 - e) * x = 0) :
    x = 0 := by
  calc
    x = e * x + (1 - e) * x := (idempotent_state_reconstruction e x).symm
    _ = 0 + 0 := by rw [he_zero, hcomp_zero]
    _ = 0 := add_zero 0

/-! ### III. Nilpotent Sub-Complex Inclusion -/

/-- Image of left multiplication by $n$. -/
def InImage (n y : R) : Prop := ∃ x : R, y = n * x

/-- Kernel of left multiplication by $n$. -/
def InKernel (n y : R) : Prop := n * y = 0

/-- For any square-zero element, the image of left multiplication is contained in its kernel:
$\operatorname{im}(n) \subseteq \ker(n)$. -/
theorem nilpotent_image_subset_kernel {n : R} (hn : IsSquareZero n) {y : R}
    (hy : InImage n y) : InKernel n y := by
  obtain ⟨x, rfl⟩ := hy
  unfold InKernel
  calc
    n * (n * x) = (n * n) * x := (mul_assoc n n x).symm
    _ = 0 * x := by rw [hn]
    _ = 0 := zero_mul x

end InfoGeometry.Algebra.ChevalleyKaplansky
