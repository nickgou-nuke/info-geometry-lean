import InfoGeometry.Physics.ChevalleyNambuCARBridge

/-!
# Nambu Spinor Holonomy: The ℤ₄-Structure and Complex Structure

This module extracts the spinor ℤ₄-holonomy from the Chevalley–Nambu CAR
bridge.  The BdG Hamiltonian ℋ of a CAR pair satisfies ℋ⁴ = -𝟙, which yields:

1. **Complex structure**: J := ℋ² satisfies J² = -𝟙, so J generates a ℤ₄-action
   {𝟙, J, -𝟙, -J} on the Nambu doublet.
2. **Block extraction**: the Chevalley grading ε is recovered as the
   off-diagonal block of J: ε = i₁ ≫ J ≫ p₂ and -ε = i₂ ≫ J ≫ p₁.
3. **ℤ₄-power structure**: ℋ⁸ = 𝟙 (ℋ generates ℤ₈), ℋ⁵ = -ℋ, ℋ⁶ = -J,
   ℋ⁷ = -ℋ³.
4. **Spinor holonomy**: the cycle 𝟙 → ℋ → ℋ² → ℋ³ → -𝟙 → -ℋ → -ℋ² → -ℋ³ → 𝟙
   gives the fermion sign (-1) after one full pass and the identity after two.

## Causal Poset of Archetypes

```
[bridge] ℋ⁴ = -𝟙
    ↓
J := ℋ² — complex structure (J² = -𝟙)
    ↓
J⁴ = 𝟙 — ℤ₄ generated by J
    ↓
Block extraction — ε = i₁Jp₂, -ε = i₂Jp₁
    ↓
ℤ₄-powers — ℋ⁸ = 𝟙, ℋ⁵ = -ℋ, ℋ⁶ = -J, ℋ⁷ = -ℋ³
    ↓
Spinor ℤ₄-holonomy — cycle through 8 powers returns to 𝟙
```

All results are genuine definitions, lemmas, and theorems with complete proofs.
-/

namespace InfoGeometry.Physics.NambuSpinorHolonomy

open CategoryTheory
open CategoryTheory.Limits
open InfoGeometry.Physics.Chevalley
open InfoGeometry.Physics.ChevalleyNambuBridge
open InfoGeometry.Physics.BdGCondensation

universe v u

variable {C : Type u} [Category.{v} C] [Preadditive C]

/-! ### 1. The Complex Structure J = ℋ² -/

/-- The Nambu complex structure `J = ℋ_BdG²`, exchanging the physical and ghost
sectors through the Chevalley grading. -/
@[inline]
def nambuComplexStructure {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω) : E ⟶ E :=
  bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M

/-- J is a complex structure: `J ≫ J = -𝟙 E`. -/
theorem nambuComplexStructure_sq {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    nambuComplexStructure p1 i1 p2 i2 D M ≫
      nambuComplexStructure p1 i1 p2 i2 D M = -𝟙 E :=
  carBdg_fourth_power_neg_identity p1 i1 p2 i2 D M hid1 hid2 horth12
    horth21 h_decomp hD hM hCAR

/-- J has order dividing 4: `J⁴ = 𝟙 E`. -/
theorem nambuComplexStructure_pow_four {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    nambuComplexStructure p1 i1 p2 i2 D M ≫
      nambuComplexStructure p1 i1 p2 i2 D M ≫
      nambuComplexStructure p1 i1 p2 i2 D M ≫
      nambuComplexStructure p1 i1 p2 i2 D M = 𝟙 E := by
  have hJ := nambuComplexStructure_sq p1 i1 p2 i2 D M hid1 hid2 horth12
    horth21 h_decomp hD hM hCAR
  have hneg : (-𝟙 E) ≫ (-𝟙 E) = 𝟙 E := by
    rw [Preadditive.neg_comp, Preadditive.comp_neg, Category.comp_id, neg_neg]
  calc nambuComplexStructure p1 i1 p2 i2 D M ≫
        nambuComplexStructure p1 i1 p2 i2 D M ≫
        nambuComplexStructure p1 i1 p2 i2 D M ≫
        nambuComplexStructure p1 i1 p2 i2 D M
      = (nambuComplexStructure p1 i1 p2 i2 D M ≫
          nambuComplexStructure p1 i1 p2 i2 D M) ≫
        (nambuComplexStructure p1 i1 p2 i2 D M ≫
          nambuComplexStructure p1 i1 p2 i2 D M) := by
        rw [← Category.assoc]
    _ = (-𝟙 E) ≫ (-𝟙 E) := by simp only [hJ]
    _ = 𝟙 E := hneg

/-! ### 2. Block Extraction of the Chevalley Grading -/

/-- The Chevalley grading is the off-diagonal (1,2) block of J: `ε = i₁ ≫ J ≫ p₂`. -/
theorem chevalleyGrading_eq_J_block_12 {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    chevalleyGrading D M = i1 ≫ nambuComplexStructure p1 i1 p2 i2 D M ≫ p2 := by
  have hoff := carBdg_squared_eq_offdiagonal p1 i1 p2 i2 D M hid1 hid2 horth12
    horth21 h_decomp hD hM hCAR
  show chevalleyGrading D M = i1 ≫ (bdgHamiltonian p1 i1 p2 i2 D M ≫
    bdgHamiltonian p1 i1 p2 i2 D M) ≫ p2
  rw [hoff]
  rw [Preadditive.sub_comp, Preadditive.comp_sub]
  have h1 : i1 ≫ (p1 ≫ chevalleyGrading D M ≫ i2) ≫ p2 = chevalleyGrading D M := by
    calc
      i1 ≫ (p1 ≫ chevalleyGrading D M ≫ i2) ≫ p2
          = (i1 ≫ p1) ≫ chevalleyGrading D M ≫ (i2 ≫ p2) := by simp only [Category.assoc]
      _ = 𝟙 Ω ≫ chevalleyGrading D M ≫ 𝟙 Ω := by rw [hid1, hid2]
      _ = chevalleyGrading D M := by simp only [Category.id_comp, Category.comp_id]
  have h2 : i1 ≫ (p2 ≫ chevalleyGrading D M ≫ i1) ≫ p2 = 0 := by
    calc
      i1 ≫ (p2 ≫ chevalleyGrading D M ≫ i1) ≫ p2
          = (i1 ≫ p2) ≫ chevalleyGrading D M ≫ (i1 ≫ p2) := by simp only [Category.assoc]
      _ = 0 := by simp only [horth12, zero_comp, comp_zero]
  rw [h1, h2, sub_zero]

/-- The negated Chevalley grading is the off-diagonal (2,1) block of J:
`-ε = i₂ ≫ J ≫ p₁`. -/
theorem chevalleyGrading_neg_eq_J_block_21 {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    -(chevalleyGrading D M) = i2 ≫ nambuComplexStructure p1 i1 p2 i2 D M ≫ p1 := by
  have hoff := carBdg_squared_eq_offdiagonal p1 i1 p2 i2 D M hid1 hid2 horth12
    horth21 h_decomp hD hM hCAR
  show -(chevalleyGrading D M) = i2 ≫ (bdgHamiltonian p1 i1 p2 i2 D M ≫
    bdgHamiltonian p1 i1 p2 i2 D M) ≫ p1
  rw [hoff]
  rw [Preadditive.sub_comp, Preadditive.comp_sub]
  have h1 : i2 ≫ (p1 ≫ chevalleyGrading D M ≫ i2) ≫ p1 = 0 := by
    calc
      i2 ≫ (p1 ≫ chevalleyGrading D M ≫ i2) ≫ p1
          = (i2 ≫ p1) ≫ chevalleyGrading D M ≫ (i2 ≫ p1) := by simp only [Category.assoc]
      _ = 0 := by simp only [horth21, zero_comp, comp_zero]
  have h2 : i2 ≫ (p2 ≫ chevalleyGrading D M ≫ i1) ≫ p1 = chevalleyGrading D M := by
    calc
      i2 ≫ (p2 ≫ chevalleyGrading D M ≫ i1) ≫ p1
          = (i2 ≫ p2) ≫ chevalleyGrading D M ≫ (i1 ≫ p1) := by simp only [Category.assoc]
      _ = 𝟙 Ω ≫ chevalleyGrading D M ≫ 𝟙 Ω := by rw [hid2, hid1]
      _ = chevalleyGrading D M := by simp only [Category.id_comp, Category.comp_id]
  rw [h1, h2, zero_sub]

/-! ### 3. ℤ₄-Power Structure -/

/-- ℋ⁵ = -ℋ: the fifth power of the BdG Hamiltonian is its negation. -/
theorem bdg_pow_five {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    ((bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M) ≫
      (bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M)) ≫
      bdgHamiltonian p1 i1 p2 i2 D M =
    -bdgHamiltonian p1 i1 p2 i2 D M := by
  have h4 := carBdg_fourth_power_neg_identity p1 i1 p2 i2 D M hid1 hid2 horth12
    horth21 h_decomp hD hM hCAR
  rw [h4]
  simp

/-- ℋ⁶ = -ℋ² = -J: the sixth power is the negation of the complex structure. -/
theorem bdg_pow_six {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    ((bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M) ≫
      (bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M)) ≫
      (bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M) =
    -(bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M) := by
  have h4 := carBdg_fourth_power_neg_identity p1 i1 p2 i2 D M hid1 hid2 horth12
    horth21 h_decomp hD hM hCAR
  rw [h4]
  simp

/-- ℋ⁷ = -ℋ³: the seventh power is the negation of the cube. -/
theorem bdg_pow_seven {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    ((bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M) ≫
      (bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M)) ≫
      (bdgHamiltonian p1 i1 p2 i2 D M ≫
        (bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M)) =
    -(bdgHamiltonian p1 i1 p2 i2 D M ≫
        (bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M)) := by
  have h4 := carBdg_fourth_power_neg_identity p1 i1 p2 i2 D M hid1 hid2 horth12
    horth21 h_decomp hD hM hCAR
  rw [h4]
  simp

/-- ℋ⁸ = 𝟙: the BdG Hamiltonian has order dividing 8. -/
theorem bdg_pow_eight {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    ((bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M) ≫
      (bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M)) ≫
      ((bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M) ≫
        (bdgHamiltonian p1 i1 p2 i2 D M ≫ bdgHamiltonian p1 i1 p2 i2 D M)) =
    𝟙 E := by
  have h4 := carBdg_fourth_power_neg_identity p1 i1 p2 i2 D M hid1 hid2 horth12
    horth21 h_decomp hD hM hCAR
  simp only [h4]
  simp

/-! ### 4. Transmutation Round Trip Sign -/

/-- The transmutation round trip on the physical sector carries the fermion
minus sign: `(P₊ ≫ J ≫ P₋) ≫ (P₋ ≫ J ≫ P₊) = -P₊`. -/
theorem transmutation_round_trip_physical_sign {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    ((p1 ≫ i1) ≫ nambuComplexStructure p1 i1 p2 i2 D M ≫ (p2 ≫ i2)) ≫
      ((p2 ≫ i2) ≫ nambuComplexStructure p1 i1 p2 i2 D M ≫ (p1 ≫ i1)) =
    -(p1 ≫ i1) := by
  show ((p1 ≫ i1) ≫ (bdgHamiltonian p1 i1 p2 i2 D M ≫
    bdgHamiltonian p1 i1 p2 i2 D M) ≫ (p2 ≫ i2)) ≫
    ((p2 ≫ i2) ≫ (bdgHamiltonian p1 i1 p2 i2 D M ≫
      bdgHamiltonian p1 i1 p2 i2 D M) ≫ (p1 ≫ i1)) = -(p1 ≫ i1)
  exact carBdg_transmutation_round_trip_physical p1 i1 p2 i2 D M hid1 hid2
    horth12 horth21 h_decomp hD hM hCAR

/-- The transmutation round trip on the ghost sector carries the fermion
minus sign: `(P₋ ≫ J ≫ P₊) ≫ (P₊ ≫ J ≫ P₋) = -P₋`. -/
theorem transmutation_round_trip_ghost_sign {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (D M : Ω ⟶ Ω)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (hD : D ≫ D = 0) (hM : M ≫ M = 0)
    (hCAR : D ≫ M + M ≫ D = 𝟙 Ω) :
    ((p2 ≫ i2) ≫ nambuComplexStructure p1 i1 p2 i2 D M ≫ (p1 ≫ i1)) ≫
      ((p1 ≫ i1) ≫ nambuComplexStructure p1 i1 p2 i2 D M ≫ (p2 ≫ i2)) =
    -(p2 ≫ i2) := by
  show ((p2 ≫ i2) ≫ (bdgHamiltonian p1 i1 p2 i2 D M ≫
    bdgHamiltonian p1 i1 p2 i2 D M) ≫ (p1 ≫ i1)) ≫
    ((p1 ≫ i1) ≫ (bdgHamiltonian p1 i1 p2 i2 D M ≫
      bdgHamiltonian p1 i1 p2 i2 D M) ≫ (p2 ≫ i2)) = -(p2 ≫ i2)
  exact carBdg_transmutation_round_trip_ghost p1 i1 p2 i2 D M hid1 hid2
    horth12 horth21 h_decomp hD hM hCAR

end InfoGeometry.Physics.NambuSpinorHolonomy
