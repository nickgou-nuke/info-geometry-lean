import InfoGeometry.QuantumContext.FiniteMarkovTransitionKernel
import InfoGeometry.QuantumContext.FiniteMarkovDirichletApproximation
import Mathlib.LinearAlgebra.Matrix.Stochastic
import Mathlib.Probability.ProbabilityMassFunction.Monad
import Mathlib.Probability.ProbabilityMassFunction.Constructions
import Mathlib.Probability.ProbabilityMassFunction.Integrals

/-!
# Finite PMF path expectation for truncated Markov first-hit cost

This owner defines finite successor paths by recursively binding the existing
row PMFs and proves that their truncated first-hit cost expectation equals the
existing finite-horizon Bellman approximant. The production `partialTraj`
kernel's successor-coordinate law is identified in
`FiniteMarkovTrajectorySuccessorLaw`; its path-cost integral and finite-horizon
Green-potential transport are established in
`FiniteMarkovTrajectoryHittingGreen`.
-/

noncomputable section

namespace InfoGeometry.QuantumContext.FiniteMarkovHittingPMFExpectation

open MeasureTheory ProbabilityTheory
open scoped ENNReal BigOperators
open InfoGeometry.QuantumContext.FiniteMarkovTransitionKernel

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

local instance : MeasurableSpace ι := ⊤
local instance : MeasurableSingletonClass ι := inferInstance
local instance (n : ℕ) : MeasurableSpace (Fin n → ι) := ⊤
local instance (n : ℕ) : MeasurableSingletonClass (Fin n → ι) := inferInstance

/-- Prepend one state to a finite path, making the successor index explicit. -/
private def prependPath {n : ℕ} (state : ι) (tail : Fin n → ι) : Fin (n + 1) → ι :=
  @Fin.cons n (fun _ => ι) state tail

/-- Finite successor histories generated by successive row-PMF transitions. -/
def successorPathPMF (P : Matrix ι ι ℝ)
    (hP : P ∈ Matrix.rowStochastic ℝ ι) :
    (n : ℕ) → ι → PMF (Fin n → ι)
  | 0, _ => PMF.pure Fin.elim0
  | n + 1, i => (rowPMF P hP i).bind fun j =>
      (successorPathPMF P hP n j).map (prependPath j)

/-- The first-hit cost truncated to the finite list of successor states. -/
def pathFirstHitCost (target : ι) :
    (n : ℕ) → ι → (Fin n → ι) → ℝ
  | 0, _, _ => 0
  | n + 1, i, path =>
      if i = target then 0 else
        1 + pathFirstHitCost target n (path 0) (fun k => path k.succ)

/-- Expected pathwise truncated first-hit cost under the finite successor PMF. -/
def successorPathExpectedCost (P : Matrix ι ι ℝ)
    (hP : P ∈ Matrix.rowStochastic ℝ ι) (target : ι) (n : ℕ) (i : ι) : ℝ :=
  ∫ path, pathFirstHitCost target n i path ∂(successorPathPMF P hP n i).toMeasure

/-- For finite carriers, expectation under a PMF bind is the finite sum of
conditional expectations weighted by the first PMF. -/
theorem integral_bind_fintype {α β : Type*} [Fintype α] [Fintype β]
    [MeasurableSpace β] [MeasurableSingletonClass β]
    (p : PMF α) (q : α → PMF β) (f : β → ℝ) :
    ∫ b, f b ∂(p.bind q).toMeasure =
      ∑ a, (p a).toReal * ∫ b, f b ∂(q a).toMeasure := by
  simp_rw [PMF.integral_eq_sum]
  simp only [smul_eq_mul, PMF.bind_apply, tsum_fintype]
  calc
    (∑ b, (∑ a, p a * q a b).toReal * f b) =
        ∑ b, (∑ a, (p a).toReal * (q a b).toReal) * f b := by
      apply Finset.sum_congr rfl
      intro b hb
      rw [ENNReal.toReal_sum (fun a _ =>
        ne_of_lt (ENNReal.mul_lt_top (p.apply_lt_top a) ((q a).apply_lt_top b)))]
      simp_rw [ENNReal.toReal_mul]
    _ = ∑ b, ∑ a, ((p a).toReal * (q a b).toReal) * f b := by
      simp_rw [Finset.sum_mul]
    _ = ∑ a, ∑ b, ((p a).toReal * (q a b).toReal) * f b := by
      rw [Finset.sum_comm]
    _ = ∑ a, (p a).toReal * ∑ b, (q a b).toReal * f b := by
      apply Finset.sum_congr rfl
      intro a ha
      calc
        ∑ b, ((p a).toReal * (q a b).toReal) * f b =
            ∑ b, (p a).toReal * ((q a b).toReal * f b) := by
          apply Finset.sum_congr rfl
          intro b hb
          ring
        _ = (p a).toReal * ∑ b, (q a b).toReal * f b := by
          rw [← Finset.mul_sum]

/-- Integration is unchanged by pushing a finite PMF through a function. -/
theorem integral_map_fintype {α β : Type*} [Fintype α] [Fintype β]
    [MeasurableSpace α] [MeasurableSpace β]
    (p : PMF α) (g : α → β) (f : β → ℝ)
    (hg : Measurable g) (hf : StronglyMeasurable f) :
    ∫ b, f b ∂(p.map g).toMeasure = ∫ a, f (g a) ∂p.toMeasure := by
  rw [← PMF.toMeasure_map (p := p) (f := g) hg]
  exact MeasureTheory.integral_map_of_stronglyMeasurable hg hf

private theorem rowPMF_integral_eq_mulVec (P : Matrix ι ι ℝ)
    (hP : P ∈ Matrix.rowStochastic ℝ ι) (i : ι) (x : ι → ℝ) :
    ∫ j, x j ∂(rowPMF P hP i).toMeasure = (P.mulVec x) i := by
  rw [PMF.integral_eq_sum]
  simp [rowPMF, Matrix.mulVec, dotProduct, ENNReal.toReal_ofReal,
    Matrix.nonneg_of_mem_rowStochastic hP]

private theorem rowPMF_integral_eq_sum (P : Matrix ι ι ℝ)
    (hP : P ∈ Matrix.rowStochastic ℝ ι) (i : ι) (x : ι → ℝ) :
    ∫ j, x j ∂(rowPMF P hP i).toMeasure =
      ∑ j, (rowPMF P hP i j).toReal * x j := by
  rw [PMF.integral_eq_sum]
  simp only [smul_eq_mul]

private theorem prependPathCost_integral (P : Matrix ι ι ℝ)
    (hP : P ∈ Matrix.rowStochastic ℝ ι) (target i j : ι) (n : ℕ)
    (hi : i ≠ target) :
    ∫ path, pathFirstHitCost target (n + 1) i path
        ∂(PMF.map (prependPath j) (successorPathPMF P hP n j)).toMeasure =
      1 + successorPathExpectedCost P hP target n j := by
  rw [integral_map_fintype _ _ _ Measurable.of_discrete StronglyMeasurable.of_discrete]
  rw [successorPathExpectedCost]
  rw [PMF.integral_eq_sum, PMF.integral_eq_sum]
  simp [smul_eq_mul, pathFirstHitCost, hi, prependPath, Fin.cons]
  have hmass :
      ∑ path, (successorPathPMF P hP n j path).toReal = 1 := by
    simpa using (PMF.integral_eq_sum (successorPathPMF P hP n j)
      (fun _ => (1 : ℝ))).symm
  calc
    (∑ path, (successorPathPMF P hP n j path).toReal *
        (1 + pathFirstHitCost target n j path)) =
      (∑ path, (successorPathPMF P hP n j path).toReal) +
        ∑ path, (successorPathPMF P hP n j path).toReal *
          pathFirstHitCost target n j path := by
            simp_rw [mul_add]
            rw [Finset.sum_add_distrib]
            simp only [mul_one]
    _ = 1 + ∑ path, (successorPathPMF P hP n j path).toReal *
        pathFirstHitCost target n j path := by rw [hmass]

/-- The expected path cost follows the finite Bellman update. -/
theorem successorPathExpectedCost_succ (P : Matrix ι ι ℝ)
    (hP : P ∈ Matrix.rowStochastic ℝ ι) (target : ι) (n : ℕ) (i : ι) :
    successorPathExpectedCost P hP target (n + 1) i =
      if i = target then 0 else
        1 + ∫ j, successorPathExpectedCost P hP target n j
          ∂(rowPMF P hP i).toMeasure := by
  unfold successorPathExpectedCost
  rw [successorPathPMF, integral_bind_fintype]
  by_cases hi : i = target
  · simp [pathFirstHitCost, hi]
  · simp [hi]
    have hsum : ∑ j, (rowPMF P hP i j).toReal = 1 := by
      simpa using (PMF.integral_eq_sum (rowPMF P hP i) (fun _ => (1 : ℝ))).symm
    rw [PMF.integral_eq_sum]
    simp only [smul_eq_mul]
    calc
      (∑ j, (rowPMF P hP i j).toReal *
          ∫ path, pathFirstHitCost target (n + 1) i path
            ∂(PMF.map (prependPath j) (successorPathPMF P hP n j)).toMeasure) =
        ∑ j, (rowPMF P hP i j).toReal *
          (1 + successorPathExpectedCost P hP target n j) := by
        apply Finset.sum_congr rfl
        intro j hj
        exact congrArg _ (prependPathCost_integral P hP target i j n hi)
      _ = 1 + ∑ j, (rowPMF P hP i j).toReal *
          successorPathExpectedCost P hP target n j := by
        calc
          _ = (∑ j, (rowPMF P hP i j).toReal) +
              ∑ j, (rowPMF P hP i j).toReal *
                successorPathExpectedCost P hP target n j := by
              simp_rw [mul_add]
              rw [Finset.sum_add_distrib]
              simp only [mul_one]
          _ = 1 + ∑ j, (rowPMF P hP i j).toReal *
              successorPathExpectedCost P hP target n j := by rw [hsum]
      _ = 1 + ∫ j, successorPathExpectedCost P hP target n j
          ∂(rowPMF P hP i).toMeasure := by
        simpa [successorPathExpectedCost] using
          congrArg (fun z : ℝ => 1 + z)
            (rowPMF_integral_eq_sum P hP i
              (successorPathExpectedCost P hP target n)).symm
    -- `rw [if_neg hi]` also leaves the unfolded row-expectation equality as a
    -- separate goal; discharge it from the named finite PMF sum formula.
    simpa [successorPathExpectedCost] using
      congrArg (fun z : ℝ => 1 + z)
        (rowPMF_integral_eq_sum P hP i
          (successorPathExpectedCost P hP target n))

/-- The finite successor-path expectation is exactly the existing Bellman
approximant at every horizon and initial state. -/
theorem successorPathExpectedCost_eq_firstHitApproximation
    (P : Matrix ι ι ℝ) (hP : P ∈ Matrix.rowStochastic ℝ ι)
    (target : ι) (n : ℕ) (i : ι) :
    successorPathExpectedCost P hP target n i =
      InfoGeometry.QuantumContext.FiniteMarkovDirichletApproximation.firstHitApproximation
        P target n i := by
  induction n generalizing i with
  | zero => simp [successorPathExpectedCost, pathFirstHitCost,
      InfoGeometry.QuantumContext.FiniteMarkovDirichletApproximation.firstHitApproximation]
  | succ n ih =>
      by_cases hi : i = target
      · subst i
        rw [successorPathExpectedCost_succ]
        simp [InfoGeometry.QuantumContext.FiniteMarkovDirichletApproximation.firstHitApproximation_target]
      · rw [successorPathExpectedCost_succ,
          InfoGeometry.QuantumContext.FiniteMarkovDirichletApproximation.firstHitApproximation_succ_of_ne
            P target n i hi]
        simp [hi]
        calc
          ∫ j, successorPathExpectedCost P hP target n j ∂(rowPMF P hP i).toMeasure =
              ∫ j, InfoGeometry.QuantumContext.FiniteMarkovDirichletApproximation.firstHitApproximation
                P target n j ∂(rowPMF P hP i).toMeasure := by
              apply integral_congr_ae
              filter_upwards with j
              exact ih j
          _ = (P.mulVec
              (InfoGeometry.QuantumContext.FiniteMarkovDirichletApproximation.firstHitApproximation
                P target n)) i := rowPMF_integral_eq_mulVec P hP i _

end InfoGeometry.QuantumContext.FiniteMarkovHittingPMFExpectation
