-- Generated by generate_unruh_rindler_superpotential.py
-- Define the polynomial ring in variables x, theta, D
R = QQ[x, theta, D];

-- Define the superpotential W = x^3 + x*theta*D
W = x^3 + x*theta*D;

-- Compute the Jacobian ideal: generated by partial derivatives
J = ideal(diff(x, W), diff(theta, W), diff(D, W));

-- Compute the dimension of the quotient ring R/J
D = dim(R / J);

-- Export the result
print(toString(D))
exit 0
