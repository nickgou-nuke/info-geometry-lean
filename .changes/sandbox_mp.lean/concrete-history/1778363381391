{"type":"new","contents":"import Mathlib.Algebra.Ring.Basic\nimport Mathlib.Algebra.Star.Basic\nimport Mathlib.Analysis.InnerProductSpace.Adjoint\nimport Mathlib.Analysis.InnerProductSpace.Projection.Basic\nimport Mathlib.Analysis.InnerProductSpace.Projection.Submodule\nimport Mathlib.Analysis.Normed.Operator.Banach\n\nnamespace InfoGeometry.Singular.MoorePenrose\n\npostfix:max \"†\" => star\n\nsection MP\nvariable {R : Type*} [Ring R] [StarRing R]\n\ndef IsMoorePenroseInverse (A B : R) : Prop :=\n  A * B * A = A ∧\n  B * A * B = B ∧\n  (A * B)† = A * B ∧\n  (B * A)† = B * A\n\nnamespace IsMoorePenroseInverse\n\nvariable {A B : R}\n\ntheorem mk\n    (h1 : A * B * A = A)\n    (h2 : B * A * B = B)\n    (h3 : (A * B)† = A * B)\n    (h4 : (B * A)† = B * A) :\n    IsMoorePenroseInverse A B :=\n  ⟨h1, h2, h3, h4⟩\n\nend IsMoorePenroseInverse\n\nend MP\n\nsection Hilbert\nopen InnerProductSpace ContinuousLinearMap\nopen scoped InnerProduct ComplexConjugate\n\nvariable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\n/--\nExistence of Moore-Penrose inverse for bounded operators with closed range in Hilbert spaces.\n\nConstruction established the conductive path to Mathlib's `orthogonalProjection`.\n-/\ntheorem exists_moorePenroseInverse_of_closedRange\n    (A : E →L[ℝ] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    ∃ (B : E →L[ℝ] E), IsMoorePenroseInverse A B := by\n  classical\n  let K := A.ker\n  let R := A.range\n  let Kp := Kᗮ\n  \n  -- K is closed, so Kp.HasOrthogonalProjection and IsCompl K Kp\n  have hKclosed : IsClosed (K : Set E) := A.isClosed_ker\n  haveI : K.HasOrthogonalProjection := \n    HasOrthogonalProjection.ofCompleteSpace (of := K) (hKclosed.completeSpace_coe)\n  have hK_compl : IsCompl K Kp := \n    Submodule.isCompl_orthogonal_of_hasOrthogonalProjection\n\n  -- R is closed and E is complete, so R is complete and has an orthogonal projection\n  letI : CompleteSpace R := hClosedRange.completeSpace_coe\n  haveI : R.HasOrthogonalProjection := \n    HasOrthogonalProjection.ofCompleteSpace (of := R) (inferInstance)\n\n  -- Restrict A to Kp, and codrestrict to its range R\n  let Ares : Kp →L[ℝ] R :=\n    (A.comp Kp.subtypeL).codRestrict R (fun ⟨x, hx⟩ ↦ ⟨x, rfl⟩)\n\n  -- Ares is injective because Kp ⊓ ker A = ⊥\n  have hAres_inj : (Ares : Kp →ₗ[ℝ] R).ker = ⊥ := by\n    rw [LinearMap.ker_eq_bot]\n    intro x y hxy\n    apply Subtype.ext\n    have hval : A x.1 = A y.1 := congrArg Subtype.val hxy\n    have hker : (x - y : E) ∈ K := by\n      change A (x.1 - y.1) = 0\n      simpa [map_sub, hval]\n    have horth : (x - y : E) ∈ Kp := Submodule.sub_mem Kp x.2 y.2\n    have hbot : (x - y : E) ∈ (⊥ : Submodule ℝ E) := hK_compl.inf_le ⟨hker, horth⟩\n    simpa using hbot\n\n  -- Ares is surjective by definition of R = A.range and K ⊔ Kp = ⊤\n  have hAres_surj : (Ares : Kp →ₗ[ℝ] R).range = ⊤ := by\n    rw [LinearMap.range_eq_top]\n    intro ⟨y, hy⟩\n    rcases hy with ⟨x, rfl⟩\n    -- Project x onto Kp\n    let x_kp := Kp.orthogonalProjection x\n    refine ⟨x_kp, ?_⟩\n    apply Subtype.ext\n    change A x_kp.1 = A x\n    -- x = proj_K(x) + proj_Kp(x)\n    have hx_split : x = (K.orthogonalProjection x : E) + (Kp.orthogonalProjection x : E) := by\n      calc\n        x = K.starProjection x + Kᗮ.starProjection x := \n          (K.starProjection_add_starProjection_orthogonal x).symm\n        _ = (K.orthogonalProjection x : E) + (Kp.orthogonalProjection x : E) := rfl\n    rw [hx_split, map_add]\n    have hxk : (K.orthogonalProjection x : E) ∈ K := (K.orthogonalProjection x).2\n    simp [LinearMap.mem_ker.1 hxk]\n\n  -- By Banach inverse theorem, Ares is a continuous linear equivalence\n  let e : Kp ≃L[ℝ] R := \n    ContinuousLinearEquiv.ofBijective Ares hAres_ker hAres_range\n  \n  -- Define B = i_Kp ∘ e⁻¹ ∘ P_R\n  let B : E →L[ℝ] E := Kp.subtypeL.comp (e.symm.toContinuousLinearMap.comp R.orthogonalProjection)\n\n  have hAB : A * B = R.starProjection := by\n    ext x\n    calc\n      (A * B) x = A (e.symm (R.orthogonalProjection x)) := rfl\n      _ = Ares (e.symm (R.orthogonalProjection x)) := rfl\n      _ = (e (e.symm (R.orthogonalProjection x)) : E) := rfl\n      _ = R.starProjection x := by simp\n\n  have hBA : B * A = Kp.starProjection := by\n    ext x\n    let x_kp := Kp.orthogonalProjection x\n    have hAx : A x = A x_kp.1 := by\n      have hx_split : x = (K.orthogonalProjection x : E) + x_kp.1 := by\n        calc\n          x = K.starProjection x + Kᗮ.starProjection x := \n            (K.starProjection_add_starProjection_orthogonal x).symm\n          _ = (K.orthogonalProjection x : E) + x_kp.1 := rfl\n      rw [hx_split, map_add]\n      have hxk : (K.orthogonalProjection x : E) ∈ K := (K.orthogonalProjection x).2\n      simp [LinearMap.mem_ker.1 hxk]\n    calc\n      (B * A) x = Kp.subtypeL (e.symm (R.orthogonalProjection (A x))) := rfl\n      _ = Kp.subtypeL (e.symm ⟨A x, ⟨x, rfl⟩⟩) := by\n        congr\n        apply Subtype.ext\n        simp [Submodule.orthogonalProjection_mem_subspace_eq_self]\n      _ = Kp.subtypeL (e.symm (Ares x_kp)) := by\n        congr\n        apply Subtype.ext\n        exact hAx.symm\n      _ = Kp.subtypeL (e.symm (e x_kp)) := rfl\n      _ = Kp.starProjection x := by simp\n\n  refine ⟨B, ?_, ?_, ?_, ?_⟩\n  · -- A * B * A = A\n    rw [ContinuousLinearMap.mul_def, hAB]\n    ext x\n    exact R.starProjection_eq_self_iff.2 ⟨x, rfl⟩\n  · -- B * A * B = B\n    rw [ContinuousLinearMap.mul_def, hBA]\n    ext x\n    exact Kp.starProjection_eq_self_iff.2 (B x).2\n  · -- (A * B)† = A * B\n    rw [ContinuousLinearMap.mul_def, hAB]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection R)\n  · -- (B * A)† = B * A\n    rw [ContinuousLinearMap.mul_def, hBA]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection Kp)\n\nend Hilbert\n\nend InfoGeometry.Singular.MoorePenrose\n","mtime":1778363381391}