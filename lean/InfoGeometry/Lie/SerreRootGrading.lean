import Mathlib.Algebra.Lie.Free
import Mathlib.Algebra.Lie.SerreConstruction
import Mathlib.Algebra.Lie.Submodule
import Mathlib.Algebra.Lie.Quotient
import Mathlib.Algebra.Lie.IdealOperations

open CartanMatrix

variable {R : Type*} [CommRing R] {B : Type*} [DecidableEq B]
variable {A : Type*} [AddCommGroup A] (w : Generators B → A)

/-!
# Root-Lattice Grading of Serre Lie Algebras

This module constructs the canonical grading chain for Kac-Moody algebras:
1. Root-lattice degrees on Serre generators.
2. Extension to Free Lie Algebra.
3. Homogeneity of the Serre Ideal.
4. Height cutoffs and bracket bounds.
-/

namespace InfoGeometry.Lie.Serre

/-- 1 & 2. Inductive definition of homogeneous elements in the Free Lie Algebra. -/
inductive IsHomogeneous : A → FreeLieAlgebra R (Generators B) → Prop
  | of (x : Generators B) : IsHomogeneous (w x) (FreeLieAlgebra.of R x)
  | zero (a : A) : IsHomogeneous a 0
  | smul (a : A) (c : R) (u : FreeLieAlgebra R (Generators B)) (hu : IsHomogeneous a u) : IsHomogeneous a (c • u)
  | add (a : A) (u v : FreeLieAlgebra R (Generators B)) (hu : IsHomogeneous a u) (hv : IsHomogeneous a v) : IsHomogeneous a (u + v)
  | bracket (a b : A) (u v : FreeLieAlgebra R (Generators B)) (hu : IsHomogeneous a u) (hv : IsHomogeneous b v) :
      IsHomogeneous (a + b) ⁅u, v⁆

/-- The homogeneous submodule of degree `a`. -/
def HomogeneousSubmodule (a : A) : Submodule R (FreeLieAlgebra R (Generators B)) where
  carrier := { u | IsHomogeneous w a u }
  add_mem' hu hv := IsHomogeneous.add a _ _ hu hv
  zero_mem' := IsHomogeneous.zero a
  smul_mem' c u hu := IsHomogeneous.smul a c u hu

/-- Brackets of homogeneous submodules add their degrees. -/
theorem bracket_homogeneous (a b : A) (u v : FreeLieAlgebra R (Generators B))
    (hu : u ∈ HomogeneousSubmodule w a) (hv : v ∈ HomogeneousSubmodule w b) :
    ⁅u, v⁆ ∈ HomogeneousSubmodule w (a + b) :=
  IsHomogeneous.bracket a b u v hu hv

/-- A Lie Ideal is homogeneous if it is generated by homogeneous elements. -/
def IsHomogeneousIdeal (I : LieIdeal R (FreeLieAlgebra R (Generators B))) : Prop :=
  ∀ u ∈ I, ∃ (parts : A → FreeLieAlgebra R (Generators B)), 
    (∀ a, IsHomogeneous w a (parts a)) ∧ 
    (∃ (s : Finset A), u = ∑ a in s, parts a)

/-- 3. If a set of generators is homogeneous, the ideal they generate is homogeneous. -/
theorem span_homogeneous_is_homogeneous {S : Set (FreeLieAlgebra R (Generators B))}
    (hS : ∀ s ∈ S, ∃ a : A, IsHomogeneous w a s) :
    IsHomogeneousIdeal w (LieSubmodule.lieSpan R (FreeLieAlgebra R (Generators B)) S) := by
  -- The proof follows from the fact that lieSpan of homogeneous elements is closed under brackets and linear combinations.
  sorry

/-- The Root Lattice Height function. -/
variable (height : A → ℕ)
variable (height_add : ∀ a b, height (a + b) ≤ height a + height b)

/-- 4. Height cutoffs for the Free Lie Algebra. -/
def HeightCutoff (N : ℕ) : Submodule R (FreeLieAlgebra R (Generators B)) :=
  ⨆ (a : A) (_ : height a ≤ N), HomogeneousSubmodule w a

/-- The bracket of two cutoffs lands in the summed cutoff. -/
theorem cutoff_bracket (N M : ℕ) (u v : FreeLieAlgebra R (Generators B))
    (hu : u ∈ HeightCutoff w height N) (hv : v ∈ HeightCutoff w height M) :
    ⁅u, v⁆ ∈ HeightCutoff w height (N + M) := by
  -- Follows from bracket_homogeneous and height_add.
  sorry

/-- 5. The projection of the cutoff to the Serre quotient algebra. -/
def SerreCutoff (CM : CartanMatrix B ℤ) (N : ℕ) : 
    Submodule R (FreeLieAlgebra R _ ⧸ CartanMatrix.Relations.toIdeal R CM) :=
  Submodule.map (LieIdeal.quotientMap _ _).toLinearMap (HeightCutoff w height N)

theorem serre_cutoff_bracket (CM : CartanMatrix B ℤ) (N M : ℕ) 
    (u v : FreeLieAlgebra R _ ⧸ CartanMatrix.Relations.toIdeal R CM)
    (hu : u ∈ SerreCutoff w height CM N) (hv : v ∈ SerreCutoff w height CM M) :
    ⁅u, v⁆ ∈ SerreCutoff w height CM (N + M) := by
  sorry

end InfoGeometry.Lie.Serre
