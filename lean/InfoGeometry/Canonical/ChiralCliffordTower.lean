import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Matrix.Mul
import Mathlib.Algebra.Ring.Basic
import Mathlib.Tactic
import InfoGeometry.Krein.TomitaMatrixAtom

open Matrix
open InfoGeometry.Krein.TomitaMatrixAtom

set_option linter.unusedSimpArgs false

namespace InfoGeometry.CliffordTower

variable {R : Type*} [CommRing R]

/-! ### 2. The Chiral Tensor Product Cℓ(1, 1)_R ⊗ Cℓ(1, 1)_L ≅ Mat(4, ℝ) -/

/-- Kronecker (tensor) product of two 2x2 matrices into a 4x4 matrix. -/
def kron2 (A B : Matrix (Fin 2) (Fin 2) R) : Matrix (Fin 4) (Fin 4) R :=
  fun i j =>
    let i_R : Fin 2 := ⟨i.val / 2, by omega⟩
    let i_L : Fin 2 := ⟨i.val % 2, by omega⟩
    let j_R : Fin 2 := ⟨j.val / 2, by omega⟩
    let j_L : Fin 2 := ⟨j.val % 2, by omega⟩
    A i_R j_R * B i_L j_L

lemma kron2_mul (A₁ A₂ B₁ B₂ : Matrix (Fin 2) (Fin 2) R) :
    kron2 (A₁ * A₂) (B₁ * B₂) = kron2 A₁ B₁ * kron2 A₂ B₂ := by
  ext i j
  dsimp [kron2, Matrix.mul_apply]
  revert i j
  intro i j
  fin_cases i <;> fin_cases j <;> simp [Fin.sum_univ_four, Fin.sum_univ_succ] <;> ring

/-! ### 3. Right- and Left-Handed Chiral Embeddings -/

/-- Right-handed chiral generator e_R = ℓ₊ ⊗ 1. -/
def e_R : Matrix (Fin 4) (Fin 4) ℝ := kron2 ellPlus 1

/-- Left-handed chiral generator e_L = 1 ⊗ ℓ₊. -/
def e_L : Matrix (Fin 4) (Fin 4) ℝ := kron2 1 ellPlus

/-- The total chiral Krein metric η_tot = ε ⊗ ε. -/
def eta_tot : Matrix (Fin 4) (Fin 4) ℝ := kron2 eps eps

@[simp] theorem e_R_sq : (e_R) * e_R = 0 := by
  dsimp [e_R]
  rw [← kron2_mul, ellPlus_square_zero, mul_one]
  ext i j; dsimp [kron2]; rw [zero_mul]

@[simp] theorem e_L_sq : (e_L) * e_L = 0 := by
  dsimp [e_L]
  rw [← kron2_mul, mul_one, ellPlus_square_zero]
  ext i j; dsimp [kron2]; rw [mul_zero]

/-- Cross-Chiral Commutation: Right- and Left-handed null generators commute. -/
theorem e_R_comm_e_L : (e_R) * e_L = e_L * e_R := by
  dsimp [e_R, e_L]
  rw [← kron2_mul, ← kron2_mul]
  simp

/-! ### 4. The Klein Quadric / On-Shell Plücker Identity -/

/-- A decomposable chiral 2-blade (bivector in twistor space): P = e_R * e_L. -/
def chiralBivector : Matrix (Fin 4) (Fin 4) ℝ :=
  e_R * e_L

/-- Master Theorem (On-Shell Klein Quadric Vanishing):
    The decomposable chiral bivector generated by the Cℓ(1, 1)_R ⊗ Cℓ(1, 1)_L pair
    is strictly nilpotent: P² = 0. -/
theorem chiral_bivector_on_shell :
    (chiralBivector) * chiralBivector = 0 := by
  dsimp [chiralBivector]
  rw [mul_assoc e_R e_L (e_R * e_L)]
  rw [← mul_assoc e_L e_R e_L]
  rw [← e_R_comm_e_L]
  rw [mul_assoc e_R e_L e_L]
  rw [← mul_assoc e_R e_R (e_L * e_L)]
  rw [e_R_sq, zero_mul]

/-- Invariance of the total Krein metric under chiral reflection: η_tot² = 1. -/
theorem eta_tot_involutive :
    (eta_tot) * eta_tot = 1 := by
  dsimp [eta_tot]
  rw [← kron2_mul, eps_sq]
  ext i j
  dsimp [kron2]
  fin_cases i <;> fin_cases j <;> norm_num

end InfoGeometry.CliffordTower
