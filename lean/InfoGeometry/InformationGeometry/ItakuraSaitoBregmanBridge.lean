import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Tactic

/-!
# Itakura–Saito Divergence as the Bregman Divergence of the Logarithmic Barrier

This module formalizes:
1. The Itakura–Saito (IS) divergence: d_IS(x, y) = x/y - log(x/y) - 1.
2. The Bregman divergence generated by the self-concordant barrier F(x) = -log(x):
     D_{-log}(x, y) = (-log x) - (-log y) - (-y⁻¹)(x - y).
3. THEOREM (Exact Equivalence): D_{-log}(x, y) = d_IS(x, y).
4. THEOREM (Strict Non-Negativity): d_IS(x, y) ≥ 0 with d_IS(x, x) = 0.
5. THEOREM (Weyl Scale Invariance): d_IS(c*x, c*y) = d_IS(x, y) for all c > 0.

All proofs are complete in native Mathlib with zero `sorry`s and zero custom axioms.
-/

noncomputable section

namespace InfoGeometry.InformationGeometry.ItakuraSaito

/-!
=============================================================================
PART 1: Definitions of Itakura–Saito and Bregman Logarithmic Divergences
=============================================================================
-/

/-- The Itakura–Saito (IS) Divergence: d_IS(x, y) = x/y - log(x/y) - 1. -/
def isDivergence (x y : ℝ) : ℝ :=
  x / y - Real.log (x / y) - 1

/-- 
  The Bregman Divergence generated by the Self-Concordant Barrier F(x) = -log(x):
  D_{-log}(x, y) = F(x) - F(y) - F'(y) * (x - y)
  with F'(y) = - 1/y.
-/
def bregmanNegLog (x y : ℝ) : ℝ :=
  (- Real.log x) - (- Real.log y) - (- y⁻¹) * (x - y)

/-!
=============================================================================
PART 2: Proven Equivalence Theorem
=============================================================================
-/

/-- 
  THEOREM 1: The Bregman divergence of the negative logarithm is identically
  the Itakura–Saito divergence:
    D_{-log}(x, y) = d_IS(x, y)
-/
theorem bregmanNegLog_eq_isDivergence (x y : ℝ) (hx : 0 < x) (hy : 0 < y) :
    bregmanNegLog x y = isDivergence x y := by
  dsimp [bregmanNegLog, isDivergence]
  rw [Real.log_div (ne_of_gt hx) (ne_of_gt hy)]
  have h_linear : (- y⁻¹) * (x - y) = - (x / y) + 1 := by
    calc
      (- y⁻¹) * (x - y) = - (y⁻¹ * (x - y)) := by ring
      _ = - (y⁻¹ * x - y⁻¹ * y) := by rw [mul_sub]
      _ = - (x / y - 1) := by
        have h_cancel : y⁻¹ * y = 1 := inv_mul_cancel₀ (ne_of_gt hy)
        rw [h_cancel, mul_comm, div_eq_mul_inv]
      _ = - (x / y) + 1 := by ring
  rw [h_linear]
  ring

/-!
=============================================================================
PART 3: Non-Negativity and Minimum of the Itakura–Saito Divergence
=============================================================================
-/

/-- 
  THEOREM 2 (Strict Non-Negativity of the Itakura–Saito Divergence):
  d_IS(x, y) ≥ 0  for all x, y > 0
  Proven from the fundamental logarithm bound log(u) ≤ u - 1 with u = x/y.
-/
theorem isDivergence_nonneg (x y : ℝ) (hx : 0 < x) (hy : 0 < y) :
    0 ≤ isDivergence x y := by
  let u := x / y
  have hu : 0 < u := div_pos hx hy
  have h_log_bound := Real.log_le_sub_one_of_pos hu
  dsimp [isDivergence]
  linarith

/-- 
  THEOREM 3 (Identity of Indiscernibles):
  d_IS(x, x) = 0
-/
@[simp]
theorem isDivergence_self (x : ℝ) (hx : 0 < x) :
    isDivergence x x = 0 := by
  dsimp [isDivergence]
  rw [div_self (ne_of_gt hx), Real.log_one]
  ring

/-!
=============================================================================
PART 4: Weyl Scale Invariance
=============================================================================
-/

/-- 
  THEOREM 4 (Weyl Scale Invariance):
  The Itakura–Saito divergence is strictly scale-invariant under global dilations:
    d_IS(c * x, c * y) = d_IS(x, y)  for all c > 0.
-/
theorem isDivergence_weyl_scale_invariant
    (x y c : ℝ) (_hx : 0 < x) (_hy : 0 < y) (hc : 0 < c) :
    isDivergence (c * x) (c * y) = isDivergence x y := by
  dsimp [isDivergence]
  rw [mul_div_mul_left x y (ne_of_gt hc)]

end InfoGeometry.InformationGeometry.ItakuraSaito

end noncomputable section
