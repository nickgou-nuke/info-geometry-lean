  deriving DecidableEq, Repr

namespace ParaKahlerModularNoetherStage

/-- Topological rank of each stage in `ParaKahlerModularNoetherStage` (`0` through `9`). -/
def rank : ParaKahlerModularNoetherStage → ℕ
  | M1_ParaKahlerHessianAndCurvature2Form => 0
  | M2_ModularSurprisalAndBregmanThreePoint => 1
  | M3_DraggedFrameAndOnsagerReciprocity => 2
  | M4_CircularlyPolarizedLightConeAndFaradayGyrotropy => 3
  | M5_FourWaveMixingAndZakharovShabatNLSLaxPair => 4
  | M6_UnruhRindlerBoostAndWedgeLadder => 5
  | M7_ModularSurprisalSpaceChargeAndVerlindeEntropicForce => 6
  | M8_OperatorKillingFieldsAndNoetherCentralizer => 7
  | M9_HelmholtzHodgeIrrotationalAndRotationalLieFlows => 8
  | M10_MasterParaKahlerBregmanModularNoetherSynthesis => 9

theorem rank_injective : Function.Injective rank := by
  intro x y h
  cases x <;> cases y <;> cases h <;> rfl

instance : LinearOrder ParaKahlerModularNoetherStage :=
  LinearOrder.lift' rank rank_injective

/-- Directed causal cover relation `u ≺ v` in the 10-stage poset (`M₁ → M₁₀`). -/
inductive causalEdge : ParaKahlerModularNoetherStage → ParaKahlerModularNoetherStage → Prop
  | m1_to_m2 :
      causalEdge M1_ParaKahlerHessianAndCurvature2Form M2_ModularSurprisalAndBregmanThreePoint
  | m2_to_m3 :
      causalEdge M2_ModularSurprisalAndBregmanThreePoint M3_DraggedFrameAndOnsagerReciprocity
  | m1_to_m4 :
      causalEdge M1_ParaKahlerHessianAndCurvature2Form
        M4_CircularlyPolarizedLightConeAndFaradayGyrotropy
  | m4_to_m5 :
      causalEdge M4_CircularlyPolarizedLightConeAndFaradayGyrotropy
        M5_FourWaveMixingAndZakharovShabatNLSLaxPair
  | m1_to_m6 :
      causalEdge M1_ParaKahlerHessianAndCurvature2Form M6_UnruhRindlerBoostAndWedgeLadder
  | m6_to_m7 :
      causalEdge M6_UnruhRindlerBoostAndWedgeLadder
        M7_ModularSurprisalSpaceChargeAndVerlindeEntropicForce
  | m7_to_m8 :
      causalEdge M7_ModularSurprisalSpaceChargeAndVerlindeEntropicForce
        M8_OperatorKillingFieldsAndNoetherCentralizer
  | m3_to_m9 :
      causalEdge M3_DraggedFrameAndOnsagerReciprocity
        M9_HelmholtzHodgeIrrotationalAndRotationalLieFlows
  | m5_to_m10 :
      causalEdge M5_FourWaveMixingAndZakharovShabatNLSLaxPair
        M10_MasterParaKahlerBregmanModularNoetherSynthesis
  | m8_to_m10 :
      causalEdge M8_OperatorKillingFieldsAndNoetherCentralizer
        M10_MasterParaKahlerBregmanModularNoetherSynthesis
  | m9_to_m10 :
      causalEdge M9_HelmholtzHodgeIrrotationalAndRotationalLieFlows
        M10_MasterParaKahlerBregmanModularNoetherSynthesis

theorem causalEdge_strict_rank_mono {u v : ParaKahlerModularNoetherStage}
    (h : causalEdge u v) : rank u < rank v := by
  cases h <;> decide

theorem causalEdge_le {u v : ParaKahlerModularNoetherStage}
    (h : causalEdge u v) : u ≤ v :=
  Nat.le_of_lt (causalEdge_strict_rank_mono h)

theorem transGen_causalEdge_strict_rank_mono {u v : ParaKahlerModularNoetherStage}
    (h : Relation.TransGen causalEdge u v) : rank u < rank v := by
  induction h with
  | single h_edge => exact causalEdge_strict_rank_mono h_edge
  | tail _ h_edge ih => exact Nat.lt_trans ih (causalEdge_strict_rank_mono h_edge)

theorem causalEdge_acyclic (u : ParaKahlerModularNoetherStage) :
    ¬ Relation.TransGen causalEdge u u := by
  intro h
  exact Nat.lt_irrefl (rank u) (transGen_causalEdge_strict_rank_mono h)

end ParaKahlerModularNoetherStage

/-! ### Stage 1: Core Operator Primitives for Bregman Divergence, Onsager Cross-Diffusion, NLS Lax Pair, and Lie Flows -/

/-- Non-commutative quadratic Bregman operator divergence `D_B(X, Y) := (X - Y) * (X - Y)`. -/
def opBregmanDiv (X Y : B) : B :=
  (X - Y) * (X - Y)

/-- Symmetrized Onsager reciprocal cross-diffusion operator
`L_{Φ,J}(X) := [Φ, [J, X]] + [J, [Φ, X]]`. -/
def onsagerCrossOp (P A C X : B) : B :=
  comm (genPhi P A C) (comm (genJ P A C) X) + comm (genJ P A C) (comm (genPhi P A C) X)

/-- Spatial Lax operator `L_NLS := Σ + Φ` of the two-sheeted non-commutative Zakharov–Shabat
nonlinear Schrödinger (NLS) Lax pair. -/
def nlsLaxL (P A C : B) : B :=
  genSig P A C + genPhi P A C

/-- Temporal/dispersive Lax operator `M_NLS := V * Σ` of the two-sheeted non-commutative
Zakharov–Shabat nonlinear Schrödinger (NLS) Lax pair. -/
def nlsLaxM (P A C : B) : B :=
  genV P A C * genSig P A C

/-- Irrotational (symmetric Jordan-cone) inner Lie derivation `L_irr(X) := [Φ, X]`. -/
def irrotationalLieFlow (P A C X : B) : B :=
  comm (genPhi P A C) X

/-- Rotational (skew-Hermitian dipole) inner Lie derivation `L_rot(X) := [J, X]`. -/
def rotationalLieFlow (P A C X : B) : B :=
  comm (genJ P A C) X

/-! ### Archetype M₁: Para-Kähler Fisher Curvature 2-Form & Symmetric Hessian Decomposition -/

/-- **Archetype `M₁` (Para-Kähler Hessian & Symplectic Curvature 2-Form Decomposition):**
For any idempotent `P * P = P` and elements `A, C, X : B`:
1. The commutator of the forward (`ad_{N_+}`) and backward (`ad_{N_-}`) off-diagonal Peirce
   derivations equals the inner derivation of the chiral symplectic generator `Σ = [N_+, N_-]`:
   `[N_+, [N_-, X]] - [N_-, [N_+, X]] = [Σ, X]`.
2. Twice the symmetric Para-Kähler Hessian sum `[N_+, [N_-, X]] + [N_-, [N_+, X]]` equals the
   negative sum of the Jordan (`ad_Φ²`) and Lie (`ad_J²`) double derivations:
   `2 • ([N_+, [N_-, X]] + [N_-, [N_+, X]]) = -(derivSqPhi P A C X + derivSqJ P A C X)`.
3. The difference `derivSqPhi P A C X - derivSqJ P A C X` isolates four times the same-cone
   sandwich `4 • sandwichSame P A C X`. -/
theorem archetype_M1_parakahler_hessian_and_curvature_2form
    {P : B} (hP : P * P = P) (A C X : B) :
    comm (conePlus P A) (comm (coneMinus P C) X) -
        comm (coneMinus P C) (comm (conePlus P A) X) =
      comm (genSig P A C) X ∧
    (2 : ℤ) • (comm (conePlus P A) (comm (coneMinus P C) X) +
        comm (coneMinus P C) (comm (conePlus P A) X)) =
      -(derivSqPhi P A C X + derivSqJ P A C X) ∧
    derivSqPhi P A C X - derivSqJ P A C X =
      (4 : ℤ) • sandwichSame P A C X := by
  refine ⟨?_, ?_, ?_⟩
  · peirce_nf hP
  · simp only [derivSqPhi, derivSqJ]
    peirce_nf hP
  · simp only [derivSqPhi, derivSqJ, sandwichSame]
    peirce_nf hP

/-! ### Archetype M₂: Modular Hamiltonian, Massieu–Planck Dual & Non-Commutative Bregman Three-Point Identity -/

/-- **Archetype `M₂` (Modular Surprisal, Massieu–Planck Dual & Non-Commutative Bregman Three-Point Identity):**
In any non-commutative ring `[Ring B]` with idempotent `P * P = P`:
1. **Universal Non-Commutative Bregman Three-Point Identity:**
   `D_B(X, Z) - D_B(X, Y) - D_B(Y, Z) = {X - Y, Y - Z}` for all `X, Y, Z : B`.
2. **Same-Cone Pythagorean Additivity:**
   `{N_+(A₁), N_+(A₂)} = 0` and `{N_-(C₁), N_-(C₂)} = 0`, so
   `D_B(N_+(A₁), -N_+(A₂)) = 0` and `D_B(N_-(C₁), -N_-(C₂)) = 0`.
3. **Null-Cone Bregman Vanishing & Primal–Dual Norm Coincidence:**
   `D_B(Φ, -J) = 0`, `D_B(J, -Φ) = 0`, `Σ² = V²`, and `[Σ, V] = 0`. -/
theorem archetype_M2_modular_surprisal_and_bregman_three_point
    {P : B} (hP : P * P = P) (A C A₁ A₂ C₁ C₂ X Y Z : B) :
    opBregmanDiv X Z - opBregmanDiv X Y - opBregmanDiv Y Z =
      anticomm (X - Y) (Y - Z) ∧
    anticomm (conePlus P A₁) (conePlus P A₂) = 0 ∧
    anticomm (coneMinus P C₁) (coneMinus P C₂) = 0 ∧
    opBregmanDiv (genPhi P A C) (-genJ P A C) = 0 ∧
    opBregmanDiv (genJ P A C) (-genPhi P A C) = 0 ∧
    genSig P A C * genSig P A C = genV P A C * genV P A C ∧
    comm (genSig P A C) (genV P A C) = 0 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp only [opBregmanDiv, anticomm]
    noncomm_ring
  · peirce_nf hP
  · peirce_nf hP
  · simp only [opBregmanDiv]
    peirce_nf hP
  · simp only [opBregmanDiv]
    peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP

/-! ### Archetype M₃: Dragged-Frame Cross-Correlation & Onsager Reciprocal Cross-Diffusion -/

/-- **Archetype `M₃` (Dragged-Frame Cross-Correlation & Onsager Reciprocal Cross-Diffusion):**
For any idempotent `P * P = P` and elements `A, C : B`:
1. The dragged-frame modular fluxes `F_Φ := [Σ, Φ]` and `F_J := [Σ, J]` anticommute (`{F_Φ, F_J} = 0`),
   have opposite squares (`F_J² + F_Φ² = 0`), and satisfy the exact cross-correlation identity
   `F_J * F_Φ = -4 • ((V * V) * Σ)`.
2. The symmetrized Onsager cross-diffusion operator `L_{Φ,J}(X) = [Φ, [J, X]] + [J, [Φ, X]]`
   annihilates the block-diagonal centralizer invariants (`L_{Φ,J}(V) = 0`, `L_{Φ,J}(Σ) = 0`) and
   acts on the off-diagonal dipole pair `(Φ, J)` by exact reciprocal cross-diffusion with opposite
   signs:
   `L_{Φ,J}(Φ) = -4 • (V * J)` and `L_{Φ,J}(J) = 4 • (V * Φ)`. -/
theorem archetype_M3_dragged_frame_and_onsager_reciprocity
    {P : B} (hP : P * P = P) (A C : B) :
    anticomm (comm (genSig P A C) (genPhi P A C)) (comm (genSig P A C) (genJ P A C)) = 0 ∧
    comm (genSig P A C) (genJ P A C) * comm (genSig P A C) (genJ P A C) +
        comm (genSig P A C) (genPhi P A C) * comm (genSig P A C) (genPhi P A C) = 0 ∧
    comm (genSig P A C) (genJ P A C) * comm (genSig P A C) (genPhi P A C) =
      -((4 : ℤ) • ((genV P A C * genV P A C) * genSig P A C)) ∧
    onsagerCrossOp P A C (genV P A C) = 0 ∧
    onsagerCrossOp P A C (genSig P A C) = 0 ∧
    onsagerCrossOp P A C (genPhi P A C) = -((4 : ℤ) • (genV P A C * genJ P A C)) ∧
    onsagerCrossOp P A C (genJ P A C) = (4 : ℤ) • (genV P A C * genPhi P A C) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · simp only [onsagerCrossOp]; peirce_nf hP
  · simp only [onsagerCrossOp]; peirce_nf hP
  · simp only [onsagerCrossOp]; peirce_nf hP
  · simp only [onsagerCrossOp]; peirce_nf hP

/-! ### Archetype LXXXI: Second-Level Nilpotent Ladders and Elliptic/Hyperbolic Squares -/

/-- The lowering and raising mixed double-commutator maps on the chiral block pair. -/
def ladderMinusOp (P A C X : B) : B :=
  comm (genPhi P A C) (comm (genJ P A C) X)

def ladderPlusOp (P A C X : B) : B :=
  comm (genJ P A C) (comm (genPhi P A C) X)

/-- The sum and difference of the second-level chiral ladder maps. -/
def ladderSumOp (P A C X : B) : B :=
  ladderMinusOp P A C X + ladderPlusOp P A C X

def ladderDiffOp (P A C X : B) : B :=
  ladderMinusOp P A C X - ladderPlusOp P A C X

/-- **Archetype LXXXI (second-level chiral ladder recursion).**
The mixed double commutators act nilpotently on `Φ` and `J`; their sum has
negative square and their difference has positive square, both with magnitude
`16 V²`. The difference also equals the Jacobi commutator `-2 ad_Σ` on every
operator. -/
theorem archetype_LXXXI_second_level_superoperator_ladder_recursion
    {P : B} (hP : P * P = P) (A C X : B) :
    ladderMinusOp P A C (genPhi P A C) = -((4 : ℤ) • (genV P A C * genJ P A C)) ∧
    ladderMinusOp P A C (genJ P A C) = 0 ∧
    ladderPlusOp P A C (genJ P A C) = (4 : ℤ) • (genV P A C * genPhi P A C) ∧
    ladderPlusOp P A C (genPhi P A C) = 0 ∧
    ladderMinusOp P A C (ladderMinusOp P A C (genPhi P A C)) = 0 ∧
    ladderMinusOp P A C (ladderMinusOp P A C (genJ P A C)) = 0 ∧
    ladderPlusOp P A C (ladderPlusOp P A C (genPhi P A C)) = 0 ∧
    ladderPlusOp P A C (ladderPlusOp P A C (genJ P A C)) = 0 ∧
    ladderDiffOp P A C X = -((2 : ℤ) • comm (genSig P A C) X) ∧
    ladderSumOp P A C (ladderSumOp P A C (genPhi P A C)) =
      -((16 : ℤ) • ((genV P A C * genV P A C) * genPhi P A C)) ∧
    ladderSumOp P A C (ladderSumOp P A C (genJ P A C)) =
      -((16 : ℤ) • ((genV P A C * genV P A C) * genJ P A C)) ∧
    ladderDiffOp P A C (ladderDiffOp P A C (genPhi P A C)) =
      (16 : ℤ) • ((genV P A C * genV P A C) * genPhi P A C) ∧
    ladderDiffOp P A C (ladderDiffOp P A C (genJ P A C)) =
      (16 : ℤ) • ((genV P A C * genV P A C) * genJ P A C) := by
  simp only [ladderMinusOp, ladderPlusOp, ladderSumOp, ladderDiffOp]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    peirce_nf hP

/-! ### Archetype M₄: Circularly Polarized Light-Cone Eigenmodes & Non-Abelian Faraday Rotation -/

/-- **Archetype `M₄` (Circularly Polarized Light-Cone Eigenmodes & Non-Abelian Faraday Rotation):**
For any idempotent `P * P = P` and elements `A, C : B`:
1. The nilpotent light-cone rays `N_+ = P A (1 - P)` and `N_- = (1 - P) C P` are opposite-helicity
   circularly polarized eigenmodes of the axial derivation `ad_Σ`:
   `[Σ, N_+] = 2 • (V * N_+)` and `[Σ, N_-] = -(2 • (V * N_-))`.
2. In the linearly polarized basis `Φ = N_+ + N_-` and `J = N_+ - N_-`, `ad_Σ` acts as a
   Faraday gyrotropic rotation mixing `Φ` and `J` with operator refractive weight `2 • V`:
   `[Σ, Φ] = 2 • (V * J)` and `[Σ, J] = 2 • (V * Φ)`.
3. Right-multiplication by `V` obeys the mirror-chirality eigenmode law:
   `[Σ, N_+] = 2 • (N_+ * V)` and `[Σ, N_-] = -(2 • (N_- * V))`. -/
theorem archetype_M4_circularly_polarized_lightcone_and_faraday_gyrotropy
    {P : B} (hP : P * P = P) (A C : B) :
    comm (genSig P A C) (conePlus P A) = (2 : ℤ) • (genV P A C * conePlus P A) ∧
    comm (genSig P A C) (coneMinus P C) = -((2 : ℤ) • (genV P A C * coneMinus P C)) ∧
    comm (genSig P A C) (genPhi P A C) = (2 : ℤ) • (genV P A C * genJ P A C) ∧
    comm (genSig P A C) (genJ P A C) = (2 : ℤ) • (genV P A C * genPhi P A C) ∧
    comm (genSig P A C) (conePlus P A) = (2 : ℤ) • (conePlus P A * genV P A C) ∧
    comm (genSig P A C) (coneMinus P C) = -((2 : ℤ) • (coneMinus P C * genV P A C)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> peirce_nf hP

/-! ### Archetype M₅: Focusing vs. Defocusing Four-Wave Mixing & Zakharov–Shabat NLS Lax Pair -/

/-- **Archetype `M₅` (Focusing vs. Defocusing Four-Wave Mixing & Two-Sheeted Zakharov–Shabat NLS Lax Pair):**
For any idempotent `P * P = P` and elements `A, C : B`:
1. **Focusing vs. Defocusing Self-Phase Modulation (4-Wave Mixing Cubics):**
   `Φ * Φ * Φ = V * Φ` (focusing cubic self-interaction) and
   `J * J * J = -(V * J)` (defocusing cubic self-interaction).
2. **Cross-Phase Modulation (XPM) Sandwich Cubics:**
   `Φ * J * Φ = -(V * J)` and `J * Φ * J = V * Φ`.
3. **Two-Sheeted Non-Commutative Zakharov–Shabat NLS Lax Pair:**
   The spatial Lax operator `L_NLS = Σ + Φ` and temporal dispersive Lax operator `M_NLS = V * Σ`
   satisfy the exact zero-curvature Lax commutator identity
   `[L_NLS, M_NLS] = -(2 • ((V * V) * J))`. -/
theorem archetype_M5_four_wave_mixing_and_zakharov_shabat_nls_lax_pair
    {P : B} (hP : P * P = P) (A C : B) :
    genPhi P A C * genPhi P A C * genPhi P A C = genV P A C * genPhi P A C ∧
    genJ P A C * genJ P A C * genJ P A C = -(genV P A C * genJ P A C) ∧
    genPhi P A C * genJ P A C * genPhi P A C = -(genV P A C * genJ P A C) ∧
    genJ P A C * genPhi P A C * genJ P A C = genV P A C * genPhi P A C ∧
    comm (nlsLaxL P A C) (nlsLaxM P A C) =
      -((2 : ℤ) • ((genV P A C * genV P A C) * genJ P A C)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · simp only [nlsLaxL, nlsLaxM]; peirce_nf hP

/-! ### Archetype M₆: Unruh Rindler Boost Generator `S_P`, Wedge Partition & Boost Eigenvalue Ladder -/

/-- **Archetype `M₆` (Unruh Rindler Boost Generator `S_P`, Wedge Partition & Boost Eigenvalue Ladder):**
For any idempotent `P * P = P` and elements `A, C : B`:
1. The grading involution `S_P = 2P - 1` satisfies `S_P² = 1` and splits the unit into orthogonal
   right (`P`) and left (`1 - P`) Rindler wedge projectors: `P + (1 - P) = 1`, `P - (1 - P) = S_P`.
2. `ad_{S_P}` acts on the light-cone rays `N_+` and `N_-` with opposite boost eigenvalues `±2`:
   `[S_P, N_+] = 2 • N_+` and `[S_P, N_-] = -(2 • N_-)`.
3. `ad_{S_P}` generates a hyperbolic Rindler boost on `(Φ, J)`:
   `[S_P, Φ] = 2 • J`, `[S_P, J] = 2 • Φ`, with boost Casimir eigenvalue `4`:
   `[S_P, [S_P, Φ]] = 4 • Φ` and `[S_P, [S_P, J]] = 4 • J`. -/
theorem archetype_M6_unruh_rindler_boost_and_wedge_ladder
    {P : B} (hP : P * P = P) (A C : B) :
    invS P * invS P = 1 ∧
    P - (1 - P) = invS P ∧
    comm (invS P) (conePlus P A) = (2 : ℤ) • conePlus P A ∧
    comm (invS P) (coneMinus P C) = -((2 : ℤ) • coneMinus P C) ∧
    comm (invS P) (genPhi P A C) = (2 : ℤ) • genJ P A C ∧
    comm (invS P) (genJ P A C) = (2 : ℤ) • genPhi P A C ∧
    comm (invS P) (comm (invS P) (genPhi P A C)) = (4 : ℤ) • genPhi P A C ∧
    comm (invS P) (comm (invS P) (genJ P A C)) = (4 : ℤ) • genJ P A C := by
  refine ⟨?_, rfl, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> peirce_nf hP

/-! ### Archetype M₇: Modular Surprisal `Σ = S_P V`, Space-Charge Dipole & Verlinde Entropic Acceleration -/

/-- **Archetype `M₇` (Modular Surprisal `Σ = S_P V`, Space-Charge Dipole `J` & Verlinde Entropic Acceleration):**
For any idempotent `P * P = P` and elements `A, C : B`:
1. **Modular Surprisal Factorization:**
   The chiral symplectic generator `Σ = [N_+, N_-]` factors as the product of the Rindler boost
   involution `S_P` and the symmetric energy-density operator `V = {N_+, N_-}`:
   `Σ = S_P * V = V * S_P`.
2. **Space-Charge Gauss Divergence & Defocusing Potential:**
   The dipole operator `J = N_+ - N_-` satisfies `[S_P, J] = 2 • Φ` and `J * J = -V`.
3. **Verlinde Entropic Acceleration & Second-Variation Identities:**
   The modular flow `[Σ, X]` factors as the product of the centralizer temperature/metric weight `V`
   and the Rindler boost gradient `[S_P, X]`:
   `[Σ, Φ] = V * [S_P, Φ]`, `[Σ, J] = V * [S_P, J]`, and at second order:
   `derivSqSig P A C (genPhi P A C) = V * derivSqJ P A C (genPhi P A C)` and
   `derivSqSig P A C (genJ P A C) = V * derivSqPhi P A C (genJ P A C)`. -/
theorem archetype_M7_modular_surprisal_space_charge_and_verlinde_entropic_force
    {P : B} (hP : P * P = P) (A C : B) :
    genSig P A C = invS P * genV P A C ∧
    genSig P A C = genV P A C * invS P ∧
    comm (invS P) (genJ P A C) = (2 : ℤ) • genPhi P A C ∧
    genJ P A C * genJ P A C = -genV P A C ∧
    comm (genSig P A C) (genPhi P A C) = genV P A C * comm (invS P) (genPhi P A C) ∧
    comm (genSig P A C) (genJ P A C) = genV P A C * comm (invS P) (genJ P A C) ∧
    derivSqSig P A C (genPhi P A C) = genV P A C * derivSqJ P A C (genPhi P A C) ∧
    derivSqSig P A C (genJ P A C) = genV P A C * derivSqPhi P A C (genJ P A C) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · simp only [derivSqSig, derivSqJ]; peirce_nf hP
  · simp only [derivSqSig, derivSqPhi]; peirce_nf hP

/-! ### Archetype M₈: Operator Killing Fields & All-Depth Conserved Noether Centralizer -/

/-- **Archetype `M₈` (Operator Killing Fields & All-Depth Conserved Noether Centralizer):**
For any idempotent `P * P = P` and elements `A, C : B`:
1. Both the symmetric metric generator `V = {N_+, N_-}` and the chiral modular generator
   `Σ = [N_+, N_-]` act as Killing derivations (`[V, Q] = 0` and `[Σ, Q] = 0`) on the entire
   conserved Noether charge family:
   `Q ∈ {P, S_P, V, Σ, Q_+, Q_-, δ(V)}`.
2. **Leibniz Product Closure of the Killing–Noether Centralizer:**
   For any generator `G : B` and conserved charges `X, Y : B`, if `[G, X] = 0` and `[G, Y] = 0`,
   then `[G, X * Y] = 0`. -/
theorem archetype_M8_operator_killing_fields_and_noether_centralizer
    {P : B} (hP : P * P = P) (A C : B) :
    (comm (genV P A C) P = 0 ∧ comm (genSig P A C) P = 0) ∧
    (comm (genV P A C) (invS P) = 0 ∧ comm (genSig P A C) (invS P) = 0) ∧
    (comm (genV P A C) (genV P A C) = 0 ∧ comm (genSig P A C) (genSig P A C) = 0) ∧
    (comm (genV P A C) (genSig P A C) = 0 ∧ comm (genSig P A C) (genV P A C) = 0) ∧
    (comm (genV P A C) (qgtPlus P A C) = 0 ∧ comm (genSig P A C) (qgtPlus P A C) = 0) ∧
    (comm (genV P A C) (qgtMinus P A C) = 0 ∧ comm (genSig P A C) (qgtMinus P A C) = 0) ∧
    (comm (genV P A C) (idempotencyDefect (genV P A C)) = 0 ∧
      comm (genSig P A C) (idempotencyDefect (genV P A C)) = 0) ∧
    (∀ G X Y : B, comm G X = 0 → comm G Y = 0 → comm G (X * Y) = 0) := by
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ?_⟩
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · peirce_nf hP
  · simp only [qgtPlus]; peirce_nf hP
  · simp only [qgtPlus]; peirce_nf hP
  · simp only [qgtMinus]; peirce_nf hP
  · simp only [qgtMinus]; peirce_nf hP
  · simp only [idempotencyDefect]; peirce_nf hP
  · simp only [idempotencyDefect]; peirce_nf hP
  · intro G X Y hX hY
    calc
      comm G (X * Y) = comm G X * Y + X * comm G Y := by
        dsimp only [comm]
        noncomm_ring
      _ = 0 * Y + X * 0 := by rw [hX, hY]
      _ = 0 := by noncomm_ring

/-! ### Archetype M₉: Helmholtz–Hodge Decomposition of Operator Lie Flows (`ad_Φ` vs. `ad_J`) -/

/-- **Archetype `M₉` (Helmholtz–Hodge Decomposition of Operator Lie Flows: Irrotational `ad_Φ` vs. Rotational `ad_J`):**
For any idempotent `P * P = P` and elements `A, C, X : B`:
1. **Light-Cone Ray Decomposition into Irrotational and Rotational Lie Flows:**
   `2 • [N_+, X] = L_irr(X) + L_rot(X)` and `2 • [N_-, X] = L_irr(X) - L_rot(X)`.
2. **Lie Bracket (Vorticity Curvature) of Irrotational and Rotational Flows:**
   `L_irr(L_rot(X)) - L_rot(L_irr(X)) = -(2 • [Σ, X])`.
3. **Symmetric Anticommutator Bracket (Onsager Cross-Diffusion Recovery):**
   `L_irr(L_rot(X)) + L_rot(L_irr(X)) = L_{Φ,J}(X)`.
4. **Pure Irrotational vs. Rotational Action on `(V, Σ)`:**
   `L_irr(V) = 0`, `L_rot(V) = 0`,
   `L_irr(Σ) = -(2 • (V * J))`, `L_rot(Σ) = -(2 • (V * Φ))`. -/
theorem archetype_M9_helmholtz_hodge_irrotational_and_rotational_lie_flows
    {P : B} (hP : P * P = P) (A C X : B) :
    (2 : ℤ) • comm (conePlus P A) X =
      irrotationalLieFlow P A C X + rotationalLieFlow P A C X ∧
    (2 : ℤ) • comm (coneMinus P C) X =
      irrotationalLieFlow P A C X - rotationalLieFlow P A C X ∧
    irrotationalLieFlow P A C (rotationalLieFlow P A C X) -
        rotationalLieFlow P A C (irrotationalLieFlow P A C X) =
      -((2 : ℤ) • comm (genSig P A C) X) ∧
    irrotationalLieFlow P A C (rotationalLieFlow P A C X) +
        rotationalLieFlow P A C (irrotationalLieFlow P A C X) =
      onsagerCrossOp P A C X ∧
    irrotationalLieFlow P A C (genV P A C) = 0 ∧
    rotationalLieFlow P A C (genV P A C) = 0 ∧
    irrotationalLieFlow P A C (genSig P A C) = -((2 : ℤ) • (genV P A C * genJ P A C)) ∧
    rotationalLieFlow P A C (genSig P A C) = -((2 : ℤ) • (genV P A C * genPhi P A C)) := by
  refine ⟨?_, ?_, ?_, rfl, ?_, ?_, ?_, ?_⟩ <;>
    (simp only [irrotationalLieFlow, rotationalLieFlow]; peirce_nf hP)

