namespace InfoGeometry.Meta.KeywordIndex

inductive Keyword : Type
  | Berezinian
  | Pfaffian
  | BottPeriodicity
  | KANDecomposition
  | CliffordAlgebra
  | AltlandZirnbauer
  | GrothendieckGroup
  | MajoranaBEC
  | TomitaTakesaki
  | MoebiusOrientifold
  | SvozilSectorization
  | VirasoroCentralCharge
  | HodgeKrein

def keyword_to_nat : Keyword → Nat
  | Keyword.Berezinian => 1
  | Keyword.Pfaffian => 2
  | Keyword.BottPeriodicity => 3
  | Keyword.KANDecomposition => 4
  | Keyword.CliffordAlgebra => 5
  | Keyword.AltlandZirnbauer => 6
  | Keyword.GrothendieckGroup => 7
  | Keyword.MajoranaBEC => 8
  | Keyword.TomitaTakesaki => 9
  | Keyword.MoebiusOrientifold => 10
  | Keyword.SvozilSectorization => 11
  | Keyword.VirasoroCentralCharge => 12
  | Keyword.HodgeKrein => 13

def keyword_description : Keyword → String
  | Keyword.Berezinian => "Berezinian (superdeterminant) for GL(1|1) or GL(2|2) preserving STr"
  | Keyword.Pfaffian => "Pfaffian of skew-symmetric tensor chains, Pf(M)^2 = det(M)"
  | Keyword.BottPeriodicity => "Bott Periodicity (8-fold real and 2-fold complex topological cycles)"
  | Keyword.KANDecomposition => "KAN Iwasawa decomposition of Lie flows into Compact, Abelian, Nilpotent"
  | Keyword.CliffordAlgebra => "Clifford Algebras generated by nested tensor chains of real basis spaces"
  | Keyword.AltlandZirnbauer => "Altland-Zirnbauer 10-fold way classification of free fermions"
  | Keyword.GrothendieckGroup => "Grothendieck Group K0 completion of the Fibonacci semigroup to Z[phi]"
  | Keyword.MajoranaBEC => "Bose-Einstein Condensation of Majorana Cooper pairs in the harmonic kernel"
  | Keyword.TomitaTakesaki => "Tomita-Takesaki modular theory and KMS states of Type II_1 factors"
  | Keyword.MoebiusOrientifold => "Moebius Orientifolds and Klein-bottle topological boundary loops"
  | Keyword.SvozilSectorization => "Svozil's Sectorization and Unitarity Breakdown at the infinite colimit"
  | Keyword.VirasoroCentralCharge => "Virasoro Algebra Central Charge c = 14/5 of the parafermionic boundary"
  | Keyword.HodgeKrein => "Hodge-Krein exact, coexact, and harmonic decomposition on Krein spaces"

theorem keyword_to_nat_inj (x y : Keyword) (h : keyword_to_nat x = keyword_to_nat y) : x = y := by
  cases x <;> cases y <;> try rfl
  all_goals { contradiction }

end InfoGeometry.Meta.KeywordIndex
