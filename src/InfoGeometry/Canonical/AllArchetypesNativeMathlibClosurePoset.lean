/-! ===========================================================================
    Part III: Explicit Native Mathlib Bridge Connecting `zornLeibnizDerivation`
    and `zornPairingActionFormula`
    =========================================================================== -/

/-- **Theorem (`zorn_leibniz_derivation_pairing_action_compatibility`)**:
Connects the Zorn grading derivation `D_para(x) = zornCommutator zornParaGrading x`
(`zornLeibnizDerivation`) directly to the metric/symplectic pairing action
(`zornPairingActionFormula`) over any `[CommRing R]`:
1. On the 6D Para-Kähler tangent space `embedVec z`, `D_para(embedVec z) = 2 K(z)`,
2. Evaluated in the 8D Fisher metric pairing `zornFullMetric`, `D_para` induces twice the
   symplectic form:
   `zornFullMetric (zornCommutator zornParaGrading (embedVec z₁)) (embedVec z₂) = 2 * symplecticForm z₁ z₂`,
3. And `D_para` is strictly skew-symmetric with respect to `zornFullMetric` on the entire 8D
   split-octonion algebra `ZornSplitOctonion R`:
   `zornFullMetric (zornCommutator zornParaGrading x) y + zornFullMetric x (zornCommutator zornParaGrading y) = 0`. -/
theorem zorn_leibniz_derivation_pairing_action_compatibility
    {R : Type*} [CommRing R] (x y : ZornSplitOctonion R) (z₁ z₂ : ParaKahlerVec R) :
    zornCommutator zornParaGrading (embedVec z₁) =
      zornSmul (2 : R) (embedVec (paraComplexK z₁)) ∧
    zornFullMetric (zornCommutator zornParaGrading (embedVec z₁)) (embedVec z₂) =
      2 * symplecticForm z₁ z₂ ∧
    zornFullMetric (zornCommutator zornParaGrading x) y +
      zornFullMetric x (zornCommutator zornParaGrading y) = 0 := by
  refine ⟨zorn_paraGrading_commutator_embedVec z₁, ?_, ?_⟩
  · dsimp [zornFullMetric, zornCommutator, zornSub, zornMul, zornParaGrading,
      embedVec, symplecticForm, vec3Dot, vec3Cross]
    ring
  · dsimp [zornFullMetric, zornCommutator, zornSub, zornMul, zornParaGrading,
      vec3Dot, vec3Cross]
    ring

/-! ===========================================================================
    Part IV: Full 27-Stage Native Mathlib Realization & `.proved` Promotion
    of `CanonicalArchetype`
    =========================================================================== -/

/-- Explicit, non-vacuous native Mathlib proposition assigned to each of the 27
constructors of `CanonicalArchetype`. -/
def canonicalArchetypeMathlibClaim : CanonicalArchetype → Prop
  | .colimitLoom =>
      ∀ {B : Type} [Ring B] (P X : B), P * P = P →
        evenGrade P X + oddGrade P X = X
  | .bivectorRotor =>
      ∀ {B : Type} [Ring B] (P A C : B), P * P = P →
        invS P * invS P = 1 ∧ genSig P A C = invS P * genV P A C
  | .zornChiralBilateral =>
      ∀ {B : Type} [Ring B] (P X : B), P * P = P →
        invS P * oddGrade P X * invS P = -oddGrade P X ∧
        invS P * evenGrade P X * invS P = evenGrade P X
  | .fourVectorSoldering =>
      ∀ {B : Type} [Ring B] (P A C : B), P * P = P →
        genPhi P A C * genPhi P A C = genV P A C ∧
        genJ P A C * genJ P A C = -genV P A C ∧
        InfoGeometry.OperatorAlgebra.PeirceSpine.comm (genPhi P A C) (genJ P A C) = -((2 : ℤ) • genSig P A C)
  | .softmaxObstruction =>
      ∀ (M : InfoGeometry.Epistemology.UnifiedAlchemicalSynthesis.Mat2),
        M = !![M 0 0, 0; 0, M 1 1] + chiralBipolar M
  | .chiralBipolarRouting =>
      ∀ (M : InfoGeometry.Epistemology.UnifiedAlchemicalSynthesis.Mat2),
        InfoGeometry.QuantumContext.TransformerLatentSpace.leftProjection * chiralBipolar M =
