{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Singular/MoorePenrose.lean","time":1778390508952,"baseTime":1778390506439,"changes":[{"range":{"start":{"line":94,"character":0},"end":{"line":291,"character":0}},"text":"\nopen InnerProductSpace ContinuousLinearMap\nopen scoped InnerProduct ComplexConjugate\n\nvariable {𝕜 E : Type*}\nvariable [RCLike 𝕜]\nvariable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\n\ntheorem exists_moorePenroseInverse_of_closedRange\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    ∃ (B : E →L[𝕜] E), IsMoorePenroseInverse A B := by\n  classical\n\n  let K : Submodule 𝕜 E := A.ker\n  let R : Submodule 𝕜 E := A.range\n  let Kp : Submodule 𝕜 E := Kᗮ\n\n  -- L0: closed/completed subspaces and their orthogonal projections.\n  haveI : CompleteSpace K := by\n    dsimp [K]\n    exact A.isClosed_ker.completeSpace_coe\n\n  haveI : K.HasOrthogonalProjection := inferInstance\n\n  haveI : CompleteSpace Kp := by\n    dsimp [Kp]\n    infer_instance\n\n  haveI : Kp.HasOrthogonalProjection := by\n    dsimp [Kp]\n    infer_instance\n\n  haveI : CompleteSpace R := by\n    dsimp [R]\n    exact hClosedRange.completeSpace_coe\n\n  haveI : R.HasOrthogonalProjection := inferInstance\n\n  -- The kernel component is killed by A, hence A only sees the Kᗮ component.\n  have hA_on_Kp : ∀ x : E, A (Kp.starProjection x) = A x := by\n    intro x\n    have hsplit :\n        K.starProjection x + Kp.starProjection x = x :=\n      Submodule.starProjection_add_starProjection_orthogonal (K := K) x\n    have hKzero : A (K.starProjection x) = 0 := by\n      have hmem : K.starProjection x ∈ K :=\n        Submodule.starProjection_apply_mem K x\n      change A (K.starProjection x) = 0\n      simpa [K, LinearMap.mem_ker] using hmem\n    calc\n      A (Kp.starProjection x)\n          = A (K.starProjection x + Kp.starProjection x) := by\n              rw [map_add, hKzero, zero_add]\n      _ = A x := by\n              rw [hsplit]\n\n  -- L1: restrict A to Kᗮ and codrestrict it to range(A).\n  let Ares : Kp →L[𝕜] R :=\n    (A.comp Kp.subtypeL).codRestrict R\n      (fun x => by\n        exact ⟨x.1, rfl⟩)\n\n  -- Injectivity: if x,y ∈ Kᗮ and A x = A y, then x-y ∈ K ∩ Kᗮ = {0}.\n  have hAres_inj : (Ares : Kp →ₗ[𝕜] R).ker = ⊥ :=\n    LinearMap.ker_eq_bot.mpr\n      (by\n        intro x y hxy\n        apply Subtype.ext\n\n        have hval : A x.1 = A y.1 :=\n          congr_arg Subtype.val hxy\n\n        have hker : x.1 - y.1 ∈ K := by\n          change A (x.1 - y.1) = 0\n          rw [map_sub, hval, sub_self]\n\n        have horth : x.1 - y.1 ∈ Kᗮ := by\n          simpa [Kp] using Submodule.sub_mem Kp x.2 y.2\n\n        have hinner :\n            inner (𝕜 := 𝕜) (x.1 - y.1) (x.1 - y.1) = (0 : 𝕜) :=\n          (K.mem_orthogonal (x.1 - y.1)).mp horth (x.1 - y.1) hker\n\n        have hzero : x.1 - y.1 = 0 :=\n          inner_self_eq_zero.mp hinner\n\n        exact sub_eq_zero.mp hzero)\n\n  -- Surjectivity: every y = A x in range(A) is A applied to the Kᗮ projection of x.\n  have hAres_surj : (Ares : Kp →ₗ[𝕜] R).range = ⊤ :=\n    LinearMap.range_eq_top.mpr\n      (by\n        intro y\n        rcases y with ⟨y, hy⟩\n        rcases hy with ⟨x, rfl⟩\n        refine ⟨Kp.orthogonalProjection x, ?_⟩\n        apply Subtype.ext\n        change A ((Kp.orthogonalProjection x : Kp) : E) = A x\n        simpa using hA_on_Kp x)\n\n  -- L2: invert the restricted/codrestricted map.\n  let e : Kp ≃L[𝕜] R :=\n    ContinuousLinearEquiv.ofBijective Ares hAres_inj hAres_surj\n\n  -- B = inclusion_Kᗮ ∘ e⁻¹ ∘ P_range.\n  let B : E →L[𝕜] E :=\n    Kp.subtypeL.comp\n      (e.symm.toContinuousLinearMap.comp R.orthogonalProjection)\n\n  -- Direct verification of A ∘ B = P_range.\n  have hAB_apply : ∀ x : E, A (B x) = R.starProjection x := by\n    intro x\n    have h :=\n      ContinuousLinearEquiv.ofBijective_apply_symm_apply\n        Ares hAres_inj hAres_surj (R.orthogonalProjection x)\n    have hval := congr_arg Subtype.val h\n    simpa [B, e, Ares] using hval\n\n  -- Direct verification of B ∘ A = P_Kᗮ.\n  have hBA_apply : ∀ x : E, B (A x) = Kp.starProjection x := by\n    intro x\n\n    have hproj :\n        R.orthogonalProjection (A x) =\n          (⟨A x, ⟨x, rfl⟩⟩ : R) :=\n      Submodule.orthogonalProjection_mem_subspace_eq_self\n        (K := R) (⟨A x, ⟨x, rfl⟩⟩ : R)\n\n    have hTz :\n        Ares (Kp.orthogonalProjection x) =\n          (⟨A x, ⟨x, rfl⟩⟩ : R) := by\n      apply Subtype.ext\n      change A ((Kp.orthogonalProjection x : Kp) : E) = A x\n      simpa using hA_on_Kp x\n\n    have hsymm₀ :=\n      ContinuousLinearEquiv.ofBijective_symm_apply_apply\n        Ares hAres_inj hAres_surj (Kp.orthogonalProjection x)\n\n    have hsymm :\n        e.symm (⟨A x, ⟨x, rfl⟩⟩ : R) =\n          Kp.orthogonalProjection x := by\n      rw [← hTz]\n      simpa [e] using hsymm₀\n\n    calc\n      B (A x)\n          = ((e.symm (R.orthogonalProjection (A x)) : Kp) : E) := by\n              simp [B]\n      _ = ((e.symm (⟨A x, ⟨x, rfl⟩⟩ : R) : Kp) : E) := by\n              rw [hproj]\n      _ = ((Kp.orthogonalProjection x : Kp) : E) := by\n              rw [hsymm]\n      _ = Kp.starProjection x := by\n              simp\n\n  have hAB : A * B = R.starProjection := by\n    ext x\n    simp only [ContinuousLinearMap.coe_mul, Function.comp_apply]\n    exact hAB_apply x\n\n  have hBA : B * A = Kp.starProjection := by\n    ext x\n    simp only [ContinuousLinearMap.coe_mul, Function.comp_apply]\n    exact hBA_apply x\n\n  refine ⟨B, ?_, ?_, ?_, ?_⟩\n\n  · -- A * B * A = A.\n    ext x\n    simp only [ContinuousLinearMap.coe_mul, Function.comp_apply]\n    rw [hAB_apply]\n    exact\n      Submodule.starProjection_mem_subspace_eq_self\n        (K := R) (⟨A x, ⟨x, rfl⟩⟩ : R)\n\n  · -- B * A * B = B.\n    ext x\n    simp only [ContinuousLinearMap.coe_mul, Function.comp_apply]\n    rw [hBA_apply]\n    simpa [B] using\n      Submodule.starProjection_mem_subspace_eq_self\n        (K := Kp) (e.symm (R.orthogonalProjection x))\n\n  · -- star (A * B) = A * B.\n    rw [hAB]\n    simpa [ContinuousLinearMap.star_eq_adjoint] using\n      (isSelfAdjoint_starProjection R)\n\n  · -- star (B * A) = B * A.\n    rw [hBA]\n    simpa [ContinuousLinearMap.star_eq_adjoint] using\n      (isSelfAdjoint_starProjection Kp)\n","rangeOffset":3210,"rangeLength":7905}]}