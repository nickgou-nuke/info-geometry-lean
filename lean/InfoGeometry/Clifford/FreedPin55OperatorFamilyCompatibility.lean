import InfoGeometry.Clifford.NormalizedVectorPin
import InfoGeometry.Twistor.Pin55ExteriorSpinorNativeAction
import InfoGeometry.Clifford.SplitClifford55ExteriorParity
import InfoGeometry.Clifford.SplitClifford55ExteriorDegrees
import InfoGeometry.Optics.OperatorValuedConnection
import InfoGeometry.OperatorAlgebra.PeirceSpine.TripotentGradedMorita

/-!
# Compatibility of the ordered Freed Pin suspension with the native Pin(5,5) operators

This owner connects PR #338's actual normalized-vector Pin group for `Q55` to
the existing exterior-spinor operator action.  The analytic family statement
is intentionally limited to algebraic operator families on the full finite
dimensional exterior algebra; no unbounded Dirac domain or index theorem is
asserted.  Curvature transport uses the existing operator-valued connection
owner and keeps its derivative data explicit.
-/

noncomputable section

namespace InfoGeometry.Clifford.FreedPin55OperatorFamilyCompatibility

open CliffordAlgebra
open InfoGeometry.Clifford.Clifford55
open InfoGeometry.Clifford.FreedCliffordSuspension
open InfoGeometry.Clifford.NormalizedVectorPin
open InfoGeometry.Clifford.SplitClifford55ExteriorSpinor
open InfoGeometry.Clifford.SplitClifford55ExteriorParity
open InfoGeometry.Clifford.Cl55NeutralHyperbolicIsometry
open InfoGeometry.Twistor.Pin55ExteriorSpinorNativeAction
open InfoGeometry.Twistor.Pin55PureSpinorAnnihilatorEquivariance
open InfoGeometry.Clifford.Clifford55
open InfoGeometry.Optics.OperatorValuedConnection
open InfoGeometry.OperatorAlgebra.PeirceSpine
open CategoryTheory

/-- The source group in PR #338 is exactly the repository's real split Pin
subgroup: both are generated by the same `Q55`-normalized vector units. -/
theorem realSplitPin55_eq_freedPin :
    realSplitPin55 = NormalizedVectorPin.pin Q55 := rfl

/-- The existing native `RealPin55` carrier and the generic PR #338 Pin
carrier have the same underlying unit and membership proof. -/
def toFreedPin (g : RealPin55) : NormalizedVectorPin.pin Q55 :=
  ⟨g.1, by simpa [realSplitPin55_eq_freedPin] using g.2⟩

@[simp] theorem toFreedPin_val (g : RealPin55) :
    ((toFreedPin g : NormalizedVectorPin.pin Q55) : Cl55ˣ) = g.1 := rfl

/-- Operator representation of the positive suspended even Clifford algebra
on the actual exterior spinor space.  We pull the even algebra back along
Freed's algebra equivalence, then use the existing faithful neutral-Clifford
spinor representation. -/
def positiveSpinorRep :
    CliffordAlgebra.even (positiveForm Q55) →ₐ[ℝ] SpinorEnd :=
  neutralCliffordRep.comp
    (neutralCliffordAlgEquiv.symm.toAlgHom.comp
      (positiveEquiv Q55).symm.toAlgHom)

/-- The positive Freed Pin inclusion followed by the exterior-spinor
operator representation, as a genuine group homomorphism into invertible
operators. -/
def freedPinSpinorRep : NormalizedVectorPin.pin Q55 →* SpinorEndˣ :=
  (Units.map positiveSpinorRep.toMonoidHom).comp
    ((NormalizedVectorPin.evenPin (positiveForm Q55)).subtype.comp
      (positivePinHom Q55))

/-- On the concrete split Pin carrier, the representation obtained through
Freed's even suspension is exactly the already established native exterior
spinor representation.  Thus the two constructions agree as operators,
including on odd Pin elements. -/
theorem freedPin_rep_agrees_native (g : RealPin55) :
    ((freedPinSpinorRep (toFreedPin g) : SpinorEndˣ) : SpinorEnd) =
      realPin55ExteriorSpinorEnd g := by
  simp [freedPinSpinorRep, positiveSpinorRep, toFreedPin,
    realPin55ExteriorSpinorEnd, realPin55NeutralCliffordElement,
    positivePinHom, positiveUnits, Units.map]

/-- The ordered positive-suspension vector image, before applying the
spinor representation, is the exact `(v,0) * (0,1)` product from PR #338. -/
theorem freedPin_vector_image (v : Clifford55.V55)
    (hv : Q55 v = 1 ∨ Q55 v = -1) :
    (evenPinToUnits (positiveForm Q55)
      (positivePinHom Q55 (pinVector Q55 v hv)) :
        CliffordAlgebra (positiveForm Q55)) =
      ι (positiveForm Q55) (v, 0) * ι (positiveForm Q55) (0, 1) :=
  positivePinHom_vector Q55 v hv

/-- Domain of each native operator is the entire exterior spinor carrier.
This makes domain invariance an algebraic statement, not an implicit analytic
claim about a geometric Dirac operator. -/
def spinorDomain : Set SplitClifford55ExteriorSpinor.Spinor := Set.univ

theorem pin_preserves_spinorDomain (g : RealPin55) :
    realPin55ExteriorSpinorLinearEquiv g '' spinorDomain = spinorDomain := by
  apply Set.image_univ_of_surjective
  exact (realPin55ExteriorSpinorLinearEquiv g).surjective

/-- The native vector operator is odd for the exterior-algebra grading. -/
theorem neutralOperator_odd
    (w : SplitClifford55ExteriorSpinor.NeutralSpace)
    (ψ : SplitClifford55ExteriorSpinor.Spinor) :
    SplitClifford55ExteriorParity.gradeInvolution (neutralAction w ψ) =
      -(neutralAction w (SplitClifford55ExteriorParity.gradeInvolution ψ)) :=
  gradeInvolution_neutralAction w ψ

/-- Pointwise family covariance under the full Pin action, retaining the
genuine parity sign.  `w` is any parameterized family of neutral vectors;
all operator domains are `spinorDomain`. -/
theorem operatorFamily_pin_covariance
    {Index : Type*}
    (w : Index → SplitClifford55ExteriorSpinor.NeutralSpace)
    (g : RealPin55) (t : Index)
    (ψ : SplitClifford55ExteriorSpinor.Spinor) :
    neutralAction (realPin55NeutralTransport g (w t))
        (realPin55ExteriorSpinorEnd g ψ) =
        realPin55ExteriorSpinorEnd g (neutralAction (w t) ψ) ∨
    neutralAction (realPin55NeutralTransport g (w t))
        (realPin55ExteriorSpinorEnd g ψ) =
        -realPin55ExteriorSpinorEnd g (neutralAction (w t) ψ) :=
  realPin55_clifford_covariance_or_neg g (w t) ψ

/-- The existing operator-valued family owner transports the connection
through the actual positive Freed algebra equivalence.  Curvature compatibility
is inherited from that owner's `mapConnection_curvature` theorem. -/
def positiveSuspensionConnection
    {Point Tangent : Type*}
    (C : Connection (Point := Point) (Tangent := Tangent) (Value := Cl55)) :
    Connection (Point := Point) (Tangent := Tangent)
      (Value := CliffordAlgebra.even (positiveForm Q55)) :=
  mapConnection (positiveEquiv Q55).toRingHom C

theorem positiveSuspensionConnection_curvature
    {Point Tangent : Type*}
    (C : Connection (Point := Point) (Tangent := Tangent) (Value := Cl55))
    (p : Point) (X Y : Tangent) :
    positiveEquiv Q55 (curvature C p X Y) =
      curvature (positiveSuspensionConnection C) p X Y :=
  mapConnection_curvature (positiveEquiv Q55).toRingHom C p X Y

theorem positiveSuspensionConnection_flat_iff
    {Point Tangent : Type*}
    (C : Connection (Point := Point) (Tangent := Tangent) (Value := Cl55)) :
    IsFlat (positiveSuspensionConnection C) ↔ IsFlat C :=
  mapConnection_isFlat_iff (positiveEquiv Q55).toRingEquiv C

/-- Compose Freed's ordered suspension with the existing exterior-spinor
representation to transport an operator-valued connection all the way to the
noncommutative algebra `End(Λ• V₅)`. -/
def pinSpinorConnection
    {Point Tangent : Type*}
    (C : Connection (Point := Point) (Tangent := Tangent) (Value := Cl55)) :
    Connection (Point := Point) (Tangent := Tangent) (Value := SpinorEnd) :=
  mapConnection (positiveSpinorRep.comp (positiveEquiv Q55).toAlgHom).toRingHom C

theorem pinSpinorConnection_curvature
    {Point Tangent : Type*}
    (C : Connection (Point := Point) (Tangent := Tangent) (Value := Cl55))
    (p : Point) (X Y : Tangent) :
    (positiveSpinorRep.comp (positiveEquiv Q55).toAlgHom)
        (curvature C p X Y) = curvature (pinSpinorConnection C) p X Y :=
  mapConnection_curvature
    (positiveSpinorRep.comp (positiveEquiv Q55).toAlgHom).toRingHom C p X Y

/-- The native exterior-spinor grading is an involutive operator and hence
supplies the tripotent required by the repository's actual graded Morita
equivalence.  This specializes that Morita owner to the Pin spinor carrier;
its unit is even by the owner's proved compatibility theorem. -/
theorem gradeLinear_tripotent :
    gradeLinear * gradeLinear * gradeLinear = gradeLinear := by
  have h := gradeLinear_sq
  calc gradeLinear * gradeLinear * gradeLinear
      = (1 : SpinorEnd) * gradeLinear := by rw [h]
    _ = gradeLinear := one_mul _

theorem pinSpinorMorita_unit_even
    (X : Action (ModuleCat SpinorEnd) InnerGradedMorita.C2)
    (ψ : X.V) :
    ((tripotentGradedMorita exteriorAlgebraBasisFinset (Finset.univ : Finset (Fin 5))).unitIso.hom.app X).hom
        (InnerGradedMorita.grading (moduleReflection gradeLinear) X ψ) =
      InnerGradedMorita.grading (moduleReflection gradeLinear) _
        (((tripotentGradedMorita exteriorAlgebraBasisFinset (Finset.univ : Finset (Fin 5))).unitIso.hom.app X).hom ψ) :=
  tripotent_unit_even exteriorAlgebraBasisFinset (Finset.univ : Finset (Fin 5)) gradeLinear X ψ

/-- The concrete spinor carrier used by the Pin representation has dimension
32, matching the five-generator exterior algebra in its existing degree owner. -/
theorem pinSpinor_finrank :
    Module.finrank ℝ SplitClifford55ExteriorSpinor.Spinor = 32 :=
  SplitClifford55ExteriorDegrees.exteriorAlgebra_finrank

end InfoGeometry.Clifford.FreedPin55OperatorFamilyCompatibility
