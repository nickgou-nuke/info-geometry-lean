import InfoGeometry.Canonical.ModularHamiltonianDoubledBridge
import InfoGeometry.Canonical.ModularSuperchargeClosure
import InfoGeometry.Canonical.RelativeModularPotential
import InfoGeometry.Canonical.OperatorDictionary
import InfoGeometry.Meta.Architecture
import Mathlib.Analysis.Normed.Algebra.Exponential

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.HestenesModularBregman

Real doubled Hestenes modular beta flows and operatorial Bregman readouts.

This file implements the trace-free root layer behind:

* `Delta - I` as deviation from the modular identity sector;
* `Kmod = -log Delta` as modular Hamiltonian / surprisal generator;
* `beta ↦ exp(-beta • Kmod)` as the untraced modular exponential family;
* operatorial Bregman divergence as convex-potential readout from a differential.

No density matrices, no trace partition function, and no type-I normalization are
introduced here.

The existing phase axis

  phaseAxisK = J ∘ epsilon = complex_i = clockAxis

is not the modular Hamiltonian. We keep the names separate:

* `phaseAxisK` / `clockAxis` : real doubled Hestenes internal complex axis;
* `Kmod`                    : modular Hamiltonian / surprisal generator;
* `Delta`                   : modular operator / beta-flow endpoint.
-/

namespace HestenesModularBregman

open InfoGeometry.Krein
open InfoGeometry.Canonical
open InfoGeometry.Canonical.OperatorDictionary
open InfoGeometry.Canonical.ModularHamiltonianDoubledBridge
open InfoGeometry.Canonical.RelativeModularPotential

section Core

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance
local instance : SMulCommClass ℝ EndH EndH := inferInstance
local instance : IsScalarTower ℝ EndH EndH := inferInstance

/--
The modular identity operator.

In type-III language, the identity is not removed. What fails is a faithful
normal trace/finite partition function by default, not the unital identity.
-/
@[rep_depth operator]
noncomputable def modularIdentity : EndH :=
  1

/-- The modular identity is the continuous-linear identity map. -/
@[rep_depth operator]
theorem modularIdentity_eq_id :
    modularIdentity (E := E) = ContinuousLinearMap.id ℝ H₂ := by
  rfl

/--
`Delta - I`: deviation of a modular operator from the identity/reference sector.

This is not a trace regularization and not a density-matrix normalization.
-/
@[rep_depth operator]
noncomputable def modularDeviation (Delta : EndH) : EndH :=
  Delta - modularIdentity (E := E)

/-- The identity sector has zero modular deviation. -/
@[rep_depth operator]
theorem modularDeviation_identity :
    modularDeviation (E := E) (modularIdentity (E := E)) = 0 := by
  simp [modularDeviation, modularIdentity]

/--
Untraced modular beta flow generated by a bounded modular Hamiltonian `Kmod`.

This is the safe bounded-operator root:

  beta ↦ exp(-beta • Kmod)

No logarithm, trace, or partition function is assumed here.
-/
@[rep_depth operator]
noncomputable def modularBetaFlow (Kmod : EndH) (beta : ℝ) : EndH :=
  NormedSpace.exp ((-beta) • Kmod)

/-- At `beta = 0`, the modular beta flow is the identity. -/
@[rep_depth operator]
theorem modularBetaFlow_zero (Kmod : EndH) :
    modularBetaFlow (E := E) Kmod 0 = modularIdentity (E := E) := by
  simp [modularBetaFlow, modularIdentity]

/-- At `beta = 1`, the modular beta flow is `exp(-Kmod)`. -/
@[rep_depth operator]
theorem modularBetaFlow_one (Kmod : EndH) :
    modularBetaFlow (E := E) Kmod 1 = NormedSpace.exp (-Kmod) := by
  simp [modularBetaFlow]

/-- Endpoint modular operator associated to a bounded modular Hamiltonian. -/
@[rep_depth operator]
noncomputable def modularDeltaFromHamiltonian (Kmod : EndH) : EndH :=
  modularBetaFlow (E := E) Kmod 1

/-- Readback for `modularDeltaFromHamiltonian`. -/
@[rep_depth operator]
theorem modularDeltaFromHamiltonian_eq_exp_neg (Kmod : EndH) :
    modularDeltaFromHamiltonian (E := E) Kmod = NormedSpace.exp (-Kmod) := by
  simp [modularDeltaFromHamiltonian, modularBetaFlow]

/-- Beta-flow deviation from the identity sector. -/
@[rep_depth operator]
noncomputable def modularBetaDeviation (Kmod : EndH) (beta : ℝ) : EndH :=
  modularDeviation (E := E) (modularBetaFlow (E := E) Kmod beta)

/-- The beta-flow deviation vanishes at `beta = 0`. -/
@[rep_depth operator]
theorem modularBetaDeviation_zero (Kmod : EndH) :
    modularBetaDeviation (E := E) Kmod 0 = 0 := by
  simp [modularBetaDeviation, modularDeviation, modularBetaFlow, modularIdentity]

/-- The beta-one deviation is exactly `exp(-Kmod) - I`. -/
@[rep_depth operator]
theorem modularBetaDeviation_one (Kmod : EndH) :
    modularBetaDeviation (E := E) Kmod 1
      = NormedSpace.exp (-Kmod) - modularIdentity (E := E) := by
  simp [modularBetaDeviation, modularDeviation, modularBetaFlow]

/-! ## Common Gibbs half-factor lemmas -/

/--
Common Gibbs half-factor for the bosonic denominator.

If `Eminus * Eplus = 1`, then

`1 - Eminus * Eminus = Eminus * (Eplus - Eminus)`.

In the thermal specialization:

`Eplus = exp(βH/2)`,
`Eminus = exp(-βH/2)`,
so this is

`1 - exp(-βH) = exp(-βH/2) * (exp(βH/2) - exp(-βH/2))`.
-/
@[rep_depth operator]
theorem common_gibbs_half_factor_sub
    {R : Type*} [Ring R]
    {Eplus Eminus : R}
    (hInv : Eminus * Eplus = 1) :
    1 - Eminus * Eminus = Eminus * (Eplus - Eminus) := by
  calc
    1 - Eminus * Eminus
        = Eminus * Eplus - Eminus * Eminus := by rw [hInv]
    _ = Eminus * (Eplus - Eminus) := by rw [mul_sub]

/--
Common Gibbs half-factor for the fermionic factor.

If `Eminus * Eplus = 1`, then

`1 + Eminus * Eminus = Eminus * (Eplus + Eminus)`.

In the thermal specialization:

`1 + exp(-βH) = exp(-βH/2) * (exp(βH/2) + exp(-βH/2))`.
-/
@[rep_depth operator]
theorem common_gibbs_half_factor_add
    {R : Type*} [Ring R]
    {Eplus Eminus : R}
    (hInv : Eminus * Eplus = 1) :
    1 + Eminus * Eminus = Eminus * (Eplus + Eminus) := by
  calc
    1 + Eminus * Eminus
        = Eminus * Eplus + Eminus * Eminus := by rw [hInv]
    _ = Eminus * (Eplus + Eminus) := by rw [mul_add]

/--
Canonical Tomita modular Hamiltonian readback.

This is only a name for the bounded owner expression already carried by
`ModularSuperchargeClosure.canonicalTomitaLogData`: `Kmod = -deltaLog`.
-/
@[rep_depth operator]
noncomputable def canonicalTomitaKmod
    (CIK : CertifiedInverseKernel H₂) : EndH :=
  -((ModularSuperchargeClosure.canonicalTomitaLogData (E := E) CIK).deltaLog)

/--
For the canonical Tomita package, the beta-one flow of `Kmod = -deltaLog`
recovers the owned modular operator `Delta`.

This is the rooted `K = -log Delta` readback already proved in the doubled lane.
-/
@[rep_depth operator]
theorem canonicalTomita_betaFlow_one_eq_Delta
    (CIK : CertifiedInverseKernel H₂) :
    modularBetaFlow (E := E) (canonicalTomitaKmod (E := E) CIK) 1
      = (ModularSuperchargeClosure.canonicalTomitaLogData (E := E) CIK).Delta := by
  unfold modularBetaFlow canonicalTomitaKmod
  simpa using canonicalTomita_modularHamiltonian_exp_neg_eq_Delta (E := E) CIK

/--
The canonical modular deviation is the beta-one deviation of the canonical
Tomita modular Hamiltonian.
-/
@[rep_depth operator]
theorem canonicalTomita_deviation_eq_beta_one_deviation
    (CIK : CertifiedInverseKernel H₂) :
    modularDeviation (E := E) ((ModularSuperchargeClosure.canonicalTomitaLogData (E := E) CIK).Delta)
      = modularBetaDeviation (E := E) (canonicalTomitaKmod (E := E) CIK) 1 := by
  unfold modularBetaDeviation
  rw [canonicalTomita_betaFlow_one_eq_Delta]

/--
Positive Hilbert expectation readout of an operator at a doubled state.

This is a scalar state-operator pairing, not an operator product.
-/
@[rep_depth operator]
noncomputable def hilbertExpectationAt
    (psi : H₂) (A : EndH) : ℝ :=
  ⟪psi, A psi⟫_ℝ

/--
Krein expectation readout of an operator at a doubled state.

This is the indefinite-pairing analogue of state-operator evaluation.
-/
@[rep_depth operator]
noncomputable def kreinExpectationAt
    (psi : H₂) (A : EndH) : ℝ :=
  KreinSpace.kreinInner (H := H₂) psi (A psi)

/-- Zero Hilbert expectation readout. -/
@[rep_depth operator]
theorem hilbertExpectationAt_zero (psi : H₂) :
    hilbertExpectationAt (E := E) psi 0 = 0 := by
  simp [hilbertExpectationAt]

/-- Zero Krein expectation readout. -/
@[rep_depth operator]
theorem kreinExpectationAt_zero (psi : H₂) :
    kreinExpectationAt (E := E) psi 0 = 0 := by
  simp [kreinExpectationAt]

/--
Operatorial Bregman divergence from a potential and a differential.

`dPhi Y` is the cotangent/readout at the base point `Y`.

This is the trace-free convex-duality root shape:

  DΦ(X,Y) = Φ(X) - Φ(Y) - dΦ(Y)(X - Y)
-/
@[rep_depth operator]
noncomputable def operatorBregman
    (Phi : EndH → ℝ)
    (dPhi : EndH → EndH →L[ℝ] ℝ)
    (X Y : EndH) : ℝ :=
  Phi X - Phi Y - dPhi Y (X - Y)

/-- Bregman divergence vanishes on the diagonal. -/
@[rep_depth operator]
theorem operatorBregman_self
    (Phi : EndH → ℝ)
    (dPhi : EndH → EndH →L[ℝ] ℝ)
    (X : EndH) :
    operatorBregman (E := E) Phi dPhi X X = 0 := by
  simp [operatorBregman]

/--
Souriau untraced operatorial exponential family.

Given a Lie-generator readout `Jhat : g → EndH`, the untraced beta family is

  exp(-beta • Jhat xi)

No trace, no partition function, and no normalization is assumed.
-/
@[rep_depth operator]
noncomputable def souriauUntracedExponential
    {g : Type*}
    (Jhat : g → EndH)
    (beta : ℝ)
    (xi : g) : EndH :=
  modularBetaFlow (E := E) (Jhat xi) beta

/-- At beta zero, the Souriau untraced exponential is the identity. -/
@[rep_depth operator]
theorem souriauUntracedExponential_zero
    {g : Type*}
    (Jhat : g → EndH)
    (xi : g) :
    souriauUntracedExponential (E := E) Jhat 0 xi = modularIdentity (E := E) := by
  simp [souriauUntracedExponential, modularBetaFlow_zero]

/-- Souriau untraced beta deviation from identity. -/
@[rep_depth operator]
noncomputable def souriauUntracedDeviation
    {g : Type*}
    (Jhat : g → EndH)
    (beta : ℝ)
    (xi : g) : EndH :=
  modularDeviation (E := E) (souriauUntracedExponential (E := E) Jhat beta xi)

/-- Souriau untraced deviation vanishes at beta zero. -/
@[rep_depth operator]
theorem souriauUntracedDeviation_zero
    {g : Type*}
    (Jhat : g → EndH)
    (xi : g) :
    souriauUntracedDeviation (E := E) Jhat 0 xi = 0 := by
  simp [souriauUntracedDeviation, souriauUntracedExponential,
    modularDeviation, modularBetaFlow, modularIdentity]

end Core

end HestenesModularBregman
