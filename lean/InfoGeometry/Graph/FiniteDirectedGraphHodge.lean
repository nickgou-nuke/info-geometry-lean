import InfoGeometry.OperatorAlgebra.FiniteTwoTermDiracHodgeZorn
import InfoGeometry.Graph.DarwinCommitTaxonomy

/-!
# Finite directed graphs as two-term Dirac--Hodge complexes

An endpoint map on a finite vertex and edge carrier determines an incidence
matrix. Its induced differential reads the target-minus-source difference.
This is a generic finite graph construction; it does not assert that a
particular repository artifact has been imported into this carrier.
-/

namespace InfoGeometry.Graph.FiniteDirectedGraphHodge

open InfoGeometry.OperatorAlgebra.FiniteTwoTermDiracHodgeZorn
open InfoGeometry.Graph

variable {n m : ℕ}

/-- Incidence transpose for a finite directed multigraph. Rows are edges and
columns are vertices, so it maps vertex functions to edge differences. -/
def incidenceTranspose (source target : Fin m → Fin n) :
    Matrix (Fin m) (Fin n) ℝ :=
  fun edge vertex =>
    (if target edge = vertex then 1 else 0) -
      (if source edge = vertex then 1 else 0)

/-- Convert the ranked source endpoint of each exported parent link into a
finite vertex index. The bound is explicit: the link set must fit in `Fin n`.
This construction models rank positions; faithful commit identity additionally
requires ranks to be injective on the exported vertex set. -/
def exportedParentSource (links : Fin m → ExportedParentLink)
    (hBound : ∀ edge, (links edge).src.topologicalIndex < n) : Fin m → Fin n :=
  fun edge => ⟨(links edge).src.topologicalIndex, hBound edge⟩

/-- Finite target indices for a family of ranked exported parent links. -/
def exportedParentTarget (links : Fin m → ExportedParentLink)
    (hBound : ∀ edge, (links edge).dst.topologicalIndex < n) : Fin m → Fin n :=
  fun edge => ⟨(links edge).dst.topologicalIndex, hBound edge⟩

/-- The finite endpoints preserve exactly the exporter topological ranks. -/
theorem exportedParent_endpoints_preserve_rank
    (links : Fin m → ExportedParentLink)
    (hSource : ∀ edge, (links edge).src.topologicalIndex < n)
    (hTarget : ∀ edge, (links edge).dst.topologicalIndex < n) (edge : Fin m) :
    (exportedParentSource links hSource edge).val =
        (links edge).src.topologicalIndex ∧
    (exportedParentTarget links hTarget edge).val =
        (links edge).dst.topologicalIndex := by
  exact ⟨rfl, rfl⟩

/-- Incidence assembled from exported links uses the exact ranked parent and
child endpoints. This is a general carrier bridge, conditional on finite rank
bounds; it does not certify that an arbitrary artifact was fully imported. -/
theorem exportedParent_incidence_entry
    (links : Fin m → ExportedParentLink)
    (hSource : ∀ edge, (links edge).src.topologicalIndex < n)
    (hTarget : ∀ edge, (links edge).dst.topologicalIndex < n)
    (edge : Fin m) (vertex : Fin n) :
    incidenceTranspose (exportedParentSource links hSource)
        (exportedParentTarget links hTarget) edge vertex =
      (if (links edge).dst.topologicalIndex = vertex.val then 1 else 0) -
      (if (links edge).src.topologicalIndex = vertex.val then 1 else 0) := by
  simp [incidenceTranspose, exportedParentSource, exportedParentTarget,
    Fin.ext_iff]

/-- The finite endpoint relation generated by an edge family. -/
def finiteParentStep (source target : Fin m → Fin n) : Fin n → Fin n → Prop :=
  fun parent child => ∃ edge, source edge = parent ∧ target edge = child

/-- If every exported parent edge strictly increases topological rank, the
induced finite endpoint relation is well-founded. This connects the exporter's
rank condition to the finite graph carrier used by the Hodge construction. -/
theorem exportedParent_finiteStep_wellFounded
    (links : Fin m → ExportedParentLink)
    (hSource : ∀ edge, (links edge).src.topologicalIndex < n)
    (hTarget : ∀ edge, (links edge).dst.topologicalIndex < n)
    (hRank : ∀ edge,
      (links edge).src.topologicalIndex < (links edge).dst.topologicalIndex) :
    WellFounded (finiteParentStep (exportedParentSource links hSource)
      (exportedParentTarget links hTarget)) := by
  apply (InvImage.wf Fin.val (Nat.lt_wfRel).2).mono
  intro parent child hStep
  rcases hStep with ⟨edge, hParent, hChild⟩
  subst parent
  subst child
  exact hRank edge

/-- The cochain differential associated to the directed graph. -/
def graphDifferential (source target : Fin m → Fin n) :
    FormEnd n m :=
  exteriorDerivative (incidenceTranspose source target)

/-- The codifferential associated to the same incidence matrix. -/
def graphCodifferential (source target : Fin m → Fin n) :
    FormEnd n m :=
  codifferential (incidenceTranspose source target)

/-- Edge-degree Hodge operator for a graph with an explicitly chosen family
of 2-cell boundaries. The first term is the graph incidence contribution and
the second is the face-boundary contribution. -/
def graphOneLaplacianWithFaces {k : ℕ}
    (incidence : Matrix (Fin m) (Fin n) ℝ)
    (faceBoundary : Matrix (Fin m) (Fin k) ℝ) (z : Fin m → ℝ) : Fin m → ℝ :=
  incidence.mulVec (incidence.transpose.mulVec z) +
    faceBoundary.mulVec (faceBoundary.transpose.mulVec z)

/-- The finite edge Hodge operator is linear in its edge cochain input. -/
theorem graphOneLaplacianWithFaces_smul {k : ℕ}
    (incidence : Matrix (Fin m) (Fin n) ℝ)
    (faceBoundary : Matrix (Fin m) (Fin k) ℝ) (c : ℝ) (z : Fin m → ℝ) :
    graphOneLaplacianWithFaces incidence faceBoundary
        (fun edge => c * z edge) =
      fun edge => c * graphOneLaplacianWithFaces incidence faceBoundary z edge := by
  change incidence.mulVec (incidence.transpose.mulVec (c • z)) +
      faceBoundary.mulVec (faceBoundary.transpose.mulVec (c • z)) =
    c • (incidence.mulVec (incidence.transpose.mulVec z) +
      faceBoundary.mulVec (faceBoundary.transpose.mulVec z))
  simp only [Matrix.mulVec_smul, smul_add]

/-- On a vertex function, the graph differential evaluates on an edge as the
value at its target minus the value at its source. -/
theorem graphDifferential_edge_apply
    (source target : Fin m → Fin n) (f : Fin n → ℝ) (e : Fin m) :
    (graphDifferential source target (f, 0)).2 e =
      f (target e) - f (source e) := by
  have sum_at (x : Fin n) :
      ∑ vertex : Fin n, (if x = vertex then (1 : ℝ) else 0) * f vertex = f x := by
    classical
    rw [Finset.sum_eq_single x]
    · simp
    · intro vertex hVertex hNe
      simp [Ne.symm hNe]
    · simp
  change (∑ vertex : Fin n,
    ((if target e = vertex then (1 : ℝ) else 0) -
      (if source e = vertex then (1 : ℝ) else 0)) * f vertex) = _
  simp_rw [sub_mul]
  rw [Finset.sum_sub_distrib, sum_at, sum_at]

/-- Multiplication by the incidence transpose sends a vertex potential to
its target-minus-source edge differences. -/
theorem incidenceTranspose_mulVec_apply
    (source target : Fin m → Fin n) (f : Fin n → ℝ) (e : Fin m) :
    (incidenceTranspose source target).mulVec f e =
      f (target e) - f (source e) := by
  have h := graphDifferential_edge_apply source target f e
  simpa [graphDifferential, exteriorDerivative] using h

/-! ### Adapter for recorded `CommitEdge` parent relations -/

/-- An ancestry edge from the `CommitEdge` carrier. Touch edges are excluded;
the subtype proof records that the selected edge is a Git parent relation. -/
abbrev ParentCommitEdge :=
  { edge : CommitEdge // edge.edgeKind = CommitEdgeKind.parent_of }

/-- Source endpoint (the parent commit) of a selected `CommitEdge`. -/
def commitParentSource (edges : Fin m → ParentCommitEdge)
    (vertexOf : CommitNode → Fin n) : Fin m → Fin n :=
  fun edge => vertexOf (edges edge).val.src

/-- Target endpoint (the child commit) of a selected `CommitEdge`. -/
def commitParentTarget (edges : Fin m → ParentCommitEdge)
    (vertexOf : CommitNode → Fin n) : Fin m → Fin n :=
  fun edge => vertexOf (edges edge).val.dst

/-- The graph differential on a recorded parent edge evaluates as child minus
parent after an explicit encoding of commit records into the finite vertex
carrier. -/
theorem commitParentDifferential_edge_apply
    (edges : Fin m → ParentCommitEdge)
    (vertexOf : CommitNode → Fin n) (f : Fin n → ℝ) (edge : Fin m) :
    (graphDifferential (commitParentSource edges vertexOf)
      (commitParentTarget edges vertexOf) (f, 0)).2 edge =
      f (vertexOf (edges edge).val.dst) - f (vertexOf (edges edge).val.src) := by
  exact graphDifferential_edge_apply
    (commitParentSource edges vertexOf) (commitParentTarget edges vertexOf) f edge

/-- Selecting a `parent_of` edge retains its ordered Git parent slot. -/
theorem parentCommitEdge_has_slot (edge : ParentCommitEdge) :
    ∃ slot, edge.val.parentSlot = some slot := by
  exact CommitEdge.parent_of_has_parentSlot edge.val edge.property

/-- A rank strictly increasing along a finite family of selected parent edges
makes the represented parent relation well-founded. This is conditional on
the supplied rank and vertex encoding; the commit record itself has no rank
field. -/
theorem commitParentStep_wellFounded
    (edges : Fin m → ParentCommitEdge) (rank : CommitNode → Nat)
    (hRank : ∀ edge, rank (edges edge).val.src < rank (edges edge).val.dst) :
    WellFounded (fun parent child : CommitNode =>
      ∃ edge, (edges edge).val.src = parent ∧ (edges edge).val.dst = child) := by
  apply (InvImage.wf rank (Nat.lt_wfRel).2).mono
  intro parent child hStep
  rcases hStep with ⟨edge, hSrc, hDst⟩
  subst parent
  subst child
  exact hRank edge

/-! ### Adapter for ranked parent links from `phylogeny_export.py` -/

/-- Source endpoint of an exported parent-to-child link after an explicit
encoding of commit references into a finite vertex carrier. -/
def exportedSource (links : Fin m → ExportedParentLink)
    (vertexOf : RankedCommitRef → Fin n) : Fin m → Fin n :=
  fun edge => vertexOf (links edge).src

/-- Target endpoint of an exported parent-to-child link after an explicit
encoding of commit references into a finite vertex carrier. -/
def exportedTarget (links : Fin m → ExportedParentLink)
    (vertexOf : RankedCommitRef → Fin n) : Fin m → Fin n :=
  fun edge => vertexOf (links edge).dst

/-- Exporter rank certificates orient every represented edge from an older
parent to a strictly later child. -/
theorem exportedEdge_rank_increases (links : Fin m → ExportedParentLink)
    (hRank : ∀ edge, (links edge).src.topologicalIndex <
      (links edge).dst.topologicalIndex) (edge : Fin m) :
    (links edge).src.topologicalIndex < (links edge).dst.topologicalIndex :=
  hRank edge

/-- Parent-to-child relation generated by a finite exported edge family. -/
def exportedFiniteParentStep (links : Fin m → ExportedParentLink)
    (parent child : RankedCommitRef) : Prop :=
  ∃ edge, (links edge).src = parent ∧ (links edge).dst = child

/-- Strictly increasing exporter ranks make the finite represented parent
relation well-founded, hence acyclic. -/
theorem exportedFiniteParentStep_wellFounded
    (links : Fin m → ExportedParentLink)
    (hRank : ∀ edge, (links edge).src.topologicalIndex <
      (links edge).dst.topologicalIndex) :
    WellFounded (exportedFiniteParentStep links) := by
  apply (InvImage.wf (fun node : RankedCommitRef => node.topologicalIndex)
    (Nat.lt_wfRel).2).mono
  intro parent child hStep
  rcases hStep with ⟨edge, hSrc, hDst⟩
  subst parent
  subst child
  exact hRank edge

/-- The incidence differential on an exported parent edge is the value at its
child minus the value at its parent, preserving the exporter's direction. -/
theorem exportedGraphDifferential_edge_apply
    (links : Fin m → ExportedParentLink)
    (vertexOf : RankedCommitRef → Fin n) (f : Fin n → ℝ) (edge : Fin m) :
    (graphDifferential (exportedSource links vertexOf)
      (exportedTarget links vertexOf) (f, 0)).2 edge =
      f (vertexOf (links edge).dst) - f (vertexOf (links edge).src) := by
  exact graphDifferential_edge_apply
    (exportedSource links vertexOf) (exportedTarget links vertexOf) f edge

/-- The Hodge incidence map on an edge enumerated from a raw ordered Git
parent list evaluates as child value minus that indexed parent value. -/
theorem orderedCommitParentDifferential_edge_apply
    (record : OrderedCommitParents)
    (vertexOf : RankedCommitRef → Fin n) (f : Fin n → ℝ)
    (slot : Fin record.parents.size) :
    (graphDifferential
      (fun edge => vertexOf (orderedParentLinkAt record edge).src)
      (fun edge => vertexOf (orderedParentLinkAt record edge).dst)
      (f, 0)).2 slot =
        f (vertexOf record.child) - f (vertexOf record.parents[slot]) := by
  rw [graphDifferential_edge_apply]
  simp [orderedParentLinkAt]

/-- The transpose incidence construction makes the graph codifferential the
adjoint of the graph differential for the standard finite real pairings. -/
theorem graphDifferential_adjoint
    (source target : Fin m → Fin n) (omega eta : TotalForms n m) :
    formPairing (graphDifferential source target omega) eta =
      formPairing omega (graphCodifferential source target eta) :=
  exterior_codifferential_adjoint (incidenceTranspose source target) omega eta

/-- The graph Dirac operator squares to the associated two-degree Hodge
Laplacian. -/
theorem graphDirac_sq_eq_graphHodge
    (source target : Fin m → Fin n) :
    diracHodge (incidenceTranspose source target) *
        diracHodge (incidenceTranspose source target) =
      hodgeLaplacian (incidenceTranspose source target) :=
  diracHodge_sq_eq_hodgeLaplacian (incidenceTranspose source target)

/-- A 1-chain with zero incidence boundary is harmonic in the unfilled
two-term graph complex: it is closed, coclosed, and annihilated by the Hodge
Laplacian. The conclusion uses no 2-cell differential. -/
theorem zero_boundary_flow_is_harmonic
    (source target : Fin m → Fin n) (z : Fin m → ℝ)
    (hBoundary :
      (incidenceTranspose source target).transpose.mulVec z = 0) :
    graphDifferential source target (0, z) = 0 ∧
    graphCodifferential source target (0, z) = 0 ∧
    hodgeLaplacian (incidenceTranspose source target) (0, z) = 0 := by
  have hDirac : diracHodge (incidenceTranspose source target) (0, z) = 0 := by
    rw [diracHodge_apply]
    simp [hBoundary]
  refine ⟨?_, ?_, ?_⟩
  · simp [graphDifferential, exteriorDerivative]
  · simp [graphCodifferential, codifferential, hBoundary]
  · rw [← diracHodge_sq_eq_hodgeLaplacian (incidenceTranspose source target)]
    change diracHodge (incidenceTranspose source target)
      (diracHodge (incidenceTranspose source target) (0, z)) = 0
    rw [hDirac]
    simp

/-- In an unfilled two-term graph complex, a 1-form is harmonic exactly when
its incidence boundary vanishes. The forward implication uses positive
definiteness of the finite real vertex pairing. -/
theorem harmonic_one_form_iff_zero_boundary
    (source target : Fin m → Fin n) (z : Fin m → ℝ) :
    hodgeLaplacian (incidenceTranspose source target) (0, z) = 0 ↔
      (incidenceTranspose source target).transpose.mulVec z = 0 := by
  let M := incidenceTranspose source target
  constructor
  · intro hLap
    have hDirac : diracHodge M (diracHodge M (0, z)) = 0 := by
      rw [← diracHodge_sq_eq_hodgeLaplacian M] at hLap
      simpa only [Module.End.mul_apply] using hLap
    have hLaplacianComponent : M.mulVec (M.transpose.mulVec z) = 0 := by
      simpa [diracHodge_apply] using congrArg Prod.snd hDirac
    have hEnergy :
        dotProduct (M.transpose.mulVec z) (M.transpose.mulVec z) = 0 := by
      calc
        dotProduct (M.transpose.mulVec z) (M.transpose.mulVec z) =
            dotProduct z (M.mulVec (M.transpose.mulVec z)) := by
          exact Matrix.dotProduct_transpose_mulVec M
            (M.transpose.mulVec z) z
        _ = 0 := by simp [hLaplacianComponent]
    have hSquares : ∑ vertex : Fin n,
        (M.transpose.mulVec z vertex) ^ 2 = 0 := by
      simpa [dotProduct, pow_two] using hEnergy
    have hEach := (Fintype.sum_eq_zero_iff_of_nonneg
      (fun vertex => sq_nonneg (M.transpose.mulVec z vertex))).mp hSquares
    funext vertex
    exact sq_eq_zero_iff.mp (congrFun hEach vertex)
  · intro hBoundary
    exact (zero_boundary_flow_is_harmonic source target z hBoundary).2.2

/-- Source vertices for a fork followed by a merge: `s → a`, `s → b`,
`a → b`. -/
def forkMergeSource (s a : Fin n) : Fin 3 → Fin n
  | 0 => s
  | 1 => s
  | 2 => a

/-- Target vertices for the same three directed edges. -/
def forkMergeTarget (a b : Fin n) : Fin 3 → Fin n
  | 0 => a
  | 1 => b
  | 2 => b

/-- Signed edge flow around the fork-merge triangle: `(+1,-1,+1)`. -/
def forkMergeCycleFlow : Fin 3 → ℝ
  | 0 => 1
  | 1 => -1
  | 2 => 1

/-- A chosen oriented 2-cell whose boundary is the fork-merge circulation.
This is additional face data; the unfilled graph complex above has no such
2-cell. -/
def forkMergeFaceBoundary : Matrix (Fin 3) (Fin 1) ℝ :=
  fun edge _ => forkMergeCycleFlow edge

/-- The signed fork-merge flow has zero boundary, with no distinctness
assumptions on its vertices. -/
theorem forkMergeCycleFlow_zero_boundary (s a b : Fin n) :
    ((incidenceTranspose (forkMergeSource s a) (forkMergeTarget a b)).transpose).mulVec
        forkMergeCycleFlow = 0 := by
  classical
  funext vertex
  let ia : ℝ := if a = vertex then 1 else 0
  let is : ℝ := if s = vertex then 1 else 0
  let ib : ℝ := if b = vertex then 1 else 0
  simp [incidenceTranspose, forkMergeSource, forkMergeTarget,
    forkMergeCycleFlow, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
  change (ia - is) + ((is - ib) + (ib - ia)) = 0
  abel

/-- The chosen face makes the previously harmonic fork-merge circulation an
explicit boundary, and its face coboundary on that circulation is its squared
Euclidean norm, equal to three. -/
theorem forkMergeFace_coboundary_on_cycle :
    forkMergeFaceBoundary.transpose.mulVec forkMergeCycleFlow = fun _ => 3 := by
  classical
  funext face
  fin_cases face
  simp [forkMergeFaceBoundary, Matrix.mulVec, dotProduct,
    forkMergeCycleFlow, Fin.sum_univ_succ]
  norm_num

/-- Boundary followed by the face coboundary vanishes on the fork-merge
triangle: `d₁ d₀ = 0` for this explicitly filled 2-cell. -/
theorem forkMerge_faceCoboundary_comp_differential_zero (s a b : Fin n) :
    forkMergeFaceBoundary.transpose *
      incidenceTranspose (forkMergeSource s a) (forkMergeTarget a b) = 0 := by
  classical
  ext face vertex
  fin_cases face
  simp [Matrix.mul_apply, Matrix.transpose_apply, forkMergeFaceBoundary,
    incidenceTranspose, forkMergeSource, forkMergeTarget,
    forkMergeCycleFlow, Fin.sum_univ_succ]
  change ((if a = vertex then (1 : ℝ) else 0) -
      (if s = vertex then 1 else 0)) +
    (((if s = vertex then 1 else 0) -
      (if b = vertex then 1 else 0)) +
      ((if b = vertex then 1 else 0) -
        (if a = vertex then 1 else 0))) = 0
  abel

/-- Once the triangle face is filled, the fork-merge circulation is no longer
harmonic: the edge Hodge operator acts on it by the positive factor three. -/
theorem forkMergeCycle_filledLaplacian (s a b : Fin n) :
    graphOneLaplacianWithFaces
      (incidenceTranspose (forkMergeSource s a) (forkMergeTarget a b))
      forkMergeFaceBoundary forkMergeCycleFlow =
        fun edge => 3 * forkMergeCycleFlow edge := by
  have hCycle := forkMergeCycleFlow_zero_boundary s a b
  have hFace := forkMergeFace_coboundary_on_cycle
  unfold graphOneLaplacianWithFaces
  rw [hCycle]
  simp only [Matrix.mulVec_zero, zero_add]
  rw [hFace]
  funext edge
  simp [forkMergeFaceBoundary, Matrix.mulVec, dotProduct,
    forkMergeCycleFlow]
  ring

/-- A directed fork-merge triangle represents a harmonic graph 1-form in the
unfilled two-term complex. -/
theorem forkMergeCycleFlow_harmonic (s a b : Fin n) :
    graphDifferential (forkMergeSource s a) (forkMergeTarget a b)
        (0, forkMergeCycleFlow) = 0 ∧
    graphCodifferential (forkMergeSource s a) (forkMergeTarget a b)
        (0, forkMergeCycleFlow) = 0 ∧
    hodgeLaplacian
        (incidenceTranspose (forkMergeSource s a) (forkMergeTarget a b))
        (0, forkMergeCycleFlow) = 0 := by
  exact zero_boundary_flow_is_harmonic
    (forkMergeSource s a) (forkMergeTarget a b) forkMergeCycleFlow
    (forkMergeCycleFlow_zero_boundary s a b)

/-- Source endpoints of a two-branch merge diamond: `s → a → t` and
`s → b → t`. -/
def mergeDiamondSource (s a b : Fin n) : Fin 4 → Fin n
  | 0 => s
  | 1 => a
  | 2 => s
  | 3 => b

/-- Target endpoints of the two-branch merge diamond. -/
def mergeDiamondTarget (a b t : Fin n) : Fin 4 → Fin n
  | 0 => a
  | 1 => t
  | 2 => b
  | 3 => t

/-- Signed circulation: positive along the first branch and negative along
the second. -/
def mergeDiamondFlow : Fin 4 → ℝ
  | 0 => 1
  | 1 => 1
  | 2 => -1
  | 3 => -1

/-- A chosen 2-cell filling the merge-diamond circulation. The directed
parent graph alone does not supply this face; it is extra complex data. -/
def mergeDiamondFaceBoundary : Matrix (Fin 4) (Fin 1) ℝ :=
  fun edge _ => mergeDiamondFlow edge

/-- Pairing an edge-weight cochain with the oriented merge-diamond cycle
computes the difference between the two branch path sums. This is the
additive, real-valued holonomy readout of the combinatorial cycle; it does
not identify it with a multiplicative path product in a ring. -/
theorem mergeDiamondFlow_pairing_eq_pathWeightDifference
    (weight : Fin 4 → ℝ) :
    dotProduct mergeDiamondFlow weight =
      (weight 0 + weight 1) - (weight 2 + weight 3) := by
  simp [dotProduct, mergeDiamondFlow, Fin.sum_univ_succ]
  abel

/-- For arbitrary real edge weights, zero merge-diamond holonomy is
equivalent to equality of the two branch path sums. -/
theorem mergeDiamondFlow_pairing_eq_zero_iff_pathSums_eq
    (weight : Fin 4 → ℝ) :
    dotProduct mergeDiamondFlow weight = 0 ↔
      weight 0 + weight 1 = weight 2 + weight 3 := by
  rw [mergeDiamondFlow_pairing_eq_pathWeightDifference]
  exact sub_eq_zero

/-- Every edge cochain obtained as target-minus-source differences of a
vertex potential has zero pairing with the merge-diamond circulation. This
is the cycle/exact-cochain annihilation law for the four-edge diamond. -/
theorem mergeDiamondCycle_annihilates_vertex_potential
    (s a b t : Fin n) (potential : Fin n → ℝ) :
    dotProduct mergeDiamondFlow
      (fun edge => potential (mergeDiamondTarget a b t edge) -
        potential (mergeDiamondSource s a b edge)) = 0 := by
  rw [mergeDiamondFlow_pairing_eq_pathWeightDifference]
  simp [mergeDiamondSource, mergeDiamondTarget]

/-- On a diamond with four distinct vertices, an edge weighting is a
vertex-potential difference exactly when its two branch sums agree. Thus the
single merge-diamond circulation is the complete obstruction to exactness on
this four-edge graph. -/
theorem mergeDiamond_edgeWeight_exact_iff_cyclePairing_zero
    (s a b t : Fin n) (hsa : s ≠ a) (hsb : s ≠ b) (hst : s ≠ t)
    (hab : a ≠ b) (hat : a ≠ t) (hbt : b ≠ t)
    (weight : Fin 4 → ℝ) :
    (∃ potential : Fin n → ℝ, ∀ edge,
      weight edge = potential (mergeDiamondTarget a b t edge) -
        potential (mergeDiamondSource s a b edge)) ↔
      dotProduct mergeDiamondFlow weight = 0 := by
  constructor
  · rintro ⟨potential, hPotential⟩
    have hWeights : weight = fun edge =>
        potential (mergeDiamondTarget a b t edge) -
          potential (mergeDiamondSource s a b edge) := by
      funext edge
      exact hPotential edge
    rw [hWeights]
    exact mergeDiamondCycle_annihilates_vertex_potential s a b t potential
  · intro hCycle
    have hPathSums :=
      (mergeDiamondFlow_pairing_eq_zero_iff_pathSums_eq weight).mp hCycle
    let potential : Fin n → ℝ := fun vertex =>
      if vertex = s then 0 else if vertex = a then weight 0 else
        if vertex = b then weight 2 else if vertex = t then weight 0 + weight 1 else 0
    refine ⟨potential, ?_⟩
    intro edge
    fin_cases edge
    · simp [potential, mergeDiamondSource, mergeDiamondTarget, hsa.symm]
    · simp [potential, mergeDiamondSource, mergeDiamondTarget,
        hsa.symm, hst.symm, hat.symm, hbt.symm]
    · simp [potential, mergeDiamondSource, mergeDiamondTarget,
        hsb.symm, hab.symm]
    · simp [potential, mergeDiamondSource, mergeDiamondTarget,
        hsb.symm, hab.symm, hst.symm, hat.symm, hbt.symm]
      linarith [hPathSums]

/-- The same exactness criterion expressed as membership in the image of the
diamond incidence transpose. -/
theorem mergeDiamond_edgeWeight_in_incidence_range_iff_cyclePairing_zero
    (s a b t : Fin n) (hsa : s ≠ a) (hsb : s ≠ b) (hst : s ≠ t)
    (hab : a ≠ b) (hat : a ≠ t) (hbt : b ≠ t)
    (weight : Fin 4 → ℝ) :
    (∃ potential : Fin n → ℝ,
      (incidenceTranspose (mergeDiamondSource s a b)
        (mergeDiamondTarget a b t)).mulVec potential = weight) ↔
      dotProduct mergeDiamondFlow weight = 0 := by
  constructor
  · rintro ⟨potential, hPotential⟩
    apply (mergeDiamond_edgeWeight_exact_iff_cyclePairing_zero
      s a b t hsa hsb hst hab hat hbt weight).mp
    refine ⟨potential, ?_⟩
    intro edge
    rw [← incidenceTranspose_mulVec_apply]
    exact (congrFun hPotential edge).symm
  · intro hCycle
    obtain ⟨potential, hPotential⟩ :=
      (mergeDiamond_edgeWeight_exact_iff_cyclePairing_zero
        s a b t hsa hsb hst hab hat hbt weight).mpr hCycle
    refine ⟨potential, ?_⟩
    funext edge
    rw [incidenceTranspose_mulVec_apply]
    exact (hPotential edge).symm

/-- Every real edge weighting on a four-vertex diamond splits into an exact
potential difference and its uniquely determined circulation component.
The coefficient is the cycle pairing divided by the cycle's squared norm 4. -/
theorem mergeDiamond_hodge_decomposition
    (s a b t : Fin n) (hsa : s ≠ a) (hsb : s ≠ b) (hst : s ≠ t)
    (hab : a ≠ b) (hat : a ≠ t) (hbt : b ≠ t)
    (weight : Fin 4 → ℝ) :
    ∃ potential : Fin n → ℝ,
      weight = fun edge =>
        (incidenceTranspose (mergeDiamondSource s a b)
          (mergeDiamondTarget a b t)).mulVec potential edge +
          (dotProduct mergeDiamondFlow weight / 4) * mergeDiamondFlow edge := by
  let coefficient : ℝ := dotProduct mergeDiamondFlow weight / 4
  let residual : Fin 4 → ℝ := fun edge =>
    weight edge - coefficient * mergeDiamondFlow edge
  have hResidualPairing : dotProduct mergeDiamondFlow residual = 0 := by
    rw [mergeDiamondFlow_pairing_eq_pathWeightDifference]
    simp [residual, coefficient, mergeDiamondFlow,
      mergeDiamondFlow_pairing_eq_pathWeightDifference]
    ring_nf
  obtain ⟨potential, hPotential⟩ :=
    (mergeDiamond_edgeWeight_exact_iff_cyclePairing_zero
      s a b t hsa hsb hst hab hat hbt residual).mpr hResidualPairing
  refine ⟨potential, ?_⟩
  funext edge
  rw [incidenceTranspose_mulVec_apply]
  have h := hPotential edge
  dsimp [residual] at h
  change weight edge =
    potential (mergeDiamondTarget a b t edge) -
      potential (mergeDiamondSource s a b edge) +
        coefficient * mergeDiamondFlow edge
  linarith

/-- Orthogonal projection of a merge-diamond edge cochain onto its signed
cycle line. -/
noncomputable def mergeDiamondCycleProjection (weight : Fin 4 → ℝ) :
    Fin 4 → ℝ :=
  fun edge => (dotProduct mergeDiamondFlow weight / 4) * mergeDiamondFlow edge

/-- Projection onto the merge-cycle line preserves the pairing with the
cycle, whose squared norm is four. -/
theorem mergeDiamondCycleProjection_pairing (weight : Fin 4 → ℝ) :
    dotProduct mergeDiamondFlow (mergeDiamondCycleProjection weight) =
      dotProduct mergeDiamondFlow weight := by
  rw [mergeDiamondFlow_pairing_eq_pathWeightDifference]
  simp [mergeDiamondCycleProjection, mergeDiamondFlow]
  ring

/-- The orthogonal merge-cycle projection is idempotent. -/
theorem mergeDiamondCycleProjection_idempotent (weight : Fin 4 → ℝ) :
    mergeDiamondCycleProjection (mergeDiamondCycleProjection weight) =
      mergeDiamondCycleProjection weight := by
  funext edge
  change (dotProduct mergeDiamondFlow
      (mergeDiamondCycleProjection weight) / 4) * mergeDiamondFlow edge =
    (dotProduct mergeDiamondFlow weight / 4) * mergeDiamondFlow edge
  rw [mergeDiamondCycleProjection_pairing]

/-- The projection fixes every scalar multiple of the diamond circulation. -/
theorem mergeDiamondCycleProjection_fixes_cycle_multiple (c : ℝ) :
    mergeDiamondCycleProjection
        (fun edge => c * mergeDiamondFlow edge) =
      fun edge => c * mergeDiamondFlow edge := by
  have hPairing :
      dotProduct mergeDiamondFlow (fun edge => c * mergeDiamondFlow edge) =
        4 * c := by
    rw [mergeDiamondFlow_pairing_eq_pathWeightDifference]
    simp [mergeDiamondFlow]
    ring
  funext edge
  change (dotProduct mergeDiamondFlow
      (fun edge => c * mergeDiamondFlow edge) / 4) *
        mergeDiamondFlow edge = c * mergeDiamondFlow edge
  rw [hPairing]
  ring

/-- Every merge-diamond edge cochain satisfies the Pythagorean identity for
its exact and cycle components. -/
theorem mergeDiamond_hodge_pythagorean
    (s a b t : Fin n) (hsa : s ≠ a) (hsb : s ≠ b) (hst : s ≠ t)
    (hab : a ≠ b) (hat : a ≠ t) (hbt : b ≠ t)
    (weight : Fin 4 → ℝ) :
    dotProduct weight weight =
      dotProduct
          (fun edge => weight edge - mergeDiamondCycleProjection weight edge)
          (fun edge => weight edge - mergeDiamondCycleProjection weight edge) +
        dotProduct (mergeDiamondCycleProjection weight)
          (mergeDiamondCycleProjection weight) := by
  obtain ⟨potential, hDecomposition⟩ :=
    mergeDiamond_hodge_decomposition s a b t hsa hsb hst hab hat hbt weight
  let incidence := incidenceTranspose (mergeDiamondSource s a b)
    (mergeDiamondTarget a b t)
  let residual : Fin 4 → ℝ := fun edge =>
    weight edge - mergeDiamondCycleProjection weight edge
  have hResidual : residual = incidence.mulVec potential := by
    funext edge
    have h := congrFun hDecomposition edge
    change weight edge = incidence.mulVec potential edge +
      mergeDiamondCycleProjection weight edge at h
    dsimp [residual]
    linarith
  have hOrth : dotProduct residual (mergeDiamondCycleProjection weight) = 0 := by
    change dotProduct residual
      ((dotProduct mergeDiamondFlow weight / 4) • mergeDiamondFlow) = 0
    rw [dotProduct_smul]
    have hCycle := mergeDiamondCycle_annihilates_vertex_potential
      s a b t potential
    have hGradient :
        (fun edge => potential (mergeDiamondTarget a b t edge) -
          potential (mergeDiamondSource s a b edge)) = incidence.mulVec potential := by
      funext edge
      exact (incidenceTranspose_mulVec_apply
        (mergeDiamondSource s a b) (mergeDiamondTarget a b t) potential edge).symm
    have hCycle' : dotProduct mergeDiamondFlow (incidence.mulVec potential) = 0 := by
      rw [← hGradient]
      exact hCycle
    rw [← hResidual, dotProduct_comm] at hCycle'
    simp [hCycle']
  have hOrthSymm :
      dotProduct (mergeDiamondCycleProjection weight) residual = 0 := by
    rw [dotProduct_comm]
    exact hOrth
  have hSplit : weight = residual + mergeDiamondCycleProjection weight := by
    funext edge
    have h := congrFun hDecomposition edge
    change weight edge = incidence.mulVec potential edge +
      mergeDiamondCycleProjection weight edge at h
    have hr := congrFun hResidual edge
    rw [← hr] at h
    dsimp [residual]
    linarith
  calc
    dotProduct weight weight =
        dotProduct (residual + mergeDiamondCycleProjection weight)
          (residual + mergeDiamondCycleProjection weight) :=
      congrArg₂ dotProduct hSplit hSplit
    _ = dotProduct residual residual +
        dotProduct (mergeDiamondCycleProjection weight)
          (mergeDiamondCycleProjection weight) := by
      simp only [add_dotProduct, dotProduct_add]
      rw [hOrth, hOrthSymm]
      ring

/-- The two directed paths in a merge diamond form a 1-cycle. -/
theorem mergeDiamondFlow_zero_boundary (s a b t : Fin n) :
    ((incidenceTranspose (mergeDiamondSource s a b)
      (mergeDiamondTarget a b t)).transpose).mulVec mergeDiamondFlow = 0 := by
  classical
  funext vertex
  let ia : ℝ := if a = vertex then 1 else 0
  let ib : ℝ := if b = vertex then 1 else 0
  let is : ℝ := if s = vertex then 1 else 0
  let it : ℝ := if t = vertex then 1 else 0
  simp [incidenceTranspose, mergeDiamondSource, mergeDiamondTarget,
    mergeDiamondFlow, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
  change (ia - is) + ((it - ia) + ((is - ib) + (ib - it))) = 0
  abel

/-- The selected diamond face satisfies the chain condition: its boundary
followed by the vertex incidence map is zero. Thus the added 2-cell defines a
valid finite 2-complex on this four-edge carrier. -/
theorem mergeDiamond_face_comp_incidence_zero (s a b t : Fin n) :
    mergeDiamondFaceBoundary.transpose *
      incidenceTranspose (mergeDiamondSource s a b)
        (mergeDiamondTarget a b t) = 0 := by
  classical
  ext face vertex
  fin_cases face
  simp [Matrix.mul_apply, Matrix.transpose_apply, mergeDiamondFaceBoundary,
    incidenceTranspose, mergeDiamondSource, mergeDiamondTarget,
    mergeDiamondFlow, Fin.sum_univ_succ]
  change ((if a = vertex then (1 : ℝ) else 0) -
      (if s = vertex then 1 else 0)) +
    (((if t = vertex then 1 else 0) -
      (if a = vertex then 1 else 0)) +
      (((if s = vertex then 1 else 0) -
        (if b = vertex then 1 else 0)) +
        ((if b = vertex then 1 else 0) -
          (if t = vertex then 1 else 0)))) = 0
  abel

/-- On a four-vertex diamond, every zero-boundary edge flow is a scalar
multiple of the signed merge circulation. Hence the graph's real cycle space
is one-dimensional. -/
theorem mergeDiamond_cycleSpace_is_span
    (s a b t : Fin n) (hsa : s ≠ a) (hsb : s ≠ b) (hst : s ≠ t)
    (hab : a ≠ b) (hat : a ≠ t) (hbt : b ≠ t)
    (flow : Fin 4 → ℝ)
    (hBoundary :
      ((incidenceTranspose (mergeDiamondSource s a b)
        (mergeDiamondTarget a b t)).transpose).mulVec flow = 0) :
    ∃ c : ℝ, flow = fun edge => c * mergeDiamondFlow edge := by
  have hAtSource := congrFun hBoundary s
  have hAtLeft := congrFun hBoundary a
  have hAtRight := congrFun hBoundary b
  have hSource : flow 0 + flow 2 = 0 := by
    simp [incidenceTranspose, mergeDiamondSource, mergeDiamondTarget,
      Matrix.mulVec, dotProduct, Fin.sum_univ_succ,
      hsa.symm, hsb.symm, hst.symm] at hAtSource
    linarith
  have hLeft : flow 0 - flow 1 = 0 := by
    simp [incidenceTranspose, mergeDiamondSource, mergeDiamondTarget,
      Matrix.mulVec, dotProduct, Fin.sum_univ_succ,
      hsa, hab.symm, hat.symm] at hAtLeft
    linarith
  have hRight : flow 2 - flow 3 = 0 := by
    simp [incidenceTranspose, mergeDiamondSource, mergeDiamondTarget,
      Matrix.mulVec, dotProduct, Fin.sum_univ_succ,
      hsb, hab, hbt.symm] at hAtRight
    linarith
  refine ⟨flow 0, ?_⟩
  funext edge
  fin_cases edge
  · simp [mergeDiamondFlow]
  · simp [mergeDiamondFlow]
    linarith
  · simp [mergeDiamondFlow]
    linarith
  · simp [mergeDiamondFlow]
    linarith

/-- A merge-diamond circulation is harmonic for the graph Hodge Laplacian
when the complex has no 2-cells. -/
theorem mergeDiamondFlow_harmonic (s a b t : Fin n) :
    graphDifferential (mergeDiamondSource s a b) (mergeDiamondTarget a b t)
        (0, mergeDiamondFlow) = 0 ∧
    graphCodifferential (mergeDiamondSource s a b) (mergeDiamondTarget a b t)
        (0, mergeDiamondFlow) = 0 ∧
    hodgeLaplacian
        (incidenceTranspose (mergeDiamondSource s a b)
          (mergeDiamondTarget a b t)) (0, mergeDiamondFlow) = 0 := by
  exact zero_boundary_flow_is_harmonic
    (mergeDiamondSource s a b) (mergeDiamondTarget a b t) mergeDiamondFlow
    (mergeDiamondFlow_zero_boundary s a b t)

/-- On a four-vertex merge diamond, the harmonic 1-forms are exactly the
scalar multiples of its signed two-path circulation. -/
theorem mergeDiamond_harmonic_flow_iff_cycle_multiple
    (s a b t : Fin n) (hsa : s ≠ a) (hsb : s ≠ b) (hst : s ≠ t)
    (hab : a ≠ b) (hat : a ≠ t) (hbt : b ≠ t)
    (flow : Fin 4 → ℝ) :
    hodgeLaplacian
        (incidenceTranspose (mergeDiamondSource s a b)
          (mergeDiamondTarget a b t)) (0, flow) = 0 ↔
      ∃ c : ℝ, flow = fun edge => c * mergeDiamondFlow edge := by
  rw [harmonic_one_form_iff_zero_boundary]
  constructor
  · exact mergeDiamond_cycleSpace_is_span s a b t hsa hsb hst hab hat hbt flow
  · rintro ⟨c, hFlow⟩
    rw [hFlow]
    change (incidenceTranspose (mergeDiamondSource s a b)
      (mergeDiamondTarget a b t)).transpose.mulVec
        (c • mergeDiamondFlow) = 0
    rw [Matrix.mulVec_smul, mergeDiamondFlow_zero_boundary]
    simp

/-- Pairing the chosen face boundary with the diamond cycle gives its squared
Euclidean norm, four. -/
theorem mergeDiamondFace_coboundary_on_flow :
    mergeDiamondFaceBoundary.transpose.mulVec mergeDiamondFlow = fun _ => 4 := by
  classical
  funext face
  fin_cases face
  simp [mergeDiamondFaceBoundary, Matrix.mulVec, dotProduct,
    mergeDiamondFlow, Fin.sum_univ_succ]
  norm_num

/-- The face contribution to the edge Hodge operator is four times the
orthogonal projection onto the merge-diamond cycle line. -/
theorem mergeDiamond_faceLaplacian_eq_four_projection
    (weight : Fin 4 → ℝ) :
    mergeDiamondFaceBoundary.mulVec
      (mergeDiamondFaceBoundary.transpose.mulVec weight) =
        fun edge => 4 * mergeDiamondCycleProjection weight edge := by
  classical
  funext edge
  simp [mergeDiamondFaceBoundary, mergeDiamondCycleProjection,
    Matrix.mulVec, dotProduct, mergeDiamondFlow, Fin.sum_univ_succ]
  ring

/-- The chosen face filling removes the merge-diamond circulation from the
harmonic subspace: its filled edge Hodge operator acts by four on that cycle. -/
theorem mergeDiamond_filled_laplacian_on_flow
    (s a b t : Fin n) :
    graphOneLaplacianWithFaces
      (incidenceTranspose (mergeDiamondSource s a b)
        (mergeDiamondTarget a b t))
      mergeDiamondFaceBoundary mergeDiamondFlow =
        fun edge => 4 * mergeDiamondFlow edge := by
  have hCycle := mergeDiamondFlow_zero_boundary s a b t
  have hFace := mergeDiamondFace_coboundary_on_flow
  unfold graphOneLaplacianWithFaces
  rw [hCycle]
  simp only [Matrix.mulVec_zero, zero_add]
  rw [hFace]
  funext edge
  simp [mergeDiamondFaceBoundary, Matrix.mulVec, dotProduct,
    mergeDiamondFlow]
  ring

/-- The filled edge Hodge operator acts by four on the full orthogonal
projection of any cochain onto the merge-diamond cycle line. -/
theorem mergeDiamond_filled_laplacian_on_projection
    (s a b t : Fin n) (weight : Fin 4 → ℝ) :
    graphOneLaplacianWithFaces
      (incidenceTranspose (mergeDiamondSource s a b)
        (mergeDiamondTarget a b t))
      mergeDiamondFaceBoundary (mergeDiamondCycleProjection weight) =
        fun edge => 4 * mergeDiamondCycleProjection weight edge := by
  let coefficient : ℝ := dotProduct mergeDiamondFlow weight / 4
  have hProjection : mergeDiamondCycleProjection weight =
      fun edge => coefficient * mergeDiamondFlow edge := rfl
  rw [hProjection, graphOneLaplacianWithFaces_smul]
  rw [mergeDiamond_filled_laplacian_on_flow s a b t]
  funext edge
  simp [coefficient]
  ring

/-- A chosen 2-cell filling removes every harmonic 1-form on a four-edge
merge diamond. This is conditional on adding that face to the graph complex. -/
theorem mergeDiamond_filling_kills_harmonic_flow
    (s a b t : Fin n) (hsa : s ≠ a) (hsb : s ≠ b) (hst : s ≠ t)
    (hab : a ≠ b) (hat : a ≠ t) (hbt : b ≠ t)
    (flow : Fin 4 → ℝ)
    (hHarmonic :
      hodgeLaplacian
        (incidenceTranspose (mergeDiamondSource s a b)
          (mergeDiamondTarget a b t)) (0, flow) = 0)
    (hFilled :
      graphOneLaplacianWithFaces
        (incidenceTranspose (mergeDiamondSource s a b)
          (mergeDiamondTarget a b t))
        mergeDiamondFaceBoundary flow = 0) :
    flow = 0 := by
  obtain ⟨c, hFlow⟩ :=
    mergeDiamond_harmonic_flow_iff_cycle_multiple
      s a b t hsa hsb hst hab hat hbt flow |>.mp hHarmonic
  rw [hFlow, graphOneLaplacianWithFaces_smul,
    mergeDiamond_filled_laplacian_on_flow] at hFilled
  have hAtZero := congrFun hFilled 0
  have hc : c = 0 := by
    norm_num [mergeDiamondFlow] at hAtZero
    linarith
  funext edge
  rw [hFlow, hc]
  simp

