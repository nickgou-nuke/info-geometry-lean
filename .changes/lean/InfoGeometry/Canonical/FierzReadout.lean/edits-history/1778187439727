{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Canonical/FierzReadout.lean","time":1778187439727,"baseTime":1778187439210,"changes":[{"range":{"start":{"line":57,"character":0},"end":{"line":101,"character":0}},"text":"Full Fierz presentation.\n\nUnlike the generic `Presentation`, this structure keeps all four Fierz\nchannels.  It is therefore the surface that can be isomorphic to\n`FierzChannelReadout`; the generic `Presentation` below is only a projection\nforgetting `scalarReadout` and `areaReadout`.\n-/\n@[rep_depth operator]\nstructure FierzPresentation extends Presentation where\n  scalarReadout : State → ℝ\n  areaReadout : State → ℝ\n  fierzIdentity :\n    ∀ ψ, (metricReadout ψ)^2 =\n      (scalarReadout ψ)^2 + (phaseReadout ψ)^2 + 4 * (areaReadout ψ)\n\n/-- Convert a Fierz readout package to the full four-channel Fierz presentation. -/\n@[rep_depth operator]\ndef toFierzPresentationWith\n    (R : FierzChannelReadout)\n    (support : R.State → Prop)\n    (generator : R.State → R.State) :\n    FierzPresentation where\n  Scalar := ℝ\n  State := R.State\n  Observable := R.State → R.State\n  act := fun A ψ => A ψ\n  support := support\n  generator := generator\n  metricReadout := R.hilbert\n  phaseReadout := R.symplectic\n  scalarReadout := R.scalar\n  areaReadout := R.area\n  fierzIdentity := R.fierzIdentity\n\n/-- Recover the Fierz readout package from a full four-channel Fierz presentation. -/\n@[rep_depth operator]\ndef ofFierzPresentation (P : FierzPresentation) : FierzChannelReadout where\n  State := P.State\n  scalar := P.scalarReadout\n  symplectic := P.phaseReadout\n  hilbert := P.metricReadout\n  area := P.areaReadout\n  fierzIdentity := P.fierzIdentity\n\n/--\nThe readout package and the full Fierz presentation are inverse on readout\ndata.  This is the actual isomorphism lane; it is not the lossy generic\n`Presentation` projection.\n-/\n@[rep_depth operator]\ntheorem of_toFierzPresentationWith\n    (R : FierzChannelReadout)\n    (support : R.State → Prop)\n    (generator : R.State → R.State) :\n    ofFierzPresentation (toFierzPresentationWith R support generator) = R := by\n  cases R\n  rfl\n\n/--\nThe full Fierz presentation recovers its four readout channels after\nforgetting to `FierzChannelReadout`.\n-/\n@[rep_depth operator]\ntheorem toFierzPresentationWith_of_readouts\n    (P : FierzPresentation) :\n    (ofFierzPresentation P).toFierzPresentationWith P.support P.generator = P := by\n  cases P\n  rfl\n\n/--\nProjection from a Fierz readout package to the generic presentation interface.\n\nThis preserves only the Hilbert and symplectic channels available in the\ngeneric `Presentation` interface while making the support/generator lane\nexplicit at the call site.  The scalar and area channels remain in the original\n`FierzChannelReadout`.\n-/\n@[rep_depth operator]\ndef toQuantumPresentationWith\n    (R : FierzChannelReadout)\n    (support : R.State → Prop)\n    (generator : R.State → R.State) :\n    Presentation where\n  Scalar := ℝ\n  State := R.State\n  Observable := R.State → R.State\n  act := fun A ψ => A ψ\n  support := support\n  generator := generator\n  metricReadout := R.hilbert\n  phaseReadout := R.symplectic\n\n/--\nDefault support lane used by lightweight translator consumers.\n-/\n@[rep_depth operator]\ndef defaultSupport (R : FierzChannelReadout) : R.State → Prop :=\n  fun ψ => 0 ≤ R.hilbert ψ\n\n/--\nDefault generator lane used by lightweight translator consumers.\n-/\n@[rep_depth operator]\ndef defaultGenerator (R : FierzChannelReadout) : R.State → R.State :=\n  fun ψ => ψ\n\n/--\nDefault projection preserving the Hilbert and symplectic readout channels\navailable in the generic `Presentation` interface.\n-/\n@[rep_depth operator]\ndef toQuantumPresentation (R : FierzChannelReadout) : Presentation :=\n  toQuantumPresentationWith R (defaultSupport R) (defaultGenerator R)\n\n/-- Default full Fierz presentation, preserving all four Fierz channels. -/\n@[rep_depth operator]\ndef toFierzPresentation (R : FierzChannelReadout) : FierzPresentation :=\n  toFierzPresentationWith R (defaultSupport R) (defaultGenerator R)\n\n@[rep_depth operator]\ntheorem of_toFierzPresentation\n    (R : FierzChannelReadout) :\n    ofFierzPresentation R.toFierzPresentation = R :=\n  of_toFierzPresentationWith R (defaultSupport R) (defaultGenerator R)\n","rangeOffset":1667,"rangeLength":1367}]}