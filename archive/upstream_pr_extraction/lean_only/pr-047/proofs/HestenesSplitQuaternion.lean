import proofs.HestenesKreinColimitBridge

/-!
# Split quaternions

This is the 4-dimensional associative algebra generated by one square -1
unit and one square +1 unit with anticommutation.  It is represented by
M₂(ℝ), not by the 8-dimensional Cayley-Dickson doubling used for split
octonions.
-/

noncomputable section
namespace HestenesSplitQuaternion

abbrev M2R := Matrix (Fin 2) (Fin 2) ℝ

def i : M2R := !![0, 1; -1, 0]
def j : M2R := !![1, 0; 0, -1]
def k : M2R := i * j

@[simp] theorem i_sq : i * i = -(1 : M2R) := by
  ext a b <;> fin_cases a <;> fin_cases b <;>
    simp [i, Matrix.mul_apply, Fin.sum_univ_two]

@[simp] theorem j_sq : j * j = (1 : M2R) := by
  ext a b <;> fin_cases a <;> fin_cases b <;>
    simp [j, Matrix.mul_apply, Fin.sum_univ_two]

@[simp] theorem ij_anticomm : i * j + j * i = (0 : M2R) := by
  ext a b <;> fin_cases a <;> fin_cases b <;>
    simp [i, j, Matrix.mul_apply, Fin.sum_univ_two]

@[simp] theorem k_sq : k * k = (1 : M2R) := by
  ext a b <;> fin_cases a <;> fin_cases b <;>
    simp [k, i, j, Matrix.mul_apply, Fin.sum_univ_two]

end HestenesSplitQuaternion
end noncomputable section
