import Mathlib
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Canonical.KantorPeirceFiveGrading
import InfoGeometry.OperatorAlgebra.OperatorExteriorAlgebra

/-!
# Noncommutative operator five-grading

This is the associative operator-algebra layer over a (possibly noncommutative)
base ring `R`.  It deliberately does not identify a nonassociative carrier with
its regular operators.  The grading is defined by an inner commutator in an
associative algebra, so the Leibniz law and the product-grade rule are
kernel-level consequences of associativity.
-/

namespace InfoGeometry.OperatorAlgebra

open ExteriorAlgebra

section Ring

variable (R : Type*) [Ring R] {A : Type*} [Ring A] [Module R A]
  [IsScalarTower R A A] [SMulCommClass R A A]

/-- The inner derivation generated by `h` on an associative operator ring `A`
over any (possibly noncommutative) ring `R`. -/
def ringInnerOperatorDerivation (h : A) : OpDerivation R A where
  toLinearMap :=
    { toFun := fun x => h * x - x * h
      map_add' := by
        intro x y
        noncomm_ring
      map_smul' := by
        intro r x
        simp only [smul_mul_assoc, mul_smul_comm,
          RingHom.id_apply, smul_sub] }
  leibniz' := by
    intro x y
    change h * (x * y) - (x * y) * h =
      (h * x - x * h) * y + x * (h * y - y * h)
    noncomm_ring

variable {R}

@[simp] theorem ringInnerOperatorDerivation_apply (h x : A) :
    ringInnerOperatorDerivation R h x = h * x - x * h := rfl

theorem ringInnerOperatorDerivation_leibniz (h x y : A) :
    ringInnerOperatorDerivation R h (x * y) =
      ringInnerOperatorDerivation R h x * y + x * ringInnerOperatorDerivation R h y :=
  OpDerivation.leibniz (ringInnerOperatorDerivation R h) x y

theorem ringInnerOperatorDerivation_add (h x y : A) :
    ringInnerOperatorDerivation R h (x + y) =
      ringInnerOperatorDerivation R h x + ringInnerOperatorDerivation R h y :=
  OpDerivation.map_add (ringInnerOperatorDerivation R h) x y

theorem ringInnerOperatorDerivation_sub (h x y : A) :
    ringInnerOperatorDerivation R h (x - y) =
      ringInnerOperatorDerivation R h x - ringInnerOperatorDerivation R h y :=
  OpDerivation.map_sub (ringInnerOperatorDerivation R h) x y

theorem ringInnerOperatorDerivation_smul (h : A) (r : R) (x : A) :
    ringInnerOperatorDerivation R h (r • x) = r • ringInnerOperatorDerivation R h x :=
  OpDerivation.map_smul (ringInnerOperatorDerivation R h) r x

/-- A weight component for the inner derivation `ad h` over any `[Ring R]`. -/
def HasRingInnerOperatorWeight (h x : A) (r : R) : Prop :=
  ringInnerOperatorDerivation R h x = r • x

theorem ringInnerOperatorWeight_mul
    {h x y : A} {r s : R}
    (hx : HasRingInnerOperatorWeight h x r)
    (hy : HasRingInnerOperatorWeight h y s) :
    HasRingInnerOperatorWeight h (x * y) (r + s) := by
  unfold HasRingInnerOperatorWeight at *
  rw [ringInnerOperatorDerivation_leibniz, hx, hy]
  rw [smul_mul_assoc, mul_smul_comm, ← add_smul]

theorem ringInnerOperatorWeight_commutator
    {h x y : A} {r s : R}
    (hx : HasRingInnerOperatorWeight h x r)
    (hy : HasRingInnerOperatorWeight h y s) :
    HasRingInnerOperatorWeight h (x * y - y * x) (r + s) := by
  unfold HasRingInnerOperatorWeight at *
  rw [ringInnerOperatorDerivation_sub]
  rw [ringInnerOperatorWeight_mul hx hy, ringInnerOperatorWeight_mul hy hx]
  rw [smul_sub]
  simp only [add_comm]

end Ring

section Real

variable {A : Type*} [Ring A] [Algebra ℝ A]

/-- The inner derivation generated by `h` on a real associative operator algebra. -/
def innerOperatorDerivation (h : A) : OpDerivation ℝ A :=
  ringInnerOperatorDerivation ℝ h

@[simp] theorem innerOperatorDerivation_apply (h x : A) :
    innerOperatorDerivation h x = h * x - x * h := rfl

theorem innerOperatorDerivation_leibniz (h x y : A) :
    innerOperatorDerivation h (x * y) =
      innerOperatorDerivation h x * y + x * innerOperatorDerivation h y :=
  ringInnerOperatorDerivation_leibniz h x y

theorem innerOperatorDerivation_add (h x y : A) :
    innerOperatorDerivation h (x + y) =
      innerOperatorDerivation h x + innerOperatorDerivation h y :=
  ringInnerOperatorDerivation_add h x y

theorem innerOperatorDerivation_sub (h x y : A) :
    innerOperatorDerivation h (x - y) =
      innerOperatorDerivation h x - innerOperatorDerivation h y :=
  ringInnerOperatorDerivation_sub h x y

theorem innerOperatorDerivation_smul (h : A) (r : ℝ) (x : A) :
    innerOperatorDerivation h (r • x) = r • innerOperatorDerivation h x :=
  ringInnerOperatorDerivation_smul h r x

/-- A weight component for the inner derivation `ad h`. -/
def HasInnerOperatorWeight (h x : A) (r : ℝ) : Prop :=
  HasRingInnerOperatorWeight h x r

theorem innerOperatorWeight_mul
    {h x y : A} {r s : ℝ}
    (hx : HasInnerOperatorWeight h x r)
    (hy : HasInnerOperatorWeight h y s) :
    HasInnerOperatorWeight h (x * y) (r + s) :=
  ringInnerOperatorWeight_mul hx hy

theorem innerOperatorWeight_commutator
    {h x y : A} {r s : ℝ}
    (hx : HasInnerOperatorWeight h x r)
    (hy : HasInnerOperatorWeight h y s) :
    HasInnerOperatorWeight h (x * y - y * x) (r + s) :=
  ringInnerOperatorWeight_commutator hx hy

end Real

end InfoGeometry.OperatorAlgebra
