import InfoGeometry.Clifford.Cl11
import Mathlib.Analysis.Normed.Algebra.Exponential

section KreinThermal

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Endomorphism algebra of the doubled space. -/
abbrev AlgebraEnd (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] :=
  DoubledSpace E →L[ℝ] DoubledSpace E

/-- Modular conjugation of an observable by the flow generated by `ε`. -/
noncomputable def modularShift
    (spectralEpsilon : AlgebraEnd E) (β : ℝ) (B : AlgebraEnd E) :
    AlgebraEnd E :=
  (NormedSpace.exp (β • spectralEpsilon)) * B * (NormedSpace.exp (-β • spectralEpsilon))

/-- KMS condition at inverse temperature `β` for a linear functional `ω`. -/
def SatisfiesKMS
    (spectralEpsilon : AlgebraEnd E)
    (ω : AlgebraEnd E →L[ℝ] ℝ)
    (β : ℝ) : Prop :=
  ∀ A B : AlgebraEnd E,
    ω (A * modularShift (E := E) spectralEpsilon β B) = ω (B * A)

/-- At `β = 0`, the KMS identity reduces to trace symmetry `ω (A B) = ω (B A)`. -/
lemma kms_zero_implies_trace
    (spectralEpsilon : AlgebraEnd E)
    (ω : AlgebraEnd E →L[ℝ] ℝ)
    (hKMS : SatisfiesKMS (E := E) spectralEpsilon ω 0) :
    ∀ A B : AlgebraEnd E, ω (A * B) = ω (B * A) := by
  intro A B
  have h := hKMS A B
  simpa [SatisfiesKMS, modularShift, zero_smul, neg_zero] using h

/-- Thermal vacuum data in the doubled-space model. -/
structure ThermalVacuum where
  Omega : DoubledSpace E
  modularJ_fixed : modularJ (E := E) Omega = Omega
  spectralEpsilon_annihilates : spectralEpsilon (E := E) Omega = 0

lemma spectralEpsilon_eq_zero_iff (v : DoubledSpace E) :
    spectralEpsilon (E := E) v = 0 ↔ v = 0 := by
  rcases v with ⟨x, y⟩
  constructor
  · intro h
    have hx : x = 0 := by simpa [spectralEpsilon] using congrArg Prod.fst h
    have hy : y = 0 := by simpa [spectralEpsilon] using congrArg Prod.snd h
    ext <;> simp [hx, hy]
  · intro h
    simp [h]

@[simp] lemma ThermalVacuum.modularJ_Omega
    (Ω : ThermalVacuum (E := E)) :
    modularJ (E := E) Ω.Omega = Ω.Omega :=
  Ω.modularJ_fixed

@[simp] lemma ThermalVacuum.eq_zero
    (Ω : ThermalVacuum (E := E)) :
    Ω.Omega = 0 :=
  (spectralEpsilon_eq_zero_iff (E := E) Ω.Omega).1 Ω.spectralEpsilon_annihilates

/-- The exponential modular flow generated by `ε` leaves the thermal vacuum fixed. -/
lemma modularFlow_inv_Omega
    (Ω : ThermalVacuum (E := E))
    (t : ℝ) :
    (NormedSpace.exp (t • spectralEpsilon (E := E))) Ω.Omega = Ω.Omega := by
  simp

end KreinThermal
