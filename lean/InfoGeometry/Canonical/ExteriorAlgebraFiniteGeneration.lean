import Mathlib.LinearAlgebra.ExteriorAlgebra.Basic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.LinearAlgebra.ExteriorAlgebra.Grading
import Mathlib.LinearAlgebra.CliffordAlgebra.Contraction
import Mathlib.Tactic

/-!
# Finite generation of individual exterior-algebra elements

Every element of an exterior algebra is built from finitely many one-particle
generators.  This is the algebraic finiteness statement needed before a
mode-support argument can be made for exterior-Fock currents.  It does not
assert convergence of an infinite current or identify the finite set with a
set of integer labels.
-/

namespace InfoGeometry.Canonical.ExteriorAlgebraFiniteGeneration

open Set

theorem exists_finite_generating_set
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (x : ExteriorAlgebra R M) :
    ∃ S : Set M, S.Finite ∧
      x ∈ Algebra.adjoin R (ExteriorAlgebra.ι R '' S) := by
  induction x using ExteriorAlgebra.induction with
  | algebraMap r =>
      refine ⟨∅, finite_empty, ?_⟩
      exact (Algebra.adjoin R (ExteriorAlgebra.ι R '' (∅ : Set M))).algebraMap_mem r
  | ι v =>
      refine ⟨{v}, finite_singleton v, ?_⟩
      exact Algebra.subset_adjoin (by simp)
  | mul a b ha hb =>
      rcases ha with ⟨S, hS, ha⟩
      rcases hb with ⟨T, hT, hb⟩
      refine ⟨S ∪ T, hS.union hT, ?_⟩
      exact (Algebra.adjoin R (ExteriorAlgebra.ι R '' (S ∪ T))).mul_mem
        (Algebra.adjoin_mono (Set.image_mono Set.subset_union_left) ha)
        (Algebra.adjoin_mono (Set.image_mono Set.subset_union_right) hb)
  | add a b ha hb =>
      rcases ha with ⟨S, hS, ha⟩
      rcases hb with ⟨T, hT, hb⟩
      refine ⟨S ∪ T, hS.union hT, ?_⟩
      exact (Algebra.adjoin R (ExteriorAlgebra.ι R '' (S ∪ T))).add_mem
        (Algebra.adjoin_mono (Set.image_mono Set.subset_union_left) ha)
        (Algebra.adjoin_mono (Set.image_mono Set.subset_union_right) hb)

/- The local graded induction step for contraction.  If both the tail and its
   contraction lie in the algebra generated by `S`, then contracting a left
   generator from `S` keeps the result in that same algebra. -/
theorem contractLeft_ι_mul_mem_adjoin
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (v : M) (x : ExteriorAlgebra R M)
    (S : Set M)
    (hv : v ∈ S)
    (hx : x ∈ Algebra.adjoin R (ExteriorAlgebra.ι R '' S))
    (hcontract : CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ x ∈
      Algebra.adjoin R (ExteriorAlgebra.ι R '' S)) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ
        (ExteriorAlgebra.ι R v * x) ∈
      Algebra.adjoin R (ExteriorAlgebra.ι R '' S) := by
  rw [CliffordAlgebra.contractLeft_ι_mul]
  apply (Algebra.adjoin R (ExteriorAlgebra.ι R '' S)).sub_mem
  · exact (Algebra.adjoin R (ExteriorAlgebra.ι R '' S)).smul_mem
      hx (φ v)
  · exact (Algebra.adjoin R (ExteriorAlgebra.ι R '' S)).mul_mem
      (Algebra.subset_adjoin ⟨v, hv, rfl⟩) hcontract

/- The corresponding successor step for a displayed exterior monomial. -/
theorem contractLeft_ιMulti_succ_mem_adjoin
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (n : ℕ) (v : Fin (n + 1) → M)
    (S : Set M)
    (hv : v 0 ∈ S)
    (htail : ExteriorAlgebra.ιMulti R n (Matrix.vecTail v) ∈
      Algebra.adjoin R (ExteriorAlgebra.ι R '' S))
    (hcontractTail : CliffordAlgebra.contractLeft
        (Q := (0 : QuadraticForm R M)) φ
        (ExteriorAlgebra.ιMulti R n (Matrix.vecTail v)) ∈
      Algebra.adjoin R (ExteriorAlgebra.ι R '' S)) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ
        (ExteriorAlgebra.ιMulti R (n + 1) v) ∈
      Algebra.adjoin R (ExteriorAlgebra.ι R '' S) := by
  rw [ExteriorAlgebra.ιMulti_succ_apply]
  exact contractLeft_ι_mul_mem_adjoin φ (v 0)
    (ExteriorAlgebra.ιMulti R n (Matrix.vecTail v)) S hv htail hcontractTail

/- The native contraction recursion on an `ιMulti` monomial. -/
theorem contractLeft_ιMulti_succ_eq
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (n : ℕ) (v : Fin (n + 1) → M) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ
        (ExteriorAlgebra.ιMulti R (n + 1) v) =
      φ (v 0) • ExteriorAlgebra.ιMulti R n (Matrix.vecTail v) -
        ExteriorAlgebra.ι R (v 0) *
          CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ
            (ExteriorAlgebra.ιMulti R n (Matrix.vecTail v)) := by
  rw [ExteriorAlgebra.ιMulti_succ_apply,
    CliffordAlgebra.contractLeft_ι_mul]

/- Base case: contraction of a single exterior generator stays in the same
   generated subalgebra. -/
theorem contractLeft_ι_mem_adjoin
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (v : M) (S : Set M) (hv : v ∈ S) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ
        (ExteriorAlgebra.ι R v) ∈
      Algebra.adjoin R (ExteriorAlgebra.ι R '' S) := by
  rw [show ExteriorAlgebra.ι R v = ExteriorAlgebra.ι R v * 1 by simp]
  apply contractLeft_ι_mul_mem_adjoin φ v 1 S hv
  · exact (Algebra.adjoin R (ExteriorAlgebra.ι R '' S)).one_mem
  · simp

/- Every displayed exterior monomial generated by entries from `S` belongs to
   the corresponding algebraic subalgebra. -/
theorem ιMulti_mem_adjoin_of_forall_mem
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (n : ℕ) (v : Fin n → M) (S : Set M)
    (hv : ∀ i, v i ∈ S) :
    ExteriorAlgebra.ιMulti R n v ∈
      Algebra.adjoin R (ExteriorAlgebra.ι R '' S) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [ExteriorAlgebra.ιMulti_succ_apply]
      apply (Algebra.adjoin R (ExteriorAlgebra.ι R '' S)).mul_mem
      · exact Algebra.subset_adjoin ⟨v 0, hv 0, rfl⟩
      · exact ih (Matrix.vecTail v) (fun i => hv i.succ)

/- Full finite-monomial contraction, with the support hypothesis stated
   natively on the entries. -/
theorem contractLeft_ιMulti_mem_adjoin_of_forall_mem
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (n : ℕ) (v : Fin n → M) (S : Set M)
    (hv : ∀ i, v i ∈ S) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ
        (ExteriorAlgebra.ιMulti R n v) ∈
      Algebra.adjoin R (ExteriorAlgebra.ι R '' S) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [ExteriorAlgebra.ιMulti_succ_apply]
      apply contractLeft_ι_mul_mem_adjoin φ (v 0)
        (ExteriorAlgebra.ιMulti R n (Matrix.vecTail v)) S (hv 0)
      · exact ιMulti_mem_adjoin_of_forall_mem n (Matrix.vecTail v) S
          (fun i => hv i.succ)
      · exact ih (Matrix.vecTail v) (fun i => hv i.succ)

/- A contraction whose dual functional vanishes on every entry annihilates the
   displayed exterior monomial. -/
theorem contractLeft_ιMulti_eq_zero_of_forall_eq_zero
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (n : ℕ) (v : Fin n → M)
    (hv : ∀ i, φ (v i) = 0) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ
        (ExteriorAlgebra.ιMulti R n v) = 0 := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [ExteriorAlgebra.ιMulti_succ_apply,
        CliffordAlgebra.contractLeft_ι_mul]
      rw [hv 0]
      rw [ih (Matrix.vecTail v) (fun i => hv i.succ)]
      simp

/- The preceding monomial calculation extends to the whole exterior algebra
   when the dual functional is zero on the ambient module.  The extension is
   by Mathlib's canonical `ιMulti_span` theorem, not by an adjoin proxy. -/
theorem contractLeft_eq_zero_of_forall_eq_zero
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (hφ : ∀ v, φ v = 0) (x : ExteriorAlgebra R M) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ x = 0 := by
  have hx : x ∈ Submodule.span R
      (Set.range fun y : Σ n, (Fin n → M) => ExteriorAlgebra.ιMulti R y.1 y.2) := by
    rw [ExteriorAlgebra.ιMulti_span]
    trivial
  refine Submodule.span_induction (p := fun x _ =>
      CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ x = 0)
    ?_ ?_ ?_ ?_ hx
  · intro x hx
    obtain ⟨y, rfl⟩ := hx
    exact contractLeft_ιMulti_eq_zero_of_forall_eq_zero φ y.1 y.2
      (fun i => hφ (y.2 i))
  · simp
  · intro x y hx hy hxp hyp
    simpa using congrArg₂ (· + ·) hxp hyp
  · intro r x hx hxp
    simpa using congrArg (fun z => r • z) hxp

/- A dual functional which vanishes on a set vanishes on its linear span.  This
   is the exact finite-support propagation lemma needed before passing from
   generators to exterior monomials. -/
theorem dual_eq_zero_of_mem_span
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (S : Set M) (hS : ∀ v ∈ S, φ v = 0)
    {v : M} (hv : v ∈ Submodule.span R S) : φ v = 0 := by
  induction hv using Submodule.span_induction with
  | mem v hv => exact hS v hv
  | zero => simp
  | add v w hv hw hφv hφw =>
      simpa using congrArg₂ (· + ·) hφv hφw
  | smul r v hv hφv =>
      simpa using congrArg (fun z => r • z) hφv

/- Exterior monomials whose entries lie in the linear span of `S` belong to
   the algebra generated by the corresponding embedded generators. -/
theorem ιMulti_mem_adjoin_of_forall_mem_span
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (S : Set M) (n : ℕ) (v : Fin n → M)
    (hv : ∀ i, v i ∈ Submodule.span R S) :
    ExteriorAlgebra.ιMulti R n v ∈
      Algebra.adjoin R (ExteriorAlgebra.ι R '' S) := by
  have hι : ∀ w : M, w ∈ Submodule.span R S →
      ExteriorAlgebra.ι R w ∈ Algebra.adjoin R (ExteriorAlgebra.ι R '' S) := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
        exact Algebra.subset_adjoin ⟨w, hw, rfl⟩
    | zero => simp
    | add w z hw hz hIw hIz =>
        simpa using (Algebra.adjoin R (ExteriorAlgebra.ι R '' S)).add_mem hIw hIz
    | smul r w hw hIw =>
        simpa using (Algebra.adjoin R (ExteriorAlgebra.ι R '' S)).smul_mem hIw r
  induction n with
  | zero => simp
  | succ n ih =>
      rw [ExteriorAlgebra.ιMulti_succ_apply]
      exact (Algebra.adjoin R (ExteriorAlgebra.ι R '' S)).mul_mem
        (hι (v 0) (hv 0))
        (ih (Matrix.vecTail v) (fun i => hv i.succ))

/- Product of displayed exterior monomials is the displayed monomial on the
   concatenated finite index. -/
theorem ιMulti_mul_ιMulti
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (n m : ℕ) (v : Fin n → M) (w : Fin m → M) :
    ExteriorAlgebra.ιMulti R n v * ExteriorAlgebra.ιMulti R m w =
      ExteriorAlgebra.ιMulti R (n + m) (Fin.append v w) := by
  rw [ExteriorAlgebra.ιMulti_apply, ExteriorAlgebra.ιMulti_apply,
    ExteriorAlgebra.ιMulti_apply, ← List.prod_append,
    ← List.ofFn_fin_append]
  have hfun : Fin.append (fun i => ExteriorAlgebra.ι R (v i))
      (fun i => ExteriorAlgebra.ι R (w i)) =
      (fun i => ExteriorAlgebra.ι R (Fin.append v w i)) := by
    funext i
    refine Fin.addCases ?_ ?_ i <;> simp [Fin.append]
  rw [hfun]

def ιMultiSpan
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (S : Set M) : Submodule R (ExteriorAlgebra R M) :=
  Submodule.span R (Set.range fun y : Sigma (fun n : ℕ => {v : Fin n → M //
    ∀ i, v i ∈ Submodule.span R S}) => ExteriorAlgebra.ιMulti R y.1 y.2.1)

theorem ιMultiSpan_one
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (S : Set M) : (1 : ExteriorAlgebra R M) ∈ ιMultiSpan S := by
  apply Submodule.subset_span
  exact ⟨⟨0, ⟨fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩⟩,
    ExteriorAlgebra.ιMulti_zero_apply (R := R) (M := M) _⟩

theorem ιMultiSpan_mul
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (S : Set M) {x y : ExteriorAlgebra R M}
    (hx : x ∈ ιMultiSpan S) (hy : y ∈ ιMultiSpan S) :
    x * y ∈ ιMultiSpan S := by
  unfold ιMultiSpan at hx hy ⊢
  refine Submodule.span_induction (p := fun x _ => x * y ∈
      Submodule.span R (Set.range fun z : Sigma (fun n : ℕ => {v : Fin n → M //
        ∀ i, v i ∈ Submodule.span R S}) => ExteriorAlgebra.ιMulti R z.1 z.2.1))
    ?_ ?_ ?_ ?_ hx
  · intro x hx
    obtain ⟨u, rfl⟩ := hx
    refine Submodule.span_induction (p := fun y _ =>
        ExteriorAlgebra.ιMulti R u.1 u.2.1 * y ∈
          Submodule.span R (Set.range fun z : Sigma (fun n : ℕ => {v : Fin n → M //
            ∀ i, v i ∈ Submodule.span R S}) => ExteriorAlgebra.ιMulti R z.1 z.2.1))
      ?_ ?_ ?_ ?_ hy
    · intro y hy
      obtain ⟨v, rfl⟩ := hy
      rw [ιMulti_mul_ιMulti]
      apply Submodule.subset_span
      exact ⟨⟨u.1 + v.1, ⟨Fin.append u.2.1 v.2.1, by
        intro i
        refine Fin.addCases ?_ ?_ i
        · intro j
          simpa [Fin.append] using u.2.2 j
        · intro j
          simpa [Fin.append] using v.2.2 j⟩⟩, rfl⟩
    · simp
    · intro a b ha hb h₁ h₂
      simpa [mul_add] using Submodule.add_mem _ h₁ h₂
    · intro r a ha h₁
      simpa [smul_mul_assoc] using Submodule.smul_mem _ r h₁
  · simp
  · intro a b ha hb h₁ h₂
    simpa [add_mul] using Submodule.add_mem _ h₁ h₂
  · intro r a ha h₁
    simpa [smul_mul_assoc] using Submodule.smul_mem _ r h₁

def ιMultiSubalgebra
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (S : Set M) : Subalgebra R (ExteriorAlgebra R M) where
  carrier := fun x => x ∈ ιMultiSpan (R := R) (M := M) S
  mul_mem' := ιMultiSpan_mul S
  one_mem' := ιMultiSpan_one S
  add_mem' := fun ha hb => (ιMultiSpan (R := R) (M := M) S).add_mem ha hb
  zero_mem' := (ιMultiSpan (R := R) (M := M) S).zero_mem
  algebraMap_mem' := by
    intro r
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ r (ιMultiSpan_one S)

theorem adjoin_le_ιMultiSpan
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (S : Set M) :
    Algebra.adjoin R (ExteriorAlgebra.ι R '' S) ≤
      ιMultiSubalgebra (R := R) (M := M) S := by
  refine Algebra.adjoin_le ?_
  rintro _ ⟨v, hv, rfl⟩
  apply Submodule.subset_span
  exact ⟨⟨1, ⟨fun _ => v, fun _ => Submodule.subset_span hv⟩⟩, by simp⟩

/- Combined finite-generator form: the contraction vanishes on every displayed
   monomial whose entries lie in the span of a set on which the dual vanishes. -/
theorem contractLeft_ιMulti_eq_zero_of_forall_mem_span
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (S : Set M) (hS : ∀ w ∈ S, φ w = 0)
    (n : ℕ) (v : Fin n → M)
    (hv : ∀ i, v i ∈ Submodule.span R S) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ
        (ExteriorAlgebra.ιMulti R n v) = 0 := by
  apply contractLeft_ιMulti_eq_zero_of_forall_eq_zero φ n v
  intro i
  exact dual_eq_zero_of_mem_span φ S hS (hv i)

/- Linear extension of the preceding monomial statement.  This is deliberately
   phrased for the generated submodule of such monomials; no multiplicative
   closure of that submodule is asserted. -/
theorem contractLeft_eq_zero_of_mem_span_ιMulti_of_forall_mem_span
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (S : Set M) (hS : ∀ w ∈ S, φ w = 0)
    {x : ExteriorAlgebra R M}
    (hx : x ∈ Submodule.span R
      (Set.range fun y : Σ n, {v : Fin n → M //
          ∀ i, v i ∈ Submodule.span R S} =>
        ExteriorAlgebra.ιMulti R y.1 y.2.1)) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ x = 0 := by
  refine Submodule.span_induction (p := fun x _ =>
      CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ x = 0)
    ?_ ?_ ?_ ?_ hx
  · intro y hy
    obtain ⟨z, rfl⟩ := hy
    exact contractLeft_ιMulti_eq_zero_of_forall_mem_span φ S hS
      z.1 z.2.1 z.2.2
  · simp
  · intro a b ha hb hza hzb
    simpa using congrArg₂ (· + ·) hza hzb
  · intro r a ha hza
    simpa using congrArg (fun z => r • z) hza

/- A dual annihilating the chosen one-particle generators annihilates every
   element of the exterior subalgebra they generate. -/
theorem contractLeft_eq_zero_of_mem_adjoin_of_forall_mem
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (φ : Module.Dual R M) (S : Set M) (hS : ∀ w ∈ S, φ w = 0)
    {x : ExteriorAlgebra R M}
    (hx : x ∈ Algebra.adjoin R (ExteriorAlgebra.ι R '' S)) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R M)) φ x = 0 := by
  apply contractLeft_eq_zero_of_mem_span_ιMulti_of_forall_mem_span φ S hS
  exact (adjoin_le_ιMultiSpan (R := R) (M := M) S) hx

end InfoGeometry.Canonical.ExteriorAlgebraFiniteGeneration
