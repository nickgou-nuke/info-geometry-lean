import InfoGeometry.Canonical.InformationPartitionCore
import InfoGeometry.Canonical.KreinDiracPolarizationBridge
import InfoGeometry.Meta.Architecture

/-!
# Krein Dirac Spectral Lift

First spectral-lift layer above the Dirac/Krein/polarization bridge.

This file does not claim a full spectral theorem on Krein space. It only packages
existing owner facts on the doubled carrier:

- Bogoliubov transport moves the chirality weight sectors,
- the transported Dirac operator generates an exponential flow,
- the existing partition/log-partition calculus applies to that transported
  generator.
-/

namespace InfoGeometry.Canonical.KreinDiracSpectralLift

open InfoGeometry.Quantum.RealMajorana
open InfoGeometry.Canonical.KreinDiracPolarizationBridge
open InfoGeometry.Canonical.SpectralInference
open InfoGeometry.Canonical.InformationCalculus.ModularRadonNikodymData
open InfoGeometry.Krein

section Doubled

variable {E : Type}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {M : RealMajoranaDatum (S := DoubledSpace E)}

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
noncomputable local instance : NormedSpace ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance

/-- Exponential flow generated by the transported Dirac operator. -/
@[rep_depth transport]
noncomputable def transportDiracFlow
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M) (τ : ℝ) : EndH :=
  NormedSpace.exp (τ • transportDirac IST T)

@[simp] theorem transportDiracFlow_zero
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M) :
    transportDiracFlow IST T 0 = (1 : EndH) := by
  simp [transportDiracFlow]

/-- Additive-time law for the exponential flow generated by the transported Dirac operator. -/
theorem transportDiracFlow_add
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M) (s t : ℝ) :
    transportDiracFlow IST T (s + t)
      = transportDiracFlow IST T s * transportDiracFlow IST T t := by
  have hComm : Commute (s • transportDirac IST T) (t • transportDirac IST T) := by
    exact ((Commute.refl (transportDirac IST T)).smul_left s).smul_right t
  calc
    transportDiracFlow IST T (s + t)
        = NormedSpace.exp ((s + t) • transportDirac IST T) := rfl
    _ = NormedSpace.exp (s • transportDirac IST T + t • transportDirac IST T) := by
          simp [add_smul]
    _ = NormedSpace.exp (s • transportDirac IST T) *
          NormedSpace.exp (t • transportDirac IST T) := by
          rw [NormedSpace.exp_add_of_commute hComm]
    _ = transportDiracFlow IST T s * transportDiracFlow IST T t := rfl

/-- The existing partition calculus applies to the transported Dirac generator. -/
theorem hasDerivAt_transportDiracPartitionFunction_zero
    (ω : EndH →L[ℝ] ℝ)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M) :
    HasDerivAt
      (fun τ : ℝ => informationPartitionFunction ω (transportDirac IST T) τ)
      (ω (transportDirac IST T)) 0 :=
  hasDerivAt_informationPartitionFunction_zero (ω := ω) (K := transportDirac IST T)

/-- Normalized log-partition lift for the transported Dirac generator. -/
theorem hasDerivAt_logTransportDiracPartitionFunction_zero_of_normalized
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1)
    (IST : InfoSpectralTriple H₂)
    (T : RealBogoliubovTransform (S := H₂) M) :
    HasDerivAt
      (fun τ : ℝ => logInformationPartitionFunction ω (transportDirac IST T) τ)
      (ω (transportDirac IST T)) 0 :=
  hasDerivAt_logInformationPartitionFunction_zero_of_normalized
    (ω := ω) (K := transportDirac IST T) hω1

/-- Strict symmetry transports the chirality weight sectors into the transported carrier weights. -/
theorem transportedChiralityWeights_of_strictSymmetry
    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :
    Submodule.map h.f.toLinearMap M.weylPlus = (h.toBogoliubovTransform).transportWeylPlus ∧
    Submodule.map h.f.toLinearMap M.weylMinus = (h.toBogoliubovTransform).transportWeylMinus := by
  exact ⟨by simpa [PolarizedMajorana.Hom.toBogoliubovTransform] using
      (h.toBogoliubovTransform.map_weylPlus_eq_transportWeylPlus (M := M)),
    by simpa [PolarizedMajorana.Hom.toBogoliubovTransform] using
      (h.toBogoliubovTransform.map_weylMinus_eq_transportWeylMinus (M := M))⟩

/--
First packaged spectral lift on the doubled carrier:
strict symmetry transports chirality weights, and the transported Dirac
generator enters the existing exponential/partition calculus.
-/
theorem kreinDiracSpectralLift_of_strictSymmetry
    (ω : EndH →L[ℝ] ℝ)
    (IST : InfoSpectralTriple H₂)
    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :
    Submodule.map h.f.toLinearMap M.weylPlus = (h.toBogoliubovTransform).transportWeylPlus ∧
    Submodule.map h.f.toLinearMap M.weylMinus = (h.toBogoliubovTransform).transportWeylMinus ∧
    HasDerivAt
      (fun τ : ℝ => informationPartitionFunction ω (transportDirac IST h.toBogoliubovTransform) τ)
      (ω (transportDirac IST h.toBogoliubovTransform)) 0 := by
  exact ⟨(transportedChiralityWeights_of_strictSymmetry (M := M) h).1,
    (transportedChiralityWeights_of_strictSymmetry (M := M) h).2,
    hasDerivAt_transportDiracPartitionFunction_zero
      (ω := ω) (IST := IST) (T := h.toBogoliubovTransform)⟩

/-- Normalized log-partition version of the first spectral lift. -/
theorem normalized_logKreinDiracSpectralLift_of_strictSymmetry
    (ω : EndH →L[ℝ] ℝ)
    (hω1 : ω (1 : EndH) = 1)
    (IST : InfoSpectralTriple H₂)
    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :
    HasDerivAt
      (fun τ : ℝ => logInformationPartitionFunction ω (transportDirac IST h.toBogoliubovTransform) τ)
      (ω (transportDirac IST h.toBogoliubovTransform)) 0 :=
  hasDerivAt_logTransportDiracPartitionFunction_zero_of_normalized
    (ω := ω) (hω1 := hω1) (IST := IST) (T := h.toBogoliubovTransform)

end Doubled

end InfoGeometry.Canonical.KreinDiracSpectralLift
