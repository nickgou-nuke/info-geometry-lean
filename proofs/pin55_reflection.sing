// Singular exact polynomial certificate for a generic O(5,5) reflection.
ring r = 0,(t,a1,a2,a3,a4,a5,a6,a7,a8,a9,a10,
              v1,v2,v3,v4,v5,v6,v7,v8,v9,v10),dp;

poly Qa = a1^2+a2^2+a3^2+a4^2+a5^2-a6^2-a7^2-a8^2-a9^2-a10^2;
poly Qv = v1^2+v2^2+v3^2+v4^2+v5^2-v6^2-v7^2-v8^2-v9^2-v10^2;
poly p = 2*(a1*v1+a2*v2+a3*v3+a4*v4+a5*v5
            -a6*v6-a7*v7-a8*v8-a9*v9-a10*v10);
poly r1=v1-t*p*a1; poly r2=v2-t*p*a2; poly r3=v3-t*p*a3;
poly r4=v4-t*p*a4; poly r5=v5-t*p*a5; poly r6=v6-t*p*a6;
poly r7=v7-t*p*a7; poly r8=v8-t*p*a8; poly r9=v9-t*p*a9;
poly r10=v10-t*p*a10;
poly Qr=r1^2+r2^2+r3^2+r4^2+r5^2-r6^2-r7^2-r8^2-r9^2-r10^2;
ideal I=t*Qa-1;
ideal G=std(I);
poly cert=reduce(Qr-Qv,G);
if (cert != 0) { ERROR("split reflection certificate failed"); }
"pin55_reflection.sing: PASS";
"generic reflection preserves Q(5,5) modulo t*Q(a)-1";
quit;
