import Mathlib.Tactic

/-!
# Canonical operator symbol algebra core

Dimension-free algebraic owners for two structures repeatedly used by the
finite Pauli--Dirac and Peirce/Witt bridges:

* an off-diagonal operator on `V × W`, whose square is controlled by the two
  ordered compositions of its chiral blocks;
* a rank-one CAR pair in an arbitrary associative ring, from which the two
  complementary Peirce projectors and their transport identities follow.

These statements are purely algebraic.  They make no analytic, spectral,
bundle, or unbounded-operator assertion.
-/

noncomputable section

namespace InfoGeometry.Algebra.OperatorSymbolCore

/-! ## Off-diagonal symbol square -/

section OffDiagonal

variable {R V W : Type*}
variable [CommSemiring R]
variable [AddCommMonoid V] [Module R V]
variable [AddCommMonoid W] [Module R W]

/-- The universal off-diagonal block operator with chiral blocks `A` and `B`. -/
def offDiagonalEnd (A : W →ₗ[R] V) (B : V →ₗ[R] W) : Module.End R (V × W) where
  toFun ψ := (A ψ.2, B ψ.1)
  map_add' := by
    intro x y
    ext <;> simp
  map_smul' := by
    intro r x
    ext <;> simp

@[simp]
theorem offDiagonalEnd_apply
    (A : W →ₗ[R] V) (B : V →ₗ[R] W) (v : V) (w : W) :
    offDiagonalEnd A B (v, w) = (A w, B v) :=
  rfl

/-- Squaring an off-diagonal symbol produces the two ordered block
compositions. -/
theorem offDiagonalEnd_sq_apply
    (A : W →ₗ[R] V) (B : V →ₗ[R] W) (ψ : V × W) :
    offDiagonalEnd A B (offDiagonalEnd A B ψ) =
      ((A.comp B) ψ.1, (B.comp A) ψ.2) := by
  rcases ψ with ⟨v, w⟩
  rfl

/-- If both ordered block products are the same scalar identity, the complete
off-diagonal symbol squares to that scalar on the product carrier. -/
theorem offDiagonalEnd_sq_scalar_apply
    (A : W →ₗ[R] V) (B : V →ₗ[R] W) (q : R)
    (hAB : A.comp B = q • (LinearMap.id : Module.End R V))
    (hBA : B.comp A = q • (LinearMap.id : Module.End R W))
    (ψ : V × W) :
    offDiagonalEnd A B (offDiagonalEnd A B ψ) = q • ψ := by
  rw [offDiagonalEnd_sq_apply, hAB, hBA]
  rcases ψ with ⟨v, w⟩
  ext <;> simp

/-- Endomorphism form of the scalar square law. -/
theorem offDiagonalEnd_sq_scalar
    (A : W →ₗ[R] V) (B : V →ₗ[R] W) (q : R)
    (hAB : A.comp B = q • (LinearMap.id : Module.End R V))
    (hBA : B.comp A = q • (LinearMap.id : Module.End R W)) :
    (offDiagonalEnd A B).comp (offDiagonalEnd A B) =
      q • (LinearMap.id : Module.End R (V × W)) := by
  apply LinearMap.ext
  intro ψ
  exact offDiagonalEnd_sq_scalar_apply A B q hAB hBA ψ

end OffDiagonal

/-! ## Rank-one CAR / Peirce algebra -/

section RankOneCAR

variable {A : Type*} [Ring A]

/-- Particle/occupied Peirce projector generated by a CAR pair. -/
def carPlus (create annihilate : A) : A := create * annihilate

/-- Hole/vacuum Peirce projector generated by a CAR pair. -/
def carMinus (create annihilate : A) : A := annihilate * create

/-- CAR immediately gives completeness of the two Peirce sectors. -/
theorem car_projectors_complete
    {create annihilate : A}
    (hcar : create * annihilate + annihilate * create = 1) :
    carPlus create annihilate + carMinus create annihilate = 1 := by
  simpa [carPlus, carMinus] using hcar

/-- A square-zero CAR creation operator satisfies `c† c c† = c†`. -/
theorem create_annihilate_create
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    create * annihilate * create = create := by
  have h := congrArg (fun x : A => x * create) hcar
  simpa [add_mul, mul_assoc, hcreate] using h

/-- A square-zero CAR annihilation operator satisfies `c c† c = c`. -/
theorem annihilate_create_annihilate
    {create annihilate : A}
    (hannihilate : annihilate * annihilate = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    annihilate * create * annihilate = annihilate := by
  have h := congrArg (fun x : A => x * annihilate) hcar
  simpa [add_mul, mul_assoc, hannihilate] using h

/-- The occupied Peirce sector is idempotent. -/
theorem carPlus_idempotent
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carPlus create annihilate * carPlus create annihilate =
      carPlus create annihilate := by
  simp only [carPlus, ← mul_assoc]
  rw [create_annihilate_create hcreate hcar]

/-- The hole Peirce sector is idempotent. -/
theorem carMinus_idempotent
    {create annihilate : A}
    (hannihilate : annihilate * annihilate = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carMinus create annihilate * carMinus create annihilate =
      carMinus create annihilate := by
  simp only [carMinus, ← mul_assoc]
  rw [annihilate_create_annihilate hannihilate hcar]

/-- The two CAR Peirce projectors are orthogonal in both orders. -/
theorem car_projectors_orthogonal
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hannihilate : annihilate * annihilate = 0) :
    carPlus create annihilate * carMinus create annihilate = 0 ∧
      carMinus create annihilate * carPlus create annihilate = 0 := by
  constructor
  · calc
      carPlus create annihilate * carMinus create annihilate =
          create * (annihilate * annihilate) * create := by
            simp [carPlus, carMinus, mul_assoc]
      _ = 0 := by rw [hannihilate]; simp
  · calc
      carMinus create annihilate * carPlus create annihilate =
          annihilate * (create * create) * annihilate := by
            simp [carPlus, carMinus, mul_assoc]
      _ = 0 := by rw [hcreate]; simp

/-- Creation maps the hole sector into the occupied sector exactly. -/
theorem car_create_peirce_transport
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carPlus create annihilate * create * carMinus create annihilate = create := by
  rw [carPlus, carMinus]
  have hucu := create_annihilate_create hcreate hcar
  calc
    (create * annihilate) * create * (annihilate * create) =
        (create * annihilate * create) * (annihilate * create) := by
          simp [mul_assoc]
    _ = create * (annihilate * create) := by rw [hucu]
    _ = create * annihilate * create := by simp [mul_assoc]
    _ = create := hucu

/-- Annihilation maps the occupied sector into the hole sector exactly. -/
theorem car_annihilate_peirce_transport
    {create annihilate : A}
    (hannihilate : annihilate * annihilate = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carMinus create annihilate * annihilate * carPlus create annihilate =
      annihilate := by
  rw [carPlus, carMinus]
  have hdc := annihilate_create_annihilate hannihilate hcar
  calc
    (annihilate * create) * annihilate * (create * annihilate) =
        (annihilate * create * annihilate) * (create * annihilate) := by
          simp [mul_assoc]
    _ = annihilate * (create * annihilate) := by rw [hdc]
    _ = annihilate * create * annihilate := by simp [mul_assoc]
    _ = annihilate := hdc

/-- Complete rank-one CAR/Peirce packet. -/
theorem rankOneCAR_peirce_packet
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hannihilate : annihilate * annihilate = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carPlus create annihilate * carPlus create annihilate = carPlus create annihilate ∧
      carMinus create annihilate * carMinus create annihilate = carMinus create annihilate ∧
      carPlus create annihilate + carMinus create annihilate = 1 ∧
      carPlus create annihilate * carMinus create annihilate = 0 ∧
      carMinus create annihilate * carPlus create annihilate = 0 ∧
      carPlus create annihilate * create * carMinus create annihilate = create ∧
      carMinus create annihilate * annihilate * carPlus create annihilate = annihilate := by
  rcases car_projectors_orthogonal hcreate hannihilate with ⟨hpm, hmp⟩
  exact ⟨carPlus_idempotent hcreate hcar,
    carMinus_idempotent hannihilate hcar,
    car_projectors_complete hcar,
    hpm, hmp,
    car_create_peirce_transport hcreate hcar,
    car_annihilate_peirce_transport hannihilate hcar⟩

end RankOneCAR

end InfoGeometry.Algebra.OperatorSymbolCore
