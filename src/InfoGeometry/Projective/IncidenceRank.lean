import Mathlib.LinearAlgebra.Projectivization.Collinear
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.Tactic

/-!
# Projective incidence and the rank of spans

The point carrier is Mathlib's actual quotient `Projectivization K V`. Its
rank is the dimension of the sum of the corresponding one-dimensional
subspaces. In an orthogonal-projection realization these are the operator
ranges, not the linear span of the projection operators as elements of an
endomorphism algebra.

All results are proved over an arbitrary division ring. Finite-dimensionality
is explicit; no finite-rank expression is used as a proxy for infinite rank.
-/

noncomputable section

open Module
open scoped LinearAlgebra.Projectivization

namespace InfoGeometry.Projective.IncidenceRank

variable {K V : Type*} [DivisionRing K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V]

/-- The subspace generated by a finite family of projective points. -/
def pointSpan (s : Finset (Projectivization K V)) : Submodule K V :=
  s.sup Projectivization.submodule

/-- Geometric rank, measured in the original vector space. -/
def pointRank (s : Finset (Projectivization K V)) : ℕ :=
  finrank K (pointSpan s)

omit [FiniteDimensional K V] in
@[simp] theorem pointSpan_empty :
    pointSpan (∅ : Finset (Projectivization K V)) = ⊥ := by
  simp [pointSpan]

omit [FiniteDimensional K V] in
@[simp] theorem pointSpan_singleton (p : Projectivization K V) :
    pointSpan {p} = p.submodule := by
  simp [pointSpan]

omit [FiniteDimensional K V] in
@[simp] theorem pointRank_empty :
    pointRank (∅ : Finset (Projectivization K V)) = 0 := by
  change finrank K (pointSpan (∅ : Finset (Projectivization K V))) = 0
  rw [pointSpan_empty, finrank_bot]

omit [FiniteDimensional K V] in
@[simp] theorem pointRank_singleton (p : Projectivization K V) :
    pointRank {p} = 1 := by
  change finrank K (pointSpan {p}) = 1
  rw [pointSpan_singleton]
  exact p.finrank_submodule

omit [FiniteDimensional K V] in
theorem pointSpan_le_iff (s : Finset (Projectivization K V)) (U : Submodule K V) :
    pointSpan s ≤ U ↔ ∀ p ∈ s, p.submodule ≤ U :=
  Finset.sup_le_iff

omit [FiniteDimensional K V] in
theorem submodule_le_pointSpan {s : Finset (Projectivization K V)}
    {p : Projectivization K V} (hp : p ∈ s) : p.submodule ≤ pointSpan s :=
  Finset.le_sup hp

omit [FiniteDimensional K V] in
theorem pointSpan_mono {s t : Finset (Projectivization K V)} (h : s ⊆ t) :
    pointSpan s ≤ pointSpan t :=
  Finset.sup_mono h

theorem pointRank_mono {s t : Finset (Projectivization K V)} (h : s ⊆ t) :
    pointRank s ≤ pointRank t :=
  Submodule.finrank_mono (pointSpan_mono h)

theorem pointRank_le_ambient (s : Finset (Projectivization K V)) :
    pointRank s ≤ finrank K V :=
  Submodule.finrank_le _

/-- Native projective collinearity is exactly geometric rank at most two. -/
theorem isCollinear_iff_pointRank_le_two (s : Finset (Projectivization K V)) :
    Projectivization.IsCollinear (s : Set (Projectivization K V)) ↔ pointRank s ≤ 2 := by
  constructor
  · rintro ⟨M, _, hdim, hmem⟩
    have hle : pointSpan s ≤ M.submodule := by
      apply (pointSpan_le_iff s M.submodule).mpr
      intro p hp
      apply (Submodule.mem_projectivization_iff_submodule_le M.submodule p).mp
      rw [Projectivization.Subspace.submodule.symm_apply_apply]
      exact hmem hp
    exact (Submodule.finrank_mono hle).trans hdim
  · intro h
    refine ⟨(pointSpan s).projectivization, ?_, ?_, ?_⟩
    · rw [Projectivization.Subspace.submodule.apply_symm_apply]
      infer_instance
    · rw [Projectivization.Subspace.submodule.apply_symm_apply]
      exact h
    · intro p hp
      exact (Submodule.mem_projectivization_iff_submodule_le (pointSpan s) p).mpr
        (submodule_le_pointSpan hp)

/-- Finite-dimensional incidence is precisely absence of rank growth. -/
theorem subspace_le_iff_finrank_sup_eq (U W : Submodule K V) :
    U ≤ W ↔ finrank K (U ⊔ W : Submodule K V) = finrank K W := by
  constructor
  · intro h
    rw [sup_of_le_right h]
  · intro h
    have heq : W = U ⊔ W :=
      Submodule.eq_of_le_of_finrank_eq le_sup_right h.symm
    rw [heq]
    exact le_sup_left

section FinsetOperations

variable [DecidableEq (Projectivization K V)]

omit [FiniteDimensional K V] in
@[simp] theorem pointSpan_insert (p : Projectivization K V)
    (s : Finset (Projectivization K V)) :
    pointSpan (insert p s) = p.submodule ⊔ pointSpan s :=
  Finset.sup_insert

omit [FiniteDimensional K V] in
@[simp] theorem pointSpan_union (s t : Finset (Projectivization K V)) :
    pointSpan (s ∪ t) = pointSpan s ⊔ pointSpan t :=
  Finset.sup_union

/-- Subcardinality follows by adding at most one dimension per projective point. -/
theorem pointRank_le_card (s : Finset (Projectivization K V)) :
    pointRank s ≤ s.card := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert p s hp ih =>
      have hdim := Submodule.finrank_add_le_finrank_add_finrank p.submodule (pointSpan s)
      rw [p.finrank_submodule] at hdim
      change finrank K (pointSpan (insert p s)) ≤ (insert p s).card
      rw [pointSpan_insert, Finset.card_insert_of_notMem hp]
      change finrank K (pointSpan s) ≤ s.card at ih
      omega

/-- The rank inequality inherited from the modular lattice of subspaces. -/
theorem pointRank_submodular (s t : Finset (Projectivization K V)) :
    pointRank (s ∪ t) + pointRank (s ∩ t) ≤ pointRank s + pointRank t := by
  have hinter : pointSpan (s ∩ t) ≤ pointSpan s ⊓ pointSpan t :=
    le_inf (pointSpan_mono Finset.inter_subset_left)
      (pointSpan_mono Finset.inter_subset_right)
  have hmono := Submodule.finrank_mono hinter
  have hdim := Submodule.finrank_sup_add_finrank_inf_eq (pointSpan s) (pointSpan t)
  change finrank K (pointSpan (s ∪ t)) + finrank K (pointSpan (s ∩ t)) ≤
    finrank K (pointSpan s) + finrank K (pointSpan t)
  rw [pointSpan_union]
  omega

/-- The common-subset form of submodularity used in incidence rank calculations. -/
theorem pointRank_union_add_common_le (s t i : Finset (Projectivization K V))
    (his : i ⊆ s) (hit : i ⊆ t) :
    pointRank (s ∪ t) + pointRank i ≤ pointRank s + pointRank t :=
  (Nat.add_le_add_left (pointRank_mono (Finset.subset_inter his hit)) _).trans
    (pointRank_submodular s t)

/-- A point belongs to the span exactly when inserting it leaves the rank unchanged. -/
theorem pointRank_insert_eq_iff (p : Projectivization K V)
    (s : Finset (Projectivization K V)) :
    pointRank (insert p s) = pointRank s ↔ p.submodule ≤ pointSpan s := by
  change finrank K (pointSpan (insert p s)) = finrank K (pointSpan s) ↔
    p.submodule ≤ pointSpan s
  rw [pointSpan_insert]
  exact (subspace_le_iff_finrank_sup_eq p.submodule (pointSpan s)).symm

/-- A point outside a span increases its rank by exactly one. -/
theorem pointRank_insert_of_not_le (p : Projectivization K V)
    (s : Finset (Projectivization K V)) (hp : ¬p.submodule ≤ pointSpan s) :
    pointRank (insert p s) = pointRank s + 1 := by
  have hv : p.rep ∉ pointSpan s := by
    intro hv
    apply hp
    rw [p.submodule_eq]
    exact Submodule.span_le.mpr (by simpa using hv)
  change finrank K (pointSpan (insert p s)) = finrank K (pointSpan s) + 1
  rw [pointSpan_insert, p.submodule_eq, sup_comm]
  exact Submodule.finrank_sup_span_singleton (p := pointSpan s) hv

end FinsetOperations

omit [FiniteDimensional K V] in
/-- Distinct projective points generate a two-dimensional vector subspace. -/
theorem finrank_sup_points {p q : Projectivization K V} (hpq : p ≠ q) :
    finrank K (p.submodule ⊔ q.submodule : Submodule K V) = 2 := by
  have hupper := Submodule.finrank_add_le_finrank_add_finrank p.submodule q.submodule
  rw [p.finrank_submodule, q.finrank_submodule] at hupper
  have hlower : 2 ≤ finrank K (p.submodule ⊔ q.submodule : Submodule K V) := by
    by_contra h
    have hdim : finrank K (p.submodule ⊔ q.submodule : Submodule K V) ≤ 1 := by omega
    have hp : p.submodule = p.submodule ⊔ q.submodule :=
      Submodule.eq_of_le_of_finrank_le le_sup_left (by simpa [p.finrank_submodule] using hdim)
    have hq : q.submodule = p.submodule ⊔ q.submodule :=
      Submodule.eq_of_le_of_finrank_le le_sup_right (by simpa [q.finrank_submodule] using hdim)
    exact hpq (Projectivization.submodule_injective (hp.trans hq.symm))
  omega

/-- Every two-dimensional subspace incident with two distinct points is their span. -/
theorem line_eq_span {p q : Projectivization K V} (hpq : p ≠ q)
    {L : Submodule K V} (hL : finrank K L = 2)
    (hp : p.submodule ≤ L) (hq : q.submodule ≤ L) :
    L = p.submodule ⊔ q.submodule := by
  apply Projectivization.line_unique hpq L (p.submodule ⊔ q.submodule)
    hL (finrank_sup_points hpq)
  · exact (Submodule.mem_projectivization_iff_submodule_le L p).mpr hp
  · exact (Submodule.mem_projectivization_iff_submodule_le L q).mpr hq
  · exact (Submodule.mem_projectivization_iff_submodule_le _ p).mpr le_sup_left
  · exact (Submodule.mem_projectivization_iff_submodule_le _ q).mpr le_sup_right

/-- Existence and uniqueness of the line through two distinct points. -/
theorem existsUnique_line {p q : Projectivization K V} (hpq : p ≠ q) :
    ∃! L : Submodule K V, finrank K L = 2 ∧ p.submodule ≤ L ∧ q.submodule ≤ L := by
  refine ⟨p.submodule ⊔ q.submodule,
    ⟨finrank_sup_points hpq, le_sup_left, le_sup_right⟩, ?_⟩
  intro L hL
  exact line_eq_span hpq hL.1 hL.2.1 hL.2.2

/-- A nonzero subspace contains a genuine point of Mathlib's projective quotient. -/
theorem exists_point_iff_ne_bot (U : Submodule K V) :
    (∃ p : Projectivization K V, p.submodule ≤ U) ↔ U ≠ ⊥ := by
  constructor
  · rintro ⟨p, hp⟩ hU
    have hdim := Submodule.finrank_mono hp
    rw [p.finrank_submodule, hU, finrank_bot] at hdim
    omega
  · intro hU
    obtain ⟨v, hv, hv0⟩ := U.ne_bot_iff.mp hU
    refine ⟨Projectivization.mk K v hv0, ?_⟩
    rw [Projectivization.submodule_mk]
    exact Submodule.span_le.mpr (by simpa using hv)

theorem exists_common_point_iff (L M : Submodule K V) :
    (∃ p : Projectivization K V, p.submodule ≤ L ∧ p.submodule ≤ M) ↔ L ⊓ M ≠ ⊥ := by
  simp_rw [← le_inf_iff]
  exact exists_point_iff_ne_bot (L ⊓ M)

/-- Two projective lines meet precisely when their joint vector rank is at most three. -/
theorem lines_meet_iff_rank_le_three {L M : Submodule K V}
    (hL : finrank K L = 2) (hM : finrank K M = 2) :
    (∃ p : Projectivization K V, p.submodule ≤ L ∧ p.submodule ≤ M) ↔
      finrank K (L ⊔ M : Submodule K V) ≤ 3 := by
  rw [exists_common_point_iff, ← Submodule.one_le_finrank_iff]
  have hdim := Submodule.finrank_sup_add_finrank_inf_eq L M
  rw [hL, hM] at hdim
  omega

/-- Distinct projective lines have joint vector rank at least three. -/
theorem three_le_finrank_sup_lines {L M : Submodule K V}
    (hL : finrank K L = 2) (hM : finrank K M = 2) (hne : L ≠ M) :
    3 ≤ finrank K (L ⊔ M : Submodule K V) := by
  by_contra h
  have hdim : finrank K (L ⊔ M : Submodule K V) ≤ 2 := by omega
  have hleft : L = L ⊔ M :=
    Submodule.eq_of_le_of_finrank_le le_sup_left (by simpa [hL] using hdim)
  have hright : M = L ⊔ M :=
    Submodule.eq_of_le_of_finrank_le le_sup_right (by simpa [hM] using hdim)
  exact hne (hleft.trans hright.symm)

/-- Two skew projective lines have joint vector rank four, and conversely. -/
theorem lines_skew_iff_rank_four {L M : Submodule K V}
    (hL : finrank K L = 2) (hM : finrank K M = 2) :
    (¬∃ p : Projectivization K V, p.submodule ≤ L ∧ p.submodule ≤ M) ↔
      finrank K (L ⊔ M : Submodule K V) = 4 := by
  rw [lines_meet_iff_rank_le_three hL hM]
  have hdim := Submodule.finrank_sup_add_finrank_inf_eq L M
  rw [hL, hM] at hdim
  omega

/-- Vector dimension three forces every pair of projective lines to meet. -/
theorem lines_meet_in_projective_plane (hV : finrank K V = 3)
    {L M : Submodule K V} (hL : finrank K L = 2) (hM : finrank K M = 2) :
    ∃ p : Projectivization K V, p.submodule ≤ L ∧ p.submodule ≤ M := by
  apply (lines_meet_iff_rank_le_three hL hM).mpr
  simpa only [hV] using (Submodule.finrank_le (L ⊔ M))

/-- Distinct lines in a projective plane have a one-dimensional intersection. -/
theorem finrank_inf_lines_in_plane (hV : finrank K V = 3)
    {L M : Submodule K V} (hL : finrank K L = 2) (hM : finrank K M = 2)
    (hne : L ≠ M) : finrank K (L ⊓ M : Submodule K V) = 1 := by
  have hlower := three_le_finrank_sup_lines hL hM hne
  have hupper : finrank K (L ⊔ M : Submodule K V) ≤ 3 := by
    simpa only [hV] using (Submodule.finrank_le (L ⊔ M))
  have hdim := Submodule.finrank_sup_add_finrank_inf_eq L M
  rw [hL, hM] at hdim
  omega

/-- A one-dimensional intersection determines a unique quotient point. -/
theorem existsUnique_common_point_of_finrank_inf_eq_one {L M : Submodule K V}
    (hdim : finrank K (L ⊓ M : Submodule K V) = 1) :
    ∃! p : Projectivization K V, p.submodule ≤ L ∧ p.submodule ≤ M := by
  let p := Projectivization.mk'' (L ⊓ M) hdim
  have hp : p.submodule = L ⊓ M := Projectivization.submodule_mk'' _ _
  refine ⟨p, ?_, ?_⟩
  · change p.submodule ≤ L ∧ p.submodule ≤ M
    rw [hp]
    exact ⟨inf_le_left, inf_le_right⟩
  · intro q hq
    apply Projectivization.submodule_injective
    rw [hp]
    exact Submodule.eq_of_le_of_finrank_eq (le_inf hq.1 hq.2)
      (by rw [q.finrank_submodule, hdim])

/-- Distinct lines in a projective plane meet in exactly one point. -/
theorem existsUnique_common_point_in_plane (hV : finrank K V = 3)
    {L M : Submodule K V} (hL : finrank K L = 2) (hM : finrank K M = 2)
    (hne : L ≠ M) :
    ∃! p : Projectivization K V, p.submodule ≤ L ∧ p.submodule ≤ M :=
  existsUnique_common_point_of_finrank_inf_eq_one (finrank_inf_lines_in_plane hV hL hM hne)

end InfoGeometry.Projective.IncidenceRank
