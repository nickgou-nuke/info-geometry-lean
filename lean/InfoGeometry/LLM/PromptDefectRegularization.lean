import InfoGeometry.LLM.Llama4SpinSpec
import InfoGeometry.Meta.Architecture

open scoped BigOperators InnerProductSpace

namespace InfoGeometry.LLM

open Llama4BlockSpec

section PromptRegularization

variable {S : Type*}
variable [NormedAddCommGroup S] [InnerProductSpace ℝ S] [CompleteSpace S]

local notation "N" => InfoGeometry.Krein.NeutralSpace S
local notation "EndN" => N →L[ℝ] N

variable {Pos Expert : Type*} [Fintype Expert] [DecidableEq Expert]

/--
Mangled prompt model: a clean channel plus a perturbation channel weighted by `ε`.
-/
structure MangledPrompt where
  clean : EndN
  perturbation : EndN
  ε : ℝ

namespace MangledPrompt

/-- Mixed latent input generated by prompt mangling / code-switching perturbations. -/
noncomputable def mixedInput (μ : MangledPrompt (S := S)) : EndN :=
  μ.clean + μ.ε • μ.perturbation

end MangledPrompt

/-- Defect-regularized core update with penalty weight `λ`. -/
noncomputable def regularizedCoreUpdate
    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))
    (lambda : ℝ) (x : EndN) : EndN :=
  B.residualUpdate x +
    ((B.moe.shared x + B.moe.routed.activeOutput x) + lambda • B.moe.routed.defectOutput x)

/-- Regularized run: apply the spin/pin checker layer after regularized core update. -/
noncomputable def regularizedRun
    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))
    (lambda : ℝ) (x : EndN) : EndN :=
  B.spinPin.layer.run (regularizedCoreUpdate (B := B) lambda x)

@[rep_depth transport]
theorem defect_quarantined_on_mixed_input
    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))
    (μ : MangledPrompt (S := S)) :
    B.moe.routed.defectOutput (MangledPrompt.mixedInput μ) = 0 := by
  exact B.moe.routed.defectOutput_eq_zero (MangledPrompt.mixedInput μ)

/-- In hard-zero sparse routing, regularized core update is independent of `λ`. -/
@[rep_depth transport]
theorem regularizedCoreUpdate_lambda_invariant
    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))
    (lambda1 lambda2 : ℝ) (x : EndN) :
    regularizedCoreUpdate (B := B) lambda1 x = regularizedCoreUpdate (B := B) lambda2 x := by
  have hDef : B.moe.routed.defectOutput x = 0 := B.moe.routed.defectOutput_eq_zero x
  have hZero1 : lambda1 • B.moe.routed.defectOutput x = (0 : EndN) := by
    rw [hDef]
    apply ContinuousLinearMap.ext
    intro y
    simp
  have hZero2 : lambda2 • B.moe.routed.defectOutput x = (0 : EndN) := by
    rw [hDef]
    apply ContinuousLinearMap.ext
    intro y
    simp
  unfold regularizedCoreUpdate
  rw [hZero1, hZero2]

/-- Defect-regularized core update collapses to the canonical core update. -/
@[rep_depth transport]
theorem regularizedCoreUpdate_eq_coreUpdate
    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))
    (lambda : ℝ) (x : EndN) :
    regularizedCoreUpdate (B := B) lambda x = B.coreUpdate x := by
  have hDef : B.moe.routed.defectOutput x = 0 := B.moe.routed.defectOutput_eq_zero x
  have hZeroDef : lambda • B.moe.routed.defectOutput x = (0 : EndN) := by
    rw [hDef]
    apply ContinuousLinearMap.ext
    intro y
    simp
  unfold regularizedCoreUpdate Llama4BlockSpec.coreUpdate Llama4BlockSpec.routedUpdate
  rw [B.moe.output_eq_shared_plus_active x]
  rw [hZeroDef]
  simp

/-- Consequently, the regularized run is independent of `λ`. -/
@[rep_depth transport]
theorem regularizedRun_lambda_invariant
    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))
    (lambda1 lambda2 : ℝ) (x : EndN) :
    regularizedRun (B := B) lambda1 x = regularizedRun (B := B) lambda2 x := by
  unfold regularizedRun
  rw [regularizedCoreUpdate_lambda_invariant (B := B) lambda1 lambda2 x]

/-- Mixed-input version: perturbation-induced defect channel remains quarantined. -/
@[rep_depth transport]
theorem regularizedRun_lambda_invariant_on_mixed_input
    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))
    (μ : MangledPrompt (S := S))
    (lambda1 lambda2 : ℝ) :
    regularizedRun (B := B) lambda1 (MangledPrompt.mixedInput μ)
      = regularizedRun (B := B) lambda2 (MangledPrompt.mixedInput μ) := by
  exact regularizedRun_lambda_invariant (B := B) lambda1 lambda2 (MangledPrompt.mixedInput μ)

/-- Regularized run collapses to the canonical spin/pin-checked block run. -/
@[rep_depth transport]
theorem regularizedRun_eq_run
    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))
    (lambda : ℝ) (x : EndN) :
    regularizedRun (B := B) lambda x = B.run x := by
  unfold regularizedRun Llama4BlockSpec.run
  rw [regularizedCoreUpdate_eq_coreUpdate (B := B) lambda x]

/-- Mixed-input specialization of the regularized-to-canonical run collapse. -/
@[rep_depth transport]
theorem regularizedRun_eq_run_on_mixed_input
    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))
    (μ : MangledPrompt (S := S))
    (lambda : ℝ) :
    regularizedRun (B := B) lambda (MangledPrompt.mixedInput μ)
      = B.run (MangledPrompt.mixedInput μ) := by
  exact regularizedRun_eq_run (B := B) lambda (MangledPrompt.mixedInput μ)

end PromptRegularization

end InfoGeometry.LLM
