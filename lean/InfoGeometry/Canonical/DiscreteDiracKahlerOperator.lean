import Mathlib
import InfoGeometry.Canonical.DiscreteRationalDiracKahler
import InfoGeometry.Canonical.ThreeColorIntegralMultiplicationTable
import InfoGeometry.Canonical.StandardIntegralSplitOctonionMultiplication

namespace InfoGeometry.Canonical

/-!
  A finite algebraic Dirac--Kähler differential generated by a chosen
  square-zero element.  The associativity hypothesis is explicit: it is not
  silently inferred for the global split-octonion carrier.
-/

def discreteExteriorDerivative
    (theta omega : StandardIntegralSplitOctonion) :
    StandardIntegralSplitOctonion :=
  splitOctonionMul theta omega

theorem splitOctonionMul_zero_left
    (omega : StandardIntegralSplitOctonion) :
    splitOctonionMul 0 omega = 0 := by
  ext r
  simp [splitOctonionMul]



theorem discrete_d_sq_eq_neg_associator
    (theta omega : StandardIntegralSplitOctonion)
    (h_theta_sq : splitOctonionMul theta theta = 0) :
    discreteExteriorDerivative theta
        (discreteExteriorDerivative theta omega) =
      -splitAssociator theta theta omega := by
  unfold discreteExteriorDerivative splitAssociator
  rw [h_theta_sq, splitOctonionMul_zero_left]
  simp

theorem discrete_d_sq_zero_of_associative
    (theta omega : StandardIntegralSplitOctonion)
    (h_theta_sq : splitOctonionMul theta theta = 0)
    (h_assoc :
      splitOctonionMul theta (splitOctonionMul theta omega) =
        splitOctonionMul (splitOctonionMul theta theta) omega) :
    discreteExteriorDerivative theta
        (discreteExteriorDerivative theta omega) = 0 := by
  dsimp [discreteExteriorDerivative]
  rw [h_assoc, h_theta_sq, splitOctonionMul_zero_left]

theorem master_discrete_dirac_kahler_synthesis
    (theta omega : StandardIntegralSplitOctonion)
    (h_theta_sq : splitOctonionMul theta theta = 0)
    (h_assoc :
      splitOctonionMul theta (splitOctonionMul theta omega) =
        splitOctonionMul (splitOctonionMul theta theta) omega) :
    discreteExteriorDerivative theta
        (discreteExteriorDerivative theta omega) = 0 :=
  discrete_d_sq_zero_of_associative theta omega h_theta_sq h_assoc

end InfoGeometry.Canonical
