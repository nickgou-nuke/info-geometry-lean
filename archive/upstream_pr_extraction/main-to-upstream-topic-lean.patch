index 000000000..3fc02d5eb
--- /dev/null
+++ b/lean/InfoGeometry/Analysis/BipolarWindingExactSequence.lean
@@ -0,0 +1,153 @@
+import InfoGeometry.Analysis.BipolarPeriodDescent
+import Mathlib.Tactic
+
+/-!
+# Exact algebraic sequence behind the bipolar period map
+
+The explicit winding carrier is `ℤ × ℤ`.  The logarithmic differential with
+residue vector `(1,-1)` first applies the difference homomorphism
+
+`(m,n) ↦ m-n`
+
+and then embeds the resulting integer as the complex period
+
+`k ↦ k (2πi)`.
+
+The difference map is surjective and its kernel is the diagonal subgroup.  This
+is the exact reason the period image is cyclic even though the source winding
+carrier has two independent generators.
+-/
+
+noncomputable section
+
+namespace InfoGeometry.Analysis.BipolarWindingExactSequence
+
+open InfoGeometry.Analysis.BipolarWindingPeriodLattice
+open InfoGeometry.Analysis.BipolarPeriodDescent
+
+/-- Residue pairing as a genuine additive homomorphism `ℤ² → ℤ`. -/
+def residueWindingHom : WindingPair →+ ℤ where
+  toFun := residueWinding
+  map_zero' := by
+    simp [residueWinding]
+  map_add' u v := by
+    rcases u with ⟨u₀, u₁⟩
+    rcases v with ⟨v₀, v₁⟩
+    simp [residueWinding]
+    ring
+
+@[simp] theorem residueWindingHom_apply (w : WindingPair) :
+    residueWindingHom w = residueWinding w := rfl
+
+/-- Diagonal winding subgroup, invisible to the residue-difference form. -/
+def diagonalWindingSubgroup : AddSubgroup WindingPair where
+  carrier := {w | w.1 = w.2}
+  zero_mem' := rfl
+  add_mem' := by
+    intro u v hu hv
+    change u.1 + v.1 = u.2 + v.2
+    rw [hu, hv]
+  neg_mem' := by
+    intro w hw
+    change -w.1 = -w.2
+    rw [hw]
+
+@[simp] theorem mem_diagonalWindingSubgroup (w : WindingPair) :
+    w ∈ diagonalWindingSubgroup ↔ w.1 = w.2 := Iff.rfl
+
+/-- Exact kernel of the residue pairing. -/
+theorem residueWindingHom_ker :
+    residueWindingHom.ker = diagonalWindingSubgroup := by
+  ext w
+  change residueWinding w = 0 ↔ w.1 = w.2
+  unfold residueWinding
+  exact sub_eq_zero
+
+/-- Every integer residue winding is represented by `(k,0)`. -/
+theorem residueWindingHom_surjective :
+    Function.Surjective residueWindingHom := by
+  intro k
+  refine ⟨(k, 0), ?_⟩
+  simp [residueWindingHom, residueWinding]
+
+/-- Integer embedding into the complex period line. -/
+def integerPeriodEmbedding : ℤ →+ ℂ where
+  toFun k := (k : ℂ) * (2 * Real.pi * Complex.I : ℂ)
+  map_zero' := by simp
+  map_add' m n := by
+    push_cast
+    ring
+
+@[simp] theorem integerPeriodEmbedding_apply (k : ℤ) :
+    integerPeriodEmbedding k =
+      (k : ℂ) * (2 * Real.pi * Complex.I : ℂ) := rfl
+
+/-- The full circulation period as a genuine additive homomorphism. -/
+def circulationPeriodHom : WindingPair →+ ℂ where
+  toFun := circulationPeriod
+  map_zero' := by
+    simp [circulationPeriod, residueWinding]
+  map_add' := circulationPeriod_add_pair
+
+@[simp] theorem circulationPeriodHom_apply (w : WindingPair) :
+    circulationPeriodHom w = circulationPeriod w := rfl
+
+/-- The circulation homomorphism is exactly the composite of residue difference
+and the integer period embedding. -/
+theorem circulationPeriodHom_eq_comp :
+    circulationPeriodHom = integerPeriodEmbedding.comp residueWindingHom := by
+  ext w
+  rfl
+
+/-- Exact kernel of the complex period map. -/
+theorem circulationPeriodHom_ker :
+    circulationPeriodHom.ker = diagonalWindingSubgroup := by
+  ext w
+  change circulationPeriod w = 0 ↔ w.1 = w.2
+  exact circulationPeriod_eq_zero_iff w
+
+/-- The complex period map and the integer period embedding have exactly the
+same range. -/
+theorem circulationPeriodHom_range_eq :
+    circulationPeriodHom.range = integerPeriodEmbedding.range := by
+  ext z
+  constructor
+  · rintro ⟨w, rfl⟩
+    exact ⟨residueWinding w, rfl⟩
+  · rintro ⟨k, rfl⟩
+    refine ⟨(k, 0), ?_⟩
+    simp [circulationPeriodHom, circulationPeriod, residueWinding,
+      integerPeriodEmbedding]
+
+/-- The cyclic period image is generated by `2πi`. -/
+theorem integerPeriodEmbedding_range_eq_zmultiples :
+    integerPeriodEmbedding.range =
+      AddSubgroup.zmultiples (2 * Real.pi * Complex.I : ℂ) := by
+  ext z
+  simp [integerPeriodEmbedding, AddSubgroup.mem_zmultiples_iff,
+    zsmul_eq_mul, eq_comm]
+
+/-- Therefore the range of the explicit winding period homomorphism is the
+native `2πiℤ` subgroup. -/
+theorem circulationPeriodHom_range_eq_zmultiples :
+    circulationPeriodHom.range =
+      AddSubgroup.zmultiples (2 * Real.pi * Complex.I : ℂ) := by
+  rw [circulationPeriodHom_range_eq,
+    integerPeriodEmbedding_range_eq_zmultiples]
+
+/-- Compact exact-sequence packet. -/
+theorem bipolar_winding_exact_sequence_packet :
+    residueWindingHom.ker = diagonalWindingSubgroup ∧
+      Function.Surjective residueWindingHom ∧
+      circulationPeriodHom =
+        integerPeriodEmbedding.comp residueWindingHom ∧
+      circulationPeriodHom.ker = diagonalWindingSubgroup ∧
+      circulationPeriodHom.range =
+        AddSubgroup.zmultiples (2 * Real.pi * Complex.I : ℂ) := by
+  exact ⟨residueWindingHom_ker,
+    residueWindingHom_surjective,
+    circulationPeriodHom_eq_comp,
+    circulationPeriodHom_ker,
+    circulationPeriodHom_range_eq_zmultiples⟩
+
+end InfoGeometry.Analysis.BipolarWindingExactSequence
