import InfoGeometry.Canonical.TensorStageFrechetConnection
import InfoGeometry.OperatorAlgebra.PeirceSpine.Basic

/-! # Peirce grading for continuous matrix-stage Leibniz derivations

An even inner generator defines a continuous Fréchet–Leibniz derivation
that intertwines Peirce pinching. Both the grading and the action transport
through the actual iterated tensor-stage bonding maps.
-/

noncomputable section

namespace InfoGeometry.Canonical.TensorFrechetPeirceGrading

open scoped Matrix Matrix.Norms.Operator
open InfoGeometry.Clifford.Cl11TensorTowerLimit
open InfoGeometry.Clifford.Cl11TensorTower
open InfoGeometry.Clifford.TowerMatrix
open InfoGeometry.Algebra.DirectLimitSuperClosureLemmas
open InfoGeometry.Canonical.TensorStageFrechetConnection
open InfoGeometry.OperatorAlgebra.PeirceSpine

/-- The inner continuous derivation generated by an even matrix commutes
with the Peirce even projection. -/
theorem stageInnerFrechet_evenGrade (n : ℕ) (P H T : Stage n)
    (hP : P * P = P) :
    evenGrade P (stageInnerFrechet n (evenGrade P H) T) =
      stageInnerFrechet n (evenGrade P H) (evenGrade P T) := by
  change evenGrade P (evenGrade P H * T - T * evenGrade P H) =
    evenGrade P H * evenGrade P T - evenGrade P T * evenGrade P H
  unfold evenGrade
  peirce_nf hP

/-- An odd generator exchanges the even and odd Peirce components under
its continuous inner Leibniz derivation. -/
theorem stageInnerFrechet_oddGrade (n : ℕ) (P H T : Stage n)
    (hP : P * P = P) :
    evenGrade P (stageInnerFrechet n (oddGrade P H) T) =
      stageInnerFrechet n (oddGrade P H) (oddGrade P T) ∧
    oddGrade P (stageInnerFrechet n (oddGrade P H) T) =
      stageInnerFrechet n (oddGrade P H) (evenGrade P T) := by
  constructor
  · change evenGrade P (oddGrade P H * T - T * oddGrade P H) =
      oddGrade P H * oddGrade P T - oddGrade P T * oddGrade P H
    unfold evenGrade oddGrade
    peirce_nf hP
  · change oddGrade P (oddGrade P H * T - T * oddGrade P H) =
      oddGrade P H * evenGrade P T - evenGrade P T * oddGrade P H
    unfold evenGrade oddGrade
    peirce_nf hP

/-- The even-generator derivation also preserves the odd component. -/
theorem stageInnerFrechet_evenGenerator_oddGrade (n : ℕ) (P H T : Stage n)
    (hP : P * P = P) :
    oddGrade P (stageInnerFrechet n (evenGrade P H) T) =
      stageInnerFrechet n (evenGrade P H) (oddGrade P T) := by
  change oddGrade P (evenGrade P H * T - T * evenGrade P H) =
    evenGrade P H * oddGrade P T - oddGrade P T * evenGrade P H
  unfold evenGrade oddGrade
  peirce_nf hP

/-- Peirce pinching is compatible with the actual iterated bonding maps. -/
theorem bondMap_evenGrade {n m : ℕ} (hnm : n ≤ m) (P T : Stage n) :
    bondMap stageBond n m hnm (evenGrade P T) =
      evenGrade (bondMap stageBond n m hnm P) (bondMap stageBond n m hnm T) := by
  simp only [evenGrade, map_add, map_mul, map_sub, map_one]

/-- The complementary Peirce component also transports along every
iterated tensor-stage inclusion. -/
theorem bondMap_oddGrade {n m : ℕ} (hnm : n ≤ m) (P T : Stage n) :
    bondMap stageBond n m hnm (oddGrade P T) =
      oddGrade (bondMap stageBond n m hnm P) (bondMap stageBond n m hnm T) := by
  simp only [oddGrade, map_add, map_mul, map_sub, map_one]

/-- The continuous inner derivation itself transports through every
iterated stage inclusion, not merely its value on a scalar subalgebra. -/
theorem bondMap_stageInnerFrechet {n m : ℕ} (hnm : n ≤ m) (H T : Stage n) :
    bondMap stageBond n m hnm (stageInnerFrechet n H T) =
      stageInnerFrechet m (bondMap stageBond n m hnm H) (bondMap stageBond n m hnm T) := by
  change bondMap stageBond n m hnm (H * T - T * H) = _
  change bondMap stageBond n m hnm (H * T - T * H) =
    bondMap stageBond n m hnm H * bondMap stageBond n m hnm T -
      bondMap stageBond n m hnm T * bondMap stageBond n m hnm H
  simp only [map_mul, map_sub]

/-- The finite-stage parity compatibility persists after transport to every
later stage, while retaining the full continuous Leibniz derivation. -/
theorem bondMap_frechet_evenGrade {n m : ℕ} (hnm : n ≤ m) (P H T : Stage n)
    (hP : P * P = P) :
    bondMap stageBond n m hnm
        (evenGrade P (stageInnerFrechet n (evenGrade P H) T)) =
      stageInnerFrechet m (evenGrade (bondMap stageBond n m hnm P)
        (bondMap stageBond n m hnm H))
        (evenGrade (bondMap stageBond n m hnm P) (bondMap stageBond n m hnm T)) := by
  rw [stageInnerFrechet_evenGrade n P H T hP, bondMap_stageInnerFrechet,
    bondMap_evenGrade, bondMap_evenGrade]

/-- An odd generator continues to exchange the two Peirce grades after
transport to any later finite stage. -/
theorem bondMap_frechet_oddGenerator {n m : ℕ} (hnm : n ≤ m) (P H T : Stage n)
    (hP : P * P = P) :
    bondMap stageBond n m hnm (evenGrade P (stageInnerFrechet n (oddGrade P H) T)) =
      stageInnerFrechet m (oddGrade (bondMap stageBond n m hnm P)
        (bondMap stageBond n m hnm H))
        (oddGrade (bondMap stageBond n m hnm P) (bondMap stageBond n m hnm T)) ∧
    bondMap stageBond n m hnm (oddGrade P (stageInnerFrechet n (oddGrade P H) T)) =
      stageInnerFrechet m (oddGrade (bondMap stageBond n m hnm P)
        (bondMap stageBond n m hnm H))
        (evenGrade (bondMap stageBond n m hnm P) (bondMap stageBond n m hnm T)) := by
  constructor
  · rw [(stageInnerFrechet_oddGrade n P H T hP).1, bondMap_stageInnerFrechet,
      bondMap_oddGrade, bondMap_oddGrade]
  · rw [(stageInnerFrechet_oddGrade n P H T hP).2, bondMap_stageInnerFrechet,
      bondMap_oddGrade, bondMap_evenGrade]

/-- Peirce pinching is preserved by the canonical map into the actual
algebraic tensor colimit. -/
theorem ofStage_evenGrade (n : ℕ) (P T : Stage n) :
    ofStage n (evenGrade P T) = evenGrade (ofStage n P) (ofStage n T) := by
  simp only [evenGrade, map_add, map_mul, map_sub, map_one]

/-- The finite-stage continuous derivation has the corresponding inner
algebraic action in the colimit; no topology on the colimit is assumed. -/
theorem ofStage_stageInnerFrechet (n : ℕ) (H T : Stage n) :
    ofStage n (stageInnerFrechet n H T) =
      ofStage n H * ofStage n T - ofStage n T * ofStage n H := by
  change ofStage n (H * T - T * H) = _
  simp only [map_sub, map_mul]

/-- The even grading law transports from a continuous finite-stage
Leibniz derivation to its inner action on represented colimit elements. -/
theorem ofStage_frechet_evenGrade (n : ℕ) (P H T : Stage n)
    (hP : P * P = P) :
    evenGrade (ofStage n P)
      (ofStage n (stageInnerFrechet n (evenGrade P H) T)) =
    ofStage n (stageInnerFrechet n (evenGrade P H) (evenGrade P T)) := by
  rw [← ofStage_evenGrade, stageInnerFrechet_evenGrade n P H T hP]

/-- The odd Peirce component maps to the corresponding colimit component. -/
theorem ofStage_oddGrade (n : ℕ) (P T : Stage n) :
    ofStage n (oddGrade P T) = oddGrade (ofStage n P) (ofStage n T) := by
  simp only [oddGrade, map_add, map_mul, map_sub, map_one]

/-- Both grade-exchange laws for an odd continuous finite-stage generator
hold for its image in the algebraic colimit. -/
theorem ofStage_frechet_oddGenerator (n : ℕ) (P H T : Stage n)
    (hP : P * P = P) :
    evenGrade (ofStage n P) (ofStage n (stageInnerFrechet n (oddGrade P H) T)) =
      ofStage n (stageInnerFrechet n (oddGrade P H) (oddGrade P T)) ∧
    oddGrade (ofStage n P) (ofStage n (stageInnerFrechet n (oddGrade P H) T)) =
      ofStage n (stageInnerFrechet n (oddGrade P H) (evenGrade P T)) := by
  constructor
  · rw [← ofStage_evenGrade, (stageInnerFrechet_oddGrade n P H T hP).1]
  · rw [← ofStage_oddGrade, (stageInnerFrechet_oddGrade n P H T hP).2]

end InfoGeometry.Canonical.TensorFrechetPeirceGrading

end
