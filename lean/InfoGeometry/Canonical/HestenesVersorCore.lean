import Mathlib.LinearAlgebra.CliffordAlgebra.SpinGroup
import InfoGeometry.Algebra.FiniteSpinAlgebra

/-!
# Native Clifford versor vocabulary

This module gives the project-level names for Mathlib's native hierarchy.
`lipschitzGroup Q` is the subgroup of units generated by invertible Clifford
vectors; `pinGroup Q` and `spinGroup Q` are the unitary and even submonoids.
The concrete twisted actions and Cartan--Dieudonné factorizations remain owned
by the Clifford modules that construct them.
-/

namespace InfoGeometry.Canonical.HestenesVersorCore

open CliffordAlgebra

variable {R M : Type*} [CommRing R]
variable [AddCommGroup M] [Module R M]
variable {Q : QuadraticForm R M}

/-- Project-level name for a native Clifford versor (a Lipschitz unit). -/
abbrev Versor := lipschitzGroup Q

/-- Project-level name for the native unitary Pin submonoid. -/
abbrev PinVersor := pinGroup Q

/-- Project-level name for the native even Spin submonoid. -/
abbrev SpinVersor := spinGroup Q

theorem pinVersor_toUnits_mem_versor (g : PinVersor (Q := Q)) :
    pinGroup.toUnits g ∈ Versor (Q := Q) := by
  exact pinGroup.units_mem_lipschitzGroup (x := pinGroup.toUnits g) g.property

theorem spinVersor_mem_pinVersor (g : SpinVersor (Q := Q)) :
    (g : CliffordAlgebra Q) ∈ PinVersor (Q := Q) := by
  exact spinGroup.mem_pin g.property

theorem spinVersor_involute_eq (g : SpinVersor (Q := Q)) :
    CliffordAlgebra.involute (g : CliffordAlgebra Q) = g := by
  exact spinGroup.involute_eq g.property

end InfoGeometry.Canonical.HestenesVersorCore
