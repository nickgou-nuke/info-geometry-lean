import Mathlib.Algebra.BigOperators.Field
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

/-!
# Explicit finite Souriau Massieu-Planck functional

This file gives the finite, constructive thermodynamic layer used by the
boundary free-entropy model:

* finite Gibbs weights from an energy readout;
* pointwise surprisal;
* Boltzmann entropy;
* Massieu-Planck potential;
* KL divergence and scalar Bregman divergence;
* the combined Souriau/free-entropy action readout.

It proves only finite algebraic identities.  It does not assert that the
Einstein-Hilbert term or the Bekenstein-Hawking area law has been induced.
-/

namespace InfoGeometry.Physics.SouriauMassieuPlanckFunctional

open Finset
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι]

/-- Finite Souriau partition function `Z(β) = Σ exp(-β Eᵢ)`. -/
def souriauPartition (beta : ℝ) (energy : ι → ℝ) : ℝ :=
  ∑ i : ι, Real.exp (-beta * energy i)

/-- The finite Souriau partition function is positive on a nonempty state space. -/
theorem souriauPartition_pos [Nonempty ι] (beta : ℝ) (energy : ι → ℝ) :
    0 < souriauPartition beta energy := by
  unfold souriauPartition
  exact Finset.sum_pos (fun i _ => Real.exp_pos (-beta * energy i)) Finset.univ_nonempty

/-- Gibbs weight `ρᵢ(β) = exp(-β Eᵢ) / Z(β)`. -/
def gibbsWeight (beta : ℝ) (energy : ι → ℝ) (i : ι) : ℝ :=
  Real.exp (-beta * energy i) / souriauPartition beta energy

/-- Gibbs weights are positive on a nonempty state space. -/
theorem gibbsWeight_pos [Nonempty ι] (beta : ℝ) (energy : ι → ℝ) (i : ι) :
    0 < gibbsWeight beta energy i := by
  unfold gibbsWeight
  exact div_pos (Real.exp_pos (-beta * energy i)) (souriauPartition_pos beta energy)

/-- Gibbs weights sum to one. -/
theorem gibbsWeight_sum_eq_one [Nonempty ι] (beta : ℝ) (energy : ι → ℝ) :
    (∑ i : ι, gibbsWeight beta energy i) = 1 := by
  unfold gibbsWeight souriauPartition
  rw [← Finset.sum_div]
  exact div_self (ne_of_gt (souriauPartition_pos beta energy))

/-- Pointwise surprisal `-log p`. -/
def surprisal (p : ℝ) : ℝ :=
  -Real.log p

/-- Boltzmann entropy `Σ pᵢ (-log pᵢ)` for an explicit finite weight function. -/
def boltzmannEntropy (weight : ι → ℝ) : ℝ :=
  ∑ i : ι, weight i * surprisal (weight i)

/-- Massieu-Planck potential `Φ(β) = log Z(β)`. -/
def massieuPlanckPotential (beta : ℝ) (energy : ι → ℝ) : ℝ :=
  Real.log (souriauPartition beta energy)

/-- Mean energy under the explicit finite Gibbs weights. -/
def meanEnergy (beta : ℝ) (energy : ι → ℝ) : ℝ :=
  ∑ i : ι, gibbsWeight beta energy i * energy i

/-- Pointwise Gibbs surprisal is `β Eᵢ + Φ(β)`. -/
theorem surprisal_gibbsWeight [Nonempty ι]
    (beta : ℝ) (energy : ι → ℝ) (i : ι) :
    surprisal (gibbsWeight beta energy i) =
      beta * energy i + massieuPlanckPotential beta energy := by
  have hZ : souriauPartition beta energy ≠ 0 :=
    ne_of_gt (souriauPartition_pos beta energy)
  have hExp : Real.exp (-beta * energy i) ≠ 0 :=
    Real.exp_ne_zero (-beta * energy i)
  unfold surprisal gibbsWeight massieuPlanckPotential
  rw [Real.log_div hExp hZ, Real.log_exp]
  ring

/-- Souriau entropy identity `S(β) = Φ(β) + β U(β)` for finite Gibbs weights. -/
theorem boltzmannEntropy_gibbsWeight_eq_massieu_add_beta_meanEnergy
    [Nonempty ι] (beta : ℝ) (energy : ι → ℝ) :
    boltzmannEntropy (gibbsWeight beta energy) =
      massieuPlanckPotential beta energy + beta * meanEnergy beta energy := by
  unfold boltzmannEntropy meanEnergy
  simp_rw [surprisal_gibbsWeight beta energy]
  simp_rw [mul_add]
  rw [Finset.sum_add_distrib]
  have hsum : (∑ i : ι, gibbsWeight beta energy i) = 1 :=
    gibbsWeight_sum_eq_one beta energy
  have hEnergy :
      (∑ i : ι, gibbsWeight beta energy i * (beta * energy i)) =
        beta * (∑ i : ι, gibbsWeight beta energy i * energy i) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => by ring)
  have hMassieu :
      (∑ i : ι, gibbsWeight beta energy i * massieuPlanckPotential beta energy) =
        massieuPlanckPotential beta energy * (∑ i : ι, gibbsWeight beta energy i) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => by ring)
  rw [hEnergy, hMassieu, hsum]
  ring

/-- Explicit finite KL divergence `Σ pᵢ log(pᵢ / qᵢ)`. -/
def energyKLDivergence (p q : ι → ℝ) : ℝ :=
  ∑ i : ι, p i * Real.log (p i / q i)

/-- KL divergence from a positive weight function to itself is zero. -/
theorem energyKLDivergence_self_of_ne_zero
    (p : ι → ℝ) (hp : ∀ i : ι, p i ≠ 0) :
    energyKLDivergence p p = 0 := by
  unfold energyKLDivergence
  simp [hp]

/-- Scalar Bregman divergence generated by a scalar potential and its gradient. -/
def scalarBregman (phi gradPhi : ℝ → ℝ) (x y : ℝ) : ℝ :=
  phi x - phi y - gradPhi y * (x - y)

/-- Scalar Bregman divergence vanishes on the diagonal. -/
theorem scalarBregman_self (phi gradPhi : ℝ → ℝ) (x : ℝ) :
    scalarBregman phi gradPhi x x = 0 := by
  unfold scalarBregman
  ring

/-- Entropy-maximization readout combining Massieu, KL, incidence, and free layers. -/
def souriauFreeEntropyAction
    (massieu kl incidenceFriction freeEnergy lambdaInc lambdaFree : ℝ) : ℝ :=
  massieu - kl - lambdaInc * incidenceFriction - lambdaFree * freeEnergy

/-- Expanding the combined Souriau/free-entropy action. -/
theorem souriauFreeEntropyAction_eq
    (massieu kl incidenceFriction freeEnergy lambdaInc lambdaFree : ℝ) :
    souriauFreeEntropyAction massieu kl incidenceFriction freeEnergy lambdaInc lambdaFree =
      massieu - kl - lambdaInc * incidenceFriction - lambdaFree * freeEnergy := by
  rfl

/-- First variation of the combined Souriau/free-entropy action. -/
def souriauFreeEntropyFirstVariation
    (dMassieu dKL dIncidenceFriction dFreeEnergy lambdaInc lambdaFree : ℝ) : ℝ :=
  dMassieu - dKL - lambdaInc * dIncidenceFriction - lambdaFree * dFreeEnergy

/-- Expanding the first variation of the combined action. -/
theorem souriauFreeEntropyFirstVariation_eq
    (dMassieu dKL dIncidenceFriction dFreeEnergy lambdaInc lambdaFree : ℝ) :
    souriauFreeEntropyFirstVariation
        dMassieu dKL dIncidenceFriction dFreeEnergy lambdaInc lambdaFree =
      dMassieu - dKL - lambdaInc * dIncidenceFriction - lambdaFree * dFreeEnergy := by
  rfl

end

end InfoGeometry.Physics.SouriauMassieuPlanckFunctional
