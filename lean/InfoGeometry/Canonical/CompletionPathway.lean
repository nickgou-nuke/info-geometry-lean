import InfoGeometry.Canonical.SectorLattice
import InfoGeometry.Canonical.SelfSimilarVacuum
import Mathlib.Order.GaloisConnection.Basic

/-!
# Lattice Completion Pathways

This file formalizes the architectural closure debt for passing from the
finite, discrete Cantor-Krein sector lattice to the infinite, continuous
conformal and operator-algebraic limits.

As detailed in the `InfoGeometry` framework, the complete lattice architecture
organizes the physical sectors. However, the infinite limit of the finite Cantor
partition requires a rigorous completion. We avoid "free complete lattices"
as they are not mathematically well-founded (often forming proper classes).
Instead, we specify the precise, set-sized completions that physically correspond
to topological, measure-theoretic, and operator-algebraic closures.

## 1. Boolean/Regular Open Completion (Topology)

For pure topology, the completion of the Boolean algebra of clopen cylinders
is the complete Boolean algebra of regular open sets of the Cantor space.
This captures the topological properties without requiring a measure.

## 2. Measure Algebra Completion (Probability)

For statistical mechanics and information theory, the completion is the
measure algebra $(\mathcal{C}, \mu_{\mathcal{C}})$. This quotients the
Borel $\sigma$-algebra by the ideal of null sets, yielding a complete
measure algebra which acts as the commutative core of the operator algebra.

## 3. von Neumann Projection Lattice (Operator Algebra)

For the full Krein-space quantum mechanics, the relevant completion is the
projection lattice of the von Neumann algebra generated by the Cantor-Clifford
representation.

In a von Neumann algebra, the projections always form a complete orthomodular
lattice. Because we are working with indefinite Krein spaces, the fundamental
symmetry $J_K = P_+ - P_-$ (formalized as `kreinInvolution`) connects the
two sectors.

## 4. Bulk-Boundary Galois Connection

The complete-lattice architecture explicitly models the bulk-boundary correspondence
as a Galois connection:
  `boundary: L_bulk → L_edge`
  `extend: L_edge → L_bulk`
where the boundary restriction is the lower adjoint (preserving joins) and
extension into the bulk is the upper adjoint (preserving meets).

-/

namespace CompletionPathway

open InfoGeometry.Canonical.SectorLattice
open InfoGeometry.Canonical.SelfSimilarVacuum

universe u v

/-! ## Concrete set-sized completion carriers -/

/--
The finite completed projection lattice at level `n`.

This is the concrete pointwise Cantor-Krein projector assignment
`BinaryWord n → KreinSector`, with the complete lattice inherited pointwise
from the four-element Krein sector lattice.
-/
abbrev FiniteProjectionCompletion (n : ℕ) : Type :=
  ProjectionAssignment n

/-- The finite completed projection lattice is complete. -/
noncomputable instance finiteProjectionCompletion_complete (n : ℕ) :
    CompleteLattice (FiniteProjectionCompletion n) :=
  inferInstance

/-- Every set of finite projection sectors has a canonical least upper bound. -/
theorem finiteProjectionCompletion_sSup_isLUB
    (n : ℕ) (S : Set (FiniteProjectionCompletion n)) :
    IsLUB S (sSup S) :=
  isLUB_sSup S

/-- Every set of finite projection sectors has a canonical greatest lower bound. -/
theorem finiteProjectionCompletion_sInf_isGLB
    (n : ℕ) (S : Set (FiniteProjectionCompletion n)) :
    IsGLB S (sInf S) :=
  isGLB_sInf S

/--
The infinite order-theoretic projection completion used in this repository.

This is not a free complete lattice. It is the concrete product of the finite
pointwise projection lattices over all Cantor levels.
-/
abbrev InfiniteProjectionCompletion : Type :=
  ProjectionStateSpace

/-- The infinite projection completion is complete as a product complete lattice. -/
noncomputable instance infiniteProjectionCompletion_complete :
    CompleteLattice InfiniteProjectionCompletion :=
  inferInstance

/-- Every set of infinite projection states has a canonical least upper bound. -/
theorem infiniteProjectionCompletion_sSup_isLUB
    (S : Set InfiniteProjectionCompletion) :
    IsLUB S (sSup S) :=
  isLUB_sSup S

/-- Every set of infinite projection states has a canonical greatest lower bound. -/
theorem infiniteProjectionCompletion_sInf_isGLB
    (S : Set InfiniteProjectionCompletion) :
    IsGLB S (sInf S) :=
  isGLB_sInf S

/--
The self-similar projection completion: fixed points of the monotone refinement
operator on `InfiniteProjectionCompletion`.

Mathlib's Knaster-Tarski theorem supplies the complete lattice instance for
`Function.fixedPoints projectionR_hom`.
-/
abbrev SelfSimilarProjectionCompletion : Type :=
  ProjectionVacuumLattice

/-- The self-similar projection completion is a complete lattice. -/
noncomputable instance selfSimilarProjectionCompletion_complete :
    CompleteLattice SelfSimilarProjectionCompletion :=
  inferInstance

/--
Every set of self-similar projection vacua has a canonical least upper bound.

This is the Knaster-Tarski fixed-point complete lattice imported from mathlib.
-/
theorem selfSimilarProjectionCompletion_sSup_isLUB
    (S : Set SelfSimilarProjectionCompletion) :
    IsLUB S (sSup S) :=
  isLUB_sSup S

/--
Every set of self-similar projection vacua has a canonical greatest lower bound.

This is the Knaster-Tarski fixed-point complete lattice imported from mathlib.
-/
theorem selfSimilarProjectionCompletion_sInf_isGLB
    (S : Set SelfSimilarProjectionCompletion) :
    IsGLB S (sInf S) :=
  isGLB_sInf S

/--
Order-theoretic topological completion currently owned by the repo.

This names the complete projection-state carrier. It does not assert a full
regular-open completion theorem.
-/
abbrev ContinuousTopologicalCompletion : Type :=
  InfiniteProjectionCompletion

/--
Order-theoretic measure-sector carrier currently owned by the repo.

This names the same concrete sector-order carrier; quotienting by null sets is
not asserted here.
-/
abbrev MeasureTheoreticCompletion : Type :=
  InfiniteProjectionCompletion

/--
Order-theoretic projection fixed-point carrier currently owned by the repo.

This names the Knaster-Tarski fixed-point lattice of the concrete projection
renormalization map; no von Neumann algebra representation theorem is asserted.
-/
abbrev VonNeumannCompletion : Type :=
  SelfSimilarProjectionCompletion

/-! ## Canonical adjunction objects -/

/--
Canonical Sigma-form for an order adjunction.

This avoids introducing another wrapper structure: an adjunction is directly a
pair of maps equipped with mathlib's `GaloisConnection`.
-/
abbrev OrderAdjunction (L : Type u) (R : Type v) [Preorder L] [Preorder R] :
    Type (max u v) :=
  Σ lower : L → R, { upper : R → L // GaloisConnection lower upper }

/-- Refinement/coarse-graining as a concrete Galois connection between adjacent levels. -/
def refinementCoarseAdjunction (n : ℕ) :
    OrderAdjunction (FiniteProjectionCompletion n) (FiniteProjectionCompletion (n + 1)) :=
  ⟨refineProjectionAssignment, coarseProjectionAssignment, projectionAssignment_galoisConnection n⟩

/-- The concrete refinement/coarse-graining maps form a mathlib Galois connection. -/
theorem refinementCoarseAdjunction_galoisConnection (n : ℕ) :
    GaloisConnection
      (@refineProjectionAssignment n)
      (@coarseProjectionAssignment n) :=
  projectionAssignment_galoisConnection n

/--
Bulk-boundary adjunction type.

The repo owns the order-theoretic slot as a concrete mathlib Galois connection.
Specific geometric boundary and extension maps must instantiate this type.
-/
abbrev BulkBoundaryAdjunction (L_bulk : Type u) (L_edge : Type v)
    [Preorder L_bulk] [Preorder L_edge] : Type (max u v) :=
  OrderAdjunction L_bulk L_edge

/-- The projection refinement map preserves arbitrary joins. -/
theorem refinementCoarseAdjunction_lower_iSup
    (n : ℕ) {ι : Sort*} (P : ι → FiniteProjectionCompletion n) :
    refineProjectionAssignment (⨆ i, P i) = ⨆ i, refineProjectionAssignment (P i) :=
  refineProjectionAssignment_iSup P

/-- The projection coarse-graining map preserves arbitrary meets. -/
theorem refinementCoarseAdjunction_upper_iInf
    (n : ℕ) {ι : Sort*} (Q : ι → FiniteProjectionCompletion (n + 1)) :
    coarseProjectionAssignment (⨅ i, Q i) = ⨅ i, coarseProjectionAssignment (Q i) :=
  coarseProjectionAssignment_iInf Q

/--
The order-theoretic projection architecture owned here consists of complete
finite sectors, complete infinite projection states, complete self-similar
fixed sectors, and the refinement/coarse-graining Galois connection.
-/
theorem completeLatticeProjectionArchitecture
    (n : ℕ) :
    (∀ S : Set (FiniteProjectionCompletion n), IsLUB S (sSup S) ∧ IsGLB S (sInf S)) ∧
      (∀ S : Set InfiniteProjectionCompletion, IsLUB S (sSup S) ∧ IsGLB S (sInf S)) ∧
      (∀ S : Set SelfSimilarProjectionCompletion, IsLUB S (sSup S) ∧ IsGLB S (sInf S)) ∧
      GaloisConnection
        (@refineProjectionAssignment n)
        (@coarseProjectionAssignment n) := by
  exact ⟨
    fun S => ⟨finiteProjectionCompletion_sSup_isLUB n S,
      finiteProjectionCompletion_sInf_isGLB n S⟩,
    fun S => ⟨infiniteProjectionCompletion_sSup_isLUB S,
      infiniteProjectionCompletion_sInf_isGLB S⟩,
    fun S => ⟨selfSimilarProjectionCompletion_sSup_isLUB S,
      selfSimilarProjectionCompletion_sInf_isGLB S⟩,
    refinementCoarseAdjunction_galoisConnection n⟩

/-- The least self-similar projector vacuum is fixed by refinement renormalization. -/
theorem leastSelfSimilarProjectionCompletion_fixed :
    projectionR projectionR_hom.lfp = projectionR_hom.lfp :=
  leastProjectionVacuum_isFixed

/-- The greatest self-similar projector vacuum is fixed by refinement renormalization. -/
theorem greatestSelfSimilarProjectionCompletion_fixed :
    projectionR projectionR_hom.gfp = projectionR_hom.gfp :=
  greatestProjectionVacuum_isFixed

end CompletionPathway
