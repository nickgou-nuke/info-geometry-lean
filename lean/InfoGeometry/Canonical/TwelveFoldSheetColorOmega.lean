import Mathlib.Algebra.Group.Basic
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Tactic.Ring
import Mathlib.Tactic.IntervalCases

namespace InfoGeometry.Canonical

/-!
# Twelve-Fold Sheet-Color Omega

This module formalizes the exact $C_{12}$ cyclic structure generated by the master 
operator $W$, which reconstructs the chiral phase $\widehat{\Omega}$ (order 4) 
and the color shift $\widehat{X}$ (order 3) through the Chinese Remainder Theorem.
-/

variable {M : Type*} [Monoid M]

theorem masterTwelve_twelve 
    (Omega_op W_op : M) 
    (h_W_cube : W_op ^ 3 = Omega_op) 
    (h_Omega_four : Omega_op ^ 4 = 1) : 
    W_op ^ 12 = 1 := by
  calc
    W_op ^ 12 = (W_op ^ 3) ^ 4 := by rw [← pow_mul]
    _ = Omega_op ^ 4 := by rw [h_W_cube]
    _ = 1 := h_Omega_four

theorem masterTwelve_six_is_Gamma 
    (Omega_op W_op : M) 
    (h_W_cube : W_op ^ 3 = Omega_op) :
    (W_op ^ 2) ^ 3 = Omega_op ^ 2 := by
  calc
    (W_op ^ 2) ^ 3 = W_op ^ 6 := by rw [← pow_mul]
    _ = (W_op ^ 3) ^ 2 := by rw [← pow_mul]
    _ = Omega_op ^ 2 := by rw [h_W_cube]

/-- The order of W must divide 12 because W^12 = 1. -/
theorem masterTwelve_order_dvd_twelve 
    (Omega_op W_op : M) 
    (h_W_cube : W_op ^ 3 = Omega_op) 
    (h_Omega_four : Omega_op ^ 4 = 1) : 
    orderOf W_op ∣ 12 := by
  exact orderOf_dvd_of_pow_eq_one (masterTwelve_twelve Omega_op W_op h_W_cube h_Omega_four)

theorem masterTwelve_order_exact
    (Omega_op X_op W_op : M)
    (h_W_cube : W_op ^ 3 = Omega_op)
    (h_W_eight : W_op ^ 8 = X_op)
    (h_Omega_four : Omega_op ^ 4 = 1)
    (h_X_three : X_op ^ 3 = 1)
    (h_omega_order : orderOf Omega_op = 4)
    (h_X_order : orderOf X_op = 3) :
    orderOf W_op = 12 := by
  have hdvd : orderOf W_op ∣ 12 := masterTwelve_order_dvd_twelve Omega_op W_op h_W_cube h_Omega_four
  
  have h_not_6 : W_op ^ 6 ≠ 1 := by
    intro h
    have h_omega2 : Omega_op ^ 2 = 1 := by
      calc
        Omega_op ^ 2 = (W_op ^ 3) ^ 2 := by rw [← h_W_cube]
        _ = W_op ^ 6 := by rw [← pow_mul]
        _ = 1 := h
    have h_div : 4 ∣ 2 := by
      rw [← h_omega_order]
      exact orderOf_dvd_of_pow_eq_one h_omega2
    revert h_div
    decide

  have h_not_4 : W_op ^ 4 ≠ 1 := by
    intro h
    have h_X : X_op = 1 := by
      calc
        X_op = W_op ^ 8 := h_W_eight.symm
        _ = (W_op ^ 4) ^ 2 := by rw [← pow_mul]
        _ = 1 ^ 2 := by rw [h]
        _ = 1 := one_pow 2
    have h_X_ord : orderOf X_op = 1 := by
      rw [h_X, orderOf_one]
    rw [h_X_ord] at h_X_order
    contradiction
    
  have h_ord_val : orderOf W_op = 12 := by
    generalize hk : orderOf W_op = k
    rw [hk] at hdvd
    have hk_cases : k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 6 ∨ k = 12 := by
      have hk0 : k ≠ 0 := by
        intro h
        subst h
        revert hdvd
        decide
      have hk12 : k ≤ 12 := Nat.le_of_dvd (by decide) hdvd
      have hk1 : 1 ≤ k := Nat.pos_of_ne_zero hk0
      interval_cases k
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr (Or.inl rfl))
      · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
      · revert hdvd; decide
      · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
      · revert hdvd; decide
      · revert hdvd; decide
      · revert hdvd; decide
      · revert hdvd; decide
      · revert hdvd; decide
      · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
      
    rcases hk_cases with h | h | h | h | h | h
    · have hW : W_op = 1 := by rw [← pow_one W_op, ← h, ← hk]; exact pow_orderOf_eq_one W_op
      have h6 : W_op ^ 6 = 1 := by rw [hW, one_pow]
      contradiction
    · have h6 : W_op ^ 6 = 1 := by 
        calc W_op ^ 6 = (W_op ^ k) ^ 3 := by rw [h, ← pow_mul]
        _ = (W_op ^ orderOf W_op) ^ 3 := by rw [hk]
        _ = 1 ^ 3 := by rw [pow_orderOf_eq_one]
        _ = 1 := one_pow 3
      contradiction
    · have h6 : W_op ^ 6 = 1 := by 
        calc W_op ^ 6 = (W_op ^ k) ^ 2 := by rw [h, ← pow_mul]
        _ = (W_op ^ orderOf W_op) ^ 2 := by rw [hk]
        _ = 1 ^ 2 := by rw [pow_orderOf_eq_one]
        _ = 1 := one_pow 2
      contradiction
    · have h4 : W_op ^ 4 = 1 := by
        calc W_op ^ 4 = (W_op ^ k) ^ 1 := by rw [h, ← pow_mul]
        _ = (W_op ^ orderOf W_op) ^ 1 := by rw [hk]
        _ = 1 ^ 1 := by rw [pow_orderOf_eq_one]
        _ = 1 := one_pow 1
      contradiction
    · have h6 : W_op ^ 6 = 1 := by
        calc W_op ^ 6 = (W_op ^ k) ^ 1 := by rw [h, ← pow_mul]
        _ = (W_op ^ orderOf W_op) ^ 1 := by rw [hk]
        _ = 1 ^ 1 := by rw [pow_orderOf_eq_one]
        _ = 1 := one_pow 1
      contradiction
    · exact h

  exact h_ord_val

end InfoGeometry.Canonical
