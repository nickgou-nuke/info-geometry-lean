import InfoGeometry.Canonical.ThermodynamicGenerator
import InfoGeometry.Krein.DoubledSpace
import InfoGeometry.Quantum.SuperchargeMultiplet

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.SouriauPlanckVector

The Souriau-Planck axis of the informational Spire.

This file formalizes the geometric temperature vector as the generator
of the modular flow on the doubled carrier.
-/

namespace InfoGeometry.Canonical.SouriauPlanckVector

open InfoGeometry.Canonical.ThermodynamicGenerator
open InfoGeometry.Krein
open InfoGeometry.Quantum

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

/-- 
The Souriau Temperature Vector.
The thermodynamic gradient flow is generated by the Modular Supercharge (Q_J).
In the canonical multiplet, this is exactly the spectral involution `ε`.
-/
@[rep_depth transport]
noncomputable def souriauTemperatureVector 
    (M : SuperchargeMultiplet (E := E)) : EndH :=
  M.modular.Q

/--
The Planck-Souriau flow maximizes the speed of change of the 
relative modular potential (Kullback-Leibler divergence).
-/
@[rep_depth transport]
def IsSouriauEquilibrium
    (M : SuperchargeMultiplet (E := E)) (A : EndH) : Prop :=
  A * souriauTemperatureVector M - souriauTemperatureVector M * A = 0

end InfoGeometry.Canonical.SouriauPlanckVector
