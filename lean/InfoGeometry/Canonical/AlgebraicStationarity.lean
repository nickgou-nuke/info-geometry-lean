import InfoGeometry.Canonical.RelationalInformationDynamics
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Canonical.EinsteinAnomalyOperator

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.AlgebraicStationarity

Purely algebraic stationarity layer for doubled-carrier operator dynamics.

This file introduces no external time, coordinates, or variational calculus.
Stationarity is expressed only through vanishing expectations of Lie/commutator
derivations. The core surfaces are:

- stationarity of an observable along a given transport generator,
- global algebraic stationarity under all inner generators,
- the modular curvature operator as the `K = Jε` nested commutator,
- and the gauge/source balance equivalent to state-level algebraic stationarity.
-/

namespace InfoGeometry.Canonical.AlgebraicStationarity

open InfoGeometry.Canonical.BogoliubovTransport
open InfoGeometry.Canonical.RelationalInformationDynamics
open InfoGeometry.Canonical.StateDependentTransport
open InfoGeometry.Canonical.ConformalUnification
open InfoGeometry.Krein

section Core

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂
local notation "Kop" => InfoGeometry.Canonical.TomitaTakesaki.modularComplexI (E := E)

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance

/--
A state is stationary along the transport generator `X` when the expectation of
the corresponding inner derivation of `A` vanishes.
-/
@[rep_depth transport]
def IsStationaryAlong
    (ω : EndH →L[ℝ] ℝ) (X A : EndH) : Prop :=
  ω (operatorInformationFirstVariation (E := E) X A) = 0

/--
An observable is algebraically stationary when every inner derivation has zero
expectation in the state `ω`.
-/
@[rep_depth transport]
def IsAlgebraicallyStationary
    (ω : EndH →L[ℝ] ℝ) (A : EndH) : Prop :=
  ∀ X : EndH, IsStationaryAlong (E := E) ω X A

/--
State-indexed algebraic stationarity for the modular dynamics generated by a
state-dependent datum.
-/
@[rep_depth transport]
def IsStateAlgebraicallyStationary
    (ω : EndH →L[ℝ] ℝ)
    (M : StateModularDatum E) (ψ : H₂) (A : EndH) : Prop :=
  ω (stateInducedDynamics (E := E) M ψ A) = 0

/--
Gauge/source cancellation law for a state-induced modular derivation.

This is the algebraic balance form of the transport equation: the expectation of
the gauge branch is exactly the negative of the source branch.
-/
@[rep_depth transport]
def AlgebraicEinsteinBalance
    (ω : EndH →L[ℝ] ℝ)
    (M : StateModularDatum E) (ψ : H₂) (A : EndH) : Prop :=
  ω (stateGaugeDynamics (E := E) M ψ A)
    =
  -ω (stateSourceDynamics (E := E) M ψ A)

/-- The modular curvature operator is the doubled `K = Jε` commutator of `D`. -/
@[rep_depth transport]
noncomputable def modularCurvatureOperator
    (D : EndH) : EndH :=
  operatorInformationHessian (E := E) Kop D

@[rep_depth transport, simp] theorem isStationaryAlong_iff
    (ω : EndH →L[ℝ] ℝ) (X A : EndH) :
    IsStationaryAlong (E := E) ω X A
      ↔
    ω (observableLieDerivation (E := E) X A) = 0 := by
  simp [IsStationaryAlong]

@[rep_depth transport, simp] theorem isAlgebraicallyStationary_iff
    (ω : EndH →L[ℝ] ℝ) (A : EndH) :
    IsAlgebraicallyStationary (E := E) ω A
      ↔
    ∀ X : EndH, ω (observableLieDerivation (E := E) X A) = 0 := by
  simp [IsAlgebraicallyStationary, IsStationaryAlong]

/--
State algebraic stationarity is exactly stationarity along the derived modular
generator at the chosen state.
-/
@[rep_depth transport]
theorem isStateAlgebraicallyStationary_iff_generatorStationarity
    (ω : EndH →L[ℝ] ℝ)
    (M : StateModularDatum E) (ψ : H₂) (A : EndH) :
    IsStateAlgebraicallyStationary (E := E) ω M ψ A
      ↔
    IsStationaryAlong (E := E) ω (stateRelativeModularGenerator (E := E) M ψ) A := by
  rfl

/--
State algebraic stationarity is equivalent to exact gauge/source cancellation in
expectation.
-/
@[rep_depth transport]
theorem isStateAlgebraicallyStationary_iff_algebraicEinsteinBalance
    (ω : EndH →L[ℝ] ℝ)
    (M : StateModularDatum E) (ψ : H₂) (A : EndH) :
    IsStateAlgebraicallyStationary (E := E) ω M ψ A
      ↔
    AlgebraicEinsteinBalance (E := E) ω M ψ A := by
  constructor
  · intro hStat
    unfold IsStateAlgebraicallyStationary AlgebraicEinsteinBalance at *
    rw [stateInducedDynamics_eq_gauge_add_source (E := E) M ψ A] at hStat
    exact add_eq_zero_iff_eq_neg.mp (by simpa using hStat)
  · intro hBalance
    unfold IsStateAlgebraicallyStationary AlgebraicEinsteinBalance at *
    rw [stateInducedDynamics_eq_gauge_add_source (E := E) M ψ A]
    exact by
      simpa using (add_eq_zero_iff_eq_neg.mpr hBalance)

/--
Projector-agreement closure turns Einstein-anomaly stationarity into
projector-obstruction stationarity on the same observable.
-/
@[rep_depth transport]
theorem starCertifiedEinsteinAnomalyStationary_iff_projectorObstructionStationary_of_projectorAgreement
    (SCI : StarCertifiedConformalInference E)
    (ω : EndH →L[ℝ] ℝ) (A : EndH)
    (hEq :
      SCI.liftedEinsteinAnomalyOperator
        =
      -SCI.toCertifiedConformalInference.liftedProjectorObstructionOperator) :
    IsStationaryAlong (E := E) ω SCI.liftedEinsteinAnomalyOperator A
      ↔
    IsStationaryAlong (E := E) ω
      SCI.toCertifiedConformalInference.liftedProjectorObstructionOperator A := by
  constructor
  · intro hStat
    unfold IsStationaryAlong at hStat ⊢
    rw [hEq] at hStat
    have hPos := congrArg Neg.neg hStat
    simpa [operatorInformationFirstVariation, transportCommutator, sub_eq_add_neg, add_comm] using hPos
  · intro hStat
    unfold IsStationaryAlong at hStat ⊢
    rw [hEq]
    have hNeg := congrArg Neg.neg hStat
    simpa [operatorInformationFirstVariation, transportCommutator, sub_eq_add_neg, add_comm] using hNeg

end Core

section LightweightTheorems

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂
local notation "Kop" => InfoGeometry.Canonical.TomitaTakesaki.modularComplexI (E := E)

/-- Negating the generator negates the induced commutator variation. -/
@[rep_depth transport, simp]
theorem operatorInformationFirstVariation_neg_left
    (X A : EndH) :
    operatorInformationFirstVariation (E := E) (-X) A
      =
    -operatorInformationFirstVariation (E := E) X A := by
  unfold operatorInformationFirstVariation transportCommutator
  simp
  abel

/-- Negating the observable negates the induced commutator variation. -/
@[rep_depth transport, simp]
theorem operatorInformationFirstVariation_neg_right
    (X A : EndH) :
    operatorInformationFirstVariation (E := E) X (-A)
      =
    -operatorInformationFirstVariation (E := E) X A := by
  unfold operatorInformationFirstVariation transportCommutator
  simp
  abel

/-- The zero observable is algebraically stationary in every state. -/
@[rep_depth transport]
theorem isAlgebraicallyStationary_zero
    (ω : EndH →L[ℝ] ℝ) :
    IsAlgebraicallyStationary (E := E) ω (0 : EndH) := by
  intro X
  unfold IsStationaryAlong operatorInformationFirstVariation transportCommutator
  simp

/-- Commutation with a fixed generator implies stationarity along that generator. -/
@[rep_depth transport]
theorem isStationaryAlong_of_commute
    (ω : EndH →L[ℝ] ℝ) (X A : EndH)
    (hComm : Commute X A) :
    IsStationaryAlong (E := E) ω X A := by
  have hZero : operatorInformationFirstVariation (E := E) X A = 0 := by
    unfold operatorInformationFirstVariation transportCommutator
    exact sub_eq_zero.mpr hComm.eq
  unfold IsStationaryAlong
  rw [hZero]
  simp

/-- Central observables are algebraically stationary in every state. -/
@[rep_depth transport]
theorem isAlgebraicallyStationary_of_central
    (ω : EndH →L[ℝ] ℝ) (A : EndH)
    (hCentral : ∀ X : EndH, Commute X A) :
    IsAlgebraicallyStationary (E := E) ω A := by
  intro X
  exact isStationaryAlong_of_commute (E := E) ω X A (hCentral X)

/-- The phase-axis response is the negative `K`-variation of the observable. -/
@[rep_depth transport, simp]
theorem phaseAxisResponse_eq_neg_KVariation
    [CompleteSpace E]
    (D : EndH) :
    phaseAxisResponse (E := E) D
      =
    -operatorInformationFirstVariation (E := E) Kop D := by
  simp [phaseAxisResponse, phaseAxisForce, operatorInformationFirstVariation,
    transportCommutator,
    InfoGeometry.Canonical.TomitaTakesaki.modularComplexI_eq_complex_i (E := E)]

/--
Applying the `K`-derivation to the phase-axis response produces minus the
modular curvature operator.
-/
@[rep_depth transport, simp]
theorem KVariation_phaseAxisResponse_eq_neg_modularCurvature
    [CompleteSpace E]
    (D : EndH) :
    operatorInformationFirstVariation (E := E) Kop (phaseAxisResponse (E := E) D)
      =
    -modularCurvatureOperator (E := E) D := by
  unfold phaseAxisResponse phaseAxisForce modularCurvatureOperator
  unfold operatorInformationHessian operatorInformationMixedSecondVariation
  unfold operatorInformationFirstVariation transportCommutator
  simp [InfoGeometry.Canonical.TomitaTakesaki.modularComplexI_eq_complex_i (E := E)]
  abel

/--
If the phase response of `D` is stationary under the internal phase axis `K`,
then the expectation of the modular curvature operator vanishes.
-/
@[rep_depth transport]
theorem modularCurvatureExpectation_eq_zero_of_phaseResponseStationary
    [CompleteSpace E]
    (ω : EndH →L[ℝ] ℝ) (D : EndH)
    (hStat : IsStationaryAlong (E := E) ω Kop (phaseAxisResponse (E := E) D)) :
    ω (modularCurvatureOperator (E := E) D) = 0 := by
  unfold IsStationaryAlong at hStat
  rw [KVariation_phaseAxisResponse_eq_neg_modularCurvature (E := E) D] at hStat
  simpa using hStat

end LightweightTheorems

end InfoGeometry.Canonical.AlgebraicStationarity
