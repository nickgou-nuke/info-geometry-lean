import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.Data.Fin.VecNotation
import Mathlib.Basic.Real.Basic
import Mathlib.Tactic

/-!
# Erlangen Program (§§1–3, §10.3): Transformation Groups, Adjoining Theorem, & Principal Group

This module formalizes Archetypes `EK₁` and `EK₂` of Felix Klein's 1872 *Erlangen Program*
(*A Comparative Review of Recent Researches in Geometry*, `0807.3161v1 (1).pdf`, pp. 2–6, 19):

1. **Transformation Groups & `[countermodel_found]` Footnote 8 (`§1`, pp. 2–3)**:
   * Any submonoid of a finite permutation group `Equiv.Perm α` automatically contains all
     inverses (`klein_footnote8_finite_perm_closed_inv`).
   * For infinite transformation monoids, closure under composition does NOT imply closure
     under inverses: the shift submonoid generated by `n ↦ n + 1` on `ℕ` is associative and
     unital yet possesses no two-sided inverse (`klein_footnote8_infinite_semigroup_countermodel`).
   * Collinear vs dualistic `ℤˣ`-grading (`§1`, p. 2): even elements form a subgroup, odd
     (dualistic) elements are never closed under composition whenever nonempty, and their union
     recovers the full group (`dualistic_mul_not_dualistic`, `collinear_union_dualistic_eq_top`).
2. **Klein's Subgroup Adjoining Equivalence (`§2`, pp. 3–4)**:
   * Monotonicity along subgroups `H ≤ G` (`isGeometricInvariant_mono_subgroup`), plus an explicit
     equivalence `klein_adjoining_equiv` between `G`-invariant joint relations on `orbit G c₀ × M`
     and `stabilizer G c₀`-invariant predicates on `M`.
3. **Principal Group & Projective Circle at Infinity (`§1, §3, §10.3`, pp. 2–5, 19)**:
   * Affine similarity action `applySimilarity3 r Q t`, scaling squared Euclidean distances by `r²`
     (`similarity3_distSq_scale`), preserving all distance ratios, and including reflections
     `det (-1 : Matrix (Fin 3) (Fin 3) ℝ) = -1` (`Footnote 11`).
   * Homogeneous block matrix `projSimilarityMatrix s r Q t : Matrix (Fin 4) (Fin 4) ℝ`, non-
     commutativity witnesses `matrix3_noncomm` and `matrix4_noncomm`, and exact equivalence
     (`projective_circleAtInfinity_stabilizer_iff_similarity3`): fixing the plane at infinity
     `x₀ = 0` and scaling `x₁² + x₂² + x₃²` on `x₀ = 0` by `μ²` (`μ ≠ 0`) is equivalent to
     having the exact block similarity form `projSimilarityMatrix (A 0 0) μ Q t` (`Qᵀ * Q = 1`).
-/

namespace InfoGeometry.Erlangen.ErlangenProgramGroupHierarchyAndPrincipal

open InfoGeometry.Erlangen.InvariantGeometry
open Matrix

/-! ## 1. Transformation Groups, Footnote 8 Countermodel, & Dualistic Grading (§1) -/

section TransformationGroups

/-- **Klein's Footnote 8 (`p. 3`), finite case**: for finite `α`, every composition-closed submonoid
of permutations `S : Submonoid (Equiv.Perm α)` automatically contains the inverse of each member. -/
theorem klein_footnote8_finite_perm_closed_inv {α : Type*} [Fintype α] [DecidableEq α]
    (S : Submonoid (Equiv.Perm α)) {g : Equiv.Perm α} (hg : g ∈ S) : g⁻¹ ∈ S := by
  have hfin : IsOfFinOrder g := isOfFinOrder_of_finite g
  obtain ⟨n, hn_pos, hn_eq⟩ := isOfFinOrder_iff_pow_eq_one.mp hfin
  have hpow : g * g ^ (n - 1) = 1 := by
    calc
      g * g ^ (n - 1) = g ^ (n - 1) * g := (pow_mul_comm' g (n - 1)).symm
      _ = g ^ (n - 1 + 1) := (pow_succ g (n - 1)).symm
      _ = g ^ n := by rw [Nat.sub_add_cancel hn_pos]
      _ = 1 := hn_eq
  have hinv : g⁻¹ = g ^ (n - 1) := inv_eq_of_mul_eq_one_right hpow
  rw [hinv]
  exact S.pow_mem hg (n - 1)

/-- Shift transformation `n ↦ n + k` on `ℕ`. -/
def natShift (k n : ℕ) : ℕ := n + k

theorem natShift_zero : natShift 0 = id := by
  ext n
  simp [natShift]

theorem natShift_comp (k₁ k₂ : ℕ) : natShift k₁ ∘ natShift k₂ = natShift (k₁ + k₂) := by
  ext n
  dsimp [natShift]
  omega

/-- **`[countermodel_found]` Klein's Footnote 8 (`p. 3`), infinite case**:
the family `{natShift k | k : ℕ}` contains `id` and is closed under composition (`f ∘ g`),
yet its generator `natShift 1` is injective without any left-right inverse on `ℕ`. -/
theorem klein_footnote8_infinite_semigroup_countermodel :
    (id ∈ Set.range natShift) ∧
      (∀ f ∈ Set.range natShift, ∀ g ∈ Set.range natShift, f ∘ g ∈ Set.range natShift) ∧
      Function.Injective (natShift 1) ∧
      (¬ ∃ inv : ℕ → ℕ, inv ∘ natShift 1 = id ∧ natShift 1 ∘ inv = id) := by
  refine ⟨⟨0, natShift_zero⟩, ?_, ?_, ?_⟩
  · rintro _ ⟨k₁, rfl⟩ _ ⟨k₂, rfl⟩
    exact ⟨k₁ + k₂, (natShift_comp k₁ k₂).symm⟩
  · intro m n hmn
    dsimp [natShift] at hmn
    omega
  · rintro ⟨inv, _, hright⟩
    have h0 : natShift 1 (inv 0) = 0 := congrFun hright 0
    dsimp [natShift] at h0
    omega

theorem injective_nonsurjective_no_right_inv {α : Type*} {f : α → α}
    (hsurj : ¬ Function.Surjective f) :
    ¬ ∃ inv : α → α, f ∘ inv = id := by
  rintro ⟨inv, h⟩
  apply hsurj
  intro y
  exact ⟨inv y, congrFun h y⟩

/-- Collinear subgroup attached to a collinear/dualistic `ℤˣ`-grading (`§1`, p. 2). -/
def collinearSubgroup {G : Type*} [Group G] (parity : G →* ℤˣ) : Subgroup G :=
  parity.ker

/-- Dualistic (correlation) coset `{g | parity g = -1}` (`§1`, p. 2). -/
def dualisticSet {G : Type*} [Group G] (parity : G →* ℤˣ) : Set G :=
  {g : G | parity g = -1}

/-- The product of two dualistic transformations is collinear, not dualistic (`§1`, p. 2). -/
theorem dualistic_mul_not_dualistic {G : Type*} [Group G] (parity : G →* ℤˣ)
    {g₁ g₂ : G} (h₁ : g₁ ∈ dualisticSet parity) (h₂ : g₂ ∈ dualisticSet parity) :
    g₁ * g₂ ∈ collinearSubgroup parity ∧ g₁ * g₂ ∉ dualisticSet parity := by
  dsimp [dualisticSet] at h₁ h₂
  have hmul : parity (g₁ * g₂) = 1 := by
    rw [map_mul, h₁, h₂]
    decide
  refine ⟨hmul, ?_⟩
  intro hmem
  dsimp [dualisticSet] at hmem
  rw [hmul] at hmem
  have hbad : (1 : ℤˣ) = -1 := hmem
  revert hbad
  decide

/-- Adding all dualistic transformations back to collineations yields the full group `⊤` (`§1`, p. 2). -/
theorem collinear_union_dualistic_eq_top {G : Type*} [Group G] (parity : G →* ℤˣ) :
    (collinearSubgroup parity : Set G) ∪ dualisticSet parity = Set.univ := by
  ext g
  simp only [Set.mem_union, SetLike.mem_coe, collinearSubgroup, MonoidHom.mem_ker,
    dualisticSet, Set.mem_ofPred_eq, Set.mem_univ, iff_true]
  exact Int.units_eq_one_or (parity g)

end TransformationGroups

/-! ## 2. Klein's §2 Principle: Subgroup Restriction and Reference-Configuration Adjoining -/

section KleinAdjoiningSection2

/-- Passing to a subgroup preserves geometric invariance (and therefore enlarges the class
of invariant configurations, `§2`, pp. 3–4). -/
theorem isGeometricInvariant_mono_subgroup {G M : Type*} [Group G] [MulAction G M]
    {H K : Subgroup G} (hHK : H ≤ K) {P : M → Prop}
    (hP : IsGeometricInvariant K M P) : IsGeometricInvariant H M P := by
  intro h m
  exact hP ⟨(h : G), hHK h.property⟩ m

/-- `G`-invariant binary relation between the orbit of a fixed configuration `c₀` and configurations
`m : M` (`§2`, p. 4). -/
def JointOrbitInvariant (G C M : Type*) [Group G] [MulAction G C] [MulAction G M] (c₀ : C) :
    Type _ :=
  {R : MulAction.orbit G c₀ → M → Prop //
    ∀ (g : G) (o : MulAction.orbit G c₀) (m : M), R (g • o) (g • m) ↔ R o m}

/-- Predicates on `M` invariant under the stabilizer of `c₀`. -/
def StabilizerInvariant (G C M : Type*) [Group G] [MulAction G C] [MulAction G M] (c₀ : C) :
    Type _ :=
  {P : M → Prop // IsGeometricInvariant (MulAction.stabilizer G c₀) M P}

/-- **Klein's Fundamental Adjoining Equivalence (`§2`, p. 4)**:
Investigating `M` jointly with the reference configuration `c₀` under the group `G` is
canonically equivalent to investigating `M` alone under the stabilizer subgroup `Stab_G(c₀)`. -/
def klein_adjoining_equiv (G C M : Type*) [Group G] [MulAction G C] [MulAction G M] (c₀ : C) :
    JointOrbitInvariant G C M c₀ ≃ StabilizerInvariant G C M c₀ where
  toFun R :=
    ⟨fun m => R.1 ⟨c₀, MulAction.mem_orbit_self c₀⟩ m, fun h m => by
      have hc : (h : G) • (⟨c₀, MulAction.mem_orbit_self c₀⟩ : MulAction.orbit G c₀) =
          ⟨c₀, MulAction.mem_orbit_self c₀⟩ := by
        ext
        exact h.property
      have hr := R.2 (h : G) ⟨c₀, MulAction.mem_orbit_self c₀⟩ m
      rw [hc] at hr
      exact hr⟩
  invFun P :=
    ⟨fun o m => ∀ g : G, g • c₀ = o.1 → P.1 (g⁻¹ • m), by
      intro g o m
      constructor
      · intro h g' hg'
        have hstep : (g * g') • c₀ = (g • o).1 := by
          rw [mul_smul, hg']
          rfl
        have hP := h (g * g') hstep
        have heq : (g * g')⁻¹ • (g • m) = g'⁻¹ • m := by
          rw [_root_.mul_inv_rev, mul_smul, inv_smul_smul]
        rwa [heq] at hP
      · intro h k hk
        have hstep : (g⁻¹ * k) • c₀ = o.1 := by
          rw [mul_smul, hk]
          exact inv_smul_smul g o.1
        have hP := h (g⁻¹ * k) hstep
        have heq : (g⁻¹ * k)⁻¹ • m = k⁻¹ • (g • m) := by
          rw [_root_.mul_inv_rev, inv_inv, mul_smul]
        rwa [heq] at hP⟩
  left_inv R := by
    apply Subtype.ext
    funext o m
    apply propext
    constructor
    · intro h
      obtain ⟨g₀, hg₀⟩ := o.2
      have ho : (g₀⁻¹ • o) = ⟨c₀, MulAction.mem_orbit_self c₀⟩ := by
        ext
        change g₀⁻¹ • o.1 = c₀
        rw [← hg₀, inv_smul_smul]
      have hP := h g₀ hg₀
      have hr := R.2 g₀⁻¹ o m
      rw [ho] at hr
      exact hr.mp hP
    · intro hR g hg
      have ho : g • (⟨c₀, MulAction.mem_orbit_self c₀⟩ : MulAction.orbit G c₀) = o := by
        ext
        exact hg
      have hr := R.2 g ⟨c₀, MulAction.mem_orbit_self c₀⟩ (g⁻¹ • m)
      rw [ho, smul_inv_smul] at hr
      exact hr.mp hR
  right_inv P := by
    apply Subtype.ext
    funext m
    apply propext
    constructor
    · intro h
      have h1 := h 1 (one_smul G c₀)
      rwa [inv_one, one_smul] at h1
    · intro hm g hg
      have hmem : g ∈ MulAction.stabilizer G c₀ := hg
      have hinv : g⁻¹ ∈ MulAction.stabilizer G c₀ := (MulAction.stabilizer G c₀).inv_mem hmem
      exact (P.2 ⟨g⁻¹, hinv⟩ m).mpr hm

end KleinAdjoiningSection2

/-! ## 3. Principal Group & Projective Stabilizer of the Circle at Infinity (§1, §3, §10.3) -/

section PrincipalGroupAndCircleAtInfinity

/-- Euclidean similarity transformation `v ↦ r • (Q *ᵥ v) + t` on `ℝ³` (`§1, p. 2`). -/
def applySimilarity3 (r : ℝ) (Q : Matrix (Fin 3) (Fin 3) ℝ) (t v : Fin 3 → ℝ) : Fin 3 → ℝ :=
  r • (Q *ᵥ v) + t

/-- Non-commutativity witness for `Matrix (Fin 3) (Fin 3) ℝ`. -/
theorem matrix3_noncomm :
    ∃ A B : Matrix (Fin 3) (Fin 3) ℝ, A * B ≠ B * A := by
  refine ⟨Matrix.of (fun i j => if i = 0 ∧ j = 1 then 1 else 0),
          Matrix.of (fun i j => if i = 1 ∧ j = 0 then 1 else 0), ?_⟩
  intro h
  have h00 := congrArg (fun M => M 0 0) h
  simp [Matrix.mul_apply] at h00

/-- Non-commutativity witness for `Matrix (Fin 4) (Fin 4) ℝ`. -/
theorem matrix4_noncomm :
    ∃ A B : Matrix (Fin 4) (Fin 4) ℝ, A * B ≠ B * A := by
  refine ⟨Matrix.of (fun i j => if i = 0 ∧ j = 1 then 1 else 0),
          Matrix.of (fun i j => if i = 1 ∧ j = 0 then 1 else 0), ?_⟩
  intro h
  have h00 := congrArg (fun M => M 0 0) h
  simp [Matrix.mul_apply] at h00

/-- Orthogonal `3 × 3` matrices preserve squared Euclidean inner products. -/
theorem orthogonal_mulVec_dotProduct (Q : Matrix (Fin 3) (Fin 3) ℝ) (hQ : Qᵀ * Q = 1)
    (u v : Fin 3 → ℝ) :
    (Q *ᵥ u) ⬝ᵥ (Q *ᵥ v) = u ⬝ᵥ v := by
  rw [← Matrix.vecMul_transpose, Matrix.dotProduct_mulVec, Matrix.vecMul_vecMul, hQ,
    Matrix.vecMul_one]

/-- Every Euclidean similarity scales squared distances uniformly by `r²` (`§1`, p. 2). -/
theorem similarity3_distSq_scale (r : ℝ) (Q : Matrix (Fin 3) (Fin 3) ℝ) (hQ : Qᵀ * Q = 1)
    (t u v : Fin 3 → ℝ) :
    (applySimilarity3 r Q t u - applySimilarity3 r Q t v) ⬝ᵥ
        (applySimilarity3 r Q t u - applySimilarity3 r Q t v) =
      r ^ 2 * ((u - v) ⬝ᵥ (u - v)) := by
  have hdiff : applySimilarity3 r Q t u - applySimilarity3 r Q t v = r • (Q *ᵥ (u - v)) := by
    ext i
    dsimp [applySimilarity3, Matrix.mulVec, dotProduct]
    simp [Fin.sum_univ_three]
    ring
  rw [hdiff, smul_dotProduct, dotProduct_smul, orthogonal_mulVec_dotProduct Q hQ,
    smul_eq_mul, smul_eq_mul, ← mul_assoc, ← sq]

/-- Ratios of squared distances are strictly invariant under the Principal Group (`§1`, p. 2). -/
theorem similarity3_distSq_ratio_invariant (r : ℝ) (hr : r ≠ 0)
    (Q : Matrix (Fin 3) (Fin 3) ℝ) (hQ : Qᵀ * Q = 1) (t u v u' v' : Fin 3 → ℝ) :
    ((applySimilarity3 r Q t u - applySimilarity3 r Q t v) ⬝ᵥ
        (applySimilarity3 r Q t u - applySimilarity3 r Q t v)) /
      ((applySimilarity3 r Q t u' - applySimilarity3 r Q t v') ⬝ᵥ
        (applySimilarity3 r Q t u' - applySimilarity3 r Q t v')) =
      ((u - v) ⬝ᵥ (u - v)) / ((u' - v') ⬝ᵥ (u' - v')) := by
  rw [similarity3_distSq_scale r Q hQ t u v, similarity3_distSq_scale r Q hQ t u' v']
  have hr2 : r ^ 2 ≠ 0 := pow_ne_zero 2 hr
  field_simp [hr2]

/-- Space inversion (orientation-reversing reflection, `Footnote 11`, p. 2) belongs to the
Principal Group while having determinant `-1`. -/
theorem principalGroup_reflection_sense :
    ((-1 : Matrix (Fin 3) (Fin 3) ℝ)ᵀ * (-1 : Matrix (Fin 3) (Fin 3) ℝ) = 1) ∧
      (-1 : Matrix (Fin 3) (Fin 3) ℝ).det = -1 := by
  refine ⟨by simp, ?_⟩
  rw [Matrix.det_neg, Fintype.card_fin, Matrix.det_one]
  norm_num

/-- Projective `4 × 4` block matrix realization of a Euclidean similarity (`s, r ≠ 0`, `Qᵀ * Q = 1`).
Acts on `(x₀, x₁, x₂, x₃)` with `x₀` as the homogenizing coordinate. -/
def projSimilarityMatrix (s r : ℝ) (Q : Matrix (Fin 3) (Fin 3) ℝ) (t : Fin 3 → ℝ) :
    Matrix (Fin 4) (Fin 4) ℝ :=
  ![ ![s, 0, 0, 0],
     ![s * t 0, r * Q 0 0, r * Q 0 1, r * Q 0 2],
     ![s * t 1, r * Q 1 0, r * Q 1 1, r * Q 1 2],
     ![s * t 2, r * Q 2 0, r * Q 2 1, r * Q 2 2] ]

private lemma projSimilarityMatrix_mulVec_inf (s r : ℝ) (Q : Matrix (Fin 3) (Fin 3) ℝ)
    (t : Fin 3 → ℝ) (y : Fin 3 → ℝ) :
    let w := projSimilarityMatrix s r Q t *ᵥ ![0, y 0, y 1, y 2]
    w 0 = 0 ∧ (Fin.tail w = r • (Q *ᵥ y)) := by
  refine ⟨?_, ?_⟩
  · simp [projSimilarityMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_four]
  · ext i
    fin_cases i <;>
      (simp [Fin.tail, projSimilarityMatrix, Matrix.mulVec, dotProduct,
        Fin.sum_univ_four, Fin.sum_univ_three]; ring)

/-- On the affine chart `x₀ = 1`, `projSimilarityMatrix s r Q t` induces `applySimilarity3 (r/s) Q t`
after dehomogenizing by `s⁻¹`. -/
theorem projSimilarityMatrix_affine_action {s r : ℝ} (hs : s ≠ 0)
    (Q : Matrix (Fin 3) (Fin 3) ℝ) (t v : Fin 3 → ℝ) :
    s⁻¹ • (projSimilarityMatrix s r Q t *ᵥ ![1, v 0, v 1, v 2]) =
      ![1, applySimilarity3 (r / s) Q t v 0,
           applySimilarity3 (r / s) Q t v 1,
           applySimilarity3 (r / s) Q t v 2] := by
  ext i
  fin_cases i
  · simp [projSimilarityMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_four, hs]
  · simp [projSimilarityMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_four,
      applySimilarity3, Fin.sum_univ_three, div_eq_mul_inv]
    field_simp [hs]
    ring
  · simp [projSimilarityMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_four,
      applySimilarity3, Fin.sum_univ_three, div_eq_mul_inv]
    field_simp [hs]
    ring
  · simp [projSimilarityMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_four,
      applySimilarity3, Fin.sum_univ_three, div_eq_mul_inv]
    field_simp [hs]
    ring

/-- Extract the `3 × 3` spatial block of a `4 × 4` homogeneous transformation matrix. -/
def spatialBlock3 (A : Matrix (Fin 4) (Fin 4) ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  Matrix.of fun i j => A i.succ j.succ

/-- Extract the translation numerator vector `(A 1 0, A 2 0, A 3 0)`. -/
def spatialTrans3 (A : Matrix (Fin 4) (Fin 4) ℝ) : Fin 3 → ℝ :=
  fun i => A i.succ 0

private lemma orthogonal_of_mulVec_normSq_scale (M : Matrix (Fin 3) (Fin 3) ℝ) (μ : ℝ)
    (hscale : ∀ y : Fin 3 → ℝ, (M *ᵥ y) ⬝ᵥ (M *ᵥ y) = μ ^ 2 * (y ⬝ᵥ y)) :
    Mᵀ * M = (μ ^ 2) • (1 : Matrix (Fin 3) (Fin 3) ℝ) := by
  have hpol : ∀ u v : Fin 3 → ℝ, (M *ᵥ u) ⬝ᵥ (M *ᵥ v) = μ ^ 2 * (u ⬝ᵥ v) := by
    intro u v
    have hadd := hscale (u + v)
    have hsub := hscale (u - v)
    have hmadd : M *ᵥ (u + v) = M *ᵥ u + M *ᵥ v := Matrix.mulVec_add M u v
    have hmsub : M *ᵥ (u - v) = M *ᵥ u - M *ᵥ v := Matrix.mulVec_sub M u v
    rw [hmadd, dotProduct_add, add_dotProduct, add_dotProduct, dotProduct_comm (M *ᵥ v) (M *ᵥ u)] at hadd
    rw [hmsub, dotProduct_sub, sub_dotProduct, sub_dotProduct, dotProduct_comm (M *ᵥ v) (M *ᵥ u)] at hsub
    rw [dotProduct_add, add_dotProduct, add_dotProduct, dotProduct_comm v u] at hadd
    rw [dotProduct_sub, sub_dotProduct, sub_dotProduct, dotProduct_comm v u] at hsub
    linarith
  ext i j
  let ei : Fin 3 → ℝ := fun k => if k = i then 1 else 0
  let ej : Fin 3 → ℝ := fun k => if k = j then 1 else 0
  have hpol_ij := hpol ei ej
  have hlhs : (M *ᵥ ei) ⬝ᵥ (M *ᵥ ej) = (Mᵀ * M) i j := by
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, dotProduct, Matrix.mulVec, Matrix.transpose_apply,
        ei, ej, Fin.sum_univ_three]
  have hrhs : ei ⬝ᵥ ej = (1 : Matrix (Fin 3) (Fin 3) ℝ) i j := by
    fin_cases i <;> fin_cases j <;>
      simp [dotProduct, ei, ej]
  rw [hlhs, hrhs] at hpol_ij
  simpa [Matrix.smul_apply, smul_eq_mul] using hpol_ij

/-- **Klein's Circle-at-Infinity Characterization of the Principal Group (`§3`, p. 5; `§10.3`, p. 19)**:
A `4 × 4` homogeneous linear transformation `A` (`A 0 0 ≠ 0`) stabilizes the plane at infinity
`x₀ = 0` and scales the Euclidean absolute quadric `x₁² + x₂² + x₃²` on `x₀ = 0` by a nonzero
factor `μ²` (`μ ≠ 0`) **if and only if** `A = projSimilarityMatrix (A 0 0) μ Q t` for an
orthogonal matrix `Q : Matrix (Fin 3) (Fin 3) ℝ` (`Qᵀ * Q = 1`) and translation `t : Fin 3 → ℝ`. -/
theorem projective_circleAtInfinity_stabilizer_iff_similarity3
    (A : Matrix (Fin 4) (Fin 4) ℝ) (h00 : A 0 0 ≠ 0) (μ : ℝ) (hμ : μ ≠ 0) :
    ((A 0 1 = 0 ∧ A 0 2 = 0 ∧ A 0 3 = 0) ∧
      (∀ y : Fin 3 → ℝ,
        let w := A *ᵥ ![0, y 0, y 1, y 2]
        w 1 ^ 2 + w 2 ^ 2 + w 3 ^ 2 = μ ^ 2 * (y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2))) ↔
    ∃ (Q : Matrix (Fin 3) (Fin 3) ℝ) (t : Fin 3 → ℝ),
      Qᵀ * Q = 1 ∧ A = projSimilarityMatrix (A 0 0) μ Q t := by
  constructor
  · rintro ⟨⟨h01, h02, h03⟩, hquad⟩
    let Q : Matrix (Fin 3) (Fin 3) ℝ := μ⁻¹ • spatialBlock3 A
    let t : Fin 3 → ℝ := (A 0 0)⁻¹ • spatialTrans3 A
    have hscale : ∀ y : Fin 3 → ℝ,
        (spatialBlock3 A *ᵥ y) ⬝ᵥ (spatialBlock3 A *ᵥ y) = μ ^ 2 * (y ⬝ᵥ y) := by
      intro y
      have hq := hquad y
      have heq1 : (A *ᵥ ![0, y 0, y 1, y 2]) 1 = (spatialBlock3 A *ᵥ y) 0 := by
        simp [Matrix.mulVec, dotProduct, spatialBlock3, Fin.sum_univ_four, Fin.sum_univ_three]
      have heq2 : (A *ᵥ ![0, y 0, y 1, y 2]) 2 = (spatialBlock3 A *ᵥ y) 1 := by
        simp [Matrix.mulVec, dotProduct, spatialBlock3, Fin.sum_univ_four, Fin.sum_univ_three]
      have heq3 : (A *ᵥ ![0, y 0, y 1, y 2]) 3 = (spatialBlock3 A *ᵥ y) 2 := by
        simp [Matrix.mulVec, dotProduct, spatialBlock3, Fin.sum_univ_four, Fin.sum_univ_three]
      dsimp only at hq
      rw [heq1, heq2, heq3] at hq
      simpa [dotProduct, Fin.sum_univ_three, sq] using hq
    have hQtQ : Qᵀ * Q = 1 := by
      have hsp := orthogonal_of_mulVec_normSq_scale (spatialBlock3 A) μ hscale
      calc
        Qᵀ * Q = (μ⁻¹ • spatialBlock3 A)ᵀ * (μ⁻¹ • spatialBlock3 A) := rfl
        _ = (μ⁻¹ * μ⁻¹) • ((spatialBlock3 A)ᵀ * spatialBlock3 A) := by
          rw [Matrix.transpose_smul, Matrix.smul_mul, Matrix.mul_smul, smul_smul]
        _ = (μ⁻¹ * μ⁻¹) • ((μ ^ 2) • (1 : Matrix (Fin 3) (Fin 3) ℝ)) := by rw [hsp]
        _ = ((μ⁻¹ * μ⁻¹) * μ ^ 2) • (1 : Matrix (Fin 3) (Fin 3) ℝ) := smul_smul _ _ _
        _ = 1 := by
          have hsc : (μ⁻¹ * μ⁻¹) * μ ^ 2 = 1 := by field_simp [hμ]
          rw [hsc, one_smul]
    refine ⟨Q, t, hQtQ, ?_⟩
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [projSimilarityMatrix, h01, h02, h03, t, spatialTrans3, Q, spatialBlock3, h00, hμ]
  · rintro ⟨Q, t, hQtQ, hA⟩
    rw [hA]
    refine ⟨⟨by simp [projSimilarityMatrix], by simp [projSimilarityMatrix],
      by simp [projSimilarityMatrix]⟩, ?_⟩
    intro y
    have hm := (projSimilarityMatrix_mulVec_inf (A 0 0) μ Q t y).2
    have hdot : (Fin.tail (projSimilarityMatrix (A 0 0) μ Q t *ᵥ ![0, y 0, y 1, y 2])) ⬝ᵥ
        (Fin.tail (projSimilarityMatrix (A 0 0) μ Q t *ᵥ ![0, y 0, y 1, y 2])) =
        μ ^ 2 * (y ⬝ᵥ y) := by
      rw [hm, smul_dotProduct, dotProduct_smul, orthogonal_mulVec_dotProduct Q hQtQ,
        smul_eq_mul, smul_eq_mul, ← mul_assoc, ← sq]
    simpa [dotProduct, Fin.sum_univ_three, Fin.tail, sq] using hdot

end PrincipalGroupAndCircleAtInfinity

