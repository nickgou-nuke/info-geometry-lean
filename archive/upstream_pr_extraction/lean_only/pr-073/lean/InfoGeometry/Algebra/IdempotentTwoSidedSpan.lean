import InfoGeometry.Algebra.IdempotentCornerCommutant

/-!
# Additive two-sided ideals generated by an idempotent

`{a * e * b}` is only the set of single products.  The algebraic two-sided
ideal `AeA` is the additive span of those products.  This owner records the
correct carrier without asserting fullness or Morita equivalence.
-/

namespace InfoGeometry.Algebra.IdempotentTwoSidedSpan

variable {A : Type*} [Ring A]

def generators (e : A) : Set A :=
  Set.range (fun p : A × A => p.1 * e * p.2)

def twoSidedSpan (e : A) : Submodule ℤ A :=
  Submodule.span ℤ (generators e)

theorem generator_mem_twoSidedSpan (e a b : A) :
    a * e * b ∈ twoSidedSpan e := by
  exact Submodule.subset_span ⟨(a, b), rfl⟩

theorem twoSidedSpan_zero_mem (e : A) :
    (0 : A) ∈ twoSidedSpan e := by
  exact (twoSidedSpan e).zero_mem

theorem twoSidedSpan_add_mem (e x y : A)
    (hx : x ∈ twoSidedSpan e) (hy : y ∈ twoSidedSpan e) :
    x + y ∈ twoSidedSpan e := by
  exact (twoSidedSpan e).add_mem hx hy

theorem left_mul_mem_twoSidedSpan (e a x : A)
    (hx : x ∈ twoSidedSpan e) :
    a * x ∈ twoSidedSpan e := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
  · intro y hy
    rcases hy with ⟨⟨u, v⟩, rfl⟩
    exact Submodule.subset_span ⟨(a * u, v), by simp [mul_assoc]
      ⟩
  · simpa using (twoSidedSpan e).zero_mem
  · intro y z hy hz hhy hhz
    simpa [mul_add] using (twoSidedSpan e).add_mem hhy hhz
  · intro n y hy hhy
    rw [mul_smul_comm n a y]
    exact (twoSidedSpan e).smul_mem n hhy

theorem right_mul_mem_twoSidedSpan (e b x : A)
    (hx : x ∈ twoSidedSpan e) :
    x * b ∈ twoSidedSpan e := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
  · intro y hy
    rcases hy with ⟨⟨u, v⟩, rfl⟩
    exact Submodule.subset_span ⟨(u, v * b), by simp [mul_assoc]
      ⟩
  · simpa using (twoSidedSpan e).zero_mem
  · intro y z hy hz hhy hhz
    simpa [add_mul] using (twoSidedSpan e).add_mem hhy hhz
  · intro n y hy hhy
    rw [smul_mul_assoc n y b]
    exact (twoSidedSpan e).smul_mem n hhy

theorem twoSidedSpan_is_twoSidedIdeal (e : A) :
    (∀ a x, x ∈ twoSidedSpan e → a * x ∈ twoSidedSpan e) ∧
      (∀ b x, x ∈ twoSidedSpan e → x * b ∈ twoSidedSpan e) := by
  exact ⟨fun a x hx => left_mul_mem_twoSidedSpan e a x hx,
    fun b x hx => right_mul_mem_twoSidedSpan e b x hx⟩

theorem twoSidedSpan_eq_top_iff_one_mem (e : A) :
    twoSidedSpan e = ⊤ ↔ (1 : A) ∈ twoSidedSpan e := by
  constructor
  · intro h
    rw [h]
    exact Submodule.mem_top
  · intro h
    apply top_unique
    intro x hx
    have hx' := left_mul_mem_twoSidedSpan e x 1 h
    simpa using hx'

noncomputable def corner_endomorphism_equiv
    (e : A) (he : e * e = e) :
    InfoGeometry.Algebra.IdempotentCornerCommutant.corner e he ≃
      Module.End A
        (InfoGeometry.Algebra.IdempotentCornerCommutant.principalLeftIdeal e he) :=
  InfoGeometry.Algebra.IdempotentCornerCommutant.cornerEndEquiv e he

end InfoGeometry.Algebra.IdempotentTwoSidedSpan
