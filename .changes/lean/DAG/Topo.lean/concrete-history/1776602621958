{"type":"new","contents":"namespace DAG\n\ndef topo (dag preds : Array (Array Nat)) : Array Nat := Id.run do\n  let mut indeg := preds.map (·.size)\n  let mut q : List Nat := []\n  for i in [:dag.size] do\n    if indeg[i]! == 0 then q := i :: q\n\n  let mut out := #[]\n  while true do\n    match q with\n    | [] => break\n    | u :: r =>\n        q := r\n        out := out.push u\n        for v in dag[u]! do\n          let d := indeg[v]! - 1\n          indeg := indeg.set! v d\n          if d == 0 then\n            q := v :: q\n  out\n\nend DAG\n","mtime":1776602621958}