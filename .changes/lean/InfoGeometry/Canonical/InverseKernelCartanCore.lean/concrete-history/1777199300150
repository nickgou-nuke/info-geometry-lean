{"type":"new","contents":"import InfoGeometry.Canonical.EPAndGroupInverse\nimport Mathlib.Tactic.NoncommRing\n\nnamespace InfoGeometry.Canonical\n\nopen InfoGeometry.Canonical.CartanDecomposition\nopen InfoGeometry.Canonical.Drazin\nopen InfoGeometry.Canonical.MoorePenrose\n\n/-!\n# Inverse Kernel Cartan Core\n\nThis file exposes the spectral Cartan seed of the certified inverse-kernel\npackage through a stable owner surface. The underlying Cartan algebra lives in\n`CartanDecomposition`; here we adapt it to the certified inverse-kernel center\nand connect it to the projector/complement algebra.\n-/\n\nvariable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"EndH\" => E →L[ℝ] E\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℚ EndH :=\n  NormedAlgebra.restrictScalars ℚ ℝ EndH\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : SMulCommClass ℝ EndH EndH := inferInstance\nlocal instance : IsScalarTower ℝ EndH EndH := inferInstance\n\nnamespace CertifiedInverseKernel\n\nvariable (CIK : CertifiedInverseKernel E)\n\n/-- Canonical spectral Cartan triple attached to the certified inverse kernel. -/\nnoncomputable abbrev cartanTriple : InformationCartanTriple EndH :=\n  CIK.toInformationCartanTriple\n\n/-- Spectral Cartan grading `Γ_S = 2 P_D - 1`. -/\nnoncomputable abbrev GammaS : EndH :=\n  CIK.cartanTriple.GammaS\n\n/-- Spectral Cartan involution `θ_S(X) = Γ_S X Γ_S`. -/\nnoncomputable abbrev thetaS : EndH → EndH :=\n  CIK.cartanTriple.thetaS\n\n/-- Spectral compact sector: fixed points of the Cartan involution. -/\nnoncomputable abbrev IsSpectralCompact (X : EndH) : Prop :=\n  CIK.cartanTriple.IsSpectralCompact X\n\n/-- Spectral noncompact sector: `-1` eigenspace of the Cartan involution. -/\nnoncomputable abbrev IsSpectralNonCompact (X : EndH) : Prop :=\n  CIK.cartanTriple.IsSpectralNonCompact X\n\n/-- Spectral Lie commutator. -/\nabbrev spectralCommutator (X Y : EndH) : EndH :=\n  InformationCartanTriple.spectralCommutator X Y\n\n/-- Spectral compact exponential flow. -/\nnoncomputable abbrev spectralCompactFlow (X : EndH) (t : ℝ) : EndH :=\n  CIK.cartanTriple.spectralCompactFlow X t\n\n/-- Spectral adjoint transport by the compact flow. -/\nnoncomputable abbrev spectralAdjointFlow (X : EndH) (t : ℝ) (Y : EndH) : EndH :=\n  CIK.cartanTriple.spectralAdjointFlow X t Y\n\n/-- Distinguished grading flow generated by `Γ_S`. -/\nnoncomputable abbrev spectralGradingFlow (t : ℝ) : EndH :=\n  CIK.cartanTriple.spectralGradingFlow t\n\n/-- The spectral Cartan grading is exactly `2 P_D - 1`. -/\ntheorem GammaS_eq_two_mul_spectralProjector_sub_one :\n    CIK.GammaS = 2 * CIK.spectralProjector - 1 := by\n  rfl\n\n/--\nThe spectral Cartan grading is the difference between the spectral projector\nand its complement.\n-/\ntheorem GammaS_eq_spectralProjector_sub_spectralComplementaryProjector :\n    CIK.GammaS = CIK.spectralProjector - CIK.spectralComplementaryProjector := by\n  change 2 * CIK.spectralProjector - 1 = CIK.spectralProjector - (1 - CIK.spectralProjector)\n  noncomm_ring\n\n/-- The spectral Cartan grading is involutive. -/\ntheorem GammaS_sq_eq_one :\n    CIK.GammaS * CIK.GammaS = (1 : EndH) := by\n  simpa [CertifiedInverseKernel.GammaS, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple] using\n    InformationCartanTriple.GammaS_sq_eq_one CIK.toInformationCartanTriple CIK.hDrazin\n\n/-- The spectral projector is the `+1` sector of the spectral grading. -/\ntheorem GammaS_mul_spectralProjector :\n    CIK.GammaS * CIK.spectralProjector = CIK.spectralProjector := by\n  simpa [CertifiedInverseKernel.GammaS, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple, CertifiedInverseKernel.spectralProjector,\n    CertifiedInverseKernel.toInverseKernel'] using\n    InformationCartanTriple.GammaS_mul_spectralProjector CIK.toInformationCartanTriple CIK.hDrazin\n\n/-- The complementary spectral projector is the `-1` sector of the spectral grading. -/\ntheorem GammaS_mul_spectralComplementaryProjector :\n    CIK.GammaS * CIK.spectralComplementaryProjector = -CIK.spectralComplementaryProjector := by\n  change (2 * CIK.spectralProjector - 1) * (1 - CIK.spectralProjector) = -(1 - CIK.spectralProjector)\n  noncomm_ring [CIK.spectralProjector_idempotent]\n\n/-- The spectral Cartan involution squares to the identity. -/\ntheorem thetaS_involutive (X : EndH) :\n    CIK.thetaS (CIK.thetaS X) = X := by\n  simpa [CertifiedInverseKernel.thetaS, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple] using\n    InformationCartanTriple.thetaS_involutive CIK.toInformationCartanTriple CIK.hDrazin X\n\n/-- Spectral compactness is exactly commutation with `Γ_S`. -/\ntheorem isSpectralCompact_iff_commute_GammaS {X : EndH} :\n    CIK.IsSpectralCompact X ↔ X * CIK.GammaS = CIK.GammaS * X := by\n  simpa [CertifiedInverseKernel.IsSpectralCompact, CertifiedInverseKernel.GammaS,\n    CertifiedInverseKernel.cartanTriple, CertifiedInverseKernel.toInformationCartanTriple] using\n    (InformationCartanTriple.isSpectralCompact_iff_commute\n      CIK.toInformationCartanTriple CIK.hDrazin (X := X))\n\n/-- Spectral noncompactness is exactly anticommutation with `Γ_S`. -/\ntheorem isSpectralNonCompact_iff_anticommute_GammaS {X : EndH} :\n    CIK.IsSpectralNonCompact X ↔ X * CIK.GammaS = -(CIK.GammaS * X) := by\n  simpa [CertifiedInverseKernel.IsSpectralNonCompact, CertifiedInverseKernel.GammaS,\n    CertifiedInverseKernel.cartanTriple, CertifiedInverseKernel.toInformationCartanTriple] using\n    (InformationCartanTriple.isSpectralNonCompact_iff_anticommute\n      CIK.toInformationCartanTriple CIK.hDrazin (X := X))\n\n/-- The spectral projector lies in the compact Cartan sector. -/\ntheorem spectralProjector_isSpectralCompact :\n    CIK.IsSpectralCompact CIK.spectralProjector := by\n  simpa [CertifiedInverseKernel.IsSpectralCompact, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple, CertifiedInverseKernel.spectralProjector,\n    CertifiedInverseKernel.toInverseKernel'] using\n    InformationCartanTriple.spectralProjector_isSpectralCompact CIK.toInformationCartanTriple CIK.hDrazin\n\n/-- The complementary spectral projector also lies in the compact Cartan sector. -/\ntheorem spectralComplementaryProjector_isSpectralCompact :\n    CIK.IsSpectralCompact CIK.spectralComplementaryProjector := by\n  simpa [CertifiedInverseKernel.IsSpectralCompact, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple, CertifiedInverseKernel.spectralComplementaryProjector,\n    CertifiedInverseKernel.toInverseKernel'] using\n    InformationCartanTriple.spectralComplement_isSpectralCompact CIK.toInformationCartanTriple CIK.hDrazin\n\n/-- The grading flow is an additive one-parameter subgroup. -/\ntheorem spectralGradingFlow_add (s t : ℝ) :\n    CIK.spectralGradingFlow (s + t) =\n      CIK.spectralGradingFlow s * CIK.spectralGradingFlow t := by\n  simpa [CertifiedInverseKernel.spectralGradingFlow, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple] using\n    InformationCartanTriple.spectralGradingFlow_add CIK.toInformationCartanTriple s t\n\n/-- The grading flow starts at the identity. -/\ntheorem spectralGradingFlow_zero :\n    CIK.spectralGradingFlow 0 = (1 : EndH) := by\n  simpa [CertifiedInverseKernel.spectralGradingFlow, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple] using\n    InformationCartanTriple.spectralGradingFlow_zero CIK.toInformationCartanTriple\n\n/-- Closed form for the grading flow generated by `Γ_S`. -/\ntheorem spectralGradingFlow_eq_cosh_add_sinh_GammaS (t : ℝ) :\n    CIK.spectralGradingFlow t =\n      Real.cosh t • (1 : EndH) + Real.sinh t • CIK.GammaS := by\n  simpa [CertifiedInverseKernel.spectralGradingFlow, CertifiedInverseKernel.GammaS,\n    CertifiedInverseKernel.cartanTriple, CertifiedInverseKernel.toInformationCartanTriple] using\n    InformationCartanTriple.spectralGradingFlow_eq_cosh_add_sinh_GammaS\n      CIK.toInformationCartanTriple CIK.hDrazin t\n\n/-- The spectral projector commutes with the grading flow. -/\ntheorem spectralProjector_commutes_spectralGradingFlow (t : ℝ) :\n    Commute CIK.spectralProjector (CIK.spectralGradingFlow t) := by\n  simpa [CertifiedInverseKernel.spectralGradingFlow, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple, CertifiedInverseKernel.spectralProjector,\n    CertifiedInverseKernel.toInverseKernel'] using\n    InformationCartanTriple.spectralProjector_commutes_spectralGradingFlow\n      CIK.toInformationCartanTriple CIK.hDrazin t\n\n/-- The complementary spectral projector commutes with the grading flow. -/\ntheorem spectralComplementaryProjector_commutes_spectralGradingFlow (t : ℝ) :\n    Commute CIK.spectralComplementaryProjector (CIK.spectralGradingFlow t) := by\n  simpa [CertifiedInverseKernel.spectralGradingFlow, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple, CertifiedInverseKernel.spectralComplementaryProjector,\n    CertifiedInverseKernel.toInverseKernel'] using\n    InformationCartanTriple.spectralComplement_commutes_spectralGradingFlow\n      CIK.toInformationCartanTriple CIK.hDrazin t\n\n/-- The grading adjoint flow fixes the spectral projector. -/\ntheorem spectralProjector_fixed_under_spectralGradingFlow (t : ℝ) :\n    CIK.spectralAdjointFlow CIK.GammaS t CIK.spectralProjector = CIK.spectralProjector := by\n  simpa [CertifiedInverseKernel.spectralAdjointFlow, CertifiedInverseKernel.GammaS,\n    CertifiedInverseKernel.cartanTriple, CertifiedInverseKernel.toInformationCartanTriple,\n    CertifiedInverseKernel.spectralProjector, CertifiedInverseKernel.toInverseKernel] using\n    InformationCartanTriple.spectralProjector_fixed_under_spectralGradingFlow\n      CIK.toInformationCartanTriple CIK.hDrazin t\n\n/-- The grading adjoint flow fixes the complementary spectral projector. -/\ntheorem spectralComplementaryProjector_fixed_under_spectralGradingFlow (t : ℝ) :\n    CIK.spectralAdjointFlow CIK.GammaS t CIK.spectralComplementaryProjector =\n      CIK.spectralComplementaryProjector := by\n  simpa [CertifiedInverseKernel.spectralAdjointFlow, CertifiedInverseKernel.GammaS,\n    CertifiedInverseKernel.cartanTriple, CertifiedInverseKernel.toInformationCartanTriple,\n    CertifiedInverseKernel.spectralComplementaryProjector, CertifiedInverseKernel.toInverseKernel] using\n    InformationCartanTriple.spectralComplement_fixed_under_spectralGradingFlow\n      CIK.toInformationCartanTriple CIK.hDrazin t\n\nend CertifiedInverseKernel\n\nend InfoGeometry.Canonical\n","mtime":1777199300150}