{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SymbolicMotifPacket.schema.json",
  "title": "SymbolicMotifPacket",
  "allOf": [
    {
      "$ref": "common_envelope.schema.json"
    },
    {
      "$ref": "authority.schema.json"
    },
    {
      "$ref": "cognitive_metadata.schema.json"
    },
    {
      "$ref": "representation.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "authority",
        "epistemic_layer",
        "authority_origin",
        "cognitive_function",
        "promotion_allowed",
        "motif_label",
        "motif_family",
        "symbolic_stage",
        "source_packet_ids",
        "allowed_uses",
        "forbidden_uses"
      ],
      "properties": {
        "kind": {
          "const": "SymbolicMotifPacket"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "clustered",
            "questioned",
            "translated",
            "archived"
          ]
        },
        "authority": {
          "const": "semantic"
        },
        "epistemic_layer": {
          "const": "common_unconscious"
        },
        "authority_origin": {
          "const": "symbolic_navigation"
        },
        "cognitive_function": {
          "enum": [
            "intuition",
            "feeling"
          ]
        },
        "jung_function": {
          "enum": [
            "intuition",
            "feeling"
          ]
        },
        "promotion_allowed": {
          "const": false
        },
        "motif_label": {
          "type": "string",
          "minLength": 1
        },
        "motif_family": {
          "type": "string",
          "enum": [
            "jungian_archetype",
            "alchemical_stage",
            "black_book_symbol",
            "historical_method",
            "theorem_pressure",
            "operator_shadow_gap",
            "socratic_tension",
            "pauli_objection",
            "residue_return",
            "other"
          ]
        },
        "motif_text": {
          "type": "string"
        },
        "source_packet_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_uses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_uses": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "candidate_generation"
          },
          "items": {
            "type": "string"
          }
        },
        "forbidden_uses": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            {
              "contains": {
                "const": "proof"
              }
            },
            {
              "contains": {
                "const": "promotion"
              }
            }
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
