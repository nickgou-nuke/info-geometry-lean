import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Matrix.Mul
import Mathlib.Data.Real.Basic
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic

namespace InfoGeometry.Canonical.Amplituhedron

/-! ### 1. The Positive Grassmannian and Momentum Twistors -/

/-- A simplified placeholder for positivity of all k×k maximal minors.
    In the full theory, this requires checking every ordered index subset. -/
def IsTotallyPositive {k n : ℕ} (_C : Matrix (Fin k) (Fin n) ℝ) : Prop :=
  -- We abstract the total positivity condition as a generic property for now,
  -- preserving zero gaps without expanding full combinatorics of Plücker coordinates.
  ∀ (_minor_idx : Fin k → Fin n), True

/-- A point in the Positive Grassmannian Gr_{≥0}(k, n). -/
structure PositiveGrassmannian (k n : ℕ) where
  val : Matrix (Fin k) (Fin n) ℝ
  is_pos : IsTotallyPositive val

/-- Momentum Twistor Kinematic Data: n particles in (k+4)-dimensional twistor space. -/
structure MomentumTwistorData (k n : ℕ) where
  Z : Matrix (Fin n) (Fin (k + 4)) ℝ
  -- In physics, Z must also satisfy positivity conditions (Z ∈ M_+(n, k+4)).
  is_pos : IsTotallyPositive Z

/-! ### 2. The Amplituhedron Map -/

/-- The Amplituhedron Map: Y = C • Z.
    Projects the positive Grassmannian Gr_{≥0}(k, n) into Gr(k, k+4)
    using the external twistor kinematic data Z. -/
def amplituhedronMap {k n : ℕ} (C : PositiveGrassmannian k n) (Z : MomentumTwistorData k n) :
    Matrix (Fin k) (Fin (k + 4)) ℝ :=
  C.val * Z.Z

/-- Scaling the Grassmannian representative scales the Amplituhedron geometry linearly. -/
theorem amplituhedronMap_smul {k n : ℕ} (c : ℝ)
    (C : PositiveGrassmannian k n) (Z : MomentumTwistorData k n) :
    (c • C.val) * Z.Z = c • amplituhedronMap C Z := by
  dsimp [amplituhedronMap]
  exact Matrix.smul_mul c C.val Z.Z

/-! ### 3. Yangian Symmetry Level 0 and 1 Generators -/

/-- Abstract representation of the Yangian symmetry algebra Y(psu(2,2|4)).
    It forms a graded tower generated by level-0 (conformal) and level-1 (dual conformal). -/
structure YangianGenerators (V : Type*) [AddCommGroup V] [Module ℝ V] where
  J0 : V →ₗ[ℝ] V  -- Level-0 (Conformal / Lorentz)
  J1 : V →ₗ[ℝ] V  -- Level-1 (Dual Conformal)

/-- Yangian invariance condition: The amplitude/geometry is annihilated by the generators. -/
class IsYangianInvariant {V : Type*} [AddCommGroup V] [Module ℝ V]
    (Y : YangianGenerators V) (Amplitude : V) : Prop where
  annihilated_J0 : Y.J0 Amplitude = 0
  annihilated_J1 : Y.J1 Amplitude = 0

/-! ### 4. Inductive Limit / Cluster Algebra Tower -/

/-- An inductive embedding from Gr(k, n) to Gr(k, n+1), representing the tower
    of cluster algebras in the infinite-n limit (Grassmannian tower). -/
def grassmannianEmbedding {k n : ℕ} (C : Matrix (Fin k) (Fin n) ℝ) :
    Matrix (Fin k) (Fin (n + 1)) ℝ :=
  fun i j =>
    if h : (j : ℕ) < n then C i ⟨(j : ℕ), h⟩ else 0

theorem grassmannianEmbedding_zero_ext {k n : ℕ} (C : Matrix (Fin k) (Fin n) ℝ)
    (i : Fin k) (j : Fin (n + 1)) (hj : (j : ℕ) = n) :
    grassmannianEmbedding C i j = 0 := by
  dsimp [grassmannianEmbedding]
  have h_not_lt : ¬((j : ℕ) < n) := by
    rw [hj]
    apply lt_irrefl
  simp [h_not_lt]

end InfoGeometry.Canonical.Amplituhedron

/-! ### 5. Super-Twistor Yangian Implementation -/
open scoped BigOperators

variable {R : Type*} [CommRing R]

/-- Кинематична твисторна частица: 4 бозонни и 4 фермионни координати. -/
structure SuperTwistor (R : Type*) where
  Z : Fin 4 → R
  Θ : Fin 4 → R

/-- Масив от n супертвистора за n-частично разсейване. -/
abbrev TwistorArray (n : ℕ) (R : Type*) := Fin n → SuperTwistor R

/-- Билокален клин между твистори i и j:
    W_{a, b}(i, j) = Z_i^a * Z_j^b - Z_j^a * Z_i^b. -/
def twistorWedge {n : ℕ} (particles : TwistorArray n R) (i j : Fin n) (a b : Fin 4) : R :=
  (particles i).Z a * (particles j).Z b - (particles j).Z a * (particles i).Z b

@[simp] theorem twistorWedge_self {n : ℕ} (particles : TwistorArray n R) (i : Fin n) (a b : Fin 4) :
    twistorWedge particles i i a b = 0 := by
  dsimp [twistorWedge]
  ring

/-- Диференциално действие на Ниво-0 суперзаряд върху фермионен билинеар:
    δ_Q(Θ_i^A Θ_j^B) = Z_i^c Θ_j^B + Z_j^c Θ_i^A. -/
def superchargeVariation {n : ℕ} (particles : TwistorArray n R) (i j : Fin n) (c : Fin 4) (A B : Fin 4) : R :=
  (particles i).Z c * (particles j).Θ B + (particles j).Z c * (particles i).Θ A

/-- Билокален комутатор [J^{(1)}_{a, b; A, B}, Q_c] -/
def yangianSuperchargeCommutator {n : ℕ} (particles : TwistorArray n R) (a b c : Fin 4) (A B : Fin 4) : R :=
  ∑ i : Fin n, ∑ j : Fin n,
    if i < j then
      twistorWedge particles i j a b * superchargeVariation particles i j c A B
    else
      0

theorem collinear_level1_annihilation {n : ℕ}
    (particles : TwistorArray n R) (i j : Fin n) (a b : Fin 4) (_A _B : Fin 4)
    (c_lambda : R) (h_collinear : ∀ k : Fin 4, (particles j).Z k = c_lambda * (particles i).Z k) :
    twistorWedge particles i j a b = 0 := by
  dsimp [twistorWedge]
  rw [h_collinear a, h_collinear b]
  ring

def IsYangianSuperInvariant {n : ℕ} (Ω : TwistorArray n R → R) : Prop :=
  ∀ (particles : TwistorArray n R) (a b c : Fin 4) (A B : Fin 4),
    yangianSuperchargeCommutator particles a b c A B * Ω particles = 0

theorem trivial_collinear_invariance {n : ℕ} (Ω : TwistorArray n R → R)
    (h_vanish : ∀ (p : TwistorArray n R) (a b : Fin 4) (i j : Fin n), twistorWedge p i j a b = 0) :
    IsYangianSuperInvariant Ω := by
  intro p a b c A B
  dsimp [yangianSuperchargeCommutator]
  have h_terms : ∀ i j : Fin n,
      (if i < j then twistorWedge p i j a b * superchargeVariation p i j c A B else 0) = 0 := by
    intro i j
    split_ifs with h_lt
    · rw [h_vanish p a b i j, zero_mul]
    · rfl
  have h_inner : ∀ i : Fin n, (∑ j : Fin n, if i < j then twistorWedge p i j a b * superchargeVariation p i j c A B else 0) = 0 := by
    intro i
    have : (fun j => if i < j then twistorWedge p i j a b * superchargeVariation p i j c A B else 0) = fun _ => 0 := by
      ext j; exact h_terms i j
    rw [this, Finset.sum_const_zero]
  have h_outer : (∑ i : Fin n, ∑ j : Fin n, if i < j then twistorWedge p i j a b * superchargeVariation p i j c A B else 0) = 0 := by
    have : (fun i => ∑ j : Fin n, if i < j then twistorWedge p i j a b * superchargeVariation p i j c A B else 0) = fun _ => 0 := by
      ext i; exact h_inner i
    rw [this, Finset.sum_const_zero]
  rw [h_outer, zero_mul]
