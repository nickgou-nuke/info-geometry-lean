import InfoGeometry.Algebra.ZornAlternativeLaws
import Mathlib.Tactic

/-!
# Zorn traceless two-mode polynomial flow

In the repository's actual Zorn multiplication convention the Casimir is
`α² + dot v w`, not `α² - dot v w`. This is a polynomial two-mode flow,
not a general analytic exponential or a global Lie-group representation.
-/

namespace InfoGeometry.Algebra.ZornVectorMatrix

variable {R : Type*} [CommRing R]

/-- The Casimir of the owner's traceless Zorn generator. -/
def zornTracelessCasimir (α : R) (v w : ZornVec3 R) : R :=
  α * α + ZornVec3.dot v w

/-- Polynomial flow inside the two-dimensional subalgebra generated by `1` and `M`. -/
def zornTracelessExp (c s α : R) (v w : ZornVec3 R) : ZornVectorMatrix R :=
  c • (1 : ZornVectorMatrix R) + s • zornTracelessFlowGen α v w

/-- Concrete coordinates. -/
theorem zornTracelessExp_coordinates (c s α : R) (v w : ZornVec3 R) :
    zornTracelessExp c s α v w =
      ⟨c + s * α, (fun i => s * v i), (fun i => s * w i), c - s * α⟩ := by
  ext
  · simp [zornTracelessExp, zornTracelessFlowGen, InfoGeometry.Algebra.zvm_add_def,
      InfoGeometry.Algebra.zvm_smul_def, add, smul, one]; ring
  · rename_i i
    simp [zornTracelessExp, zornTracelessFlowGen, InfoGeometry.Algebra.zvm_add_def,
      InfoGeometry.Algebra.zvm_smul_def, add, smul, one]
  · rename_i i
    simp [zornTracelessExp, zornTracelessFlowGen, InfoGeometry.Algebra.zvm_add_def,
      InfoGeometry.Algebra.zvm_smul_def, add, smul, one]
  · simp [zornTracelessExp, zornTracelessFlowGen, InfoGeometry.Algebra.zvm_add_def,
      InfoGeometry.Algebra.zvm_smul_def, add, smul, one]; ring

/-- Two-mode Cayley--Hamilton multiplication in a common generator. -/
theorem zornTracelessExp_mul
    (c₁ s₁ c₂ s₂ α : R) (v w : ZornVec3 R) :
    zornTracelessExp c₁ s₁ α v w * zornTracelessExp c₂ s₂ α v w =
      zornTracelessExp
        (c₁ * c₂ + s₁ * s₂ * zornTracelessCasimir α v w)
        (c₁ * s₂ + s₁ * c₂) α v w := by
  ext
  · simp [zornTracelessExp_coordinates, zornTracelessCasimir,
      InfoGeometry.Algebra.zvm_mul_def, mul, ZornVec3.dot]; ring
  · rename_i i
    fin_cases i <;>
      (simp [zornTracelessExp_coordinates, zornTracelessCasimir,
        InfoGeometry.Algebra.zvm_mul_def, mul, ZornVec3.dot, ZornVec3.cross]; ring)
  · rename_i i
    fin_cases i <;>
      (simp [zornTracelessExp_coordinates, zornTracelessCasimir,
        InfoGeometry.Algebra.zvm_mul_def, mul, ZornVec3.dot, ZornVec3.cross]; ring)
  · simp [zornTracelessExp_coordinates, zornTracelessCasimir,
      InfoGeometry.Algebra.zvm_mul_def, mul, ZornVec3.dot]; ring

/-- Inverse candidate and its scalar norm obstruction; no invertibility is assumed. -/
theorem zornTracelessExp_mul_opposite
    (c s α : R) (v w : ZornVec3 R) :
    zornTracelessExp c s α v w * zornTracelessExp c (-s) α v w =
      (c * c - s * s * zornTracelessCasimir α v w) •
        (1 : ZornVectorMatrix R) := by
  rw [zornTracelessExp_mul]
  have hs : c * (-s) + s * c = 0 := by ring
  have hc : c * c + s * (-s) * zornTracelessCasimir α v w =
      c * c - s * s * zornTracelessCasimir α v w := by ring
  rw [hs, hc]
  simp [zornTracelessExp]

end InfoGeometry.Algebra.ZornVectorMatrix
