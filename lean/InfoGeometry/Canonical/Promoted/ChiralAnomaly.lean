section InverseLayer

variable {R : Type*} [SeminormedRing R]

/--
The Chiral Anomaly Operator (χ).
Defined as the commutator between the geometric (Penrose) inverse 
and the spectral (Drazin) inverse.
χ = [a⁺, aᴰ].
-/
def inverseCommutator (_a : R) (a_mp a_d : R) : R :=
  a_mp * a_d - a_d * a_mp

/--
The Chiral Scale ε.
Generated by the divergence between geometry and spectrum.
ε = || [a⁺, aᴰ] ||.
-/
noncomputable def epsilon (a a_mp a_d : R) : ℝ :=
  nnnorm (inverseCommutator a a_mp a_d)

/--
Theorem: If an information operator is normal, its Chiral Anomaly 
(in the inverse sense) vanishes for index 1.
This provides the inverse-level bridge to the projector-level proof.
-/
theorem normal_inverse_anomaly_vanishes (_a a_mp a_d : R)
    (h_comm : a_mp * a_d = a_d * a_mp) :
    inverseCommutator _a a_mp a_d = 0 := by
  simpa [inverseCommutator, sub_eq_zero] using h_comm

end InverseLayer

section RoutingClifford

open scoped BigOperators

/-- Routing chiral anomaly from the split `Cl(1,1)` mode masses. -/
noncomputable def routingChiralAnomaly {n : Nat}
    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) : ℝ :=
  plusMass w label - minusMass w label

/-- Emergent routing chiral scale `ε` from the split mass imbalance. -/
noncomputable def routingEpsilon {n : Nat}
    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) : ℝ :=
  |routingChiralAnomaly w label|

lemma routingChiralAnomaly_eq_semantic_coord_gap {n : Nat}
    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) :
    routingChiralAnomaly w label
      = (cliffordSemanticState w label).1 - (cliffordSemanticState w label).2 := by
  unfold routingChiralAnomaly
  rw [cliffordSemanticState_fst_eq_plusMass, cliffordSemanticState_snd_eq_minusMass]

lemma routingEpsilon_nonneg {n : Nat}
    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) :
    0 ≤ routingEpsilon w label := by
  unfold routingEpsilon
  exact abs_nonneg _

lemma routingEpsilon_le_one_of_simplex {n : Nat}
    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel)
    (hw_nonneg : ∀ σ, 0 ≤ w σ)
    (hw_sum : ∑ σ, w σ = 1) :
    routingEpsilon w label ≤ 1 := by
  have hp : 0 ≤ plusMass w label := plusMass_nonneg hw_nonneg
  have hq : 0 ≤ minusMass w label := minusMass_nonneg hw_nonneg
  have hsum_pm : plusMass w label + minusMass w label = 1 := by
    rw [plusMass_add_minusMass_eq_sum, hw_sum]
  have htri :
      |plusMass w label - minusMass w label|
        ≤ |plusMass w label| + |minusMass w label| := by
    simpa [sub_eq_add_neg, abs_neg] using
      (abs_add_le (plusMass w label) (-(minusMass w label)))
  unfold routingEpsilon routingChiralAnomaly
  calc
    |plusMass w label - minusMass w label|
        ≤ |plusMass w label| + |minusMass w label| := htri
    _ = plusMass w label + minusMass w label := by
          simp [abs_of_nonneg hp, abs_of_nonneg hq]
    _ = 1 := hsum_pm

lemma routingEpsilon_eq_semantic_gap_abs {n : Nat}
    (w : PermMode n → ℝ) (label : PermMode n → CliffordLabel) :
    routingEpsilon w label
      = |(cliffordSemanticState w label).1 - (cliffordSemanticState w label).2| := by
  unfold routingEpsilon
  rw [routingChiralAnomaly_eq_semantic_coord_gap]

section FromBistochastic

variable {V : Type*} [NormedAddCommGroup V]
variable (n : Nat) [Nonempty (Fin n)]

/--
For a bistochastic router, the Birkhoff decomposition admits a canonical
split-`Cl(1,1)` chiral scale `ε` bounded by `1`.
-/
theorem exists_routingEpsilon_of_bistochastic
    (β : ℝ) (x : Fin n → V) (hcol : IsBistochasticSwitch n β x)
    (label : PermMode n → CliffordLabel) :
    ∃ w : PermMode n → ℝ,
      (∀ σ, 0 ≤ w σ) ∧
      ∑ σ, w σ = 1 ∧
      ∑ σ, w σ • σ.permMatrix ℝ = switchMatrix n β x ∧
      routingEpsilon w label ≤ 1 := by
  rcases exists_perm_decomposition_of_bistochastic (n := n) β x hcol with
    ⟨w, hw_nonneg, hw_sum, hw_matrix⟩
  refine ⟨w, hw_nonneg, hw_sum, hw_matrix, ?_⟩
  exact routingEpsilon_le_one_of_simplex w label hw_nonneg hw_sum

end FromBistochastic

section SinkhornDynamics

variable (n : Nat)

/--
For any doubly-stochastic coupling matrix, there is a Birkhoff mode decomposition
with routing chiral scale bounded by `1`.
-/
theorem exists_routingEpsilon_of_mem_doublyStochastic
    (M : SinkhornMatrix n)
    (hM : M ∈ doublyStochastic ℝ (Fin n))
    (label : PermMode n → CliffordLabel) :
    ∃ w : PermMode n → ℝ,
      (∀ σ, 0 ≤ w σ) ∧
      ∑ σ, w σ = 1 ∧
      ∑ σ, w σ • σ.permMatrix ℝ = M ∧
      routingEpsilon w label ≤ 1 := by
  rcases exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM with
    ⟨w, hw_nonneg, hw_sum, hw_matrix⟩
  refine ⟨w, hw_nonneg, hw_sum, hw_matrix, ?_⟩
  exact routingEpsilon_le_one_of_simplex w label hw_nonneg hw_sum

/--
Chosen Birkhoff decomposition weights for a doubly-stochastic matrix.
-/
noncomputable def sinkhornPermutationWeights
    (M : SinkhornMatrix n)
    (hM : M ∈ doublyStochastic ℝ (Fin n)) : PermMode n → ℝ :=
  Classical.choose (exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM)

lemma sinkhornPermutationWeights_nonneg
    (M : SinkhornMatrix n)
    (hM : M ∈ doublyStochastic ℝ (Fin n)) :
    ∀ σ, 0 ≤ sinkhornPermutationWeights n M hM σ := by
  classical
  exact (Classical.choose_spec (exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM)).1

lemma sinkhornPermutationWeights_sum_one
    (M : SinkhornMatrix n)
    (hM : M ∈ doublyStochastic ℝ (Fin n)) :
    ∑ σ, sinkhornPermutationWeights n M hM σ = 1 := by
  classical
  exact (Classical.choose_spec (exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM)).2.1

lemma sinkhornPermutationWeights_decomposition
    (M : SinkhornMatrix n)
    (hM : M ∈ doublyStochastic ℝ (Fin n)) :
    ∑ σ, sinkhornPermutationWeights n M hM σ • σ.permMatrix ℝ = M := by
  classical
  exact (Classical.choose_spec (exists_eq_sum_perm_of_mem_doublyStochastic (M := M) hM)).2.2

/--
Selected routing chiral scale `ε` for a doubly-stochastic matrix
using the chosen Birkhoff coefficients.
-/
noncomputable def selectedRoutingEpsilon
    (M : SinkhornMatrix n)
    (hM : M ∈ doublyStochastic ℝ (Fin n))
    (label : PermMode n → CliffordLabel) : ℝ :=
  routingEpsilon (sinkhornPermutationWeights n M hM) label

lemma selectedRoutingEpsilon_le_one
    (M : SinkhornMatrix n)
    (hM : M ∈ doublyStochastic ℝ (Fin n))
    (label : PermMode n → CliffordLabel) :
    selectedRoutingEpsilon n M hM label ≤ 1 := by
  unfold selectedRoutingEpsilon
  exact routingEpsilon_le_one_of_simplex
    (sinkhornPermutationWeights n M hM) label
    (sinkhornPermutationWeights_nonneg (n := n) M hM)
    (sinkhornPermutationWeights_sum_one (n := n) M hM)

/--
Sinkhorn trajectory constrained to remain in the Birkhoff polytope at every step.
-/
structure DoublyStochasticSinkhornTrajectory where
  traj : SinkhornTrajectory n
  mem_doublyStochastic : ∀ k : Nat, traj.state k ∈ doublyStochastic ℝ (Fin n)

/--
Per-iteration selected routing chiral scale along a doubly-stochastic Sinkhorn trajectory.
-/
noncomputable def trajectorySelectedRoutingEpsilon
    (T : DoublyStochasticSinkhornTrajectory n) (k : Nat)
    (label : PermMode n → CliffordLabel) : ℝ :=
  selectedRoutingEpsilon n (T.traj.state k) (T.mem_doublyStochastic k) label

lemma trajectorySelectedRoutingEpsilon_le_one
    (T : DoublyStochasticSinkhornTrajectory n) (k : Nat)
    (label : PermMode n → CliffordLabel) :
    trajectorySelectedRoutingEpsilon n T k label ≤ 1 := by
  unfold trajectorySelectedRoutingEpsilon
  exact selectedRoutingEpsilon_le_one (n := n) (M := T.traj.state k)
    (hM := T.mem_doublyStochastic k) label

/--
Combined Sinkhorn dynamic control:
- phase Lyapunov is monotone across the step;
- the selected routing chiral scale on the next iterate is bounded by `1`.
-/
theorem sinkhorn_dynamics_step_control
    (T : DoublyStochasticSinkhornTrajectory n) (k : Nat)
    (label : PermMode n → CliffordLabel) :
    trajectoryLyapunovNext n T.traj k ≤ trajectoryLyapunov n T.traj k ∧
      trajectorySelectedRoutingEpsilon n T (k + 1) label ≤ 1 := by
  refine ⟨trajectoryLyapunov_monotone (n := n) T.traj k, ?_⟩
  exact trajectorySelectedRoutingEpsilon_le_one (n := n) T (k + 1) label

/--
Generator-level Sinkhorn dynamic control:
- phase Radon-Nikodym log-barrier is monotone across the step;
- the selected routing chiral scale on the next iterate is bounded by `1`.
-/
theorem sinkhorn_dynamics_generator_step_control
    (T : DoublyStochasticSinkhornTrajectory n) (k : Nat)
    (label : PermMode n → CliffordLabel) :
    trajectoryRNBarrierNext n T.traj k ≤ trajectoryRNBarrier n T.traj k ∧
      trajectorySelectedRoutingEpsilon n T (k + 1) label ≤ 1 := by
  refine ⟨trajectoryRNBarrier_monotone (n := n) T.traj k, ?_⟩
  exact trajectorySelectedRoutingEpsilon_le_one (n := n) T (k + 1) label

/--
Constructive alternating Sinkhorn iterate from explicit positivity hypotheses.
-/
noncomputable def sinkhornIterate
    (M0 : SinkhornMatrix n)
    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)
    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M) :
    Nat → SinkhornMatrix n
  | 0 => M0
  | k + 1 =>
      let Mk := sinkhornIterate M0 hrow hcol k
      match phaseAt k with
      | .row => rowNormalize n Mk (hrow Mk)
      | .col => colNormalize n Mk (hcol Mk)

lemma sinkhornIterate_step
    (M0 : SinkhornMatrix n)
    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)
    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M)
    (k : Nat) :
    SinkhornStep n (phaseAt k)
      (sinkhornIterate (n := n) M0 hrow hcol k)
      (sinkhornIterate (n := n) M0 hrow hcol (k + 1)) := by
  let Mk := sinkhornIterate (n := n) M0 hrow hcol k
  cases hphase : phaseAt k with
  | row =>
      refine ⟨hrow Mk, ?_⟩
      simp [sinkhornIterate, hphase]
  | col =>
      refine ⟨hcol Mk, ?_⟩
      simp [sinkhornIterate, hphase]

/-- Generated Sinkhorn trajectory from the recursive iterate map. -/
noncomputable def sinkhornIterateTrajectory
    (M0 : SinkhornMatrix n)
    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)
    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M) :
    SinkhornTrajectory n where
  state := sinkhornIterate (n := n) M0 hrow hcol
  step := sinkhornIterate_step (n := n) M0 hrow hcol

/--
Generated doubly-stochastic Sinkhorn trajectory from explicit balancing hypothesis
along the recursive iterate sequence.
-/
noncomputable def sinkhornIterateDoublyStochasticTrajectory
    (M0 : SinkhornMatrix n)
    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)
    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M)
    (hbal : ∀ k : Nat,
      sinkhornIterate (n := n) M0 hrow hcol k ∈ doublyStochastic ℝ (Fin n)) :
    DoublyStochasticSinkhornTrajectory n where
  traj := sinkhornIterateTrajectory (n := n) M0 hrow hcol
  mem_doublyStochastic := hbal

/--
Stepwise control theorem for the constructive iterate generator:
Lyapunov monotonicity and next-step routing chiral bound `ε ≤ 1`.
-/
theorem sinkhornIterate_step_control
    (M0 : SinkhornMatrix n)
    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)
    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M)
    (hbal : ∀ k : Nat,
      sinkhornIterate (n := n) M0 hrow hcol k ∈ doublyStochastic ℝ (Fin n))
    (k : Nat) (label : PermMode n → CliffordLabel) :
    trajectoryLyapunovNext n (sinkhornIterateTrajectory (n := n) M0 hrow hcol) k
      ≤ trajectoryLyapunov n (sinkhornIterateTrajectory (n := n) M0 hrow hcol) k ∧
      trajectorySelectedRoutingEpsilon n
        (sinkhornIterateDoublyStochasticTrajectory (n := n) M0 hrow hcol hbal)
        (k + 1) label ≤ 1 := by
  simpa [sinkhornIterateDoublyStochasticTrajectory, sinkhornIterateTrajectory] using
    (sinkhorn_dynamics_step_control (n := n)
      (T := sinkhornIterateDoublyStochasticTrajectory (n := n) M0 hrow hcol hbal)
      (k := k) (label := label))

/--
Generator-level control theorem for the constructive iterate:
RN-barrier monotonicity plus next-step routing chiral bound `ε ≤ 1`.
-/
theorem sinkhornIterate_generator_step_control
    (M0 : SinkhornMatrix n)
    (hrow : ∀ M : SinkhornMatrix n, HasPositiveRowSums n M)
    (hcol : ∀ M : SinkhornMatrix n, HasPositiveColSums n M)
    (hbal : ∀ k : Nat,
      sinkhornIterate (n := n) M0 hrow hcol k ∈ doublyStochastic ℝ (Fin n))
    (k : Nat) (label : PermMode n → CliffordLabel) :
    trajectoryRNBarrierNext n (sinkhornIterateTrajectory (n := n) M0 hrow hcol) k
      ≤ trajectoryRNBarrier n (sinkhornIterateTrajectory (n := n) M0 hrow hcol) k ∧
      trajectorySelectedRoutingEpsilon n
        (sinkhornIterateDoublyStochasticTrajectory (n := n) M0 hrow hcol hbal)
        (k + 1) label ≤ 1 := by
  simpa [sinkhornIterateDoublyStochasticTrajectory, sinkhornIterateTrajectory] using
    (sinkhorn_dynamics_generator_step_control (n := n)
      (T := sinkhornIterateDoublyStochasticTrajectory (n := n) M0 hrow hcol hbal)
      (k := k) (label := label))

end SinkhornDynamics
