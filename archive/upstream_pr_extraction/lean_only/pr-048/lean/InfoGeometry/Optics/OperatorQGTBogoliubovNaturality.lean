import InfoGeometry.Optics.OperatorQGTSoldering

/-!
# Internal Bogoliubov naturality of operator QGT soldering

An internal endomorphism acts on both causal sheets by the same operator.  This
file proves that its commutator derivation may be applied either to the four
operator coefficients before soldering or to the resulting endomorphism of the
doubled carrier.  The final theorem applies this identity simultaneously to the
symmetric BKM and antisymmetric Berry channels of the operator QGT.
-/

noncomputable section

namespace InfoGeometry.Optics.OperatorQGTBogoliubovNaturality

open InfoGeometry.Optics.OperatorCausalSoldering
open InfoGeometry.OperatorAlgebra
open InfoGeometry.Unified

variable {W : Type*} [AddCommGroup W] [Module ℂ W]

abbrev EndW := Module.End ℂ W
abbrev DoubledEndW := Module.End ℂ (Fin 2 → W)

/-- The inner derivation generated by an internal operator. -/
def internalCommutator (X A : EndW (W := W)) : EndW (W := W) :=
  X * A - A * X

/-- Apply the internal commutator independently to all four causal channels. -/
def internalCommutatorFourVector
    (X : EndW (W := W)) (v : OperatorFourVector W) : OperatorFourVector W :=
  fun i => internalCommutator X (v i)

/-- The same internal operator acting identically on both sheets. -/
def doubledInternalOperator (X : EndW (W := W)) : DoubledEndW (W := W) where
  toFun ψ i := X (ψ i)
  map_add' ψ φ := by
    funext i
    exact X.map_add (ψ i) (φ i)
  map_smul' c ψ := by
    funext i
    exact X.map_smul c (ψ i)

@[simp] theorem doubledInternalOperator_apply
    (X : EndW (W := W)) (ψ : Fin 2 → W) (i : Fin 2) :
    doubledInternalOperator X ψ i = X (ψ i) :=
  rfl

@[simp] theorem doubledInternalOperator_zero :
    doubledInternalOperator (W := W) 0 = 0 := by
  ext ψ i
  rfl

@[simp] theorem doubledInternalOperator_add
    (X Y : EndW (W := W)) :
    doubledInternalOperator (X + Y) =
      doubledInternalOperator X + doubledInternalOperator Y := by
  ext ψ i
  rfl

@[simp] theorem doubledInternalOperator_mul
    (X Y : EndW (W := W)) :
    doubledInternalOperator (X * Y) =
      doubledInternalOperator X * doubledInternalOperator Y := by
  ext ψ i
  rfl

@[simp] theorem doubledInternalOperator_one :
    doubledInternalOperator (W := W) 1 = 1 := by
  ext ψ i
  rfl

/-- An invertible internal frame induces an invertible frame acting identically
on the two sheets. -/
def doubledInternalUnit (u : (EndW (W := W))ˣ) : (DoubledEndW (W := W))ˣ where
  val := doubledInternalOperator (u : EndW (W := W))
  inv := doubledInternalOperator (↑(u⁻¹) : EndW (W := W))
  val_inv := by
    rw [← doubledInternalOperator_mul]
    simp
  inv_val := by
    rw [← doubledInternalOperator_mul]
    simp

@[simp] theorem doubledInternalUnit_val
    (u : (EndW (W := W))ˣ) :
    (doubledInternalUnit u : DoubledEndW (W := W)) =
      doubledInternalOperator (u : EndW (W := W)) :=
  rfl

@[simp] theorem doubledInternalUnit_inv_val
    (u : (EndW (W := W))ˣ) :
    (↑((doubledInternalUnit u)⁻¹) : DoubledEndW (W := W)) =
      doubledInternalOperator (↑(u⁻¹) : EndW (W := W)) :=
  rfl

/-- Left multiplication by an internal operator commutes with causal matrix
reconstruction, entry by entry. -/
theorem operatorSoldering_left_internal
    (X : EndW (W := W)) (v : OperatorFourVector W) :
    (fun i j => X * operatorSoldering v i j) =
      operatorSoldering (fun i => X * v i) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [operatorSoldering_apply, mul_add, mul_sub]

/-- Right multiplication by an internal operator commutes with causal matrix
reconstruction, entry by entry. -/
theorem operatorSoldering_right_internal
    (v : OperatorFourVector W) (X : EndW (W := W)) :
    (fun i j => operatorSoldering v i j * X) =
      operatorSoldering (fun i => v i * X) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [operatorSoldering_apply, add_mul, sub_mul]

/-- Acting internally after soldering equals left multiplication of every
operator coefficient before the doubled-carrier action. -/
theorem doubledInternalOperator_mul_operatorSolderingAction
    (X : EndW (W := W)) (v : OperatorFourVector W) :
    doubledInternalOperator X * operatorSolderingAction v =
      operatorSolderingAction (fun i => X * v i) := by
  apply LinearMap.ext
  intro ψ
  funext i
  change X (∑ j : Fin 2, operatorSoldering v i j (ψ j)) =
    ∑ j : Fin 2, operatorSoldering (fun k => X * v k) i j (ψ j)
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro j _
  change (X * operatorSoldering v i j) (ψ j) = _
  exact congrArg (fun M => M i j (ψ j))
    (operatorSoldering_left_internal X v)

/-- Acting internally before soldering equals right multiplication of every
operator coefficient before the doubled-carrier action. -/
theorem operatorSolderingAction_mul_doubledInternalOperator
    (v : OperatorFourVector W) (X : EndW (W := W)) :
    operatorSolderingAction v * doubledInternalOperator X =
      operatorSolderingAction (fun i => v i * X) := by
  apply LinearMap.ext
  intro ψ
  funext i
  change (∑ j : Fin 2, operatorSoldering v i j (X (ψ j))) =
    ∑ j : Fin 2, operatorSoldering (fun k => v k * X) i j (ψ j)
  apply Finset.sum_congr rfl
  intro j _
  change (operatorSoldering v i j * X) (ψ j) = _
  exact congrArg (fun M => M i j (ψ j))
    (operatorSoldering_right_internal v X)

/-- Infinitesimal internal frame covariance of causal operator soldering. -/
theorem operatorSolderingAction_internalCommutatorFourVector
    (X : EndW (W := W)) (v : OperatorFourVector W) :
    operatorSolderingAction (internalCommutatorFourVector X v) =
      doubledInternalOperator X * operatorSolderingAction v -
        operatorSolderingAction v * doubledInternalOperator X := by
  rw [doubledInternalOperator_mul_operatorSolderingAction,
    operatorSolderingAction_mul_doubledInternalOperator]
  apply LinearMap.ext
  intro ψ
  funext i
  change
    (∑ j : Fin 2,
        operatorSoldering (internalCommutatorFourVector X v) i j (ψ j)) =
      (∑ j : Fin 2, operatorSoldering (fun k => X * v k) i j (ψ j)) -
        ∑ j : Fin 2, operatorSoldering (fun k => v k * X) i j (ψ j)
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro j _
  fin_cases i <;> fin_cases j <;>
    simp [internalCommutatorFourVector, internalCommutator,
      operatorSoldering_apply, sub_eq_add_neg, smul_add,
      add_assoc, add_left_comm, add_comm]

/-! ## Finite internal frame transformations -/

/-- Conjugate every causal operator coefficient by the same invertible
internal frame. -/
def internalConjugateFourVector
    (u : (EndW (W := W))ˣ) (v : OperatorFourVector W) : OperatorFourVector W :=
  fun i => innerConjugation u (v i)

/-- Group-level covariance: coefficientwise internal conjugation becomes
inner conjugation by the induced doubled-sheet frame. -/
theorem operatorSolderingAction_internalConjugateFourVector
    (u : (EndW (W := W))ˣ) (v : OperatorFourVector W) :
    operatorSolderingAction (internalConjugateFourVector u v) =
      innerConjugation (doubledInternalUnit u) (operatorSolderingAction v) := by
  change operatorSolderingAction
      (fun i => (u : EndW (W := W)) * v i *
        (↑(u⁻¹) : EndW (W := W))) =
    doubledInternalOperator (u : EndW (W := W)) *
      operatorSolderingAction v *
        doubledInternalOperator (↑(u⁻¹) : EndW (W := W))
  calc
    operatorSolderingAction
        (fun i => (u : EndW (W := W)) * v i *
          (↑(u⁻¹) : EndW (W := W))) =
      operatorSolderingAction
        (fun i => (u : EndW (W := W)) *
          (v i * (↑(u⁻¹) : EndW (W := W)))) := by
            congr 1
    _ = doubledInternalOperator (u : EndW (W := W)) *
          operatorSolderingAction
            (fun i => v i * (↑(u⁻¹) : EndW (W := W))) := by
          rw [doubledInternalOperator_mul_operatorSolderingAction]
    _ = doubledInternalOperator (u : EndW (W := W)) *
          (operatorSolderingAction v *
            doubledInternalOperator (↑(u⁻¹) : EndW (W := W))) := by
          rw [operatorSolderingAction_mul_doubledInternalOperator]
    _ = doubledInternalOperator (u : EndW (W := W)) *
          operatorSolderingAction v *
            doubledInternalOperator (↑(u⁻¹) : EndW (W := W)) := by
          rw [mul_assoc]

/-- Apply one internal Bogoliubov generator to both QGT channels. -/
def qgtInternalCommutator
    (X : EndW (W := W)) (Q : QGTFourVector W) : QGTFourVector W where
  symmetricBKM := internalCommutatorFourVector X Q.symmetricBKM
  antisymmetricBerry := internalCommutatorFourVector X Q.antisymmetricBerry

/-- Finite internal frame conjugation of both QGT channels. -/
def qgtInternalConjugation
    (u : (EndW (W := W))ˣ) (Q : QGTFourVector W) : QGTFourVector W where
  symmetricBKM := internalConjugateFourVector u Q.symmetricBKM
  antisymmetricBerry := internalConjugateFourVector u Q.antisymmetricBerry

/-- The combined BKM/Berry operator is transported by the same inner
derivation; complex linearity keeps the Berry factor `i` inside the channel. -/
theorem qgtInternalCommutator_totalOperator
    (X : EndW (W := W)) (Q : QGTFourVector W) :
    (qgtInternalCommutator X Q).totalOperator =
      internalCommutatorFourVector X Q.totalOperator := by
  funext i
  simp [qgtInternalCommutator, QGTFourVector.totalOperator,
    internalCommutatorFourVector, internalCommutator,
    mul_add, add_mul, sub_eq_add_neg, smul_add]
  abel

/-- The total BKM/Berry operator transforms by internal conjugation. -/
theorem qgtInternalConjugation_totalOperator
    (u : (EndW (W := W))ˣ) (Q : QGTFourVector W) :
    (qgtInternalConjugation u Q).totalOperator =
      internalConjugateFourVector u Q.totalOperator := by
  funext i
  simp [qgtInternalConjugation, QGTFourVector.totalOperator,
    internalConjugateFourVector, innerConjugation,
    mul_add, add_mul]

/-- The full operator-valued QGT soldering is equivariant for infinitesimal
internal Bogoliubov/frame transport on `W`. -/
theorem QGTSoldering_internalCommutator
    (X : EndW (W := W)) (Q : QGTFourVector W) :
    QGTSoldering (qgtInternalCommutator X Q) =
      doubledInternalOperator X * QGTSoldering Q -
        QGTSoldering Q * doubledInternalOperator X := by
  rw [QGTSoldering, qgtInternalCommutator_totalOperator,
    operatorSolderingAction_internalCommutatorFourVector]
  rfl

/-- The full operator-valued QGT soldering is equivariant for finite internal
Bogoliubov/frame transformations. -/
theorem QGTSoldering_internalConjugation
    (u : (EndW (W := W))ˣ) (Q : QGTFourVector W) :
    QGTSoldering (qgtInternalConjugation u Q) =
      innerConjugation (doubledInternalUnit u) (QGTSoldering Q) := by
  rw [QGTSoldering, qgtInternalConjugation_totalOperator,
    operatorSolderingAction_internalConjugateFourVector]
  rfl

end InfoGeometry.Optics.OperatorQGTBogoliubovNaturality
