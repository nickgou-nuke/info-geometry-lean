import Coxeter.PermutationRepresentation
import InfoGeometry.CoxeterPort.MatrixGroup
import InfoGeometry.CoxeterPort.GeometricReflectionOperators
import InfoGeometry.RootSystem.D4WeylGroup

/-!
# Coxeter presentation acting on the integral D₄ root lattice

The simple reflections in the D₄ lattice owner satisfy the Coxeter relations.
This file packages those relations as a homomorphism from the abstract
Coxeter group into the concrete subgroup generated by the lattice reflections.
-/

namespace InfoGeometry.RootSystem.D4

/-- The D₄ Coxeter matrix derived from the integral root-lattice Cartan
matrix: adjacent simple roots have label three and orthogonal roots label two.
-/
def d4CoxeterMatrix : CoxeterMatrix (Fin 4) where
  M i j := if i = j then 1 else if cartanMatrix i j = -1 then 3 else 2
  isSymm := by
    ext i j
    change (if j = i then 1 else if cartanMatrix j i = -1 then 3 else 2) =
      (if i = j then 1 else if cartanMatrix i j = -1 then 3 else 2)
    have hs : cartanMatrix i j = cartanMatrix j i := by
      simp [cartanMatrix, dot, mul_comm]
    simp [eq_comm, hs]
  diagonal := by
    intro i
    simp
  off_diagonal := by
    intro i j hij
    by_cases hcart : cartanMatrix i j = -1 <;> simp [hij, hcart]

/-- The abstract D₄ simple-root reflections act noncommutatively on their
real geometric root module. -/
theorem d4GeometricReflectionOperatorGroup_exists_noncommuting_pair :
    ∃ x y : InfoGeometry.CoxeterPort.GeometricReflectionOperators.geometricReflectionOperatorGroup
      (W := d4CoxeterMatrix.Group), x * y ≠ y * x := by
  apply InfoGeometry.CoxeterPort.GeometricReflectionOperators.geometricReflectionOperatorGroup_exists_noncommuting_pair
    (W := d4CoxeterMatrix.Group) (i := (0 : Fin 4)) (j := (1 : Fin 4))
  change d4CoxeterMatrix.M (0 : Fin 4) (1 : Fin 4) = 3
  rcases cartanMatrix_adjacent with ⟨h01, _, _⟩
  simp [d4CoxeterMatrix, h01]

/-- The external Coxeter library's permutation action of the abstract D₄
Coxeter group on its signed reflection set. -/
noncomputable abbrev d4AbstractRootPermRep :
    d4CoxeterMatrix.Group →* Equiv.Perm
      (Coxeter.AbstractRootSet d4CoxeterMatrix.Group) :=
  Coxeter.permRep

/-- The abstract D₄ group acts faithfully on its signed reflection set. -/
theorem d4AbstractRootPermRep_injective :
    Function.Injective d4AbstractRootPermRep :=
  Coxeter.permRep_inj

private theorem cube_eq_one_of_involutions_and_braid
    {G : Type*} [Group G] (s t : G)
    (hs : s * s = 1) (ht : t * t = 1)
    (hbraid : s * t * s = t * s * t) : (s * t) ^ 3 = 1 := by
  calc
    (s * t) ^ 3 = s * t * s * t * s * t := by
      rw [pow_succ, pow_succ, pow_one]
      simp only [mul_assoc]
    _ = t * s * t * t * s * t := by rw [hbraid]
    _ = (t * s) * (t * t) * (s * t) := by group
    _ = (t * s) * 1 * (s * t) := by rw [ht]
    _ = t * (s * s) * t := by group
    _ = t * 1 * t := by rw [hs]
    _ = 1 := by simp [ht]

/-- The concrete D₄ lattice reflections satisfy the Coxeter matrix relations. -/
theorem simpleReflectionEquiv_isLiftable :
    d4CoxeterMatrix.IsLiftable simpleReflectionEquiv := by
  intro i j
  by_cases hij : i = j
  · subst j
    simp [d4CoxeterMatrix, simpleReflectionEquiv_square]
  · by_cases hcart : cartanMatrix i j = -1
    · have hlabel : d4CoxeterMatrix i j = 3 := by
        simp [d4CoxeterMatrix, hij, hcart]
      rw [hlabel]
      exact cube_eq_one_of_involutions_and_braid
        (simpleReflectionEquiv i) (simpleReflectionEquiv j)
        (simpleReflectionEquiv_square i) (simpleReflectionEquiv_square j)
        (simpleReflectionEquiv_braid_of_cartan_neg_one i j hcart)
    · have hcart0 : cartanMatrix i j = 0 := by
        rw [cartanMatrix_off_diagonal i j hij] at hcart ⊢
        by_cases hadj : (i = 0 ∧ j = 1) ∨ (i = 1 ∧ j = 0) ∨
            (i = 1 ∧ j = 2) ∨ (i = 2 ∧ j = 1) ∨
            (i = 1 ∧ j = 3) ∨ (i = 3 ∧ j = 1)
        · have : False := hcart (by simp [hadj])
          exact this.elim
        · simp [hadj]
      have hcomm := simpleReflectionEquiv_commute_of_cartan_zero i j hcart0
      have hpow :
          (simpleReflectionEquiv i * simpleReflectionEquiv j) ^ 2 = 1 := calc
        (simpleReflectionEquiv i * simpleReflectionEquiv j) ^ 2 =
            (simpleReflectionEquiv i * simpleReflectionEquiv j) *
              (simpleReflectionEquiv i * simpleReflectionEquiv j) := by rw [pow_two]
        _ = simpleReflectionEquiv i * (simpleReflectionEquiv j *
              simpleReflectionEquiv i) * simpleReflectionEquiv j := by
          simp only [mul_assoc]
        _ = simpleReflectionEquiv i * (simpleReflectionEquiv i *
              simpleReflectionEquiv j) * simpleReflectionEquiv j := by rw [← hcomm]
        _ = (simpleReflectionEquiv i * simpleReflectionEquiv i) *
              (simpleReflectionEquiv j * simpleReflectionEquiv j) := by
          simp only [mul_assoc]
        _ = 1 := by simp [simpleReflectionEquiv_square]
      have hlabel : d4CoxeterMatrix.M i j = 2 := by
        simp [d4CoxeterMatrix, hij, hcart0]
      rw [hlabel]
      exact hpow

/-- The simple lattice reflections, viewed as elements of the generated Weyl
subgroup. -/
noncomputable def d4CoxeterGenerators : Fin 4 → d4WeylGroup := fun i =>
  ⟨simpleReflectionEquiv i, simpleReflectionEquiv_mem_d4WeylGroup i⟩

/-- The subgroup-valued simple generators preserve the D₄ Coxeter relations. -/
theorem d4CoxeterGenerators_isLiftable :
    d4CoxeterMatrix.IsLiftable d4CoxeterGenerators := by
  intro i j
  apply Subtype.ext
  exact simpleReflectionEquiv_isLiftable i j

/-- The abstract D₄ Coxeter group acts on the concrete integral D₄ root
lattice through its generated Weyl subgroup. -/
noncomputable def d4CoxeterToWeyl : d4CoxeterMatrix.Group →* d4WeylGroup :=
  d4CoxeterMatrix.toCoxeterSystem.lift
    ⟨d4CoxeterGenerators, d4CoxeterGenerators_isLiftable⟩

@[simp] theorem d4CoxeterToWeyl_simple (i : Fin 4) :
    d4CoxeterToWeyl (d4CoxeterMatrix.simple i) = d4CoxeterGenerators i := by
  exact CoxeterSystem.lift_apply_simple d4CoxeterMatrix.toCoxeterSystem
    d4CoxeterGenerators_isLiftable i

private noncomputable def d4CoxeterToLatticeAut :
    d4CoxeterMatrix.Group →* (Lattice ≃ Lattice) :=
  d4WeylGroup.subtype.comp d4CoxeterToWeyl

/-- The Coxeter homomorphism is onto the subgroup generated by the four
simple lattice reflections. -/
theorem d4CoxeterToWeyl_surjective : Function.Surjective d4CoxeterToWeyl := by
  have hgen : d4WeylGroup ≤ d4CoxeterToLatticeAut.range := by
    change Subgroup.closure (Set.range simpleReflectionEquiv) ≤
      d4CoxeterToLatticeAut.range
    rw [Subgroup.closure_le]
    rintro g ⟨i, rfl⟩
    change ∃ x, d4CoxeterToLatticeAut x = simpleReflectionEquiv i
    refine ⟨d4CoxeterMatrix.simple i, ?_⟩
    simp [d4CoxeterToLatticeAut, d4CoxeterToWeyl_simple, d4CoxeterGenerators]
  intro w
  obtain ⟨x, hx⟩ := (MonoidHom.mem_range).mp (hgen w.property)
  refine ⟨x, ?_⟩
  apply Subtype.ext
  exact hx

end InfoGeometry.RootSystem.D4
