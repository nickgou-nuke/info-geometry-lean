import Mathlib.Algebra.Algebra.Unitization
import Mathlib.Algebra.FreeNonUnitalNonAssocAlgebra
import Mathlib.Algebra.Ring.Associator
import Mathlib.LinearAlgebra.BilinearForm.Basic
import Mathlib.RingTheory.Congruence.Basic
import Mathlib.RingTheory.Congruence.Hom
import Mathlib.Tactic.LinearCombination
import InfoGeometry.Algebra.UnitizationNonAssoc

/-!
# Kingdon algebras

A native nonassociative quotient construction following Definition 3.1 of
Depies--Smith--Ashburn, *Octonions as Clifford-like algebras*.

The ambient carrier is the unitization of Mathlib's free non-unital
nonassociative algebra.  We quotient by the ring congruence generated by:

* linearity of the insertion of the formed vector space;
* the left and right alternative laws;
* `uv + vu = B u v`;
* collective anti-association `(uv)w = w(vu)` on inserted vectors.

No associativity axiom is imposed.
-/

namespace InfoGeometry.Algebra.Kingdon

universe u v

variable (R : Type u) (V : Type v)
variable [CommRing R] [AddCommGroup V] [Module R V]

/-- The free non-unital nonassociative algebra on the underlying type of `V`. -/
abbrev Free := FreeNonUnitalNonAssocAlgebra R V

/-- The unital free nonassociative ambient ring used for the Kingdon quotient. -/
abbrev Ambient := Unitization R (Free R V)

/-- The canonical copy of a vector in the unitized free nonassociative algebra. -/
noncomputable def ambientGenerator (v : V) : Ambient R V :=
  Unitization.inr (FreeNonUnitalNonAssocAlgebra.of R v)

/-- Generating relations for the Kingdon congruence associated to a bilinear form `B`.

The first three constructors make `ambientGenerator` linear.  The next two impose
alternativity on the entire quotient.  The final two are the Kingdon quadratic and
collective anti-association relations from Definition 3.1 of the source paper.
-/
inductive Relation (B : LinearMap.BilinForm R V) : Ambient R V → Ambient R V → Prop
  | map_zero : Relation B (ambientGenerator R V 0) 0
  | map_add (u v : V) :
      Relation B (ambientGenerator R V (u + v))
        (ambientGenerator R V u + ambientGenerator R V v)
  | map_smul (r : R) (v : V) :
      Relation B (ambientGenerator R V (r • v))
        (Unitization.inl r * ambientGenerator R V v)
  | alternative_left (x y : Ambient R V) : Relation B ((x * x) * y) (x * (x * y))
  | alternative_right (x y : Ambient R V) : Relation B ((y * x) * x) (y * (x * x))
  | quadratic (u v : V) :
      Relation B
        (ambientGenerator R V u * ambientGenerator R V v +
          ambientGenerator R V v * ambientGenerator R V u)
        (Unitization.inl (B u v))
  | antiassociate (u v w : V) :
      Relation B
        ((ambientGenerator R V u * ambientGenerator R V v) * ambientGenerator R V w)
        (ambientGenerator R V w * (ambientGenerator R V v * ambientGenerator R V u))

/-- The smallest additive and multiplicative congruence containing the Kingdon relations. -/
def congruence (B : LinearMap.BilinForm R V) : RingCon (Ambient R V) :=
  ringConGen (Relation R V B)

/-- The Kingdon algebra associated to the bilinear form `B`. -/
abbrev Algebra (B : LinearMap.BilinForm R V) := (congruence R V B).Quotient

namespace Algebra

variable {R V}
variable [CommRing R] [AddCommGroup V] [Module R V]
variable (B : LinearMap.BilinForm R V)

/-- The quotient map from the unital free nonassociative ambient ring. -/
def mk (x : Ambient R V) : Algebra R V B :=
  RingCon.toQuotient x

@[simp] theorem mk_zero : mk B (0 : Ambient R V) = 0 := rfl

@[simp] theorem mk_one : mk B (1 : Ambient R V) = 1 := rfl

@[simp] theorem mk_add (x y : Ambient R V) : mk B (x + y) = mk B x + mk B y := rfl

@[simp] theorem mk_mul (x y : Ambient R V) : mk B (x * y) = mk B x * mk B y := rfl

/-- The canonical insertion of the formed vector space into its Kingdon algebra. -/
noncomputable def ι (v : V) : Algebra R V B :=
  mk B (ambientGenerator R V v)

private theorem relation_sound {x y : Ambient R V} (h : Relation R V B x y) :
    mk B x = mk B y :=
  Quotient.sound (RingConGen.Rel.of x y h)

@[simp] theorem ι_zero : ι B (0 : V) = 0 := by
  exact relation_sound B Relation.map_zero

@[simp] theorem ι_add (u v : V) : ι B (u + v) = ι B u + ι B v := by
  exact relation_sound B (Relation.map_add u v)

@[simp] theorem ι_smul (r : R) (v : V) :
    ι B (r • v) = mk B (Unitization.inl r) * ι B v := by
  exact relation_sound B (Relation.map_smul r v)

/-- Scalar action induced by the central coefficient copy in the unitization. -/
noncomputable instance : SMul R (Algebra R V B) where
  smul r x := mk B (Unitization.inl r) * x

/-- The Kingdon quotient inherits its coefficient module structure from the
unitized free algebra, without assuming associativity. -/
noncomputable instance : Module R (Algebra R V B) where
  one_smul x := by
    refine Quotient.inductionOn x ?_
    intro x
    apply congrArg (mk B)
    rcases x with ⟨s, a⟩
    ext <;> simp
  mul_smul r s x := by
    refine Quotient.inductionOn x ?_
    intro x
    apply congrArg (mk B)
    rcases x with ⟨t, a⟩
    ext <;> simp [mul_assoc]
  smul_add r x y := mul_add _ _ _
  add_smul r s x := by
    change mk B (Unitization.inl (r + s)) * x =
      mk B (Unitization.inl r) * x + mk B (Unitization.inl s) * x
    rw [Unitization.inl_add, mk_add, add_mul]
  zero_smul x := by
    change mk B (Unitization.inl 0) * x = 0
    rw [Unitization.inl_zero, mk_zero, zero_mul]
  smul_zero r := by
    change mk B (Unitization.inl r) * 0 = 0
    rw [mul_zero]

/-- Coefficient scalars associate through Kingdon multiplication. -/
noncomputable instance : IsScalarTower R (Algebra R V B) (Algebra R V B) where
  smul_assoc r x y := by
    refine Quotient.inductionOn₂ x y ?_
    intro x y
    apply congrArg (mk B)
    rcases x with ⟨sx, x⟩
    rcases y with ⟨sy, y⟩
    ext <;> simp [mul_add, add_mul, smul_add, smul_mul_assoc, mul_smul_comm] <;> ring

/-- Coefficient scalars commute across the two inputs of Kingdon multiplication. -/
noncomputable instance : SMulCommClass R (Algebra R V B) (Algebra R V B) where
  smul_comm r x y := by
    refine Quotient.inductionOn₂ x y ?_
    intro x y
    apply congrArg (mk B)
    rcases x with ⟨sx, x⟩
    rcases y with ⟨sy, y⟩
    ext <;> simp [mul_add, add_mul, smul_add, mul_comm,
      smul_mul_assoc, mul_smul_comm] <;> ring

/-- The embedded coefficient ring acts by the quotient's native scalar action. -/
theorem scalar_mul (r : R) (x : Algebra R V B) :
    mk B (Unitization.inl r) * x = r • x := rfl

/-- Embedded coefficients are central in the Kingdon quotient. -/
theorem mul_scalar (r : R) (x : Algebra R V B) :
    x * mk B (Unitization.inl r) = r • x := by
  refine Quotient.inductionOn x ?_
  intro x
  apply congrArg (mk B)
  rcases x with ⟨s, a⟩
  ext <;> simp [mul_comm]

/-- The canonical formed-space insertion as a genuine linear map. -/
noncomputable def ιLinear : V →ₗ[R] Algebra R V B where
  toFun := ι B
  map_add' := ι_add B
  map_smul' r v := by
    change ι B (r • v) = mk B (Unitization.inl r) * ι B v
    exact ι_smul B r v

/-- The left alternative law holds natively in the Kingdon quotient. -/
theorem alternative_left (x y : Algebra R V B) : (x * x) * y = x * (x * y) := by
  refine Quotient.inductionOn₂ x y ?_
  intro a b
  exact relation_sound B (Relation.alternative_left a b)

/-- The right alternative law holds natively in the Kingdon quotient. -/
theorem alternative_right (x y : Algebra R V B) : (y * x) * x = y * (x * x) := by
  refine Quotient.inductionOn₂ x y ?_
  intro a b
  exact relation_sound B (Relation.alternative_right a b)

/-- Polarization of left alternativity. -/
theorem alternative_left_linearized (x y z : Algebra R V B) :
    (x * y) * z + (y * x) * z = x * (y * z) + y * (x * z) := by
  have h := alternative_left B (x + y) z
  simp only [add_mul, mul_add] at h
  rw [alternative_left B x z, alternative_left B y z] at h
  have h' :
      (x * (x * z) + y * (y * z)) + ((x * y) * z + (y * x) * z) =
        (x * (x * z) + y * (y * z)) + (x * (y * z) + y * (x * z)) := by
    simpa only [add_assoc, add_left_comm, add_comm] using h
  exact add_left_cancel h'

/-- Polarization of right alternativity. -/
theorem alternative_right_linearized (x y z : Algebra R V B) :
    (z * x) * y + (z * y) * x = z * (x * y) + z * (y * x) := by
  have h := alternative_right B (x + y) z
  simp only [add_mul, mul_add] at h
  rw [alternative_right B x z, alternative_right B y z] at h
  have h' :
      (z * (x * x) + z * (y * y)) + ((z * x) * y + (z * y) * x) =
        (z * (x * x) + z * (y * y)) + (z * (x * y) + z * (y * x)) := by
    simpa only [add_assoc, add_left_comm, add_comm] using h
  exact add_left_cancel h'

theorem flexible (x y : Algebra R V B) : (x * y) * x = x * (y * x) := by
  have h := alternative_left_linearized B x y x
  rw [alternative_right B x y] at h
  exact add_right_cancel h

theorem associator_swap12 (x y z : Algebra R V B) :
    (x * y) * z - x * (y * z) = -((y * x) * z - y * (x * z)) := by
  rw [eq_neg_iff_add_eq_zero, sub_add_sub_comm, sub_eq_zero]
  simpa only [add_comm] using alternative_left_linearized B x y z

theorem associator_swap23 (x y z : Algebra R V B) :
    (x * y) * z - x * (y * z) = -((x * z) * y - x * (z * y)) := by
  rw [eq_neg_iff_add_eq_zero, sub_add_sub_comm, sub_eq_zero]
  exact alternative_right_linearized B y z x

/-- The native Mathlib associator is alternating in its first two arguments. -/
theorem associator_swap12_native (x y z : Algebra R V B) :
    associator x y z = -associator y x z := by
  simpa only [associator_apply] using associator_swap12 B x y z

/-- The native Mathlib associator is alternating in its final two arguments. -/
theorem associator_swap23_native (x y z : Algebra R V B) :
    associator x y z = -associator x z y := by
  simpa only [associator_apply] using associator_swap23 B x y z

@[simp] theorem associator_self_left (x z : Algebra R V B) : associator x x z = 0 := by
  rw [associator_apply, sub_eq_zero]
  exact alternative_left B x z

@[simp] theorem associator_self_right (x z : Algebra R V B) : associator z x x = 0 := by
  rw [associator_apply, sub_eq_zero]
  exact alternative_right B x z

@[simp] theorem associator_outer_self (x y : Algebra R V B) : associator x y x = 0 := by
  rw [associator_apply, sub_eq_zero]
  exact flexible B x y

/-- Mathlib's native Teichmüller identity specialized to the Kingdon quotient. -/
theorem associator_teichmueller (a b c d : Algebra R V B) :
    a * associator b c d - associator (a * b) c d + associator a (b * c) d
      - associator a b (c * d) + associator a b c * d = 0 :=
  associator_cocycle a b c d

/-- Rost's right-repeated associator identity in an alternative Kingdon algebra. -/
theorem associator_mul_right_self (x y t : Algebra R V B) :
    associator x (y * x) t = x * associator x y t := by
  have h₁ := associator_teichmueller B x y x t
  have h₂ := associator_teichmueller B x x y t
  have h₃ := associator_teichmueller B x x t y
  have h :
      (x * associator y x t - associator (x * y) x t + associator x (y * x) t
          - associator x y (x * t) + associator x y x * t)
        - (x * associator x y t - associator (x * x) y t + associator x (x * y) t
          - associator x x (y * t) + associator x x y * t)
        - (x * associator x t y - associator (x * x) t y + associator x (x * t) y
          - associator x x (t * y) + associator x x t * y) = 0 := by
    rw [h₁, h₂, h₃]
    abel
  rw [associator_swap12_native B y x t,
    associator_swap23_native B x t y,
    associator_swap12_native B (x * y) x t,
    associator_swap23_native B x y (x * t),
    associator_swap23_native B (x * x) t y] at h
  simp only [associator_outer_self, associator_self_left, zero_mul] at h
  rw [← sub_eq_zero]
  linear_combination (norm := abel) h

/-- Rost's left-repeated associator identity in an alternative Kingdon algebra. -/
theorem associator_mul_left_self (x y z : Algebra R V B) :
    associator x (y * z) y = associator x z y * y := by
  have h₁ := associator_teichmueller B x y z y
  have h₂ := associator_teichmueller B z x y y
  have h₃ := associator_teichmueller B x z y y
  have h :
      (x * associator y z y - associator (x * y) z y + associator x (y * z) y
          - associator x y (z * y) + associator x y z * y)
        - (z * associator x y y - associator (z * x) y y + associator z (x * y) y
          - associator z x (y * y) + associator z x y * y)
        - (x * associator z y y - associator (x * z) y y + associator x (z * y) y
          - associator x z (y * y) + associator x z y * y) = 0 := by
    rw [h₁, h₂, h₃]
    abel
  simp only [associator_self_right, associator_outer_self, zero_mul, mul_zero] at h
  rw [associator_swap12_native B z (x * y) y,
    associator_swap23_native B x (z * y) y,
    associator_swap12_native B x z (y * y),
    associator_swap12_native B z x y,
    associator_swap23_native B x z y] at h
  have hneg (a : Algebra R V B) : (-a) * y = -(a * y) := by
    apply eq_neg_of_add_eq_zero_left
    rw [← add_mul, neg_add_cancel, zero_mul]
  rw [associator_swap23_native B x z y, hneg]
  rw [← sub_eq_zero]
  rw [hneg, hneg] at h
  simp only [neg_one_smul, neg_neg] at h
  abel_nf at h ⊢
  exact h

/-- The right Moufang identity in Rost's parenthesized orientation. -/
theorem right_moufang (x y z : Algebra R V B) :
    x * ((y * z) * y) = ((x * y) * z) * y := by
  have h := associator_mul_left_self B x y z
  have hswap := associator_swap23_native B x z y
  have hneg (a : Algebra R V B) : (-a) * y = -(a * y) := by
    apply eq_neg_of_add_eq_zero_left
    rw [← add_mul, neg_add_cancel, zero_mul]
  rw [hswap, hneg] at h
  simp only [associator_apply] at h
  rw [sub_mul] at h
  abel_nf at h
  have h' :
      x * (y * z) * y + -(x * (y * z * y)) =
        x * (y * z) * y + -(x * y * z * y) := by
    simpa only [neg_one_smul] using h
  exact neg_injective (add_left_cancel h')

/-- The left Moufang identity in the alternative Kingdon algebra. -/
theorem left_moufang (x y t : Algebra R V B) :
    ((x * y) * x) * t = x * (y * (x * t)) := by
  have hmain := associator_mul_right_self B x y t
  have hswap := associator_swap12_native B y x t
  have hneg (a : Algebra R V B) : x * (-a) = -(x * a) := by
    apply eq_neg_of_add_eq_zero_left
    rw [← mul_add, neg_add_cancel, mul_zero]
  have hzero : associator x (y * x) t + x * associator y x t = 0 := by
    rw [hmain, hswap, hneg, add_neg_cancel]
  simp only [associator_apply] at hzero
  rw [mul_sub] at hzero
  rw [flexible B x y]
  linear_combination (norm := abel) hzero

/-- The middle Moufang identity in the alternative Kingdon algebra. -/
theorem middle_moufang (x y z : Algebra R V B) :
    (x * y) * (z * x) = x * ((y * z) * x) := by
  have hright := associator_mul_right_self B x z y
  have hneg (a : Algebra R V B) : -(x * a) = x * (-a) := by
    symm
    apply eq_neg_of_add_eq_zero_left
    rw [← mul_add, neg_add_cancel, mul_zero]
  have hcyclic : associator y z x = associator x y z := by
    calc
      associator y z x = -associator z y x := associator_swap12_native B y z x
      _ = associator z x y := by
        rw [associator_swap23_native B z y x]
        simp
      _ = -associator x z y := associator_swap12_native B z x y
      _ = associator x y z := by
        rw [associator_swap23_native B x z y]
        simp
  have h : associator x y (z * x) = x * associator y z x := by
    calc
      associator x y (z * x) = -associator x (z * x) y :=
        associator_swap23_native B x y (z * x)
      _ = -(x * associator x z y) := by rw [hright]
      _ = x * (-associator x z y) := hneg (associator x z y)
      _ = x * associator y z x := by
        rw [hcyclic, associator_swap23_native B x z y]
        congr 1
        abel
  simp only [associator_apply] at h
  rw [mul_sub] at h
  linear_combination (norm := abel) h

/-- The inserted generators satisfy the Kingdon quadratic relation. -/
theorem quadratic (u v : V) :
    ι B u * ι B v + ι B v * ι B u = mk B (Unitization.inl (B u v)) := by
  exact relation_sound B (Relation.quadratic u v)

/-- Inserted vectors collectively anti-associate in the Kingdon sense. -/
theorem antiassociate (u v w : V) :
    (ι B u * ι B v) * ι B w = ι B w * (ι B v * ι B u) := by
  exact relation_sound B (Relation.antiassociate u v w)

section UniversalProperty

variable {A : Type*} [NonAssocRing A]

/-- The nonassociative unitization lift of a linear generator map.

Unlike Mathlib's `Unitization.lift`, this construction does not assume that the target
multiplication is associative. -/
noncomputable def ambientLift [Module R A] [IsScalarTower R A A] [SMulCommClass R A A]
    (θ : V →ₗ[R] A) : Ambient R V →+* A :=
  Unitization.liftNonAssoc (R := R) (N := Free R V) (A := A)
    (FreeNonUnitalNonAssocAlgebra.lift R θ)

/-- The ambient lift sends a canonical free generator to the prescribed linear map. -/
@[simp] theorem ambientLift_generator [Module R A] [IsScalarTower R A A]
    [SMulCommClass R A A] (θ : V →ₗ[R] A) (v : V) :
    ambientLift θ (ambientGenerator R V v) = θ v := by
  simpa [ambientLift, ambientGenerator] using
    (Unitization.liftNonAssoc_inr (R := R) (N := Free R V) (A := A)
      (FreeNonUnitalNonAssocAlgebra.lift R θ) (FreeNonUnitalNonAssocAlgebra.of R v))

/-- An ambient homomorphism respects the Kingdon presentation when it identifies every
generating relation. -/
def Respects (f : Ambient R V →+* A) : Prop :=
  ∀ ⦃x y⦄, Relation R V B x y → f x = f y

/-- The ambient lift respects the Kingdon presentation when the target is alternative and the
prescribed generators satisfy the two Kingdon identities. -/
theorem ambientLift_respects [Module R A] [IsScalarTower R A A] [SMulCommClass R A A]
    (θ : V →ₗ[R] A)
    (hleft : ∀ x y : A, (x * x) * y = x * (x * y))
    (hright : ∀ x y : A, (y * x) * x = y * (x * x))
    (hquad : ∀ u v : V, θ u * θ v + θ v * θ u = B u v • (1 : A))
    (hanti : ∀ u v w : V, (θ u * θ v) * θ w = θ w * (θ v * θ u)) :
    Respects B (ambientLift θ) := by
  intro x y hxy
  cases hxy with
  | map_zero => simp
  | map_add u v => simp
  | map_smul r v =>
      simp [ambientLift, ambientGenerator]
  | alternative_left x y =>
      simpa only [map_mul] using hleft (ambientLift θ x) (ambientLift θ y)
  | alternative_right x y =>
      simpa only [map_mul] using hright (ambientLift θ x) (ambientLift θ y)
  | quadratic u v =>
      simpa [ambientLift, ambientGenerator] using hquad u v
  | antiassociate u v w =>
      simpa only [map_mul, ambientLift_generator] using hanti u v w

/-- A relation-respecting ambient homomorphism kills the generated Kingdon congruence. -/
theorem congruence_le_ker (f : Ambient R V →+* A) (hf : Respects B f) :
    congruence R V B ≤ RingCon.ker f := by
  apply RingCon.ringConGen_le
  intro x y hxy
  exact (RingCon.ker_apply f).2 (hf hxy)

/-- The homomorphism from the Kingdon quotient induced by a relation-respecting ambient map. -/
def lift (f : Ambient R V →+* A) (hf : Respects B f) : Algebra R V B →+* A :=
  (congruence R V B).lift f (congruence_le_ker B f hf)

/-- The Kingdon homomorphism induced by a linear map satisfying the target identities. -/
noncomputable def liftOfLinear [Module R A] [IsScalarTower R A A] [SMulCommClass R A A]
    (θ : V →ₗ[R] A)
    (hleft : ∀ x y : A, (x * x) * y = x * (x * y))
    (hright : ∀ x y : A, (y * x) * x = y * (x * x))
    (hquad : ∀ u v : V, θ u * θ v + θ v * θ u = B u v • (1 : A))
    (hanti : ∀ u v w : V, (θ u * θ v) * θ w = θ w * (θ v * θ u)) :
    Algebra R V B →+* A :=
  lift B (ambientLift θ) (ambientLift_respects B θ hleft hright hquad hanti)

/-- The induced Kingdon homomorphism extends the prescribed generator map. -/
@[simp] theorem liftOfLinear_ι [Module R A] [IsScalarTower R A A] [SMulCommClass R A A]
    (θ : V →ₗ[R] A)
    (hleft : ∀ x y : A, (x * x) * y = x * (x * y))
    (hright : ∀ x y : A, (y * x) * x = y * (x * x))
    (hquad : ∀ u v : V, θ u * θ v + θ v * θ u = B u v • (1 : A))
    (hanti : ∀ u v w : V, (θ u * θ v) * θ w = θ w * (θ v * θ u))
    (v : V) :
    liftOfLinear B θ hleft hright hquad hanti (ι B v) = θ v := by
  change ambientLift θ (ambientGenerator R V v) = θ v
  exact ambientLift_generator θ v

/-- The quotient lift agrees with the original map on every ambient representative. -/
@[simp] theorem lift_mk (f : Ambient R V →+* A) (hf : Respects B f)
    (x : Ambient R V) : lift B f hf (mk B x) = f x :=
  rfl

/-- Uniqueness in the universal property of the presented Kingdon quotient. -/
theorem lift_unique (f : Ambient R V →+* A) (hf : Respects B f)
    (g : Algebra R V B →+* A) (hg : ∀ x, g (mk B x) = f x) :
    g = lift B f hf := by
  apply RingCon.lift_unique (congruence_le_ker B f hf)
  ext x
  exact hg x

/-- The paper-facing uniqueness theorem: a scalar-preserving homomorphism out of the Kingdon
algebra is determined by its values on the inserted formed vector space. -/
theorem liftOfLinear_unique [Module R A] [IsScalarTower R A A] [SMulCommClass R A A]
    (θ : V →ₗ[R] A)
    (hleft : ∀ x y : A, (x * x) * y = x * (x * y))
    (hright : ∀ x y : A, (y * x) * x = y * (x * x))
    (hquad : ∀ u v : V, θ u * θ v + θ v * θ u = B u v • (1 : A))
    (hanti : ∀ u v w : V, (θ u * θ v) * θ w = θ w * (θ v * θ u))
    (g : Algebra R V B →+* A)
    (hg_scalar : ∀ r : R, g (mk B (Unitization.inl r)) = r • (1 : A))
    (hg_ι : ∀ v : V, g (ι B v) = θ v) :
    g = liftOfLinear B θ hleft hright hquad hanti := by
  let freeMap : Free R V →ₙₐ[R] A :=
    { toFun := fun a => g (mk B (Unitization.inr a))
      map_zero' := by
        simp
      map_add' := by
        intro a b
        rw [Unitization.inr_add]
        simp
      map_mul' := by
        intro a b
        rw [Unitization.inr_mul]
        simp
      map_smul' := by
        intro r a
        change g (mk B (Unitization.inr (r • a))) =
          r • g (mk B (Unitization.inr a))
        rw [← Unitization.inl_mul_inr]
        change g (mk B (Unitization.inl r) * mk B (Unitization.inr a)) = _
        rw [map_mul, hg_scalar]
        exact smul_one_mul r _ }
  have hfree : freeMap = FreeNonUnitalNonAssocAlgebra.lift R θ := by
    apply FreeNonUnitalNonAssocAlgebra.hom_ext
    intro v
    dsimp [freeMap]
    rw [FreeNonUnitalNonAssocAlgebra.lift_of_apply]
    simpa [ι, ambientGenerator] using hg_ι v
  apply lift_unique B (ambientLift θ)
    (ambientLift_respects B θ hleft hright hquad hanti)
  intro x
  rcases x with ⟨r, a⟩
  change g (mk B (r, a)) =
    r • (1 : A) + (FreeNonUnitalNonAssocAlgebra.lift R θ) a
  conv_lhs => rw [← Unitization.inl_fst_add_inr_snd_eq (r, a)]
  rw [mk_add, map_add, hg_scalar]
  change r • (1 : A) + freeMap a = _
  rw [hfree]

end UniversalProperty

end Algebra

end InfoGeometry.Algebra.Kingdon
