import InfoGeometry.Canonical.KMSSinkhornBridge

/-!
# InfoGeometry.Canonical.YangMillsContinuum

Continuum-facing modular/inference bridge interfaces built on the canonical
Krein and IB layers.

This module formalizes:
- modular operator as a Radon-Nikodym-style relative density,
- modular Hamiltonian as negative logarithmic relative density,
- real-parameter modular automorphism flow,
- sampled IB-to-modular KMS bridge theorems.
-/

namespace InfoGeometry.Canonical.YangMillsContinuum

open InfoGeometry.Canonical.KMSSinkhornBridge
open InfoGeometry.Canonical.IB

/-- Doubled-space endomorphisms used in the continuum Yang-Mills bridge. -/
abbrev EndH (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] : Type _ :=
  AlgebraEnd (E := E)

/-- Identity endomorphism on doubled space. -/
noncomputable def idEndH
    (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] :
    EndH E :=
  ContinuousLinearMap.id ℝ (InfoGeometry.Krein.DoubledSpace E)

/--
Modular Radon-Nikodym data:
- `rnDerivative` represents `dμ/dν`,
- `modularOperator` is identified with this relative density,
- `modularHamiltonian` is identified with `-log(dμ/dν)`.
-/
structure ModularRadonNikodymData
    (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] where
  rnDerivative : ℝ
  rnDerivative_pos : 0 < rnDerivative
  modularOperator : EndH E
  modularOperator_eq_rn :
    modularOperator = rnDerivative • idEndH E
  modularHamiltonian : EndH E
  modularHamiltonian_eq_neg_log_rn :
    modularHamiltonian = (-Real.log rnDerivative) • idEndH E

namespace ModularRadonNikodymData

variable {E : Type}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

noncomputable local instance : NormedRing (EndH E) := inferInstance
noncomputable local instance : NormedAlgebra ℝ (EndH E) := inferInstance
local instance : IsTopologicalRing (EndH E) := inferInstance
local instance : CompleteSpace (EndH E) := inferInstance

@[simp] lemma modularOperator_apply
    (M : ModularRadonNikodymData E)
    (v : InfoGeometry.Krein.DoubledSpace E) :
    M.modularOperator v = M.rnDerivative • v := by
  simpa [idEndH] using congrArg (fun A : EndH E => A v) M.modularOperator_eq_rn

@[simp] lemma modularHamiltonian_apply
    (M : ModularRadonNikodymData E)
    (v : InfoGeometry.Krein.DoubledSpace E) :
    M.modularHamiltonian v = (-Real.log M.rnDerivative) • v := by
  simpa [idEndH] using
    congrArg (fun A : EndH E => A v) M.modularHamiltonian_eq_neg_log_rn

/--
Real-parameter modular automorphism group generated by the modular Hamiltonian.
-/
noncomputable def modularAutomorphismGroup
    (M : ModularRadonNikodymData E) :
    ℝ → EndH E → EndH E :=
  fun t A => modularShift (E := E) M.modularHamiltonian t A

@[simp] lemma modularAutomorphismGroup_zero
    (M : ModularRadonNikodymData E)
    (A : EndH E) :
    modularAutomorphismGroup M 0 A = A := by
  simp [modularAutomorphismGroup, modularShift, InfoGeometry.Krein.modular_shift]

/--
Flow law interface for additive-time modular automorphisms.
This is the continuum group-law contract for `σ_{s+t} = σ_s ∘ σ_t`.
-/
structure AutomorphismFlowLaw (M : ModularRadonNikodymData E) : Prop where
  add :
    ∀ s t : ℝ, ∀ A : EndH E,
      modularAutomorphismGroup M (s + t) A =
        modularAutomorphismGroup M s (modularAutomorphismGroup M t A)

end ModularRadonNikodymData

/--
Sampled IB trajectory carrying a discrete-time inference flow together with a
real-time sampling map.
-/
structure IBSampledFlow
    {Xib Yib Tib : Type}
    [Fintype Xib] [Fintype Yib] [Fintype Tib]
    [MeasurableSpace Xib] [MeasurableSingletonClass Xib]
    [MeasurableSpace Yib] [MeasurableSingletonClass Yib]
    [MeasurableSpace Tib] [MeasurableSingletonClass Tib]
    (prob : IBProblem (X := Xib) (Y := Yib)) where
  pTrajectory : Nat → Xib → FinProb Tib
  step :
    ∀ k : Nat, pTrajectory (k + 1) = ibBlahutArimotoStep prob (pTrajectory k)
  sampleTime : Nat → ℝ

namespace IBSampledFlow

variable {E : Type}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {n : Nat}
variable {Xib Yib Tib : Type}
variable [Fintype Xib] [Fintype Yib] [Fintype Tib]
variable [MeasurableSpace Xib] [MeasurableSingletonClass Xib]
variable [MeasurableSpace Yib] [MeasurableSingletonClass Yib]
variable [MeasurableSpace Tib] [MeasurableSingletonClass Tib]
variable {prob : IBProblem (X := Xib) (Y := Yib)}

/-- Canonical weighted observable sampled from an IB trajectory. -/
noncomputable def sampledObservable
    (S : IBSampledFlow (Xib := Xib) (Yib := Yib) (Tib := Tib) (prob := prob))
    (x0 : Xib) (t0 : Tib)
    (Ω : InfoGeometry.Krein.DoubledSpace E) :
    Nat → EndH E →L[ℝ] ℝ :=
  ibInducedObservableWeighted
    (F := E) (Xib := Xib) (Yib := Yib) (Tib := Tib)
    S.pTrajectory x0 t0 (omegaSeed (F := E) Ω)

/--
Sampled IB dynamics induce Sinkhorn-KMS control for the weighted expectation
observable.
-/
theorem sinkhornControl_of_sampledIB
    (T : InfoGeometry.Canonical.MoE.SinkhornTrajectory n)
    (K : EndH E)
    (β : ℝ)
    (S : IBSampledFlow (Xib := Xib) (Yib := Yib) (Tib := Tib) (prob := prob))
    (x0 : Xib) (t0 : Tib)
    (Ω : InfoGeometry.Krein.DoubledSpace E)
    (hΩ : Ω ≠ 0)
    (hStruct : ExpectationSeedKMSHypotheses (F := E) K β Ω) :
    SinkhornKMSControl n T K
      (sampledObservable (prob := prob) S x0 t0 Ω) β := by
  simpa [sampledObservable] using
    (sinkhorn_kmsControl_of_ibDynamics_weighted_from_expectationSeed
      (n := n) (T := T) (K := K) (β := β)
      (prob := prob) (pTrajectory := S.pTrajectory)
      (hStep := S.step) (x0 := x0) (t0 := t0)
      (Ω := Ω) hΩ hStruct)

/--
Sampled IB dynamics induce exact stepwise KMS closure.
-/
theorem sinkhornClosure_of_sampledIB
    (T : InfoGeometry.Canonical.MoE.SinkhornTrajectory n)
    (K : EndH E)
    (β : ℝ)
    (S : IBSampledFlow (Xib := Xib) (Yib := Yib) (Tib := Tib) (prob := prob))
    (x0 : Xib) (t0 : Tib)
    (Ω : InfoGeometry.Krein.DoubledSpace E)
    (hΩ : Ω ≠ 0)
    (hStruct : ExpectationSeedKMSHypotheses (F := E) K β Ω) :
    SinkhornKMSClosure n T K
      (sampledObservable (prob := prob) S x0 t0 Ω) β := by
  exact sinkhorn_step_kmsClosure_of_control
    (n := n) (T := T) (K := K)
    (ω := sampledObservable (prob := prob) S x0 t0 Ω)
    (β := β)
    (sinkhornControl_of_sampledIB
      (n := n) (prob := prob)
      (T := T) (K := K) (β := β) (S := S)
      (x0 := x0) (t0 := t0) (Ω := Ω) hΩ hStruct)

end IBSampledFlow

end InfoGeometry.Canonical.YangMillsContinuum
