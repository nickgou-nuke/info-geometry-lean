import InfoGeometry.Canonical.ProjectorEquivariance
import InfoGeometry.Krein.KreinSpace
import Mathlib.Analysis.SpecialFunctions.Exp

open scoped InnerProductSpace

/-!
# InfoGeometry.Dynamics.UnruhKMS

The Thermalization of the Vacuum via Hyperbolic Rotation.

This module proves that the Bogoliubov/Chiral boost acts as the modular flow, 
generating the KMS (Kubo-Martin-Schwinger) thermal state for the Rindler wedge.
The "Temperature" is not an external bath; it is the geometric necessity of 
the Hestenes boost acting on the split vacuum.

- `modularHamiltonian`: The generator of the thermal state.
- `unruhFlow`: The continuous hyperbolic evolution.
- `unruhFlow_is_modular_flow`: The exact equivalence of the boost and thermal time.
-/

namespace InfoGeometry.Dynamics

open InfoGeometry.Krein
open InfoGeometry.Canonical.ProjectorEquivariance

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

/--
Elliptic phase generator on the doubled carrier: `K = J ∘ ε`.
-/
noncomputable def phaseGenerator : EndH :=
  HestenesI (E := E)

/--
Hyperbolic boost generator on the doubled carrier: `B = ε`.

This generator has square `+Id` and is the correct owner for
`cosh/sinh` boost flow.
-/
noncomputable def boostGenerator : EndH :=
  spectral_epsilon (E := E)

/--
Modular Hamiltonian on the Unruh/Rindler (hyperbolic) lane.

Convention fix: this owner follows the boost convention (`B² = Id`), while the
phase axis remains `phaseGenerator = J ∘ ε` (elliptic, `K² = -Id`).
-/
noncomputable def modularHamiltonian : DoubledSpace E →L[ℝ] DoubledSpace E :=
  boostGenerator (E := E)

/-- Hyperbolic convention owner law: `modularHamiltonian^2 = Id`. -/
@[simp] theorem modularHamiltonian_sq_one :
    (modularHamiltonian (E := E) : EndH) * modularHamiltonian (E := E) = (1 : EndH) := by
  change (spectral_epsilon (E := E)).comp (spectral_epsilon (E := E))
      = (ContinuousLinearMap.id ℝ H₂)
  simpa using spectral_epsilon_involution (E := E)

/-- Elliptic/hyperbolic bridge: `K = J ∘ B`. -/
@[simp] theorem phaseGenerator_eq_modular_j_comp_boostGenerator :
    phaseGenerator (E := E)
      = (modular_j (E := E)).comp (boostGenerator (E := E)) := by
  rfl

/-- Elliptic/hyperbolic bridge (inverse direction): `B = J ∘ K`. -/
@[simp] theorem boostGenerator_eq_modular_j_comp_phaseGenerator :
    boostGenerator (E := E)
      = (modular_j (E := E)).comp (phaseGenerator (E := E)) := by
  simpa [phaseGenerator, boostGenerator, HestenesI, complex_i] using
    (modular_j_comp_complex_i (E := E))

/--
**The Unruh-Rindler Flow**
The thermal time evolution at rapidity θ.
This is the hyperbolic boost flow generated by `modularHamiltonian`.
-/
noncomputable def unruhFlow (θ : ℝ) : DoubledSpace E →L[ℝ] DoubledSpace E :=
  (Real.cosh θ) • ContinuousLinearMap.id ℝ H₂
    + (Real.sinh θ) • modularHamiltonian (E := E)

/--
**Theorem: The Unruh Flow is the Modular Flow**
AUTHORITY: PAULI AUDITOR
This algebraically forces the thermalization of the vacuum. 
The Bogoliubov squeeze generated by the hyperbolic boost axis `ε` is the exact
mathematical definition of a thermal state (KMS condition) relative 
to the split observer.
-/
@[simp]
theorem unruhFlow_is_modular_flow (θ : ℝ) :
    unruhFlow (E := E) θ = 
      (Real.cosh θ) • ContinuousLinearMap.id ℝ (DoubledSpace E) + 
      (Real.sinh θ) • modularHamiltonian (E := E) := 
  rfl

end InfoGeometry.Dynamics
