import InfoGeometry.Clifford.CockleCoquaternionPlanarTriad
import InfoGeometry.Clifford.Cl11Matrix
import InfoGeometry.Clifford.Cl11GeometricSynthesis
import InfoGeometry.Clifford.SplitQ11CausalCone
import InfoGeometry.Clifford.Cl11GeometricBiquaternionBridge

/-!
# Source-grounded finite archetype poset for the Cl(1,1) stream

This candidate collects structures with declarations in the imported owners.
Its order is the reflexive-transitive path relation generated by explicitly
typed prerequisite edges. It does not assert a Clifford classification for the
pair carrier or identify its doubled real matrix representation with a complex
matrix algebra.

The normalized matrix Peirce node is conditional on IsUnit (2 : ℝ). The
Coquaternion raw pair is kept distinct: its owner proves orthogonality and
scaled idempotence. Normalized idempotents are read from the real matrix owner.
-/

namespace InfoGeometry.Clifford.Cl11CanonicalArchetypePoset

open InfoGeometry.Clifford.Coquaternion
open InfoGeometry.Clifford.Cl11Matrix
open InfoGeometry.Clifford.Cl11GeometricSynthesis
open InfoGeometry.Clifford.SplitQ11CausalCone
open InfoGeometry.Clifford.GeometricBiquaternion
open InfoGeometry.Clifford.GeometricBiquaternion.Biquat

/-- The finite set of source-backed archetypes in this Cl(1,1) stream. -/
inductive Archetype where
  | coquaternionCarrier
  | generatorRelations
  | ellipticUnit
  | hyperbolicBivector
  | dualNilpotent
  | gradingDecomposition
  | rawOrthogonalElements
  | matrixRepresentation
  | normalizedMatrixPeirce
  | nativeCliffordMatrixEquivalence
  | spinorAction
  | geometricBiquaternionPair
  | centralI3Laws
  | doubledMatrixRepresentation
  deriving DecidableEq, Repr

/-- A typed direct prerequisite edge, tied to a source owner theorem. -/
inductive Prerequisite : Archetype → Archetype → Prop where
  | carrier_relations :
      Prerequisite .coquaternionCarrier .generatorRelations
  | relations_elliptic :
      Prerequisite .generatorRelations .ellipticUnit
  | relations_hyperbolic :
      Prerequisite .generatorRelations .hyperbolicBivector
  | relations_dual :
      Prerequisite .generatorRelations .dualNilpotent
  | relations_grading :
      Prerequisite .generatorRelations .gradingDecomposition
  | grading_raw :
      Prerequisite .gradingDecomposition .rawOrthogonalElements
  | relations_matrix :
      Prerequisite .generatorRelations .matrixRepresentation
  | matrix_normalized (h2 : IsUnit (2 : ℝ)) :
      Prerequisite .matrixRepresentation .normalizedMatrixPeirce
  | grading_normalized (h2 : IsUnit (2 : ℝ)) :
      Prerequisite .gradingDecomposition .normalizedMatrixPeirce
  | relations_clifford_equiv :
      Prerequisite .generatorRelations .nativeCliffordMatrixEquivalence
  | matrix_spinor :
      Prerequisite .matrixRepresentation .spinorAction
  | carrier_biquaternion :
      Prerequisite .coquaternionCarrier .geometricBiquaternionPair
  | biquaternion_i3 :
      Prerequisite .geometricBiquaternionPair .centralI3Laws
  | biquaternion_matrix :
      Prerequisite .geometricBiquaternionPair .doubledMatrixRepresentation

/-- A strictly increasing layer number, used only to certify acyclicity. -/
def layer : Archetype → ℕ
  | .coquaternionCarrier => 0
  | .generatorRelations => 1
  | .ellipticUnit => 2
  | .hyperbolicBivector => 3
  | .dualNilpotent => 4
  | .gradingDecomposition => 5
  | .rawOrthogonalElements => 6
  | .matrixRepresentation => 7
  | .normalizedMatrixPeirce => 8
  | .nativeCliffordMatrixEquivalence => 9
  | .spinorAction => 10
  | .geometricBiquaternionPair => 11
  | .centralI3Laws => 12
  | .doubledMatrixRepresentation => 13

private theorem layer_injective : Function.Injective layer := by
  intro a b h
  cases a <;> cases b <;> simp [layer] at h ⊢

private theorem layer_lt_of_prerequisite {a b : Archetype}
    (h : Prerequisite a b) : layer a < layer b := by
  cases h <;> simp [layer]

/-- Paths generated by the typed prerequisite edges. -/
inductive Path : Archetype → Archetype → Prop where
  | refl (a : Archetype) : Path a a
  | edge {a b c : Archetype} : Prerequisite a b → Path b c → Path a c

theorem path_trans {a b c : Archetype} (hab : Path a b) (hbc : Path b c) :
    Path a c := by
  induction hab generalizing c with
  | refl => exact hbc
  | edge h rest ih => exact Path.edge h (ih hbc)

private theorem layer_le_of_path {a b : Archetype} (h : Path a b) :
    layer a ≤ layer b := by
  induction h with
  | refl => exact Nat.le_refl _
  | edge h rest ih => exact (layer_lt_of_prerequisite h).le.trans ih

/-- The causal order is exactly reachability in the typed prerequisite graph. -/
instance : PartialOrder Archetype where
  le := Path
  le_refl := Path.refl
  le_trans := path_trans
  le_antisymm := by
    intro a b hab hba
    apply layer_injective
    exact Nat.le_antisymm (layer_le_of_path hab) (layer_le_of_path hba)

/-- A path in both directions can only be the reflexive path at one node. -/
theorem path_acyclic {a b : Archetype} (hab : Path a b) (hba : Path b a) :
    a = b := le_antisymm hab hba

/-- The real matrix owner supplies the complementary normalized Peirce laws
under the explicit condition that two is a unit. -/
def normalizedPeirceWitness (h2 : IsUnit (2 : ℝ)) : Prop :=
  IsUnit (2 : ℝ) ∧
  InfoGeometry.Clifford.Cl11GeometricSynthesis.P_plus *
      InfoGeometry.Clifford.Cl11GeometricSynthesis.P_plus =
    InfoGeometry.Clifford.Cl11GeometricSynthesis.P_plus ∧
  InfoGeometry.Clifford.Cl11GeometricSynthesis.P_minus *
      InfoGeometry.Cl11GeometricSynthesis.P_minus =
    InfoGeometry.Clifford.Cl11GeometricSynthesis.P_minus ∧
  InfoGeometry.Clifford.Cl11GeometricSynthesis.P_plus *
      InfoGeometry.Clifford.Cl11GeometricSynthesis.P_minus = 0 ∧
  InfoGeometry.Clifford.Cl11GeometricSynthesis.P_minus *
      InfoGeometry.Clifford.Cl11GeometricSynthesis.P_plus = 0 ∧
  InfoGeometry.Clifford.Cl11GeometricSynthesis.P_plus +
      InfoGeometry.Clifford.Cl11GeometricSynthesis.P_minus =
    InfoGeometry.Clifford.Cl11GeometricSynthesis.one

theorem normalizedPeirceWitness_holds (h2 : IsUnit (2 : ℝ)) :
    normalizedPeirceWitness h2 := by
  exact ⟨h2,
    InfoGeometry.Clifford.Cl11GeometricSynthesis.P_plus_sq,
    InfoGeometry.Clifford.Cl11GeometricSynthesis.P_minus_sq,
    InfoGeometry.Clifford.Cl11GeometricSynthesis.P_plus_mul_P_minus,
    InfoGeometry.Clifford.Cl11GeometricSynthesis.P_minus_mul_P_plus,
    InfoGeometry.Clifford.Cl11GeometricSynthesis.P_plus_add_P_minus⟩

/-- Generator relations of the source coquaternion carrier. -/
theorem coquaternion_relations :
    (InfoGeometry.Clifford.Coquaternion.Coquaternion.e1 : Coquaternion ℝ) * e1 = 1 ∧
    (InfoGeometry.Clifford.Coquaternion.Coquaternion.e2 : Coquaternion ℝ) * e2 = -1 ∧
    (InfoGeometry.Clifford.Coquaternion.Coquaternion.e1 : Coquaternion ℝ) * e2 +
      e2 * e1 = 0 :=
  ⟨InfoGeometry.Clifford.Coquaternion.Coquaternion.e1_sq,
    InfoGeometry.Clifford.Coquaternion.Coquaternion.e2_sq,
    InfoGeometry.Clifford.Coquaternion.Coquaternion.anticomm_e1_e2⟩

/-- The source owner's three planar generators have distinct square laws. -/
theorem planar_generators :
    (InfoGeometry.Clifford.Coquaternion.Coquaternion.i_unit : Coquaternion ℝ) *
        i_unit = -1 ∧
    (InfoGeometry.Clifford.Coquaternion.Coquaternion.j_unit : Coquaternion ℝ) *
        j_unit = 1 ∧
    (InfoGeometry.Clifford.Coquaternion.Coquaternion.epsilon : Coquaternion ℝ) *
        epsilon = 0 :=
  InfoGeometry.Clifford.Coquaternion.Coquaternion.planar_triad_coexistence

/-- The raw chiral pair is orthogonal and scaled-idempotent, not idempotent. -/
theorem raw_pair_laws :
    InfoGeometry.Clifford.Coquaternion.Coquaternion.P_plus_raw * P_minus_raw = 0 ∧
    InfoGeometry.Clifford.Coquaternion.Coquaternion.P_minus_raw * P_plus_raw = 0 ∧
    InfoGeometry.Clifford.Coquaternion.Coquaternion.P_plus_raw * P_plus_raw =
      ⟨2, 0, 0, 2⟩ ∧
    InfoGeometry.Clifford.Coquaternion.Coquaternion.P_minus_raw * P_minus_raw =
      ⟨2, 0, 0, -2⟩ :=
  ⟨InfoGeometry.Clifford.Coquaternion.Coquaternion.P_plus_mul_P_minus,
    InfoGeometry.Clifford.Coquaternion.Coquaternion.P_minus_mul_P_plus,
    InfoGeometry.Clifford.Coquaternion.Coquaternion.P_plus_sq,
    InfoGeometry.Clifford.Coquaternion.Coquaternion.P_minus_sq⟩

/-- The native Clifford algebra equivalence from Cl11Matrix is retained as
the operator-level matrix representation archetype. -/
theorem native_clifford_matrix_equivalence_exists :
    Nonempty
      (CliffordAlgebra InfoGeometry.Clifford.Cl11Matrix.q11 ≃ₐ[ℝ]
        InfoGeometry.Clifford.Cl11Matrix.Mat2) :=
  ⟨InfoGeometry.Clifford.Cl11Matrix.cl11EquivMat⟩

/-- The causal-cone owner proves the projector action on its two-component
real spinor carrier. -/
theorem matrix_spinor_projector_action (ψ : Spinor2) :
    matrixAct matrixKreinPlusProjector ψ 0 = ψ 0 ∧
    matrixAct matrixKreinPlusProjector ψ 1 = 0 ∧
    matrixAct matrixKreinMinusProjector ψ 0 = 0 ∧
    matrixAct matrixKreinMinusProjector ψ 1 = ψ 1 :=
  matrix_projector_spinor_action ψ

/-- The pair extension's central-generator and matrix-multiplication laws,
at exactly the carrier scope stated by its owner. -/
theorem geometric_biquaternion_laws :
    (I3 : Biquat ℝ) * I3 = -1 ∧
    (∀ q : Coquaternion ℝ,
      (I3 : Biquat ℝ) * ofCoquaternion q = ofCoquaternion q * I3) ∧
    (∀ p q : Biquat ℝ, toMatrix4 (p * q) = toMatrix4 p * toMatrix4 q) :=
  ⟨I3_sq, I3_comm_coquaternion, toMatrix4_mul⟩

/-- Reflexivity, transitivity, antisymmetry, and acyclicity of this finite
source-grounded reachability poset. -/
theorem causal_poset_certificate :
    (∀ a : Archetype, Path a a) ∧
    (∀ a b c : Archetype, Path a b → Path b c → Path a c) ∧
    (∀ a b : Archetype, Path a b → Path b a → a = b) := by
  exact ⟨Path.refl, fun _ _ _ h₁ h₂ => path_trans h₁ h₂,
    fun _ _ h₁ h₂ => path_acyclic h₁ h₂⟩

end InfoGeometry.Clifford.Cl11CanonicalArchetypePoset
