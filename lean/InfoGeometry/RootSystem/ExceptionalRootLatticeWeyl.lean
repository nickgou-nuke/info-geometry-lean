import InfoGeometry.Exceptional.CFSGPort.ChevalleyStringsInputs
import InfoGeometry.Cantor.CantorRandomWalk

/-!
# Weyl symmetries of the exceptional root-coordinate lattices

For each local exceptional root tag, the integral root-coordinate lattice has
a concrete subgroup generated by its simple reflections. The construction
uses the existing reflection action on root coordinates and makes no claim
that an abstract Coxeter presentation has already been identified with this
concrete subgroup.
-/

namespace InfoGeometry.RootSystem.Exceptional

open InfoGeometry.Exceptional.CFSGPort.Chevalley
open InfoGeometry.Cantor.CantorRandomWalk

/-- The integral root-coordinate lattice for an exceptional root tag. -/
abbrev RootLattice (τ : Tag) := Fin τ.rank → ℤ

/-- The simple reflection at node `i`, as a lattice automorphism. -/
def simpleReflection (τ : Tag) (i : Fin τ.rank) : Equiv.Perm (RootLattice τ) :=
  (reflectEquiv τ i).toEquiv

@[simp] theorem simpleReflection_apply (τ : Tag) (i : Fin τ.rank) (v : RootLattice τ) :
    simpleReflection τ i v = reflect τ i v :=
  rfl

/-- Each simple root reflection is an involution of the integral lattice. -/
theorem simpleReflection_sq (τ : Tag) (i : Fin τ.rank) :
    simpleReflection τ i * simpleReflection τ i = 1 := by
  apply Equiv.ext
  intro v
  exact reflect_reflect τ i v

/-- The concrete Weyl subgroup generated by the simple reflections on the
integer root-coordinate lattice. -/
def rootLatticeWeylGroup (τ : Tag) : Subgroup (Equiv.Perm (RootLattice τ)) :=
  Subgroup.closure (Set.range (simpleReflection τ))

/-- Every generating reflection preserves the certified root predicate. -/
theorem simpleReflection_preservesRoot (τ : Tag) (i : Fin τ.rank)
    {v : RootLattice τ} (hv : IsRoot τ v) :
    IsRoot τ (simpleReflection τ i v) := by
  exact (isRoot_reflect_iff i).2 hv

/-- Every element of the concrete exceptional Weyl subgroup preserves the
root set. -/
theorem rootLatticeWeylGroup_preservesRoot (τ : Tag)
    (w : rootLatticeWeylGroup τ) {v : RootLattice τ} (hv : IsRoot τ v) :
    IsRoot τ ((w : Equiv.Perm (RootLattice τ)) v) := by
  have hw := Subgroup.closure_induction_left
    (p := fun g _ => ∀ x : RootLattice τ, IsRoot τ x → IsRoot τ (g x))
    (fun x hx => hx)
    (fun a ha b hb hhb x hx => by
      rcases ha with ⟨i, rfl⟩
      exact simpleReflection_preservesRoot τ i (hhb x hx))
    (fun a ha b hb hhb x hx => by
      rcases ha with ⟨i, rfl⟩
      have hi : (simpleReflection τ i)⁻¹ = simpleReflection τ i := by
        exact inv_eq_of_mul_eq_one_left (simpleReflection_sq τ i)
      simpa [hi] using simpleReflection_preservesRoot τ i (hhb x hx))
    w.property
  exact hw v hv

/-- Boolean configurations indexed by the exceptional root-coordinate
lattice. -/
abbrev RootConfiguration (τ : Tag) := RootLattice τ → Bool

/-- The exceptional Weyl subgroup acts on root-lattice configurations by
inverse reindexing. -/
instance rootConfigurationAction (τ : Tag) :
    MulAction (rootLatticeWeylGroup τ) (RootConfiguration τ) where
  smul w f x := f (((w⁻¹ : rootLatticeWeylGroup τ) : Equiv.Perm (RootLattice τ)) x)
  one_smul := by
    intro f
    funext x
    change f ((1 : Equiv.Perm (RootLattice τ)) x) = f x
    rfl
  mul_smul := by
    intro g h f
    funext x
    change f (((h⁻¹ : rootLatticeWeylGroup τ) : Equiv.Perm (RootLattice τ))
      (((g⁻¹ : rootLatticeWeylGroup τ) : Equiv.Perm (RootLattice τ)) x)) =
      f ((((g * h)⁻¹ : rootLatticeWeylGroup τ) : Equiv.Perm (RootLattice τ)) x)
    congr 1

@[simp] theorem smul_rootConfiguration_apply (τ : Tag)
    (g : rootLatticeWeylGroup τ) (f : RootConfiguration τ) (x : RootLattice τ) :
    (g • f) x = f (((g⁻¹ : rootLatticeWeylGroup τ) : Equiv.Perm (RootLattice τ)) x) := rfl

/-- Distinct lattice Weyl automorphisms act differently on the full Boolean
configuration cube. -/
instance rootConfigurationFaithfulSMul (τ : Tag) :
    FaithfulSMul (rootLatticeWeylGroup τ) (RootConfiguration τ) := by
  rw [faithfulSMul_iff]
  intro g hg
  have hinv : (g⁻¹ : Equiv.Perm (RootLattice τ)) = 1 := by
    apply Equiv.ext
    intro x
    have hbit := congrArg (fun f : RootConfiguration τ => f x)
      (hg fun y => decide (y = x))
    rw [smul_rootConfiguration_apply] at hbit
    have hx : ((g⁻¹ : rootLatticeWeylGroup τ) : Equiv.Perm (RootLattice τ)) x = x := by
      exact of_decide_eq_true (by simpa using hbit)
    exact hx
  apply Subtype.ext
  simpa using congrArg Inv.inv hinv

/-- The induced permutation representation on the full root-lattice Boolean
configuration cube. -/
def rootConfigurationPermRep (τ : Tag) :
    rootLatticeWeylGroup τ →* Equiv.Perm (RootConfiguration τ) :=
  MulAction.toPermHom (rootLatticeWeylGroup τ) (RootConfiguration τ)

/-- The configuration permutation representation is faithful. -/
theorem rootConfigurationPermRep_injective (τ : Tag) :
    Function.Injective (rootConfigurationPermRep τ) := by
  intro g h hgh
  apply FaithfulSMul.eq_of_smul_eq_smul (M := rootLatticeWeylGroup τ)
    (α := RootConfiguration τ)
  intro f
  have hfg := congrArg (fun p : Equiv.Perm (RootConfiguration τ) => p f) hgh
  change g • f = h • f at hfg
  exact hfg

/-- The first coordinate vector used to witness infinitude of the root lattice. -/
def firstRootCoordinate (τ : Tag) : Fin τ.rank :=
  ⟨0, by cases τ <;> decide⟩

/-- Natural numbers embed in every exceptional root-coordinate lattice along
its first simple-root coordinate. -/
def natToRootLattice (τ : Tag) (n : ℕ) : RootLattice τ :=
  (n : ℤ) • Pi.single (firstRootCoordinate τ) 1

theorem natToRootLattice_injective (τ : Tag) :
    Function.Injective (natToRootLattice τ) := by
  intro m n h
  have h0 := congrFun h (firstRootCoordinate τ)
  exact_mod_cast (by simpa [natToRootLattice, firstRootCoordinate] using h0)

instance rootLattice_infinite (τ : Tag) : Infinite (RootLattice τ) :=
  Infinite.of_injective (natToRootLattice τ) (natToRootLattice_injective τ)

/-- A classical enumeration of each countably infinite exceptional
root-coordinate lattice. -/
noncomputable def rootLatticeEquivNat (τ : Tag) : RootLattice τ ≃ ℕ := by
  haveI : Countable (RootLattice τ) := inferInstance
  have hcard : Cardinal.mk (RootLattice τ) = Cardinal.aleph0 :=
    Cardinal.mk_eq_aleph0 (RootLattice τ)
  letI : Denumerable (RootLattice τ) := Classical.choice ((Cardinal.denumerable_iff).2 hcard)
  exact Denumerable.eqv (RootLattice τ)

/-- Reindex root-lattice Boolean configurations as infinite binary words. -/
noncomputable def rootConfigurationEquivCantorWord (τ : Tag) :
    RootConfiguration τ ≃ CantorWord :=
  (rootLatticeEquivNat τ).arrowCongr (Equiv.refl Bool)

/-- The exceptional Weyl action transported to permutations of `CantorWord`. -/
noncomputable def cantorWordPermRep (τ : Tag) :
    rootLatticeWeylGroup τ →* Equiv.Perm CantorWord :=
  (rootConfigurationEquivCantorWord τ).permCongrHom.toMonoidHom.comp
    (rootConfigurationPermRep τ)

theorem cantorWordPermRep_injective (τ : Tag) :
    Function.Injective (cantorWordPermRep τ) :=
  (rootConfigurationEquivCantorWord τ).permCongrHom.injective.comp
    (rootConfigurationPermRep_injective τ)

/-- The image exceptional Weyl subgroup on the binary Cantor-word carrier. -/
noncomputable def cantorWordWeylGroup (τ : Tag) : Subgroup (Equiv.Perm CantorWord) :=
  (⊤ : Subgroup (rootLatticeWeylGroup τ)).map (cantorWordPermRep τ)

end InfoGeometry.RootSystem.Exceptional
