import InfoGeometry.Canonical.ChiralHodgeDecomposition
import InfoGeometry.Canonical.RealHomologyCohomologyDictionary
import InfoGeometry.Meta.Architecture
import Mathlib.Tactic.Abel

open scoped InnerProductSpace

noncomputable section

namespace ChiralDiracHomologyCalibration

open InfoGeometry.Canonical.ChiralHodgeDecomposition
open InfoGeometry.Krein

/-!
# Chiral Dirac homology calibration

This file separates two lanes:

* a chiral Hodge/Dirac lane carries off-diagonal arrows and Hodge loops;
* a chiral homology lane requires explicit nilpotence witnesses.

The root doubled operator `J` in `ChiralHodgeDecomposition` is therefore not
called a boundary here.  Chiral arrows become boundary arrows only after the two
nilpotence laws are supplied.
-/

section RealLinearChiralComplex

variable {Cplus Cminus : Type*}
variable [AddCommGroup Cplus] [Module ℝ Cplus]
variable [AddCommGroup Cminus] [Module ℝ Cminus]

/--
A real-linear chiral differential pair.

`dPlus : C₊ → C₋` and `dMinus : C₋ → C₊` define sector homology only when both
cross-composites vanish.
-/
@[rep_depth krein]
structure ChiralDifferentialCalibration where
  dPlus : Cplus →ₗ[ℝ] Cminus
  dMinus : Cminus →ₗ[ℝ] Cplus

  /-- `d⁻ ∘ d⁺ = 0`, so minus-boundaries are minus-cycles. -/
  dMinus_comp_dPlus_zero : dMinus.comp dPlus = 0

  /-- `d⁺ ∘ d⁻ = 0`, so plus-boundaries are plus-cycles. -/
  dPlus_comp_dMinus_zero : dPlus.comp dMinus = 0

namespace ChiralDifferentialCalibration

variable (C : ChiralDifferentialCalibration (Cplus := Cplus) (Cminus := Cminus))

/-- Plus cycles: plus-sector states killed by the outgoing `dPlus`. -/
@[rep_depth krein]
def IsPlusCycle (x : Cplus) : Prop :=
  C.dPlus x = 0

/-- Minus cycles: minus-sector states killed by the outgoing `dMinus`. -/
@[rep_depth krein]
def IsMinusCycle (y : Cminus) : Prop :=
  C.dMinus y = 0

/-- Plus boundaries: plus-sector states generated by the incoming `dMinus`. -/
@[rep_depth krein]
def IsPlusBoundary (x : Cplus) : Prop :=
  ∃ y : Cminus, C.dMinus y = x

/-- Minus boundaries: minus-sector states generated by the incoming `dPlus`. -/
@[rep_depth krein]
def IsMinusBoundary (y : Cminus) : Prop :=
  ∃ x : Cplus, C.dPlus x = y

/-- Plus-sector boundaries are cycles when `dPlus.comp dMinus = 0`. -/
@[rep_depth krein]
theorem plusBoundary_isPlusCycle
    {x : Cplus}
    (hx : C.IsPlusBoundary x) :
    C.IsPlusCycle x := by
  rcases hx with ⟨y, rfl⟩
  unfold IsPlusCycle
  exact congrArg (fun F : Cminus →ₗ[ℝ] Cminus => F y) C.dPlus_comp_dMinus_zero

/-- Minus-sector boundaries are cycles when `dMinus.comp dPlus = 0`. -/
@[rep_depth krein]
theorem minusBoundary_isMinusCycle
    {y : Cminus}
    (hy : C.IsMinusBoundary y) :
    C.IsMinusCycle y := by
  rcases hy with ⟨x, rfl⟩
  unfold IsMinusCycle
  exact congrArg (fun F : Cplus →ₗ[ℝ] Cplus => F x) C.dMinus_comp_dPlus_zero

/-- Plus homology equivalence: representatives differ by an incoming `dMinus` boundary. -/
@[rep_depth krein]
def PlusHomologyEquivalent (x y : Cplus) : Prop :=
  C.IsPlusBoundary (x - y)

/-- Minus homology equivalence: representatives differ by an incoming `dPlus` boundary. -/
@[rep_depth krein]
def MinusHomologyEquivalent (x y : Cminus) : Prop :=
  C.IsMinusBoundary (x - y)

/-- Plus homology equivalence is reflexive. -/
@[rep_depth krein]
theorem plusHomologyEquivalent_refl
    (x : Cplus) :
    C.PlusHomologyEquivalent x x := by
  unfold PlusHomologyEquivalent IsPlusBoundary
  refine ⟨0, ?_⟩
  simp

/-- Plus homology equivalence is symmetric. -/
@[rep_depth krein]
theorem plusHomologyEquivalent_symm
    {x y : Cplus}
    (hxy : C.PlusHomologyEquivalent x y) :
    C.PlusHomologyEquivalent y x := by
  unfold PlusHomologyEquivalent IsPlusBoundary at hxy ⊢
  rcases hxy with ⟨z, hz⟩
  refine ⟨-z, ?_⟩
  calc
    C.dMinus (-z) = -C.dMinus z := by simp
    _ = y - x := by
      rw [hz]
      abel

/-- Plus homology equivalence is transitive. -/
@[rep_depth krein]
theorem plusHomologyEquivalent_trans
    {x y z : Cplus}
    (hxy : C.PlusHomologyEquivalent x y)
    (hyz : C.PlusHomologyEquivalent y z) :
    C.PlusHomologyEquivalent x z := by
  unfold PlusHomologyEquivalent IsPlusBoundary at hxy hyz ⊢
  rcases hxy with ⟨a, ha⟩
  rcases hyz with ⟨b, hb⟩
  refine ⟨a + b, ?_⟩
  calc
    C.dMinus (a + b) = C.dMinus a + C.dMinus b := by simp
    _ = (x - y) + (y - z) := by rw [ha, hb]
    _ = x - z := by abel

/-- Plus homology equivalence is an equivalence relation. -/
@[rep_depth krein]
theorem plusHomologyEquivalent_equivalence :
    Equivalence C.PlusHomologyEquivalent := by
  refine ⟨?refl, ?symm, ?trans⟩
  · intro x
    exact C.plusHomologyEquivalent_refl x
  · intro x y hxy
    exact C.plusHomologyEquivalent_symm hxy
  · intro x y z hxy hyz
    exact C.plusHomologyEquivalent_trans hxy hyz

/-- Minus homology equivalence is reflexive. -/
@[rep_depth krein]
theorem minusHomologyEquivalent_refl
    (x : Cminus) :
    C.MinusHomologyEquivalent x x := by
  unfold MinusHomologyEquivalent IsMinusBoundary
  refine ⟨0, ?_⟩
  simp

/-- Minus homology equivalence is symmetric. -/
@[rep_depth krein]
theorem minusHomologyEquivalent_symm
    {x y : Cminus}
    (hxy : C.MinusHomologyEquivalent x y) :
    C.MinusHomologyEquivalent y x := by
  unfold MinusHomologyEquivalent IsMinusBoundary at hxy ⊢
  rcases hxy with ⟨z, hz⟩
  refine ⟨-z, ?_⟩
  calc
    C.dPlus (-z) = -C.dPlus z := by simp
    _ = y - x := by
      rw [hz]
      abel

/-- Minus homology equivalence is transitive. -/
@[rep_depth krein]
theorem minusHomologyEquivalent_trans
    {x y z : Cminus}
    (hxy : C.MinusHomologyEquivalent x y)
    (hyz : C.MinusHomologyEquivalent y z) :
    C.MinusHomologyEquivalent x z := by
  unfold MinusHomologyEquivalent IsMinusBoundary at hxy hyz ⊢
  rcases hxy with ⟨a, ha⟩
  rcases hyz with ⟨b, hb⟩
  refine ⟨a + b, ?_⟩
  calc
    C.dPlus (a + b) = C.dPlus a + C.dPlus b := by simp
    _ = (x - y) + (y - z) := by rw [ha, hb]
    _ = x - z := by abel

/-- Minus homology equivalence is an equivalence relation. -/
@[rep_depth krein]
theorem minusHomologyEquivalent_equivalence :
    Equivalence C.MinusHomologyEquivalent := by
  refine ⟨?refl, ?symm, ?trans⟩
  · intro x
    exact C.minusHomologyEquivalent_refl x
  · intro x y hxy
    exact C.minusHomologyEquivalent_symm hxy
  · intro x y z hxy hyz
    exact C.minusHomologyEquivalent_trans hxy hyz

end ChiralDifferentialCalibration

end RealLinearChiralComplex

section RootHodgeReadbacks

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

/-- Root doubled chiral Dirac plus arrow, exposed only as a Hodge arrow readback. -/
@[rep_depth krein]
noncomputable abbrev rootHodgeArrowPlus : EndH :=
  rootDiracPlus (E := E)

/-- Root doubled chiral Dirac minus arrow, exposed only as a Hodge arrow readback. -/
@[rep_depth krein]
noncomputable abbrev rootHodgeArrowMinus : EndH :=
  rootDiracMinus (E := E)

omit [CompleteSpace E] in
/-- Owner-lane readback: the root odd Dirac lane is the sum of chiral Hodge arrows. -/
@[rep_depth krein]
theorem rootDiracOddLane_eq_hodgeArrow_sum :
    rootDiracOddLane (E := E) =
      rootHodgeArrowPlus (E := E) + rootHodgeArrowMinus (E := E) :=
  rootDiracOddLane_eq_chiral_sum (E := E)

/-- Owner-lane readback: the root Dirac square is the sum of chiral Hodge loops. -/
@[rep_depth krein]
theorem rootDiracOddLane_sq_eq_hodgeLoop_sum :
    (rootDiracOddLane (E := E)).comp (rootDiracOddLane (E := E)) =
      rootChiralLaplacianPlus (E := E) + rootChiralLaplacianMinus (E := E) :=
  rootDiracOddLane_sq_eq_chiralLaplacian_sum (E := E)

end RootHodgeReadbacks

end ChiralDiracHomologyCalibration
