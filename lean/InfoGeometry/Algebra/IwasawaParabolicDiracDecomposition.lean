import Mathlib.Algebra.Module.LinearMap.Basic
import Mathlib.Algebra.Ring.Basic
import InfoGeometry.Canonical.KANIwasawaSplitPeirceDiracBridge

namespace InfoGeometry.Algebra

open InfoGeometry.Canonical.KANIwasawaSplitPeirceDirac

/-! ### The Iwasawa Dirac-Kähler Decomposition -/

/-- An abstract Dirac-Kähler operator D decomposed over the Iwasawa KAN triad. -/
structure IwasawaDiracDecomposition (V : Type*) [AddCommGroup V] [Module ℝ V] where
  /-- The full Dirac-Kähler operator D = d - δ. -/
  D : V →ₗ[ℝ] V
  /-- The angular/spin connection operator D_K acting on the compact isotropy factor. -/
  D_K : V →ₗ[ℝ] V
  /-- The scale/Euler radial derivative operator D_A along the split torus. -/
  D_A : V →ₗ[ℝ] V
  /-- The horocyclic BRST/Koszul operator D_N along the unipotent foliation. -/
  D_N : V →ₗ[ℝ] V
  /-- The pristine canonical triad decomposition: D = D_K + D_A + D_N. -/
  decomp_eq : D = D_K + D_A + D_N
  /-- The nilpotent property of the horocyclic operator in the flat limit: D_N^2 = 0. -/
  n_nilpotent : D_N ∘ₗ D_N = 0

/-! ### The Parabolic Subgroup P = M ⋉ (A ⋉ N) and Klein Bottle Holonomy -/

/-- The Parabolic group elements in the SL(2, ℝ) split representation. -/
structure ParabolicElement where
  /-- M factor: discrete parity reflection (Z_2 Weyl reflection). 
      Physically conflated as centralizer Z_K(A), but algebraically the normalizer N_K(A). -/
  m_reflect : Bool
  /-- A factor: continuous Weyl scaling/boost parameter. -/
  a_boost : ℝ
  /-- N factor: continuous nilpotent shear parameter. -/
  n_shear : ℝ

/-- Mapping the abstract parabolic element into the Cl(1,1) real matrix representation. -/
noncomputable def ParabolicElement.toMatrix (p : ParabolicElement) : Matrix (Fin 2) (Fin 2) ℝ :=
  let M_mat := if p.m_reflect then matR else 1
  let A_mat := matA_boost p.a_boost
  let N_mat := matN p.n_shear
  M_mat * (A_mat * N_mat)

/-- The discrete Klein Bottle lattice Γ ⊂ P generated by a and b. -/
def kleinBottleA : ParabolicElement := ⟨true, 0, 0⟩
def kleinBottleB (t : ℝ) : ParabolicElement := ⟨false, t, 0⟩

/-- Matrix representation of the orientation-reversing cycle a. -/
theorem kleinBottleA_matrix :
    kleinBottleA.toMatrix = matR := by
  dsimp [kleinBottleA, ParabolicElement.toMatrix]
  simp [matA_boost, matN]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [matA, matR]

/-- Matrix representation of the scale cycle b. -/
theorem kleinBottleB_matrix (t : ℝ) :
    (kleinBottleB t).toMatrix = matA_boost t := by
  dsimp [kleinBottleB, ParabolicElement.toMatrix]
  simp [matA_boost, matN]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [matA]

/-- The pristine algebraic relation defining the Klein Bottle Holonomy in the Parabolic subgroup:
    a * b * a⁻¹ = b⁻¹. In matrix form: R * A(t) * R = A(-t).
    This proves that the local Cayley-Dickson split algebra globally supports the non-orientable Klein topology. -/
theorem kleinBottle_holonomy_relation (t : ℝ) :
    kleinBottleA.toMatrix * (kleinBottleB t).toMatrix * kleinBottleA.toMatrix =
      (kleinBottleB (-t)).toMatrix := by
  rw [kleinBottleA_matrix, kleinBottleB_matrix, kleinBottleB_matrix]
  exact matR_conjugates_boost t

end InfoGeometry.Algebra
