/-!
# The Logarithmic Bridge: The Redline Archetype (Lie/Jacobian Corridor)

This module formalizes the **Lie/Jacobian corridor** of the Universal Logarithmic Bridge:

1. **Lie Flow** → **Jacobian Determinant**
   `det(exp(tA)) = exp(t · Tr(A))`

2. **Negative Log Jacobian** → **Negative Log Determinant Potential**
   `-log det(J(t))` is the compression potential; for `J(t) = exp(tA)` its derivative is `-Tr(A)`

3. **Logarithmic Radon–Nikodym Chain Rule**
   `dlog_D(Δ₁₂ · Δ₂₃) = dlog_D(Δ₁₂) + dlog_D(Δ₂₃)`

4. **Zero-Jacobian Weyl Invariance**
   Finite Weyl scaling preserves the zero-determinant locus

All proofs are complete in native Mathlib with zero `sorry`s and zero custom axioms.
The docstring claims about de Rham cohomology, differential forms, and exterior
derivatives are interpretive analogies; the kernel-checked content below is the
finite-dimensional algebraic and calculus core.
-/

noncomputable section

namespace InfoGeometry.LogarithmicBridge

open InfoGeometry.Analysis.LieExponentialTraceDeterminant
open InfoGeometry.Analysis.MatrixPathDeformationEntropy
open InfoGeometry.Modular
open InfoGeometry.Volume.ZeroJacobianWeylBoundary

/-!
=============================================================================
PART 1: The Lie Flow → Jacobian Determinant → Negative Log Bridge
=============================================================================
-/

variable {n : Type*} [Fintype n] [DecidableEq n]

/--
THEOREM 1 (Lie Exponential Redline): The Lie flow generated by A has Jacobian determinant:
`det(exp(tA)) = exp(t · Tr(A))`

The negative log Jacobian is the affine potential:
`-log det(exp(tA)) = -t · Tr(A)`
-/
theorem lieFlow_negativeLogJacobian (A : Matrix n n ℝ) (t : ℝ) :
    -Real.log ( (lieExponentialPath A t).det ) = - (t * Matrix.trace A) := by
  have h_det : (lieExponentialPath A t).det = Real.exp (t * Matrix.trace A) :=
    det_lieExponentialPath A t
  rw [h_det]
  have h_log_exp : Real.log (Real.exp (t * Matrix.trace A)) = t * Matrix.trace A := by
    rw [Real.log_exp]
  rw [h_log_exp]
  <;> ring
  <;> simp [Real.log_exp]

/--
THEOREM 2 (Matrix Path Deformation): For any positive-determinant matrix path J(t),
the negative log-determinant potential satisfies:
`d/dt [-log det(J(t))] = - (det(J(t))' / det(J(t)))`

If J(t) = exp(tA), this reduces to `-Tr(A)` — the generator trace.
-/
theorem matrixPath_negativeLogPotential_deriv
    {J : ℝ → Matrix n n ℝ}
    {t det' generatorTrace : ℝ}
    (hdet : HasDerivAt (determinantVolumePath J) det' t)
    (hpos : ∀ u : ℝ, 0 < (J u).det)
    (hJacobi : det' = (J t).det * generatorTrace) :
    deriv (matrixPathCompressionPotential J) t = -generatorTrace :=
  deriv_matrixPathCompressionPotential_of_jacobi hdet hpos hJacobi

/-!
=============================================================================
PART 2: The Logarithmic Radon–Nikodym Chain Rule
=============================================================================
-/

variable {R : Type*} [CommRing R]

/--
THEOREM 3 (Logarithmic Radon–Nikodym Chain Rule): The logarithmic derivative
`dlog_D(Δ) = Δ⁻¹ · D(Δ)` is a group homomorphism:
`dlog_D(Δ₁₂ · Δ₂₃) = dlog_D(Δ₁₂) + dlog_D(Δ₂₃)`

This is the algebraic backbone of the Connes cocycle in the commutative case.
-/
theorem logarithmicRadonNikodym_chainRule
    (D : R →ₗ[R] R) (hD : ∀ x y, D (x * y) = D x * y + x * D y)
    (Δ12 inv_Δ12 Δ23 inv_Δ23 : R)
    (h12 : Δ12 * inv_Δ12 = 1) (h23 : Δ23 * inv_Δ23 = 1) :
    (inv_Δ12 * inv_Δ23) * (D (Δ12 * Δ23)) =
      (inv_Δ12 * D Δ12) * (Δ23 * inv_Δ23) + (inv_Δ23 * D Δ23) * (Δ12 * inv_Δ12) := by
  rw [hD Δ12 Δ23]
  calc
    (inv_Δ12 * inv_Δ23) * (D Δ12 * Δ23 + Δ12 * D Δ23)
      = (inv_Δ12 * inv_Δ23) * (D Δ12 * Δ23) + (inv_Δ12 * inv_Δ23) * (Δ12 * D Δ23) := by
        ring
    _ = (inv_Δ12 * D Δ12) * (Δ23 * inv_Δ23) + (inv_Δ23 * D Δ23) * (Δ12 * inv_Δ12) := by
        ring

/-!
=============================================================================
PART 3: The Zero-Jacobian Weyl Boundary Bridge
=============================================================================
-/

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/--
THEOREM 4 (Zero-Jacobian Invariance under Finite Weyl Scaling):
The zero-Jacobian locus is invariant under finite Weyl scaling.
`det DF = 0 ↔ det D(e^ϕ F) = 0`
-/
theorem zeroJacobian_weylInvariant
    (phi : ℝ) (J : Matrix ι ι ℝ) :
    (weylScaledJacobian (ι := ι) phi J).det = 0 ↔ J.det = 0 := by
  rw [det_weylScaledJacobian_eq_zero_iff phi J]

/--
THEOREM 5 (Total Transported Density Vanishes on Zero-Jacobian):
The total transported density vanishes exactly when the Jacobian determinant
vanishes. Finite Weyl volume scaling cannot remove a zero determinant.
-/
theorem totalTransportDensity_zero_iff_zeroJacobian
    (dim : ℕ) (phi : ℝ) (J : Matrix ι ι ℝ) :
    totalTransportDensity (ι := ι) dim phi J = 0 ↔ J.det = 0 := by
  rw [totalTransportDensity_eq_zero_iff_det_eq_zero dim phi J]

/-!
=============================================================================
PART 4: The Complete Kernel-Checked Core
=============================================================================
-/

/--
The canonical dictionary for the Lie/Jacobian corridor of the logarithmic bridge.
This is a data structure, not a new proof; every field is a kernel-checked theorem
from this module or its imports.
-/
structure LieJacobianDictionary (n : Type*) [Fintype n] [DecidableEq n] where
  /-- Lie flow determinant exponential redline. -/
  lieFlow_to_jacobian : ∀ (A : Matrix n n ℝ) (t : ℝ),
    (lieExponentialPath A t).det = Real.exp (t * Matrix.trace A)
  /-- Negative log Jacobian = negative generator trace. -/
  jacobian_to_negLog : ∀ (A : Matrix n n ℝ) (t : ℝ),
    -Real.log ( (lieExponentialPath A t).det ) = - (t * Matrix.trace A)

/--
THEOREM 6 (Lie/Jacobian Corridor Complete):
The Lie exponential redline corridor is verified in native Mathlib with zero axioms.
-/
theorem lieJacobianCorridor_complete {n : Type*} [Fintype n] [DecidableEq n] :
    ∃ (_dict : LieJacobianDictionary n), True := by
  refine' ⟨
    { lieFlow_to_jacobian := fun A t => det_lieExponentialPath A t
      jacobian_to_negLog := fun A t => lieFlow_negativeLogJacobian A t
    },
    True.intro
  ⟩

end InfoGeometry.LogarithmicBridge

end noncomputable section
