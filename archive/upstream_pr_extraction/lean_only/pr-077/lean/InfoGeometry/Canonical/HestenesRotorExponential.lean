import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Complex.Basic
import InfoGeometry.Canonical.LorentzSelfDualLieSplit
import InfoGeometry.Canonical.HestenesBivectorCarrier
import InfoGeometry.Canonical.CliffordParityBridge
import InfoGeometry.Canonical.HestenesBivectorSelfDuality

namespace InfoGeometry.Canonical.HestenesRotorExponential

open Matrix
open InfoGeometry.Canonical.LorentzSelfDualLieSplit
open InfoGeometry.Canonical.HestenesBivectorCarrier
open InfoGeometry.Canonical.CliffordParity
open InfoGeometry.Canonical.HestenesBivectorSelfDuality

variable {M : Type*} [AddCommGroup M] [Module ℝ M]
variable (Q : QuadraticForm ℝ M) [InfoGeometry.Canonical.CliffordParity.HasVolumeElement ℝ M Q] [HasSpacetimeBasis Q]

/-- Explicit closed-form exponential for a 2x2 complex trace-zero matrix.
    By the Cayley-Hamilton theorem, since tr(B) = 0, B^2 = -det(B) I.
    Thus exp(B) = cos(w) I + (sin(w)/w) B, where w^2 = det(B). -/
noncomputable def expSL2C (B : sl2c) : Matrix (Fin 2) (Fin 2) ℂ :=
  let det := B.val.det
  let w := det ^ ((2 : ℂ)⁻¹)
  let c := Complex.cos w
  let s := if w = 0 then (1 : ℂ) else Complex.sin w / w
  c • 1 + s • B.val

/-- Determinant for a linear combination of identity and trace-zero matrix. -/
lemma det_add_smul_fin_two (c s : ℂ) (B : Matrix (Fin 2) (Fin 2) ℂ) (hB_tr : B.trace = 0) :
    (c • (1 : Matrix (Fin 2) (Fin 2) ℂ) + s • B).det = c ^ 2 + s ^ 2 * B.det := by
  -- Matrix.det_fin_two says A 0 0 * A 1 1 - A 0 1 * A 1 0
  rw [Matrix.trace_fin_two] at hB_tr
  have h00 : (c • (1 : Matrix (Fin 2) (Fin 2) ℂ) + s • B) 0 0 = c + s * B 0 0 := by simp
  have h11 : (c • (1 : Matrix (Fin 2) (Fin 2) ℂ) + s • B) 1 1 = c + s * B 1 1 := by simp
  have h01 : (c • (1 : Matrix (Fin 2) (Fin 2) ℂ) + s • B) 0 1 = s * B 0 1 := by simp
  have h10 : (c • (1 : Matrix (Fin 2) (Fin 2) ℂ) + s • B) 1 0 = s * B 1 0 := by simp
  rw [Matrix.det_fin_two, h00, h11, h01, h10]
  have h_B11 : B 1 1 = - B 0 0 := by
    calc
      B 1 1 = (B 0 0 + B 1 1) - B 0 0 := by ring
      _ = 0 - B 0 0 := by rw [hB_tr]
      _ = -B 0 0 := by ring
  rw [h_B11]
  have h_det_B : B.det = - B 0 0 ^ 2 - B 0 1 * B 1 0 := by
    rw [Matrix.det_fin_two, h_B11]
    ring
  rw [h_det_B]
  ring

/-- The exponential of a trace-zero matrix has unit determinant natively, replacing topological sorrys. -/
lemma det_exp_of_trace_zero (B : sl2c) : (expSL2C B).det = 1 := by
  dsimp [expSL2C]
  have h_tr : B.val.trace = 0 := B.prop
  rw [det_add_smul_fin_two _ _ _ h_tr]
  by_cases h : (B.val.det) ^ ((2 : ℂ)⁻¹) = 0
  · have h2 : B.val.det = ((B.val.det) ^ ((2 : ℂ)⁻¹)) ^ (2 : ℕ) := (Complex.cpow_ofNat_inv_pow B.val.det 2).symm
    have h_det_zero : B.val.det = 0 := by rw [h2, h, zero_pow (by decide)]
    simp [h_det_zero, Complex.cos_zero]
  · simp [h]
    have h1 : (Complex.sin ((B.val.det) ^ ((2 : ℂ)⁻¹)) / (B.val.det) ^ ((2 : ℂ)⁻¹)) ^ (2 : ℕ) * B.val.det = (Complex.sin ((B.val.det) ^ ((2 : ℂ)⁻¹))) ^ (2 : ℕ) := by
      have h2 : B.val.det = ((B.val.det) ^ ((2 : ℂ)⁻¹)) ^ (2 : ℕ) := (Complex.cpow_ofNat_inv_pow B.val.det 2).symm
      have h3 : (B.val.det) ^ ((2 : ℂ)⁻¹) ≠ 0 := h
      calc
        (Complex.sin ((B.val.det) ^ ((2 : ℂ)⁻¹)) / (B.val.det) ^ ((2 : ℂ)⁻¹)) ^ (2 : ℕ) * B.val.det
        _ = (Complex.sin ((B.val.det) ^ ((2 : ℂ)⁻¹)) / (B.val.det) ^ ((2 : ℂ)⁻¹)) ^ (2 : ℕ) * (((B.val.det) ^ ((2 : ℂ)⁻¹)) ^ (2 : ℕ)) := by nth_rw 3 [h2]
        _ = ((Complex.sin ((B.val.det) ^ ((2 : ℂ)⁻¹)) / (B.val.det) ^ ((2 : ℂ)⁻¹)) * (B.val.det) ^ ((2 : ℂ)⁻¹)) ^ (2 : ℕ) := by ring
        _ = (Complex.sin ((B.val.det) ^ ((2 : ℂ)⁻¹))) ^ (2 : ℕ) := by rw [div_mul_cancel₀ _ h3]
    rw [h1]
    exact Complex.cos_sq_add_sin_sq _

/-- Given a complexified bivector, we map it to its (sl2c × sl2c) split representation,
    then apply the matrix exponential to both components to get the Left and Right rotors. -/
noncomputable def bivectorToChiralRotors 
    (B : ComplexBivector Q)
    (iso : ComplexBivector Q ≃ₗ[ℂ] (sl2c × sl2c)) : 
    (Matrix (Fin 2) (Fin 2) ℂ) × (Matrix (Fin 2) (Fin 2) ℂ) :=
  let pair := iso B
  (expSL2C (pair.1), expSL2C (pair.2))

/-- The adjoint action of a chiral rotor pair on a target sl2c matrix (e.g. representing a vector/spinor). -/
noncomputable def chiralAdjointAction
    (R_L R_R : Matrix (Fin 2) (Fin 2) ℂ) (V : Matrix (Fin 2) (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  R_L * V * R_R

/-- The left rotor generated by a bivector is in SL(2, ℂ). -/
lemma left_rotor_in_sl2c (B : ComplexBivector Q) (iso : ComplexBivector Q ≃ₗ[ℂ] (sl2c × sl2c)) :
    ((bivectorToChiralRotors Q B iso).1).det = 1 := by
  dsimp [bivectorToChiralRotors]
  apply det_exp_of_trace_zero

/-- The right rotor generated by a bivector is in SL(2, ℂ). -/
lemma right_rotor_in_sl2c (B : ComplexBivector Q) (iso : ComplexBivector Q ≃ₗ[ℂ] (sl2c × sl2c)) :
    ((bivectorToChiralRotors Q B iso).2).det = 1 := by
  dsimp [bivectorToChiralRotors]
  apply det_exp_of_trace_zero

end InfoGeometry.Canonical.HestenesRotorExponential
