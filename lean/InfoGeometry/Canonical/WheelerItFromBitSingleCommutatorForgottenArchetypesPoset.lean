/-- 3D vector dot product over a non-commutative ring `B` (`∑_i u_i * v_i`). -/
def dot3 (u v : Fin 3 → B) : B :=
  u 0 * v 0 + u 1 * v 1 + u 2 * v 2

/-- 3D non-commutative vector cross product over `B`. -/
def cross3 (u v : Fin 3 → B) : Fin 3 → B
  | 0 => u 1 * v 2 - u 2 * v 1
  | 1 => u 2 * v 0 - u 0 * v 2
  | 2 => u 0 * v 1 - u 1 * v 0

/-- Zorn's Split-Octonion Vector-Matrix Algebra carrier `(a, b) × (u, v)` over an arbitrary `[Ring B]`. -/
def ZornOct (B : Type*) : Type _ := (B × B) × ((Fin 3 → B) × (Fin 3 → B))

/-- Upper-left scalar entry `a` of a Zorn vector-matrix `X : ZornOct B`. -/
def ZornOct.a (X : ZornOct B) : B := X.1.1

/-- Lower-right scalar entry `b` of a Zorn vector-matrix `X : ZornOct B`. -/
def ZornOct.b (X : ZornOct B) : B := X.1.2

/-- Upper-right 3-vector entry `u` of a Zorn vector-matrix `X : ZornOct B`. -/
def ZornOct.u (X : ZornOct B) : Fin 3 → B := X.2.1

/-- Lower-left 3-vector entry `v` of a Zorn vector-matrix `X : ZornOct B`. -/
def ZornOct.v (X : ZornOct B) : Fin 3 → B := X.2.2

/-- Constructor for a Zorn vector-matrix from `(a, b, u, v)`. -/
def mkZornOct (a b : B) (u v : Fin 3 → B) : ZornOct B := ((a, b), (u, v))

instance : Zero (ZornOct B) := ⟨mkZornOct 0 0 (fun _ => 0) (fun _ => 0)⟩

/-- Zero Zorn vector-matrix inhabitant for model witnessing. -/
instance : Inhabited (ZornOct B) := ⟨0⟩

instance : Add (ZornOct B) :=
  ⟨fun X Y => mkZornOct (X.a + Y.a) (X.b + Y.b) (fun i => X.u i + Y.u i) (fun i => X.v i + Y.v i)⟩

instance : Sub (ZornOct B) :=
  ⟨fun X Y => mkZornOct (X.a - Y.a) (X.b - Y.b) (fun i => X.u i - Y.u i) (fun i => X.v i - Y.v i)⟩

instance : Neg (ZornOct B) :=
  ⟨fun X => mkZornOct (-X.a) (-X.b) (fun i => -X.u i) (fun i => -X.v i)⟩

/-- Zorn Vector-Matrix Multiplication over `[Ring B]`:
    $$\begin{pmatrix} a_1 & u_1 \\ v_1 & b_1 \end{pmatrix}
      \begin{pmatrix} a_2 & u_2 \\ v_2 & b_2 \end{pmatrix} =
      \begin{pmatrix} a_1 a_2 - u_1 \cdot v_2 & a_1 u_2 + u_1 b_2 + v_1 \times v_2 \\
                      v_1 a_2 + b_1 v_2 + u_1 \times u_2 & b_1 b_2 - v_1 \cdot u_2 \end{pmatrix}$$ -/
instance : Mul (ZornOct B) :=
  ⟨fun X Y =>
    mkZornOct
      (X.a * Y.a - dot3 X.u Y.v)
      (X.b * Y.b - dot3 X.v Y.u)
      (fun i => X.a * Y.u i + X.u i * Y.b + cross3 X.v Y.v i)
      (fun i => X.v i * Y.a + X.b * Y.v i + cross3 X.u Y.u i)⟩

/-- Upper-corner embedding `E_+(u)` (`a = 0, b = 0, u = u, v = 0`). -/
def zornUpper (u : Fin 3 → B) : ZornOct B := mkZornOct 0 0 u (fun _ => 0)

/-- Lower-corner embedding `E_-(v)` (`a = 0, b = 0, u = 0, v = v`). -/
def zornLower (v : Fin 3 → B) : ZornOct B := mkZornOct 0 0 (fun _ => 0) v

/-- Non-associative Zorn Associator `Assoc(X, Y, Z) = (X * Y) * Z - X * (Y * Z)`. -/
def zornAssoc (X Y Z : ZornOct B) : ZornOct B := (X * Y) * Z - X * (Y * Z)

/-- Componentwise extensionality for `ZornOct B`. -/
lemma ZornOct.ext {X Y : ZornOct B}
    (ha : X.a = Y.a) (hb : X.b = Y.b)
    (hu : ∀ i, X.u i = Y.u i) (hv : ∀ i, X.v i = Y.v i) : X = Y := by
  rcases X with ⟨⟨xa, xb⟩, ⟨xu, xv⟩⟩
  rcases Y with ⟨⟨ya, yb⟩, ⟨yu, yv⟩⟩
  dsimp [ZornOct.a, ZornOct.b, ZornOct.u, ZornOct.v] at ha hb hu hv
  have hu' : xu = yu := funext hu
  have hv' : xv = yv := funext hv
  subst ha hb hu' hv'
  rfl

@[simp] lemma cross3_zero (i : Fin 3) :
    cross3 (fun _ : Fin 3 => (0 : B)) (fun _ => 0) i = 0 := by
  rcases i with ⟨_ | _ | _ | n, hn⟩
  · dsimp [cross3]; simp
  · dsimp [cross3]; simp
  · dsimp [cross3]; simp
  · omega

@[simp] lemma dot3_zero_left (v : Fin 3 → B) :
    dot3 (fun _ : Fin 3 => (0 : B)) v = 0 := by
  dsimp [dot3]; simp

@[simp] lemma dot3_zero_right (u : Fin 3 → B) :
    dot3 u (fun _ : Fin 3 => (0 : B)) = 0 := by
  dsimp [dot3]; simp

/-- Theorem 5.1 (Zorn Chiral Triality Folding & Scalar Triple Product Associator over `[Ring B]`):
    In `ZornOct B` over any non-commutative `[Ring B]`:
    1. **Chiral Corner Folding (`𝔤_{+1} × 𝔤_{+1} → 𝔤_{-1}`)**:
       `zornUpper u1 * zornUpper u2 = zornLower (cross3 u1 u2)`,
    2. **Dual Chiral Corner Folding (`𝔤_{-1} × 𝔤_{-1} → 𝔤_{+1}`)**:
       `zornLower v1 * zornLower v2 = zornUpper (cross3 v1 v2)`,
    3. **Non-Associative Scalar Triple Product Anomaly**:
       For any three upper-corner vectors `u1, u2, u3 : Fin 3 → B`, the Zorn
       associator `zornAssoc (zornUpper u1) (zornUpper u2) (zornUpper u3)` is purely
       diagonal (`u = 0, v = 0`), with upper-diagonal entry
       `a = dot3 u1 (cross3 u2 u3)` and lower-diagonal entry
       `b = - dot3 (cross3 u1 u2) u3`! -/
theorem zorn_triality_folding_and_associator_in_ring (u1 u2 u3 v1 v2 : Fin 3 → B) :
    zornUpper u1 * zornUpper u2 = zornLower (cross3 u1 u2) ∧
    zornLower v1 * zornLower v2 = zornUpper (cross3 v1 v2) ∧
    (zornAssoc (zornUpper u1) (zornUpper u2) (zornUpper u3)).a =
      dot3 u1 (cross3 u2 u3) ∧
    (zornAssoc (zornUpper u1) (zornUpper u2) (zornUpper u3)).b =
      - dot3 (cross3 u1 u2) u3 := by
  have mul_def (X Y : ZornOct B) : X * Y =
      mkZornOct (X.a * Y.a - dot3 X.u Y.v) (X.b * Y.b - dot3 X.v Y.u)
        (fun i => X.a * Y.u i + X.u i * Y.b + cross3 X.v Y.v i)
        (fun i => X.v i * Y.a + X.b * Y.v i + cross3 X.u Y.u i) := rfl
  have sub_def (X Y : ZornOct B) : X - Y =
      mkZornOct (X.a - Y.a) (X.b - Y.b) (fun i => X.u i - Y.u i) (fun i => X.v i - Y.v i) := rfl
  have h_uu : ∀ x y : Fin 3 → B, zornUpper x * zornUpper y = zornLower (cross3 x y) := by
    intro x y
    apply ZornOct.ext <;>
    · (try intro i)
      simp only [mul_def]
      dsimp [zornUpper, zornLower, mkZornOct, ZornOct.a, ZornOct.b, ZornOct.u, ZornOct.v]
      simp [cross3_zero, dot3_zero_right]
  have h_vv : ∀ x y : Fin 3 → B, zornLower x * zornLower y = zornUpper (cross3 x y) := by
    intro x y
    apply ZornOct.ext <;>
    · (try intro i)
      simp only [mul_def]
      dsimp [zornUpper, zornLower, mkZornOct, ZornOct.a, ZornOct.b, ZornOct.u, ZornOct.v]
      simp [cross3_zero, dot3_zero_left]
  refine ⟨h_uu u1 u2, h_vv v1 v2, ?_, ?_⟩
  · dsimp [zornAssoc]
    rw [h_uu u1 u2, h_uu u2 u3]
    simp only [mul_def, sub_def]
    dsimp [zornUpper, zornLower, mkZornOct, ZornOct.a, ZornOct.b, ZornOct.u, ZornOct.v]
    simp [dot3_zero_left]
  · dsimp [zornAssoc]
    rw [h_uu u1 u2, h_uu u2 u3]
    simp only [mul_def, sub_def]
    dsimp [zornUpper, zornLower, mkZornOct, ZornOct.a, ZornOct.b, ZornOct.u, ZornOct.v]
    simp [dot3_zero_right]

/-!
## Stage VI: Acyclic Causal Poset of the Wheeler–Single-Commutator–Zorn Synthesis
-/

/-- Nodes of the 10-stage Wheeler "It From Bit" & Single-Commutator causal poset. -/
inductive Node
  | primordialBinaryCut
  | twoFacesOperatorReality
  | singleCommutatorOscillator
  | cl11ZeroSumSquareBalance
  | cubicPartialIsometryEigenvalue
  | decadicResolventCrystal
  | bornJordanSchwingerQuantization
  | tomitaTakesakiBimoduleExpectation
  | pascualJordanTripleReproduction
  | zornTrialityAssociatorCrown
  deriving DecidableEq, Repr

/-- Topological causal rank in the 10-stage poset. -/
def rank : Node → ℕ
  | .primordialBinaryCut => 0
  | .twoFacesOperatorReality => 1
  | .singleCommutatorOscillator => 2
  | .cl11ZeroSumSquareBalance => 3
  | .cubicPartialIsometryEigenvalue => 4
  | .decadicResolventCrystal => 5
  | .bornJordanSchwingerQuantization => 6
  | .tomitaTakesakiBimoduleExpectation => 7
  | .pascualJordanTripleReproduction => 8
  | .zornTrialityAssociatorCrown => 9

/-- Directed causal cover edges of the 10-stage poset. -/
def coverEdge : Node → Node → Prop
  | .primordialBinaryCut, .twoFacesOperatorReality => True
  | .twoFacesOperatorReality, .singleCommutatorOscillator => True
  | .singleCommutatorOscillator, .cl11ZeroSumSquareBalance => True
  | .cl11ZeroSumSquareBalance, .cubicPartialIsometryEigenvalue => True
  | .cubicPartialIsometryEigenvalue, .decadicResolventCrystal => True
  | .decadicResolventCrystal, .bornJordanSchwingerQuantization => True
  | .bornJordanSchwingerQuantization, .tomitaTakesakiBimoduleExpectation => True
  | .tomitaTakesakiBimoduleExpectation, .pascualJordanTripleReproduction => True
  | .pascualJordanTripleReproduction, .zornTrialityAssociatorCrown => True
  | _, _ => False

/-- Every causal cover edge strictly increases the topological rank. -/
theorem coverEdge_strict_rank {u v : Node} (h : coverEdge u v) :
    rank u < rank v := by
  cases u <;> cases v <;> simp [coverEdge, rank] at h ⊢

/-- The causal cover relation is strictly irreflexive. -/
theorem coverEdge_irrefl (u : Node) : ¬ coverEdge u u := by
  intro h
  exact Nat.lt_irrefl (rank u) (coverEdge_strict_rank h)

/-- The causal cover relation is strictly asymmetric. -/
theorem coverEdge_asymm {u v : Node} (huv : coverEdge u v) : ¬ coverEdge v u := by
  intro hvu
  exact Nat.lt_asymm (coverEdge_strict_rank huv) (coverEdge_strict_rank hvu)

/-- **Inductive Colimit Cone Transport (`wheeler_single_commutator_resolvent_colimit_cone_transport`):**
    Under any compatible inductive ring cone `toLimit : ∀ k : ℕ, Stage k →+* Limit`
    (`toLimit (k + 1) (embed k Z) = toLimit k Z`), the single-commutator power ladder
    (`J_1, J_2`), Casimir bridge `Z_bridge`, and decadic resolvent crystal factorizations
    transport functorially from finite stage `Stage k` into `Limit`. -/
theorem wheeler_single_commutator_resolvent_colimit_cone_transport
    {Stage : ℕ → Type*} [∀ k, Ring (Stage k)]
    {Limit : Type*} [Ring Limit]
    (embed : ∀ k : ℕ, Stage k →+* Stage (k + 1))
    (toLimit : ∀ k : ℕ, Stage k →+* Limit)
    (hCone : ∀ (k : ℕ) (Z : Stage k), toLimit (k + 1) (embed k Z) = toLimit k Z)
    (k : ℕ) (P X : Stage k) (hP : P * P = P) :
    let P_inf := toLimit k P
    let X_inf := toLimit k X
    toLimit k (J_1 P X) = J_1 P_inf X_inf ∧
    toLimit k (J_2 P X) = J_2 P_inf X_inf ∧
    toLimit k (Z_bridge P X) = Z_bridge P_inf X_inf ∧
    toLimit (k + 1) (Z_bridge (embed k P) (embed k X)) = Z_bridge P_inf X_inf ∧
    J_1 P_inf X_inf * J_1 P_inf X_inf + J_2 P_inf X_inf * J_2 P_inf X_inf = 0 ∧
    (1 - J_1 P_inf X_inf) * (1 + J_1 P_inf X_inf) = 1 + Z_bridge P_inf X_inf ∧
    (1 - J_2 P_inf X_inf) * (1 + J_2 P_inf X_inf) = 1 - Z_bridge P_inf X_inf := by
  have hJ1 : toLimit k (J_1 P X) = J_1 (toLimit k P) (toLimit k X) := by
    dsimp [J_1, comm]
    simp only [map_sub, map_mul]
  have hJ2 : toLimit k (J_2 P X) = J_2 (toLimit k P) (toLimit k X) := by
    dsimp [J_2, J_1, comm]
    simp only [map_sub, map_mul]
  have hZb : toLimit k (Z_bridge P X) = Z_bridge (toLimit k P) (toLimit k X) := by
    dsimp [Z_bridge, V_P, Sigma_P, Q_pos, Q_neg, P_perp]
    simp only [map_add, map_mul, map_sub, map_one]
  have hZbEmb : toLimit (k + 1) (Z_bridge (embed k P) (embed k X)) =
      Z_bridge (toLimit k P) (toLimit k X) := by
    have hE : embed k (Z_bridge P X) = Z_bridge (embed k P) (embed k X) := by
      dsimp [Z_bridge, V_P, Sigma_P, Q_pos, Q_neg, P_perp]
      simp only [map_add, map_mul, map_sub, map_one]
    rw [← hE, hCone k, hZb]
  have hP_inf : toLimit k P * toLimit k P = toLimit k P := by
    rw [← map_mul, hP]
  have hLad := single_commutator_power_ladder hP_inf (toLimit k X)
  have hRes := decadic_single_commutator_resolvent_crystal hP_inf (toLimit k X)
  exact ⟨hJ1, hJ2, hZb, hZbEmb, hLad.2.2.2.1, hRes.1, hRes.2.1⟩

