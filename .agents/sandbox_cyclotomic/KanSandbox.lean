import Mathlib

/-!
# Sandbox: genuine Iwasawa `KAN` decomposition data for `SL(2, ℝ)`

This replaces the placeholder `IwasawaDecompositionData`, which stored three
real numbers `det_K`, `det_A`, `det_N` together with three *assumed* equations
`det_K = 1`, `det_A = 1`, `det_N = 1`.  Its "Theorem 12" therefore proved
`1 * 1 * 1 = 1` and carried no information about any group.

Here the three factors are the actual matrices, and the determinant-one statement
is *derived* from them:

* `kRot θ` is the rotation `exp (θ X_K)` with `X_K = [[0,-1],[1,0]]`, proved
  orthogonal with determinant one.
* `aDiag lam` is the hyperbolic element `exp (lam X_A)` with `X_A = [[1,0],[0,-1]]`,
  a positive diagonal matrix with determinant one.
* `nShear ξ` is the unipotent `exp (ξ X_N) = 1 + ξ X_N` with the strictly
  nilpotent `X_N`, whose inverse is `nShear (-ξ)`.

`kan_det` is the real content: the `KAN` product lands in `SL(2, ℝ)`.
-/

namespace KanTest

abbrev Mat2 := Matrix (Fin 2) (Fin 2) ℝ

/-! ### The nilpotent generator `X_N` and the unipotent sector `N` -/

/-- `X_N = s_+`, the strictly upper-triangular root. -/
def sPlus : Mat2 := !![0, 1; 0, 0]

/-- The nilpotency that makes `N` unipotent: `X_N ^ 2 = 0`. -/
theorem sPlus_sq : sPlus ^ 2 = 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sPlus, pow_two, Matrix.mul_apply, Matrix.zero_apply]

/-- The unipotent factor `N = exp (ξ X_N) = 1 + ξ X_N`. -/
def nShear (ξ : ℝ) : Mat2 := !![1, ξ; 0, 1]

/-- `N` really is `1 + ξ X_N`, i.e. it lies in the one-parameter unipotent
subgroup generated by the nilpotent `X_N`. -/
theorem nShear_eq_one_add_smul (ξ : ℝ) : nShear ξ = 1 + ξ • sPlus := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [nShear, sPlus, Matrix.add_apply, Matrix.smul_apply]

/-- `N` is invertible, with inverse `N(-ξ)`.  This is exactly the content of
`s₊² = 0`. -/
theorem nShear_mul_nShear_neg (ξ : ℝ) : nShear ξ * nShear (-ξ) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [nShear, Matrix.mul_apply, Matrix.one_apply]

theorem det_nShear (ξ : ℝ) : (nShear ξ).det = 1 := by
  rw [show (nShear ξ).det = (!![(1 : ℝ), ξ; 0, 1] : Mat2).det by rfl, Matrix.det_fin_two_of]
  ring

/-! ### The hyperbolic sector `A` -/

/-- `A = exp (lam X_A)`, the positive diagonal one-parameter subgroup. -/
noncomputable def aDiag (lam : ℝ) : Mat2 := !![Real.exp lam, 0; 0, Real.exp (-lam)]

/-- `A` is positive diagonal. -/
theorem aDiag_pos_diag (lam : ℝ) : 0 < (aDiag lam) 0 0 ∧ (aDiag lam) 1 1 > 0 := by
  constructor <;> simp [aDiag] <;> positivity

/-- `A` lies in `SL(2, ℝ)`: its determinant is one because `exp lam * exp (-lam) = 1`. -/
theorem det_aDiag (lam : ℝ) : (aDiag lam).det = 1 := by
  rw [show (aDiag lam).det = (!![Real.exp lam, 0; 0, Real.exp (-lam)] : Mat2).det by rfl,
    Matrix.det_fin_two_of]
  rw [← Real.exp_add]
  norm_num

/-! ### The elliptic sector `K` -/

/-- `K = exp (θ X_K)`, the rotation one-parameter subgroup. -/
noncomputable def kRot (θ : ℝ) : Mat2 :=
  !![Real.cos θ, -Real.sin θ; Real.sin θ, Real.cos θ]

/-- `K` lies in `SO(2)`: `Kᵀ * K = 1`. -/
theorem kRot_transpose_mul (θ : ℝ) : Matrix.transpose (kRot θ) * kRot θ = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [kRot, Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply]
  all_goals nlinarith [Real.sin_sq_add_cos_sq θ]

/-- `K` lies in `SL(2, ℝ)`. -/
theorem det_kRot (θ : ℝ) : (kRot θ).det = 1 := by
  rw [show (kRot θ).det
        = (!![Real.cos θ, -Real.sin θ; Real.sin θ, Real.cos θ] : Mat2).det by rfl,
      Matrix.det_fin_two_of]
  nlinarith [Real.sin_sq_add_cos_sq θ]

/-! ### The `KAN` product -/

/-- The `KAN` product `exp(θ X_K) * exp(lam X_A) * exp(ξ X_N)`. -/
noncomputable def kanMatrix (θ lam ξ : ℝ) : Mat2 := kRot θ * aDiag lam * nShear ξ

/-- **The genuine unimodular-product theorem.**  For every `(θ, lam, ξ)` the `KAN`
product has determinant one, so `kanMatrix` really lands in `SL(2, ℝ)`.

This is the statement the placeholder `IwasawaDecompositionData.unimodular_product`
only *assumed*: it stored `det_K = 1`, `det_A = 1`, `det_N = 1` as fields and
concluded `det_K * det_A * det_N = 1`.  Here the three factors are matrices and
the conclusion is derived from `Matrix.det_mul`. -/
theorem kan_det (θ lam ξ : ℝ) : (kanMatrix θ lam ξ).det = 1 := by
  rw [kanMatrix, Matrix.det_mul, Matrix.det_mul, det_kRot, det_aDiag, det_nShear]
  ring

/-- The explicit entries of the `KAN` product. -/
theorem kanMatrix_explicit (θ lam ξ : ℝ) :
    kanMatrix θ lam ξ
      = !![Real.cos θ * Real.exp lam,
          Real.cos θ * Real.exp lam * ξ - Real.sin θ * Real.exp (-lam);
          Real.sin θ * Real.exp lam,
          Real.sin θ * Real.exp lam * ξ + Real.cos θ * Real.exp (-lam)] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [kanMatrix, kRot, aDiag, nShear, Matrix.mul_apply] <;> ring

/-- At the origin of the parameter space every factor is the identity, so the
`KAN` chart really does pass through the identity of `SL(2, ℝ)`. -/
theorem kanMatrix_zero : kanMatrix 0 0 0 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [kanMatrix, kRot, aDiag, nShear, Matrix.mul_apply, Matrix.one_apply]

#print axioms kan_det

end KanTest
