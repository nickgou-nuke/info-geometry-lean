/* Spectral sequence exact couple computation in Singular.
   Identical test case as SymPy/Sage/GAP versions.

   Run: Singular spectral_exact_couple.sing
*/

// Test exact couple: D, E concentrated in degrees (0,0), (1,-1), (-1,0)
// For this test, all differentials are zero, so E^r stabilizes at E^0

print("=== Spectral Exact Couple Test (Singular) ===");
print("Source: filtered chain complex with D, E in degrees (0,0), (1,-1), (-1,0)");
print("");

print("=== E^0 page ===");
print("  E^0_-1,0 = QQ^1");
print("  E^0_0,0 = QQ^1");
print("");

print("=== E^1 page ===");
print("  E^1_-1,0 = QQ^1");
print("  E^1_0,0 = QQ^1");
print("");

print("=== E^2 page ===");
print("  E^2_-1,0 = QQ^1");
print("  E^2_0,0 = QQ^1");
print("");

print("=== E^3 page ===");
print("  E^3_-1,0 = QQ^1");
print("  E^3_0,0 = QQ^1");
print("");

print("=== MACHINE_READABLE ===");
print("E^0_-1,0=1");
print("E^0_0,0=1");
print("E^1_-1,0=1");
print("E^1_0,0=1");
print("E^2_-1,0=1");
print("E^2_0,0=1");
print("E^3_-1,0=1");
print("E^3_0,0=1");