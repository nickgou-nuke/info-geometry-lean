import InfoGeometry.OperatorAlgebra.PeirceSpine.Supercharge

/-!
# Peirce spine A₃₃–A₃₄: orientation grading, half-twist sandwiches, Hodge conjugation

Left multiplication by the grading `S = P - (1 - P)` is written `⋆`.

* A₃₃: `⋆⋆ = id`; `⋆` swaps `V ↔ Σ` and `Φ ↔ J`. Sandwiching by `Φ`
  (or by `J` with `-J` on the right) sends `V ↦ V²`, `Σ ↦ -(V Σ)` and `S ↦ -(V S)`.
  Sandwiching by `Σ = J Φ` sends `V ↦ V³`, `Σ ↦ V² Σ` and `S ↦ V² S`.
* A₃₄: the codifferentials are Hodge conjugates of the derivations:
  `d̄ = -⋆ d ⋆` and `d = -⋆ d̄ ⋆`, for `N₊, N₋, Φ, J`. Hence the Laplacian
  `{d_Φ, d̄_Φ}` is generated by `d_Φ` and `⋆` alone.

**Corrections to the intake.** A random `6 × 6` numerical model refutes two
candidate conjuncts:

* `{d_Φ, d̄_Φ}(X) = 2 V X` is false; the correct form is `2 (V X + X V)`;
* `⋆{d_Φ, d̄_Φ}(X) = 2 Σ X` is false; the correct form is `2 (Σ X + S X V)`.

The words orientation, Möbius and Hodge are only reading aids. The theorems are
identities in the ring `B`. The general operator-ring form, for any
involution and any odd element, is in
`InfoGeometry.OperatorAlgebra.SquareZeroPairSpectral.Orientation`. The
dictionary between the two is in `PeirceSpine.Bridge`.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine

variable {B : Type*} [Ring B]

/-- `⋆ X = S X`. -/
def hodgeStar (P X : B) : B := invS P * X
/-- `d̄_Φ = d̄₊ + d̄₋`. -/
def superDerivPhiBar (P A C X : B) : B := superDerivPlusBar P A X + superDerivMinusBar P C X
/-- `d̄_J = d̄₊ - d̄₋`. -/
def superDerivJBar (P A C X : B) : B := superDerivPlusBar P A X - superDerivMinusBar P C X
/-- The Laplacian `{d_Φ, d̄_Φ}`. -/
def hodgeLaplacianPhi (P A C X : B) : B :=
  superDerivPhi P A C (superDerivPhiBar P A C X) + superDerivPhiBar P A C (superDerivPhi P A C X)

variable {P : B} (hP : P * P = P)
include hP

/-! ### A₃₃ -/

theorem archetype_A33_hodge_star_and_half_twists (A C X : B) :
    hodgeStar P (hodgeStar P X) = X ∧
    hodgeStar P (genV P A C) = genSig P A C ∧
    hodgeStar P (genSig P A C) = genV P A C ∧
    hodgeStar P (genPhi P A C) = genJ P A C ∧
    hodgeStar P (genJ P A C) = genPhi P A C ∧
    genPhi P A C * genV P A C * genPhi P A C = genV P A C * genV P A C ∧
    genPhi P A C * genSig P A C * genPhi P A C = -(genV P A C * genSig P A C) ∧
    genPhi P A C * invS P * genPhi P A C = -(genV P A C * invS P) ∧
    genJ P A C * genV P A C * (-genJ P A C) = genV P A C * genV P A C ∧
    genJ P A C * genSig P A C * (-genJ P A C) = -(genV P A C * genSig P A C) ∧
    genJ P A C * invS P * (-genJ P A C) = -(genV P A C * invS P) ∧
    genSig P A C * genV P A C * genSig P A C = genV P A C * genV P A C * genV P A C ∧
    genSig P A C * genSig P A C * genSig P A C = genV P A C * genV P A C * genSig P A C ∧
    genSig P A C * invS P * genSig P A C = genV P A C * genV P A C * invS P := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    ((try simp only [hodgeStar]); peirce_nf hP)

/-- The double loop: sandwiching by `Φ` and then by `J` is sandwiching by `Σ`. -/
theorem double_half_twist_eq_spin_sandwich (A C X : B) :
    genJ P A C * (genPhi P A C * X * genPhi P A C) * (-genJ P A C) =
      genSig P A C * X * genSig P A C := by
  peirce_nf hP

/-! ### A₃₄ -/

theorem archetype_A34_hodge_conjugate_codifferentials (A C X : B) :
    superDerivPlusBar P A X = -hodgeStar P (superDerivPlus P A (hodgeStar P X)) ∧
    superDerivMinusBar P C X = -hodgeStar P (superDerivMinus P C (hodgeStar P X)) ∧
    superDerivPhiBar P A C X = -hodgeStar P (superDerivPhi P A C (hodgeStar P X)) ∧
    superDerivJBar P A C X = -hodgeStar P (superDerivJ P A C (hodgeStar P X)) ∧
    superDerivPhi P A C X = -hodgeStar P (superDerivPhiBar P A C (hodgeStar P X)) ∧
    superDerivJ P A C X = -hodgeStar P (superDerivJBar P A C (hodgeStar P X)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    ((try simp only [hodgeStar, superDerivPhiBar, superDerivJBar, superDerivPhi, superDerivJ,
      superDerivPlus, superDerivMinus, superDerivPlusBar, superDerivMinusBar, parityConj]);
      peirce_nf hP)

/-- Corrected Laplacian: `{d_Φ, d̄_Φ} = 2 (V X + X V)`. -/
theorem hodgeLaplacianPhi_eq (A C X : B) :
    hodgeLaplacianPhi P A C X = (2 : ℤ) • (genV P A C * X + X * genV P A C) := by
  simp only [hodgeLaplacianPhi, superDerivPhiBar, superDerivPhi, superDerivPlus,
    superDerivMinus, superDerivPlusBar, superDerivMinusBar, parityConj]
  peirce_nf hP

/-- The left-only Laplacian formula holds at an input precisely when its
omitted right-multiplication term is killed by doubling. -/
theorem hodgeLaplacianPhi_left_only_iff (A C X : B) :
    hodgeLaplacianPhi P A C X = (2 : ℤ) • (genV P A C * X) ↔
      (2 : ℤ) • (X * genV P A C) = 0 := by
  rw [hodgeLaplacianPhi_eq hP]
  simp only [two_zsmul]
  rw [add_add_add_comm, add_eq_left]

/-- Requiring the submitted left-only formula on the whole operator ring
is equivalent to `2V = 0`, not to `V = 0` in arbitrary characteristic. -/
theorem hodgeLaplacianPhi_left_only_forall_iff (A C : B) :
    (∀ X : B, hodgeLaplacianPhi P A C X =
      (2 : ℤ) • (genV P A C * X)) ↔ (2 : ℤ) • genV P A C = 0 := by
  constructor
  · intro h
    simpa only [one_mul] using (hodgeLaplacianPhi_left_only_iff hP A C 1).1 (h 1)
  · intro h X
    apply (hodgeLaplacianPhi_left_only_iff hP A C X).2
    rw [← mul_smul_comm, h, mul_zero]

/-- Adding twice the inner derivation isolates left multiplication by `4V`.
This is the characteristic-free replacement for the intake's claim that the
Laplacian alone is left multiplication by `2V`. -/
theorem hodgeLaplacianPhi_add_connection (A C X : B) :
    hodgeLaplacianPhi P A C X + (2 : ℤ) • connV P A C X =
      (4 : ℤ) • (genV P A C * X) := by
  rw [hodgeLaplacianPhi_eq hP]
  simp only [connV, comm]
  abel

/-- Subtracting twice the inner derivation isolates right multiplication by
`4V`, retaining the order of the ambient noncommutative ring. -/
theorem hodgeLaplacianPhi_sub_connection (A C X : B) :
    hodgeLaplacianPhi P A C X - (2 : ℤ) • connV P A C X =
      (4 : ℤ) • (X * genV P A C) := by
  rw [hodgeLaplacianPhi_eq hP]
  simp only [connV, comm]
  abel

/-- The same Laplacian generated by `d_Φ` and `⋆` alone. -/
theorem hodgeLaplacianPhi_from_star (A C X : B) :
    -superDerivPhi P A C (hodgeStar P (superDerivPhi P A C (hodgeStar P X))) -
        hodgeStar P (superDerivPhi P A C (hodgeStar P (superDerivPhi P A C X))) =
      (2 : ℤ) • (genV P A C * X + X * genV P A C) := by
  simp only [hodgeStar, superDerivPhi, superDerivPlus, superDerivMinus, parityConj]
  peirce_nf hP

/-- Corrected Hodge dual of the Laplacian: `⋆{d_Φ, d̄_Φ} X = 2 (Σ X + S X V)`. -/
theorem hodgeStar_hodgeLaplacianPhi (A C X : B) :
    hodgeStar P (hodgeLaplacianPhi P A C X) =
      (2 : ℤ) • (genSig P A C * X + invS P * X * genV P A C) := by
  rw [hodgeLaplacianPhi_eq hP]
  simp only [hodgeStar]
  peirce_nf hP

end InfoGeometry.OperatorAlgebra.PeirceSpine
