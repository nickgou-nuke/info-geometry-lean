import InfoGeometry.Canonical.RelativePotentialDiscreteBridge
import InfoGeometry.Canonical.SinkhornKMSCore
import InfoGeometry.Meta.Architecture

/-!
# InfoGeometry.Canonical.RelativePotentialCountBridge

Discrete count-side representation of the projective/affine relative-potential
spine.

This file keeps the raw finite-count presentation available while making its
status explicit: raw count ratios are representative-level objects, whereas the
canonical projective relative density is obtained only after quotienting by
positive rescaling and taking the canonical gauge.
-/

open scoped BigOperators

namespace InfoGeometry.Canonical.RelativePotentialCountBridge

open InfoGeometry.Canonical.PositiveRayCore
open InfoGeometry.Canonical.RelativePotentialCore
open InfoGeometry.Canonical.KMSSinkhornBridge
open InfoGeometry.Krein

universe u

section Counts

variable (n : Nat)

/-- Relative-count profile over a finite sample index set. -/
abbrev RelativeCounts := Fin n → ℝ

/-- Raw relative count ratio. This is a representative-level density. -/
noncomputable def relativeCountDensity
    (counts ref : RelativeCounts n) : Fin n → ℝ :=
  fun i => counts i / ref i

/-- Pointwise logarithm of the raw relative count ratio. -/
@[rep_depth count]
noncomputable def relativeCountLogDensity
    (counts ref : RelativeCounts n) : Fin n → ℝ :=
  fun i => Real.log (relativeCountDensity n counts ref i)

/-- Mean log-relative density (finite-sample modular log-density). -/
noncomputable def relativeLogDensityMean (ρ : Fin n → ℝ) : ℝ :=
  (n : ℝ)⁻¹ * ∑ i : Fin n, Real.log (ρ i)

/-- Relative modular Hamiltonian: negative mean log-relative density. -/
noncomputable def relativeModularHamiltonian (ρ : Fin n → ℝ) : ℝ :=
  -relativeLogDensityMean n ρ

/--
Tomita-Takesaki-style operator generated by the relative modular Hamiltonian on
the doubled router-amplitude space.
-/
noncomputable def relativeTomitaTakesakiOp
    (ρ : Fin n → ℝ) : AlgebraEnd (RouterAmplitude n) :=
  relativeModularHamiltonian n ρ •
    ContinuousLinearMap.id ℝ (DoubledSpace (RouterAmplitude n))

@[simp] lemma relativeTomitaTakesakiOp_apply
    (ρ : Fin n → ℝ) (v : DoubledSpace (RouterAmplitude n)) :
    relativeTomitaTakesakiOp n ρ v = relativeModularHamiltonian n ρ • v := by
  simp [relativeTomitaTakesakiOp]

/--
Generalized chain rule on relative densities: log-density means add under
pointwise multiplicative composition.
-/
lemma relativeLogDensityMean_mul
    (ρ σ : Fin n → ℝ)
    (hρ : ∀ i : Fin n, ρ i ≠ 0)
    (hσ : ∀ i : Fin n, σ i ≠ 0) :
    relativeLogDensityMean n (fun i => ρ i * σ i)
      = relativeLogDensityMean n ρ + relativeLogDensityMean n σ := by
  unfold relativeLogDensityMean
  have hsum :
      (∑ i : Fin n, Real.log (ρ i * σ i))
        = ∑ i : Fin n, (Real.log (ρ i) + Real.log (σ i)) := by
    refine Finset.sum_congr rfl ?_
    intro i hi
    exact Real.log_mul (hρ i) (hσ i)
  rw [hsum, Finset.sum_add_distrib, mul_add]

end Counts

section PositiveCounts

variable {n : Nat} [Nonempty (Fin n)]

/-- Positive count profile realized as a `PositiveMeasure`. -/
def positiveMeasureOfCounts
    (counts : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i) :
    InfoGeometry.PositiveMeasure (Fin n) ℝ where
  mass := counts
  pos := hcounts

/-- Total mass of a strictly positive count profile. -/
noncomputable def countMass
    (counts : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i) : ℝ :=
  InfoGeometry.PositiveMeasure.Z (positiveMeasureOfCounts counts hcounts)

lemma countMass_pos
    (counts : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i) :
    0 < countMass counts hcounts := by
  unfold countMass
  exact InfoGeometry.PositiveMeasure.Z_pos (positiveMeasureOfCounts counts hcounts)

lemma countMass_ne_zero
    (counts : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i) :
    countMass counts hcounts ≠ 0 :=
  (countMass_pos counts hcounts).ne'

/-- Projective positive state carried by a positive count profile. -/
noncomputable def countRay
    (counts : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i) : PositiveRay (Fin n) :=
  Quotient.mk _ (positiveMeasureOfCounts counts hcounts)

@[simp] theorem gaugeSection_countRay_apply
    (counts : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i)
    (i : Fin n) :
    gaugeSection (α := Fin n) (countRay counts hcounts) i
      = counts i / countMass counts hcounts := by
  simpa [countRay, countMass, positiveMeasureOfCounts] using
    congrArg (fun f => f i)
      (gaugeSection_mk (α := Fin n) (μ := positiveMeasureOfCounts counts hcounts))

@[simp] theorem relativeDensity_countRay_eq_massRatio_mul_relativeCountDensity
    (counts ref : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i)
    (href : ∀ i : Fin n, 0 < ref i)
    (i : Fin n) :
    relativeDensity (α := Fin n) (countRay counts hcounts) (countRay ref href) i
      = (countMass ref href / countMass counts hcounts)
          * relativeCountDensity n counts ref i := by
  unfold relativeDensity representativeRelativeDensity relativeCountDensity
  rw [gaugeSection_countRay_apply (counts := counts) (hcounts := hcounts) (i := i)]
  rw [gaugeSection_countRay_apply (counts := ref) (hcounts := href) (i := i)]
  have hzc : countMass counts hcounts ≠ 0 := countMass_ne_zero counts hcounts
  have hzr : countMass ref href ≠ 0 := countMass_ne_zero ref href
  have hci : counts i ≠ 0 := (hcounts i).ne'
  have hri : ref i ≠ 0 := (href i).ne'
  field_simp [hzc, hzr, hci, hri]

@[simp] theorem relativeLogDensity_countRay_eq_relativeCountLogDensity_add_massShift
    (counts ref : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i)
    (href : ∀ i : Fin n, 0 < ref i)
    (i : Fin n) :
    relativeLogDensity (α := Fin n) (countRay counts hcounts) (countRay ref href) i
      = relativeCountLogDensity n counts ref i
        + Real.log (countMass ref href / countMass counts hcounts) := by
  rw [relativeLogDensity_eq_logDensity_sub_logDensity]
  unfold InfoGeometry.Canonical.PositiveRayCore.logDensity relativeCountLogDensity relativeCountDensity
  rw [gaugeSection_countRay_apply (counts := counts) (hcounts := hcounts) (i := i)]
  rw [gaugeSection_countRay_apply (counts := ref) (hcounts := href) (i := i)]
  have hzc : countMass counts hcounts ≠ 0 := countMass_ne_zero counts hcounts
  have hzr : countMass ref href ≠ 0 := countMass_ne_zero ref href
  rw [Real.log_div ((hcounts i).ne') hzc]
  rw [Real.log_div ((href i).ne') hzr]
  rw [Real.log_div ((hcounts i).ne') ((href i).ne')]
  rw [Real.log_div hzr hzc]
  ring_nf

@[simp] theorem relativeModularPotential_countRay_eq_neg_relativeCountLogDensity_add_massShift
    (counts ref : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i)
    (href : ∀ i : Fin n, 0 < ref i)
    (i : Fin n) :
    relativeModularPotential (α := Fin n) (countRay counts hcounts) (countRay ref href) i
      = -relativeCountLogDensity n counts ref i
        + Real.log (countMass counts hcounts / countMass ref href) := by
  rw [relativeModularPotential_eq_logDensity_base_sub_logDensity]
  unfold InfoGeometry.Canonical.PositiveRayCore.logDensity relativeCountLogDensity relativeCountDensity
  rw [gaugeSection_countRay_apply (counts := ref) (hcounts := href) (i := i)]
  rw [gaugeSection_countRay_apply (counts := counts) (hcounts := hcounts) (i := i)]
  have hzc : countMass counts hcounts ≠ 0 := countMass_ne_zero counts hcounts
  have hzr : countMass ref href ≠ 0 := countMass_ne_zero ref href
  rw [Real.log_div ((href i).ne') hzr]
  rw [Real.log_div ((hcounts i).ne') hzc]
  rw [Real.log_div ((hcounts i).ne') ((href i).ne')]
  rw [Real.log_div hzc hzr]
  ring_nf

/--
The projective logarithmic generator on positive count rays is exactly the raw
count-side modular potential together with the expected global mass-shift.
-/
@[simp] theorem projectiveLogGenerator_countRay_eq_neg_relativeCountLogDensity_add_massShift
    (counts ref : RelativeCounts n)
    (hcounts : ∀ i : Fin n, 0 < counts i)
    (href : ∀ i : Fin n, 0 < ref i)
    (i : Fin n) :
    InfoGeometry.MeasureProjective.ProjectiveState.logGenerator
        (InfoGeometry.Canonical.RelativePotentialDiscreteBridge.toProjectiveState
          (α := Fin n) (countRay ref href))
        (InfoGeometry.Canonical.RelativePotentialDiscreteBridge.toProjectiveState
          (α := Fin n) (countRay counts hcounts)) i
      = -relativeCountLogDensity n counts ref i
        + Real.log (countMass counts hcounts / countMass ref href) := by
  rw [InfoGeometry.Canonical.RelativePotentialDiscreteBridge.projectiveLogGenerator_eq_relativeModularPotential
    (α := Fin n) (q := countRay counts hcounts) (q0 := countRay ref href) (a := i)]
  exact relativeModularPotential_countRay_eq_neg_relativeCountLogDensity_add_massShift
    (n := n) (counts := counts) (ref := ref) (hcounts := hcounts) (href := href) (i := i)

end PositiveCounts

end InfoGeometry.Canonical.RelativePotentialCountBridge
