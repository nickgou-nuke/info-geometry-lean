{"type":"new","contents":"import InfoGeometry.Canonical.TimeReversalKramers\nimport InfoGeometry.Canonical.BogoliubovTransport\nimport InfoGeometry.Meta.Architecture\n\nopen scoped InnerProductSpace\n\n/-!\n# InfoGeometry.Canonical.ModularKramersBridge\n\nBridge the doubled-real Kramers lane to modular conjugation/flow fixed sectors.\n\nThis file stays in the repo-native language `(H₂, J, ε, K)`:\n- `J` from `modular_j`,\n- `K = J ∘ ε` from `phaseAxisK`,\n- Kramers symmetry as real-linear/Krein-isometric/phase-antilinear.\n-/\n\nnamespace InfoGeometry.Canonical.ModularKramersBridge\n\nopen InfoGeometry.Krein\nopen InfoGeometry.Canonical.HestenesRealStructures\nopen InfoGeometry.Canonical.TimeReversalKramers\nopen InfoGeometry.Canonical.OperatorDictionary\nopen InfoGeometry.Canonical.BogoliubovTransport\n\nsection Core\n\nvariable {E : Type 0}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\n\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : CompleteSpace EndH := inferInstance\nlocal instance : SMulCommClass ℝ EndH EndH := inferInstance\nlocal instance : IsScalarTower ℝ EndH EndH := inferInstance\n\n/-- Fixed-point predicate for a doubled-carrier operator action. -/\n@[rep_depth krein]\ndef IsFixedBy (U : EndH) (u : H₂) : Prop := U u = u\n\n/-- Fixed-point predicate for the modular transport flow generated by `hMod`. -/\n@[rep_depth transport]\ndef IsFixedByModularFlow (hMod : EndH) (u : H₂) : Prop :=\n  ∀ t : ℝ, modularTransportFlow (E := E) hMod t u = u\n\n/--\nIf `Θ` commutes with modular conjugation `J`, it preserves the `J`-fixed sector.\n-/\n@[rep_depth krein]\ntheorem kramers_preserves_modularConjugation_fixed_of_commute\n    (S : KramersSymmetry (E := E))\n    (hJ : Commute S.Θ (modular_j (E := E)))\n    {u : H₂}\n    (hu : IsFixedBy (modular_j (E := E)) u) :\n    IsFixedBy (modular_j (E := E)) (S.Θ u) := by\n  unfold IsFixedBy at hu ⊢\n  calc\n    modular_j (E := E) (S.Θ u) = ((modular_j (E := E)) * S.Θ) u := rfl\n    _ = (S.Θ * (modular_j (E := E))) u := by rw [hJ.eq]\n    _ = S.Θ ((modular_j (E := E)) u) := rfl\n    _ = S.Θ u := by rw [hu]\n\n/--\nIf `Θ` commutes pointwise with the modular flow, it preserves modular-flow\nfixed vectors.\n-/\n@[rep_depth transport]\ntheorem kramers_preserves_modularFlow_fixed_of_commute\n    (S : KramersSymmetry (E := E))\n    (hMod : EndH)\n    (hComm : ∀ t : ℝ, Commute S.Θ (modularTransportFlow (E := E) hMod t))\n    {u : H₂}\n    (hu : IsFixedByModularFlow (E := E) hMod u) :\n    IsFixedByModularFlow (E := E) hMod (S.Θ u) := by\n  intro t\n  have hCommT : Commute S.Θ (modularTransportFlow (E := E) hMod t) := hComm t\n  have huT : modularTransportFlow (E := E) hMod t u = u := hu t\n  calc\n    modularTransportFlow (E := E) hMod t (S.Θ u)\n        = ((modularTransportFlow (E := E) hMod t) * S.Θ) u := rfl\n    _ = (S.Θ * modularTransportFlow (E := E) hMod t) u := by\n          rw [hCommT.eq]\n    _ = S.Θ (modularTransportFlow (E := E) hMod t u) := rfl\n    _ = S.Θ u := by rw [huT]\n\n/--\nCapstone API name: if `Θ` commutes with the modular-flow generator, then `Θ`\ncommutes with the full modular flow.\n-/\n@[rep_depth transport]\ntheorem theta_commutes_modularFlow_of_commute_generator\n    (S : KramersSymmetry (E := E))\n    (hMod : EndH)\n    (hCommGen : Commute S.Θ (modularTransportGenerator (E := E) hMod)) :\n    ∀ t : ℝ, Commute S.Θ (modularTransportFlow (E := E) hMod t) := by\n  intro t\n  simpa [modularTransportFlow] using ((hCommGen.smul_right t).exp_right)\n\n/--\nCapstone API name: if `Θ` commutes pointwise with modular flow, `Θ` preserves\nthe modular fixed sector.\n-/\n@[rep_depth transport]\ntheorem theta_preserves_modular_fixedSector_of_commute_flow\n    (S : KramersSymmetry (E := E))\n    (hMod : EndH)\n    (hComm : ∀ t : ℝ, Commute S.Θ (modularTransportFlow (E := E) hMod t))\n    {u : H₂}\n    (hu : IsFixedByModularFlow (E := E) hMod u) :\n    IsFixedByModularFlow (E := E) hMod (S.Θ u) :=\n  kramers_preserves_modularFlow_fixed_of_commute\n    (E := E) (S := S) (hMod := hMod) hComm hu\n\n/--\nIf the Majorana involution `C` commutes pointwise with modular flow, then the\nMajorana fixed sector is preserved by modular transport.\n-/\n@[rep_depth transport]\ntheorem majoranaFix_preserved_under_modularFlow_of_commute_C\n    (M : MajoranaRealStructure (E := E))\n    (hMod : EndH)\n    (hComm : ∀ t : ℝ, Commute M.C (modularTransportFlow (E := E) hMod t))\n    {u : H₂}\n    (hu : M.IsMajorana u) :\n    ∀ t : ℝ, M.IsMajorana (modularTransportFlow (E := E) hMod t u) := by\n  intro t\n  unfold MajoranaRealStructure.IsMajorana at hu ⊢\n  have hCommT : Commute M.C (modularTransportFlow (E := E) hMod t) := hComm t\n  calc\n    M.C (modularTransportFlow (E := E) hMod t u)\n        = ((M.C) * modularTransportFlow (E := E) hMod t) u := rfl\n    _ = (modularTransportFlow (E := E) hMod t * M.C) u := by\n          rw [hCommT.eq]\n    _ = modularTransportFlow (E := E) hMod t (M.C u) := rfl\n    _ = modularTransportFlow (E := E) hMod t u := by rw [hu]\n\nomit [CompleteSpace E] in\n/--\nIf the modular seed is phase-linear, the exact modular transport flow commutes\nwith the internal phase axis `K = J ∘ ε`.\n-/\n@[rep_depth transport]\ntheorem phaseAxisK_commutes_modularFlow_of_IsPhaseLinear\n    (hMod : EndH)\n    (hPhase : IsPhaseLinear (E := E) hMod)\n    (t : ℝ) :\n    Commute (phaseAxisK (E := E)) (modularTransportFlow (E := E) hMod t) := by\n  show (phaseAxisK (E := E)) * modularTransportFlow (E := E) hMod t =\n      modularTransportFlow (E := E) hMod t * (phaseAxisK (E := E))\n  simpa [phaseAxisK] using\n    (complex_i_comp_modularTransportFlow_eq_modularTransportFlow_comp_complex_i_of_IsPhaseLinear\n      (E := E) hMod hPhase t)\n\n/--\nIf `Θ` commutes with modular conjugation `J`, Kramers pairing is equivariant\nunder `J` on the doubled carrier.\n-/\n@[rep_depth krein]\ntheorem modularConjugation_equivariant_kramersPair_of_commute\n    (S : KramersSymmetry (E := E))\n    (hJ : Commute S.Θ (modular_j (E := E)))\n    (u : H₂) :\n    (modular_j (E := E) (S.pair u).1, modular_j (E := E) (S.pair u).2)\n      =\n    S.pair (modular_j (E := E) u) := by\n  refine Prod.ext ?_ ?_\n  · rfl\n  ·\n    calc\n      modular_j (E := E) (S.pair u).2\n          = modular_j (E := E) (S.Θ u) := by rfl\n      _ = ((modular_j (E := E)) * S.Θ) u := rfl\n      _ = (S.Θ * (modular_j (E := E))) u := by rw [hJ.eq]\n      _ = S.Θ (modular_j (E := E) u) := rfl\n      _ = (S.pair (modular_j (E := E) u)).2 := by rfl\n\nend Core\n\nend InfoGeometry.Canonical.ModularKramersBridge\n","mtime":1777199300154}