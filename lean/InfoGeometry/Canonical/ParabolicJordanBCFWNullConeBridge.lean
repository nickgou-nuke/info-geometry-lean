import InfoGeometry.Krein.KreinJordanSpectralObstructions
import InfoGeometry.Canonical.PeirceBCFWKinematicBridge

/-!
# InfoGeometry.Canonical.ParabolicJordanBCFWNullConeBridge

Welds the concrete `2 × 2` Krein/Jordan spectral obstruction witnesses in
`InfoGeometry.Krein.KreinJordanSpectralObstructions` directly into the
Peirce–Klein null-cone bilinear form `peirceKinematicForm` and BCFW on-shell
shifts (`shiftedPi`, `shiftedPj`, `shiftedChannel`) from
`InfoGeometry.Canonical.PeirceBCFWKinematicBridge` and
`InfoGeometry.Canonical.BCFWOnShellShift`:

1. **Nullity & Orthogonality of Peirce/Jordan Witnesses**:
   `peirceCutP0`, `jordanNilpotent`, and `outwardNilpotentX` all lie on the
   `peirceKinematicForm` null cone (`peirceKinematicForm p p = 0`), with
   `peirceCutP0` orthogonal to both `jordanNilpotent` and `outwardNilpotentX`,
   while `(jordanNilpotent, outwardNilpotentX)` form a non-orthogonal dual null
   pair (`peirceKinematicForm N X = -1/2 ≠ 0`).
2. **Oblique Dual Blow-Up & Parabolic Coalescence as Exact BCFW Null Rays**:
   Both the p. 444 oblique Markushevich projector `obliqueProj θ` and the
   p. 451 rank-1 spectral projector `jordanSpectralProj ρ₁ ρ₂` are literally
   BCFW shifts `shiftedPi (complexifiedChannel peirceCutP0) (complexifiedChannel jordanNilpotent) z`
   at `z = -(cos θ / sin θ)` and `z = (ρ₁ - ρ₂)⁻¹`, hence remain identically
   on-shell (`peirceKinematicForm = 0`) for every parameter value even as their
   Frobenius norm blows up.
3. **Krein Signature Invariance Under Walsh Rotation**:
   Both `kreinPolarityMat = diag(1, -1)` and its Walsh rotation
   `walshMat * kreinPolarityMat * walshMat = kreinSwapMat` have identical
   `peirceKinematicForm` quadratic value `-1`, contrasting with the `2 → 0`
   diagonal-sum drop in `errata_F8_walsh_basis_dependence`.
4. **Affine Channel Pole & Parabolic Coalescence Invariance**:
   Shifting `outwardNilpotentX` along `jordanNilpotent` produces an exact
   affine BCFW channel quadratic `peirceKinematicForm (shiftedChannel X N z) = -z`
   (simple zero at `z = 0`), whereas the coalesced Jordan block
   `jordanApproachMat ρ ρ = ρ • 1 + N` preserves the exact quadratic value `ρ²`.
-/

namespace InfoGeometry.Canonical.ParabolicJordanBCFWNullConeBridge

open InfoGeometry.Canonical
open InfoGeometry.Krein.KreinJordanSpectralObstructions

/-! ## 1. Null-cone membership and bilinear pairings of the `2 × 2` witnesses -/

theorem complexifiedChannel_peirceCutP0_null :
    peirceKinematicForm (complexifiedChannel peirceCutP0)
      (complexifiedChannel peirceCutP0) = 0 := by
  rw [peirceKinematicForm_self]
  simp [complexifiedChannel, complexifyChannelCoordinates, channelCoordinates, peirceCutP0]

theorem complexifiedChannel_jordanNilpotent_null :
    peirceKinematicForm (complexifiedChannel jordanNilpotent)
      (complexifiedChannel jordanNilpotent) = 0 := by
  rw [peirceKinematicForm_self]
  simp [complexifiedChannel, complexifyChannelCoordinates, channelCoordinates, jordanNilpotent]

theorem complexifiedChannel_outwardNilpotentX_null :
    peirceKinematicForm (complexifiedChannel outwardNilpotentX)
      (complexifiedChannel outwardNilpotentX) = 0 := by
  rw [peirceKinematicForm_self]
  simp [complexifiedChannel, complexifyChannelCoordinates, channelCoordinates, outwardNilpotentX]

theorem complexifiedChannel_peirceCutP0_orth_jordanNilpotent :
    peirceKinematicForm (complexifiedChannel peirceCutP0)
      (complexifiedChannel jordanNilpotent) = 0 := by
  simp [peirceKinematicForm, LinearMap.mk₂_apply, complexifiedChannel,
    complexifyChannelCoordinates, channelCoordinates, peirceCutP0, jordanNilpotent]

theorem complexifiedChannel_peirceCutP0_orth_outwardNilpotentX :
    peirceKinematicForm (complexifiedChannel peirceCutP0)
      (complexifiedChannel outwardNilpotentX) = 0 := by
  simp [peirceKinematicForm, LinearMap.mk₂_apply, complexifiedChannel,
    complexifyChannelCoordinates, channelCoordinates, peirceCutP0, outwardNilpotentX]

/-- `jordanNilpotent` (`e₁₂`) and `outwardNilpotentX` (`e₂₁`) are dual null
vectors with nonzero pairing `-1/2`. -/
theorem complexifiedChannel_jordanNilpotent_outwardNilpotentX_pairing :
    peirceKinematicForm (complexifiedChannel jordanNilpotent)
      (complexifiedChannel outwardNilpotentX) = -(1 / 2 : ℂ) := by
  simp [peirceKinematicForm, LinearMap.mk₂_apply, complexifiedChannel,
    complexifyChannelCoordinates, channelCoordinates, jordanNilpotent, outwardNilpotentX]

/-! ## 2. Exact BCFW on-shell shifts generated by `peirceCutP0` and `jordanNilpotent` -/

theorem peirceCutP0_bcfw_shift_jordanNilpotent_null (z : ℂ) :
    peirceKinematicForm
      (shiftedPi (complexifiedChannel peirceCutP0) (complexifiedChannel jordanNilpotent) z)
      (shiftedPi (complexifiedChannel peirceCutP0) (complexifiedChannel jordanNilpotent) z) = 0 :=
  bcfw_shift_left_null peirceKinematicForm peirceKinematicForm_isSymm
    (complexifiedChannel peirceCutP0) (complexifiedChannel jordanNilpotent) z
    complexifiedChannel_peirceCutP0_null
    complexifiedChannel_jordanNilpotent_null
    complexifiedChannel_peirceCutP0_orth_jordanNilpotent

theorem peirceCutP0_bcfw_shift_outwardNilpotentX_null (z : ℂ) :
    peirceKinematicForm
      (shiftedPj (complexifiedChannel peirceCutP0) (complexifiedChannel outwardNilpotentX) z)
      (shiftedPj (complexifiedChannel peirceCutP0) (complexifiedChannel outwardNilpotentX) z) = 0 :=
  bcfw_shift_right_null peirceKinematicForm peirceKinematicForm_isSymm
    (complexifiedChannel peirceCutP0) (complexifiedChannel outwardNilpotentX) z
    complexifiedChannel_peirceCutP0_null
    complexifiedChannel_outwardNilpotentX_null
    complexifiedChannel_peirceCutP0_orth_outwardNilpotentX

/-! ## 3. Oblique projector `Ω_θ` and spectral projector `P_{ρ₁}` as BCFW null rays -/

/-- The p. 444 oblique Markushevich projector `obliqueProj θ` is identically the
BCFW shift of `peirceCutP0` along `jordanNilpotent` with shift parameter
`z = -(cos θ / sin θ)`. -/
theorem complexifiedChannel_obliqueProj_eq_bcfwShift (θ : ℝ) :
    complexifiedChannel (obliqueProj θ) =
      shiftedPi (complexifiedChannel peirceCutP0)
        (complexifiedChannel jordanNilpotent)
        ((-(Real.cos θ / Real.sin θ) : ℝ) : ℂ) := by
  funext i
  fin_cases i <;>
    simp [complexifiedChannel, complexifyChannelCoordinates, channelCoordinates,
      shiftedPi, obliqueProj, peirceCutP0, jordanNilpotent]

/-- Consequently, `obliqueProj θ` lies on the Peirce–Klein null cone for every `θ : ℝ`,
even as `frobNormSq (obliqueProj θ) → ∞` (`obliqueProj_frobNormSq_unbounded`). -/
theorem complexifiedChannel_obliqueProj_null (θ : ℝ) :
    peirceKinematicForm (complexifiedChannel (obliqueProj θ))
      (complexifiedChannel (obliqueProj θ)) = 0 := by
  rw [complexifiedChannel_obliqueProj_eq_bcfwShift]
  exact peirceCutP0_bcfw_shift_jordanNilpotent_null _

/-- The p. 451 rank-1 spectral projector `jordanSpectralProj ρ₁ ρ₂` is identically
the BCFW shift of `peirceCutP0` along `jordanNilpotent` with shift parameter
`z = (ρ₁ - ρ₂)⁻¹`. -/
theorem complexifiedChannel_jordanSpectralProj_eq_bcfwShift (ρ₁ ρ₂ : ℝ) :
    complexifiedChannel (jordanSpectralProj ρ₁ ρ₂) =
      shiftedPi (complexifiedChannel peirceCutP0)
        (complexifiedChannel jordanNilpotent)
        (((ρ₁ - ρ₂)⁻¹ : ℝ) : ℂ) := by
  funext i
  fin_cases i <;>
    simp [complexifiedChannel, complexifyChannelCoordinates, channelCoordinates,
      shiftedPi, jordanSpectralProj, peirceCutP0, jordanNilpotent]

/-- Consequently, `jordanSpectralProj ρ₁ ρ₂` remains identically on-shell on the
Peirce–Klein null cone for all `ρ₁, ρ₂ : ℝ`. -/
theorem complexifiedChannel_jordanSpectralProj_null (ρ₁ ρ₂ : ℝ) :
    peirceKinematicForm (complexifiedChannel (jordanSpectralProj ρ₁ ρ₂))
      (complexifiedChannel (jordanSpectralProj ρ₁ ρ₂)) = 0 := by
  rw [complexifiedChannel_jordanSpectralProj_eq_bcfwShift]
  exact peirceCutP0_bcfw_shift_jordanNilpotent_null _

/-! ## 4. Walsh invariance of Krein signature, parabolic coalescence, and affine channel pole -/

/-- Both `kreinPolarityMat = diag(1, -1)` and its Walsh rotation
`walshMat * kreinPolarityMat * walshMat = kreinSwapMat` have exact
`peirceKinematicForm` quadratic norm `-1`. -/
theorem kreinPolarity_walsh_peirceForm_invariant :
    peirceKinematicForm (complexifiedChannel kreinPolarityMat)
      (complexifiedChannel kreinPolarityMat) = -1 ∧
    peirceKinematicForm (complexifiedChannel (walshMat * kreinPolarityMat * walshMat))
      (complexifiedChannel (walshMat * kreinPolarityMat * walshMat)) = -1 := by
  rw [walsh_conjugated_kreinPolarity]
  constructor
  · rw [peirceKinematicForm_self]
    simp [complexifiedChannel, complexifyChannelCoordinates, channelCoordinates, kreinPolarityMat]
  · rw [peirceKinematicForm_self]
    simp [complexifiedChannel, complexifyChannelCoordinates, channelCoordinates, kreinSwapMat]

/-- The coalesced parabolic Jordan block `jordanApproachMat ρ ρ = ρ • 1 + N`
has exact `peirceKinematicForm` quadratic value `(ρ : ℂ) ^ 2`, identical to
`ρ • 1` despite carrying the non-zero nilpotent shear `N`. -/
theorem complexifiedChannel_jordanApproach_coalescence_sq (ρ : ℝ) :
    peirceKinematicForm (complexifiedChannel (jordanApproachMat ρ ρ))
      (complexifiedChannel (jordanApproachMat ρ ρ)) = (ρ : ℂ) ^ 2 := by
  rw [peirceKinematicForm_self]
  simp [complexifiedChannel, complexifyChannelCoordinates, channelCoordinates,
    jordanApproachMat, sq]

/-- Shifting the dual null channel `outwardNilpotentX` along `jordanNilpotent`
yields an exact affine BCFW channel quadratic equal to `-z`, vanishing if and
only if `z = 0`. -/
theorem outwardNilpotentX_shiftedChannel_affine_pole (z : ℂ) :
    peirceKinematicForm
      (shiftedChannel (complexifiedChannel outwardNilpotentX)
        (complexifiedChannel jordanNilpotent) z)
      (shiftedChannel (complexifiedChannel outwardNilpotentX)
        (complexifiedChannel jordanNilpotent) z) = -z := by
  rw [shiftedChannel_sq peirceKinematicForm peirceKinematicForm_isSymm
    (complexifiedChannel outwardNilpotentX) (complexifiedChannel jordanNilpotent) z
    complexifiedChannel_jordanNilpotent_null]
  rw [complexifiedChannel_outwardNilpotentX_null,
    peirceKinematicForm_isSymm.eq
      (complexifiedChannel outwardNilpotentX) (complexifiedChannel jordanNilpotent),
    complexifiedChannel_jordanNilpotent_outwardNilpotentX_pairing]
  simp [mul_neg]

end InfoGeometry.Canonical.ParabolicJordanBCFWNullConeBridge
