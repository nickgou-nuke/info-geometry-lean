import InfoGeometry.Lie.RealSplitOctonionDerivation
import Mathlib.Tactic

/-!
# Baez §4.1: theorem-safe `G₂` surfaces from split octonions

Baez's Octonions, §4.1, describes `G₂` as the automorphism group of the
octonions, its Lie algebra as the derivations of the octonions, and the fact
that an automorphism is determined by the image of a suitable basic triple of
imaginary units.

This file implements the theorem-safe native surface over the repository's
kernel-checked Zorn split-Cayley carrier.  It proves the generic formal facts
that fit the current split-Cayley carrier and linear-algebraic closure:

* a nonassociative algebra automorphism is a linear equivalence preserving `1`
  and multiplication;
* a basic generating triple determines an automorphism pointwise;
* linear maps satisfying the Leibniz rule have a commutator closure theorem
  under explicit bilinearity assumptions;
* the existing concrete split-Cayley rotation is promoted to a genuine
  `Module.End ℝ` derivation.

The scope stays at these kernel-checked algebraic facts on the split-Cayley
carrier; the compact real form theorem, the dimension/classification theorem,
and Baez's preferred basic triples live in separate owners.
-/

noncomputable section

namespace InfoGeometry.Lie.BaezG2SplitOctonion

/-- Automorphisms of a possibly nonassociative algebra object: linear equivalences
preserving the unit and the chosen multiplication. -/
structure NonAssocAut (R A : Type*) [CommRing R] [AddCommGroup A] [Module R A] [One A] [Mul A]
    where
  toLinearEquiv : A ≃ₗ[R] A
  map_one' : toLinearEquiv 1 = 1
  map_mul' : ∀ X Y : A, toLinearEquiv (X * Y) = toLinearEquiv X * toLinearEquiv Y

namespace NonAssocAut

variable {R A : Type*} [CommRing R] [AddCommGroup A] [Module R A] [One A] [Mul A]

instance : CoeFun (NonAssocAut R A) (fun _ => A → A) where
  coe Φ := Φ.toLinearEquiv

@[simp] theorem map_zero (Φ : NonAssocAut R A) : Φ (0 : A) = 0 :=
  Φ.toLinearEquiv.map_zero

@[simp] theorem map_add (Φ : NonAssocAut R A) (X Y : A) : Φ (X + Y) = Φ X + Φ Y :=
  Φ.toLinearEquiv.map_add X Y

@[simp] theorem map_neg (Φ : NonAssocAut R A) (X : A) : Φ (-X) = -Φ X :=
  Φ.toLinearEquiv.map_neg X

@[simp] theorem map_smul (Φ : NonAssocAut R A) (r : R) (X : A) :
    Φ (r • X) = r • Φ X :=
  Φ.toLinearEquiv.map_smul r X

@[simp] theorem map_one (Φ : NonAssocAut R A) : Φ (1 : A) = 1 :=
  Φ.map_one'

@[simp] theorem map_mul (Φ : NonAssocAut R A) (X Y : A) :
    Φ (X * Y) = Φ X * Φ Y :=
  Φ.map_mul' X Y

/-- The identity automorphism. -/
def id : NonAssocAut R A where
  toLinearEquiv := LinearEquiv.refl R A
  map_one' := rfl
  map_mul' := by intro X Y; rfl

/-- Composition of nonassociative algebra automorphisms. -/
def comp (Φ Ψ : NonAssocAut R A) : NonAssocAut R A where
  toLinearEquiv := Φ.toLinearEquiv.trans Ψ.toLinearEquiv
  map_one' := by
    change Ψ (Φ (1 : A)) = 1
    simp
  map_mul' := by
    intro X Y
    change Ψ (Φ (X * Y)) = Ψ (Φ X) * Ψ (Φ Y)
    rw [map_mul Φ, map_mul Ψ]

/-- Inversion of nonassociative algebra automorphisms. -/
def inv (Φ : NonAssocAut R A) : NonAssocAut R A where
  toLinearEquiv := Φ.toLinearEquiv.symm
  map_one' := by
    apply Φ.toLinearEquiv.injective
    simp
  map_mul' := by
    intro X Y
    apply Φ.toLinearEquiv.injective
    rw [map_mul]
    simp

end NonAssocAut

/-- The subalgebra generated by three distinguished elements, for a
possibly nonassociative multiplication.  This is the proof-relevant version of
Baez's phrase "a basic triple generates the octonions". -/
inductive TripleClosure (R A : Type*) [CommRing R] [AddCommGroup A] [Module R A] [One A] [Mul A]
    (u v w : A) : A → Prop
  | zero : TripleClosure R A u v w 0
  | one : TripleClosure R A u v w 1
  | first : TripleClosure R A u v w u
  | second : TripleClosure R A u v w v
  | third : TripleClosure R A u v w w
  | add {x y : A} : TripleClosure R A u v w x → TripleClosure R A u v w y →
      TripleClosure R A u v w (x + y)
  | neg {x : A} : TripleClosure R A u v w x → TripleClosure R A u v w (-x)
  | smul (r : R) {x : A} : TripleClosure R A u v w x → TripleClosure R A u v w (r • x)
  | mul {x y : A} : TripleClosure R A u v w x → TripleClosure R A u v w y →
      TripleClosure R A u v w (x * y)

/-- A basic triple is recorded only when generation is actually supplied. -/
structure BasicTriple (R A : Type*) [CommRing R] [AddCommGroup A] [Module R A] [One A] [Mul A]
    where
  first : A
  second : A
  third : A
  generates : ∀ x : A, TripleClosure R A first second third x

variable {R A : Type*} [CommRing R] [AddCommGroup A] [Module R A] [One A] [Mul A]

/-- Two automorphisms agreeing on a generating triple agree on everything in its
nonassociative closure. -/
theorem NonAssocAut.agree_on_tripleClosure {u v w x : A} (Φ Ψ : NonAssocAut R A)
    (hu : Φ u = Ψ u) (hv : Φ v = Ψ v) (hw : Φ w = Ψ w)
    (hx : TripleClosure R A u v w x) : Φ x = Ψ x := by
  induction hx with
  | zero => simp
  | one => simp
  | first => exact hu
  | second => exact hv
  | third => exact hw
  | add _ _ ihx ihy => simp [ihx, ihy]
  | neg _ ih => simp [ih]
  | smul _ _ ih => simp [ih]
  | mul _ _ ihx ihy => simp [ihx, ihy]

/-- Extensionality for nonassociative algebra automorphisms. -/
theorem NonAssocAut.eq_of_forall (Φ Ψ : NonAssocAut R A) (h : ∀ x : A, Φ x = Ψ x) :
    Φ = Ψ := by
  cases Φ
  cases Ψ
  simp only at h
  congr
  ext x
  exact h x

/-- Baez §4.1 theorem-safe form: images of a fixed basic triple determine an
automorphism pointwise. -/
theorem NonAssocAut.pointwise_eq_of_eq_on_basicTriple (T : BasicTriple R A)
    (Φ Ψ : NonAssocAut R A)
    (h₁ : Φ T.first = Ψ T.first)
    (h₂ : Φ T.second = Ψ T.second)
    (h₃ : Φ T.third = Ψ T.third) :
    ∀ x : A, Φ x = Ψ x := by
  intro x
  exact NonAssocAut.agree_on_tripleClosure Φ Ψ h₁ h₂ h₃ (T.generates x)

/-- If two automorphisms agree on a basic generating triple, they are equal. -/
theorem NonAssocAut.ext_of_eq_on_basicTriple (T : BasicTriple R A)
    (Φ Ψ : NonAssocAut R A)
    (h₁ : Φ T.first = Ψ T.first)
    (h₂ : Φ T.second = Ψ T.second)
    (h₃ : Φ T.third = Ψ T.third) :
    Φ = Ψ := by
  apply NonAssocAut.eq_of_forall
  exact NonAssocAut.pointwise_eq_of_eq_on_basicTriple T Φ Ψ h₁ h₂ h₃

/-- Leibniz rule for a linear endomorphism of a nonassociative algebra. -/
def IsNonAssocDerivation (D : Module.End R A) : Prop :=
  ∀ X Y : A, D (X * Y) = D X * Y + X * D Y

/-- The pointwise endomorphism commutator. -/
def endomorphismCommutator (D E : Module.End R A) : Module.End R A :=
  D.comp E - E.comp D

omit [One A] in
/-- Derivations are closed under commutator whenever multiplication is
additively bilinear in the subtraction form needed for the calculation.  This is
the kernel-checked Lie-algebra calculation behind the slogan
`Lie(G₂) = Der(𝕆)`, with the classification statement carried by separate
owners. -/
theorem IsNonAssocDerivation.commutator
    {D E : Module.End R A} (hD : IsNonAssocDerivation (R := R) (A := A) D)
    (hE : IsNonAssocDerivation (R := R) (A := A) E)
    (hsub_mul : ∀ X Y Z : A, (X - Y) * Z = X * Z - Y * Z)
    (hmul_sub : ∀ X Y Z : A, X * (Y - Z) = X * Y - X * Z) :
    IsNonAssocDerivation (R := R) (A := A) (endomorphismCommutator (R := R) (A := A) D E) := by
  intro X Y
  unfold endomorphismCommutator
  change D (E (X * Y)) - E (D (X * Y)) =
    (D (E X) - E (D X)) * Y + X * (D (E Y) - E (D Y))
  rw [hE X Y, map_add, hD (E X) Y, hD X (E Y)]
  rw [hD X Y, map_add, hE (D X) Y, hE X (D Y)]
  rw [hsub_mul, hmul_sub]
  abel

open InfoGeometry.Lie.RealSplitOctonionDerivationWitness

/-- The repository's canonical real split-Cayley/Zorn carrier. -/
abbrev SplitCayley := InfoGeometry.Lie.RealSplitOctonionDerivation.SplitCayley

/-- The split-Cayley automorphism surface that plays the local theorem-safe role
of Baez's `G₂ = Aut(𝕆)` slogan. -/
abbrev SplitCayleyG2Aut := NonAssocAut ℝ SplitCayley

/-- The split-Cayley derivation surface for the local `𝔤₂ = Der(𝕆)` lane. -/
abbrev SplitCayleyG2Derivation :=
  {D : Module.End ℝ SplitCayley // IsNonAssocDerivation (R := ℝ) (A := SplitCayley) D}

/-- The concrete real split-Cayley `0-1` rotation is linear, delegated to the
native real split-octonion derivation owner. -/
theorem rot01Real_smul (r : ℝ) (X : SplitCayley) : rot01Real (r • X) = r • rot01Real X :=
  InfoGeometry.Lie.RealSplitOctonionDerivation.rot01Real_smul r X

/-- The existing split-Cayley coordinate rotation as a real-linear endomorphism,
delegated to the native real split-octonion derivation owner. -/
abbrev rot01Linear : Module.End ℝ SplitCayley :=
  InfoGeometry.Lie.RealSplitOctonionDerivation.rot01Linear

/-- The real-linear `0-1` rotation satisfies the split-Cayley Leibniz rule. -/
theorem rot01Linear_is_derivation :
    IsNonAssocDerivation (R := ℝ) (A := SplitCayley) rot01Linear :=
  InfoGeometry.Lie.RealSplitOctonionDerivation.rot01Linear_isLeibniz

/-- A bundled concrete nonzero split-Cayley `𝔤₂`-type derivation witness. -/
def rot01G2Derivation : SplitCayleyG2Derivation :=
  ⟨rot01Linear, rot01Linear_is_derivation⟩

/-- Nonzero readout inherited from the native split-Cayley witness. -/
theorem rot01G2Derivation_nonzero : ∃ X : SplitCayley, rot01G2Derivation.1 X ≠ 0 := by
  exact ⟨up0, rot01Real_nonzero_on_up0⟩

end InfoGeometry.Lie.BaezG2SplitOctonion
