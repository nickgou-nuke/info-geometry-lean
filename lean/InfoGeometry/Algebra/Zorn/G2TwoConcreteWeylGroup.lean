import InfoGeometry.OperatorAlgebra.G2TwoAutomorphismTheorem
import InfoGeometry.Algebra.Zorn.G2TwoBasisRigidity
import InfoGeometry.Algebra.Zorn.G2TwoExplicitGenerators
import Mathlib.Tactic

/-!
# Concrete Weyl Representatives in SplitOctF2Aut

This module constructs twelve distinct concrete Weyl representatives in
`SplitOctF2Aut` and the subgroup they generate.

The Weyl group is generated by three explicit automorphisms:
1. `swap01Aut` (order 2) — swaps coordinates 0 and 1 ($u_0 \leftrightarrow u_1, d_0 \leftrightarrow d_1$), fixing $e^+, e^-$.
2. `cycle012Aut` (order 3) — cyclic permutation $(0\;1\;2)$ of the spatial coordinates, fixing $e^+, e^-$.
3. `swapCartanAut` (order 2) — swaps the Cartan idempotents $e^+ \leftrightarrow e^-$ and dualizes $u_i \leftrightarrow d_i$.

The present file does not prove that the generated subgroup is a normalizer,
has order exactly 12, or is a concrete BN-pair Weyl quotient.  All twelve
listed representatives are nevertheless proved distinct by kernel-checked
evaluation on the basis, yielding a genuine lower bound.

All proofs are native Mathlib with 0 `sorry`s.
-/

namespace InfoGeometry.Algebra.Zorn.G2ConcreteWeyl

open InfoGeometry.OperatorAlgebra.G2TwoAutomorphismTheorem
open InfoGeometry.Algebra.Zorn.G2Unipotent

/-- Coordinate map swapping the Cartan idempotents `a ↔ b` and spatial directions `u_i ↔ d_i`. -/
def swapCartanFun (X : SplitOctF2) : SplitOctF2 :=
  ⟨X.b, X.a, X.y0, X.y1, X.y2, X.x0, X.x1, X.x2⟩

/-- Equivalence of the carrier under `swapCartanFun`. -/
def swapCartanEquiv : SplitOctF2 ≃ SplitOctF2 where
  toFun := swapCartanFun
  invFun := swapCartanFun
  left_inv X := by rcases X; rfl
  right_inv X := by rcases X; rfl

/-- Proof that `swapCartanEquiv` preserves the split-Zorn multiplication, addition, and unit. -/
theorem isSplitOctF2Aut_swapCartan :
    IsSplitOctF2Aut swapCartanEquiv := by
  refine ⟨rfl, ?_, ?_⟩
  · intro X Y
    rcases X with ⟨a1, b1, x01, x11, x21, y01, y11, y21⟩
    rcases Y with ⟨a2, b2, x02, x12, x22, y02, y12, y22⟩
    ext <;> rfl
  · intro X Y
    rcases X with ⟨a1, b1, x01, x11, x21, y01, y11, y21⟩
    rcases Y with ⟨a2, b2, x02, x12, x22, y02, y12, y22⟩
    ext <;> rfl

/-- 🏆 THEOREM 1: The Cartan-swapping involution automorphism in SplitOctF2Aut. -/
def swapCartanAut : SplitOctF2Aut :=
  ⟨swapCartanEquiv, isSplitOctF2Aut_swapCartan⟩

/-- `swapCartanAut` is an involution (order 2). -/
theorem swapCartanAut_sq : swapCartanAut * swapCartanAut = 1 := by
  apply automorphism_ext_of_basis
  intro i
  fin_cases i <;> rfl

theorem swapCartanAut_comm_cycle012 :
    swapCartanAut * cycle012Aut = cycle012Aut * swapCartanAut := by
  apply automorphism_ext_of_basis
  intro i
  fin_cases i <;> rfl

theorem swapCartanAut_comm_swap01 :
    swapCartanAut * swap01Aut = swap01Aut * swapCartanAut := by
  apply automorphism_ext_of_basis
  intro i
  fin_cases i <;> rfl

theorem swap01_cycle012_conjugate :
    swap01Aut * cycle012Aut * swap01Aut = cycle012Aut * cycle012Aut := by
  apply automorphism_ext_of_basis
  intro i
  fin_cases i <;> rfl

/-- The concrete 12 Weyl automorphisms of SplitOctF2Aut. -/
noncomputable def concreteWeylElement (i : Fin 12) : SplitOctF2Aut :=
  match i.1 with
  | 0 => 1
  | 1 => cycle012Aut
  | 2 => cycle012Aut * cycle012Aut
  | 3 => swap01Aut
  | 4 => swap01Aut * cycle012Aut
  | 5 => swap01Aut * (cycle012Aut * cycle012Aut)
  | 6 => swapCartanAut
  | 7 => swapCartanAut * cycle012Aut
  | 8 => swapCartanAut * (cycle012Aut * cycle012Aut)
  | 9 => swapCartanAut * swap01Aut
  | 10 => swapCartanAut * (swap01Aut * cycle012Aut)
  | 11 => swapCartanAut * (swap01Aut * (cycle012Aut * cycle012Aut))
  | _ => 1

/-- 🏆 THEOREM 2: All 12 concrete Weyl automorphisms are strictly distinct. -/
theorem concreteWeylElement_injective :
    Function.Injective concreteWeylElement := by
  intro i j h
  fin_cases i <;> fin_cases j
  all_goals try rfl
  all_goals
    have h_eval := congrArg (fun f : SplitOctF2Aut => (f.1 (basis8 0), f.1 (basis8 2), f.1 (basis8 3), f.1 (basis8 4))) h
    revert h_eval
    decide

/-- The concrete Weyl subgroup in SplitOctF2Aut. -/
def concreteWeylSubgroup : Subgroup SplitOctF2Aut :=
  Subgroup.closure {swap01Aut, cycle012Aut, swapCartanAut}

lemma swap01Aut_mem_subgroup : swap01Aut ∈ concreteWeylSubgroup := by
  apply Subgroup.subset_closure
  simp

lemma cycle012Aut_mem_subgroup : cycle012Aut ∈ concreteWeylSubgroup := by
  apply Subgroup.subset_closure
  simp

lemma swapCartanAut_mem_subgroup : swapCartanAut ∈ concreteWeylSubgroup := by
  apply Subgroup.subset_closure
  simp

noncomputable instance : Finite concreteWeylSubgroup :=
  Finite.of_injective Subtype.val Subtype.val_injective

noncomputable instance : Fintype concreteWeylSubgroup := Fintype.ofFinite _

theorem concreteWeylElement_mem (i : Fin 12) :
    concreteWeylElement i ∈ concreteWeylSubgroup := by
  fin_cases i
  · exact concreteWeylSubgroup.one_mem
  · exact cycle012Aut_mem_subgroup
  · exact concreteWeylSubgroup.mul_mem cycle012Aut_mem_subgroup cycle012Aut_mem_subgroup
  · exact swap01Aut_mem_subgroup
  · exact concreteWeylSubgroup.mul_mem swap01Aut_mem_subgroup cycle012Aut_mem_subgroup
  · exact concreteWeylSubgroup.mul_mem swap01Aut_mem_subgroup
      (concreteWeylSubgroup.mul_mem cycle012Aut_mem_subgroup cycle012Aut_mem_subgroup)
  · exact swapCartanAut_mem_subgroup
  · exact concreteWeylSubgroup.mul_mem swapCartanAut_mem_subgroup cycle012Aut_mem_subgroup
  · exact concreteWeylSubgroup.mul_mem swapCartanAut_mem_subgroup
      (concreteWeylSubgroup.mul_mem cycle012Aut_mem_subgroup cycle012Aut_mem_subgroup)
  · exact concreteWeylSubgroup.mul_mem swapCartanAut_mem_subgroup swap01Aut_mem_subgroup
  · exact concreteWeylSubgroup.mul_mem swapCartanAut_mem_subgroup
      (concreteWeylSubgroup.mul_mem swap01Aut_mem_subgroup cycle012Aut_mem_subgroup)
  · exact concreteWeylSubgroup.mul_mem swapCartanAut_mem_subgroup
      (concreteWeylSubgroup.mul_mem swap01Aut_mem_subgroup
        (concreteWeylSubgroup.mul_mem cycle012Aut_mem_subgroup cycle012Aut_mem_subgroup))

/-- 🏆 THEOREM 3: The concrete Weyl subgroup has order AT LEAST 12. -/
theorem concreteWeylSubgroup_card_lower_bound :
    12 ≤ Fintype.card concreteWeylSubgroup := by
  let f : Fin 12 → concreteWeylSubgroup := fun i => ⟨concreteWeylElement i, concreteWeylElement_mem i⟩
  have hf : Function.Injective f := by
    intro i j h
    have h' := congrArg (fun z : concreteWeylSubgroup => (z : SplitOctF2Aut)) h
    exact concreteWeylElement_injective h'
  have hc := Fintype.card_le_of_injective f hf
  simpa using hc

set_option maxHeartbeats 4000000

noncomputable def weylWordVal (i : Fin 12) : concreteWeylSubgroup :=
  ⟨concreteWeylElement i, concreteWeylElement_mem i⟩

