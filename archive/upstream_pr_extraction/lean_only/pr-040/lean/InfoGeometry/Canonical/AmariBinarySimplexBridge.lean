import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.Tactic
import InfoGeometry.Potential.Thermo
import InfoGeometry.ExponentialFamily.Bernoulli
import InfoGeometry.Prequantum.JaynesKLPotential
import InfoGeometry.Arithmetic.AmariZetaDuallyFlatGeometry
import InfoGeometry.Krein.FiniteCovarianceMajoranaBlock

/-!
# Real binary Amari simplex

This is the native real, one-dimensional owner for the binary simplex.  It
keeps the logistic/logit chart and its algebraic symmetries separate from the
general Legendre/Fenchel owner in `InfoGeometry.Potential.Thermo`.

The file deliberately distinguishes two defects which are often conflated:

* the Fenchel gap `ψ θ + φ s - θ*s`, whose zero locus is the logistic contact
  relation;
* the Bregman/KL defect from the midpoint, `φ s - φ (1/2)`, since
  `φ' (1/2) = 0`.

No complex logarithm, analytic continuation, or spectral assertion is used.
-/

noncomputable section

namespace InfoGeometry.Canonical.AmariBinarySimplexBridge

def logistic (θ : ℝ) : ℝ :=
  Real.exp θ / (1 + Real.exp θ)

def logit (s : ℝ) : ℝ :=
  Real.log (s / (1 - s))

def massieu (θ : ℝ) : ℝ :=
  Real.log (1 + Real.exp θ)

def negativeEntropy (s : ℝ) : ℝ :=
  s * Real.log s + (1 - s) * Real.log (1 - s)

def fisherExp (θ : ℝ) : ℝ :=
  logistic θ * (1 - logistic θ)

def fisherMix (s : ℝ) : ℝ :=
  1 / (s * (1 - s))

def fenchelGap (θ s : ℝ) : ℝ :=
  massieu θ + negativeEntropy s - θ * s

def midpoint : ℝ := 1 / 2

/-- The Bregman divergence generated by negative entropy, based at `1/2`. -/
def midpointBregman (s : ℝ) : ℝ :=
  negativeEntropy s - negativeEntropy midpoint

theorem logistic_pos (θ : ℝ) : 0 < logistic θ := by
  unfold logistic
  positivity

theorem one_sub_logistic_pos (θ : ℝ) : 0 < 1 - logistic θ := by
  unfold logistic
  have h : 0 < 1 + Real.exp θ := by positivity
  apply sub_pos.mpr
  apply (div_lt_iff₀ h).2
  nlinarith [Real.exp_pos θ]

theorem logistic_mem_Ioo (θ : ℝ) : logistic θ ∈ Set.Ioo (0 : ℝ) 1 := by
  exact ⟨logistic_pos θ, sub_pos.mp (one_sub_logistic_pos θ)⟩

theorem logit_logistic (θ : ℝ) : logit (logistic θ) = θ := by
  unfold logit logistic
  have h : 0 < 1 + Real.exp θ := by positivity
  have hne : 1 + Real.exp θ ≠ 0 := ne_of_gt h
  have hratio :
      (Real.exp θ / (1 + Real.exp θ)) /
          (1 - Real.exp θ / (1 + Real.exp θ)) = Real.exp θ := by
    field_simp [hne]
    ring
  rw [hratio, Real.log_exp]

theorem logistic_logit {s : ℝ} (hs : s ∈ Set.Ioo (0 : ℝ) 1) :
    logistic (logit s) = s := by
  unfold logistic logit
  have hratio : 0 < s / (1 - s) :=
    div_pos hs.1 (sub_pos.mpr hs.2)
  rw [Real.exp_log hratio]
  field_simp [ne_of_gt (sub_pos.mpr hs.2)]
  ring

theorem logit_one_sub {s : ℝ} (hs : s ∈ Set.Ioo (0 : ℝ) 1) :
    logit (1 - s) = -logit s := by
  unfold logit
  have hs0 : s ≠ 0 := ne_of_gt hs.1
  have hs1 : 1 - s ≠ 0 := ne_of_gt (sub_pos.mpr hs.2)
  have hratio : (1 - s) / (1 - (1 - s)) = (s / (1 - s))⁻¹ := by
    field_simp [hs0, hs1]
    ring
  rw [hratio, Real.log_inv]

theorem negativeEntropy_midpoint :
    negativeEntropy midpoint = -Real.log 2 := by
  unfold negativeEntropy midpoint
  have hhalf : 1 - (1 / 2 : ℝ) = 1 / 2 := by norm_num
  have hlog : Real.log (1 / 2 : ℝ) = -Real.log 2 := by
    rw [show (1 / 2 : ℝ) = (2 : ℝ)⁻¹ by norm_num, Real.log_inv]
  rw [hhalf, hlog]
  ring

theorem negativeEntropy_one_sub (s : ℝ) :
    negativeEntropy (1 - s) = negativeEntropy s := by
  unfold negativeEntropy
  rw [show 1 - (1 - s) = s by ring]
  ring

theorem fisherExp_eq_logistic_mul_complement (θ : ℝ) :
    fisherExp θ = logistic θ * (1 - logistic θ) := rfl

/-! ## Native Hessian readout -/

theorem deriv_massieu (θ : ℝ) :
    deriv massieu θ = logistic θ := by
  simpa [massieu, logistic,
    InfoGeometry.ExponentialFamily.Bernoulli.logPartition] using
    InfoGeometry.ExponentialFamily.Bernoulli.deriv_logPartition θ

theorem deriv_logistic (θ : ℝ) :
    deriv logistic θ = fisherExp θ := by
  unfold logistic fisherExp
  have hnum : HasDerivAt (fun x : ℝ => Real.exp x) (Real.exp θ) θ :=
    Real.hasDerivAt_exp θ
  have hden : HasDerivAt (fun x : ℝ => 1 + Real.exp x)
      (Real.exp θ) θ := by
    simpa using (Real.hasDerivAt_exp θ).const_add 1
  have hquot :
      HasDerivAt (fun x : ℝ => Real.exp x / (1 + Real.exp x))
        ((Real.exp θ * (1 + Real.exp θ) - Real.exp θ * Real.exp θ) /
          (1 + Real.exp θ) ^ 2) θ :=
    hnum.div hden (by positivity)
  have hquot' :
      HasDerivAt (fun x : ℝ => Real.exp x / (1 + Real.exp x))
        (Real.exp θ / (1 + Real.exp θ) ^ 2) θ := by
    convert hquot using 1
    ring
  have hderiv := hquot'.deriv
  change deriv (fun x : ℝ => Real.exp x / (1 + Real.exp x)) θ =
    Real.exp θ / (1 + Real.exp θ) *
      (1 - Real.exp θ / (1 + Real.exp θ))
  rw [hderiv]
  field_simp [ne_of_gt (by positivity : 0 < 1 + Real.exp θ)]
  ring

theorem deriv2_massieu (θ : ℝ) :
    deriv (fun x : ℝ => deriv massieu x) θ = fisherExp θ := by
  have hderiv : (fun x : ℝ => deriv massieu x) = logistic := by
    funext x
    exact deriv_massieu x
  rw [hderiv]
  exact deriv_logistic θ

theorem fisherExp_pos (θ : ℝ) : 0 < fisherExp θ := by
  unfold fisherExp
  exact mul_pos (logistic_pos θ) (one_sub_logistic_pos θ)

/-- The exponential Fisher variance is the squared off-diagonal coherence of
the finite covariance/Majorana block at the logistic coordinate. -/
theorem fisherExp_eq_covariance_offdiag_sq (θ : ℝ) :
    fisherExp θ =
      (InfoGeometry.Krein.FiniteCovarianceMajoranaBlock.covarianceProjection
        (logistic θ) 0 1) ^ 2 := by
  have hc : 0 ≤ logistic θ := le_of_lt (logistic_pos θ)
  have hc1 : 0 ≤ 1 - logistic θ := le_of_lt (one_sub_logistic_pos θ)
  unfold fisherExp
  change logistic θ * (1 - logistic θ) =
    (Real.sqrt (logistic θ) * Real.sqrt (1 - logistic θ)) ^ 2
  rw [mul_pow, Real.sq_sqrt hc, Real.sq_sqrt hc1]

theorem hasDerivAt_negativeEntropy {s : ℝ}
    (hs : s ∈ Set.Ioo (0 : ℝ) 1) :
    HasDerivAt negativeEntropy (logit s) s := by
  have hs0 : s ≠ 0 := ne_of_gt hs.1
  have hq0 : 1 - s ≠ 0 := ne_of_gt (sub_pos.mpr hs.2)
  have hfirst :
      HasDerivAt (fun x : ℝ => x * Real.log x)
        (Real.log s + 1) s := by
    have h := (hasDerivAt_id s).mul (Real.hasDerivAt_log hs0)
    convert h using 1 <;> simp only [id_eq] <;> field_simp <;> ring
  have hinner : HasDerivAt (fun x : ℝ => 1 - x) (-1 : ℝ) s := by
    simpa using (hasDerivAt_const s (1 : ℝ)).sub (hasDerivAt_id s)
  have hsecond :
      HasDerivAt (fun x : ℝ => (1 - x) * Real.log (1 - x))
        (-(Real.log (1 - s) + 1)) s := by
    have hlog := (Real.hasDerivAt_log hq0).comp s hinner
    have h := hinner.mul hlog
    convert h using 1 <;> simp [Function.comp_def] <;> field_simp <;> ring
  have hlogit :
      Real.log (s / (1 - s)) = Real.log s - Real.log (1 - s) :=
    Real.log_div hs0 hq0
  unfold negativeEntropy logit
  convert hfirst.add hsecond using 1
  rw [hlogit]
  ring

theorem deriv_negativeEntropy {s : ℝ}
    (hs : s ∈ Set.Ioo (0 : ℝ) 1) :
    deriv negativeEntropy s = logit s :=
  (hasDerivAt_negativeEntropy hs).deriv

theorem deriv_negativeEntropy_midpoint :
    deriv negativeEntropy midpoint = 0 := by
  have hm : midpoint ∈ Set.Ioo (0 : ℝ) 1 := by
    constructor <;> norm_num [midpoint]
  rw [deriv_negativeEntropy hm]
  unfold logit midpoint
  norm_num

theorem fisherExp_logit {s : ℝ} (hs : s ∈ Set.Ioo (0 : ℝ) 1) :
    fisherExp (logit s) = s * (1 - s) := by
  rw [fisherExp_eq_logistic_mul_complement, logistic_logit hs]

theorem fisherMix_mul_fisherExp_logit {s : ℝ}
    (hs : s ∈ Set.Ioo (0 : ℝ) 1) :
    fisherMix s * fisherExp (logit s) = 1 := by
  rw [fisherExp_logit hs]
  unfold fisherMix
  have hne : s * (1 - s) ≠ 0 :=
    mul_ne_zero (ne_of_gt hs.1) (ne_of_gt (sub_pos.mpr hs.2))
  rw [div_eq_mul_inv, mul_assoc, inv_mul_cancel₀ hne, one_mul]

theorem fisherMix_pos {s : ℝ} (hs : s ∈ Set.Ioo (0 : ℝ) 1) :
    0 < fisherMix s := by
  unfold fisherMix
  exact one_div_pos.mpr (mul_pos hs.1 (sub_pos.mpr hs.2))

theorem midpointBregman_eq_negativeEntropy_add_log_two (s : ℝ) :
    midpointBregman s = negativeEntropy s + Real.log 2 := by
  rw [midpointBregman, negativeEntropy_midpoint]
  ring

theorem midpointBregman_midpoint : midpointBregman midpoint = 0 := by
  unfold midpointBregman
  exact sub_self _

theorem midpointBregman_nonneg {s : ℝ}
    (hs : s ∈ Set.Ioo (0 : ℝ) 1) :
    0 ≤ midpointBregman s := by
  have hs0 : 0 < s := hs.1
  have hq0 : 0 < 1 - s := sub_pos.mpr hs.2
  have hhalf : (0 : ℝ) < 1 / 2 := by norm_num
  have hloghalf : Real.log (1 / 2 : ℝ) = -Real.log 2 := by
    rw [show (1 / 2 : ℝ) = (2 : ℝ)⁻¹ by norm_num, Real.log_inv]
  have hleft :=
    InfoGeometry.Prequantum.JaynesKLPotential.scalarKLDivergence_nonneg
      s (1 / 2 : ℝ) hs0 hhalf
  have hright :=
    InfoGeometry.Prequantum.JaynesKLPotential.scalarKLDivergence_nonneg
      (1 - s) (1 / 2 : ℝ) hq0 hhalf
  have hleft' :
      InfoGeometry.Prequantum.JaynesKLPotential.scalarKLDivergence
          s (1 / 2 : ℝ) =
        s * Real.log s + s * Real.log 2 - s + 1 / 2 := by
    unfold InfoGeometry.Prequantum.JaynesKLPotential.scalarKLDivergence
    rw [Real.log_div (ne_of_gt hs0) (by norm_num), hloghalf]
    ring
  have hright' :
      InfoGeometry.Prequantum.JaynesKLPotential.scalarKLDivergence
          (1 - s) (1 / 2 : ℝ) =
        (1 - s) * Real.log (1 - s) + (1 - s) * Real.log 2
          - (1 - s) + 1 / 2 := by
    unfold InfoGeometry.Prequantum.JaynesKLPotential.scalarKLDivergence
    rw [Real.log_div (ne_of_gt hq0) (by norm_num), hloghalf]
    ring
  have hdecomp :
      InfoGeometry.Prequantum.JaynesKLPotential.scalarKLDivergence
          s (1 / 2 : ℝ) +
        InfoGeometry.Prequantum.JaynesKLPotential.scalarKLDivergence
          (1 - s) (1 / 2 : ℝ) =
      negativeEntropy s + Real.log 2 := by
    rw [hleft', hright']
    unfold negativeEntropy
    ring
  rw [midpointBregman_eq_negativeEntropy_add_log_two, ← hdecomp]
  exact add_nonneg hleft hright

theorem fenchelGap_contact (θ : ℝ) :
    fenchelGap θ (logistic θ) = 0 := by
  unfold fenchelGap massieu negativeEntropy logistic
  have h : 0 < 1 + Real.exp θ := by positivity
  have hratio :
      Real.log (Real.exp θ / (1 + Real.exp θ)) =
        θ - Real.log (1 + Real.exp θ) := by
    rw [Real.log_div (Real.exp_ne_zero θ) (ne_of_gt h), Real.log_exp]
  have hcomp :
      1 - Real.exp θ / (1 + Real.exp θ) =
        (1 + Real.exp θ)⁻¹ := by
    field_simp [ne_of_gt h]
    ring
  rw [hratio, hcomp, Real.log_inv]
  field_simp [ne_of_gt h]
  ring

theorem midpointBregman_is_not_fenchelGap (s : ℝ) :
    midpointBregman s =
      negativeEntropy s - negativeEntropy midpoint := rfl

/-! The real binary owner and the arithmetic Amari owner have the same
finite seam potential.  These are equalities of the existing definitions,
not a new transport interface. -/

theorem midpointBregman_eq_arithmetic_amariDeviance (s : ℝ) :
    midpointBregman s =
      InfoGeometry.Arithmetic.AmariZeta.amariDevianceFromSeam s := by
  rw [midpointBregman_eq_negativeEntropy_add_log_two]
  unfold negativeEntropy
  unfold InfoGeometry.Arithmetic.AmariZeta.amariDevianceFromSeam
  ring

theorem arithmetic_amariDeviance_nonneg {s : ℝ}
    (hs : s ∈ Set.Ioo (0 : ℝ) 1) :
    0 ≤ InfoGeometry.Arithmetic.AmariZeta.amariDevianceFromSeam s := by
  rw [← midpointBregman_eq_arithmetic_amariDeviance]
  exact midpointBregman_nonneg hs

theorem fisherExp_complexification (θ : ℝ) :
    (fisherExp θ : ℂ) =
      InfoGeometry.Arithmetic.AmariZeta.fisherRaoMetric (logistic θ) := by
  simp [fisherExp, InfoGeometry.Arithmetic.AmariZeta.fisherRaoMetric]

end InfoGeometry.Canonical.AmariBinarySimplexBridge
