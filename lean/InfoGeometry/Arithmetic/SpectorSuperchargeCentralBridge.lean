import InfoGeometry.Arithmetic.PrimonSupergradedGasAlgebra
import InfoGeometry.Arithmetic.PrimeBitWittenIndex
import InfoGeometry.Arithmetic.ArithmeticSuperchargeHopfBridge

/-!
# InfoGeometry.Arithmetic.SpectorSuperchargeCentralBridge

Finite bridge from the Spector/Witten prime-bit corridor to the existing
supercharge and central-charge sockets.

This file does not prove a supersymmetric field theory, a super-Virasoro
representation, a BPS bound, or an infinite zeta theorem.  It packages the
already-owned finite Witten-index cancellation together with the already-owned
odd supercharge / central-charge bookkeeping:

* finite prime registers have vanishing Boolean Witten supertrace;
* the odd supercharge square commutes with parity;
* the Hamiltonian generated by the odd supercharge is parity-even;
* the supercharge commutes with the Hamiltonian generated by its square;
* a supplied central charge is explicitly central.

#### BUCKET 1: CLOSED FINITE THEOREMS
All theorem statements below are finite arithmetic or algebraic readbacks of
already-owned owner surfaces.

#### BUCKET 2: CONDITIONAL THEOREMS FROM EXPLICIT WITNESSES
The central-charge component is a supplied witness field.  This file does not
construct it.

#### BUCKET 3: OPEN CLOSURE DEBT
No analytic continuation, infinite Euler product, Bethe ansatz, sigma-model,
or Riemann Hypothesis claim is proved here.
-/

namespace InfoGeometry.Arithmetic.SpectorSuperchargeCentralBridge

open scoped BigOperators

open InfoGeometry.Arithmetic.PrimeBitWittenIndex
open InfoGeometry.Arithmetic.PrimonSupergradedGasAlgebra
open InfoGeometry.Arithmetic.ArithmeticSuperchargeHopfBridge

/-! ## Finite Spector/Witten readout plus supercharge carrier -/

/--
Finite Spector packet for the supercharge/central-charge corridor.

`register` is the finite prime-bit cutoff, `supercharge` is the supplied odd
supercharge packet, and `centralCharge` is the supplied central element.
-/
structure SpectorSuperchargeCentralReadout
    (Op : Type*) [Ring Op] where
  /-- Finite prime-bit register carrying the Witten cancellation. -/
  register : PrimeRegister

  /-- Nonempty register hypothesis needed for finite Witten cancellation. -/
  hNonempty : register.primes.Nonempty

  /-- Supplied odd-supercharge / Hamiltonian / parity packet. -/
  supercharge : ParitySuperchargePacket Op

  /-- Supplied central-charge readout. -/
  centralCharge : Op

  /-- The supplied central charge is central. -/
  centralCharge_commutes : ∀ X : Op, centralCharge * X = X * centralCharge

namespace SpectorSuperchargeCentralReadout

variable {Op : Type*} [Ring Op]
variable (R : SpectorSuperchargeCentralReadout Op)

/-- The finite prime register has vanishing Boolean Witten supertrace. -/
theorem finiteWittenIndex_cancel :
    PrimonSupergradedGasAlgebra.finitePrimonWittenIndex R.register = 0 :=
  PrimonSupergradedGasAlgebra.finitePrimonWittenIndex_cancel R.register R.hNonempty

/-- The odd supercharge square commutes with parity. -/
theorem supercharge_sq_commutes_with_parity :
    (R.supercharge.supercharge * R.supercharge.supercharge) * R.supercharge.parity =
      R.supercharge.parity * (R.supercharge.supercharge * R.supercharge.supercharge) :=
  R.supercharge.supercharge_sq_commutes_with_parity

/-- The Hamiltonian generated by the odd supercharge is parity-even. -/
theorem hamiltonian_commutes_with_parity :
    R.supercharge.hamiltonian * R.supercharge.parity =
      R.supercharge.parity * R.supercharge.hamiltonian :=
  R.supercharge.hamiltonian_commutes_with_parity

/-- The supercharge commutes with the Hamiltonian generated by its square. -/
theorem supercharge_commutes_with_hamiltonian :
    R.supercharge.supercharge * R.supercharge.hamiltonian =
      R.supercharge.hamiltonian * R.supercharge.supercharge :=
  R.supercharge.supercharge_commutes_with_hamiltonian

/-- The supplied central charge is central. -/
theorem centralCharge_commutes_theorem (X : Op) :
    R.centralCharge * X = X * R.centralCharge :=
  R.centralCharge_commutes X

/--
Finite Spector readout with supercharge and central-charge bookkeeping.

This packages the finite Witten cancellation with the parity-evenness of the
supplied supercharge Hamiltonian and the explicit central-charge witness.
-/
theorem spector_finite_witten_supercharge_central_packet :
    PrimonSupergradedGasAlgebra.finitePrimonWittenIndex R.register = 0 ∧
      (R.supercharge.supercharge * R.supercharge.supercharge) * R.supercharge.parity =
        R.supercharge.parity * (R.supercharge.supercharge * R.supercharge.supercharge) ∧
      R.supercharge.hamiltonian * R.supercharge.parity =
        R.supercharge.parity * R.supercharge.hamiltonian ∧
      ∀ X : Op, R.centralCharge * X = X * R.centralCharge := by
  exact ⟨R.finiteWittenIndex_cancel, R.supercharge_sq_commutes_with_parity,
    R.hamiltonian_commutes_with_parity, R.centralCharge_commutes_theorem⟩

/--
Finite Spector readout including supercharge Hamiltonian conservation.

This extends the existing packet with `[Q,H]=0`, proved algebraically from the
supplied relation `H = Q²`.
-/
theorem spector_finite_witten_supercharge_conservation_packet :
    PrimonSupergradedGasAlgebra.finitePrimonWittenIndex R.register = 0 ∧
      R.supercharge.supercharge * R.supercharge.hamiltonian =
        R.supercharge.hamiltonian * R.supercharge.supercharge ∧
      R.supercharge.hamiltonian * R.supercharge.parity =
        R.supercharge.parity * R.supercharge.hamiltonian ∧
      ∀ X : Op, R.centralCharge * X = X * R.centralCharge := by
  exact ⟨R.finiteWittenIndex_cancel, R.supercharge_commutes_with_hamiltonian,
    R.hamiltonian_commutes_with_parity, R.centralCharge_commutes_theorem⟩

end SpectorSuperchargeCentralReadout

end InfoGeometry.Arithmetic.SpectorSuperchargeCentralBridge
