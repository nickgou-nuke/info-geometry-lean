LIB "nctools.lib";

// Variables ordered so that Lm1 > L0 > L1 > V > D
ring r = 0, (Lm1, L0, L1, V, D), dp;

matrix C[5][5];
matrix Dmat[5][5];

int i;
int j;
for (i=1; i<=5; i++) {
  for (j=1; j<=5; j++) {
    C[i,j] = 1;
    Dmat[i,j] = 0;
  }
}

// Variables: 1:Lm1, 2:L0, 3:L1, 4:V, 5:D
// Plural requires relations in the upper triangle: x_j * x_i = C[i,j] * x_i * x_j + Dmat[i,j]  for j > i

// We want to define commutators for Lm1, L0, L1.
// j=2, i=1: L0 * Lm1 = Lm1 * L0 + Lm1
C[1,2] = 1; Dmat[1,2] = Lm1;

// j=3, i=1: L1 * Lm1 = Lm1 * L1 + 2*L0
C[1,3] = 1; Dmat[1,3] = 2*L0;

// j=3, i=2: L1 * L0 = L0 * L1 + L1
C[2,3] = 1; Dmat[2,3] = L1;

// Define the non-commutative ring
def R = nc_algebra(C, Dmat);
setring R;

// Define the left ideal for the primary state constraint
ideal I = L1*V, L0*V - D*V;
I = std(I); // std(I) computes a left Groebner basis in Plural

print("Groebner basis of I:");
print(I);

// The expression we want to reduce is L1 * Lm1 * V
poly expr = L1 * Lm1 * V;

print("expr before reduction:");
print(expr);

// Reduce it modulo the left ideal
poly reduced_expr = reduce(expr, I);

print("Original Expression: L1 * Lm1 * V");
print("Reduced modulo state constraints:");
print(reduced_expr);

// Algebraically prove that L1 * Lm1 * V mathematically reduces to exactly 2 * D * V in the ideal quotient.
if (reduced_expr == 2 * D * V) {
  print("Proof successful: L1 * Lm1 * V reduces exactly to 2*D*V.");
} else {
  print("Proof failed.");
}

quit;
