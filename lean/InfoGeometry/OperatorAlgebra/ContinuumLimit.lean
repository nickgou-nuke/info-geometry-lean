import InfoGeometry.OperatorAlgebra.ErlangenJaynesGromov
import Mathlib.Order.Filter.Basic
import Mathlib.Topology.Neighborhoods
import Mathlib.Topology.Basic

/-!
# Algebraic Continuum Limit for Nilpotent Parabolic Updates

This module records the exact algebraic content behind the slogan:

`finite Jaynes/Bayes/JKO steps -> continuum parabolic flow`.

For a square-zero generator `ε`, the rescaled `n`-step update with step size
`t / n` is not merely asymptotic.  For every nonzero scalar cast of `n`, it is
definitionally the same parabolic translation:

`(1 + (t / n) ε)^n = 1 + t ε`.

No topology, analytic continuation, compactness, or convergence theorem is used
here.  The analytic limit can be added later as an enrichment; the structural
identity already lives in algebra.
-/

noncomputable section

namespace InfoGeometry.OperatorAlgebra.ContinuumLimit

open Filter

open InfoGeometry.OperatorAlgebra.ErlangenJaynesGromov
open InfoGeometry.OperatorAlgebra.ErlangenJaynesGromov.OperatorErlangenSystem

universe uK uA

variable {K : Type uK} {A : Type uA}
variable [Field K] [Ring A] [Algebra K A]

/-- One rescaled nilpotent parabolic update step of size `t / n`. -/
def scaledParabolicStep (ε : A) (t : K) (n : ℕ) : A :=
  1 + (t / (n : K)) • ε

/-- The algebraic continuum parabolic flow generated by a square-zero element. -/
def continuumParabolicFlow (ε : A) (t : K) : A :=
  1 + t • ε

@[simp]
theorem continuumParabolicFlow_zero (ε : A) :
    continuumParabolicFlow ε (0 : K) = 1 := by
  simp [continuumParabolicFlow]

/--
Exact rescaled-step law.

For every `n` whose scalar cast is nonzero, `n` rescaled parabolic updates with
step `t / n` equal the continuum parabolic flow at time `t`.
-/
theorem scaledParabolicStep_pow_exact
    (ε : A) (hε : ε * ε = 0) (t : K) {n : ℕ} (hn : (n : K) ≠ 0) :
    (scaledParabolicStep ε t n) ^ n = continuumParabolicFlow ε t := by
  rw [scaledParabolicStep, continuumParabolicFlow]
  rw [nilpotent_power_law (R := K) (A := A) ε hε (t / (n : K)) n]
  have hscale : (n : K) * (t / (n : K)) = t := by
    field_simp [hn]
  rw [hscale]

/--
The structural continuum limit is constant on the punctured finite-time mesh:
the only excluded mesh size is one whose scalar cast vanishes.
-/
theorem scaledParabolicStep_pow_eq_flow_iff_nonzero_cast
    (ε : A) (hε : ε * ε = 0) (t : K) (n : ℕ) (hn : (n : K) ≠ 0) :
    (scaledParabolicStep ε t n) ^ n = continuumParabolicFlow ε t :=
  scaledParabolicStep_pow_exact ε hε t hn

/-- At one mesh interval, the exact continuum law is just the single update. -/
@[simp]
theorem scaledParabolicStep_pow_one
    (ε : A) (hε : ε * ε = 0) (t : K) :
    (scaledParabolicStep ε t 1) ^ (1 : ℕ) = continuumParabolicFlow ε t := by
  exact scaledParabolicStep_pow_exact ε hε t (by simp)

section RealTopology

variable {A₀ : Type uA}
variable [Ring A₀] [Algebra ℝ A₀] [TopologicalSpace A₀]

/--
Real rescaled nilpotent mesh used for the topological convergence corollary.

The value at `n = 0` is assigned to the continuum flow so that the mesh is a
total sequence on `ℕ`; the convergence theorem only uses the tail `n ≥ 1`.
-/
def realScaledParabolicMesh (ε : A₀) (t : ℝ) (n : ℕ) : A₀ :=
  if 1 ≤ n then (scaledParabolicStep ε t n) ^ n else continuumParabolicFlow ε t

/--
Topological continuum corollary for the real nilpotent mesh.

The convergence is immediate because the sequence is eventually constant:
for every `n ≥ 1`, the algebraic identity already gives the continuum flow.
-/
theorem continuum_parabolic_diffusion
    (ε : A₀) (hε : ε * ε = 0) (t : ℝ) :
    Tendsto (realScaledParabolicMesh ε t) atTop (nhds (continuumParabolicFlow ε t)) := by
  refine tendsto_atTop_of_eventually_const (i₀ := 1) ?_
  intro n hn
  have hn0 : n ≠ 0 := Nat.ne_of_gt (Nat.lt_of_lt_of_le Nat.zero_lt_one hn)
  rw [realScaledParabolicMesh, if_pos hn]
  exact scaledParabolicStep_pow_exact ε hε t (Nat.cast_ne_zero.mpr hn0)

end RealTopology

/--
Algebraic ergodic/projection compatibility packet.

This packages the exact continuum identity together with an idempotent
coarse-graining map fixing the generator.  It is a finite algebraic statement,
not an analytic theorem about metric convergence or invariant measures.
-/
structure ParabolicContinuumProjectionPacket where
  /-- Square-zero parabolic generator. -/
  generator : A
  /-- Local nilpotent law. -/
  generator_squareZero : generator * generator = 0
  /-- Algebraic coarse-graining projection. -/
  projection : A →ₐ[K] A
  /-- Projection is idempotent. -/
  projection_idempotent : ∀ a : A, projection (projection a) = projection a
  /-- The generator survives coarse graining. -/
  projection_fixes_generator : projection generator = generator

namespace ParabolicContinuumProjectionPacket

variable (P : ParabolicContinuumProjectionPacket (K := K) (A := A))

/-- Coarse graining fixes the continuum parabolic flow generated by `P.generator`. -/
theorem projection_fixes_flow (t : K) :
    P.projection (continuumParabolicFlow P.generator t) =
      continuumParabolicFlow P.generator t := by
  simp [continuumParabolicFlow, P.projection_fixes_generator]

/--
Coarse graining fixes the exact `n`-step rescaled update, after identifying it
with the algebraic continuum flow.
-/
theorem projection_fixes_scaled_pow
    (t : K) {n : ℕ} (hn : (n : K) ≠ 0) :
    P.projection ((scaledParabolicStep P.generator t n) ^ n) =
      continuumParabolicFlow P.generator t := by
  rw [scaledParabolicStep_pow_exact P.generator P.generator_squareZero t hn]
  exact P.projection_fixes_flow t

end ParabolicContinuumProjectionPacket

end InfoGeometry.OperatorAlgebra.ContinuumLimit
