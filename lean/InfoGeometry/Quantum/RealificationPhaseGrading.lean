import InfoGeometry.Quantum.Realification
import InfoGeometry.Quantum.SylvesterWeylBraidBridge
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
import Mathlib.Tactic.Abel

/-!
# Internal real phase coefficients and Pauli homogeneous planes

The phase plane is defined over the reals using the existing internal block
operator. Complex scalars appear only in comparison theorems. Ordered Weyl
products retain their phase and matrix order. A complex homogeneous line has
an actual two-dimensional real image when its generator is nonzero.

The word identities do not assert a direct-sum or fine-grading classification.
Unreduced words retain the signed power relations of the chosen generators.
-/

noncomputable section

open Matrix

namespace InfoGeometry.Quantum.Realification

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Internal scalar coefficients in the real plane generated by `1` and `J`. -/
def internalScalar (a b : ℝ) : Matrix (n ⊕ n) (n ⊕ n) ℝ :=
  a • 1 + b • internalJ

omit [Fintype n] in
@[simp] theorem internalScalar_one : internalScalar (n := n) 1 0 = 1 := by
  simp [internalScalar]

omit [Fintype n] in
@[simp] theorem internalScalar_axis : internalScalar (n := n) 0 1 = internalJ := by
  simp [internalScalar]

/-- Complex multiplication is the native multiplication of this real plane. -/
theorem internalScalar_mul (a b c d : ℝ) :
    internalScalar (n := n) a b * internalScalar c d =
      internalScalar (a * c - b * d) (a * d + b * c) := by
  simp only [internalScalar, add_mul, mul_add, smul_mul_smul, one_mul,
    mul_one, internalJ_sq, smul_neg, sub_smul, add_smul]
  abel

/-- Operators compatible with `J` commute with every internal coefficient. -/
theorem commute_internalScalar (A : Matrix (n ⊕ n) (n ⊕ n) ℝ)
    (hA : Commute A internalJ) (a b : ℝ) :
    Commute A (internalScalar a b) := by
  change A * internalScalar a b = internalScalar a b * A
  simp only [internalScalar, mul_add, add_mul, mul_smul_comm, smul_mul_assoc,
    mul_one, one_mul, hA.eq]

omit [Fintype n] in
/-- The comparison with an ordinary complex scalar is a proved identity. -/
theorem realify_scalar_one (z : ℂ) :
    realify (z • (1 : Matrix n n ℂ)) = internalScalar z.re z.im := by
  ext i j
  rcases i with i | i <;> rcases j with j | j <;>
    by_cases hij : i = j <;>
      simp [internalScalar, internalJ, hij]

/-- Complex scalar multiplication becomes multiplication by an internal matrix. -/
theorem realify_complex_smul (z : ℂ) (A : Matrix n n ℂ) :
    realify (z • A) = internalScalar z.re z.im * realify A := by
  rw [← realify_scalar_one, ← realify_mul]
  simp

/-- A real phase rotor, distinguished from its infinitesimal generator `J`. -/
def internalRotor (θ : ℝ) : Matrix (n ⊕ n) (n ⊕ n) ℝ :=
  internalScalar (Real.cos θ) (Real.sin θ)

omit [Fintype n] in
@[simp] theorem internalRotor_zero : internalRotor (n := n) 0 = 1 := by
  simp [internalRotor]

theorem internalRotor_add (θ φ : ℝ) :
    internalRotor (n := n) θ * internalRotor φ = internalRotor (θ + φ) := by
  simp only [internalRotor, internalScalar_mul, Real.cos_add, Real.sin_add]
  rw [add_comm (Real.sin θ * Real.cos φ)]

theorem internalRotor_mul_neg (θ : ℝ) :
    internalRotor (n := n) θ * internalRotor (-θ) = 1 := by
  rw [internalRotor_add, add_neg_cancel, internalRotor_zero]

omit [Fintype n] in
/-- The internal phase generator is skew for the positive real Hilbert adjoint. -/
@[simp] theorem internalJ_transpose :
    (internalJ (n := n)).transpose = -internalJ := by
  ext i j
  cases i <;> cases j <;> simp [internalJ, Matrix.one_apply, eq_comm]

omit [Fintype n] in
@[simp] theorem internalRotor_transpose (θ : ℝ) :
    (internalRotor (n := n) θ).transpose = internalRotor (-θ) := by
  simp [internalRotor, internalScalar, Matrix.transpose_add, Matrix.transpose_smul]

/-- Real phase evolution is orthogonal for the positive Hilbert metric. -/
theorem internalRotor_orthogonal (θ : ℝ) :
    (internalRotor (n := n) θ).transpose * internalRotor θ = 1 := by
  rw [internalRotor_transpose, internalRotor_add, neg_add_cancel, internalRotor_zero]

/-- The real homogeneous component generated by an operator and its phase. -/
def phasePlane (W : Matrix (n ⊕ n) (n ⊕ n) ℝ) :
    Submodule ℝ (Matrix (n ⊕ n) (n ⊕ n) ℝ) :=
  Submodule.span ℝ {W, internalJ * W}

theorem mem_phasePlane_iff (W M : Matrix (n ⊕ n) (n ⊕ n) ℝ) :
    M ∈ phasePlane W ↔ ∃ a b : ℝ, internalScalar a b * W = M := by
  simp only [phasePlane, Submodule.mem_span_pair, internalScalar, add_mul,
    smul_mul_assoc, one_mul]

/-- Internal coefficients preserve their homogeneous real component. -/
theorem internalScalar_mul_mem_phasePlane (W : Matrix (n ⊕ n) (n ⊕ n) ℝ)
    (a b : ℝ) : internalScalar a b * W ∈ phasePlane W :=
  (mem_phasePlane_iff _ _).mpr ⟨a, b, rfl⟩

/-- The real plane is exactly the image of the original complex line. -/
theorem mem_phasePlane_realify_iff (W : Matrix n n ℂ)
    (M : Matrix (n ⊕ n) (n ⊕ n) ℝ) :
    M ∈ phasePlane (realify W) ↔ ∃ z : ℂ, realify (z • W) = M := by
  rw [mem_phasePlane_iff]
  constructor
  · rintro ⟨a, b, h⟩
    exact ⟨⟨a, b⟩, (realify_complex_smul ⟨a, b⟩ W).trans h⟩
  · rintro ⟨z, h⟩
    exact ⟨z.re, z.im, (realify_complex_smul z W).symm.trans h⟩

/-- A nonzero complex line has two independent real phase directions. -/
theorem realify_phase_pair_linearIndependent (W : Matrix n n ℂ) (hW : W ≠ 0) :
    LinearIndependent ℝ ![realify W, internalJ * realify W] := by
  rw [LinearIndependent.pair_iff]
  intro a b hab
  have hz : realify ((⟨a, b⟩ : ℂ) • W) = 0 := by
    rw [realify_complex_smul]
    simpa only [internalScalar, add_mul, smul_mul_assoc, one_mul] using hab
  have hz' : (⟨a, b⟩ : ℂ) • W = 0 := by
    apply realify_injective
    simpa using hz
  have hz0 : (⟨a, b⟩ : ℂ) = 0 := (smul_eq_zero.mp hz').resolve_right hW
  exact ⟨congrArg Complex.re hz0, congrArg Complex.im hz0⟩

theorem finrank_phasePlane_realify (W : Matrix n n ℂ) (hW : W ≠ 0) :
    Module.finrank ℝ (phasePlane (realify W)) = 2 := by
  have h := finrank_span_eq_card (realify_phase_pair_linearIndependent W hW)
  rw [Matrix.range_cons_cons_empty] at h
  exact h

/-- The actual homogeneous product respects the internal phase plane. -/
theorem phasePlane_mul {A B M N : Matrix (n ⊕ n) (n ⊕ n) ℝ}
    (hA : Commute A internalJ) (hM : M ∈ phasePlane A) (hN : N ∈ phasePlane B) :
    M * N ∈ phasePlane (A * B) := by
  obtain ⟨a, b, rfl⟩ := (mem_phasePlane_iff A M).mp hM
  obtain ⟨c, d, rfl⟩ := (mem_phasePlane_iff B N).mp hN
  have hc := (commute_internalScalar A hA c d).eq
  have hprod : (internalScalar a b * A) * (internalScalar c d * B) =
      internalScalar (a * c - b * d) (a * d + b * c) * (A * B) := by
    calc
      _ = internalScalar a b * (A * internalScalar c d) * B := by
        simp only [mul_assoc]
      _ = (internalScalar a b * internalScalar c d) * (A * B) := by
        rw [hc]
        simp only [mul_assoc]
      _ = _ := by rw [internalScalar_mul]
  rw [hprod]
  exact internalScalar_mul_mem_phasePlane _ _ _

/-- The second real trace detects the imaginary part of the complex trace. -/
theorem trace_internalJ_realify (A : Matrix n n ℂ) :
    trace (internalJ * realify A) = -2 * (trace A).im := by
  have h := trace_realify ((⟨0, 1⟩ : ℂ) • A)
  rw [realify_complex_smul] at h
  simpa [internalScalar, trace_smul, Complex.mul_re] using h

/-- Both real trace conditions are necessary to recover complex trace zero. -/
theorem trace_realify_zero_iff (A : Matrix n n ℂ) :
    trace (realify A) = 0 ∧ trace (internalJ * realify A) = 0 ↔ trace A = 0 := by
  rw [trace_realify, trace_internalJ_realify]
  constructor
  · rintro ⟨hre, him⟩
    apply Complex.ext
    · simpa using (mul_eq_zero.mp hre).resolve_left (by norm_num : (2 : ℝ) ≠ 0)
    · simpa using (mul_eq_zero.mp him).resolve_left (by norm_num : (-2 : ℝ) ≠ 0)
  · intro h
    simp [h]

/-- The compatible, twice-traceless real sector is exactly the image of `sl`. -/
theorem traceZero_preimage_iff (M : Matrix (n ⊕ n) (n ⊕ n) ℝ) :
    (∃ A : Matrix n n ℂ, trace A = 0 ∧ realify A = M) ↔
      Commute M internalJ ∧ trace M = 0 ∧ trace (internalJ * M) = 0 := by
  constructor
  · rintro ⟨A, hA, rfl⟩
    exact ⟨realify_commutes_internalJ A, (trace_realify_zero_iff A).mpr hA⟩
  · rintro ⟨hJ, htr⟩
    refine ⟨unrealify M, ?_, realify_unrealify_of_commute M hJ⟩
    apply (trace_realify_zero_iff _).mp
    simpa only [realify_unrealify_of_commute M hJ] using htr

/-- Realification retains powers, including the minus-one relations at even `N`. -/
theorem realify_pow (A : Matrix n n ℂ) (k : ℕ) :
    realify (A ^ k) = realify A ^ k :=
  map_pow realifyRingHom A k

theorem realify_pow_eq_neg_one {A : Matrix n n ℂ} {k : ℕ}
    (hA : A ^ k = -1) : realify A ^ k = -1 := by
  rw [← realify_pow, hA, realify_neg, realify_one]

/-- Unreduced Weyl words have exactly the same ordered real matrix word. -/
theorem realify_weylD (X Z : Matrix n n ℂ) (a b : ℕ) :
    realify (Weyl.weylD X Z a b) = Weyl.weylD (realify X) (realify Z) a b := by
  simp only [Weyl.weylD, realify_mul, realify_pow]

/-- The paper's projective coefficient becomes an internal real phase matrix. -/
theorem realify_weylD_mul (X Z : Matrix n n ℂ) (ω : ℂ)
    (hZX : Z * X = ω • (X * Z)) (a b c d : ℕ) :
    Weyl.weylD (realify X) (realify Z) a b *
        Weyl.weylD (realify X) (realify Z) c d =
      internalScalar (ω ^ (b * c)).re (ω ^ (b * c)).im *
        Weyl.weylD (realify X) (realify Z) (a + c) (b + d) := by
  rw [← realify_weylD, ← realify_weylD, ← realify_mul,
    Weyl.weylD_mul X Z ω hZX, realify_complex_smul, realify_weylD]

/-- Derive the bracket sign from the ordered product instead of relabeling it. -/
theorem realify_weylD_bracket (X Z : Matrix n n ℂ) (ω : ℂ)
    (hZX : Z * X = ω • (X * Z)) (a b c d : ℕ) :
    Weyl.weylD (realify X) (realify Z) a b *
        Weyl.weylD (realify X) (realify Z) c d -
      Weyl.weylD (realify X) (realify Z) c d *
        Weyl.weylD (realify X) (realify Z) a b =
      internalScalar (ω ^ (b * c) - ω ^ (d * a)).re
          (ω ^ (b * c) - ω ^ (d * a)).im *
        Weyl.weylD (realify X) (realify Z) (a + c) (b + d) := by
  rw [← realify_weylD, ← realify_weylD, ← realify_mul, ← realify_mul,
    ← realify_sub, Weyl.weylD_mul X Z ω hZX, Weyl.weylD_mul X Z ω hZX]
  rw [Nat.add_comm c a, Nat.add_comm d b, ← sub_smul, realify_complex_smul,
    realify_weylD]

/-- Products of whole homogeneous planes obey the same degree-addition law. -/
theorem weyl_phasePlane_mul (X Z : Matrix n n ℂ) (ω : ℂ)
    (hZX : Z * X = ω • (X * Z)) (a b c d : ℕ)
    {M N : Matrix (n ⊕ n) (n ⊕ n) ℝ}
    (hM : M ∈ phasePlane (realify (Weyl.weylD X Z a b)))
    (hN : N ∈ phasePlane (realify (Weyl.weylD X Z c d))) :
    M * N ∈ phasePlane (realify (Weyl.weylD X Z (a + c) (b + d))) := by
  obtain ⟨z, rfl⟩ := (mem_phasePlane_realify_iff _ _).mp hM
  obtain ⟨w, rfl⟩ := (mem_phasePlane_realify_iff _ _).mp hN
  apply (mem_phasePlane_realify_iff _ _).mpr
  refine ⟨z * w * ω ^ (b * c), ?_⟩
  rw [← realify_mul, smul_mul_smul, Weyl.weylD_mul X Z ω hZX, smul_smul]

/-- The constructed clock and shift discharge the braid premise explicitly. -/
theorem realify_sylvester_braid (N : ℕ) [NeZero N] (ω : ℂ) (hω : ω ^ N = 1) :
    realify (SylvesterWeylBraid.clockMatrix N ω) *
        realify (SylvesterWeylBraid.shiftMatrix N (R := ℂ)) =
      internalScalar ω.re ω.im *
        (realify (SylvesterWeylBraid.shiftMatrix N (R := ℂ)) *
          realify (SylvesterWeylBraid.clockMatrix N ω)) := by
  rw [← realify_mul, SylvesterWeylBraid.sylvester_weyl_braid_relation N ω hω,
    realify_complex_smul, realify_mul]

end InfoGeometry.Quantum.Realification
