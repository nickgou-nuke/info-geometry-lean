import InfoGeometry.Basic
import InfoGeometry.Canonical.FierzReadout
import InfoGeometry.Meta.Architecture
import Mathlib.Algebra.Lie.OfAssociative

/-!
# InfoGeometry.Canonical.OperatorialFierzDerivationBridge

Constructive bridge for the Operatorial Fierz Identity and emergent spacetime
derivations.

This file formalizes the transition from spatial derivatives (∂_μ) to algebraic
derivations ([K, ·]), following the Tomita-Takesaki/Fierz synthesis.

In the repository ontology:
- A "Vector Field" is an inner derivation of the observable algebra.
- The "Modular Flow" is the master derivation generated by the thermal vacuum.
- Spacetime emergence is the identification of the Fierz Grade-1 derivation
  with the Modular derivation.
-/

open FierzReadout

namespace InfoGeometry.Canonical.OperatorialFierz

variable {𝒜 : Type*} [NormedRing 𝒜] [NormedAlgebra ℝ 𝒜] [StarRing 𝒜]

/--
Noncommutative operator derivation on the observable algebra.

This is the owner surface used in the operatorial Fierz bridge: the algebra is
not assumed commutative, so we package the Leibniz rule explicitly instead of
forcing Mathlib's commutative `Derivation` type.
-/
@[rep_depth operator]
structure OperatorDerivation (𝒜 : Type*) [Add 𝒜] [SMul ℝ 𝒜] [Mul 𝒜] where
  toFun : 𝒜 → 𝒜
  map_add' : ∀ X Y, toFun (X + Y) = toFun X + toFun Y
  map_smul' : ∀ (r : ℝ) X, toFun (r • X) = r • toFun X
  leibniz' : ∀ X Y, toFun (X * Y) = toFun X * Y + X * toFun Y

instance {𝒜 : Type*} [Add 𝒜] [SMul ℝ 𝒜] [Mul 𝒜] :
    CoeFun (OperatorDerivation 𝒜) (fun _ => 𝒜 → 𝒜) :=
  ⟨OperatorDerivation.toFun⟩

/--
Inner derivation generated by an operator `A`: `δ_A(X) = [A, X]`.

This replaces the classical coordinate-based derivative.
-/
@[rep_depth operator]
def innerDerivation (A : 𝒜) : OperatorDerivation 𝒜 where
  toFun := fun X => A * X - X * A
  map_add' := fun X Y => by
    simp only [mul_add, add_mul]
    abel
  map_smul' := fun r X => by
    simp only [Algebra.mul_smul_comm, Algebra.smul_mul_assoc, smul_sub]
  leibniz' := fun X Y => by
    simp only [mul_add, add_mul, mul_assoc, sub_eq_add_neg, neg_mul, mul_neg]
    -- After expansion: AXY + -(XYA) = (AXY + -(XAY)) + (XAY + -(XYA))
    -- This is a simple additive identity.
    abel

/--
Grade-1 (Vector) projection of an operator.
In a physical spacetime model, this extracts the translational generator.
-/
@[rep_depth operator]
structure FierzGradeProjections (𝒜 : Type*) [Add 𝒜] [SMul ℝ 𝒜] where
  grade1 : 𝒜 → 𝒜
  is_linear : ∀ (r : ℝ) (A B : 𝒜), grade1 (r • A + B) = r • grade1 A + grade1 B

/--
Emergent spacetime derivation generated by the Grade-1 Fierz piece of two 
spinorial operators `Ψ` and `Φ`.
-/
@[rep_depth operator]
def emergentSpacetimeDerivation 
    (P : FierzGradeProjections 𝒜) (Ψ Φ : 𝒜) : OperatorDerivation 𝒜 :=
  innerDerivation (P.grade1 (Ψ * star Φ))

/--
The Thermodynamic Gravity Equivalence:
Spacetime exists when the thermal modular flow is identified with the 
emergent Fierz vector derivation.
-/
@[rep_depth transport]
def SpacetimeIsThermalFlow 
    (K_mod : 𝒜) (P : FierzGradeProjections 𝒜) (Ψ Φ : 𝒜) : Prop :=
  innerDerivation K_mod = emergentSpacetimeDerivation P Ψ Φ

/--
Theorem: The Grade-1 Fierz derivation satisfies the Leibniz rule by construction.
This ensures that emergent spacetime is a valid infinitesimal transformation 
without requiring a manifold.
-/
theorem emergentSpacetime_is_derivation 
    (P : FierzGradeProjections 𝒜) (Ψ Φ : 𝒜) :
    ∀ (X Y : 𝒜), 
      (emergentSpacetimeDerivation P Ψ Φ) (X * Y) = 
      (emergentSpacetimeDerivation P Ψ Φ) X * Y + X * (emergentSpacetimeDerivation P Ψ Φ) Y :=
  fun X Y => (emergentSpacetimeDerivation P Ψ Φ).leibniz' X Y

end InfoGeometry.Canonical.OperatorialFierz
