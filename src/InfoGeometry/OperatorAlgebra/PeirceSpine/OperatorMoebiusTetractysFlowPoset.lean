-- 5. RINDLER HORIZON SHOCKWAVE ALGEBRA & TWO-SHOCKWAVE SCATTERING (𝔖Yr₂–𝔖Yr₆)
-- ============================================================================

/--
**Theorem 5 (`𝔖Yr₂`–`𝔖Yr₃` — The `𝔰𝔩₂` Rindler Horizon Lie Algebra & One-Sided Scramblon Kick):**
For any idempotent `P * P = P` and `X, Y, W : B`:
1. `comm (S_P P) (N_plus P X) = N_plus P X + N_plus P X`,
2. `comm (S_P P) (N_minus P Y) = - (N_minus P Y + N_minus P Y)`,
3. `comm (N_plus P X) (N_minus P Y) = Sigma_sp P X Y` and `S_P P * V_met P X Y = Sigma_sp P X Y`,
4. `comm (S_P P) (TFD_Symmetric P W) = 0` (two-sided diagonal invariance),
5. `comm (S_P P) (Phi_v P X Y) = J_mc P X Y + J_mc P X Y` (one-sided off-diagonal excitation).
-/
theorem sl2_rindler_wedge_and_tfd_scramblon_excitation
    (P X Y W : B) (hP : P * P = P) :
    comm (S_P P) (N_plus P X) = N_plus P X + N_plus P X ∧
    comm (S_P P) (N_minus P Y) = - (N_minus P Y + N_minus P Y) ∧
    comm (N_plus P X) (N_minus P Y) = Sigma_sp P X Y ∧
    S_P P * V_met P X Y = Sigma_sp P X Y ∧
    comm (S_P P) (TFD_Symmetric P W) = 0 ∧
    comm (S_P P) (Phi_v P X Y) = J_mc P X Y + J_mc P X Y := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  · dsimp only [S_P, N_plus, N_minus, Phi_v, J_mc, V_met, Sigma_sp,
                Q_pos, Q_neg, TFD_Symmetric, comm]
    amari_peirce_nf hP

/--
**Theorem 6 (`𝔖Yr₄`–`𝔖Yr₆` — Scramblon Corner Defect & Two-Shockwave Scattering):**
For any idempotent `P * P = P` and `G, X, Y : B` with unipotent parabolic shears
`E_fut = 1 + N_plus P X` and `E_past = 1 + N_minus P Y`:
1. `ScramblonLadderDefect P G = N_plus P G * N_minus P G`,
2. `(E_fut * E_past - (1 + Phi_v P X Y)) + (E_past * E_fut - (1 + Phi_v P X Y)) = V_met P X Y`,
3. `comm E_fut E_past = Sigma_sp P X Y`,
4. `comm (S_P P) (V_met P X Y) = 0` and `comm (S_P P) (Sigma_sp P X Y) = 0`.
-/
theorem wick_scramblon_ladder_and_shockwave_entanglement_action
    (P G X Y : B) (hP : P * P = P) :
    let np := N_plus P X
    let nm := N_minus P Y
    let ph := Phi_v P X Y
    let E_fut  := 1 + np
    let E_past := 1 + nm
    ScramblonLadderDefect P G = N_plus P G * N_minus P G ∧
    (E_fut * E_past - (1 + ph)) + (E_past * E_fut - (1 + ph)) = V_met P X Y ∧
    comm E_fut E_past = Sigma_sp P X Y ∧
    comm (S_P P) (V_met P X Y) = 0 ∧
    comm (S_P P) (Sigma_sp P X Y) = 0 := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;>
  · dsimp only [ScramblonLadderDefect, S_P, N_plus, N_minus, Phi_v,
                V_met, Sigma_sp, Q_pos, Q_neg, comm]
    amari_peirce_nf hP

