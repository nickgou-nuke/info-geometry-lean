import InfoGeometry.OperatorAlgebra.SchurIdempotencyDefect
import Mathlib.Logic.Relation
import Mathlib.Order.WellFounded

/-!
# Finite dyadic Schur descent and its reachability order

Each stage is a full two-by-two matrix ring over the previous stage. A step
requires an actual unit equal to the head entry, and passes to the ordered
Schur tail. Depth falls by exactly one. Reachability therefore defines a
partial order on the native dependent sum of stages, with ancestors below
their descendants, and an admissible path transports idempotence.

The reverse step relation is well-founded, ruling out an infinite sequence
of reductions. A positive-depth matrix can nevertheless be stuck when its
head is not a unit; existence of a path to depth zero is not asserted.
-/

namespace InfoGeometry.OperatorAlgebra.DyadicSchurDescent

universe u

/-- Repeated full matrix doubling, retaining the original coefficient ring. -/
abbrev Stage (A : Type u) : ℕ → Type u :=
  Nat.rec A (fun _ B => Matrix (Fin 2) (Fin 2) B)

variable {A : Type u} [Ring A]

instance stageRing : (n : ℕ) → Ring (Stage A n) :=
  Nat.rec (inferInstanceAs (Ring A)) fun n ih =>
    letI : Ring (Stage A n) := ih
    inferInstanceAs (Ring (Matrix (Fin 2) (Fin 2) (Stage A n)))

/-- An operator together with its finite matrix depth. -/
abbrev Node (A : Type u) := Σ n, Stage A n

/-- Idempotence in the actual ring at the node's depth. -/
def Node.Idempotent (x : Node A) : Prop := IsIdempotentElem x.2

/-- The ordered tail at a proposed unit pivot. The step relation additionally
requires that this unit is the head of the matrix. -/
def schurTail {n : ℕ} (M : Stage A (n + 1)) (pivot : (Stage A n)ˣ) : Stage A n :=
  M 1 1 - M 1 0 * (↑pivot⁻¹ : Stage A n) * M 0 1

/-- A supplied head unit justifies a single reduction. No conclusion about
idempotence is stored in this relation. -/
inductive Step : Node A → Node A → Prop
  | reduce (n : ℕ) (M : Stage A (n + 1)) (pivot : (Stage A n)ˣ)
      (head_eq : (pivot : Stage A n) = M 0 0) :
      Step ⟨n + 1, M⟩ ⟨n, schurTail M pivot⟩

theorem step_depth {x y : Node A} (h : Step x y) : y.1 + 1 = x.1 := by
  cases h
  rfl

theorem step_depth_lt {x y : Node A} (h : Step x y) : y.1 < x.1 := by
  rw [← step_depth h]
  exact Nat.lt_succ_self _

/-- Reachable nodes cannot have greater depth than their ancestors. -/
theorem reachable_depth_le {x y : Node A} (h : Relation.ReflTransGen Step x y) :
    y.1 ≤ x.1 := by
  induction h with
  | refl => exact le_rfl
  | tail _ hstep ih =>
      exact le_trans (le_of_lt (step_depth_lt hstep)) ih

/-- Every nonempty path strictly reduces depth. -/
theorem reachable_eq_or_depth_lt {x y : Node A}
    (h : Relation.ReflTransGen Step x y) : x = y ∨ y.1 < x.1 := by
  cases h with
  | refl => exact Or.inl rfl
  | tail hpath hstep =>
      exact Or.inr (lt_of_lt_of_le (step_depth_lt hstep) (reachable_depth_le hpath))

theorem reachable_antisymm {x y : Node A}
    (hxy : Relation.ReflTransGen Step x y)
    (hyx : Relation.ReflTransGen Step y x) : x = y := by
  rcases reachable_eq_or_depth_lt hxy with heq | hlt
  · exact heq
  · exact False.elim ((not_lt_of_ge (reachable_depth_le hyx)) hlt)

/-- The order is generated by actual Schur reductions, not assigned to
names of stages. Its orientation is ancestor ≤ descendant. -/
instance nodePartialOrder : PartialOrder (Node A) where
  le := Relation.ReflTransGen Step
  le_refl _ := Relation.ReflTransGen.refl
  le_trans _ _ _ := Relation.ReflTransGen.trans
  le_antisymm _ _ := reachable_antisymm

theorem step_lt {x y : Node A} (h : Step x y) : x < y := by
  apply (lt_iff_le_not_ge).2
  refine ⟨Relation.ReflTransGen.single h, ?_⟩
  intro hback
  exact (not_lt_of_ge (reachable_depth_le hback)) (step_depth_lt h)

theorem transGen_depth_lt {x y : Node A} (h : Relation.TransGen Step x y) :
    y.1 < x.1 := by
  induction h with
  | single hstep => exact step_depth_lt hstep
  | tail _ hstep ih => exact lt_trans (step_depth_lt hstep) ih

/-- No nonempty sequence of reductions returns to its initial operator. -/
theorem no_cycle (x : Node A) : ¬Relation.TransGen Step x x := by
  intro h
  exact (lt_irrefl x.1) (transGen_depth_lt h)

/-- Well-foundedness uses the reverse orientation of `Step`: predecessors
in this relation are the smaller-depth descendants. -/
theorem reverse_step_wellFounded : WellFounded (Function.swap (Step (A := A))) := by
  apply (measure (fun x : Node A => x.1)).wf.mono
  intro x y h
  exact step_depth_lt h

theorem no_infinite_descent (f : ℕ → Node A) :
    ¬∀ n, Step (f n) (f (n + 1)) := by
  intro hf
  have hEmpty := wellFounded_iff_isEmpty_descending_chain.mp
    (reverse_step_wellFounded (A := A))
  exact hEmpty.false ⟨f, hf⟩

/-- Idempotence descends through a genuine unit pivot. -/
theorem schurTail_idempotent {n : ℕ} (M : Stage A (n + 1))
    (pivot : (Stage A n)ˣ) (head_eq : (pivot : Stage A n) = M 0 0)
    (hM : IsIdempotentElem M) : IsIdempotentElem (schurTail M pivot) := by
  apply SchurIdempotencyDefect.schur_isIdempotentElem M (↑pivot⁻¹ : Stage A n)
  · rw [← head_eq]
    exact pivot.mul_inv
  · rw [← head_eq]
    exact pivot.inv_mul
  · exact hM

theorem idempotent_of_step {x y : Node A} (h : Step x y)
    (hx : x.Idempotent) : y.Idempotent := by
  cases h with
  | reduce n M pivot head_eq =>
      exact schurTail_idempotent M pivot head_eq hx

/-- Every finite admissible path preserves idempotence. -/
theorem idempotent_of_reachable {x y : Node A}
    (h : Relation.ReflTransGen Step x y) (hx : x.Idempotent) : y.Idempotent := by
  induction h with
  | refl => exact hx
  | tail _ hstep ih => exact idempotent_of_step hstep ih

/-- A depth-zero coefficient admits no further matrix reduction. -/
theorem zero_depth_terminal (a : A) (y : Node A) : ¬Step ⟨0, a⟩ y := by
  intro h
  exact Nat.not_lt_zero _ (step_depth_lt h)

/-- If an admissible path actually reaches depth zero, its terminal element
is an idempotent in the original, still arbitrary noncommutative ring. -/
theorem terminal_idempotent {x : Node A} {a : A}
    (h : x ≤ ⟨0, a⟩) (hx : x.Idempotent) : IsIdempotentElem a :=
  idempotent_of_reachable h hx

end InfoGeometry.OperatorAlgebra.DyadicSchurDescent
