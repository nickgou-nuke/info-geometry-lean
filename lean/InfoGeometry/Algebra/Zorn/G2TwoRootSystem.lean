import InfoGeometry.OperatorAlgebra.G2TwoAutomorphismTheorem
import InfoGeometry.Algebra.Zorn.G2TwoConcreteWeylG2
import InfoGeometry.Algebra.Zorn.G2TwoOuterGenerators
import Mathlib.Tactic

namespace InfoGeometry.Algebra.Zorn.G2TwoRootSystem

open InfoGeometry.OperatorAlgebra.G2TwoAutomorphismTheorem
open InfoGeometry.Algebra.Zorn.G2ConcreteWeylG2
open InfoGeometry.Algebra.Zorn.G2TwoOuterGenerators
open InfoGeometry.Algebra.Zorn.G2Unipotent

/-- Root length in the G₂ root system: Short (length √2) or Long (length √6). -/
inductive RootLength : Type
  | Short : RootLength
  | Long  : RootLength
  deriving DecidableEq, Repr

/-- The 12 roots of G₂ indexed as RootLength × ZMod 6. -/
abbrev G2Root := RootLength × ZMod 6

/-- The base short root S₀ = uShort. -/
def S0 : SplitOctF2Aut := unipotentShortAut true

/-- The base long root L₀ = g4Aut. -/
def L0 : SplitOctF2Aut := g4Aut

/-- The 12 root automorphisms in SplitOctF2Aut generated by the Coxeter rotation c. -/
noncomputable def rootAut (r : G2Root) : SplitOctF2Aut :=
  let base := match r.1 with
    | RootLength.Short => S0
    | RootLength.Long  => L0
  c ^ r.2.val * base * (c ^ r.2.val)⁻¹

/-- The root subgroup map xRoot : G2Root → Bool → SplitOctF2Aut. -/
noncomputable def xRoot (r : G2Root) (t : Bool) : SplitOctF2Aut :=
  if t then rootAut r else 1

theorem xRoot_false (r : G2Root) : xRoot r false = 1 := rfl

theorem xRoot_true (r : G2Root) : xRoot r true = rootAut r := by
  simp [xRoot]

theorem rootAut_sq (r : G2Root) : rootAut r * rootAut r = 1 := by
  dsimp [rootAut]
  cases r.1
  · have h0 : S0 * S0 = 1 := unipotentShortAut_order true
    calc
      (c ^ r.2.val * S0 * (c ^ r.2.val)⁻¹) * (c ^ r.2.val * S0 * (c ^ r.2.val)⁻¹)
        = c ^ r.2.val * S0 * ((c ^ r.2.val)⁻¹ * c ^ r.2.val) * S0 * (c ^ r.2.val)⁻¹ := by simp [mul_assoc]
      _ = c ^ r.2.val * (S0 * 1 * S0) * (c ^ r.2.val)⁻¹ := by rw [inv_mul_cancel]; simp [mul_assoc]
      _ = c ^ r.2.val * (S0 * S0) * (c ^ r.2.val)⁻¹ := by simp [mul_assoc]
      _ = c ^ r.2.val * 1 * (c ^ r.2.val)⁻¹ := by rw [h0]
      _ = 1 := by simp
  · have h0 : L0 * L0 = 1 := g4Aut_sq
    calc
      (c ^ r.2.val * L0 * (c ^ r.2.val)⁻¹) * (c ^ r.2.val * L0 * (c ^ r.2.val)⁻¹)
        = c ^ r.2.val * L0 * ((c ^ r.2.val)⁻¹ * c ^ r.2.val) * L0 * (c ^ r.2.val)⁻¹ := by simp [mul_assoc]
      _ = c ^ r.2.val * (L0 * 1 * L0) * (c ^ r.2.val)⁻¹ := by rw [inv_mul_cancel]; simp [mul_assoc]
      _ = c ^ r.2.val * (L0 * L0) * (c ^ r.2.val)⁻¹ := by simp [mul_assoc]
      _ = c ^ r.2.val * 1 * (c ^ r.2.val)⁻¹ := by rw [h0]
      _ = 1 := by simp

theorem xRoot_add (r : G2Root) (a b : Bool) :
    xRoot r (a ^^ b) = xRoot r a * xRoot r b := by
  cases a <;> cases b
  · rfl
  · simp [xRoot]
  · simp [xRoot]
  · simpa [xRoot] using (rootAut_sq r).symm

/-- Reflection permutation action on roots under simple reflection s. -/
def sAction (r : G2Root) : G2Root :=
  match r.1 with
  | RootLength.Short => (RootLength.Short, 3 - r.2)
  | RootLength.Long  => (RootLength.Long, -r.2)

/-- Cyclotomic rotation action on roots under Coxeter element c. -/
def cAction (r : G2Root) : G2Root :=
  (r.1, r.2 + 1)

/-- Root negation under longest element / Cartan swap c³. -/
def negAction (r : G2Root) : G2Root :=
  (r.1, r.2 + 3)

theorem rootAut_neg (r : G2Root) :
    rootAut (negAction r) = c ^ 3 * rootAut r * (c ^ 3)⁻¹ := by
  rcases r with ⟨l, k⟩
  dsimp [negAction, rootAut]
  cases l <;> fin_cases k
  all_goals
    apply automorphism_ext_of_basis
    intro i
    fin_cases i <;> rfl

theorem s_rootAut_s (r : G2Root) :
    s * rootAut r * s = rootAut (sAction r) := by
  rcases r with ⟨l, k⟩
  dsimp [sAction, rootAut]
  cases l <;> fin_cases k
  all_goals
    apply automorphism_ext_of_basis
    intro i
    fin_cases i <;> rfl

end InfoGeometry.Algebra.Zorn.G2TwoRootSystem
