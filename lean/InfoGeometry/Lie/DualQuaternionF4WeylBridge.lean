def dualQuaternionF4_e1 : DualQuat := sorry

/-- The second dual-quaternionic generator. -/
def dualQuaternionF4_e2 : DualQuat := sorry

/-- The third dual-quaternionic generator. -/
def dualQuaternionF4_e3 : DualQuat := sorry

/-- The fourth dual-quaternionic generator. -/
def dualQuaternionF4_e4 : DualQuat := sorry

theorem dualQuaternionF4_e1_sq : dualQuaternionF4_e1 ^ 2 = 1 := sorry
theorem dualQuaternionF4_e2_sq : dualQuaternionF4_e2 ^ 2 = 1 := sorry
