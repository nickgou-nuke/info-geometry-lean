import Mathlib.Algebra.Ring.Defs
import Mathlib.Tactic.Basic
import InfoGeometry.Arithmetic.ArithmeticErlangenSquareRootBridge

/-!
# InfoGeometry.Arithmetic.ArithmeticSuperchargeHopfBridge

Finite algebraic supercharge bridge for the arithmetic binary lattice.

This module formalizes a conservative part of the "supercharge hopping"
picture:

* `Γ` is a parity involution;
* `Q` is odd with respect to `Γ`;
* `Q² = H`;
* therefore `H` is even: it commutes with `Γ`.

The Hopf/CFT/BRST/Schroedinger/RH interpretations are represented as witness
gates.  No RH theorem, zero-location theorem, or spectral-density theorem is
asserted here.
-/

noncomputable section

namespace InfoGeometry.Arithmetic.ArithmeticSuperchargeHopfBridge

/-! ## 1. Algebraic supercharge packet -/

/--
Parity/supercharge/Hamiltonian packet in an abstract operator ring.

`Γ` is the square-free/Möbius parity involution, `Q` is the odd supercharge,
and `H` is its square.
-/
structure ParitySuperchargePacket
    (Op : Type*) [Ring Op] where
  parity : Op
  supercharge : Op
  hamiltonian : Op
  parity_sq :
    parity * parity = 1
  supercharge_odd :
    supercharge * parity = -parity * supercharge
  square_True :
    supercharge * supercharge = hamiltonian

namespace ParitySuperchargePacket

variable
    {Op : Type*} [Ring Op]
    (P : ParitySuperchargePacket Op)

/--
The square of an odd supercharge commutes with parity.

This is the formal algebraic content of "two fermionic hops return to the
original parity sector".
-/
theorem supercharge_sq_commutes_with_parity :
    (P.supercharge * P.supercharge) * P.parity =
      P.parity * (P.supercharge * P.supercharge) := by
  calc
    (P.supercharge * P.supercharge) * P.parity
        = P.supercharge * (P.supercharge * P.parity) := by
            rw [mul_assoc]
    _ = P.supercharge * ((-P.parity) * P.supercharge) := by
            rw [P.supercharge_odd]
    _ = (P.supercharge * (-P.parity)) * P.supercharge := by
            rw [← mul_assoc]
    _ = (-(P.supercharge * P.parity)) * P.supercharge := by
            rw [mul_neg]
    _ = (-((-P.parity) * P.supercharge)) * P.supercharge := by
            rw [P.supercharge_odd]
    _ = (P.parity * P.supercharge) * P.supercharge := by
            simp [neg_mul]
    _ = P.parity * (P.supercharge * P.supercharge) := by
            rw [mul_assoc]

/-- The Hamiltonian generated by `Q²` is parity-even. -/
theorem hamiltonian_commutes_with_parity :
    P.hamiltonian * P.parity = P.parity * P.hamiltonian := by
  rw [← P.square_True]
  exact P.supercharge_sq_commutes_with_parity

end ParitySuperchargePacket

/-! ## 2. Hopf and spectral witness gates -/

/--
Hopf-differential interpretation gate.

The concrete differential geometry of a Hopf differential on a Cantor-like
arithmetic carrier is model-dependent, so this structure stores it as supplied
data.
-/
structure HopfDifferentialGate
    (Carrier Differential Readout : Type*) where
  carrier : Carrier
  differential : Differential
  readout : Readout
  hopf_True : Prop
  certificate : hopf_True

namespace HopfDifferentialGate

/-- Re-export of the supplied Hopf law. -/
theorem valid
    {Carrier Differential Readout : Type*}
    (G : HopfDifferentialGate Carrier Differential Readout) :
    G.hopf_True :=
  G.certificate

end HopfDifferentialGate

/--
Jacobi-Schroedinger spectral-density witness gate.

This records a supplied spectral problem and density law.  It does not assert
that Riemann zeros are its spectrum.
-/
structure JacobiSchroedingerSpectralGate
    (Potential Wavefunction Spectrum DensityReadout : Type*) where
  potential : Potential
  wavefunction : Wavefunction
  spectrum : Spectrum
  densityReadout : DensityReadout
  schroedinger_True : Prop
  density_True : Prop
  certificate : schroedinger_True ∧ density_True

namespace JacobiSchroedingerSpectralGate

/-- Re-export of the supplied Schroedinger law. -/
theorem schroedinger_holds
    {Potential Wavefunction Spectrum DensityReadout : Type*}
    (G : JacobiSchroedingerSpectralGate
      Potential Wavefunction Spectrum DensityReadout) :
    G.schroedinger_True :=
  G.certificate.1

/-- Re-export of the supplied spectral-density law. -/
theorem density_holds
    {Potential Wavefunction Spectrum DensityReadout : Type*}
    (G : JacobiSchroedingerSpectralGate
      Potential Wavefunction Spectrum DensityReadout) :
    G.density_True :=
  G.certificate.2

end JacobiSchroedingerSpectralGate

/--
Full supercharge/Hopf bridge packet.

The theorem-bearing algebra is the parity-evenness of `H = Q²`; geometric and
spectral interpretations remain witness-gated.
-/
structure ArithmeticSuperchargeHopfPacket
    (Op Carrier Differential HopfReadout
      Potential Wavefunction Spectrum DensityReadout : Type*)
    [Ring Op] where
  supercharge :
    ParitySuperchargePacket Op
  hopf :
    HopfDifferentialGate Carrier Differential HopfReadout
  spectral :
    JacobiSchroedingerSpectralGate
      Potential Wavefunction Spectrum DensityReadout

namespace ArithmeticSuperchargeHopfPacket

variable
    {Op Carrier Differential HopfReadout
      Potential Wavefunction Spectrum DensityReadout : Type*}
    [Ring Op]
    (P : ArithmeticSuperchargeHopfPacket
      Op Carrier Differential HopfReadout
      Potential Wavefunction Spectrum DensityReadout)

/-- The Hamiltonian in the packet commutes with the parity involution. -/
theorem hamiltonian_parity_even :
    P.supercharge.hamiltonian * P.supercharge.parity =
      P.supercharge.parity * P.supercharge.hamiltonian :=
  P.supercharge.hamiltonian_commutes_with_parity

end ArithmeticSuperchargeHopfPacket

end InfoGeometry.Arithmetic.ArithmeticSuperchargeHopfBridge
