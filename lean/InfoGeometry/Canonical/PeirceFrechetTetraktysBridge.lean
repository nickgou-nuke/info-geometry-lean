import InfoGeometry.Optics.OperatorDerivationForms
import InfoGeometry.OperatorAlgebra.PeirceSpine.Tetraktys

/-!
# Fréchet inner derivations and the Peirce Tetraktys

This bridge reuses the operator-valued Peirce/Tetraktys owner and the
continuous inner-derivation owner. It identifies (i) the square of the
Fréchet inner derivation generated by `Φ` with the negative `Φ` double
commutator, and (ii) the Lie bracket of the `Φ` and `J` inner derivations
with the inner derivation generated by `-2 • Σ`.

These are algebraic operator identities. They do not assert positivity,
spectral-gap, KMS, or a physical mass interpretation.
-/

noncomputable section

namespace InfoGeometry.Canonical.PeirceFrechetTetraktysBridge

open InfoGeometry.Optics.OperatorDerivationForms
open InfoGeometry.OperatorAlgebra.PeirceSpine

variable {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]

/-- The iterated continuous inner derivation generated by `Φ` is the
negative double-commutator superoperator already owned as `derivSqPhi`. -/
theorem innerFrechetPhi_square_eq_negative_derivSqPhi
    (P a c x : A) :
    FrechetOperatorDerivation.ofInner (genPhi P a c)
        (FrechetOperatorDerivation.ofInner (genPhi P a c) x) =
      -derivSqPhi P a c x := by
  simp [FrechetOperatorDerivation.ofInner_apply, derivSqPhi,
    InfoGeometry.OperatorAlgebra.PeirceSpine.comm]

/-- The commutator of the Fréchet inner derivations generated by `Φ` and
`J` descends to the inner derivation generated by `-2 • Σ`.

The only algebraic input beyond associativity is the Peirce idempotent law;
the coefficient `2` is an integer scalar acting on the operator algebra. -/
theorem innerFrechetPhiJ_bracket_eq_spinDipole
    {P : A} (hP : P * P = P) (a c : A) :
    FrechetOperatorDerivation.toNCDerivation
        (FrechetOperatorDerivation.commutator
          (FrechetOperatorDerivation.ofInner (genPhi P a c))
          (FrechetOperatorDerivation.ofInner (genJ P a c))) =
      FrechetOperatorDerivation.toNCDerivation
        (FrechetOperatorDerivation.ofInner
          (-((2 : ℤ) • genSig P a c))) := by
  rcases InfoGeometry.OperatorAlgebra.PeirceSpine.archetype_A3_nilpotent_cones_and_tetraktys_table
      (P := P) hP a c with
    ⟨_, _, _, _, _, hJΦ, hΦJ, _, _, _, _, _, _, _, _⟩
  have hBracket :
      genPhi P a c * genJ P a c - genJ P a c * genPhi P a c =
        -((2 : ℤ) • genSig P a c) := by
    rw [hΦJ, hJΦ]
    abel
  calc
    _ = FrechetOperatorDerivation.toNCDerivation
        (FrechetOperatorDerivation.ofInner
          (genPhi P a c * genJ P a c - genJ P a c * genPhi P a c)) :=
      FrechetOperatorDerivation.toNCDerivation_ofInner_commutator
        (genPhi P a c) (genJ P a c)
    _ = FrechetOperatorDerivation.toNCDerivation
        (FrechetOperatorDerivation.ofInner
          (-((2 : ℤ) • genSig P a c))) := by rw [hBracket]

end InfoGeometry.Canonical.PeirceFrechetTetraktysBridge

end
