import InfoGeometry.Potential.LogPotential
import InfoGeometry.Canonical.Triality
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Analysis.Calculus.Deriv.Basic
import Mathlib.Analysis.Calculus.FDeriv.Basic
import Mathlib.Analysis.InnerProductSpace.Dual

namespace InfoGeometry.Convex

open InfoGeometry.Canonical.Triality
open scoped BigOperators

/-- Abstract divergence interface used by Bregman-triality attention bridges. -/
class BregmanDivergence (Q K : Type*) where
  D : Q → K → ℝ

/--
Construct a triadic core whose interaction score is `-D`.
This encodes the usual "larger similarity <-> smaller divergence" convention.
-/
def bregmanTriadicCore {Q K V : Type*} [BregmanDivergence Q K]
    (route : Q → K → V) : TriadicCore Q K V where
  interact := fun q k => - BregmanDivergence.D q k
  route := route

/-- Minimal 1D Hessian geometry package. -/
structure HessianGeometry1D where
  potential : ℝ → ℝ

namespace HessianGeometry1D

/-- Hessian metric in 1D (totalized second derivative). -/
noncomputable def metric (H : HessianGeometry1D) (x : ℝ) : ℝ :=
  deriv (deriv H.potential) x

@[simp] theorem metric_def (H : HessianGeometry1D) (x : ℝ) :
    H.metric x = deriv (deriv H.potential) x := rfl

/-- Dual coordinate map in 1D. -/
noncomputable def dualMap (H : HessianGeometry1D) (x : ℝ) : ℝ :=
  deriv H.potential x

@[simp] theorem dualMap_def (H : HessianGeometry1D) (x : ℝ) :
    H.dualMap x = deriv H.potential x := rfl

/-- Legendre dual potential (as supremum). -/
noncomputable def dualPotential (H : HessianGeometry1D) (θ : ℝ) : ℝ :=
  sSup { r : ℝ | ∃ x : ℝ, r = x * θ - H.potential x }

/-- Bregman divergence generated by the 1D potential. -/
noncomputable def divergence (H : HessianGeometry1D) (x y : ℝ) : ℝ :=
  H.potential x - H.potential y - (H.dualMap y) * (x - y)

@[simp] theorem divergence_def (H : HessianGeometry1D) (x y : ℝ) :
    H.divergence x y = H.potential x - H.potential y - (H.dualMap y) * (x - y) := rfl

/-- Any 1D `LogPotential` induces a 1D Hessian geometry. -/
noncomputable def ofLogPotential (L : InfoGeometry.LogPotential ℝ) : HessianGeometry1D where
  potential := L.ψ

/-- A named Bregman divergence instance attached to `H`. -/
noncomputable def bregmanDiv (H : HessianGeometry1D) : BregmanDivergence ℝ ℝ where
  D := fun x y => H.divergence x y

@[simp] theorem bregmanDiv_D (H : HessianGeometry1D) (x y : ℝ) :
    (bregmanDiv H).D x y = H.divergence x y := rfl

/--
Bregman-softmax attention over 1D Hessian systems.
The interaction score is definitionally `-H.divergence`.
-/
noncomputable def softmaxBregmanAttention
    {ι : Type _} [DecidableEq ι]
    (H : HessianGeometry1D) (I : Finset ι) (hI : I.Nonempty) (keys : ι → ℝ)
    (route : ℝ → ℝ → ℝ) :
    (letI : BregmanDivergence ℝ ℝ := bregmanDiv H
     GeometricAttentionMap (bregmanTriadicCore (Q := ℝ) (K := ℝ) (V := ℝ) route) ι) := by
  classical
  letI : BregmanDivergence ℝ ℝ := bregmanDiv H
  exact softmaxAttention (core := bregmanTriadicCore route) (I := I) (hI := hI) (keys := keys)

end HessianGeometry1D

/--
Multivariate Hessian geometry package on an inner product space `E`.
`grad` is the primal gradient and `metricOp` is recovered as `fderiv grad`.
-/
structure HessianGeometry (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] where
  potential : E → ℝ
  grad : E → E
  has_gradient : ∀ x, HasFDerivAt potential (InnerProductSpace.toDual ℝ E (grad x)) x

namespace HessianGeometry

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable (H : HessianGeometry E)

/-- Dual coordinate map. -/
noncomputable def dualMap (x : E) : E := H.grad x

@[simp] theorem dualMap_def (x : E) : H.dualMap x = H.grad x := rfl

/-- Hessian metric operator, as totalized Fréchet derivative of `grad`. -/
noncomputable def metricOp (x : E) : E →L[ℝ] E :=
  fderiv ℝ H.grad x

/-- Bilinear metric induced by `metricOp`. -/
noncomputable def metric (x : E) (u v : E) : ℝ :=
  inner ℝ u (H.metricOp x v)

@[simp] theorem metric_def (x : E) (u v : E) :
    H.metric x u v = inner ℝ u (H.metricOp x v) := rfl

/-- Bregman divergence generated by the potential. -/
noncomputable def divergence (x y : E) : ℝ :=
  H.potential x - H.potential y - inner ℝ (H.dualMap y) (x - y)

@[simp] theorem divergence_def (x y : E) :
    H.divergence x y = H.potential x - H.potential y - inner ℝ (H.dualMap y) (x - y) := rfl

/-- Legendre dual potential (as supremum). -/
noncomputable def dualPotential (θ : E) : ℝ :=
  sSup { r : ℝ | ∃ x : E, r = inner ℝ x θ - H.potential x }

/-- A named Bregman divergence instance attached to `H`. -/
noncomputable def bregmanDiv (H : HessianGeometry E) : BregmanDivergence E E where
  D := fun x y => H.divergence x y

@[simp] theorem bregmanDiv_D (H : HessianGeometry E) (x y : E) :
    (bregmanDiv H).D x y = H.divergence x y := rfl

/--
Bregman-softmax attention over multivariate Hessian systems.
The interaction score is definitionally `-H.divergence`.
-/
noncomputable def softmaxBregmanAttention
    {ι : Type _} [DecidableEq ι]
    (H : HessianGeometry E)
    (I : Finset ι) (hI : I.Nonempty) (keys : ι → E)
    (route : E → E → E) :
    (letI : BregmanDivergence E E := bregmanDiv H
     GeometricAttentionMap (bregmanTriadicCore (Q := E) (K := E) (V := E) route) ι) := by
  classical
  letI : BregmanDivergence E E := bregmanDiv H
  exact softmaxAttention (core := bregmanTriadicCore route) (I := I) (hI := hI) (keys := keys)

end HessianGeometry

end InfoGeometry.Convex
