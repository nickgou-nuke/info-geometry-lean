{"type":"new","contents":"import InfoGeometry.Krein.DoubledSpace\nimport InfoGeometry.Clifford.Grading\n\n/-!\n# InfoGeometry.Krein.Superphysics\n\nAlgebraic supercharge generators and supersymmetric Hamiltonian structures \non doubled information spaces. \n\nThis implementation is strictly algebraic, avoiding coordinate-based L2 proofs \nto ensure performance and generality across general Hilbert spaces.\n-/\n\nset_option linter.unusedSectionVars false\nset_option linter.unusedSimpArgs false\n\nnamespace InfoGeometry.Krein\n\nopen InfoGeometry.Cartan\n\nvariable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\n/-- Algebraic supercharge package: odd generator and its square Hamiltonian. -/\nstructure Supercharge where\n  Q : DoubledSpace E →L[ℝ] DoubledSpace E\n  odd : isOdd Q\n\n/-- Algebraic square of a supercharge. -/\nabbrev superSquare (S : Supercharge (E := E)) :\n    DoubledSpace E →L[ℝ] DoubledSpace E :=\n  S.Q.comp S.Q\n\n/-- The Hamiltonian generated by a supercharge. -/\ndef superHamiltonian (S : Supercharge (E := E)) :\n    DoubledSpace E →L[ℝ] DoubledSpace E :=\n  superSquare S\n\n/-- Supersymmetric Hamiltonians are always grade-preserving (even). -/\nlemma superHamiltonian_isEven (S : Supercharge (E := E)) :\n    isEven (superHamiltonian S) := by\n  simp only [isEven, superHamiltonian, superSquare, isOdd]\n  calc\n    modular_j.comp (S.Q.comp S.Q)\n        = (modular_j.comp S.Q).comp S.Q := by rw [ContinuousLinearMap.comp_assoc]\n      _ = (-(S.Q.comp modular_j)).comp S.Q := by rw [S.odd]\n      _ = -(S.Q.comp (modular_j.comp S.Q)) := by simp [ContinuousLinearMap.comp_assoc]\n      _ = -(S.Q.comp (-(S.Q.comp modular_j))) := by rw [S.odd]\n      _ = (S.Q.comp S.Q).comp modular_j := by simp [ContinuousLinearMap.comp_assoc]\n\nlemma supercharge_maps_plus_to_minus\n    (S : Supercharge (E := E))\n    {v : DoubledSpace E}\n    (hv : inGradePlus v) :\n    inGradeMinus (S.Q v) := by\n  simp only [inGradePlus] at hv\n  simp only [inGradeMinus]\n  have h := congrArg (fun T : DoubledSpace E →L[ℝ] DoubledSpace E => T v) S.odd\n  simpa [ContinuousLinearMap.comp_apply, hv] using h\n\nlemma supercharge_maps_minus_to_plus\n    (S : Supercharge (E := E))\n    {v : DoubledSpace E}\n    (hv : inGradeMinus v) :\n    inGradePlus (S.Q v) := by\n  simp only [inGradeMinus] at hv\n  simp only [inGradePlus]\n  have h := congrArg (fun T : DoubledSpace E →L[ℝ] DoubledSpace E => T v) S.odd\n  simpa [ContinuousLinearMap.comp_apply, hv] using h\n\nlemma superHamiltonian_maps_plus_to_plus\n    (S : Supercharge (E := E))\n    {v : DoubledSpace E}\n    (hv : inGradePlus v) :\n    inGradePlus ((superHamiltonian S) v) := by\n  apply supercharge_maps_minus_to_plus\n  apply supercharge_maps_plus_to_minus\n  exact hv\n\nlemma superHamiltonian_maps_minus_to_minus\n    (S : Supercharge (E := E))\n    {v : DoubledSpace E}\n    (hv : inGradeMinus v) :\n    inGradeMinus ((superHamiltonian S) v) := by\n  apply supercharge_maps_plus_to_minus\n  apply supercharge_maps_minus_to_plus\n  exact hv\n\n/-- Canonical supercharge generated by the spectral sign `ε`. -/\nnoncomputable def epsilonSupercharge : Supercharge (E := E) where\n  Q := spectral_epsilon\n  odd := spectral_epsilon_isOdd\n\nlemma epsilonSupercharge_hamiltonian :\n    superHamiltonian (epsilonSupercharge (E := E))\n      = ContinuousLinearMap.id ℝ (DoubledSpace E) :=\n  spectral_epsilon_involution E\n\n/-- Canonical supercharge generated by the complex structure `I = J ∘ ε`. -/\nnoncomputable def complex_i_isOdd :\n    isOdd (complex_i (E := E)) := by\n  simp only [isOdd]\n  rw [modular_j_comp_complex_i (E := E), complex_i_comp_modular_j (E := E)]\n  simp\n\nnoncomputable def complex_iSupercharge : Supercharge (E := E) where\n  Q := complex_i\n  odd := complex_i_isOdd\n\nlemma complex_iSupercharge_hamiltonian :\n    superHamiltonian (complex_iSupercharge (E := E))\n      = -(ContinuousLinearMap.id ℝ (DoubledSpace E)) :=\n  complex_i_sq E\n\nend InfoGeometry.Krein\n","mtime":1776602622050}