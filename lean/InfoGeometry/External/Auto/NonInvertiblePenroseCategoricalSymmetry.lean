import Mathlib.Tactic

/-!
# Non-invertible Penrose categorical symmetry

This module formalizes the final structural key in the Penrose/wallpaper
holographic stack: once periodic translations are replaced by aperiodic Penrose
inflation/groupoid moves, spatial symmetry is no longer purely group-like.
Tripotent operators `T³=T` model non-invertible topological defect lines: their
spectrum may contain `0`, and `T²` is an idempotent support projector.

We also package the Connes-style noncommutative derivative `d_Q(a)=[Q,a]` and the
discrete SUSY relation `Q²=H`.
-/

noncomputable section

namespace NonInvertiblePenroseCategoricalSymmetry

open Matrix

/-! ## 1. Tripotent defect operator -/

/-- An element is tripotent if `T³=T`. -/
def IsTripotent {R : Type*} [Mul R] (T : R) : Prop := T * T * T = T

/-- A concrete tripotent defect with eigen-sectors `+1,-1,0`. -/
def Tzero : Matrix (Fin 3) (Fin 3) ℤ := !![1, 0, 0; 0, -1, 0; 0, 0, 0]

/-- `Tzero³=Tzero`. -/
theorem Tzero_tripotent : IsTripotent Tzero := by
  unfold IsTripotent
  decide

/-- The square of the tripotent is the support/idempotent projector. -/
def Pzero : Matrix (Fin 3) (Fin 3) ℤ := Tzero * Tzero

/-- `P=T²` is idempotent. -/
theorem Pzero_idempotent : Pzero * Pzero = Pzero := by
  decide

/-- The support projector preserves the tripotent on the right. -/
theorem Tzero_mul_Pzero : Tzero * Pzero = Tzero := by
  decide

/-- The support projector preserves the tripotent on the left. -/
theorem Pzero_mul_Tzero : Pzero * Tzero = Tzero := by
  decide

/-- The vector in the zero sector. -/
def zeroMode : Fin 3 → ℤ := ![0, 0, 1]

/-- `Tzero` annihilates the zero mode, so the zero sector lies in its kernel. -/
theorem Tzero_annihilates_zeroMode : Tzero.mulVec zeroMode = 0 := by
  decide

/-- Therefore `Tzero` cannot have a left inverse. -/
theorem Tzero_no_left_inverse : ¬ ∃ L : Matrix (Fin 3) (Fin 3) ℤ, L * Tzero = 1 := by
  intro h
  rcases h with ⟨L, hL⟩
  have h22 := congrFun (congrFun hL 2) 2
  simp [Tzero, Matrix.mul_apply, Fin.sum_univ_three] at h22

/-! ## 2. Noncommutative derivative and discrete SUSY -/

section Derivation

variable {R : Type*} [Ring R]

/-- Inner/noncommutative derivative generated by an odd operator `Q`. -/
def ncDerivative (Q a : R) : R := Q * a - a * Q

/-- Inner commutators satisfy the Leibniz rule in any associative ring. -/
theorem ncDerivative_leibniz (Q a b : R) :
    ncDerivative Q (a * b) = ncDerivative Q a * b + a * ncDerivative Q b := by
  unfold ncDerivative
  noncomm_ring

end Derivation

/-! ## 3. Categorical/non-invertible symmetry synthesis -/

/-- Synthesis theorem for non-invertible Penrose categorical symmetry. -/
theorem noninvertible_penrose_categorical_symmetry_synthesis :
    IsTripotent Tzero ∧
    Pzero * Pzero = Pzero ∧
    Tzero * Pzero = Tzero ∧
    Pzero * Tzero = Tzero ∧
    Tzero.mulVec zeroMode = 0 ∧
    (¬ ∃ L : Matrix (Fin 3) (Fin 3) ℤ, L * Tzero = 1) := by
  constructor
  · exact Tzero_tripotent
  constructor
  · exact Pzero_idempotent
  constructor
  · exact Tzero_mul_Pzero
  constructor
  · exact Pzero_mul_Tzero
  constructor
  · exact Tzero_annihilates_zeroMode
  · exact Tzero_no_left_inverse

#check Tzero_tripotent
#check Pzero_idempotent
#check Tzero_annihilates_zeroMode
#check Tzero_no_left_inverse
#check ncDerivative_leibniz
#check noninvertible_penrose_categorical_symmetry_synthesis

end NonInvertiblePenroseCategoricalSymmetry
