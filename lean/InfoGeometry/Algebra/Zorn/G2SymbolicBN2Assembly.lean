import Mathlib.Algebra.Group.Subgroup.Basic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Data.Set.Basic

/-!
# Symbolic Assembly of the BN2 Axiom for G₂(2)

Combines:
  1. Root complement invariance: `sᵢ(Φ⁺ \ {αᵢ}) = Φ⁺ \ {αᵢ} ⟹ sᵢ U_{rest} sᵢ ⊆ B`
  2. Rank-1 SL₂(𝔽₂) Levi identity: `sᵢ U_{αᵢ} sᵢ ⊆ B ∪ B sᵢ B`
to prove the full symbolic $(B, N)$ axiom BN2:
  `sᵢ B sᵢ ⊆ B ∪ B sᵢ B`
without brute-force computation, coset lookup tables, or finite case analysis.
-/

variable {G : Type*} [Group G]

namespace InfoGeometry.Algebra.Zorn.SymbolicBN2

/-! =========================================================================
    1. Bruhat Double-Coset Cell Definitions
    ========================================================================= -/

/-- Predicate for membership in the big Bruhat cell `B s B`. -/
def InCellBsB (B : Subgroup G) (s x : G) : Prop :=
  ∃ b₁ ∈ B, ∃ b₂ ∈ B, x = b₁ * s * b₂

/-- Predicate for membership in the Bruhat cover `B ∪ B s B`. -/
def InBruhatCover (B : Subgroup G) (s x : G) : Prop :=
  x ∈ B ∨ InCellBsB B s x

/-! =========================================================================
    2. Levi Root Decomposition Structure
    ========================================================================= -/

/--
A Levi root decomposition of a Borel subgroup `B` with respect to a simple reflection `s`:
  - `U_alpha`: The rank-1 root subgroup along `αᵢ` (satisfying the SL₂(𝔽₂) identity)
  - `U_rest`: The normal unipotent factor generated by the root complement `Φ⁺ \ {αᵢ}`
-/
structure LeviRootDecomposition (B : Subgroup G) (s : G) where
  U_alpha : Set G
  U_rest : Set G
  alpha_subset_B : U_alpha ⊆ B
  rest_subset_B : U_rest ⊆ B
  -- Root factorization: every b ∈ B factorizes as b = u_α * u_rest
  factorize : ∀ b ∈ B, ∃ u_a ∈ U_alpha, ∃ u_r ∈ U_rest, b = u_a * u_r
  -- Root complement invariance: s * U_rest * s ⊆ B
  rest_invariant : ∀ u_r ∈ U_rest, s * u_r * s ∈ B
  -- Rank-1 SL₂(𝔽₂) Levi identity: s * U_α * s ⊆ B ∪ B s B
  rank1_levi : ∀ u_a ∈ U_alpha, InBruhatCover B s (s * u_a * s)
  -- Simple reflection involution: s² = 1
  s_invol : s * s = 1

/-! =========================================================================
    3. Symbolic Proof of Axiom BN2
    ========================================================================= -/

/--
MAIN THEOREM (Symbolic BN2 Reduction Step):
For any Borel element `b ∈ B` factorized along the Levi root splitting `(U_α, U_rest)`,
the reflection conjugate `s * b * s` is contained in `B ∪ B s B`.
-/
theorem symbolic_bn2_step (B : Subgroup G) (s : G)
    (decomp : LeviRootDecomposition B s)
    (b : G) (hb : b ∈ B) :
    InBruhatCover B s (s * b * s) := by
  -- 1. Factorize b = u_a * u_r
  obtain ⟨u_a, hu_a, u_r, hu_r, rfl⟩ := decomp.factorize b hb
  -- 2. Insert s² = 1 between factors: s * (u_a * u_r) * s = (s * u_a * s) * (s * u_r * s)
  have h_expand : s * (u_a * u_r) * s = (s * u_a * s) * (s * u_r * s) := by
    calc
      s * (u_a * u_r) * s
        = (s * u_a * 1) * (u_r * s) := by simp only [mul_one, mul_assoc]
      _ = (s * u_a * (s * s)) * (u_r * s) := by rw [decomp.s_invol]
      _ = (s * u_a * s) * (s * u_r * s) := by simp only [mul_assoc]
  rw [h_expand]
  -- 3. Extract root complement invariance: s * u_r * s ∈ B
  have h_r_inv : s * u_r * s ∈ B := decomp.rest_invariant u_r hu_r
  -- 4. Case split on the rank-1 Levi component
  rcases decomp.rank1_levi u_a hu_a with h_in_B | h_in_BsB
  · -- Case 1 (Toral / Identity branch): s * u_a * s ∈ B
    left
    exact B.mul_mem h_in_B h_r_inv
  · -- Case 2 (SL₂ non-trivial braid branch): s * u_a * s ∈ B s B
    right
    obtain ⟨b₁, hb₁, b₂, hb₂, h_mid⟩ := h_in_BsB
    refine ⟨b₁, hb₁, b₂ * (s * u_r * s), B.mul_mem hb₂ h_r_inv, ?_⟩
    rw [h_mid]
    calc
      (b₁ * s * b₂) * (s * u_r * s)
        = b₁ * s * (b₂ * (s * u_r * s)) := by rw [mul_assoc]
      _ = b₁ * s * (b₂ * (s * u_r * s)) := rfl

/--
COROLLARY (Global Set-Inclusion BN2 Formulation):
  `s * B * s ⊆ B ∪ B * s * B`
-/
theorem symbolic_bn2_set_inclusion (B : Subgroup G) (s : G)
    (decomp : LeviRootDecomposition B s) :
    ∀ x ∈ { y | ∃ b ∈ B, y = s * b * s }, InBruhatCover B s x := by
  rintro x ⟨b, hb, rfl⟩
  exact symbolic_bn2_step B s decomp b hb

end InfoGeometry.Algebra.Zorn.SymbolicBN2
