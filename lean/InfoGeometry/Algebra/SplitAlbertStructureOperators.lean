import InfoGeometry.Algebra.JordanInnerDerivations
import Mathlib.Tactic

/-!
# Split-Albert structure operators

This owner constructs the concrete operator sector generated by

* genuine Jordan derivations of the verified real split-Albert algebra, and
* left Jordan multiplications.

For `J = H₃(𝕆_s)` the represented structure operators are

`D + L_a`, with `D ∈ Der(J)` and `a ∈ J`.

The key theorem proves that these operators are closed under the endomorphism
commutator.  The proof uses only the already verified Jordan identities:

* derivations are closed under commutator;
* `[D,L_a] = L_{D a}`;
* `[L_a,L_b]` is the genuine inner Jordan derivation.

The closed operator sector is then packaged as a native Mathlib
`LieSubalgebra ℝ (Module.End ℝ J)`.

This is the algebraic substrate of the split-Albert structure algebra.  It is
not identified here with `𝔢₆(6)`, and no dimension, simplicity, or real-form
classification theorem is assumed.
-/

noncomputable section

namespace InfoGeometry.Algebra.SplitAlbertStructureOperators

open InfoGeometry.Algebra
open InfoGeometry.Algebra.H3Zorn
open InfoGeometry.Algebra.NonAssocDerivation

abbrev Albert := H3Zorn ℝ
abbrev AlbertEnd := Module.End ℝ Albert
abbrev AlbertDerivation := NonAssocDerivation.derivations ℝ Albert

/-- The represented split-Albert structure operator `D + L_a`. -/
def structureOperator (D : AlbertDerivation) (a : Albert) : AlbertEnd :=
  (D : AlbertEnd) + jordanLmul (R := ℝ) a

@[simp] theorem structureOperator_apply
    (D : AlbertDerivation) (a x : Albert) :
    structureOperator D a x = D x + a * x := by
  rfl

/-- Predicate selecting exactly the endomorphisms represented as `D + L_a`. -/
def IsStructureOperator (T : AlbertEnd) : Prop :=
  ∃ D : AlbertDerivation, ∃ a : Albert, T = structureOperator D a

/-- Every genuine derivation is a structure operator. -/
theorem derivation_isStructureOperator (D : AlbertDerivation) :
    IsStructureOperator (D : AlbertEnd) := by
  refine ⟨D, 0, ?_⟩
  ext x
  simp [structureOperator, jordanLmul]

/-- Every left Jordan multiplication is a structure operator. -/
theorem leftMultiplication_isStructureOperator (a : Albert) :
    IsStructureOperator (jordanLmul (R := ℝ) a) := by
  refine ⟨0, a, ?_⟩
  ext x
  simp [structureOperator]

/-- The represented structure-operator sector contains zero. -/
theorem zero_isStructureOperator :
    IsStructureOperator (0 : AlbertEnd) := by
  refine ⟨0, 0, ?_⟩
  ext x
  simp [structureOperator, jordanLmul]

/-- The represented structure-operator sector is closed under addition. -/
theorem add_isStructureOperator
    {S T : AlbertEnd}
    (hS : IsStructureOperator S) (hT : IsStructureOperator T) :
    IsStructureOperator (S + T) := by
  rcases hS with ⟨D, a, rfl⟩
  rcases hT with ⟨E, b, rfl⟩
  refine ⟨D + E, a + b, ?_⟩
  ext x
  simp [structureOperator, jordanLmul, add_mul]
  abel

/-- The represented structure-operator sector is closed under real scaling. -/
theorem smul_isStructureOperator
    (r : ℝ) {T : AlbertEnd} (hT : IsStructureOperator T) :
    IsStructureOperator (r • T) := by
  rcases hT with ⟨D, a, rfl⟩
  refine ⟨r • D, r • a, ?_⟩
  ext x
  simp [structureOperator, jordanLmul]

/-- Explicit commutator formula for represented split-Albert structure
operators.

`[D+L_a,E+L_b] = ([D,E] + D_{a,b}) + L_{D b - E a}`.
-/
theorem structureOperator_lie_formula
    (D E : AlbertDerivation) (a b : Albert) :
    ⁅structureOperator D a, structureOperator E b⁆ =
      structureOperator
        (⁅D, E⁆ + h3ZornJordanInnerDerivation a b)
        (D b - E a) := by
  ext x
  simp only [Ring.lie_def, Module.End.mul_apply, LinearMap.sub_apply,
    structureOperator_apply, LinearMap.add_apply]
  rw [D.property b x, E.property a x]
  simp only [NonAssocDerivation.lie_apply,
    h3ZornJordanInnerDerivation_apply]
  simp only [add_mul, sub_mul]
  abel

/-- The represented split-Albert structure operators are closed under the Lie
commutator. -/
theorem lie_isStructureOperator
    {S T : AlbertEnd}
    (hS : IsStructureOperator S) (hT : IsStructureOperator T) :
    IsStructureOperator ⁅S, T⁆ := by
  rcases hS with ⟨D, a, rfl⟩
  rcases hT with ⟨E, b, rfl⟩
  refine ⟨⁅D, E⁆ + h3ZornJordanInnerDerivation a b, D b - E a, ?_⟩
  exact structureOperator_lie_formula D E a b

/-- Native Lie-subalgebra package for the concrete represented split-Albert
structure operators. -/
def structureOperatorLieSubalgebra : LieSubalgebra ℝ AlbertEnd where
  carrier := {T | IsStructureOperator T}
  zero_mem' := zero_isStructureOperator
  add_mem' := by
    intro S T hS hT
    exact add_isStructureOperator hS hT
  smul_mem' := by
    intro r T hT
    exact smul_isStructureOperator r hT
  lie_mem' := by
    intro S T hS hT
    exact lie_isStructureOperator hS hT

@[simp] theorem mem_structureOperatorLieSubalgebra_iff (T : AlbertEnd) :
    T ∈ structureOperatorLieSubalgebra ↔ IsStructureOperator T :=
  Iff.rfl

/-- The actual native Lie-algebra carrier of represented split-Albert
structure operators. -/
abbrev StructureOperatorCarrier := structureOperatorLieSubalgebra

/-- Readback of the concrete carrier into endomorphisms. -/
def structureOperatorCarrierVal : StructureOperatorCarrier → AlbertEnd :=
  fun T => T.1

/-- Genuine derivations embed into the represented structure Lie algebra. -/
def derivationToStructure (D : AlbertDerivation) : StructureOperatorCarrier :=
  ⟨(D : AlbertEnd), derivation_isStructureOperator D⟩

/-- Left Jordan multiplications embed into the represented structure Lie
algebra. -/
def leftMultiplicationToStructure (a : Albert) : StructureOperatorCarrier :=
  ⟨jordanLmul (R := ℝ) a, leftMultiplication_isStructureOperator a⟩

@[simp] theorem derivationToStructure_val (D : AlbertDerivation) :
    (derivationToStructure D : AlbertEnd) = (D : AlbertEnd) :=
  rfl

@[simp] theorem leftMultiplicationToStructure_val (a : Albert) :
    (leftMultiplicationToStructure a : AlbertEnd) = jordanLmul (R := ℝ) a :=
  rfl

/-- The closure packet needed before a reduced-structure or TKK identification:
zero, addition, scalar multiplication, and commutator all remain in the same
concrete represented carrier. -/
theorem structureOperator_closure_packet :
    IsStructureOperator (0 : AlbertEnd) ∧
    (∀ {S T : AlbertEnd}, IsStructureOperator S → IsStructureOperator T →
      IsStructureOperator (S + T)) ∧
    (∀ (r : ℝ) {T : AlbertEnd}, IsStructureOperator T →
      IsStructureOperator (r • T)) ∧
    (∀ {S T : AlbertEnd}, IsStructureOperator S → IsStructureOperator T →
      IsStructureOperator ⁅S, T⁆) := by
  exact ⟨zero_isStructureOperator,
    fun hS hT => add_isStructureOperator hS hT,
    fun r _ hT => smul_isStructureOperator r hT,
    fun hS hT => lie_isStructureOperator hS hT⟩

end InfoGeometry.Algebra.SplitAlbertStructureOperators
