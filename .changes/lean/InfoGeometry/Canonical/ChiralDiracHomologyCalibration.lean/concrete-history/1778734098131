{"type":"new","contents":"import InfoGeometry.Canonical.ChiralHodgeDecomposition\nimport InfoGeometry.Canonical.RealHomologyCohomologyDictionary\nimport InfoGeometry.Meta.Architecture\nimport Mathlib.Tactic.Abel\n\nopen scoped InnerProductSpace\n\nnoncomputable section\n\nnamespace InfoGeometry.Canonical.ChiralDiracHomologyCalibration\n\nopen InfoGeometry.Canonical.ChiralHodgeDecomposition\nopen InfoGeometry.Krein\n\n/-!\n# Chiral Dirac homology calibration\n\nThis file separates two lanes:\n\n* a chiral Hodge/Dirac lane carries off-diagonal arrows and Hodge loops;\n* a chiral homology lane requires explicit nilpotence witnesses.\n\nThe root doubled operator `J` in `ChiralHodgeDecomposition` is therefore not\ncalled a boundary here.  Chiral arrows become boundary arrows only after the two\nnilpotence laws are supplied.\n-/\n\nsection RealLinearChiralComplex\n\nvariable {Cplus Cminus : Type*}\nvariable [AddCommGroup Cplus] [Module ℝ Cplus]\nvariable [AddCommGroup Cminus] [Module ℝ Cminus]\n\n/--\nA real-linear chiral differential pair.\n\n`dPlus : C₊ → C₋` and `dMinus : C₋ → C₊` define sector homology only when both\ncross-composites vanish.\n-/\n@[rep_depth krein]\nstructure ChiralDifferentialCalibration where\n  dPlus : Cplus →ₗ[ℝ] Cminus\n  dMinus : Cminus →ₗ[ℝ] Cplus\n\n  /-- `d⁻ ∘ d⁺ = 0`, so minus-boundaries are minus-cycles. -/\n  dMinus_comp_dPlus_zero : dMinus.comp dPlus = 0\n\n  /-- `d⁺ ∘ d⁻ = 0`, so plus-boundaries are plus-cycles. -/\n  dPlus_comp_dMinus_zero : dPlus.comp dMinus = 0\n\nnamespace ChiralDifferentialCalibration\n\nvariable (C : ChiralDifferentialCalibration (Cplus := Cplus) (Cminus := Cminus))\n\n/-- Plus cycles: plus-sector states killed by the outgoing `dPlus`. -/\n@[rep_depth krein]\ndef IsPlusCycle (x : Cplus) : Prop :=\n  C.dPlus x = 0\n\n/-- Minus cycles: minus-sector states killed by the outgoing `dMinus`. -/\n@[rep_depth krein]\ndef IsMinusCycle (y : Cminus) : Prop :=\n  C.dMinus y = 0\n\n/-- Plus boundaries: plus-sector states generated by the incoming `dMinus`. -/\n@[rep_depth krein]\ndef IsPlusBoundary (x : Cplus) : Prop :=\n  ∃ y : Cminus, C.dMinus y = x\n\n/-- Minus boundaries: minus-sector states generated by the incoming `dPlus`. -/\n@[rep_depth krein]\ndef IsMinusBoundary (y : Cminus) : Prop :=\n  ∃ x : Cplus, C.dPlus x = y\n\n/-- Plus-sector boundaries are cycles when `dPlus.comp dMinus = 0`. -/\n@[rep_depth krein]\ntheorem plusBoundary_isPlusCycle\n    {x : Cplus}\n    (hx : C.IsPlusBoundary x) :\n    C.IsPlusCycle x := by\n  rcases hx with ⟨y, rfl⟩\n  unfold IsPlusCycle\n  exact congrArg (fun F : Cminus →ₗ[ℝ] Cminus => F y) C.dPlus_comp_dMinus_zero\n\n/-- Minus-sector boundaries are cycles when `dMinus.comp dPlus = 0`. -/\n@[rep_depth krein]\ntheorem minusBoundary_isMinusCycle\n    {y : Cminus}\n    (hy : C.IsMinusBoundary y) :\n    C.IsMinusCycle y := by\n  rcases hy with ⟨x, rfl⟩\n  unfold IsMinusCycle\n  exact congrArg (fun F : Cplus →ₗ[ℝ] Cplus => F x) C.dMinus_comp_dPlus_zero\n\n/-- Plus homology equivalence: representatives differ by an incoming `dMinus` boundary. -/\n@[rep_depth krein]\ndef PlusHomologyEquivalent (x y : Cplus) : Prop :=\n  C.IsPlusBoundary (x - y)\n\n/-- Minus homology equivalence: representatives differ by an incoming `dPlus` boundary. -/\n@[rep_depth krein]\ndef MinusHomologyEquivalent (x y : Cminus) : Prop :=\n  C.IsMinusBoundary (x - y)\n\n/-- Plus homology equivalence is reflexive. -/\n@[rep_depth krein]\ntheorem plusHomologyEquivalent_refl\n    (x : Cplus) :\n    C.PlusHomologyEquivalent x x := by\n  unfold PlusHomologyEquivalent IsPlusBoundary\n  refine ⟨0, ?_⟩\n  simp\n\n/-- Plus homology equivalence is symmetric. -/\n@[rep_depth krein]\ntheorem plusHomologyEquivalent_symm\n    {x y : Cplus}\n    (hxy : C.PlusHomologyEquivalent x y) :\n    C.PlusHomologyEquivalent y x := by\n  unfold PlusHomologyEquivalent IsPlusBoundary at hxy ⊢\n  rcases hxy with ⟨z, hz⟩\n  refine ⟨-z, ?_⟩\n  calc\n    C.dMinus (-z) = -C.dMinus z := by simp\n    _ = y - x := by\n      rw [hz]\n      abel\n\n/-- Plus homology equivalence is transitive. -/\n@[rep_depth krein]\ntheorem plusHomologyEquivalent_trans\n    {x y z : Cplus}\n    (hxy : C.PlusHomologyEquivalent x y)\n    (hyz : C.PlusHomologyEquivalent y z) :\n    C.PlusHomologyEquivalent x z := by\n  unfold PlusHomologyEquivalent IsPlusBoundary at hxy hyz ⊢\n  rcases hxy with ⟨a, ha⟩\n  rcases hyz with ⟨b, hb⟩\n  refine ⟨a + b, ?_⟩\n  calc\n    C.dMinus (a + b) = C.dMinus a + C.dMinus b := by simp\n    _ = (x - y) + (y - z) := by rw [ha, hb]\n    _ = x - z := by abel\n\n/-- Plus homology equivalence is an equivalence relation. -/\n@[rep_depth krein]\ntheorem plusHomologyEquivalent_equivalence :\n    Equivalence C.PlusHomologyEquivalent := by\n  refine ⟨?refl, ?symm, ?trans⟩\n  · intro x\n    exact C.plusHomologyEquivalent_refl x\n  · intro x y hxy\n    exact C.plusHomologyEquivalent_symm hxy\n  · intro x y z hxy hyz\n    exact C.plusHomologyEquivalent_trans hxy hyz\n\n/-- Minus homology equivalence is reflexive. -/\n@[rep_depth krein]\ntheorem minusHomologyEquivalent_refl\n    (x : Cminus) :\n    C.MinusHomologyEquivalent x x := by\n  unfold MinusHomologyEquivalent IsMinusBoundary\n  refine ⟨0, ?_⟩\n  simp\n\n/-- Minus homology equivalence is symmetric. -/\n@[rep_depth krein]\ntheorem minusHomologyEquivalent_symm\n    {x y : Cminus}\n    (hxy : C.MinusHomologyEquivalent x y) :\n    C.MinusHomologyEquivalent y x := by\n  unfold MinusHomologyEquivalent IsMinusBoundary at hxy ⊢\n  rcases hxy with ⟨z, hz⟩\n  refine ⟨-z, ?_⟩\n  calc\n    C.dPlus (-z) = -C.dPlus z := by simp\n    _ = y - x := by\n      rw [hz]\n      abel\n\n/-- Minus homology equivalence is transitive. -/\n@[rep_depth krein]\ntheorem minusHomologyEquivalent_trans\n    {x y z : Cminus}\n    (hxy : C.MinusHomologyEquivalent x y)\n    (hyz : C.MinusHomologyEquivalent y z) :\n    C.MinusHomologyEquivalent x z := by\n  unfold MinusHomologyEquivalent IsMinusBoundary at hxy hyz ⊢\n  rcases hxy with ⟨a, ha⟩\n  rcases hyz with ⟨b, hb⟩\n  refine ⟨a + b, ?_⟩\n  calc\n    C.dPlus (a + b) = C.dPlus a + C.dPlus b := by simp\n    _ = (x - y) + (y - z) := by rw [ha, hb]\n    _ = x - z := by abel\n\n/-- Minus homology equivalence is an equivalence relation. -/\n@[rep_depth krein]\ntheorem minusHomologyEquivalent_equivalence :\n    Equivalence C.MinusHomologyEquivalent := by\n  refine ⟨?refl, ?symm, ?trans⟩\n  · intro x\n    exact C.minusHomologyEquivalent_refl x\n  · intro x y hxy\n    exact C.minusHomologyEquivalent_symm hxy\n  · intro x y z hxy hyz\n    exact C.minusHomologyEquivalent_trans hxy hyz\n\nend ChiralDifferentialCalibration\n\nend RealLinearChiralComplex\n\nsection RootHodgeReadbacks\n\nvariable {E : Type 0}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\n\n/-- Root doubled chiral Dirac plus arrow, exposed only as a Hodge arrow readback. -/\n@[rep_depth krein]\nnoncomputable abbrev rootHodgeArrowPlus : EndH :=\n  rootDiracPlus (E := E)\n\n/-- Root doubled chiral Dirac minus arrow, exposed only as a Hodge arrow readback. -/\n@[rep_depth krein]\nnoncomputable abbrev rootHodgeArrowMinus : EndH :=\n  rootDiracMinus (E := E)\n\nomit [CompleteSpace E] in\n/-- Owner-lane readback: the root odd Dirac lane is the sum of chiral Hodge arrows. -/\n@[rep_depth krein]\ntheorem rootDiracOddLane_eq_hodgeArrow_sum :\n    rootDiracOddLane (E := E) =\n      rootHodgeArrowPlus (E := E) + rootHodgeArrowMinus (E := E) :=\n  rootDiracOddLane_eq_chiral_sum (E := E)\n\n/-- Owner-lane readback: the root Dirac square is the sum of chiral Hodge loops. -/\n@[rep_depth krein]\ntheorem rootDiracOddLane_sq_eq_hodgeLoop_sum :\n    (rootDiracOddLane (E := E)).comp (rootDiracOddLane (E := E)) =\n      rootChiralLaplacianPlus (E := E) + rootChiralLaplacianMinus (E := E) :=\n  rootDiracOddLane_sq_eq_chiralLaplacian_sum (E := E)\n\nend RootHodgeReadbacks\n\nend InfoGeometry.Canonical.ChiralDiracHomologyCalibration\n","mtime":1778734098131}