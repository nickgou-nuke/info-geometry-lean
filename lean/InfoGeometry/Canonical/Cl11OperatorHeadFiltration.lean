import Mathlib.LinearAlgebra.LinearIndependent.Defs
import Mathlib.LinearAlgebra.Dimension.Constructions
import InfoGeometry.Canonical.Cl11TensorTowerInfiniteCAR

/-!
# Exact dimensions of finite CAR-mode heads in the operator colimit

The coefficient algebra here is the existing algebraic direct limit of the
real matrix tensor tower.  A finite head means a finite initial set of CAR
modes; it does not bound the dimension of the operator colimit.  The proof
uses the concrete countable creation modes and their established linear
independence in that colimit.  No spectral Dirac operator or Hilbert completion
is asserted by this module.

## BUCKET 1: Proved
The finite-head filtration is monotone and strictly increases at each new CAR
creation mode.

## BUCKET 2: Conditional
No conditional theorem is introduced.

## BUCKET 3: Open boundary
No spectral Dirac operator or analytic Hilbert-space completion is constructed.
-/

namespace InfoGeometry.Canonical.Cl11OperatorHeadFiltration

open InfoGeometry.Clifford.Cl11TensorTowerInfiniteCAR

/-- The real linear subspace generated by the first `n` creation modes in the
actual algebraic operator colimit. -/
noncomputable def creationHeadSpan (n : ℕ) :
    Submodule ℝ InfoGeometry.Clifford.Cl11TensorTowerInfiniteCAR.OperatorColimit :=
  Submodule.span ℝ (Set.range fun i : Fin n => creationMode i.val)

/-- The first `n` creation modes span exactly an `n`-dimensional subspace of
the operator colimit. The finite dimension belongs to this cutoff span, not
to the ambient algebraic direct limit. -/
theorem creationHeadSpan_finrank (n : ℕ) :
    Module.finrank ℝ (creationHeadSpan n) = n := by
  classical
  have hli : LinearIndependent ℝ (fun i : Fin n => creationMode i.val) := by
    convert creationMode_linearIndependent.comp Fin.val Fin.val_injective using 1
    ext i
    rfl
  rw [creationHeadSpan, finrank_span_eq_card hli]
  simp

/-- Increasing the cutoff includes the earlier finite-mode span. -/
theorem creationHeadSpan_mono {n m : ℕ} (hnm : n ≤ m) :
    creationHeadSpan n ≤ creationHeadSpan m := by
  apply Submodule.span_mono
  rintro _ ⟨i, rfl⟩
  exact ⟨⟨i.val, Nat.lt_of_lt_of_le i.isLt hnm⟩, rfl⟩

/-- The next creation mode is not generated by the preceding finite head.
This follows from the CAR-derived linear independence in the actual colimit. -/
theorem next_creationMode_not_mem_headSpan (n : ℕ) :
    creationMode n ∉ creationHeadSpan n := by
  intro hspan
  have hsubset : Set.range (fun i : Fin n => creationMode i.val) ⊆
      creationMode '' ({n}ᶜ : Set ℕ) := by
    rintro _ ⟨i, rfl⟩
    refine ⟨i.val, ?_, rfl⟩
    simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
    omega
  have hmem : creationMode n ∈
      Submodule.span ℝ (creationMode '' ({n}ᶜ : Set ℕ)) :=
    Submodule.span_mono hsubset hspan
  exact creationMode_linearIndependent.notMem_span n hmem

/-- The finite-head filtration is strictly increasing at every cutoff.  Thus
each finite head is extended by a genuinely new operator in the unbounded
operator colimit. -/
theorem creationHeadSpan_strictMono : StrictMono creationHeadSpan := by
  intro n m hnm
  rw [lt_iff_le_not_ge]
  refine ⟨creationHeadSpan_mono (Nat.le_of_lt hnm), ?_⟩
  intro hback
  exact next_creationMode_not_mem_headSpan n
    (hback (Submodule.subset_span ⟨⟨n, hnm⟩, rfl⟩))

end InfoGeometry.Canonical.Cl11OperatorHeadFiltration
