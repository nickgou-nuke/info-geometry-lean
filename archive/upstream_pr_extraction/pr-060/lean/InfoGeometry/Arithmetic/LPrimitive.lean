import InfoGeometry.Arithmetic.PrimitiveSetsAbove

/-!
# InfoGeometry.Arithmetic.LPrimitive

Primitive-set-only L-multiple skeleton extracted from Lichtman's proof of the
Erdos primitive set conjecture.

The paper defines

`L_a = { b * a : every prime p | b satisfies p >= P(a) }`,

where `P(a)` is the largest prime factor of `a`, and calls a set `L`-primitive
when no distinct member is an `L`-multiple of another.

This file installs the finite/order-theoretic skeleton and canonical cutoff
densities.  It does not claim an asymptotic density or analytic continuation
without a convergence theorem.
-/

namespace InfoGeometry.Arithmetic

/-- All prime factors of `m` are at least `B`. -/
def PrimeFactorsGE (m B : ℕ) : Prop :=
  ∀ ⦃p : ℕ⦄, Nat.Prime p → p ∣ m → B ≤ p

/-- `P` is a largest prime factor of `a`. -/
def IsLargestPrimeFactorOf (P a : ℕ) : Prop :=
  Nat.Prime P ∧ P ∣ a ∧ ∀ ⦃q : ℕ⦄, Nat.Prime q → q ∣ a → q ≤ P

/--
`n` is an `L`-multiple of `a`, witnessed using a largest prime factor `P` of `a`.

This is the direct Lean surface for

`n ∈ L_a` iff `n = b * a` and every prime divisor of `b` is at least `P(a)`.
-/
def LMultiple (a n : ℕ) : Prop :=
  ∃ P : ℕ, IsLargestPrimeFactorOf P a ∧ ∃ b : ℕ, n = b * a ∧ PrimeFactorsGE b P

/-- Set of `L`-multiples of `a`. -/
def LMultiplesOf (a : ℕ) : Set ℕ :=
  {n | LMultiple a n}

/-- Set of `L`-multiples generated by a set `A`. -/
def LMultiplesOfSet (A : Set ℕ) : Set ℕ :=
  {n | ∃ a ∈ A, LMultiple a n}

/-- `A` is `L`-primitive when no distinct member is an `L`-multiple of another. -/
def LPrimitiveSet (A : Set ℕ) : Prop :=
  ∀ ⦃a a' : ℕ⦄, a ∈ A → a' ∈ A → LMultiple a a' → a = a'

/-- Finite `L`-primitive specialization. -/
def LPrimitiveFinset (A : Finset ℕ) : Prop :=
  LPrimitiveSet (A : Set ℕ)

/-- An `L`-multiple is an ordinary multiple. -/
theorem LMultiple.dvd {a n : ℕ} (h : LMultiple a n) : a ∣ n := by
  rcases h with ⟨_P, _hP, b, rfl, _hb⟩
  exact ⟨b, by rw [Nat.mul_comm]⟩

/-- If `P` is a largest prime factor of `a`, then `a ∈ L_a`. -/
theorem LMultiple.self_of_largestPrimeFactor {a P : ℕ}
    (hP : IsLargestPrimeFactorOf P a) :
    LMultiple a a := by
  refine ⟨P, hP, 1, ?_, ?_⟩
  · simp
  · intro p hp hpdvd
    exact (Nat.Prime.not_dvd_one hp hpdvd).elim

/-- Ordinary primitive sets are `L`-primitive. -/
theorem PrimitiveSet.toLPrimitiveSet {A : Set ℕ}
    (hA : PrimitiveSet A) :
    LPrimitiveSet A := by
  intro a a' ha ha' hL
  exact hA ha ha' hL.dvd

/-- Finite ordinary primitive sets are finite `L`-primitive sets. -/
theorem PrimitiveFinset.toLPrimitiveFinset {A : Finset ℕ}
    (hA : PrimitiveFinset A) :
    LPrimitiveFinset A :=
  PrimitiveSet.toLPrimitiveSet hA

/-- Membership in `LMultiplesOfSet` is union membership over generators. -/
theorem mem_LMultiplesOfSet_iff {A : Set ℕ} {n : ℕ} :
    n ∈ LMultiplesOfSet A ↔ ∃ a ∈ A, n ∈ LMultiplesOf a := by
  rfl

/--
Lichtman trichotomy input.

The paper proves that if `L_a` and `L_a'` meet, then one generator is an
`L`-multiple of the other.  We keep this as an explicit finite combinatorial
input until the largest-prime-factor arithmetic proof is fully formalized.
-/
def LTrichotomyInput : Prop :=
  ∀ ⦃a a' x : ℕ⦄,
    1 < a →
    1 < a' →
    LMultiple a x →
    LMultiple a' x →
      LMultiple a a' ∨ LMultiple a' a

namespace LTrichotomyInput

/-- Read the Lichtman trichotomy directly from its native proposition. -/
theorem trichotomy
    (T : LTrichotomyInput)
    ⦃a a' x : ℕ⦄
    (ha : 1 < a)
    (ha' : 1 < a')
    (hx : LMultiple a x)
    (hx' : LMultiple a' x) :
    LMultiple a a' ∨ LMultiple a' a :=
  T ha ha' hx hx'

/--
For an `L`-primitive set, distinct generators have disjoint `L`-multiple
surfaces, assuming the Lichtman trichotomy input.
-/
theorem not_common_LMultiple_of_lprimitive
    (T : LTrichotomyInput)
    {A : Set ℕ}
    (hA : LPrimitiveSet A)
    {a a' x : ℕ}
    (ha : a ∈ A)
    (ha' : a' ∈ A)
    (haa' : a ≠ a')
    (ha_gt : 1 < a)
    (ha'_gt : 1 < a')
    (hx : LMultiple a x)
    (hx' : LMultiple a' x) :
    False := by
  rcases T.trichotomy ha_gt ha'_gt hx hx' with h | h
  · exact haa' (hA ha ha' h)
  · exact haa' ((hA ha' ha h).symm)

end LTrichotomyInput

/--
Canonical finite-cutoff density of `L_a` in `{0, ..., cutoff}`.

The historical name is retained, but this is now an explicitly computed real
number rather than a proof-carrying property record.
-/
noncomputable def LMultipleDensityWitness (a cutoff : ℕ) : ℝ :=
  by
    classical
    exact
      (((Finset.range (cutoff + 1)).filter (LMultiple a)).card : ℝ) /
        (cutoff + 1 : ℝ)

namespace LMultipleDensityWitness

/-- Every canonical finite-cutoff `L_a` density is nonnegative. -/
theorem density_holds (a cutoff : ℕ) :
    0 ≤ LMultipleDensityWitness a cutoff := by
  classical
  unfold LMultipleDensityWitness
  apply div_nonneg
  · exact_mod_cast
      Nat.zero_le (((Finset.range (cutoff + 1)).filter (LMultiple a)).card)
  · positivity

/-- Every canonical finite-cutoff density is at most one. -/
theorem density_le_one (a cutoff : ℕ) :
    LMultipleDensityWitness a cutoff ≤ 1 := by
  classical
  unfold LMultipleDensityWitness
  have hcard :
      ((Finset.range (cutoff + 1)).filter (LMultiple a)).card ≤
        (Finset.range (cutoff + 1)).card :=
    Finset.card_filter_le _ _
  have hden : (0 : ℝ) < cutoff + 1 := by positivity
  rw [div_le_one hden]
  have hcard' :
      ((Finset.range (cutoff + 1)).filter (LMultiple a)).card ≤ cutoff + 1 := by
    simpa using hcard
  exact_mod_cast hcard'

/-- Canonical finite-cutoff `L_a` densities lie in the unit interval. -/
theorem density_mem_unitInterval (a cutoff : ℕ) :
    LMultipleDensityWitness a cutoff ∈ Set.Icc (0 : ℝ) 1 :=
  ⟨density_holds a cutoff, density_le_one a cutoff⟩

end LMultipleDensityWitness

/--
Canonical finite aggregate density for a finite family of `L_a` surfaces.

No logarithm or asymptotic limit is hidden in this definition.
-/
noncomputable def LPrimitiveLogDensityWitness
    (A : Finset ℕ) (cutoff : ℕ) : ℝ :=
  by
    classical
    exact ∑ a ∈ A, LMultipleDensityWitness a cutoff

/-- Native finite local-density nonnegativity theorem. -/
theorem lichtman_local_density_bound (a cutoff : ℕ) :
    0 ≤ LMultipleDensityWitness a cutoff :=
  LMultipleDensityWitness.density_holds a cutoff

/-- The finite aggregate density is the sum of its canonical local densities. -/
theorem lichtman_lDensity_eq_sum (A : Finset ℕ) (cutoff : ℕ) :
    LPrimitiveLogDensityWitness A cutoff =
      ∑ a ∈ A, LMultipleDensityWitness a cutoff :=
  rfl

/-- A finite aggregate of canonical local densities is nonnegative. -/
theorem lichtman_lDensity_nonnegative (A : Finset ℕ) (cutoff : ℕ) :
    0 ≤ LPrimitiveLogDensityWitness A cutoff := by
  unfold LPrimitiveLogDensityWitness
  apply Finset.sum_nonneg
  intro a ha
  exact LMultipleDensityWitness.density_holds a cutoff

theorem lichtman_mertens_weight_nonnegative (n : ℕ) :
    0 ≤ (1 / ((n : ℝ) + 1) : ℝ) := by
  positivity

end InfoGeometry.Arithmetic
