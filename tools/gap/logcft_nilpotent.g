Print("=== GAP c=0 LogCFT Nilpotent Representation ===\n");

# The algebra generated by N where N^2 = 0 over a 2D space
A := Algebra( Rationals, [ [ [0, 1], [0, 0] ] ] );

# The dimension of the algebra is 1 (plus implicitly scalars, but as an algebra generated by this it's 1D)
if Dimension(A) = 1 then
    Print("[OK] Nilpotent algebra has correct dimension.\n");
fi;

# N is nilpotent
N := [ [0, 1], [0, 0] ];
if N * N = [ [0, 0], [0, 0] ] then
    Print("[OK] N is strictly nilpotent.\n");
fi;

Print("GAP_LOGCFT_OK\n");
quit;
