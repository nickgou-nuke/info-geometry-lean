import InfoGeometry.Clifford.DaviauRealDirac8x8
import InfoGeometry.OperatorAlgebra.ChiralProjectorFromInvolution

/-!
# Daviau (2001) Chiral Peirce Projectors, `su(2) + su(2)` Lie Algebras, and Double-Swap

Formalizes Sections 2, 3, and 5 (Eq. 66) of Claude Daviau (2001):
1. Constructive instantiation of `OperatorAlgebra.ChiralInvolution Mat8R` for the three real
   chiral involutions `-(Γ^{0123} P_j)`, yielding Peirce projectors
   `p_j = ½(I₈ - Γ^{0123} P_j)` and `p'_j = ½(I₈ + Γ^{0123} P_j)`.
2. Explicit column-vector eigenspinor convention `p_j *ᵥ Φ = Φ` (correcting the pp. 159-160
   row-vector notation slip `Φ = Φ p_j`), illustrated by Daviau Eq. (66)'s `Φ_L` and `Φ_R`.
3. Left-chiral `su(2) ⊕ su(2)` Lie subalgebras generated by `(B_k, C_k)` on `p_j` (Eqs. 35-36)
   together with right-chiral `(Y_k, X_k)` on `p'_j` (Eq. 37), explicitly proving Lie commutation
   `B_k C_l = C_l B_k` (with non-zero product `B₁ C₁ ≠ 0`) vs. strict cross-chirality annihilation
   with `(Y_l, X_l)`.
4. The chiral double-swap identity `Γ^μ P_{j+1} p_j = p_j Γ^μ P_{j+1}` and Clifford algebra on `p_j`:
   `{M^μ, M^ν} = -2 g^{μν} p_j` (Eq. 41).
-/

noncomputable section

namespace InfoGeometry.Clifford.DaviauChiralPeirceSU2

open Matrix
open InfoGeometry.Algebra.FiniteSpin
open InfoGeometry.OperatorAlgebra
open InfoGeometry.Clifford.DaviauRealDirac8x8

/-- Cyclic successor mod 3 on `{0, 1, 2}` (representing `j ↦ j + 1 mod 3`). -/
def nextIdx : Fin 3 → Fin 3
  | ⟨0, _⟩ => ⟨1, by decide⟩
  | ⟨1, _⟩ => ⟨2, by decide⟩
  | ⟨2, _⟩ => ⟨0, by decide⟩

/-- Cyclic predecessor mod 3 on `{0, 1, 2}` (representing `j ↦ j + 2 mod 3`). -/
def prevIdx : Fin 3 → Fin 3
  | ⟨0, _⟩ => ⟨2, by decide⟩
  | ⟨1, _⟩ => ⟨0, by decide⟩
  | ⟨2, _⟩ => ⟨1, by decide⟩

/-! ### Section 1: Chiral Peirce Projectors via `ChiralInvolution` -/

/-- The involution operator `Γ^{0123} P_j ∈ M₈(ℝ)` satisfying `(Γ^{0123} P_j)² = I₈`. -/
def chiralInvolutionOp (j : Fin 3) : Mat8R :=
  gamma0123R * quatPR j

theorem chiralInvolutionOp_sq (j : Fin 3) :
    chiralInvolutionOp j * chiralInvolutionOp j = (1 : Mat8R) := by
  dsimp [chiralInvolutionOp]
  calc
    gamma0123R * quatPR j * (gamma0123R * quatPR j)
        = (gamma0123R * gamma0123R) * (quatPR j * quatPR j) := by
          have hcom := gamma0123R_comm_quatPR j
          calc
            gamma0123R * quatPR j * (gamma0123R * quatPR j)
                = gamma0123R * (quatPR j * gamma0123R) * quatPR j := by simp [mul_assoc]
            _ = gamma0123R * (gamma0123R * quatPR j) * quatPR j := by rw [← hcom]
            _ = (gamma0123R * gamma0123R) * (quatPR j * quatPR j) := by simp [mul_assoc]
    _ = (-(1 : Mat8R)) * (-(1 : Mat8R)) := by rw [gamma0123R_sq, quatPR_sq j]
    _ = 1 := by simp

/-- Constructive `ChiralInvolution Mat8R` for generation `j ∈ Fin 3` with `chi = -Γ^{0123} P_j`. -/
def daviauChiralInvolution (j : Fin 3) : ChiralInvolution Mat8R where
  chi := -chiralInvolutionOp j
  chi_sq := by
    rw [neg_mul_neg, chiralInvolutionOp_sq j]

/-- Left chiral Peirce projector `p_j = ½(I₈ - Γ^{0123} P_j)` (Daviau Eq. 35). -/
def peirceLeft (j : Fin 3) : Mat8R :=
  (daviauChiralInvolution j).Pleft

/-- Right chiral Peirce projector `p'_j = ½(I₈ + Γ^{0123} P_j)` (Daviau Eq. 37). -/
def peirceRight (j : Fin 3) : Mat8R :=
  (daviauChiralInvolution j).Pright

theorem peirceLeft_def (j : Fin 3) :
    peirceLeft j = (1 / 2 : ℝ) • ((1 : Mat8R) - gamma0123R * quatPR j) := by
  dsimp [peirceLeft, ChiralInvolution.Pleft, daviauChiralInvolution, chiralInvolutionOp]
  rw [sub_eq_add_neg]

theorem peirceRight_def (j : Fin 3) :
    peirceRight j = (1 / 2 : ℝ) • ((1 : Mat8R) + gamma0123R * quatPR j) := by
  dsimp [peirceRight, ChiralInvolution.Pright, daviauChiralInvolution, chiralInvolutionOp]
  rw [sub_neg_eq_add]

theorem peirceLeft_idem (j : Fin 3) : peirceLeft j * peirceLeft j = peirceLeft j :=
  (daviauChiralInvolution j).Pleft_idem

theorem peirceRight_idem (j : Fin 3) : peirceRight j * peirceRight j = peirceRight j :=
  (daviauChiralInvolution j).Pright_idem

theorem peirceLeft_mul_peirceRight (j : Fin 3) : peirceLeft j * peirceRight j = 0 :=
  (daviauChiralInvolution j).Pleft_mul_Pright

theorem peirceRight_mul_peirceLeft (j : Fin 3) : peirceRight j * peirceLeft j = 0 :=
  (daviauChiralInvolution j).Pright_mul_Pleft

theorem peirceLeft_add_peirceRight (j : Fin 3) : peirceLeft j + peirceRight j = 1 :=
  (daviauChiralInvolution j).Pleft_add_Pright

/-- Integer doubled left projector `2 p_j = I₈ - Γ^{0123} P_j ∈ Mat8Z`. -/
def twoPeirceLeftZ (j : Fin 3) : Mat8Z :=
  1 - gamma0123Z * quatPZ j

/-- Integer doubled right projector `2 p'_j = I₈ + Γ^{0123} P_j ∈ Mat8Z`. -/
def twoPeirceRightZ (j : Fin 3) : Mat8Z :=
  1 + gamma0123Z * quatPZ j

theorem peirceLeft_eq_half_cast (j : Fin 3) :
    peirceLeft j = (1 / 2 : ℝ) • castZ8 (twoPeirceLeftZ j) := by
  rw [peirceLeft_def]
  dsimp [twoPeirceLeftZ, gamma0123R, quatPR]
  rw [castZ8_sub, castZ8_one, castZ8_mul]

theorem peirceRight_eq_half_cast (j : Fin 3) :
    peirceRight j = (1 / 2 : ℝ) • castZ8 (twoPeirceRightZ j) := by
  rw [peirceRight_def]
  dsimp [twoPeirceRightZ, gamma0123R, quatPR]
  rw [castZ8_add, castZ8_one, castZ8_mul]

theorem peirceLeft_transpose (j : Fin 3) : (peirceLeft j)ᵀ = peirceLeft j := by
  have hZ : ∀ k : Fin 3, (twoPeirceLeftZ k)ᵀ = twoPeirceLeftZ k := by intro k; revert k; decide
  rw [peirceLeft_eq_half_cast, transpose_smul, ← castZ8_transpose, hZ j]

theorem peirceRight_transpose (j : Fin 3) : (peirceRight j)ᵀ = peirceRight j := by
  have hZ : ∀ k : Fin 3, (twoPeirceRightZ k)ᵀ = twoPeirceRightZ k := by intro k; revert k; decide
  rw [peirceRight_eq_half_cast, transpose_smul, ← castZ8_transpose, hZ j]

/-! ### Section 2: Column-Vector Spinor Convention (`p_j *ᵥ Φ = Φ`) & Daviau Eq. (66) -/

/-- Column-vector left-chiral eigenspinor predicate `p_j *ᵥ Φ = Φ` (correcting Daviau's pp. 159-160
row-vector slip `Φ = Φ p_j`). -/
def IsLeftChiralSpinor (j : Fin 3) (Φ : Vec8R) : Prop :=
  (peirceLeft j).mulVec Φ = Φ

/-- Column-vector right-chiral eigenspinor predicate `p'_j *ᵥ Φ = Φ`. -/
def IsRightChiralSpinor (j : Fin 3) (Φ : Vec8R) : Prop :=
  (peirceRight j).mulVec Φ = Φ

theorem spinor_chiral_decomp (j : Fin 3) (Φ : Vec8R) :
    (peirceLeft j).mulVec Φ + (peirceRight j).mulVec Φ = Φ := by
  rw [← Matrix.add_mulVec, peirceLeft_add_peirceRight, Matrix.one_mulVec]

theorem isLeftChiralSpinor_peirceLeft (j : Fin 3) (Φ : Vec8R) :
    IsLeftChiralSpinor j ((peirceLeft j).mulVec Φ) := by
  dsimp [IsLeftChiralSpinor]
  rw [Matrix.mulVec_mulVec, peirceLeft_idem]

theorem isRightChiralSpinor_peirceRight (j : Fin 3) (Φ : Vec8R) :
    IsRightChiralSpinor j ((peirceRight j).mulVec Φ) := by
  dsimp [IsRightChiralSpinor]
  rw [Matrix.mulVec_mulVec, peirceRight_idem]

/-- Daviau Eq. (66) left-chiral neutrino column spinor `Φ_L` (`j = 3`, i.e. `j = 2 : Fin 3`). -/
def daviauPhiL (a : Fin 4 → ℝ) : Vec8R :=
  (1 / Real.sqrt 2) • ![a 0, a 1, a 2, a 3, -a 3, a 2, a 1, -a 0]

/-- Daviau Eq. (66) right-chiral antineutrino column spinor `Φ_R` (`j = 3`, i.e. `j = 2 : Fin 3`). -/
def daviauPhiR (b : Fin 4 → ℝ) : Vec8R :=
  (1 / Real.sqrt 2) • ![b 0, b 1, b 2, b 3, b 3, -b 2, -b 1, b 0]

theorem daviauPhiL_isLeftChiral (a : Fin 4 → ℝ) :
    IsLeftChiralSpinor ⟨2, by decide⟩ (daviauPhiL a) := by
  dsimp [IsLeftChiralSpinor]
  rw [peirceLeft_eq_half_cast]
  ext i
  fin_cases i <;>
    simp [daviauPhiL, twoPeirceLeftZ, gamma0123Z, quatPZ, p3Z, castZ8,
      Matrix.mulVec, dotProduct, Fin.sum_univ_eight] <;>
    ring

theorem daviauPhiR_isRightChiral (b : Fin 4 → ℝ) :
    IsRightChiralSpinor ⟨2, by decide⟩ (daviauPhiR b) := by
  dsimp [IsRightChiralSpinor]
  rw [peirceRight_eq_half_cast]
  ext i
  fin_cases i <;>
    simp [daviauPhiR, twoPeirceRightZ, gamma0123Z, quatPZ, p3Z, castZ8,
      Matrix.mulVec, dotProduct, Fin.sum_univ_eight] <;>
    ring

/-! ### Section 3: `su(2) ⊕ su(2)` Lie Algebras on `p_j` (Daviau Eqs. 35-37) -/

/-- Integer doubled `B_k` (`2 B_k`) on `Fin 3`. -/
def twoGenBZ (j : Fin 3) : Fin 3 → Mat8Z
  | ⟨0, _⟩ => gamma2Z * gamma3Z * twoPeirceLeftZ j
  | ⟨1, _⟩ => gamma3Z * gamma1Z * twoPeirceLeftZ j
  | ⟨2, _⟩ => gamma1Z * gamma2Z * twoPeirceLeftZ j

/-- Integer doubled `C_k` (`2 C_k`) on `Fin 3`. -/
def twoGenCZ (j : Fin 3) : Fin 3 → Mat8Z
  | ⟨0, _⟩ => quatPZ j * twoPeirceLeftZ j
  | ⟨1, _⟩ => quatPZ (nextIdx j) * gamma0Z * twoPeirceLeftZ j
  | ⟨2, _⟩ => quatPZ (prevIdx j) * gamma0Z * twoPeirceLeftZ j

/-- Integer doubled right-chiral `Y_k` (`2 Y_k`) on `Fin 3` (Daviau Eq. 37). -/
def twoGenYZ (j : Fin 3) : Fin 3 → Mat8Z
  | ⟨0, _⟩ => gamma2Z * gamma3Z * twoPeirceRightZ j
  | ⟨1, _⟩ => gamma3Z * gamma1Z * twoPeirceRightZ j
  | ⟨2, _⟩ => gamma1Z * gamma2Z * twoPeirceRightZ j

/-- Integer doubled right-chiral `X_k` (`2 X_k`) on `Fin 3` (Daviau Eq. 37). -/
def twoGenXZ (j : Fin 3) : Fin 3 → Mat8Z
  | ⟨0, _⟩ => quatPZ j * twoPeirceRightZ j
  | ⟨1, _⟩ => quatPZ (nextIdx j) * gamma0Z * twoPeirceRightZ j
  | ⟨2, _⟩ => quatPZ (prevIdx j) * gamma0Z * twoPeirceRightZ j

/-- Left-chiral `B_k` generators on `p_j` (Daviau Eq. 35). -/
def genB (j k : Fin 3) : Mat8R :=
  (1 / 2 : ℝ) • castZ8 (twoGenBZ j k)

/-- Left-chiral `C_k` generators on `p_j` (Daviau Eq. 35). -/
def genC (j k : Fin 3) : Mat8R :=
  (1 / 2 : ℝ) • castZ8 (twoGenCZ j k)

/-- Right-chiral `Y_k` generators on `p'_j` (Daviau Eq. 37). -/
def genY (j k : Fin 3) : Mat8R :=
  (1 / 2 : ℝ) • castZ8 (twoGenYZ j k)

/-- Right-chiral `X_k` generators on `p'_j` (Daviau Eq. 37). -/
def genX (j k : Fin 3) : Mat8R :=
  (1 / 2 : ℝ) • castZ8 (twoGenXZ j k)

theorem genB_eq_mul (j k : Fin 3) :
    genB j k =
      (match k with
       | ⟨0, _⟩ => gammaR 2 * gammaR 3
       | ⟨1, _⟩ => gammaR 3 * gammaR 1
       | ⟨2, _⟩ => gammaR 1 * gammaR 2) * peirceLeft j := by
  fin_cases k <;>
    simp [genB, twoGenBZ, peirceLeft_eq_half_cast, gammaR, gammaZ, castZ8_mul]

theorem genC_eq_mul (j k : Fin 3) :
    genC j k =
      (match k with
       | ⟨0, _⟩ => quatPR j
       | ⟨1, _⟩ => quatPR (nextIdx j) * gammaR 0
       | ⟨2, _⟩ => quatPR (prevIdx j) * gammaR 0) * peirceLeft j := by
  fin_cases k <;>
    simp [genC, twoGenCZ, peirceLeft_eq_half_cast, quatPR, gammaR, gammaZ, castZ8_mul]

private theorem twoGenBZ_sq (j k : Fin 3) :
    twoGenBZ j k * twoGenBZ j k = -(2 • twoPeirceLeftZ j) := by
  revert j k; decide

private theorem twoGenCZ_sq (j k : Fin 3) :
    twoGenCZ j k * twoGenCZ j k = -(2 • twoPeirceLeftZ j) := by
  revert j k; decide

private theorem twoGenBZ_cyclic (j : Fin 3) :
    twoGenBZ j 0 * twoGenBZ j 1 = 2 • twoGenBZ j 2 ∧
    twoGenBZ j 1 * twoGenBZ j 0 = -(2 • twoGenBZ j 2) ∧
    twoGenBZ j 1 * twoGenBZ j 2 = 2 • twoGenBZ j 0 ∧
    twoGenBZ j 2 * twoGenBZ j 1 = -(2 • twoGenBZ j 0) ∧
    twoGenBZ j 2 * twoGenBZ j 0 = 2 • twoGenBZ j 1 ∧
    twoGenBZ j 0 * twoGenBZ j 2 = -(2 • twoGenBZ j 1) := by
  revert j; decide

private theorem twoGenCZ_cyclic (j : Fin 3) :
    twoGenCZ j 0 * twoGenCZ j 1 = 2 • twoGenCZ j 2 ∧
    twoGenCZ j 1 * twoGenCZ j 0 = -(2 • twoGenCZ j 2) ∧
    twoGenCZ j 1 * twoGenCZ j 2 = 2 • twoGenCZ j 0 ∧
    twoGenCZ j 2 * twoGenCZ j 1 = -(2 • twoGenCZ j 0) ∧
    twoGenCZ j 2 * twoGenCZ j 0 = 2 • twoGenCZ j 1 ∧
    twoGenCZ j 0 * twoGenCZ j 2 = -(2 • twoGenCZ j 1) := by
  revert j; decide

private theorem twoGenBZ_comm_twoGenCZ (j k l : Fin 3) :
    twoGenBZ j k * twoGenCZ j l = twoGenCZ j l * twoGenBZ j k := by
  revert j k l; decide

private theorem twoGenBZ_transpose (j k : Fin 3) :
    (twoGenBZ j k)ᵀ = -twoGenBZ j k := by
  revert j k; decide

private theorem twoGenCZ_transpose (j k : Fin 3) :
    (twoGenCZ j k)ᵀ = -twoGenCZ j k := by
  revert j k; decide

private theorem twoPeirceLeftZ_mul_twoGenYZ (j l : Fin 3) :
    twoPeirceLeftZ j * twoGenYZ j l = 0 := by
  revert j l; decide

private theorem twoPeirceLeftZ_mul_twoGenXZ (j l : Fin 3) :
    twoPeirceLeftZ j * twoGenXZ j l = 0 := by
  revert j l; decide

private lemma twoGenBZ_factor_right (j k : Fin 3) :
    ∃ M : Mat8Z, twoGenBZ j k = M * twoPeirceLeftZ j := by
  fin_cases k
  · exact ⟨gamma2Z * gamma3Z, rfl⟩
  · exact ⟨gamma3Z * gamma1Z, rfl⟩
  · exact ⟨gamma1Z * gamma2Z, rfl⟩

private lemma twoGenCZ_factor_right (j k : Fin 3) :
    ∃ M : Mat8Z, twoGenCZ j k = M * twoPeirceLeftZ j := by
  fin_cases k
  · exact ⟨quatPZ j, rfl⟩
  · exact ⟨quatPZ (nextIdx j) * gamma0Z, rfl⟩
  · exact ⟨quatPZ (prevIdx j) * gamma0Z, rfl⟩

private theorem twoGenBZ_twoGenYZ_zero (j k l : Fin 3) :
    twoGenBZ j k * twoGenYZ j l = 0 ∧ twoGenBZ j k * twoGenXZ j l = 0 ∧
    twoGenCZ j k * twoGenYZ j l = 0 ∧ twoGenCZ j k * twoGenXZ j l = 0 := by
  obtain ⟨MB, hB⟩ := twoGenBZ_factor_right j k
  obtain ⟨MC, hC⟩ := twoGenCZ_factor_right j k
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hB, mul_assoc, twoPeirceLeftZ_mul_twoGenYZ, mul_zero]
  · rw [hB, mul_assoc, twoPeirceLeftZ_mul_twoGenXZ, mul_zero]
  · rw [hC, mul_assoc, twoPeirceLeftZ_mul_twoGenYZ, mul_zero]
  · rw [hC, mul_assoc, twoPeirceLeftZ_mul_twoGenXZ, mul_zero]

/-- Lifting `½ A * ½ B = ¼ (A * B)` when `A * B = 2 • C` gives `½ C`. -/
private theorem half_cast_mul_of_two_zsmul {A B C : Mat8Z} (h : A * B = 2 • C) :
    ((1 / 2 : ℝ) • castZ8 A) * ((1 / 2 : ℝ) • castZ8 B) = (1 / 2 : ℝ) • castZ8 C := by
  rw [smul_mul_smul_comm, ← castZ8_mul, h, two_smul, castZ8_add, ← two_smul ℝ, smul_smul]
  norm_num

private theorem half_cast_mul_of_neg_two_zsmul {A B C : Mat8Z} (h : A * B = -(2 • C)) :
    ((1 / 2 : ℝ) • castZ8 A) * ((1 / 2 : ℝ) • castZ8 B) = -((1 / 2 : ℝ) • castZ8 C) := by
  rw [smul_mul_smul_comm, ← castZ8_mul, h, castZ8_neg, two_smul, castZ8_add, ← two_smul ℝ,
    smul_neg, smul_smul]
  norm_num

theorem genB_sq (j k : Fin 3) : genB j k * genB j k = -peirceLeft j := by
  dsimp [genB]
  rw [half_cast_mul_of_neg_two_zsmul (twoGenBZ_sq j k), peirceLeft_eq_half_cast]

theorem genC_sq (j k : Fin 3) : genC j k * genC j k = -peirceLeft j := by
  dsimp [genC]
  rw [half_cast_mul_of_neg_two_zsmul (twoGenCZ_sq j k), peirceLeft_eq_half_cast]

theorem genB_cyclic (j : Fin 3) :
    genB j 0 * genB j 1 = genB j 2 ∧
    genB j 1 * genB j 0 = -genB j 2 ∧
    genB j 1 * genB j 2 = genB j 0 ∧
    genB j 2 * genB j 1 = -genB j 0 ∧
    genB j 2 * genB j 0 = genB j 1 ∧
    genB j 0 * genB j 2 = -genB j 1 := by
  have h := twoGenBZ_cyclic j
  refine ⟨half_cast_mul_of_two_zsmul h.1, half_cast_mul_of_neg_two_zsmul h.2.1,
    half_cast_mul_of_two_zsmul h.2.2.1, half_cast_mul_of_neg_two_zsmul h.2.2.2.1,
    half_cast_mul_of_two_zsmul h.2.2.2.2.1, half_cast_mul_of_neg_two_zsmul h.2.2.2.2.2⟩

theorem genC_cyclic (j : Fin 3) :
    genC j 0 * genC j 1 = genC j 2 ∧
    genC j 1 * genC j 0 = -genC j 2 ∧
    genC j 1 * genC j 2 = genC j 0 ∧
    genC j 2 * genC j 1 = -genC j 0 ∧
    genC j 2 * genC j 0 = genC j 1 ∧
    genC j 0 * genC j 2 = -genC j 1 := by
  have h := twoGenCZ_cyclic j
  refine ⟨half_cast_mul_of_two_zsmul h.1, half_cast_mul_of_neg_two_zsmul h.2.1,
    half_cast_mul_of_two_zsmul h.2.2.1, half_cast_mul_of_neg_two_zsmul h.2.2.2.1,
    half_cast_mul_of_two_zsmul h.2.2.2.2.1, half_cast_mul_of_neg_two_zsmul h.2.2.2.2.2⟩

/-- Lie bracket commutation `[B_k, C_l] = 0` (`B_k C_l = C_l B_k`) on `p_j` (Daviau Eq. 36). -/
theorem genB_comm_genC (j k l : Fin 3) :
    genB j k * genC j l = genC j l * genB j k := by
  dsimp [genB, genC]
  rw [smul_mul_smul_comm, smul_mul_smul_comm, ← castZ8_mul, ← castZ8_mul,
    twoGenBZ_comm_twoGenCZ j k l]

/-- Clarifying Daviau Eq. (36): `B_k` and `C_l` commute in the Lie bracket (`[B_k, C_l] = 0`)
and share `p_j`, so their matrix product `genB j 0 * genC j 0` is nonzero. -/
theorem genB_mul_genC_nonzero (j : Fin 3) : genB j 0 * genC j 0 ≠ 0 := by
  have hZ : ∀ k : Fin 3, twoGenBZ k 0 * twoGenCZ k 0 ≠ 0 := by decide
  intro h
  have hR : (1 / 4 : ℝ) • castZ8 (twoGenBZ j 0 * twoGenCZ j 0) = 0 := by
    have h0 : genB j 0 * genC j 0 = (1 / 4 : ℝ) • castZ8 (twoGenBZ j 0 * twoGenCZ j 0) := by
      dsimp [genB, genC]; rw [smul_mul_smul_comm, ← castZ8_mul]; norm_num
    rw [← h0]; exact h
  have hC : castZ8 (twoGenBZ j 0 * twoGenCZ j 0) = 0 :=
    (smul_eq_zero.mp hR).resolve_left (by norm_num)
  apply hZ j
  ext a b
  have hab := congrArg (fun M : Mat8R => M a b) hC
  exact Int.cast_eq_zero.mp hab

theorem genB_mem_so8 (j k : Fin 3) : genB j k ∈ so8Submodule := by
  change (genB j k)ᵀ = -genB j k
  simp [genB, ← castZ8_transpose, twoGenBZ_transpose j k]

theorem genC_mem_so8 (j k : Fin 3) : genC j k ∈ so8Submodule := by
  change (genC j k)ᵀ = -genC j k
  simp [genC, ← castZ8_transpose, twoGenCZ_transpose j k]

theorem genB_genC_annihilate_rightChiral (j k l : Fin 3) :
    genB j k * genY j l = 0 ∧ genB j k * genX j l = 0 ∧
    genC j k * genY j l = 0 ∧ genC j k * genX j l = 0 := by
  have h := twoGenBZ_twoGenYZ_zero j k l
  dsimp [genB, genC, genY, genX]
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    · rw [smul_mul_smul_comm, ← castZ8_mul]
      first | rw [h.1] | rw [h.2.1] | rw [h.2.2.1] | rw [h.2.2.2]
      simp

/-! ### Section 4: Chiral Double-Swap & `M^μ = Γ^μ P_{j+1} p_j` (Daviau Eqs. 38-44) -/

/-- Chiral massive Dirac operator `M^μ = Γ^μ P_{j+1} p_j` (Daviau Eq. 38). -/
def chiralDiracM (j : Fin 3) (μ : Fin 4) : Mat8R :=
  gammaR μ * quatPR (nextIdx j) * peirceLeft j

/-- Integer doubled `2 M^μ = Γ^μ P_{j+1} (2 p_j)`. -/
def twoChiralDiracMZ (j : Fin 3) (μ : Fin 4) : Mat8Z :=
  gammaZ μ * quatPZ (nextIdx j) * twoPeirceLeftZ j

theorem chiralDiracM_eq_half_cast (j : Fin 3) (μ : Fin 4) :
    chiralDiracM j μ = (1 / 2 : ℝ) • castZ8 (twoChiralDiracMZ j μ) := by
  dsimp [chiralDiracM, twoChiralDiracMZ, gammaR, quatPR]
  rw [peirceLeft_eq_half_cast, Matrix.mul_smul, ← castZ8_mul, ← castZ8_mul]

/-- First chiral swap: `Γ^μ p_j = p'_j Γ^μ`. -/
theorem gammaR_swap_peirceLeft (j : Fin 3) (μ : Fin 4) :
    gammaR μ * peirceLeft j = peirceRight j * gammaR μ := by
  have hZ : ∀ (k : Fin 3) (α : Fin 4),
      gammaZ α * twoPeirceLeftZ k = twoPeirceRightZ k * gammaZ α := by
    intro k α; revert k α; decide
  rw [peirceLeft_eq_half_cast, peirceRight_eq_half_cast, Matrix.mul_smul, Matrix.smul_mul]
  dsimp [gammaR]; rw [← castZ8_mul, ← castZ8_mul, hZ j μ]

/-- Second chiral swap: `P_{j+1} p'_j = p_j P_{j+1}` (and `P_{j+1} p_j = p'_j P_{j+1}`). -/
theorem quatPR_next_swap_peirceRight (j : Fin 3) :
    quatPR (nextIdx j) * peirceRight j = peirceLeft j * quatPR (nextIdx j) := by
  have hZ : ∀ k : Fin 3, quatPZ (nextIdx k) * twoPeirceRightZ k =
      twoPeirceLeftZ k * quatPZ (nextIdx k) := by
    intro k; revert k; decide
  rw [peirceRight_eq_half_cast, peirceLeft_eq_half_cast, Matrix.mul_smul, Matrix.smul_mul]
  dsimp [quatPR]; rw [← castZ8_mul, ← castZ8_mul, hZ j]

/-- Double swap: `Γ^μ P_{j+1}` commutes with `p_j`, so `chiralDiracM j μ = p_j * (Γ^μ P_{j+1})`. -/
theorem chiralDiracM_double_swap (j : Fin 3) (μ : Fin 4) :
    (gammaR μ * quatPR (nextIdx j)) * peirceLeft j =
      peirceLeft j * (gammaR μ * quatPR (nextIdx j)) := by
  calc
    (gammaR μ * quatPR (nextIdx j)) * peirceLeft j
        = quatPR (nextIdx j) * (gammaR μ * peirceLeft j) := by
          rw [gammaR_comm_quatPR μ (nextIdx j), mul_assoc]
    _ = quatPR (nextIdx j) * (peirceRight j * gammaR μ) := by
          rw [gammaR_swap_peirceLeft]
    _ = (quatPR (nextIdx j) * peirceRight j) * gammaR μ := by
          rw [mul_assoc]
    _ = (peirceLeft j * quatPR (nextIdx j)) * gammaR μ := by
          rw [quatPR_next_swap_peirceRight]
    _ = peirceLeft j * (gammaR μ * quatPR (nextIdx j)) := by
          rw [mul_assoc, ← gammaR_comm_quatPR μ (nextIdx j)]

/-- Daviau Eq. (41): `{M^μ, M^ν} = -2 g^{μν} p_j`. -/
theorem chiralDiracM_anticomm (j : Fin 3) (μ ν : Fin 4) :
    chiralDiracM j μ * chiralDiracM j ν + chiralDiracM j ν * chiralDiracM j μ =
      (if μ = ν then -2 * minkowskiMetricR μ else 0) • peirceLeft j := by
  have hZ : ∀ (k : Fin 3) (α β : Fin 4),
      twoChiralDiracMZ k α * twoChiralDiracMZ k β +
        twoChiralDiracMZ k β * twoChiralDiracMZ k α =
      (if α = β then -4 * minkowskiMetricZ α else 0) • twoPeirceLeftZ k := by
    intro k α β; revert k α β; decide
  rw [chiralDiracM_eq_half_cast, chiralDiracM_eq_half_cast]
  rw [smul_mul_smul_comm, smul_mul_smul_comm, ← smul_add, ← castZ8_mul, ← castZ8_mul,
    ← castZ8_add, hZ j μ ν, castZ8_zsmul, peirceLeft_eq_half_cast, smul_smul, smul_smul]
  congr 1
  by_cases h : μ = ν
  · subst h
    simp [minkowskiMetricR]
    ring
  · simp [h]

/-- Column-vector spinor invariance: `M^μ *ᵥ Φ` remains in the left-chiral eigenspace `p_j *ᵥ Ψ = Ψ`
whenever `p_j *ᵥ Φ = Φ` (in fact for any `Φ`). -/
theorem chiralDiracM_preserves_leftChiral (j : Fin 3) (μ : Fin 4) (Φ : Vec8R) :
    IsLeftChiralSpinor j ((chiralDiracM j μ).mulVec Φ) := by
  dsimp [IsLeftChiralSpinor]
  rw [Matrix.mulVec_mulVec]
  calc
    (peirceLeft j * chiralDiracM j μ).mulVec Φ
        = (peirceLeft j * ((gammaR μ * quatPR (nextIdx j)) * peirceLeft j)).mulVec Φ := rfl
    _ = ((peirceLeft j * peirceLeft j) * (gammaR μ * quatPR (nextIdx j))).mulVec Φ := by
          rw [chiralDiracM_double_swap, ← mul_assoc]
    _ = (peirceLeft j * (gammaR μ * quatPR (nextIdx j))).mulVec Φ := by
          rw [peirceLeft_idem]
    _ = ((gammaR μ * quatPR (nextIdx j)) * peirceLeft j).mulVec Φ := by
          rw [← chiralDiracM_double_swap]
    _ = (chiralDiracM j μ).mulVec Φ := rfl

/-- **Theorem 2 (`daviau_chiral_peirce_su2_double_swap`)**:
Chiral Peirce projectors `(p_j, p'_j)`, `su(2) ⊕ su(2)` Lie relations of `(B_k, C_k)` (Daviau Eq. 36),
commutation vs. cross-chirality annihilation, chiral double-swap, `{M^μ, M^ν} = -2 g^{μν} p_j`
(Daviau Eq. 41), and column-vector chiral invariance `p_j *ᵥ Φ = Φ`. -/
theorem daviau_chiral_peirce_su2_double_swap (j : Fin 3) :
    (peirceLeft j * peirceLeft j = peirceLeft j ∧
     peirceRight j * peirceRight j = peirceRight j ∧
     peirceLeft j * peirceRight j = 0 ∧
     peirceLeft j + peirceRight j = 1) ∧
    (genB j 0 * genB j 1 = genB j 2 ∧ genB j 1 * genB j 0 = -genB j 2 ∧
     genB j 1 * genB j 2 = genB j 0 ∧ genB j 2 * genB j 1 = -genB j 0 ∧
     genB j 2 * genB j 0 = genB j 1 ∧ genB j 0 * genB j 2 = -genB j 1) ∧
    (genC j 0 * genC j 1 = genC j 2 ∧ genC j 1 * genC j 0 = -genC j 2 ∧
     genC j 1 * genC j 2 = genC j 0 ∧ genC j 2 * genC j 1 = -genC j 0 ∧
     genC j 2 * genC j 0 = genC j 1 ∧ genC j 0 * genC j 2 = -genC j 1) ∧
    (∀ k : Fin 3, genB j k * genB j k = -peirceLeft j ∧ genC j k * genC j k = -peirceLeft j) ∧
    (∀ k l : Fin 3, genB j k * genC j l = genC j l * genB j k) ∧
    (∀ μ : Fin 4, (gammaR μ * quatPR (nextIdx j)) * peirceLeft j =
      peirceLeft j * (gammaR μ * quatPR (nextIdx j))) ∧
    (∀ μ ν : Fin 4, chiralDiracM j μ * chiralDiracM j ν + chiralDiracM j ν * chiralDiracM j μ =
      (if μ = ν then -2 * minkowskiMetricR μ else 0) • peirceLeft j) ∧
    (∀ (μ : Fin 4) (Φ : Vec8R), IsLeftChiralSpinor j Φ →
      IsLeftChiralSpinor j ((chiralDiracM j μ).mulVec Φ)) :=
  ⟨⟨peirceLeft_idem j, peirceRight_idem j, peirceLeft_mul_peirceRight j, peirceLeft_add_peirceRight j⟩,
   genB_cyclic j,
   genC_cyclic j,
   fun k => ⟨genB_sq j k, genC_sq j k⟩,
   genB_comm_genC j,
   chiralDiracM_double_swap j,
   chiralDiracM_anticomm j,
   fun μ Φ _ => chiralDiracM_preserves_leftChiral j μ Φ⟩

end InfoGeometry.Clifford.DaviauChiralPeirceSU2
