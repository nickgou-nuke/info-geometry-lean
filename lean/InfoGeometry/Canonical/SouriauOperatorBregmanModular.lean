import InfoGeometry.Canonical.BogoliubovTransport
import InfoGeometry.Geometry.OperatorBregmanDivergence
import InfoGeometry.Meta.Architecture

/-!
# Souriau operator Bregman modular bridge

This file anchors the bounded-operator part of the Souriau/information-geometry
picture on the repo-native real doubled Krein carrier.

It formalizes only the bounded roots available here:

* operator product pairings are evaluated by Krein expectation;
* operatorial Bregman divergence is pulled back along a Souriau representation;
* a bounded modular Hamiltonian generates a beta-family by `exp((-beta) • K)`;
* `Delta - I` is the deviation of a bounded modular operator from the identity.

It does not assert an unbounded logarithm theorem for type-III modular operators,
trace formulas, or a full Tomita-Takesaki standard form.
-/

noncomputable section

namespace SouriauOperatorBregmanModular

open InfoGeometry.Canonical.BogoliubovTransport
open InfoGeometry.Geometry.OperatorBregmanDivergence

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => InfoGeometry.Krein.DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance

/-- Primal bounded operator lane on the real doubled carrier. -/
@[rep_depth operator]
abbrev OperatorPrimal : Type := EndH

/-- Dual bounded operator lane, paired with the primal lane by a state expectation. -/
@[rep_depth operator]
abbrev OperatorDual : Type := EndH

/-- Krein pairing of one observable against a doubled state. -/
@[rep_depth thermo]
def observablePairing (ψ : H₂) (A : OperatorDual (E := E)) : ℝ :=
  kreinExpectation (E := E) ψ A

/-- Product pairing: a primal operator and a dual operator are multiplied first. -/
@[rep_depth thermo]
def operatorProductPairing
    (ψ : H₂) (ρ : OperatorPrimal (E := E)) (H : OperatorDual (E := E)) : ℝ :=
  kreinExpectation (E := E) ψ (ρ * H)

@[simp]
theorem observablePairing_add
    (ψ : H₂) (A B : OperatorDual (E := E)) :
    observablePairing (E := E) ψ (A + B) =
      observablePairing (E := E) ψ A + observablePairing (E := E) ψ B := by
  simp [observablePairing]

@[simp]
theorem observablePairing_sub
    (ψ : H₂) (A B : OperatorDual (E := E)) :
    observablePairing (E := E) ψ (A - B) =
      observablePairing (E := E) ψ A - observablePairing (E := E) ψ B := by
  simp [observablePairing]

@[simp]
theorem observablePairing_smul
    (ψ : H₂) (c : ℝ) (A : OperatorDual (E := E)) :
    observablePairing (E := E) ψ (c • A) =
      c * observablePairing (E := E) ψ A := by
  simp [observablePairing]

@[simp]
theorem operatorProductPairing_zero_right
    (ψ : H₂) (ρ : OperatorPrimal (E := E)) :
    operatorProductPairing (E := E) ψ ρ 0 = 0 := by
  simp [operatorProductPairing, kreinExpectation, InfoGeometry.Krein.KreinSpace.kreinInner_def]

/-- Raw bounded-operator Bregman divergence using the product/Krein pairing. -/
@[rep_depth thermo]
def boundedOperatorBregman
    (ψ : H₂)
    (Phi : OperatorPrimal (E := E) → ℝ)
    (gradPhi : OperatorPrimal (E := E) → OperatorDual (E := E))
    (X Y : OperatorPrimal (E := E)) : ℝ :=
  Phi X - Phi Y - operatorProductPairing (E := E) ψ (gradPhi Y) (X - Y)

@[simp]
theorem boundedOperatorBregman_self
    (ψ : H₂)
    (Phi : OperatorPrimal (E := E) → ℝ)
    (gradPhi : OperatorPrimal (E := E) → OperatorDual (E := E))
    (X : OperatorPrimal (E := E)) :
    boundedOperatorBregman (E := E) ψ Phi gradPhi X X = 0 := by
  simp [boundedOperatorBregman]

/-- A Souriau representation by bounded operators on the real doubled carrier. -/
@[rep_depth thermo]
structure SouriauOperatorRepresentation (g : Type*) where
  /-- Infinitesimal generator assigned to an abstract Souriau parameter. -/
  rep : g → OperatorPrimal (E := E)

namespace SouriauOperatorRepresentation

variable {g : Type*} (R : SouriauOperatorRepresentation (E := E) g)

/-- Pull back the bounded-operator Bregman divergence along a Souriau representation. -/
@[rep_depth thermo]
def bregmanPullback
    (ψ : H₂)
    (Phi : OperatorPrimal (E := E) → ℝ)
    (gradPhi : OperatorPrimal (E := E) → OperatorDual (E := E))
    (ξ η : g) : ℝ :=
  boundedOperatorBregman (E := E) ψ Phi gradPhi (R.rep ξ) (R.rep η)

@[simp]
theorem bregmanPullback_self
    (ψ : H₂)
    (Phi : OperatorPrimal (E := E) → ℝ)
    (gradPhi : OperatorPrimal (E := E) → OperatorDual (E := E))
    (ξ : g) :
    R.bregmanPullback ψ Phi gradPhi ξ ξ = 0 := by
  simp [bregmanPullback]

/-- The bounded modular Hamiltonian generated by a Souriau parameter. -/
@[rep_depth thermo]
abbrev modularHamiltonian (ξ : g) : OperatorPrimal (E := E) :=
  R.rep ξ

end SouriauOperatorRepresentation

/-- Bounded beta-family generated by a modular Hamiltonian `K`. -/
@[rep_depth thermo]
def modularBetaExponential (K : OperatorPrimal (E := E)) (beta : ℝ) : OperatorPrimal (E := E) :=
  NormedSpace.exp ((-beta) • K)

@[simp]
theorem modularBetaExponential_zero
    (K : OperatorPrimal (E := E)) :
    modularBetaExponential (E := E) K 0 = 1 := by
  simp [modularBetaExponential, NormedSpace.exp_zero]

/-- The bounded modular operator at inverse-temperature parameter `beta = 1`. -/
@[rep_depth thermo]
def modularDeltaOfHamiltonian (K : OperatorPrimal (E := E)) : OperatorPrimal (E := E) :=
  modularBetaExponential (E := E) K 1

@[simp]
theorem modularDeltaOfHamiltonian_eq
    (K : OperatorPrimal (E := E)) :
    modularDeltaOfHamiltonian (E := E) K = NormedSpace.exp ((-1 : ℝ) • K) := by
  rfl

/-- `Delta - I`: bounded deviation from the identity operator. -/
@[rep_depth thermo]
def modularDeviation (Delta : OperatorPrimal (E := E)) : OperatorPrimal (E := E) :=
  Delta - 1

@[simp]
theorem modularDeviation_one :
    modularDeviation (E := E) (1 : OperatorPrimal (E := E)) = 0 := by
  simp [modularDeviation]

@[simp]
theorem modularDeviation_beta_zero
    (K : OperatorPrimal (E := E)) :
    modularDeviation (E := E) (modularBetaExponential (E := E) K 0) = 0 := by
  simp [modularDeviation]

/-- A bounded pair saying that `Delta` is generated by `K` at `beta = 1`. -/
@[rep_depth thermo]
def IsBoundedModularPair
    (Delta K : OperatorPrimal (E := E)) : Prop :=
  Delta = modularDeltaOfHamiltonian (E := E) K

/-- Read `Delta - I` through the bounded modular Hamiltonian presentation. -/
@[rep_depth thermo]
theorem modularDeviation_of_boundedPair
    {Delta K : OperatorPrimal (E := E)}
    (h : IsBoundedModularPair (E := E) Delta K) :
    modularDeviation (E := E) Delta = NormedSpace.exp ((-1 : ℝ) • K) - 1 := by
  rw [h]
  rfl

namespace SouriauOperatorRepresentation

variable {g : Type*} (R : SouriauOperatorRepresentation (E := E) g)

/-- Souriau beta-family of bounded modular operators. -/
@[rep_depth thermo]
def modularBetaFamily (ξ : g) (beta : ℝ) : OperatorPrimal (E := E) :=
  modularBetaExponential (E := E) (R.modularHamiltonian ξ) beta

@[simp]
theorem modularBetaFamily_zero (ξ : g) :
    R.modularBetaFamily ξ 0 = 1 := by
  simp [modularBetaFamily]

/-- Souriau `Delta - I` readout at `beta = 1`. -/
@[rep_depth thermo]
def modularDeviationAtOne (ξ : g) : OperatorPrimal (E := E) :=
  modularDeviation (E := E) (R.modularBetaFamily ξ 1)

@[simp]
theorem modularDeviationAtOne_eq (ξ : g) :
    R.modularDeviationAtOne ξ =
      NormedSpace.exp ((-1 : ℝ) • R.modularHamiltonian ξ) - 1 := by
  rfl

end SouriauOperatorRepresentation

/-- Link to the existing regular-cone Bregman root: diagonal divergence vanishes. -/
@[simp]
theorem regularConeBregman_self_readback
    {c : InfoGeometry.Canonical.CertifiedModularReduction
      (E := InfoGeometry.Krein.DoubledSpace E)}
    (ω : OperatorEnd E →L[ℝ] ℝ)
    (gradPhi : OperatorEnd E → OperatorEnd E →L[ℝ] ℝ)
    (U : RegularConePoint (E := E) c) :
    operatorBregmanDivergence (E := E) ω gradPhi U U = 0 := by
  simpa using operatorBregmanDivergence_self (E := E) ω gradPhi U

end SouriauOperatorBregmanModular
