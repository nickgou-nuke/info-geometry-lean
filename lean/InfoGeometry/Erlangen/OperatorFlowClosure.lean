import InfoGeometry.Algebra.DerivationSymmetry
import InfoGeometry.Clifford.NeutralPhaseSpaceSymmetry
import InfoGeometry.Lie.ContinuousDerivationInvariantFunctional
import Mathlib.Algebra.Group.Action.Hom
import Mathlib.Analysis.Normed.Operator.Mul
import Mathlib.GroupTheory.GroupAction.FixingSubgroup
import Mathlib.Order.Closure

/-!
# Bounded operator flows and invariant-data symmetry closure

Bounded derivations of a complete real normed algebra generate actual algebra
automorphisms. Their native generated subgroup lies in the subgroup fixing all
of its invariant data, for any specified action on a data carrier. The native
Galois connection makes this an idempotent closure with unchanged fixed data.

For the inverse-dual action on the algebraic dual, a continuous functional
annihilating every generator is fixed by both the generated flow group and
its invariant-data closure. The conjugation-generated Lie algebra of those
generators consequently annihilates the same functional.

The ambient algebra is allowed to be noncommutative. The flows are bounded
operator exponentials; the invariant-data closure is an algebraic subgroup
construction, with no topological closure or unbounded integration asserted.
Ambient algebra automorphisms need not be continuous, and the closure does not
assert that each added symmetry is bounded or an exponential.
-/

noncomputable section

namespace InfoGeometry.Erlangen.OperatorFlowClosure

open InfoGeometry.Lie.ContinuousDerivationExponential
open InfoGeometry.Algebra.NonAssocDerivation

attribute [local instance 100] LieRing.ofAssociativeRing

variable {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]

section AlgebraAutomorphism

/-- Surjectivity and multiplication preservation force the flow to preserve
the multiplicative identity. -/
theorem flow_map_one (D : A →L[ℝ] A)
    (hD : IsDerivation (ContinuousLinearMap.mul ℝ A) D) (t : ℝ) :
    flow D t (1 : A) = 1 := by
  let y : A := (flowLinearEquiv D t).symm 1
  have hy : flow D t y = 1 := (flowLinearEquiv D t).apply_symm_apply 1
  have hmul := flow_map_mul (ContinuousLinearMap.mul ℝ A) D hD t 1 y
  change flow D t (1 * y) = flow D t 1 * flow D t y at hmul
  rw [one_mul, hy, mul_one] at hmul
  exact hmul.symm

/-- The existing bounded derivation flow, bundled as a native algebra
automorphism of the original noncommutative algebra. -/
def flowAlgEquiv (D : A →L[ℝ] A)
    (hD : IsDerivation (ContinuousLinearMap.mul ℝ A) D) (t : ℝ) :
    A ≃ₐ[ℝ] A :=
  AlgEquiv.ofLinearEquiv (flowLinearEquiv D t) (flow_map_one D hD t)
    (fun x y => flow_map_mul (ContinuousLinearMap.mul ℝ A) D hD t x y)

@[simp]
theorem flowAlgEquiv_apply (D : A →L[ℝ] A)
    (hD : IsDerivation (ContinuousLinearMap.mul ℝ A) D) (t : ℝ) (x : A) :
    flowAlgEquiv D hD t x = flow D t x :=
  rfl

@[simp]
theorem flowAlgEquiv_symm_apply (D : A →L[ℝ] A)
    (hD : IsDerivation (ContinuousLinearMap.mul ℝ A) D) (t : ℝ) (x : A) :
    (flowAlgEquiv D hD t).symm x = flow D (-t) x := by
  change flow (-D) t x = flow D (-t) x
  rw [flow_neg_generator]

@[simp]
theorem flowAlgEquiv_zero (D : A →L[ℝ] A)
    (hD : IsDerivation (ContinuousLinearMap.mul ℝ A) D) :
    flowAlgEquiv D hD 0 = 1 := by
  ext x
  change flow D 0 x = x
  simp

theorem flowAlgEquiv_add (D : A →L[ℝ] A)
    (hD : IsDerivation (ContinuousLinearMap.mul ℝ A) D) (s t : ℝ) :
    flowAlgEquiv D hD (s + t) = flowAlgEquiv D hD s * flowAlgEquiv D hD t := by
  ext x
  change flow D (s + t) x = flow D s (flow D t x)
  exact congrArg (fun T : A →L[ℝ] A => T x) (flow_add D s t)

@[simp]
theorem flowAlgEquiv_neg (D : A →L[ℝ] A)
    (hD : IsDerivation (ContinuousLinearMap.mul ℝ A) D) (t : ℝ) :
    flowAlgEquiv D hD (-t) = (flowAlgEquiv D hD t)⁻¹ := by
  ext x
  exact (flowAlgEquiv_symm_apply D hD t x).symm

end AlgebraAutomorphism

section GeneratedGroup

variable {ι : Type*} (D : ι → A →L[ℝ] A)
  (hD : ∀ i, IsDerivation (ContinuousLinearMap.mul ℝ A) (D i))

/-- The subgroup generated by every real time of every chosen bounded
derivation. Native subgroup generation includes products and inverses. -/
def flowGroup : Subgroup (A ≃ₐ[ℝ] A) :=
  Subgroup.closure
    (Set.range (fun p : ι × ℝ => flowAlgEquiv (D p.1) (hD p.1) p.2))

theorem flowAlgEquiv_mem_flowGroup (i : ι) (t : ℝ) :
    flowAlgEquiv (D i) (hD i) t ∈ flowGroup D hD :=
  Subgroup.subset_closure ⟨(i, t), rfl⟩

variable (T : Type*) [MulAction (A ≃ₐ[ℝ] A) T]

/-- The native invariant-data closure operator on the actual ambient algebra
automorphism group, for the specified data action. -/
def dataClosureOperator : ClosureOperator (Subgroup (A ≃ₐ[ℝ] A)) :=
  (fixingSubgroup_fixedPoints_gc (A ≃ₐ[ℝ] A) T).dual.closureOperator

omit [CompleteSpace A] in
@[simp]
theorem dataClosureOperator_apply (H : Subgroup (A ≃ₐ[ℝ] A)) :
    dataClosureOperator (A := A) T H =
      fixingSubgroup (A ≃ₐ[ℝ] A) (MulAction.fixedPoints H T) :=
  rfl

/-- All algebra automorphisms fixing the invariant data of the generated
bounded-flow group. -/
def flowSymmetryClosure : Subgroup (A ≃ₐ[ℝ] A) :=
  dataClosureOperator (A := A) T (flowGroup D hD)

theorem flowGroup_le_flowSymmetryClosure :
    flowGroup D hD ≤ flowSymmetryClosure D hD T :=
  (dataClosureOperator (A := A) T).le_closure (flowGroup D hD)

theorem flowSymmetryClosure_idempotent :
    dataClosureOperator (A := A) T (flowSymmetryClosure D hD T) =
      flowSymmetryClosure D hD T :=
  (dataClosureOperator (A := A) T).idempotent (flowGroup D hD)

/-- Completing the group with respect to its invariant data does not change
the chosen fixed data. -/
theorem fixedPoints_flowSymmetryClosure :
    MulAction.fixedPoints (flowSymmetryClosure D hD T) T =
      MulAction.fixedPoints (flowGroup D hD) T :=
  (fixingSubgroup_fixedPoints_gc (A ≃ₐ[ℝ] A) T).u_l_u_eq_u
    (OrderDual.toDual (flowGroup D hD))

end GeneratedGroup

section FunctionalAction

/-- Forgetting multiplication preserves the native automorphism group law. -/
def algEquivToLinearEquivHom : (A ≃ₐ[ℝ] A) →* (A ≃ₗ[ℝ] A) where
  toFun α := α.toLinearEquiv
  map_one' := rfl
  map_mul' _ _ := rfl

/-- The real inverse-dual action, pulled back along algebra automorphisms.
It is explicit data rather than a global action instance. -/
@[instance_reducible]
def algebraContragredientAction :
    MulAction (A ≃ₐ[ℝ] A) (Module.Dual ℝ A) :=
  MulAction.compHom (Module.Dual ℝ A)
    ((InfoGeometry.Clifford.NeutralPhaseSpaceSymmetry.contragredientLinearEquivHom
      (E := A)).comp (algEquivToLinearEquivHom (A := A)))

local instance : MulAction (A ≃ₐ[ℝ] A) (Module.Dual ℝ A) :=
  algebraContragredientAction

omit [CompleteSpace A] in
@[simp]
theorem algebraContragredient_smul_apply
    (α : A ≃ₐ[ℝ] A) (μ : Module.Dual ℝ A) (x : A) :
    (α • μ) x = μ (α.symm x) := by
  change
    InfoGeometry.Clifford.NeutralPhaseSpaceSymmetry.contragredientLinearEquivHom
      α.toLinearEquiv μ x = μ (α.symm x)
  exact InfoGeometry.Clifford.NeutralPhaseSpaceSymmetry.contragredientLinearEquivHom_apply
    α.toLinearEquiv μ x

omit [CompleteSpace A] in
/-- Fixing a dual datum under the inverse-dual action is exactly preservation
of its evaluation on the original algebra. -/
theorem algebraContragredient_fixed_iff
    (α : A ≃ₐ[ℝ] A) (μ : Module.Dual ℝ A) :
    α • μ = μ ↔ ∀ x : A, μ (α x) = μ x := by
  constructor
  · intro h x
    have hx := congrArg (fun ν : Module.Dual ℝ A => ν (α x)) h
    rw [algebraContragredient_smul_apply, α.symm_apply_apply] at hx
    exact hx.symm
  · intro h
    ext x
    rw [algebraContragredient_smul_apply]
    simpa only [α.apply_symm_apply] using (h (α.symm x)).symm

/-- The inverse-dual action of every time of an annihilated generator fixes
the continuous functional viewed in the algebraic dual. -/
theorem flowAlgEquiv_smul_functional
    (ω : A →L[ℝ] ℝ) (D : A →L[ℝ] A)
    (hD : IsDerivation (ContinuousLinearMap.mul ℝ A) D)
    (hω : ω.comp D = 0) (t : ℝ) :
    flowAlgEquiv D hD t • ω.toLinearMap = ω.toLinearMap := by
  ext x
  rw [algebraContragredient_smul_apply, flowAlgEquiv_symm_apply]
  exact functional_flow_eq_self ω D hω (-t) x

variable {ι : Type*} (D : ι → A →L[ℝ] A)
  (hD : ∀ i, IsDerivation (ContinuousLinearMap.mul ℝ A) (D i))

/-- Every element of the generated group fixes an annihilating functional. -/
theorem flowGroup_le_functionalStabilizer (ω : A →L[ℝ] ℝ)
    (hω : ∀ i, ω.comp (D i) = 0) :
    flowGroup D hD ≤ MulAction.stabilizer (A ≃ₐ[ℝ] A) ω.toLinearMap := by
  apply (Subgroup.closure_le _).mpr
  rintro α ⟨⟨i, t⟩, rfl⟩
  exact flowAlgEquiv_smul_functional ω (D i) (hD i) (hω i) t

theorem functional_mem_fixedPoints_flowGroup (ω : A →L[ℝ] ℝ)
    (hω : ∀ i, ω.comp (D i) = 0) :
    ω.toLinearMap ∈ MulAction.fixedPoints (flowGroup D hD) (Module.Dual ℝ A) := by
  intro α
  exact flowGroup_le_functionalStabilizer D hD ω hω α.property

/-- The bounded-flow symmetry closure for algebraic dual data, with the
specified inverse-dual action. -/
def functionalFlowSymmetryClosure : Subgroup (A ≃ₐ[ℝ] A) :=
  flowSymmetryClosure D hD (Module.Dual ℝ A)

theorem flowGroup_le_functionalFlowSymmetryClosure :
    flowGroup D hD ≤ functionalFlowSymmetryClosure D hD :=
  flowGroup_le_flowSymmetryClosure D hD (Module.Dual ℝ A)

/-- The same functional remains fixed after the invariant-data closure. -/
theorem functional_mem_fixedPoints_functionalFlowSymmetryClosure
    (ω : A →L[ℝ] ℝ) (hω : ∀ i, ω.comp (D i) = 0) :
    ω.toLinearMap ∈
      MulAction.fixedPoints (functionalFlowSymmetryClosure D hD) (Module.Dual ℝ A) := by
  change ω.toLinearMap ∈
    MulAction.fixedPoints (flowSymmetryClosure D hD (Module.Dual ℝ A)) (Module.Dual ℝ A)
  rw [fixedPoints_flowSymmetryClosure]
  exact functional_mem_fixedPoints_flowGroup D hD ω hω

/-- Direct evaluation form of functional preservation by the symmetry closure. -/
theorem functional_closure_eq_self (ω : A →L[ℝ] ℝ)
    (hω : ∀ i, ω.comp (D i) = 0)
    (α : functionalFlowSymmetryClosure D hD) (x : A) :
    ω ((α : A ≃ₐ[ℝ] A) x) = ω x := by
  have hfix : (α : A ≃ₐ[ℝ] A) • ω.toLinearMap = ω.toLinearMap :=
    functional_mem_fixedPoints_functionalFlowSymmetryClosure D hD ω hω α
  exact (algebraContragredient_fixed_iff (α : A ≃ₐ[ℝ] A) ω.toLinearMap).mp hfix x

/-- Forgetting continuity embeds each bounded generator into the existing
algebraic derivation carrier, retaining its actual multiplication. -/
def generatorDerivation (i : ι) : derivations ℝ A :=
  ⟨(D i).toLinearMap, fun x y => hD i x y⟩

/-- The Lie algebra generated by closure-conjugates of the bounded generators
annihilates the original continuous functional. -/
theorem conjugationLieSpan_le_annihilatingDerivations
    (ω : A →L[ℝ] ℝ) (hω : ∀ i, ω.comp (D i) = 0) :
    InfoGeometry.Algebra.DerivationSymmetry.conjugationLieSpan
        (functionalFlowSymmetryClosure D hD) (Set.range (generatorDerivation D hD)) ≤
      InfoGeometry.Algebra.DerivationSymmetry.annihilatingDerivations ω.toLinearMap := by
  apply InfoGeometry.Algebra.DerivationSymmetry.conjugationLieSpan_le_annihilatingDerivations
  · intro α x
    exact functional_closure_eq_self D hD ω hω α x
  · rintro E ⟨i, rfl⟩
    intro x
    exact congrArg (fun f : A →L[ℝ] ℝ => f x) (hω i)

end FunctionalAction

section ClosureDualLift

open InfoGeometry.Clifford.NeutralPhaseSpaceCore
open InfoGeometry.Clifford.NeutralPhaseSpaceSymmetry

variable {ι : Type*}
  (D : ι → A →L[ℝ] A)
  (hD : ∀ i, IsDerivation (ContinuousLinearMap.mul ℝ A) (D i))
  (T : Type*) [MulAction (A ≃ₐ[ℝ] A) T]

/-- Subgroup inclusion, forgetting multiplication, and the inverse-dual lift
compose to a native representation of the actual symmetry closure. -/
def closureDualLiftHom : flowSymmetryClosure D hD T →*
    (PhaseSpaceCarrier A ≃ₗ[ℝ] PhaseSpaceCarrier A) :=
  (dualLiftHom (E := A)).comp
    ((algEquivToLinearEquivHom (A := A)).comp (flowSymmetryClosure D hD T).subtype)

@[simp] theorem closureDualLiftHom_apply (α : flowSymmetryClosure D hD T) :
    closureDualLiftHom D hD T α = dualLift (α : A ≃ₐ[ℝ] A).toLinearEquiv := rfl

/-- The phase-space representation does not identify distinct closure symmetries. -/
theorem closureDualLiftHom_injective : Function.Injective (closureDualLiftHom D hD T) := by
  intro α β h
  apply Subtype.ext
  apply AlgEquiv.toLinearEquiv_injective
  apply dualLift_injective
  exact h

theorem closureDualLift_preserves_neutralBilin (α : flowSymmetryClosure D hD T)
    (X Y : PhaseSpaceCarrier A) :
    canonicalNeutralBilin (closureDualLiftHom D hD T α X) (closureDualLiftHom D hD T α Y) =
      canonicalNeutralBilin X Y :=
  dualLift_preserves_neutralBilin (α : A ≃ₐ[ℝ] A).toLinearEquiv X Y

theorem closureDualLift_preserves_omega (α : flowSymmetryClosure D hD T)
    (X Y : PhaseSpaceCarrier A) :
    neutralOmega (closureDualLiftHom D hD T α X) (closureDualLiftHom D hD T α Y) =
      neutralOmega X Y :=
  dualLift_preserves_omega (α : A ≃ₐ[ℝ] A).toLinearEquiv X Y

theorem closureDualLift_commutes_grading (α : flowSymmetryClosure D hD T)
    (X : PhaseSpaceCarrier A) :
    closureDualLiftHom D hD T α (neutralParaInvolution X) =
      neutralParaInvolution (closureDualLiftHom D hD T α X) :=
  dualLift_commutes_grading (α : A ≃ₐ[ℝ] A).toLinearEquiv X

/-- Inclusion of an original flow generator agrees with its existing linear
flow followed by the inverse-dual lift. -/
theorem closureDualLiftHom_flow (i : ι) (t : ℝ) :
    closureDualLiftHom D hD T
        ⟨flowAlgEquiv (D i) (hD i) t,
          flowGroup_le_flowSymmetryClosure D hD T (flowAlgEquiv_mem_flowGroup D hD i t)⟩ =
      dualLift (flowLinearEquiv (D i) t) := rfl

end ClosureDualLift

end InfoGeometry.Erlangen.OperatorFlowClosure

end
