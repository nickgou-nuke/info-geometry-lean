import InfoGeometry.Clifford.Cl55VacuumIdealSpinorBridge
import InfoGeometry.Clifford.Cl55CARSpinAutomorphism
import InfoGeometry.Clifford.Cl55CARExteriorCalibration
import InfoGeometry.Algebra.IdempotentCornerCommutant
import Mathlib.LinearAlgebra.Dimension.Finrank

/-!
# Cl(5,5) vacuum idempotent ideal

This module is a compatibility layer over the owner implementation in
`Cl55VacuumIdealSpinorBridge`.  In particular, the idempotent is the
rank-one coordinate projection transported through the faithful Fock and
Cl(5,5) equivalences.  We do not identify it with a product of CAR number
operators without a proved generator-level comparison.
-/

noncomputable section

namespace InfoGeometry.Clifford.Cl55VacuumIdempotentIdeal

open InfoGeometry.Clifford.Clifford55
open InfoGeometry.Clifford.Cl55VacuumIdealSpinorBridge
open InfoGeometry.Clifford.Cl55FockMatrixIntertwiner
open InfoGeometry.Clifford.Cl55NeutralHyperbolicIsometry
open InfoGeometry.Clifford.Cl55CARExteriorCalibration
open InfoGeometry.Clifford.SplitClifford55ExteriorSpinor
open InfoGeometry.Algebra.IdempotentCornerCommutant

/-! The reference rank-one vacuum idempotent from the Fock-coordinate owner. -/
abbrev vacuumIdempotent : Clifford55.Cl55 := cl55VacuumIdempotent

/-- Idempotency is inherited from the owner rank-one projection. -/
theorem vacuumIdempotent_idem :
    vacuumIdempotent * vacuumIdempotent = vacuumIdempotent :=
  cl55VacuumIdempotent_idempotent

/-- The coordinate projection is nonzero, hence so is its transport to Cl(5,5). -/
theorem vacuumIdempotent_ne_zero : vacuumIdempotent ≠ 0 := by
  intro h
  have hneutral := congrArg
    Cl55NeutralHyperbolicIsometry.neutralCliffordAlgEquiv.symm h
  have hproj := congrArg neutralCliffordFockAlgEquiv hneutral
  have hcoord : vacuumProjection = 0 := by
    simpa [vacuumIdempotent, cl55VacuumIdempotent,
      neutralVacuumIdempotent] using hproj
  have hvac : vacuumCoordinate ≠ 0 := by
    intro hz
    have hzero := congrArg (fun f : CoordSpinor => f 0) hz
    norm_num [vacuumCoordinate] at hzero
  apply hvac
  have h := congrArg (fun T : Module.End ℝ CoordSpinor => T vacuumCoordinate) hcoord
  simpa only [vacuumProjection_vacuum, LinearMap.zero_apply] using h

/-- The concrete principal left ideal generated by the vacuum idempotent. -/
abbrev MinimalLeftIdeal : Submodule ℝ Clifford55.Cl55 := cl55VacuumIdeal

/-- The left ideal has the dimension of the exterior spinor. -/
theorem minimalLeftIdeal_finrank : Module.finrank ℝ MinimalLeftIdeal = 32 := by
  exact cl55VacuumIdeal_finrank

/-- The vacuum ideal is identified with the native 32-dimensional exterior
spinor by the owner's explicit representation equivalence. -/
noncomputable abbrev vacuumIdempotentIdealEquiv :
    MinimalLeftIdeal ≃ₗ[ℝ]
      InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.Spinor :=
  cl55VacuumIdealSpinorEquiv

/-- In any associative ring, the commutator with an element commuting with
`e` preserves the principal left ideal `{x | x * e = x}`. -/
theorem commutator_mem_rightFixed {A : Type*} [Ring A]
    (N e x : A) (hNe : N * e = e * N) (hx : x * e = x) :
    (N * x - x * N) * e = N * x - x * N := by
  calc
    (N * x - x * N) * e = N * (x * e) - x * (N * e) := by noncomm_ring
    _ = N * x - x * (e * N) := by rw [hx, hNe]
    _ = N * x - (x * e) * N := by congr 1; noncomm_ring
    _ = N * x - x * N := by rw [hx]

theorem wedge_smul (r : ℝ) (v : InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.V5) :
    wedge (r • v) = r • wedge v := by
  ext ψ
  simp [wedge]

theorem contract_smul (r : ℝ)
    (φ : Module.Dual ℝ InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.V5) :
    contract (r • φ) = r • contract φ := by
  exact (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm ℝ InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.V5))).map_smul r φ

theorem wedge_zero : wedge (0 : InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.V5) = 0 := by
  ext ψ
  simp [wedge]

theorem contract_zero :
    contract (0 : Module.Dual ℝ InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.V5) = 0 := by
  ext ψ
  simp [contract]

theorem annihilation55_normalization (i : Fin 5) :
    (1 / 2 : ℝ) •
      (wedge ((2 : ℝ) • basisVector i) +
        contract (0 : Module.Dual ℝ InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.V5)) = wedge (basisVector i) := by
  rw [wedge_smul (2 : ℝ) (basisVector i), contract_zero, add_zero]
  norm_num [smul_smul]

theorem creation55_normalization (i : Fin 5) :
    (1 / 2 : ℝ) •
      (wedge (0 : InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.V5) + contract ((2 : ℝ) • dualBasisVector i)) =
        contract (dualBasisVector i) := by
  rw [wedge_zero, contract_smul (2 : ℝ) (dualBasisVector i), zero_add]
  norm_num [smul_smul]

theorem annihilation55_spinor (i : Fin 5) :
    neutralCliffordRep (neutralCliffordAlgEquiv.symm (annihilation55 i)) =
      wedge (basisVector i) := by
  simp only [annihilation55, map_smul, neutralCliffordAlgEquiv_symm_ι55,
    neutralCliffordRep_ι, neutralToV55_symm_nPair]
  simp only [neutralAction]
  simpa only [two_smul] using annihilation55_normalization i

theorem creation55_spinor (i : Fin 5) :
    neutralCliffordRep (neutralCliffordAlgEquiv.symm (creation55 i)) =
      contract (dualBasisVector i) := by
  simp only [creation55, map_smul, neutralCliffordAlgEquiv_symm_ι55,
    neutralCliffordRep_ι, neutralToV55_symm_nbarPair]
  simp only [neutralAction]
  simpa only [two_smul] using creation55_normalization i

/-- The actual Cl(5,5) left-ideal action of the positive-null CAR generator,
transported to the exterior spinor, is wedge multiplication. -/
theorem vacuumIdeal_annihilation55_action
    (i : Fin 5) (x : MinimalLeftIdeal) :
    cl55VacuumIdealSpinorEquiv
        (cl55VacuumIdealLeftAction (annihilation55 i) x) =
      wedge (basisVector i) (cl55VacuumIdealSpinorEquiv x) := by
  calc
    cl55VacuumIdealSpinorEquiv
        (cl55VacuumIdealLeftAction (annihilation55 i) x) =
      neutralCliffordRep (neutralCliffordAlgEquiv.symm (annihilation55 i))
        (cl55VacuumIdealSpinorEquiv x) :=
          cl55VacuumIdealLeftAction_intertwines (annihilation55 i) x
    _ = wedge (basisVector i) (cl55VacuumIdealSpinorEquiv x) := by
      rw [annihilation55_spinor]

/-- The actual Cl(5,5) left-ideal action of the negative-null CAR generator,
transported to the exterior spinor, is interior contraction. -/
theorem vacuumIdeal_creation55_action
    (i : Fin 5) (x : MinimalLeftIdeal) :
    cl55VacuumIdealSpinorEquiv
        (cl55VacuumIdealLeftAction (creation55 i) x) =
      contract (dualBasisVector i) (cl55VacuumIdealSpinorEquiv x) := by
  calc
    cl55VacuumIdealSpinorEquiv
        (cl55VacuumIdealLeftAction (creation55 i) x) =
      neutralCliffordRep (neutralCliffordAlgEquiv.symm (creation55 i))
        (cl55VacuumIdealSpinorEquiv x) :=
          cl55VacuumIdealLeftAction_intertwines (creation55 i) x
    _ = contract (dualBasisVector i) (cl55VacuumIdealSpinorEquiv x) := by
      rw [creation55_spinor]

/-- The CAR mixed anticommutator acts on the actual Cl(5,5) vacuum ideal as
the Kronecker scalar.  This is the ideal-level operator relation, obtained
from the Clifford algebra relation rather than from coordinate matrices. -/
theorem vacuumIdeal_CAR_mixed_anticommutator (i j : Fin 5) :
    cl55VacuumIdealLeftAction (annihilation55 i) *
        cl55VacuumIdealLeftAction (creation55 j) +
      cl55VacuumIdealLeftAction (creation55 j) *
        cl55VacuumIdealLeftAction (annihilation55 i) =
      (if i = j then (1 : ℝ) else 0) •
        (1 : Module.End ℝ MinimalLeftIdeal) := by
  ext x
  change annihilation55 i * (creation55 j * x.1) +
      creation55 j * (annihilation55 i * x.1) =
    (if i = j then (1 : ℝ) else 0) • x.1
  calc
    annihilation55 i * (creation55 j * x.1) +
        creation55 j * (annihilation55 i * x.1) =
      (annihilation55 i * creation55 j +
        creation55 j * annihilation55 i) * x.1 := by noncomm_ring
    _ = (if i = j then (1 : ℝ) else 0) • x.1 := by
      rw [annihilation55_creation55_anticommutator_eq]
      simp

/-- The annihilation generators anticommute on the actual Cl(5,5) vacuum
ideal. -/
theorem vacuumIdeal_CAR_annihilation_anticommutator (i j : Fin 5) :
    cl55VacuumIdealLeftAction (annihilation55 i) *
        cl55VacuumIdealLeftAction (annihilation55 j) +
      cl55VacuumIdealLeftAction (annihilation55 j) *
        cl55VacuumIdealLeftAction (annihilation55 i) = 0 := by
  ext x
  change annihilation55 i * (annihilation55 j * x.1) +
      annihilation55 j * (annihilation55 i * x.1) = 0
  calc
    annihilation55 i * (annihilation55 j * x.1) +
        annihilation55 j * (annihilation55 i * x.1) =
      (annihilation55 i * annihilation55 j +
        annihilation55 j * annihilation55 i) * x.1 := by noncomm_ring
    _ = 0 := by rw [annihilation55_anticommutator]; simp

/-- The creation generators anticommute on the actual Cl(5,5) vacuum
ideal. -/
theorem vacuumIdeal_CAR_creation_anticommutator (i j : Fin 5) :
    cl55VacuumIdealLeftAction (creation55 i) *
        cl55VacuumIdealLeftAction (creation55 j) +
      cl55VacuumIdealLeftAction (creation55 j) *
        cl55VacuumIdealLeftAction (creation55 i) = 0 := by
  ext x
  change creation55 i * (creation55 j * x.1) +
      creation55 j * (creation55 i * x.1) = 0
  calc
    creation55 i * (creation55 j * x.1) +
        creation55 j * (creation55 i * x.1) =
      (creation55 i * creation55 j +
        creation55 j * creation55 i) * x.1 := by noncomm_ring
    _ = 0 := by rw [creation55_anticommutator]; simp

/-- The scalar exterior spinor, transported into the concrete principal ideal,
is fixed by each vacuum-mode projection.  The order is contraction after
wedge because the concrete `annihilation55` generator acts by wedge and
`creation55` acts by contraction. -/
noncomputable def scalarVacuumState : MinimalLeftIdeal :=
  cl55VacuumIdealSpinorEquiv.symm 1

def vacuumIdealModeProjector (i : Fin 5) : Module.End ℝ MinimalLeftIdeal :=
  cl55VacuumIdealLeftAction (creation55 i) *
    cl55VacuumIdealLeftAction (annihilation55 i)

theorem scalarVacuumState_readout :
    cl55VacuumIdealSpinorEquiv scalarVacuumState = (1 : Spinor) :=
  cl55VacuumIdealSpinorEquiv.apply_symm_apply 1

theorem vacuumIdeal_modeProjector_fixes_scalar (i : Fin 5) :
    vacuumIdealModeProjector i scalarVacuumState = scalarVacuumState := by
  change (cl55VacuumIdealLeftAction (creation55 i) *
      cl55VacuumIdealLeftAction (annihilation55 i)) scalarVacuumState = _
  apply cl55VacuumIdealSpinorEquiv.injective
  rw [Module.End.mul_apply, vacuumIdeal_creation55_action,
    vacuumIdeal_annihilation55_action, scalarVacuumState_readout,
    SplitClifford55ExteriorSpinor.wedge_apply, mul_one]
  simp [SplitClifford55ExteriorSpinor.contract,
    SplitClifford55ExteriorSpinor.dualBasisVector,
    SplitClifford55ExteriorSpinor.basisVector]

/-- Ordered five-mode product.  Endomorphism multiplication is noncommutative,
so this is deliberately a product in `Fin` order rather than a `Finset` product. -/
def vacuumIdealModeProjectorProduct : Module.End ℝ MinimalLeftIdeal :=
  vacuumIdealModeProjector 0 * vacuumIdealModeProjector 1 *
    vacuumIdealModeProjector 2 * vacuumIdealModeProjector 3 *
    vacuumIdealModeProjector 4

/-- The product of the five concrete CAR vacuum-mode projections fixes the
scalar exterior vacuum.  This identifies the action on that vector without
identifying the owner's independently indexed coordinate-zero idempotent. -/
theorem vacuumIdeal_modeProjector_product_fixes_scalar :
    vacuumIdealModeProjectorProduct scalarVacuumState = scalarVacuumState := by
  change vacuumIdealModeProjector 0
      (vacuumIdealModeProjector 1
        (vacuumIdealModeProjector 2
          (vacuumIdealModeProjector 3
            (vacuumIdealModeProjector 4 scalarVacuumState)))) = _
  simp only [vacuumIdeal_modeProjector_fixes_scalar]

noncomputable def cl55SpinorRep : Clifford55.Cl55 →ₐ[ℝ] SpinorEnd :=
  neutralCliffordRep.comp neutralCliffordAlgEquiv.symm.toAlgHom

noncomputable def numberSpinor : SpinorEnd :=
  cl55SpinorRep numberOperator55

theorem numberSpinor_commutator_wedge (i : Fin 5) :
    numberSpinor * wedge (basisVector i) -
        wedge (basisVector i) * numberSpinor = -(wedge (basisVector i)) := by
  have h := congrArg cl55SpinorRep (numberOperator55_commutator_annihilation i)
  simpa [numberSpinor, cl55SpinorRep, annihilation55_spinor] using h

theorem contract_basis_generator (i : Fin 5) :
    contract (dualBasisVector i)
      (ExteriorAlgebra.ι ℝ (basisVector i)) = 1 := by
  simp [contract, dualBasisVector, basisVector]

theorem numberSpinor_one : numberSpinor (1 : Spinor) = (5 : ℝ) • 1 := by
  calc
    numberSpinor 1 =
        ∑ i : Fin 5, contract (dualBasisVector i)
          (ExteriorAlgebra.ι ℝ (basisVector i)) := by
      simp [numberSpinor, cl55SpinorRep, numberOperator55,
        creation55_spinor, annihilation55_spinor, wedge]
    _ = (5 : ℝ) • 1 := by
      norm_num [contract_basis_generator, Algebra.smul_def]
      exact (map_ofNat (algebraMap ℝ Spinor) 5).symm

theorem numberSpinor_wedge (i : Fin 5) (x : Spinor) :
    numberSpinor (wedge (basisVector i) x) =
      wedge (basisVector i) (numberSpinor x) - wedge (basisVector i) x := by
  have h := congrArg (fun T : SpinorEnd => T x)
    (numberSpinor_commutator_wedge i)
  change numberSpinor (wedge (basisVector i) x) -
      wedge (basisVector i) (numberSpinor x) = -(wedge (basisVector i) x) at h
  calc
    numberSpinor (wedge (basisVector i) x) =
        (numberSpinor (wedge (basisVector i) x) -
          wedge (basisVector i) (numberSpinor x)) +
          wedge (basisVector i) (numberSpinor x) := by abel
    _ = -(wedge (basisVector i) x) +
        wedge (basisVector i) (numberSpinor x) := by rw [h]
    _ = wedge (basisVector i) (numberSpinor x) -
        wedge (basisVector i) x := by abel

theorem numberSpinor_ιMulti_basis (n : ℕ) (v : Fin n → Fin 5)
    (hn : n ≤ 5) :
    numberSpinor (ExteriorAlgebra.ιMulti ℝ n (basisVector ∘ v)) =
      ((5 - n : ℕ) : ℝ) • ExteriorAlgebra.ιMulti ℝ n (basisVector ∘ v) := by
  induction n with
  | zero =>
      simpa using numberSpinor_one
  | succ n ih =>
      have hn' : n ≤ 5 := by omega
      have hsub : ((5 - (n + 1) : ℕ) : ℝ) =
          ((5 - n : ℕ) : ℝ) - 1 := by
        rw [Nat.cast_sub (by omega : n + 1 ≤ 5),
          Nat.cast_sub (by omega : n ≤ 5)]
        push_cast
        ring
      rw [ExteriorAlgebra.ιMulti_succ_apply]
      change numberSpinor
          (wedge (basisVector (v 0))
            (ExteriorAlgebra.ιMulti ℝ n (Matrix.vecTail (basisVector ∘ v)))) =
        ((5 - (n + 1) : ℕ) : ℝ) •
          wedge (basisVector (v 0))
            (ExteriorAlgebra.ιMulti ℝ n (Matrix.vecTail (basisVector ∘ v)))
      have htail : Matrix.vecTail (basisVector ∘ v) =
          basisVector ∘ (fun j : Fin n => v j.succ) := by
        funext j
        rfl
      rw [numberSpinor_wedge, htail, ih (fun j => v j.succ) hn']
      rw [map_smul, hsub]
      module

theorem sigma_basis_eq_exteriorAlgebra
    (a : Σ k : ℕ, Set.powersetCard (Fin 5) k) :
    InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.exteriorAlgebraBasisSigma a =
      InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.vBasis.ExteriorAlgebra a.2 := by
  simpa [InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.exteriorAlgebraBasisSigma,
    InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.degreeBasis] using
    (ExteriorAlgebra.basis_eq_coe_basis
      (b := InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.vBasis)
      (s := a.2)).symm

theorem numberSpinor_exteriorBasisSigma
    (a : Σ k : ℕ, Set.powersetCard (Fin 5) k) :
    numberSpinor
        (InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.exteriorAlgebraBasisSigma a) =
      ((5 - a.1 : ℕ) : ℝ) •
        InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.exteriorAlgebraBasisSigma a := by
  rw [sigma_basis_eq_exteriorAlgebra, ExteriorAlgebra.basis_apply_powersetCard]
  have hcard : a.2.1.card = a.1 := by
    simpa [Set.powersetCard.mem_iff] using a.2.2
  have hle : a.1 ≤ 5 := by
    rw [← hcard]
    exact Finset.card_le_univ _
  let f : Fin a.1 → Fin 5 := Set.powersetCard.ofFinEmbEquiv.symm a.2
  have hvec : basisVector ∘ f =
      InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.vBasis ∘ f := by
    funext j
    simp [basisVector, InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.vBasis,
      Pi.basisFun_apply]
  have hword := numberSpinor_ιMulti_basis a.1 f hle
  rw [hvec] at hword
  simpa [ExteriorAlgebra.ιMulti_family,
    InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.vBasis, f] using hword

noncomputable def numberCoord : Module.End ℝ (Fin 32 → ℝ) :=
  InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.neutralCliffordRepCoordinate
    (neutralCliffordAlgEquiv.symm numberOperator55)

theorem numberCoord_intertwines (ψ : Spinor) :
    numberCoord (spinorCoordinateEquiv ψ) = spinorCoordinateEquiv (numberSpinor ψ) := by
  simpa [numberCoord, numberSpinor, cl55SpinorRep] using
    (InfoGeometry.Clifford.Cl55FockMatrixIntertwiner.spinorCoordinateEquiv_intertwines
      (neutralCliffordAlgEquiv.symm numberOperator55) ψ).symm

theorem spinorCoordinate_basis (i : Fin 32) :
    spinorCoordinateEquiv
        (InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.exteriorAlgebraBasisSigma
          (InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.exteriorIndexEquivFin.symm i)) =
      Pi.single i 1 := by
  rw [spinorCoordinateEquiv]
  let b := InfoGeometry.Clifford.SplitClifford55ExteriorDegrees.exteriorAlgebraBasisSigma
  change (b.reindex
      InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.exteriorIndexEquivFin).equivFun
    (b (InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.exteriorIndexEquivFin.symm i)) = _
  rw [← b.reindex_apply
    InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.exteriorIndexEquivFin i]
  ext j
  rw [Module.Basis.equivFun_self]
  simp [Pi.single_apply, eq_comm]

noncomputable def numberCoordEigenvalue (i : Fin 32) : ℝ :=
  ((5 - (InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.exteriorIndexEquivFin.symm i).1 : ℕ) : ℝ)

theorem numberCoord_single (i : Fin 32) :
    numberCoord (Pi.single i 1) = numberCoordEigenvalue i • Pi.single i 1 := by
  rw [← spinorCoordinate_basis i, numberCoord_intertwines,
    numberSpinor_exteriorBasisSigma]
  simp [numberCoordEigenvalue, spinorCoordinate_basis]

theorem numberCoord_zero_readout (x : Fin 32 → ℝ) :
    numberCoord x 0 = numberCoordEigenvalue 0 * x 0 := by
  have hx : x = ∑ j : Fin 32, x j • Pi.single j 1 := by
    simpa [Pi.basisFun_equivFun, Pi.basisFun_apply] using
      ((Pi.basisFun ℝ (Fin 32)).sum_equivFun x).symm
  rw [hx, map_sum]
  simp_rw [map_smul, numberCoord_single]
  simp [numberCoordEigenvalue, Pi.single_apply, eq_comm]
  ring_nf

theorem numberCoord_vacuumProjection (x : Fin 32 → ℝ) :
    numberCoord (vacuumProjection x) = vacuumProjection (numberCoord x) := by
  ext i
  by_cases hi : i = 0
  · subst i
    rw [vacuumProjection_apply, map_smul, vacuumCoordinate, numberCoord_single,
      vacuumProjection_apply, numberCoord_zero_readout]
    simp [vacuumCoordinate, Pi.single_apply]
    ring_nf
  · rw [vacuumProjection_apply, map_smul, vacuumCoordinate, numberCoord_single,
      vacuumProjection_apply]
    simp [vacuumCoordinate, Pi.single_apply, hi]

theorem numberOperator55_commutes_vacuumIdempotent :
    numberOperator55 * vacuumIdempotent = vacuumIdempotent * numberOperator55 := by
  have h₁ : (numberCoord : Module.End ℝ CoordSpinor) * vacuumProjection = vacuumProjection * (numberCoord : Module.End ℝ CoordSpinor) := by
    apply LinearMap.ext
    intro x
    exact numberCoord_vacuumProjection x

  have h₂ : numberOperator55 * vacuumIdempotent = vacuumIdempotent * numberOperator55 := by
    apply neutralCliffordAlgEquiv.symm.injective
    rw [map_mul, map_mul]
    simp only [vacuumIdempotent, cl55VacuumIdempotent,
      neutralCliffordAlgEquiv.symm_apply_apply]
    apply neutralCliffordFockAlgEquiv.injective
    rw [map_mul, map_mul]
    -- Prove that numberCoord commutes with vacuumProjection in the Fock space
    have h₁ : (numberCoord : Module.End ℝ CoordSpinor) * vacuumProjection = vacuumProjection * (numberCoord : Module.End ℝ CoordSpinor) := by
      apply LinearMap.ext
      intro x
      exact numberCoord_vacuumProjection x
    simp_all [neutralVacuumIdempotent, neutralCliffordFockAlgEquiv]
    <;>
    (try simp_all [neutralCliffordFockAlgEquiv, neutralVacuumIdempotent]) <;>
    (try aesop)
  exact h₂

/-- The number-operator commutator preserves the vacuum ideal, now using the
proved commutation with the owner's reference coordinate idempotent. -/
theorem numberOperator55_commutator_preserves_vacuumIdeal
    (x : MinimalLeftIdeal) :
    (numberOperator55 * x.1 - x.1 * numberOperator55) ∈ MinimalLeftIdeal := by
  change (numberOperator55 * x.1 - x.1 * numberOperator55) * vacuumIdempotent =
    numberOperator55 * x.1 - x.1 * numberOperator55
  exact commutator_mem_rightFixed numberOperator55 vacuumIdempotent x.1
    numberOperator55_commutes_vacuumIdempotent x.2

/-- The concrete principal right ideal generated by the vacuum idempotent. -/
abbrev MinimalRightIdeal : Submodule ℝ Clifford55.Cl55 :=
  { carrier := {x : Clifford55.Cl55 | vacuumIdempotent * x = x},
    zero_mem' := by simp [vacuumIdempotent],
    add_mem' := by
      intro x y hx hy
      calc
        vacuumIdempotent * (x + y) = vacuumIdempotent * x + vacuumIdempotent * y := by rw [mul_add]
        _ = x + y := by rw [hx, hy]
    smul_mem' := by
      intro r x hx
      calc
        vacuumIdempotent * (r • x) = r • (vacuumIdempotent * x) := by simp
        _ = r • x := by rw [hx] }

/-- Matrix model of `Cl(5,5)` in which the reference idempotent is a
rank-one coordinate projection. -/
noncomputable def cl55MatrixEquiv : Clifford55.Cl55 ≃ₐ[ℝ]
    Matrix (Fin 32) (Fin 32) ℝ :=
  Cl55NeutralHyperbolicIsometry.neutralCliffordAlgEquiv.symm.trans
    neutralCliffordFockMatrixAlgEquiv

/-- Transport matrix transpose back to the Clifford algebra. -/
noncomputable def transposeCl55 : Clifford55.Cl55 →ₗ[ℝ] Clifford55.Cl55 :=
  (cl55MatrixEquiv.toLinearEquiv.symm.toLinearMap).comp
    ((Matrix.transposeLinearEquiv (Fin 32) (Fin 32) ℝ ℝ).toLinearMap.comp
      cl55MatrixEquiv.toLinearEquiv.toLinearMap)

theorem transposeCl55_mul (x y : Clifford55.Cl55) :
    transposeCl55 (x * y) = transposeCl55 y * transposeCl55 x := by
  apply cl55MatrixEquiv.injective
  simp [transposeCl55, cl55MatrixEquiv, Matrix.transpose_mul]

theorem transposeCl55_vacuumIdempotent :
    transposeCl55 vacuumIdempotent = vacuumIdempotent := by
  apply cl55MatrixEquiv.injective
  have hmatrix : cl55MatrixEquiv vacuumIdempotent =
      (LinearMap.toMatrixAlgEquiv (Pi.basisFun ℝ (Fin 32))) vacuumProjection := by
    simp [cl55MatrixEquiv, neutralCliffordFockMatrixAlgEquiv,
      vacuumIdempotent, cl55VacuumIdempotent, neutralVacuumIdempotent]
  have hdiag : (LinearMap.toMatrixAlgEquiv (Pi.basisFun ℝ (Fin 32)))
      vacuumProjection = Matrix.diagonal (fun i : Fin 32 => if i = 0 then (1 : ℝ) else 0) := by
    ext i j
    rw [LinearMap.toMatrixAlgEquiv_apply]
    simp only [Pi.basisFun_repr, Pi.basisFun_apply, vacuumProjection,
      coordinateRankOne, vacuumCoordinate]
    by_cases hj : j = 0
    · subst j
      simp [Matrix.diagonal_apply, Pi.single_apply]
    · have h0j : (0 : Fin 32) ≠ j := fun h => hj h.symm
      simp [h0j, Matrix.diagonal_apply, Pi.single_apply]
      intro hij hi
      exact hj (hij.symm.trans hi)
  have htranspose : (Matrix.transposeLinearEquiv (Fin 32) (Fin 32) ℝ ℝ)
      (cl55MatrixEquiv vacuumIdempotent) = cl55MatrixEquiv vacuumIdempotent := by
    rw [hmatrix, hdiag]
    ext i j
    by_cases hij : i = j
    · subst j
      rfl
    · simp [hij, Ne.symm hij]
  simpa [transposeCl55] using htranspose

/-- Transpose carries the right ideal `eA` to the left ideal `Ae`. -/
noncomputable def rightIdealToLeftIdeal : MinimalRightIdeal ≃ₗ[ℝ] MinimalLeftIdeal where
  toFun x := ⟨transposeCl55 x.1, by
    change transposeCl55 x.1 * vacuumIdempotent = transposeCl55 x.1
    have hx := congrArg transposeCl55 x.2
    rw [transposeCl55_mul, transposeCl55_vacuumIdempotent] at hx
    exact hx
  ⟩
  invFun x := ⟨transposeCl55 x.1, by
    change vacuumIdempotent * transposeCl55 x.1 = transposeCl55 x.1
    have hx := congrArg transposeCl55 x.2
    rw [transposeCl55_mul, transposeCl55_vacuumIdempotent] at hx
    exact hx
  ⟩
  left_inv x := by
    apply Subtype.ext
    apply cl55MatrixEquiv.injective
    simp [transposeCl55, cl55MatrixEquiv, Matrix.transpose_transpose]
  right_inv x := by
    apply Subtype.ext
    apply cl55MatrixEquiv.injective
    simp [transposeCl55, cl55MatrixEquiv, Matrix.transpose_transpose]
  map_add' x y := by simp [transposeCl55]
  map_smul' r x := by simp [transposeCl55]

/-- The right ideal has the dimension of the exterior spinor. -/
theorem minimalRightIdeal_finrank : Module.finrank ℝ MinimalRightIdeal = 32 := by
  rw [rightIdealToLeftIdeal.finrank_eq]
  exact minimalLeftIdeal_finrank

/-- The right vacuum ideal is identified with the native exterior spinor by
transpose followed by the owner's left-ideal equivalence. -/
noncomputable abbrev vacuumIdempotentIdealEquivRight :
    MinimalRightIdeal ≃ₗ[ℝ]
      InfoGeometry.Clifford.SplitClifford55ExteriorSpinor.Spinor :=
  rightIdealToLeftIdeal.trans cl55VacuumIdealSpinorEquiv

end InfoGeometry.Clifford.Cl55VacuumIdempotentIdeal

end noncomputable section
