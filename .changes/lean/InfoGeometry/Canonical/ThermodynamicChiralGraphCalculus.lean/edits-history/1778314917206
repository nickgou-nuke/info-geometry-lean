{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Canonical/ThermodynamicChiralGraphCalculus.lean","time":1778314917206,"baseTime":1778314916528,"changes":[{"range":{"start":{"line":220,"character":0},"end":{"line":236,"character":0}},"text":"  simp only [gaugeShiftedCycleCurvatureLog, cycleCurvatureLog, gaugeBoundaryTerm,\n    gaugeShiftedLogAffinity]\n  induction C.edges with\n  | nil => simp\n  | cons e es ih =>\n      simp [ih]\n      ring_nf\n\n/-- Gauge invariance of cycle curvature on gauge-closed cycles. -/\ntheorem cycleCurvatureLog_gauge_invariant\n    (γ : GaugeTransform V) (C : Cycle E) (hC : G.CycleGaugeClosed C) :\n    G.gaugeShiftedCycleCurvatureLog γ C = G.cycleCurvatureLog C := by\n  rw [G.gaugeShiftedCycleCurvatureLog_eq_add_boundary γ C, hC.boundary_zero γ]\n  ring\n\n/-- If the log-affinity is a pure vertex coboundary, every gauge-closed cycle\nhas zero additive curvature.  This is the conservative Kolmogorov/Polettini\n`exact connection ⇒ trivial cycle affinity` direction. -/\ntheorem cycleCurvatureLog_eq_zero_of_logAffinity_eq_gaugeBoundary\n    (γ : GaugeTransform V) (C : Cycle E)\n    (hC : G.CycleGaugeClosed C)\n    (hexact : ∀ e ∈ C.edges,\n      G.logAffinity e = γ.potential (G.dst e) - γ.potential (G.src e)) :\n    G.cycleCurvatureLog C = 0 := by\n  simp only [cycleCurvatureLog]\n  calc\n    (C.edges.map G.logAffinity).sum =\n        (C.edges.map (fun e => γ.potential (G.dst e) - γ.potential (G.src e))).sum := by\n      congr 1\n      apply List.map_congr_left\n      intro e he\n      exact hexact e he\n    _ = G.gaugeBoundaryTerm γ C := by\n      rfl\n    _ = 0 := hC.boundary_zero γ\n","rangeOffset":8217,"rangeLength":646}]}