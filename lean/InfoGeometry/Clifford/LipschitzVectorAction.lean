import Mathlib.LinearAlgebra.CliffordAlgebra.SpinGroup
import Mathlib.LinearAlgebra.CliffordAlgebra.Equivs
import Mathlib.LinearAlgebra.CliffordAlgebra.EvenEquiv
import Mathlib.Analysis.Complex.Circle
import InfoGeometry.Clifford.RealQuadraticReflection
import InfoGeometry.Clifford.RealQuadraticReflectionCartanDieudonne

/-!
# The Lipschitz action on the Clifford vector carrier

Mathlib's `lipschitzGroup Q` is a subgroup of Clifford units generated by
invertible vectors.  Its native theorem says that grade-twisted conjugation
preserves the range of `CliffordAlgebra.ι Q`.  This file transports that
restricted linear map back to the original module.  Injectivity of `ι` is an
explicit hypothesis, since it is what identifies the module with that range.

The result is a linear equivalence.  Under injectivity of the scalar map into
the Clifford algebra, the transported action also preserves the quadratic form
and therefore has Mathlib's native `Q.IsometryEquiv` interface. Full
surjectivity onto the orthogonal group is established under the explicit finite
orthogonal-spanning hypotheses used by the repository's Cartan--Dieudonné
argument; the Pin action has a separate, more restrictive normalization result.
-/

noncomputable section

namespace InfoGeometry.Clifford.LipschitzVectorAction

open CliffordAlgebra
open Metric
open scoped ComplexConjugate

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
variable (Q : QuadraticForm R M)

/-! ### The low-dimensional compact Spin carriers -/

/-- The negative definite one-dimensional quadratic carrier `Cl(0,1)`. -/
abbrev spinOneQuadratic : QuadraticForm ℝ ℝ := CliffordAlgebraComplex.Q

/-- The two-dimensional negative definite carrier `Cl(0,2)`, formed by
adjoining a second generator of square `-1`. -/
abbrev spinTwoQuadratic : QuadraticForm ℝ (ℝ × ℝ) :=
  CliffordAlgebra.EquivEven.Q' spinOneQuadratic

/-- The three-dimensional negative definite carrier `Cl(0,3)`, formed by
adjoining a third generator of square `-1`. -/
abbrev spinThreeQuadratic : QuadraticForm ℝ ((ℝ × ℝ) × ℝ) :=
  CliffordAlgebra.EquivEven.Q' spinTwoQuadratic

/-- Mathlib's even-equivalence identifies the `Cl(0,2)` even algebra with
`Cl(0,1)`, hence with the complex numbers. -/
noncomputable def spinTwoEvenComplexEquiv :
    CliffordAlgebra.even spinTwoQuadratic ≃ₐ[ℝ] ℂ :=
  (CliffordAlgebra.equivEven spinOneQuadratic).symm.trans
    CliffordAlgebraComplex.equiv

/-- Mathlib's even-equivalence identifies the `Cl(0,3)` even algebra with
`Cl(0,2)`, hence with the quaternion division algebra. -/
lemma spinTwoQuadratic_eq_quaternionQ :
    spinTwoQuadratic = CliffordAlgebraQuaternion.Q (-1 : ℝ) (-1 : ℝ) := by
  ext ⟨x, y⟩
  simp [spinTwoQuadratic, spinOneQuadratic,
    CliffordAlgebraQuaternion.Q_apply]

/-- The identity on the two vector coordinates identifies the quadratic
carrier used for `Cl(0,2)` with the one in Mathlib's quaternion equivalence. -/
def spinTwoQuadraticQuaternionIsometry :
    spinTwoQuadratic.IsometryEquiv
      (CliffordAlgebraQuaternion.Q (-1 : ℝ) (-1 : ℝ)) where
  toLinearEquiv := LinearEquiv.refl ℝ (ℝ × ℝ)
  map_app' v :=
    (congrArg (fun q : QuadraticForm ℝ (ℝ × ℝ) => q v)
      spinTwoQuadratic_eq_quaternionQ).symm

/-- Clifford algebra equivalences induced by quadratic isometries preserve
the Clifford star operation. -/
theorem cliffordEquivOfIsometry_star
    {M₁ M₂ : Type*} [AddCommGroup M₁] [Module ℝ M₁]
    [AddCommGroup M₂] [Module ℝ M₂]
    {Q₁ : QuadraticForm ℝ M₁} {Q₂ : QuadraticForm ℝ M₂}
    (e : Q₁.IsometryEquiv Q₂) (x : CliffordAlgebra Q₁) :
    CliffordAlgebra.equivOfIsometry e (star x) =
      star (CliffordAlgebra.equivOfIsometry e x) := by
  induction x using CliffordAlgebra.induction with
  | algebraMap r => simp
  | ι m => simp [CliffordAlgebra.equivOfIsometry]
  | add x y hx hy => simp only [map_add, star_add, hx, hy]
  | mul x y hx hy => simp only [map_mul, star_mul, hx, hy]

/-- A star-compatible Clifford algebra equivalence from `Cl(0,2)` to the
quaternion algebra. -/
noncomputable def spinTwoQuaternionCliffordEquiv :
    CliffordAlgebra spinTwoQuadratic ≃ₐ[ℝ]
      QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ) :=
  (CliffordAlgebra.equivOfIsometry spinTwoQuadraticQuaternionIsometry).trans
    (CliffordAlgebraQuaternion.equiv
      (R := ℝ) (c₁ := (-1 : ℝ)) (c₂ := (-1 : ℝ)))

@[simp] theorem spinTwoQuaternionCliffordEquiv_ι (x : ℝ × ℝ) :
    spinTwoQuaternionCliffordEquiv (CliffordAlgebra.ι spinTwoQuadratic x) =
      (⟨0, x.1, x.2, 0⟩ : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) := by
  simp [spinTwoQuaternionCliffordEquiv, CliffordAlgebra.equivOfIsometry,
    spinTwoQuadraticQuaternionIsometry, CliffordAlgebraQuaternion.equiv_apply,
    CliffordAlgebraQuaternion.toQuaternion_ι] <;> constructor <;> rfl

theorem spinTwoQuaternionCliffordEquiv_star (x : CliffordAlgebra spinTwoQuadratic) :
    spinTwoQuaternionCliffordEquiv (star x) =
      star (spinTwoQuaternionCliffordEquiv x) := by
  simp only [spinTwoQuaternionCliffordEquiv, AlgEquiv.trans_apply]
  rw [cliffordEquivOfIsometry_star]
  exact CliffordAlgebraQuaternion.toQuaternion_star _

noncomputable def spinThreeEvenQuaternionEquiv :
    CliffordAlgebra.even spinThreeQuadratic ≃ₐ[ℝ]
      QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ) :=
  (CliffordAlgebra.equivEven spinTwoQuadratic).symm.trans
    spinTwoQuaternionCliffordEquiv

/-- Clifford star restricted to the even subalgebra, represented explicitly
because Mathlib does not install a star instance on this subtype. -/
def spinThreeEvenStar
    (x : CliffordAlgebra.even spinThreeQuadratic) :
    CliffordAlgebra.even spinThreeQuadratic := by
  have hxmem : (x : CliffordAlgebra spinThreeQuadratic) ∈
      CliffordAlgebra.evenOdd spinThreeQuadratic 0 := by
    rw [← CliffordAlgebra.even_toSubmodule]
    exact x.property
  refine ⟨star (x : CliffordAlgebra spinThreeQuadratic), ?_⟩
  change star (x : CliffordAlgebra spinThreeQuadratic) ∈
    CliffordAlgebra.evenOdd spinThreeQuadratic 0
  rw [CliffordAlgebra.star_def]
  exact (CliffordAlgebra.reverse_mem_evenOdd_iff
      (Q := spinThreeQuadratic)).mpr
    ((CliffordAlgebra.involute_mem_evenOdd_iff
      (Q := spinThreeQuadratic)).mpr hxmem)

/-- On the even carrier, the `Cl(0,3)⁺ ≃ ℍ` equivalence carries Clifford
star to quaternion conjugation. -/
theorem spinThreeEvenQuaternionEquiv_star
    (x : CliffordAlgebra.even spinThreeQuadratic) :
    spinThreeEvenQuaternionEquiv (spinThreeEvenStar x) =
      star (spinThreeEvenQuaternionEquiv x) := by
  let E := CliffordAlgebra.equivEven spinTwoQuadratic
  let y : CliffordAlgebra spinTwoQuadratic := E.symm x
  have hy : E y = x := by simp [y]
  have hxmem : (x : CliffordAlgebra spinThreeQuadratic) ∈
      CliffordAlgebra.evenOdd spinThreeQuadratic 0 := by
    rw [← CliffordAlgebra.even_toSubmodule]
    exact x.property
  have hstar :
      (E (star y) : CliffordAlgebra spinThreeQuadratic) =
        (spinThreeEvenStar x : CliffordAlgebra spinThreeQuadratic) := by
    change (CliffordAlgebra.toEven spinTwoQuadratic
        (CliffordAlgebra.reverse (CliffordAlgebra.involute y)) :
          CliffordAlgebra spinThreeQuadratic) = _
    rw [CliffordAlgebra.coe_toEven_reverse_involute,
      show (CliffordAlgebra.toEven spinTwoQuadratic y :
        CliffordAlgebra spinThreeQuadratic) =
          (x : CliffordAlgebra spinThreeQuadratic) from congrArg Subtype.val hy]
    change reverse (x : CliffordAlgebra spinThreeQuadratic) =
      star (x : CliffordAlgebra spinThreeQuadratic)
    rw [CliffordAlgebra.star_def,
      CliffordAlgebra.involute_eq_of_mem_even hxmem]
  have hstarSub : E (star y) = spinThreeEvenStar x := Subtype.ext hstar
  have hpre : E.symm (spinThreeEvenStar x) = star y := by
    apply E.injective
    rw [E.apply_symm_apply, hstarSub]
  change spinTwoQuaternionCliffordEquiv (E.symm (spinThreeEvenStar x)) =
    star (spinTwoQuaternionCliffordEquiv (E.symm x))
  rw [hpre]
  exact spinTwoQuaternionCliffordEquiv_star y

/-- Quaternion coordinate of a `Spin(0,3)` element under the even-Clifford
algebra equivalence `Cl(0,3)⁺ ≃ ℍ`. -/
def spinThreeQuaternionCoordinate
    (g : spinGroup spinThreeQuadratic) :
    QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ) :=
  spinThreeEvenQuaternionEquiv
    ⟨(g : CliffordAlgebra spinThreeQuadratic), spinGroup.mem_even g.prop⟩

/-- The quaternion coordinate preserves multiplication. -/
noncomputable def spinThreeQuaternionCoordinateHom :
    spinGroup spinThreeQuadratic →*
      QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ) where
  toFun := spinThreeQuaternionCoordinate
  map_one' := by
    change spinThreeEvenQuaternionEquiv (1 : CliffordAlgebra.even spinThreeQuadratic) = 1
    exact map_one spinThreeEvenQuaternionEquiv
  map_mul' g h := by
    change spinThreeQuaternionCoordinate (g * h) =
      spinThreeQuaternionCoordinate g * spinThreeQuaternionCoordinate h
    dsimp [spinThreeQuaternionCoordinate]
    have hsub :
        (⟨((g : CliffordAlgebra spinThreeQuadratic) *
            (h : CliffordAlgebra spinThreeQuadratic)),
          spinGroup.mem_even (g * h).prop⟩ : CliffordAlgebra.even spinThreeQuadratic) =
        (⟨(g : CliffordAlgebra spinThreeQuadratic), spinGroup.mem_even g.prop⟩ :
          CliffordAlgebra.even spinThreeQuadratic) *
        ⟨(h : CliffordAlgebra spinThreeQuadratic), spinGroup.mem_even h.prop⟩ := by
      apply Subtype.ext
      rfl
    rw [congrArg spinThreeEvenQuaternionEquiv hsub, map_mul]

/-- The quaternion coordinate is faithful: the even-algebra equivalence
separates elements of `Spin(0,3)`. -/
theorem spinThreeQuaternionCoordinateHom_injective :
    Function.Injective spinThreeQuaternionCoordinateHom := by
  intro g h hgh
  have heq :
      (⟨(g : CliffordAlgebra spinThreeQuadratic), spinGroup.mem_even g.prop⟩ :
        CliffordAlgebra.even spinThreeQuadratic) =
      ⟨(h : CliffordAlgebra spinThreeQuadratic), spinGroup.mem_even h.prop⟩ :=
    spinThreeEvenQuaternionEquiv.injective hgh
  have hcl : (g : CliffordAlgebra spinThreeQuadratic) =
      (h : CliffordAlgebra spinThreeQuadratic) :=
    congrArg (fun z : CliffordAlgebra.even spinThreeQuadratic =>
      (z : CliffordAlgebra spinThreeQuadratic)) heq
  exact Subtype.ext hcl

/-- Every `Spin(0,3)` coordinate has unit Clifford-star norm in the
quaternion algebra: quaternion conjugation times the coordinate is one. -/
theorem spinThreeQuaternionCoordinate_star_mul_self
    (g : spinGroup spinThreeQuadratic) :
    star (spinThreeQuaternionCoordinate g) * spinThreeQuaternionCoordinate g = 1 := by
  let x : CliffordAlgebra.even spinThreeQuadratic :=
    ⟨(g : CliffordAlgebra spinThreeQuadratic), spinGroup.mem_even g.prop⟩
  have hstarCoord :
      star (spinThreeQuaternionCoordinate g) =
        spinThreeEvenQuaternionEquiv (spinThreeEvenStar x) := by
    simpa [spinThreeQuaternionCoordinate, x] using
      (spinThreeEvenQuaternionEquiv_star x).symm
  have hprod : spinThreeEvenStar x * x = 1 := by
    apply Subtype.ext
    change star (g : CliffordAlgebra spinThreeQuadratic) *
      (g : CliffordAlgebra spinThreeQuadratic) = 1
    exact spinGroup.coe_star_mul_self g
  calc
    star (spinThreeQuaternionCoordinate g) * spinThreeQuaternionCoordinate g
        = spinThreeEvenQuaternionEquiv (spinThreeEvenStar x * x) := by
            rw [hstarCoord]
            simp [spinThreeQuaternionCoordinate, x]
    _ = 1 := by rw [hprod, map_one]

/-- A unit quaternion is a product of two unit quaternions with vanishing
`imK` coordinate. This factorization is the coordinate input for expressing
every Spin(0,3) quaternion as a product of two negative-unit Clifford vectors. -/
theorem unitQuaternion_factors_with_zero_imK
    (q : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))
    (hq : star q * q = 1) :
    ∃ u v : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ),
      u.imK = 0 ∧ v.imK = 0 ∧ star u * u = 1 ∧
      star v * v = 1 ∧ u * v = q := by
  let noK (a b c : ℝ) : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ) := ⟨a, b, c, 0⟩
  have hnorm : q.re ^ 2 + q.imI ^ 2 + q.imJ ^ 2 + q.imK ^ 2 = 1 := by
    rcases q with ⟨a, b, c, d⟩
    have hr := congrArg QuaternionAlgebra.re hq
    simp only [QuaternionAlgebra.star_mk, QuaternionAlgebra.mk_mul_mk,
      QuaternionAlgebra.re_one] at hr
    nlinarith
  let s : ℝ := q.imJ ^ 2 + q.imK ^ 2
  let r : ℝ := Real.sqrt s
  let u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ) :=
    if hs : s = 0 then noK 1 0 0
    else noK (q.imJ / r) (q.imK / r) 0
  have hs_nonneg : 0 ≤ s := by positivity
  have hu_imK : u.imK = 0 := by
    simp [u, noK] <;> split_ifs <;> rfl
  have hu_norm : u.re ^ 2 + u.imI ^ 2 + u.imJ ^ 2 = 1 := by
    by_cases hs : s = 0
    · have hj : q.imJ = 0 := by nlinarith [sq_nonneg q.imJ, sq_nonneg q.imK]
      have hk : q.imK = 0 := by nlinarith [sq_nonneg q.imJ, sq_nonneg q.imK]
      simp [u, noK, hs, hj, hk]
    · have hr : r ^ 2 = s := by simpa [r] using Real.sq_sqrt hs_nonneg
      have hrpos : r ≠ 0 := by
        dsimp [r]
        have hspos : 0 < s := lt_of_le_of_ne hs_nonneg (fun h => hs h.symm)
        exact ne_of_gt (Real.sqrt_pos.2 hspos)
      have hfrac : q.imJ ^ 2 / r ^ 2 + q.imK ^ 2 / r ^ 2 = 1 := by
        rw [← add_div, hr]
        exact div_self hs
      simp only [u, noK, dif_neg hs]
      dsimp [r]
      field_simp
      nlinarith [hfrac]
  have hu_star : star u * u = 1 := by
    have h := hu_norm
    have hk := hu_imK
    ext <;> simp [QuaternionAlgebra.star_mk, QuaternionAlgebra.mk_mul_mk,
      h, hk, QuaternionAlgebra.re_one] <;> ring_nf <;> nlinarith
  have hu_right : u * star u = 1 := by
    have h := hu_norm
    have hk := hu_imK
    ext <;> simp [QuaternionAlgebra.star_mk, QuaternionAlgebra.mk_mul_mk,
      h, hk, QuaternionAlgebra.re_one] <;> ring_nf <;> nlinarith
  let v := star u * q
  have hv_imK : v.imK = 0 := by
    rcases q with ⟨a, b, c, d⟩
    by_cases hs : s = 0
    · have hc : c = 0 := by nlinarith [sq_nonneg c, sq_nonneg d]
      have hd : d = 0 := by nlinarith [sq_nonneg c, sq_nonneg d]
      simp [v, u, noK, hs, hc, hd, QuaternionAlgebra.star_mk,
        QuaternionAlgebra.mk_mul_mk]
    · have hr : r ^ 2 = s := by simpa [r] using Real.sq_sqrt hs_nonneg
      have hrpos : r ≠ 0 := by
        dsimp [r]
        have hspos : 0 < s := lt_of_le_of_ne hs_nonneg (fun h => hs h.symm)
        exact ne_of_gt (Real.sqrt_pos.2 hspos)
      simp only [v, u, noK, QuaternionAlgebra.star_mk, QuaternionAlgebra.mk_mul_mk,
        dif_neg hs]
      field_simp
      nlinarith [hr]
  have hv_star : star v * v = 1 := by
    calc
      star v * v = star q * (u * star u) * q := by
        simp [v, star_mul, mul_assoc]
      _ = star q * q := by rw [hu_right]; simp
      _ = 1 := hq
  have huv : u * v = q := by
    dsimp [v]
    rw [← mul_assoc, hu_right, one_mul]
  exact ⟨u, v, hu_imK, hv_imK, hu_star, hv_star, huv⟩

/-- The faithful quaternion coordinate lifts to quaternion units, since the
Spin inverse supplies a two-sided multiplicative inverse. -/
noncomputable def spinThreeQuaternionUnitsHom :
    spinGroup spinThreeQuadratic →*
      (QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))ˣ where
  toFun g :=
    ⟨spinThreeQuaternionCoordinateHom g,
      spinThreeQuaternionCoordinateHom g⁻¹,
      by
        calc
          spinThreeQuaternionCoordinateHom g * spinThreeQuaternionCoordinateHom g⁻¹ =
              spinThreeQuaternionCoordinateHom (g * g⁻¹) := (map_mul _ _ _).symm
          _ = 1 := by simp,
      by
        calc
          spinThreeQuaternionCoordinateHom g⁻¹ * spinThreeQuaternionCoordinateHom g =
              spinThreeQuaternionCoordinateHom (g⁻¹ * g) := (map_mul _ _ _).symm
          _ = 1 := by simp⟩
  map_one' := by
    apply Units.ext
    simp
  map_mul' g h := by
    apply Units.ext
    simp [map_mul]

@[simp] theorem coe_spinThreeQuaternionUnitsHom (g : spinGroup spinThreeQuadratic) :
    (spinThreeQuaternionUnitsHom g :
      QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) =
      spinThreeQuaternionCoordinateHom g := rfl

/-- The homomorphism into quaternion units remains faithful. -/
theorem spinThreeQuaternionUnitsHom_injective :
    Function.Injective spinThreeQuaternionUnitsHom := by
  intro g h hgh
  apply spinThreeQuaternionCoordinateHom_injective
  exact congrArg (fun u : (QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))ˣ =>
    (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))) hgh

/-- Reversion is the identity on the one-generator Clifford algebra `Cl(0,1)`. -/
theorem spinOne_reverse_eq_self (x : CliffordAlgebra spinOneQuadratic) :
    CliffordAlgebra.reverse x = x := by
  change CliffordAlgebra.reverse (Q := CliffordAlgebraComplex.Q) x = x
  exact CliffordAlgebraComplex.reverse_apply x

/-- The complex coordinate of an element of Mathlib's Spin group for the
negative definite two-dimensional quadratic space, using the even-subalgebra
equivalence `Cl(0,2)⁺ ≃ ℂ`. -/
def spinTwoComplexCoordinate (g : spinGroup spinTwoQuadratic) : ℂ :=
  spinTwoEvenComplexEquiv
    ⟨(g : CliffordAlgebra spinTwoQuadratic), spinGroup.mem_even g.prop⟩

/-- The spin relation forces the complex coordinate of a `Cl(0,2)` spinor to
have unit norm. -/
theorem spinTwoComplexCoordinate_norm
    (g : spinGroup spinTwoQuadratic) :
    ‖spinTwoComplexCoordinate g‖ = 1 := by
  have heven := spinGroup.mem_even g.prop
  let x : CliffordAlgebra spinOneQuadratic :=
    (CliffordAlgebra.equivEven spinOneQuadratic).symm
      ⟨(g : CliffordAlgebra spinTwoQuadratic), heven⟩
  have hx : (CliffordAlgebra.equivEven spinOneQuadratic) x =
      ⟨(g : CliffordAlgebra spinTwoQuadratic), heven⟩ := by
    simp [x]
  have hstar : star (g : CliffordAlgebra spinTwoQuadratic) * g = 1 :=
    spinGroup.coe_star_mul_self g
  have hstar' : CliffordAlgebra.reverse (g : CliffordAlgebra spinTwoQuadratic) * g = 1 := by
    rw [CliffordAlgebra.star_def, spinGroup.involute_eq g.prop] at hstar
    exact hstar
  have hxval : (CliffordAlgebra.toEven spinOneQuadratic x :
      CliffordAlgebra (CliffordAlgebra.EquivEven.Q' spinOneQuadratic)) = g := by
    simpa only [CliffordAlgebra.equivEven, AlgEquiv.ofAlgHom_apply] using
      congrArg Subtype.val hx
  have htoEvenStar :=
    CliffordAlgebra.coe_toEven_reverse_involute (Q := spinOneQuadratic) x
  have htoEvenInvolute :
      (CliffordAlgebra.toEven spinOneQuadratic (CliffordAlgebra.involute x) :
        CliffordAlgebra (CliffordAlgebra.EquivEven.Q' spinOneQuadratic)) =
      CliffordAlgebra.reverse
        (CliffordAlgebra.toEven spinOneQuadratic x :
          CliffordAlgebra (CliffordAlgebra.EquivEven.Q' spinOneQuadratic)) := by
    rw [← htoEvenStar, spinOne_reverse_eq_self]
  have hxnorm : CliffordAlgebra.involute x * x = 1 := by
    apply (CliffordAlgebra.equivEven spinOneQuadratic).injective
    rw [CliffordAlgebra.equivEven, AlgEquiv.ofAlgHom_apply]
    simp only [map_one]
    apply Subtype.ext
    change (CliffordAlgebra.toEven spinOneQuadratic
        (CliffordAlgebra.involute x * x) :
          CliffordAlgebra (CliffordAlgebra.EquivEven.Q' spinOneQuadratic)) = 1
    rw [map_mul]
    simp only [Subalgebra.coe_mul]
    rw [htoEvenInvolute, hxval]
    exact hstar'
  have hcoord :
      spinTwoComplexCoordinate g =
        CliffordAlgebraComplex.equiv x := by
    rfl
  have hcoord' : spinTwoComplexCoordinate g =
      CliffordAlgebraComplex.toComplex x := by
    simpa only [CliffordAlgebraComplex.equiv, AlgEquiv.ofAlgHom_apply] using hcoord
  have hconj :
      conj (spinTwoComplexCoordinate g) * spinTwoComplexCoordinate g = 1 := by
    rw [hcoord']
    rw [← CliffordAlgebraComplex.toComplex_involute,
      ← map_mul, hxnorm]
    simp
  have hnorm : ‖spinTwoComplexCoordinate g‖ = 1 := by
    have hnormSq : Complex.normSq (spinTwoComplexCoordinate g) = 1 := by
      apply Complex.ofReal_injective
      rw [Complex.ofReal_one, Complex.normSq_eq_conj_mul_self, hconj]
    have hsq : ‖spinTwoComplexCoordinate g‖ ^ 2 = 1 := by
      rw [← Complex.normSq_eq_norm_sq, hnormSq]
    nlinarith [norm_nonneg (spinTwoComplexCoordinate g)]
  exact hnorm

/-- The complex coordinate map, regarded as a map into the unit circle. -/
def spinTwoComplexCircle (g : spinGroup spinTwoQuadratic) : Circle :=
  ⟨spinTwoComplexCoordinate g,
    mem_sphere_zero_iff_norm.mpr (spinTwoComplexCoordinate_norm g)⟩

@[simp]
theorem coe_spinTwoComplexCircle (g : spinGroup spinTwoQuadratic) :
    (spinTwoComplexCircle g : ℂ) = spinTwoComplexCoordinate g := rfl

/-- The even-algebra complex coordinate defines a group homomorphism from
Mathlib's `Spin(0,2)` group to the circle group. -/
noncomputable def spinTwoComplexCircleHom : spinGroup spinTwoQuadratic →* Circle where
  toFun := spinTwoComplexCircle
  map_one' := by
    apply Circle.ext
    change spinTwoComplexCoordinate (1 : spinGroup spinTwoQuadratic) = 1
    change spinTwoEvenComplexEquiv (1 : CliffordAlgebra.even spinTwoQuadratic) = 1
    exact map_one spinTwoEvenComplexEquiv
  map_mul' g h := by
    apply Circle.ext
    change spinTwoComplexCoordinate (g * h) =
      spinTwoComplexCoordinate g * spinTwoComplexCoordinate h
    dsimp [spinTwoComplexCoordinate]
    have hsub :
        (⟨((g : CliffordAlgebra spinTwoQuadratic) *
            (h : CliffordAlgebra spinTwoQuadratic)),
          spinGroup.mem_even (g * h).prop⟩ : CliffordAlgebra.even spinTwoQuadratic) =
        (⟨(g : CliffordAlgebra spinTwoQuadratic), spinGroup.mem_even g.prop⟩ :
          CliffordAlgebra.even spinTwoQuadratic) *
        ⟨(h : CliffordAlgebra spinTwoQuadratic), spinGroup.mem_even h.prop⟩ := by
      apply Subtype.ext
      rfl
    rw [congrArg spinTwoEvenComplexEquiv hsub, map_mul]

/-- The complex-coordinate homomorphism is injective: the even Clifford
algebra equivalence separates spin elements. -/
theorem spinTwoComplexCircleHom_injective :
    Function.Injective spinTwoComplexCircleHom := by
  intro g h hgh
  have hcoord : spinTwoComplexCoordinate g = spinTwoComplexCoordinate h := by
    have hh := congrArg (fun z : Circle => (z : ℂ)) hgh
    have hh' : (spinTwoComplexCircle g : ℂ) = spinTwoComplexCircle h := by
      simpa [spinTwoComplexCircleHom] using hh
    simpa only [coe_spinTwoComplexCircle] using hh'
  have heq :
      (⟨(g : CliffordAlgebra spinTwoQuadratic), spinGroup.mem_even g.prop⟩ :
        CliffordAlgebra.even spinTwoQuadratic) =
      ⟨(h : CliffordAlgebra spinTwoQuadratic), spinGroup.mem_even h.prop⟩ :=
    spinTwoEvenComplexEquiv.injective hcoord
  have hcl : (g : CliffordAlgebra spinTwoQuadratic) =
      (h : CliffordAlgebra spinTwoQuadratic) :=
    congrArg (fun z : CliffordAlgebra.even spinTwoQuadratic =>
      (z : CliffordAlgebra spinTwoQuadratic)) heq
  exact Subtype.ext hcl

/-- Every element of Mathlib's Lipschitz group is homogeneous for the Clifford
grade involution: it is either even or odd. This follows from the actual
generating set of the group (invertible vectors), not from Pin unitarity. -/
theorem lipschitz_involute_eq_self_or_neg
    {g : (CliffordAlgebra Q)ˣ} (hg : g ∈ lipschitzGroup Q) :
    involute (Q := Q) (↑g : CliffordAlgebra Q) = ↑g ∨
      involute (Q := Q) (↑g : CliffordAlgebra Q) = -↑g := by
  unfold lipschitzGroup at hg
  induction hg using Subgroup.closure_induction'' with
  | mem x hx =>
      obtain ⟨v, hv⟩ := hx
      rw [← hv, involute_ι]
      right
      simp
  | inv_mem x hx =>
      obtain ⟨v, hv⟩ := hx
      let αx : (CliffordAlgebra Q)ˣ :=
        Units.map (involute (Q := Q)).toMonoidHom x
      have hαx : (↑αx : CliffordAlgebra Q) = -↑x := by
        change involute (Q := Q) (↑x : CliffordAlgebra Q) = -↑x
        rw [← hv, involute_ι]
      have hαinv : involute (Q := Q) (↑(x⁻¹) : CliffordAlgebra Q) =
          (↑(αx⁻¹) : CliffordAlgebra Q) := by
        exact (Units.coe_map_inv (involute (Q := Q)).toMonoidHom x).symm
      have hprod : (↑αx : CliffordAlgebra Q) *
          (-↑(x⁻¹) : CliffordAlgebra Q) = 1 := by
        rw [hαx]
        calc
          (-↑x : CliffordAlgebra Q) * (-↑(x⁻¹) : CliffordAlgebra Q) =
              (↑x : CliffordAlgebra Q) * ↑(x⁻¹) := by noncomm_ring
          _ = 1 := by
            simpa using congrArg (fun u : (CliffordAlgebra Q)ˣ =>
              (u : CliffordAlgebra Q)) (mul_inv x)
      right
      change involute (Q := Q) (↑(x⁻¹) : CliffordAlgebra Q) =
        -↑(x⁻¹ : (CliffordAlgebra Q)ˣ)
      rw [hαinv]
      calc
        (↑(αx⁻¹) : CliffordAlgebra Q) =
            (↑(αx⁻¹) : CliffordAlgebra Q) * 1 := by simp
        _ = (↑(αx⁻¹) : CliffordAlgebra Q) *
            ((↑αx : CliffordAlgebra Q) * (-↑(x⁻¹) : CliffordAlgebra Q)) := by
              rw [hprod]
        _ = ((↑(αx⁻¹) : CliffordAlgebra Q) * ↑αx) *
            (-↑(x⁻¹) : CliffordAlgebra Q) := by noncomm_ring
        _ = -↑(x⁻¹ : (CliffordAlgebra Q)ˣ) := by simp
  | one => simp
  | mul x y hx hy ihx ihy =>
      rcases ihx with hx' | hx' <;> rcases ihy with hy' | hy'
      · left
        change involute (Q := Q) ((↑x : CliffordAlgebra Q) * ↑y) = _
        rw [map_mul, hx', hy']
        exact (Units.val_mul x y).symm
      · right
        change involute (Q := Q) ((↑x : CliffordAlgebra Q) * ↑y) =
          -((↑x : CliffordAlgebra Q) * ↑y)
        rw [map_mul, hx', hy']
        simp only [mul_neg]
      · right
        change involute (Q := Q) ((↑x : CliffordAlgebra Q) * ↑y) =
          -((↑x : CliffordAlgebra Q) * ↑y)
        rw [map_mul, hx', hy']
        simp only [neg_mul]
      · left
        change involute (Q := Q) ((↑x : CliffordAlgebra Q) * ↑y) =
          (↑x : CliffordAlgebra Q) * ↑y
        rw [map_mul, hx', hy']
        simp only [neg_mul, mul_neg, neg_neg]

/-- The canonical equivalence from `M` to the range of its Clifford vector map,
under the stated injectivity hypothesis. -/
noncomputable def vectorRangeEquiv (hι : Function.Injective (CliffordAlgebra.ι Q)) :
    M ≃ₗ[R] LinearMap.range (CliffordAlgebra.ι Q) :=
  LinearEquiv.ofInjective (CliffordAlgebra.ι Q) hι

/-- The grade-twisted adjoint restricted to the Clifford vector range. -/
noncomputable def twistedRangeMap
    (g : lipschitzGroup Q) [Invertible (2 : R)] :
    LinearMap.range (CliffordAlgebra.ι Q) →ₗ[R]
      LinearMap.range (CliffordAlgebra.ι Q) :=
  LinearMap.codRestrict (LinearMap.range (CliffordAlgebra.ι Q))
    { toFun := fun x =>
        involute (Q := Q) (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
          (x : CliffordAlgebra Q) *
          (↑((g : (CliffordAlgebra Q)ˣ)⁻¹) : CliffordAlgebra Q)
      map_add' := by
        intro x y
        change _ * ((x : CliffordAlgebra Q) + (y : CliffordAlgebra Q)) * _ = _
        noncomm_ring
      map_smul' := by
        intro r x
        simp only [Algebra.smul_def]
        let a : CliffordAlgebra Q := algebraMap R (CliffordAlgebra Q) r
        let A : CliffordAlgebra Q :=
          involute (Q := Q) (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q)
        let B : CliffordAlgebra Q := ↑((g : (CliffordAlgebra Q)ˣ)⁻¹)
        have hcomm : A * a = a * A :=
          (Algebra.commutes r A).symm
        change A * (a * (x : CliffordAlgebra Q)) * B =
          a * (A * (x : CliffordAlgebra Q) * B)
        calc
          A * (a * (x : CliffordAlgebra Q)) * B = (A * a) * (x : CliffordAlgebra Q) * B := by
            simp only [mul_assoc]
          _ = (a * A) * (x : CliffordAlgebra Q) * B := by rw [hcomm]
          _ = a * (A * (x : CliffordAlgebra Q) * B) := by
            simp only [mul_assoc] }
    (by
      intro x
      rcases x.property with ⟨v, hv⟩
      change involute (Q := Q)
        (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
          (x : CliffordAlgebra Q) *
          (↑((g : (CliffordAlgebra Q)ˣ)⁻¹) : CliffordAlgebra Q) ∈
        LinearMap.range (CliffordAlgebra.ι Q)
      rw [← hv]
      exact lipschitzGroup.involute_act_ι_mem_range_ι g.property v)

/-- The induced linear action on `M`, transported across the injective Clifford
vector map. Its defining equation is the grade-twisted adjoint formula. -/
noncomputable def twistedVectorMap
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (g : lipschitzGroup Q) [Invertible (2 : R)] : M →ₗ[R] M :=
  (vectorRangeEquiv Q hι).symm.toLinearMap.comp
    ((twistedRangeMap Q g).comp (vectorRangeEquiv Q hι).toLinearMap)

@[simp] theorem ι_twistedVectorMap
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (g : lipschitzGroup Q) [Invertible (2 : R)] (v : M) :
    CliffordAlgebra.ι Q (twistedVectorMap Q hι g v) =
      involute (Q := Q) (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
        CliffordAlgebra.ι Q v *
        (↑((g : (CliffordAlgebra Q)ˣ)⁻¹) : CliffordAlgebra Q) := by
  have h := congrArg Subtype.val ((vectorRangeEquiv Q hι).apply_symm_apply
    (twistedRangeMap Q g ((vectorRangeEquiv Q hι) v)))
  simpa [twistedVectorMap, twistedRangeMap, vectorRangeEquiv] using h

/-- The transported action of the inverse Lipschitz unit is inverse on vectors. -/
theorem twistedVectorMap_inv_apply
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (g : lipschitzGroup Q) [Invertible (2 : R)] (v : M) :
    twistedVectorMap Q hι g⁻¹ (twistedVectorMap Q hι g v) = v := by
  apply hι
  rw [ι_twistedVectorMap, ι_twistedVectorMap]
  let u : (CliffordAlgebra Q)ˣ := g
  let αu : (CliffordAlgebra Q)ˣ :=
    Units.map (involute (Q := Q)).toMonoidHom u
  have hαinv : involute (Q := Q) (↑(u⁻¹) : CliffordAlgebra Q) =
      (↑(αu⁻¹) : CliffordAlgebra Q) := by
    exact (Units.coe_map_inv (involute (Q := Q)).toMonoidHom u).symm
  change involute (Q := Q) (↑(u⁻¹) : CliffordAlgebra Q) *
      (involute (Q := Q) (↑u : CliffordAlgebra Q) *
        CliffordAlgebra.ι Q v * (↑u⁻¹ : CliffordAlgebra Q)) *
      (↑u : CliffordAlgebra Q) = CliffordAlgebra.ι Q v
  rw [hαinv]
  change (↑(αu⁻¹) : CliffordAlgebra Q) *
      ((↑αu : CliffordAlgebra Q) * CliffordAlgebra.ι Q v *
        (↑u⁻¹ : CliffordAlgebra Q)) * (↑u : CliffordAlgebra Q) = _
  have hαunit : (↑(αu⁻¹) : CliffordAlgebra Q) * (↑αu : CliffordAlgebra Q) = 1 := by
    exact Units.inv_mul αu
  have hu : (↑(u⁻¹) : CliffordAlgebra Q) * (↑u : CliffordAlgebra Q) = 1 := by
    exact Units.inv_mul u
  calc
    _ = ((↑(αu⁻¹) : CliffordAlgebra Q) * (↑αu : CliffordAlgebra Q)) *
          CliffordAlgebra.ι Q v * ((↑(u⁻¹) : CliffordAlgebra Q) * (↑u : CliffordAlgebra Q)) := by
            noncomm_ring
    _ = 1 * CliffordAlgebra.ι Q v * 1 := by rw [hαunit, hu]
    _ = CliffordAlgebra.ι Q v := by simp

/-- The twisted action of a Lipschitz unit preserves the quadratic form.
The explicit scalar-injectivity hypothesis lets the Clifford square identity
be reflected back from the algebra to `R`. -/
theorem twistedVectorMap_preserves_quadraticForm
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap R (CliffordAlgebra Q)))
    (g : lipschitzGroup Q) [Invertible (2 : R)] (v : M) :
    Q (twistedVectorMap Q hι g v) = Q v := by
  have hgrade := lipschitz_involute_eq_self_or_neg Q g.property
  let u : (CliffordAlgebra Q)ˣ := g
  let a : CliffordAlgebra Q := (u : CliffordAlgebra Q)
  let b : CliffordAlgebra Q := (↑(u⁻¹) : CliffordAlgebra Q)
  have hab : b * a = 1 := by
    exact Units.inv_mul u
  have hba : a * b = 1 := by
    exact Units.mul_inv u
  have hConjSq : (a * CliffordAlgebra.ι Q v * b) ^ 2 =
      algebraMap R (CliffordAlgebra Q) (Q v) := by
    calc
      (a * CliffordAlgebra.ι Q v * b) ^ 2 =
          a * (CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q v) * b := by
            calc
              (a * CliffordAlgebra.ι Q v * b) ^ 2 =
                  a * CliffordAlgebra.ι Q v * (b * a) *
                    CliffordAlgebra.ι Q v * b := by noncomm_ring
              _ = a * (CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q v) * b := by
                    rw [hab]
                    noncomm_ring
      _ = a * algebraMap R (CliffordAlgebra Q) (Q v) * b := by
            rw [CliffordAlgebra.ι_sq_scalar]
      _ = algebraMap R (CliffordAlgebra Q) (Q v) := by
            have hcomm : algebraMap R (CliffordAlgebra Q) (Q v) * a =
                a * algebraMap R (CliffordAlgebra Q) (Q v) :=
              Algebra.commutes (Q v) a
            calc
              a * algebraMap R (CliffordAlgebra Q) (Q v) * b =
                  algebraMap R (CliffordAlgebra Q) (Q v) * a * b := by
                    rw [← hcomm]
              _ = algebraMap R (CliffordAlgebra Q) (Q v) * (a * b) := by
                    noncomm_ring
              _ = algebraMap R (CliffordAlgebra Q) (Q v) := by
                    rw [hba, mul_one]
  have hAct :
      (involute (Q := Q) (↑u : CliffordAlgebra Q) * CliffordAlgebra.ι Q v * b) *
      (involute (Q := Q) (↑u : CliffordAlgebra Q) * CliffordAlgebra.ι Q v * b) =
        algebraMap R (CliffordAlgebra Q) (Q v) := by
    rcases hgrade with hgrade | hgrade
    · rw [hgrade]
      simpa [a, b, u, pow_two] using hConjSq
    · rw [hgrade]
      have hNeg : ((-a) * CliffordAlgebra.ι Q v * b) ^ 2 =
          (a * CliffordAlgebra.ι Q v * b) ^ 2 := by noncomm_ring
      simpa [a, b, u, pow_two] using hNeg.trans hConjSq
  apply hScalar
  calc
    algebraMap R (CliffordAlgebra Q) (Q (twistedVectorMap Q hι g v)) =
        CliffordAlgebra.ι Q (twistedVectorMap Q hι g v) *
          CliffordAlgebra.ι Q (twistedVectorMap Q hι g v) :=
        (CliffordAlgebra.ι_sq_scalar Q _).symm
    _ = (involute (Q := Q) (↑u : CliffordAlgebra Q) * CliffordAlgebra.ι Q v * b) *
        (involute (Q := Q) (↑u : CliffordAlgebra Q) * CliffordAlgebra.ι Q v * b) := by
          rw [ι_twistedVectorMap]
    _ = algebraMap R (CliffordAlgebra Q) (Q v) := hAct

/-- Every Lipschitz unit therefore acts by a linear equivalence on the module;
the inverse equivalence is induced by its inverse unit. -/
noncomputable def twistedVectorEquiv
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (g : lipschitzGroup Q) [Invertible (2 : R)] : M ≃ₗ[R] M :=
  LinearEquiv.ofLinearMap (twistedVectorMap Q hι g)
    (twistedVectorMap Q hι g⁻¹)
    (by
      ext v
      exact twistedVectorMap_inv_apply Q hι g⁻¹ v)
    (by
      ext v
      exact twistedVectorMap_inv_apply Q hι g v)

@[simp] theorem twistedVectorEquiv_apply
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (g : lipschitzGroup Q) [Invertible (2 : R)] (v : M) :
    twistedVectorEquiv Q hι g v = twistedVectorMap Q hι g v := rfl

/-- The Lipschitz action, regarded as a native quadratic isometry. -/
noncomputable def twistedVectorIsometryEquiv
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap R (CliffordAlgebra Q)))
    (g : lipschitzGroup Q) [Invertible (2 : R)] : Q.IsometryEquiv Q :=
  { twistedVectorEquiv Q hι g with
    map_app' := twistedVectorMap_preserves_quadraticForm Q hι hScalar g }

@[simp] theorem twistedVectorIsometryEquiv_apply
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap R (CliffordAlgebra Q)))
    (g : lipschitzGroup Q) [Invertible (2 : R)] (v : M) :
    twistedVectorIsometryEquiv Q hι hScalar g v = twistedVectorMap Q hι g v := rfl

/-- The transported linear equivalences compose according to multiplication in
the Lipschitz group. -/
theorem twistedVectorEquiv_mul_apply
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (g h : lipschitzGroup Q) [Invertible (2 : R)] (v : M) :
    twistedVectorEquiv Q hι (g * h) v =
      twistedVectorEquiv Q hι g (twistedVectorEquiv Q hι h v) := by
  apply hι
  simp only [twistedVectorEquiv_apply, ι_twistedVectorMap]
  simp [map_mul, mul_assoc]

/-- The kernel condition for the transported twisted action, stated directly
as the defining relation between a Lipschitz unit and every Clifford vector.
Identifying this commutant with scalars requires additional hypotheses on the
quadratic space and is deliberately not asserted here. -/
theorem twistedVectorEquiv_eq_refl_iff
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (g : lipschitzGroup Q) [Invertible (2 : R)] :
    twistedVectorEquiv Q hι g = LinearEquiv.refl R M ↔
      ∀ v : M,
        involute (Q := Q) (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
            CliffordAlgebra.ι Q v =
          CliffordAlgebra.ι Q v * ↑(g : (CliffordAlgebra Q)ˣ) := by
  constructor
  · intro h v
    have hfix : twistedVectorEquiv Q hι g v = v :=
      congrArg (fun f : M ≃ₗ[R] M => f v) h
    have hfix' : involute (Q := Q)
          (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
          CliffordAlgebra.ι Q v * ↑((g : (CliffordAlgebra Q)ˣ)⁻¹) =
        CliffordAlgebra.ι Q v := by
      calc
        _ = CliffordAlgebra.ι Q (twistedVectorMap Q hι g v) := by
          rw [ι_twistedVectorMap]
        _ = CliffordAlgebra.ι Q v := by
          rw [← twistedVectorEquiv_apply]
          exact congrArg (CliffordAlgebra.ι Q) hfix
    calc
      involute (Q := Q) (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
          CliffordAlgebra.ι Q v =
          (involute (Q := Q) (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
            CliffordAlgebra.ι Q v * ↑((g : (CliffordAlgebra Q)ˣ)⁻¹)) *
              ↑(g : (CliffordAlgebra Q)ˣ) := by
                rw [mul_assoc, Units.inv_mul, mul_one]
      _ = CliffordAlgebra.ι Q v * ↑(g : (CliffordAlgebra Q)ˣ) := by rw [hfix']
  · intro h
    apply DFunLike.ext
    intro v
    apply hι
    rw [twistedVectorEquiv_apply, ι_twistedVectorMap]
    calc
      involute (Q := Q) (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
          CliffordAlgebra.ι Q v * ↑((g : (CliffordAlgebra Q)ˣ)⁻¹) =
          (CliffordAlgebra.ι Q v * ↑(g : (CliffordAlgebra Q)ˣ)) *
            ↑((g : (CliffordAlgebra Q)ˣ)⁻¹) := by rw [h v]
      _ = CliffordAlgebra.ι Q v := by
        rw [mul_assoc, Units.mul_inv, mul_one]

/-- Parity-resolved consequence of the kernel criterion: an even Lipschitz
unit acting trivially commutes with every vector; an odd one anticommutes with
every vector. This keeps the general conclusion separate from any
dimension-specific claim that the kernel consists only of scalars. -/
theorem twistedVectorEquiv_refl_commute_or_anticommute
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (g : lipschitzGroup Q) [Invertible (2 : R)] :
    twistedVectorEquiv Q hι g = LinearEquiv.refl R M →
      (∀ v : M, (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
          CliffordAlgebra.ι Q v = CliffordAlgebra.ι Q v *
            (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q)) ∨
      (∀ v : M, (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
          CliffordAlgebra.ι Q v = -(CliffordAlgebra.ι Q v *
            (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q))) := by
  intro hfix
  have h := (twistedVectorEquiv_eq_refl_iff Q hι g).mp hfix
  rcases lipschitz_involute_eq_self_or_neg Q g.property with heven | hodd
  · left
    intro v
    calc
      (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * CliffordAlgebra.ι Q v =
          involute (Q := Q) (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
            CliffordAlgebra.ι Q v := by rw [heven]
      _ = CliffordAlgebra.ι Q v * ↑(g : (CliffordAlgebra Q)ˣ) := h v
  · right
    intro v
    have hv := h v
    rw [hodd] at hv
    calc
      (↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * CliffordAlgebra.ι Q v =
          -((-↑(g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * CliffordAlgebra.ι Q v) := by
            noncomm_ring
      _ = -(CliffordAlgebra.ι Q v * ↑(g : (CliffordAlgebra Q)ˣ)) := by rw [hv]

/-- The grade-twisted Lipschitz action as a group representation on `M`. -/
noncomputable def twistedActionHom
    (hι : Function.Injective (CliffordAlgebra.ι Q)) [Invertible (2 : R)] :
    lipschitzGroup Q →* (M ≃ₗ[R] M) where
  toFun := fun g => by
    letI : Invertible (2 : R) := inferInstance
    exact twistedVectorEquiv Q hι g
  map_one' := by
    ext v
    apply hι
    simp [twistedVectorEquiv_apply, ι_twistedVectorMap]
  map_mul' g h := by
    ext v
    exact twistedVectorEquiv_mul_apply Q hι g h v

/-- The full Lipschitz action as a homomorphism into the native quadratic-isometry
group. This is distinct from the Pin hom below: no normalization of the
quadratic values of generating vectors is imposed. -/
noncomputable def lipschitzTwistedIsometryHom
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap R (CliffordAlgebra Q)))
    [Invertible (2 : R)] :
    lipschitzGroup Q →* Q.IsometryEquiv Q where
  toFun := fun g => twistedVectorIsometryEquiv Q hι hScalar g
  map_one' := by
    apply DFunLike.ext
    intro v
    change twistedVectorEquiv Q hι 1 v = v
    apply hι
    rw [twistedVectorEquiv_apply, ι_twistedVectorMap]
    simp
  map_mul' g h := by
    apply DFunLike.ext
    intro v
    change twistedVectorEquiv Q hι (g * h) v =
      twistedVectorEquiv Q hι g (twistedVectorEquiv Q hι h v)
    exact twistedVectorEquiv_mul_apply Q hι g h v

/-- A native Pin element, viewed as a Lipschitz-group element through Mathlib's
canonical embedding into Clifford units. -/
noncomputable def pinAsLipschitz (g : pinGroup Q) : lipschitzGroup Q :=
  ⟨pinGroup.toUnits g, pinGroup.units_mem_lipschitzGroup g.property⟩

@[simp] theorem pinAsLipschitz_apply (g : pinGroup Q) :
    ((pinAsLipschitz Q g : lipschitzGroup Q) : (CliffordAlgebra Q)ˣ) =
      pinGroup.toUnits g := rfl

/-- A Clifford vector of quadratic value `-1` determines a native Pin element.
This sign matches Mathlib's `star` convention on vectors. -/
noncomputable def pinNegativeUnitVector (v : M) (hv : Q v = -1) : pinGroup Q := by
  let u : (CliffordAlgebra Q)ˣ :=
    (CliffordAlgebra.isUnit_ι_of_isUnit Q (by rw [hv]; exact ⟨-1, by norm_num⟩)).unit
  have hu : (u : CliffordAlgebra Q) = CliffordAlgebra.ι Q v := by
    exact CliffordAlgebra.isUnit_ι_of_isUnit Q
      (by rw [hv]; exact ⟨-1, by norm_num⟩) |>.unit_spec
  refine ⟨CliffordAlgebra.ι Q v, ?_⟩
  rw [pinGroup.mem_iff]
  constructor
  · apply Submonoid.mem_map.mpr
    refine ⟨u, ?_, hu⟩
    apply Subgroup.subset_closure
    exact ⟨v, hu.symm⟩
  · rw [Unitary.mem_iff]
    constructor
    · rw [CliffordAlgebra.star_ι, neg_mul,
        CliffordAlgebra.ι_sq_scalar, hv]
      simp
    · rw [CliffordAlgebra.star_ι, mul_neg,
        CliffordAlgebra.ι_sq_scalar, hv]
      simp

@[simp] theorem pinNegativeUnitVector_coe (v : M) (hv : Q v = -1) :
    ((pinNegativeUnitVector Q v hv : pinGroup Q) : CliffordAlgebra Q) =
      CliffordAlgebra.ι Q v := rfl

/-- The quaternion coordinate of a Spin(0,3) element built from two
negative-unit vectors is the image of their coordinates under Mathlib's
`Cl(0,2) ≃ ℍ` equivalence. -/
theorem spinThreeQuaternionCoordinate_of_two_negativeUnitVectors
    (x y : (ℝ × ℝ) × ℝ)
    (hx : spinThreeQuadratic x = -1) (hy : spinThreeQuadratic y = -1) :
    ∃ g : spinGroup spinThreeQuadratic,
      spinThreeQuaternionCoordinate g =
        spinTwoQuaternionCliffordEquiv
          ((CliffordAlgebra.ι spinTwoQuadratic x.1 +
              algebraMap ℝ (CliffordAlgebra spinTwoQuadratic) x.2) *
            (CliffordAlgebra.ι spinTwoQuadratic y.1 -
              algebraMap ℝ (CliffordAlgebra spinTwoQuadratic) y.2)) := by
  let p := pinNegativeUnitVector spinThreeQuadratic x hx
  let r := pinNegativeUnitVector spinThreeQuadratic y hy
  have hEven : CliffordAlgebra.ι spinThreeQuadratic x *
      CliffordAlgebra.ι spinThreeQuadratic y ∈
      CliffordAlgebra.even spinThreeQuadratic := by
    exact CliffordAlgebra.ι_mul_ι_mem_evenOdd_zero spinThreeQuadratic x y
  have hprod : (p * r : pinGroup spinThreeQuadratic) =
      ⟨CliffordAlgebra.ι spinThreeQuadratic x *
        CliffordAlgebra.ι spinThreeQuadratic y, by
          rw [pinGroup.mem_iff]
          constructor
          · exact (p * r).property.1
          · simpa [p, r] using (p * r).property.2⟩ := by
    apply Subtype.ext
    simp [p, r]
  let g : spinGroup spinThreeQuadratic := ⟨(p * r : pinGroup spinThreeQuadratic), by
    rw [spinGroup.mem_iff]
    constructor
    · exact (p * r).property
    · simpa [hprod] using hEven⟩
  have hsub :
      (⟨CliffordAlgebra.ι spinThreeQuadratic x *
          CliffordAlgebra.ι spinThreeQuadratic y, hEven⟩ :
        CliffordAlgebra.even spinThreeQuadratic) =
        (CliffordAlgebra.even.ι spinThreeQuadratic).bilin x y := by
    apply Subtype.ext
    rfl
  refine ⟨g, ?_⟩
  change spinThreeEvenQuaternionEquiv
      ⟨(g : CliffordAlgebra spinThreeQuadratic), spinGroup.mem_even g.prop⟩ = _
  rw [show (⟨(g : CliffordAlgebra spinThreeQuadratic), spinGroup.mem_even g.prop⟩ :
      CliffordAlgebra.even spinThreeQuadratic) =
      ⟨CliffordAlgebra.ι spinThreeQuadratic x *
        CliffordAlgebra.ι spinThreeQuadratic y, hEven⟩ from ?_]
  · change spinTwoQuaternionCliffordEquiv
      (CliffordAlgebra.ofEven spinTwoQuadratic
        ((CliffordAlgebra.even.ι spinThreeQuadratic).bilin x y)) = _
    rw [CliffordAlgebra.ofEven_ι]
  · apply Subtype.ext
    change ((p * r : pinGroup spinThreeQuadratic) :
      CliffordAlgebra spinThreeQuadratic) = _
    exact congrArg Subtype.val hprod

/-- The quaternion coordinate map for `Spin(0,3)` is onto the unit
quaternions. The factorization lemma chooses unit quaternions `u,v` in the
real-plus-`imI`-plus-`imJ` plane with `u*v=q`; their coordinates provide the
two negative-unit vectors in `Cl(0,3)`. -/
theorem spinThreeQuaternionCoordinateHom_surjective
    (q : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))
    (hq : star q * q = 1) :
    ∃ g : spinGroup spinThreeQuadratic,
      spinThreeQuaternionCoordinateHom g = q := by
  obtain ⟨u, v, huK, hvK, huNorm, hvNorm, huv⟩ :=
    unitQuaternion_factors_with_zero_imK q hq
  let x : (ℝ × ℝ) × ℝ := ((u.imI, u.imJ), u.re)
  let y : (ℝ × ℝ) × ℝ := ((v.imI, v.imJ), -v.re)
  have huCoord : spinTwoQuaternionCliffordEquiv
      (CliffordAlgebra.ι spinTwoQuadratic x.1 +
        algebraMap ℝ (CliffordAlgebra spinTwoQuadratic) x.2) = u := by
    rw [map_add, spinTwoQuaternionCliffordEquiv_ι,
      spinTwoQuaternionCliffordEquiv.commutes]
    rcases u with ⟨a, b, c, d⟩
    simp only at huK
    subst d
    ext <;> simp [x]
  have hvCoord : spinTwoQuaternionCliffordEquiv
      (CliffordAlgebra.ι spinTwoQuadratic y.1 -
        algebraMap ℝ (CliffordAlgebra spinTwoQuadratic) y.2) = v := by
    rw [map_sub, spinTwoQuaternionCliffordEquiv_ι,
      spinTwoQuaternionCliffordEquiv.commutes]
    rcases v with ⟨a, b, c, d⟩
    simp only at hvK
    subst d
    ext <;> simp [y]
  have hx : spinThreeQuadratic x = -1 := by
    have hn := congrArg QuaternionAlgebra.re huNorm
    rcases u with ⟨a, b, c, d⟩
    simp only [QuaternionAlgebra.star_mk, QuaternionAlgebra.mk_mul_mk,
      QuaternionAlgebra.re_one] at hn
    simp [x, spinThreeQuadratic, spinTwoQuadratic]
    nlinarith [huK]
  have hy : spinThreeQuadratic y = -1 := by
    have hn := congrArg QuaternionAlgebra.re hvNorm
    rcases v with ⟨a, b, c, d⟩
    simp only [QuaternionAlgebra.star_mk, QuaternionAlgebra.mk_mul_mk,
      QuaternionAlgebra.re_one] at hn
    simp [y, spinThreeQuadratic, spinTwoQuadratic]
    nlinarith [hvK]
  obtain ⟨g, hg⟩ := spinThreeQuaternionCoordinate_of_two_negativeUnitVectors x y hx hy
  refine ⟨g, ?_⟩
  change spinThreeQuaternionCoordinate g = q
  calc
    spinThreeQuaternionCoordinate g =
        spinTwoQuaternionCliffordEquiv
          ((CliffordAlgebra.ι spinTwoQuadratic x.1 +
              algebraMap ℝ (CliffordAlgebra spinTwoQuadratic) x.2) *
            (CliffordAlgebra.ι spinTwoQuadratic y.1 -
              algebraMap ℝ (CliffordAlgebra spinTwoQuadratic) y.2)) := hg
    _ = u * v := by rw [map_mul, huCoord, hvCoord]
    _ = q := huv

/-- The norm-one elements form a subgroup of the group of invertible
quaternions. The inverse closure uses the equality of the two Hamilton norm
products `star q * q` and `q * star q`. -/
def spinThreeUnitQuaternionSubgroup :
    Subgroup (QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))ˣ where
  carrier := {u | star (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) *
    (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) = 1}
  one_mem' := by simp
  mul_mem' {u v} hu hv := by
    change star ((u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) * v) *
      ((u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) * v) = 1
    calc
      star ((u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) * v) *
          ((u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) * v) =
          star (v : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) *
            (star (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) *
              (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))) * v := by
            rw [star_mul]
            noncomm_ring
      _ = 1 := by rw [hu]; simpa using hv
  inv_mem' {u} hu := by
    have hnorm : star (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) *
        (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) = 1 := hu
    have hinv : (↑u⁻¹ : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) =
        star (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) := by
      apply Units.inv_eq_of_mul_eq_one_left
      exact hnorm
    have hright : (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) *
        star (u : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) = 1 := by
      rw [← hinv]
      simp
    change star ((↑u⁻¹ : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))) *
      (↑u⁻¹ : QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) = 1
    rw [hinv, star_star]
    exact hright

/-- The Spin(0,3) quaternion coordinate, packaged as a homomorphism into
the norm-one quaternion subgroup. -/
noncomputable def spinThreeQuaternionNormOneHom :
    spinGroup spinThreeQuadratic →* spinThreeUnitQuaternionSubgroup where
  toFun g :=
    ⟨spinThreeQuaternionUnitsHom g,
      by
        change star (spinThreeQuaternionCoordinate g) *
          spinThreeQuaternionCoordinate g = 1
        exact spinThreeQuaternionCoordinate_star_mul_self g⟩
  map_one' := by
    apply Subtype.ext
    apply Units.ext
    simp [spinThreeQuaternionUnitsHom]
  map_mul' g h := by
    apply Subtype.ext
    apply Units.ext
    simp [spinThreeQuaternionUnitsHom, map_mul]

/-- The Spin(0,3) coordinate is an isomorphism onto the unit-quaternion
subgroup (equivalently, the unit 3-sphere in Hamilton's quaternions). -/
noncomputable def spinThreeQuaternionNormOneEquiv :
    spinGroup spinThreeQuadratic ≃* spinThreeUnitQuaternionSubgroup :=
  MulEquiv.ofBijective spinThreeQuaternionNormOneHom
    ⟨by
      intro g h hgh
      apply spinThreeQuaternionCoordinateHom_injective
      have hval := congrArg (fun u : spinThreeUnitQuaternionSubgroup =>
        ((u : (QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))ˣ) :
          QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))) hgh
      simpa [spinThreeQuaternionNormOneHom] using hval,
      by
        intro q
        obtain ⟨g, hg⟩ := spinThreeQuaternionCoordinateHom_surjective
          ((q : (QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ))ˣ) :
            QuaternionAlgebra ℝ (-1 : ℝ) 0 (-1 : ℝ)) q.property
        refine ⟨g, ?_⟩
        apply Subtype.ext
        apply Units.ext
        simpa [spinThreeQuaternionNormOneHom] using hg⟩

/-- Every unit complex number is represented by an even product of two
negative-unit vectors in `Cl(0,2)`. Consequently the natural homomorphism
`Spin(0,2) → Circle` constructed from the even-algebra coordinate is onto.

The factorization is explicit: for `z = a + b I`, use the vectors
`(-a,b)` and `(1,0)`. Their Clifford product has complex coordinate `z`;
the circle norm equation supplies `a² + b² = 1`, so both vectors have
quadratic value `-1`. -/
theorem spinTwoComplexCircleHom_surjective :
    Function.Surjective spinTwoComplexCircleHom := by
  intro z
  let a : ℝ := (z : ℂ).re
  let b : ℝ := (z : ℂ).im
  have hzNorm : ‖(z : ℂ)‖ = 1 := Circle.norm_coe z
  have hab : a ^ 2 + b ^ 2 = 1 := by
    have hs : Complex.normSq (z : ℂ) = 1 := by
      rw [Complex.normSq_eq_norm_sq, hzNorm]
      norm_num
    have hs' : (z : ℂ).re * (z : ℂ).re + (z : ℂ).im * (z : ℂ).im = 1 := by
      simpa [Complex.normSq] using hs
    change (z : ℂ).re ^ 2 + (z : ℂ).im ^ 2 = 1
    nlinarith [hs']
  let v : ℝ × ℝ := (-a, b)
  let e : ℝ × ℝ := (1, 0)
  have hv : spinTwoQuadratic v = -1 := by
    rw [spinTwoQuadratic_eq_quaternionQ]
    simp [v, CliffordAlgebraQuaternion.Q_apply]
    nlinarith [hab]
  have he : spinTwoQuadratic e = -1 := by
    rw [spinTwoQuadratic_eq_quaternionQ]
    simp [e, CliffordAlgebraQuaternion.Q_apply]
  let p : pinGroup spinTwoQuadratic := pinNegativeUnitVector spinTwoQuadratic v hv
  let q : pinGroup spinTwoQuadratic := pinNegativeUnitVector spinTwoQuadratic e he
  have hEven : CliffordAlgebra.ι spinTwoQuadratic v *
      CliffordAlgebra.ι spinTwoQuadratic e ∈ CliffordAlgebra.even spinTwoQuadratic := by
    exact CliffordAlgebra.ι_mul_ι_mem_evenOdd_zero spinTwoQuadratic v e
  have hpq : (p * q : pinGroup spinTwoQuadratic) =
      ⟨CliffordAlgebra.ι spinTwoQuadratic v * CliffordAlgebra.ι spinTwoQuadratic e,
        by
          rw [pinGroup.mem_iff]
          constructor
          ·
            have hm := pinGroup.mem_lipschitzGroup (p * q).property
            simpa [p, q] using hm
          · have hm := (p * q).property.2
            simpa [p, q] using hm⟩ := by
    apply Subtype.ext
    simp [p, q]
  let g : spinGroup spinTwoQuadratic := ⟨(p * q : pinGroup spinTwoQuadratic), by
    rw [spinGroup.mem_iff]
    constructor
    · exact (p * q).property
    · simpa [hpq] using hEven⟩
  have hcoord : spinTwoComplexCoordinate g = z := by
    change CliffordAlgebraComplex.equiv
      (CliffordAlgebra.ofEven spinOneQuadratic
        ⟨CliffordAlgebra.ι spinTwoQuadratic v * CliffordAlgebra.ι spinTwoQuadratic e,
          hEven⟩) = z
    have hsub :
        (⟨CliffordAlgebra.ι spinTwoQuadratic v * CliffordAlgebra.ι spinTwoQuadratic e,
          hEven⟩ : CliffordAlgebra.even spinTwoQuadratic) =
        (CliffordAlgebra.even.ι spinTwoQuadratic).bilin v e := by
      apply Subtype.ext
      rfl
    rw [hsub, CliffordAlgebra.ofEven_ι]
    change CliffordAlgebraComplex.toComplex
      ((CliffordAlgebra.ι spinOneQuadratic v.1 +
        algebraMap ℝ (CliffordAlgebra spinOneQuadratic) v.2) *
        (CliffordAlgebra.ι spinOneQuadratic e.1 -
          algebraMap ℝ (CliffordAlgebra spinOneQuadratic) e.2)) = (z : ℂ)
    apply Complex.ext <;>
      simp [CliffordAlgebraComplex.toComplex_ι, Complex.mul_re, Complex.mul_im,
        v, e, a, b]
  refine ⟨g, ?_⟩
  apply Circle.ext
  exact hcoord

/-- The standard low-dimensional identification `Spin(0,2) ≃* U(1)`,
realized through the even Clifford algebra equivalence with `ℂ`. -/
noncomputable def spinTwoComplexCircleEquiv :
    spinGroup spinTwoQuadratic ≃* Circle :=
  MulEquiv.ofBijective spinTwoComplexCircleHom
    ⟨spinTwoComplexCircleHom_injective, spinTwoComplexCircleHom_surjective⟩

/-- Mathlib's canonical map from its Pin monoid into its Lipschitz group. -/
noncomputable def pinAsLipschitzHom : pinGroup Q →* lipschitzGroup Q where
  toFun := pinAsLipschitz Q
  map_one' := by
    apply Subtype.ext
    simp [pinAsLipschitz]
  map_mul' g h := by
    apply Subtype.ext
    simp [pinAsLipschitz]

/-- The native Pin monoid acts by invertible linear maps on the original
quadratic carrier. -/
noncomputable def pinTwistedActionHom
    (hι : Function.Injective (CliffordAlgebra.ι Q)) [Invertible (2 : R)] :
    pinGroup Q →* (M ≃ₗ[R] M) :=
  (twistedActionHom Q hι).comp (pinAsLipschitzHom Q)

/-- The Pin action of a negative unit vector is the corresponding Clifford
reflection formula `polar(v,x) • v - Q(v) • x`. -/
theorem pinNegativeUnitVector_action_apply
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (v : M) (hv : Q v = -1) [Invertible (2 : R)] (x : M) :
    pinTwistedActionHom Q hι (pinNegativeUnitVector Q v hv) x =
      QuadraticMap.polar Q v x • v - Q v • x := by
  let u : (CliffordAlgebra Q)ˣ :=
    (CliffordAlgebra.isUnit_ι_of_isUnit Q (by rw [hv]; exact ⟨-1, by norm_num⟩)).unit
  have hu : (u : CliffordAlgebra Q) = CliffordAlgebra.ι Q v := by
    exact CliffordAlgebra.isUnit_ι_of_isUnit Q
      (by rw [hv]; exact ⟨-1, by norm_num⟩) |>.unit_spec
  have hpin : pinGroup.toUnits (pinNegativeUnitVector Q v hv) = u := by
    apply Units.ext
    simp [pinNegativeUnitVector, u]
  have hinv : (↑(u⁻¹) : CliffordAlgebra Q) = -CliffordAlgebra.ι Q v := by
    apply Units.inv_eq_of_mul_eq_one_right
    calc
      (↑u : CliffordAlgebra Q) * (-CliffordAlgebra.ι Q v) =
          -(CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q v) := by
            rw [hu]
            noncomm_ring
      _ = -algebraMap R (CliffordAlgebra Q) (Q v) := by
            rw [CliffordAlgebra.ι_sq_scalar]
      _ = 1 := by rw [hv]; norm_num
  have hunit : ((pinAsLipschitz Q (pinNegativeUnitVector Q v hv) :
      lipschitzGroup Q) : (CliffordAlgebra Q)ˣ) = u := by
    rw [pinAsLipschitz_apply, hpin]
  have hmap : involute (Q := Q) (↑((pinAsLipschitz Q
      (pinNegativeUnitVector Q v hv) : lipschitzGroup Q) :
      (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) =
      -CliffordAlgebra.ι Q v := by
    rw [hunit, hu, CliffordAlgebra.involute_ι]
  have hmapInv : (↑((((pinAsLipschitz Q
      (pinNegativeUnitVector Q v hv) : lipschitzGroup Q) :
      (CliffordAlgebra Q)ˣ)⁻¹)) : CliffordAlgebra Q) =
      -CliffordAlgebra.ι Q v := by
    rw [hunit]
    exact hinv
  change twistedVectorMap Q hι (pinAsLipschitz Q
      (pinNegativeUnitVector Q v hv)) x = _
  apply hι
  rw [ι_twistedVectorMap, hmap, hmapInv]
  calc
    (-CliffordAlgebra.ι Q v) * CliffordAlgebra.ι Q x *
        (-CliffordAlgebra.ι Q v) =
        CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q x * CliffordAlgebra.ι Q v := by
          noncomm_ring
    _ = CliffordAlgebra.ι Q
        (QuadraticMap.polar Q v x • v - Q v • x) :=
      CliffordAlgebra.ι_mul_ι_mul_ι (Q := Q) v x

/-- A negative-unit Pin vector reverses its own normal. -/
theorem pinNegativeUnitVector_action_normal
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (v : M) (hv : Q v = -1) [Invertible (2 : R)] :
    pinTwistedActionHom Q hι (pinNegativeUnitVector Q v hv) v = -v := by
  rw [pinNegativeUnitVector_action_apply Q hι v hv v,
    QuadraticMap.polar_self, hv]
  norm_num [two_smul]

/-- A negative-unit Pin vector fixes every vector orthogonal to its normal. -/
theorem pinNegativeUnitVector_action_fixes_orthogonal
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (v x : M) (hv : Q v = -1) (horth : Q.IsOrtho v x)
    [Invertible (2 : R)] :
    pinTwistedActionHom Q hι (pinNegativeUnitVector Q v hv) x = x := by
  rw [pinNegativeUnitVector_action_apply Q hι v hv x,
    horth.polar_eq_zero, hv]
  simp

/-- Every native Pin element acts isometrically for `Q`. -/
theorem pinTwistedAction_preservesQuadraticForm
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap R (CliffordAlgebra Q)))
    (g : pinGroup Q) [Invertible (2 : R)] (v : M) :
    pinTwistedActionHom Q hι g v =
      twistedVectorMap Q hι (pinAsLipschitz Q g) v ∧
      Q (pinTwistedActionHom Q hι g v) = Q v := by
  constructor
  · rfl
  · exact twistedVectorMap_preserves_quadraticForm Q hι hScalar
      (pinAsLipschitz Q g) v

/-- Native quadratic-isometry form of the transported Pin action. -/
noncomputable def pinTwistedIsometryEquiv
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap R (CliffordAlgebra Q)))
    (g : pinGroup Q) [Invertible (2 : R)] : Q.IsometryEquiv Q :=
  { pinTwistedActionHom Q hι g with
    map_app' := fun v => (pinTwistedAction_preservesQuadraticForm Q hι hScalar g v).2 }

@[simp] theorem pinTwistedIsometryEquiv_apply
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap R (CliffordAlgebra Q)))
    (g : pinGroup Q) [Invertible (2 : R)] (v : M) :
    pinTwistedIsometryEquiv Q hι hScalar g v = pinTwistedActionHom Q hι g v := rfl

/-- The native Pin action as a homomorphism into the quadratic-isometry group.
This packages the pointwise isometries with their multiplicative action law. -/
noncomputable def pinTwistedIsometryHom
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap R (CliffordAlgebra Q)))
    [Invertible (2 : R)] : pinGroup Q →* Q.IsometryEquiv Q where
  toFun := fun g => pinTwistedIsometryEquiv Q hι hScalar g
  map_one' := by
    apply DFunLike.ext
    intro v
    change pinTwistedActionHom Q hι 1 v = v
    simp [pinTwistedActionHom]
  map_mul' g h := by
    apply DFunLike.ext
    intro v
    change pinTwistedActionHom Q hι (g * h) v =
      pinTwistedActionHom Q hι g (pinTwistedActionHom Q hι h v)
    simp [pinTwistedActionHom]

end InfoGeometry.Clifford.LipschitzVectorAction

namespace InfoGeometry.Clifford.LipschitzVectorAction

variable {M : Type*} [AddCommGroup M] [Module ℝ M]
variable (Q : QuadraticForm ℝ M)

/-- Rescaling a non-isotropic normal by a nonzero scalar does not change its
hyperplane reflection. -/
theorem realQuadraticReflection_smul
    (c : ℝ) (v : M) (hv : Q v ≠ 0) (hc : c ≠ 0) :
    realQuadraticReflection Q (c • v)
      (by rw [QuadraticMap.map_smul]; exact mul_ne_zero (mul_ne_zero hc hc) hv) =
    realQuadraticReflection Q v hv := by
  apply DFunLike.ext
  intro x
  rw [realQuadraticReflection_apply, realQuadraticReflection_apply,
    QuadraticMap.polar_smul_right, QuadraticMap.map_smul]
  simp only [smul_eq_mul, smul_smul]
  have hcoef :
      (c * QuadraticMap.polar (⇑Q) x v /
        (c * c * Q v)) * c =
        QuadraticMap.polar (⇑Q) x v / Q v := by
    field_simp [hc, hv]
  rw [hcoef]

/-- Conditional Cartan--Dieudonné coverage for the Pin action. Negative
definiteness supplies the normalization to quadratic value `-1` needed to lift
each real reflection generator to Mathlib's Pin group. -/
theorem pinTwistedIsometryHom_surjective_of_reflection_normalization
    {ι : Type*} [Fintype ι]
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap ℝ (CliffordAlgebra Q)))
    (b : ι → M)
    (hspan : Submodule.span ℝ (Set.range b) = ⊤)
    (hQ : ∀ i, Q (b i) ≠ 0)
    (horth : ∀ {i j}, i ≠ j → QuadraticMap.polar (⇑Q) (b i) (b j) = 0)
    (hnegative : ∀ v : M, v ≠ 0 → Q v < 0) :
    Function.Surjective (pinTwistedIsometryHom Q hι hScalar) := by
  classical
  let ρ := pinTwistedIsometryHom Q hι hScalar
  have hgen : realQuadraticReflectionSubgroup Q ≤ ρ.range := by
    change Subgroup.closure (realQuadraticReflectionSet Q) ≤ ρ.range
    rw [Subgroup.closure_le]
    intro f hf
    rcases hf with ⟨v, hv, rfl⟩
    have hv0 : v ≠ 0 := by
      intro hzero
      subst v
      exact hv (by simp)
    have hrad : 0 < -Q v := neg_pos.mpr (hnegative v hv0)
    have hsqrt : Real.sqrt (-Q v) ^ 2 = -Q v := Real.sq_sqrt (le_of_lt hrad)
    let c : ℝ := (Real.sqrt (-Q v))⁻¹
    have hc : c ≠ 0 := by
      dsimp [c]
      exact inv_ne_zero (ne_of_gt (Real.sqrt_pos.2 hrad))
    let w : M := c • v
    have hw : Q w = -1 := by
      rw [show w = c • v from rfl, QuadraticMap.map_smul]
      dsimp [c]
      field_simp [ne_of_gt (Real.sqrt_pos.2 hrad)]
      rw [hsqrt]
      ring
    have hw' : Q (c • v) = -1 := by simpa [w] using hw
    refine ⟨pinNegativeUnitVector Q w hw, ?_⟩
    apply DFunLike.ext
    intro x
    have hreflection := congrArg (fun f : M ≃ₗ[ℝ] M => f x)
      (realQuadraticReflection_smul Q c v hv hc)
    change pinTwistedActionHom Q hι (pinNegativeUnitVector Q w hw) x =
      realQuadraticReflection Q v hv x
    rw [pinNegativeUnitVector_action_apply Q hι w hw x, ← hreflection,
      realQuadraticReflection_apply, QuadraticMap.polar_comm, hw']
    rw [show w = c • v from rfl, QuadraticMap.polar_smul_right]
    simp only [smul_smul, smul_eq_mul, div_neg, div_one]
    module
  have htop : realQuadraticReflectionSubgroup Q = ⊤ :=
    realQuadraticReflectionSubgroup_eq_top_of_orthogonal_spanning
      Q b hspan hQ horth
  have hrange : ρ.range = ⊤ := by
    apply top_unique
    rw [← htop]
    exact hgen
  intro f
  have hf : f ∈ ρ.range := by rw [hrange]; simp
  rcases hf with ⟨g, rfl⟩
  exact ⟨g, rfl⟩

/-- For a finite-dimensional negative-definite real quadratic space, an
orthogonal basis supplies the spanning-family and reflection-normalization
hypotheses, so the Pin action is onto the full quadratic-isometry group.
The Clifford-vector and scalar-map injectivity assumptions remain explicit. -/
theorem pinTwistedIsometryHom_surjective_of_negative_definite_finiteDim
    [FiniteDimensional ℝ M]
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap ℝ (CliffordAlgebra Q)))
    [Invertible (2 : ℝ)]
    (hnegative : ∀ v : M, v ≠ 0 → Q v < 0) :
    Function.Surjective (pinTwistedIsometryHom Q hι hScalar) := by
  let B : LinearMap.BilinForm ℝ M := QuadraticMap.associatedHom ℝ Q
  have hBsymm : LinearMap.IsSymm B :=
    ⟨fun x y => QuadraticMap.associated_isSymm ℝ Q x y⟩
  obtain ⟨b, hb⟩ :=
    LinearMap.BilinForm.exists_orthogonal_basis (B := B) hBsymm
  let basisVectors : Fin (Module.finrank ℝ M) → M := b
  have hspan : Submodule.span ℝ (Set.range basisVectors) = ⊤ := by
    exact b.span_eq
  have hQ : ∀ i : Fin (Module.finrank ℝ M), Q (basisVectors i) ≠ 0 := by
    intro i
    apply ne_of_lt
    apply hnegative
    exact b.ne_zero i
  have horth : ∀ {i j : Fin (Module.finrank ℝ M)}, i ≠ j →
      QuadraticMap.polar (⇑Q) (basisVectors i) (basisVectors j) = 0 := by
    intro i j hij
    have hzero : B (basisVectors i) (basisVectors j) = 0 := hb hij
    have htwo : 2 * B (basisVectors i) (basisVectors j) =
        QuadraticMap.polar (⇑Q) (basisVectors i) (basisVectors j) := by
      have h := congrArg (fun C : LinearMap.BilinForm ℝ M => C (basisVectors i) (basisVectors j))
        (QuadraticMap.two_nsmul_associated ℝ Q)
      have h' : B (basisVectors i) (basisVectors j) +
          B (basisVectors i) (basisVectors j) =
            QuadraticMap.polar (⇑Q) (basisVectors i) (basisVectors j) := by
        simpa only [B, two_smul, LinearMap.add_apply,
          QuadraticMap.polarBilin_apply_apply] using h
      calc
        2 * B (basisVectors i) (basisVectors j) =
            B (basisVectors i) (basisVectors j) +
              B (basisVectors i) (basisVectors j) := by ring
        _ = QuadraticMap.polar (⇑Q) (basisVectors i) (basisVectors j) := h'
    rw [hzero] at htwo
    simpa using htwo.symm
  exact pinTwistedIsometryHom_surjective_of_reflection_normalization
    Q hι hScalar basisVectors hspan hQ horth hnegative

/-- The full Lipschitz group contains a lift of every anisotropic vector
reflection, with no sign restriction on the quadratic value. -/
theorem lipschitzVectorEquiv_reflection
    {M : Type*} [AddCommGroup M] [Module ℝ M]
    (Q : QuadraticForm ℝ M)
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    [Invertible (2 : ℝ)] (v : M) (hv : Q v ≠ 0) :
    ∃ g : lipschitzGroup Q,
      twistedVectorEquiv Q hι g = realQuadraticReflection Q v hv := by
  let u : (CliffordAlgebra Q)ˣ :=
    (CliffordAlgebra.isUnit_ι_of_isUnit Q
      ⟨Units.mk0 (Q v) hv, rfl⟩).unit
  have hu : (u : CliffordAlgebra Q) = CliffordAlgebra.ι Q v := by
    exact (CliffordAlgebra.isUnit_ι_of_isUnit Q
      ⟨Units.mk0 (Q v) hv, rfl⟩).unit_spec
  let g : lipschitzGroup Q := ⟨u, Subgroup.subset_closure ⟨v, hu.symm⟩⟩
  refine ⟨g, ?_⟩
  apply DFunLike.ext
  intro x
  apply hι
  rw [twistedVectorEquiv_apply, ι_twistedVectorMap]
  change CliffordAlgebra.involute (Q := Q) (↑u : CliffordAlgebra Q) *
      CliffordAlgebra.ι Q x * (↑u⁻¹ : CliffordAlgebra Q) =
    CliffordAlgebra.ι Q (realQuadraticReflection Q v hv x)
  rw [hu, CliffordAlgebra.involute_ι]
  have hInv : (↑u⁻¹ : CliffordAlgebra Q) =
      algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) * CliffordAlgebra.ι Q v := by
    apply Units.inv_eq_of_mul_eq_one_right
    rw [hu]
    have hcomm := (Algebra.commutes ((Q v)⁻¹) (CliffordAlgebra.ι Q v)).symm
    calc
      CliffordAlgebra.ι Q v *
          (algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) * CliffordAlgebra.ι Q v) =
          (CliffordAlgebra.ι Q v *
            algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹)) * CliffordAlgebra.ι Q v := by
              noncomm_ring
      _ = (algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
            CliffordAlgebra.ι Q v) * CliffordAlgebra.ι Q v := by rw [hcomm]
      _ = algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
            (CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q v) := by noncomm_ring
      _ = algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹ * Q v) := by
            rw [CliffordAlgebra.ι_sq_scalar, map_mul]
      _ = 1 := by simp [hv]
  rw [hInv]
  calc
    (-CliffordAlgebra.ι Q v) * CliffordAlgebra.ι Q x *
        (algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) * CliffordAlgebra.ι Q v) =
        -(algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
          (CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q x * CliffordAlgebra.ι Q v)) := by
            have hcommV := (Algebra.commutes ((Q v)⁻¹)
              (CliffordAlgebra.ι Q v)).symm
            have hcommX := (Algebra.commutes ((Q v)⁻¹)
              (CliffordAlgebra.ι Q x)).symm
            calc
              (-CliffordAlgebra.ι Q v) * CliffordAlgebra.ι Q x *
                  (algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) * CliffordAlgebra.ι Q v) =
                  -(CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q x *
                    algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
                    CliffordAlgebra.ι Q v) := by noncomm_ring
              _ = -(CliffordAlgebra.ι Q v *
                    (CliffordAlgebra.ι Q x *
                      algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹)) *
                    CliffordAlgebra.ι Q v) := by noncomm_ring
              _ = -(CliffordAlgebra.ι Q v *
                    (algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
                      CliffordAlgebra.ι Q x) * CliffordAlgebra.ι Q v) := by
                    rw [hcommX]
              _ = -(CliffordAlgebra.ι Q v *
                    algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
                    CliffordAlgebra.ι Q x * CliffordAlgebra.ι Q v) := by noncomm_ring
              _ = -(algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
                    CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q x *
                    CliffordAlgebra.ι Q v) := by
                    have : CliffordAlgebra.ι Q v *
                        algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) =
                      algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
                        CliffordAlgebra.ι Q v := hcommV
                    rw [this]
              _ = -(algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
                    (CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q x *
                      CliffordAlgebra.ι Q v)) := by noncomm_ring
    _ = CliffordAlgebra.ι Q (realQuadraticReflection Q v hv x) := by
      rw [CliffordAlgebra.ι_mul_ι_mul_ι]
      simp only [map_sub, map_smul]
      rw [realQuadraticReflection_apply]
      simp only [map_sub, map_smul, Algebra.smul_def]
      have hInvQ : algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
          algebraMap ℝ (CliffordAlgebra Q) (Q v) = 1 := by
        rw [← map_mul]
        rw [inv_mul_cancel₀ hv, map_one]
      have hpol : algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
          algebraMap ℝ (CliffordAlgebra Q) (QuadraticMap.polar (⇑Q) v x) =
          algebraMap ℝ (CliffordAlgebra Q)
            (QuadraticMap.polar (⇑Q) v x / Q v) := by
        calc
          _ = algebraMap ℝ (CliffordAlgebra Q)
              ((Q v)⁻¹ * QuadraticMap.polar (⇑Q) v x) := (map_mul _ _ _).symm
          _ = algebraMap ℝ (CliffordAlgebra Q)
              (QuadraticMap.polar (⇑Q) v x / Q v) := by
                congr 1
                rw [div_eq_mul_inv, mul_comm]
      have hcent : ∀ (a : ℝ) (z : CliffordAlgebra Q),
          algebraMap ℝ (CliffordAlgebra Q) a * z =
            z * algebraMap ℝ (CliffordAlgebra Q) a :=
        fun a z => Algebra.commutes a z
      have hpol' : algebraMap ℝ (CliffordAlgebra Q)
          (QuadraticMap.polar (⇑Q) x v / Q v) =
          algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
            algebraMap ℝ (CliffordAlgebra Q) (QuadraticMap.polar (⇑Q) v x) := by
        rw [QuadraticMap.polar_comm Q x v]
        exact hpol.symm
      rw [hpol']
      have hcentQ : algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
          algebraMap ℝ (CliffordAlgebra Q) (Q v) =
          algebraMap ℝ (CliffordAlgebra Q) (Q v) *
            algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) :=
        hcent _ _
      calc
        -((algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹)) *
            ((algebraMap ℝ (CliffordAlgebra Q) (QuadraticMap.polar (⇑Q) v x)) *
              CliffordAlgebra.ι Q v -
             (algebraMap ℝ (CliffordAlgebra Q) (Q v)) * CliffordAlgebra.ι Q x)) =
          -(algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
              algebraMap ℝ (CliffordAlgebra Q) (QuadraticMap.polar (⇑Q) v x) *
              CliffordAlgebra.ι Q v) +
            algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
              algebraMap ℝ (CliffordAlgebra Q) (Q v) * CliffordAlgebra.ι Q x := by
                noncomm_ring
        _ = -(algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
              algebraMap ℝ (CliffordAlgebra Q) (QuadraticMap.polar (⇑Q) v x) *
              CliffordAlgebra.ι Q v) + CliffordAlgebra.ι Q x := by
                rw [hInvQ, one_mul]
        _ = CliffordAlgebra.ι Q x -
              (algebraMap ℝ (CliffordAlgebra Q) ((Q v)⁻¹) *
                algebraMap ℝ (CliffordAlgebra Q) (QuadraticMap.polar (⇑Q) v x)) *
                CliffordAlgebra.ι Q v := by abel

/-- Cartan--Dieudonné surjectivity for the full Lipschitz action under the
repository's finite orthogonal-spanning hypotheses. Unlike the Pin variant,
this works for mixed-signature real quadratic forms: anisotropic reflection
normals are lifted directly, without rescaling them to quadratic value `-1`. -/
theorem lipschitzTwistedIsometryHom_surjective_of_orthogonal_spanning
    {ι : Type*} [Fintype ι]
    (hι : Function.Injective (CliffordAlgebra.ι Q))
    (hScalar : Function.Injective (algebraMap ℝ (CliffordAlgebra Q)))
    [Invertible (2 : ℝ)]
    (b : ι → M)
    (hspan : Submodule.span ℝ (Set.range b) = ⊤)
    (hQ : ∀ i, Q (b i) ≠ 0)
    (horth : ∀ {i j}, i ≠ j → QuadraticMap.polar (⇑Q) (b i) (b j) = 0) :
    Function.Surjective (lipschitzTwistedIsometryHom Q hι hScalar) := by
  classical
  let ρ := lipschitzTwistedIsometryHom Q hι hScalar
  have hgen : realQuadraticReflectionSubgroup Q ≤ ρ.range := by
    change Subgroup.closure (realQuadraticReflectionSet Q) ≤ ρ.range
    rw [Subgroup.closure_le]
    intro f hf
    rcases hf with ⟨v, hv, rfl⟩
    obtain ⟨g, hg⟩ := lipschitzVectorEquiv_reflection Q hι v hv
    refine ⟨g, ?_⟩
    apply DFunLike.ext
    intro x
    change twistedVectorEquiv Q hι g x = realQuadraticReflection Q v hv x
    exact congrArg (fun e : M ≃ₗ[ℝ] M => e x) hg
  have htop : realQuadraticReflectionSubgroup Q = ⊤ :=
    realQuadraticReflectionSubgroup_eq_top_of_orthogonal_spanning
      Q b hspan hQ horth
  have hrange : ρ.range = ⊤ := by
    apply top_unique
    rw [← htop]
    exact hgen
  intro f
  have hf : f ∈ ρ.range := by rw [hrange]; simp
  rcases hf with ⟨g, rfl⟩
  exact ⟨g, rfl⟩

end InfoGeometry.Clifford.LipschitzVectorAction
