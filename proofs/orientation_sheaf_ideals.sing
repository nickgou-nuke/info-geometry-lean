// orientation_sheaf_ideals.sing
// Algebraic ideals corresponding to locally constant sections of the orientation sheaf

ring r = 0, (x, y, z), dp;

// A locally constant section on a connected component can be represented
// by idempotent elements in the coordinate ring.
// For the 4 components of O(p,q), we can consider the ideal generated by
// elements that split the space into 4 parts.

ideal I_components = (x^2 - 1, y^2 - 1);
// x represents space orientation (+1 or -1)
// y represents time orientation (+1 or -1)

// The orientation sheaf sections correspond to modules over this ring
qring Q = std(I_components);

// The ideal of orientation preserving transformations (connected component of identity)
ideal SO_plus = (x - 1, y - 1);

// Space reversing
ideal SO_minus_space = (x + 1, y - 1);

// Time reversing
ideal SO_minus_time = (x - 1, y + 1);

// Space and time reversing
ideal SO_minus_both = (x + 1, y + 1);

print("Orientation sheaf ideals formulation loaded.");
