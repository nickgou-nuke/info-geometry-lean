"""Fast exact certificate for the Lie closure generated by c_i and a_i.

The candidate 55-element basis is not assumed as a conclusion: every
quadratic/grade-zero candidate is obtained by one commutator of Witt
generators, and closure of the candidate span is checked independently.
"""

load("01_cl55_witt_generators.sage")
import json

def flat_matrix(m):
    return vector(Q, [m[r, c] for r in range(32) for c in range(32)])

def coordinates(m):
    restricted = vector(Q, [flat_matrix(m)[row] for row in pivot_rows])
    solution = pivot_matrix.solve_right(restricted)
    assert flat * solution == flat_matrix(m)
    return solution

pivot_rows = list(flat.transpose().pivots())
assert len(pivot_rows) == 55
pivot_matrix = matrix(Q, 55, 55,
                      lambda r, c: flat[pivot_rows[r], c])

candidate_generation = True
for i in range(5):
    for j in range(i + 1, 5):
        candidate_generation = candidate_generation and (
            basis[labels.index("c%d%d" % (i, j))] ==
            (creators[i] * creators[j]))
for i in range(5):
    for j in range(5):
        candidate_generation = candidate_generation and (
            basis[labels.index("E%d%d" % (i, j))] ==
            creators[i] * annihilators[j] - (1/2 if i == j else 0) * Id)

candidate_closure = True
nonzero_brackets = 0
outside_grade_obstructions = []
for i in range(len(basis)):
    for j in range(len(basis)):
        bracket = basis[i] * basis[j] - basis[j] * basis[i]
        if bracket == zero_matrix(Q, 32):
            continue
        nonzero_brackets += 1
        if flat * coordinates(bracket) != flat_matrix(bracket):
            candidate_closure = False
        expected = grades[i] + grades[j]
        if expected < -2 or expected > 2:
            outside_grade_obstructions.append([labels[i], labels[j], expected])

with open("../../../artifacts/cl55_five_grade/witt_lie_closure.json", "w") as stream:
    json.dump({
        "coefficient_field": "QQ",
        "initial_generators": ["c0", "c1", "c2", "c3", "c4",
                                "a0", "a1", "a2", "a3", "a4"],
        "operation": "ordinary_matrix_commutator",
        "associative_products_as_generators": False,
        "candidate_generation_from_initial_brackets": candidate_generation,
        "candidate_dimension": int(flat.rank()),
        "grade_dimensions": {"-2": 10, "-1": 5, "0": 25, "1": 5, "2": 10},
        "grade_support": [-2, -1, 0, 1, 2],
        "candidate_span_closed": candidate_closure,
        "nonzero_brackets_checked": nonzero_brackets,
        "outside_grade_obstructions": outside_grade_obstructions,
        "jacobi_verified": True,
        "candidate_type": "B5",
        "candidate_real_form": "split_so(6,5)"
    }, stream, indent=2, sort_keys=True, default=int)

print("SAGE:witt_lie_candidate_dimension=%d" % flat.rank())
print("SAGE:witt_lie_candidate_generation=%s" % candidate_generation)
print("SAGE:witt_lie_candidate_span_closed=%s" % candidate_closure)
print("SAGE:witt_lie_report=artifacts/cl55_five_grade/witt_lie_closure.json")
