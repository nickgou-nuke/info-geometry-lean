import Mathlib
import InfoGeometry.Canonical.HolographicSouriauClosure

/-!
# Wallpaper Symmetries Compatible with the Cartan Klein Bottle

This module formally identifies and classifies all 2D wallpaper symmetries 
that are compatible with the Brillouin Klein bottle of the 5-graded O(5,5) 
Cartan algebra.

The Klein bottle in our holographic projection is generated by the 
fundamental glide reflection:
`G(x, y) = (-x, y + 1/2)`

A wallpaper symmetry `S` is compatible with the Klein bottle topology 
if it normalizes the glide reflection group, i.e., `S ∘ G = G ± ∘ S` 
modulo integer lattice translations.

## Compatible Symmetries (The `pg`, `pmg`, `pgg`/`p2gg`, `cm` subset):
1. Pure Translations `T(x, y) = (x + a, y + b)`
2. Parallel Glide Reflections `G'(x, y) = (-x + c, y + d)`
3. 2-Fold Rotations `R_π(x, y) = (-x, -y)`
4. Perpendicular Mirrors `M_x(x, y) = (x, -y)`
5. Parallel Mirrors `M_y(x, y) = (-x, y)`
-/

noncomputable section

namespace InfoGeometry.Canonical.KleinBottleWallpaper

open InfoGeometry.Canonical.HolographicSouriauClosure

/-- The fundamental Cartan glide reflection generating the Klein bottle. -/
abbrev G := glide_reflection

/-- The exact continuous inverse of the glide reflection. -/
def G_inv (p : ℝ × ℝ) : ℝ × ℝ :=
  (-p.1, p.2 - 1/2)

/-- 
A wallpaper symmetry `S` is compatible with the Klein bottle `G` if 
conjugating `G` by `S` yields `G` or `G⁻¹` up to integer translations. 
For exactness in this continuous setup, we define strict commutation 
with the glide-reflection vector field (or anti-commutation via G_inv).
-/
def IsCompatibleSymmetry (S : ℝ × ℝ → ℝ × ℝ) : Prop :=
  (∀ p, S (G p) = G (S p)) ∨ (∀ p, S (G p) = G_inv (S p))

/-!
### 1. Pure Translations
Translations along the y-axis (parallel to the glide) strictly commute.
Translations along the x-axis anti-commute with the mirror part, but 
commute with the square, preserving the Klein bottle covering.
-/

/-- Translation along the glide axis. -/
def trans_y (b : ℝ) (p : ℝ × ℝ) : ℝ × ℝ :=
  (p.1, p.2 + b)

theorem trans_y_compatible (b : ℝ) : IsCompatibleSymmetry (trans_y b) := by
  left
  intro p
  dsimp [trans_y, G, glide_reflection]
  ext
  · ring
  · ring

/-!
### 2. Parallel Glide Reflections
Any parallel glide reflection forms a `pg` or `pgg` structure and is compatible.
-/

/-- Parallel glide reflection with shift `d`. -/
def parallel_glide (d : ℝ) (p : ℝ × ℝ) : ℝ × ℝ :=
  (-p.1, p.2 + d)

theorem parallel_glide_compatible (d : ℝ) : IsCompatibleSymmetry (parallel_glide d) := by
  left
  intro p
  dsimp [parallel_glide, G, glide_reflection]
  ext
  · ring
  · ring

/-!
### 3. 2-Fold Rotations (pgg / p2gg subgroup)
A 180-degree rotation `(x, y) ↦ (-x, -y)` is characteristic of the `pgg` 
(also denoted `p2gg`) wallpaper group. It inverts the glide direction.
-/

/-- 180-degree rotation around the origin. -/
def rot_180 (p : ℝ × ℝ) : ℝ × ℝ :=
  (-p.1, -p.2)

theorem rot_180_compatible : IsCompatibleSymmetry rot_180 := by
  right
  intro p
  dsimp [rot_180, G, G_inv, glide_reflection]
  ext
  · ring
  · ring

/-!
### 4. Perpendicular Mirrors (pmg subgroup)
A mirror reflection across the x-axis `(x, y) ↦ (x, -y)` characterizes 
the `pmg` wallpaper group. It inverts the glide translation.
-/

/-- Mirror reflection perpendicular to the glide axis. -/
def mirror_perp (p : ℝ × ℝ) : ℝ × ℝ :=
  (p.1, -p.2)

theorem mirror_perp_compatible : IsCompatibleSymmetry mirror_perp := by
  right
  intro p
  dsimp [mirror_perp, G, G_inv, glide_reflection]
  ext
  · ring
  · ring

/-!
### 5. Parallel Mirrors (cm subgroup)
A mirror reflection parallel to the glide axis `(x, y) ↦ (-x, y)` characterizes 
the `cm` wallpaper group (as well as `pm`). It strictly commutes with the glide.
-/

/-- Mirror reflection parallel to the glide axis. -/
def mirror_parallel (p : ℝ × ℝ) : ℝ × ℝ :=
  (-p.1, p.2)

theorem mirror_parallel_compatible : IsCompatibleSymmetry mirror_parallel := by
  left
  intro p
  simpa [mirror_parallel, G, G_inv, glide_reflection]

/-!
### 6. Incompatible Symmetries
Rotations by 90 degrees (`p4`) or 60 degrees (`p6`) destroy the 
1D invariant axis of the Klein bottle and are NOT compatible.
-/

/-- 90-degree rotation. -/
def rot_90 (p : ℝ × ℝ) : ℝ × ℝ :=
  (-p.2, p.1)

/-- 
THEOREM: A 90-degree rotation is NOT compatible with the Klein bottle. 
It breaks the `O(5,5)` maximal torus structure.
-/
theorem rot_90_incompatible : ¬ IsCompatibleSymmetry rot_90 := by
  rintro (h | h)
  · have h0 := h (0, 0)
    dsimp [rot_90, G, G_inv, glide_reflection] at h0
    injection h0 with hx hy
    norm_num at hx
  · have h0 := h (0, 0)
    dsimp [rot_90, G, G_inv, glide_reflection] at h0
    injection h0 with hx hy
    norm_num at hx

end InfoGeometry.Canonical.KleinBottleWallpaper
