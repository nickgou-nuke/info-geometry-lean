import InfoGeometry.Canonical.OperatorContentNetwork.Basic
import Mathlib.Algebra.BigOperators.Group.List.Basic
import Mathlib.Algebra.Group.Units.Basic
import Mathlib.Tactic.NoncommRing

/-!
# Substitution and ordered execution of real operator programs

Substitution is the native `FreeAlgebra.lift` into another free algebra.
Evaluation is its lift into the full real matrix algebra. Agreement on the
generators of an adjoined subalgebra suffices for agreement on its programs.
This is algebraic substitution; no interpretation of untyped abstraction is
asserted. Event execution uses the native ordered `List.prod`.
-/

namespace InfoGeometry.Canonical.OperatorContentNetwork

variable {α β γ δ : Type*}

/-- Composing substitutions substitutes the second program into each first image. -/
theorem substitution_comp (σ : α → Program β) (τ : β → Program γ) :
    (FreeAlgebra.lift ℝ τ).comp (FreeAlgebra.lift ℝ σ) =
      FreeAlgebra.lift ℝ (fun a => FreeAlgebra.lift ℝ τ (σ a)) := by
  apply FreeAlgebra.hom_ext
  funext a
  simp

theorem substitution_comp_apply (σ : α → Program β) (τ : β → Program γ)
    (p : Program α) :
    FreeAlgebra.lift ℝ τ (FreeAlgebra.lift ℝ σ p) =
      FreeAlgebra.lift ℝ (fun a => FreeAlgebra.lift ℝ τ (σ a)) p :=
  DFunLike.congr_fun (substitution_comp σ τ) p

/-- Substitution by the original generators is the identity algebra homomorphism. -/
theorem substitution_identity :
    FreeAlgebra.lift ℝ (FreeAlgebra.ι ℝ : α → Program α) =
      AlgHom.id ℝ (Program α) := by
  apply FreeAlgebra.hom_ext
  funext a
  simp

/-- The two associations of a three-stage substitution agree on every program. -/
theorem substitution_assoc_apply (σ : α → Program β) (τ : β → Program γ)
    (υ : γ → Program δ) (p : Program α) :
    FreeAlgebra.lift ℝ (fun b => FreeAlgebra.lift ℝ υ (τ b))
        (FreeAlgebra.lift ℝ σ p) =
      FreeAlgebra.lift ℝ υ
        (FreeAlgebra.lift ℝ (fun a => FreeAlgebra.lift ℝ τ (σ a)) p) := by
  rw [← substitution_comp_apply τ υ, ← substitution_comp_apply σ τ]

/-- Substitution transports a declared generator support into its declared target support. -/
theorem substitution_mem_adjoin {S : Set α} {T : Set β}
    (σ : α → Program β)
    (hσ : ∀ a ∈ S, σ a ∈ Algebra.adjoin ℝ (FreeAlgebra.ι ℝ '' T))
    {p : Program α} (hp : p ∈ Algebra.adjoin ℝ (FreeAlgebra.ι ℝ '' S)) :
    FreeAlgebra.lift ℝ σ p ∈ Algebra.adjoin ℝ (FreeAlgebra.ι ℝ '' T) := by
  have hle : Algebra.adjoin ℝ (FreeAlgebra.ι ℝ '' S) ≤
      (Algebra.adjoin ℝ (FreeAlgebra.ι ℝ '' T)).comap (FreeAlgebra.lift ℝ σ) := by
    apply Algebra.adjoin_le
    rintro _ ⟨a, ha, rfl⟩
    change FreeAlgebra.lift ℝ σ (FreeAlgebra.ι ℝ a) ∈
      Algebra.adjoin ℝ (FreeAlgebra.ι ℝ '' T)
    simpa using hσ a ha
  exact hle hp

section MatrixEvaluation

variable {n m : Type*} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

/-- Evaluating after substitution agrees with evaluating each substituted generator. -/
theorem evaluation_substitution (ρ : β → Operator n) (σ : α → Program β) :
    (FreeAlgebra.lift ℝ ρ).comp (FreeAlgebra.lift ℝ σ) =
      FreeAlgebra.lift ℝ (fun a => FreeAlgebra.lift ℝ ρ (σ a)) := by
  apply FreeAlgebra.hom_ext
  funext a
  simp

theorem evaluation_substitution_apply (ρ : β → Operator n)
    (σ : α → Program β) (p : Program α) :
    FreeAlgebra.lift ℝ ρ (FreeAlgebra.lift ℝ σ p) =
      FreeAlgebra.lift ℝ (fun a => FreeAlgebra.lift ℝ ρ (σ a)) p :=
  DFunLike.congr_fun (evaluation_substitution ρ σ) p

/-- An algebra homomorphism between real matrix algebras commutes with program evaluation. -/
theorem evaluation_naturality (F : Operator n →ₐ[ℝ] Operator m)
    (ρ : α → Operator n) :
    F.comp (FreeAlgebra.lift ℝ ρ) = FreeAlgebra.lift ℝ (fun a => F (ρ a)) := by
  apply FreeAlgebra.hom_ext
  funext a
  simp

/-- Generator agreement extends to the native subalgebra generated by those names. -/
theorem evaluation_eqOn_adjoin {S : Set α} (ρ η : α → Operator n)
    (h : Set.EqOn ρ η S) :
    Set.EqOn (FreeAlgebra.lift ℝ ρ) (FreeAlgebra.lift ℝ η)
      (Algebra.adjoin ℝ (FreeAlgebra.ι ℝ '' S)) := by
  apply AlgHom.eqOn_adjoin_iff.mpr
  rintro _ ⟨a, ha, rfl⟩
  simpa using h ha

/-- Evaluation depends only on the supplied generator support of the program. -/
theorem evaluation_locality {S : Set α} (ρ η : α → Operator n)
    (h : Set.EqOn ρ η S) {p : Program α}
    (hp : p ∈ Algebra.adjoin ℝ (FreeAlgebra.ι ℝ '' S)) :
    FreeAlgebra.lift ℝ ρ p = FreeAlgebra.lift ℝ η p :=
  evaluation_eqOn_adjoin ρ η h hp

/-- Noncommuting multiplication is retained even inside arbitrary matrix contexts. -/
theorem context_swap_defect (P A B Q : Operator n) :
    P * A * B * Q - P * B * A * Q = P * (A * B - B * A) * Q := by
  noncomm_ring

/-- An adjacent exchange in an event list has its exact ordered commutator residual. -/
theorem execution_adjacent_swap_defect (before after : List (Operator n))
    (A B : Operator n) :
    (before ++ A :: B :: after).prod - (before ++ B :: A :: after).prod =
      before.prod * (A * B - B * A) * after.prod := by
  simp only [List.prod_append, List.prod_cons]
  noncomm_ring

/-- Invertible contexts preserve, and detect, commutation of the exchanged operators. -/
theorem unit_context_swap_eq_iff (P Q : (Operator n)ˣ) (A B : Operator n) :
    (P : Operator n) * A * B * (Q : Operator n) =
        (P : Operator n) * B * A * (Q : Operator n) ↔ Commute A B := by
  change ((P : Operator n) * A * B) * (Q : Operator n) =
    ((P : Operator n) * B * A) * (Q : Operator n) ↔ A * B = B * A
  rw [Units.mul_left_inj Q]
  simpa only [mul_assoc] using
    (Units.mul_right_inj P (b := A * B) (c := B * A))

theorem unit_context_commutator_eq_zero_iff (P Q : (Operator n)ˣ)
    (A B : Operator n) :
    (P : Operator n) * (A * B - B * A) * (Q : Operator n) = 0 ↔
      Commute A B := by
  rw [← context_swap_defect, sub_eq_zero]
  exact unit_context_swap_eq_iff P Q A B

theorem unit_context_commutator_ne_zero_iff (P Q : (Operator n)ˣ)
    (A B : Operator n) :
    (P : Operator n) * (A * B - B * A) * (Q : Operator n) ≠ 0 ↔
      ¬ Commute A B :=
  not_congr (unit_context_commutator_eq_zero_iff P Q A B)

end MatrixEvaluation

end InfoGeometry.Canonical.OperatorContentNetwork
