import InfoGeometry.Core.TitsExhaustion
import InfoGeometry.Algebra.Zorn.G2ConcreteGeneratorInfrastructure

/-!
# Non-circular generated-subgroup Bruhat exhaustion for `G₂(2)`

This file separates two logically distinct statements:

1. the subgroup generated by the concrete Borel/unipotent subgroup together
   with the two simple Weyl reflections is contained in the concrete Bruhat
   covering;
2. identifying that generated subgroup with the whole ambient automorphism
   group is a separate generation theorem.

Thus no ambient generation statement is used in the Bruhat exhaustion proof.
-/

namespace InfoGeometry.Algebra.Zorn.G2GeneratedBruhatExhaustion

open InfoGeometry.Foundations
open InfoGeometry.OperatorAlgebra.G2TwoAutomorphismTheorem
open InfoGeometry.Algebra.Zorn.G2ConcreteWeylG2
open InfoGeometry.Algebra.Zorn.G2TwoBruhatClassification
open InfoGeometry.Algebra.Zorn.G2TwoPCSubgroupClosure
open InfoGeometry.Algebra.Zorn.G2ConcreteGeneratorInfrastructure

/-- Every element of the concrete unipotent/Borel subgroup preserves the
Bruhat covering under left translation in both directions. -/
theorem unipotent_mem_covering_leftStabilizer
    {b : SplitOctF2Aut}
    (hb : b ∈ unipotentSubgroup) :
    b ∈ leftStabilizer concreteBruhatCovering := by
  intro g
  constructor
  · intro hg
    exact concreteBruhatCovering_left_mul_borel b hb hg
  · intro hbg
    have hbinv : b⁻¹ ∈ unipotentSubgroup :=
      unipotentSubgroup.inv_mem hb
    have h :=
      concreteBruhatCovering_left_mul_borel b⁻¹ hbinv hbg
    simpa [mul_assoc] using h

/-- Under `ConcreteBN2Transition`, each simple reflection preserves membership
in the Bruhat covering in both directions. The reverse implication uses the
already proved involutivity `s² = t² = 1`. -/
theorem simpleReflection_mem_covering_leftStabilizer
    (htrans : ConcreteBN2Transition)
    {r : SplitOctF2Aut}
    (hr : r ∈ ({s, t} : Set SplitOctF2Aut)) :
    r ∈ leftStabilizer concreteBruhatCovering := by
  have hsq : r * r = 1 := by
    rcases hr with rfl | rfl
    · exact s_sq
    · exact t_sq
  apply mem_leftStabilizer_of_sq_eq_one concreteBruhatCovering hsq
  intro g hg
  exact concreteBruhatCovering_left_mul_simple_of_transition
    htrans r hr hg

/-- The full concrete BN generating set lies in the left stabilizer of the
Bruhat covering. -/
theorem concreteBNGenerators_mem_covering_leftStabilizer
    (htrans : ConcreteBN2Transition) :
    ((unipotentSubgroup : Set SplitOctF2Aut) ∪
      ({s, t} : Set SplitOctF2Aut)) ⊆
      leftStabilizer concreteBruhatCovering := by
  intro x hx
  rcases hx with hxU | hxW
  · exact unipotent_mem_covering_leftStabilizer hxU
  · exact simpleReflection_mem_covering_leftStabilizer htrans hxW

/-- The identity automorphism belongs to the concrete Bruhat covering. -/
theorem one_mem_concreteBruhatCovering :
    (1 : SplitOctF2Aut) ∈ concreteBruhatCovering := by
  apply Set.mem_iUnion.mpr
  refine ⟨(0, false), ?_⟩
  simpa [weylNF_zero_false] using
    (weyl_mem_concreteBruhatCell (1 : SplitOctF2Aut))

/-- Main non-circular exhaustion theorem:

`ConcreteBN2Transition` implies that every element of the subgroup generated
by the Borel/unipotent subgroup and the simple reflections `s,t` belongs to the
concrete Bruhat covering.

No assumption that this generated subgroup equals the ambient
`SplitOctF2Aut` is used. -/
theorem concreteBNGeneratorSubgroup_subset_bruhatCovering
    (htrans : ConcreteBN2Transition) :
    (concreteBNGeneratorSubgroup : Set SplitOctF2Aut) ⊆
      concreteBruhatCovering := by
  have hclosure :
      (Subgroup.closure
        ((unipotentSubgroup : Set SplitOctF2Aut) ∪
          ({s, t} : Set SplitOctF2Aut)) : Set SplitOctF2Aut) ⊆
        concreteBruhatCovering :=
    closure_subset_of_leftStabilizer
      concreteBruhatCovering
      one_mem_concreteBruhatCovering
      ((unipotentSubgroup : Set SplitOctF2Aut) ∪
        ({s, t} : Set SplitOctF2Aut))
      (concreteBNGenerators_mem_covering_leftStabilizer htrans)
  simpa [concreteBNGeneratorSubgroup] using hclosure

/-- Equivalent elementwise form of the generated-subgroup exhaustion theorem. -/
theorem mem_concreteBruhatCovering_of_mem_concreteBNGeneratorSubgroup
    (htrans : ConcreteBN2Transition)
    {g : SplitOctF2Aut}
    (hg : g ∈ concreteBNGeneratorSubgroup) :
    g ∈ concreteBruhatCovering :=
  concreteBNGeneratorSubgroup_subset_bruhatCovering htrans hg

/-- Once ambient generation is independently available, the generated-subgroup
exhaustion theorem upgrades immediately to full Bruhat coverage. -/
theorem concreteBruhatCovering_eq_univ_of_generator_top
    (htrans : ConcreteBN2Transition)
    (hgen : concreteBNGeneratorSubgroup = ⊤) :
    concreteBruhatCovering = Set.univ := by
  ext g
  simp only [Set.mem_univ, iff_true]
  apply concreteBNGeneratorSubgroup_subset_bruhatCovering htrans
  rw [hgen]
  exact Subgroup.mem_top g

end InfoGeometry.Algebra.Zorn.G2GeneratedBruhatExhaustion
