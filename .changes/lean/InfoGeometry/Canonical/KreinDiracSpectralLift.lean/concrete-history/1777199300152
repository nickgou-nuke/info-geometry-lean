{"type":"new","contents":"import InfoGeometry.Canonical.InformationPartitionCore\nimport InfoGeometry.Canonical.KreinDiracPolarizationBridge\nimport InfoGeometry.Meta.Architecture\n\n/-!\n# Krein Dirac Spectral Lift\n\nFirst spectral-lift layer above the Dirac/Krein/polarization bridge.\n\nThis file does not claim a full spectral theorem on Krein space. It only packages\nexisting owner facts on the doubled carrier:\n\n- Bogoliubov transport moves the chirality weight sectors,\n- the transported Dirac operator generates an exponential flow,\n- the existing partition/log-partition calculus applies to that transported\n  generator.\n-/\n\nnamespace InfoGeometry.Canonical.KreinDiracSpectralLift\n\nopen InfoGeometry.Quantum.RealMajorana\nopen InfoGeometry.Canonical.KreinDiracPolarizationBridge\nopen InfoGeometry.Canonical.SpectralInference\nopen InfoGeometry.Canonical.InformationCalculus.ModularRadonNikodymData\nopen InfoGeometry.Krein\n\nsection Doubled\n\nvariable {E : Type}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\nvariable {M : RealMajoranaDatum (S := DoubledSpace E)}\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\n\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nnoncomputable local instance : NormedSpace ℝ EndH := inferInstance\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : CompleteSpace EndH := inferInstance\n\n/-- Exponential flow generated by the transported Dirac operator. -/\n@[rep_depth transport]\nnoncomputable def transportDiracFlow\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M) (τ : ℝ) : EndH :=\n  NormedSpace.exp (τ • transportDirac IST T)\n\n@[simp] theorem transportDiracFlow_zero\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M) :\n    transportDiracFlow IST T 0 = (1 : EndH) := by\n  simp [transportDiracFlow]\n\n/-- Additive-time law for the exponential flow generated by the transported Dirac operator. -/\ntheorem transportDiracFlow_add\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M) (s t : ℝ) :\n    transportDiracFlow IST T (s + t)\n      = transportDiracFlow IST T s * transportDiracFlow IST T t := by\n  have hComm : Commute (s • transportDirac IST T) (t • transportDirac IST T) := by\n    exact ((Commute.refl (transportDirac IST T)).smul_left s).smul_right t\n  calc\n    transportDiracFlow IST T (s + t)\n        = NormedSpace.exp ((s + t) • transportDirac IST T) := rfl\n    _ = NormedSpace.exp (s • transportDirac IST T + t • transportDirac IST T) := by\n          simp [add_smul]\n    _ = NormedSpace.exp (s • transportDirac IST T) *\n          NormedSpace.exp (t • transportDirac IST T) := by\n          rw [NormedSpace.exp_add_of_commute hComm]\n    _ = transportDiracFlow IST T s * transportDiracFlow IST T t := rfl\n\n/-- The existing partition calculus applies to the transported Dirac generator. -/\ntheorem hasDerivAt_transportDiracPartitionFunction_zero\n    (ω : EndH →L[ℝ] ℝ)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M) :\n    HasDerivAt\n      (fun τ : ℝ => informationPartitionFunction ω (transportDirac IST T) τ)\n      (ω (transportDirac IST T)) 0 :=\n  hasDerivAt_informationPartitionFunction_zero (ω := ω) (K := transportDirac IST T)\n\n/-- Normalized log-partition lift for the transported Dirac generator. -/\ntheorem hasDerivAt_logTransportDiracPartitionFunction_zero_of_normalized\n    (ω : EndH →L[ℝ] ℝ)\n    (hω1 : ω (1 : EndH) = 1)\n    (IST : InfoSpectralTriple H₂)\n    (T : RealBogoliubovTransform (S := H₂) M) :\n    HasDerivAt\n      (fun τ : ℝ => logInformationPartitionFunction ω (transportDirac IST T) τ)\n      (ω (transportDirac IST T)) 0 :=\n  hasDerivAt_logInformationPartitionFunction_zero_of_normalized\n    (ω := ω) (K := transportDirac IST T) hω1\n\n/-- Strict symmetry transports the chirality weight sectors into the transported carrier weights. -/\ntheorem transportedChiralityWeights_of_strictSymmetry\n    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :\n    Submodule.map h.f.toLinearMap M.weylPlus = (h.toBogoliubovTransform).transportWeylPlus ∧\n    Submodule.map h.f.toLinearMap M.weylMinus = (h.toBogoliubovTransform).transportWeylMinus := by\n  exact ⟨by simpa [PolarizedMajorana.Hom.toBogoliubovTransform] using\n      (h.toBogoliubovTransform.map_weylPlus_eq_transportWeylPlus (M := M)),\n    by simpa [PolarizedMajorana.Hom.toBogoliubovTransform] using\n      (h.toBogoliubovTransform.map_weylMinus_eq_transportWeylMinus (M := M))⟩\n\n/--\nFirst packaged spectral lift on the doubled carrier:\nstrict symmetry transports chirality weights, and the transported Dirac\ngenerator enters the existing exponential/partition calculus.\n-/\ntheorem kreinDiracSpectralLift_of_strictSymmetry\n    (ω : EndH →L[ℝ] ℝ)\n    (IST : InfoSpectralTriple H₂)\n    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :\n    Submodule.map h.f.toLinearMap M.weylPlus = (h.toBogoliubovTransform).transportWeylPlus ∧\n    Submodule.map h.f.toLinearMap M.weylMinus = (h.toBogoliubovTransform).transportWeylMinus ∧\n    HasDerivAt\n      (fun τ : ℝ => informationPartitionFunction ω (transportDirac IST h.toBogoliubovTransform) τ)\n      (ω (transportDirac IST h.toBogoliubovTransform)) 0 := by\n  exact ⟨(transportedChiralityWeights_of_strictSymmetry (M := M) h).1,\n    (transportedChiralityWeights_of_strictSymmetry (M := M) h).2,\n    hasDerivAt_transportDiracPartitionFunction_zero\n      (ω := ω) (IST := IST) (T := h.toBogoliubovTransform)⟩\n\n/-- Normalized log-partition version of the first spectral lift. -/\ntheorem normalized_logKreinDiracSpectralLift_of_strictSymmetry\n    (ω : EndH →L[ℝ] ℝ)\n    (hω1 : ω (1 : EndH) = 1)\n    (IST : InfoSpectralTriple H₂)\n    {X Y : PolarizedMajorana (S := H₂) M} (h : X ⟶ Y) :\n    HasDerivAt\n      (fun τ : ℝ => logInformationPartitionFunction ω (transportDirac IST h.toBogoliubovTransform) τ)\n      (ω (transportDirac IST h.toBogoliubovTransform)) 0 :=\n  hasDerivAt_logTransportDiracPartitionFunction_zero_of_normalized\n    (ω := ω) (hω1 := hω1) (IST := IST) (T := h.toBogoliubovTransform)\n\nend Doubled\n\nend InfoGeometry.Canonical.KreinDiracSpectralLift\n","mtime":1777199300152}