import InfoGeometry.Analysis.BipolarLogDifferential
import InfoGeometry.Canonical.BipolarTwoSheetOperatorConnectionBridge
import InfoGeometry.Canonical.BipolarHalfLogLiftAnalyticPureGauge
import Mathlib.Analysis.Calculus.Deriv.Inv
import Mathlib.Analysis.Calculus.Deriv.Prod
import Mathlib.Tactic

/-!
# Variable bipolar Cartan connection

The global logarithmic differential on the twice-punctured plane is

`dlog01(s) ds = (1/s - 1/(s-1)) ds`.

This file places half of that one-form in the complex Cartan line generated by
`σ3c`:

`A_s(v) = (dlog01(s) * v / 2) • σ3c`.

Three logically different assertions are proved.

1. The rational coefficient has its genuine complex derivative away from the
   two punctures, so the directional derivative used below is not postulated.
2. The exterior derivative vanishes because the antisymmetrized directional
   derivatives contain the factor `u*v-v*u`; the self-wedge vanishes because
   all values lie in one abelian Cartan line.
3. On a compatible principal-log chart, the repository-owned `halfLogLift`
   has the displayed derivative and satisfies the local pure-gauge identity
   `G⁻¹ dG = A`.

The last statement is local. Globally, the half-log frame can acquire the
central sign `-I₂`, while the connection itself is single-valued and flat.
No smooth principal bundle or contour-integral holonomy theorem is asserted.
-/

noncomputable section

namespace InfoGeometry.Canonical.BipolarVariableCartanConnection

open InfoGeometry.Analysis.BipolarCrossRatioLog
open InfoGeometry.Analysis.BipolarLogDifferential
open InfoGeometry.Canonical.BipolarLogSL2
open InfoGeometry.Canonical.BipolarTwoSheetOperatorConnectionBridge
open InfoGeometry.OperatorAlgebra.ExteriorAlgebra
open InfoGeometry.Physics.ChiralCausalCone

abbrev Matrix2C := Matrix (Fin 2) (Fin 2) ℂ

/-- Complex derivative of the rational logarithmic coefficient. -/
def dlog01Deriv (s : ℂ) : ℂ :=
  -(s ^ 2)⁻¹ + ((1 - s) ^ 2)⁻¹

/-- The rational logarithmic coefficient has the claimed genuine derivative
at every point away from `0` and `1`. -/
theorem hasDerivAt_dlog01 {s : ℂ} (hs : s ∈ punctured01) :
    HasDerivAt dlog01 (dlog01Deriv s) s := by
  change HasDerivAt (fun z : ℂ => 1 / z + 1 / (1 - z)) (dlog01Deriv s) s
  have h0 : HasDerivAt (fun z : ℂ => z⁻¹) (-(s ^ 2)⁻¹) s :=
    hasDerivAt_inv hs.1
  have hlin : HasDerivAt (fun z : ℂ => 1 - z) (-1) s := by
    simpa using (hasDerivAt_const s (1 : ℂ)).sub (hasDerivAt_id s)
  have h1 := hlin.inv (one_sub_ne_zero_of_mem hs)
  convert h0.add h1 using 1 <;>
    try simp [dlog01, dlog01Deriv, one_div]
  all_goals try { funext z; rfl }
  all_goals field_simp [hs.1, one_sub_ne_zero_of_mem hs] <;> ring

/-- The nonconstant Cartan-valued one-form at a base point `s`. -/
def variableCartanConnection (s : ℂ) : Op1Form ℂ ℂ Matrix2C where
  toFun v := ((dlog01 s * v) / 2) • σ3c
  map_add' u v := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [σ3c, Matrix.smul_apply] <;> ring
  map_smul' c v := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [σ3c, Matrix.smul_apply, smul_smul] <;> ring

@[simp] theorem variableCartanConnection_apply (s v : ℂ) :
    variableCartanConnection s v = ((dlog01 s * v) / 2) • σ3c :=
  rfl

/-- Directional derivative in the base direction `u`, evaluated on the tangent
argument `v`. -/
def connectionDirectionalDerivative (s u v : ℂ) : Matrix2C :=
  ((dlog01Deriv s * u * v) / 2) • σ3c

/-- The displayed directional derivative is the actual derivative of the
connection along the affine complex line `t ↦ s + t*u`. -/
theorem hasDerivAt_variableCartanConnection_along
    {s : ℂ} (hs : s ∈ punctured01) (u v : ℂ) :
    HasDerivAt
      (fun t : ℂ => variableCartanConnection (s + t * u) v)
      (connectionDirectionalDerivative s u v) 0 := by
  have hline : HasDerivAt (fun t : ℂ => s + t * u) u 0 := by
    convert
      (hasDerivAt_const (x := (0 : ℂ)) (c := s)).add
        ((hasDerivAt_id (x := (0 : ℂ))).mul_const u) using 1 <;>
      simp
  have hcoeff := (hasDerivAt_dlog01 hs).comp_of_eq 0 hline (by ring)
  apply hasDerivAt_pi.2
  intro i
  apply hasDerivAt_pi.2
  intro j
  fin_cases i <;> fin_cases j
  · convert (hcoeff.mul_const v).div_const (2 : ℂ) using 1
    · funext x
      simp [variableCartanConnection, connectionDirectionalDerivative,
        σ3c, Matrix.smul_apply, mul_assoc]
    · simp [variableCartanConnection, connectionDirectionalDerivative,
        σ3c, Matrix.smul_apply, mul_assoc]
  · simpa [variableCartanConnection, connectionDirectionalDerivative,
      σ3c, Matrix.smul_apply] using
      (hasDerivAt_const (x := (0 : ℂ)) (c := (0 : ℂ)))
  · simpa [variableCartanConnection, connectionDirectionalDerivative,
      σ3c, Matrix.smul_apply] using
      (hasDerivAt_const (x := (0 : ℂ)) (c := (0 : ℂ)))
  · convert ((hcoeff.mul_const v).div_const (2 : ℂ)).neg using 1
    · funext x
      simp [variableCartanConnection, connectionDirectionalDerivative,
        σ3c, Matrix.smul_apply, mul_assoc]
    · simp [variableCartanConnection, connectionDirectionalDerivative,
        σ3c, Matrix.smul_apply, mul_assoc]

/-- Directional derivatives commute after antisymmetrization because the base
is one-dimensional over `ℂ`. -/
theorem connectionDirectionalDerivative_swap (s u v : ℂ) :
    connectionDirectionalDerivative s u v =
      connectionDirectionalDerivative s v u := by
  unfold connectionDirectionalDerivative
  apply congrArg (fun c : ℂ => c • σ3c)
  ring

/-- Exterior derivative of the variable Cartan connection. The zero form is
justified below by the genuine directional-derivative calculation. -/
def variableExteriorDerivative (_s : ℂ) : Op2Form ℂ ℂ Matrix2C :=
  0

/-- The zero two-form is exactly the antisymmetrized directional derivative. -/
theorem variableExteriorDerivative_eq_directionalDifference
    (s u v : ℂ) :
    variableExteriorDerivative s u v =
      connectionDirectionalDerivative s u v -
        connectionDirectionalDerivative s v u := by
  change 0 = _
  rw [connectionDirectionalDerivative_swap]
  simp

/-- The exterior derivative term vanishes. -/
theorem variableExteriorDerivative_eq_zero (s : ℂ) :
    variableExteriorDerivative s = 0 :=
  rfl

/-- Any two values of the variable connection commute because both are scalar
multiples of `σ3c`. -/
theorem variableCartanConnection_values_commute (s u v : ℂ) :
    variableCartanConnection s u * variableCartanConnection s v =
      variableCartanConnection s v * variableCartanConnection s u := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [variableCartanConnection, σ3c, Matrix.mul_apply,
      Fin.sum_univ_two, Matrix.smul_apply] <;>
    ring

/-- The nonlinear commutator part of curvature vanishes on every tangent pair. -/
theorem variableCartanConnection_selfWedge_zero (s : ℂ) :
    wedge (variableCartanConnection s) (variableCartanConnection s) = 0 := by
  apply Op2Form.ext
  intro u v
  rw [wedge_apply, variableCartanConnection_values_commute, sub_self]
  change (0 : Matrix2C) = 0
  rfl

/-- Curvature of the nonconstant Cartan connection. -/
def variableCartanCurvature (s : ℂ) : Op2Form ℂ ℂ Matrix2C :=
  variableExteriorDerivative s +
    wedge (variableCartanConnection s) (variableCartanConnection s)

/-- Nonconstant Maurer--Cartan equation on the twice-punctured domain. -/
theorem variableCartanCurvature_eq_zero
    {s : ℂ} (_hs : s ∈ punctured01) :
    variableCartanCurvature s = 0 := by
  apply Op2Form.ext
  intro u v
  change variableExteriorDerivative s u v +
    wedge (variableCartanConnection s) (variableCartanConnection s) u v = 0
  rw [variableExteriorDerivative_eq_zero, variableCartanConnection_selfWedge_zero]
  simp

/-- Derivative matrix of the principal-branch half-log frame. -/
def halfLogLiftDerivative (s : ℂ) : Matrix2C :=
  (dlog01 s / 2) •
    !![plusWeight s, 0;
       0, -minusWeight s]

/-- Genuine derivative of the positive half-weight on a compatible log chart. -/
theorem hasDerivAt_plusWeight
    {s : ℂ} (hs : s ∈ punctured01)
    (hslit : crossRatio01 s ∈ Complex.slitPlane) :
    HasDerivAt plusWeight
      ((dlog01 s / 2) * plusWeight s) s := by
  have hhalf := (hasDerivAt_bipolarLog hs hslit).div_const (2 : ℂ)
  have hexp :=
    (Complex.hasDerivAt_exp (bipolarLog s / 2)).comp s hhalf
  simpa [plusWeight, mul_comm, mul_left_comm, mul_assoc] using hexp

/-- Genuine derivative of the negative half-weight on a compatible log chart. -/
theorem hasDerivAt_minusWeight
    {s : ℂ} (hs : s ∈ punctured01)
    (hslit : crossRatio01 s ∈ Complex.slitPlane) :
    HasDerivAt minusWeight
      ((-dlog01 s / 2) * minusWeight s) s := by
  have hhalf := (hasDerivAt_bipolarLog hs hslit).neg.div_const (2 : ℂ)
  have hexp :=
    (Complex.hasDerivAt_exp (-bipolarLog s / 2)).comp s hhalf
  simpa [minusWeight, mul_comm, mul_left_comm, mul_assoc] using hexp

/-- The matrix half-log lift has the displayed genuine derivative. -/
theorem hasDerivAt_halfLogLift
    {s : ℂ} (hs : s ∈ punctured01)
    (hslit : crossRatio01 s ∈ Complex.slitPlane) :
    HasDerivAt halfLogLift (halfLogLiftDerivative s) s := by
  rw [hasDerivAt_pi]
  intro i
  rw [hasDerivAt_pi]
  intro j
  fin_cases i <;> fin_cases j
  · simpa [halfLogLift, halfLogLiftDerivative] using
      hasDerivAt_plusWeight hs hslit
  · simpa [halfLogLift, halfLogLiftDerivative] using
      (hasDerivAt_const s (0 : ℂ))
  · simpa [halfLogLift, halfLogLiftDerivative] using
      (hasDerivAt_const s (0 : ℂ))
  · convert hasDerivAt_minusWeight hs hslit using 1 <;>
      simp [halfLogLift, halfLogLiftDerivative] <;>
      ring

/-- Differential of the half-log frame evaluated on a tangent vector. -/
def halfLogLiftDifferential (s v : ℂ) : Matrix2C :=
  v • halfLogLiftDerivative s

/-- The displayed differential is the genuine derivative along an affine
complex tangent line. -/
theorem hasDerivAt_halfLogLift_along
    {s : ℂ} (hs : s ∈ punctured01)
    (hslit : crossRatio01 s ∈ Complex.slitPlane) (v : ℂ) :
    HasDerivAt
      (fun t : ℂ => halfLogLift (s + t * v))
      (halfLogLiftDifferential s v) 0 := by
  apply hasDerivAt_pi.2
  intro i
  apply hasDerivAt_pi.2
  intro j
  have h := BipolarHalfLogLiftAnalyticPureGauge.hasDerivAt_halfLogLift_entry_along
    hs hslit v i j
  convert h using 1

/-- Algebraic local pure-gauge identity `G⁻¹ dG = A`. -/
theorem halfLogLiftInv_mul_differential (s v : ℂ) :
    halfLogLiftInv s * halfLogLiftDifferential s v =
      variableCartanConnection s v := by
  have hpm : minusWeight s * plusWeight s = 1 := by
    rw [mul_comm, plusWeight_mul_minusWeight]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [halfLogLiftInv, halfLogLiftDifferential, halfLogLiftDerivative,
      variableCartanConnection, σ3c, Matrix.mul_apply, Fin.sum_univ_two,
      Matrix.smul_apply, hpm, mul_assoc, mul_comm, mul_left_comm] <;>
    ring

/-- Local integrability packet: the directional derivative is genuine and its
left Maurer--Cartan quotient is the variable connection. -/
theorem local_pure_gauge_packet
    {s : ℂ} (hs : s ∈ punctured01)
    (hslit : crossRatio01 s ∈ Complex.slitPlane) (v : ℂ) :
    HasDerivAt
        (fun t : ℂ => halfLogLift (s + t * v))
        (halfLogLiftDifferential s v) 0 ∧
      halfLogLiftInv s * halfLogLiftDifferential s v =
        variableCartanConnection s v := by
  exact ⟨hasDerivAt_halfLogLift_along hs hslit v,
    halfLogLiftInv_mul_differential s v⟩

/-- Compact variable-connection packet. -/
theorem bipolar_variable_cartan_packet
    {s : ℂ} (hs : s ∈ punctured01)
    (hslit : crossRatio01 s ∈ Complex.slitPlane) (u v : ℂ) :
    HasDerivAt dlog01 (dlog01Deriv s) s ∧
      variableExteriorDerivative s u v = 0 ∧
      wedge (variableCartanConnection s) (variableCartanConnection s) u v = 0 ∧
      variableCartanCurvature s u v = 0 ∧
      HasDerivAt
        (fun t : ℂ => halfLogLift (s + t * v))
        (halfLogLiftDifferential s v) 0 ∧
      halfLogLiftInv s * halfLogLiftDifferential s v =
        variableCartanConnection s v := by
  exact ⟨hasDerivAt_dlog01 hs,
    by rw [variableExteriorDerivative_eq_zero s]
       ; change (0 : Matrix2C) = 0
       ; rfl,
    by rw [variableCartanConnection_selfWedge_zero s]
       ; change (0 : Matrix2C) = 0
       ; rfl,
    by rw [variableCartanCurvature_eq_zero hs]
       ; change (0 : Matrix2C) = 0
       ; rfl,
    hasDerivAt_halfLogLift_along hs hslit v,
    halfLogLiftInv_mul_differential s v⟩

end InfoGeometry.Canonical.BipolarVariableCartanConnection
