-      (fun _ : Unit => fun ζ => σ ζ)
-      (fun _ n => n) := by
-  intro _ n ζ hζ
-  fin_cases n
-  · exact galois_preserves_cyclotomic10 σ ζ hζ
-  · exact galois_preserves_cyclotomic12 σ ζ hζ
