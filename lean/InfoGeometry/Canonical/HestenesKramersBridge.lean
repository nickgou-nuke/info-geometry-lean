import InfoGeometry.Canonical.OperatorDictionary
import InfoGeometry.Meta.Architecture
import Mathlib.Tactic.Linarith

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.HestenesKramersBridge

Real-carrier Kramers translation in the repo's doubled Hestenes language.

This file does not introduce complex antiunitary primitives. The Kramers partner
is the internal phase-axis image `K ψ`, where `K = J ∘ ε`.
-/

namespace HestenesKramersBridge

open InfoGeometry.Krein
open InfoGeometry.Canonical.OperatorDictionary
open InfoGeometry.Canonical.TomitaTakesaki

section Core

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E

/-- Real-carrier Kramers partner generated by the internal phase axis `K = J ∘ ε`. -/
@[rep_depth krein]
noncomputable def phasePartner (ψ : H₂) : H₂ :=
  InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E) ψ

/-- Kramers partner in repo language: `(ψ, Kψ)`. -/
@[rep_depth krein]
noncomputable def kramersPair (ψ : H₂) : H₂ × H₂ :=
  (ψ, phasePartner (E := E) ψ)

section

omit [CompleteSpace E]

/-- The phase partner is exactly the internal phase-axis action `K ψ`. -/
@[rep_depth krein, simp]
theorem phasePartner_eq_phaseAxisK (ψ : H₂) :
    phasePartner (E := E) ψ =
      InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E) ψ := by
  rfl

end

/-- `K² = -Id` on the doubled carrier. -/
@[rep_depth krein, simp]
theorem phasePartner_phasePartner_eq_neg (ψ : H₂) :
    phasePartner (E := E) (phasePartner (E := E) ψ) = -ψ := by
  change (InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E)).comp
      (InfoGeometry.Canonical.OperatorDictionary.phaseAxisK (E := E)) ψ = -ψ
  simpa using
    congrArg (fun F : H₂ →L[ℝ] H₂ => F ψ) (phaseAxisK_sq_eq_neg_id (E := E))

/--
Hilbert-orthogonality of the real Kramers pair:
`⟪ψ, Kψ⟫ = 0`.
-/
@[rep_depth krein]
theorem inner_first_second_eq_zero (ψ : H₂) :
    ⟪(kramersPair (E := E) ψ).1, (kramersPair (E := E) ψ).2⟫_ℝ = 0 := by
  have hSkew :
      ⟪phasePartner (E := E) ψ, ψ⟫_ℝ = -⟪ψ, phasePartner (E := E) ψ⟫_ℝ := by
    simpa [phasePartner] using phaseAxisK_inner_skew (E := E) ψ ψ
  have hComm :
      ⟪phasePartner (E := E) ψ, ψ⟫_ℝ = ⟪ψ, phasePartner (E := E) ψ⟫_ℝ := by
    simp [real_inner_comm]
  have hSelf :
      ⟪ψ, phasePartner (E := E) ψ⟫_ℝ = -⟪ψ, phasePartner (E := E) ψ⟫_ℝ := by
    linarith [hSkew, hComm]
  have : ⟪ψ, phasePartner (E := E) ψ⟫_ℝ = 0 := by linarith [hSelf]
  simpa [kramersPair] using this

/--
The partner map is nontrivial on nonzero states:
`ψ ≠ 0 → Kψ ≠ ψ`.
-/
@[rep_depth krein]
theorem phasePartner_ne_self_of_ne_zero {ψ : H₂} (hψ : ψ ≠ 0) :
    phasePartner (E := E) ψ ≠ ψ := by
  intro hEq
  have hSq := phasePartner_phasePartner_eq_neg (E := E) ψ
  have hApply : phasePartner (E := E) (phasePartner (E := E) ψ) = phasePartner (E := E) ψ := by
    exact congrArg (phasePartner (E := E)) hEq
  have hNeg : -ψ = ψ := by
    calc
      -ψ = phasePartner (E := E) (phasePartner (E := E) ψ) := by exact hSq.symm
      _ = phasePartner (E := E) ψ := hApply
      _ = ψ := hEq
  have hTwoSum : ψ + ψ = 0 := by
    calc
      ψ + ψ = ψ + (-ψ) := by rw [hNeg]
      _ = 0 := by simp
  have hTwoSmul : (2 : ℝ) • ψ = 0 := by
    simpa [two_smul] using hTwoSum
  have hψ0 : ψ = 0 := by
    exact (smul_eq_zero.mp hTwoSmul).resolve_left (by norm_num)
  exact hψ hψ0

/--
Krein-sign rule for the Kramers partner:
`[Kψ, Kφ] = -[ψ, φ]`.
-/
@[rep_depth krein]
theorem kreinInner_phasePartner_phasePartner (ψ φ : H₂) :
    KreinSpace.kreinInner (H := H₂) (phasePartner (E := E) ψ) (phasePartner (E := E) φ)
      =
    -KreinSpace.kreinInner (H := H₂) ψ φ := by
  simpa [phasePartner] using phaseAxisK_kreinInner_comp (E := E) ψ φ

end Core

end HestenesKramersBridge
