import InfoGeometry.Canonical.ZornThreeGeneratorObstruction

/-!
# Upper-plane associativity criterion for the native Zorn product

The carrier is `SplitOctonionZorn.SplitOctonion`, with its existing
nonassociative multiplication. The associator formula in
`ZornAssociatorKreinBridge` gives an exact zero criterion. Consequently,
three upper vectors whose directions are linear combinations of the same
two vectors have equal bracketings. This extends the Boolean selection
statement in `ZornThreeGeneratorObstruction` to arbitrary real coefficients.

This is an upper-sector statement, not associativity of the entire carrier
or of the subalgebra generated by two arbitrary split octonions.
-/

noncomputable section

namespace InfoGeometry.Canonical.ZornUpperPlaneAssociator

open InfoGeometry.Algebra.SplitOctonionZorn
open InfoGeometry.Canonical.ZornAssociatorKreinBridge

/-- Vanishing of the upper associator is exactly vanishing of oriented volume. -/
theorem associator_upper_eq_zero_iff (u v w : Vec3) :
    associator (upper u) (upper v) (upper w) = 0 ↔ tripleDet u v w = 0 := by
  constructor
  · intro h
    have ha := congrArg SplitOctonion.a h
    rw [associator_upper_coordinates] at ha
    change -tripleDet u v w = 0 at ha
    exact neg_eq_zero.mp ha
  · intro h
    rw [associator_upper_eq_neg_tripleDet_smul_kreinJ, h]
    simp

/-- Every three directions in the same two-vector span have zero triple product. -/
theorem tripleDet_two_vector_combinations (u v : Vec3) (a b c d e f : ℝ) :
    tripleDet (a • u + b • v) (c • u + d • v) (e • u + f • v) = 0 := by
  rcases u with ⟨ux, uy, uz⟩
  rcases v with ⟨vx, vy, vz⟩
  change tripleDet ⟨a * ux + b * vx, a * uy + b * vy, a * uz + b * vz⟩
    ⟨c * ux + d * vx, c * uy + d * vy, c * uz + d * vz⟩
    ⟨e * ux + f * vx, e * uy + f * vy, e * uz + f * vz⟩ = 0
  dsimp [tripleDet, Vector3.dot, Vector3.cross]
  ring

/-- Upper Zorn vectors in a common two-vector plane have zero associator. -/
theorem associator_upper_two_vector_combinations
    (u v : Vec3) (a b c d e f : ℝ) :
    associator (upper (a • u + b • v)) (upper (c • u + d • v))
      (upper (e • u + f • v)) = 0 := by
  apply (associator_upper_eq_zero_iff _ _ _).2
  exact tripleDet_two_vector_combinations u v a b c d e f

end InfoGeometry.Canonical.ZornUpperPlaneAssociator
