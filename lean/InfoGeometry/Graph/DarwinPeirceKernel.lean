import InfoGeometry.OperatorAlgebra.PeirceSpine.IrreduciblePeirceKernel
import Mathlib.Tactic.Abel
import Mathlib.Tactic.FinCases

/-!
# Generic Peirce operator kernel

The results below are identities in an associative ring relative to an
idempotent. They provide an algebraic model, not an identification of the
repository's Python labels, declaration digest distances, or concrete Git
Hodge data with elements of this ring.
-/

namespace InfoGeometry.Graph.DarwinPeirceKernel

open InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel

variable {B : Type*} [Ring B]

def transferPhi (P A C : B) : B := u P A + v P C
def directedCurrent (P A C : B) : B := u P A - v P C
def affinityMetric (P A C : B) : B := anticomm (u P A) (v P C)
def chiralCurvature (P A C : B) : B :=
  InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel.comm (u P A) (v P C)
def corner11 (P X : B) : B := P * X * P
def corner10 (P X : B) : B := P * X * (1 - P)
def corner01 (P X : B) : B := (1 - P) * X * P
def corner00 (P X : B) : B := (1 - P) * X * (1 - P)

/-- The two complementary idempotents indexing the Peirce rows and columns. -/
def peirceIdem (P : B) : Bool → B
  | false => P
  | true => 1 - P

/-- A uniformly indexed Peirce block; index `0` is the `P` corner and index
`1` is its complement. -/
def peirceBlock (P : B) (i j : Bool) (X : B) : B :=
  peirceIdem P i * X * peirceIdem P j
def weakLabel (P A : B) : B := P + u P A
def rawLabelUnion (P Q : B) : B := P + Q
def deduplicatedLabelUnion (P Q : B) : B := P + Q - P * Q

lemma P_left_complement {P : B} (hP : P * P = P) : P * (1 - P) = 0 := by
  rw [mul_sub, mul_one, hP, sub_self]

lemma complement_right_P {P : B} (hP : P * P = P) : (1 - P) * P = 0 := by
  rw [sub_mul, one_mul, hP, sub_self]

macro "peirce_abel" hP:ident : tactic =>
  `(tactic| (
    simp only [defect, anticomm,
               InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel.comm, u, v, weakLabel,
               corner11, corner10, corner01, corner00,
               rawLabelUnion, deduplicatedLabelUnion,
               add_mul, mul_add, sub_mul, mul_sub, one_mul, mul_one,
               mul_zero, zero_mul, sub_self, add_zero, zero_add, sub_zero,
               true_and, and_true,
               mul_assoc, $hP:ident, P_assoc $hP:ident,
               P_left_complement $hP:ident, complement_right_P $hP:ident]
    abel <;> simp))

macro "tetraktys_abel" hP:ident : tactic =>
  `(tactic| (
    simp only [transferPhi, directedCurrent, affinityMetric, chiralCurvature,
      anticomm, InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel.comm, u, v,
      add_mul, mul_add, sub_mul, mul_sub, one_mul, mul_one,
      mul_zero, zero_mul, sub_self, add_zero, zero_add, sub_zero,
      mul_assoc, $hP:ident, P_assoc $hP:ident,
      P_left_complement $hP:ident, complement_right_P $hP:ident]
    abel_nf))

/-! ### Multiplication table of the Peirce tetraktys -/

/-- The four operators generated by the source and sink corners satisfy the
split-quaternion multiplication table. This is an identity in an associative
ring relative to one idempotent; it carries no graph or repository-data map. -/
theorem tetraktys_multiplication_table {P : B} (hP : P * P = P)
    (A C : B) :
    transferPhi P A C * transferPhi P A C = affinityMetric P A C ∧
    directedCurrent P A C * directedCurrent P A C = -affinityMetric P A C ∧
    chiralCurvature P A C * chiralCurvature P A C =
      affinityMetric P A C * affinityMetric P A C ∧
    directedCurrent P A C * transferPhi P A C = chiralCurvature P A C ∧
    transferPhi P A C * directedCurrent P A C = -chiralCurvature P A C ∧
    transferPhi P A C * chiralCurvature P A C =
      -(affinityMetric P A C * directedCurrent P A C) ∧
    directedCurrent P A C * chiralCurvature P A C =
      -(affinityMetric P A C * transferPhi P A C) ∧
    comm (affinityMetric P A C) (transferPhi P A C) = 0 ∧
    comm (affinityMetric P A C) (directedCurrent P A C) = 0 ∧
    comm (affinityMetric P A C) (chiralCurvature P A C) = 0 := by
  refine ⟨by tetraktys_abel hP, by tetraktys_abel hP, by tetraktys_abel hP,
    by tetraktys_abel hP, by tetraktys_abel hP, by tetraktys_abel hP,
    by tetraktys_abel hP, by tetraktys_abel hP, by tetraktys_abel hP,
    by tetraktys_abel hP⟩

/-! ### Algebraic archetype for overlapping weak labels -/

/-- The defect of a raw sum of idempotents is exactly their Jordan overlap. -/
theorem defect_rawLabelUnion_eq_anticomm
    {P Q : B} (hP : P * P = P) (hQ : Q * Q = Q) :
    defect (rawLabelUnion P Q) = anticomm P Q := by
  unfold defect rawLabelUnion anticomm
  simp only [add_mul, mul_add, hP, hQ]
  abel_nf

/-- For commuting idempotents, inclusion--exclusion removes the overlap and
produces an idempotent union. -/
theorem deduplicatedLabelUnion_idempotent
    {P Q : B} (hP : P * P = P) (hQ : Q * Q = Q)
    (hPQ : P * Q = Q * P) :
    defect (deduplicatedLabelUnion P Q) = 0 := by
  have hPQP : P * (Q * P) = P * Q := by
    calc
      P * (Q * P) = P * (P * Q) := by rw [hPQ]
      _ = P * Q := P_assoc hP Q
  have hPQQ : P * (Q * Q) = P * Q := by
    rw [hQ]
  have hQPP : Q * (P * Q) = P * Q := by
    calc
      Q * (P * Q) = (Q * P) * Q := by rw [← mul_assoc]
      _ = (P * Q) * Q := by rw [hPQ]
      _ = P * (Q * Q) := by rw [mul_assoc]
      _ = P * Q := hPQQ
  have hPQsq : P * (Q * (P * Q)) = P * Q := by
    calc
      P * (Q * (P * Q)) = P * (P * Q) := by rw [hQPP]
      _ = P * Q := P_assoc hP Q
  unfold defect deduplicatedLabelUnion
  simp only [sub_mul, mul_sub, add_mul, mul_add, mul_assoc,
    hP, hQ, hPQ, P_assoc hQ P, hPQP]
  abel_nf

lemma P_mul_sourceCone {P : B} (hP : P * P = P) (A : B) :
    P * u P A = u P A := by
  unfold u
  rw [← mul_assoc, P_assoc hP]

lemma sourceCone_mul_P {P : B} (hP : P * P = P) (A : B) :
    u P A * P = 0 := by
  unfold u
  rw [mul_assoc, complement_right_P hP, mul_zero]

lemma sourceCone_mul_sourceCone {P : B} (hP : P * P = P) (A A' : B) :
    u P A * u P A' = 0 := by
  unfold u
  calc
    (P * A * (1 - P)) * (P * A' * (1 - P)) =
        ((P * A) * ((1 - P) * P)) * (A' * (1 - P)) := by
      simp only [mul_assoc]
    _ = 0 := by rw [complement_right_P hP]; simp

/-- A source-cone weak label is an idempotent. -/
theorem weakLabel_idempotent {P : B} (hP : P * P = P) (A : B) :
    defect (weakLabel P A) = 0 := by
  have hPu := P_mul_sourceCone hP A
  have huP := sourceCone_mul_P hP A
  have huu := sourceCone_mul_sourceCone hP A A
  unfold defect weakLabel
  simp only [add_mul, mul_add, hP, hPu, huP, huu, add_zero]
  abel_nf

/-- Multiplying two source-cone labels in order returns the second label. -/
theorem weakLabel_ordered_product {P : B} (hP : P * P = P)
    (A Btag : B) :
    weakLabel P A * weakLabel P Btag = weakLabel P Btag := by
  have hPB := P_mul_sourceCone hP Btag
  have hAP := sourceCone_mul_P hP A
  have hAB := sourceCone_mul_sourceCone hP A Btag
  unfold weakLabel
  simp only [add_mul, mul_add, hP, hPB, hAP, hAB, add_zero]

/-- The order-dependent commutator records the difference of weak facets. -/
theorem weakLabel_commutator {P : B} (hP : P * P = P)
    (A Btag : B) :
    InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel.comm
      (weakLabel P A) (weakLabel P Btag) = u P (Btag - A) := by
  unfold InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel.comm
  rw [weakLabel_ordered_product hP A Btag,
      weakLabel_ordered_product hP Btag A]
  unfold weakLabel u
  simp only [mul_sub, sub_mul]
  abel_nf

/-- Reversing the Peirce root exchanges source and sink cones. -/
theorem rootReversal_exchanges_cones (P A C : B) :
    u (1 - P) C = v P C ∧
    v (1 - P) A = u P A := by
  have hComp : 1 - (1 - P) = P := by abel
  constructor
  · unfold u v
    rw [hComp]
  · unfold v u
    rw [hComp]

/-- Symmetric transfer and affinity are root-invariant; directed current and
chiral curvature reverse sign under root reversal with swapped inputs. -/
theorem rootReversal_symmetric_vs_directed (P A C : B) :
    transferPhi (1 - P) C A = transferPhi P A C ∧
    affinityMetric (1 - P) C A = affinityMetric P A C ∧
    directedCurrent (1 - P) C A = -directedCurrent P A C ∧
    chiralCurvature (1 - P) C A = -chiralCurvature P A C := by
  rcases rootReversal_exchanges_cones P A C with ⟨hSource, hSink⟩
  unfold transferPhi affinityMetric directedCurrent chiralCurvature
  rw [hSource, hSink]
  simp only [anticomm,
    InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel.comm]
  refine ⟨by abel, by constructor <;> [abel; constructor <;> [abel; abel]]⟩

/-- Commuting the symmetric transfer with the root idempotent recovers the
directed current. This is an identity of the abstract Peirce terms; it does
not identify a concrete Git graph with elements of `B`. -/
theorem root_commutator_recovers_directedCurrent {P : B}
    (hP : P * P = P) (A C : B) :
    InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel.comm P
      (transferPhi P A C) = directedCurrent P A C := by
  have hPu := P_mul_sourceCone hP A
  have huP := sourceCone_mul_P hP A
  have hLeftComp := P_left_complement hP
  have hPv : P * v P C = 0 := by
    unfold v
    have hLeftC : P * ((1 - P) * C) = 0 := by
      calc
        P * ((1 - P) * C) = (P * (1 - P)) * C := by simp only [mul_assoc]
        _ = 0 := by rw [hLeftComp]; simp
    calc
      P * ((1 - P) * C * P) = (P * ((1 - P) * C)) * P := by
        simp only [mul_assoc]
      _ = 0 := by rw [hLeftC]; simp
  have hvP : v P C * P = v P C := by
    unfold v
    rw [mul_assoc, hP]
  unfold InfoGeometry.OperatorAlgebra.IrreduciblePeirceKernel.comm
    transferPhi directedCurrent
  simp only [mul_add, add_mul, hPu, hPv, huP, hvP, add_zero, zero_add]

/-- The four Peirce corners reconstruct every element relative to an
idempotent. -/
theorem peirce_reconstruct {P : B} (_hP : P * P = P) (X : B) :
    corner11 P X + corner10 P X + corner01 P X + corner00 P X = X := by
  peirce_abel _hP

/-- Distinct Peirce row and column idempotents are orthogonal. -/
theorem peirceIdem_mul_of_ne {P : B} (hP : P * P = P)
    {i j : Bool} (hij : i ≠ j) : peirceIdem P i * peirceIdem P j = 0 := by
  cases i <;> cases j
  · exact (hij rfl).elim
  · simpa [peirceIdem] using P_left_complement hP
  · simpa [peirceIdem] using complement_right_P hP
  · exact (hij rfl).elim

/-- Both Peirce row idempotents are idempotent. -/
theorem peirceIdem_idempotent {P : B} (hP : P * P = P) (i : Bool) :
    peirceIdem P i * peirceIdem P i = peirceIdem P i := by
  cases i
  · exact hP
  · unfold peirceIdem
    simp only [sub_mul, mul_sub, one_mul, mul_one, hP]
    abel

/-- In a product of two Peirce blocks, incompatible middle indices force the
product to vanish. This is the matrix-unit composition rule's zero case. -/
theorem peirceBlock_mul_of_middle_ne {P : B} (hP : P * P = P)
    (i j k l : Bool) (X Y : B) (hjk : j ≠ k) :
    peirceBlock P i j X * peirceBlock P k l Y = 0 := by
  unfold peirceBlock
  calc
    (peirceIdem P i * X * peirceIdem P j) *
        (peirceIdem P k * Y * peirceIdem P l) =
      peirceIdem P i * X * (peirceIdem P j * peirceIdem P k) *
        Y * peirceIdem P l := by simp only [mul_assoc]
    _ = 0 := by rw [peirceIdem_mul_of_ne hP hjk]; simp

/-- The full Peirce block multiplication rule. Matching middle indices retain
the shared corner idempotent; mismatching indices give zero. -/
theorem peirceBlock_mul {P : B} (hP : P * P = P)
    (i j k l : Bool) (X Y : B) :
    peirceBlock P i j X * peirceBlock P k l Y =
      if j = k then peirceIdem P i * X * peirceIdem P j * Y * peirceIdem P l
      else 0 := by
  by_cases hjk : j = k
  · subst k
    have hIdem := peirceIdem_idempotent hP j
    unfold peirceBlock
    calc
      (peirceIdem P i * X * peirceIdem P j) *
          (peirceIdem P j * Y * peirceIdem P l) =
        peirceIdem P i * X * (peirceIdem P j * peirceIdem P j) *
          Y * peirceIdem P l := by simp only [mul_assoc]
      _ = peirceIdem P i * X * peirceIdem P j * Y * peirceIdem P l := by
        rw [hIdem]
      _ = if j = j then peirceIdem P i * X * peirceIdem P j * Y *
          peirceIdem P l else 0 := by simp
  · rw [peirceBlock_mul_of_middle_ne hP i j k l X Y hjk]
    simp [hjk]

/-- Equality of operators is equivalent to equality in each of their four
Peirce corners. -/
theorem equal_iff_all_peirce_corners_equal {P : B} (hP : P * P = P)
    (X Y : B) :
    X = Y ↔ corner11 P X = corner11 P Y ∧
      corner10 P X = corner10 P Y ∧
      corner01 P X = corner01 P Y ∧
      corner00 P X = corner00 P Y := by
  constructor
  · intro h
    subst Y
    exact ⟨rfl, rfl, rfl, rfl⟩
  · rintro ⟨h11, h10, h01, h00⟩
    calc
      X = corner11 P X + corner10 P X + corner01 P X + corner00 P X :=
        (peirce_reconstruct hP X).symm
      _ = corner11 P Y + corner10 P Y + corner01 P Y + corner00 P Y := by
        rw [h11, h10, h01, h00]
      _ = Y := peirce_reconstruct hP Y

def relativeIdempotentComplement (sub anc : B) : B := anc - sub

/-- If one idempotent is a two-sided sub-idempotent of another, their
difference is an idempotent orthogonal to the sub-idempotent. -/
theorem nested_idempotent_complement
    {sub anc : B} (hSubIdem : sub * sub = sub)
    (hAncIdem : anc * anc = anc)
    (hSubAnc : sub * anc = sub) (hAncSub : anc * sub = sub) :
    defect (relativeIdempotentComplement sub anc) = 0 ∧
    sub * relativeIdempotentComplement sub anc = 0 ∧
    relativeIdempotentComplement sub anc * sub = 0 := by
  unfold defect relativeIdempotentComplement
  constructor
  · simp only [sub_mul, mul_sub, hSubIdem, hAncIdem, hSubAnc, hAncSub]
    abel
  · constructor
    · simp only [mul_sub, hSubAnc, hSubIdem, sub_self]
    · simp only [sub_mul, hAncSub, hSubIdem, sub_self]

def splitIdempotentPolarity (left right : B) : B := left - right

/-- The difference of orthogonal idempotents is tripotent, and its square is
their sum. -/
theorem orthogonal_idempotents_form_mrca_tripotent
    {left right : B} (hLeft : left * left = left)
    (hRight : right * right = right)
    (hLR : left * right = 0) (hRL : right * left = 0) :
    splitIdempotentPolarity left right * splitIdempotentPolarity left right =
      left + right ∧
    splitIdempotentPolarity left right * splitIdempotentPolarity left right *
      splitIdempotentPolarity left right = splitIdempotentPolarity left right := by
  have hSq : splitIdempotentPolarity left right *
      splitIdempotentPolarity left right = left + right := by
    unfold splitIdempotentPolarity
    simp only [sub_mul, mul_sub, hLeft, hRight, hLR, hRL,
      sub_zero, zero_sub]
    abel
  refine ⟨hSq, ?_⟩
  rw [hSq]
  unfold splitIdempotentPolarity
  simp only [mul_sub, add_mul, hLeft, hRight, hLR, hRL,
    add_zero, zero_add]

end InfoGeometry.Graph.DarwinPeirceKernel
