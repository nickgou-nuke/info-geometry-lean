import InfoGeometry.Categorical.LogJordanTensorPowerBraidSector
import InfoGeometry.Categorical.LogNilpotentTensorPowerBraid

/-!
# Bridge from recursive tensor powers to the generated monoidal sector

`LogJordanTensorPowerBraidSector` owns the full monoidal subcategory generated by
the standard Jordan object using tensor syntax trees.  The arbitrary-Bn layer
uses a convenient right-associated recursive tensor-power definition.  This
file proves those are the same ambient logarithmic objects.
-/

noncomputable section

namespace InfoGeometry.Categorical.LogJordanTensorPowerSectorBridge

open InfoGeometry.Categorical.LogNilpotentTensorPowerBraid
open InfoGeometry.Categorical.LogJordanTensorPowerBraidSector
open InfoGeometry.Categorical.LogJordanCheckedRBraidBridge

/-- The recursive right-associated tensor power is exactly the interpretation
of the canonical tensor word in the generated logarithmic monoidal sector. -/
theorem tensorPowerObj_eq_sector :
    ∀ n : ℕ,
      tensorPowerObj standardJordanObject n = (standardTensorPower n).1
  | 0 => rfl
  | 1 => rfl
  | n + 2 => by
      change
        InfoGeometry.Categorical.LogNilpotentModuleCategory.LogNilpotentModule.tensorObj
            standardJordanObject (tensorPowerObj standardJordanObject (n + 1)) =
          InfoGeometry.Categorical.LogNilpotentModuleCategory.LogNilpotentModule.tensorObj
            standardJordanObject ((standardTensorPower (n + 1)).1)
      rw [tensorPowerObj_eq_sector (n + 1)]

/-- Every recursive tensor-power carrier therefore belongs to the existing
full generated tensor-power subcategory. -/
def recursiveTensorPowerSectorObject (n : ℕ) : TensorPowerSubcategory :=
  standardTensorPower n

end InfoGeometry.Categorical.LogJordanTensorPowerSectorBridge
