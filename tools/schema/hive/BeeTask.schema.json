{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BeeTask.schema.json",
  "title": "BeeTask",
  "description": "Ephemeral MotherBee dispatch envelope. A BeeTask assigns bounded compute over validated packets; it is not mathematical authority and does not itself raise packet authority.",
  "allOf": [
    {
      "$ref": "common_envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "task_id",
        "assigned_role",
        "task_kind",
        "input_packet_ids",
        "allowed_output_kinds",
        "forbidden_output_kinds",
        "authority_ceiling",
        "instruction",
        "dry_run"
      ],
      "properties": {
        "kind": {
          "const": "BeeTask"
        },
        "status": {
          "enum": [
            "pending",
            "claimed",
            "running",
            "completed",
            "blocked",
            "failed",
            "cancelled"
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "assigned_role": {
          "type": "string",
          "enum": [
            "MotherBee",
            "SourceBee",
            "RetrieverBee",
            "SocratesBee",
            "PauliBee",
            "TranslatorBee",
            "ThinkingBee",
            "DreamlineBee",
            "ShadowBee",
            "LeanBee",
            "BuildBee",
            "AuditBee",
            "PromotionBee"
          ]
        },
        "task_kind": {
          "type": "string",
          "enum": [
            "source.capture",
            "retrieval.context",
            "socratic.question",
            "pauli.critique",
            "candidate.translate",
            "candidate.formulate",
            "dreamline.explore",
            "shadow.reroute",
            "lean.verify",
            "build.verify",
            "audit.semantic",
            "promotion.decide"
          ]
        },
        "target_packet_id": {
          "type": "string",
          "minLength": 1
        },
        "input_packet_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context_refs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "source_ref.schema.json"
              }
            ]
          }
        },
        "repulsion_field": {
          "type": "array",
          "description": "Packet hashes or packet ids for known failed/blocked trajectories that the bee must treat as non-authority repulsive context.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_output_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_output_kinds": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "PromotionDecisionPacket"
          },
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority_ceiling": {
          "type": "string",
          "enum": [
            "navigation",
            "semantic",
            "proposal",
            "execution_intent",
            "lean_checked",
            "build_checked",
            "audit_checked",
            "promoted"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer"
        },
        "store_path": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer"
        },
        "claimed_by": {
          "type": "string"
        },
        "claim_token": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  ]
}
