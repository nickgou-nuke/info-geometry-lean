import InfoGeometry.OperatorAlgebra.KreinAdjoint
import InfoGeometry.Algebra.CuntzSharpTangent

/-!
# Krein-inner commutator derivations

The associative operator envelope carries the infinitesimal action of a
Krein-skew generator by commutator. This is the operator-level bridge from
split infinitesimal symmetries to star-compatible Cuntz tangent data.
-/

namespace InfoGeometry.OperatorAlgebra

open InfoGeometry.Krein
open InfoGeometry.Krein.KreinSpace
open InfoGeometry.Algebra.Cuntz
open scoped InnerProductSpace

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [KreinSpace H]

/-- Commutator with an operator generator. -/
def kreinCommutator (D : H →L[ℝ] H) :
    (H →L[ℝ] H) →+ (H →L[ℝ] H) where
  toFun T := D * T - T * D
  map_zero' := by
    change D * 0 - 0 * D = 0
    simp only [mul_zero, zero_mul, sub_zero]
  map_add' := by intro T U; noncomm_ring

@[simp] theorem kreinCommutator_apply
    (D T : H →L[ℝ] H) :
    kreinCommutator D T = D * T - T * D :=
  rfl

theorem kreinCommutator_leibniz
    (D T U : H →L[ℝ] H) :
    kreinCommutator D (T * U) =
      kreinCommutator D T * U + T * kreinCommutator D U := by
  change D * (T * U) - (T * U) * D =
    (D * T - T * D) * U + T * (D * U - U * D)
  noncomm_ring

theorem kreinCommutator_smul
    (D T : H →L[ℝ] H) (c : ℝ) :
    kreinCommutator D (c • T) = c • kreinCommutator D T := by
  change D * (c • T) - (c • T) * D = c • (D * T - T * D)
  rw [smul_mul_assoc, mul_smul_comm, smul_sub]

/-- A Krein-skew generator gives a Krein-star-compatible commutator derivation. -/
theorem kreinCommutator_kreinStar
    (D T : H →L[ℝ] H)
    (hD : IsKreinSkewAdjoint D) :
    kreinCommutator D (kreinAdjoint T) =
      kreinAdjoint (kreinCommutator D T) := by
  unfold kreinAdjoint
  change D * InfoGeometry.Krein.KreinSpace.kreinAdjoint T -
      InfoGeometry.Krein.KreinSpace.kreinAdjoint T * D =
    InfoGeometry.Krein.KreinSpace.kreinAdjoint (D * T - T * D)
  rw [InfoGeometry.Krein.KreinSpace.kreinAdjoint_sub,
    InfoGeometry.Krein.KreinSpace.kreinAdjoint_mul,
    InfoGeometry.Krein.KreinSpace.kreinAdjoint_mul,
    hD, neg_mul, mul_neg]
  noncomm_ring

/-- A derivation of the associative operator envelope preserving the Krein involution. -/
structure KreinStarDerivation where
  toAddHom : (H →L[ℝ] H) →+ (H →L[ℝ] H)
  leibniz' : ∀ T U,
    toAddHom (T * U) = toAddHom T * U + T * toAddHom U
  kreinStar' : ∀ T,
    toAddHom (kreinAdjoint T) = kreinAdjoint (toAddHom T)

/-- The commutator derivation generated by a Krein-skew operator. -/
noncomputable def kreinCommutatorDerivation
    (D : H →L[ℝ] H)
    (hD : IsKreinSkewAdjoint D) :
    KreinStarDerivation (H := H) where
  toAddHom := kreinCommutator D
  leibniz' := by
    intro T U
    exact kreinCommutator_leibniz D T U
  kreinStar' := by
    intro T
    exact kreinCommutator_kreinStar D T hD
/-- The commutator packaged for the explicit-involution Cuntz tangent API. -/
noncomputable def kreinInnerInvolutiveDerivation
    (D : H →L[ℝ] H)
    (hD : IsKreinSkewAdjoint D) :
    InvolutiveDerivation
      (A := H →L[ℝ] H)
      (kreinAdjoint (H := H)) where
  toAddHom := kreinCommutator D
  leibniz' := by
    intro T U
    exact kreinCommutator_leibniz D T U
  sharp' := by
    intro T
    exact kreinCommutator_kreinStar D T hD

end InfoGeometry.OperatorAlgebra
