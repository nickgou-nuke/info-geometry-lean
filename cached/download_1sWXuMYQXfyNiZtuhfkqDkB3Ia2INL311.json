    superDerivJ P A C (invS P) = -((2 : ℤ) • genPhi P A C) ∧
    -- 2. "Boundary of a Boundary is Zero" on `invS P` (`d_Φ²(S) = 0`, `d_J²(S) = 0`):
    superDerivPhi P A C (superDerivPhi P A C (invS P)) = 0 ∧
    superDerivJ P A C (superDerivJ P A C (invS P)) = 0 ∧
