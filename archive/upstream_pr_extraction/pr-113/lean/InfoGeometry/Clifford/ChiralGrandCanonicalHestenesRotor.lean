import InfoGeometry.Clifford.SplitQ11Projectors
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic

/-!
# Native Hestenes boost rotor for the chiral thermal coordinate

The split `Cl(1,1)` pseudoscalar is a genuine noncommutative operator with
square `+1`.  Its hyperbolic rotor is therefore the exact Clifford analogue
of the reciprocal thermal weights.  No complex scalar extension is used.
-/

noncomputable section

namespace InfoGeometry.Clifford.ChiralGrandCanonicalHestenesRotor

open InfoGeometry.Clifford.SplitQ11PhaseFlip
open InfoGeometry.Clifford.SplitQ11Projectors

abbrev Operator := Alg

/-- Hyperbolic Hestenes rotor generated by the split pseudoscalar. -/
def boostRotor (η : ℝ) : Operator :=
  Real.cosh η • (1 : Operator) + Real.sinh η • epsGen

@[simp] theorem boostRotor_zero : boostRotor 0 = 1 := by
  unfold boostRotor
  simp

theorem boostRotor_mul_neg (η : ℝ) :
    boostRotor η * boostRotor (-η) = 1 := by
  calc
    boostRotor η * boostRotor (-η) =
        (Real.cosh η * Real.cosh η - Real.sinh η * Real.sinh η) •
          (1 : Operator) := by
            unfold boostRotor
            simp [Real.cosh_neg, Real.sinh_neg, add_mul, mul_add,
              epsGen_sq]
            module
    _ = 1 := by
      have h := Real.cosh_sq_sub_sinh_sq η
      rw [show Real.cosh η * Real.cosh η - Real.sinh η * Real.sinh η = 1 by
        simpa [pow_two] using h]
      simp

theorem boostRotor_neg_mul (η : ℝ) :
    boostRotor (-η) * boostRotor η = 1 := by
  simpa only [neg_neg] using boostRotor_mul_neg (-η)

def boostRotorUnit (η : ℝ) : Operatorˣ where
  val := boostRotor η
  inv := boostRotor (-η)
  val_inv := boostRotor_mul_neg η
  inv_val := boostRotor_neg_mul η

theorem boostRotor_isUnit (η : ℝ) : IsUnit (boostRotor η) := by
  exact ⟨boostRotorUnit η, rfl⟩

/-- The rotor has reciprocal eigenvalues on the two native `epsGen` projectors. -/
theorem boostRotor_mul_epsPlusProjector (η : ℝ) :
    boostRotor η * epsPlusProjector =
      (Real.cosh η + Real.sinh η) • epsPlusProjector := by
  calc
    boostRotor η * epsPlusProjector =
        Real.cosh η • ((1 : Operator) * epsPlusProjector) +
          Real.sinh η • (epsGen * epsPlusProjector) := by
            unfold boostRotor
            rw [add_mul, smul_mul_assoc, smul_mul_assoc]
    _ = (Real.cosh η + Real.sinh η) • epsPlusProjector := by
      rw [one_mul, epsGen_mul_epsPlusProjector]
      module

theorem boostRotor_mul_epsMinusProjector (η : ℝ) :
    boostRotor η * epsMinusProjector =
      (Real.cosh η - Real.sinh η) • epsMinusProjector := by
  calc
    boostRotor η * epsMinusProjector =
        Real.cosh η • ((1 : Operator) * epsMinusProjector) +
          Real.sinh η • (epsGen * epsMinusProjector) := by
            unfold boostRotor
            rw [add_mul, smul_mul_assoc, smul_mul_assoc]
    _ = (Real.cosh η - Real.sinh η) • epsMinusProjector := by
      rw [one_mul, epsGen_mul_epsMinusProjector]
      module

theorem boostRotor_projector_weights (η : ℝ) :
    Real.cosh η + Real.sinh η = Real.exp η ∧
      Real.cosh η - Real.sinh η = Real.exp (-η) := by
  exact ⟨Real.cosh_add_sinh η, by
    rw [Real.cosh_sub_sinh, Real.exp_neg]⟩

/-- Elliptic Hestenes phase rotor generated by the square-minus-one axis `kGen`. -/
def phaseRotor (θ : ℝ) : Operator :=
  Real.cos θ • (1 : Operator) + Real.sin θ • kGen

theorem phaseRotor_mul_neg (θ : ℝ) :
    phaseRotor θ * phaseRotor (-θ) = 1 := by
  calc
    phaseRotor θ * phaseRotor (-θ) =
        (Real.cos θ * Real.cos θ + Real.sin θ * Real.sin θ) •
          (1 : Operator) := by
            unfold phaseRotor
            simp [Real.cos_neg, Real.sin_neg, add_mul, mul_add, kGen_sq]
            module
    _ = 1 := by
      have h := Real.cos_sq_add_sin_sq θ
      rw [show Real.cos θ * Real.cos θ + Real.sin θ * Real.sin θ = 1 by
        simpa [pow_two] using h]
      simp

theorem phaseRotor_neg_mul (θ : ℝ) :
    phaseRotor (-θ) * phaseRotor θ = 1 := by
  simpa only [neg_neg] using phaseRotor_mul_neg (-θ)

theorem boost_phase_generators_anticommute :
    epsGen * kGen + kGen * epsGen = 0 := by
  rw [epsGen_mul_kGen, kGen_mul_epsGen]
  simp [jGen]

end InfoGeometry.Clifford.ChiralGrandCanonicalHestenesRotor
