import InfoGeometry.Canonical.CertifiedModularReduction
import InfoGeometry.Meta.Architecture

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.BogoliubovOptimalTransport

Canonical regular-lane optimal-transport surfaces for Bogoliubov evolution.

This file keeps to owner data already present in `CertifiedModularReduction`:
- `Preg/Pzero` projector split,
- regular generator `Kambient`,
- certified support/kill laws.

No new physics axioms are introduced.
-/

namespace InfoGeometry.Canonical.BogoliubovOptimalTransport

open InfoGeometry.Canonical

section Core

variable {E : Type*}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "EndH" => E →L[ℝ] E

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance
local instance : SMulCommClass ℝ EndH EndH := inferInstance
local instance : IsScalarTower ℝ EndH EndH := inferInstance

/--
Alignment obstruction for the regular-lane generator against `Preg`.
-/
@[rep_depth operator]
noncomputable def alignmentObstruction
    (c : CertifiedModularReduction (E := E)) : EndH :=
  c.Kambient * c.Preg - c.Preg * c.Kambient

/--
Certified regular-lane support implies zero alignment obstruction.
-/
@[rep_depth operator]
theorem alignmentObstruction_eq_zero
    (c : CertifiedModularReduction (E := E)) :
    alignmentObstruction c = 0 := by
  unfold alignmentObstruction
  have hSupp := c.Kambient_supported_on_Preg
  calc
    c.Kambient * c.Preg - c.Preg * c.Kambient
        = c.Kambient - c.Kambient := by rw [hSupp.2, hSupp.1]
    _ = 0 := by simp

/--
Owner `χ`-obstruction for inertial-vs-curved transport regime:
the certified spectral/metric anomaly.
-/
@[rep_depth operator]
noncomputable def chiObstruction
    (c : CertifiedModularReduction (E := E)) : EndH :=
  c.anomaly

/--
`χ = 0` exactly when spectral and metric support lanes are aligned.
-/
@[rep_depth operator]
theorem chiObstruction_eq_zero_iff_alignment
    (c : CertifiedModularReduction (E := E)) :
    chiObstruction c = 0 ↔ c.SpectralMetricAlignment := by
  simpa [chiObstruction] using c.anomaly_vanishes_iff_alignment

/--
Curved lane (`χ ≠ 0`) is exactly non-alignment of spectral and metric supports.
-/
@[rep_depth operator]
theorem chiObstruction_ne_zero_iff_non_alignment
    (c : CertifiedModularReduction (E := E)) :
    chiObstruction c ≠ 0 ↔ ¬ c.SpectralMetricAlignment := by
  simpa [chiObstruction] using
    c.curved_regular_lane_iff_non_alignment

/--
Regular-lane optimality condition for an operator flow `U`.
-/
@[rep_depth operator]
def IsOptimalBogoliubovFlow
    (c : CertifiedModularReduction (E := E))
    (U : ℝ → EndH) : Prop :=
  ∀ t : ℝ, U t * c.Preg = c.Preg * U t

/--
Interface theorem: any flow constructor that turns `χ = 0` into commutation
with `Preg` yields an optimal Bogoliubov flow.
-/
@[rep_depth transport, capstone]
theorem optimal_transport_of_alignment_zero
    (c : CertifiedModularReduction (E := E))
    (U : ℝ → EndH)
    (hFlowGenerates :
      ∀ t : ℝ, alignmentObstruction c = 0 → U t * c.Preg = c.Preg * U t)
    (hAlign : alignmentObstruction c = 0) :
    IsOptimalBogoliubovFlow c U := by
  intro t
  exact hFlowGenerates t hAlign

/--
Canonical exponential flow generated by the regular-lane modular Hamiltonian.
-/
@[rep_depth operator]
noncomputable def canonicalBogoliubovFlow
    (c : CertifiedModularReduction (E := E))
    (t : ℝ) : EndH :=
  NormedSpace.exp (t • c.Kambient)

/--
The canonical exponential Bogoliubov flow is regular-lane optimal.
-/
@[rep_depth transport, capstone]
theorem canonicalBogoliubovFlow_isOptimal
    (c : CertifiedModularReduction (E := E)) :
    IsOptimalBogoliubovFlow c (canonicalBogoliubovFlow c) := by
  intro t
  have hSupp := c.Kambient_supported_on_Preg
  have hCommKP : Commute c.Preg c.Kambient := by
    calc
      c.Preg * c.Kambient = c.Kambient := hSupp.1
      _ = c.Kambient * c.Preg := by symm; exact hSupp.2
  have hCommFlow : Commute c.Preg (NormedSpace.exp (t • c.Kambient)) := by
    simpa using ((hCommKP.smul_right t).exp_right)
  simpa [canonicalBogoliubovFlow] using hCommFlow.eq.symm

/--
No defect leakage for `Preg`-invariant states under an optimal flow.

`hPzeroMulPreg` is the structural split law `Pzero * Preg = 0`.
-/
@[rep_depth transport, capstone]
theorem no_defect_leakage_of_optimal_flow
    (c : CertifiedModularReduction (E := E))
    (U : ℝ → EndH)
    (hOptimal : IsOptimalBogoliubovFlow c U)
    (hPzeroMulPreg : c.Pzero * c.Preg = 0)
    (v : E) (hReg : c.Preg v = v) (t : ℝ) :
    c.Pzero (U t v) = 0 := by
  have hCommEval : U t (c.Preg v) = c.Preg (U t v) := by
    simpa [ContinuousLinearMap.mul_apply] using congrArg (fun T : EndH => T v) (hOptimal t)
  have hRegAfter : c.Preg (U t v) = U t v := by
    calc
      c.Preg (U t v) = U t (c.Preg v) := by exact hCommEval.symm
      _ = U t v := by simp [hReg]
  calc
    c.Pzero (U t v)
        = c.Pzero (c.Preg (U t v)) := by rw [hRegAfter]
    _ = (c.Pzero * c.Preg) (U t v) := by
          simp [ContinuousLinearMap.mul_apply]
    _ = 0 := by
          rw [hPzeroMulPreg]
          simp

end Core

end InfoGeometry.Canonical.BogoliubovOptimalTransport
