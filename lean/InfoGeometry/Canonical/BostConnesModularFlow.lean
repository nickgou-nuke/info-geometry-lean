import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Arithmetic.BostConnesSystem
import InfoGeometry.Canonical.DiscreteModularSpectrum

/-!
# Bost-Connes Geometric Modular Flow

This module records an arithmetic modular-flow interface for the chosen
Bost--Connes generators.

The main formal content is the scaling law
`σ_t(μ_n) = n^{it} μ_n` encoded in `ArithmeticModularFlow`.
-/

noncomputable section

namespace InfoGeometry.Canonical.BostConnesModularFlow

open InfoGeometry.Arithmetic.BostConnesSystem

universe u

variable {Op : Type u} [NormedRing Op] [NormedAlgebra ℂ Op] [StarRing Op]

/-!
## 1. The Bost-Connes Geometric Modular Flow

The modular flow σ_t is packaged here only through its action on the indexed
generators.
-/

/-- 
The modular flow applied to the indexed Bost--Connes generators.

The scaling equates to `n^{it} = e^{i t \ln n}`.
-/
structure ArithmeticModularFlow (C : CuntzMultiplicativeIndexing Op) where
  /-- The modular flow operator at time t. -/
  σ : ℝ → (Op →L[ℂ] Op)
  /-- The modular flow scales the arithmetic isometry by n^{it}. -/
  scaling : ∀ (t : ℝ) (n : ℕ+), 
    σ t (C.generator n) = (Complex.exp (Complex.I * (t : ℂ) * (Real.log (n.val : ℝ) : ℂ))) • C.generator n

/-!
## 2. Formal Flow Intertwining (Liouville Grading)

The Liouville arithmetic grading `Γ`, generated by prime-factor parity,
commutes with the same scalar scaling law on generators.
-/

/--
The Liouville/modular intertwining condition on generators.
-/
structure LiouvilleModularInvariance (C : CuntzMultiplicativeIndexing Op) (F : ArithmeticModularFlow C) where
  Γ : Op →L[ℂ] Op
  /-- The grading operator evaluates identically over the shifted basis. -/
  commutes_with_flow : ∀ (t : ℝ) (n : ℕ+), 
    Γ (F.σ t (C.generator n)) = F.σ t (Γ (C.generator n))

/--
Construct the Liouville grading modular invariance from the scalar scaling actions of Γ and σ.
-/
def makeLiouvilleModularInvariance
    (C : CuntzMultiplicativeIndexing Op)
    (F : ArithmeticModularFlow C)
    (Γ : Op →L[ℂ] Op)
    (h_Γ : ∀ (n : ℕ+), Γ (C.generator n) = ((liouville n : ℂ)) • C.generator n) :
    LiouvilleModularInvariance C F where
  Γ := Γ
  commutes_with_flow t n := by
    rw [F.scaling t n, map_smul, h_Γ n, map_smul, F.scaling t n]
    simp [smul_smul, mul_comm]

/--
Generator-level commutation theorem packaged through
`LiouvilleModularInvariance`.
-/
theorem witten_index_conserved_under_flow
    (C : CuntzMultiplicativeIndexing Op) 
    (F : ArithmeticModularFlow C)
    (L : LiouvilleModularInvariance C F) 
    (t : ℝ) (n : ℕ+) :
    L.Γ (F.σ t (C.generator n)) = F.σ t (L.Γ (C.generator n)) := by
  exact L.commutes_with_flow t n

end InfoGeometry.Canonical.BostConnesModularFlow

