import InfoGeometry.Canonical.BipolarTwoSheetOperatorConnectionBridge
import InfoGeometry.Information.ModularSurprisalDerivationBridge
import InfoGeometry.OperatorAlgebra.OperatorExteriorAlgebra
import Mathlib.Tactic

/-!
# Bipolar logarithmic inner derivation and adjoint characters

The correct operator replacement for a coordinate derivative is a genuine
Leibniz derivation. This file applies the repository-owned inner derivations

`adK(K)(X) = KX - XK`

and packages the complex-linear form as the repository-native `OpDerivation`
for the combined bipolar Cartan generator

`K(s) = eta(s) Kboost + theta(s) Kcirc`.

The exact algebraic correction is that `Kboost` and `Kcirc` are two real
coordinate directions in one complex Cartan line, not two independent complex
Cartan generators: `Kcirc = i Kboost`. Consequently

`K(s) = (W(s)/2) sigma3`, where `W(s) = bipolarLog(s)`.

The two parabolic sheet generators are root eigenoperators with eigenvalues
`+W(s)` and `-W(s)`. Their finite conjugation weights are the genuine
exponential characters

`chi_plus(w) = exp(w)`, `chi_minus(w) = exp(-w)`.

On the punctured bipolar domain `exp(W(s)) = q(s)`, so these become the exact
multiplicative weights `q(s)` and `q(s)^(-1)`. On the critical line the radial
coordinate vanishes and both characters have unit norm.

No global principal-log additivity, matrix-exponential series identity,
particle-hole identification, or dynamical gauge statement is inferred.
-/

noncomputable section

namespace InfoGeometry.Canonical.BipolarLogarithmicDerivationBridge

open InfoGeometry.Analysis.BipolarCrossRatioLog
open InfoGeometry.Canonical.BipolarTwoSheetOperatorConnectionBridge
open InfoGeometry.Information.ModularSurprisalDerivationBridge
open InfoGeometry.OperatorAlgebra.ExteriorAlgebra
open InfoGeometry.Physics.ChiralCausalCone
open InfoGeometry.Canonical.BipolarLogSL2

abbrev Matrix2C := Matrix (Fin 2) (Fin 2) ℂ

/-- Positive root character on the additive complex Cartan parameter. -/
def plusRootCharacter (w : ℂ) : ℂ :=
  Complex.exp w

/-- Negative root character on the additive complex Cartan parameter. -/
def minusRootCharacter (w : ℂ) : ℂ :=
  Complex.exp (-w)

@[simp] theorem plusRootCharacter_zero :
    plusRootCharacter 0 = 1 := by
  simp [plusRootCharacter]

@[simp] theorem minusRootCharacter_zero :
    minusRootCharacter 0 = 1 := by
  simp [minusRootCharacter]

/-- The positive root weight exponentiates additively. -/
theorem plusRootCharacter_add (w₁ w₂ : ℂ) :
    plusRootCharacter (w₁ + w₂) =
      plusRootCharacter w₁ * plusRootCharacter w₂ := by
  change Complex.exp (w₁ + w₂) = Complex.exp w₁ * Complex.exp w₂
  rw [Complex.exp_add]

/-- The negative root weight exponentiates additively. -/
theorem minusRootCharacter_add (w₁ w₂ : ℂ) :
    minusRootCharacter (w₁ + w₂) =
      minusRootCharacter w₁ * minusRootCharacter w₂ := by
  change Complex.exp (-(w₁ + w₂)) =
    Complex.exp (-w₁) * Complex.exp (-w₂)
  rw [show -(w₁ + w₂) = -w₁ + -w₂ by ring, Complex.exp_add]

/-- The two root characters are multiplicative inverses. -/
theorem minusRootCharacter_eq_inv (w : ℂ) :
    minusRootCharacter w = (plusRootCharacter w)⁻¹ := by
  simpa [minusRootCharacter, plusRootCharacter] using Complex.exp_neg w

/-- The two named Cartan coefficients are one complex Cartan direction viewed
through its real and imaginary coordinate axes. -/
theorem Kcirc_eq_I_smul_Kboost :
    Kcirc = Complex.I • Kboost := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Kcirc, Kboost, σ3c, Matrix.smul_apply] <;> ring

/-- Exact scalar normal form of the logarithmic Cartan generator. -/
theorem bipolarLogarithmicCartan_eq_half_bipolarLog_sigma3 (s : ℂ) :
    bipolarLogarithmicCartan s = (bipolarLog s / 2) • σ3c := by
  have hscalar :
      (eta s : ℂ) * (1 / 2 : ℂ) +
          (theta s : ℂ) * (Complex.I / 2) =
        bipolarLog s / 2 := by
    calc
      (eta s : ℂ) * (1 / 2 : ℂ) +
            (theta s : ℂ) * (Complex.I / 2) =
          ((eta s : ℂ) + (theta s : ℂ) * Complex.I) / 2 := by ring
      _ = bipolarLog s / 2 := by
        apply Complex.ext <;> simp [bipolarLog, eta, theta]
  rw [bipolarLogarithmicCartan, logarithmicCartan, Kboost, Kcirc]
  simp only [smul_smul]
  rw [← add_smul, hscalar]

/-- Additive inner derivation generated by the bipolar logarithmic Cartan element. -/
def logarithmicDerivation (s : ℂ) : Matrix2C →+ Matrix2C :=
  adK (bipolarLogarithmicCartan s)

/-- Native complex-linear inner derivation on the matrix algebra. -/
def logarithmicDerivationLinear (s : ℂ) : Matrix2C →ₗ[ℂ] Matrix2C :=
  adK_algebra (R := ℂ) (bipolarLogarithmicCartan s)

/-- Repository-native operator derivation carrying the same inner commutator. -/
def logarithmicOpDerivation (s : ℂ) : OpDerivation ℂ Matrix2C where
  toLinearMap := logarithmicDerivationLinear s
  leibniz' := by
    intro X Y
    simpa [logarithmicDerivationLinear] using
      adK_algebra_is_derivation (R := ℂ)
        (bipolarLogarithmicCartan s) X Y

@[simp] theorem logarithmicDerivation_apply (s : ℂ) (X : Matrix2C) :
    logarithmicDerivation s X =
      bipolarLogarithmicCartan s * X - X * bipolarLogarithmicCartan s :=
  rfl

@[simp] theorem logarithmicDerivationLinear_apply (s : ℂ) (X : Matrix2C) :
    logarithmicDerivationLinear s X =
      bipolarLogarithmicCartan s * X - X * bipolarLogarithmicCartan s :=
  rfl

/-- The additive logarithmic inner derivation satisfies the Leibniz rule. -/
theorem logarithmicDerivation_leibniz (s : ℂ) (X Y : Matrix2C) :
    logarithmicDerivation s (X * Y) =
      logarithmicDerivation s X * Y + X * logarithmicDerivation s Y := by
  simpa [logarithmicDerivation] using
    adK_is_derivation (bipolarLogarithmicCartan s) X Y

/-- The complex-linear logarithmic derivation satisfies the same Leibniz rule. -/
theorem logarithmicDerivationLinear_leibniz
    (s : ℂ) (X Y : Matrix2C) :
    logarithmicDerivationLinear s (X * Y) =
      logarithmicDerivationLinear s X * Y +
        X * logarithmicDerivationLinear s Y := by
  simpa [logarithmicDerivationLinear] using
    adK_algebra_is_derivation (R := ℂ)
      (bipolarLogarithmicCartan s) X Y

@[simp] theorem logarithmicOpDerivation_apply (s : ℂ) (X : Matrix2C) :
    logarithmicOpDerivation s X =
      bipolarLogarithmicCartan s * X - X * bipolarLogarithmicCartan s :=
  rfl

/-- The `OpDerivation` carrier exposes the Leibniz identity directly. -/
theorem logarithmicOpDerivation_leibniz
    (s : ℂ) (X Y : Matrix2C) :
    logarithmicOpDerivation s (X * Y) =
      logarithmicOpDerivation s X * Y +
        X * logarithmicOpDerivation s Y := by
  exact (logarithmicOpDerivation s).leibniz X Y

/-- The derivation annihilates the identity. -/
@[simp] theorem logarithmicDerivation_one (s : ℂ) :
    logarithmicDerivation s (1 : Matrix2C) = 0 := by
  simpa [logarithmicDerivation] using
    adK_one (bipolarLogarithmicCartan s)

/-- The complex-linear derivation also annihilates the identity. -/
@[simp] theorem logarithmicDerivationLinear_one (s : ℂ) :
    logarithmicDerivationLinear s (1 : Matrix2C) = 0 := by
  simpa [logarithmicDerivationLinear] using
    adK_algebra_one (R := ℂ) (bipolarLogarithmicCartan s)

@[simp] theorem logarithmicOpDerivation_one (s : ℂ) :
    logarithmicOpDerivation s (1 : Matrix2C) = 0 := by
  rw [logarithmicOpDerivation_apply]
  simp

/-- Plus-sheet adjoint eigenoperator law. -/
theorem logarithmicDerivation_sigmaPlus (s : ℂ) :
    logarithmicDerivation s σPlus = bipolarLog s • σPlus := by
  rw [logarithmicDerivation_apply, bipolarLogarithmicCartan_comm_sigmaPlus]
  congr 1
  apply Complex.ext <;> simp [bipolarLog, eta, theta]

/-- Minus-sheet adjoint eigenoperator law. -/
theorem logarithmicDerivation_sigmaMinus (s : ℂ) :
    logarithmicDerivation s σMinus = (-bipolarLog s) • σMinus := by
  rw [logarithmicDerivation_apply, bipolarLogarithmicCartan_comm_sigmaMinus]
  congr 1
  apply Complex.ext <;> simp [bipolarLog, eta, theta]

/-- Complex-linear plus-sheet eigenoperator law. -/
theorem logarithmicDerivationLinear_sigmaPlus (s : ℂ) :
    logarithmicDerivationLinear s σPlus = bipolarLog s • σPlus := by
  rw [logarithmicDerivationLinear_apply, bipolarLogarithmicCartan_comm_sigmaPlus]
  congr 1
  apply Complex.ext <;> simp [bipolarLog, eta, theta]

/-- Complex-linear minus-sheet eigenoperator law. -/
theorem logarithmicDerivationLinear_sigmaMinus (s : ℂ) :
    logarithmicDerivationLinear s σMinus = (-bipolarLog s) • σMinus := by
  rw [logarithmicDerivationLinear_apply, bipolarLogarithmicCartan_comm_sigmaMinus]
  congr 1
  apply Complex.ext <;> simp [bipolarLog, eta, theta]

/-- Native `OpDerivation` plus-sheet eigenoperator law. -/
theorem logarithmicOpDerivation_sigmaPlus (s : ℂ) :
    logarithmicOpDerivation s σPlus = bipolarLog s • σPlus := by
  rw [logarithmicOpDerivation_apply, bipolarLogarithmicCartan_comm_sigmaPlus]
  congr 1
  apply Complex.ext <;> simp [bipolarLog, eta, theta]

/-- Native `OpDerivation` minus-sheet eigenoperator law. -/
theorem logarithmicOpDerivation_sigmaMinus (s : ℂ) :
    logarithmicOpDerivation s σMinus = (-bipolarLog s) • σMinus := by
  rw [logarithmicOpDerivation_apply, bipolarLogarithmicCartan_comm_sigmaMinus]
  congr 1
  apply Complex.ext <;> simp [bipolarLog, eta, theta]

/-- Finite conjugation on the plus root space is exactly the positive root
character evaluated at the logarithmic weight. -/
theorem torusAdjoint_sigmaPlus_eq_plusRootCharacter (s : ℂ) :
    torusAdjoint s σPlus =
      plusRootCharacter (bipolarLog s) • σPlus := by
  unfold torusAdjoint
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [halfLogLift, plusWeight, minusWeight, plusRootCharacter,
      σPlus, Matrix.mul_apply, Fin.sum_univ_two, ← Complex.exp_add]

/-- Finite conjugation on the minus root space is exactly the negative root
character evaluated at the logarithmic weight. -/
theorem torusAdjoint_sigmaMinus_eq_minusRootCharacter (s : ℂ) :
    torusAdjoint s σMinus =
      minusRootCharacter (bipolarLog s) • σMinus := by
  unfold torusAdjoint
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [halfLogLift, plusWeight, minusWeight, minusRootCharacter,
      σMinus, Matrix.mul_apply, Fin.sum_univ_two, ← Complex.exp_add]

/-- On the punctured bipolar domain the positive character is exactly `q(s)`. -/
theorem plusRootCharacter_bipolar
    {s : ℂ} (hs : s ∈ punctured01) :
    plusRootCharacter (bipolarLog s) = crossRatio01 s := by
  simpa [plusRootCharacter] using exp_bipolarLog hs

/-- On the punctured bipolar domain the negative character is exactly `q(s)⁻¹`. -/
theorem minusRootCharacter_bipolar
    {s : ℂ} (hs : s ∈ punctured01) :
    minusRootCharacter (bipolarLog s) = (crossRatio01 s)⁻¹ := by
  rw [minusRootCharacter, Complex.exp_neg, exp_bipolarLog hs]

/-- On the critical line both adjoint characters are pure unit-modulus phases. -/
theorem criticalLine_rootCharacters_unit_norm (y : ℝ) :
    ‖plusRootCharacter (bipolarLog (criticalLine y))‖ = 1 ∧
      ‖minusRootCharacter (bipolarLog (criticalLine y))‖ = 1 := by
  have hs : criticalLine y ∈ punctured01 := criticalLine_mem_punctured01 y
  constructor
  · rw [plusRootCharacter_bipolar hs]
    exact norm_crossRatio01_criticalLine y
  · rw [minusRootCharacter_bipolar hs, norm_inv,
      norm_crossRatio01_criticalLine]
    simp

/-- The finite adjoint action integrates the plus-sheet derivation character. -/
theorem logarithmicDerivation_integrates_plus
    {s : ℂ} (hs : s ∈ punctured01) :
    logarithmicOpDerivation s σPlus = bipolarLog s • σPlus ∧
      torusAdjoint s σPlus = crossRatio01 s • σPlus := by
  exact ⟨logarithmicOpDerivation_sigmaPlus s,
    torusAdjoint_sigmaPlus hs⟩

/-- The finite adjoint action integrates the minus-sheet derivation character. -/
theorem logarithmicDerivation_integrates_minus
    {s : ℂ} (hs : s ∈ punctured01) :
    logarithmicOpDerivation s σMinus = (-bipolarLog s) • σMinus ∧
      torusAdjoint s σMinus = (crossRatio01 s)⁻¹ • σMinus := by
  exact ⟨logarithmicOpDerivation_sigmaMinus s,
    torusAdjoint_sigmaMinus hs⟩

/-- Character-level form of the integrated plus-sheet law, valid before the
bipolar `exp(log q) = q` specialization. -/
theorem logarithmicDerivation_integrates_plus_character (s : ℂ) :
    logarithmicOpDerivation s σPlus = bipolarLog s • σPlus ∧
      torusAdjoint s σPlus =
        plusRootCharacter (bipolarLog s) • σPlus := by
  exact ⟨logarithmicOpDerivation_sigmaPlus s,
    torusAdjoint_sigmaPlus_eq_plusRootCharacter s⟩

/-- Character-level form of the integrated minus-sheet law. -/
theorem logarithmicDerivation_integrates_minus_character (s : ℂ) :
    logarithmicOpDerivation s σMinus = (-bipolarLog s) • σMinus ∧
      torusAdjoint s σMinus =
        minusRootCharacter (bipolarLog s) • σMinus := by
  exact ⟨logarithmicOpDerivation_sigmaMinus s,
    torusAdjoint_sigmaMinus_eq_minusRootCharacter s⟩

/-- Compact derivation/integration packet. -/
theorem bipolar_logarithmic_derivation_packet
    {s : ℂ} (hs : s ∈ punctured01) (X Y : Matrix2C) :
    logarithmicOpDerivation s (X * Y) =
        logarithmicOpDerivation s X * Y +
          X * logarithmicOpDerivation s Y ∧
      logarithmicOpDerivation s σPlus = bipolarLog s • σPlus ∧
      logarithmicOpDerivation s σMinus = (-bipolarLog s) • σMinus ∧
      torusAdjoint s σPlus = crossRatio01 s • σPlus ∧
      torusAdjoint s σMinus = (crossRatio01 s)⁻¹ • σMinus := by
  exact ⟨logarithmicOpDerivation_leibniz s X Y,
    logarithmicOpDerivation_sigmaPlus s,
    logarithmicOpDerivation_sigmaMinus s,
    torusAdjoint_sigmaPlus hs,
    torusAdjoint_sigmaMinus hs⟩

/-- Full scalar-to-operator reconstruction packet. It records the corrected
Cartan carrier, genuine Leibniz derivation, infinitesimal root weights, finite
root characters, and their exact bipolar specialization. -/
theorem bipolar_logarithmic_adjoint_character_packet
    {s : ℂ} (hs : s ∈ punctured01) (X Y : Matrix2C) :
    bipolarLogarithmicCartan s = (bipolarLog s / 2) • σ3c ∧
      logarithmicOpDerivation s (X * Y) =
        logarithmicOpDerivation s X * Y +
          X * logarithmicOpDerivation s Y ∧
      logarithmicOpDerivation s σPlus = bipolarLog s • σPlus ∧
      logarithmicOpDerivation s σMinus = (-bipolarLog s) • σMinus ∧
      torusAdjoint s σPlus =
        plusRootCharacter (bipolarLog s) • σPlus ∧
      torusAdjoint s σMinus =
        minusRootCharacter (bipolarLog s) • σMinus ∧
      plusRootCharacter (bipolarLog s) = crossRatio01 s ∧
      minusRootCharacter (bipolarLog s) = (crossRatio01 s)⁻¹ := by
  exact ⟨bipolarLogarithmicCartan_eq_half_bipolarLog_sigma3 s,
    logarithmicOpDerivation_leibniz s X Y,
    logarithmicOpDerivation_sigmaPlus s,
    logarithmicOpDerivation_sigmaMinus s,
    torusAdjoint_sigmaPlus_eq_plusRootCharacter s,
    torusAdjoint_sigmaMinus_eq_minusRootCharacter s,
    plusRootCharacter_bipolar hs,
    minusRootCharacter_bipolar hs⟩

end InfoGeometry.Canonical.BipolarLogarithmicDerivationBridge
