{"file":"/home/goutev/repos/info-geometry-lean/external/SpectralThm/SpectralThm/ComplexMeasure/RadonNikodym.lean","time":1778539126977,"baseTime":1778539124391,"changes":[{"range":{"start":{"line":8,"character":0},"end":{"line":36,"character":0}},"text":"\nopen MeasureTheory\n\nnamespace ComplexRMK\n\nvariable {X : Type*} [MeasurableSpace X]\n\n/-- Radon-Nikodym theorem for complex measures with respect to a dominating positive measure. -/\ntheorem exists_l1_eq_withDensity_variation_lambda (μ : ComplexMeasure X) (lambda : Measure X)\n    [SigmaFinite lambda] (h_ac : μ ≪ᵥ lambda.toENNRealVectorMeasure) :\n    ∃ h : X → ℂ, Integrable h lambda ∧ μ = lambda.withDensityᵥ h := by\n  let μ_re := MeasureTheory.ComplexMeasure.re μ\n  let μ_im := MeasureTheory.ComplexMeasure.im μ\n  have h_re : μ_re ≪ᵥ lambda.toENNRealVectorMeasure := by\n    apply VectorMeasure.AbsolutelyContinuous.mk\n    intro s hmeas hs\n    have : μ s = 0 := h_ac hmeas hs\n    rw [MeasureTheory.ComplexMeasure.re_apply, this, Complex.zero_re]\n  have h_im : μ_im ≪ᵥ lambda.toENNRealVectorMeasure := by\n    apply VectorMeasure.AbsolutelyContinuous.mk\n    intro s hmeas hs\n    have : μ s = 0 := h_ac hmeas hs\n    rw [MeasureTheory.ComplexMeasure.im_apply, this, Complex.zero_im]\n  let f_re := μ_re.rnDeriv lambda\n  let f_im := μ_im.rnDeriv lambda\n  have hf_re_int := μ_re.integrable_rnDeriv lambda\n  have hf_im_int := μ_im.integrable_rnDeriv lambda\n  have hf_re_eq := μ_re.withDensityᵥ_rnDeriv_eq lambda h_re\n  have hf_im_eq := μ_im.withDensityᵥ_rnDeriv_eq lambda h_im\n  let h (x : X) : ℂ := ⟨f_re x, f_im x⟩\n  use h\n  constructor\n  · exact hf_re_int.complex_ofReal.add (hf_im_int.complex_ofReal.mul_const Complex.I)\n  · ext s hmeas\n    rw [VectorMeasure.withDensityᵥ_apply _ hmeas]\n    · apply Complex.ext\n      · rw [Complex.add_re, Complex.mul_re, Complex.I_re, Complex.I_im,\n            Complex.ofReal_re, Complex.ofReal_im]\n        simp only [zero_mul, mul_one, sub_zero, add_zero]\n        rw [← VectorMeasure.withDensityᵥ_apply hf_re_int hmeas, hf_re_eq]\n        rfl\n      · rw [Complex.add_im, Complex.mul_im, Complex.I_re, Complex.I_im,\n            Complex.ofReal_re, Complex.ofReal_im]\n        simp only [zero_mul, one_mul, add_zero, mul_zero, zero_add]\n        rw [← VectorMeasure.withDensityᵥ_apply hf_im_int hmeas, hf_im_eq]\n        rfl\n    · exact hf_re_int.complex_ofReal.add (hf_im_int.complex_ofReal.mul_const Complex.I)\n\ntheorem exists_l1_eq_withDensity_variation (μ : ComplexMeasure X) :\n    ∃ h : X → ℂ, Integrable h μ.variation ∧\n    μ = μ.variation.withDensityᵥ h := by\n","rangeOffset":237,"rangeLength":1166}]}