import Mathlib

namespace InfoGeometry.Canonical

/-!
# The Integral Chiral Clifford Order

The integral chiral Clifford order $\mathcal{O}$ is the $\mathbb{Z}$-submodule of $M_2(\mathbb{Z})$
generated by the four integral Pauli-type matrices $I, L, J, X$.
We prove that this order is exactly the parity subring of $M_2(\mathbb{Z})$ characterized by:
$A_{00} \equiv A_{11} \pmod 2$
$A_{01} \equiv A_{10} \pmod 2$

We also prove that its scalar extension to $\mathbb{Q}$ is the full matrix algebra $M_2(\mathbb{Q})$.
-/

abbrev M2Z := Matrix (Fin 2) (Fin 2) ℤ
abbrev M2Q := Matrix (Fin 2) (Fin 2) ℚ

def integralChiralParity (A : M2Z) : Prop :=
  Int.ModEq 2 (A 0 0) (A 1 1) ∧ Int.ModEq 2 (A 0 1) (A 1 0)

def paritySubring : Subring M2Z where
  carrier := {A | integralChiralParity A}
  zero_mem' := by
    constructor <;> exact Int.ModEq.refl 0
  one_mem' := by
    constructor
    · exact Int.ModEq.refl 1
    · exact Int.ModEq.refl 0
  add_mem' := by
    intro A B hA hB
    constructor
    · simpa using hA.1.add hB.1
    · simpa using hA.2.add hB.2
  mul_mem' := by
    intro A B hA hB
    have h00 : Int.ModEq 2 (A 0 0 * B 0 0 + A 0 1 * B 1 0)
        (A 1 0 * B 0 1 + A 1 1 * B 1 1) := by
      calc
        A 0 0 * B 0 0 + A 0 1 * B 1 0
            ≡ A 1 1 * B 1 1 + A 1 0 * B 0 1 [ZMOD 2] :=
              (hA.1.mul hB.1).add (hA.2.mul hB.2.symm)
        _ ≡ A 1 0 * B 0 1 + A 1 1 * B 1 1 [ZMOD 2] := by
              simp [add_comm]
    have h01 : Int.ModEq 2 (A 0 0 * B 0 1 + A 0 1 * B 1 1)
        (A 1 0 * B 0 0 + A 1 1 * B 1 0) := by
      calc
        A 0 0 * B 0 1 + A 0 1 * B 1 1
            ≡ A 1 1 * B 1 0 + A 1 0 * B 0 0 [ZMOD 2] :=
              (hA.1.mul hB.2).add (hA.2.mul hB.1.symm)
        _ ≡ A 1 0 * B 0 0 + A 1 1 * B 1 0 [ZMOD 2] := by
              simp [add_comm]
    constructor
    · simp [Matrix.mul_apply, Fin.sum_univ_two]; exact h00
    · simp [Matrix.mul_apply, Fin.sum_univ_two]; exact h01
  neg_mem' := by
    intro A hA
    constructor
    · exact hA.1.neg
    · exact hA.2.neg

def paritySubmodule : Submodule ℤ M2Z where
  carrier := {A | integralChiralParity A}
  zero_mem' := paritySubring.zero_mem'
  add_mem' := paritySubring.add_mem'
  smul_mem' := by
    intro c A hA
    change Int.ModEq 2 (c * A 0 0) (c * A 1 1) ∧ Int.ModEq 2 (c * A 0 1) (c * A 1 0)
    constructor
    · exact hA.1.mul_left c
    · exact hA.2.mul_left c

def chiralI : M2Z := !![1, 0; 0, 1]
def chiralL : M2Z := !![1, 0; 0, -1]
def chiralJ : M2Z := !![0, -1; 1, 0]
def chiralX : M2Z := !![0, 1; 1, 0]

def integerChiralOrder : Submodule ℤ M2Z :=
  Submodule.span ℤ {chiralI, chiralL, chiralJ, chiralX}

theorem integerChiralOrder_eq_paritySubring :
    (integerChiralOrder : Set M2Z) = paritySubring := by
  have H : integerChiralOrder = paritySubmodule := by
    apply le_antisymm
    · rw [integerChiralOrder, Submodule.span_le]
      rintro X hX
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hX
      rcases hX with rfl | rfl | rfl | rfl
      · constructor <;> rfl
      · constructor <;> decide
      · constructor <;> decide
      · constructor <;> decide
    · intro A hA
      have hA1 : A 0 0 % 2 = A 1 1 % 2 := hA.1
      have hA2 : A 0 1 % 2 = A 1 0 % 2 := hA.2
      let k := (A 0 0 - A 1 1) / 2
      have hk : A 0 0 = A 1 1 + 2 * k := by omega
      let m := (A 0 1 - A 1 0) / 2
      have hm : A 0 1 = A 1 0 + 2 * m := by omega
      let cI := A 1 1 + k
      let cL := k
      let cJ := -m
      let cX := A 1 0 + m
      have hA_decomp : A = cI • chiralI + cL • chiralL + cJ • chiralJ + cX • chiralX := by
        ext i j
        fin_cases i <;> fin_cases j
        · dsimp [cI, cL, cJ, cX, chiralI, chiralL, chiralJ, chiralX, Matrix.smul_apply, Matrix.add_apply]
          omega
        · dsimp [cI, cL, cJ, cX, chiralI, chiralL, chiralJ, chiralX, Matrix.smul_apply, Matrix.add_apply]
          omega
        · dsimp [cI, cL, cJ, cX, chiralI, chiralL, chiralJ, chiralX, Matrix.smul_apply, Matrix.add_apply]
          omega
        · dsimp [cI, cL, cJ, cX, chiralI, chiralL, chiralJ, chiralX, Matrix.smul_apply, Matrix.add_apply]
          omega
      rw [hA_decomp]
      refine Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_) ?_
      · apply Submodule.smul_mem; apply Submodule.subset_span; simp
      · apply Submodule.smul_mem; apply Submodule.subset_span; simp
      · apply Submodule.smul_mem; apply Submodule.subset_span; simp
      · apply Submodule.smul_mem; apply Submodule.subset_span; simp
  calc (integerChiralOrder : Set M2Z) = (paritySubmodule : Set M2Z) := by rw [H]
    _ = (paritySubring : Set M2Z) := rfl

theorem integerChiralOrder_mul_closed (A B : M2Z)
    (hA : A ∈ integerChiralOrder) (hB : B ∈ integerChiralOrder) :
    A * B ∈ integerChiralOrder := by
  have H : (integerChiralOrder : Set M2Z) = paritySubring := integerChiralOrder_eq_paritySubring
  have hA' : A ∈ (paritySubring : Set M2Z) := by
    change A ∈ (integerChiralOrder : Set M2Z) at hA
    rw [H] at hA
    exact hA
  have hB' : B ∈ (paritySubring : Set M2Z) := by
    change B ∈ (integerChiralOrder : Set M2Z) at hB
    rw [H] at hB
    exact hB
  have hAB : A * B ∈ (paritySubring : Set M2Z) := paritySubring.mul_mem hA' hB'
  change A * B ∈ (integerChiralOrder : Set M2Z)
  rw [H]
  exact hAB

def chiralIQ : M2Q := !![1, 0; 0, 1]
def chiralLQ : M2Q := !![1, 0; 0, -1]
def chiralJQ : M2Q := !![0, -1; 1, 0]
def chiralXQ : M2Q := !![0, 1; 1, 0]

theorem integerChiralOrder_scalarExtension_rat :
    Submodule.span ℚ {chiralIQ, chiralLQ, chiralJQ, chiralXQ} = (⊤ : Submodule ℚ M2Q) := by
  apply eq_top_iff.mpr
  intro A _
  let cI := (A 0 0 + A 1 1) / 2
  let cL := (A 0 0 - A 1 1) / 2
  let cJ := (A 1 0 - A 0 1) / 2
  let cX := (A 0 1 + A 1 0) / 2
  have hA_decomp : A = cI • chiralIQ + cL • chiralLQ + cJ • chiralJQ + cX • chiralXQ := by
    ext i j
    fin_cases i <;> fin_cases j
    · dsimp [cI, cL, cJ, cX, chiralIQ, chiralLQ, chiralJQ, chiralXQ, Matrix.smul_apply, Matrix.add_apply]; ring
    · dsimp [cI, cL, cJ, cX, chiralIQ, chiralLQ, chiralJQ, chiralXQ, Matrix.smul_apply, Matrix.add_apply]; ring
    · dsimp [cI, cL, cJ, cX, chiralIQ, chiralLQ, chiralJQ, chiralXQ, Matrix.smul_apply, Matrix.add_apply]; ring
    · dsimp [cI, cL, cJ, cX, chiralIQ, chiralLQ, chiralJQ, chiralXQ, Matrix.smul_apply, Matrix.add_apply]; ring
  rw [hA_decomp]
  refine Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_) ?_
  · apply Submodule.smul_mem; apply Submodule.subset_span; simp
  · apply Submodule.smul_mem; apply Submodule.subset_span; simp
  · apply Submodule.smul_mem; apply Submodule.subset_span; simp
  · apply Submodule.smul_mem; apply Submodule.subset_span; simp

end InfoGeometry.Canonical
