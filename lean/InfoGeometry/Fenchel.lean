import Mathlib

/-- Bregman divergence generated by a real potential `f`. -/
noncomputable def bregmanDiv (f : ℝ → ℝ) (x y : ℝ) : ℝ :=
  f x - f y - deriv f y * (x - y)

lemma bregmanDiv_three_point
    (f : ℝ → ℝ) (x y z : ℝ) :
    bregmanDiv f x z
      = bregmanDiv f x y + bregmanDiv f y z
        + (deriv f y - deriv f z) * (x - y) := by
  unfold bregmanDiv
  ring

lemma bregmanDiv_pythagorean_ineq
    (f : ℝ → ℝ) (x y z : ℝ)
    (hproj : 0 ≤ (deriv f y - deriv f z) * (x - y)) :
    bregmanDiv f x z ≥ bregmanDiv f x y + bregmanDiv f y z := by
  have hdecomp := bregmanDiv_three_point f x y z
  linarith [hdecomp, hproj]

section ConvexDuality

/-- `f⋆` is a (possibly weak) Legendre conjugate of `f` when it bounds all affine supports. -/
def IsLegendreConjugate (f fStar : ℝ → ℝ) : Prop :=
  ∀ η θ, η * θ - f θ ≤ fStar η

/-- Fenchel gap associated to a primal/dual potential pair. -/
def fenchelGap (f fStar : ℝ → ℝ) (θ η : ℝ) : ℝ :=
  f θ + fStar η - η * θ

lemma fenchelYoung_ineq
    {f fStar : ℝ → ℝ}
    (hConj : IsLegendreConjugate f fStar)
    (θ η : ℝ) :
    η * θ ≤ f θ + fStar η := by
  have h := hConj η θ
  linarith

lemma fenchelGap_nonneg_of_conjugate
    {f fStar : ℝ → ℝ}
    (hConj : IsLegendreConjugate f fStar)
    (θ η : ℝ) :
    0 ≤ fenchelGap f fStar θ η := by
  unfold fenchelGap
  have h := hConj η θ
  linarith

/-- Minimal data for 1D dual-flat information geometry: primal potential, dual potential,
and Fenchel-Young compatibility. -/
structure DualFlatPotential where
  primal : ℝ → ℝ
  dual : ℝ → ℝ
  conjugate : IsLegendreConjugate primal dual

lemma DualFlatPotential.fenchelGap_nonneg
    (D : DualFlatPotential)
    (θ η : ℝ) :
    0 ≤ fenchelGap D.primal D.dual θ η :=
  fenchelGap_nonneg_of_conjugate D.conjugate θ η

end ConvexDuality
