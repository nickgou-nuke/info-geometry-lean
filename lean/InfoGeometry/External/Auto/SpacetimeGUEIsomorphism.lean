-- Part 2:  The Quaternion Connection
---------------------------------------------------------------

/-- The quaternion algebra ℍ = {1, i, j, k} with i² = j² = k² = ijk = −1.

    Mapping to Pauli matrices:
      i ↔ −i σ₁
      j ↔ −i σ₂
      k ↔ −i σ₃

    A quaternion q = a + b·i + c·j + d·k maps to a 2×2 complex matrix:
      q → a·I − i(b·σ₁ + c·σ₂ + d·σ₃)

    This is the standard spinor (SU(2)) representation of quaternions. -/

/- Represent a quaternion (a, b, c, d) as a 2×2 complex matrix.
    q = a·I − i(b·σ₁ + c·σ₂ + d·σ₃)

    For a unit quaternion (a²+b²+c²+d²=1), this is an SU(2) matrix.
    The map is an ℝ-algebra isomorphism ℍ ≅ {2×2 matrices of the form [α β; −β* α*]}. -/
def quaternionToMatrix (a b c d : ℝ) : Matrix (Fin 2) (Fin 2) ℂ :=
  !![(a : ℂ) - I * (d : ℂ), (-(c : ℂ)) - I * (b : ℂ);
     (c : ℂ) - I * (b : ℂ), (a : ℂ) + I * (d : ℂ)]

/-- The quaternion norm: N(q) = a² + b² + c² + d².
    The matrix determinant equals the quaternion norm. -/
theorem quaternionMatrix_det_eq_norm (a b c d : ℝ) :
    Matrix.det (quaternionToMatrix a b c d) = ((a^2 + b^2 + c^2 + d^2 : ℝ) : ℂ) := by
  rw [Matrix.det_fin_two]
  simp [quaternionToMatrix]
  ring_nf
  simp [Complex.I_sq]
  ring
def spatialRotation (X : Matrix (Fin 2) (Fin 2) ℂ) (Λ : Matrix (Fin 2) (Fin 2) ℂ) :
    Matrix (Fin 2) (Fin 2) ℂ :=
  Λ * X * Matrix.conjTranspose Λ

/-- Under spatial rotation by a unit quaternion, the trace (time) is invariant
    and the determinant (proper time) is invariant.
    This is the Lorentz invariance of the Minkowski metric expressed in spinor form. -/
theorem rotation_invariance (X Λ : Matrix (Fin 2) (Fin 2) ℂ)
    (hU : Matrix.conjTranspose Λ * Λ = 1) (hdet : Matrix.det Λ = 1) :
    Matrix.trace (spatialRotation X Λ) = Matrix.trace X ∧
      Matrix.det (spatialRotation X Λ) = Matrix.det X := by
  constructor
  · unfold spatialRotation
    calc
      Matrix.trace (Λ * X * Matrix.conjTranspose Λ)
          = Matrix.trace (Matrix.conjTranspose Λ * (Λ * X)) := by
              simpa [mul_assoc] using Matrix.trace_mul_cycle Λ X (Matrix.conjTranspose Λ)
      _ = Matrix.trace ((Matrix.conjTranspose Λ * Λ) * X) := by rw [mul_assoc]
      _ = Matrix.trace (1 * X) := by rw [hU]
      _ = Matrix.trace X := by simp
  · unfold spatialRotation
    calc
      Matrix.det (Λ * X * Matrix.conjTranspose Λ)
          = Matrix.det Λ * Matrix.det X * Matrix.det (Matrix.conjTranspose Λ) := by
              simp [Matrix.det_mul, mul_assoc]
      _ = (1 : ℂ) * Matrix.det X * Matrix.det (Matrix.conjTranspose Λ) := by simp [hdet]
      _ = Matrix.det X * Matrix.det (Matrix.conjTranspose Λ) := by ring
      _ = Matrix.det X * (1 : ℂ) := by simp [Matrix.det_conjTranspose, hdet]
      _ = Matrix.det X := by ring
