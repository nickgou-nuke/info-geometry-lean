import InfoGeometry.OperatorAlgebra.PeirceSpine.CurvatureDoubleCommutator
import Mathlib.Tactic.NoncommRing

/-!
# D₅₀: noncommutative clade, fork, lineage, and selection identities

The file formalizes finite algebraic statements in an associative ring. The
taxonomic terminology is naming for the idempotents and their inclusions; no
biological interpretation or metric-space ultrametric is inferred.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine

open InfoGeometry.Core.IdempotentGraphGrassmannian

variable {B : Type*} [Ring B]

/-- Inclusion of one idempotent corner in another, expressed by two-sided
absorption. -/
def cladeSubsumes (Psub Panc : B) : Prop :=
  Psub * Panc = Psub ∧ Panc * Psub = Psub

/-- The complement of a subsumed idempotent inside its parent. -/
def cladeComplement (Psub Panc : B) : B := Panc - Psub

/-- The signed difference of orthogonal daughter idempotents. -/
def cladeFork (Pl Pr : B) : B := Pl - Pr

/-- Join of two orthogonal daughter idempotents. -/
def cladeJoin (Pl Pr : B) : B := Pl + Pr

/-- Root signed element for a two-leaf ingroup and one outgroup. -/
def threeLeafRoot (P1 P2 P3 : B) : B := (P1 + P2) - P3

/-- The lineage recursion reuses the existing daughter-idempotent tower. -/
def phyloLineage (n : ℕ) (P A : B) : B := daughterIdemTower n P A

/-- Double commutator generated by the signed fork element. -/
def forkDamping (P A C X : B) : B :=
  comm (genJ P A C) (comm (genJ P A C) X)

/-- Sum of the inner curvature derivation and fork double commutator. -/
def cladisticFlow (P A C X : B) : B :=
  comm (genSig P A C) X + forkDamping P A C X

/-- A join-weighted operator expression attached to the three-leaf cladogram.
It is an algebraic weight, not a metric distance. -/
def threeLeafJoinWeight (P1 P2 P3 : B) : B :=
  cladeJoin P1 P2 + (2 : ℤ) • (P1 + P2 + P3)

/-- The five causal archetypes used to organize the D₅₀ results. -/
inductive PhylogenesisArchetype
  | nestedClades
  | binaryFork
  | threeLeafRoot
  | lineageMutation
  | selectionModes
  deriving DecidableEq, Repr

def phylogenesisRank : PhylogenesisArchetype → ℕ
  | .nestedClades => 0
  | .binaryFork => 1
  | .threeLeafRoot => 2
  | .lineageMutation => 3
  | .selectionModes => 4

theorem phylogenesisRank_injective : Function.Injective phylogenesisRank := by
  intro x y h
  cases x <;> cases y <;> cases h <;> rfl

instance : PartialOrder PhylogenesisArchetype :=
  PartialOrder.lift phylogenesisRank phylogenesisRank_injective

theorem phylogenesis_causal_chain :
    PhylogenesisArchetype.nestedClades < PhylogenesisArchetype.binaryFork ∧
    PhylogenesisArchetype.binaryFork < PhylogenesisArchetype.threeLeafRoot ∧
    PhylogenesisArchetype.threeLeafRoot < PhylogenesisArchetype.lineageMutation ∧
    PhylogenesisArchetype.lineageMutation < PhylogenesisArchetype.selectionModes := by
  decide

/-- Two nested clade inclusions compose. -/
theorem cladeSubsumes_trans {Psub Pmid Panc : B}
    (hsm : cladeSubsumes Psub Pmid) (hmA : cladeSubsumes Pmid Panc) :
    cladeSubsumes Psub Panc := by
  rcases hsm with ⟨hsm₁, hsm₂⟩
  rcases hmA with ⟨hmA₁, hmA₂⟩
  constructor
  · calc
      Psub * Panc = (Psub * Pmid) * Panc := by rw [hsm₁]
      _ = Psub * (Pmid * Panc) := by rw [mul_assoc]
      _ = Psub := by rw [hmA₁, hsm₁]
  · calc
      Panc * Psub = Panc * (Pmid * Psub) := by rw [hsm₂]
      _ = (Panc * Pmid) * Psub := by rw [← mul_assoc]
      _ = Psub := by rw [hmA₂, hsm₂]

/-- The parent-minus-descendant complement is an orthogonal idempotent, and
the two pieces reconstruct the parent. -/
theorem cladeComplement_peirce_split {Psub Panc : B}
    (hSub : Psub * Psub = Psub) (hAnc : Panc * Panc = Panc)
    (hIncl : cladeSubsumes Psub Panc) :
    cladeComplement Psub Panc * cladeComplement Psub Panc =
        cladeComplement Psub Panc ∧
    Psub * cladeComplement Psub Panc = 0 ∧
    cladeComplement Psub Panc * Psub = 0 ∧
    Psub + cladeComplement Psub Panc = Panc := by
  rcases hIncl with ⟨hPA, hAP⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold cladeComplement
    noncomm_ring [hAnc, hSub, hPA, hAP]
  · unfold cladeComplement
    rw [mul_sub, hPA, hSub, sub_self]
  · unfold cladeComplement
    rw [sub_mul, hAP, hSub, sub_self]
  · unfold cladeComplement
    abel

/-- Orthogonal daughter idempotents form a tripotent whose square is their
join (the algebraic MRCA). -/
theorem cladeFork_mrca {Pl Pr : B}
    (hL : Pl * Pl = Pl) (hR : Pr * Pr = Pr)
    (hLR : Pl * Pr = 0) (hRL : Pr * Pl = 0) :
    cladeFork Pl Pr * cladeFork Pl Pr = cladeJoin Pl Pr ∧
    cladeFork Pl Pr * cladeFork Pl Pr * cladeFork Pl Pr =
      cladeFork Pl Pr ∧
    cladeJoin Pl Pr * cladeJoin Pl Pr = cladeJoin Pl Pr ∧
    cladeSubsumes Pl (cladeJoin Pl Pr) ∧
    cladeSubsumes Pr (cladeJoin Pl Pr) := by
  have hSq : cladeFork Pl Pr * cladeFork Pl Pr = cladeJoin Pl Pr := by
    unfold cladeFork cladeJoin
    noncomm_ring [hL, hR, hLR, hRL]
  refine ⟨hSq, ?_, ?_, ?_, ?_⟩
  · rw [hSq]
    unfold cladeJoin cladeFork
    noncomm_ring [hL, hR, hLR, hRL]
  · unfold cladeJoin
    noncomm_ring [hL, hR, hLR, hRL]
  · unfold cladeSubsumes cladeJoin
    exact ⟨by noncomm_ring [hL, hR, hLR, hRL],
      by noncomm_ring [hL, hR, hLR, hRL]⟩
  · unfold cladeSubsumes cladeJoin
    exact ⟨by noncomm_ring [hL, hR, hLR, hRL],
      by noncomm_ring [hL, hR, hLR, hRL]⟩

/-- Three mutually orthogonal leaves yield the stated ingroup root identities.
The signed root is tripotent on the occupied three-leaf join. -/
theorem threeLeafRoot_identities {P1 P2 P3 : B}
    (h1 : P1 * P1 = P1) (h2 : P2 * P2 = P2) (h3 : P3 * P3 = P3)
    (h12 : P1 * P2 = 0) (h21 : P2 * P1 = 0)
    (h13 : P1 * P3 = 0) (h31 : P3 * P1 = 0)
    (h23 : P2 * P3 = 0) (h32 : P3 * P2 = 0) :
    cladeFork P1 P2 * cladeFork P1 P2 = cladeJoin P1 P2 ∧
    comm (threeLeafRoot P1 P2 P3) (cladeFork P1 P2) = 0 ∧
    threeLeafRoot P1 P2 P3 * cladeFork P1 P2 = cladeFork P1 P2 ∧
    idempotencyDefect (threeLeafRoot P1 P2 P3) = (2 : ℤ) • P3 ∧
    idempotencyDefectBar (cladeFork P1 P2) = (2 : ℤ) • P1 ∧
    idempotencyDefect (cladeFork P1 P2) = (2 : ℤ) • P2 ∧
    threeLeafJoinWeight P1 P2 P3 =
      (3 : ℤ) • (P1 + P2) + (2 : ℤ) • P3 := by
  have hFork := cladeFork_mrca h1 h2 h12 h21
  refine ⟨hFork.1, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · unfold comm threeLeafRoot cladeFork
    noncomm_ring [h1, h2, h3, h12, h21, h13, h31, h23, h32]
  · unfold threeLeafRoot cladeFork
    noncomm_ring [h1, h2, h3, h12, h21, h13, h31, h23, h32]
  · unfold idempotencyDefect threeLeafRoot
    noncomm_ring [h1, h2, h3, h12, h21, h13, h31, h23, h32]
  · unfold idempotencyDefectBar cladeFork
    noncomm_ring [h1, h2, h12, h21]
  · unfold idempotencyDefect cladeFork
    noncomm_ring [h1, h2, h12, h21]
  · unfold threeLeafJoinWeight cladeJoin
    abel

/-- Every stage of the existing daughter-idempotent tower remains idempotent. -/
theorem phyloLineage_idempotent {P : B} (hP : P * P = P)
    (A : B) (n : ℕ) :
    phyloLineage n P A * phyloLineage n P A = phyloLineage n P A := by
  have hTower : ∀ k : ℕ,
      daughterIdemTower k P A * daughterIdemTower k P A = daughterIdemTower k P A := by
    intro k
    induction k with
    | zero => exact hP
    | succ k ih =>
        dsimp [daughterIdemTower]
        have hN0 : conePlus (daughterIdemTower k P A) A *
            conePlus (daughterIdemTower k P A) A = 0 :=
          conePlus_mul_conePlus ih A A
        have hPN : daughterIdemTower k P A *
            conePlus (daughterIdemTower k P A) A =
              conePlus (daughterIdemTower k P A) A :=
          P_mul_conePlus ih A
        have hNP : conePlus (daughterIdemTower k P A) A *
            daughterIdemTower k P A = 0 :=
          conePlus_mul_P ih A
        noncomm_ring [ih, hN0, hPN, hNP]
  simpa [phyloLineage] using hTower n

/-- The mutation/divergence difference is the symmetric Peirce boundary, whose
square is the metric generator. -/
theorem lineage_divergence_metric {P : B} (hP : P * P = P)
    (A C : B) :
    (P + coneMinus P C) - (P - conePlus P A) = genPhi P A C ∧
    ((P + coneMinus P C) - (P - conePlus P A)) *
      ((P + coneMinus P C) - (P - conePlus P A)) = genV P A C := by
  refine ⟨?_, ?_⟩
  · unfold genPhi
    abel
  · rw [show (P + coneMinus P C) - (P - conePlus P A) =
      genPhi P A C by unfold genPhi; abel]
    have hPhi : genPhi P A C * genPhi P A C = genV P A C := by
      peirce_nf hP
    exact hPhi

/-- The fork double commutator contracts the boundary mode and annihilates the
signed fork and metric modes. -/
theorem cladistic_selection_modes {P : B} (hP : P * P = P)
    (A C : B) :
    forkDamping P A C (genPhi P A C) =
      -((4 : ℤ) • (genV P A C * genPhi P A C)) ∧
    forkDamping P A C (genJ P A C) = 0 ∧
    forkDamping P A C (genV P A C) = 0 ∧
    cladisticFlow P A C (genV P A C) = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold forkDamping
    peirce_nf hP
  · unfold forkDamping
    peirce_nf hP
  · unfold forkDamping
    peirce_nf hP
  · unfold cladisticFlow forkDamping
    peirce_nf hP

/-- D₅₀ master theorem: nested idempotents, the MRCA fork, the three-leaf
root, finite mutation lineage, and selection eigenmodes. -/
theorem stageD50_cladistic_phylogenesis
    {P Psub Pmid Panc P1 P2 P3 : B}
    (hP : P * P = P) (hSub : Psub * Psub = Psub)
    (hMid : Pmid * Pmid = Pmid)
    (hIncl1 : cladeSubsumes Psub Pmid)
    (hIncl2 : cladeSubsumes Pmid Panc)
    (h1 : P1 * P1 = P1) (h2 : P2 * P2 = P2) (h3 : P3 * P3 = P3)
    (h12 : P1 * P2 = 0) (h21 : P2 * P1 = 0)
    (h13 : P1 * P3 = 0) (h31 : P3 * P1 = 0)
    (h23 : P2 * P3 = 0) (h32 : P3 * P2 = 0)
    (A C : B) (n : ℕ) :
    cladeSubsumes Psub Panc ∧
    cladeComplement Psub Pmid * cladeComplement Psub Pmid =
      cladeComplement Psub Pmid ∧
    cladeFork P1 P2 * cladeFork P1 P2 = cladeJoin P1 P2 ∧
    comm (threeLeafRoot P1 P2 P3) (cladeFork P1 P2) = 0 ∧
    idempotencyDefect (threeLeafRoot P1 P2 P3) = (2 : ℤ) • P3 ∧
    phyloLineage n P A * phyloLineage n P A = phyloLineage n P A ∧
    ((P + coneMinus P C) - (P - conePlus P A)) *
      ((P + coneMinus P C) - (P - conePlus P A)) = genV P A C ∧
    forkDamping P A C (genPhi P A C) =
      -((4 : ℤ) • (genV P A C * genPhi P A C)) ∧
    cladisticFlow P A C (genV P A C) = 0 := by
  exact ⟨cladeSubsumes_trans hIncl1 hIncl2,
    (cladeComplement_peirce_split hSub hMid hIncl1).1,
    (cladeFork_mrca h1 h2 h12 h21).1,
    (threeLeafRoot_identities h1 h2 h3 h12 h21 h13 h31 h23 h32).2.1,
    (threeLeafRoot_identities h1 h2 h3 h12 h21 h13 h31 h23 h32).2.2.2.1,
    phyloLineage_idempotent hP A n,
    (lineage_divergence_metric hP A C).2,
    (cladistic_selection_modes hP A C).1,
    (cladistic_selection_modes hP A C).2.2.2⟩

end InfoGeometry.OperatorAlgebra.PeirceSpine
