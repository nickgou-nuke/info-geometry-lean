import Mathlib.Algebra.FreeAlgebra
import Mathlib.Tactic.NoncommRing
import Mathlib.Algebra.RingQuot
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Tactic.Abel

/-!
# The quantum Grassmannian `Gr_q(2,4)`

This file constructs the coordinate algebra of the quantum Grassmannian by the
standard quantum-minor route:

1. present the `2 × 4` quantum matrix algebra by the FRT/Manin relations;
2. form its ordered `2 × 2` quantum minors;
3. take the subalgebra generated by those six minors.

The construction is algebraic.  No claim about a C*-completion, operator
K-theory, or a concrete Bost--Connes representation is made here.
-/

noncomputable section

namespace QuantumGrassmannian

universe u

variable (R : Type u) [Field R]

/-- The row/column indices of a `2 × 4` quantum matrix. -/
abbrev QuantumMatrixIndex := Fin 2 × Fin 4

/-- The free associative algebra on the eight matrix-coordinate generators. -/
abbrev QuantumMatrixFree := FreeAlgebra R QuantumMatrixIndex

/-- A matrix-coordinate generator in the free algebra. -/
def freeEntry (i : Fin 2) (j : Fin 4) : QuantumMatrixFree R :=
  FreeAlgebra.ι R (i, j)

/--
The FRT/Manin relations for a `2 × 4` quantum matrix.

Our convention is

* entries in one row or column `q`-commute;
* northeast/southwest entries commute;
* northwest/southeast entries have commutator
  `(q - q⁻¹) xᵢₗ xₖⱼ`.
-/
inductive QuantumMatrixRel (q : R) : QuantumMatrixFree R → QuantumMatrixFree R → Prop
  | sameRow (i : Fin 2) (j l : Fin 4) (hjl : j < l) :
      QuantumMatrixRel q
        (freeEntry R i j * freeEntry R i l)
        (q • (freeEntry R i l * freeEntry R i j))
  | sameColumn (i k : Fin 2) (j : Fin 4) (hik : i < k) :
      QuantumMatrixRel q
        (freeEntry R i j * freeEntry R k j)
        (q • (freeEntry R k j * freeEntry R i j))
  | separated (i k : Fin 2) (j l : Fin 4) (hik : i < k) (hlj : l < j) :
      QuantumMatrixRel q
        (freeEntry R i j * freeEntry R k l)
        (freeEntry R k l * freeEntry R i j)
  | crossing (i k : Fin 2) (j l : Fin 4) (hik : i < k) (hjl : j < l) :
      QuantumMatrixRel q
        (freeEntry R i j * freeEntry R k l - freeEntry R k l * freeEntry R i j)
        ((q - q⁻¹) • (freeEntry R i l * freeEntry R k j))

/-- The FRT `2 × 4` quantum matrix algebra at deformation parameter `q`. -/
abbrev QuantumMatrixAlgebra (q : R) := RingQuot (QuantumMatrixRel R q)

/-- The canonical quotient map from the free algebra to the quantum matrix algebra. -/
def quantumMatrixQuotient (q : R) :
    QuantumMatrixFree R →ₐ[R] QuantumMatrixAlgebra R q :=
  RingQuot.mkAlgHom R (QuantumMatrixRel R q)

/-- The image of a matrix-coordinate generator in the quantum matrix algebra. -/
def entry (q : R) (i : Fin 2) (j : Fin 4) : QuantumMatrixAlgebra R q :=
  quantumMatrixQuotient R q (freeEntry R i j)

/-- The same-row FRT relation holds in the presented quantum matrix algebra. -/
theorem entry_sameRow (q : R) (i : Fin 2) (j l : Fin 4) (hjl : j < l) :
    entry R q i j * entry R q i l = q • (entry R q i l * entry R q i j) := by
  simp only [entry, ← map_mul, ← map_smul]
  exact RingQuot.mkAlgHom_rel R (QuantumMatrixRel.sameRow i j l hjl)

/-- The same-column FRT relation holds in the presented quantum matrix algebra. -/
theorem entry_sameColumn (q : R) (i k : Fin 2) (j : Fin 4) (hik : i < k) :
    entry R q i j * entry R q k j = q • (entry R q k j * entry R q i j) := by
  simp only [entry, ← map_mul, ← map_smul]
  exact RingQuot.mkAlgHom_rel R (QuantumMatrixRel.sameColumn i k j hik)

/-- Northeast/southwest entries commute in the presented quantum matrix algebra. -/
theorem entry_separated (q : R) (i k : Fin 2) (j l : Fin 4)
    (hik : i < k) (hlj : l < j) :
    entry R q i j * entry R q k l = entry R q k l * entry R q i j := by
  simp only [entry, ← map_mul]
  exact RingQuot.mkAlgHom_rel R (QuantumMatrixRel.separated i k j l hik hlj)

/-- The crossing FRT commutator relation holds in the quantum matrix algebra. -/
theorem entry_crossing (q : R) (i k : Fin 2) (j l : Fin 4)
    (hik : i < k) (hjl : j < l) :
    entry R q i j * entry R q k l - entry R q k l * entry R q i j =
      (q - q⁻¹) • (entry R q i l * entry R q k j) := by
  simp only [entry, ← map_mul, ← map_sub, ← map_smul]
  exact RingQuot.mkAlgHom_rel R (QuantumMatrixRel.crossing i k j l hik hjl)

/-- An ordered pair indexing one of the six `2 × 2` quantum minors. -/
abbrev QuantumMinorIndex := {p : Fin 4 × Fin 4 // p.1 < p.2}

/--
The ordered quantum minor
`Δᵢⱼ = x₀ᵢ x₁ⱼ - q x₀ⱼ x₁ᵢ`, for `i < j`.
-/
def quantumMinor (q : R) (p : QuantumMinorIndex) : QuantumMatrixAlgebra R q :=
  entry R q 0 p.1.1 * entry R q 1 p.1.2 -
    q • (entry R q 0 p.1.2 * entry R q 1 p.1.1)

/-- Reorder a northwest/southeast mixed-row product using the FRT crossing law. -/
theorem entry_zero_mul_one_of_lt (q : R) (i j : Fin 4) (hij : i < j) :
    entry R q 0 i * entry R q 1 j =
      entry R q 1 j * entry R q 0 i +
        (q - q⁻¹) • (entry R q 1 i * entry R q 0 j) := by
  have hc := entry_crossing R q (0 : Fin 2) 1 i j (by decide) hij
  have hs := entry_separated R q (0 : Fin 2) 1 j i (by decide) hij
  rw [hs] at hc
  calc
    entry R q 0 i * entry R q 1 j =
        (entry R q 0 i * entry R q 1 j - entry R q 1 j * entry R q 0 i) +
          entry R q 1 j * entry R q 0 i := by abel
    _ = (q - q⁻¹) • (entry R q 1 i * entry R q 0 j) +
          entry R q 1 j * entry R q 0 i := by rw [hc]
    _ = entry R q 1 j * entry R q 0 i +
          (q - q⁻¹) • (entry R q 1 i * entry R q 0 j) := by abel

/-- Uniform row-1-before-row-0 normal form for an ordered quantum minor. -/
theorem quantumMinor_eq_reordered (q : R) (p : QuantumMinorIndex) :
    quantumMinor R q p =
      entry R q 1 p.1.2 * entry R q 0 p.1.1 -
        q⁻¹ • (entry R q 1 p.1.1 * entry R q 0 p.1.2) := by
  rw [quantumMinor, entry_zero_mul_one_of_lt R q p.1.1 p.1.2 p.2]
  have hs := entry_separated R q (0 : Fin 2) 1 p.1.2 p.1.1 (by decide) p.2
  rw [hs]
  let x := entry R q 1 p.1.1 * entry R q 0 p.1.2
  have hx : (q - q⁻¹) • x = q • x - q⁻¹ • x := sub_smul q q⁻¹ x
  change entry R q 1 p.1.2 * entry R q 0 p.1.1 + (q - q⁻¹) • x - q • x =
    entry R q 1 p.1.2 * entry R q 0 p.1.1 - q⁻¹ • x
  rw [hx]
  abel

/--
The coordinate algebra `O_q(Gr(2,4))`, defined as the subalgebra of
`O_q(M_{2,4})` generated by its six ordered maximal quantum minors.
-/
def coordinateRing (q : R) : Subalgebra R (QuantumMatrixAlgebra R q) :=
  Algebra.adjoin R (Set.range (quantumMinor R q))

/-- Every ordered quantum minor belongs to the quantum Grassmannian coordinate algebra. -/
theorem quantumMinor_mem_coordinateRing (q : R) (p : QuantumMinorIndex) :
    quantumMinor R q p ∈ coordinateRing R q :=
  Algebra.subset_adjoin (Set.mem_range_self p)

lemma quantumMinor_mul_expand (q : R) (i j k l : Fin 4) (hij : i < j) (hkl : k < l) :
    quantumMinor R q ⟨(i, j), hij⟩ * quantumMinor R q ⟨(k, l), hkl⟩ =
      (entry R q 0 i * entry R q 1 j) * (entry R q 0 k * entry R q 1 l)
      - q • ((entry R q 0 i * entry R q 1 j) * (entry R q 0 l * entry R q 1 k))
      - q • ((entry R q 0 j * entry R q 1 i) * (entry R q 0 k * entry R q 1 l))
      + q^2 • ((entry R q 0 j * entry R q 1 i) * (entry R q 0 l * entry R q 1 k)) := by
  dsimp [quantumMinor]
  rw [sub_mul, mul_sub, mul_sub, smul_mul_assoc, mul_smul_comm, smul_mul_assoc, mul_smul_comm, smul_smul, ← sq]
  abel

lemma entry_sameRow' (q : R) (i : Fin 2) (j l : Fin 4) (hjl : j < l) :
    entry R q i j * entry R q i l = q • (entry R q i l * entry R q i j) :=
  entry_sameRow R q i j l hjl

lemma entry_separated' (q : R) (i k : Fin 2) (j l : Fin 4) (hik : i < k) (hlj : l < j) :
    entry R q i j * entry R q k l = entry R q k l * entry R q i j :=
  entry_separated R q i k j l hik hlj

lemma entry_crossing' (q : R) (i k : Fin 2) (j l : Fin 4) (hik : i < k) (hjl : j < l) :
    entry R q i j * entry R q k l = entry R q k l * entry R q i j + (q - q⁻¹) • (entry R q i l * entry R q k j) := by
  calc
    entry R q i j * entry R q k l = entry R q i j * entry R q k l - entry R q k l * entry R q i j + entry R q k l * entry R q i j := by abel
    _ = (q - q⁻¹) • (entry R q i l * entry R q k j) + entry R q k l * entry R q i j := by rw [entry_crossing R q i k j l hik hjl]
    _ = entry R q k l * entry R q i j + (q - q⁻¹) • (entry R q i l * entry R q k j) := by abel

lemma entry_crossing_swap' (q : R) (j l : Fin 4) (hjl : j < l) :
    entry R q 1 l * entry R q 0 j = entry R q 0 j * entry R q 1 l - (q - q⁻¹) • (entry R q 0 l * entry R q 1 j) := by
  exact eq_sub_of_add_eq (entry_crossing' R q 0 1 j l (by decide) hjl).symm

lemma swap_middle {q : R} {a b c d c' b' : QuantumMatrixAlgebra R q} (h : b * c = c' * b') :
    (a * b) * (c * d) = a * c' * b' * d := by
  calc
    (a * b) * (c * d) = a * (b * c) * d := by simp only [mul_assoc]
    _ = a * (c' * b') * d := by rw [h]
    _ = a * c' * b' * d := by simp only [mul_assoc]

lemma swap_middle_crossing {q : R} {a b c d c' b' x y : QuantumMatrixAlgebra R q} (h : b * c = c' * b' - (q - q⁻¹) • (x * y)) :
    (a * b) * (c * d) = a * c' * b' * d - (q - q⁻¹) • (a * x * y * d) := by
  calc
    (a * b) * (c * d) = a * (b * c) * d := by simp only [mul_assoc]
    _ = a * (c' * b' - (q - q⁻¹) • (x * y)) * d := by rw [h]
    _ = a * c' * b' * d - (q - q⁻¹) • (a * x * y * d) := by simp only [mul_sub, sub_mul, mul_assoc, mul_smul_comm, smul_mul_assoc]

lemma reduce_01_23 (q : R) :
    quantumMinor R q ⟨(0, 1), by decide⟩ * quantumMinor R q ⟨(2, 3), by decide⟩ =
      entry R q 0 0 * entry R q 0 2 * entry R q 1 1 * entry R q 1 3
      - q • (entry R q 0 0 * entry R q 0 3 * entry R q 1 1 * entry R q 1 2)
      - q • (entry R q 0 1 * entry R q 0 2 * entry R q 1 0 * entry R q 1 3)
      + q^2 • (entry R q 0 1 * entry R q 0 3 * entry R q 1 0 * entry R q 1 2) := by
  rw [quantumMinor_mul_expand R q 0 1 2 3 (by decide) (by decide)]
  rw [swap_middle R (entry_separated' R q 0 1 2 1 (by decide) (by decide)).symm]
  rw [swap_middle R (entry_separated' R q 0 1 3 1 (by decide) (by decide)).symm]
  rw [swap_middle R (entry_separated' R q 0 1 2 0 (by decide) (by decide)).symm]
  rw [swap_middle R (entry_separated' R q 0 1 3 0 (by decide) (by decide)).symm]

lemma reduce_02_13 (q : R) :
    quantumMinor R q ⟨(0, 2), by decide⟩ * quantumMinor R q ⟨(1, 3), by decide⟩ =
      entry R q 0 0 * entry R q 0 1 * entry R q 1 2 * entry R q 1 3
      - (q - q⁻¹) • (entry R q 0 0 * entry R q 0 2 * entry R q 1 1 * entry R q 1 3)
      - q • (entry R q 0 0 * entry R q 0 3 * entry R q 1 2 * entry R q 1 1)
      - q • (entry R q 0 2 * entry R q 0 1 * entry R q 1 0 * entry R q 1 3)
      + q^2 • (entry R q 0 2 * entry R q 0 3 * entry R q 1 0 * entry R q 1 1) := by
  rw [quantumMinor_mul_expand R q 0 2 1 3 (by decide) (by decide)]
  rw [swap_middle_crossing R (entry_crossing_swap' R q 1 2 (by decide))]
  rw [swap_middle R (entry_separated' R q 0 1 3 2 (by decide) (by decide)).symm]
  rw [swap_middle R (entry_separated' R q 0 1 1 0 (by decide) (by decide)).symm]
  rw [swap_middle R (entry_separated' R q 0 1 3 0 (by decide) (by decide)).symm]

lemma reduce_03_12 (q : R) :
    quantumMinor R q ⟨(0, 3), by decide⟩ * quantumMinor R q ⟨(1, 2), by decide⟩ =
      entry R q 0 0 * entry R q 0 1 * entry R q 1 3 * entry R q 1 2
      - (q - q⁻¹) • (entry R q 0 0 * entry R q 0 3 * entry R q 1 1 * entry R q 1 2)
      - q • (entry R q 0 0 * entry R q 0 2 * entry R q 1 3 * entry R q 1 1)
      + q • ((q - q⁻¹) • (entry R q 0 0 * entry R q 0 3 * entry R q 1 2 * entry R q 1 1))
      - q • (entry R q 0 3 * entry R q 0 1 * entry R q 1 0 * entry R q 1 2)
      + q^2 • (entry R q 0 3 * entry R q 0 2 * entry R q 1 0 * entry R q 1 1) := by
  rw [quantumMinor_mul_expand R q 0 3 1 2 (by decide) (by decide)]
  rw [swap_middle_crossing R (entry_crossing_swap' R q 1 3 (by decide))]
  rw [swap_middle_crossing R (entry_crossing_swap' R q 2 3 (by decide))]
  rw [swap_middle R (entry_separated' R q 0 1 1 0 (by decide) (by decide)).symm]
  rw [swap_middle R (entry_separated' R q 0 1 2 0 (by decide) (by decide)).symm]
  simp only [smul_sub, mul_assoc]
  abel

lemma swap_row_left (q : R) (row : Fin 2) (j l : Fin 4) (hjl : j < l)
    {a b c d : QuantumMatrixAlgebra R q}
    (ha : a = entry R q row l) (hb : b = entry R q row j) :
    q • (a * (b * (c * d))) = entry R q row j * (entry R q row l * (c * d)) := by
  subst ha hb
  calc q • (entry R q row l * (entry R q row j * (c * d)))
      = (q • (entry R q row l * entry R q row j)) * (c * d) := by simp only [← mul_assoc, smul_mul_assoc]
    _ = entry R q row j * entry R q row l * (c * d) := by rw [← entry_sameRow' R q row j l hjl]
    _ = entry R q row j * (entry R q row l * (c * d)) := by simp only [mul_assoc]

lemma swap_row_right (q : R) (row : Fin 2) (j l : Fin 4) (hjl : j < l)
    {a b c d : QuantumMatrixAlgebra R q}
    (hc : c = entry R q row l) (hd : d = entry R q row j) :
    q • (a * (b * (c * d))) = a * (b * (entry R q row j * entry R q row l)) := by
  subst hc hd
  calc q • (a * (b * (entry R q row l * entry R q row j)))
      = a * b * (q • (entry R q row l * entry R q row j)) := by simp only [← mul_assoc, mul_smul_comm]
    _ = a * b * (entry R q row j * entry R q row l) := by rw [← entry_sameRow' R q row j l hjl]
    _ = a * (b * (entry R q row j * entry R q row l)) := by simp only [mul_assoc]

lemma swap_row_right2 (q : R) (row : Fin 2) (j l : Fin 4) (hjl : j < l)
    {a b c d : QuantumMatrixAlgebra R q}
    (hc : c = entry R q row l) (hd : d = entry R q row j) :
    (q * q) • (a * (b * (c * d))) = q • (a * (b * (entry R q row j * entry R q row l))) := by
  calc (q * q) • (a * (b * (c * d)))
      = q • (q • (a * (b * (c * d)))) := by rw [mul_smul]
    _ = q • (a * (b * (entry R q row j * entry R q row l))) := by rw [swap_row_right R q row j l hjl hc hd]

lemma swap_row_left2 (q : R) (row : Fin 2) (j l : Fin 4) (hjl : j < l)
    {a b c d : QuantumMatrixAlgebra R q}
    (ha : a = entry R q row l) (hb : b = entry R q row j) :
    (q * q) • (a * (b * (c * d))) = q • (entry R q row j * (entry R q row l * (c * d))) := by
  calc (q * q) • (a * (b * (c * d)))
      = q • (q • (a * (b * (c * d)))) := by rw [mul_smul]
    _ = q • (entry R q row j * (entry R q row l * (c * d))) := by rw [swap_row_left R q row j l hjl ha hb]

lemma swap_row_right3 (q : R) (row : Fin 2) (j l : Fin 4) (hjl : j < l)
    {a b c d : QuantumMatrixAlgebra R q}
    (hc : c = entry R q row l) (hd : d = entry R q row j) :
    (q * (q * q)) • (a * (b * (c * d))) = (q * q) • (a * (b * (entry R q row j * entry R q row l))) := by
  calc (q * (q * q)) • (a * (b * (c * d)))
      = ((q * q) * q) • (a * (b * (c * d))) := by rw [mul_comm q (q * q)]
    _ = (q * q) • (q • (a * (b * (c * d)))) := by rw [mul_smul]
    _ = (q * q) • (a * (b * (entry R q row j * entry R q row l))) := by rw [swap_row_right R q row j l hjl hc hd]

lemma swap_row_left3 (q : R) (row : Fin 2) (j l : Fin 4) (hjl : j < l)
    {a b c d : QuantumMatrixAlgebra R q}
    (ha : a = entry R q row l) (hb : b = entry R q row j) :
    (q * (q * q)) • (a * (b * (c * d))) = (q * q) • (entry R q row j * (entry R q row l * (c * d))) := by
  calc (q * (q * q)) • (a * (b * (c * d)))
      = ((q * q) * q) • (a * (b * (c * d))) := by rw [mul_comm q (q * q)]
    _ = (q * q) • (q • (a * (b * (c * d)))) := by rw [mul_smul]
    _ = (q * q) • (entry R q row j * (entry R q row l * (c * d))) := by rw [swap_row_left R q row j l hjl ha hb]

lemma swap_row_right4 (q : R) (row : Fin 2) (j l : Fin 4) (hjl : j < l)
    {a b c d : QuantumMatrixAlgebra R q}
    (hc : c = entry R q row l) (hd : d = entry R q row j) :
    (q * (q * (q * q))) • (a * (b * (c * d))) = (q * (q * q)) • (a * (b * (entry R q row j * entry R q row l))) := by
  calc (q * (q * (q * q))) • (a * (b * (c * d)))
      = ((q * (q * q)) * q) • (a * (b * (c * d))) := by rw [mul_comm q (q * (q * q))]
    _ = (q * (q * q)) • (q • (a * (b * (c * d)))) := by rw [mul_smul]
    _ = (q * (q * q)) • (a * (b * (entry R q row j * entry R q row l))) := by rw [swap_row_right R q row j l hjl hc hd]

lemma swap_row_left4 (q : R) (row : Fin 2) (j l : Fin 4) (hjl : j < l)
    {a b c d : QuantumMatrixAlgebra R q}
    (ha : a = entry R q row l) (hb : b = entry R q row j) :
    (q * (q * (q * q))) • (a * (b * (c * d))) = (q * (q * q)) • (entry R q row j * (entry R q row l * (c * d))) := by
  calc (q * (q * (q * q))) • (a * (b * (c * d)))
      = ((q * (q * q)) * q) • (a * (b * (c * d))) := by rw [mul_comm q (q * (q * q))]
    _ = (q * (q * q)) • (q • (a * (b * (c * d)))) := by rw [mul_smul]
    _ = (q * (q * q)) • (entry R q row j * (entry R q row l * (c * d))) := by rw [swap_row_left R q row j l hjl ha hb]

/--
The standard q-Plücker exchange theorem for the six ordered minors.
-/
theorem quantumPlucker (q : R) :
    quantumMinor R q ⟨(0, 1), by decide⟩ * quantumMinor R q ⟨(2, 3), by decide⟩ -
      q • (quantumMinor R q ⟨(0, 2), by decide⟩ * quantumMinor R q ⟨(1, 3), by decide⟩) +
      q^2 • (quantumMinor R q ⟨(0, 3), by decide⟩ * quantumMinor R q ⟨(1, 2), by decide⟩) = 0 := by
  by_cases hq : q = 0
  · subst hq
    have h0 : entry R 0 0 0 * entry R 0 0 2 = 0 := by
      calc entry R 0 0 0 * entry R 0 0 2 = 0 • (entry R 0 0 2 * entry R 0 0 0) := entry_sameRow' R 0 0 0 2 (by decide)
        _ = 0 := by simp only [zero_smul]
    simp only [sq, zero_mul, zero_smul, sub_zero, add_zero]
    rw [reduce_01_23 R 0]
    simp only [sq, zero_mul, zero_smul, sub_zero, add_zero]
    calc entry R 0 0 0 * entry R 0 0 2 * entry R 0 1 1 * entry R 0 1 3
      _ = (entry R 0 0 0 * entry R 0 0 2) * entry R 0 1 1 * entry R 0 1 3 := by simp only [mul_assoc]
      _ = 0 * entry R 0 1 1 * entry R 0 1 3 := by rw [h0]
      _ = 0 := by simp only [zero_mul]
  · rw [reduce_01_23, reduce_02_13, reduce_03_12]
    simp only [smul_add, smul_sub, smul_smul, sq, mul_assoc]

    have hq_inv : q * q⁻¹ = 1 := mul_inv_cancel₀ hq
    have hq_cancel : q * (q - q⁻¹) = q * q - 1 := by
      calc q * (q - q⁻¹) = q * q - q * q⁻¹ := by rw [mul_sub]
        _ = q * q - 1 := by rw [hq_inv]
    have hq_cancel2 : q * (q * (q - q⁻¹)) = q * (q * q) - q := by
      calc q * (q * (q - q⁻¹)) = q * (q * q - 1) := by rw [hq_cancel]
        _ = q * (q * q) - q := by ring
    have hq_cancel3 : q * (q * (q * (q - q⁻¹))) = q * (q * (q * q)) - q * q := by
      calc q * (q * (q * (q - q⁻¹))) = q * (q * (q * q) - q) := by rw [hq_cancel2]
        _ = q * (q * (q * q)) - q * q := by ring

    rw [hq_cancel3, hq_cancel2, hq_cancel]

    -- Distribute everything
    simp only [sub_smul, one_smul]

    -- Now perform the swaps on the distributed terms!
    -- reduce_02_13 term 3: -q^2 • (00*03*12*11)
    -- This matches and ALREADY swaps reduce_03_12 term 4 part 2: -q^2 • (00*03*12*11) !!!
    rw [swap_row_right2 R q 1 1 2 (by decide) rfl rfl]

    -- reduce_02_13 term 4: -q^2 • (02*01*10*13)
    rw [swap_row_left2 R q 0 1 2 (by decide) rfl rfl]

    -- reduce_03_12 term 1: q^2 • (00*01*13*12)
    rw [swap_row_right2 R q 1 2 3 (by decide) rfl rfl]

    -- reduce_03_12 term 3: -q^3 • (00*02*13*11)
    rw [swap_row_right3 R q 1 1 3 (by decide) rfl rfl]

    -- reduce_03_12 term 4 distributed part 1: q^4 • (00*03*12*11)
    rw [swap_row_right4 R q 1 1 2 (by decide) rfl rfl]

    -- reduce_03_12 term 5: -q^3 • (03*01*10*12)
    rw [swap_row_left3 R q 0 1 3 (by decide) rfl rfl]

    -- reduce_03_12 term 6: q^4 • (03*02*10*11)
    rw [swap_row_left4 R q 0 2 3 (by decide) rfl rfl]

    abel

end QuantumGrassmannian
