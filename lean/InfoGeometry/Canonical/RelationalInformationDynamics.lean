import InfoGeometry.Canonical.BogoliubovVielbein
import InfoGeometry.Canonical.RelationalInformationCore
import InfoGeometry.Canonical.InformationPartitionCore

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.RelationalInformationDynamics

Constructive transport layer for operatorial relational information geometry on
the doubled carrier.

This file does not introduce a new scalar facade. It works directly with:

- normalized operator-valued Massieu/log-partition potentials,
- exact exponential transport of doubled-space endomorphisms,
- commutator-defined first and second information variations,
- the QGT metric/phase readouts of those variations,
- and a concrete realization of the abstract relational-information datum.
-/

namespace InfoGeometry.Canonical.RelationalInformationDynamics

open InfoGeometry.Canonical.RelationalInformationCore
open InfoGeometry.Canonical.StateDependentTransport
open InfoGeometry.Canonical.BogoliubovTransport
open InfoGeometry.Canonical.BogoliubovVielbein.BogoliubovVielbeinBundle
open InfoGeometry.Canonical.InformationCalculus.ModularRadonNikodymData
open InfoGeometry.Quantum.GeometricQuantumTensor
open InfoGeometry.Krein

section Core

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
noncomputable local instance : NormedSpace ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance

/-- Analytic log-partition potential attached to an operatorial observable seed. -/
@[rep_depth operator]
noncomputable def operatorMassieuPotential
    (ω : EndH →L[ℝ] ℝ) (A : EndH) : ℝ → ℝ :=
  fun τ => logInformationPartitionFunction (E := E) ω A τ

/--
Primitive operatorial Massieu value.

This file treats the normalized infinitesimal observable value `ω(A)` as the
primitive functional quantity. Any analytic derivative statement about the
log-partition potential is only a witness for this algebraic value.
-/
@[rep_depth operator]
noncomputable def operatorMassieuExpectation
    (ω : EndH →L[ℝ] ℝ) (A : EndH) : ℝ :=
  ω A

/--
Normalized analytic witness for the primitive operatorial Massieu value.

Under normalization, the log-partition potential has infinitesimal value
exactly equal to the observable expectation `ω(A)`.
-/
@[rep_depth operator]
theorem operatorMassieuPotential_normalizedInfinitesimalLaw
    (ω : EndH →L[ℝ] ℝ) (A : EndH)
    (hω1 : ω (1 : EndH) = 1) :
    HasDerivAt (operatorMassieuPotential (E := E) ω A)
      (operatorMassieuExpectation ω A) 0 := by
  simpa [operatorMassieuPotential, operatorMassieuExpectation] using
    (hasDerivAt_logInformationPartitionFunction_zero_of_normalized
      (E := E) (ω := ω) (K := A) hω1)

/-- First information variation of an observable seed along a transport channel. -/
@[rep_depth transport]
noncomputable abbrev operatorInformationFirstVariation
    (X A : EndH) : EndH :=
  transportCommutator (E := E) X A

/-- Lie derivation of observables generated by the transport channel `X`. -/
@[rep_depth transport]
noncomputable def observableLieDerivation
    (X : EndH) : EndH →ₗ[ℝ] EndH :=
  InfoGeometry.Canonical.RelationalInformationCore.perturbationDerivation
    (E := E) X

@[rep_depth transport, simp] theorem observableLieDerivation_apply
    (X A : EndH) :
    observableLieDerivation (E := E) X A
      =
    operatorInformationFirstVariation (E := E) X A := by
  simp [observableLieDerivation, operatorInformationFirstVariation,
    InfoGeometry.Canonical.RelationalInformationCore.perturbationDerivation,
    lieBracket_eq_transportCommutator]

/--
The first information variation as a linear map in the perturbation channel for
a fixed observable seed.
-/
@[rep_depth transport]
noncomputable def operatorInformationFirstVariationMap
    (A : EndH) : PerturbationChannel E →ₗ[ℝ] EndH :=
  { toFun := fun X => operatorInformationFirstVariation (E := E) X A
    map_add' := by
      intro X Y
      apply ContinuousLinearMap.ext
      intro u
      apply DoubledSpace.ext <;>
        simp [operatorInformationFirstVariation, transportCommutator,
          sub_eq_add_neg, ContinuousLinearMap.add_comp,
          ContinuousLinearMap.comp_add]
      · abel
      · abel
    map_smul' := by
      intro c X
      apply ContinuousLinearMap.ext
      intro u
      apply DoubledSpace.ext <;>
        simp [operatorInformationFirstVariation, transportCommutator,
          ContinuousLinearMap.smul_comp, smul_sub] }

@[rep_depth transport] theorem operatorInformationFirstVariationMap_apply
    (A X : EndH) :
    operatorInformationFirstVariationMap (E := E) A X
      =
    operatorInformationFirstVariation (E := E) X A := rfl

/-- Mixed second information variation along two transport channels. -/
@[rep_depth transport]
noncomputable abbrev operatorInformationMixedSecondVariation
    (X Y A : EndH) : EndH :=
  transportCommutator (E := E) X (operatorInformationFirstVariation (E := E) Y A)

/--
The mixed second information variation as a canonical bilinear map on
perturbation channels for a fixed observable seed.
-/
@[rep_depth transport]
noncomputable def operatorInformationMixedSecondVariationMap
    (A : EndH) :
    PerturbationChannel E →ₗ[ℝ] PerturbationChannel E →ₗ[ℝ] EndH :=
  LinearMap.mk₂ ℝ
    (fun X Y => operatorInformationMixedSecondVariation (E := E) X Y A)
    (by
      intro X1 X2 Y
      apply ContinuousLinearMap.ext
      intro u
      apply DoubledSpace.ext <;>
        simp [operatorInformationMixedSecondVariation, operatorInformationFirstVariation,
          transportCommutator, sub_eq_add_neg, ContinuousLinearMap.add_comp,
          ContinuousLinearMap.comp_add]
      · abel
      · abel)
    (by
      intro c X Y
      apply ContinuousLinearMap.ext
      intro u
      apply DoubledSpace.ext <;>
        simp [operatorInformationMixedSecondVariation, operatorInformationFirstVariation,
          transportCommutator, ContinuousLinearMap.smul_comp, smul_sub])
    (by
      intro X Y1 Y2
      apply ContinuousLinearMap.ext
      intro u
      apply DoubledSpace.ext <;>
        simp [operatorInformationMixedSecondVariation, operatorInformationFirstVariation,
          transportCommutator, sub_eq_add_neg, ContinuousLinearMap.add_comp,
          ContinuousLinearMap.comp_add]
      · abel
      · abel)
    (by
      intro c X Y
      apply ContinuousLinearMap.ext
      intro u
      apply DoubledSpace.ext <;>
        simp [operatorInformationMixedSecondVariation, operatorInformationFirstVariation,
          transportCommutator, ContinuousLinearMap.smul_comp, smul_sub])

@[rep_depth transport] theorem operatorInformationMixedSecondVariationMap_apply
    (A X Y : EndH) :
    operatorInformationMixedSecondVariationMap (E := E) A X Y
      =
    operatorInformationMixedSecondVariation (E := E) X Y A := rfl

/-- Nested Lie derivation channel generated by `X` after `Y`. -/
@[rep_depth transport]
noncomputable def observableLieHessian
    (X Y : EndH) : EndH →ₗ[ℝ] EndH :=
  (observableLieDerivation (E := E) X).comp
    (observableLieDerivation (E := E) Y)

@[rep_depth transport, simp] theorem observableLieHessian_apply
    (X Y A : EndH) :
    observableLieHessian (E := E) X Y A
      =
    operatorInformationMixedSecondVariation (E := E) X Y A := by
  simp [observableLieHessian, LinearMap.comp_apply,
    operatorInformationMixedSecondVariation]

/-- Diagonal second information variation of an observable seed. -/
@[rep_depth transport]
noncomputable abbrev operatorInformationHessian
    (X A : EndH) : EndH :=
  operatorInformationMixedSecondVariation (E := E) X X A

/-- Symmetric operator-valued second-variation sector. -/
@[rep_depth transport]
noncomputable def operatorInformationMetricPart
    (X Y A : EndH) : EndH :=
  ((2 : ℝ)⁻¹) •
    (operatorInformationMixedSecondVariation (E := E) X Y A
      + operatorInformationMixedSecondVariation (E := E) Y X A)

/--
The symmetric operator-valued second-variation sector as a canonical bilinear
map on perturbation channels.
-/
@[rep_depth transport]
noncomputable def operatorInformationMetricPartMap
    (A : EndH) :
    PerturbationChannel E →ₗ[ℝ] PerturbationChannel E →ₗ[ℝ] EndH :=
  ((2 : ℝ)⁻¹) •
    (operatorInformationMixedSecondVariationMap (E := E) A
      + (operatorInformationMixedSecondVariationMap (E := E) A).flip)

@[rep_depth transport] theorem operatorInformationMetricPartMap_apply
    (A X Y : EndH) :
    operatorInformationMetricPartMap (E := E) A X Y
      =
    operatorInformationMetricPart (E := E) X Y A := by
  simp [operatorInformationMetricPartMap, operatorInformationMetricPart,
    operatorInformationMixedSecondVariationMap_apply]

/-- Antisymmetric operator-valued second-variation sector. -/
@[rep_depth transport]
noncomputable def operatorInformationCurvaturePart
    (X Y A : EndH) : EndH :=
  operatorInformationMixedSecondVariation (E := E) X Y A
    - operatorInformationMixedSecondVariation (E := E) Y X A

/--
The antisymmetric operator-valued second-variation sector as a canonical
bilinear map on perturbation channels.
-/
@[rep_depth transport]
noncomputable def operatorInformationCurvaturePartMap
    (A : EndH) :
    PerturbationChannel E →ₗ[ℝ] PerturbationChannel E →ₗ[ℝ] EndH :=
  operatorInformationMixedSecondVariationMap (E := E) A
    - (operatorInformationMixedSecondVariationMap (E := E) A).flip

@[rep_depth transport] theorem operatorInformationCurvaturePartMap_apply
    (A X Y : EndH) :
    operatorInformationCurvaturePartMap (E := E) A X Y
      =
    operatorInformationCurvaturePart (E := E) X Y A := by
  simp [operatorInformationCurvaturePartMap, operatorInformationCurvaturePart,
    operatorInformationMixedSecondVariationMap_apply]

@[rep_depth transport] theorem operatorInformationMetricPartMap_diag
    (A X : EndH) :
    operatorInformationMetricPartMap (E := E) A X X
      =
    operatorInformationHessian (E := E) X A := by
  simpa [operatorInformationMetricPartMap_apply, operatorInformationMetricPart,
    operatorInformationHessian, invOf_eq_inv] using
    invOf_two_smul_add_invOf_two_smul ℝ
      (operatorInformationMixedSecondVariation (E := E) X X A)

@[rep_depth transport] theorem operatorInformationCurvaturePartMap_diag
    (A X : EndH) :
    operatorInformationCurvaturePartMap (E := E) A X X = 0 := by
  simp [operatorInformationCurvaturePartMap_apply, operatorInformationCurvaturePart]

/-!
The curvature channel is algebraic: it is the bracket derivation mandated by
Jacobi, not a background spacetime curvature tensor.
-/
@[rep_depth transport]
theorem operatorInformationCurvaturePart_eq_bracketDerivation
    (X Y A : EndH) :
    operatorInformationCurvaturePart (E := E) X Y A
      =
    observableLieDerivation (E := E) ⁅X, Y⁆ A := by
  have hFlat :
      operatorInformationCurvaturePart (E := E) X Y A
        - observableLieDerivation (E := E) ⁅X, Y⁆ A = 0 := by
    simpa [operatorInformationCurvaturePart, operatorInformationMixedSecondVariation,
      observableLieDerivation, operatorInformationFirstVariation,
      InfoGeometry.Canonical.RelationalInformationCore.transportObstruction,
      InfoGeometry.Canonical.RelationalInformationCore.perturbationDerivation,
      lieBracket_eq_transportCommutator] using
      (InfoGeometry.Canonical.RelationalInformationCore.transportObstruction_eq_zero
        (E := E) X Y A)
  exact sub_eq_zero.mp hFlat

/-- Exponential transport path of an observable seed along a transport channel. -/
@[rep_depth transport]
noncomputable def transportedObservable
    (X A : EndH) (t : ℝ) : EndH :=
  InfoGeometry.Canonical.expTransport (A := EndH) X A t

/-- Primitive operatorial Massieu value along the exponential transport orbit. -/
@[rep_depth transport]
noncomputable def transportedMassieuExpectation
    (ω : EndH →L[ℝ] ℝ) (X A : EndH) (t : ℝ) : ℝ :=
  ω (transportedObservable (E := E) X A t)

/--
The Lie derivation generated by `X` intertwines with the exponential transport
generated by the same `X`.
-/
@[rep_depth transport]
theorem observableLieDerivation_transport_intertwines
    (X A : EndH) (t : ℝ) :
    operatorInformationFirstVariation (E := E) X
      (transportedObservable (E := E) X A t)
      =
    transportedObservable (E := E) X
      (operatorInformationFirstVariation (E := E) X A) t := by
  simpa [operatorInformationFirstVariation, transportedObservable] using
    (transportCommutator_expTransport (E := E) X A t)

/--
The diagonal nested Lie derivation is transported exactly by the same
exponential orbit.
-/
@[rep_depth transport]
theorem observableLieHessian_transport_intertwines
    (X A : EndH) (t : ℝ) :
    operatorInformationHessian (E := E) X
      (transportedObservable (E := E) X A t)
      =
    transportedObservable (E := E) X
      (operatorInformationHessian (E := E) X A) t := by
  unfold operatorInformationHessian operatorInformationMixedSecondVariation
  rw [observableLieDerivation_transport_intertwines (E := E)
    (X := X) (A := A) (t := t)]
  exact observableLieDerivation_transport_intertwines (E := E)
    (X := X) (A := operatorInformationFirstVariation (E := E) X A) (t := t)

/--
Observable expectations respect the derivation/transport intertwining law.
-/
@[rep_depth transport]
theorem operatorMassieuExpectation_transport_intertwines_firstVariation
    (ω : EndH →L[ℝ] ℝ) (X A : EndH) (t : ℝ) :
    transportedMassieuExpectation (E := E) ω X
      (operatorInformationFirstVariation (E := E) X A) t
      =
    ω
      (operatorInformationFirstVariation (E := E) X
        (transportedObservable (E := E) X A t)) := by
  simpa [transportedMassieuExpectation] using
    congrArg ω
      (observableLieDerivation_transport_intertwines (E := E)
        (X := X) (A := A) (t := t)).symm

/--
Observable expectations also respect the transported diagonal Hessian channel.
-/
@[rep_depth transport]
theorem operatorMassieuExpectation_transport_intertwines_hessian
    (ω : EndH →L[ℝ] ℝ) (X A : EndH) (t : ℝ) :
    transportedMassieuExpectation (E := E) ω X
      (operatorInformationHessian (E := E) X A) t
      =
    ω
      (operatorInformationHessian (E := E) X
        (transportedObservable (E := E) X A t)) := by
  simpa [transportedMassieuExpectation] using
    congrArg ω
      (observableLieHessian_transport_intertwines (E := E)
        (X := X) (A := A) (t := t)).symm

/-- Metric readout of the first operatorial information variation. -/
@[rep_depth transport]
noncomputable def operatorInformationMetricReadout
    (X A : EndH) : LinearMap.BilinForm ℝ H₂ :=
  InfoGeometry.Quantum.GeometricQuantumTensor.metricOfOperator
    (E := E) (operatorInformationFirstVariation (E := E) X A)

/-- `(Jε)`-phase readout of the first operatorial information variation. -/
@[rep_depth transport]
noncomputable def operatorInformationPhaseReadout
    (X A : EndH) : LinearMap.BilinForm ℝ H₂ :=
  InfoGeometry.Quantum.GeometricQuantumTensor.berryOfOperator
    (E := E) (operatorInformationFirstVariation (E := E) X A)

/-- Channel bilinear form induced by evaluating perturbation channels on a fixed doubled state. -/
@[rep_depth krein]
noncomputable def channelMetricAtState
    (ψ : H₂) : LinearMap.BilinForm ℝ (PerturbationChannel E) :=
  LinearMap.mk₂ ℝ
    (fun X Y => ⟪X ψ, Y ψ⟫_ℝ)
    (by
      intro X₁ X₂ Y
      simp [inner_add_left])
    (by
      intro c X Y
      simp [real_inner_smul_left]
      ring)
    (by
      intro X Y₁ Y₂
      simp [inner_add_right])
    (by
      intro c X Y
      simp [real_inner_smul_right]
      ring)

@[rep_depth krein, simp] theorem channelMetricAtState_apply
    (ψ : H₂) (X Y : PerturbationChannel E) :
    channelMetricAtState (E := E) ψ X Y = ⟪X ψ, Y ψ⟫_ℝ := rfl

/-- Concrete constructive realization of the abstract relational-information datum. -/
@[rep_depth krein]
noncomputable def constructiveRelationalDatum
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ) :
    RelationalInformationDatum (E := E) where
  referenceState := reference
  comparisonState := comparison
  modularData := M
  informationFunctional := fun ψ =>
    operatorMassieuExpectation ω (stateRelativeModularGenerator (E := E) M ψ)
  firstVariation := fun ψ A =>
    ω (stateInducedDynamics (E := E) M ψ A)
  secondVariation := fun ψ =>
    channelMetricAtState (E := E) ψ

/--
The realized information functional is the primitive operatorial Massieu
expectation of the state-relative modular generator.
-/
@[rep_depth krein, simp]
theorem constructiveRelationalDatum_informationFunctional
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (ψ : H₂) :
    (constructiveRelationalDatum (E := E) reference comparison M ω).informationFunctional ψ
      =
    ω (stateRelativeModularGenerator (E := E) M ψ) := by
  rfl

/--
Reference functional value of the realized datum is the primitive expectation
of the reference-state modular generator.
-/
@[rep_depth krein, simp]
theorem constructiveRelationalDatum_referenceFunctionalValue
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ) :
    referenceFunctionalValue
        (constructiveRelationalDatum (E := E) reference comparison M ω)
      =
    ω (stateRelativeModularGenerator (E := E) M reference) := by
  rfl

/--
Comparison functional value of the realized datum is the primitive expectation
of the comparison-state modular generator.
-/
@[rep_depth krein, simp]
theorem constructiveRelationalDatum_comparisonFunctionalValue
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ) :
    comparisonFunctionalValue
        (constructiveRelationalDatum (E := E) reference comparison M ω)
      =
    ω (stateRelativeModularGenerator (E := E) M comparison) := by
  rfl

/-- Comparison-state channel metric of the realized datum is the state-evaluated channel bilinear form. -/
@[rep_depth krein, simp]
theorem constructiveRelationalDatum_comparisonGeneratorMetric_apply
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (X Y : PerturbationChannel E) :
    comparisonGeneratorMetric
        (constructiveRelationalDatum (E := E) reference comparison M ω) X Y
      =
    ⟪X comparison, Y comparison⟫_ℝ := by
  simp [comparisonGeneratorMetric, constructiveRelationalDatum, channelMetricAtState]

/-- The comparison-state first variation of the realized datum is the expected induced dynamics. -/
@[rep_depth transport, simp]
theorem constructiveRelationalDatum_firstVariation_comparison
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (A : ObservableAlgebra E) :
    (constructiveRelationalDatum (E := E) reference comparison M ω).firstVariation comparison A
      =
    ω (comparisonInducedDynamics
      (constructiveRelationalDatum (E := E) reference comparison M ω) A) := by
  rfl

/-- The comparison-state phase form of the realized datum is the channel metric twisted by `K = Jε`. -/
@[rep_depth krein, simp]
theorem constructiveRelationalDatum_comparisonGeneratorPhase_apply_eq_comp_complex_i
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (X Y : PerturbationChannel E) :
    comparisonGeneratorPhase
        (constructiveRelationalDatum (E := E) reference comparison M ω) X Y
      =
    ⟪(X.comp (InfoGeometry.Krein.complex_i (E := E))) comparison,
      Y comparison⟫_ℝ := by
  simp [comparisonGeneratorPhase, comparisonGeneratorMetric,
    constructiveRelationalDatum, channelMetricAtState, channelPhaseAxis]

@[rep_depth krein, simp]
theorem constructiveRelationalDatum_comparisonGeneratorPhase_apply
    (reference comparison : H₂)
    (M : StateModularDatum E)
    (ω : EndH →L[ℝ] ℝ)
    (X Y : PerturbationChannel E) :
    comparisonGeneratorPhase
        (constructiveRelationalDatum (E := E) reference comparison M ω) X Y
      =
    ⟪(X.comp (InfoGeometry.Canonical.TomitaTakesaki.modularComplexI (E := E))) comparison,
      Y comparison⟫_ℝ := by
  exact constructiveRelationalDatum_comparisonGeneratorPhase_apply_eq_comp_complex_i
    (E := E) reference comparison M ω X Y

end Core

section LightweightTheorems

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

/-- The symmetric second-variation sector is invariant under swapping the channels. -/
@[rep_depth transport]
theorem operatorInformationMetricPart_swap
    (X Y A : EndH) :
    operatorInformationMetricPart (E := E) X Y A
      =
    operatorInformationMetricPart (E := E) Y X A := by
  unfold operatorInformationMetricPart
  simp [add_comm]

/-- The phase readout is the metric readout twisted by the concrete phase axis `K = Jε`. -/
@[rep_depth transport, simp]
theorem operatorInformationPhaseReadout_eq_metric_comp_complex_i
    [CompleteSpace E]
    (X A : EndH) :
    operatorInformationPhaseReadout (E := E) X A
      =
    (operatorInformationMetricReadout (E := E) X A).compLeft
      (InfoGeometry.Krein.complex_i (E := E)).toLinearMap := by
  ext u v
  simp [operatorInformationPhaseReadout, operatorInformationMetricReadout]

@[rep_depth transport, simp]
theorem operatorInformationPhaseReadout_eq_metric_comp_modularComplexI
    (X A : EndH) :
    operatorInformationPhaseReadout (E := E) X A
      =
    (operatorInformationMetricReadout (E := E) X A).compLeft
      (InfoGeometry.Canonical.TomitaTakesaki.modularComplexI (E := E)).toLinearMap := by
  rfl

end LightweightTheorems

end InfoGeometry.Canonical.RelationalInformationDynamics
