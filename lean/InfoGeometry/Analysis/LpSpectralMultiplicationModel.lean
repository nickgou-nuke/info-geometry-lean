import InfoGeometry.OperatorAlgebra.ComplexBoundedOperators.L2Multiplier
import Mathlib.MeasureTheory.Function.L2Space
import Mathlib.MeasureTheory.Function.LpSpace.Complete
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.MeasureTheory.Function.SpecialFunctions.Basic
import Mathlib.MeasureTheory.Integral.DominatedConvergence
import Mathlib.Algebra.BigOperators.Group.Finset.Indicator

/-!
# TT-F5: Mathlib-Native `L²` Spectral Multiplication Model & Stone Unitary Group

This module extends `InfoGeometry.OperatorAlgebra.ComplexBoundedOperators.L2Multiplier`
over an arbitrary measurable space `(α, μ)` (with no `[SigmaFinite μ]` or
`[IsFiniteMeasure μ]` assumptions) to construct:

1. Bounded measurable multiplication operators `lpMulOpOfBound` via `memLp_top_of_bound`,
   along with algebraic, adjoint (`mulOp_adjoint`, `lpMulOpOfBound_adjoint`), and operator
   norm (`norm_lpMulOpOfBound_le_max`, `norm_lpMulOpOfBound_le`) lemmas.
2. The projection-valued spectral measure `pvmProj` on measurable subsets of `α`, proving
   self-adjointness, idempotence, `IsStarProjection`, lattice identities, disjoint
   orthogonality, and strong countable additivity (`pvmProj_countable_add`) via dominated
   convergence.
3. The Stone unitary 1-parameter group `stoneMulGroup` generated by a measurable real-valued
   function `h : α → ℝ`, proving group laws, adjointness, unitarity, isometry, and strong
   continuity (`stoneMulGroup_continuous`).
-/

set_option autoImplicit false

open scoped ENNReal InnerProduct
open MeasureTheory Filter Topology Function
open InfoGeometry.OperatorAlgebra.ComplexBoundedOperators.L2Multiplier

noncomputable section

namespace InfoGeometry.Analysis.LpSpectralMultiplicationModel

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}

/-! ### Part 1: Bounded Multiplication Operators on `L2c α μ` -/

/-- Lift an a.e.-bounded `AEStronglyMeasurable` function `f : α → ℂ` into `Linftyc α μ`. -/
def toLinftyOfBound (f : α → ℂ) (hf : AEStronglyMeasurable f μ)
    (C : ℝ) (hC : ∀ᵐ x ∂μ, ‖f x‖ ≤ C) : Linftyc α μ :=
  (MeasureTheory.memLp_top_of_bound hf C hC).toLp f

/-- A.e. representative identity for `toLinftyOfBound`. -/
theorem toLinftyOfBound_ae (f : α → ℂ) (hf : AEStronglyMeasurable f μ)
    (C : ℝ) (hC : ∀ᵐ x ∂μ, ‖f x‖ ≤ C) :
    toLinftyOfBound f hf C hC =ᵐ[μ] f :=
  MemLp.coeFn_toLp (MeasureTheory.memLp_top_of_bound hf C hC)

/-- Multiplication operator on `L2c α μ` induced by an a.e.-bounded measurable symbol
`f : α → ℂ`, reusing `L2Multiplier.mulOp`. -/
def lpMulOpOfBound (f : α → ℂ) (hf : AEStronglyMeasurable f μ)
    (C : ℝ) (hC : ∀ᵐ x ∂μ, ‖f x‖ ≤ C) : L2c α μ →L[ℂ] L2c α μ :=
  mulOp (toLinftyOfBound f hf C hC)

/-- Pointwise a.e. action of `lpMulOpOfBound`. -/
theorem lpMulOpOfBound_apply_ae (f : α → ℂ) (hf : AEStronglyMeasurable f μ)
    (C : ℝ) (hC : ∀ᵐ x ∂μ, ‖f x‖ ≤ C) (ψ : L2c α μ) :
    ⇑(lpMulOpOfBound f hf C hC ψ) =ᵐ[μ] fun x => f x * ψ x := by
  filter_upwards [mulOp_apply_ae (toLinftyOfBound f hf C hC) ψ,
    toLinftyOfBound_ae f hf C hC] with x hmul hlinf
  rw [lpMulOpOfBound, hmul, hlinf]

/-- Congruence of `lpMulOpOfBound` under a.e. equality of symbols. -/
theorem lpMulOpOfBound_congr_ae {f g : α → ℂ}
    (hf : AEStronglyMeasurable f μ) (hg : AEStronglyMeasurable g μ)
    {C₁ C₂ : ℝ} (hC₁ : ∀ᵐ x ∂μ, ‖f x‖ ≤ C₁) (hC₂ : ∀ᵐ x ∂μ, ‖g x‖ ≤ C₂)
    (hfg : f =ᵐ[μ] g) :
    lpMulOpOfBound f hf C₁ hC₁ = lpMulOpOfBound g hg C₂ hC₂ := by
  refine congrArg mulOp (MeasureTheory.Lp.ext ?_)
  exact (toLinftyOfBound_ae f hf C₁ hC₁).trans
    (hfg.trans (toLinftyOfBound_ae g hg C₂ hC₂).symm)

/-- Multiplicativity on `Linftyc α μ`: `mulOp (a • b) = mulOp a ∘L mulOp b`. -/
theorem mulOp_smul (a b : Linftyc α μ) :
    mulOp (α := α) (μ := μ) (a • b) =
      mulOp (α := α) (μ := μ) a ∘L mulOp (α := α) (μ := μ) b := by
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [mulOp_apply_ae (a • b) ψ, mulOp_apply_ae a (mulOp b ψ),
    mulOp_apply_ae b ψ, MeasureTheory.Lp.coeFn_lpSMul (r := ∞) a b] with x h1 h2 h3 hab
  rw [h1, ContinuousLinearMap.comp_apply, h2, h3, hab]
  exact mul_assoc (a x) (b x) (ψ x)

/-- Adjoint of `mulOp a` is `mulOp (star a)`. -/
theorem mulOp_adjoint (a : Linftyc α μ) :
    (mulOp (α := α) (μ := μ) a).adjoint = mulOp (α := α) (μ := μ) (star a) := by
  symm
  rw [ContinuousLinearMap.eq_adjoint_iff]
  intro ψ φ
  rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
  refine MeasureTheory.integral_congr_ae ?_
  filter_upwards [mulOp_apply_ae (star a) ψ, mulOp_apply_ae a φ,
    MeasureTheory.Lp.coeFn_star a] with x h1 h2 hstar
  rw [h1, h2, hstar, Pi.star_apply]
  simp only [RCLike.inner_apply, ← RCLike.star_def, star_mul, star_star]
  rw [← mul_assoc, mul_comm (φ x) (star (ψ x)), mul_assoc, mul_comm (φ x) (a x),
    mul_comm (star (ψ x))]

/-- Multiplicativity of `lpMulOpOfBound`. -/
theorem lpMulOpOfBound_mul (f g : α → ℂ)
    (hf : AEStronglyMeasurable f μ) (hg : AEStronglyMeasurable g μ)
    (C₁ C₂ : ℝ) (hC₁ : ∀ᵐ x ∂μ, ‖f x‖ ≤ C₁) (hC₂ : ∀ᵐ x ∂μ, ‖g x‖ ≤ C₂)
    (hfg : AEStronglyMeasurable (f * g) μ) (C₁₂ : ℝ)
    (hC₁₂ : ∀ᵐ x ∂μ, ‖(f * g) x‖ ≤ C₁₂) :
    lpMulOpOfBound (f * g) hfg C₁₂ hC₁₂ =
      lpMulOpOfBound f hf C₁ hC₁ ∘L lpMulOpOfBound g hg C₂ hC₂ := by
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [lpMulOpOfBound_apply_ae (f * g) hfg C₁₂ hC₁₂ ψ,
    lpMulOpOfBound_apply_ae f hf C₁ hC₁ (lpMulOpOfBound g hg C₂ hC₂ ψ),
    lpMulOpOfBound_apply_ae g hg C₂ hC₂ ψ] with x h1 h2 h3
  rw [h1, ContinuousLinearMap.comp_apply, h2, h3, Pi.mul_apply, mul_assoc]

/-- Identity multiplication operator on `L2c α μ`. -/
theorem lpMulOpOfBound_one
    (h1 : AEStronglyMeasurable (1 : α → ℂ) μ)
    (C : ℝ) (hC : ∀ᵐ x ∂μ, ‖(1 : α → ℂ) x‖ ≤ C) :
    lpMulOpOfBound (1 : α → ℂ) h1 C hC = 1 := by
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [lpMulOpOfBound_apply_ae (1 : α → ℂ) h1 C hC ψ] with x hx
  simpa using hx

/-- Star compatibility of `toLinftyOfBound`. -/
theorem toLinftyOfBound_star (f : α → ℂ)
    (hf : AEStronglyMeasurable f μ) (C : ℝ) (hC : ∀ᵐ x ∂μ, ‖f x‖ ≤ C)
    (hf_star : AEStronglyMeasurable (star ∘ f) μ) (C_star : ℝ)
    (hC_star : ∀ᵐ x ∂μ, ‖(star ∘ f) x‖ ≤ C_star) :
    toLinftyOfBound (star ∘ f) hf_star C_star hC_star =
      star (toLinftyOfBound f hf C hC) := by
  apply MeasureTheory.Lp.ext
  filter_upwards [toLinftyOfBound_ae (star ∘ f) hf_star C_star hC_star,
    MeasureTheory.Lp.coeFn_star (toLinftyOfBound f hf C hC),
    toLinftyOfBound_ae f hf C hC] with x h1 h2 h3
  rw [h1, h2, Pi.star_apply, h3]
  rfl

/-- Adjoint of `lpMulOpOfBound` corresponds to pointwise conjugation `star ∘ f`. -/
theorem lpMulOpOfBound_adjoint (f : α → ℂ)
    (hf : AEStronglyMeasurable f μ) (C : ℝ) (hC : ∀ᵐ x ∂μ, ‖f x‖ ≤ C)
    (hf_star : AEStronglyMeasurable (star ∘ f) μ) (C_star : ℝ)
    (hC_star : ∀ᵐ x ∂μ, ‖(star ∘ f) x‖ ≤ C_star) :
    (lpMulOpOfBound f hf C hC).adjoint =
      lpMulOpOfBound (star ∘ f) hf_star C_star hC_star := by
  rw [lpMulOpOfBound, mulOp_adjoint, ← toLinftyOfBound_star f hf C hC hf_star C_star hC_star]
  rfl

/-- Unconditional operator norm bound `‖lpMulOpOfBound f hf C hC‖ ≤ max C 0`. -/
theorem norm_lpMulOpOfBound_le_max (f : α → ℂ) (hf : AEStronglyMeasurable f μ)
    (C : ℝ) (hC : ∀ᵐ x ∂μ, ‖f x‖ ≤ C) :
    ‖lpMulOpOfBound f hf C hC‖ ≤ max C 0 := by
  calc ‖lpMulOpOfBound f hf C hC‖
      ≤ ‖toLinftyOfBound f hf C hC‖ := norm_mulOp_le _
    _ = ENNReal.toReal (eLpNorm f ∞ μ) := MeasureTheory.Lp.norm_toLp f _
    _ = ENNReal.toReal (eLpNormEssSup f μ) := by
        rw [MeasureTheory.eLpNorm_exponent_top hf]
    _ ≤ ENNReal.toReal (ENNReal.ofReal C) :=
        ENNReal.toReal_mono ENNReal.ofReal_ne_top
          (MeasureTheory.eLpNormEssSup_le_of_ae_bound hC)
    _ = max C 0 := ENNReal.toReal_ofReal'

/-- Operator norm bound `‖lpMulOpOfBound f hf C hC‖ ≤ C` when `0 ≤ C`. -/
theorem norm_lpMulOpOfBound_le (f : α → ℂ) (hf : AEStronglyMeasurable f μ)
    {C : ℝ} (hC_nonneg : 0 ≤ C) (hC : ∀ᵐ x ∂μ, ‖f x‖ ≤ C) :
    ‖lpMulOpOfBound f hf C hC‖ ≤ C := by
  simpa [max_eq_left hC_nonneg] using norm_lpMulOpOfBound_le_max f hf C hC

/-! ### Part 2: Projection-Valued Spectral Measure (`pvmProj`) -/

/-- Spectral projection onto a measurable subset `S : Set α` acting on `L2c α μ`
via multiplication by the indicator function `S.indicator (fun _ => (1 : ℂ))`. -/
def pvmProj (S : Set α) (hS : MeasurableSet S) : L2c α μ →L[ℂ] L2c α μ :=
  lpMulOpOfBound (S.indicator fun _ => (1 : ℂ))
    (aestronglyMeasurable_const.indicator hS) 1
    (Eventually.of_forall fun x => by by_cases hx : x ∈ S <;> simp [hx])

/-- Pointwise a.e. action of `pvmProj S hS`. -/
theorem pvmProj_apply_ae (S : Set α) (hS : MeasurableSet S) (ψ : L2c α μ) :
    ⇑(pvmProj (α := α) (μ := μ) S hS ψ) =ᵐ[μ]
      fun x => S.indicator (fun _ => (1 : ℂ)) x * ψ x :=
  lpMulOpOfBound_apply_ae _ _ _ _ ψ

/-- Every `pvmProj S hS` is self-adjoint. -/
theorem pvmProj_isSelfAdjoint (S : Set α) (hS : MeasurableSet S) :
    IsSelfAdjoint (pvmProj (α := α) (μ := μ) S hS) := by
  rw [ContinuousLinearMap.isSelfAdjoint_iff']
  have hstar_m : AEStronglyMeasurable (star ∘ S.indicator fun _ => (1 : ℂ)) μ :=
    (aestronglyMeasurable_const.indicator hS).star
  have hstar_b : ∀ᵐ x ∂μ, ‖(star ∘ S.indicator fun _ => (1 : ℂ)) x‖ ≤ (1 : ℝ) :=
    Eventually.of_forall fun x => by by_cases hx : x ∈ S <;> simp [hx]
  rw [pvmProj, lpMulOpOfBound_adjoint _ _ _ _ hstar_m 1 hstar_b]
  refine lpMulOpOfBound_congr_ae hstar_m (aestronglyMeasurable_const.indicator hS) hstar_b _ ?_
  exact Eventually.of_forall fun x => by by_cases hx : x ∈ S <;> simp [hx]

/-- Every `pvmProj S hS` is idempotent. -/
theorem pvmProj_isIdempotent (S : Set α) (hS : MeasurableSet S) :
    IsIdempotentElem (pvmProj (α := α) (μ := μ) S hS) := by
  unfold IsIdempotentElem
  rw [ContinuousLinearMap.mul_def]
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [pvmProj_apply_ae S hS (pvmProj S hS ψ),
    pvmProj_apply_ae S hS ψ] with x h1 h2
  rw [ContinuousLinearMap.comp_apply, h1, h2]
  by_cases hx : x ∈ S <;> simp [hx]

/-- Every `pvmProj S hS` is a star projection (`IsStarProjection`). -/
theorem pvmProj_isStarProjection (S : Set α) (hS : MeasurableSet S) :
    IsStarProjection (pvmProj (α := α) (μ := μ) S hS) :=
  ⟨pvmProj_isIdempotent S hS, pvmProj_isSelfAdjoint S hS⟩

/-- `pvmProj` on `Set.univ` is the identity operator. -/
theorem pvmProj_univ :
    pvmProj (α := α) (μ := μ) Set.univ MeasurableSet.univ = 1 := by
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [pvmProj_apply_ae Set.univ MeasurableSet.univ ψ] with x hx
  simp [hx]

/-- `pvmProj` on `∅` is the zero operator. -/
theorem pvmProj_empty :
    pvmProj (α := α) (μ := μ) ∅ MeasurableSet.empty = 0 := by
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [pvmProj_apply_ae ∅ MeasurableSet.empty ψ,
    MeasureTheory.Lp.coeFn_zero ℂ 2 μ] with x hx hz
  rw [zero_apply, hz, Pi.zero_apply, hx]
  simp

/-- `pvmProj` sends intersections to operator compositions. -/
theorem pvmProj_inter (S T : Set α) (hS : MeasurableSet S) (hT : MeasurableSet T) :
    pvmProj (α := α) (μ := μ) (S ∩ T) (hS.inter hT) =
      pvmProj (α := α) (μ := μ) S hS ∘L pvmProj (α := α) (μ := μ) T hT := by
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [pvmProj_apply_ae (S ∩ T) (hS.inter hT) ψ,
    pvmProj_apply_ae S hS (pvmProj T hT ψ), pvmProj_apply_ae T hT ψ] with x hST hS' hT'
  rw [ContinuousLinearMap.comp_apply, hST, hS', hT']
  by_cases hxS : x ∈ S <;> by_cases hxT : x ∈ T <;> simp [hxS, hxT]

/-- Disjoint measurable sets yield orthogonal spectral projections (`E(S) ∘L E(T) = 0`). -/
theorem pvmProj_disjoint_comp {S T : Set α}
    (hS : MeasurableSet S) (hT : MeasurableSet T) (hdisj : Disjoint S T) :
    pvmProj (α := α) (μ := μ) S hS ∘L pvmProj (α := α) (μ := μ) T hT = 0 := by
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [pvmProj_apply_ae S hS (pvmProj T hT ψ),
    pvmProj_apply_ae T hT ψ, MeasureTheory.Lp.coeFn_zero ℂ 2 μ] with x h1 h2 hz
  rw [ContinuousLinearMap.comp_apply, zero_apply, h1, h2, hz]
  by_cases hxS : x ∈ S
  · have hxT : x ∉ T := Set.disjoint_left.mp hdisj hxS
    simp [hxS, hxT]
  · simp [hxS]

/-- Countable strong additivity of `pvmProj` on pairwise disjoint measurable sets,
proved via dominated convergence in `L2c α μ` without any finiteness assumptions on `μ`. -/
theorem pvmProj_countable_add (S : ℕ → Set α) (hS : ∀ n, MeasurableSet (S n))
    (hdisj : Pairwise (Disjoint on S)) (ψ : L2c α μ) :
    Tendsto
      (fun N => ∑ n ∈ Finset.range N, pvmProj (α := α) (μ := μ) (S n) (hS n) ψ)
      atTop
      (𝓝 (pvmProj (α := α) (μ := μ) (⋃ n, S n) (MeasurableSet.iUnion hS) ψ)) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  let f : ℕ → L2c α μ := fun N =>
    ∑ n ∈ Finset.range N, pvmProj (α := α) (μ := μ) (S n) (hS n) ψ
  let fInf : L2c α μ :=
    pvmProj (α := α) (μ := μ) (⋃ n, S n) (MeasurableSet.iUnion hS) ψ
  let F : ℕ → α → ℝ := fun N x =>
    ‖((⋃ n ∈ Finset.range N, S n).indicator (fun _ => (1 : ℂ)) x -
      (⋃ n, S n).indicator (fun _ => (1 : ℂ)) x) * ψ x‖ ^ 2
  have hae : ∀ N, ∀ᵐ x ∂μ, (f N - fInf) x =
      ((⋃ n ∈ Finset.range N, S n).indicator (fun _ => (1 : ℂ)) x -
        (⋃ n, S n).indicator (fun _ => (1 : ℂ)) x) * ψ x := by
    intro N
    have hsum_ae : ∀ᵐ x ∂μ,
        ∀ n, ⇑(pvmProj (α := α) (μ := μ) (S n) (hS n) ψ) x =
          (S n).indicator (fun _ => (1 : ℂ)) x * ψ x :=
      ae_all_iff.mpr fun n => pvmProj_apply_ae (S n) (hS n) ψ
    filter_upwards [MeasureTheory.Lp.coeFn_sub (f N) fInf,
      MeasureTheory.Lp.coeFn_fun_finsetSum (Finset.range N)
        (fun n => pvmProj (α := α) (μ := μ) (S n) (hS n) ψ),
      hsum_ae, pvmProj_apply_ae (⋃ n, S n) (MeasurableSet.iUnion hS) ψ] with x hsub hfin hterm hinf
    rw [hsub, Pi.sub_apply, hfin, hinf]
    have hsum_eq :
        (∑ n ∈ Finset.range N, ⇑(pvmProj (α := α) (μ := μ) (S n) (hS n) ψ) x) =
          (⋃ n ∈ Finset.range N, S n).indicator (fun _ => (1 : ℂ)) x * ψ x := by
      simp_rw [hterm]
      rw [← Finset.sum_mul,
        Finset.indicator_biUnion_apply (Finset.range N) S (hdisj.pairwiseDisjoint _) x]
    rw [hsum_eq, ← sub_mul]
  have hnorm_sq : ∀ N, ‖f N - fInf‖ ^ 2 = ∫ x, F N x ∂μ := by
    intro N
    rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := ℂ), MeasureTheory.L2.inner_def,
      ← integral_re (MeasureTheory.L2.integrable_inner (f N - fInf) (f N - fInf))]
    refine MeasureTheory.integral_congr_ae ?_
    filter_upwards [hae N] with x hx
    rw [← InnerProductSpace.norm_sq_eq_re_inner (𝕜 := ℂ) ((f N - fInf) x), hx]
  have htend_sq : Tendsto (fun N => ∫ x, F N x ∂μ) atTop (𝓝 (∫ _ : α, (0 : ℝ) ∂μ)) := by
    refine MeasureTheory.tendsto_integral_of_dominated_convergence (bound := fun x => ‖ψ x‖ ^ 2)
      ?_ ?_ ?_ ?_
    · intro N
      have hmeas : AEStronglyMeasurable (fun x => ‖(f N - fInf) x‖ ^ 2) μ :=
        (MeasureTheory.Lp.aestronglyMeasurable (f N - fInf)).norm.pow 2
      refine hmeas.congr ?_
      filter_upwards [hae N] with x hx
      rw [hx]
    · exact (MeasureTheory.memLp_two_iff_integrable_sq_norm
        (MeasureTheory.Lp.aestronglyMeasurable ψ)).mp (MeasureTheory.Lp.memLp ψ)
    · intro N
      refine Eventually.of_forall fun x => ?_
      rw [Real.norm_of_nonneg (sq_nonneg _), norm_mul, mul_pow]
      have hdiff_le :
          ‖(⋃ n ∈ Finset.range N, S n).indicator (fun _ => (1 : ℂ)) x -
            (⋃ n, S n).indicator (fun _ => (1 : ℂ)) x‖ ≤ 1 := by
        by_cases hxN : x ∈ ⋃ n ∈ Finset.range N, S n
        · have hxU : x ∈ ⋃ n, S n := by
            rcases Set.mem_iUnion₂.mp hxN with ⟨n, _, hxn⟩
            exact Set.mem_iUnion.mpr ⟨n, hxn⟩
          rw [Set.indicator_of_mem hxN, Set.indicator_of_mem hxU, sub_self, norm_zero]
          norm_num
        · by_cases hxU : x ∈ ⋃ n, S n
          · rw [Set.indicator_of_notMem hxN, Set.indicator_of_mem hxU, zero_sub, norm_neg,
              norm_one]
          · rw [Set.indicator_of_notMem hxN, Set.indicator_of_notMem hxU, sub_self, norm_zero]
            norm_num
      calc ‖(⋃ n ∈ Finset.range N, S n).indicator (fun _ => (1 : ℂ)) x -
              (⋃ n, S n).indicator (fun _ => (1 : ℂ)) x‖ ^ 2 * ‖ψ x‖ ^ 2
          ≤ 1 ^ 2 * ‖ψ x‖ ^ 2 :=
            mul_le_mul_of_nonneg_right
              (pow_le_pow_left₀ (norm_nonneg _) hdiff_le 2) (sq_nonneg _)
        _ = ‖ψ x‖ ^ 2 := by rw [one_pow, one_mul]
    · refine Eventually.of_forall fun x => ?_
      by_cases hxU : x ∈ ⋃ n, S n
      · rcases Set.mem_iUnion.mp hxU with ⟨n₀, hxn₀⟩
        refine tendsto_atTop_of_eventually_const (i₀ := n₀ + 1) ?_
        intro N hN
        have hxN : x ∈ ⋃ n ∈ Finset.range N, S n :=
          Set.mem_iUnion₂.mpr
            ⟨n₀, Finset.mem_range.mpr (Nat.lt_of_lt_of_le (Nat.lt_succ_self n₀) hN), hxn₀⟩
        dsimp only [F]
        rw [Set.indicator_of_mem hxN, Set.indicator_of_mem hxU, sub_self, zero_mul, norm_zero]
        norm_num
      · refine tendsto_atTop_of_eventually_const (i₀ := 0) ?_
        intro N _
        have hxN : x ∉ ⋃ n ∈ Finset.range N, S n := by
          intro hxN
          rcases Set.mem_iUnion₂.mp hxN with ⟨n, _, hxn⟩
          exact hxU (Set.mem_iUnion.mpr ⟨n, hxn⟩)
        dsimp only [F]
        rw [Set.indicator_of_notMem hxN, Set.indicator_of_notMem hxU, sub_self, zero_mul,
          norm_zero]
        norm_num
  simp only [MeasureTheory.integral_zero] at htend_sq
  have htend_norm_sq : Tendsto (fun N => ‖f N - fInf‖ ^ 2) atTop (𝓝 0) := by
    simpa only [hnorm_sq] using htend_sq
  have htend_sqrt := htend_norm_sq.sqrt
  simpa [Real.sqrt_sq (norm_nonneg _), Real.sqrt_zero] using htend_sqrt

/-! ### Part 3: Stone Unitary 1-Parameter Group (`stoneMulGroup`) -/

/-- Stone unitary 1-parameter multiplication group `t ↦ M_{exp(i * t * h)}` on `L2c α μ`
generated by a measurable real-valued function `h : α → ℝ`. -/
def stoneMulGroup (h : α → ℝ) (hh : Measurable h) (t : ℝ) : L2c α μ →L[ℂ] L2c α μ :=
  lpMulOpOfBound
    (fun x => Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ)))
    ((measurable_const.mul
      (Complex.continuous_ofReal.measurable.comp hh)).cexp.aestronglyMeasurable)
    1
    (Eventually.of_forall fun x => by
      have harg : Complex.I * (t : ℂ) * (h x : ℂ) = Complex.I * ((t * h x : ℝ) : ℂ) := by
        push_cast
        rw [mul_assoc]
      rw [harg, Complex.norm_exp_I_mul_ofReal])

/-- Pointwise a.e. action of `stoneMulGroup`. -/
theorem stoneMulGroup_apply_ae (h : α → ℝ) (hh : Measurable h) (t : ℝ) (ψ : L2c α μ) :
    ⇑(stoneMulGroup (α := α) (μ := μ) h hh t ψ) =ᵐ[μ]
      fun x => Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ)) * ψ x :=
  lpMulOpOfBound_apply_ae _ _ _ _ ψ

/-- Group identity law at `t = 0`. -/
theorem stoneMulGroup_zero (h : α → ℝ) (hh : Measurable h) :
    stoneMulGroup (α := α) (μ := μ) h hh 0 = 1 := by
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [stoneMulGroup_apply_ae h hh 0 ψ] with x hx
  simp [hx]

/-- One-parameter group composition law `U_{s + t} = U_s ∘L U_t`. -/
theorem stoneMulGroup_add (h : α → ℝ) (hh : Measurable h) (s t : ℝ) :
    stoneMulGroup (α := α) (μ := μ) h hh (s + t) =
      stoneMulGroup (α := α) (μ := μ) h hh s ∘L
        stoneMulGroup (α := α) (μ := μ) h hh t := by
  refine ContinuousLinearMap.ext fun ψ => MeasureTheory.Lp.ext ?_
  filter_upwards [stoneMulGroup_apply_ae h hh (s + t) ψ,
    stoneMulGroup_apply_ae h hh s (stoneMulGroup h hh t ψ),
    stoneMulGroup_apply_ae h hh t ψ] with x hst hs ht
  rw [hst, ContinuousLinearMap.comp_apply, hs, ht]
  have harg :
      Complex.I * ((s + t : ℝ) : ℂ) * (h x : ℂ) =
        Complex.I * (s : ℂ) * (h x : ℂ) + Complex.I * (t : ℂ) * (h x : ℂ) := by
    push_cast
    rw [mul_add, add_mul]
  rw [harg, Complex.exp_add, mul_assoc]

/-- Adjoint of `stoneMulGroup h hh t` is `stoneMulGroup h hh (-t)`. -/
theorem stoneMulGroup_adjoint (h : α → ℝ) (hh : Measurable h) (t : ℝ) :
    (stoneMulGroup (α := α) (μ := μ) h hh t).adjoint =
      stoneMulGroup (α := α) (μ := μ) h hh (-t) := by
  have hstar_m :
      AEStronglyMeasurable
        (star ∘ fun x => Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))) μ :=
    ((measurable_const.mul
      (Complex.continuous_ofReal.measurable.comp hh)).cexp.aestronglyMeasurable).star
  have hstar_b :
      ∀ᵐ x ∂μ,
        ‖(star ∘ fun x => Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))) x‖ ≤ (1 : ℝ) :=
    Eventually.of_forall fun x => by
      have harg : Complex.I * (t : ℂ) * (h x : ℂ) = Complex.I * ((t * h x : ℝ) : ℂ) := by
        push_cast
        rw [mul_assoc]
      rw [Function.comp_apply, norm_star, harg, Complex.norm_exp_I_mul_ofReal]
  rw [stoneMulGroup, lpMulOpOfBound_adjoint _ _ _ _ hstar_m 1 hstar_b, stoneMulGroup]
  refine lpMulOpOfBound_congr_ae hstar_m _ hstar_b _ ?_
  refine Eventually.of_forall fun x => ?_
  simp only [Function.comp_apply, RCLike.star_def, ← Complex.exp_conj]
  congr 1
  simp only [map_mul, Complex.conj_I, Complex.conj_ofReal]
  push_cast
  rw [neg_mul, mul_neg, neg_mul]

/-- Composition `U_t ∘L U_{-t} = 1`. -/
theorem stoneMulGroup_comp_neg (h : α → ℝ) (hh : Measurable h) (t : ℝ) :
    stoneMulGroup (α := α) (μ := μ) h hh t ∘L
      stoneMulGroup (α := α) (μ := μ) h hh (-t) = 1 := by
  rw [← stoneMulGroup_add, add_neg_cancel, stoneMulGroup_zero]

/-- Composition `U_{-t} ∘L U_t = 1`. -/
theorem stoneMulGroup_neg_comp (h : α → ℝ) (hh : Measurable h) (t : ℝ) :
    stoneMulGroup (α := α) (μ := μ) h hh (-t) ∘L
      stoneMulGroup (α := α) (μ := μ) h hh t = 1 := by
  rw [← stoneMulGroup_add, neg_add_cancel, stoneMulGroup_zero]

/-- Each `stoneMulGroup h hh t` belongs to `unitary (L2c α μ →L[ℂ] L2c α μ)`. -/
theorem stoneMulGroup_unitary (h : α → ℝ) (hh : Measurable h) (t : ℝ) :
    stoneMulGroup (α := α) (μ := μ) h hh t ∈ unitary (L2c α μ →L[ℂ] L2c α μ) := by
  rw [Unitary.mem_iff, ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.mul_def,
    ContinuousLinearMap.mul_def, stoneMulGroup_adjoint]
  exact ⟨stoneMulGroup_neg_comp h hh t, stoneMulGroup_comp_neg h hh t⟩

/-- Each `stoneMulGroup h hh t` is an isometry on `L2c α μ`. -/
theorem stoneMulGroup_isometry (h : α → ℝ) (hh : Measurable h) (t : ℝ) :
    Isometry (stoneMulGroup (α := α) (μ := μ) h hh t) := by
  rw [ContinuousLinearMap.isometry_iff_adjoint_comp_self, stoneMulGroup_adjoint]
  exact stoneMulGroup_neg_comp h hh t

/-- Each `stoneMulGroup h hh t` preserves `L²` norm pointwise. -/
theorem norm_stoneMulGroup_apply (h : α → ℝ) (hh : Measurable h) (t : ℝ) (ψ : L2c α μ) :
    ‖stoneMulGroup (α := α) (μ := μ) h hh t ψ‖ = ‖ψ‖ :=
  ContinuousLinearMap.norm_map_of_mem_unitary (stoneMulGroup_unitary h hh t) ψ

/-- Strong continuity of `stoneMulGroup`: `t ↦ U_t ψ` is continuous in `L2c α μ`
for every `ψ : L2c α μ`, proved via dominated convergence without finiteness assumptions on `μ`. -/
theorem stoneMulGroup_continuous (h : α → ℝ) (hh : Measurable h) (ψ : L2c α μ) :
    Continuous (fun t : ℝ => stoneMulGroup (α := α) (μ := μ) h hh t ψ) := by
  rw [continuous_iff_seqContinuous]
  intro u t hu
  rw [tendsto_iff_norm_sub_tendsto_zero]
  let G : ℕ → α → ℝ := fun n x =>
    ‖(Complex.exp (Complex.I * (u n : ℂ) * (h x : ℂ)) -
      Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))) * ψ x‖ ^ 2
  have hae : ∀ n, ∀ᵐ x ∂μ,
      (stoneMulGroup (α := α) (μ := μ) h hh (u n) ψ -
        stoneMulGroup (α := α) (μ := μ) h hh t ψ) x =
      (Complex.exp (Complex.I * (u n : ℂ) * (h x : ℂ)) -
        Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))) * ψ x := by
    intro n
    filter_upwards [MeasureTheory.Lp.coeFn_sub
        (stoneMulGroup (α := α) (μ := μ) h hh (u n) ψ)
        (stoneMulGroup (α := α) (μ := μ) h hh t ψ),
      stoneMulGroup_apply_ae h hh (u n) ψ,
      stoneMulGroup_apply_ae h hh t ψ] with x hsub hun ht
    rw [hsub, Pi.sub_apply, hun, ht, sub_mul]
  have hnorm_sq : ∀ n,
      ‖stoneMulGroup (α := α) (μ := μ) h hh (u n) ψ -
        stoneMulGroup (α := α) (μ := μ) h hh t ψ‖ ^ 2 = ∫ x, G n x ∂μ := by
    intro n
    rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := ℂ), MeasureTheory.L2.inner_def,
      ← integral_re (MeasureTheory.L2.integrable_inner _ _)]
    refine MeasureTheory.integral_congr_ae ?_
    filter_upwards [hae n] with x hx
    rw [← InnerProductSpace.norm_sq_eq_re_inner (𝕜 := ℂ) _, hx]
  have htend_sq :
      Tendsto (fun n => ∫ x, G n x ∂μ) atTop (𝓝 (∫ _ : α, (0 : ℝ) ∂μ)) := by
    refine MeasureTheory.tendsto_integral_of_dominated_convergence
      (bound := fun x => 4 * ‖ψ x‖ ^ 2) ?_ ?_ ?_ ?_
    · intro n
      have hmeas :
          AEStronglyMeasurable
            (fun x => ‖(stoneMulGroup (α := α) (μ := μ) h hh (u n) ψ -
              stoneMulGroup (α := α) (μ := μ) h hh t ψ) x‖ ^ 2) μ :=
        (MeasureTheory.Lp.aestronglyMeasurable _).norm.pow 2
      refine hmeas.congr ?_
      filter_upwards [hae n] with x hx
      rw [hx]
    · exact ((MeasureTheory.memLp_two_iff_integrable_sq_norm
        (MeasureTheory.Lp.aestronglyMeasurable ψ)).mp
        (MeasureTheory.Lp.memLp ψ)).const_mul 4
    · intro n
      refine Eventually.of_forall fun x => ?_
      rw [Real.norm_of_nonneg (sq_nonneg _), norm_mul, mul_pow]
      have harg_u :
          Complex.I * (u n : ℂ) * (h x : ℂ) = Complex.I * ((u n * h x : ℝ) : ℂ) := by
        push_cast
        rw [mul_assoc]
      have harg_t :
          Complex.I * (t : ℂ) * (h x : ℂ) = Complex.I * ((t * h x : ℝ) : ℂ) := by
        push_cast
        rw [mul_assoc]
      have hdiff_le :
          ‖Complex.exp (Complex.I * (u n : ℂ) * (h x : ℂ)) -
            Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))‖ ≤ 2 := by
        calc ‖Complex.exp (Complex.I * (u n : ℂ) * (h x : ℂ)) -
              Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))‖
            ≤ ‖Complex.exp (Complex.I * (u n : ℂ) * (h x : ℂ))‖ +
                ‖Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))‖ := norm_sub_le _ _
          _ = 1 + 1 := by
              rw [harg_u, harg_t, Complex.norm_exp_I_mul_ofReal, Complex.norm_exp_I_mul_ofReal]
          _ = 2 := by norm_num
      calc ‖Complex.exp (Complex.I * (u n : ℂ) * (h x : ℂ)) -
              Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))‖ ^ 2 * ‖ψ x‖ ^ 2
          ≤ 2 ^ 2 * ‖ψ x‖ ^ 2 :=
            mul_le_mul_of_nonneg_right
              (pow_le_pow_left₀ (norm_nonneg _) hdiff_le 2) (sq_nonneg _)
        _ = 4 * ‖ψ x‖ ^ 2 := by norm_num
    · refine Eventually.of_forall fun x => ?_
      have harg_tend :
          Tendsto (fun n => Complex.I * (u n : ℂ) * (h x : ℂ)) atTop
            (𝓝 (Complex.I * (t : ℂ) * (h x : ℂ))) :=
        (tendsto_const_nhds.mul ((Complex.continuous_ofReal.tendsto t).comp hu)).mul
          tendsto_const_nhds
      have hexp_tend :
          Tendsto (fun n => Complex.exp (Complex.I * (u n : ℂ) * (h x : ℂ))) atTop
            (𝓝 (Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ)))) :=
        harg_tend.cexp
      have hsub_tend :
          Tendsto
            (fun n =>
              (Complex.exp (Complex.I * (u n : ℂ) * (h x : ℂ)) -
                Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))) * ψ x)
            atTop (𝓝 (0 : ℂ)) := by
        simpa [sub_self, zero_mul] using
          (hexp_tend.sub
            (tendsto_const_nhds (x := Complex.exp (Complex.I * (t : ℂ) * (h x : ℂ))))).mul
            (tendsto_const_nhds (x := ψ x))
      have hpow_tend := (hsub_tend.norm).pow 2
      simpa [G] using hpow_tend
  simp only [MeasureTheory.integral_zero] at htend_sq
  have htend_norm_sq :
      Tendsto
        (fun n => ‖stoneMulGroup (α := α) (μ := μ) h hh (u n) ψ -
          stoneMulGroup (α := α) (μ := μ) h hh t ψ‖ ^ 2)
        atTop (𝓝 0) := by
    simpa only [hnorm_sq] using htend_sq
  have htend_sqrt := htend_norm_sq.sqrt
  simpa [Real.sqrt_sq (norm_nonneg _), Real.sqrt_zero] using htend_sqrt

end InfoGeometry.Analysis.LpSpectralMultiplicationModel
