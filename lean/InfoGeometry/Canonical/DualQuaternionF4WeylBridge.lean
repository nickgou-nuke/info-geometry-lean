import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra

/-!
# Abstract F₄ Coxeter Datum and Generated Linear Group

This file records an abstract four-generator linear-equivalence datum with
the Coxeter relations of type F₄. It does not construct the generators from
dual quaternions or identify the generated subgroup with the canonical root
reflection group $W(F_4)$.

The datum supplies four linear equivalences $e_1, e_2, e_3, e_4$ and their
Coxeter relations for F₄:
- Involutivity: $e_i^2 = 1$
- Braid relations: $(e_1 e_2)^3 = 1$, $(e_2 e_3)^4 = 1$, $(e_3 e_4)^3 = 1$
- Commutativity for non-adjacent nodes.

The generated subgroup can be rewritten as the closure of the range of the
same four declared generators. A realization from a concrete carrier and a
comparison with the root-system Weyl group remain separate obligations.
-/

namespace InfoGeometry.Canonical.DualQuaternionF4WeylBridge

/-- Abstract datum for four linear equivalences satisfying the F₄ Coxeter
relations. A concrete dual-quaternion realization is not part of this
structure. -/
structure DualQuaternionF4WeylDatum (V : Type*) [AddCommGroup V] [Module ℝ V] where
  e1 : V ≃ₗ[ℝ] V
  e2 : V ≃ₗ[ℝ] V
  e3 : V ≃ₗ[ℝ] V
  e4 : V ≃ₗ[ℝ] V

  -- Involutivity (Coxeter generators)
  e1_sq : e1 * e1 = 1
  e2_sq : e2 * e2 = 1
  e3_sq : e3 * e3 = 1
  e4_sq : e4 * e4 = 1

  -- Coxeter braid relations for F4
  e1e2_order3 : (e1 * e2) ^ 3 = 1
  e2e3_order4 : (e2 * e3) ^ 4 = 1
  e3e4_order3 : (e3 * e4) ^ 3 = 1

  -- Non-adjacent commutativity (order 2)
  e1e3_commute : e1 * e3 = e3 * e1
  e1e4_commute : e1 * e4 = e4 * e1
  e2e4_commute : e2 * e4 = e4 * e2

variable {V : Type*} [AddCommGroup V] [Module ℝ V] (D : DualQuaternionF4WeylDatum V)

-- The theorem surface required by the architectural boundary:

theorem dualQuaternionF4_e1_sq : D.e1 * D.e1 = 1 := D.e1_sq
theorem dualQuaternionF4_e2_sq : D.e2 * D.e2 = 1 := D.e2_sq
theorem dualQuaternionF4_e3_sq : D.e3 * D.e3 = 1 := D.e3_sq
theorem dualQuaternionF4_e4_sq : D.e4 * D.e4 = 1 := D.e4_sq

theorem dualQuaternionF4_e1e2_order3 : (D.e1 * D.e2) ^ 3 = 1 := D.e1e2_order3
theorem dualQuaternionF4_e2e3_order4 : (D.e2 * D.e3) ^ 4 = 1 := D.e2e3_order4
theorem dualQuaternionF4_e3e4_order3 : (D.e3 * D.e4) ^ 3 = 1 := D.e3e4_order3

theorem dualQuaternionF4_e1e3_commute : D.e1 * D.e3 = D.e3 * D.e1 := D.e1e3_commute
theorem dualQuaternionF4_e1e4_commute : D.e1 * D.e4 = D.e4 * D.e1 := D.e1e4_commute
theorem dualQuaternionF4_e2e4_commute : D.e2 * D.e4 = D.e4 * D.e2 := D.e2e4_commute

/-- The subgroup of linear equivalences generated by the four declared
generators in the abstract datum. -/
def dualQuaternionF4GeneratedSubgroup : Subgroup (V ≃ₗ[ℝ] V) :=
  Subgroup.closure {D.e1, D.e2, D.e3, D.e4}

/-- The four declared generators, indexed as the simple generators of the
abstract F₄ Coxeter diagram. No map to a root-system realization is supplied. -/
def canonicalF4SimpleReflections (D : DualQuaternionF4WeylDatum V) : Fin 4 → (V ≃ₗ[ℝ] V)
  | 0 => D.e1
  | 1 => D.e2
  | 2 => D.e3
  | 3 => D.e4

/-- The indexed family returns the four declared generators by definition. -/
theorem dualQuaternionF4_eq_simpleReflections :
    (D.e1 = canonicalF4SimpleReflections D 0) ∧
    (D.e2 = canonicalF4SimpleReflections D 1) ∧
    (D.e3 = canonicalF4SimpleReflections D 2) ∧
    (D.e4 = canonicalF4SimpleReflections D 3) :=
  ⟨rfl, rfl, rfl, rfl⟩

theorem canonicalF4SimpleReflections_range :
    Set.range (canonicalF4SimpleReflections D) = {D.e1, D.e2, D.e3, D.e4} := by
  ext x
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i <;> simp [canonicalF4SimpleReflections]
  · rintro (rfl | rfl | rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩
    · exact ⟨2, rfl⟩
    · exact ⟨3, rfl⟩

/-- The generated subgroup is the closure of the range of its four declared
generators. This is not an identification with the canonical Weyl group. -/
theorem dualQuaternionF4GeneratedSubgroup_eq_simpleReflectionClosure :
    dualQuaternionF4GeneratedSubgroup D = Subgroup.closure (Set.range (canonicalF4SimpleReflections D)) := by
  dsimp [dualQuaternionF4GeneratedSubgroup]
  rw [canonicalF4SimpleReflections_range D]

/-- Compatibility alias for the old name. The equality only rewrites the
generating set; it does not prove that this subgroup is $W(F_4)$. -/
theorem dualQuaternionF4GeneratedSubgroup_eq_weylF4 :
    dualQuaternionF4GeneratedSubgroup D =
      Subgroup.closure (Set.range (canonicalF4SimpleReflections D)) :=
  dualQuaternionF4GeneratedSubgroup_eq_simpleReflectionClosure D

end InfoGeometry.Canonical.DualQuaternionF4WeylBridge
