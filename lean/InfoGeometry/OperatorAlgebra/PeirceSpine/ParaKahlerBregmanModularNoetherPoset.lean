      comm (genSig P A C) (genPhi P A C) = genV P A C * comm (invS P) (genPhi P A C)) ∧
    (comm (genV P A C) (idempotencyDefect (genV P A C)) = 0 ∧
      comm (genSig P A C) (idempotencyDefect (genV P A C)) = 0) ∧
    (irrotationalLieFlow P A C (rotationalLieFlow P A C X) -
        rotationalLieFlow P A C (irrotationalLieFlow P A C X) =
      -((2 : ℤ) • comm (genSig P A C) X)) := by
  have hM1 := archetype_M1_parakahler_hessian_and_curvature_2form hP A C X
  have hM2 := archetype_M2_modular_surprisal_and_bregman_three_point hP A C A A C C X Y Z
  have hM3 := archetype_M3_dragged_frame_and_onsager_reciprocity hP A C
