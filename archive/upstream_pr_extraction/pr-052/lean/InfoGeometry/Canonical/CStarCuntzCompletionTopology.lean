import InfoGeometry.Physics.CStarCuntzTensorQuotient
import Mathlib.Topology.Category.TopCat.Basic

/-!
# Topological boundary of a Cuntz C⋆ completion

An actual `CStarCuntzCompletion` already records that the closed star
subalgebra generated by its family is the whole carrier.  This owner turns
that equality into the corresponding native homeomorphism and `TopCat` arrow.
No completion or norm is constructed here; the result only transports the
topology supplied by the C⋆ realization.
-/

noncomputable section

namespace InfoGeometry.Physics.CStarCuntzTensorQuotient.CStarCuntzCompletion

open CategoryTheory

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def generatedToCarrierHomeomorph (U : CStarCuntzCompletion ι) :
    U.family.generatedCStarSubalgebra ≃ₜ U.carrier := by
  have hset :
      (↑U.family.generatedCStarSubalgebra : Set U.carrier) =
        (Set.univ : Set U.carrier) := by
    rw [U.universalNormCompletion]
    rfl
  exact (Homeomorph.setCongr hset).trans (Homeomorph.Set.univ U.carrier)

@[simp] theorem generatedToCarrierHomeomorph_apply
    (U : CStarCuntzCompletion ι)
    (a : U.family.generatedCStarSubalgebra) :
    U.generatedToCarrierHomeomorph a = (a : U.carrier) :=
  rfl

def generatedToCarrierTopCatHom (U : CStarCuntzCompletion ι) :
    TopCat.of U.family.generatedCStarSubalgebra ⟶ TopCat.of U.carrier :=
  TopCat.ofHom
    { toFun := fun a => U.generatedToCarrierHomeomorph a
      continuous_toFun := U.generatedToCarrierHomeomorph.continuous }

def carrierToGeneratedTopCatHom (U : CStarCuntzCompletion ι) :
    TopCat.of U.carrier ⟶ TopCat.of U.family.generatedCStarSubalgebra :=
  TopCat.ofHom
    { toFun := fun a => U.generatedToCarrierHomeomorph.symm a
      continuous_toFun := U.generatedToCarrierHomeomorph.symm.continuous }

@[simp] theorem generatedToCarrierTopCatHom_apply
    (U : CStarCuntzCompletion ι)
    (a : U.family.generatedCStarSubalgebra) :
    U.generatedToCarrierTopCatHom a = (a : U.carrier) :=
  by
    change U.generatedToCarrierHomeomorph a = (a : U.carrier)
    rfl

@[simp] theorem carrierToGeneratedTopCatHom_apply
    (U : CStarCuntzCompletion ι) (a : U.carrier) :
    U.carrierToGeneratedTopCatHom a = U.generatedToCarrierHomeomorph.symm a :=
  by
    change U.generatedToCarrierHomeomorph.symm a = U.generatedToCarrierHomeomorph.symm a
    rfl

theorem generatedToCarrierTopCatHom_isIso (U : CStarCuntzCompletion ι) :
    IsIso U.generatedToCarrierTopCatHom := by
  refine IsIso.mk ⟨U.carrierToGeneratedTopCatHom, ?_, ?_⟩
  · apply TopCat.hom_ext
    ext a
    rw [TopCat.comp_app, TopCat.id_app]
    simp [generatedToCarrierTopCatHom, carrierToGeneratedTopCatHom,
      TopCat.ofHom]
    rw [← generatedToCarrierHomeomorph_apply U a]
    exact U.generatedToCarrierHomeomorph.symm_apply_apply a
  · apply TopCat.hom_ext
    ext a
    rw [TopCat.comp_app, TopCat.id_app]
    simp [generatedToCarrierTopCatHom, carrierToGeneratedTopCatHom,
      TopCat.ofHom]
    rw [← generatedToCarrierHomeomorph_apply U
      (U.generatedToCarrierHomeomorph.symm a)]
    exact U.generatedToCarrierHomeomorph.apply_symm_apply a

theorem generatedToCarrierHomeomorph_generator
    (U : CStarCuntzCompletion ι) (i : ι) :
    U.generatedToCarrierHomeomorph
        (⟨U.family.S i, U.family.S_mem_generatedCStarSubalgebra i⟩ :
          U.family.generatedCStarSubalgebra) = U.family.S i :=
  rfl

theorem carrierToGeneratedTopCatHom_generator
    (U : CStarCuntzCompletion ι) (i : ι) :
    U.carrierToGeneratedTopCatHom (U.family.S i) =
      (⟨U.family.S i, U.family.S_mem_generatedCStarSubalgebra i⟩ :
        U.family.generatedCStarSubalgebra) := by
  apply U.generatedToCarrierHomeomorph.injective
  simp [carrierToGeneratedTopCatHom, TopCat.ofHom]

theorem carrierToGeneratedTopCatHom_star_generator
    (U : CStarCuntzCompletion ι) (i : ι) :
    U.carrierToGeneratedTopCatHom (star (U.family.S i)) =
      star (⟨U.family.S i, U.family.S_mem_generatedCStarSubalgebra i⟩ :
        U.family.generatedCStarSubalgebra) := by
  apply U.generatedToCarrierHomeomorph.injective
  simp [carrierToGeneratedTopCatHom, TopCat.ofHom]

end InfoGeometry.Physics.CStarCuntzTensorQuotient.CStarCuntzCompletion
