import InfoGeometry.Categorical.LogNilpotentBraidGroup3Representation
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Categorical.LogJordanCheckedRBraidBridge

/-!
# InfoGeometry.Categorical.LogJordanBraidGroup3Representation

Concrete three-strand braid-group representation generated by the standard
rank-two logarithmic Jordan object at the repository-owned Hadjiivanov shear
parameter `logShearBase = -2πi`.

All group-theoretic infrastructure is reused from
`FibonacciBraidGroup3Representation`; all checked-`R` and Yang--Baxter data is
reused from `LogJordanCheckedRBraidBridge` and `LogNilpotentCrossCheckedR`.
-/

noncomputable section

namespace InfoGeometry.Categorical.LogJordanBraidGroup3Representation

open InfoGeometry.Categorical.FibonacciBraidGroup3Representation
open InfoGeometry.Categorical.LogNilpotentBraidGroup3Representation
open InfoGeometry.Categorical.LogNilpotentCrossCheckedR
open InfoGeometry.Categorical.LogJordanCheckedRBraidBridge
open InfoGeometry.Clifford.LogCftMonodromy

/-- The three-fold tensor carrier generated by the standard rank-two logarithmic
Jordan object. -/
abbrev StandardTripleCarrier := TripleCarrier standardJordanObject

/-- The two local Hadjiivanov checked braid operators form the standard Artin
pair on the logarithmic triple tensor carrier. -/
def standardHadjiivanovBraidGenerators :
    BraidThreeGenerators
      (StandardTripleCarrier ≃ₗ[ℂ] StandardTripleCarrier) :=
  logBraidThreeGenerators standardJordanObject
    standardJordanObject_sq_zero logShearBase

/-- Group-level `B₃` action on the standard logarithmic triple tensor carrier. -/
def standardHadjiivanovBraidGroup3Hom :
    BraidGroup3 →*
      (StandardTripleCarrier ≃ₗ[ℂ] StandardTripleCarrier) :=
  standardHadjiivanovBraidGenerators.toGroupHom

/-- Mathlib representation of `B₃` on the standard logarithmic triple tensor
carrier. -/
def standardHadjiivanovBraidRepresentation :
    Representation ℂ BraidGroup3 StandardTripleCarrier :=
  LinearEquiv.automorphismGroup.toLinearMapMonoidHom.comp
    standardHadjiivanovBraidGroup3Hom

/-- The first braid generator acts on tensor positions 1--2 by the standard
Hadjiivanov checked `R`. -/
@[simp]
theorem standardHadjiivanov_sigmaOne :
    standardHadjiivanovBraidGroup3Hom sigmaOne =
      logCheckedR12 standardJordanObject standardJordanObject_sq_zero
        logShearBase := by
  simp [standardHadjiivanovBraidGroup3Hom,
    standardHadjiivanovBraidGenerators,
    logBraidThreeGenerators]

/-- The second braid generator acts on tensor positions 2--3 by the same local
Hadjiivanov checked `R`. -/
@[simp]
theorem standardHadjiivanov_sigmaTwo :
    standardHadjiivanovBraidGroup3Hom sigmaTwo =
      logCheckedR23 standardJordanObject standardJordanObject_sq_zero
        logShearBase := by
  simp [standardHadjiivanovBraidGroup3Hom,
    standardHadjiivanovBraidGenerators,
    logBraidThreeGenerators]

/-- The concrete logarithmic braid representation satisfies the defining Artin
relation of `B₃`. -/
theorem standardHadjiivanov_artin :
    standardHadjiivanovBraidGroup3Hom sigmaOne *
        standardHadjiivanovBraidGroup3Hom sigmaTwo *
        standardHadjiivanovBraidGroup3Hom sigmaOne =
      standardHadjiivanovBraidGroup3Hom sigmaTwo *
        standardHadjiivanovBraidGroup3Hom sigmaOne *
        standardHadjiivanovBraidGroup3Hom sigmaTwo := by
  exact standardHadjiivanovBraidGenerators.artin

/-- Readback of the first generator through Mathlib's `Representation`. -/
@[simp]
theorem standardHadjiivanov_representation_sigmaOne :
    standardHadjiivanovBraidRepresentation sigmaOne =
      (logCheckedR12 standardJordanObject standardJordanObject_sq_zero
        logShearBase).toLinearMap := by
  rfl

/-- Readback of the second generator through Mathlib's `Representation`. -/
@[simp]
theorem standardHadjiivanov_representation_sigmaTwo :
    standardHadjiivanovBraidRepresentation sigmaTwo =
      (logCheckedR23 standardJordanObject standardJordanObject_sq_zero
        logShearBase).toLinearMap := by
  rfl

/-- Inverse first braid generator readback. -/
@[simp]
theorem standardHadjiivanov_sigmaOne_inv :
    standardHadjiivanovBraidGroup3Hom sigmaOne⁻¹ =
      (logCheckedR12 standardJordanObject standardJordanObject_sq_zero
        logShearBase)⁻¹ := by
  rw [map_inv]
  rfl

/-- Inverse second braid generator readback. -/
@[simp]
theorem standardHadjiivanov_sigmaTwo_inv :
    standardHadjiivanovBraidGroup3Hom sigmaTwo⁻¹ =
      (logCheckedR23 standardJordanObject standardJordanObject_sq_zero
        logShearBase)⁻¹ := by
  rw [map_inv]
  rfl

end InfoGeometry.Categorical.LogJordanBraidGroup3Representation
