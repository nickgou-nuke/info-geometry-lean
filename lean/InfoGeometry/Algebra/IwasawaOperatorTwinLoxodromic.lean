import Mathlib
import InfoGeometry.Algebra.FiniteSpinAlgebra

namespace InfoGeometry.Algebra.IwasawaOperatorTwinLoxodromic

open Finset

/-!
# Iwasawa Operator Skeleton: Rotors ($\mathcal{J}^2 = -1$), Dilations, Involutions ($\Gamma^2 = 1, \Sigma^2 = 1$), and Derivations

This module formalizes the algebraic operator components of the $K, A, N$ Iwasawa-type hierarchy:
1. **$K$-sector (Circular Rotors)**:
   Generated by a complex structure $\mathcal{J}$ with $\mathcal{J}^2 = -1$:
   $K(\theta) = \cos\theta \cdot 1 + \sin\theta \cdot \mathcal{J}$.
2. **$A$-sector (Semisimple Dilations and Weyl Reflection)**:
   Infinitesimal generator $D$ and sheet/Weyl reflection $\Sigma$ satisfying $\Sigma D \Sigma = -D$.
3. **$N$-sector (Unipotents and Derivations)**:
   Unipotent flow $U(N) = 1 + N$ from nilpotent generators $N^k = 0$, and derivation Lie closure
   $[D_1, D_2] \in \operatorname{Der}(A)$ for arbitrary nonassociative algebras.
4. **Twin $\mathbb{Z}_2 \times \mathbb{Z}_2$ Grading Projectors**:
   Generated by two commuting grading involutions $(\Gamma, \Sigma)$ with $\Gamma^2 = 1, \Sigma^2 = 1$:
   $$P_{\sigma, \tau} = \frac{1}{4}(1 + \sigma \Gamma)(1 + \tau \Sigma), \quad \sigma, \tau \in \{+1, -1\}$$
   satisfying completeness, idempotence, and pairwise orthogonality.

*Note*: This file formalizes the algebraic operator skeleton for $K, A, N$ components;
it does not assert a full group-level Iwasawa decomposition $G = KAN$.
-/

variable {R : Type*} [CommRing R]

/-! ### 1. K-Sector: Complex Rotors ($\mathcal{J}^2 = -1$) -/

section RotorSector

/-- A complex structure generator $\mathcal{J}$ with $\mathcal{J}^2 = -1$. -/
def IsComplexStructure (J : R) : Prop :=
  J * J = -1

/-- Circular rotor $K(c, s) = c \cdot 1 + s \cdot \mathcal{J}$. -/
def rotor (J c s : R) : R :=
  c + s * J

/-- 🏆 THEOREM: Rotor multiplication: $K(c_1, s_1) K(c_2, s_2) = K(c_1 c_2 - s_1 s_2, s_1 c_2 + c_1 s_2)$
    under $\mathcal{J}^2 = -1$. -/
theorem rotor_mul (J : R) (hJ : IsComplexStructure J) (c1 s1 c2 s2 : R) :
    rotor J c1 s1 * rotor J c2 s2 =
      rotor J (c1 * c2 - s1 * s2) (s1 * c2 + c1 * s2) := by
  dsimp [rotor]
  dsimp [IsComplexStructure] at hJ
  calc
    (c1 + s1 * J) * (c2 + s2 * J) =
        c1 * c2 + (s1 * c2 + c1 * s2) * J + s1 * s2 * (J * J) := by ring
    _ = c1 * c2 + (s1 * c2 + c1 * s2) * J + s1 * s2 * (-1) := by rw [hJ]
    _ = (c1 * c2 - s1 * s2) + (s1 * c2 + c1 * s2) * J := by ring

/-- Unit rotor condition: $c^2 + s^2 = 1 \implies K(c, s) K(c, -s) = 1$. -/
theorem rotor_inv (J : R) (hJ : IsComplexStructure J) (c s : R) (h : c ^ 2 + s ^ 2 = 1) :
    rotor J c s * rotor J c (-s) = 1 := by
  rw [rotor_mul J hJ]
  dsimp [rotor]
  have h1 : c * c - s * (-s) = 1 := by
    calc
      c * c - s * (-s) = c ^ 2 + s ^ 2 := by ring
      _ = 1 := h
  have h2 : s * c + c * (-s) = 0 := by ring
  rw [h1, h2, zero_mul, add_zero]

end RotorSector

/-! ### 2. A-Sector: Infinitesimal Dilations & Weyl Sheet Inversion ($\Sigma D \Sigma = -D$) -/

section DilationFlow

/-- A Weyl sheet reflection $\Sigma$ and dilation generator $D$ satisfying $\Sigma^2 = 1$ and $\Sigma D \Sigma = -D$. -/
structure WeylDilationPair (Sig D : R) : Prop where
  sig_sq : Sig * Sig = 1
  sig_conj_D : Sig * D * Sig = -D

/-- 🏆 THEOREM: Weyl sheet reflection inverts powers: $\Sigma D^k \Sigma = (-D)^k$. -/
theorem weyl_dilation_pow (Sig D : R) (hW : WeylDilationPair Sig D) (k : ℕ) :
    Sig * (D ^ k) * Sig = (-D) ^ k := by
  induction k with
  | zero =>
    rw [pow_zero, pow_zero, mul_one, hW.sig_sq]
  | succ k ih =>
    calc
      Sig * (D ^ (k + 1)) * Sig = Sig * (D ^ k * D) * Sig := by rw [pow_succ]
      _ = Sig * (D ^ k) * 1 * D * Sig := by ring
      _ = Sig * (D ^ k) * (Sig * Sig) * D * Sig := by rw [hW.sig_sq]
      _ = (Sig * (D ^ k) * Sig) * (Sig * D * Sig) := by ring
      _ = ((-D) ^ k) * (-D) := by rw [ih, hW.sig_conj_D]
      _ = (-D) ^ (k + 1) := by rw [pow_succ]

end DilationFlow

/-! ### 3. Loxodromic Commuting Flow (Semisimple Sector) -/

section LoxodromicFlow

/-- A loxodromic element combining scaling factor $a$ and phase $(c, s)$. -/
def loxodromicElement (J : R) (a c s : R) : R :=
  a * rotor J c s

/-- 🏆 THEOREM: Composition of commuting loxodromic scaling and phase rotations:
    $(a_1 K(c_1, s_1)) \cdot (a_2 K(c_2, s_2)) = (a_1 a_2) K(c_1 c_2 - s_1 s_2, s_1 c_2 + c_1 s_2)$. -/
theorem loxodromic_mul (J : R) (hJ : IsComplexStructure J) (a1 c1 s1 a2 c2 s2 : R) :
    loxodromicElement J a1 c1 s1 * loxodromicElement J a2 c2 s2 =
      loxodromicElement J (a1 * a2) (c1 * c2 - s1 * s2) (s1 * c2 + c1 * s2) := by
  dsimp [loxodromicElement]
  calc
    (a1 * rotor J c1 s1) * (a2 * rotor J c2 s2) =
        (a1 * a2) * (rotor J c1 s1 * rotor J c2 s2) := by ring
    _ = (a1 * a2) * rotor J (c1 * c2 - s1 * s2) (s1 * c2 + c1 * s2) := by
      rw [rotor_mul J hJ]

end LoxodromicFlow

/-! ### 4. Twin Thermal Doubling & 4-Fold Chiral-Sheet Grading ($\Gamma^2 = 1, \Sigma^2 = 1$) -/

section TwinThermalGrading

/-- A grading involution $\Gamma$ with $\Gamma^2 = 1$. -/
def IsGradingInvolution (Γ : R) : Prop :=
  Γ * Γ = 1

/-- The 4-fold chiral $\times$ sheet projector family:
    $$P_{\sigma, \tau} = \frac{1}{4}(1 + \sigma \Gamma)(1 + \tau \Sigma)$$
    generated by two commuting grading involutions $(\Gamma, \Sigma)$ with $\Gamma^2 = 1, \Sigma^2 = 1$. -/
def twinProjector (Γ Sig : R) (quarter : R) (sΓ sSig : R) : R :=
  quarter * (1 + sΓ * Γ) * (1 + sSig * Sig)

/-- 🏆 THEOREM (Completeness): The four twin projectors sum to $1$ when $4 \cdot \mathrm{quarter} = 1$. -/
theorem twin_projectors_sum_eq_one
    (Γ Sig quarter : R)
    (hquarter : 4 * quarter = 1) :
    twinProjector Γ Sig quarter 1 1 +
    twinProjector Γ Sig quarter 1 (-1) +
    twinProjector Γ Sig quarter (-1) 1 +
    twinProjector Γ Sig quarter (-1) (-1) = 1 := by
  dsimp [twinProjector]
  calc
    quarter * (1 + 1 * Γ) * (1 + 1 * Sig) +
    quarter * (1 + 1 * Γ) * (1 + -1 * Sig) +
    quarter * (1 + -1 * Γ) * (1 + 1 * Sig) +
    quarter * (1 + -1 * Γ) * (1 + -1 * Sig) =
        (4 * quarter) * 1 := by ring
    _ = 1 * 1 := by rw [hquarter]
    _ = 1 := mul_one 1

/-- 🏆 THEOREM (Idempotence): Each twin projector is idempotent $P_{\sigma, \tau}^2 = P_{\sigma, \tau}$. -/
theorem twinProjector_isIdempotent
    (Γ Sig quarter : R) (sΓ sSig : R)
    (hΓ : IsGradingInvolution Γ) (hSig : IsGradingInvolution Sig)
    (hsΓ : sΓ ^ 2 = 1) (hsSig : sSig ^ 2 = 1)
    (hquarter : 4 * quarter = 1) :
    twinProjector Γ Sig quarter sΓ sSig * twinProjector Γ Sig quarter sΓ sSig =
      twinProjector Γ Sig quarter sΓ sSig := by
  dsimp [twinProjector]
  dsimp [IsGradingInvolution] at hΓ hSig
  have hΓprime : (sΓ * Γ) * (sΓ * Γ) = 1 := by
    calc
      (sΓ * Γ) * (sΓ * Γ) = (sΓ * sΓ) * (Γ * Γ) := by ring
      _ = 1 := by rw [← pow_two, hsΓ, hΓ, one_mul]
  have hSigprime : (sSig * Sig) * (sSig * Sig) = 1 := by
    calc
      (sSig * Sig) * (sSig * Sig) = (sSig * sSig) * (Sig * Sig) := by ring
      _ = 1 := by rw [← pow_two, hsSig, hSig, one_mul]
  have hΓsum : (1 + sΓ * Γ) * (1 + sΓ * Γ) = 2 * (1 + sΓ * Γ) := by
    rw [show (1 + sΓ * Γ) * (1 + sΓ * Γ) = 1 + 2 * (sΓ * Γ) + (sΓ * Γ) * (sΓ * Γ) by ring, hΓprime]
    ring
  have hSigsum : (1 + sSig * Sig) * (1 + sSig * Sig) = 2 * (1 + sSig * Sig) := by
    rw [show (1 + sSig * Sig) * (1 + sSig * Sig) = 1 + 2 * (sSig * Sig) + (sSig * Sig) * (sSig * Sig) by ring, hSigprime]
    ring
  have hqq : 4 * quarter ^ 2 = quarter := by
    calc
      4 * quarter ^ 2 = (4 * quarter) * quarter := by ring
      _ = 1 * quarter := by rw [hquarter]
      _ = quarter := by ring
  calc
    (quarter * (1 + sΓ * Γ) * (1 + sSig * Sig)) * (quarter * (1 + sΓ * Γ) * (1 + sSig * Sig)) =
        quarter ^ 2 * ((1 + sΓ * Γ) * (1 + sΓ * Γ)) * ((1 + sSig * Sig) * (1 + sSig * Sig)) := by ring
    _ = quarter ^ 2 * (2 * (1 + sΓ * Γ)) * (2 * (1 + sSig * Sig)) := by rw [hΓsum, hSigsum]
    _ = (4 * quarter ^ 2) * (1 + sΓ * Γ) * (1 + sSig * Sig) := by ring
    _ = quarter * (1 + sΓ * Γ) * (1 + sSig * Sig) := by rw [hqq]

/-- 🏆 THEOREM (Pairwise Orthogonality across Chiral Grading):
    $P_{\sigma, \tau_1} P_{-\sigma, \tau_2} = 0$. -/
theorem twinProjector_chiral_orthogonal
    (Γ Sig quarter : R) (sΓ sSig1 sSig2 : R)
    (hΓ : IsGradingInvolution Γ) (hsΓ : sΓ ^ 2 = 1) :
    twinProjector Γ Sig quarter sΓ sSig1 * twinProjector Γ Sig quarter (-sΓ) sSig2 = 0 := by
  dsimp [twinProjector, IsGradingInvolution] at *
  have hzero : (1 + sΓ * Γ) * (1 + (-sΓ) * Γ) = 0 := by
    calc
      (1 + sΓ * Γ) * (1 + (-sΓ) * Γ) = 1 - (sΓ * Γ) * (sΓ * Γ) := by ring
      _ = 0 := by
        have hsq : (sΓ * Γ) * (sΓ * Γ) = 1 := by
          calc
            (sΓ * Γ) * (sΓ * Γ) = (sΓ * sΓ) * (Γ * Γ) := by ring
            _ = 1 := by rw [← pow_two, hsΓ, hΓ, one_mul]
        rw [hsq, sub_self]
  calc
    (quarter * (1 + sΓ * Γ) * (1 + sSig1 * Sig)) * (quarter * (1 + (-sΓ) * Γ) * (1 + sSig2 * Sig)) =
        (quarter ^ 2 * (1 + sSig1 * Sig) * (1 + sSig2 * Sig)) * ((1 + sΓ * Γ) * (1 + (-sΓ) * Γ)) := by ring
    _ = (quarter ^ 2 * (1 + sSig1 * Sig) * (1 + sSig2 * Sig)) * 0 := by rw [hzero]
    _ = 0 := mul_zero _

/-- 🏆 THEOREM (Pairwise Orthogonality across Sheet Grading):
    $P_{\sigma_1, \tau} P_{\sigma_2, -\tau} = 0$. -/
theorem twinProjector_sheet_orthogonal
    (Γ Sig quarter : R) (sSig sΓ1 sΓ2 : R)
    (hSig : IsGradingInvolution Sig) (hsSig : sSig ^ 2 = 1) :
    twinProjector Γ Sig quarter sΓ1 sSig * twinProjector Γ Sig quarter sΓ2 (-sSig) = 0 := by
  dsimp [twinProjector, IsGradingInvolution] at *
  have hzero : (1 + sSig * Sig) * (1 + (-sSig) * Sig) = 0 := by
    calc
      (1 + sSig * Sig) * (1 + (-sSig) * Sig) = 1 - (sSig * Sig) * (sSig * Sig) := by ring
      _ = 0 := by
        have hsq : (sSig * Sig) * (sSig * Sig) = 1 := by
          calc
            (sSig * Sig) * (sSig * Sig) = (sSig * sSig) * (Sig * Sig) := by ring
            _ = 1 := by rw [← pow_two, hsSig, hSig, one_mul]
        rw [hsq, sub_self]
  calc
    (quarter * (1 + sΓ1 * Γ) * (1 + sSig * Sig)) * (quarter * (1 + sΓ2 * Γ) * (1 + (-sSig) * Sig)) =
        (quarter ^ 2 * (1 + sΓ1 * Γ) * (1 + sΓ2 * Γ)) * ((1 + sSig * Sig) * (1 + (-sSig) * Sig)) := by ring
    _ = (quarter ^ 2 * (1 + sΓ1 * Γ) * (1 + sΓ2 * Γ)) * 0 := by rw [hzero]
    _ = 0 := mul_zero _

end TwinThermalGrading

/-! ### 5. N-Sector: Unipotent Inversion & General Derivation Lie Closure -/

section DerivationLieBracket

variable {A : Type*} [NonUnitalNonAssocRing A]

/-- A derivation on a nonassociative algebra $A$ is a linear endomorphism satisfying the Leibniz rule. -/
structure NonAssocDerivation (D : A → A) : Prop where
  map_add : ∀ x y, D (x + y) = D x + D y
  leibniz : ∀ x y, D (x * y) = D x * y + x * D y

/-- The commutator bracket $[D_1, D_2] = D_1 \circ D_2 - D_2 \circ D_1$. -/
def derCommutator (D1 D2 : A → A) (x : A) : A :=
  D1 (D2 x) - D2 (D1 x)

/-- 🏆 THEOREM: The commutator bracket of two nonassociative derivations is again a derivation! -/
theorem derCommutator_is_derivation
    (D1 D2 : A → A)
    (h1 : NonAssocDerivation D1)
    (h2 : NonAssocDerivation D2) :
    NonAssocDerivation (derCommutator D1 D2) := by
  refine ⟨?_, ?_⟩
  · intro x y
    dsimp [derCommutator]
    rw [h2.map_add, h1.map_add, h1.map_add, h2.map_add]
    abel
  · intro x y
    dsimp [derCommutator]
    rw [h2.leibniz, h1.map_add, h1.leibniz, h1.leibniz]
    rw [h1.leibniz, h2.map_add, h2.leibniz, h2.leibniz]
    rw [sub_mul, mul_sub]
    abel

end DerivationLieBracket

end InfoGeometry.Algebra.IwasawaOperatorTwinLoxodromic
