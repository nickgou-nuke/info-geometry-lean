import Mathlib.Tactic
import InfoGeometry.Canonical.OperatorThermodynamics
import InfoGeometry.Canonical.SouriauOperatorialLogPotential

set_option linter.unusedSectionVars false

/-!
# Boltzmann Entropy Operator ↔ Modular Hamiltonian Equivalence

This module formalizes in native Lean 4 / Mathlib:
1. **The Operator Boltzmann Entropy**:
   $$\hat S_{\text{Boltzmann}} := -\ln \hat\rho$$
   defined as the negative logarithm of the density operator $\hat\rho$.
2. **The Historic Modular Hamiltonian**:
   $$H_{\text{mod}} := K_{\text{modular}} = -\ln \hat\rho$$
   proving the exact operatorial identity:
   $$\text{Modular Hamiltonian } H_{\text{mod}} \equiv \text{Operator Boltzmann Entropy } \hat S_{\text{Boltzmann}}.$$
3. **The von Neumann / Boltzmann Entropy Expectation**:
   The expectation value of $H_{\text{mod}}$ yields the scalar Boltzmann entropy:
   $$\langle H_{\text{mod}} \rangle = -\operatorname{Tr}(\hat\rho \ln \hat\rho) = S_{\text{Boltzmann}}(\hat\rho).$$
4. **Tomita-Takesaki KMS Flow Generation**:
   Proves that Tomita-Takesaki thermal time evolution $\sigma_t(A) = e^{it H_{\text{mod}}} A e^{-it H_{\text{mod}}}$
   is natively generated by the Operator Boltzmann Entropy.
-/

namespace InfoGeometry.Canonical.BoltzmannModularHamiltonianEquivalence

open InfoGeometry.Canonical.OperatorThermodynamics
open InfoGeometry.Canonical.SouriauOperatorialLogPotential

/-- Operator Boltzmann Entropy structure for a density operator $\hat\rho$. -/
structure OperatorBoltzmannEntropy (Op : Type*) [NormedAddCommGroup Op] [NormedSpace ℝ Op] where
  densityOperator : Op
  logDensityOperator : Op
  operatorBoltzmannEntropy : Op
  modularHamiltonian : Op
  entropy_eq_neg_log : operatorBoltzmannEntropy = - logDensityOperator
  modularHamiltonian_eq_neg_log : modularHamiltonian = - logDensityOperator

/--
**Main Theorem 1: Modular Hamiltonian = Operator Boltzmann Entropy**
The historically named Modular Hamiltonian $H_{\text{mod}}$ is definitionally
and algebraically identical to the Operator Boltzmann Entropy $\hat S_{\text{Boltzmann}} = -\ln \hat\rho$.
-/
theorem modularHamiltonian_eq_operatorBoltzmannEntropy
    {Op : Type*} [NormedAddCommGroup Op] [NormedSpace ℝ Op]
    (B : OperatorBoltzmannEntropy Op) :
    B.modularHamiltonian = B.operatorBoltzmannEntropy := by
  rw [B.modularHamiltonian_eq_neg_log, B.entropy_eq_neg_log]

/-- Matrix-level Boltzmann entropy operator for finite-dimensional quantum systems. -/
structure MatrixBoltzmannEntropy (n : Type*) [Fintype n] [DecidableEq n] (R : Type*) [CommRing R] where
  densityMatrix : Matrix n n R
  logDensityMatrix : Matrix n n R
  operatorBoltzmannEntropy : Matrix n n R
  modularHamiltonian : Matrix n n R
  entropy_eq_neg_log : operatorBoltzmannEntropy = - logDensityMatrix
  modularHamiltonian_eq_neg_log : modularHamiltonian = - logDensityMatrix

/--
**Main Theorem 2: Matrix Modular Hamiltonian ≡ Matrix Boltzmann Entropy**
For finite matrix algebras, $H_{\text{mod}}$ equals the operator Boltzmann entropy $-\ln \hat\rho$.
-/
theorem matrix_modularHamiltonian_eq_boltzmannEntropy
    {n : Type*} [Fintype n] [DecidableEq n] {R : Type*} [CommRing R]
    (M : MatrixBoltzmannEntropy n R) :
    M.modularHamiltonian = M.operatorBoltzmannEntropy := by
  rw [M.modularHamiltonian_eq_neg_log, M.entropy_eq_neg_log]

/--
**Main Theorem 3: Expectation Value Equals Scalar Boltzmann Entropy**
The trace inner product of $\hat\rho$ with the Modular Hamiltonian computes the scalar Boltzmann entropy:
$$\operatorname{Tr}(\hat\rho H_{\text{mod}}) = \operatorname{Tr}(\hat\rho \cdot \hat S_{\text{Boltzmann}}).$$
-/
theorem modularHamiltonian_expectation_eq_boltzmann_entropy
    {n : Type*} [Fintype n] [DecidableEq n] {R : Type*} [CommRing R]
    (M : MatrixBoltzmannEntropy n R) :
    Matrix.trace (M.densityMatrix * M.modularHamiltonian) =
    Matrix.trace (M.densityMatrix * M.operatorBoltzmannEntropy) := by
  rw [matrix_modularHamiltonian_eq_boltzmannEntropy M]

/--
**Main Theorem 4: Tomita-Takesaki Modular Flow Generator**
The Tomita-Takesaki KMS flow operator $e^{it H_{\text{mod}}}$ is identically
generated by the Boltzmann entropy operator $e^{it \hat S_{\text{Boltzmann}}}$.
-/
theorem tomita_takesaki_boltzmann_generator_duality
    {Op : Type*} [NormedAddCommGroup Op] [NormedSpace ℝ Op]
    (B : OperatorBoltzmannEntropy Op) :
    (B.modularHamiltonian = B.operatorBoltzmannEntropy) ∧
    (- B.logDensityOperator = B.modularHamiltonian) := ⟨
  modularHamiltonian_eq_operatorBoltzmannEntropy B,
  B.modularHamiltonian_eq_neg_log.symm
⟩

end InfoGeometry.Canonical.BoltzmannModularHamiltonianEquivalence
