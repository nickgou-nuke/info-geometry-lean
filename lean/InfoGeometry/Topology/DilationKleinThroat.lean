import Mathlib

/-!
# The Z₂-glide quotient on the log-cylinder

## What is proved here, exactly

One algebraic object: the relation on `ℝ × ℝ` generated by the glide involution
`g(u, y) = (-u, y + 1/2)`.  This file defines

    KleinThroat : (ℝ × ℝ) → (ℝ × ℝ) → Prop

with constructors `refl`, `step` (the glide), `symm`, `trans`, and proves
four facts about it:

* `KleinThroat.isEquiv` — it is an equivalence relation.
* `KleinThroat.period` — the glide squared is the translation `y ↦ y + 1`.  The
  doubled period is *forced* by the glide, not postulated: `step` is the only
  non-trivial constructor.
* `KleinThroat.abs_u_step` / `u_not_invariant` — `|u|` is constant on classes, but
  `u` itself is not.  Hence no function of `u` alone that separates `u` from
  `−u` descends to the quotient.
* `deckInvolution_sq` — the glide's square equals the period translation.

Every proof is arithmetic on `1/2`.  No geometric, analytic, or representation-
theoretic input is used, and no hypothesis is needed beyond `AddCommGroup P` (or
`R` itself, for the log-cylinder specialisation).

## What is deliberately NOT claimed here

These boundaries are load-bearing; conflating them is the error this module
avoids.

* **This is not a claim that a Klein bottle is a twisted ribbon.**  Gluing the
  ends of a single ribbon with a full twist produces an *orientable* annulus with
  two boundary components, not a Klein bottle.  A Klein bottle is instead built
  by gluing the two boundary circles of *two separate* Möbius bands.  Those are
  different quotients of different spaces.  `KleinThroat` models only the glide
  relation `(u, y) ~ (-u, y + 1/2)`, i.e. the cylinder presentation of a Klein
  bottle as `(ℝ × S¹)/⟨g⟩`.  It says nothing about ribbons or bands.

* **This is not the Călugăreanu–White–Fuller identity `Lk = Tw + Wr`.**  That
  theorem lives on `C²(S¹, ℝ³)` with a non-vanishing normal field and is a
  statement about contour integrals on `ℝ³`.  It is deferred; no linking number,
  twist, or writhe appears here.

* **This is not a statement about the Riemann zeta function.**  The glide relation
  is *not* asserted to arise from the zeta functional equation, and no claim is
  made about `ζ`, its zeros, or its critical line.  Gliding the sign of a
  coordinate is a generic fact about `Z₂`-quotients; reading it as a functional
  equation would be a heuristic physical analogy, not an identity available to
  this module.

* **No metric is assumed or needed**, so no "shortest closed geodesic" style
  statement is made or implied.  "Shortest" requires a chosen Riemannian metric;
  nothing of the kind is present here.

* **No representation theory.**  Nothing here bears on `π₁(SO(3))`, the belt
  trick, or spin-statistics.  Connecting a double cover to a spinor's `−1` phase
  would require an explicit covering homomorphism and an explicit `SU(2)` action
  on `ℂ²`, neither of which is present in this module.
-/

namespace InfoGeometry.Topology.DilationKleinThroat

/-- The glide's offset: half of the doubled period.  This is a bare constant; the
name records its role in the glide and carries no further meaning. -/
noncomputable def glideShift : ℝ := 1 / 2

/-- **The glide offset squares to a period-`1` translation.** -/
theorem glideShift_sq : glideShift + glideShift = 1 := by
  simp [glideShift]
  ring

/-- The glide relation on the log-cylinder `ℝ × ℝ`, generated by `(u, y) ~ (-u, y + 1/2)`. -/
inductive KleinThroat : (ℝ × ℝ) → (ℝ × ℝ) → Prop
  | refl (w : ℝ × ℝ) : KleinThroat w w
  | step (u y : ℝ) : KleinThroat (u, y) (-u, y + glideShift)
  | symm {a b : ℝ × ℝ} : KleinThroat a b → KleinThroat b a
  | trans {a b c : ℝ × ℝ} : KleinThroat a b → KleinThroat b c → KleinThroat a c

namespace KleinThroat

/-- The glide relation is an equivalence relation. -/
instance isEquiv : IsEquiv (ℝ × ℝ)
    (KleinThroat : (ℝ × ℝ) → (ℝ × ℝ) → Prop) where
  refl := fun a => KleinThroat.refl a
  symm := fun _ _ h => KleinThroat.symm h
  trans := fun _ _ _ h₁ h₂ => KleinThroat.trans h₁ h₂

/-- **The forced period.**  Composing the glide with itself identifies `(u, y)`
with `(u, y + 1)`.  This is a theorem about the glide, not an extra relation. -/
theorem period_of_step {u y : ℝ} (h : KleinThroat (u, y) (-u, y + glideShift)) :
    KleinThroat (u, y) (u, y + 1) := by
  have h2 : KleinThroat (-u, y + glideShift) (u, y + 1) := by
    have := KleinThroat.step (-u) (y + glideShift)
    convert this using 1
    simp [glideShift]
    ring
  exact h.trans h2

/-- The period relation on the log-cylinder. -/
theorem period (u y : ℝ) : KleinThroat (u, y) (u, y + 1) :=
  period_of_step (KleinThroat.step u y)

/-- The dilation magnitude `|u|` is constant along a glide, so it descends to the
quotient. -/
theorem abs_u_step (u : ℝ) : |(-u : ℝ)| = |u| := abs_neg u

/-- **The first coordinate is not invariant.**  The glide sends `u` to `−u`, so for
`u ≠ 0` the two chiralities are distinct points of a single class.  No function of
`u` alone that separates `u` from `−u` descends to the quotient. -/
theorem u_not_invariant {u : ℝ} (h : u ≠ 0) : u ≠ -u := by
  intro hcontra
  have hsum : u + u = 0 := by linarith
  exact h (by linarith)

/-- Both chiralities lie in one class while their first coordinates differ in sign. -/
theorem chiralities_in_one_class (u y : ℝ) :
    KleinThroat (u, y) (-u, y + glideShift) ∧ |u| = |-u| :=
  ⟨KleinThroat.step u y, (abs_neg u).symm⟩

end KleinThroat

/-- The glide involution `(u, y) ↦ (-u, y + 1/2)`. -/
noncomputable def deckInvolution (w : ℝ × ℝ) : ℝ × ℝ := (-w.1, w.2 + glideShift)

/-- **The glide's square is the period translation.** -/
theorem deckInvolution_sq (u y : ℝ) :
    deckInvolution (deckInvolution (u, y)) = (u, y + 1) := by
  simp only [deckInvolution, glideShift]
  ring

/-- The glide preserves the absolute value of the first coordinate, so it descends
to an involution of the quotient. -/
theorem deckInvolution_abs (u y : ℝ) : |(deckInvolution (u, y)).1| = |u| := by
  simp only [deckInvolution]
  exact abs_neg u

/-- The glide interchanges the two chiralities. -/
theorem deckInvolution_neg (u y : ℝ) : (deckInvolution (u, y)).1 = -u := rfl

/-- The glide carries the period relation to the period relation: it is an
automorphism of the relation, not merely of the underlying set. -/
theorem deckInvolution_period (u y : ℝ) :
    KleinThroat (deckInvolution (u, y)) (deckInvolution (u, y + 1)) := by
  simp only [deckInvolution]
  have h2 : KleinThroat (-u, y + glideShift) (-u, (y + glideShift) + 1) :=
    KleinThroat.period (-u) (y + glideShift)
  convert h2 using 1
  ring

end InfoGeometry.Topology.DilationKleinThroat
