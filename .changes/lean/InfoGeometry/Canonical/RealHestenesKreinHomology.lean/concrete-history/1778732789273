{"type":"new","contents":"import InfoGeometry.Canonical.DrazinCoreFlow\nimport InfoGeometry.Canonical.DrazinLightConeDictionary\nimport InfoGeometry.Canonical.HestenesRealStructures\nimport InfoGeometry.Krein.KreinSpace\nimport InfoGeometry.Krein.DoubledSpace\nimport InfoGeometry.Meta.Architecture\nimport Mathlib.Tactic.Abel\n\nopen scoped InnerProductSpace\n\nnoncomputable section\n\nnamespace InfoGeometry.Canonical.RealHestenesKreinHomology\n\nopen InfoGeometry.Krein\nopen InfoGeometry.Canonical.Drazin\nopen InfoGeometry.Canonical.Drazin.IsDrazinInverse\nopen InfoGeometry.Canonical.HestenesRealStructures\n\n/-!\n# Real Hestenes--Krein Homology\n\nThis file provides a theorem-safe real homology/cohomology socket:\n\n* a real nilpotent differential gives cycles and boundaries;\n* homology equivalence is difference by a real boundary;\n* Drazin generalized-kernel readback is witness-gated;\n* a complementary projector selects the null residue by idempotence;\n* boundary-vanishing real witnesses descend to homology classes;\n* Krein/Hestenes frame data preserves the real pairing readout.\n\nNo complex coefficient lane, de Rham theorem, or analytic Hodge theorem is\nasserted here.\n-/\n\n/-! ## 1. Real differential homology -/\n\n/--\nA real chain differential.\n\nThis is deliberately algebraic: no complex coefficients, no analytic domain\nclaims, and no Hodge theorem.\n-/\n@[rep_depth operator]\nstructure RealDifferential\n    (C : Type*) [AddCommGroup C] [Module ℝ C] where\n  D : C →ₗ[ℝ] C\n  D_sq_zero : D.comp D = 0\n\nnamespace RealDifferential\n\nvariable {C : Type*}\nvariable [AddCommGroup C] [Module ℝ C]\nvariable (𝒟 : RealDifferential C)\n\n/-- Real cycle: killed by the differential. -/\n@[rep_depth operator]\ndef IsCycle (x : C) : Prop :=\n  𝒟.D x = 0\n\n/-- Real boundary: generated by the differential. -/\n@[rep_depth operator]\ndef IsBoundary (x : C) : Prop :=\n  ∃ y : C, 𝒟.D y = x\n\n/-- Boundaries are cycles when `D² = 0`. -/\n@[rep_depth operator]\ntheorem boundary_is_cycle\n    {x : C}\n    (hx : 𝒟.IsBoundary x) :\n    𝒟.IsCycle x := by\n  rcases hx with ⟨y, rfl⟩\n  unfold IsCycle\n  have h := congrArg (fun F : C →ₗ[ℝ] C => F y) 𝒟.D_sq_zero\n  simpa [LinearMap.comp_apply] using h\n\n/-! ## 2. Homology equivalence -/\n\n/-- Homology equivalence: two chains differ by a boundary. -/\n@[rep_depth operator]\ndef HomologyEquivalent (x y : C) : Prop :=\n  ∃ b : C, 𝒟.D b = x - y\n\n/-- Homology equivalence is reflexive. -/\n@[rep_depth operator]\ntheorem HomologyEquivalent_refl\n    (x : C) :\n    𝒟.HomologyEquivalent x x := by\n  refine ⟨0, ?_⟩\n  simp\n\n/-- Homology equivalence is symmetric. -/\n@[rep_depth operator]\ntheorem HomologyEquivalent_symm\n    {x y : C}\n    (h : 𝒟.HomologyEquivalent x y) :\n    𝒟.HomologyEquivalent y x := by\n  rcases h with ⟨b, hb⟩\n  refine ⟨-b, ?_⟩\n  calc\n    𝒟.D (-b) = -𝒟.D b := by simp\n    _ = -(x - y) := by rw [hb]\n    _ = y - x := by abel\n\n/-- Homology equivalence is transitive. -/\n@[rep_depth operator]\ntheorem HomologyEquivalent_trans\n    {x y z : C}\n    (hxy : 𝒟.HomologyEquivalent x y)\n    (hyz : 𝒟.HomologyEquivalent y z) :\n    𝒟.HomologyEquivalent x z := by\n  rcases hxy with ⟨b₁, hb₁⟩\n  rcases hyz with ⟨b₂, hb₂⟩\n  refine ⟨b₁ + b₂, ?_⟩\n  calc\n    𝒟.D (b₁ + b₂) = 𝒟.D b₁ + 𝒟.D b₂ := by simp\n    _ = (x - y) + (y - z) := by rw [hb₁, hb₂]\n    _ = x - z := by abel\n\n/-- Homology equivalence is an equivalence relation. -/\n@[rep_depth operator]\ntheorem HomologyEquivalent_isEquivalence :\n    Equivalence 𝒟.HomologyEquivalent := by\n  refine ⟨?refl, ?symm, ?trans⟩\n  · intro x\n    exact 𝒟.HomologyEquivalent_refl x\n  · intro x y h\n    exact 𝒟.HomologyEquivalent_symm h\n  · intro x y z hxy hyz\n    exact 𝒟.HomologyEquivalent_trans hxy hyz\n\n/-! ## 5. Boundary-vanishing witnesses descend to homology -/\n\n/--\nA real homology witness/readout.\n\nIt descends to homology if it vanishes on generated boundaries.\n-/\n@[rep_depth operator]\nstructure BoundaryVanishingWitness where\n  eval : C →ₗ[ℝ] ℝ\n  vanishes_on_boundaries :\n    ∀ y : C, eval (𝒟.D y) = 0\n\nnamespace BoundaryVanishingWitness\n\nvariable {𝒟}\nvariable (ω : BoundaryVanishingWitness 𝒟)\n\n/-- Boundary-vanishing witnesses are constant on homology classes. -/\n@[rep_depth operator]\ntheorem descends_to_homology_equivalence\n    {x y : C}\n    (hxy : 𝒟.HomologyEquivalent x y) :\n    ω.eval x = ω.eval y := by\n  rcases hxy with ⟨b, hb⟩\n  have hdiff : ω.eval (x - y) = 0 := by\n    rw [← hb]\n    exact ω.vanishes_on_boundaries b\n  rw [map_sub] at hdiff\n  exact sub_eq_zero.mp hdiff\n\nend BoundaryVanishingWitness\n\nend RealDifferential\n\n/-! ## 3. Witness-gated Drazin null support -/\n\n/--\nDrazin null support predicate for an endomorphism.\n\n`P0` is the Drazin complementary projector. The field\n`null_iff_generalizedKernel` is the bridge to the concrete `Module.End`\ngeneralized-kernel theorem when that owner is imported.\n-/\n@[rep_depth operator]\nstructure DrazinNullSupport\n    (C : Type*) [AddCommGroup C] [Module ℝ C] where\n  A : Module.End ℝ C\n  P0 : Module.End ℝ C\n  k : ℕ\n  /-- Null residue predicate selected by the Drazin complementary projector. -/\n  IsDrazinNull : C → Prop := fun x => P0 x = x\n  /-- Generalized kernel predicate from the selected backend. -/\n  IsGeneralizedKernel : C → Prop\n  /-- Calibration to the existing generalized-kernel theorem. -/\n  null_iff_generalizedKernel :\n    ∀ x : C, IsDrazinNull x ↔ IsGeneralizedKernel x\n\nnamespace DrazinNullSupport\n\nvariable {C : Type*}\nvariable [AddCommGroup C] [Module ℝ C]\nvariable (N : DrazinNullSupport C)\n\n/-- Readback of the supplied Drazin-null/generalized-kernel calibration. -/\n@[rep_depth operator]\ntheorem drazinNull_iff_generalizedKernel\n    (x : C) :\n    N.IsDrazinNull x ↔ N.IsGeneralizedKernel x :=\n  N.null_iff_generalizedKernel x\n\nend DrazinNullSupport\n\n/-! ## 3b. Direct Module.End Drazin generalized-kernel residue -/\n\nnamespace DrazinNullResidue\n\nvariable {K V : Type*}\nvariable [DivisionRing K] [AddCommGroup V] [Module K V]\nvariable {A D : Module.End K V} {k : ℕ}\n\n/-- Drazin-null cycle: killed by the core-defining power `A^k`. -/\n@[rep_depth operator]\ndef IsDrazinNullCycle (A : Module.End K V) (k : ℕ) (x : V) : Prop :=\n  (A ^ k) x = 0\n\n/-- Drazin-null cycles are exactly elements of the existing generalized kernel. -/\n@[rep_depth operator]\ntheorem isDrazinNullCycle_iff_mem_drazinCore\n    (A : Module.End K V) (k : ℕ) (x : V) :\n    IsDrazinNullCycle A k x ↔ x ∈ drazinCore A k := by\n  simp [IsDrazinNullCycle, drazinCore, LinearMap.mem_ker]\n\n/--\nDrazin-null cycles are exactly the range of the complementary Drazin projector.\n-/\n@[rep_depth operator]\ntheorem isDrazinNullCycle_iff_mem_range_complementaryProjection\n    (h : IsDrazinInverse A D k) (x : V) :\n    IsDrazinNullCycle A k x\n      ↔ x ∈ LinearMap.range (complementaryProjection A D) := by\n  calc\n    IsDrazinNullCycle A k x\n        ↔ x ∈ drazinCore A k :=\n          isDrazinNullCycle_iff_mem_drazinCore A k x\n    _ ↔ x ∈ LinearMap.range (complementaryProjection A D) := by\n          rw [← complementaryProjection_range_eq_drazinCore (h := h)]\n\n/-- The complementary Drazin projector selects a Drazin-null cycle. -/\n@[rep_depth operator]\ntheorem complementaryProjection_selects_drazinNullCycle\n    (h : IsDrazinInverse A D k) (x : V) :\n    IsDrazinNullCycle A k (complementaryProjection A D x) := by\n  exact\n    (isDrazinNullCycle_iff_mem_drazinCore A k\n      (complementaryProjection A D x)).2\n      (complementaryProjection_mapsTo_drazinCore (h := h) x)\n\n/-- The complementary Drazin projector fixes Drazin-null cycles. -/\n@[rep_depth operator]\ntheorem complementaryProjection_fixes_drazinNullCycle\n    (h : IsDrazinInverse A D k)\n    {x : V}\n    (hx : IsDrazinNullCycle A k x) :\n    complementaryProjection A D x = x := by\n  have hxrange :\n      x ∈ LinearMap.range (complementaryProjection A D) :=\n    (isDrazinNullCycle_iff_mem_range_complementaryProjection\n      (A := A) (D := D) (k := k) h x).1 hx\n  rcases hxrange with ⟨y, hy⟩\n  rw [← hy]\n  have hIdem :\n      complementaryProjection A D * complementaryProjection A D =\n        complementaryProjection A D :=\n    complementaryProjection_is_idempotent (h := h)\n  simpa using congrArg (fun F : Module.End K V => F y) hIdem\n\nend DrazinNullResidue\n\n/-! ## 4. Generic null-projector adapter -/\n\n/--\nGeneric idempotent null-projector adapter.\n\nUse this when the projector is already known to be idempotent but is not\nnecessarily presented through a Drazin inverse witness.\n-/\n@[rep_depth operator]\nstructure NullProjector\n    (C : Type*) [AddCommGroup C] [Module ℝ C] where\n  P0 : Module.End ℝ C\n  P0_idem : P0.comp P0 = P0\n\nnamespace NullProjector\n\nvariable {C : Type*}\nvariable [AddCommGroup C] [Module ℝ C]\nvariable (P : NullProjector C)\n\n/-- Null residue selected by the complementary projector. -/\n@[rep_depth operator]\ndef IsNullResidue (x : C) : Prop :=\n  P.P0 x = x\n\n/-- The complementary Drazin projector selects its own image. -/\n@[rep_depth operator]\ntheorem selects_null_residue\n    (x : C) :\n    P.IsNullResidue (P.P0 x) := by\n  unfold IsNullResidue\n  have h := congrArg (fun F : Module.End ℝ C => F x) P.P0_idem\n  simpa [LinearMap.comp_apply] using h\n\n/-- Null residues are preserved by the complementary projector. -/\n@[rep_depth operator]\ntheorem preserves_null_residue\n    {x : C}\n    (_hx : P.IsNullResidue x) :\n    P.IsNullResidue (P.P0 x) := by\n  exact P.selects_null_residue x\n\nend NullProjector\n\n/-! ## 6. Krein/Hestenes frame readouts -/\n\nnamespace RealFrameReadout\n\nvariable {H : Type*}\nvariable [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]\nvariable [KreinSpace H]\n\n/-- Real Krein pairing readout. -/\n@[rep_depth krein]\nnoncomputable def pairingReadout (u v : H) : ℝ :=\n  KreinSpace.kreinInner (H := H) u v\n\n/-- Krein-preserving frame maps preserve the pairing readout. -/\n@[rep_depth krein]\ntheorem krein_frame_preserves_pairing\n    (U : H →L[ℝ] H)\n    (hU : KreinSpace.IsKreinIsometry (H := H) U)\n    (u v : H) :\n    pairingReadout (U u) (U v) = pairingReadout u v :=\n  hU u v\n\nend RealFrameReadout\n\n/--\nA doubled Hestenes--Krein frame.\n\nThe `kreinPreserving` field protects the real pairing readout. The\n`phasePreserving` field protects the internal Hestenes phase axis.\n-/\n@[rep_depth krein]\nstructure HestenesKreinDoubledFrame\n    (E : Type 0) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] where\n  U : DoubledSpace E →L[ℝ] DoubledSpace E\n  kreinPreserving :\n    KreinSpace.IsKreinIsometry (H := DoubledSpace E) U\n  phasePreserving :\n    KLinear (E := E) U\n\nnamespace HestenesKreinDoubledFrame\n\nvariable {E : Type 0}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\n\n/-- Doubled Hestenes--Krein frames preserve the real Krein pairing readout. -/\n@[rep_depth krein]\ntheorem preserves_pairing\n    (F : HestenesKreinDoubledFrame E)\n    (u v : H₂) :\n    KreinSpace.kreinInner (H := H₂) (F.U u) (F.U v) =\n      KreinSpace.kreinInner (H := H₂) u v :=\n  F.kreinPreserving u v\n\n/-- Readback of Hestenes phase-axis preservation. -/\n@[rep_depth krein]\ntheorem preserves_phase\n    (F : HestenesKreinDoubledFrame E) :\n    KLinear (E := E) F.U :=\n  F.phasePreserving\n\n/-- Readback of Hestenes phase-axis preservation as the concrete commutation law. -/\n@[rep_depth krein]\ntheorem preserves_phaseAxis\n    (F : HestenesKreinDoubledFrame E) :\n    F.U.comp (InfoGeometry.Krein.clockAxis (E := E)) =\n      (InfoGeometry.Krein.clockAxis (E := E)).comp F.U :=\n  F.phasePreserving\n\nend HestenesKreinDoubledFrame\n\nend InfoGeometry.Canonical.RealHestenesKreinHomology\n","mtime":1778732789273}