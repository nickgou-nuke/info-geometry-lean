import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.RingTheory.DedekindDomain.Ideal.Lemmas
import Mathlib.RingTheory.Trace.Defs
import Mathlib.RingTheory.Finiteness.Basic

/-!
# InfoGeometry.Arithmetic.RatRingOfIntegersDedekindTrace

Ported to Mathlib `v4.34.1` from `mccorvie/riemann-masullo` (Apache-2.0, upstream
commit `b967ac4`):
- `RiemannMasullo/ForMathlib/NumberTheory/NumberField/Basic.lean`
- `RiemannMasullo/ForMathlib/RingTheory/DedekindDomain/Ideal/Lemmas.lean`
- `RiemannMasullo/ForMathlib/RingTheory/Trace/Defs.lean`

Every ideal of `𝓞 ℚ` is generated by a unique natural number `n` equal to its
absolute norm (`Ideal.absNorm`), yielding an explicit bijection between
`Ideal (𝓞 ℚ)` and `ℕ`. Also includes height-one prime power absorption in
Dedekind domains and trace compatibility under algebra projections.
-/

open NumberField IsDedekindDomain Function

namespace InfoGeometry.Arithmetic.RatRingOfIntegersDedekindTrace

namespace RatRingOfIntegers

/-- `𝓞 ℚ` is infinite via the equivalence `𝓞 ℚ ≃+* ℤ`. -/
scoped instance instInfinite : Infinite (𝓞 ℚ) :=
  Infinite.of_injective _ Rat.ringOfIntegersEquiv.symm.injective

/-- Every element of `𝓞 ℚ` is an integer. -/
theorem exists_intCast (a : 𝓞 ℚ) : ∃ z : ℤ, a = z :=
  ⟨Rat.ringOfIntegersEquiv a, by
    conv_lhs => rw [← Rat.ringOfIntegersEquiv.symm_apply_apply a]
    exact map_intCast Rat.ringOfIntegersEquiv.symm _⟩

/-- The `ℤ`-rank of `𝓞 ℚ` is `1`. -/
theorem finrank_int : Module.finrank ℤ (𝓞 ℚ) = 1 := by
  rw [Rat.ringOfIntegersEquiv.toAddEquiv.toIntLinearEquiv.finrank_eq, Module.finrank_self]

/-- The absolute norm of the principal ideal generated by `(z : 𝓞 ℚ)` is `z.natAbs`. -/
theorem absNorm_span_intCast (z : ℤ) :
    Ideal.absNorm (Ideal.span {(z : 𝓞 ℚ)}) = z.natAbs := by
  have h : ((z : ℤ) : 𝓞 ℚ) = algebraMap ℤ (𝓞 ℚ) z := (eq_intCast (algebraMap ℤ (𝓞 ℚ)) z).symm
  rw [Ideal.absNorm_span_singleton, h, Algebra.norm_algebraMap, finrank_int, pow_one]

/-- The absolute norm of the principal ideal generated by `(n : 𝓞 ℚ)` is `n`. -/
theorem absNorm_span_natCast (n : ℕ) :
    Ideal.absNorm (Ideal.span {(n : 𝓞 ℚ)}) = n := by
  simpa using absNorm_span_intCast n

/-- `𝓞 ℚ` is a principal ideal ring via `Rat.ringOfIntegersEquiv.symm`. -/
scoped instance instIsPrincipalIdealRing : IsPrincipalIdealRing (𝓞 ℚ) :=
  IsPrincipalIdealRing.of_surjective Rat.ringOfIntegersEquiv.symm.toRingHom
    Rat.ringOfIntegersEquiv.symm.surjective

/-- Every ideal of `𝓞 ℚ` is generated by a natural number. -/
theorem exists_eq_span_natCast (I : Ideal (𝓞 ℚ)) : ∃ n : ℕ, I = Ideal.span {(n : 𝓞 ℚ)} := by
  obtain ⟨a, rfl⟩ := (IsPrincipalIdealRing.principal I).principal
  obtain ⟨z, rfl⟩ := exists_intCast a
  refine ⟨z.natAbs, Ideal.span_singleton_eq_span_singleton.mpr ?_⟩
  simpa using (Int.associated_natAbs z).map (Int.castRingHom (𝓞 ℚ))

/-- A nonzero natural number remains nonzero in `𝓞 ℚ`. -/
theorem natCast_ne_zero {n : ℕ} (hn : n ≠ 0) : (n : 𝓞 ℚ) ≠ 0 := by
  intro h
  have := congrArg Rat.ringOfIntegersEquiv h
  simp [hn] at this

/-- Primality in `𝓞 ℚ` for natural numbers agrees with `Nat.Prime`. -/
theorem prime_natCast_iff {p : ℕ} : Prime (p : 𝓞 ℚ) ↔ p.Prime := by
  rw [← MulEquiv.prime_iff Rat.ringOfIntegersEquiv.toMulEquiv, Nat.prime_iff_prime_int]
  simp

/-- Every ideal of `𝓞 ℚ` is uniquely spanned by its own absolute norm. -/
theorem ideal_eq_span_absNorm (I : Ideal (𝓞 ℚ)) : I = Ideal.span {(I.absNorm : 𝓞 ℚ)} := by
  obtain ⟨n, rfl⟩ := exists_eq_span_natCast I
  rw [absNorm_span_natCast]

/-- `Ideal.absNorm` is injective on `Ideal (𝓞 ℚ)`. -/
theorem absNorm_injective : Function.Injective (Ideal.absNorm : Ideal (𝓞 ℚ) → ℕ) := by
  intro I J h
  rw [ideal_eq_span_absNorm I, ideal_eq_span_absNorm J, h]

/-- `n ↦ Ideal.span {(n : 𝓞 ℚ)}` is injective on `ℕ`. -/
theorem span_natCast_injective : Function.Injective (fun n : ℕ ↦ Ideal.span {(n : 𝓞 ℚ)}) := by
  intro m n h
  have hnorm := congrArg Ideal.absNorm h
  simpa only [absNorm_span_natCast] using hnorm

/-- `Ideal.absNorm : Ideal (𝓞 ℚ) → ℕ` is a bijection. -/
theorem absNorm_bijective : Function.Bijective (Ideal.absNorm : Ideal (𝓞 ℚ) → ℕ) :=
  ⟨absNorm_injective, fun n ↦ ⟨Ideal.span {(n : 𝓞 ℚ)}, absNorm_span_natCast n⟩⟩

end RatRingOfIntegers

section DedekindDomainIdealLemmas

variable {R : Type*} [CommRing R] [IsDedekindDomain R]

/-- A height-one prime dividing a power of another height-one prime equals it. -/
theorem HeightOneSpectrum.eq_of_dvd_pow {v w : HeightOneSpectrum R} {k : ℕ}
    (h : w.asIdeal ∣ v.asIdeal ^ k) : w = v :=
  HeightOneSpectrum.asIdeal_injective <| associated_iff_eq.mp <|
    w.prime.associated_of_dvd v.prime (w.prime.dvd_of_dvd_pow h)

end DedekindDomainIdealLemmas

/-- If an algebra projection admits an additive section compatible with multiplication,
the trace of a lifted element projects to its trace in the quotient algebra.
The images of a finite basis of the original algebra span the quotient. -/
theorem trace_of_algebra_projection
    {R A K B ι : Type*} [CommRing R] [CommRing A] [Algebra R A]
    [Field K] [CommRing B] [Algebra K B] [Fintype ι]
    (b : Module.Basis ι R A) (p : R →+* K) (hp : Surjective p)
    (q : A →+* B) (s : B →+ A) (hqs : ∀ z, q (s z) = z)
    (hq : ∀ r, q (algebraMap R A r) = algebraMap K B (p r))
    (hs : ∀ a z, s (q a * z) = a * s z) :
    Module.Finite K B ∧ ∀ x, p (Algebra.trace R A (s x)) = Algebra.trace K B x := by
  classical
  let c (i : ι) : B →ₗ[K] K :=
    { toFun := fun z ↦ p (b.repr (s z) i)
      map_add' := fun z w ↦ by simp
      map_smul' := fun k z ↦ by
        obtain ⟨r, rfl⟩ := hp k
        change p (b.repr (s (p r • z)) i) = p r * p (b.repr (s z) i)
        rw [Algebra.smul_def]
        rw [← hq, hs, ← Algebra.smul_def, map_smul, Finsupp.smul_apply, smul_eq_mul, map_mul] }
  have hsum (z : B) : ∑ i, c i z • q (b i) = z := by
    have h := congrArg q (b.sum_repr (s z))
    change ∑ i, p (b.repr (s z) i) • q (b i) = z
    simpa only [hqs, map_sum, Algebra.smul_def, map_mul, hq] using h
  let f : A →ₛₗ[p] B :=
    { toFun := q
      map_add' := map_add q
      map_smul' := fun r z ↦ by simp only [Algebra.smul_def, map_mul, hq] }
  let : RingHomSurjective p := ⟨hp⟩
  let : Module.Finite R A := Module.Finite.of_basis b
  have hfinite : Module.Finite K B := Module.Finite.of_surjective f fun z ↦ ⟨s z, hqs z⟩
  refine ⟨hfinite, fun x ↦ ?_⟩
  have hm : Algebra.lmul K B x =
      ∑ i, (c i).smulRight (x * q (b i)) := by
    ext z
    change x * z = (∑ i, (c i).smulRight (x * q (b i))) z
    simp only [LinearMap.sum_apply,
      LinearMap.smulRight_apply, ← mul_smul_comm, ← Finset.mul_sum, hsum]
  rw [Algebra.trace_eq_matrix_trace b, Matrix.trace, map_sum, Algebra.trace_apply]
  rw [hm, map_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [LinearMap.trace_smulRight, Matrix.diag_apply, Algebra.leftMulMatrix_eq_repr_mul]
  change p (b.repr (s x * b i) i) = p (b.repr (s (x * q (b i))) i)
  rw [mul_comm x, hs, mul_comm (s x)]

end InfoGeometry.Arithmetic.RatRingOfIntegersDedekindTrace
