/-!
# InfoGeometry.Canonical.BogoliubovRGFlowBridge

Typed equilibrium bridge between Bogoliubov transport and metriplectic flow.

Both sides of the bridge live in the same operator space `EndH`.  The
reversible component of a supplied metriplectic flow is identified with the
canonical exponential generated by `Kambient`.  At dissipative equilibrium,
the already-proved metriplectic kernel theorem removes the dissipative
component, so the total flow is exactly the canonical Bogoliubov flow.

No density-valued Wasserstein flow is identified with an operator-valued
Bogoliubov flow here; such a statement would require an additional typed
intertwiner.
-/

noncomputable section

namespace InfoGeometry.Canonical.BogoliubovRGFlowBridge

open InfoGeometry.Canonical
open InfoGeometry.Canonical.OnsagerCasimirJ
open InfoGeometry.Canonical.RelativeModularPotential
open BogoliubovOptimalTransport
open InfoGeometry.SuperMetriplectic
open InfoGeometry.Canonical.SouriauKreinMetriplectic
open InfoGeometry.Canonical.SouriauMetriplecticOptimalTransport

variable {E : Type}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/--
Operator-valued bridge connecting the canonical Bogoliubov flow with a
metriplectic flow on the same endomorphism space.
-/
@[rep_depth transport]
structure Bridge
    (E : Type)
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] where
  /-- The certified regular lane reduction. -/
  reduction :
    CertifiedModularReduction (E := InfoGeometry.Krein.DoubledSpace E)

  /-- Time at which the operator-valued metriplectic flow is compared. -/
  time : ℝ

  /-- Operatorial potential owning the response probe. -/
  potential : PotentialDatum (E := E)

  /-- Reference and comparison vectors for the operatorial response. -/
  reference : InfoGeometry.Krein.DoubledSpace E
  comparison : InfoGeometry.Krein.DoubledSpace E
  ψ : InfoGeometry.Krein.DoubledSpace E

  /-- Entropy and comparison perturbation channels. -/
  X :
    (InfoGeometry.Krein.DoubledSpace E) →L[ℝ]
      (InfoGeometry.Krein.DoubledSpace E)
  Y :
    (InfoGeometry.Krein.DoubledSpace E) →L[ℝ]
      (InfoGeometry.Krein.DoubledSpace E)

  /-- Weyl weight of the operatorial response context. -/
  weight : ℝ

  /-- Onsager-Casimir parity hypotheses for the response channels. -/
  X_jInvariant :
    InfoGeometry.Canonical.OnsagerCasimirJ.IsJInvariant (E := E) X
  Y_jInvariant :
    InfoGeometry.Canonical.OnsagerCasimirJ.IsJInvariant (E := E) Y

  /-- Genuine Onsager metric acting on doubled-space endomorphisms. -/
  metric :
    OnsagerMetricData
      (InfoGeometry.Krein.DoubledSpace E →L[ℝ]
        InfoGeometry.Krein.DoubledSpace E)

  /-- Energy force for the metriplectic decomposition. -/
  energyForce :
    InfoGeometry.Krein.DoubledSpace E →L[ℝ]
      InfoGeometry.Krein.DoubledSpace E

  /-- Onsager degeneracy preserves the energy channel. -/
  energy_degeneracy :
    metric.onsager energyForce = 0

namespace Bridge

variable (B : Bridge E)

/--
Canonical operatorial Souriau/Onsager context.  Its observable is
definitionally the certified regular BdG generator.
-/
@[rep_depth transport]
noncomputable def onsagerContext :
    OperatorialMetriplecticContext (E := E) where
  P := B.potential
  reference := B.reference
  comparison := B.comparison
  ψ := B.ψ
  A := B.reduction.Kambient
  X := B.X
  Y := B.Y
  weight := B.weight
  X_jInvariant := B.X_jInvariant
  Y_jInvariant := B.Y_jInvariant

/--
Canonical metriplectic flow attached to the bridge.

The reversible flow is the Bogoliubov exponential, while the dissipative and
total flows are constructed from the supplied Onsager metric rather than
related by stored equality fields.
-/
@[rep_depth transport]
noncomputable def metriplecticFlow :
    MetriplecticFlow
      (InfoGeometry.Krein.DoubledSpace E →L[ℝ]
        InfoGeometry.Krein.DoubledSpace E) where
  metric := B.metric
  entropyForce := B.X
  energyForce := B.energyForce
  reversibleFlow := canonicalBogoliubovFlow B.reduction B.time
  dissipativeFlow := B.metric.onsager B.X
  totalFlow :=
    canonicalBogoliubovFlow B.reduction B.time + B.metric.onsager B.X
  entropyProduction := B.metric.pairing B.X (B.metric.onsager B.X)
  dissipativeFlow_eq_onsager_entropy := rfl
  totalFlow_eq_reversible_add_dissipative := rfl
  energy_degeneracy := B.energy_degeneracy
  entropyProduction_eq_quadratic := rfl

/-- The operator probed by the Onsager context is the regular BdG generator. -/
@[rep_depth transport]
theorem onsager_observable_eq_Kambient :
    B.onsagerContext.A = B.reduction.Kambient :=
  rfl

/-- The metriplectic entropy force is the operatorial Onsager force channel. -/
@[rep_depth transport]
theorem entropy_force_eq_onsager_channel :
    B.metriplecticFlow.entropyForce = B.onsagerContext.X :=
  rfl

/-- The reversible component is definitionally the canonical Bogoliubov flow. -/
@[rep_depth transport]
theorem reversible_flow_is_bogoliubov :
    B.metriplecticFlow.reversibleFlow =
      canonicalBogoliubovFlow B.reduction B.time :=
  rfl

/-- The canonical flow used by the bridge is generated by `Kambient`. -/
@[rep_depth transport]
theorem generator_eq_Kambient
    (B : Bridge E) :
    canonicalBogoliubovFlow B.reduction B.time =
      NormedSpace.exp (B.time • B.reduction.Kambient) :=
  rfl

/--
At dissipative equilibrium the total operator flow is exactly the canonical
Bogoliubov flow.
-/
@[rep_depth transport, capstone]
theorem rg_fixed_point_is_pure_bogoliubov_flow
    (B : Bridge E)
    (hEq : B.metriplecticFlow.IsDissipativeEquilibrium) :
    B.metriplecticFlow.totalFlow =
      canonicalBogoliubovFlow B.reduction B.time := by
  have hDissipative :
      B.metriplecticFlow.dissipativeFlow = 0 :=
    B.metriplecticFlow.dissipativeFlow_eq_zero_of_equilibrium hEq
  calc
    B.metriplecticFlow.totalFlow =
        B.metriplecticFlow.reversibleFlow +
          B.metriplecticFlow.dissipativeFlow :=
      B.metriplecticFlow.totalFlow_eq_reversible_add_dissipative
    _ = B.metriplecticFlow.reversibleFlow := by
      rw [hDissipative, add_zero]
    _ = canonicalBogoliubovFlow B.reduction B.time :=
      B.reversible_flow_is_bogoliubov

/--
The operatorial entropy production associated with the bridge is nonnegative
when the existing comparison-state Cramer--Rao response supplies the Onsager
positive-semidefinite form.
-/
@[rep_depth transport]
theorem operatorial_entropyProduction_nonneg_of_cramerRao
    (B : Bridge E)
    (R :
      OperatorialMetriplecticContext.CramerRaoOperatorialResponseContext
        B.onsagerContext) :
    0 ≤ InfoGeometry.Canonical.Operators.entropyProduction
      B.onsagerContext.P B.onsagerContext.X B.reduction.Kambient := by
  rw [← B.onsager_observable_eq_Kambient]
  exact B.onsagerContext.canonicalEntropyProduction_nonneg_of_cramerRaoResponse R

/-- The pure equilibrium flow remains regular-lane optimal. -/
@[rep_depth transport]
theorem rg_fixed_point_flow_isOptimal
    (B : Bridge E) :
    IsOptimalBogoliubovFlow B.reduction
      (canonicalBogoliubovFlow B.reduction) :=
  canonicalBogoliubovFlow_isOptimal B.reduction

theorem dissipative_flow_eq_onsager_channel :
    B.metriplecticFlow.dissipativeFlow = B.metric.onsager B.X :=
  rfl

@[rep_depth transport]

theorem total_flow_eq_bogoliubov_add_onsager :
    B.metriplecticFlow.totalFlow =
      canonicalBogoliubovFlow B.reduction B.time + B.metric.onsager B.X :=
  rfl

end Bridge

/-! ## Typed density-flow realization -/

/--
A typed realization of a Souriau/JKO density flow inside the doubled
Bogoliubov carrier.

This is the missing mathematical content behind the historical untyped
`otFlow` field.  The encoder is a genuine real-linear map, and the reversible
and dissipative compatibility laws compare maps with matching codomains.
Compatibility with the total flow is derived below from the two owner
decomposition theorems.
-/
@[rep_depth transport]
structure DensityOTIntertwiner
    (B : Bridge E)
    (State LieGroup LieAlgebra LieDual Observable : Type*)
    [Ring Observable] where
  /-- The genuine Souriau/metriplectic/JKO density flow. -/
  otFlow :
    SouriauMetriplecticOTFlow
      State LieGroup LieAlgebra LieDual Observable

  /-- Linear realization of density states in the doubled Krein carrier. -/
  encodeDensity :
    Density State →ₗ[ℝ] InfoGeometry.Krein.DoubledSpace E

  /-- The density-side reversible flow is represented by the BdG flow. -/
  reversible_intertwines :
    ∀ ρ : Density State,
      encodeDensity (otFlow.reversibleFlow ρ) =
        B.metriplecticFlow.reversibleFlow (encodeDensity ρ)

  /-- The JKO dissipative leg is represented by the Onsager operator. -/
  dissipative_intertwines :
    ∀ ρ : Density State,
      encodeDensity (otFlow.dissipativeFlow ρ) =
        B.metriplecticFlow.dissipativeFlow (encodeDensity ρ)

namespace DensityOTIntertwiner

variable
    {State LieGroup LieAlgebra LieDual Observable : Type*}
    [Ring Observable]

variable (B : Bridge E)

variable
    (I :
      DensityOTIntertwiner B
        State LieGroup LieAlgebra LieDual Observable)

/--
The encoded Souriau/JKO total density flow is the operatorial metriplectic
total flow on the doubled carrier.

This is a theorem from linearity and the two native total-flow decomposition
laws; it is not stored as a third compatibility field.
-/
@[rep_depth transport]
theorem total_intertwines
    (ρ : Density State) :
    I.encodeDensity (I.otFlow.totalFlow ρ) =
      B.metriplecticFlow.totalFlow (I.encodeDensity ρ) := by
  rw [I.otFlow.totalFlow_eq_reversible_add_dissipative]
  rw [map_add]
  rw [I.reversible_intertwines, I.dissipative_intertwines]
  rw [B.metriplecticFlow.totalFlow_eq_reversible_add_dissipative]
  rfl

/--
At operatorial dissipative equilibrium, the encoded density total flow is the
canonical Bogoliubov evolution of the encoded density.
-/
@[rep_depth transport, capstone]
theorem total_intertwines_bogoliubov_at_equilibrium
    (ρ : Density State)
    (hEq : B.metriplecticFlow.IsDissipativeEquilibrium) :
    I.encodeDensity (I.otFlow.totalFlow ρ) =
      canonicalBogoliubovFlow B.reduction B.time (I.encodeDensity ρ) := by
  rw [I.total_intertwines]
  rw [B.rg_fixed_point_is_pure_bogoliubov_flow hEq]

/--
A stationary JKO leg is sent to the kernel of the operatorial dissipative
channel.
-/
@[rep_depth transport]
theorem dissipative_stationary_maps_to_operator_kernel
    (ρ : Density State)
    (hρ : I.otFlow.dissipativeFlow ρ = 0) :
    B.metriplecticFlow.dissipativeFlow (I.encodeDensity ρ) = 0 := by
  rw [← I.dissipative_intertwines]
  rw [hρ, map_zero]

end DensityOTIntertwiner

/-! ## Discrete Feshbach–Schur RG Decimation, Gap Suppression & BdG Resolvent Bridge -/

section SchurRGDecimation

open InfoGeometry.Physics.NuclearRealKreinFeshbach
open InfoGeometry.Krein

/-- The Schur-complement effective correction `P * H * R * H * P` generated by eliminating
the complementary subspace `1 - P`. -/
def schurCorrection
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [CompleteSpace V] [KreinSpace V]
    (P H R : V →L[ℝ] V) : V →L[ℝ] V :=
  P * H * R * H * P

/-- When `R` is supported on `1 - P`, `schurCorrection` factors through the off-diagonal corner
couplings `P * H * (1 - P)` and `(1 - P) * H * P`. -/
theorem schurCorrection_eq_corner_sandwich
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [CompleteSpace V] [KreinSpace V]
    (P H R : V →L[ℝ] V)
    (hQR : (1 - P) * R = R) (hRQ : R * (1 - P) = R) :
    schurCorrection P H R = (P * H * (1 - P)) * R * ((1 - P) * H * P) := by
  dsimp [schurCorrection]
  calc P * H * R * H * P
      = P * H * ((1 - P) * R * (1 - P)) * H * P := by rw [hQR, hRQ]
    _ = (P * H * (1 - P)) * R * ((1 - P) * H * P) := by noncomm_ring

/-- Exact operator-norm bound on `effectiveHamiltonian P H R - P * H * P` in terms of the
off-diagonal coupling norms and the complementary resolvent norm `‖R‖`. -/
theorem effectiveHamiltonian_sub_direct_norm_le
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [CompleteSpace V] [KreinSpace V]
    (P H R : V →L[ℝ] V)
    (hQR : (1 - P) * R = R) (hRQ : R * (1 - P) = R) :
    ‖effectiveHamiltonian P H R - P * H * P‖ ≤
      ‖P * H * (1 - P)‖ * ‖R‖ * ‖(1 - P) * H * P‖ := by
  have hdiff : effectiveHamiltonian P H R - P * H * P = schurCorrection P H R := by
    dsimp [effectiveHamiltonian, schurCorrection]
    abel
  rw [hdiff, schurCorrection_eq_corner_sandwich P H R hQR hRQ]
  have h1 : ‖(P * H * (1 - P)) * R * ((1 - P) * H * P)‖ ≤
      ‖(P * H * (1 - P)) * R‖ * ‖(1 - P) * H * P‖ :=
    ContinuousLinearMap.opNorm_comp_le _ _
  have h2 : ‖(P * H * (1 - P)) * R‖ ≤ ‖P * H * (1 - P)‖ * ‖R‖ :=
    ContinuousLinearMap.opNorm_comp_le _ _
  exact le_trans h1 (mul_le_mul_of_nonneg_right h2 (norm_nonneg _))

/-- **Schur Gap Suppression Bound** (`ATCodazzi` Prop. 5.1): if the high-window resolvent has
gap bound `‖R‖ ≤ g⁻¹` (`0 < g`) and the off-diagonal couplings have norm `≤ ε`, then the
Feshbach–Schur correction is suppressed as `ε ^ 2 / g`. -/
theorem schur_gap_suppression_bound
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [CompleteSpace V] [KreinSpace V]
    (P H R : V →L[ℝ] V) {g ε : ℝ}
    (hg : 0 < g) (hR : ‖R‖ ≤ g⁻¹)
    (h1 : ‖P * H * (1 - P)‖ ≤ ε) (h2 : ‖(1 - P) * H * P‖ ≤ ε)
    (hQR : (1 - P) * R = R) (hRQ : R * (1 - P) = R) :
    ‖effectiveHamiltonian P H R - P * H * P‖ ≤ ε ^ 2 / g := by
  have hnorm := effectiveHamiltonian_sub_direct_norm_le P H R hQR hRQ
  have hε : 0 ≤ ε := le_trans (norm_nonneg _) h1
  have hg_inv : 0 ≤ g⁻¹ := inv_nonneg.mpr (le_of_lt hg)
  have h3 : ‖P * H * (1 - P)‖ * ‖R‖ ≤ ε * g⁻¹ :=
    mul_le_mul h1 hR (norm_nonneg _) hε
  have h4 : ‖P * H * (1 - P)‖ * ‖R‖ * ‖(1 - P) * H * P‖ ≤ (ε * g⁻¹) * ε :=
    mul_le_mul h3 h2 (norm_nonneg _) (mul_nonneg hε hg_inv)
  calc ‖effectiveHamiltonian P H R - P * H * P‖
      ≤ ‖P * H * (1 - P)‖ * ‖R‖ * ‖(1 - P) * H * P‖ := hnorm
    _ ≤ (ε * g⁻¹) * ε := h4
    _ = ε ^ 2 / g := by ring

/-- When `[P, H] = 0` (`P * H = H * P`), the Schur RG flow correction `schurCorrection P H R`
vanishes identically and `effectiveHamiltonian P H R = P * H * P`. -/
theorem schurCorrection_zero_of_commute
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [CompleteSpace V] [KreinSpace V]
    (P H R : V →L[ℝ] V)
    (hP : P * P = P) (hComm : P * H = H * P) (hQR : (1 - P) * R = R) :
    schurCorrection P H R = 0 ∧ effectiveHamiltonian P H R = P * H * P := by
  have hEff := effectiveHamiltonian_sub_direct_eq_zero_of_commute P H R hP hComm hQR
  have hDiff : schurCorrection P H R = effectiveHamiltonian P H R - P * H * P := by
    dsimp [schurCorrection, effectiveHamiltonian]
    abel
  refine ⟨?_, hEff⟩
  rw [hDiff, hEff, sub_self]

/-- Contrapositive obstruction characterization: a non-vanishing Schur RG flow correction
(`effectiveHamiltonian P H R ≠ P * H * P`) necessarily requires the noncommutativity obstruction
`[P, H] ≠ 0` (`P * H ≠ H * P`). -/
theorem schurCorrection_ne_zero_implies_noncommute
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [CompleteSpace V] [KreinSpace V]
    (P H R : V →L[ℝ] V)
    (hP : P * P = P) (hQR : (1 - P) * R = R)
    (hNonZero : effectiveHamiltonian P H R ≠ P * H * P) :
    P * H ≠ H * P := by
  intro hComm
  exact hNonZero (schurCorrection_zero_of_commute P H R hP hComm hQR).2

/-! ### Feshbach Decimation of `Bridge.reduction.Kambient` -/

section BridgeDecimation

local notation "EndD" => InfoGeometry.Krein.DoubledSpace E →L[ℝ] InfoGeometry.Krein.DoubledSpace E

noncomputable local instance : NormedRing EndD := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndD := inferInstance
local instance : IsTopologicalRing EndD := inferInstance
local instance : CompleteSpace EndD := inferInstance
local instance : SMulCommClass ℝ EndD EndD := inferInstance
local instance : IsScalarTower ℝ EndD EndD := inferInstance

/-- The Feshbach-decimated generator `effectiveHamiltonian P₀ B.reduction.Kambient R₀` is
supported on the IR projector `P₀`. -/
theorem decimated_Kambient_supported_on_IR
    (B : Bridge E) (P₀ R₀ : EndD) (hP0 : P₀ * P₀ = P₀) :
    let K_IR := effectiveHamiltonian P₀ B.reduction.Kambient R₀
    P₀ * K_IR = K_IR ∧ K_IR * P₀ = K_IR := by
  intro K_IR
  dsimp [K_IR, effectiveHamiltonian]
  constructor
  · calc P₀ * (P₀ * B.reduction.Kambient * P₀ + P₀ * B.reduction.Kambient * R₀ * B.reduction.Kambient * P₀)
        = (P₀ * P₀) * B.reduction.Kambient * P₀ +
            (P₀ * P₀) * B.reduction.Kambient * R₀ * B.reduction.Kambient * P₀ := by noncomm_ring
      _ = P₀ * B.reduction.Kambient * P₀ +
            P₀ * B.reduction.Kambient * R₀ * B.reduction.Kambient * P₀ := by rw [hP0]
  · calc (P₀ * B.reduction.Kambient * P₀ + P₀ * B.reduction.Kambient * R₀ * B.reduction.Kambient * P₀) * P₀
        = P₀ * B.reduction.Kambient * (P₀ * P₀) +
            P₀ * B.reduction.Kambient * R₀ * B.reduction.Kambient * (P₀ * P₀) := by noncomm_ring
      _ = P₀ * B.reduction.Kambient * P₀ +
            P₀ * B.reduction.Kambient * R₀ * B.reduction.Kambient * P₀ := by rw [hP0]

/-- When `P₀ ≤ B.reduction.Preg`, the Feshbach-decimated generator `K_IR` remains supported on
the regular projector `B.reduction.Preg`. -/
theorem decimated_Kambient_supported_on_Preg
    (B : Bridge E) (P₀ R₀ : EndD)
    (hP0 : P₀ * P₀ = P₀)
    (hSub : P₀ * B.reduction.Preg = P₀)
    (hSubR : B.reduction.Preg * P₀ = P₀) :
    let K_IR := effectiveHamiltonian P₀ B.reduction.Kambient R₀
    B.reduction.Preg * K_IR = K_IR ∧ K_IR * B.reduction.Preg = K_IR := by
  intro K_IR
  have hIR := decimated_Kambient_supported_on_IR B P₀ R₀ hP0
  constructor
  · calc B.reduction.Preg * K_IR = B.reduction.Preg * (P₀ * K_IR) := by rw [hIR.1]
      _ = (B.reduction.Preg * P₀) * K_IR := (mul_assoc _ _ _).symm
      _ = P₀ * K_IR := by rw [hSubR]
      _ = K_IR := hIR.1
  · calc K_IR * B.reduction.Preg = (K_IR * P₀) * B.reduction.Preg := by rw [hIR.2]
      _ = K_IR * (P₀ * B.reduction.Preg) := mul_assoc _ _ _
      _ = K_IR * P₀ := by rw [hSub]
      _ = K_IR := hIR.2

/-- When `P₀ ≤ B.reduction.Preg`, the Feshbach-decimated generator `K_IR` annihilates the
Drazin defect projector `B.reduction.Pzero` on both sides. -/
theorem decimated_Kambient_kills_Pzero
    (B : Bridge E) (P₀ R₀ : EndD)
    (hP0 : P₀ * P₀ = P₀)
    (hSub : P₀ * B.reduction.Preg = P₀)
    (hSubR : B.reduction.Preg * P₀ = P₀) :
    let K_IR := effectiveHamiltonian P₀ B.reduction.Kambient R₀
    B.reduction.Pzero * K_IR = 0 ∧ K_IR * B.reduction.Pzero = 0 := by
  intro K_IR
  have hPzero : B.reduction.Pzero = (1 : EndD) - B.reduction.Preg := by
    simp [CertifiedModularReduction.Pzero, CertifiedModularReduction.Preg,
      CertifiedInverseKernel.spectralComplementaryProjector,
      CertifiedInverseKernel.toInverseKernel', InverseKernel.spectralComplementaryProjector]
  have hPreg_idem : B.reduction.Preg * B.reduction.Preg = B.reduction.Preg := by
    change B.reduction.cik.spectralProjector.comp B.reduction.cik.spectralProjector =
      B.reduction.cik.spectralProjector
    exact B.reduction.cik.spectralProjector_idempotent
  have hPzero_P0 : B.reduction.Pzero * P₀ = 0 := by
    calc B.reduction.Pzero * P₀
        = ((1 : EndD) - B.reduction.Preg) * (B.reduction.Preg * P₀) := by rw [hPzero, hSubR]
      _ = B.reduction.Preg * P₀ - (B.reduction.Preg * B.reduction.Preg) * P₀ := by noncomm_ring
      _ = B.reduction.Preg * P₀ - B.reduction.Preg * P₀ := by rw [hPreg_idem]
      _ = 0 := sub_self _
  have hP0_Pzero : P₀ * B.reduction.Pzero = 0 := by
    calc P₀ * B.reduction.Pzero
        = (P₀ * B.reduction.Preg) * ((1 : EndD) - B.reduction.Preg) := by rw [hPzero, hSub]
      _ = P₀ * B.reduction.Preg - P₀ * (B.reduction.Preg * B.reduction.Preg) := by noncomm_ring
      _ = P₀ * B.reduction.Preg - P₀ * B.reduction.Preg := by rw [hPreg_idem]
      _ = 0 := sub_self _
  have hIR := decimated_Kambient_supported_on_IR B P₀ R₀ hP0
  constructor
  · calc B.reduction.Pzero * K_IR = B.reduction.Pzero * (P₀ * K_IR) := by rw [hIR.1]
      _ = (B.reduction.Pzero * P₀) * K_IR := (mul_assoc _ _ _).symm
      _ = 0 := by rw [hPzero_P0, zero_mul]
  · calc K_IR * B.reduction.Pzero = (K_IR * P₀) * B.reduction.Pzero := by rw [hIR.2]
      _ = K_IR * (P₀ * B.reduction.Pzero) := mul_assoc _ _ _
      _ = 0 := by rw [hP0_Pzero, mul_zero]

/-- The exponential flow generated by the Feshbach-decimated generator `K_IR` remains
regular-lane optimal (`IsOptimalBogoliubovFlow B.reduction`). -/
theorem decimated_bogoliubovFlow_isOptimal
    (B : Bridge E) (P₀ R₀ : EndD)
    (hP0 : P₀ * P₀ = P₀)
    (hSub : P₀ * B.reduction.Preg = P₀)
    (hSubR : B.reduction.Preg * P₀ = P₀) :
    IsOptimalBogoliubovFlow B.reduction
      (fun t => NormedSpace.exp (t • effectiveHamiltonian P₀ B.reduction.Kambient R₀)) := by
  intro t
  have hSupp := decimated_Kambient_supported_on_Preg B P₀ R₀ hP0 hSub hSubR
  have hComm : Commute B.reduction.Preg (effectiveHamiltonian P₀ B.reduction.Kambient R₀) :=
    hSupp.1.trans hSupp.2.symm
  simpa using ((hComm.smul_right t).exp_right).eq.symm

/-- On the eliminated complement `1 - P₀`, the Feshbach-decimated Bogoliubov flow acts as
the identity `(1 - P₀) * exp(t • K_IR) = 1 - P₀` for all `t : ℝ`. -/
theorem decimated_bogoliubovFlow_fixed_on_complement
    (B : Bridge E) (P₀ R₀ : EndD) (hP0 : P₀ * P₀ = P₀) (t : ℝ) :
    (1 - P₀) * NormedSpace.exp (t • effectiveHamiltonian P₀ B.reduction.Kambient R₀) = 1 - P₀ := by
  set K_IR := effectiveHamiltonian P₀ B.reduction.Kambient R₀
  have hIR := decimated_Kambient_supported_on_IR B P₀ R₀ hP0
  have hKill : (1 - P₀) * K_IR = 0 := by
    calc (1 - P₀) * K_IR = K_IR - P₀ * K_IR := by noncomm_ring
      _ = K_IR - K_IR := by rw [hIR.1]
      _ = 0 := sub_self _
  let f : ℝ → EndD := fun s => (1 - P₀) * NormedSpace.exp (s • K_IR)
  have hderiv : ∀ s : ℝ, HasDerivAt f 0 s := by
    intro s
    have hexp0 : HasDerivAt (fun u : ℝ => NormedSpace.exp (u • K_IR))
        (NormedSpace.exp (s • K_IR) * K_IR) s :=
      hasDerivAt_exp_smul_const (𝕂 := ℝ) K_IR s
    have hcomm : NormedSpace.exp (s • K_IR) * K_IR = K_IR * NormedSpace.exp (s • K_IR) :=
      (((Commute.refl K_IR).smul_right s).exp_right).eq.symm
    have hexp : HasDerivAt (fun u : ℝ => NormedSpace.exp (u • K_IR))
        (K_IR * NormedSpace.exp (s • K_IR)) s :=
      hcomm ▸ hexp0
    have hmul : HasDerivAt f ((1 - P₀) * (K_IR * NormedSpace.exp (s • K_IR))) s :=
      hexp.const_mul (1 - P₀)
    have hzero : (1 - P₀) * (K_IR * NormedSpace.exp (s • K_IR)) = 0 := by
      rw [← mul_assoc, hKill, zero_mul]
    simpa [hzero] using hmul
  have hconst : f t = f 0 :=
    is_const_of_deriv_eq_zero (fun s => (hderiv s).differentiableAt)
      (fun s => (hderiv s).deriv) t 0
  simpa [f, zero_smul, NormedSpace.exp_zero, mul_one] using hconst

/-- If the IR projector `P₀` commutes with `B.reduction.Kambient`, the Schur correction
vanishes identically and `K_IR = P₀ * B.reduction.Kambient * P₀`. -/
theorem decimated_Kambient_fixed_point_if_commutes
    (B : Bridge E) (P₀ R₀ : EndD)
    (hP0 : P₀ * P₀ = P₀)
    (hComm : P₀ * B.reduction.Kambient = B.reduction.Kambient * P₀)
    (hQR : (1 - P₀) * R₀ = R₀) :
    effectiveHamiltonian P₀ B.reduction.Kambient R₀ = P₀ * B.reduction.Kambient * P₀ := by
  have hzero : P₀ * B.reduction.Kambient * R₀ = 0 := by
    calc P₀ * B.reduction.Kambient * R₀
        = (B.reduction.Kambient * P₀) * ((1 - P₀) * R₀) := by rw [hComm, hQR]
      _ = B.reduction.Kambient * (P₀ - P₀ * P₀) * R₀ := by noncomm_ring
      _ = 0 := by rw [hP0, sub_self, mul_zero, zero_mul]
  dsimp [effectiveHamiltonian]
  rw [hzero, zero_mul, zero_mul, add_zero]

/-- Two-step Feshbach RG decimation closure for `B.reduction.Kambient` through nested scales
`P₀ ≤ P₁ ≤ B.reduction.Preg`: derives Schur transitivity to `K_01`, Krein self-adjointness of
`K_01`, IR and regular-lane projector support, Drazin defect `Pzero` annihilation, Bogoliubov
flow optimality, and complement invariance `(1 - P₀) * exp(t • K_01) = 1 - P₀`. -/
theorem nested_decimated_Kambient_transitive
    (B : Bridge E) (P₀ P₁ R₁ R₀₁ : EndD) (E : ℝ)
    (hP0 : P₀ * P₀ = P₀) (hP1 : P₁ * P₁ = P₁)
    (hP0_sa : InfoGeometry.Krein.KreinSpace.kreinAdjoint P₀ = P₀)
    (hP1_sa : InfoGeometry.Krein.KreinSpace.kreinAdjoint P₁ = P₁)
    (hK_sa : InfoGeometry.Krein.KreinSpace.kreinAdjoint B.reduction.Kambient = B.reduction.Kambient)
    (h_nest : P₀ * P₁ = P₀)
    (hSub : P₁ * B.reduction.Preg = P₁) (hSubR : B.reduction.Preg * P₁ = P₁)
    (hQR1 : (1 - P₁) * R₁ = R₁)
    (hDR1 : denominator P₁ B.reduction.Kambient E * R₁ = 1 - P₁)
    (hSR01 : intermediateShell P₀ P₁ * R₀₁ = R₀₁)
    (hDR01 : intermediateDenominator P₀ P₁
      (effectiveHamiltonian P₁ B.reduction.Kambient R₁) E * R₀₁ =
      intermediateShell P₀ P₁) :
    let K_01 := effectiveHamiltonian P₀ (effectiveHamiltonian P₁ B.reduction.Kambient R₁) R₀₁
    effectiveHamiltonian P₀ B.reduction.Kambient (nestedResolvent B.reduction.Kambient R₁ R₀₁) =
        K_01 ∧
      InfoGeometry.Krein.KreinSpace.IsKreinSelfAdjoint K_01 ∧
      (P₀ * K_01 = K_01 ∧ K_01 * P₀ = K_01) ∧
      (B.reduction.Preg * K_01 = K_01 ∧ K_01 * B.reduction.Preg = K_01) ∧
      (B.reduction.Pzero * K_01 = 0 ∧ K_01 * B.reduction.Pzero = 0) ∧
      IsOptimalBogoliubovFlow B.reduction (fun t => NormedSpace.exp (t • K_01)) ∧
      ∀ t : ℝ, (1 - P₀) * NormedSpace.exp (t • K_01) = 1 - P₀ := by
  intro K_01
  have hTrans :
      effectiveHamiltonian P₀ B.reduction.Kambient
          (nestedResolvent B.reduction.Kambient R₁ R₀₁) = K_01 :=
    effectiveHamiltonian_schur_transitive P₀ P₁ B.reduction.Kambient R₁ R₀₁ E
      hP1 hP0_sa hP1_sa hK_sa h_nest hQR1 hDR1 hSR01 hDR01
  have hR : P₁ * P₀ = P₀ := nested_mul_right P₀ P₁ hP0_sa hP1_sa h_nest
  have hSub0 : P₀ * B.reduction.Preg = P₀ := by
    calc P₀ * B.reduction.Preg = (P₀ * P₁) * B.reduction.Preg := by rw [h_nest]
      _ = P₀ * (P₁ * B.reduction.Preg) := mul_assoc _ _ _
      _ = P₀ := by rw [hSub, h_nest]
  have hSub0R : B.reduction.Preg * P₀ = P₀ := by
    calc B.reduction.Preg * P₀ = B.reduction.Preg * (P₁ * P₀) := by rw [hR]
      _ = (B.reduction.Preg * P₁) * P₀ := (mul_assoc _ _ _).symm
      _ = P₀ := by rw [hSubR, hR]
  have hSupp0 :
      (1 - P₀) * nestedResolvent B.reduction.Kambient R₁ R₀₁ =
        nestedResolvent B.reduction.Kambient R₁ R₀₁ :=
    nestedResolvent_support P₀ P₁ B.reduction.Kambient R₁ R₀₁ hP0 h_nest hQR1 hSR01
  have hD0 :
      denominator P₀ B.reduction.Kambient E * nestedResolvent B.reduction.Kambient R₁ R₀₁ =
        1 - P₀ :=
    denominator_mul_nestedResolvent P₀ P₁ B.reduction.Kambient R₁ R₀₁ E
      hP0 hP1 h_nest hR hQR1 hDR1 hSR01 hDR01
  have hSA : InfoGeometry.Krein.KreinSpace.IsKreinSelfAdjoint K_01 := by
    rw [← hTrans]
    exact effectiveHamiltonian_kreinSelfAdjoint P₀ B.reduction.Kambient
      (nestedResolvent B.reduction.Kambient R₁ R₀₁) E hP0_sa hK_sa hSupp0 hD0
  have hIR : P₀ * K_01 = K_01 ∧ K_01 * P₀ = K_01 := by
    rw [← hTrans]
    exact decimated_Kambient_supported_on_IR B P₀
      (nestedResolvent B.reduction.Kambient R₁ R₀₁) hP0
  have hPreg : B.reduction.Preg * K_01 = K_01 ∧ K_01 * B.reduction.Preg = K_01 := by
    rw [← hTrans]
    exact decimated_Kambient_supported_on_Preg B P₀
      (nestedResolvent B.reduction.Kambient R₁ R₀₁) hP0 hSub0 hSub0R
  have hPzero : B.reduction.Pzero * K_01 = 0 ∧ K_01 * B.reduction.Pzero = 0 := by
    rw [← hTrans]
    exact decimated_Kambient_kills_Pzero B P₀
      (nestedResolvent B.reduction.Kambient R₁ R₀₁) hP0 hSub0 hSub0R
  have hOpt : IsOptimalBogoliubovFlow B.reduction (fun t => NormedSpace.exp (t • K_01)) := by
    simpa only [← hTrans] using
      decimated_bogoliubovFlow_isOptimal B P₀
        (nestedResolvent B.reduction.Kambient R₁ R₀₁) hP0 hSub0 hSub0R
  have hComp : ∀ t : ℝ, (1 - P₀) * NormedSpace.exp (t • K_01) = 1 - P₀ := by
    intro t
    rw [← hTrans]
    exact decimated_bogoliubovFlow_fixed_on_complement B P₀
      (nestedResolvent B.reduction.Kambient R₁ R₀₁) hP0 t
  exact ⟨hTrans, hSA, hIR, hPreg, hPzero, hOpt, hComp⟩

/-- At dissipative equilibrium, coarse-graining by any projector `P₀` commuting with
`B.reduction.Kambient` intertwines the encoded `DensityOTIntertwiner` total flow with the
canonical Bogoliubov flow. -/
theorem rg_coarseGrain_intertwines_equilibrium_flow
    {State LieGroup LieAlgebra LieDual Observable : Type*} [Ring Observable]
    (B : Bridge E)
    (I : DensityOTIntertwiner B State LieGroup LieAlgebra LieDual Observable)
    (P₀ : EndD)
    (hComm : P₀ * B.reduction.Kambient = B.reduction.Kambient * P₀)
    (hEq : B.metriplecticFlow.IsDissipativeEquilibrium)
    (ρ : Density State) :
    P₀ (I.encodeDensity (I.otFlow.totalFlow ρ)) =
      canonicalBogoliubovFlow B.reduction B.time (P₀ (I.encodeDensity ρ)) := by
  rw [I.total_intertwines_bogoliubov_at_equilibrium B ρ hEq]
  have hCommFlow : Commute P₀ (canonicalBogoliubovFlow B.reduction B.time) := by
    change Commute P₀ (NormedSpace.exp (B.time • B.reduction.Kambient))
    exact (Commute.smul_right hComm B.time).exp_right
  exact congrArg (fun T : EndD => T (I.encodeDensity ρ)) hCommFlow.eq

end BridgeDecimation

/-! ### Two-Level BdG Resolvent Gap Bridge -/

section BdGResolventBridge

open InfoGeometry.Physics.NuclearBdGTwoLevelExact

/-- Inside the two-level BdG spectral gap `|E| < bdgEnergy ξ Δ`, the shifted BdG block
`bdgBlock ξ Δ - E • 1` has nonzero determinant. -/
theorem bdg_resolvent_det_ne_zero
    {ξ Δ E : ℝ} (hE : |E| < bdgEnergy ξ Δ) :
    (bdgBlock ξ Δ - E • (1 : M2R)).det ≠ 0 := by
  rw [bdg_characteristic]
  have h2 : |E| ^ 2 < (bdgEnergy ξ Δ) ^ 2 :=
    sq_lt_sq' (by linarith [abs_nonneg E, bdgEnergy_nonneg ξ Δ]) hE
  rw [sq_abs, bdgEnergy_sq] at h2
  exact sub_ne_zero.mpr (ne_of_lt h2)

/-- Explicit matrix resolvent `(E • 1 - bdgBlock ξ Δ)⁻¹` on the two-level BdG carrier `M2R`. -/
def bdgExplicitResolvent (ξ Δ E : ℝ) : M2R :=
  (E ^ 2 - (ξ ^ 2 + Δ ^ 2))⁻¹ • (E • (1 : M2R) + bdgBlock ξ Δ)

/-- Inside the spectral gap `|E| < bdgEnergy ξ Δ`, `bdgExplicitResolvent ξ Δ E` is the exact
two-sided inverse of `E • 1 - bdgBlock ξ Δ`. -/
theorem bdg_resolvent_mul_eq_one
    {ξ Δ E : ℝ} (hE : |E| < bdgEnergy ξ Δ) :
    (E • (1 : M2R) - bdgBlock ξ Δ) * bdgExplicitResolvent ξ Δ E = 1 ∧
      bdgExplicitResolvent ξ Δ E * (E • (1 : M2R) - bdgBlock ξ Δ) = 1 := by
  have h2 : |E| ^ 2 < (bdgEnergy ξ Δ) ^ 2 :=
    sq_lt_sq' (by linarith [abs_nonneg E, bdgEnergy_nonneg ξ Δ]) hE
  rw [sq_abs, bdgEnergy_sq] at h2
  have hden : E ^ 2 - (ξ ^ 2 + Δ ^ 2) ≠ 0 := sub_ne_zero.mpr (ne_of_lt h2)
  have hsq : bdgBlock ξ Δ * bdgBlock ξ Δ = (ξ ^ 2 + Δ ^ 2) • (1 : M2R) :=
    bdgBlock_sq ξ Δ
  have hdiff : (E • (1 : M2R) - bdgBlock ξ Δ) * (E • (1 : M2R) + bdgBlock ξ Δ) =
      (E ^ 2 - (ξ ^ 2 + Δ ^ 2)) • (1 : M2R) := by
    calc (E • (1 : M2R) - bdgBlock ξ Δ) * (E • (1 : M2R) + bdgBlock ξ Δ)
        = (E ^ 2) • (1 : M2R) - bdgBlock ξ Δ * bdgBlock ξ Δ := by
            simp only [sub_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul, mul_one,
              smul_sub, smul_smul]
            rw [← sq E]
            abel
      _ = (E ^ 2 - (ξ ^ 2 + Δ ^ 2)) • (1 : M2R) := by rw [hsq, sub_smul]
  have hdiff' : (E • (1 : M2R) + bdgBlock ξ Δ) * (E • (1 : M2R) - bdgBlock ξ Δ) =
      (E ^ 2 - (ξ ^ 2 + Δ ^ 2)) • (1 : M2R) := by
    calc (E • (1 : M2R) + bdgBlock ξ Δ) * (E • (1 : M2R) - bdgBlock ξ Δ)
        = (E ^ 2) • (1 : M2R) - bdgBlock ξ Δ * bdgBlock ξ Δ := by
            simp only [add_mul, mul_sub, smul_mul_assoc, mul_smul_comm, one_mul, mul_one,
              smul_add, smul_smul]
            rw [← sq E]
            abel
      _ = (E ^ 2 - (ξ ^ 2 + Δ ^ 2)) • (1 : M2R) := by rw [hsq, sub_smul]
  constructor
  · dsimp [bdgExplicitResolvent]
    rw [mul_smul_comm, hdiff, smul_smul, inv_mul_cancel₀ hden, one_smul]
  · dsimp [bdgExplicitResolvent]
    rw [smul_mul_assoc, hdiff', smul_smul, inv_mul_cancel₀ hden, one_smul]

/-- At zero excitation energy `E = 0`, any positive BdG gap `0 < bdgEnergy ξ Δ` yields the
explicit zero-energy inverse `-(ξ ^ 2 + Δ ^ 2)⁻¹ • bdgBlock ξ Δ`. -/
theorem bdg_zero_energy_resolvent
    {ξ Δ : ℝ} (hgap : 0 < bdgEnergy ξ Δ) :
    (-bdgBlock ξ Δ) * bdgExplicitResolvent ξ Δ 0 = 1 ∧
      bdgExplicitResolvent ξ Δ 0 = -((ξ ^ 2 + Δ ^ 2)⁻¹ • bdgBlock ξ Δ) := by
  have hE : |(0 : ℝ)| < bdgEnergy ξ Δ := by simpa using hgap
  have hmul := (bdg_resolvent_mul_eq_one hE).1
  simp only [zero_smul, zero_sub] at hmul
  refine ⟨hmul, ?_⟩
  dsimp [bdgExplicitResolvent]
  rw [zero_smul, zero_add, zero_pow (by norm_num), zero_sub, inv_neg, neg_smul]

end BdGResolventBridge

end SchurRGDecimation

end InfoGeometry.Canonical.BogoliubovRGFlowBridge
