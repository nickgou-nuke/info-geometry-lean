/-- A left-handed (dotted) Weyl spinor: ψ_L = (ψ_L¹, ψ_L²). -/
def leftSpinor (a b : ℂ) : Matrix (Fin 2) (Fin 1) ℂ :=
  !![a; b]

/-- A right-handed (undotted) Weyl spinor: ψ_R = (ψ_R¹, ψ_R²). -/
def rightSpinor (c d : ℂ) : Matrix (Fin 1) (Fin 2) ℂ :=
  !![c, d]

/-- **Fierz Soldering (the Penrose map):**
    A 2×2 Hermitian matrix (spacetime point) is the tensor product
    of a right-handed and left-handed spinor:

    X^{αβ̇} = ψ_R^α ⊗ ψ_L^{*β̇}

    This is the fundamental mechanism by which fermionic spinor degrees
    of freedom "solder" together to create bosonic spacetime coordinates.

    In the Goutev-Tonev nuclear simulator:
    - ψ_R = proton valence spinor (T₃ = +½)
    - ψ_L = neutron valence spinor (T₃ = −½)
    - The Fierz product ψ_R ⊗ ψ_L* generates the 2×2 matrix whose
      eigenvalues encode the emergent spacetime geometry. -/
def fierzSolder (ψ_R : Matrix (Fin 1) (Fin 2) ℂ) (ψ_L : Matrix (Fin 2) (Fin 1) ℂ) :
    Matrix (Fin 2) (Fin 2) ℂ :=
  ψ_L * ψ_R

/-- The trace of the Fierz-soldered matrix is the spinor inner product:
    Tr(ψ_L ψ_R) = ψ_R · ψ_L = ⟨ψ_L|ψ_R⟩.
    This is the "time" coordinate generated by the spinor overlap. -/
theorem fierz_trace_is_inner_product (a b c d : ℂ) :
    Matrix.trace (fierzSolder (rightSpinor c d) (leftSpinor a b)) = c * a + d * b := by
  simp [fierzSolder, leftSpinor, rightSpinor, Matrix.trace, Matrix.mul_apply]
  ring
