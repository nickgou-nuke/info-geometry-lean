import InfoGeometry.Canonical.DrazinSupercharge
import InfoGeometry.Meta.Architecture

set_option linter.dupNamespace false

open scoped InnerProductSpace

namespace InfoGeometry.Canonical.SuperchargeModularHamiltonianBridge

open InfoGeometry.Canonical

variable {E : Type*}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "EndH" => E →L[ℝ] E

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
noncomputable local instance : NormedAlgebra ℚ EndH :=
  NormedAlgebra.restrictScalars ℚ ℝ EndH
local instance : IsTopologicalRing EndH := inferInstance
local instance : SMulCommClass ℝ EndH EndH := inferInstance
local instance : IsScalarTower ℝ EndH EndH := inferInstance

/--
Bounded modular-Hamiltonian surrogate generated by the Drazin/MP supercharge.

This structure does not assert `Q² = Δ`, does not construct `log Δ`, and does not
claim a Type-III realization. It only calibrates the already-owned even
regular-support Hamiltonian `P_D * Q² * P_D` by a positive real energy unit.
-/
@[rep_depth krein]
structure SuperchargeModularHamiltonianBridge where
  CIK : CertifiedInverseKernel E

  /-- Positive calibration unit converting the even super-Hamiltonian to a modular scale. -/
  modularEnergyUnit : ℝ
  modularEnergyUnit_pos : 0 < modularEnergyUnit

  /-- Candidate bounded modular Hamiltonian surrogate. -/
  Ksur : EndH

  /--
  The surrogate modular Hamiltonian is exactly the calibrated regular-support
  compression of the Drazin/MP supercharge Hamiltonian.
  -/
  Ksur_True :
    Ksur =
      modularEnergyUnit •
        DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian CIK

namespace SuperchargeModularHamiltonianBridge

variable (H : SuperchargeModularHamiltonianBridge (E := E))

/-- Readback of the defining calibration law. -/
@[rep_depth krein]
theorem Ksur_eq_calibrated_regularRestrictedSuperHamiltonian :
    H.Ksur =
      H.modularEnergyUnit •
        DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK :=
  H.Ksur_True

/-- Left regular-support invariance: `P_D * K_sur = K_sur`. -/
@[rep_depth krein]
theorem spectralProjector_mul_Ksur :
    H.CIK.spectralProjector * H.Ksur = H.Ksur := by
  rw [H.Ksur_True]
  calc
    H.CIK.spectralProjector *
        (H.modularEnergyUnit •
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)
        =
      H.modularEnergyUnit •
        (H.CIK.spectralProjector *
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK) := by
        simp
    _ =
      H.modularEnergyUnit •
        DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK := by
        rw [
          DrazinSupercharge.CertifiedInverseKernel.spectralProjector_mul_regularRestrictedSuperHamiltonian
        ]

/-- Right regular-support invariance: `K_sur * P_D = K_sur`. -/
@[rep_depth krein]
theorem Ksur_mul_spectralProjector :
    H.Ksur * H.CIK.spectralProjector = H.Ksur := by
  rw [H.Ksur_True]
  calc
    (H.modularEnergyUnit •
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)
        * H.CIK.spectralProjector
        =
      H.modularEnergyUnit •
        (DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK
          * H.CIK.spectralProjector) := by
        simp
    _ =
      H.modularEnergyUnit •
        DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK := by
        rw [
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian_mul_spectralProjector
        ]

/-- Left defect annihilation: `P₀ * K_sur = 0`. -/
@[rep_depth krein]
theorem spectralComplementaryProjector_mul_Ksur_eq_zero :
    H.CIK.spectralComplementaryProjector * H.Ksur = 0 := by
  rw [H.Ksur_True]
  calc
    H.CIK.spectralComplementaryProjector *
        (H.modularEnergyUnit •
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)
        =
      H.modularEnergyUnit •
        (H.CIK.spectralComplementaryProjector *
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK) := by
        simp
    _ = 0 := by
        rw [
          DrazinSupercharge.CertifiedInverseKernel.spectralComplementaryProjector_mul_regularRestrictedSuperHamiltonian_eq_zero
        ]
        simp

/-- Right defect annihilation: `K_sur * P₀ = 0`. -/
@[rep_depth krein]
theorem Ksur_mul_spectralComplementaryProjector_eq_zero :
    H.Ksur * H.CIK.spectralComplementaryProjector = 0 := by
  rw [H.Ksur_True]
  calc
    (H.modularEnergyUnit •
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)
        * H.CIK.spectralComplementaryProjector
        =
      H.modularEnergyUnit •
        (DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK
          * H.CIK.spectralComplementaryProjector) := by
        simp
    _ = 0 := by
        rw [
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian_mul_spectralComplementaryProjector_eq_zero
        ]
        simp

/-- The calibrated surrogate commutes with the spectral grading. -/
@[rep_depth krein]
theorem Ksur_commutes_GammaS :
    H.Ksur * H.CIK.GammaS = H.CIK.GammaS * H.Ksur := by
  rw [H.Ksur_True]
  calc
    (H.modularEnergyUnit •
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)
        * H.CIK.GammaS
        =
      H.modularEnergyUnit •
        (DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK
          * H.CIK.GammaS) := by
        simp
    _ =
      H.modularEnergyUnit •
        (H.CIK.GammaS *
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK) := by
        rw [
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian_commutes_GammaS
        ]
    _ =
      H.CIK.GammaS *
        (H.modularEnergyUnit •
          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK) := by
        simp

/-- The bounded modular-Hamiltonian surrogate is in the even/spectrally compact lane. -/
@[rep_depth krein]
theorem Ksur_isSpectralCompact :
    let T := H.CIK.toInformationCartanTriple
    T.IsSpectralCompact H.Ksur := by
  let T := H.CIK.toInformationCartanTriple
  rw [CartanDecomposition.InformationCartanTriple.isSpectralCompact_iff_commute T H.CIK.hDrazin]
  simpa [T, CertifiedInverseKernel.GammaS, CertifiedInverseKernel.cartanTriple,
    CertifiedInverseKernel.toInformationCartanTriple] using
    Ksur_commutes_GammaS H

end SuperchargeModularHamiltonianBridge

end InfoGeometry.Canonical.SuperchargeModularHamiltonianBridge
