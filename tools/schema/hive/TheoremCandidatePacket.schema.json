{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TheoremCandidatePacket.schema.json",
  "title": "TheoremCandidatePacket",
  "allOf": [
    {
      "$ref": "common_envelope.schema.json"
    },
    {
      "$ref": "authority.schema.json"
    },
    {
      "$ref": "representation.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "packet_version",
        "packet_hash",
        "symbolic_origin_refs",
        "formal_target",
        "bridge_claim",
        "novelty_defense",
        "repo_anchor_refs",
        "candidate_dependencies",
        "admissibility_state",
        "cost_class"
      ],
      "properties": {
        "kind": {
          "const": "TheoremCandidatePacket"
        },
        "status": {
          "enum": [
            "draft",
            "legalized",
            "probe_ready",
            "gated",
            "executed",
            "accepted",
            "rejected",
            "deferred"
          ]
        },
        "authority": {
          "const": "proposal"
        },
        "packet_version": {
          "type": "string",
          "minLength": 1
        },
        "packet_hash": {
          "type": "string",
          "minLength": 1
        },
        "symbolic_origin_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "source_ref.schema.json"
          }
        },
        "formal_target": {
          "type": "object",
          "required": [
            "target_kind",
            "summary"
          ],
          "properties": {
            "target_kind": {
              "type": "string"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "target_expression": { "type": "string", "minLength": 1 },
            "source_path": { "type": "string", "minLength": 1 },
            "source_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "candidate_shape": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "pantograph_binding": {
          "type": "object",
          "required": ["source_path", "source_snapshot_sha256", "target_expression"],
          "properties": {
            "source_path": { "type": "string", "minLength": 1 },
            "source_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "target_expression": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "draft_binding": {
          "type": "object",
          "required": ["receipt", "receipt_sha256"],
          "properties": {
            "receipt": { "type": "object" },
            "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        "ground_truth_contract": {
          "type": "object",
          "required": ["contract", "contract_sha256"],
          "properties": {
            "contract": { "$ref": "GroundTruthTheoremContract.schema.json" },
            "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        "bridge_claim": {
          "type": "string",
          "minLength": 1
        },
        "novelty_defense": {
          "type": "object",
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "duplication_assessment": {
              "type": "string"
            },
            "pressure_points": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "repo_anchor_refs": {
          "type": "array",
          "items": {
            "$ref": "source_ref.schema.json"
          }
        },
        "candidate_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "admissibility_state": {
          "type": "string",
          "enum": [
            "unknown",
            "emergent",
            "plausible",
            "needs_anchor",
            "needs_translation",
            "inadmissible",
            "admissible_for_probe",
            "admissible_for_build"
          ]
        },
        "cost_class": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "very_high",
            "unknown"
          ]
        },
        "anchor_completeness": {
          "type": "string"
        },
        "target_namespace_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_module_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promotion_allowed": {
          "const": false
        }
      }
    }
  ]
}
