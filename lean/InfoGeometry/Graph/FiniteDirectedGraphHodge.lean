  · rintro ⟨potential, hPotential⟩
    have hWeights : weight = fun edge =>
        potential (archiveCycleTarget edge) -
          potential (archiveCycleSource edge) := by
      funext edge
      exact hPotential edge
    rw [hWeights, archiveCycle_pairing_eq_pathDifference]
