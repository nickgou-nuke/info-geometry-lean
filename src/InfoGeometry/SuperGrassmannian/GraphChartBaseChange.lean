import InfoGeometry.SuperGrassmannian.GradedGraphChart
import Mathlib.LinearAlgebra.Pi
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Coefficient change for finite free graph charts

For left modules over a possibly noncommutative ring, coordinates multiply
on the right. Extension is the target-module span of the coefficientwise
image, not the set-theoretic image (which need not be a target submodule).
No surjectivity of the coefficient homomorphism is assumed.
-/

namespace InfoGeometry.SuperGrassmannian.GraphChartBaseChange

variable {A B C I J : Type*} [Ring A] [Ring B] [Ring C]

/-- Semilinear coefficient change on the ambient pair of free modules. -/
def coefficientMap (φ : A →+* B) :
    ((I → A) × (J → A)) →ₛₗ[φ] ((I → B) × (J → B)) where
  toFun z := (fun i => φ (z.1 i), fun j => φ (z.2 j))
  map_add' x y := by ext <;> simp
  map_smul' a x := by ext <;> simp [smul_eq_mul]

/-- Extension of a submodule inside the base-changed free ambient module. -/
def extend (φ : A →+* B) (S : Submodule A ((I → A) × (J → A))) :
    Submodule B ((I → B) × (J → B)) :=
  Submodule.span B (coefficientMap φ '' (S : Set _))

@[simp] theorem extend_id (S : Submodule A ((I → A) × (J → A))) :
    extend (RingHom.id A) S = S := by
  have h : coefficientMap (I := I) (J := J) (RingHom.id A) = LinearMap.id := rfl
  simp [extend, h]

/-- Extension is functorial even for non-surjective coefficient maps. -/
theorem extend_comp (φ : A →+* B) (ψ : B →+* C)
    (S : Submodule A ((I → A) × (J → A))) :
    extend ψ (extend φ S) = extend (ψ.comp φ) S := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    apply (Submodule.image_span_subset (coefficientMap ψ) _ _).mpr
    rintro _ ⟨x, hx, rfl⟩
    exact Submodule.subset_span ⟨x, hx, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨x, hx, rfl⟩
    exact Submodule.subset_span ⟨coefficientMap φ x,
      Submodule.subset_span ⟨x, hx, rfl⟩, rfl⟩

variable [Fintype I]

/-- Right-coefficient formula for a homomorphism of finite free left modules. -/
def coordinateLinearMap (T : I → J → A) : (I → A) →ₗ[A] (J → A) where
  toFun x j := ∑ i, x i * T i j
  map_add' x y := by ext j; simp [add_mul, Finset.sum_add_distrib]
  map_smul' a x := by
    ext j
    simp [smul_eq_mul, mul_assoc, Finset.mul_sum]

@[simp] theorem coordinateLinearMap_apply (T : I → J → A) (x : I → A) (j : J) :
    coordinateLinearMap T x j = ∑ i, x i * T i j := rfl

/-- Evaluation commutes with change of coefficients. -/
theorem coordinateLinearMap_natural (φ : A →+* B) (T : I → J → A) (x : I → A) :
    coordinateLinearMap (fun i j => φ (T i j)) (fun i => φ (x i)) =
      fun j => φ (coordinateLinearMap T x j) := by
  funext j
  simp

/-- Graphs are generated by their standard source-frame lifts. -/
theorem graph_eq_span [DecidableEq I] (T : I → J → A) :
    (coordinateLinearMap T).graph = Submodule.span A
      (Set.range fun i => (Pi.single i (1 : A), T i)) := by
  apply le_antisymm
  · intro z hz
    have he : z = ∑ i, z.1 i • (Pi.single i (1 : A), T i) := by
      apply Prod.ext
      · funext j
        simp [Prod.fst_sum, Finset.sum_apply, Pi.single_apply, smul_eq_mul]
      · funext j
        change z.2 = coordinateLinearMap T z.1 at hz
        simpa [Prod.snd_sum, Finset.sum_apply, smul_eq_mul] using congrFun hz j
    rw [he]
    exact Submodule.sum_mem _ fun i _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change T i = coordinateLinearMap T (Pi.single i 1)
    funext j
    simp [Pi.single_apply]

/-- Main coefficient-change theorem: extension of a graph is the graph of
the coefficientwise-mapped linear map. -/
theorem extend_graph (φ : A →+* B) (T : I → J → A) :
    extend φ (coordinateLinearMap T).graph =
      (coordinateLinearMap (fun i j => φ (T i j))).graph := by
  classical
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨z, hz, rfl⟩
    change z.2 = coordinateLinearMap T z.1 at hz
    change (fun j => φ (z.2 j)) =
      coordinateLinearMap (fun i j => φ (T i j)) (fun i => φ (z.1 i))
    rw [coordinateLinearMap_natural, hz]
  · rw [graph_eq_span]
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    apply Submodule.subset_span
    refine ⟨(Pi.single i 1, T i), ?_, ?_⟩
    · change T i = coordinateLinearMap T (Pi.single i 1)
      funext j
      simp [Pi.single_apply]
    · ext j <;> simp [coefficientMap, Pi.single_apply]

end InfoGeometry.SuperGrassmannian.GraphChartBaseChange
