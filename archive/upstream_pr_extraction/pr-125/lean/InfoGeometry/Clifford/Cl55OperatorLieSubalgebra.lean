import InfoGeometry.Clifford.Cl55OperatorFiveGradeClosure
import Mathlib.Algebra.Lie.Subalgebra

/-!
# A native Lie subalgebra generated by the `Cl(5,5)` Witt packets

This owner keeps the carrier native to `Cl55`.  It does not replace the
operator grade submodules and it does not assert that their finite sum is
itself closed.  Instead, it records the genuine Mathlib Lie subalgebra
generated by the five creation and five annihilation operators, together
with the grade-two, grade-minus-two, and mixed commutator channels that are
already forced by the CAR relations.
-/

noncomputable section
set_option autoImplicit false

namespace InfoGeometry.Clifford.Clifford55

def cl55LieGenerators : Set Cl55 :=
  Set.range creation55 ∪ Set.range annihilation55

def cl55LieGeneratedSubalgebra : LieSubalgebra ℝ Cl55 :=
  LieSubalgebra.lieSpan ℝ Cl55 cl55LieGenerators

@[simp] theorem creation55_mem_cl55LieGeneratedSubalgebra (i : Fin 5) :
    creation55 i ∈ cl55LieGeneratedSubalgebra := by
  exact LieSubalgebra.subset_lieSpan (Or.inl ⟨i, rfl⟩)

@[simp] theorem annihilation55_mem_cl55LieGeneratedSubalgebra (i : Fin 5) :
    annihilation55 i ∈ cl55LieGeneratedSubalgebra := by
  exact LieSubalgebra.subset_lieSpan (Or.inr ⟨i, rfl⟩)

theorem creation55_mul_creation55_mem_cl55LieGeneratedSubalgebra
    (i j : Fin 5) :
    creation55 i * creation55 j ∈ cl55LieGeneratedSubalgebra := by
  have h := cl55LieGeneratedSubalgebra.lie_mem
    (creation55_mem_cl55LieGeneratedSubalgebra i)
    (creation55_mem_cl55LieGeneratedSubalgebra j)
  change creation55 i * creation55 j - creation55 j * creation55 i ∈
    cl55LieGeneratedSubalgebra at h
  have hba : creation55 j * creation55 i =
      -(creation55 i * creation55 j) := by
    apply eq_neg_of_add_eq_zero_left
    simpa [add_comm] using creation55_anticommutator i j
  have hbr : creation55 i * creation55 j - creation55 j * creation55 i =
      (2 : ℝ) • (creation55 i * creation55 j) := by
    calc
      creation55 i * creation55 j - creation55 j * creation55 i =
          creation55 i * creation55 j + creation55 i * creation55 j := by
            rw [hba, sub_neg_eq_add]
      _ = (2 : ℝ) • (creation55 i * creation55 j) :=
        (two_smul ℝ (creation55 i * creation55 j)).symm
  rw [hbr] at h
  have hs := cl55LieGeneratedSubalgebra.smul_mem (1 / 2 : ℝ) h
  have hcancel : (1 / 2 : ℝ) * 2 = 1 := by norm_num
  rw [smul_smul, hcancel, one_smul] at hs
  exact hs

theorem annihilation55_mul_annihilation55_mem_cl55LieGeneratedSubalgebra
    (i j : Fin 5) :
    annihilation55 i * annihilation55 j ∈ cl55LieGeneratedSubalgebra := by
  have h := cl55LieGeneratedSubalgebra.lie_mem
    (annihilation55_mem_cl55LieGeneratedSubalgebra i)
    (annihilation55_mem_cl55LieGeneratedSubalgebra j)
  change annihilation55 i * annihilation55 j - annihilation55 j * annihilation55 i ∈
    cl55LieGeneratedSubalgebra at h
  have hba : annihilation55 j * annihilation55 i =
      -(annihilation55 i * annihilation55 j) := by
    apply eq_neg_of_add_eq_zero_left
    simpa [add_comm] using annihilation55_anticommutator i j
  have hbr : annihilation55 i * annihilation55 j - annihilation55 j * annihilation55 i =
      (2 : ℝ) • (annihilation55 i * annihilation55 j) := by
    calc
      annihilation55 i * annihilation55 j - annihilation55 j * annihilation55 i =
          annihilation55 i * annihilation55 j + annihilation55 i * annihilation55 j := by
            rw [hba, sub_neg_eq_add]
      _ = (2 : ℝ) • (annihilation55 i * annihilation55 j) :=
        (two_smul ℝ (annihilation55 i * annihilation55 j)).symm
  rw [hbr] at h
  have hs := cl55LieGeneratedSubalgebra.smul_mem (1 / 2 : ℝ) h
  have hcancel : (1 / 2 : ℝ) * 2 = 1 := by norm_num
  rw [smul_smul, hcancel, one_smul] at hs
  exact hs

theorem creation55_annihilation55_commutator_mem_cl55LieGeneratedSubalgebra
    (i j : Fin 5) :
    ⁅creation55 i, annihilation55 j⁆ ∈ cl55LieGeneratedSubalgebra :=
  cl55LieGeneratedSubalgebra.lie_mem
    (creation55_mem_cl55LieGeneratedSubalgebra i)
    (annihilation55_mem_cl55LieGeneratedSubalgebra j)

def spinCl55LieGenerators (g : Spin55) : Set Cl55 :=
  Set.range (fun i => spinCliffordRingEquiv g (creation55 i)) ∪
    Set.range (fun i => spinCliffordRingEquiv g (annihilation55 i))

def spinCl55LieGeneratedSubalgebra (g : Spin55) : LieSubalgebra ℝ Cl55 :=
  LieSubalgebra.lieSpan ℝ Cl55 (spinCl55LieGenerators g)

theorem spin_creation55_mem_cl55LieGeneratedSubalgebra
    (g : Spin55) (i : Fin 5) :
    spinCliffordRingEquiv g (creation55 i) ∈
      spinCl55LieGeneratedSubalgebra g := by
  exact LieSubalgebra.subset_lieSpan (Or.inl ⟨i, rfl⟩)

theorem spin_annihilation55_mem_cl55LieGeneratedSubalgebra
    (g : Spin55) (i : Fin 5) :
    spinCliffordRingEquiv g (annihilation55 i) ∈
      spinCl55LieGeneratedSubalgebra g := by
  exact LieSubalgebra.subset_lieSpan (Or.inr ⟨i, rfl⟩)

theorem spinCliffordRingEquiv_lieBracket
    (g : Spin55) (x y : Cl55) :
    spinCliffordRingEquiv g ⁅x, y⁆ =
      ⁅spinCliffordRingEquiv g x, spinCliffordRingEquiv g y⁆ := by
  simpa only [LieRing.of_associative_ring_bracket, map_sub, map_mul]

theorem spinCliffordRingEquiv_mem_spinCl55LieGeneratedSubalgebra
    (g : Spin55) {x : Cl55}
    (hx : x ∈ cl55LieGeneratedSubalgebra) :
    spinCliffordRingEquiv g x ∈ spinCl55LieGeneratedSubalgebra g := by
  change x ∈ LieSubalgebra.lieSpan ℝ Cl55 cl55LieGenerators at hx
  induction hx using LieSubalgebra.lieSpan_induction with
  | mem x hx =>
      rcases hx with hx | hx
      · rcases hx with ⟨i, rfl⟩
        exact spin_creation55_mem_cl55LieGeneratedSubalgebra g i
      · rcases hx with ⟨i, rfl⟩
        exact spin_annihilation55_mem_cl55LieGeneratedSubalgebra g i
  | zero =>
      simp
  | add x y hx hy ihx ihy =>
      simpa only [map_add] using
        (spinCl55LieGeneratedSubalgebra g).add_mem ihx ihy
  | smul a x hx ihx =>
      change ChiralLorentzCARLift.unitConjugation (spinGroup.toUnits g) (a • x) ∈
        spinCl55LieGeneratedSubalgebra g
      rw [ChiralLorentzCARLift.unitConjugation_smul]
      exact (spinCl55LieGeneratedSubalgebra g).smul_mem a ihx
  | lie x y hx hy ihx ihy =>
      rw [spinCliffordRingEquiv_lieBracket]
      exact (spinCl55LieGeneratedSubalgebra g).lie_mem ihx ihy

end InfoGeometry.Clifford.Clifford55
