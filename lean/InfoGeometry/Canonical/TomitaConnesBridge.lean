import InfoGeometry.Canonical.TomitaKreinNilpotentAtom
import InfoGeometry.Volume.ConnesTomitaKreinBridge

/-!
# InfoGeometry.Canonical.TomitaConnesBridge

Canonical re-export of the finite Tomita/Krein readout of the constructive
Connes infinitesimal layer.

This file intentionally does not construct a current algebra.  It only exposes
the finite identification

```text
[ε, A] = 2 [P₊, A]
```

and the finite idempotent exponential representative

```text
exp(t ε) = exp(t) P₊ + exp(-t) P₋.
```

The finite doubled-real atom remains in `TomitaKreinNilpotentAtom`; the
Connes/Radon-Nikodym infinitesimal layer remains in `Volume.ConnesInfinitesimal`.
-/

namespace InfoGeometry.Canonical.TomitaConnesBridge

open InfoGeometry.Clifford.SplitQ11PhaseFlip
open InfoGeometry.Clifford.SplitQ11Projectors
open InfoGeometry.Canonical.KreinProjectorLattice

/-! ## Finite modular/Krein commutator readout -/

/-- Finite split-`Cl(1,1)` modular derivation generated by the Krein sign `ε`. -/
@[rep_depth krein]
noncomputable abbrev finiteKreinModularDerivation (A : Alg) : Alg :=
  InfoGeometry.Volume.ConnesTomitaKreinBridge.finiteKreinModularDerivation A

/-- Finite sector-leakage commutator with the positive Krein projector. -/
@[rep_depth krein]
noncomputable abbrev finiteKreinPositiveProjectorCommutator (A : Alg) : Alg :=
  InfoGeometry.Volume.ConnesTomitaKreinBridge.finiteKreinPositiveProjectorCommutator A

/--
Canonical finite bridge theorem:
`[ε, A] = 2 [P₊, A]`, where `P₊ = (1 + ε) / 2`.
-/
@[rep_depth krein]
theorem finiteKrein_projector_commutator_as_modular_derivation (A : Alg) :
    finiteKreinModularDerivation A =
      (2 : ℝ) • finiteKreinPositiveProjectorCommutator A :=
  InfoGeometry.Volume.ConnesTomitaKreinBridge.finiteKrein_projector_commutator_as_modular_derivation A

/-- The finite modular generator is the Krein involution recovered from the lattice. -/
@[rep_depth krein]
theorem finiteKreinModularGenerator_eq_latticeInvolution :
    epsGen = KreinSector.kreinInvolution :=
  InfoGeometry.Volume.ConnesTomitaKreinBridge.finiteKreinModularGenerator_eq_latticeInvolution

/--
Same canonical bridge theorem using the lattice-recovered Krein involution.
-/
@[rep_depth krein]
theorem finiteKrein_lattice_projector_commutator_as_modular_derivation (A : Alg) :
    KreinSector.kreinInvolution * A - A * KreinSector.kreinInvolution =
      (2 : ℝ) • finiteKreinPositiveProjectorCommutator A :=
  InfoGeometry.Volume.ConnesTomitaKreinBridge.finiteKrein_lattice_projector_commutator_as_modular_derivation A

/-! ## Finite idempotent exponential readout -/

/--
Finite idempotent expansion of the exponential generated by the Krein sign:
`exp(t ε) = exp(t) P₊ + exp(-t) P₋`.
-/
@[rep_depth krein]
noncomputable abbrev finiteKreinIdempotentExponential (t : ℝ) : Alg :=
  InfoGeometry.Volume.ConnesTomitaKreinBridge.finiteKreinIdempotentExponential t

/-- Readback of the finite projector formula for `exp(t ε)`. -/
@[rep_depth krein]
theorem finiteKrein_idempotent_exponential_formula (t : ℝ) :
    finiteKreinIdempotentExponential t =
      Real.exp t • epsPlusProjector + Real.exp (-t) • epsMinusProjector :=
  InfoGeometry.Volume.ConnesTomitaKreinBridge.finiteKrein_idempotent_exponential_formula t

/-- The finite idempotent exponential is the identity at zero modular time. -/
@[rep_depth krein]
theorem finiteKrein_idempotent_exponential_zero :
    finiteKreinIdempotentExponential 0 = (1 : Alg) :=
  InfoGeometry.Volume.ConnesTomitaKreinBridge.finiteKrein_idempotent_exponential_zero

/-- Orthogonal idempotents make the finite exponential multiplicative in time. -/
@[rep_depth krein]
theorem finiteKrein_idempotent_exponential_add (s t : ℝ) :
    finiteKreinIdempotentExponential (s + t) =
      finiteKreinIdempotentExponential s * finiteKreinIdempotentExponential t :=
  InfoGeometry.Volume.ConnesTomitaKreinBridge.finiteKrein_idempotent_exponential_add s t

end InfoGeometry.Canonical.TomitaConnesBridge
