import InfoGeometry.Krein.DoubledRootLemmas
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Clifford.Hestenes
import InfoGeometry.Clifford.GeometricRotor

/-!
# Real doubled Hestenes anchor

This module exposes the repo's real-doubled translation of complex/Hestenes
structure.  It proves only facts already rooted in `DoubledSpace`, `Hestenes`,
and `GeometricRotor`.
-/

namespace InfoGeometry.Clifford.RealDoubledHestenesAnchor

open InfoGeometry.Krein

variable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => InfoGeometry.Krein.DoubledSpace E

/-- The real doubled phase axis `I = Jε` is a Hestenes bivector: `I² = -1`. -/
@[rep_depth krein]
noncomputable def doubledIBivector : InfoGeometry.Clifford.Bivector E where
  op := InfoGeometry.Krein.doubledI (E := E)
  square_neg := InfoGeometry.Krein.doubledI_sq (E := E)

/-- The rotor generated by the doubled phase axis has inverse given by reverse. -/
@[rep_depth krein]
theorem doubledI_rotor_exp_reverse (θ : ℝ) :
    (InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ).exp.comp
        ((InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ).reverse) =
      ContinuousLinearMap.id ℝ H₂ :=
  InfoGeometry.Clifford.Rotor.exp_reverse
    (InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ)

/-- The reverse of the doubled phase-axis rotor is also a left inverse. -/
@[rep_depth krein]
theorem doubledI_rotor_reverse_comp_exp (θ : ℝ) :
    (InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ).reverse.comp
        ((InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ).exp) =
      ContinuousLinearMap.id ℝ H₂ :=
  InfoGeometry.Clifford.Rotor.reverse_comp_exp
    (InfoGeometry.Clifford.Rotor.modularFlow (E := E) doubledIBivector θ)

/-- Hestenes `Cl(1,1)` pseudoscalar representation is the doubled spectral involution. -/
@[rep_depth krein]
theorem hestenes_pseudoscalar_rep_eq_doubledEpsilon :
    _root_.cl11Rep (E := E) InfoGeometry.Clifford.Hestenes.Pseudoscalar =
      InfoGeometry.Krein.doubledEpsilon (E := E) := by
  simpa [InfoGeometry.Krein.doubledEpsilon] using
    InfoGeometry.Clifford.Hestenes.cl11Rep_pseudoscalar_eq_spectral_epsilon (E := E)

/-- The represented Hestenes pseudoscalar squares to identity on the doubled carrier. -/
@[rep_depth krein]
theorem hestenes_pseudoscalar_rep_sq :
    (_root_.cl11Rep (E := E) InfoGeometry.Clifford.Hestenes.Pseudoscalar).comp
        (_root_.cl11Rep (E := E) InfoGeometry.Clifford.Hestenes.Pseudoscalar) =
      ContinuousLinearMap.id ℝ H₂ :=
  InfoGeometry.Clifford.Hestenes.cl11Rep_pseudoscalar_comp_self (E := E)

end InfoGeometry.Clifford.RealDoubledHestenesAnchor
