/-!
# The Prima Materia: Information Geometry of the Primordial Spinor

This file formalizes the physics of the primordial spinor as an entropy gradient
flow across an information geometry, bridging Dirac quantum mechanics with the
Jordan-Kinderlehrer-Otto (JKO) statistical mechanics scheme.
-/

/- 1. The Spinor Bundle & Measure Substrate -/

/-- The space of primordial spinors on a metric space M. -/
structure PrimordialSpinor (M : Type) where
  psi : M → ℂ

/-- Probability density distribution: ρ(x) = ψ*(x) ψ(x) -/
def probability_density {M : Type} (s : PrimordialSpinor M) (x : M) : ℝ :=
  Complex.normSq (s.psi x)

lemma probability_density_nonneg {M : Type} (s : PrimordialSpinor M) (x : M) :
    0 ≤ probability_density s x := by
  simpa [probability_density] using Complex.normSq_nonneg _

/- 2. Information Geometry & The Wasserstein Metric -/

/-- A coupling between two probability distributions ρ1 and ρ2. -/
def IsCoupling {M : Type} [MeasureSpace M] (gamma : M → M → ℝ) (rho1 rho2 : M → ℝ) : Prop :=
  (∀ x, (∫ y, gamma x y) = rho1 x) ∧ (∀ y, (∫ x, gamma x y) = rho2 y) ∧ (∀ x y, 0 ≤ gamma x y)

/-- Wasserstein-2 metric for probability distributions. -/
def Wasserstein2 {M : Type} [MetricSpace M] [MeasureSpace M] (rho1 rho2 : M → ℝ) : ℝ :=
  sInf { cost | ∃ gamma, IsCoupling gamma rho1 rho2 ∧ cost = ∫ x, ∫ y, gamma x y * (dist x y)^2 }

/- 3. The Non-Commutative Modular Entropy (Tomita-Takesaki) -/

/-- The Boltzmann Modular Entropy Operator K, where the modular operator is Δ = e^{-K}.
    Time evolution is entirely generated by derivation with K. -/
structure ModularEntropyOperator (M : Type) where
  K_op : (M → ℂ) → (M → ℂ)

/-- The Shannon entropy is not fundamental; it is merely the expectation value 
    of the non-commutative Boltzmann operator: S = ⟨ψ | K | ψ⟩. -/
def ShannonExpectationEntropy {M : Type} [MeasureSpace M] 
    (K : ModularEntropyOperator M) (s : PrimordialSpinor M) : ℂ :=
  ∫ x, starRingEnd ℂ (s.psi x) * (K.K_op s.psi x)

/-- The Classical Shannon-Boltzmann Entropy functional (for macroscopic JKO limit). -/
def ClassicalShannonEntropy {M : Type} [MeasureSpace M] (rho : M → ℝ) : ℝ :=
  ∫ x, rho x * Real.log (rho x)

/-- The JKO Functional combining Wasserstein distance and Classical Entropy. -/
def JKO_Functional {M : Type} [MetricSpace M] [MeasureSpace M]
    (tau : ℝ) (rho_n rho : M → ℝ) : ℝ :=
  (1 / (2 * tau)) * (Wasserstein2 rho_n rho)^2 + ClassicalShannonEntropy rho

/-- Property that the density evolves via JKO gradient flow. 
    In the full theory, this macroscopic flow is driven purely by 
    the non-commutative modular Hamiltonian K. -/
def IsEntropyGradientFlow {M : Type} [MetricSpace M] [MeasureSpace M] (rho : ℝ → M → ℝ) : Prop :=
  ∀ ⦃t tau⦄, 0 < tau → 
    JKO_Functional tau (rho t) (rho (t + tau)) = 
      sInf { JKO_Functional tau (rho t) rho_new | rho_new : M → ℝ }

/- 4. The Pre-Existing Synthesis (The Alchemy) -/

