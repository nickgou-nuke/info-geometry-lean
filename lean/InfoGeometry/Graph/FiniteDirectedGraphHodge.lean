/-- Every real edge weighting on the transcribed archive cycle splits into
an exact potential difference and its orthogonal cycle component. The
coefficient is the cycle pairing divided by its squared norm, four. -/
theorem archiveCycle_hodge_decomposition (weight : Fin 4 → ℝ) :
    ∃ potential : Fin 4 → ℝ,
      weight = fun edge =>
        (incidenceTranspose archiveCycleSource archiveCycleTarget).mulVec
          potential edge +
          (dotProduct archiveCycleFlow weight / 4) * archiveCycleFlow edge := by
  let coefficient : ℝ := dotProduct archiveCycleFlow weight / 4
  let residual : Fin 4 → ℝ := fun edge =>
    weight edge - coefficient * archiveCycleFlow edge
  have hResidualPairing : dotProduct archiveCycleFlow residual = 0 := by
    rw [archiveCycle_pairing_eq_pathDifference]
    simp [residual, coefficient, archiveCycleFlow,
      archiveCycle_pairing_eq_pathDifference]
    ring_nf
  obtain ⟨potential, hPotential⟩ :=
    (archiveCycle_edgeWeight_exact_iff_cyclePairing_zero residual).mpr
      hResidualPairing
  refine ⟨potential, ?_⟩
  funext edge
  rw [incidenceTranspose_mulVec_apply]
  have h := hPotential edge
  dsimp [residual] at h
  change weight edge =
    potential (archiveCycleTarget edge) -
      potential (archiveCycleSource edge) +
        coefficient * archiveCycleFlow edge
  linarith

/-- In any decomposition into an exact part and the archived cycle, the
cycle coefficient is forced by pairing with the cycle and dividing by four. -/
theorem archiveCycle_hodge_cycleCoefficient_unique
    (weight : Fin 4 → ℝ) (potential : Fin 4 → ℝ) (coefficient : ℝ)
    (hDecomposition :
      weight = fun edge =>
        (incidenceTranspose archiveCycleSource archiveCycleTarget).mulVec
          potential edge + coefficient * archiveCycleFlow edge) :
    coefficient = dotProduct archiveCycleFlow weight / 4 := by
  have h0 := congrFun hDecomposition 0
  have h1 := congrFun hDecomposition 1
  have h2 := congrFun hDecomposition 2
  have h3 := congrFun hDecomposition 3
  have hPairing : dotProduct archiveCycleFlow weight = 4 * coefficient := by
    rw [archiveCycle_pairing_eq_pathDifference, h0, h1, h2, h3]
    simp [incidenceTranspose_mulVec_apply, archiveCycleSource,
      archiveCycleTarget, archiveCycleFlow]
    ring
  calc
    coefficient = (4 * coefficient) / 4 := by ring
    _ = dotProduct archiveCycleFlow weight / 4 := by rw [← hPairing]

/-- Orthogonal projection of an edge weighting onto the line spanned by the
archived signed cycle. -/
noncomputable def archiveCycleProjection (weight : Fin 4 → ℝ) : Fin 4 → ℝ :=
  fun edge =>
    (dotProduct archiveCycleFlow weight / 4) * archiveCycleFlow edge

/-- Pairing with the archived cycle is unchanged by its orthogonal
projection, since the cycle has squared norm four. -/
theorem archiveCycleProjection_pairing (weight : Fin 4 → ℝ) :
    dotProduct archiveCycleFlow (archiveCycleProjection weight) =
      dotProduct archiveCycleFlow weight := by
  rw [archiveCycle_pairing_eq_pathDifference]
  simp [archiveCycleProjection, archiveCycleFlow]
  ring

/-- The archive-cycle projection is idempotent. -/
theorem archiveCycleProjection_idempotent (weight : Fin 4 → ℝ) :
    archiveCycleProjection (archiveCycleProjection weight) =
      archiveCycleProjection weight := by
  funext edge
  change (dotProduct archiveCycleFlow (archiveCycleProjection weight) / 4) *
      archiveCycleFlow edge =
    (dotProduct archiveCycleFlow weight / 4) * archiveCycleFlow edge
  rw [archiveCycleProjection_pairing]

/-- The cycle projection fixes every scalar multiple of its generating flow. -/
theorem archiveCycleProjection_fixes_cycle_multiple (c : ℝ) :
    archiveCycleProjection (fun edge => c * archiveCycleFlow edge) =
      fun edge => c * archiveCycleFlow edge := by
  have hPairing :
      dotProduct archiveCycleFlow (fun edge => c * archiveCycleFlow edge) =
        4 * c := by
    rw [archiveCycle_pairing_eq_pathDifference]
    simp [archiveCycleFlow]
    ring
  funext edge
  change (dotProduct archiveCycleFlow
      (fun edge => c * archiveCycleFlow edge) / 4) *
        archiveCycleFlow edge = c * archiveCycleFlow edge
  rw [hPairing]
  ring

/-- The cycle projection kills every exact cochain (a vertex-potential
difference), so its kernel contains the incidence-transpose image. -/
theorem archiveCycleProjection_kills_exact
    (potential : Fin 4 → ℝ) :
    archiveCycleProjection
      ((incidenceTranspose archiveCycleSource archiveCycleTarget).mulVec potential) =
        0 := by
