namespace InfoGeometry.Quantum.ArakiBregmanKMS

/-! ## 1. Tensor Product Factorization: Base Shifts Commute with Fiber Phase Rotations -/

variable {α : Type*} [CommSemiring α]
variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]

/-- 🏆 THEOREM: General Kronecker Commutation Identity.
For any operators $A$ on the base space and $B$ on the fiber space,
the lifted operators $A \otimes I$ and $I \otimes B$ strictly commute. -/
theorem kronecker_base_fiber_comm (A : Matrix m m α) (B : Matrix n n α) :
    (A ⊗ₖ (1 : Matrix n n α)) * ((1 : Matrix m m α) ⊗ₖ B) =
    ((1 : Matrix m m α) ⊗ₖ B) * (A ⊗ₖ (1 : Matrix n n α)) := by
  have h1 : (A ⊗ₖ (1 : Matrix n n α)) * ((1 : Matrix m m α) ⊗ₖ B) = (A * 1) ⊗ₖ (1 * B) := by
    rw [← mul_kronecker_mul]
  have h2 : ((1 : Matrix m m α) ⊗ₖ B) * (A ⊗ₖ (1 : Matrix n n α)) = (1 * A) ⊗ₖ (B * 1) := by
    rw [← mul_kronecker_mul]
  rw [h1, h2, Matrix.mul_one, Matrix.one_mul, Matrix.one_mul, Matrix.mul_one]

/-- Concrete 2-state Cuntz Left shift on the base tree level. -/
def S_L_base : Matrix (Fin 2) (Fin 2) ℝ :=
  ![![0, 1], ![0, 0]]

/-- Concrete internal phase axis $K = J \varepsilon$ on the spinor fiber. -/
def K_fiber : Matrix (Fin 2) (Fin 2) ℝ :=
  ![![0, -1], ![1, 0]]

/-- Lifted Cuntz Left shift acting on the composite Hilbert space $\mathcal{H}_{\text{base}} \otimes \mathcal{H}_{\text{fiber}}$. -/
def S_L_total : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℝ :=
  S_L_base ⊗ₖ (1 : Matrix (Fin 2) (Fin 2) ℝ)

/-- Lifted internal phase axis $K$ acting on the composite Hilbert space $\mathcal{H}_{\text{base}} \otimes \mathcal{H}_{\text{fiber}}$. -/
def K_total : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℝ :=
  (1 : Matrix (Fin 2) (Fin 2) ℝ) ⊗ₖ K_fiber

/-- 🏆 THEOREM: The concrete path-space Cuntz shift strictly commutes with the canonical phase axis $K$:
$$(S_{\text{left}} \otimes I) (I \otimes K) = (I \otimes K) (S_{\text{left}} \otimes I)$$ -/
theorem cantor_S_left_commutes_fiber_K :
    S_L_total * K_total = K_total * S_L_total :=
  kronecker_base_fiber_comm S_L_base K_fiber

/-! ## 2. Araki Relative Entropy & Bregman Divergence for the KMS Flow -/

/-- The scalar Bregman divergence generated by the exponential potential: $d_{\text{Bregman}}(x) = e^x - 1 - x$. -/
def bregman_div (x : ℝ) : ℝ :=
  exp x - 1 - x

/-- 🏆 THEOREM: The Bregman divergence is strictly non-negative: $e^x - 1 - x \ge 0$. -/
theorem bregman_div_nonneg (x : ℝ) :
    0 ≤ bregman_div x := by
  dsimp [bregman_div]
  have h := add_one_le_exp x
  linarith

/-- 🏆 THEOREM: At the flat KMS boundary ($x = 0 \iff \Delta = I$), the relative entropy strictly vanishes. -/
theorem bregman_div_zero :
    bregman_div 0 = 0 := by
  dsimp [bregman_div]
  simp

/-- Single-mode 2×2 modular operator $\Delta(\beta, \omega) = \operatorname{diag}(1, e^{-\beta\omega})$. -/
def delta_matrix (β ω : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  ![![1, 0], ![0, exp (- (β * ω))]]

/-- Single-mode 2×2 modular Hamiltonian $\log \Delta(\beta, \omega) = \operatorname{diag}(0, -\beta\omega)$. -/
def log_delta_matrix (β ω : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  ![![0, 0], ![0, - (β * ω)]]

/-- Operatorial Araki vacuum shape deformation: $D_{\text{Araki}} = \Delta - I - \log \Delta$. -/
def araki_shape_deformation (β ω : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  delta_matrix β ω - (1 : Matrix (Fin 2) (Fin 2) ℝ) - log_delta_matrix β ω

/-- 🏆 THEOREM: The Araki deformation on the diagonal corresponds directly to the scalar Bregman divergence. -/
theorem araki_shape_deformation_diagonal (β ω : ℝ) :
    araki_shape_deformation β ω = ![![0, 0], ![0, bregman_div (- (β * ω))]] := by
  ext i j; fin_cases i <;> fin_cases j <;>
  { dsimp [araki_shape_deformation, delta_matrix, log_delta_matrix, bregman_div]; simp }

/-- 🏆 THEOREM: At the flat boundary ($\beta = 0$), the operatorial Araki shape deformation vanishes identically:
$$D_{\text{Araki}}(0, \omega) = 0$$ -/
theorem araki_shape_deformation_vanishes_at_flat_boundary (ω : ℝ) :
    araki_shape_deformation 0 ω = 0 := by
  rw [araki_shape_deformation_diagonal]
  have h_zero : - (0 * ω) = 0 := by ring
  rw [h_zero, bregman_div_zero]
  ext i j; fin_cases i <;> fin_cases j <;>
  { simp }

/--
🏆 **GRAND CAPSTONE MASTER THEOREM: Full Synthesis of Tensor Commutation & KMS Dissipation**
-/
theorem grand_araki_bregman_kms_synthesis
    (x : ℝ)
    (ω : ℝ) :
    (S_L_total * K_total = K_total * S_L_total) ∧
    (0 ≤ bregman_div x) ∧
    (bregman_div 0 = 0) ∧
    (araki_shape_deformation 0 ω = 0) :=
  ⟨cantor_S_left_commutes_fiber_K,
   bregman_div_nonneg x,
   bregman_div_zero,
   araki_shape_deformation_vanishes_at_flat_boundary ω⟩

end InfoGeometry.Quantum.ArakiBregmanKMS
