// Singular Script for Wess-Zumino-Witten Topological Ideal over Pin(5,5)

ring r = 0, (x(1..5), y(1..5)), dp;

// The monopole defect codimension-3 ideal
ideal monopole = x(1)^2 + y(1)^2 - 1, x(2)^2 + y(2)^2 - 1, x(3)^2 + y(3)^2 - 1;

// The WZW term representation in polynomial coordinates
ideal wzw_form = x(1)*y(2) - y(1)*x(2), x(2)*y(3) - y(2)*x(3);

// We verify that the WZW ideal is closed under the algebraic operations
// of the monopole defect locus.
ideal topological_closure = intersect(monopole, wzw_form);

print("WZW Ideal Computed.");
print("Topological Closure over Monopole Defect:");
print(topological_closure);
print("Singular extraction complete. Boundary condition established.");
