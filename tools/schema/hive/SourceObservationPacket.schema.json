{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SourceObservationPacket.schema.json",
  "title": "SourceObservationPacket",
  "allOf": [
    {
      "$ref": "common_envelope.schema.json"
    },
    {
      "$ref": "authority.schema.json"
    },
    {
      "$ref": "cognitive_metadata.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "authority",
        "epistemic_layer",
        "authority_origin",
        "cognitive_function",
        "promotion_allowed",
        "source_type",
        "source_uri",
        "capture_method",
        "content_hash",
        "summary",
        "allowed_uses",
        "forbidden_uses"
      ],
      "properties": {
        "kind": {
          "const": "SourceObservationPacket"
        },
        "status": {
          "enum": [
            "draft",
            "captured",
            "indexed",
            "superseded",
            "archived"
          ]
        },
        "authority": {
          "const": "navigation"
        },
        "epistemic_layer": {
          "const": "raw_source"
        },
        "authority_origin": {
          "const": "source_observation"
        },
        "cognitive_function": {
          "const": "sensation"
        },
        "jung_function": {
          "const": "sensation"
        },
        "promotion_allowed": {
          "const": false
        },
        "source_type": {
          "type": "string",
          "enum": [
            "google_ai_mode",
            "arxiv",
            "paper",
            "pdf",
            "web",
            "repo_file",
            "lean_declaration",
            "old_doc",
            "black_book",
            "operator_prompt",
            "browser_capture",
            "other"
          ]
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "capture_method": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        },
        "quote_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": true
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "allowed_uses": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "source_grounding"
          },
          "items": {
            "type": "string"
          }
        },
        "forbidden_uses": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "proof"
          },
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
