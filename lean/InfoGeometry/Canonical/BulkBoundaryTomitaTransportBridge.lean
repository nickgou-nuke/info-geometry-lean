import InfoGeometry.Canonical.BulkBoundaryZeroModeOwner
import InfoGeometry.Canonical.BogoliubovTransport
import InfoGeometry.Canonical.RealTomitaCore
import InfoGeometry.Canonical.StandardFormCore
import InfoGeometry.Canonical.WedgeBoostModularBridge
import InfoGeometry.Dynamics.UnruhKMS
import InfoGeometry.Meta.Architecture

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.BulkBoundaryTomitaTransportBridge

Operator-first bridge between the real Tomita modular transport lane and the
dimension-agnostic bulk-boundary zero-mode owner lane.

This file does not claim a full holographic reconstruction theorem. It records
the honest transport statement currently supported by the repo:

- a boundary-localized zero-mode owner on the doubled real carrier,
- a real modular-log packet providing the transport flow,
- an explicit realization of that flow by parity-even Bogoliubov transforms,
- and the induced persistence of the zero mode under modular transport.
-/

namespace InfoGeometry.Canonical.BulkBoundaryTomitaTransportBridge

open InfoGeometry.Krein
open InfoGeometry.Canonical.StandardFormCore
open InfoGeometry.Canonical.RealTomitaCore
open InfoGeometry.Canonical.BulkBoundaryZeroModeOwner
open InfoGeometry.Quantum.BulkBoundary
open InfoGeometry.Quantum.KitaevChain
open InfoGeometry.Quantum.RealMajorana
open InfoGeometry.Canonical.WedgeBoostModularBridge

section Core

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

/--
Canonical operator bridge joining:

- a standard-form carrier,
- a real modular-log transport packet,
- a Majorana/chirality bulk-boundary owner,
- and a Bogoliubov realization of the modular flow.
-/
@[rep_depth operator]
structure ModularBulkBoundaryBridge where
  carrier : StandardFormCarrier E
  logData : RealModularLogData (E := E)
  delta_agrees : carrier.Delta = logData.Delta
  majorana : RealMajoranaDatum (S := H₂)
  localOp : KitaevCell → EndH
  chain : List KitaevCell
  owner :
    DimensionAgnosticBoundaryZeroModeOwner
      (S := H₂) majorana majorana.chiralityPolarization localOp chain
  transport : ℝ → RealBogoliubovTransform (S := H₂) majorana
  transport_eq_flow : ∀ t : ℝ, (transport t).B = logData.flow t
  transport_eq_inverseFlow : ∀ t : ℝ, (transport t).Binv = logData.flow (-t)
  transport_preserves_chirality :
    ∀ t : ℝ, (transport t).preservesPolarization majorana.chiralityPolarization

namespace ModularBulkBoundaryBridge

variable (B : ModularBulkBoundaryBridge (E := E))

/-- The standard-form carrier flow is generated by the same `Δ` as the real-log packet. -/
@[rep_depth operator]
theorem carrier_modularFlow_eq_logData_generator :
    B.carrier.seed.modularFlow
      = InfoGeometry.Volume.ConnesCocycle.additiveModularFlowOfGenerator
          (H := E) B.logData.Delta := by
  simpa [B.delta_agrees] using B.carrier.modularFlow_eq_generator

/-- The owned open-chain operator before modular transport. -/
@[rep_depth operator]
noncomputable def ownedOperator : EndH :=
  globalChainOperatorFromOpenChain (S := H₂) B.localOp B.chain

/-- The modular/Bogoliubov transported open-chain operator. -/
@[rep_depth operator]
noncomputable def transportedOperator (t : ℝ) : EndH :=
  (B.transport t).B.comp (B.ownedOperator.comp (B.transport t).Binv)

/-- The owner packet immediately yields the boundary-localized pair predicate. -/
@[rep_depth krein]
theorem owner_boundaryPair :
    BoundaryLocalizedZeroModePair
      (M := B.majorana) (P0 := B.majorana.chiralityPolarization) B.localOp B.chain := by
  rcases B.owner.boundaryWitness with
    ⟨ψplus, ψminus, hψplusNe, hψminusNe, hψplusMem, hψminusMem,
      hψplusZero, hψminusZero⟩
  exact ⟨ψplus, ψminus, hψplusNe, hψminusNe, hψplusMem, hψminusMem,
    hψplusZero, hψminusZero⟩

/-- The untransported owner already certifies a genuine operator zero mode. -/
@[rep_depth operator]
theorem owner_hasZeroMode :
    HasZeroMode (S := H₂) B.ownedOperator := by
  simpa [ModularBulkBoundaryBridge.ownedOperator] using
    InfoGeometry.Canonical.BulkBoundaryZeroModeOwner.owner_hasZeroMode B.owner

/-- The untransported owner already exports an explicit nonzero zero-mode vector. -/
@[rep_depth operator]
theorem owner_exists_zeroMode :
    ∃ v : H₂, B.ownedOperator v = 0 ∧ v ≠ 0 := by
  simpa [ModularBulkBoundaryBridge.ownedOperator] using
    InfoGeometry.Canonical.BulkBoundaryZeroModeOwner.owner_exists_zeroMode B.owner

/-- Any Bogoliubov realization of the modular flow preserves the owned zero mode. -/
@[rep_depth operator]
theorem transported_hasZeroMode (t : ℝ) :
    HasZeroMode (S := H₂) (B.transportedOperator t) := by
  exact hasZeroMode_conjugate_of_hasZeroMode
    (M := B.majorana)
    (T := B.transport t)
    (H := B.ownedOperator)
    B.owner_hasZeroMode

/-- Explicit witness form of modularly transported zero-mode persistence. -/
@[rep_depth operator]
theorem transported_exists_zeroMode (t : ℝ) :
    ∃ v : H₂, (B.transportedOperator t) v = 0 ∧ v ≠ 0 := by
  exact exists_zeroMode_of_hasZeroMode_conjugate
    (M := B.majorana)
    (T := B.transport t)
    (H := B.ownedOperator)
    B.owner_hasZeroMode

/-- The transported operator is exactly the real modular flow conjugation of the owner. -/
@[rep_depth operator]
theorem transportedOperator_eq_flow_conjugate (t : ℝ) :
    B.transportedOperator t
      = (B.logData.flow t).comp (B.ownedOperator.comp (B.logData.flow (-t))) := by
  unfold transportedOperator
  rw [B.transport_eq_flow t, B.transport_eq_inverseFlow t]

/--
If the real modular transport generator commutes with the doubled Krein sign,
then the implemented transport commutes with that sign at every modular time.
-/
@[rep_depth transport]
theorem transport_commutes_modularSign_of_commute_generator
    (hCommSign :
      Commute
        (InfoGeometry.Canonical.TomitaTakesaki.modularSignEpsilon (E := E))
        (InfoGeometry.Canonical.BogoliubovTransport.modularTransportGenerator
          (E := E) B.logData.deltaLog))
    (t : ℝ) :
    (InfoGeometry.Canonical.TomitaTakesaki.modularSignEpsilon (E := E)).comp
        ((B.transport t).B)
      =
    ((B.transport t).B).comp
        (InfoGeometry.Canonical.TomitaTakesaki.modularSignEpsilon (E := E)) := by
  rw [B.transport_eq_flow t]
  simpa [RealModularLogData.flow] using
    InfoGeometry.Canonical.BogoliubovTransport.modularSignEpsilon_comp_modularTransportFlow_eq_modularTransportFlow_comp_modularSignEpsilon_of_commute_generator
        (E := E) B.logData.deltaLog hCommSign t

/--
Under explicit self-adjointness, phase-linearity, and sign-commutation
hypotheses, the implemented modular transport preserves the doubled Krein inner
product.
-/
@[rep_depth transport]
theorem transport_preserves_kreinInner_of_isSelfAdjoint_of_IsPhaseLinear_of_commute_modularSign
    (hSelf : IsSelfAdjoint B.logData.deltaLog)
    (hPhase :
      InfoGeometry.Canonical.BogoliubovTransport.IsPhaseLinear
        (E := E) B.logData.deltaLog)
    (hCommSign :
      Commute
        (InfoGeometry.Canonical.TomitaTakesaki.modularSignEpsilon (E := E))
        (InfoGeometry.Canonical.BogoliubovTransport.modularTransportGenerator
          (E := E) B.logData.deltaLog))
    (t : ℝ) (u v : H₂) :
    KreinSpace.kreinInner (H := H₂) ((B.transport t).B u) ((B.transport t).B v)
      =
    KreinSpace.kreinInner (H := H₂) u v := by
  rw [B.transport_eq_flow t]
  simpa [RealModularLogData.flow] using
    InfoGeometry.Canonical.BogoliubovTransport.modularTransportFlow_preserves_kreinInner_of_isSelfAdjoint_of_IsPhaseLinear_of_commute_modularSign
        (E := E) B.logData.deltaLog hSelf hPhase hCommSign t u v

/--
Wedge/boost reparameterization of the transported operator:
evaluating at the modular time extracted from a wedge boost parameter is the
same operator conjugation, expressed in the wedge-normalized clock.
-/
@[rep_depth transport]
theorem transportedOperator_eq_wedgeBoost_conjugate (τwedge : ℝ) :
    B.transportedOperator (modularTimeOfWedgeBoost τwedge)
      =
    (B.logData.flow (modularTimeOfWedgeBoost τwedge)).comp
      (B.ownedOperator.comp (B.logData.flow (-modularTimeOfWedgeBoost τwedge))) := by
  simpa using B.transportedOperator_eq_flow_conjugate (modularTimeOfWedgeBoost τwedge)

/--
The wedge/boost normalization is exact on the transported operator surface.
-/
@[rep_depth transport]
theorem transportedOperator_wedge_roundtrip (τmod : ℝ) :
    B.transportedOperator (modularTimeOfWedgeBoost (wedgeBoostParameter τmod))
      = B.transportedOperator τmod := by
  simp [modularTimeOfWedgeBoost_wedgeBoostParameter]

/--
Round-tripping through the wedge/boost clock leaves the conjugation formula
unchanged.
-/
@[rep_depth transport]
theorem transportedOperator_eq_wedge_roundtrip_conjugate (τmod : ℝ) :
    B.transportedOperator (modularTimeOfWedgeBoost (wedgeBoostParameter τmod))
      =
    (B.logData.flow τmod).comp (B.ownedOperator.comp (B.logData.flow (-τmod))) := by
  simpa [modularTimeOfWedgeBoost_wedgeBoostParameter] using
    B.transportedOperator_eq_wedgeBoost_conjugate (wedgeBoostParameter τmod)

/--
Chirality-specialized transport theorem:
the modularly transported owner still has nonzero Weyl plus/minus zero modes.
-/
@[rep_depth krein]
theorem transported_weylZeroModePair (t : ℝ) :
    ∃ ψplus ψminus : H₂,
      ψplus ≠ 0 ∧ ψminus ≠ 0
        ∧ ψplus ∈ B.majorana.weylPlus ∧ ψminus ∈ B.majorana.weylMinus
        ∧ (B.transportedOperator t) ψplus = 0
        ∧ (B.transportedOperator t) ψminus = 0 := by
  simpa [ModularBulkBoundaryBridge.transportedOperator, ModularBulkBoundaryBridge.ownedOperator]
    using
      weylZeroModePair_under_bogoliubov_of_preservesChiralityPolarization
        (M := B.majorana)
        (T := B.transport t)
        (hpres := B.transport_preserves_chirality t)
        (localOp := B.localOp)
        (chain := B.chain)
        B.owner_boundaryPair

end ModularBulkBoundaryBridge

end Core

end InfoGeometry.Canonical.BulkBoundaryTomitaTransportBridge
