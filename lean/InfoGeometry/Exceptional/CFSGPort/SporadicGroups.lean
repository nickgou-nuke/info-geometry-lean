/-- Exact right inverse of the first J₁ seed matrix over `𝔽₁₁`. -/
def J1SeedMatrix1Inv : Matrix (Fin 7) (Fin 7) (ZMod 11) :=
  !![0, 7, 9, 9, 10, 7, 9;
    7, 0, 1, 4, 3, 3, 4;
    9, 1, 2, 8, 3, 6, 2;
    9, 4, 8, 10, 1, 6, 0;
    10, 3, 3, 1, 8, 9, 1;
    7, 3, 6, 6, 9, 1, 3;
    9, 4, 2, 0, 1, 3, 0]

/-- Exact right inverse of the second J₁ seed matrix over `𝔽₁₁`. -/
def J1SeedMatrix2Inv : Matrix (Fin 7) (Fin 7) (ZMod 11) :=
  !![5, 10, 5, 2, 7, 3, 3;
    7, 4, 10, 3, 4, 9, 4;
    1, 10, 8, 3, 7, 0, 3;
    8, 0, 9, 6, 2, 4, 3;
    5, 3, 1, 1, 10, 2, 9;
    8, 3, 2, 2, 7, 3, 4;
    2, 8, 1, 9, 3, 5, 9]

theorem j1Seed1_det_ne_zero : J1SeedMatrix1.det ≠ 0 := by
  have hinv : J1SeedMatrix1 * J1SeedMatrix1Inv = 1 := by decide +kernel
  have hdet : J1SeedMatrix1.det * J1SeedMatrix1Inv.det = 1 := by
    rw [← Matrix.det_mul, hinv, Matrix.det_one]
  intro hz
  rw [hz, zero_mul] at hdet
  exact (by decide : (0 : ZMod 11) ≠ 1) hdet

theorem j1Seed2_det_ne_zero : J1SeedMatrix2.det ≠ 0 := by
  have hinv : J1SeedMatrix2 * J1SeedMatrix2Inv = 1 := by decide +kernel
  have hdet : J1SeedMatrix2.det * J1SeedMatrix2Inv.det = 1 := by
    rw [← Matrix.det_mul, hinv, Matrix.det_one]
  intro hz
  rw [hz, zero_mul] at hdet
  exact (by decide : (0 : ZMod 11) ≠ 1) hdet

/-- The local J₁ seed carrier identifies with the subgroup of `GL(7, 𝔽₁₁)`
generated by its two seed matrices. -/
noncomputable def j1GLSeedEquiv [Fact (Nat.Prime 11)] :
    J1 ≃* Subgroup.closure
      ({Matrix.GeneralLinearGroup.mkOfDetNeZero J1SeedMatrix1 j1Seed1_det_ne_zero,
        Matrix.GeneralLinearGroup.mkOfDetNeZero J1SeedMatrix2 j1Seed2_det_ne_zero} :
        Set (Matrix.GeneralLinearGroup (Fin 7) (ZMod 11))) := by
  exact matrixPairSeedEquiv J1SeedMatrix1 J1SeedMatrix2
    j1Seed1_det_ne_zero j1Seed2_det_ne_zero
