# ------- Cell 2: Clifford signature (2,2) conformal -------
# In [2]
# Define basis: e_1, e_2, e_+, e_-  (conformal split in 2D)
# Signature: (+, -, +, -) -- conformal on R^1,1
def _coords():
    x, y = symbols('x y', real=True)
    return x, y

def _conformal_basis():
    """
    Returns the 4 basis vectors of a 2D conformal algebra:
    e_1, e_2 null? No:
      e_1^2 = +1, e_2^2 = -1  (Minkowski)
      e_+^2 = 0,  e_-^2 = 0    (null generators)
      e_+ = (1/2)(e_0 + e_3), e_- = (1/2)(e_0 - e_3)
      compactified R^1,1 is conformally split.
    """
    # We encode as 4x4 matrix representation of the geometric product.
    from sympy import diag, eye
    Gamma = {}
    # Pauli-like representation (not fully faithful for Cl(2,2) but enough)
    # Cl(2,2) ~ Mat(2x2) Clifford map:
    sigma1 = Matrix([[0,1],[1,0]])
    sigma2 = Matrix([[0,R(-1)],[R(1),0]])
    sigma3 = Matrix([[1,0],[0,-1]])
    I2 = eye(2)
    Gamma[1] = sigma1
    Gamma[2] = -sigma1   # e2 dual to e1 in this demo
    # null generators as linear combo of sigma2 and sigma3
    Gamma['+'] = Matrix([[0,1],[1,0]]) + Matrix([[1,0],[0,-1]])   # e_+ ~ sigma1+sigma3
    Gamma['-'] = Matrix([[0,1],[1,0]]) - Matrix([[1,0],[0,-1]])   # e_- ~ sigma1-sigma3
    return Gamma

Gamma = _conformal_basis()
print("--- basis representation ---")
print(f"  e_1 geometric: {Gamma[1].tolist()}")
print(f"  e_2 geometric: {Gamma[2].tolist()}")
print(f"  e_+ geometric: {Gamma['+'].tolist()}")
print(f"  e_- geometric: {Gamma['-'].tolist()}")

# ------- Cell 3: Geometric product -------
# In [3]
def geometric(A, B):
    """Return the product A*B in the 2D Cl(2,2) rep."""
    return (A * B).applyfunc(lambda z: simplify(z))

# verify signs
