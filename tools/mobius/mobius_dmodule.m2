restart()
needsPackage "Dmodules"

R = QQ[z, Dz, WeylAlgebra => {z => Dz}]
use R

-- Hyperbolic Möbius packet: M = diag(2, 1/2)
-- Fixed point polynomial on the affine chart is
--   c z^2 + (d-a) z - b = -(3/2) z.
f = -(3/2) * z

assert substitute(f, {z => 0_R}) == 0_R

-- The D-module generated by the coordinate z has first-order annihilator Dz^2.
I = ideal(Dz^2)
r = holonomicRank(I)
assert(r == 2)

J = ideal(z * Dz - Dz * z + 1)
assert(gens gb J == matrix {{0_R}})

print "fixedPointPolynomial = -(3/2) z"
print concatenate("holonomicRank(Dz^2) = ", toString r)
print "weylCommutatorVerified = [Dz, z] = 1"
print "MOBIUS_M2_OK"
exit
