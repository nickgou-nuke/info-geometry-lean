import InfoGeometry.Canonical.HestenesClPlus14

/-!
# Native Clifford reverse/Krein conjugation

This owner records the intrinsic Clifford-side involution generated by the
fundamental even bivector `β = γ₁γ₀`.  Identification with the matrix Krein
adjoint is a later algebra-equivalence theorem.
-/

noncomputable section
namespace HestenesCliffordKrein

open HestenesCl14

abbrev Algebra := Cl14

def beta : Algebra := sigma 0

def reverseKrein (x : Algebra) : Algebra :=
  beta * CliffordAlgebra.reverse x * beta

@[simp] theorem beta_sq : beta * beta = (1 : Algebra) := by
  change sigma 0 * sigma 0 = (1 : Algebra)
  exact congrArg Subtype.val sigmaEven_zero_sq

@[simp] theorem reverse_beta : CliffordAlgebra.reverse beta = -beta := by
  change CliffordAlgebra.reverse (gamma 1 * gamma 0) =
    -(gamma 1 * gamma 0)
  simp only [CliffordAlgebra.reverse.map_mul]
  simpa [gamma] using
    (eq_neg_of_add_eq_zero_left (gamma_anticomm (i := 0) (j := 1) (by decide)))

@[simp] theorem reverseKrein_zero : reverseKrein (0 : Algebra) = 0 := by
  simp [reverseKrein]

@[simp] theorem reverseKrein_add (x y : Algebra) :
    reverseKrein (x + y) = reverseKrein x + reverseKrein y := by
  simp [reverseKrein, map_add, add_mul, mul_add]

@[simp] theorem reverseKrein_involutive (x : Algebra) :
    reverseKrein (reverseKrein x) = x := by
  unfold reverseKrein
  rw [CliffordAlgebra.reverse.map_mul, CliffordAlgebra.reverse.map_mul,
    reverse_beta]
  simp only [map_neg, CliffordAlgebra.reverse_reverse]
  simp only [mul_assoc, neg_mul, mul_neg]
  rw [← mul_assoc beta beta, beta_sq]
  simp

end HestenesCliffordKrein
end noncomputable section
