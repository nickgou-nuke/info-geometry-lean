import InfoGeometry.QuantumGeometry.Projective.QGT
import InfoGeometry.Analysis.MatrixTraceQuadratic
import InfoGeometry.Canonical.CramerRaoOnsagerCommutatorUncertainty
import InfoGeometry.Canonical.ConnesSpectralTripleBridge
import InfoGeometry.Canonical.ConnesNCSpectralMetricSupremum
import InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset
import InfoGeometry.OperatorAlgebra.PeirceSpine.CyclotomicGaloisNilpotentSylvesterSynthesis

/-!
# Nilpotent Directions and the State-Level QGT

For an operator `N`, its adjoint pair determines a self-adjoint bridge
`Φ = N + N†`, a skew-adjoint current `J = N - N†`, and the Cartan commutator
`H = [N,N†]`. The skew-adjoint directions `iΦ` and `J` have commutator
`-2iH`; therefore the projective Berry curvature evaluated on these
directions is the state expectation of that Cartan commutator.

This is an explicit bridge between operator commutator geometry and the
state-dependent QGT. It does not identify the operator anticommutator metric
`NN† + N†N` with the QGT: they have different types and state dependence.
-/

noncomputable section

open scoped InnerProductSpace
open ContinuousLinearMap
open InfoGeometry.QuantumGeometry.Projective

namespace InfoGeometry.Canonical.NilpotentQGTCartanBridge

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

local notation "EndH" => H →L[ℂ] H

/-- The self-adjoint bridge generated by an operator and its adjoint. -/
def nilpotentDirac (N : EndH) : EndH := N + adjoint N

/-- The skew-adjoint current generated by an operator and its adjoint. -/
def nilpotentCurrent (N : EndH) : EndH := N - adjoint N

/-- The Cartan commutator generated by an operator and its adjoint. -/
def nilpotentCartan (N : EndH) : EndH := opCommutator N (adjoint N)

/-- The finite-dimensional linear trace of a bounded operator. -/
def finiteOperatorTrace (T : EndH) : ℂ :=
  LinearMap.trace ℂ H T.toLinearMap

/-- The positive/metric Gramian generated by an operator and its adjoint. -/
def nilpotentGramian (N : EndH) : EndH := N * adjoint N + adjoint N * N

/-- A nilpotent endomorphism of a finite-dimensional complex space has zero
linear trace. -/
theorem finiteOperatorTrace_eq_zero_of_isNilpotent
    [Module.Finite ℂ H] (N : EndH)
    (hN : IsNilpotent N.toLinearMap) :
    finiteOperatorTrace N = 0 := by
  exact IsNilpotent.eq_zero
    (LinearMap.isNilpotent_trace_of_isNilpotent hN)

/-- Every positive power of a nilpotent endomorphism has zero trace in finite
dimension. -/
theorem finiteOperatorTrace_pow_eq_zero_of_isNilpotent
    [Module.Finite ℂ H] (N : EndH)
    (hN : IsNilpotent N.toLinearMap) {k : ℕ} (hk : k ≠ 0) :
    finiteOperatorTrace (N ^ k) = 0 := by
  apply finiteOperatorTrace_eq_zero_of_isNilpotent
  simpa only [ContinuousLinearMap.toLinearMap_pow] using hN.pow_of_pos hk

/-- The finite-dimensional operator trace is invariant under conjugation by a
map equipped with a left inverse. This inverse law is sufficient for
cyclicity in the displayed orientation. -/
theorem finiteOperatorTrace_similarity
    [Module.Finite ℂ H] (G T Ginv : EndH)
    (hInv : Ginv * G = 1) :
    finiteOperatorTrace (G * T * Ginv) = finiteOperatorTrace T := by
  change LinearMap.trace ℂ H
      (G.toLinearMap * T.toLinearMap * Ginv.toLinearMap) = _
  calc
    LinearMap.trace ℂ H
        ((G.toLinearMap * T.toLinearMap) * Ginv.toLinearMap) =
      LinearMap.trace ℂ H
        (Ginv.toLinearMap * (G.toLinearMap * T.toLinearMap)) :=
      LinearMap.trace_mul_comm ℂ _ _
    _ = LinearMap.trace ℂ H
        ((Ginv * G * T).toLinearMap) := by
      congr 1
    _ = LinearMap.trace ℂ H T.toLinearMap := by
      rw [hInv, one_mul]

/-- Every commutator has zero finite-dimensional linear trace. -/
theorem finiteOperatorTrace_commutator_eq_zero
    [Module.Finite ℂ H] (X Y : EndH) :
    finiteOperatorTrace (opCommutator X Y) = 0 := by
  change LinearMap.trace ℂ H
      (X.toLinearMap * Y.toLinearMap - Y.toLinearMap * X.toLinearMap) = 0
  rw [map_sub, LinearMap.trace_mul_comm ℂ X.toLinearMap Y.toLinearMap,
    sub_self]

/-- In finite dimension, a square-zero operator has zero trace, the two
adjoint Gramian terms have equal trace by cyclicity, and both the Cartan
commutator and the Gramian trace reduce to these cyclic identities. -/
theorem nilpotent_finite_trace_invariants
    [Module.Finite ℂ H] (N : EndH) (hNil : N * N = 0) :
    finiteOperatorTrace N = 0 ∧
      finiteOperatorTrace (N * adjoint N) =
        finiteOperatorTrace (adjoint N * N) ∧
      finiteOperatorTrace (nilpotentCartan N) = 0 ∧
      finiteOperatorTrace (nilpotentGramian N) =
        2 * finiteOperatorTrace (N * adjoint N) := by
  have hNsq : N.toLinearMap * N.toLinearMap = 0 := by
    rw [← ContinuousLinearMap.toLinearMap_mul, hNil]
    simp
  have hNnil : IsNilpotent N.toLinearMap := by
    refine ⟨2, ?_⟩
    simpa [pow_two] using hNsq
  have hTraceN : finiteOperatorTrace N = 0 := by
    exact finiteOperatorTrace_eq_zero_of_isNilpotent N hNnil
  have hCyclic :
      finiteOperatorTrace (N * adjoint N) =
        finiteOperatorTrace (adjoint N * N) := by
    change LinearMap.trace ℂ H
        (N.toLinearMap * (adjoint N).toLinearMap) =
      LinearMap.trace ℂ H ((adjoint N).toLinearMap * N.toLinearMap)
    exact LinearMap.trace_mul_comm ℂ N.toLinearMap (adjoint N).toLinearMap
  have hCartan : finiteOperatorTrace (nilpotentCartan N) = 0 := by
    exact finiteOperatorTrace_commutator_eq_zero N (adjoint N)
  have hGramian :
      finiteOperatorTrace (nilpotentGramian N) =
        2 * finiteOperatorTrace (N * adjoint N) := by
    change LinearMap.trace ℂ H
        (N.toLinearMap * (adjoint N).toLinearMap +
          (adjoint N).toLinearMap * N.toLinearMap) =
      2 * LinearMap.trace ℂ H
        (N.toLinearMap * (adjoint N).toLinearMap)
    rw [map_add, LinearMap.trace_mul_comm ℂ (adjoint N).toLinearMap
      N.toLinearMap]
    ring
  exact ⟨hTraceN, hCyclic, hCartan, hGramian⟩

/-- The real part of the finite-dimensional trace of the adjoint Gramian is
nonnegative. The proof expresses the operator in an orthonormal basis and
reuses the positive Hilbert–Schmidt trace pairing on the full matrix algebra. -/
theorem nilpotent_finite_volume_nonneg
    [Module.Finite ℂ H] (N : EndH) :
    0 ≤ Complex.re (finiteOperatorTrace (N * adjoint N)) := by
  let b := stdOrthonormalBasis ℂ H
  let A := LinearMap.toMatrix b.toBasis b.toBasis N.toLinearMap
  have hTrace :
      finiteOperatorTrace (N * adjoint N) =
        Matrix.trace (A * Matrix.conjTranspose A) := by
    change LinearMap.trace ℂ H ((N * adjoint N).toLinearMap) = _
    rw [ContinuousLinearMap.toLinearMap_mul,
      LinearMap.trace_eq_matrix_trace ℂ b.toBasis,
      ← ContinuousLinearMap.adjoint_toLinearMap N,
      LinearMap.toMatrix_mul, LinearMap.toMatrix_adjoint]
  have hCycle :
      Matrix.trace (A * Matrix.conjTranspose A) =
        Matrix.trace (Matrix.conjTranspose A * A) :=
    Matrix.trace_mul_comm A (Matrix.conjTranspose A)
  have hPositive :
      0 ≤ InfoGeometry.Analysis.MatrixTraceQuadratic.tracePair A A :=
    InfoGeometry.Analysis.MatrixTraceQuadratic.tracePair_self_nonneg A
  have hPositive' :
      0 ≤ Complex.re (Matrix.trace (Matrix.conjTranspose A * A)) := by
    simpa [InfoGeometry.Analysis.MatrixTraceQuadratic.tracePair_apply,
      Matrix.star_eq_conjTranspose] using hPositive
  rw [hTrace, hCycle]
  exact hPositive'

/-- In finite dimension, the trace volume of `N N†` is strictly positive
exactly when the transition operator is nonzero. This is the faithful
Hilbert–Schmidt norm criterion transported through an orthonormal basis. -/
theorem nilpotent_finite_volume_pos_iff
    [Module.Finite ℂ H] (N : EndH) :
    0 < Complex.re (finiteOperatorTrace (N * adjoint N)) ↔ N ≠ 0 := by
  let b := stdOrthonormalBasis ℂ H
  let A := LinearMap.toMatrix b.toBasis b.toBasis N.toLinearMap
  have hTrace :
      finiteOperatorTrace (N * adjoint N) =
        Matrix.trace (A * Matrix.conjTranspose A) := by
    change LinearMap.trace ℂ H ((N * adjoint N).toLinearMap) = _
    rw [ContinuousLinearMap.toLinearMap_mul,
      LinearMap.trace_eq_matrix_trace ℂ b.toBasis,
      ← ContinuousLinearMap.adjoint_toLinearMap N,
      LinearMap.toMatrix_mul, LinearMap.toMatrix_adjoint]
  have hCycle :
      Matrix.trace (A * Matrix.conjTranspose A) =
        Matrix.trace (Matrix.conjTranspose A * A) :=
    Matrix.trace_mul_comm A (Matrix.conjTranspose A)
  have hVolume :
      Complex.re (finiteOperatorTrace (N * adjoint N)) =
        InfoGeometry.Analysis.MatrixTraceQuadratic.tracePair A A := by
    rw [hTrace, hCycle]
    simp [InfoGeometry.Analysis.MatrixTraceQuadratic.tracePair_apply,
      Matrix.star_eq_conjTranspose]
  have hA_zero : A = 0 ↔ N = 0 := by
    constructor
    · intro hA
      change LinearMap.toMatrix b.toBasis b.toBasis N.toLinearMap = 0 at hA
      apply ContinuousLinearMap.coe_injective
      apply (LinearMap.toMatrix b.toBasis b.toBasis).injective
      simpa using hA
    · intro hN
      simp [A, hN]
  rw [hVolume, InfoGeometry.Analysis.MatrixTraceQuadratic.tracePair_self_pos_iff]
  exact not_congr hA_zero

/-- The finite Gramian trace is invariant under conjugation by an isometry. -/
theorem nilpotent_finite_volume_isometric_conjugate
    [Module.Finite ℂ H] (U N : EndH)
    (hAdjU : adjoint U * U = 1) :
    finiteOperatorTrace
        ((U * N * adjoint U) * adjoint (U * N * adjoint U)) =
      finiteOperatorTrace (N * adjoint N) := by
  have hAdj : adjoint (U * N * adjoint U) = U * adjoint N * adjoint U := by
    have hUN : adjoint (U * N) = adjoint N * adjoint U :=
      adjoint_comp U N
    calc
      adjoint ((U * N) * adjoint U) =
          adjoint (adjoint U) * adjoint (U * N) :=
        adjoint_comp (U * N) (adjoint U)
      _ = U * adjoint N * adjoint U := by
        rw [adjoint_adjoint, hUN]
        noncomm_ring
  have hGram :
      (U * N * adjoint U) * adjoint (U * N * adjoint U) =
        U * (N * adjoint N) * adjoint U := by
    rw [hAdj]
    calc
      (U * N * adjoint U) * (U * adjoint N * adjoint U) =
          U * N * (adjoint U * U) * adjoint N * adjoint U := by noncomm_ring
      _ = U * N * adjoint N * adjoint U := by rw [hAdjU, mul_one]
      _ = U * (N * adjoint N) * adjoint U := by noncomm_ring
  rw [hGram]
  exact finiteOperatorTrace_similarity U (N * adjoint N) (adjoint U) hAdjU

/-- The algebraic Connes seminorm carrier generated by the symmetric
nilpotent/adjoint Dirac operator. This uses the repository's algebraic
commutator-seminorm interface; it makes no compact-resolvent or trace-class
claim. -/
noncomputable def nilpotentGeneratedSpectralTriple (N : EndH) :
    ConnesSpectral.SpectralTriple EndH where
  dirac := nilpotentDirac N

/-- The Dirac commutator of the nilpotent-generated spectral seminorm is the
sum of the inner derivations generated separately by `N` and `N†`. -/
theorem nilpotent_generated_spectral_commutator (N X : EndH) :
    (nilpotentGeneratedSpectralTriple N).commutator X =
      opCommutator N X + opCommutator (adjoint N) X := by
  change (N + adjoint N) * X - X * (N + adjoint N) =
    (N * X - X * N) + (adjoint N * X - X * adjoint N)
  noncomm_ring

/-- The corresponding Connes Lipschitz condition is exactly the unit-ball
condition for the norm of the paired nilpotent inner derivation. -/
theorem nilpotent_generated_spectral_lipschitz_iff (N X : EndH) :
    (nilpotentGeneratedSpectralTriple N).LipschitzFunction X ↔
      ‖opCommutator N X + opCommutator (adjoint N) X‖ ≤ 1 := by
  rw [ConnesSpectral.SpectralTriple.LipschitzFunction,
    ConnesSpectral.SpectralTriple.commutatorNorm,
    nilpotent_generated_spectral_commutator]

/-- An observable in the nilpotent-generated Dirac unit ball contributes its
state-readout difference to the existing Connes spectral-distance supremum.
Finiteness is stated as the exact boundedness premise required by the
supremum owner. -/
theorem nilpotent_generated_observable_le_spectral_distance_supremum
    (N X : EndH) (ω₁ ω₂ : EndH → ℝ)
    (hLip : ‖opCommutator N X + opCommutator (adjoint N) X‖ ≤ 1)
    (hBdd : BddAbove
      (InfoGeometry.Canonical.ConnesNCSpectralMetricSupremum.spectralDistanceSet
        (nilpotentDirac N) ω₁ ω₂)) :
    |ω₁ X - ω₂ X| ≤
      InfoGeometry.Canonical.ConnesNCSpectralMetricSupremum.supremumSpectralDist
        (nilpotentDirac N) ω₁ ω₂ := by
  apply InfoGeometry.Canonical.ConnesNCSpectralMetricSupremum.pointwise_le_supremum_spectral_dist
    (nilpotentDirac N) ω₁ ω₂ X ?_ hBdd
  change ConnesSpectral.SpectralTriple.LipschitzFunction
    (nilpotentGeneratedSpectralTriple N) X
  rw [nilpotent_generated_spectral_lipschitz_iff]
  exact hLip

/-- If two additive readouts distinguish an observable annihilated by the
paired nilpotent/adjoint derivation, their distance for the nilpotent Dirac
operator is unbounded. This is the kernel obstruction to finite distance. -/
theorem nilpotent_spectral_distance_unbounded_of_derivation_kernel
    (N c : EndH) (ω₁ ω₂ : EndH →+ ℝ)
    (hComm : opCommutator N c + opCommutator (adjoint N) c = 0)
    (hReadout : ω₁ c ≠ ω₂ c) :
    ¬ BddAbove
      (InfoGeometry.Canonical.ConnesNCSpectralMetricSupremum.spectralDistanceSet
        (nilpotentDirac N) ω₁ ω₂) := by
  apply InfoGeometry.Canonical.ConnesNCSpectralMetricSupremum.spectralDistanceSet_not_bddAbove_of_commuting_readouts
    (nilpotentDirac N) ω₁ ω₂ c ?_ hReadout
  change (nilpotentGeneratedSpectralTriple N).commutator c = 0
  rw [nilpotent_generated_spectral_commutator]
  exact hComm

/-- The directions `iΦ` and `J` are skew-adjoint. -/
theorem nilpotent_generated_directions_skew_adjoint (N : EndH) :
    adjoint (Complex.I • nilpotentDirac N) = -(Complex.I • nilpotentDirac N) ∧
    adjoint (nilpotentCurrent N) = -nilpotentCurrent N := by
  have hΦ : adjoint (nilpotentDirac N) = nilpotentDirac N := by
    simp [nilpotentDirac, map_add, adjoint_adjoint]
    abel
  have hJ : adjoint (nilpotentCurrent N) = -nilpotentCurrent N := by
    simp [nilpotentCurrent, map_sub, adjoint_adjoint]
  have hI : adjoint (Complex.I • nilpotentDirac N) =
      -(Complex.I • nilpotentDirac N) := by
    calc
      adjoint (Complex.I • nilpotentDirac N) =
          starRingEnd ℂ Complex.I • adjoint (nilpotentDirac N) :=
            map_smulₛₗ adjoint Complex.I (nilpotentDirac N)
      _ = -(Complex.I • nilpotentDirac N) := by rw [hΦ]; simp
  exact ⟨hI, hJ⟩

/-- The commutator of the two skew directions is `-2 i` times the Cartan
commutator. This identity is valid without nilpotency; it specializes to the
Cartan generator of any nilpotent-first pair. -/
theorem nilpotent_generated_directions_commutator (N : EndH) :
    opCommutator (Complex.I • nilpotentDirac N) (nilpotentCurrent N) =
      (-2 * Complex.I) • nilpotentCartan N := by
  dsimp [opCommutator, nilpotentDirac, nilpotentCurrent, nilpotentCartan]
  simp only [add_comp, comp_add, sub_comp, comp_sub, comp_smul]
  module

/-- The QGT Berry curvature on the nilpotent-generated skew directions is the
state expectation of `-2 i [N,N†]`. Together with the nilpotent-first Casimir
theorem, this makes the Cartan invariant visible to the state-level QGT. -/
theorem nilpotent_generated_berry_curvature_eq_cartan_expectation
    (ψ : NormalizedState H) (N : EndH) :
    (berryCurvature ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N) : ℂ) *
        Complex.I =
      ⟪ψ.vec, (((-2 * Complex.I) • nilpotentCartan N) ψ.vec)⟫_ℂ := by
  obtain ⟨hX, hY⟩ := nilpotent_generated_directions_skew_adjoint N
  have h := berryCurvature_skewAdjoint_commutator ψ
      (Complex.I • nilpotentDirac N) (nilpotentCurrent N) hX hY
  rw [nilpotent_generated_directions_commutator] at h
  exact h

/-- The Robertson bound specialized to the same nilpotent-generated directions
controls the Cartan expectation detected by the Berry curvature. -/
theorem nilpotent_generated_robertson_bound (ψ : NormalizedState H) (N : EndH) :
    fubiniStudyMetric ψ (Complex.I • nilpotentDirac N) (Complex.I • nilpotentDirac N) *
        fubiniStudyMetric ψ (nilpotentCurrent N) (nilpotentCurrent N) ≥
      (1 / 4 : ℝ) * Complex.normSq
        (⟪ψ.vec, (((-2 * Complex.I) • nilpotentCartan N) ψ.vec)⟫_ℂ) := by
  obtain ⟨hX, hY⟩ := nilpotent_generated_directions_skew_adjoint N
  have h :=
    InfoGeometry.Canonical.CramerRaoOnsagerCommutatorUncertainty.cramerRao_robertson_schrodinger_bound
      ψ hX hY
  rw [nilpotent_generated_directions_commutator] at h
  exact h

/-- Nilpotent-first synthesis in one carrier: a square-zero, von Neumann regular
Hilbert-space operator generates orthogonal projector sheets, and the same
operator's Cartan commutator controls the Robertson bound through its QGT
Berry curvature. The projector identities and the state-space inequality are
both attached to this single `N`; no ring operator is paired with an unrelated
Hilbert-space operator. -/
theorem nilpotent_first_qgt_robertson_synthesis
    (ψ : NormalizedState H) (N : EndH)
    (hNil : N * N = 0)
    (hVNR : N * adjoint N * N = N) :
    let P := N * adjoint N
    let Q := adjoint N * N
    P * P = P ∧ Q * Q = Q ∧ P * Q = 0 ∧ Q * P = 0 ∧
      (berryCurvature ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N) : ℂ) *
          Complex.I =
        ⟪ψ.vec, (((-2 * Complex.I) • nilpotentCartan N) ψ.vec)⟫_ℂ ∧
      fubiniStudyMetric ψ (Complex.I • nilpotentDirac N) (Complex.I • nilpotentDirac N) *
          fubiniStudyMetric ψ (nilpotentCurrent N) (nilpotentCurrent N) ≥
        (1 / 4 : ℝ) * Complex.normSq
          (⟪ψ.vec, (((-2 * Complex.I) • nilpotentCartan N) ψ.vec)⟫_ℂ) := by
  dsimp only
  have hNilAdj : adjoint N * adjoint N = 0 := by
    have hs := congrArg star hNil
    simpa [ContinuousLinearMap.star_eq_adjoint, star_mul] using hs
  have hVNRAdj : adjoint N * N * adjoint N = adjoint N := by
    have hs := congrArg star hVNR
    simpa [ContinuousLinearMap.star_eq_adjoint, star_mul, mul_assoc] using hs
  have hP : (N * adjoint N) * (N * adjoint N) = N * adjoint N := by
    calc
      (N * adjoint N) * (N * adjoint N) =
          (N * adjoint N * N) * adjoint N := by noncomm_ring
      _ = N * adjoint N := by rw [hVNR]
  have hQ : (adjoint N * N) * (adjoint N * N) = adjoint N * N := by
    calc
      (adjoint N * N) * (adjoint N * N) =
          (adjoint N * N * adjoint N) * N := by noncomm_ring
      _ = adjoint N * N := by rw [hVNRAdj]
  have hPQ : (N * adjoint N) * (adjoint N * N) = 0 := by
    calc
      (N * adjoint N) * (adjoint N * N) =
          N * (adjoint N * adjoint N) * N := by noncomm_ring
      _ = 0 := by rw [hNilAdj]; simp
  have hQP : (adjoint N * N) * (N * adjoint N) = 0 := by
    calc
      (adjoint N * N) * (N * adjoint N) =
          adjoint N * (N * N) * adjoint N := by noncomm_ring
      _ = 0 := by rw [hNil]; simp
  exact ⟨hP, hQ, hPQ, hQP,
    nilpotent_generated_berry_curvature_eq_cartan_expectation ψ N,
    nilpotent_generated_robertson_bound ψ N⟩

/-- Same-carrier nilpotent, Casimir, and state-level uncertainty synthesis.
Here the Casimir theorem is instantiated on the Hilbert-space operator ring
with `M = adjoint N`, while the Berry curvature and Robertson bound use the
same `N`. The operator anticommutator metric `V` remains distinct from the
state-dependent Fubini–Study metric. -/
theorem nilpotent_first_casimir_qgt_robertson_synthesis
    (ψ : NormalizedState H) (N : EndH)
    (hNil : N * N = 0)
    (hVNR : N * adjoint N * N = N) :
    let M := adjoint N
    let hCartan := InfoGeometry.OperatorAlgebra.PeirceSpine.comm N M
    let V := N * M + M * N
    let C₂ := InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.casimir2
      N M hCartan
    (N * M * N = N ∧ M * N * M = M ∧
      N * N = 0 ∧ M * M = 0) ∧
    ((N * M) * (N * M) = N * M ∧
      (M * N) * (M * N) = M * N ∧
      (N * M) * (M * N) = 0 ∧
      (M * N) * (N * M) = 0) ∧
    (hCartan ^ 3 = hCartan ∧
      ((hCartan * hCartan + hCartan = (2 : ℤ) • (N * M) ∧
        hCartan * hCartan - hCartan = (2 : ℤ) • (M * N) ∧
        1 - hCartan * hCartan = 1 - N * M - M * N) ∧
       ((1 - hCartan * hCartan) * (1 - hCartan * hCartan) =
            1 - hCartan * hCartan ∧
          (1 - hCartan * hCartan) * (N * M) = 0 ∧
          (N * M) * (1 - hCartan * hCartan) = 0 ∧
          (1 - hCartan * hCartan) * (M * N) = 0 ∧
          (M * N) * (1 - hCartan * hCartan) = 0))) ∧
    (InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.comm
        hCartan N = InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.twoOp N ∧
      InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.comm
        hCartan M = -InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.twoOp M ∧
      InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.comm
        N M = hCartan ∧
      C₂ - hCartan * hCartan =
        InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.twoOp V ∧
      InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.comm C₂ hCartan = 0 ∧
      InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.comm C₂ N = 0 ∧
      InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.comm C₂ M = 0) ∧
    (Complex.normSq (QGT ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N)) =
        fubiniStudyMetric ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N) ^ 2 +
          (1 / 4 : ℝ) *
            InfoGeometry.Canonical.CramerRaoOnsagerCommutatorUncertainty.onsagerReversibleBracket
              ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N) ^ 2 ∧
      InfoGeometry.Canonical.CramerRaoOnsagerCommutatorUncertainty.onsagerDissipativeMetric
          ψ (Complex.I • nilpotentDirac N) (Complex.I • nilpotentDirac N) *
        InfoGeometry.Canonical.CramerRaoOnsagerCommutatorUncertainty.onsagerDissipativeMetric
          ψ (nilpotentCurrent N) (nilpotentCurrent N) ≥
        (InfoGeometry.Canonical.CramerRaoOnsagerCommutatorUncertainty.onsagerDissipativeMetric
            ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N)) ^ 2 +
          (1 / 4 : ℝ) *
            InfoGeometry.Canonical.CramerRaoOnsagerCommutatorUncertainty.onsagerReversibleBracket
              ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N) ^ 2) ∧
    ((berryCurvature ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N) : ℂ) *
        Complex.I = ⟪ψ.vec, (((-2 * Complex.I) • hCartan) ψ.vec)⟫_ℂ ∧
      fubiniStudyMetric ψ (Complex.I • nilpotentDirac N) (Complex.I • nilpotentDirac N) *
        fubiniStudyMetric ψ (nilpotentCurrent N) (nilpotentCurrent N) ≥
          (1 / 4 : ℝ) * Complex.normSq
            (⟪ψ.vec, (((-2 * Complex.I) • hCartan) ψ.vec)⟫_ℂ)) := by
  dsimp only
  let M := adjoint N
  let hCartan := InfoGeometry.OperatorAlgebra.PeirceSpine.comm N M
  have hNilM : adjoint N * adjoint N = 0 := by
    have hs := congrArg star hNil
    simpa [ContinuousLinearMap.star_eq_adjoint, star_mul] using hs
  have hVNRM : adjoint N * N * adjoint N = adjoint N := by
    have hs := congrArg star hVNR
    simpa [ContinuousLinearMap.star_eq_adjoint, star_mul, mul_assoc] using hs
  have hCasimir :=
    InfoGeometry.OperatorAlgebra.PeirceSpine.ZornNambuDeRhamDiracKahlerPoset.nilpotent_first_sl2_casimir_invariants_and_projector_precipitation
      hNil hNilM hVNR hVNRM
  rcases hCasimir with
    ⟨hP, hQ, hPQ, hQP, _, _, _, hHN, hHM, hNM, _, _, hParabolic, hC₂H, hC₂N, hC₂M⟩
  have hSpectral :=
    InfoGeometry.OperatorAlgebra.PeirceSpine.CyclotomicGaloisNilpotentSylvesterSynthesis.nilpotent_first_tripotent_spectral_sheets
      hNil hVNR
  have hSpectral' :
      hCartan ^ 3 = hCartan ∧
        ((hCartan * hCartan + hCartan = (2 : ℤ) • (N * M) ∧
          hCartan * hCartan - hCartan = (2 : ℤ) • (M * N) ∧
          1 - hCartan * hCartan = 1 - N * M - M * N) ∧
         ((1 - hCartan * hCartan) * (1 - hCartan * hCartan) =
              1 - hCartan * hCartan ∧
            (1 - hCartan * hCartan) * (N * M) = 0 ∧
            (N * M) * (1 - hCartan * hCartan) = 0 ∧
            (1 - hCartan * hCartan) * (M * N) = 0 ∧
            (M * N) * (1 - hCartan * hCartan) = 0)) := by
    simpa [hCartan, M, ContinuousLinearMap.star_eq_adjoint, pow_two] using hSpectral
  exact ⟨⟨hVNR, hVNRM, hNil, hNilM⟩,
    ⟨hP, hQ, hPQ, hQP⟩,
    hSpectral',
    ⟨hHN, hHM, hNM, hParabolic, hC₂H, hC₂N, hC₂M⟩,
    ⟨⟨InfoGeometry.Canonical.CramerRaoOnsagerCommutatorUncertainty.onsager_QGT_split
         ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N),
       InfoGeometry.Canonical.CramerRaoOnsagerCommutatorUncertainty.cramerRao_metriplectic_full_bound
         ψ (Complex.I • nilpotentDirac N) (nilpotentCurrent N)⟩,
     ⟨nilpotent_generated_berry_curvature_eq_cartan_expectation ψ N,
       nilpotent_generated_robertson_bound ψ N⟩⟩⟩

end InfoGeometry.Canonical.NilpotentQGTCartanBridge

