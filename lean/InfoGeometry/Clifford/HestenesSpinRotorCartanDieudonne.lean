import Mathlib.LinearAlgebra.CliffordAlgebra.Basic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.LinearAlgebra.CliffordAlgebra.Grading
import InfoGeometry.Clifford.HestenesSpinRotor

namespace InfoGeometry.Clifford.Hestenes

open CliffordAlgebra

variable {R : Type*} [CommRing R] [Invertible (2 : R)]
variable {M : Type*} [AddCommGroup M] [Module R M]
variable (Q : QuadraticForm R M)

/--
The reflection of a vector `x` along a non-null vector `v` in Clifford algebra
is given by `-v * x * v⁻¹`.
Here we define the raw geometric action of a vector `v` on the odd sector.
-/
def vectorReflectionAction (v x : ClMinus Q) : ClMinus Q :=
  -- The product v * x * v is odd because Odd * Odd * Odd = Odd
  ⟨v.val * x.val * v.val, by
    have h1 := clMinus_mul_clMinus Q v.val x.val v.property x.property
    exact clPlus_mul_clMinus Q (v.val * x.val) v.val h1 v.property⟩

/--
The composition of two vector reflections corresponds to the action of a Spin Rotor.
If we reflect along `u` then `v`, the combined operator is the even element `v * u`.
-/
def rotorFromReflections (u v : ClMinus Q) : GeometricRotor Q :=
  ⟨⟨v.val * u.val, clMinus_mul_clMinus Q v.val u.val v.property u.property⟩⟩

/--
Theorem: The sequential application of two vector reflections is structurally
equivalent to the adjoint action of the Spin Rotor generated by their Clifford product.
-/
theorem rotor_action_eq_double_reflection (u v x : ClMinus Q) :
    GeometricRotor.action Q (rotorFromReflections Q u v) x ⟨u.val * v.val, clMinus_mul_clMinus Q u.val v.val u.property v.property⟩ =
    vectorReflectionAction Q v (vectorReflectionAction Q u x) := by
  apply Subtype.ext
  dsimp [GeometricRotor.action, rotorFromReflections, vectorReflectionAction]
  simp only [mul_assoc]

end InfoGeometry.Clifford.Hestenes
