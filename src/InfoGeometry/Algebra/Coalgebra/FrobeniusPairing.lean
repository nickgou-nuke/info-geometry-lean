import Mathlib.Algebra.Algebra.Basic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Algebra.Module.LinearMap.End

/-!
# Frobenius pairings generated by a linear functional

For an associative algebra `A` and a linear functional `ε : A →ₗ[R] R`, the
standard Frobenius pairing is

`β(a, b) = ε (a * b)`.

This file constructs that pairing as a curried Mathlib linear map and derives
its Frobenius associativity from `mul_assoc`.  Nondegeneracy is deliberately
not asserted: it is additional data about `ε`.
-/

namespace InfoGeometry.Algebra.FrobeniusPairing

variable {R A : Type*}
variable [CommSemiring R] [Semiring A] [Algebra R A]

/-- Left multiplication followed by a linear functional. -/
def pairingRight (ε : A →ₗ[R] R) (a : A) : A →ₗ[R] R :=
  ε.comp (LinearMap.mulLeft R a)

/-- The Frobenius pairing `β(a,b) = ε(ab)` as a curried bilinear map. -/
def pairing (ε : A →ₗ[R] R) : A →ₗ[R] (A →ₗ[R] R) where
  toFun := pairingRight ε
  map_add' a b := by
    ext c
    simp [pairingRight, LinearMap.mulLeft_apply, add_mul]
  map_smul' r a := by
    ext b
    simp [pairingRight, LinearMap.mulLeft_apply, Algebra.smul_mul_assoc]

@[simp]
theorem pairing_apply (ε : A →ₗ[R] R) (a b : A) :
    pairing ε a b = ε (a * b) :=
  rfl

/-- Frobenius associativity is ordinary associativity under `ε`. -/
theorem pairing_mul_left_eq_pairing_mul_right
    (ε : A →ₗ[R] R) (a b c : A) :
    pairing ε (a * b) c = pairing ε a (b * c) := by
  simp only [pairing_apply, mul_assoc]

/-- A trace functional produces a symmetric Frobenius pairing. -/
theorem pairing_comm
    (ε : A →ₗ[R] R)
    (htrace : ∀ a b : A, ε (a * b) = ε (b * a))
    (a b : A) :
    pairing ε a b = pairing ε b a := by
  simpa only [pairing_apply] using htrace a b

/--
Nondegeneracy of the generated pairing is exactly right-separation by the
functional `ε`.
-/
theorem pairing_nondegenerate_iff
    (ε : A →ₗ[R] R) :
    (∀ a : A, (∀ b : A, pairing ε a b = 0) → a = 0) ↔
      ∀ a : A, (∀ b : A, ε (a * b) = 0) → a = 0 := by
  rfl

end InfoGeometry.Algebra.FrobeniusPairing
