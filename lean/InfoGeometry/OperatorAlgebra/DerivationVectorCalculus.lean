import Mathlib.Tactic
import InfoGeometry.Algebra.DerivationLieLaneRepresentation

/-!
# Three-derivation vector calculus

This file is the operator/derivation replacement for coordinate vector
calculus in three directions.  A frame is a triple of Lie generators acting
by genuine Leibniz derivations.

The classical identities are refined as follows:

* `curl (grad a)` is the cyclic action of the frame Lie brackets;
* `div (curl v)` is the corresponding cyclic bracket contraction;
* both vanish when the frame derivations commute.

Thus noncommuting operator directions do not invalidate exterior calculus:
their commutator is precisely the curvature term omitted by naïve coordinate
formulas.
-/

namespace InfoGeometry.OperatorAlgebra.DerivationVectorCalculus

open InfoGeometry.Algebra
open InfoGeometry.Algebra.DerivationLieLane

variable {R A : Type*}
variable [CommRing R] [NonUnitalNonAssocRing A] [Module R A]
  [IsScalarTower R A A] [SMulCommClass R A A]

variable (K : DerivationLieLane R A)

/-- A three-component coefficient vector. -/
abbrev Vector3 := Fin 3 → A

/-- A three-direction derivation frame. -/
abbrev DerivationFrame3 := Fin 3 → K.L

/-- Gradient generated by the represented derivations. -/
def gradient
    (frame : DerivationFrame3 K) (a : A) : Vector3 (A := A) :=
  fun i => K.operatorAction (frame i) a

/-- Divergence generated by the represented derivations. -/
def divergence
    (frame : DerivationFrame3 K) (v : Vector3 (A := A)) : A :=
  ∑ i : Fin 3, K.operatorAction (frame i) (v i)

/-- Three-dimensional curl generated by the represented derivations. -/
def curl
    (frame : DerivationFrame3 K) (v : Vector3 (A := A)) : Vector3 (A := A) :=
  fun i =>
    if i = (0 : Fin 3) then
      K.operatorAction (frame 1) (v 2) -
        K.operatorAction (frame 2) (v 1)
    else if i = (1 : Fin 3) then
      K.operatorAction (frame 2) (v 0) -
        K.operatorAction (frame 0) (v 2)
    else
      K.operatorAction (frame 0) (v 1) -
        K.operatorAction (frame 1) (v 0)

/-- Pairwise commuting frame condition. -/
def FrameCommutes (frame : DerivationFrame3 K) : Prop :=
  ∀ i j : Fin 3, ⁅frame i, frame j⁆ = 0

/-- `curl (grad a)` is exactly the cyclic Lie-bracket action. -/
theorem curl_gradient_eq_bracketAction
    (frame : DerivationFrame3 K) (a : A) :
    curl K frame (gradient K frame a) =
      fun i =>
        if i = (0 : Fin 3) then
          K.operatorAction ⁅frame 1, frame 2⁆ a
        else if i = (1 : Fin 3) then
          K.operatorAction ⁅frame 2, frame 0⁆ a
        else
          K.operatorAction ⁅frame 0, frame 1⁆ a := by
  funext i
  fin_cases i
  · simp [curl, gradient, K.operatorAction_commutator_apply]
  · simp [curl, gradient, K.operatorAction_commutator_apply]
  · simp [curl, gradient, K.operatorAction_commutator_apply]

/-- Commuting derivation directions recover the classical
`curl (grad a) = 0` identity. -/
theorem curl_gradient_eq_zero_of_commute
    (frame : DerivationFrame3 K)
    (hframe : FrameCommutes K frame) (a : A) :
    curl K frame (gradient K frame a) = fun _ => 0 := by
  rw [curl_gradient_eq_bracketAction K frame a]
  funext i
  fin_cases i
  · simp [hframe 1 2]
  · simp [hframe 2 0]
  · simp [hframe 0 1]

/-- Divergence of curl is the cyclic contraction of the frame curvature. -/
theorem divergence_curl_eq_bracketContraction
    (frame : DerivationFrame3 K) (v : Vector3 (A := A)) :
    divergence K frame (curl K frame v) =
      K.operatorAction ⁅frame 0, frame 1⁆ (v 2) +
        K.operatorAction ⁅frame 1, frame 2⁆ (v 0) +
          K.operatorAction ⁅frame 2, frame 0⁆ (v 1) := by
  unfold divergence curl
  simp only [Fin.sum_univ_three, map_sub]
  rw [K.operatorAction_commutator_apply (frame 0) (frame 1) (v 2),
    K.operatorAction_commutator_apply (frame 1) (frame 2) (v 0),
    K.operatorAction_commutator_apply (frame 2) (frame 0) (v 1)]
  abel

/-- Commuting derivation directions recover the classical
`div (curl v) = 0` identity. -/
theorem divergence_curl_eq_zero_of_commute
    (frame : DerivationFrame3 K)
    (hframe : FrameCommutes K frame) (v : Vector3 (A := A)) :
    divergence K frame (curl K frame v) = 0 := by
  rw [divergence_curl_eq_bracketContraction K frame v,
    hframe 0 1, hframe 1 2, hframe 2 0]
  simp

end InfoGeometry.OperatorAlgebra.DerivationVectorCalculus
