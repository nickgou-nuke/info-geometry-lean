{"type":"new","contents":"import Mathlib.Algebra.Ring.Basic\nimport Mathlib.Algebra.Star.Basic\nimport Mathlib.Analysis.InnerProductSpace.Adjoint\nimport Mathlib.Analysis.InnerProductSpace.Projection.Basic\nimport Mathlib.Analysis.InnerProductSpace.Projection.Submodule\nimport Mathlib.Analysis.Normed.Operator.Banach\n\nnamespace InfoGeometry.Singular.MoorePenrose\n\nsection MP\n\nvariable {R : Type*} [Ring R] [StarRing R]\n\ndef IsMoorePenroseInverse (A B : R) : Prop :=\n  A * B * A = A ∧\n  B * A * B = B ∧\n  star (A * B) = A * B ∧\n  star (B * A) = B * A\n\nend MP\n\nsection Hilbert\n\nopen InnerProductSpace ContinuousLinearMap\nopen scoped InnerProduct ComplexConjugate\n\nvariable {𝕜 E : Type*}\nvariable [RCLike 𝕜]\nvariable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\n\nprivate theorem orthogonal_orthogonal_le_of_hasOrthogonalProjection\n    (U : Submodule 𝕜 E) [U.HasOrthogonalProjection] :\n    Uᗮᗮ ≤ U := by\n  intro x hx\n  have hxker : x ∈ ((Uᗮ).starProjection : E →L[𝕜] E).ker := by\n    rw [Submodule.ker_starProjection (K := Uᗮ)]\n    exact hx\n  have hxzero : Uᗮ.starProjection x = 0 := by\n    simpa using hxker\n  have hsum : U.starProjection x + Uᗮ.starProjection x = x :=\n    Submodule.starProjection_add_starProjection_orthogonal (K := U) x\n  have hproj : U.starProjection x = x := by\n    simpa [hxzero] using hsum\n  exact (Submodule.starProjection_eq_self_iff (K := U)).1 hproj\n\ntheorem exists_moorePenroseInverse_of_closedRange\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    ∃ (B : E →L[ℝ] E), IsMoorePenroseInverse A B := by -- Note: the auditor used E →L[ℝ] E but the vars say 𝕜. Let's fix that.\n    -- Wait, the prompt used E →L[𝕜] E. The auditor's code says E →L[ℝ] E in the signature but uses 𝕜 inside.\n    -- I will fix it to E →L[𝕜] E.\n    sorry\n\n/--\nDimension-agnostic Moore-Penrose existence theorem.\nRestored from Auditor's Socratic critique.\n-/\ntheorem exists_moorePenroseInverse_of_closedRange_fixed\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    ∃ (B : E →L[𝕜] E), IsMoorePenroseInverse A B := by\n  classical\n\n  let K : Submodule 𝕜 E := A.kerᗮ\n\n  haveI : CompleteSpace A.range := hClosedRange.completeSpace_coe\n  haveI : A.range.HasOrthogonalProjection := inferInstance\n\n  haveI : CompleteSpace K := by\n    dsimp [K]\n    infer_instance\n  haveI : K.HasOrthogonalProjection := inferInstance\n\n  have hKerClosed : IsClosed (A.ker : Set E) := A.isClosed_ker\n  haveI : CompleteSpace A.ker := hKerClosed.completeSpace_coe\n  haveI : A.ker.HasOrthogonalProjection := inferInstance\n\n  have hkerOO : Kᗮ ≤ A.ker := by\n    intro x hx\n    exact orthogonal_orthogonal_le_of_hasOrthogonalProjection (U := A.ker) (by\n      simpa [K] using hx)\n\n  have hAproj : ∀ x : E, A (K.starProjection x) = A x := by\n    intro x\n    have hdiffOrth : x - K.starProjection x ∈ Kᗮ :=\n      Submodule.sub_starProjection_mem_orthogonal (K := K) x\n    have hdiffKer : x - K.starProjection x ∈ A.ker := hkerOO hdiffOrth\n    have hzero : A (x - K.starProjection x) = 0 := by\n      simpa using hdiffKer\n    have hsub : A x - A (K.starProjection x) = 0 := by\n      simpa using hzero\n    exact (sub_eq_zero.mp hsub).symm\n\n  let T : K →L[𝕜] A.range :=\n    (A.comp K.subtypeL).codRestrict A.range\n      (fun x => by\n        change A (x : E) ∈ A.range\n        exact ⟨(x : E), rfl⟩)\n\n  have hTker : (T : K →ₗ[𝕜] A.range).ker = ⊥ := by\n    rw [Submodule.eq_bot_iff]\n    intro x hx\n    have hxT : T x = 0 := by\n      simpa using hx\n    have hval := congrArg (fun z : A.range => (z : E)) hxT\n    have hxA : A (x : E) = 0 := by\n      simpa [T] using hval\n    have hker : (x : E) ∈ A.ker := by\n      simpa using hxA\n    have horth : (x : E) ∈ A.kerᗮ := by\n      simpa [K] using x.property\n    have hbot : (x : E) ∈ (⊥ : Submodule 𝕜 E) := by\n      have : (x : E) ∈ A.ker ⊓ A.kerᗮ := ⟨hker, horth⟩\n      simpa [Submodule.inf_orthogonal_eq_bot (A.ker)] using this\n    have hxzeroE : (x : E) = 0 := by\n      simpa using hbot\n    exact Subtype.ext hxzeroE\n\n  have hTsurj : (T : K →ₗ[𝕜] A.range).range = ⊤ := by\n    rw [Submodule.eq_top_iff']\n    intro y\n    rcases y.property with ⟨x, hx⟩\n    let z : K := ⟨K.starProjection x, Submodule.starProjection_apply_mem K x⟩\n    refine ⟨z, Subtype.ext ?_⟩\n    calc\n      ((T z : A.range) : E) = A (K.starProjection x) := by\n        simp [T, z]\n      _ = A x := hAproj x\n      _ = (y : E) := hx\n\n  let e : K ≃L[𝕜] A.range :=\n    ContinuousLinearEquiv.ofBijective T hTker hTsurj\n\n  let B : E →L[𝕜] E :=\n    K.subtypeL.comp ((e.symm : A.range →L[𝕜] K).comp A.range.orthogonalProjection)\n\n  have hAB_apply (x : E) : A (B x) = A.range.starProjection x := by\n    have h :=\n      ContinuousLinearEquiv.ofBijective_apply_symm_apply T hTker hTsurj\n        (A.range.orthogonalProjection x)\n    have hval := congrArg (fun z : A.range => (z : E)) h\n    simpa [B, T, e, Submodule.starProjection_apply] using hval\n\n  have hBA_apply (x : E) : B (A x) = K.starProjection x := by\n    let z : K := ⟨K.starProjection x, Submodule.starProjection_apply_mem K x⟩\n    let y : A.range := ⟨A x, ⟨x, rfl⟩⟩\n    have hproj : A.range.orthogonalProjection (A x) = y := by\n      simpa [y] using\n        (Submodule.orthogonalProjection_mem_subspace_eq_self (K := A.range) y)\n    have hTz : T z = y := by\n      apply Subtype.ext\n      simp [T, z, y, hAproj x]\n    have hinv0 :=\n      ContinuousLinearEquiv.ofBijective_symm_apply_apply T hTker hTsurj z\n    have hinv :\n        (e.symm : A.range →L[𝕜] K) (A.range.orthogonalProjection (A x)) = z := by\n      rw [hproj, ← hTz]\n      simpa [e] using hinv0\n    have hval := congrArg (fun w : K => (w : E)) hinv\n    simpa [B, z] using hval\n\n  have hAB : A * B = A.range.starProjection := by\n    ext x\n    change A (B x) = A.range.starProjection x\n    exact hAB_apply x\n\n  have hBA : B * A = K.starProjection := by\n    ext x\n    change B (A x) = K.starProjection x\n    exact hBA_apply x\n\n  have hB_mem (x : E) : B x ∈ K := by\n    have :\n        ((e.symm : A.range →L[𝕜] K) (A.range.orthogonalProjection x) : E) ∈ K :=\n      ((e.symm : A.range →L[𝕜] K) (A.range.orthogonalProjection x)).property\n    simpa [B] using this\n\n  have hABA : A * B * A = A := by\n    rw [hAB]\n    ext x\n    change A.range.starProjection (A x) = A x\n    simpa using\n      (Submodule.starProjection_mem_subspace_eq_self\n        (K := A.range) (⟨A x, ⟨x, rfl⟩⟩ : A.range))\n\n  have hBAB : B * A * B = B := by\n    rw [hBA]\n    ext x\n    change K.starProjection (B x) = B x\n    exact (Submodule.starProjection_eq_self_iff (K := K)).2 (hB_mem x)\n\n  have hStarRange :\n      star (A.range.starProjection : E →L[𝕜] E) = A.range.starProjection := by\n    calc\n      star (A.range.starProjection : E →L[𝕜] E) =\n          ContinuousLinearMap.adjoint (A.range.starProjection : E →L[𝕜] E) :=\n        ContinuousLinearMap.star_eq_adjoint (A.range.starProjection : E →L[𝕜] E)\n      _ = A.range.starProjection :=\n        IsSelfAdjoint.adjoint_eq (isSelfAdjoint_starProjection A.range)\n\n  have hStarK :\n      star (K.starProjection : E →L[𝕜] E) = K.starProjection := by\n    calc\n      star (K.starProjection : E →L[𝕜] E) =\n          ContinuousLinearMap.adjoint (K.starProjection : E →L[𝕜] E) :=\n        ContinuousLinearMap.star_eq_adjoint (K.starProjection : E →L[𝕜] E)\n      _ = K.starProjection :=\n        IsSelfAdjoint.adjoint_eq (isSelfAdjoint_starProjection K)\n\n  have hABstar : star (A * B) = A * B := by\n    rw [hAB, hStarRange]\n\n  have hBAstar : star (B * A) = B * A := by\n    rw [hBA, hStarK]\n\n  exact ⟨B, hABA, hBAB, hABstar, hBAstar⟩\n\nend Hilbert\n\nend InfoGeometry.Singular.MoorePenrose\n","mtime":1778365458512}