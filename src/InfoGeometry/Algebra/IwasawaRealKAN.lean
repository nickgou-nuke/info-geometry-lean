import Mathlib

/-!
# The Iwasawa `KAN` decomposition on `SL(2, ℝ)`

A genuine owner for the `KAN` decomposition of `SL(2, ℝ)`.  This module replaces
two placeholder structures that stored three real numbers `det_K`, `det_A`,
`det_N` together with three *assumed* equations `det_K = 1`, `det_A = 1`,
`det_N = 1`, from which their "unimodular product" theorems concluded
`1 * 1 * 1 = 1`.  No group, no matrix and no decomposition appeared in either.

Here the three factors are actual matrices in `SL(2, ℝ)`:

* `kRot θ` is the rotation `exp (θ X_K)` for `X_K = [[0,-1],[1,0]]`; it is proved
  orthogonal, with determinant one.
* `aDiag lam` is the hyperbolic element `exp (lam X_A)` for `X_A = [[1,0],[0,-1]]`;
  it is proved positive diagonal, with determinant one.
* `nShear ξ` is the unipotent `exp (ξ X_N) = 1 + ξ X_N` for the strictly
  nilpotent `X_N`; its determinant one is *derived* from unipotence, not assumed.

`IwasawaKAN2.kan_det` is the real content: the product `K · A · N` lies in
`SL(2, ℝ)`.  `IwasawaKAN2.canonical` supplies explicit witnesses for which every
hypothesis is discharged by computation.

Note on hypotheses.  For `K` and `A`, membership in `SL(2, ℝ)` is genuinely part
of the input: orthogonality alone does not fix the orientation (`[[0,1],[1,0]]` is
orthogonal with determinant `-1`), and positive diagonality alone does not fix the
modulus.  Those two determinants are therefore carried as hypotheses, which is the
standard definition of the `SO(2)` and split-torus sectors.  What was absent
before is now present: the *matrices*, their sector certificates, the derived
unipotent determinant, and the product theorem.
-/

namespace InfoGeometry.Algebra.IwasawaRealKAN

abbrev Mat2 := Matrix (Fin 2) (Fin 2) ℝ

/-- The strictly upper-triangular root `X_N = s_+`. -/
def sPlus : Mat2 := !![0, 1; 0, 0]

/-- `X_N` is nilpotent of index two.  This is what makes the `N` sector
unipotent. -/
theorem sPlus_sq : sPlus ^ 2 = 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sPlus, pow_two, Matrix.mul_apply, Matrix.zero_apply]

/-! ### The unipotent sector `N` -/

/-- `N = exp (ξ X_N) = 1 + ξ X_N`. -/
def nShear (ξ : ℝ) : Mat2 := !![1, ξ; 0, 1]

/-- `N` lies in the one-parameter unipotent subgroup generated by `X_N`. -/
theorem nShear_eq_one_add_smul (ξ : ℝ) : nShear ξ = 1 + ξ • sPlus := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [nShear, sPlus, Matrix.add_apply, Matrix.smul_apply]

/-- The unipotent is invertible, with inverse `N(-ξ)`: the inverse identity is
exactly the content of `s₊² = 0`. -/
theorem nShear_mul_nShear_neg (ξ : ℝ) : nShear ξ * nShear (-ξ) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [nShear, Matrix.mul_apply, Matrix.one_apply]

/-- **Unimodularity of the nilpotent sector is derived, not assumed.**  Any
upper unitriangular `2x2` matrix has determinant one. -/
theorem det_of_unitriangular {u : Mat2}
    (h00 : u 0 0 = 1) (h11 : u 1 1 = 1) (h10 : u 1 0 = 0) : u.det = 1 := by
  have hu : u = !![(1 : ℝ), u 0 1; 0, 1] := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h00, h11, h10]
  rw [hu, Matrix.det_fin_two_of]
  ring

theorem nShear_unit (ξ : ℝ) :
    nShear ξ 0 0 = 1 ∧ nShear ξ 1 1 = 1 ∧ nShear ξ 1 0 = 0 :=
  ⟨rfl, rfl, rfl⟩

theorem det_nShear (ξ : ℝ) : (nShear ξ).det = 1 :=
  det_of_unitriangular (nShear_unit ξ).1 (nShear_unit ξ).2.1 (nShear_unit ξ).2.2

/-! ### The hyperbolic sector `A` -/

/-- `A = exp (lam X_A)`, the positive diagonal one-parameter subgroup. -/
noncomputable def aDiag (lam : ℝ) : Mat2 := !![Real.exp lam, 0; 0, Real.exp (-lam)]

/-- `A` is positive diagonal. -/
theorem aDiag_pos_diag (lam : ℝ) : 0 < (aDiag lam) 0 0 ∧ (aDiag lam) 1 1 > 0 := by
  constructor <;> simp [aDiag] <;> positivity

theorem aDiag_is_diag (lam : ℝ) : aDiag lam 0 1 = 0 ∧ aDiag lam 1 0 = 0 :=
  ⟨rfl, rfl⟩

/-- `A` has determinant one because `exp lam * exp (-lam) = 1`. -/
theorem det_aDiag (lam : ℝ) : (aDiag lam).det = 1 := by
  rw [show (aDiag lam).det = (!![Real.exp lam, 0; 0, Real.exp (-lam)] : Mat2).det by rfl,
    Matrix.det_fin_two_of]
  rw [← Real.exp_add]
  norm_num

/-! ### The elliptic sector `K` -/

/-- `K = exp (θ X_K)`, the rotation one-parameter subgroup. -/
noncomputable def kRot (θ : ℝ) : Mat2 :=
  !![Real.cos θ, -Real.sin θ; Real.sin θ, Real.cos θ]

/-- `K` is orthogonal: `Kᵀ * K = 1`. -/
theorem kRot_transpose_mul (θ : ℝ) : Matrix.transpose (kRot θ) * kRot θ = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [kRot, Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply]
  all_goals nlinarith [Real.sin_sq_add_cos_sq θ]

/-- `K` has determinant one. -/
theorem det_kRot (θ : ℝ) : (kRot θ).det = 1 := by
  rw [show (kRot θ).det
        = (!![Real.cos θ, -Real.sin θ; Real.sin θ, Real.cos θ] : Mat2).det by rfl,
      Matrix.det_fin_two_of]
  nlinarith [Real.sin_sq_add_cos_sq θ]

/-! ### The `KAN` product and its unimodularity -/

/-- The `KAN` product `exp (θ X_K) * exp (lam X_A) * exp (ξ X_N)`. -/
noncomputable def kanMatrix (θ lam ξ : ℝ) : Mat2 := kRot θ * aDiag lam * nShear ξ

/-- **The genuine unimodular-product theorem.**  The `KAN` product lies in
`SL(2, ℝ)` for every `(θ, lam, ξ)`. -/
theorem kan_det (θ lam ξ : ℝ) : (kanMatrix θ lam ξ).det = 1 := by
  rw [kanMatrix, Matrix.det_mul, Matrix.det_mul, det_kRot, det_aDiag, det_nShear]
  ring

/-- The explicit entries of the `KAN` product. -/
theorem kanMatrix_explicit (θ lam ξ : ℝ) :
    kanMatrix θ lam ξ
      = !![Real.cos θ * Real.exp lam,
          Real.cos θ * Real.exp lam * ξ - Real.sin θ * Real.exp (-lam);
          Real.sin θ * Real.exp lam,
          Real.sin θ * Real.exp lam * ξ + Real.cos θ * Real.exp (-lam)] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [kanMatrix, kRot, aDiag, nShear, Matrix.mul_apply] <;> ring

/-- The `KAN` chart passes through the identity of `SL(2, ℝ)`. -/
theorem kanMatrix_zero : kanMatrix 0 0 0 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [kanMatrix, kRot, aDiag, nShear, Matrix.mul_apply, Matrix.one_apply]

/-! ### The `KAN` triad as data -/

/-- An element of the `KAN` decomposition of `SL(2, ℝ)`: the three sector factors
together with their sector certificates.

The certificates are genuine structural facts about the matrices.  `k_det` and
`a_det` are kept as hypotheses because they are genuinely part of `SO(2)` and of
the split-torus sector respectively -- orthogonality does not fix the orientation
and positivity does not fix the modulus.  `u_det` is *not* a hypothesis: it is
derived from unipotence by `det_of_unitriangular`. -/
structure IwasawaKAN2 where
  /-- The elliptic factor `K`. -/
  k : Mat2
  /-- The hyperbolic factor `A`. -/
  a : Mat2
  /-- The unipotent factor `N`. -/
  u : Mat2
  /-- `K` is orthogonal. -/
  k_orth : Matrix.transpose k * k = 1
  /-- `K` lies in the orientation-preserving component. -/
  k_det : k.det = 1
  /-- `A` is positive diagonal. -/
  a_pos : 0 < a 0 0 ∧ 0 < a 1 1
  /-- `A` is diagonal. -/
  a_is_diag : a 0 1 = 0 ∧ a 1 0 = 0
  /-- `A` lies in `SL(2, ℝ)`. -/
  a_det : a.det = 1
  /-- `N` is upper unitriangular. -/
  u_unit : u 0 0 = 1 ∧ u 1 1 = 1 ∧ u 1 0 = 0

namespace IwasawaKAN2

/-- The determinant of the unipotent factor, **derived** from unipotence. -/
theorem u_det (I : IwasawaKAN2) : I.u.det = 1 :=
  det_of_unitriangular I.u_unit.1 I.u_unit.2.1 I.u_unit.2.2

/-- **The unimodular-product theorem for the `KAN` triad.**  The product
`K · A · N` lies in `SL(2, ℝ)`.

This replaces the placeholder theorems `IwasawaDecompositionData.unimodular_product`
and `sl3_unimodular_product`, which proved `1 * 1 * 1 = 1` for three real numbers
that were never connected to any matrix. -/
theorem kan_det (I : IwasawaKAN2) : (I.k * I.a * I.u).det = 1 := by
  rw [Matrix.det_mul, Matrix.det_mul, I.k_det, I.a_det, I.u_det]
  ring

/-- The `KAN` product of the triad, in `SL(2, ℝ)`. -/
def product (I : IwasawaKAN2) : Mat2 := I.k * I.a * I.u

theorem product_det (I : IwasawaKAN2) : (I.product).det = 1 := I.kan_det

end IwasawaKAN2

/-- The canonical `KAN` decomposition `exp (θ X_K) · exp (lam X_A) · exp (ξ X_N)`,
with every sector certificate and determinant discharged by computation. -/
noncomputable def IwasawaKAN2.canonical (θ lam ξ : ℝ) : IwasawaKAN2 where
  k := kRot θ
  a := aDiag lam
  u := nShear ξ
  k_orth := kRot_transpose_mul θ
  k_det := det_kRot θ
  a_pos := aDiag_pos_diag lam
  a_is_diag := aDiag_is_diag lam
  a_det := det_aDiag lam
  u_unit := nShear_unit ξ

/-- The canonical triad reproduces the `KAN` product. -/
theorem IwasawaKAN2.canonical_product (θ lam ξ : ℝ) :
    (IwasawaKAN2.canonical θ lam ξ).product = kanMatrix θ lam ξ := rfl

theorem IwasawaKAN2.canonical_det (θ lam ξ : ℝ) :
    ((IwasawaKAN2.canonical θ lam ξ).product).det = 1 :=
  (IwasawaKAN2.canonical θ lam ξ).product_det

end InfoGeometry.Algebra.IwasawaRealKAN
