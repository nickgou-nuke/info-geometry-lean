      },
      "required_hypotheses": [
        {
          "name": "hJ",
          "pattern": "J\\s*\\*\\s*J\\s*=\\s*1",
          "description": "Involution hypothesis on input matrix"
        }
      ],
      "target_relation": {
        "type": "equality",
        "relation_symbol": "=",
        "pattern": "blockEmbed J\\s*\\*\\s*blockEmbed J\\s*=\\s*1"
      }
    },
    "standardMasterEpistemicColimitCertificate": {
      "theorem_name": "standardMasterEpistemicColimitCertificate",
