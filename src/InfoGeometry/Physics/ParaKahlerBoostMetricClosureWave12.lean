import InfoGeometry.Physics.ParaKahlerHessianHamiltonianBridge

/-!
# Hyperbolic transform compatibility for the Physics para-complex carrier

The Physics para-complex carrier provides an involution and a symmetric
anti-invariant bilinear form.  This file proves that the associated
hyperbolic transform preserves that form.
-/

noncomputable section

namespace InfoGeometry.Physics.ParaKahler

namespace ParaKahlerStructure

variable {V : Type*} [AddCommGroup V] [Module ℝ V]
variable (pk : ParaKahlerStructure V)

/-- The hyperbolic transform generated by the para-complex involution. -/
def hyperbolicFlow (t : ℝ) (v : V) : V :=
  Real.cosh t • v + Real.sinh t • pk.J v

private theorem mixed_metric_skew (u v : V) :
    pk.g (pk.J u) v = -pk.g u (pk.J v) := by
  have h := pk.g_para_inv v (pk.J u)
  rw [pk.J_sq u] at h
  calc
    pk.g (pk.J u) v = pk.g v (pk.J u) := pk.g_symm _ _
    _ = -pk.g (pk.J v) u := by linarith
    _ = -pk.g u (pk.J v) := by rw [pk.g_symm]

theorem hyperbolicFlow_preserves_bilinear (t : ℝ) (u v : V) :
    pk.g (pk.hyperbolicFlow t u) (pk.hyperbolicFlow t v) = pk.g u v := by
  dsimp [hyperbolicFlow]
  simp only [map_add, LinearMap.add_apply, map_smul, LinearMap.smul_apply]
  simp only [smul_eq_mul]
  have hcross : pk.g (pk.J u) v + pk.g u (pk.J v) = 0 := by
    rw [mixed_metric_skew]
    ring
  have htrig : Real.cosh t ^ 2 - Real.sinh t ^ 2 = 1 := by
    exact Real.cosh_sq_sub_sinh_sq t
  calc
    Real.cosh t * (Real.cosh t * pk.g u v + Real.sinh t * pk.g (pk.J u) v) +
        Real.sinh t * (Real.cosh t * pk.g u (pk.J v) +
          Real.sinh t * pk.g (pk.J u) (pk.J v)) =
        (Real.cosh t)^2 * pk.g u v +
          Real.cosh t * Real.sinh t *
            (pk.g (pk.J u) v + pk.g u (pk.J v)) +
          (Real.sinh t)^2 * pk.g (pk.J u) (pk.J v) := by ring
    _ = pk.g u v := by
      rw [hcross, pk.g_para_inv]
      ring_nf
      calc
        Real.cosh t ^ 2 * pk.g u v - pk.g u v * Real.sinh t ^ 2 =
            (Real.cosh t ^ 2 - Real.sinh t ^ 2) * pk.g u v := by ring
        _ = pk.g u v := by rw [htrig]; ring

end ParaKahlerStructure

end InfoGeometry.Physics.ParaKahler
