import Coxeter.Basic
import Coxeter.LinearAlgebra.BilinearForm
import Coxeter.LinearAlgebra.TwoDim

/-!
Root-module reflection operators adapted from `lean-coxeter`'s geometric
representation, using the repository's pinned Mathlib API.
-/

noncomputable section

namespace InfoGeometry.CoxeterPort.GeometricReflectionOperators

open Coxeter
open CoxeterGroup

variable {W : Type*} [CoxeterGroup W]

/-- The real free module on the simple-root labels of a Coxeter system. -/
abbrev RootModule := B W →₀ ℝ

/-- The standard basis of the formal root module. -/
def rootBasis : Module.Basis (B W) ℝ (RootModule (W := W)) :=
  Finsupp.basisSingleOne

/-- The symmetric bilinear form whose simple-root Gram matrix is the Coxeter
cosine matrix. -/
def rootBilinear : LinearMap.BilinForm ℝ (RootModule (W := W)) :=
  Matrix.toBilin rootBasis (fun i j => -Real.cos (Real.pi / M i j))

theorem rootBilinear_isSymm : (rootBilinear (W := W)).IsSymm := by
  rw [LinearMap.BilinForm.isSymm_iff_basis rootBasis]
  intro i j
  unfold rootBilinear
  repeat rw [@Matrix.toBilin_single (B := fun i j ↦ -Real.cos (Real.pi / M.M i j))]
  rw [M.symmetric i j]

@[simp]
theorem rootBilinear_basis (i j : B W) :
    rootBilinear (W := W) (rootBasis i) (rootBasis j) =
      -Real.cos (Real.pi / M i j) := by
  unfold rootBilinear
  rw [@Matrix.toBilin_single (B := fun i j ↦ -Real.cos (Real.pi / M.M i j))]

@[simp]
theorem rootBilinear_basis_self (i : B W) :
    rootBilinear (W := W) (rootBasis i) (rootBasis i) = 1 := by
  rw [rootBilinear_basis, M.diagonal]
  norm_num

/-- The simple-root reflection on the full formal root module. -/
def simpleRootReflection (i : B W) :
    RootModule (W := W) ≃ₗ[ℝ] RootModule (W := W) where
  toFun x := x - (2 * rootBilinear (W := W) (rootBasis i) x) • rootBasis i
  invFun x := x - (2 * rootBilinear (W := W) (rootBasis i) x) • rootBasis i
  map_add' := by
    intro x y
    simp
    module
  map_smul' := by
    intro c x
    simp
    module
  left_inv := by
    intro x
    simp
    module
  right_inv := by
    intro x
    simp
    module

@[simp]
theorem simpleRootReflection_apply (i : B W) (x : RootModule (W := W)) :
    simpleRootReflection i x =
      x - (2 * rootBilinear (W := W) (rootBasis i) x) • rootBasis i := rfl

theorem simpleRootReflection_involutive (i : B W) :
    Function.Involutive (simpleRootReflection i) :=
  (simpleRootReflection i).left_inv

@[simp]
theorem simpleRootReflection_basis (i : B W) :
    simpleRootReflection i (rootBasis i) = -rootBasis i := by
  rw [simpleRootReflection_apply, rootBilinear_basis_self]
  module

/-- Regard a simple-root reflection as a unit in the endomorphism algebra. -/
def simpleRootReflectionUnit (i : B W) :
    (Module.End ℝ (RootModule (W := W)))ˣ where
  val := (simpleRootReflection i).toLinearMap
  inv := (simpleRootReflection i).toLinearMap
  val_inv := by
    apply LinearMap.ext
    intro x
    exact (simpleRootReflection i).left_inv x
  inv_val := by
    apply LinearMap.ext
    intro x
    exact (simpleRootReflection i).left_inv x

/-- The noncommutative operator group generated by all simple-root
reflections on the formal root module. -/
def geometricReflectionOperatorGroup :
    Subgroup (Module.End ℝ (RootModule (W := W)))ˣ :=
  Subgroup.closure (Set.range simpleRootReflectionUnit)

theorem simpleRootReflectionUnit_mem_group (i : B W) :
    simpleRootReflectionUnit i ∈ geometricReflectionOperatorGroup (W := W) :=
  Subgroup.subset_closure ⟨i, rfl⟩

/-- Adjacent simple roots with Coxeter exponent three give a genuinely
noncommuting pair in the endomorphism-unit reflection group. -/
theorem simpleRootReflectionUnit_noncommute_of_M_eq_three
    (i j : B W) (hij : M i j = 3) :
    simpleRootReflectionUnit i * simpleRootReflectionUnit j ≠
      simpleRootReflectionUnit j * simpleRootReflectionUnit i := by
  have hne : i ≠ j := by
    intro h
    subst j
    have hdiag := M.diagonal i
    simp [hdiag] at hij
  have hji : M j i = 3 := by
    rw [M.symmetric j i]
    exact hij
  have hcos : Real.cos (Real.pi / (M j i : ℝ)) = 1 / 2 := by
    rw [hji]
    norm_num [Real.cos_pi_div_three]
  have hleft :
      simpleRootReflection i (simpleRootReflection j (rootBasis i)) = rootBasis j := by
    simp [simpleRootReflection_apply, rootBilinear_basis, M.symmetric, hij, hji, hcos,
      Real.cos_pi_div_three]
    module
  have hright :
      simpleRootReflection j (simpleRootReflection i (rootBasis i)) =
        -rootBasis i - rootBasis j := by
    simp [simpleRootReflection_apply, rootBilinear_basis, rootBilinear_basis_self,
      M.symmetric, hij, hji, hcos, Real.cos_pi_div_three]
    module
  have hvec :
      simpleRootReflection i (simpleRootReflection j (rootBasis i)) ≠
        simpleRootReflection j (simpleRootReflection i (rootBasis i)) := by
    rw [hleft, hright]
    intro heq
    have hcoord := congrArg (fun x : RootModule (W := W) => x i) heq
    simp [rootBasis, hne] at hcoord
  intro h
  have hval := congrArg Units.val h
  have happly := congrArg (fun f : Module.End ℝ (RootModule (W := W)) => f (rootBasis i)) hval
  apply hvec
  simpa [simpleRootReflectionUnit, LinearEquiv.coe_coe, LinearEquiv.mul_apply] using happly

/-- The generated reflection subgroup itself contains a noncommuting pair
whenever its Coxeter system has a pair of generators with exponent three. -/
theorem geometricReflectionOperatorGroup_exists_noncommuting_pair
    (i j : B W) (hij : M i j = 3) :
    ∃ x y : geometricReflectionOperatorGroup (W := W), x * y ≠ y * x := by
  refine ⟨⟨simpleRootReflectionUnit i, simpleRootReflectionUnit_mem_group i⟩,
    ⟨simpleRootReflectionUnit j, simpleRootReflectionUnit_mem_group j⟩, ?_⟩
  intro h
  exact simpleRootReflectionUnit_noncommute_of_M_eq_three i j hij
    (congrArg Subtype.val h)

end InfoGeometry.CoxeterPort.GeometricReflectionOperators

end
