import InfoGeometry.OperatorAlgebra.SplitOctonionLoxodromic
import InfoGeometry.OperatorAlgebra.SplitOctonionLeftMultiplicationBridge
import Mathlib.Algebra.Algebra.Subalgebra.Basic

/-!
# The associative operator algebra generated by split-Zorn left multiplication

The carrier is the repository's real Zorn model of the split octonions. Its
left regular maps lie in an associative endomorphism algebra. Their composition
is not identified with split-octonion multiplication: the discrepancy is the
associator, and a concrete nonzero instance is already proved by the
`SplitOctonionNonmultiplicativity` owner.
-/

noncomputable section

namespace InfoGeometry.OperatorAlgebra.SplitOctonionMultiplicationOperatorAlgebra

open InfoGeometry.OperatorAlgebra.SplitOctonionLoxodromic

/-- The unital associative subalgebra of endomorphisms generated by all
left-multiplication operators of the split-Zorn carrier. -/
def leftMultiplicationAlgebra : Subalgebra ℝ
    (Module.End ℝ InfoGeometry.OperatorAlgebra.SplitOctonionPseudoReal.CanonicalZorn) :=
  Algebra.adjoin ℝ (Set.range zMulLinear)

/-- Every split-Zorn left-multiplication operator belongs to the generated
operator algebra. -/
theorem leftMultiplication_mem
    (x : InfoGeometry.OperatorAlgebra.SplitOctonionPseudoReal.CanonicalZorn) :
    zMulLinear x ∈ leftMultiplicationAlgebra := by
  exact Algebra.subset_adjoin ⟨x, rfl⟩

/-- The generated multiplication-operator algebra is associative, since its
multiplication is composition in `Module.End`. -/
theorem leftMultiplicationAlgebra_mul_assoc
    (f g h : leftMultiplicationAlgebra) :
    (f * g) * h = f * (g * h) := by
  apply Subtype.ext
  exact mul_assoc (f : Module.End ℝ InfoGeometry.OperatorAlgebra.SplitOctonionPseudoReal.CanonicalZorn)
    (g : Module.End ℝ InfoGeometry.OperatorAlgebra.SplitOctonionPseudoReal.CanonicalZorn)
    (h : Module.End ℝ InfoGeometry.OperatorAlgebra.SplitOctonionPseudoReal.CanonicalZorn)

end InfoGeometry.OperatorAlgebra.SplitOctonionMultiplicationOperatorAlgebra

end
