import InfoGeometry.Core.PeirceGrading
import InfoGeometry.Core.PeirceCompressionDefect
import InfoGeometry.OperatorAlgebra.DerivationCurvatureVariation
import Mathlib.Algebra.Ring.Subring.Basic

/-! # Retained curvature and compression defects in the Peirce grading

The exact curvature remainder is a native two-cochain. Its grade and the
grade of the mixed variation follow from multiplication in the ambient
associative ring. Compression retains the product of two odd components
inside an even corner. Generated subring membership records the input
generators in the native subring order. No grade preservation by the represented
derivations is assumed, and no grade of the full curvature is asserted.
-/

noncomputable section

namespace InfoGeometry.OperatorAlgebra.PeirceCurvatureDefect

open InfoGeometry.Algebra
open InfoGeometry.Core.PeirceGrading
open InfoGeometry.Core.PeirceCompressionDefect
open InfoGeometry.OperatorAlgebra.DerivationDifferentialForms

variable {A : Type*} [Ring A]

section Curvature

variable {R : Type*} [CommRing R] [Algebra R A]
variable (K : DerivationLieLane R A)

/-- The error after subtracting the native linearized curvature is the full wedge square. -/
theorem connectionCurvature_remainder (Γ α : OneForm K) :
    connectionCurvature K (Γ + α) - connectionCurvature K Γ -
      curvatureLinearization K Γ α = connectionWedgeSquare K α := by
  rw [connectionCurvature_add]
  apply DFunLike.ext _ _
  intro x
  apply LinearMap.ext
  intro y
  change (connectionCurvature K Γ x y + curvatureLinearization K Γ α x y +
    connectionWedgeSquare K α x y) - connectionCurvature K Γ x y -
      curvatureLinearization K Γ α x y = connectionWedgeSquare K α x y
  abel

/-- Each quadratic remainder value belongs to the subring generated by its two inputs. -/
theorem connectionCurvature_remainder_mem_closure (Γ α : OneForm K) (x y : K.L) :
    (connectionCurvature K (Γ + α) - connectionCurvature K Γ -
      curvatureLinearization K Γ α) x y ∈ Subring.closure ({α x, α y} : Set A) := by
  rw [connectionCurvature_remainder, connectionWedgeSquare_apply]
  let S := Subring.closure ({α x, α y} : Set A)
  have hx : α x ∈ S := Subring.subset_closure (by simp)
  have hy : α y ∈ S := Subring.subset_closure (by simp)
  exact S.sub_mem (S.mul_mem hx hy) (S.mul_mem hy hx)

/-- Polarization is a difference of two native associative Lie brackets. -/
theorem connectionCrossWedge_eq_lie_sub (α β : OneForm K) (x y : K.L) :
    connectionCrossWedge K α β x y = ⁅α x, β y⁆ - ⁅α y, β x⁆ := by
  rw [connectionCrossWedge_apply]
  change _ = (α x * β y - β y * α x) - (α y * β x - β x * α y)
  abel

/-- Odd connection values can generate an even quadratic curvature term. -/
theorem connectionWedgeSquare_mem_even_of_odd {p : A} (hp : IsIdempotentElem p)
    (α : OneForm K) (x y : K.L)
    (hx : α x ∈ LinearMap.range (odd p))
    (hy : α y ∈ LinearMap.range (odd p)) :
    connectionWedgeSquare K α x y ∈ LinearMap.range (even p) := by
  rw [connectionWedgeSquare_apply]
  exact (lie_routing hp).2.1 (α x) hx (α y) hy

/-- The retained nonlinear remainder is even for the two specified odd input values. -/
theorem connectionCurvature_remainder_mem_even_of_odd
    {p : A} (hp : IsIdempotentElem p) (Γ α : OneForm K) (x y : K.L)
    (hx : α x ∈ LinearMap.range (odd p))
    (hy : α y ∈ LinearMap.range (odd p)) :
    (connectionCurvature K (Γ + α) - connectionCurvature K Γ -
      curvatureLinearization K Γ α) x y ∈ LinearMap.range (even p) := by
  rw [connectionCurvature_remainder]
  exact connectionWedgeSquare_mem_even_of_odd K hp α x y hx hy

/-- Two odd variations produce an even mixed second variation. -/
theorem connectionCrossWedge_mem_even_of_odd
    {p : A} (hp : IsIdempotentElem p) (α β : OneForm K) (x y : K.L)
    (hαx : α x ∈ LinearMap.range (odd p))
    (hαy : α y ∈ LinearMap.range (odd p))
    (hβx : β x ∈ LinearMap.range (odd p))
    (hβy : β y ∈ LinearMap.range (odd p)) :
    connectionCrossWedge K α β x y ∈ LinearMap.range (even p) := by
  rw [connectionCrossWedge_eq_lie_sub]
  exact (LinearMap.range (even p)).sub_mem
    ((lie_routing hp).2.1 (α x) hαx (β y) hβy)
    ((lie_routing hp).2.1 (α y) hαy (β x) hβx)

/-- An even variation and an odd variation produce an odd mixed second variation. -/
theorem connectionCrossWedge_mem_odd_of_even_odd
    {p : A} (hp : IsIdempotentElem p) (α β : OneForm K) (x y : K.L)
    (hαx : α x ∈ LinearMap.range (even p))
    (hαy : α y ∈ LinearMap.range (even p))
    (hβx : β x ∈ LinearMap.range (odd p))
    (hβy : β y ∈ LinearMap.range (odd p)) :
    connectionCrossWedge K α β x y ∈ LinearMap.range (odd p) := by
  rw [connectionCrossWedge_eq_lie_sub]
  exact (LinearMap.range (odd p)).sub_mem
    ((lie_routing hp).2.2 (α x) hαx (β y) hβy)
    ((lie_routing hp).2.2 (α y) hαy (β x) hβx)

/-- The same mixed routing holds with the two variations in the opposite order. -/
theorem connectionCrossWedge_mem_odd_of_odd_even
    {p : A} (hp : IsIdempotentElem p) (α β : OneForm K) (x y : K.L)
    (hαx : α x ∈ LinearMap.range (odd p))
    (hαy : α y ∈ LinearMap.range (odd p))
    (hβx : β x ∈ LinearMap.range (even p))
    (hβy : β y ∈ LinearMap.range (even p)) :
    connectionCrossWedge K α β x y ∈ LinearMap.range (odd p) := by
  rw [connectionCrossWedge_comm K α β]
  exact connectionCrossWedge_mem_odd_of_even_odd K hp β α x y hβx hβy hαx hαy

end Curvature

/-- Left compression of the odd projection selects its directed transfer corner. -/
theorem mul_odd_left {p : A} (hp : IsIdempotentElem p) (x : A) :
    p * odd p x = p * x * (1 - p) := by
  simp only [odd_apply, mul_add, ← mul_assoc, hp.eq, hp.mul_one_sub_self,
    zero_mul, add_zero]

/-- Right compression selects the opposite directed transfer corner. -/
theorem odd_mul_right {p : A} (hp : IsIdempotentElem p) (x : A) :
    odd p x * p = (1 - p) * x * p := by
  simp only [odd_apply, add_mul, mul_assoc, hp.eq, hp.one_sub_mul_self,
    mul_zero, zero_add]

/-- The exact compression defect is the compressed product of both odd components. -/
theorem compression_mul_defect_eq_odd_mul
    {p : A} (hp : IsIdempotentElem p) (x y : A) :
    p * (x * y) * p - (p * x * p) * (p * y * p) =
      p * (odd p x * odd p y) * p := by
  rw [compression_mul_defect p x y hp.eq]
  calc
    _ = p * x * ((1 - p) * (1 - p)) * y * p := by rw [hp.one_sub.eq]
    _ = (p * odd p x) * (odd p y * p) := by
      rw [mul_odd_left hp, odd_mul_right hp]
      simp only [mul_assoc]
    _ = p * (odd p x * odd p y) * p := by simp only [mul_assoc]

/-- The product defect lies in the even grade, although it is generated by odd inputs. -/
theorem compression_mul_defect_mem_even
    {p : A} (hp : IsIdempotentElem p) (x y : A) :
    p * (x * y) * p - (p * x * p) * (p * y * p) ∈ LinearMap.range (even p) := by
  rw [compression_mul_defect_eq_odd_mul hp]
  have hp' : p ∈ LinearMap.range (even p) := (mem_even_iff hp).mpr rfl
  exact even_mul_even hp
    (even_mul_even hp hp' (odd_mul_odd hp ⟨x, rfl⟩ ⟨y, rfl⟩)) hp'

/-- Nonzero compression defect requires both odd components to survive. -/
theorem compression_mul_defect_ne_zero_imp_odd_ne_zero
    {p : A} (hp : IsIdempotentElem p) (x y : A)
    (h : p * (x * y) * p - (p * x * p) * (p * y * p) ≠ 0) :
    odd p x ≠ 0 ∧ odd p y ≠ 0 := by
  rw [compression_mul_defect_eq_odd_mul hp] at h
  constructor
  · intro hx
    apply h
    simp only [hx, zero_mul, mul_zero]
  · intro hy
    apply h
    simp only [hy, mul_zero, zero_mul]

/-- The projector and both odd inputs generate the exact compression defect. -/
theorem compression_mul_defect_mem_closure
    {p : A} (hp : IsIdempotentElem p) (x y : A) :
    p * (x * y) * p - (p * x * p) * (p * y * p) ∈
      Subring.closure ({p, odd p x, odd p y} : Set A) := by
  rw [compression_mul_defect_eq_odd_mul hp]
  let S := Subring.closure ({p, odd p x, odd p y} : Set A)
  have hpS : p ∈ S := Subring.subset_closure (by simp)
  have hxS : odd p x ∈ S := Subring.subset_closure (by simp)
  have hyS : odd p y ∈ S := Subring.subset_closure (by simp)
  exact S.mul_mem (S.mul_mem hpS (S.mul_mem hxS hyS)) hpS

/-- The generated defect subring lies below the generated input subring in the native order. -/
theorem closure_compression_mul_defect_le
    {p : A} (hp : IsIdempotentElem p) (x y : A) :
    Subring.closure ({p * (x * y) * p - (p * x * p) * (p * y * p)} : Set A) ≤
      Subring.closure ({p, odd p x, odd p y} : Set A) := by
  rw [Subring.closure_le, Set.singleton_subset_iff]
  exact compression_mul_defect_mem_closure hp x y

end InfoGeometry.OperatorAlgebra.PeirceCurvatureDefect
