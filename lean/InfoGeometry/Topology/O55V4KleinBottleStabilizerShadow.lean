import InfoGeometry.Topology.O55V4KleinBottleOrbitShadow
import Mathlib.Tactic

/-!
# Finite `O(5,5)` / V4 / stabilizer shadow

This file isolates the theorem-safe finite stabilizer lane for the coordinate V4
shadow generated by `reflPair0` and `reflPair1`.

Closed content:
- exact coordinate criteria for `reflPair0`, `reflPair1`, and `reflPair01` to
  stabilize a point;
- if both reflected hyperbolic pairs are zero, then the whole four-point V4
  orbit shadow collapses to a singleton.

It does **not** prove a Lie-group stabilizer, an actual quotient-space
construction, or a full orbit/stabilizer classification for `O(5,5)` or
`Pin(5,5)`.
-/

namespace O55V4KleinBottleStabilizerShadow

open InfoGeometry.Topology.O55V4KleinBottleFinite
open InfoGeometry.Topology.O55V4KleinBottleOrbitShadow

/-- The first hyperbolic pair vanishes. -/
def Pair0Fixed (x : Vec55) : Prop := x 0 = 0 ∧ x 5 = 0

/-- The second hyperbolic pair vanishes. -/
def Pair1Fixed (x : Vec55) : Prop := x 1 = 0 ∧ x 6 = 0

/-- Exact coordinate criterion for `reflPair0` to stabilize a point. -/
theorem reflPair0_eq_self_iff (x : Vec55) :
    reflPair0 x = x ↔ Pair0Fixed x := by
  constructor
  · intro h
    constructor
    · have h0 := congrFun h 0
      simp [reflPair0] at h0
      linarith
    · have h5 := congrFun h 5
      simp [reflPair0] at h5
      linarith
  · rintro ⟨h0, h5⟩
    ext i
    fin_cases i <;> simp [reflPair0, h0, h5]

/-- Exact coordinate criterion for `reflPair1` to stabilize a point. -/
theorem reflPair1_eq_self_iff (x : Vec55) :
    reflPair1 x = x ↔ Pair1Fixed x := by
  constructor
  · intro h
    constructor
    · have h1 := congrFun h 1
      simp [reflPair1] at h1
      linarith
    · have h6 := congrFun h 6
      simp [reflPair1] at h6
      linarith
  · rintro ⟨h1, h6⟩
    ext i
    fin_cases i <;> simp [reflPair1, h1, h6]

/-- The composite reflection stabilizes exactly when both reflected pairs vanish. -/
theorem reflPair01_eq_self_iff (x : Vec55) :
    reflPair01 x = x ↔ Pair0Fixed x ∧ Pair1Fixed x := by
  constructor
  · intro h
    constructor
    · constructor
      · have h0 := congrFun h 0
        simp [reflPair01, reflPair0, reflPair1] at h0
        linarith
      · have h5 := congrFun h 5
        simp [reflPair01, reflPair0, reflPair1] at h5
        linarith
    · constructor
      · have h1 := congrFun h 1
        simp [reflPair01, reflPair0, reflPair1] at h1
        linarith
      · have h6 := congrFun h 6
        simp [reflPair01, reflPair0, reflPair1] at h6
        linarith
  · rintro ⟨⟨h0, h5⟩, ⟨h1, h6⟩⟩
    ext i
    fin_cases i <;> simp [reflPair01, reflPair0, reflPair1, h0, h5, h1, h6]

/-- If both reflected pairs vanish, the V4 orbit shadow is a singleton. -/
theorem orbitShadow_singleton_of_pair01Fixed {x y : Vec55}
    (h0 : Pair0Fixed x) (h1 : Pair1Fixed x)
    (hy : InV4OrbitShadow x y) :
    y = x := by
  rcases hy with rfl | rfl | rfl | rfl
  · rfl
  · exact (reflPair0_eq_self_iff x).2 h0
  · exact (reflPair1_eq_self_iff x).2 h1
  · rw [(reflPair01_eq_self_iff x).2 ⟨h0, h1⟩]

/-- Closed finite packet for the stabilizer shadow lane. -/
theorem finite_v4_stabilizer_shadow_packet {x y : Vec55}
    (h0 : Pair0Fixed x) (h1 : Pair1Fixed x) :
    reflPair0 x = x ∧
    reflPair1 x = x ∧
    reflPair01 x = x ∧
    (InV4OrbitShadow x y → y = x) := by
  exact ⟨(reflPair0_eq_self_iff x).2 h0,
    (reflPair1_eq_self_iff x).2 h1,
    (reflPair01_eq_self_iff x).2 ⟨h0, h1⟩,
    orbitShadow_singleton_of_pair01Fixed h0 h1⟩

end O55V4KleinBottleStabilizerShadow
