    =========================================================================== -/

section TwoSheetSumDifferenceCrossoverLaw

variable {B : Type*} [Ring B]

/-- Upper-sheet (`+`) connection `∇₊ = P X P ∈ B₁₁`. -/
def connPlus (P X : B) : B := peirce11 P X

/-- Lower-sheet (`-`) connection `∇₋ = (1 - P) Y (1 - P) ∈ B₀₀`. -/
def connMinus (P Y : B) : B := peirce00 P Y

/-- Mean / Sum two-sheet connection `Ω_sum = ∇₊ + ∇₋ = P X P + (1 - P) Y (1 - P) ∈ 𝔨`. -/
def connSum (P X Y : B) : B := connPlus P X + connMinus P Y

/-- Difference / Contorsion-Jump two-sheet connection
`Ω_diff = ∇₊ - ∇₋ = P X P - (1 - P) Y (1 - P) ∈ 𝔨`. -/
def connDiff (P X Y : B) : B := connPlus P X - connMinus P Y

/-- **Single-Sheet Connection Blindness on Throat Operators `N₊, N₋`
(`single_sheet_connection_blindness_on_throat`)**:
In any associative ring `[Ring B]` with idempotent `P * P = P`:
1. The upper-sheet connection `∇₊ = P X P` acts on `N₊ = P A (1 - P)` only from the left and is
   identically zero on `N₊` from the right (`N₊ * ∇₊ = 0`), while it is identically zero on
   `N₋ = (1 - P) C P` from the left (`∇₊ * N₋ = 0`),
2. The lower-sheet connection `∇₋ = (1 - P) Y (1 - P)` is identically zero on `N₊` from the left
   (`∇₋ * N₊ = 0`) and identically zero on `N₋` from the right (`N₋ * ∇₋ = 0`),
3. Consequently, neither single-sheet connection can execute a two-sided Lie bracket on `N₊` alone:
   `[∇₊, N₊] = {∇₊, N₊} = ∇₊ * N₊` and `[∇₋, N₊] = -{∇₋, N₊} = -(N₊ * ∇₋)`. -/
theorem single_sheet_connection_blindness_on_throat
    {P : B} (hP : P * P = P) (X Y A C : B) :
    conePlus P A * connPlus P X = 0 ∧
    connMinus P Y * conePlus P A = 0 ∧
    connPlus P X * coneMinus P C = 0 ∧
    coneMinus P C * connMinus P Y = 0 ∧
    comm (connPlus P X) (conePlus P A) = connPlus P X * conePlus P A ∧
    anticomm (connPlus P X) (conePlus P A) = connPlus P X * conePlus P A ∧
    comm (connMinus P Y) (conePlus P A) = -(conePlus P A * connMinus P Y) ∧
    anticomm (connMinus P Y) (conePlus P A) = conePlus P A * connMinus P Y := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    ((try dsimp only [connPlus, connMinus, peirce11, peirce00]); peirce_nf hP)

/-- **The Universal Fourfold Sum-Difference Transport Crossover Law
(`universal_fourfold_sum_difference_transport_crossover_law`)**:
In any associative ring `[Ring B]` with idempotent `P * P = P`, for arbitrary sheet elements
`X, Y : B` and throat elements `A, C : B`:
1. Chiral intertwining of Sum and Difference connections:
   `invS P * connSum P X Y = connDiff P X Y`, `connSum P X Y * invS P = connDiff P X Y`,
   `invS P * connDiff P X Y = connSum P X Y`, and `connDiff P X Y * invS P = connSum P X Y`,
2. Throat corner coupling:
   `[Ω_sum, N₊] = {Ω_diff, N₊} = ∇₊ N₊ - N₊ ∇₋` and
   `{Ω_sum, N₊} = [Ω_diff, N₊] = ∇₊ N₊ + N₊ ∇₋`,
3. **The Universal Fourfold Crossover Law on `(Φ, J)`**:
   - `[Ω_sum, Φ] = {Ω_diff, J}`,
   - `[Ω_sum, J] = {Ω_diff, Φ}`,
   - `{Ω_sum, Φ} = [Ω_diff, J}`,
   - `{Ω_sum, J} = [Ω_diff, Φ]`! -/
theorem universal_fourfold_sum_difference_transport_crossover_law
    {P : B} (hP : P * P = P) (X Y A C : B) :
    invS P * connSum P X Y = connDiff P X Y ∧
    connSum P X Y * invS P = connDiff P X Y ∧
    invS P * connDiff P X Y = connSum P X Y ∧
    connDiff P X Y * invS P = connSum P X Y ∧
    comm (connSum P X Y) (conePlus P A) =
      connPlus P X * conePlus P A - conePlus P A * connMinus P Y ∧
    comm (connSum P X Y) (conePlus P A) =
      anticomm (connDiff P X Y) (conePlus P A) ∧
    anticomm (connSum P X Y) (conePlus P A) =
      connPlus P X * conePlus P A + conePlus P A * connMinus P Y ∧
    anticomm (connSum P X Y) (conePlus P A) =
      comm (connDiff P X Y) (conePlus P A) ∧
    comm (connSum P X Y) (genPhi P A C) =
      anticomm (connDiff P X Y) (genJ P A C) ∧
    comm (connSum P X Y) (genJ P A C) =
      anticomm (connDiff P X Y) (genPhi P A C) ∧
    anticomm (connSum P X Y) (genPhi P A C) =
      comm (connDiff P X Y) (genJ P A C) ∧
    anticomm (connSum P X Y) (genJ P A C) =
      comm (connDiff P X Y) (genPhi P A C) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    ((try dsimp only [connSum, connDiff, connPlus, connMinus, peirce11, peirce00]); peirce_nf hP)

/-- **Endogenous DeWitt/Gramian Specialization, Klein Four-Group Characters
`χ₊₊, χ₊₋, χ₋₊, χ₋₋`, & Sheet Curvature Asymmetry `∇₊² - ∇₋²`
(`dewitt_gramian_endogenous_crossover_and_klein_characters`)**:
In any associative ring `[Ring B]` with idempotent `P * P = P`:
1. Endogenous Gramian Connections (`X = Y = V`):
   `connPlus P V = N₊ N₋`, `connMinus P V = N₋ N₊`, `connSum P V V = V` (DeWitt / Fisher Metric),
   and `connDiff P V V = Σ` (Berry / Spin Connection),
2. Endogenous Fourfold Crossover (`[Σ, Φ] = {V, J} = 2 V J` and `[Σ, J] = {V, Φ} = 2 V Φ`):
   - `comm V Φ = anticomm Σ J = 0`,
   - `comm V J = anticomm Σ Φ = 0`,
   - `anticomm V Φ = comm Σ J = (2 : ℤ) • (V * Φ)`,
   - `anticomm V J = comm Σ Φ = (2 : ℤ) • (V * J)`,
3. Klein Four-Group Eigen-Sectors (`χ₊₊, χ₊₋, χ₋₊, χ₋₋`) under Chiral Cut `S_P (·) S_P` and
   Sheet-Exchange Throat `Φ (·) Φ`:
   - `χ₊₊` (`V`): `S_P V S_P = V` and `Φ V Φ = V²`,
   - `χ₊₋` (`Σ`): `S_P Σ S_P = Σ` and `Φ Σ Φ = -(V * Σ)`,
   - `χ₋₊` (`Φ`): `S_P Φ S_P = -Φ` and `Φ Φ Φ = V * Φ`,
   - `χ₋₋` (`J`, Klein Seam Twist): `S_P J S_P = -J` and `Φ J Φ = -(V * J)`,
4. Two-Sheet Curvature Asymmetry (`∇₊² - ∇₋²`):
   `connSum P X Y * connSum P X Y = connPlus P X ^ 2 + connMinus P Y ^ 2` and
   `invS P * (connSum P X Y * connSum P X Y) = connSum P X Y * connDiff P X Y =
     connPlus P X ^ 2 - connMinus P Y ^ 2`. -/
theorem dewitt_gramian_endogenous_crossover_and_klein_characters
    {P : B} (hP : P * P = P) (X Y A C : B) :
    (connPlus P (genV P A C) = conePlus P A * coneMinus P C ∧
     connMinus P (genV P A C) = coneMinus P C * conePlus P A ∧
     connSum P (genV P A C) (genV P A C) = genV P A C ∧
     connDiff P (genV P A C) (genV P A C) = genSig P A C) ∧
    (comm (genV P A C) (genPhi P A C) = 0 ∧
     anticomm (genSig P A C) (genJ P A C) = 0 ∧
     comm (genV P A C) (genJ P A C) = 0 ∧
     anticomm (genSig P A C) (genPhi P A C) = 0 ∧
     anticomm (genV P A C) (genPhi P A C) = comm (genSig P A C) (genJ P A C) ∧
     comm (genSig P A C) (genJ P A C) = (2 : ℤ) • (genV P A C * genPhi P A C) ∧
     anticomm (genV P A C) (genJ P A C) = comm (genSig P A C) (genPhi P A C) ∧
     comm (genSig P A C) (genPhi P A C) = (2 : ℤ) • (genV P A C * genJ P A C)) ∧
    (invS P * genV P A C * invS P = genV P A C ∧
     genPhi P A C * genV P A C * genPhi P A C = genV P A C * genV P A C ∧
     invS P * genSig P A C * invS P = genSig P A C ∧
     genPhi P A C * genSig P A C * genPhi P A C = -(genV P A C * genSig P A C) ∧
     invS P * genPhi P A C * invS P = -genPhi P A C ∧
     genPhi P A C * genPhi P A C * genPhi P A C = genV P A C * genPhi P A C ∧
     invS P * genJ P A C * invS P = -genJ P A C ∧
     genPhi P A C * genJ P A C * genPhi P A C = -(genV P A C * genJ P A C)) ∧
    (connSum P X Y * connSum P X Y =
       connPlus P X * connPlus P X + connMinus P Y * connMinus P Y ∧
     connSum P X Y * connDiff P X Y =
       connPlus P X * connPlus P X - connMinus P Y * connMinus P Y ∧
     invS P * (connSum P X Y * connSum P X Y) =
       connPlus P X * connPlus P X - connMinus P Y * connMinus P Y) := by
  refine ⟨⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩,
          ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩⟩ <;>
    (first | simp only [connSum, connDiff, connPlus, connMinus, peirce11, peirce00] | skip) <;>
      peirce_nf hP

end TwoSheetSumDifferenceCrossoverLaw

