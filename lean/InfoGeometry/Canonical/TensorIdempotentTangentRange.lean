import InfoGeometry.Canonical.TensorCurvatureTangentQuotient
import InfoGeometry.Core.IdempotentTangent

/-! # The tangent range of a colimit idempotent

Every derivation evaluates on an idempotent to a linearized idempotent
direction. Conversely, every such direction is the value of a concrete
inner derivation. The quotient by the stabilizer is therefore linearly
isomorphic to the complete idempotent tangent module.
-/

noncomputable section

namespace InfoGeometry.Canonical.TensorIdempotentTangentRange

open InfoGeometry.Clifford.Cl11TensorTowerLimit
open InfoGeometry.Canonical.TensorLimitExactConnection
open InfoGeometry.Canonical.TensorCurvatureTangentQuotient
open InfoGeometry.Core.PeirceTangent
open InfoGeometry.OperatorAlgebra.PeirceSpine

/-- The module of solutions to the linearized idempotent equation. -/
def idempotentTangent (P : Limit) : Submodule ℝ Limit where
  carrier := {T | P * T + T * P = T}
  zero_mem' := by simp
  add_mem' := by
    intro X Y hX hY
    change P * (X + Y) + (X + Y) * P = X + Y
    rw [mul_add, add_mul]
    calc
      P * X + P * Y + (X * P + Y * P) = (P * X + X * P) + (P * Y + Y * P) := by abel
      _ = X + Y := by rw [hX, hY]
  smul_mem' := by
    intro r X hX
    change P * (r • X) + (r • X) * P = r • X
    rw [mul_smul_comm, smul_mul_assoc, ← smul_add, hX]

/-- Every derivation produces a tangent direction at an idempotent. -/
theorem cutEvaluation_mem_tangent (P : Limit) (hP : P * P = P) (D : LimitDeriv) :
    cutEvaluation P D ∈ idempotentTangent P := by
  change P * D.1 P + D.1 P * P = D.1 P
  have h := D.property P P
  rw [hP] at h
  rw [add_comm]
  exact h.symm

/-- Every tangent vector is generated by the inner derivation of its
canonical commutator with the idempotent. -/
theorem tangent_has_inner_generator (P T : Limit) (hP : P * P = P)
    (hT : T ∈ idempotentTangent P) :
    cutEvaluation P (limitInnerLieHom (T * P - P * T)) = T := by
  change (T * P - P * T) * P - P * (T * P - P * T) = T
  exact tangent_eq_double_commutator hP hT

/-- The evaluation range is precisely the full tangent module. -/
theorem cutEvaluation_range_eq_tangent (P : Limit) (hP : P * P = P) :
    (cutEvaluation P).range = idempotentTangent P := by
  ext T
  constructor
  · rintro ⟨D, rfl⟩
    exact cutEvaluation_mem_tangent P hP D
  · intro hT
    exact ⟨limitInnerLieHom (T * P - P * T), tangent_has_inner_generator P T hP hT⟩

/-- The tangent equation is exactly the fixed-point condition for the
odd Peirce projection, including in the full colimit operator algebra. -/
theorem tangent_iff_oddGrade (P T : Limit) (hP : P * P = P) :
    T ∈ idempotentTangent P ↔ oddGrade P T = T := by
  constructor
  · intro hT
    exact (tangent_eq_offDiagonal hP hT).symm
  · intro hT
    have hOdd : P * oddGrade P T + oddGrade P T * P = oddGrade P T := by
      unfold oddGrade
      peirce_nf hP
    change P * T + T * P = T
    rw [← hT]
    exact hOdd

/-- The evaluation image is also exactly the set of off-diagonal Peirce
elements. -/
theorem mem_cutEvaluation_range_iff_oddGrade (P T : Limit) (hP : P * P = P) :
    T ∈ (cutEvaluation P).range ↔ oddGrade P T = T := by
  rw [cutEvaluation_range_eq_tangent P hP]
  exact tangent_iff_oddGrade P T hP

/-- First isomorphism theorem: derivation directions modulo the cut
stabilizer are exactly all algebraic tangent directions to the idempotent. -/
def quotientEquivIdempotentTangent (P : Limit) (hP : P * P = P) :
    (LimitDeriv ⧸ (cutEvaluation P).ker) ≃ₗ[ℝ] idempotentTangent P :=
  (tangentQuotientEquiv P).trans (LinearEquiv.ofEq _ _ (cutEvaluation_range_eq_tangent P hP))

/-- Under the tangent isomorphism, the quotient curvature is exactly the
commutator of the corresponding tangent operators. -/
theorem quotientCurvature_eq_tangent_commutator (P : Limit) (hP : P * P = P)
    (u v : LimitDeriv ⧸ (cutEvaluation P).ker) :
    quotientCurvature P u v =
      (quotientEquivIdempotentTangent P hP u : Limit) *
        (quotientEquivIdempotentTangent P hP v : Limit) -
      (quotientEquivIdempotentTangent P hP v : Limit) *
        (quotientEquivIdempotentTangent P hP u : Limit) := by
  rfl

end InfoGeometry.Canonical.TensorIdempotentTangentRange

end
