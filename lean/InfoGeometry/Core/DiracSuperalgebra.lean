import InfoGeometry.Singular.SquareZeroChiralHodge

/-!
# Partial Z2 superalgebra of a square-zero Moore--Penrose pair

This owner records matrix-unit and global involution identities generated by
the normalized pair a + m over an arbitrary involutive ring.
-/

namespace InfoGeometry.Core.DiracSuperalgebra

open InfoGeometry.Singular.MoorePenrose

variable {R : Type*} [Ring R] [StarRing R]

/-- The active even support, P+ + P-. -/
def activeSupport (a m : R) : R := exactSupport a m + coexactSupport a m

/-- The global involution extending supported chirality by +1 on the
harmonic complement. -/
def superInvolution (a m : R) : R := chiralSupport a m + harmonicSupport a m

/-- Partial matrix-unit identities and the normalized supercharge square. -/
theorem partial_matrix_unit_identities
    {a m : R} (h : IsMoorePenroseInverse a m) (ha : a * a = 0) :
    (exactSupport a m * a = a ∧ a * coexactSupport a m = a ∧
      a * exactSupport a m = 0 ∧ coexactSupport a m * a = 0) ∧
    (coexactSupport a m * m = m ∧ m * exactSupport a m = m ∧
      m * coexactSupport a m = 0 ∧ exactSupport a m * m = 0) ∧
    (normalizedDirac a m * normalizedDirac a m = activeSupport a m) := by
  rcases h.dual_square_zero_orthogonality ha with ⟨hrev, hfwd, hm⟩
  have haa : exactSupport a m * a = a := h.aba_eq_a
  have ham : a * coexactSupport a m = a := by
    unfold coexactSupport
    rw [← mul_assoc, h.aba_eq_a]
  have hae : a * exactSupport a m = 0 := by
    unfold exactSupport
    rw [← mul_assoc, ha, zero_mul]
  have hma : coexactSupport a m * a = 0 := by
    unfold coexactSupport
    rw [mul_assoc, ha, mul_zero]
  have hmm : coexactSupport a m * m = m := h.bab_eq_b
  have hme : m * exactSupport a m = m := by
    unfold exactSupport
    rw [← mul_assoc, h.bab_eq_b]
  have hme0 : m * coexactSupport a m = 0 := by
    unfold coexactSupport
    rw [← mul_assoc, hm, zero_mul]
  have hem0 : exactSupport a m * m = 0 := by
    unfold exactSupport
    rw [mul_assoc, hm, mul_zero]
  have hsq :
      normalizedDirac a m * normalizedDirac a m =
        exactSupport a m + coexactSupport a m := by
    simpa [normalizedDirac, exactSupport, coexactSupport, pow_two] using
      h.normalizedDirac_sq ha
  simpa [activeSupport] using
    ⟨⟨haa, ham, hae, hma⟩, ⟨hmm, hme, hme0, hem0⟩, hsq⟩

/-- The active support is idempotent and absorbs both generators. -/
theorem activeSupport_identities
    {a m : R} (h : IsMoorePenroseInverse a m) (ha : a * a = 0) :
    activeSupport a m * activeSupport a m = activeSupport a m ∧
    activeSupport a m * a = a ∧ a * activeSupport a m = a ∧
    activeSupport a m * m = m ∧ m * activeSupport a m = m := by
  rcases h.dual_square_zero_orthogonality ha with ⟨hrev, hfwd, _⟩
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · unfold activeSupport
    rw [add_mul, mul_add, mul_add, h.exactSupport_idem, hfwd, hrev,
      h.coexactSupport_idem]
    abel
  · unfold activeSupport
    unfold exactSupport coexactSupport
    calc
      (a * m + m * a) * a = a * m * a + m * a * a := by noncomm_ring
      _ = a := by
        rw [h.aba_eq_a]
        have hz : m * a * a = 0 := by rw [mul_assoc, ha, mul_zero]
        rw [hz, add_zero]
  · unfold activeSupport
    unfold exactSupport coexactSupport
    calc
      a * (a * m + m * a) = a * a * m + a * m * a := by noncomm_ring
      _ = a := by
        have hz : a * a * m = 0 := by rw [ha, zero_mul]
        rw [hz, h.aba_eq_a, zero_add]
  · unfold activeSupport
    unfold exactSupport coexactSupport
    calc
      (a * m + m * a) * m = a * m * m + m * a * m := by noncomm_ring
      _ = m := by
        have hz : a * m * m = 0 := by rw [mul_assoc, h.inverse_sq_eq_zero ha, mul_zero]
        rw [hz, h.bab_eq_b, zero_add]
  · unfold activeSupport
    unfold exactSupport coexactSupport
    calc
      m * (a * m + m * a) = m * a * m + m * m * a := by noncomm_ring
      _ = m := by
        have hz : m * m * a = 0 := by rw [h.inverse_sq_eq_zero ha, zero_mul]
        rw [h.bab_eq_b, hz, add_zero]

/-- The global Peirce involution squares to one. -/
theorem superInvolution_sq
    {a m : R} (h : IsMoorePenroseInverse a m) (ha : a * a = 0) :
    superInvolution a m * superInvolution a m = 1 := by
  have hc := h.chiralSupport_sq_support ha
  have hp := h.harmonicSupport_idem ha
  have hch : chiralSupport a m * harmonicSupport a m = 0 := by
    unfold chiralSupport
    rw [sub_mul, h.exactSupport_mul_harmonicSupport ha,
      h.coexactSupport_mul_harmonicSupport ha, sub_zero]
  have hhc : harmonicSupport a m * chiralSupport a m = 0 := by
    unfold chiralSupport
    rw [mul_sub, h.harmonicSupport_mul_exactSupport ha,
      h.harmonicSupport_mul_coexactSupport ha, sub_zero]
  unfold superInvolution
  rw [add_mul, mul_add, mul_add, hc, hch, hhc, hp]
  simp only [add_zero, zero_add]
  unfold harmonicSupport
  abel

/-- The global involution anticommutes with the normalized supercharge. -/
theorem superInvolution_anticommute_normalizedDirac
    {a m : R} (h : IsMoorePenroseInverse a m) (ha : a * a = 0) :
    superInvolution a m * normalizedDirac a m +
      normalizedDirac a m * superInvolution a m = 0 := by
  have hγ : chiralSupport a m * normalizedDirac a m +
      normalizedDirac a m * chiralSupport a m = 0 := by
    simpa [chiralSupport, exactSupport, coexactSupport, normalizedDirac] using
      h.chirality_normalizedDirac_anticommute ha
  have hleft := h.harmonicSupport_mul_normalizedDirac ha
  have hright := h.normalizedDirac_mul_harmonicSupport ha
  have hleft' : harmonicSupport a m * (a + m) = 0 := by
    simpa [normalizedDirac] using hleft
  have hright' : (a + m) * harmonicSupport a m = 0 := by
    simpa [normalizedDirac] using hright
  have hγ' : chiralSupport a m * (a + m) +
      (a + m) * chiralSupport a m = 0 := by
    simpa [chiralSupport, exactSupport, coexactSupport, normalizedDirac] using hγ
  unfold superInvolution
  unfold normalizedDirac
  calc
    (chiralSupport a m + harmonicSupport a m) * (a + m) +
        (a + m) * (chiralSupport a m + harmonicSupport a m) =
      (chiralSupport a m * (a + m) +
          (a + m) * chiralSupport a m) +
        (harmonicSupport a m * (a + m) +
          (a + m) * harmonicSupport a m) := by noncomm_ring
    _ = 0 := by
      rw [hγ', hleft', hright', add_zero, zero_add]

end InfoGeometry.Core.DiracSuperalgebra
