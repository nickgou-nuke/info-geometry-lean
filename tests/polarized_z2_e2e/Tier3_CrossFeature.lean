/-- Pair (F1, F7): On `DoubledSpace ℝ`, `etaChiral` simultaneously provides
`PositiveHilbertCompatibility` (`g_J = chiralHilbertForm`) and the odd generator
of `centralDoubledDGA ℝ` in the central nonzero curvature regime (`h = 1`, `∂_F² = 0`). -/
theorem t3_f1_f7_doubled_polarization_central_dga :
    let P := concreteDoubledNullPolarizationReal
    let D := centralDoubledDGA ℝ
    D.curvature = (1 : EndH₂ (E := ℝ)) ∧
      IsCentralNonzeroRegime D.curvature ∧
      D.diff ^ 2 = 0 ∧
      IsUnit (D.diff (gamma5 (E := ℝ))) ∧
      PositiveHilbertCompatibility P ∧
      (∀ u : DoubledSpace ℝ, u ≠ 0 → 0 < P.gJ u u) := by
  refine ⟨centralDoubledDGA_curvature_eq_one,
    centralDoubledDGA_isCentralNonzero,
    centralDoubledDGA_diff_sq,
    centralDoubledDGA_diff_gamma5_isUnit,
    concreteDoubledPositiveHilbertCompatibilityReal,
    fun u hu => concreteDoubledPositiveHilbertCompatibilityReal.gJ_pos hu⟩

/-- Pair (F1, F8): On `DoubledSpace ℝ`, `ChiralObservablesDynamics` generated by
`P.J` yields strict energy positivity and sign flip under `J ↦ -J`, while
`(centralDoubledDGA ℝ).diff` cannot equal `commutatorDeriv H` for any `H : EndH₂`. -/
theorem t3_f1_f8_doubled_polarization_dga_vs_commutator
    (H : EndH₂ (E := ℝ)) (u : DoubledSpace ℝ) (hu : u ≠ 0) :
    let P := concreteDoubledNullPolarizationReal
    let dyn := concreteChiralObservablesDynamicsReal
    0 < P.gJ u (dyn.H u) ∧
      ¬ PositiveHilbertCompatibility P.negMirror ∧
      (centralDoubledDGA ℝ).diff ≠ commutatorDeriv (R := ℝ) H := by
  exact ⟨concreteChiralObservablesDynamicsReal.energy_pos hu,
    concreteDoubledPositiveHilbertCompatibilityReal.not_negMirror,
    centralDoubledDGA_diff_ne_commutatorDeriv H⟩

/-- Pair (F1, F13): `OperatorCliffordDouble.withLpBlockMatrixAlgEquiv` realizes the
chirality grading `gamma5` and Hilbert-compatibility involution `etaChiral` on
`DoubledSpace ℝ` as the standard `2 × 2` block matrices `diag(1, -1)` and `[[0, 1], [1, 0]]`. -/
theorem t3_f1_f13_withLp_block_matrix_on_doubled_space (x y : ℝ) :
    let e := withLpBlockMatrixAlgEquiv (R := ℝ) (M := ℝ)
    let idEnd : Module.End ℝ ℝ := LinearMap.id
    let gMat : Matrix (Fin 2) (Fin 2) (Module.End ℝ ℝ) := !![idEnd, 0; 0, -idEnd]
    let jMat : Matrix (Fin 2) (Fin 2) (Module.End ℝ ℝ) := !![0, idEnd; idEnd, 0]
    e gMat (to_doubled x y) = (gamma5 (E := ℝ)) (to_doubled x y) ∧
      e jMat (to_doubled x y) = (etaChiral (E := ℝ)) (to_doubled x y) ∧
      e (gMat * jMat + jMat * gMat) = 0 := by
  dsimp only
  have hg :
      withLpBlockMatrixAlgEquiv (R := ℝ) (M := ℝ)
          !![(LinearMap.id : Module.End ℝ ℝ), 0; 0, -(LinearMap.id : Module.End ℝ ℝ)]
          (to_doubled x y) =
        (gamma5 (E := ℝ)) (to_doubled x y) := by
    apply DoubledSpace.ext <;>
      simp [withLpBlockMatrixAlgEquiv_apply, gamma5, spectral_epsilon]
  have hj :
      withLpBlockMatrixAlgEquiv (R := ℝ) (M := ℝ)
          !![0, (LinearMap.id : Module.End ℝ ℝ); (LinearMap.id : Module.End ℝ ℝ), 0]
          (to_doubled x y) =
        (etaChiral (E := ℝ)) (to_doubled x y) := by
    apply DoubledSpace.ext <;>
      simp [withLpBlockMatrixAlgEquiv_apply, etaChiral, modular_j]
  have hanti :
      withLpBlockMatrixAlgEquiv (R := ℝ) (M := ℝ)
          (!![(LinearMap.id : Module.End ℝ ℝ), 0; 0, -(LinearMap.id : Module.End ℝ ℝ)] *
              !![0, (LinearMap.id : Module.End ℝ ℝ); (LinearMap.id : Module.End ℝ ℝ), 0] +
            !![0, (LinearMap.id : Module.End ℝ ℝ); (LinearMap.id : Module.End ℝ ℝ), 0] *
              !![(LinearMap.id : Module.End ℝ ℝ), 0; 0, -(LinearMap.id : Module.End ℝ ℝ)]) =
        0 := by
    have hzero :
        (!![(LinearMap.id : Module.End ℝ ℝ), 0; 0, -(LinearMap.id : Module.End ℝ ℝ)] *
            !![0, (LinearMap.id : Module.End ℝ ℝ); (LinearMap.id : Module.End ℝ ℝ), 0] +
          !![0, (LinearMap.id : Module.End ℝ ℝ); (LinearMap.id : Module.End ℝ ℝ), 0] *
            !![(LinearMap.id : Module.End ℝ ℝ), 0; 0, -(LinearMap.id : Module.End ℝ ℝ)]) = 0 := by
      ext i j
      fin_cases i <;> fin_cases j <;> simp
    rw [hzero, map_zero]
  exact ⟨hg, hj, hanti⟩

/-- Pair (F2, F3): For two orthogonal projections `P, Ω`, `odd P Ω` lies in the
positive-adjoint Hermitian regime (`0 ≤ F² ≤ (1/4) I` and `I - F² ≥ (3/4) I`),
while `blockOdd` separates positive adjoint `Y = Xᵀ` from unilateral nilpotent `X = 0, Y ≠ 0`. -/
theorem t3_f2_f3_positive_adjoint_vs_quarter_projector_bound
    {n : Type*} [Fintype n] [DecidableEq n]
    {P Ω : Matrix n n ℝ}
    (hP : IsIdempotentElem P) (hPs : P.IsHermitian)
    (hΩ : IsIdempotentElem Ω) (hΩs : Ω.IsHermitian)
    (X Y : Matrix n n ℝ) (hYne : Y ≠ 0) :
    (odd P Ω).IsHermitian ∧
      ((1 / 4 : ℝ) • (1 : Matrix n n ℝ) - odd P Ω * odd P Ω).PosSemidef ∧
      ((1 : Matrix n n ℝ) - odd P Ω * odd P Ω).PosDef ∧
      ((blockOdd X Y)ᵀ = blockOdd X Y ↔ Y = Xᵀ) ∧
      (blockOdd (0 : Matrix n n ℝ) Y * blockOdd (0 : Matrix n n ℝ) Y = 0 ∧
        ¬ (blockOdd (0 : Matrix n n ℝ) Y).IsHermitian) := by
  have hq := orthogonalProjector_F_sq_le_quarter hP hPs hΩ hΩs
  have h3q := orthogonalProjector_one_sub_F_sq_ge_three_quarters hP hPs hΩ hΩs
  have h2 := indefinite_vs_positive_adjoint_blocks X Y
  have hnil := unilateral_nilpotent_blocks_sq_zero hYne
  exact ⟨odd_isHermitian hPs hΩs, hq.2.1, h3q.2, h2.1.1, hnil.2.1, hnil.2.2.2.1⟩

/-- Pair (F2, F4): Trivial common kernel of `component10 P A` and `(component10 P A)ᴴ`
on a nonempty index type ensures `PosDef` of the coupled-corner square (`F2`), nonvanishing
`component10 P A ≠ 0`, and strict positivity of the real two-sheet BKM resolvent integral (`F4`). -/
theorem t3_f2_f4_coupled_corner_posDef_implies_bkm_pos
    {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (P A : Matrix ι ι ℝ) (hP : IsIdempotentElem P) (hPT : Pᵀ = P)
    (hker : ∀ v : ι → ℝ, component10 P A *ᵥ v = 0 → (component10 P A)ᴴ *ᵥ v = 0 → v = 0)
    {p q : ℝ} (hp : 0 < p) (hq : 0 < q) :
    let Φ := component10 P A + component01 P Aᵀ
    (Φ * Φ).PosDef ∧
      component10 P A ≠ 0 ∧
      0 < ∫ s in Ioi (0 : ℝ),
        Matrix.trace (Φ * twoSheetResolventReal P p q s * Φ * twoSheetResolventReal P p q s) := by
  have hPs : P.IsHermitian := Matrix.isHermitian_iff_isSymm.mpr hPT
  have hpd : ((component10 P A + component01 P Aᵀ) * (component10 P A + component01 P Aᵀ)).PosDef := by
    simpa only [Matrix.conjTranspose_eq_transpose_of_trivial] using
      (square_posDef_iff hP hPs A).mpr hker
  have hXne : component10 P A ≠ 0 := by
    intro h0
    have i0 : ι := Classical.arbitrary ι
    let e : ι → ℝ := fun j => if j = i0 then 1 else 0
    have he_ne : e ≠ 0 := by
      intro hz
      have hval := congrFun hz i0
      simp [e] at hval
    have hx1 : component10 P A *ᵥ e = 0 := by
      rw [h0, Matrix.zero_mulVec]
    have hx2 : (component10 P A)ᴴ *ᵥ e = 0 := by
      rw [h0, Matrix.conjTranspose_zero, Matrix.zero_mulVec]
    exact he_ne (hker e hx1 hx2)
  have hbkm := (real_twoSheetResolvent_coupledCorner_pos_iff P hP.eq hPT A hp hq).mpr hXne
  exact ⟨hpd, hXne, hbkm⟩

/-- Pair (F3, F4): Any nonzero odd commutator difference `F := odd P Ω` of two orthogonal
projections `P, Ω` simultaneously satisfies the `1/4` and `3/4` spectral bounds (`F3`)
and instantiates `RealTwoSheetBKMContext.ofOddAnticomm` with strictly positive BKM
resolvent pairing (`F4`). -/
theorem t3_f3_f4_orthogonal_projector_odd_feeds_bkm_context
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P Ω : Matrix ι ι ℝ)
    (hP : IsIdempotentElem P) (hPT : Pᵀ = P)
    (hΩ : IsIdempotentElem Ω) (hΩT : Ωᵀ = Ω)
    (hFne : odd P Ω ≠ 0) {p q : ℝ} (hp : 0 < p) (hq : 0 < q) :
    let F := odd P Ω
    let hPs : P.IsHermitian := Matrix.isHermitian_iff_isSymm.mpr hPT
    let hΩs : Ω.IsHermitian := Matrix.isHermitian_iff_isSymm.mpr hΩT
    let hFT : Fᵀ = F := by
      simpa only [Matrix.conjTranspose_eq_transpose_of_trivial] using
        (odd_isHermitian hPs hΩs).eq
    let hFOdd : P * F + F * P = F := (mem_odd_iff hP).mp ⟨Ω, rfl⟩
    let ctx := RealTwoSheetBKMContext.ofOddAnticomm P hP.eq hPT p q hp hq F hFT hFOdd
    ((1 / 4 : ℝ) • (1 : Matrix ι ι ℝ) - F * F).PosSemidef ∧
      ((1 : Matrix ι ι ℝ) - F * F).PosDef ∧
      ctx.twoSheetReal_posDef = ctx.twoSheetReal_posDef ∧
      0 < ctx.bkmPairing F F ∧
      ctx.bkmPairing F F = logDividedDifference p q * Matrix.trace (F * F) := by
  have hPs : P.IsHermitian := Matrix.isHermitian_iff_isSymm.mpr hPT
  have hΩs : Ω.IsHermitian := Matrix.isHermitian_iff_isSymm.mpr hΩT
  have hFT : (odd P Ω)ᵀ = odd P Ω := by
    simpa only [Matrix.conjTranspose_eq_transpose_of_trivial] using (odd_isHermitian hPs hΩs).eq
  have hFOdd : P * odd P Ω + odd P Ω * P = odd P Ω := (mem_odd_iff hP).mp ⟨Ω, rfl⟩
  let ctx := RealTwoSheetBKMContext.ofOddAnticomm P hP.eq hPT p q hp hq (odd P Ω) hFT hFOdd
  have hq := orthogonalProjector_F_sq_le_quarter hP hPs hΩ hΩs
  have h3q := orthogonalProjector_one_sub_F_sq_ge_three_quarters hP hPs hΩ hΩs
  have hbkmPos : 0 < ctx.bkmPairing (odd P Ω) (odd P Ω) := by
    change 0 < ctx.bkmPairing ctx.Φ ctx.Φ
    exact ctx.bkmPairing_self_pos hFne
  have hbkmTr : ctx.bkmPairing (odd P Ω) (odd P Ω) =
      logDividedDifference p q * Matrix.trace (odd P Ω * odd P Ω) := by
    change ctx.bkmPairing ctx.Φ ctx.Φ = _
    rw [ctx.bkmPairing_self_eq_quadratic, ctx.quadratic_trace]
    rfl
  exact ⟨hq.2.1, h3q.2, rfl, hbkmPos, hbkmTr⟩

/-- Pair (F3, F11): For a self-adjoint projector `P` and `star`-preserving derivations
`D₁, D₂` (witnessed on `mat3P, mat3S1, mat3S2`), each derivative `Dᵢ P` lies in the
positive-adjoint `F² ≥ 0` regime (`F2`/`F3`) while `P * [D₁ P, D₂ P] * P = star X₁ * X₂ - star X₂ * X₁` (`F11`). -/
theorem t3_f3_f11_projector_deriv_curvature_positive_adjoint :
    let D₁ := matrixInnerLieHom ℝ (Fin 3) mat3S1
    let D₂ := matrixInnerLieHom ℝ (Fin 3) mat3S2
    let DP₁ := (matrixDerivationsLane ℝ (Fin 3)).operatorAction D₁ mat3P
    let DP₂ := (matrixDerivationsLane ℝ (Fin 3)).operatorAction D₂ mat3P
    let X₁ := coneMinus mat3P DP₁
    let X₂ := coneMinus mat3P DP₂
    (DP₁ * DP₁).PosSemidef ∧
      (DP₂ * DP₂).PosSemidef ∧
      mat3P * (DP₁ * DP₂ - DP₂ * DP₁) * mat3P = star X₁ * X₂ - star X₂ * X₁ ∧
      mat3P * (DP₁ * DP₂ - DP₂ * DP₁) * mat3P ≠ 0 := by
  let D₁ := matrixInnerLieHom ℝ (Fin 3) mat3S1
  let D₂ := matrixInnerLieHom ℝ (Fin 3) mat3S2
  let DP₁ := (matrixDerivationsLane ℝ (Fin 3)).operatorAction D₁ mat3P
  let DP₂ := (matrixDerivationsLane ℝ (Fin 3)).operatorAction D₂ mat3P
  have hDP₁_herm : DP₁.IsHermitian := by
    have hs := mat3_inner_star_comm mat3S1_skewAdjoint mat3P
    rw [mat3P_selfAdjoint] at hs
    exact Matrix.isHermitian_iff_isSymm.mpr hs.symm
  have hDP₂_herm : DP₂.IsHermitian := by
    have hs := mat3_inner_star_comm mat3S2_skewAdjoint mat3P
    rw [mat3P_selfAdjoint] at hs
    exact Matrix.isHermitian_iff_isSymm.mpr hs.symm
  have hpsd1 : (DP₁ * DP₁).PosSemidef := by
    nth_rw 2 [← hDP₁_herm.eq]
    exact Matrix.posSemidef_self_mul_conjTranspose DP₁
  have hpsd2 : (DP₂ * DP₂).PosSemidef := by
    nth_rw 2 [← hDP₂_herm.eq]
    exact Matrix.posSemidef_self_mul_conjTranspose DP₂
  have hw := mat3_projected_curvature_star_ne_zero
  exact ⟨hpsd1, hpsd2, hw.1, hw.2⟩

/-- Pair (F4, F16): Finite-dimensional `Matrix ι ι ℝ` admits a faithful star trace and
strictly positive real BKM pairing while failing traciality when `p ≠ q`, paralleling
how a `1 < β` Bost–Connes KMS bridge requires a non-identity modular shift `σ_imag ≠ id`. -/
theorem t3_f4_f16_finite_trace_bkm_vs_kms_modular_shift
    {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
    {B_inf : Type*} [Ring B_inf] [Algebra ℝ B_inf]
    (sep : FiniteTraceBKMVsTypeIIISeparation ι B_inf)
    (hpq : sep.bkmContext.p ≠ sep.bkmContext.q)
    (hΦne : sep.bkmContext.Φ ≠ 0)
    (Sys : CliffordTowerKMSBridgeSystem)
    (C : BostConnesCuntzSystem Sys.completion.Carrier)
    {β : ℝ} (hβ : 1 < β)
    (h_scale : ∀ n : ℕ+, Sys.modular.σ_imag (S C n) = ((n : ℝ) ^ (-β)) • S C n) :
    IsEmpty (B_inf →ₐ[ℝ] Matrix ι ι ℝ) ∧
      Matrix.trace (sep.bkmContext.density *
          (conePlus sep.bkmContext.P sep.bkmContext.Φ *
            coneMinus sep.bkmContext.P sep.bkmContext.Φ)) ≠
        Matrix.trace (sep.bkmContext.density *
          (coneMinus sep.bkmContext.P sep.bkmContext.Φ *
            conePlus sep.bkmContext.P sep.bkmContext.Φ)) ∧
      Sys.modular.σ_imag ≠ AlgHom.id ℝ Sys.completion.Carrier := by
  exact ⟨sep.no_algHom_boundary_to_finite,
    (sep.nonTracial_density_when_weights_differ hpq hΦne).1,
    bostConnes_kms_requires_nontrivial_modular_shift Sys C hβ h_scale⟩

/-- Pair (F5, F15): In `Mat2R` (`F5`), `hyperbolicPlaneF` is associative and Krein-self-adjoint
with `F² = -1` (`¬ PosSemidef`), whereas in `ZornCarrier` (`F15`) multiplication is non-associative
and `mat2CToZornCarrier : Mat2C ≃ₗ[ℝ] ZornCarrier` cannot preserve multiplication. -/
theorem t3_f5_f15_hyperbolic_plane_vs_zorn_nonassociativity :
    (hyperbolicPlaneF * hyperbolicPlaneF = -(1 : Matrix (Fin 2) (Fin 2) ℝ) ∧
      ¬ (hyperbolicPlaneF * hyperbolicPlaneF).PosSemidef) ∧
      (∃ x y : ZornCarrier, leftMulEnd (x * y) ≠ leftMulEnd x ∘ₗ leftMulEnd y) ∧
      ¬ (∀ A B : InfoGeometry.Algebra.FiniteSpin.Mat2C,
          mat2CToZornCarrier (A * B) = mat2CToZornCarrier A * mat2CToZornCarrier B) := by
  refine ⟨⟨hyperbolicPlane_kreinSelfAdjoint_sq_neg_one.2.2.2.2.1,
      hyperbolicPlane_kreinSelfAdjoint_sq_neg_one.2.2.2.2.2⟩,
    leftMulEnd_not_multiplicative,
    mat2CToZornCarrier_not_multiplicative⟩

/-- Pair (F6, F9): On any associative `R`-algebra `A` with idempotent `P` killed by
`K : DerivationLieLane R A`, `MaurerCartanFrameTransport.peirceParityAlgEquiv P hP` agrees
with `CurvedZ2GradedDGA.ofPeirce` (`PeirceBoundaryComplex.parityAlgEquiv`), so the
even/odd Cartan parts `ϖ x, e x` of a flat 1-form obey `D.IsEven (ϖ x)`, `D.IsOdd (e x)`,
and `R_ϖ = -(e x * e y - e y * e x)`. -/
theorem t3_f6_f9_peirce_parity_dga_and_flat_cartan_splitting
    {R A : Type*} [CommRing R] [Ring A] [Algebra R A]
    (K : DerivationLieLane R A) {P F : A}
    (hP : P * P = P) (hKP : ∀ z : K.L, K.operatorAction z P = 0)
    (hF : F ∈ LinearMap.range (odd P))
    (θ : OneForm K) (hflat : connectionCurvature K θ = 0) (x y : K.L) :
    let D := CurvedZ2GradedDGA.ofPeirce (R := R) (A := A) hP hF
    let ϖ := peirceEvenOneForm K P θ
    let e := peirceOddOneForm K P θ
    (∀ a : A, D.parity a = peirceParityAlgEquiv (R := R) P hP a) ∧
      D.IsEven (ϖ x) ∧
      D.IsOdd (e x) ∧
      D.diff (e x) = F * e x + e x * F ∧
      connectionCurvature K ϖ x y = -(e x * e y - e y * e x) := by
  let D := CurvedZ2GradedDGA.ofPeirce (R := R) (A := A) hP hF
  let ϖ := peirceEvenOneForm K P θ
  let e := peirceOddOneForm K P θ
  have hpar : ∀ a : A, D.parity a = peirceParityAlgEquiv (R := R) P hP a := by
    intro a
    change conjugation P a = (2 * P - 1) * a * (2 * P - 1)
    rw [conjugation_apply, reflection]
  have hP2 : ∀ z : A, P * (P * z) = P * z := fun z => by rw [← mul_assoc, hP]
  have hϖ_even : D.IsEven (ϖ x) := by
    change D.parity (evenGrade P (θ x)) = evenGrade P (θ x)
    rw [hpar]
    change (2 * P - 1) * (P * θ x * P + (1 - P) * θ x * (1 - P)) * (2 * P - 1) =
      P * θ x * P + (1 - P) * θ x * (1 - P)
    simp only [two_mul, sub_mul, mul_sub, add_mul, mul_add, one_mul, mul_one, mul_assoc, hP, hP2]
    abel
  have he_odd : D.IsOdd (e x) := by
    change D.parity (oddGrade P (θ x)) = -oddGrade P (θ x)
    rw [hpar]
    change (2 * P - 1) * (P * θ x * (1 - P) + (1 - P) * θ x * P) * (2 * P - 1) =
      -(P * θ x * (1 - P) + (1 - P) * θ x * P)
    simp only [two_mul, sub_mul, mul_sub, add_mul, mul_add, one_mul, mul_one, mul_assoc, hP, hP2]
    abel
  have hdiff_e : D.diff (e x) = F * e x + e x * F := D.diff_of_odd he_odd
  have hcart := graded_split_flat_cartan_equations K hP hKP θ hflat x y
  exact ⟨hpar, hϖ_even, he_odd, hdiff_e, hcart.2.1⟩

/-- Pair (F6, F13): `cliffordTensorEquivMatrix` transports `CurvedZ2GradedDGA ℝ A` to
`Matrix (Fin (2^k)) (Fin (2^k)) A` via scalar embedding `Matrix.scalar _`, preserving
the parity involution, odd generator, and Bianchi identity `∂_F(F²) = 0`. -/
theorem t3_f6_f13_clifford_tensor_lifts_curved_dga
    (k : ℕ) {A : Type*} [Ring A] [Algebra ℝ A]
    (D : CurvedZ2GradedDGA ℝ A) :
    let e := cliffordTensorEquivMatrix k A
    let αMat : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) A ≃ₐ[ℝ]
        Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) A :=
      { toFun := fun X => Matrix.map X D.parity
        invFun := fun X => Matrix.map X D.parity
        left_inv := fun X => by ext i j; exact D.parity_involutive (X i j)
        right_inv := fun X => by ext i j; exact D.parity_involutive (X i j)
        map_mul' := fun M N => by
          ext i j
          simp [Matrix.mul_apply, map_sum, map_mul]
        map_add' := fun M N => by ext i j; simp
        commutes' := fun r => by
          ext i j
          simp only [Algebra.algebraMap_eq_smul_one, Matrix.map_apply]
          by_cases hij : i = j
          · subst hij
            simp [map_smul, map_one]
          · simp [hij] }
    let FMat : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) A :=
      e ((1 : Clsplit k) ⊗ₜ[ℝ] D.oddGen)
    let DMat : CurvedZ2GradedDGA ℝ (Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) A) :=
      { parity := αMat
        parity_involutive := fun M => by
          ext i j
          exact D.parity_involutive (M i j)
        oddGen := FMat
        oddGen_parity := by
          ext i j
          change D.parity (e ((1 : Clsplit k) ⊗ₜ[ℝ] D.oddGen) i j) =
            -(e ((1 : Clsplit k) ⊗ₜ[ℝ] D.oddGen) i j)
          rw [cliffordTensorEquivMatrix_one_tmul]
          by_cases hij : i = j
          · subst hij
            simp [Matrix.scalar_apply, D.oddGen_parity]
          · simp [Matrix.scalar_apply, hij] }
    DMat.curvature = Matrix.scalar (Fin (2 ^ k)) D.curvature ∧
      DMat.diff DMat.curvature = 0 ∧
      DMat.diff (e ((1 : Clsplit k) ⊗ₜ[ℝ] D.oddGen)) =
        Matrix.scalar (Fin (2 ^ k)) (2 * D.curvature) := by
  dsimp only
  let αMat : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) A ≃ₐ[ℝ]
      Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) A :=
    { toFun := fun X => Matrix.map X D.parity
      invFun := fun X => Matrix.map X D.parity
      left_inv := fun X => by ext i j; exact D.parity_involutive (X i j)
      right_inv := fun X => by ext i j; exact D.parity_involutive (X i j)
      map_mul' := fun M N => by
        ext i j
        simp [Matrix.mul_apply, map_sum, map_mul]
      map_add' := fun M N => by ext i j; simp
      commutes' := fun r => by
        ext i j
        simp only [Algebra.algebraMap_eq_smul_one, Matrix.map_apply]
        by_cases hij : i = j
        · subst hij
          simp [map_smul, map_one]
        · simp [hij] }
  let FMat : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) A :=
    cliffordTensorEquivMatrix k A ((1 : Clsplit k) ⊗ₜ[ℝ] D.oddGen)
  have hFMat_odd : αMat FMat = -FMat := by
    ext i j
    change D.parity (FMat i j) = -(FMat i j)
    dsimp [FMat]
    rw [cliffordTensorEquivMatrix_one_tmul]
    by_cases hij : i = j
    · subst hij
      simp [Matrix.scalar_apply, D.oddGen_parity]
    · simp [Matrix.scalar_apply, hij]
  let DMat : CurvedZ2GradedDGA ℝ (Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) A) :=
    { parity := αMat
      parity_involutive := fun M => by
        ext i j
        exact D.parity_involutive (M i j)
      oddGen := FMat
      oddGen_parity := hFMat_odd }
  have hcurv : DMat.curvature = Matrix.scalar (Fin (2 ^ k)) D.curvature := by
    change FMat * FMat = Matrix.scalar (Fin (2 ^ k)) (D.oddGen * D.oddGen)
    dsimp [FMat]
    rw [cliffordTensorEquivMatrix_one_tmul, ← map_mul]
    rfl
  refine ⟨hcurv, DMat.bianchi, ?_⟩
  change FMat * FMat - αMat FMat * FMat = Matrix.scalar (Fin (2 ^ k)) (2 * D.curvature)
  rw [hFMat_odd, neg_mul, sub_neg_eq_add]
  change DMat.curvature + DMat.curvature = Matrix.scalar (Fin (2 ^ k)) (2 * D.curvature)
  rw [hcurv, ← map_add, ← two_mul]

/-- Pair (F7, F8): Separates all three curvature regimes (`flatMat2DGA`, `centralMat2DGA`,
`nonCentralMat4DGA`) from ordinary ungraded commutator derivations `commutatorDeriv`,
including `G² = 0 ∧ D_G² ≠ 0` vs `flatMat2DGA.diff ^ 2 = 0`. -/
theorem t3_f7_f8_three_regimes_vs_commutator_deriv
    (H2 : Matrix (Fin 2) (Fin 2) ℝ) :
    IsFlatRegime flatMat2DGA.curvature ∧
      IsCentralNonzeroRegime centralMat2DGA.curvature ∧
      IsNonCentralRegime nonCentralMat4DGA.curvature ∧
      flatMat2DGA.diff ≠ commutatorDeriv (R := ℝ) H2 ∧
      centralMat2DGA.diff ≠ commutatorDeriv (R := ℝ) H2 ∧
      (atomNeg2 * atomNeg2 = 0 ∧ (commutatorDeriv (R := ℝ) atomNeg2) ^ 2 ≠ 0) ∧
      nonCentralMat4DGA.diff ^ 2 ≠ 0 := by
  exact ⟨flatMat2DGA_isFlat, centralMat2DGA_isCentralNonzero, nonCentralMat4DGA_isNonCentral,
    flatMat2DGA_diff_ne_commutatorDeriv H2, centralMat2DGA_diff_ne_commutatorDeriv H2,
    ⟨nilpotent_commutatorDeriv_sq_ne_zero.1, nilpotent_commutatorDeriv_sq_ne_zero.2.2.2.1⟩,
    nonCentralMat4DGA_diff_sq_ne_zero⟩

/-- Pair (F9, F10): Combines flat Maurer–Cartan graded splitting `θ = ϖ + e` (`F9`)
with `SolderingOneForm` equivariance and isotropy transformation (`F10`) on the concrete
`Witnesses` lane, showing homogeneous transformation of the odd component vs inhomogeneous
transformation of `ϖ`. -/
theorem t3_f9_f10_soldering_witness_flat_cartan_equations
    (g : (MaurerCartanFrameTransport.Witnesses.Mat2 × MaurerCartanFrameTransport.Witnesses.Mat2)ˣ)
    (h : peirceIsotropySubgroup _ MaurerCartanFrameTransport.Witnesses.witnessP)
    (x y : MaurerCartanFrameTransport.Witnesses.UpperAff2) :
    let K := MaurerCartanFrameTransport.Witnesses.witnessLane
    let P := MaurerCartanFrameTransport.Witnesses.witnessP
    let S := MaurerCartanFrameTransport.Witnesses.witnessSoldering
    let ϖ := peirceEvenOneForm K P (gaugeForm K g)
    let e := peirceOddOneForm K P (gaugeForm K g)
    gaugeForm K g = ϖ + e ∧
      connectionCurvature K ϖ x y = -(e x * e y - e y * e x) ∧
      peirceOddOneForm K P (gaugeForm K (g * (h : _))) x =
        frameTransport (h : _) (e x) ∧
      S.toOneForm (S.baseRightAct h x) = frameTransport (h : _) (S.toOneForm x) ∧
      LinearMap.ker S.toOneForm = ⊥ := by
  have hcart := gaugeForm_graded_split_cartan_equations
    MaurerCartanFrameTransport.Witnesses.witnessLane
    MaurerCartanFrameTransport.Witnesses.witnessP_idempotent
    MaurerCartanFrameTransport.Witnesses.witnessLane_kills_witnessP
    g x y
  have hiso := peirceSplit_gaugeForm_isotropy_transform
    MaurerCartanFrameTransport.Witnesses.witnessLane
    MaurerCartanFrameTransport.Witnesses.witnessP_idempotent
    MaurerCartanFrameTransport.Witnesses.witnessLane_kills_witnessP
    g h.2 x
  exact ⟨hcart.1, hcart.2.1, hiso.2,
    MaurerCartanFrameTransport.Witnesses.witnessSoldering.equivariant h x,
    MaurerCartanFrameTransport.Witnesses.witnessSoldering.ker_eq_bot⟩

/-- Pair (F9, F12): Combines the general nonabelian logarithmic-derivative cocycle law
`gaugeForm_product_general_separation` (`F12`) with graded splitting (`F9`): for any
`g, h : Aˣ`, `gaugeForm K (g * h)` obeys the cocycle defect identity, remains flat,
and splits into `ϖ + e` satisfying both Cartan structural equations. -/
theorem t3_f9_f12_gauge_product_cocycle_and_graded_splitting
    {R A : Type*} [CommRing R] [Ring A] [Algebra R A]
    (K : DerivationLieLane R A) {P : A} (hP : P * P = P)
    (hKP : ∀ z : K.L, K.operatorAction z P = 0)
    (g h : Aˣ) (x y : K.L) :
    let ϖ := peirceEvenOneForm K P (gaugeForm K (g * h))
    let e := peirceOddOneForm K P (gaugeForm K (g * h))
    gaugeForm K (g * h) x = frameTransport h (gaugeForm K g x) + gaugeForm K h x ∧
      gaugeForm K (g * h) x - (gaugeForm K g x + gaugeForm K h x) =
        frameTransport h (gaugeForm K g x) - gaugeForm K g x ∧
      connectionCurvature K ϖ x y = -(e x * e y - e y * e x) ∧
      exteriorDerivativeOne K e x y + (ϖ x * e y - e y * ϖ x) -
        (ϖ y * e x - e x * ϖ y) = 0 := by
  have hsep := gaugeForm_product_general_separation K g h x
  have hcart := gaugeForm_graded_split_cartan_equations K hP hKP (g * h) x y
  exact ⟨hsep.1, hsep.2.2.2.2.1, hcart.2.1, hcart.2.2⟩

/-- Pair (F10, F11): Contrasts `F11` (`lane_projected_exactCurvature`, which vanishes when
`K` kills `P` and is nonzero on `mat2P` / `mat3P` when `D_i P ≠ 0`) with `F10`
(`witnessSoldering.frameEquiv`), showing that `witnessLane` preserves `witnessP` while
`witnessSoldering` remains a nondegenerate bijection onto `peirceOddSubmodule`. -/
theorem t3_f10_f11_soldering_lane_and_projected_exact_curvature
    (x y : MaurerCartanFrameTransport.Witnesses.UpperAff2) :
    let K := MaurerCartanFrameTransport.Witnesses.witnessLane
    let P := MaurerCartanFrameTransport.Witnesses.witnessP
    let S := MaurerCartanFrameTransport.Witnesses.witnessSoldering
    P * connectionCurvature K (exteriorDerivativeZero K P) x y * P = 0 ∧
      Function.Bijective S.frameEquiv ∧
      LinearMap.range S.toOneForm = peirceOddSubmodule ℝ _ P ∧
      mat2P * ((matrixDerivationsLane ℝ (Fin 2)).operatorAction
          (matrixInnerLieHom ℝ (Fin 2) mat2E01) mat2P *
        (matrixDerivationsLane ℝ (Fin 2)).operatorAction
          (matrixInnerLieHom ℝ (Fin 2) mat2E10) mat2P -
        (matrixDerivationsLane ℝ (Fin 2)).operatorAction
          (matrixInnerLieHom ℝ (Fin 2) mat2E10) mat2P *
        (matrixDerivationsLane ℝ (Fin 2)).operatorAction
          (matrixInnerLieHom ℝ (Fin 2) mat2E01) mat2P) * mat2P ≠ 0 := by
  have hexact := lane_projected_exactCurvature
    MaurerCartanFrameTransport.Witnesses.witnessLane
    MaurerCartanFrameTransport.Witnesses.witnessP_idempotent x y
  have hx0 : MaurerCartanFrameTransport.Witnesses.witnessLane.operatorAction x
      MaurerCartanFrameTransport.Witnesses.witnessP = 0 :=
    MaurerCartanFrameTransport.Witnesses.witnessLane_kills_witnessP x
  have hy0 : MaurerCartanFrameTransport.Witnesses.witnessLane.operatorAction y
      MaurerCartanFrameTransport.Witnesses.witnessP = 0 :=
    MaurerCartanFrameTransport.Witnesses.witnessLane_kills_witnessP y
  rw [hx0, hy0] at hexact
  simp only [InfoGeometry.OperatorAlgebra.PeirceSpine.conePlus,
    InfoGeometry.OperatorAlgebra.PeirceSpine.coneMinus,
    mul_zero, zero_mul, sub_self] at hexact
  exact ⟨hexact,
    MaurerCartanFrameTransport.Witnesses.witnessSoldering.frameEquiv.bijective,
    MaurerCartanFrameTransport.Witnesses.witnessSoldering.range_eq_odd,
    mat2_projected_curvature_ne_zero⟩

/-- Pair (F13, F14): `cliffordTensorEquivMatrix` preserves the coefficient algebra `Cl3 1 1 1`
inside `Clsplit 1 ⊗[ℝ] Cl3 1 1 1 ≃ₐ[ℝ] Matrix (Fin 2) (Fin 2) (Cl3 1 1 1)`, while
`Cl3 1 1 1 ≃ₐ[ℝ] Mat2C` and `Clsplit 2 ≃ₐ[ℝ] Mat4R` are strictly non-isomorphic as real
algebras by dimension and center invariants. -/
theorem t3_f13_f14_clifford_tensor_tower_vs_cl30_signature :
    cliffordTensorEquivMatrix 1 (Cl3 1 1 1) ((1 : Clsplit 1) ⊗ₜ[ℝ] pseudoscalar30) =
        Matrix.scalar (Fin 2) pseudoscalar30 ∧
      (cliffordTensorEquivMatrix 1 (Cl3 1 1 1) ((1 : Clsplit 1) ⊗ₜ[ℝ] pseudoscalar30)) ^ 2 =
        -1 ∧
      Module.finrank ℝ (Cl3 1 1 1) = 8 ∧
      Module.finrank ℝ (Clsplit 2) = 16 ∧
      ¬ Nonempty (Cl3 1 1 1 ≃ₐ[ℝ] Clsplit 2) := by
  have h1 : cliffordTensorEquivMatrix 1 (Cl3 1 1 1) ((1 : Clsplit 1) ⊗ₜ[ℝ] pseudoscalar30) =
      Matrix.scalar (Fin 2) pseudoscalar30 := by
    simpa using cliffordTensorEquivMatrix_one_tmul 1 (Cl3 1 1 1) pseudoscalar30
  have hsq :
      (cliffordTensorEquivMatrix 1 (Cl3 1 1 1) ((1 : Clsplit 1) ⊗ₜ[ℝ] pseudoscalar30)) ^ 2 =
        -1 := by
    rw [h1, ← map_pow, pseudoscalar30_sq, map_neg, map_one]
  exact ⟨h1, hsq, cl30_finrank, cl22_finrank, cl30_not_algEquiv_cl22⟩

/-- Pair (F13, F15): Composes `splitTowerEquivMatrix 3 : Clsplit 3 ≃ₐ[ℝ] Mat8R` with
`mat8EquivEndZorn : Mat8R ≃ₐ[ℝ] EndZorn` (`F13 × F15`) and lifts `EndZorn` into
`Clsplit 1 ⊗[ℝ] EndZorn ≃ₐ[ℝ] Matrix (Fin 2) (Fin 2) EndZorn`, preserving the Zorn
left-regular non-multiplicativity obstruction. -/
theorem t3_f13_f15_clifford_tensor_zorn_endomorphism_and_nonmult :
    Nonempty (Clsplit 3 ≃ₐ[ℝ] EndZorn) ∧
      (∃ x y : ZornCarrier,
        cliffordTensorEquivMatrix 1 EndZorn ((1 : Clsplit 1) ⊗ₜ[ℝ] leftMulEnd (x * y)) ≠
          cliffordTensorEquivMatrix 1 EndZorn
            ((1 : Clsplit 1) ⊗ₜ[ℝ] (leftMulEnd x ∘ₗ leftMulEnd y))) ∧
      (∃ x y : ZornCarrier, leftMulMat8 (x * y) ≠ leftMulMat8 x * leftMulMat8 y) := by
  have heq : Nonempty (Clsplit 3 ≃ₐ[ℝ] EndZorn) := by
    have hdim : (2 ^ 3 : ℕ) = 8 := by norm_num
    let e8 : Matrix (Fin (2 ^ 3)) (Fin (2 ^ 3)) ℝ ≃ₐ[ℝ] Mat8R :=
      Matrix.reindexAlgEquiv ℝ ℝ (Fin.castOrderIso hdim).toEquiv
    exact ⟨(splitTowerEquivMatrix 3).trans (e8.trans mat8EquivEndZorn)⟩
  obtain ⟨x, y, hxy⟩ := leftMulEnd_not_multiplicative
  refine ⟨heq, ⟨x, y, ?_⟩, leftMulMat8_not_multiplicative⟩
  intro hmat
  apply hxy
  exact (one_tmul_inj 1 EndZorn).mp ((cliffordTensorEquivMatrix 1 EndZorn).injective hmat)

/-- Pair (F14, F15): Both `Cl3 1 1 1 ≃ₐ[ℝ] Mat2C` (`F14`) and `ZornCarrier` (`F15`) are
8-dimensional real noncommutative spaces, yet `Mat2C` is associative (with central
`z² = -1`) whereas no surjective multiplicative map exists from `Mat2C` to `ZornCarrier`. -/
theorem t3_f14_f15_mat2C_real_clifford_vs_zorn_nonmultiplicativity :
    Module.finrank ℝ (Cl3 1 1 1) = Module.finrank ℝ ZornCarrier ∧
      (∃ z ∈ Subalgebra.center ℝ (Cl3 1 1 1), z ^ 2 = -1) ∧
      ¬ (∃ f : InfoGeometry.Algebra.FiniteSpin.Mat2C → ZornCarrier,
          Function.Surjective f ∧ ∀ A B, f (A * B) = f A * f B) := by
  have hdimZ : Module.finrank ℝ ZornCarrier = 8 := by
    have h2 : Module.finrank ℝ SplitCarrier = 8 := splitCarrier_finrank
    rw [← h2]
    exact algToCarrierEquiv.symm.finrank_eq
  exact ⟨cl30_finrank.trans hdimZ.symm,
    cl30_exists_central_sq_neg_one,
    no_surjective_multiplicative_mat2C_to_zornCarrier⟩

/-- Pair (F13, F16): Bridges `cliffordTensorEquivMatrix k Limit` (`F13`) with the inductive
colimit `Cl11TensorTowerLimit.Limit` and `bostConnes_colimit_kms_partition_bridge`
(`F16`), verifying stage-bond compatibility of the GNS limit state. -/
theorem t3_f13_f16_clifford_tensor_to_tower_limit_kms
    (k n : ℕ) (X : Stage n)
    (Sys : CliffordTowerKMSBridgeSystem)
    (C : BostConnesCuntzSystem Sys.completion.Carrier)
    {β : ℝ} (hβ : 1 < β)
    (h_scale : ∀ m : ℕ+, Sys.modular.σ_imag (S C m) = ((m : ℝ) ^ (-β)) • S C m)
    (h_scale_star : ∀ m : ℕ+, Sys.modular.σ_imag (star (S C m)) = ((m : ℝ) ^ β) • star (S C m)) :
    cliffordTensorEquivMatrix k Limit ((1 : Clsplit k) ⊗ₜ[ℝ] ofStage (n + 1) (stageBond n X)) =
        cliffordTensorEquivMatrix k Limit ((1 : Clsplit k) ⊗ₜ[ℝ] ofStage n X) ∧
      Sys.limitState (ofStage (n + 1) (stageBond n X)) = Sys.limitState (ofStage n X) ∧
      (∑' m : ℕ+, (bostConnesKMSProjectionState Sys C hβ h_scale h_scale_star).φ
        (S C m * star (S C m))) = 1 := by
  have h1 : cliffordTensorEquivMatrix k Limit ((1 : Clsplit k) ⊗ₜ[ℝ] ofStage (n + 1) (stageBond n X)) =
      cliffordTensorEquivMatrix k Limit ((1 : Clsplit k) ⊗ₜ[ℝ] ofStage n X) := by
    have hbond : ofStage (n + 1) (stageBond n X) = ofStage n X :=
      ofStage_apply_bond n X
    rw [hbond]
  have hbridge := bostConnes_colimit_kms_partition_bridge Sys C hβ h_scale h_scale_star
  exact ⟨h1, hbridge.2.2.2.2.2 n X, hbridge.2.2.1⟩

/-- Pair (F15, F16): Contrasts the non-associative Zorn associator defect `[L_x, R_y] = assoc`
and `G_{2(2)}` derivations (`F15`) with the associative noncommutative Clifford inductive limit
`Cl11TensorTowerLimit.Limit` supporting `BostConnesColimitKMSBridge` (`F16`). -/
theorem t3_f15_f16_zorn_g2_vs_clifford_limit_associativity
    (x y z : ZornCarrier) :
    lrComm x y z = zornAssociator x y z ∧
      Module.finrank ℝ canonicalZornDerivations = 14 ∧
      (∃ u v : ZornCarrier, leftMulEnd (u * v) ≠ leftMulEnd u ∘ₗ leftMulEnd v) ∧
      (∃ a b : Limit, a * b ≠ b * a) ∧
      (∀ (n : ℕ) (X : Stage n),
        traceKMSBridgeModel.limitState (ofStage (n + 1) (stageBond n X)) =
          traceKMSBridgeModel.limitState (ofStage n X)) := by
  refine ⟨lrComm_apply_eq_associator x y z,
    g2_derivation_finrank_and_standard_span.1,
    leftMulEnd_not_multiplicative,
    limit_noncommutative,
    fun n X => ?_⟩
  rw [CliffordTowerKMSBridgeSystem.limitState,
    traceKMSBridgeModel.gns.limitState_stage_readout (n + 1) (stageBond n X),
    traceKMSBridgeModel.gns.limitState_stage_readout n X,
    traceKMSBridgeModel.gns.limitState_stage_compat n X]

end PolarizedZ2E2E.Tier3

section E2EAxiomAudit
open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut audited : Nat := 0
  for (name, info) in env.constants do
    if (env.getModuleIdxFor? name).isSome then continue
    if name.toString.startsWith "_private." then continue
    match info with
    | .thmInfo _ | .defnInfo _ =>
      if info.isUnsafe || info.isPartial then
        throwError "Unsafe or partial E2E declaration: {name}"
      let axioms ← Lean.collectAxioms name
      for ax in axioms do
        unless allowed.contains ax do
          throwError "Disallowed axiom {ax} in E2E declaration {name}"
      audited := audited + 1
    | .axiomInfo _ =>
      throwError "Disallowed axiom declaration in E2E file: {name}"
    | _ => pure ()
  if audited == 0 then
    throwError "E2EAxiomAudit found 0 declarations in current module"
  logInfo m!"E2E_AXIOM_AUDIT_PASS: {audited} local declarations verified"
end E2EAxiomAudit
