import InfoGeometry.Clifford.Cl55WittOrthogonalReflections

namespace InfoGeometry.Clifford.Clifford55

/-!
The full orthogonal group of the Witt carrier is represented as the subgroup
of the native `LinearEquiv` group preserving `Q55`.  The separate subgroup
below is generated by the five explicitly proved coordinate reflections.
-/

def orthogonalGroup55 : Subgroup (V55 ≃ₗ[ℝ] V55) where
  carrier := {g | ∀ x, Q55 (g x) = Q55 x}
  one_mem' := by
    intro x
    rfl
  mul_mem' := by
    intro f g hf hg x
    rw [LinearEquiv.mul_apply, hf, hg]
  inv_mem' := by
    intro f hf x
    have h := hf (f⁻¹ x)
    simpa using h.symm

noncomputable def coordinateReflectionGenerator (i : Fin 5) : orthogonalGroup55 :=
  ⟨negativeReflectionLinearEquiv i, negativeReflection_preserves_Q55 i⟩

noncomputable def globalSheetReflectionGenerator : orthogonalGroup55 :=
  ⟨globalSheetReflectionLinearEquiv, globalSheetReflection_preserves_Q55⟩

noncomputable def coordinateReflectionSubgroup :
    Subgroup orthogonalGroup55 :=
  Subgroup.closure (Set.range coordinateReflectionGenerator)

theorem coordinateReflectionGenerator_mem_coordinateReflectionSubgroup
    (i : Fin 5) :
    coordinateReflectionGenerator i ∈ coordinateReflectionSubgroup := by
  exact Subgroup.subset_closure ⟨i, rfl⟩

theorem globalSheetReflectionGenerator_coe_mem_orthogonalGroup55 :
    (globalSheetReflectionGenerator : V55 ≃ₗ[ℝ] V55) ∈ orthogonalGroup55 :=
  globalSheetReflectionGenerator.property

theorem globalSheetReflectionGenerator_mem_coordinateReflectionSubgroup :
    globalSheetReflectionGenerator ∈ coordinateReflectionSubgroup := by
  have h0 := coordinateReflectionGenerator_mem_coordinateReflectionSubgroup 0
  have h1 := coordinateReflectionGenerator_mem_coordinateReflectionSubgroup 1
  have h2 := coordinateReflectionGenerator_mem_coordinateReflectionSubgroup 2
  have h3 := coordinateReflectionGenerator_mem_coordinateReflectionSubgroup 3
  have h4 := coordinateReflectionGenerator_mem_coordinateReflectionSubgroup 4
  have hprod :
      coordinateReflectionGenerator 0 * coordinateReflectionGenerator 1 *
          coordinateReflectionGenerator 2 * coordinateReflectionGenerator 3 *
          coordinateReflectionGenerator 4 ∈ coordinateReflectionSubgroup := by
    exact coordinateReflectionSubgroup.mul_mem
      (coordinateReflectionSubgroup.mul_mem
        (coordinateReflectionSubgroup.mul_mem
          (coordinateReflectionSubgroup.mul_mem h0 h1) h2) h3) h4
  have heq :
      coordinateReflectionGenerator 0 * coordinateReflectionGenerator 1 *
          coordinateReflectionGenerator 2 * coordinateReflectionGenerator 3 *
          coordinateReflectionGenerator 4 = globalSheetReflectionGenerator := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
    apply Prod.ext
    · rfl
    · funext j
      fin_cases j <;>
        simp [coordinateReflectionGenerator, globalSheetReflectionGenerator,
          negativeReflectionLinearEquiv_apply, negativeReflection,
          globalSheetReflectionLinearEquiv, globalSheetReflection]
  rw [← heq]
  exact hprod

end InfoGeometry.Clifford.Clifford55
