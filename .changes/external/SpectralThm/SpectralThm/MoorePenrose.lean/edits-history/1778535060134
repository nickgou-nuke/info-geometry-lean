{"file":"/home/goutev/repos/info-geometry-lean/external/SpectralThm/SpectralThm/MoorePenrose.lean","time":1778535060134,"baseTime":1778535059214,"changes":[{"range":{"start":{"line":157,"character":0},"end":{"line":157,"character":0}},"text":"/-- Restriction of `A` to the orthogonal complement of its kernel. -/\nnoncomputable def mpRestricted (A : E →L[𝕜] E) : (A.ker)ᗮ →L[𝕜] A.range :=\n  (A.comp (A.ker)ᗮ.subtypeL).codRestrict A.range (fun x => LinearMap.mem_range.mpr ⟨x.1, rfl⟩)\n\n/-- The restricted operator has a trivial kernel. -/\ntheorem mpRestricted_ker_eq_bot (A : E →L[𝕜] E) :\n    (mpRestricted A : (A.ker)ᗮ →ₗ[𝕜] A.range).ker = ⊥ := by\n  rw [LinearMap.ker_eq_bot]\n  intro x y hxy\n  apply Subtype.ext\n  have h_val : A x.1 = A y.1 := by\n    have h := congrArg Subtype.val hxy\n    simpa [mpRestricted] using h\n  have h_mem : (x.1 - y.1 : E) ∈ A.ker := by\n    change A (x.1 - y.1) = 0\n    rw [map_sub, h_val, sub_self]\n  have h_mem_Kp : (x.1 - y.1 : E) ∈ (A.ker)ᗮ :=\n    Submodule.sub_mem _ x.2 y.2\n  have h_zero : (x.1 - y.1 : E) = 0 := by\n    have hmem : (x.1 - y.1 : E) ∈ A.ker ⊓ (A.ker)ᗮ := ⟨h_mem, h_mem_Kp⟩\n    simpa [Submodule.inf_orthogonal_eq_bot (A.ker)] using hmem\n  exact sub_eq_zero.mp h_zero\n\n/-- The restricted operator is surjective. -/\ntheorem mpRestricted_range_eq_top (A : E →L[𝕜] E) :\n    (mpRestricted A : (A.ker)ᗮ →ₗ[𝕜] A.range).range = ⊤ := by\n  rw [LinearMap.range_eq_top]\n  intro y\n  rcases y with ⟨y, hy⟩\n  rcases hy with ⟨x, rfl⟩\n  refine ⟨(Submodule.orthogonalProjection (A.ker)ᗮ) x, ?_⟩\n  apply Subtype.ext\n  let K := A.ker\n  let Kp : Submodule 𝕜 E := Kᗮ\n  have hA_on_Kp : ∀ x : E, A (Kp.starProjection x) = A x := by\n    intro x\n    have hsplit :\n        K.starProjection x + Kp.starProjection x = x :=\n      Submodule.starProjection_add_starProjection_orthogonal (K := K) x\n    have hKzero : A (K.starProjection x) = 0 := by\n      exact (Submodule.starProjection_apply_mem K x)\n    calc\n      A (Kp.starProjection x)\n          = 0 + A (Kp.starProjection x) := by rw [zero_add]\n      _ = A (K.starProjection x) + A (Kp.starProjection x) := by rw [hKzero]\n      _ = A (K.starProjection x + Kp.starProjection x) := by rw [map_add]\n      _ = A x := by rw [hsplit]\n  exact hA_on_Kp x\n\n/-- The continuous linear equivalence between `(ker A)ᗮ` and `range A`. -/\nnoncomputable def mpEquiv (A : E →L[𝕜] E) (hClosedRange : IsClosed (A.range : Set E)) :\n    (A.ker)ᗮ ≃L[𝕜] A.range :=\n  haveI : CompleteSpace (A.ker)ᗮ := inferInstance\n  haveI : CompleteSpace A.range := hClosedRange.completeSpace_coe\n  ContinuousLinearEquiv.ofBijective\n    (mpRestricted A)\n    (mpRestricted_ker_eq_bot A)\n    (mpRestricted_range_eq_top A)\n\n/--\n  Constructive Moore--Penrose inverse for an endomorphism with closed range.\n  -/\nnoncomputable def moorePenroseInverse\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) : E →L[𝕜] E :=\n  let Kp : Submodule 𝕜 E := (A.ker)ᗮ\n  let R : Submodule 𝕜 E := A.range\n  haveI : CompleteSpace R := hClosedRange.completeSpace_coe\n  Kp.subtypeL.comp ((mpEquiv A hClosedRange).symm.toContinuousLinearMap.comp (Submodule.orthogonalProjection R))\n\n/-- Proof that the construction satisfies the Moore--Penrose identities. -/\ntheorem isMoorePenroseInverse_moorePenroseInverse\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    IsMoorePenroseInverse A (moorePenroseInverse A hClosedRange) := by\n  let B := moorePenroseInverse A hClosedRange\n  let K : Submodule 𝕜 E := A.ker\n  let Kp : Submodule 𝕜 E := Kᗮ\n  let R : Submodule 𝕜 E := A.range\n  let e := mpEquiv A hClosedRange\n  haveI : CompleteSpace Kp := inferInstance\n  haveI : CompleteSpace R := hClosedRange.completeSpace_coe\n  haveI : Kp.HasOrthogonalProjection := inferInstance\n  haveI : R.HasOrthogonalProjection := inferInstance\n\n  have hA_on_Kp : ∀ x : E, A (Kp.starProjection x) = A x := by\n    intro x\n    have hsplit : K.starProjection x + Kp.starProjection x = x :=\n      Submodule.starProjection_add_starProjection_orthogonal (K := K) x\n    have hKzero : A (K.starProjection x) = 0 := by\n      exact (Submodule.starProjection_apply_mem K x)\n    calc\n      A (Kp.starProjection x) = 0 + A (Kp.starProjection x) := by rw [zero_add]\n      _ = A (K.starProjection x) + A (Kp.starProjection x) := by rw [hKzero]\n      _ = A (K.starProjection x + Kp.starProjection x) := by rw [map_add]\n      _ = A x := by rw [hsplit]\n\n  have hAB_apply : ∀ y : E, A (B y) = R.starProjection y := by\n    intro y\n    simp only [B, moorePenroseInverse, ContinuousLinearMap.comp_apply]\n    let yR := Submodule.orthogonalProjection R y\n    have h_eval := e.apply_symm_apply yR\n    have h_val : A (e.symm yR : E) = (e (e.symm yR) : E) := rfl\n    show A (↑(e.symm yR)) = R.starProjection y\n    rw [h_val, h_eval]\n    rfl\n\n  have hBA_apply : ∀ x : E, B (A x) = Kp.starProjection x := by\n    intro x\n    simp only [B, moorePenroseInverse, ContinuousLinearMap.comp_apply]\n    let xKp := Submodule.orthogonalProjection Kp x\n    have hAx_mem : A x ∈ R := ⟨x, rfl⟩\n    have hproj : Submodule.orthogonalProjection R (A x) = (⟨A x, hAx_mem⟩ : R) := by\n      apply Subtype.ext\n      exact Submodule.starProjection_mem_subspace_eq_self (K := R) ⟨A x, hAx_mem⟩\n    have hTz : e xKp = (⟨A x, hAx_mem⟩ : R) := by\n      apply Subtype.ext\n      exact hA_on_Kp x\n    have hsymm : e.symm (⟨A x, hAx_mem⟩ : R) = xKp := by\n      rw [← hTz]\n      exact e.symm_apply_apply xKp\n    show (↑(e.symm (Submodule.orthogonalProjection R (A x)))) = Kp.starProjection x\n    rw [hproj, hsymm]\n    rfl\n\n  refine IsMoorePenroseInverse.mk ?_ ?_ ?_ ?_\n  · -- ABA = A\n    ext x\n    rw [ContinuousLinearMap.mul_apply, ContinuousLinearMap.mul_apply, hAB_apply]\n    exact Submodule.starProjection_mem_subspace_eq_self (K := R) ⟨A x, ⟨x, rfl⟩⟩\n  · -- BAB = B\n    ext y\n    rw [ContinuousLinearMap.mul_apply, ContinuousLinearMap.mul_apply, hBA_apply]\n    have hBmem : B y ∈ Kp := (e.symm (Submodule.orthogonalProjection R y)).property\n    exact Submodule.starProjection_mem_subspace_eq_self (K := Kp) ⟨B y, hBmem⟩\n  · -- star (AB) = AB\n    have hAB : A * B = R.starProjection := by ext y; exact hAB_apply y\n    rw [hAB]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection R)\n  · -- star (BA) = BA\n    have hBA : B * A = Kp.starProjection := by ext x; exact hBA_apply x\n    rw [hBA]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection Kp)\n\n","rangeOffset":5942,"rangeLength":0}]}