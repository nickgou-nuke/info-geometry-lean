{"type":"new","contents":"import Mathlib.Analysis.Convex.Cone.Dual\nimport Mathlib.Analysis.Convex.Cone.InnerDual\nimport Mathlib.LinearAlgebra.Projectivization.Basic\nimport Mathlib.Topology.Algebra.Module.PerfectPairing\n\n/-!\n# Self-dual cones and projective ray spaces\n\nMathlib-rooted cone and projective-ray primitives.  The cone laws are explicit\nLean fields over Mathlib's `ProperCone`, `ProperCone.innerDual`,\n`ProperCone.dual`, and `LinearMap.IsContPerfPair`; theorem readbacks below keep\nlater projective modules from treating the structures as external authority.\n-/\n\nnamespace InfoGeometry.Convex\n\nopen scoped LinearAlgebra.Projectivization\n\nsection Inner\n\nvariable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n\n/-- A proper cone equal to its inner dual in a real Hilbert space. -/\nstructure SelfDualCone (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [CompleteSpace E] where\n  cone : ProperCone ℝ E\n  self_dual : ProperCone.innerDual (cone : Set E) = cone\n\n/-- Mathlib-rooted readback for Hilbert-space self-duality. -/\n@[simp] lemma SelfDualCone.innerDual_eq [CompleteSpace E] (C : SelfDualCone E) :\n    ProperCone.innerDual (C.cone : Set E) = C.cone :=\n  C.self_dual\n\n/-- Projective rays represented by nonzero cone points. -/\ndef ConeRay (C : ProperCone ℝ E) : Type _ :=\n  {ℓ : ℙ ℝ E // ∃ v : E, ∃ hv : v ≠ 0, v ∈ (C : Set E) ∧ Projectivization.mk ℝ v hv = ℓ}\n\n/-- Projective rays represented by nonzero interior cone points. -/\ndef ConeInteriorRay (C : ProperCone ℝ E) : Type _ :=\n  {ℓ : ℙ ℝ E // ∃ v : E, ∃ hv : v ≠ 0, v ∈ interior (C : Set E) ∧\n    Projectivization.mk ℝ v hv = ℓ}\n\n/-- Read back a concrete nonzero representative for a cone ray. -/\nlemma ConeRay.exists_rep {C : ProperCone ℝ E} (ℓ : ConeRay (E := E) C) :\n    ∃ v : E, ∃ hv : v ≠ 0, v ∈ (C : Set E) ∧ Projectivization.mk ℝ v hv = ℓ.1 :=\n  ℓ.2\n\n/-- Read back a concrete nonzero interior representative for an interior cone ray. -/\nlemma ConeInteriorRay.exists_rep {C : ProperCone ℝ E} (ℓ : ConeInteriorRay (E := E) C) :\n    ∃ v : E, ∃ hv : v ≠ 0, v ∈ interior (C : Set E) ∧\n      Projectivization.mk ℝ v hv = ℓ.1 :=\n  ℓ.2\n\nend Inner\n\nsection Pairing\n\nvariable {E F : Type*}\nvariable [AddCommGroup E] [Module ℝ E] [TopologicalSpace E]\nvariable [AddCommGroup F] [Module ℝ F] [TopologicalSpace F]\n\n/-- Self-dual cone data expressed through a Mathlib continuous perfect pairing. -/\nstructure PairedSelfDualCone where\n  pairing : E →ₗ[ℝ] F →ₗ[ℝ] ℝ\n  is_perf : pairing.IsContPerfPair\n  coneE : ProperCone ℝ E\n  coneF : ProperCone ℝ F\n  dual_eq : ProperCone.dual pairing coneE = coneF\n\ninstance (C : PairedSelfDualCone (E := E) (F := F)) : C.pairing.IsContPerfPair := C.is_perf\n\n/-- Mathlib-rooted readback for the continuous perfect pairing. -/\ntheorem PairedSelfDualCone.isContPerfPair (C : PairedSelfDualCone (E := E) (F := F)) :\n    C.pairing.IsContPerfPair :=\n  C.is_perf\n\n/-- Mathlib-rooted readback for paired cone duality. -/\n@[simp] theorem PairedSelfDualCone.dual_eq_coneF (C : PairedSelfDualCone (E := E) (F := F)) :\n    ProperCone.dual C.pairing C.coneE = C.coneF :=\n  C.dual_eq\n\nend Pairing\n\nend InfoGeometry.Convex\n","mtime":1778318543728}