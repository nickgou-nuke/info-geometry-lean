/-!
# Cockle's Coquaternions, the Cl(1,1) Planar Triad, and Chiral Lightcone Grading

This module formalizes the geometric algebra of the 2D Lorentzian plane $\mathrm{Cl}(1,1)$,
isomorphic to Cockle's split-quaternions (coquaternions) and represented in the real matrix algebra $M_2(\mathbb{R})$:

1. **The Coquaternion Carrier and Clifford Basis**:
   - Generators: $\{1, e_1, e_2, \omega\}$ where $e_1^2 = +1$ (spacelike), $e_2^2 = -1$ (timelike),
     and $\omega = e_1 e_2$ is the chiral bivector / pseudoscalar satisfying $\omega^2 = +1$.
   - Associative ring structure over any commutative ring $R$.

2. **The Triad of Planar Number Systems**:
   Within this single 4-dimensional real algebra, all three classical planar geometries
   coexist as genuine subrings:
   - **Elliptic Plane (Complex Numbers $\mathbb{C}$)**:
     Generated by $i = e_2$ with $i^2 = -1$.
   - **Hyperbolic Plane (Split-Complex Numbers $\mathbb{R}[j]$)**:
     Generated by $j = \omega$ with $j^2 = +1$.
   - **Parabolic Plane (Dual Numbers $\mathbb{R}[\epsilon]$)**:
     Generated by the lightcone nilpotent element $\epsilon = e_2 + \omega = i + j$ with $\epsilon^2 = 0$.

3. **Chiral Lightcone Projectors and $\mathbb{Z}_2$-Grading**:
   - The chiral volume element $\Gamma = \omega$ generates the even/odd grading:
     $\Gamma x \Gamma = +x$ for even elements, and $\Gamma x \Gamma = -x$ for odd elements.
   - Orthogonal idempotent projectors $\mathcal{P}_\pm = \frac{1 \pm \omega}{2}$ satisfying
     $\mathcal{P}_+^2 = \mathcal{P}_+$, $\mathcal{P}_-^2 = \mathcal{P}_-$, $\mathcal{P}_+ \mathcal{P}_- = 0$,
     and $\mathcal{P}_+ + \mathcal{P}_- = 1$.
   - Lightcone ladder nilpotency: $(\mathcal{P}_+ e_1)^2 = 0$.

4. **Algebra Representation in Matrix Algebra $M_2(R)$ and Determinant Norm Preservation**:
   - Concrete matrix representation map $\Psi : \mathbb{H}_{\mathrm{split}} \to M_2(R)$.
   - Preserves addition, scalar multiplication, identity, and matrix multiplication.
   - Determinant matches the coquaternion reduced pseudo-norm:
     $\det(\Psi(q)) = s^2 - x^2 + y^2 - z^2$.
-/

namespace InfoGeometry.Clifford.Coquaternion

open Matrix

/-- Cockle's split-quaternion (coquaternion) carrier over a ring R:
    q = s • 1 + x • e₁ + y • e₂ + z • ω. -/
@[ext]
structure Coquaternion (R : Type*) where
  s : R  -- scalar component (1)
  x : R  -- spacelike vector component (e₁, e₁² = +1)
  y : R  -- timelike vector component (e₂, e₂² = -1)
  z : R  -- chiral bivector component (ω = e₁e₂, ω² = +1)
  deriving DecidableEq, Repr, Inhabited

variable {R : Type*} [Ring R]

/-- Non-commutativity ground witness (`2 × 2` spin algebra over `ℂ`). -/
theorem exists_noncomm_pair :
    ∃ a b : _root_.InfoGeometry.Algebra.FiniteSpin.Mat2C, a * b ≠ b * a :=
  ⟨_root_.InfoGeometry.Algebra.FiniteSpin.J_plus,
   _root_.InfoGeometry.Algebra.FiniteSpin.J_minus,
   _root_.InfoGeometry.Algebra.FiniteSpin.j_plus_j_minus_ne⟩

namespace Coquaternion

/-- The identity coquaternion: 1 • 1. -/
def one : Coquaternion R := ⟨1, 0, 0, 0⟩

/-- The zero coquaternion. -/
def zero : Coquaternion R := ⟨0, 0, 0, 0⟩

/-- The spacelike generator e₁: e₁² = +1. -/
def e1 : Coquaternion R := ⟨0, 1, 0, 0⟩

/-- The timelike generator e₂: e₂² = -1. -/
def e2 : Coquaternion R := ⟨0, 0, 1, 0⟩

/-- The chiral bivector / pseudoscalar ω = e₁e₂: ω² = +1. -/
def omega : Coquaternion R := ⟨0, 0, 0, 1⟩

/-- Addition of coquaternions. -/
def add (p q : Coquaternion R) : Coquaternion R :=
  ⟨p.s + q.s, p.x + q.x, p.y + q.y, p.z + q.z⟩

/-- Negation of coquaternions. -/
def neg (q : Coquaternion R) : Coquaternion R :=
  ⟨-q.s, -q.x, -q.y, -q.z⟩

/-- Subtraction of coquaternions. -/
def sub (p q : Coquaternion R) : Coquaternion R :=
  ⟨p.s - q.s, p.x - q.x, p.y - q.y, p.z - q.z⟩

/-- Scalar multiplication. -/
def smul (c : R) (q : Coquaternion R) : Coquaternion R :=
  ⟨c * q.s, c * q.x, c * q.y, c * q.z⟩

/-- Multiplication in Cl(1,1) derived from e₁² = 1, e₂² = -1, {e₁, e₂} = 0:
    (s₁ + x₁e₁ + y₁e₂ + z₁ω)(s₂ + x₂e₁ + y₂e₂ + z₂ω) =
      (s₁s₂ + x₁x₂ - y₁y₂ + z₁z₂)
    + (s₁x₂ + x₁s₂ + y₁z₂ - z₁y₂) e₁
    + (s₁y₂ + y₁s₂ + x₁z₂ - z₁x₂) e₂
    + (s₁z₂ + z₁s₂ + x₁y₂ - y₁x₂) ω. -/
def mul (p q : Coquaternion R) : Coquaternion R :=
  ⟨p.s * q.s + p.x * q.x - p.y * q.y + p.z * q.z,
   p.s * q.x + p.x * q.s + p.y * q.z - p.z * q.y,
   p.s * q.y + p.y * q.s + p.x * q.z - p.z * q.x,
   p.s * q.z + p.z * q.s + p.x * q.y - p.y * q.x⟩

instance : Zero (Coquaternion R) := ⟨zero⟩
instance : One (Coquaternion R) := ⟨one⟩
instance : Add (Coquaternion R) := ⟨add⟩
instance : Neg (Coquaternion R) := ⟨neg⟩
instance : Sub (Coquaternion R) := ⟨sub⟩
instance : Mul (Coquaternion R) := ⟨mul⟩
instance : SMul R (Coquaternion R) := ⟨smul⟩

@[simp] theorem zero_s : (0 : Coquaternion R).s = 0 := rfl
@[simp] theorem zero_x : (0 : Coquaternion R).x = 0 := rfl
@[simp] theorem zero_y : (0 : Coquaternion R).y = 0 := rfl
@[simp] theorem zero_z : (0 : Coquaternion R).z = 0 := rfl

@[simp] theorem one_s : (1 : Coquaternion R).s = 1 := rfl
@[simp] theorem one_x : (1 : Coquaternion R).x = 0 := rfl
@[simp] theorem one_y : (1 : Coquaternion R).y = 0 := rfl
@[simp] theorem one_z : (1 : Coquaternion R).z = 0 := rfl

@[simp] theorem add_s (p q : Coquaternion R) : (p + q).s = p.s + q.s := rfl
@[simp] theorem add_x (p q : Coquaternion R) : (p + q).x = p.x + q.x := rfl
@[simp] theorem add_y (p q : Coquaternion R) : (p + q).y = p.y + q.y := rfl
@[simp] theorem add_z (p q : Coquaternion R) : (p + q).z = p.z + q.z := rfl

@[simp] theorem neg_s (q : Coquaternion R) : (-q).s = -q.s := rfl
@[simp] theorem neg_x (q : Coquaternion R) : (-q).x = -q.x := rfl
@[simp] theorem neg_y (q : Coquaternion R) : (-q).y = -q.y := rfl
@[simp] theorem neg_z (q : Coquaternion R) : (-q).z = -q.z := rfl

@[simp] theorem sub_s (p q : Coquaternion R) : (p - q).s = p.s - q.s := rfl
@[simp] theorem sub_x (p q : Coquaternion R) : (p - q).x = p.x - q.x := rfl
@[simp] theorem sub_y (p q : Coquaternion R) : (p - q).y = p.y - q.y := rfl
@[simp] theorem sub_z (p q : Coquaternion R) : (p - q).z = p.z - q.z := rfl

@[simp] theorem smul_s (c : R) (q : Coquaternion R) : (c • q).s = c * q.s := rfl
@[simp] theorem smul_x (c : R) (q : Coquaternion R) : (c • q).x = c * q.x := rfl
@[simp] theorem smul_y (c : R) (q : Coquaternion R) : (c • q).y = c * q.y := rfl
@[simp] theorem smul_z (c : R) (q : Coquaternion R) : (c • q).z = c * q.z := rfl

@[simp] theorem mul_s (p q : Coquaternion R) : (p * q).s = p.s * q.s + p.x * q.x - p.y * q.y + p.z * q.z := rfl
@[simp] theorem mul_x (p q : Coquaternion R) : (p * q).x = p.s * q.x + p.x * q.s + p.y * q.z - p.z * q.y := rfl
@[simp] theorem mul_y (p q : Coquaternion R) : (p * q).y = p.s * q.y + p.y * q.s + p.x * q.z - p.z * q.x := rfl
@[simp] theorem mul_z (p q : Coquaternion R) : (p * q).z = p.s * q.z + p.z * q.s + p.x * q.y - p.y * q.x := rfl

/-! ### Section 1: Clifford Generating Relations -/

/-- e₁² = +1: The spacelike vector squares to the positive identity. -/
@[simp]
theorem e1_sq : (e1 : Coquaternion R) * e1 = 1 := by
  ext <;> { simp [e1]; try ring }

/-- e₂² = -1: The timelike vector squares to the negative identity. -/
@[simp]
theorem e2_sq : (e2 : Coquaternion R) * e2 = -1 := by
  ext <;> { simp [e2]; try ring }

/-- ω² = +1: The chiral bivector / pseudoscalar squares to +1. -/
@[simp]
theorem omega_sq : (omega : Coquaternion R) * omega = 1 := by
  ext <;> { simp [omega]; try ring }

/-- e₁ e₂ = ω: The product of the two orthogonal vectors is the bivector. -/
theorem e1_mul_e2 : (e1 : Coquaternion R) * e2 = omega := by
  ext <;> { simp [e1, e2, omega]; try ring }

/-- e₂ e₁ = -ω: Anticommutativity of the orthogonal vectors. -/
theorem e2_mul_e1 : (e2 : Coquaternion R) * e1 = -omega := by
  ext <;> { simp [e1, e2, omega]; try ring }

/-- Anticommutator {e₁, e₂} = 0. -/
theorem anticomm_e1_e2 : (e1 : Coquaternion R) * e2 + e2 * e1 = 0 := by
  ext <;> { simp [e1, e2]; try ring }

/-- ω e₁ = -e₂. -/
theorem omega_mul_e1 : (omega : Coquaternion R) * e1 = -e2 := by
  ext <;> { simp [e1, omega, e2]; try ring }

/-- e₁ ω = e₂. -/
theorem e1_mul_omega : (e1 : Coquaternion R) * omega = e2 := by
  ext <;> { simp [e1, omega, e2]; try ring }

/-- Anticommutator {ω, e₁} = 0: The bivector anticommutes with e₁. -/
theorem anticomm_omega_e1 : (omega : Coquaternion R) * e1 + e1 * omega = 0 := by
  ext <;> { simp [omega, e1]; try ring }

/-- ω e₂ = -e₁. -/
theorem omega_mul_e2 : (omega : Coquaternion R) * e2 = -e1 := by
  ext <;> { simp [e2, omega, e1]; try ring }

/-- e₂ ω = e₁. -/
theorem e2_mul_omega : (e2 : Coquaternion R) * omega = e1 := by
  ext <;> { simp [e2, omega, e1]; try ring }

/-- Anticommutator {ω, e₂} = 0: The bivector anticommutes with e₂. -/
theorem anticomm_omega_e2 : (omega : Coquaternion R) * e2 + e2 * omega = 0 := by
  ext <;> { simp [omega, e2]; try ring }

/-- Left identity law. -/
@[simp]
theorem one_mul_q (q : Coquaternion R) : (1 : Coquaternion R) * q = q := by
  ext <;> simp

/-- Right identity law. -/
@[simp]
theorem mul_one_q (q : Coquaternion R) : q * 1 = q := by
  ext <;> simp

/-- Associativity of coquaternion multiplication. -/
theorem mul_assoc_q (p q r : Coquaternion R) : (p * q) * r = p * (q * r) := by
  ext <;> { simp; noncomm_ring }

/-- Left distributivity. -/
theorem left_distrib_q (p q r : Coquaternion R) : p * (q + r) = p * q + p * r := by
  ext <;> { simp; noncomm_ring }

/-- Right distributivity. -/
theorem right_distrib_q (p q r : Coquaternion R) : (p + q) * r = p * r + q * r := by
  ext <;> { simp; noncomm_ring }

/-! ### Section 2: The Triad of Planar Number Systems in Cl(1,1) -/

/-- Elliptic complex generator i := e₂. -/
def i_unit : Coquaternion R := e2

/-- Hyperbolic split-complex generator j := ω. -/
def j_unit : Coquaternion R := omega

/-- Parabolic dual-number nilpotent generator ε := e₂ + ω = i + j. -/
def epsilon : Coquaternion R := e2 + omega

/-- Pillar 1: The Elliptic Plane (Complex Numbers ℂ).
    i² = -1: Generates the complex plane inside Cl(1,1). -/
theorem i_sq_neg_one : (i_unit : Coquaternion R) * i_unit = -1 := e2_sq

/-- Pillar 2: The Hyperbolic Plane (Split-Complex Numbers ℝ[j]).
    j² = +1: Generates the split-complex plane inside Cl(1,1). -/
theorem j_sq_one : (j_unit : Coquaternion R) * j_unit = 1 := omega_sq

/-- Pillar 3: The Parabolic Plane (Dual Numbers ℝ[ε]).
    ε² = 0: The sum of the elliptic and hyperbolic units generates a nilpotent dual unit! -/
theorem epsilon_sq_zero : (epsilon : Coquaternion R) * epsilon = 0 := by
  ext <;> { simp [epsilon, e2, omega]; try ring }

/-- Fundamental Theorem of Planar Coexistence:
    All three planar number systems (elliptic/complex, hyperbolic/split-complex,
    and parabolic/dual) coexist simultaneously inside Cockle's coquaternion algebra Cl(1,1). -/
theorem planar_triad_coexistence :
    (i_unit : Coquaternion R) * i_unit = -1 ∧
    (j_unit : Coquaternion R) * j_unit = 1 ∧
    (epsilon : Coquaternion R) * epsilon = 0 :=
  ⟨i_sq_neg_one, j_sq_one, epsilon_sq_zero⟩

/-! ### Section 3: Chiral Lightcone Projectors and ℤ₂-Grading -/

/-- Even (bosonic) part: elements in Cl⁰(1,1) = span{1, ω}. -/
def evenPart (q : Coquaternion R) : Coquaternion R :=
  ⟨q.s, 0, 0, q.z⟩

/-- Odd (fermionic) part: elements in Cl¹(1,1) = span{e₁, e₂}. -/
def oddPart (q : Coquaternion R) : Coquaternion R :=
  ⟨0, q.x, q.y, 0⟩

/-- Direct sum decomposition: q = evenPart q + oddPart q. -/
theorem even_add_odd (q : Coquaternion R) : evenPart q + oddPart q = q := by
  ext <;> { simp [evenPart, oddPart]; try abel }

/-- Chiral volume element / grading operator Γ = ω. -/
def chiralGrading : Coquaternion R := omega

/-- Γ² = 1: The grading operator is an involution. -/
@[simp]
theorem chiralGrading_sq : (chiralGrading : Coquaternion R) * chiralGrading = 1 :=
  omega_sq

/-- Grading action on even elements: Γ (even) Γ = + (even). -/
theorem chiral_grading_even (q : Coquaternion R) :
    chiralGrading * evenPart q * chiralGrading = evenPart q := by
  ext <;> { simp [chiralGrading, omega, evenPart]; try abel }

/-- Grading action on odd elements: Γ (odd) Γ = - (odd). -/
theorem chiral_grading_odd (q : Coquaternion R) :
    chiralGrading * oddPart q * chiralGrading = - oddPart q := by
  ext <;> { simp [chiralGrading, omega, oddPart]; try abel }

/-- Unscaled chiral lightcone projector P₊ = 1 + ω. -/
def P_plus_raw : Coquaternion R := 1 + omega

/-- Unscaled chiral lightcone projector P₋ = 1 - ω. -/
def P_minus_raw : Coquaternion R := 1 - omega

/-- Orthogonal annihilation: P₊ P₋ = 0. -/
theorem P_plus_mul_P_minus : (P_plus_raw : Coquaternion R) * P_minus_raw = 0 := by
  ext <;> { simp [P_plus_raw, P_minus_raw, omega]; try ring }

/-- Orthogonal annihilation: P₋ P₊ = 0. -/
theorem P_minus_mul_P_plus : (P_minus_raw : Coquaternion R) * P_plus_raw = 0 := by
  ext <;> { simp [P_plus_raw, P_minus_raw, omega]; try ring }

/-- Completeness relation: P₊ + P₋ = 2 • 1. -/
theorem P_plus_add_P_minus : (P_plus_raw : Coquaternion R) + P_minus_raw = ⟨2, 0, 0, 0⟩ := by
  ext <;> { simp [P_plus_raw, P_minus_raw, omega]; try norm_num }

/-- Raw idempotency of P₊: (1 + ω)² = 2(1 + ω). -/
theorem P_plus_sq : (P_plus_raw : Coquaternion R) * P_plus_raw = ⟨2, 0, 0, 2⟩ := by
  ext <;> { simp [P_plus_raw, omega]; try norm_num }

/-- Raw idempotency of P₋: (1 - ω)² = 2(1 - ω). -/
theorem P_minus_sq : (P_minus_raw : Coquaternion R) * P_minus_raw = ⟨2, 0, 0, -2⟩ := by
  ext <;> { simp [P_minus_raw, omega]; try norm_num }

/-- Lightcone nilpotent ladder: (P₊ e₁)² = 0. -/
theorem lightcone_ladder_nilpotent :
    ((P_plus_raw : Coquaternion R) * e1) * (P_plus_raw * e1) = 0 := by
  ext <;> { simp [P_plus_raw, e1, omega]; try ring }

/-! ### Section 4: Algebra Representation in Matrix Algebra M₂(R) -/

abbrev Mat2 (R : Type*) := Matrix (Fin 2) (Fin 2) R

/-- Matrix representation of a coquaternion:
    Ψ(s, x, y, z) = !![ s + x, -y - z;
                        y - z,  s - x ] -/
def toMatrix (q : Coquaternion R) : Mat2 R :=
  !![ q.s + q.x, -q.y - q.z;
      q.y - q.z,  q.s - q.x ]

/-- Zero maps to zero matrix. -/
@[simp]
theorem toMatrix_zero : toMatrix (0 : Coquaternion R) = 0 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [toMatrix]

/-- Identity maps to identity matrix. -/
@[simp]
theorem toMatrix_one : toMatrix (1 : Coquaternion R) = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [toMatrix]

/-- Addition is preserved by toMatrix. -/
theorem toMatrix_add (p q : Coquaternion R) :
    toMatrix (p + q) = toMatrix p + toMatrix q := by
  ext i j; fin_cases i <;> fin_cases j <;> { simp [toMatrix]; abel }

/-- Scalar multiplication is preserved by toMatrix. -/
theorem toMatrix_smul (c : R) (q : Coquaternion R) :
    toMatrix (smul c q) = c • toMatrix q := by
  ext i j; fin_cases i <;> fin_cases j <;> { simp [toMatrix, smul]; noncomm_ring }

/-- Matrix multiplication homomorphism:
    Ψ(p • q) = Ψ(p) * Ψ(q). -/
theorem toMatrix_mul (p q : Coquaternion R) :
    toMatrix (p * q) = toMatrix p * toMatrix q := by
  ext i j
  fin_cases i <;> fin_cases j <;> {
    simp [toMatrix, Matrix.mul_apply, Fin.sum_univ_two]
    noncomm_ring
  }

/-- Determinant of a 2x2 matrix: det(M) = M₀₀ M₁₁ - M₀₁ M₁₀. -/
def det2 (M : Mat2 R) : R :=
  M 0 0 * M 1 1 - M 0 1 * M 1 0

/-- Reduced norm of a coquaternion: N(q) = s² - x² + y² - z². -/
def normSq (q : Coquaternion R) : R :=
  q.s^2 - q.x^2 + q.y^2 - q.z^2

/-- Over any non-commutative ring `[Ring R]`, `det2 (toMatrix q)` equals the reduced norm
`normSq q` plus the commutator anomaly `(q.x * q.s - q.s * q.x) + (q.z * q.y - q.y * q.z)`. -/
theorem toMatrix_det_noncomm (q : Coquaternion R) :
    det2 (toMatrix q) =
      normSq q + (q.x * q.s - q.s * q.x) + (q.z * q.y - q.y * q.z) := by
  simp [toMatrix, det2, normSq, sq]
  noncomm_ring

/-- Over any commutative ring, the determinant of the matrix representation equals the
coquaternion reduced norm: det(Ψ(q)) = N(q). -/
theorem toMatrix_det {S : Type*} [CommRing S] (q : Coquaternion S) :
    det2 (toMatrix q) = normSq q := by
  simp [toMatrix, det2, normSq]
  ring

/-! ### Section 5: Master Synthesis Theorem -/

/-- Universal compilation theorem for Cockle's coquaternions and the `Cl(1,1)` triad over `[Ring R]`. -/
theorem compile_cockle_coquaternion_planar_triad (p q : Coquaternion R) :
    ((e1 : Coquaternion R) * e1 = 1) ∧
    ((e2 : Coquaternion R) * e2 = -1) ∧
    ((omega : Coquaternion R) * omega = 1) ∧
    ((e1 : Coquaternion R) * e2 + e2 * e1 = 0) ∧
    ((i_unit : Coquaternion R) * i_unit = -1 ∧
     (j_unit : Coquaternion R) * j_unit = 1 ∧
     (epsilon : Coquaternion R) * epsilon = 0) ∧
    ((chiralGrading : Coquaternion R) * chiralGrading = 1) ∧
    (chiralGrading * evenPart q * chiralGrading = evenPart q) ∧
    (chiralGrading * oddPart q * chiralGrading = - oddPart q) ∧
    ((P_plus_raw : Coquaternion R) * P_minus_raw = 0) ∧
    (((P_plus_raw : Coquaternion R) * e1) * (P_plus_raw * e1) = 0) ∧
    (toMatrix (p * q) = toMatrix p * toMatrix q) ∧
    (det2 (toMatrix q) =
      normSq q + (q.x * q.s - q.s * q.x) + (q.z * q.y - q.y * q.z)) :=
  ⟨e1_sq, e2_sq, omega_sq, anticomm_e1_e2, planar_triad_coexistence,
   chiralGrading_sq, chiral_grading_even q, chiral_grading_odd q,
   P_plus_mul_P_minus, lightcone_ladder_nilpotent, toMatrix_mul p q,
   toMatrix_det_noncomm q⟩

/-- Matrix representation anticommutativity of `e₁` and `e₂` in `Mat2 R`. -/
theorem toMatrix_anticomm_e1_e2 :
    toMatrix (e1 : Coquaternion R) * toMatrix (e2 : Coquaternion R) +
      toMatrix (e2 : Coquaternion R) * toMatrix (e1 : Coquaternion R) = 0 := by
  rw [← toMatrix_mul, ← toMatrix_mul, ← toMatrix_add, anticomm_e1_e2, toMatrix_zero]

/-- Non-commutative matrix representation anticommutativity witness after `toMatrix_mul`. -/
theorem toMatrix_anticomm_witness :
    (e1 : Coquaternion R) * e2 + e2 * e1 = 0 := by
  ext <;> simp [e1, e2]

end Coquaternion

end InfoGeometry.Clifford.Coquaternion
