/-!
# Dadarlat (2009) — Fiberwise KK-Equivalence: Abelian Group Classification

Formalizes the group-theoretic core of Proposition 4.1 and Theorem 1.3:

**Theorem (Dadarlat, Prop 4.1).** Let G be a torsion-free abelian group with a
distinguished element e ∈ G\{0} such that:
  (i) G is torsion-free
  (ii) The map θ: G → G ⊗ G, x ↦ x ⊗ e is a group isomorphism
Then G is isomorphic to either:
  (a) G ≅ Z  (with e ↦ 1), or
  (b) G is isomorphic to a subgroup H ≤ Q with the property:
      1/n ∈ H  ⇒  1/n² ∈ H  for all nonzero n ∈ Z

This is the K0-group classification of strongly self-absorbing Kirchberg
C*-algebras with the automatic triviality property (Dadarlat, Thm 1.3).

The proof uses:
- Ext(G, G[p]) = 0 for all primes p (UCT condition)
- θ isomorphism ⇒ unique divisibility properties
- Square-closure: 1/n ∈ H ⇒ 1/n² ∈ H characterizes subgroups of Q
  that arise as K0 of UHF algebras.

References:
  [Dadarlat 2009] Fiberwise KK-equivalence, Prop 4.1
  [Toms-Winter 2007] Strongly self-absorbing C*-algebras, Trans. AMS 359
-/

open Classical

noncomputable section

namespace InfoGeometry.KTheory.Dadarlat

/-!
## 1. Square-closed subgroups of Q
-/

/--
A subgroup H ≤ Q is *square-closed* if for all n : ℤ, n ≠ 0,
  1/n ∈ H  →  1/n² ∈ H.

This is the algebraic condition characterizing K0 groups of UHF algebras
tensored with O∞ (Toms-Winter 2007, Dadarlat Prop 4.1).
-/
def IsSquareClosed (H : AddSubgroup ℚ) : Prop :=
  ∀ (n : ℤ), n ≠ 0 → ((n : ℚ)⁻¹ ∈ H → ((n : ℚ)⁻¹)^2 ∈ H)

/--
Examples of square-closed subgroups:
- Q itself
- Z[1/p] = {a/p^k : a ∈ Z, k ∈ ℕ} for any prime p
- Z[1/m] for any nonzero integer m
-/
example : IsSquareClosed (⊤ : AddSubgroup ℚ) := by
  intro n hn h
  exact Submodule.mem_top

/--
Z[1/p] is square-closed: (1/p²) = (1/p)² ∈ Z[1/p].
-/
example (p : ℕ) (hp : p ≠ 0) : IsSquareClosed
    (AddSubgroup.closure ({(p : ℚ)⁻¹} : Set ℚ)) := by
  intro n hn hn_in
  -- This requires the additive subgroup generated by 1/p,
  -- which contains all a/p^k. Since (1/p)² = 1/p², it's in the subgroup.
  -- For a full proof, we'd use the structure of Z[1/p].
  sorry

/-!
## 2. The embedding into Q
-/

/--
If G is a torsion-free abelian group with a distinguished element e ≠ 0
and the map θ: G → G ⊗ G, θ(x) = x ⊗ e is an isomorphism, then G embeds
into Q via a map γ: G → Q defined by:
  γ(x) = m/n  where n x = m e  (for x ≠ 0, unique relatively prime m,n)
  γ(0) = 0.

This is the key construction from Dadarlat Prop 4.1.
-/
structure TorsionFreeWithUnit where
  G : Type*
  [addCommGroup : AddCommGroup G]
  e : G
  he_ne_zero : e ≠ 0
  torsionFree : ∀ (x : G), ∀ (n : ℕ), n ≠ 0 → n • x = 0 → x = 0
  theta_iso : Function.Bijective (λ (x : G) => x ⊗[ℤ] e)
  -- Note: G ⊗ G means tensor product over ℤ

/--
**Lemma (Dadarlat, Prop 4.1, Step 1).** G is torsion-free.

This is proved in the paper using Ext(G, G[p]) = 0 derived from the UCT
condition (ii) in the paper. For the Lean formalization, we include it
as a hypothesis of the structure.
-/
lemma torsion_free_of_uct (G : Type*) [AddCommGroup G] (h : TorsionFreeWithUnit G) :
    ∀ (x : G), ∀ (n : ℕ), n ≠ 0 → n • x = 0 → x = 0 :=
  h.torsionFree

/--
**Lemma (Dadarlat, Prop 4.1, Step 2).** The map γ: G → Q is an injective
group homomorphism.

For x ≠ 0, there exist unique relatively prime integers m, n with n > 0
such that n x = m e. Define γ(x) = m/n.
-/
def gammaMap {G : Type*} [AddCommGroup G] (data : TorsionFreeWithUnit G)
    (x : G) : ℚ :=
  if hx : x = 0 then 0
  else
    -- The existence of m, n follows from the theta_iso condition:
    -- Since θ(x) = x ⊗ e is an isomorphism, the equation n x = m e
    -- has a unique solution modulo torsion. Over ℤ with G torsion-free,
    -- this gives unique relatively prime m, n.
    --
    -- This is the deep part of the proof. For the formalization,
    -- we state the existence as a separate lemma.
    0 -- placeholder

/--
**Theorem (Dadarlat, Prop 4.1).** Classification of K0 groups of strongly
self-absorbing Kirchberg algebras.

If G = K0(D) where D is a unital Kirchberg algebra satisfying the UCT
and with the automatic triviality property, then G is either:
  (a) G ≅ Z, or
  (b) G is isomorphic to a square-closed subgroup of Q.

Equivalently, D ≅ O2 (if G = 0), D ≅ O∞ (if G ≅ Z), or
D ≅ O∞ ⊗ U where U is a UHF algebra of infinite type (if G ≤ Q
is square-closed).
-/
theorem classification_of_k0
    {G : Type*} [AddCommGroup G] (data : TorsionFreeWithUnit G) :
    (∃ (f : G ≃+ ℤ), f data.e = 1) ∨
    (∃ (H : AddSubgroup ℚ) (f : G ≃+ H), IsSquareClosed H) := by
