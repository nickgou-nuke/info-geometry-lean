            toc.innerHTML = '';
            headers.forEach((header, index) => {
                const id = 'header-' + index;
                header.id = id;
                header.classList.add('scroll-mt-24'); // Add scroll padding
                const link = document.createElement('a');
                link.href = '#' + id;
                link.textContent = header.textContent;
                link.className = 'block py-1 text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors border-l-2 border-transparent hover:border-indigo-600 pl-3 ' + (header.tagName === 'H3' ? 'ml-4 text-xs' : 'text-sm font-medium');
                link.dataset.targetId = id;
                
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    document.getElementById(id).scrollIntoView({behavior: 'smooth'});
                });

                toc.appendChild(link);
            });

            // Intersection Observer for Active State
            const observerOptions = {
                root: null,
                rootMargin: '-100px 0px -66%',
                threshold: 0
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        const activeLink = toc.querySelector(`a[data-target-id="${id}"]`);
                        
                        // Remove active class from all
                        toc.querySelectorAll('a').forEach(link => {
                            link.classList.remove('text-indigo-600', 'dark:text-indigo-400', 'border-indigo-600', 'font-bold');
                            link.classList.add('text-gray-500', 'dark:text-gray-400', 'border-transparent');
                        });

                        if (activeLink) {
                            activeLink.classList.remove('text-gray-500', 'dark:text-gray-400', 'border-transparent');
                            activeLink.classList.add('text-indigo-600', 'dark:text-indigo-400', 'border-indigo-600', 'font-bold');
                        }
                    }
                });
            }, observerOptions);

            headers.forEach(header => observer.observe(header));
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            hljs.highlightAll();

            // Add Copy Button to code blocks
            document.querySelectorAll('pre').forEach((pre) => {
                // Create container for relative positioning
                const wrapper = document.createElement('div');
                wrapper.className = 'relative group';
                
                // Insert wrapper before pre, then move pre into wrapper
                pre.parentNode.insertBefore(wrapper, pre);
                wrapper.appendChild(pre);

                // Create the copy button
                const button = document.createElement('button');
                button.className = 'absolute top-2 right-2 bg-gray-700/50 hover:bg-gray-700 text-gray-300 hover:text-white px-2 py-1 rounded text-xs transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100 focus:outline-none';
                button.innerHTML = `
                    <span class="flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                        Copy
                    </span>
                `;
                
                // Add click event
                button.addEventListener('click', () => {
                    const code = pre.querySelector('code').innerText;
                    navigator.clipboard.writeText(code).then(() => {
                        const originalHtml = button.innerHTML;
                        button.innerHTML = `
                            <span class="flex items-center gap-1 text-green-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Copied!
                            </span>
                        `;
                        setTimeout(() => {
                            button.innerHTML = originalHtml;
                        }, 2000);
                    }).catch(err => {
                        console.error('Failed to copy: ', err);
                    });
                });

                wrapper.appendChild(button);
            });

            // Copy Link Button Logic
            const copyLinkBtn = document.getElementById('copy-link-btn');
            if (copyLinkBtn) {
                copyLinkBtn.addEventListener('click', () => {
                    navigator.clipboard.writeText(window.location.href).then(() => {
                        const copyIcon = document.getElementById('copy-icon');
                        const checkIcon = document.getElementById('check-icon');
                        const copyText = document.getElementById('copy-text');
                        
                        copyIcon.classList.add('opacity-0', 'scale-50');
                        checkIcon.classList.remove('opacity-0', 'scale-50');
                        copyText.textContent = 'Copied!';
                        copyText.classList.add('text-green-500');

                        setTimeout(() => {
                            copyIcon.classList.remove('opacity-0', 'scale-50');
                            checkIcon.classList.add('opacity-0', 'scale-50');
                            copyText.textContent = 'Copy Link';
                            copyText.classList.remove('text-green-500');
                        }, 2000);
                    });
                });
            }

            // Lightbox
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = document.getElementById('lightbox-img');
            const contentImages = document.querySelectorAll('.prose img');

            contentImages.forEach(img => {
                img.classList.add('cursor-zoom-in', 'transition-transform', 'hover:scale-[1.01]');
                img.addEventListener('click', () => {
                    lightboxImg.src = img.src;
                    lightbox.classList.remove('hidden');
                    // Small delay to allow display:block to apply before opacity transition
                    requestAnimationFrame(() => {
                        lightbox.classList.remove('opacity-0');
                        lightboxImg.classList.remove('scale-95');
                        lightboxImg.classList.add('scale-100');
                    });
                    document.body.style.overflow = 'hidden';
                });
            });

            lightbox.addEventListener('click', () => {
                lightbox.classList.add('opacity-0');
                lightboxImg.classList.remove('scale-100');
                lightboxImg.classList.add('scale-95');
                setTimeout(() => {
                    lightbox.classList.add('hidden');
                    document.body.style.overflow = '';
                }, 300);
            });

            // Clap/Like Button Logic
            const clapBtn = document.getElementById('clap-btn');
            const clapCount = document.getElementById('clap-count');
            const postId = '3641';
            const storageKey = 'claps_' + postId;
            
            // Load initial state
            let currentClaps = parseInt(localStorage.getItem(storageKey) || '0');
            if (currentClaps > 0) {
                clapCount.textContent = currentClaps;
                clapCount.classList.remove('opacity-0');
                clapBtn.classList.add('text-indigo-500', 'border-indigo-500');
            }

            clapBtn.addEventListener('click', () => {
                currentClaps++;
                localStorage.setItem(storageKey, currentClaps);
                
                clapCount.textContent = currentClaps;
                clapCount.classList.remove('opacity-0');
                clapBtn.classList.add('text-indigo-500', 'border-indigo-500');

                // Animation
                const particle = document.createElement('span');
                particle.textContent = '+1';
                particle.className = 'absolute -top-8 text-indigo-600 font-bold text-lg animate-fade-out-up pointer-events-none';
                clapBtn.appendChild(particle);
                setTimeout(() => particle.remove(), 1000);
            });
        });
    </script>
