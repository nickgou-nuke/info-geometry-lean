import InfoGeometry.Clifford.SplitOctonionChiralMatrixProduct

/-!
# Principal left ideals in the chained chiral-action algebra

The chained-action algebra is associative because it is a subalgebra of an
endomorphism algebra.  This file records the valid ideal construction that
does not assume a primitive idempotent or claim minimality.
-/

namespace InfoGeometry.Clifford.SplitOctonionChiralMatrixReadout

noncomputable section

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 1000000

abbrev ChiralActionAlgebra : Type := ↥chiralCayleyChainedLeftActionAlgebra

def principalLeftIdeal (f : ChiralActionAlgebra) : Set ChiralActionAlgebra :=
  Set.range (fun a : ChiralActionAlgebra => a * f)

def principalRightIdeal (f : ChiralActionAlgebra) : Set ChiralActionAlgebra :=
  Set.range (fun a : ChiralActionAlgebra => f * a)

theorem mem_principalLeftIdeal_iff (f x : ChiralActionAlgebra) :
    x ∈ principalLeftIdeal f ↔ ∃ a : ChiralActionAlgebra, a * f = x := by
  rfl

theorem mem_principalRightIdeal_iff (f x : ChiralActionAlgebra) :
    x ∈ principalRightIdeal f ↔ ∃ a : ChiralActionAlgebra, f * a = x := by
  rfl

theorem principalLeftIdeal_left_closed
    (f a x : ChiralActionAlgebra)
    (hx : x ∈ principalLeftIdeal f) :
    a * x ∈ principalLeftIdeal f := by
  rcases hx with ⟨b, rfl⟩
  refine ⟨a * b, ?_⟩
  simp [mul_assoc]

theorem principalLeftIdeal_add_mem
    (f x y : ChiralActionAlgebra)
    (hx : x ∈ principalLeftIdeal f)
    (hy : y ∈ principalLeftIdeal f) :
    x + y ∈ principalLeftIdeal f := by
  rcases hx with ⟨a, rfl⟩
  rcases hy with ⟨b, rfl⟩
  exact ⟨a + b, by simp [add_mul]⟩

theorem principalLeftIdeal_smul_mem
    (f : ChiralActionAlgebra) (r : ℝ) (x : ChiralActionAlgebra)
    (hx : x ∈ principalLeftIdeal f) :
    r • x ∈ principalLeftIdeal f := by
  rcases hx with ⟨a, rfl⟩
  exact ⟨r • a, by simp⟩

theorem principalRightIdeal_right_closed
    (f a x : ChiralActionAlgebra)
    (hx : x ∈ principalRightIdeal f) :
    x * a ∈ principalRightIdeal f := by
  rcases hx with ⟨b, rfl⟩
  refine ⟨b * a, ?_⟩
  simp [mul_assoc]

theorem principalRightIdeal_add_mem
    (f x y : ChiralActionAlgebra)
    (hx : x ∈ principalRightIdeal f)
    (hy : y ∈ principalRightIdeal f) :
    x + y ∈ principalRightIdeal f := by
  rcases hx with ⟨a, rfl⟩
  rcases hy with ⟨b, rfl⟩
  exact ⟨a + b, by simp [mul_add]⟩

theorem principalRightIdeal_smul_mem
    (f : ChiralActionAlgebra) (r : ℝ) (x : ChiralActionAlgebra)
    (hx : x ∈ principalRightIdeal f) :
    r • x ∈ principalRightIdeal f := by
  rcases hx with ⟨a, rfl⟩
  exact ⟨r • a, by simp⟩

/-- The canonical submodule carrier of the existing right principal ideal. -/
def principalRightIdealSubmodule (f : ChiralActionAlgebra) :
    Submodule ℝ ChiralActionAlgebra where
  carrier := principalRightIdeal f
  zero_mem' := by
    exact ⟨0, by simp⟩
  add_mem' := by
    intro x y hx hy
    exact principalRightIdeal_add_mem f x y hx hy
  smul_mem' := by
    intro r x hx
    exact principalRightIdeal_smul_mem f r x hx

@[simp]
theorem principalRightIdealSubmodule_mem_iff
    (f x : ChiralActionAlgebra) :
    x ∈ principalRightIdealSubmodule f ↔ x ∈ principalRightIdeal f :=
  Iff.rfl

/-- Right multiplication on the canonical right-ideal submodule. -/
def rightLinearMapOnIdeal (f a : ChiralActionAlgebra) :
    principalRightIdealSubmodule f →ₗ[ℝ] principalRightIdealSubmodule f where
  toFun x := ⟨x.1 * a, principalRightIdeal_right_closed f a x.1 x.2⟩
  map_add' x y := by
    apply Subtype.ext
    simp only [Submodule.coe_add, add_mul]
  map_smul' r x := by
    apply Subtype.ext
    simp only [Submodule.coe_smul, RingHom.id_apply]
    rw [smul_mul_assoc]

@[simp]
theorem rightLinearMapOnIdeal_apply
    (f a : ChiralActionAlgebra) (x : principalRightIdealSubmodule f) :
    (rightLinearMapOnIdeal f a x : ChiralActionAlgebra) = x.1 * a :=
  rfl

theorem rightLinearMapOnIdeal_one (f : ChiralActionAlgebra) :
    rightLinearMapOnIdeal f 1 = LinearMap.id := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  simp

theorem rightLinearMapOnIdeal_mul
    (f a b : ChiralActionAlgebra) :
    rightLinearMapOnIdeal f (a * b) =
      (rightLinearMapOnIdeal f b).comp (rightLinearMapOnIdeal f a) := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  simp only [rightLinearMapOnIdeal_apply, LinearMap.comp_apply]
  rw [mul_assoc]

/-! The two existing ideal carriers couple through the corner generated by `f`. -/

theorem principalRightIdeal_mul_principalLeftIdeal_in_corner
    (f : ChiralActionAlgebra) {phi psi : ChiralActionAlgebra}
    (hphi : phi ∈ principalRightIdeal f)
    (hpsi : psi ∈ principalLeftIdeal f) :
    ∃ c : ChiralActionAlgebra, phi * psi = f * c * f := by
  rcases hphi with ⟨a, rfl⟩
  rcases hpsi with ⟨b, rfl⟩
  refine ⟨a * b, ?_⟩
  simp [mul_assoc]

theorem generator_mem_principalLeftIdeal (f : ChiralActionAlgebra) :
    f ∈ principalLeftIdeal f := by
  exact ⟨1, by simp⟩

theorem idempotent_mem_principalLeftIdeal (f : ChiralActionAlgebra)
    (hf : f * f = f) :
    f ∈ principalLeftIdeal f := by
  exact ⟨f, hf⟩

theorem generator_mem_principalRightIdeal (f : ChiralActionAlgebra) :
    f ∈ principalRightIdeal f := by
  exact ⟨1, by simp⟩

theorem idempotent_mem_principalRightIdeal (f : ChiralActionAlgebra)
    (hf : f * f = f) :
    f ∈ principalRightIdeal f := by
  exact ⟨f, hf⟩

theorem principalLeftIdeal_one_eq_univ :
    principalLeftIdeal (1 : ChiralActionAlgebra) = Set.univ := by
  ext x
  constructor
  · intro _
    trivial
  · intro _
    exact ⟨x, by simp⟩

theorem principalRightIdeal_one_eq_univ :
    principalRightIdeal (1 : ChiralActionAlgebra) = Set.univ := by
  ext x
  constructor
  · intro _
    trivial
  · intro _
    exact ⟨x, by simp⟩

end
end InfoGeometry.Clifford.SplitOctonionChiralMatrixReadout
