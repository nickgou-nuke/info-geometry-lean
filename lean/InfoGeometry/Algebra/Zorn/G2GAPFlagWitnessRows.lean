set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem all_gapWitnessMatrixSound
    (k : Fin 12) (i : Fin 189) (hi : i ∈ orbitCells k) :
    gapWitnessMatrixSound k i := by
  fin_cases k <;>
    simp [orbitCells, G2FlagWordCertificate.flagCells] at hi ⊢ <;>
    aesop

theorem all_gapWitnessQuotientRowWitness
    (k : Fin 12) (i : Fin 189) (hi : i ∈ orbitCells k) :
    ∃ b : SplitOctF2Aut,
      b ∈ G2TwoPCSubgroupClosure.unipotentSubgroup ∧
        G2FlagOrbitPartitionCertificate.orbitEnum i = b •
          (QuotientGroup.mk
            (weylNF (G2FlagOrbitPartitionCertificate.orbitWeyl k).1
              (G2FlagOrbitPartitionCertificate.orbitWeyl k).2) :
            G2NativeQuotientRepresentative.CarrierQuotient) := by
  exact G2GAPFlagWitnessReadback.quotientRowWitness_of_all_gapWitness_matrix_sound
    all_gapWitnessMatrixSound k i hi

theorem g2_fin189_orbit_certificate
    (k : Fin 12) (i : Fin 189) (hi : i ∈ orbitCells k) :
    ∃ b : SplitOctF2Aut,
      b ∈ G2TwoPCSubgroupClosure.unipotentSubgroup ∧
        G2FlagOrbitPartitionCertificate.orbitEnum i = b •
          (QuotientGroup.mk
            (weylNF (G2FlagOrbitPartitionCertificate.orbitWeyl k).1
              (G2FlagOrbitPartitionCertificate.orbitWeyl k).2) :
            G2NativeQuotientRepresentative.CarrierQuotient) := by
  exact all_gapWitnessQuotientRowWitness k i hi

end InfoGeometry.Algebra.Zorn.G2GAPFlagWitnessRows
