{"type":"new","contents":"import Mathlib.Algebra.Ring.Basic\nimport Mathlib.Algebra.Star.Basic\nimport Mathlib.Analysis.InnerProductSpace.Adjoint\nimport Mathlib.Analysis.InnerProductSpace.Projection.Basic\nimport Mathlib.Analysis.InnerProductSpace.Projection.Submodule\nimport Mathlib.Analysis.Normed.Operator.Banach\n\nnamespace InfoGeometry.Singular.MoorePenrose\n\nsection MP\n\nvariable {R : Type*} [Ring R] [StarRing R]\n\ndef IsMoorePenroseInverse (A B : R) : Prop :=\n  A * B * A = A ∧\n  B * A * B = B ∧\n  star (A * B) = A * B ∧\n  star (B * A) = B * A\n\nend MP\n\nsection Hilbert\n\nopen InnerProductSpace ContinuousLinearMap\nopen scoped InnerProduct ComplexConjugate\n\nvariable {𝕜 E : Type*}\nvariable [RCLike 𝕜]\nvariable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\n\nprivate theorem orthogonal_orthogonal_le_of_hasOrthogonalProjection\n    (U : Submodule 𝕜 E) [U.HasOrthogonalProjection] :\n    Uᗮᗮ ≤ U := by\n  intro x hx\n  have hxzero : Uᗮ.starProjection x = 0 := by\n    have hker : x ∈ (Uᗮ.starProjection : E →L[𝕜] E).ker := by\n      rw [Submodule.ker_starProjection]\n      exact hx\n    exact hker\n  have hsum : U.starProjection x + Uᗮ.starProjection x = x :=\n    Submodule.starProjection_add_starProjection_orthogonal (K := U) x\n  have hproj : U.starProjection x = x := by\n    rw [hxzero] at hsum\n    simpa using hsum\n  exact (Submodule.starProjection_eq_self_iff (K := U)).1 hproj\n\ntheorem exists_moorePenroseInverse_of_closedRange\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    ∃ (B : E →L[𝕜] E), IsMoorePenroseInverse A B := by\n  classical\n\n  let K : Submodule 𝕜 E := A.kerᗮ\n\n  haveI : CompleteSpace A.range := hClosedRange.completeSpace_coe\n  haveI : A.range.HasOrthogonalProjection := inferInstance\n\n  haveI : CompleteSpace K := by\n    dsimp [K]\n    infer_instance\n  haveI : K.HasOrthogonalProjection := inferInstance\n\n  have hKerClosed : IsClosed (A.ker : Set E) := A.isClosed_ker\n  haveI : CompleteSpace A.ker := hKerClosed.completeSpace_coe\n  haveI : A.ker.HasOrthogonalProjection := inferInstance\n\n  have hkerOO : Kᗮ ≤ A.ker := by\n    intro x hx\n    exact orthogonal_orthogonal_le_of_hasOrthogonalProjection (U := A.ker) (by\n      simpa [K] using hx)\n\n  have hAproj : ∀ x : E, A (K.starProjection x) = A x := by\n    intro x\n    have hdiffOrth : x - K.starProjection x ∈ Kᗮ :=\n      Submodule.sub_starProjection_mem_orthogonal (K := K) x\n    have hdiffKer : x - K.starProjection x ∈ A.ker := hkerOO hdiffOrth\n    have hzero : A (x - K.starProjection x) = 0 := hdiffKer\n    have hsub : A x - A (K.starProjection x) = 0 := by\n      rw [← map_sub]\n      exact hzero\n    exact (sub_eq_zero.mp hsub).symm\n\n  let T : K →L[𝕜] A.range :=\n    (A.comp K.subtypeL).codRestrict A.range\n      (fun x => by\n        change A (x : E) ∈ A.range\n        exact ⟨(x : E), rfl⟩)\n\n  have hTker : (T : K →ₗ[𝕜] A.range).ker = ⊥ := by\n    rw [Submodule.eq_bot_iff]\n    intro x hx\n    have hxA : A (x : E) = 0 := by\n      have hzero : T x = 0 := hx\n      have hval := congrArg (fun z : A.range => (z : E)) hzero\n      simpa [T] using hval\n    have hker : (x : E) ∈ A.ker := hxA\n    have horth : (x : E) ∈ A.kerᗮ := by\n      simpa [K] using x.property\n    have hbot : (x : E) ∈ (⊥ : Submodule 𝕜 E) := by\n      have : (x : E) ∈ A.ker ⊓ A.kerᗮ := ⟨hker, horth⟩\n      simpa [Submodule.inf_orthogonal_eq_bot (A.ker)] using this\n    have hxzeroE : (x : E) = 0 := by\n      simpa using hbot\n    exact Subtype.ext hxzeroE\n\n  have hTsurj : (T : K →ₗ[𝕜] A.range).range = ⊤ := by\n    rw [Submodule.eq_top_iff']\n    intro y\n    rcases y.property with ⟨x, hx⟩\n    refine ⟨⟨K.starProjection x, Submodule.starProjection_apply_mem K x⟩, ?_⟩\n    apply Subtype.ext\n    dsimp [T]\n    rw [hAproj]\n    exact hx\n\n  let e : K ≃L[𝕜] A.range :=\n    ContinuousLinearEquiv.ofBijective T hTker hTsurj\n\n  let B : E →L[𝕜] E :=\n    K.subtypeL.comp ((e.symm : A.range →L[𝕜] K).comp A.range.orthogonalProjection)\n\n  have hAB_apply (x : E) : A (B x) = A.range.starProjection x := by\n    have h :=\n      ContinuousLinearEquiv.ofBijective_apply_symm_apply T hTker hTsurj\n        (A.range.orthogonalProjection x)\n    have hval := congrArg (fun z : A.range => (z : E)) h\n    dsimp [B]\n    exact hval\n\n  have hBA_apply (x : E) : B (A x) = K.starProjection x := by\n    let z : K := ⟨K.starProjection x, Submodule.starProjection_apply_mem K x⟩\n    let y : A.range := ⟨A x, ⟨x, rfl⟩⟩\n    have hproj : A.range.orthogonalProjection (A x) = y := by\n      apply Subtype.ext\n      exact Submodule.starProjection_mem_subspace_eq_self y\n    have hTz : T z = y := by\n      apply Subtype.ext\n      dsimp [T, z, y]\n      rw [hAproj x]\n    have hinv : e.symm (A.range.orthogonalProjection (A x)) = z := by\n      apply e.injective\n      simp [hproj]\n      exact hTz.symm\n    dsimp [B]\n    rw [hinv]\n    rfl\n\n  have hAB : A * B = A.range.starProjection := by\n    ext x\n    exact hAB_apply x\n\n  have hBA : B * A = K.starProjection := by\n    ext x\n    exact hBA_apply x\n\n  have hB_mem (x : E) : B x ∈ K := by\n    dsimp [B]\n    exact (e.symm (A.range.orthogonalProjection x)).property\n\n  have hABA : A * B * A = A := by\n    rw [hAB]\n    ext x\n    change A.range.starProjection (A x) = A x\n    exact Submodule.starProjection_mem_subspace_eq_self (⟨A x, ⟨x, rfl⟩⟩ : A.range)\n\n  have hBAB : B * A * B = B := by\n    rw [hBA]\n    ext x\n    exact (Submodule.starProjection_eq_self_iff (K := K)).2 (hB_mem x)\n\n  have hStarRange :\n      star (A.range.starProjection : E →L[𝕜] E) = A.range.starProjection := by\n    rw [ContinuousLinearMap.star_eq_adjoint]\n    exact IsSelfAdjoint.adjoint_eq (isSelfAdjoint_starProjection A.range)\n\n  have hStarK :\n      star (K.starProjection : E →L[𝕜] E) = K.starProjection := by\n    rw [ContinuousLinearMap.star_eq_adjoint]\n    exact IsSelfAdjoint.adjoint_eq (isSelfAdjoint_starProjection K)\n\n  have hABstar : star (A * B) = A * B := by\n    rw [hAB, hStarRange]\n\n  have hBAstar : star (B * A) = B * A := by\n    rw [hBA, hStarK]\n\n  exact ⟨B, hABA, hBAB, hABstar, hBAstar⟩\n\nend Hilbert\n\nend InfoGeometry.Singular.MoorePenrose\n","mtime":1778366314957}