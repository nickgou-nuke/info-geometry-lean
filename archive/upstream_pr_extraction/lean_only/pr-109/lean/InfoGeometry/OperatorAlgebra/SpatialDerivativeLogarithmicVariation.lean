import InfoGeometry.OperatorAlgebra.NoncommutativePowerDerivative
import Mathlib.Analysis.SpecialFunctions.Exponential

/-!
# Logarithmic variation of invertible operator paths

This file defines the left and right Maurer--Cartan logarithmic derivatives
of a unit-valued path in a real Banach algebra.

For an exponential path `Delta t = exp (-K t)`, the full derivative is the
noncommutative exponential derivative.  When `K'(t)` commutes with `K(t)`,
both logarithmic derivatives reduce to `-K'(t)`.

No scalar trace, determinant, diagonalization, or cohomological
identification is used.
-/

noncomputable section

namespace InfoGeometry.OperatorAlgebra.SpatialDerivativeLogarithmicVariation

open InfoGeometry.OperatorAlgebra

variable {A : Type*}
  [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]

local instance : NormedAlgebra ℚ A :=
  NormedAlgebra.restrictScalars ℚ ℝ A

/-- Left Maurer--Cartan logarithmic derivative `Delta⁻¹ Delta'`. -/
def leftLogarithmicDerivative
    (Delta : ℝ → Aˣ) (t : ℝ) : A :=
  (↑((Delta t)⁻¹) : A) *
    deriv (fun s : ℝ => (Delta s : A)) t

/-- Right Maurer--Cartan logarithmic derivative `Delta' Delta⁻¹`. -/
def rightLogarithmicDerivative
    (Delta : ℝ → Aˣ) (t : ℝ) : A :=
  deriv (fun s : ℝ => (Delta s : A)) t *
    (↑((Delta t)⁻¹) : A)

/-- The exponential `exp (-a)` as a unit of the Banach algebra. -/
def expNegUnit (a : A) : Aˣ :=
  (NormedSpace.isUnit_exp (-a)).unit

@[simp]
theorem expNegUnit_val (a : A) :
    ((expNegUnit a : Aˣ) : A) =
      NormedSpace.exp (-a) :=
  (NormedSpace.isUnit_exp (-a)).unit_spec

/-- Unit-valued negative-exponential path generated by `K`. -/
def expNegUnitsPath (K : ℝ → A) (t : ℝ) : Aˣ :=
  expNegUnit (K t)

@[simp]
theorem expNegUnitsPath_val
    (K : ℝ → A) (t : ℝ) :
    ((expNegUnitsPath K t : Aˣ) : A) =
      NormedSpace.exp (-K t) :=
  expNegUnit_val (K t)

/--
The derivative of `exp (-K)` is the native noncommutative exponential
derivative applied to `-K'`.
-/
theorem hasDerivAt_exp_neg
    {K : ℝ → A} {t : ℝ} {K' : A}
    (hK : HasDerivAt K K' t) :
    HasDerivAt
      (fun s : ℝ => NormedSpace.exp (-K s))
      (exponentialDerivative (𝕜 := ℝ) (-K t) (-K')) t := by
  exact
    (hasFDerivAt_exp_noncommutative
      (𝕜 := ℝ) (A := A) (-K t)).comp_hasDerivAt t hK.neg

/--
On a direction commuting with the base point, the native noncommutative
exponential derivative reduces to multiplication by the exponential.
-/
theorem exponentialDerivative_apply_of_commute
    (a h : A) (hcomm : Commute h a) :
    exponentialDerivative (𝕜 := ℝ) a h =
      NormedSpace.exp a * h := by
  have hLine :
      HasDerivAt (fun s : ℝ => a + (s • h)) h 0 := by
    convert
      (hasDerivAt_const (x := (0 : ℝ)) a).add
        ((hasDerivAt_id (x := (0 : ℝ))).smul_const h) using 1
    all_goals simp
  have hFrechetAt :
      HasFDerivAt NormedSpace.exp
        (exponentialDerivative (𝕜 := ℝ) a)
        (a + ((0 : ℝ) • h)) := by
    simpa using
      (hasFDerivAt_exp_noncommutative
        (𝕜 := ℝ) (A := A) a)
  have hFromFrechet :
      HasDerivAt
        (fun s : ℝ => NormedSpace.exp (a + (s • h)))
        (exponentialDerivative (𝕜 := ℝ) a h) 0 :=
    hFrechetAt.comp_hasDerivAt 0 hLine
  have hFactor :
      (fun s : ℝ => NormedSpace.exp (a + (s • h))) =
        fun s : ℝ => NormedSpace.exp a * NormedSpace.exp (s • h) := by
    funext s
    exact NormedSpace.exp_add_of_commute
      (hcomm.symm.smul_right s)
  have hFromFactor :
      HasDerivAt
        (fun s : ℝ => NormedSpace.exp (a + (s • h)))
        (NormedSpace.exp a * h) 0 := by
    rw [hFactor]
    simpa using
      (hasDerivAt_exp_smul_const h (0 : ℝ)).const_mul
        (NormedSpace.exp a)
  exact hFromFrechet.unique hFromFactor

/--
In a tangent direction commuting with the generator, differentiation of
`exp (-K)` reduces to right multiplication by `-K'`.
-/
theorem hasDerivAt_exp_neg_of_commute
    {K : ℝ → A} {t : ℝ} {K' : A}
    (hK : HasDerivAt K K' t)
    (hcomm : Commute K' (K t)) :
    HasDerivAt
      (fun s : ℝ => NormedSpace.exp (-K s))
      (NormedSpace.exp (-K t) * (-K')) t := by
  have hcommNeg : Commute (-K') (-K t) :=
    hcomm.neg_left.neg_right
  simpa [SpatialDerivativeLogarithmicVariation.exponentialDerivative_apply_of_commute
    (-K t) (-K') hcommNeg] using
      hasDerivAt_exp_neg (A := A) hK

/--
For a commuting tangent direction, the left logarithmic derivative of
`Delta = exp (-K)` is exactly `-K'`.
-/
theorem leftLogarithmicDerivative_expNegUnitsPath
    {K : ℝ → A} {t : ℝ} {K' : A}
    (hK : HasDerivAt K K' t)
    (hcomm : Commute K' (K t)) :
    leftLogarithmicDerivative (expNegUnitsPath K) t =
      -K' := by
  have hExp := hasDerivAt_exp_neg_of_commute (A := A) hK hcomm
  rw [leftLogarithmicDerivative, show
    deriv (fun s : ℝ => ((expNegUnitsPath K s : Aˣ) : A)) t =
        NormedSpace.exp (-K t) * (-K') by
      simpa using hExp.deriv]
  have hInvMul :
      (↑((expNegUnitsPath K t)⁻¹) : A) *
          NormedSpace.exp (-K t) = 1 := by
    rw [← expNegUnitsPath_val (K := K) t]
    exact Units.inv_mul _
  calc
    (↑((expNegUnitsPath K t)⁻¹) : A) *
          (NormedSpace.exp (-K t) * (-K')) =
        ((↑((expNegUnitsPath K t)⁻¹) : A) *
          NormedSpace.exp (-K t)) * (-K') := by
            rw [mul_assoc]
    _ = -K' := by rw [hInvMul, one_mul]

/--
For a commuting tangent direction, the right logarithmic derivative of
`Delta = exp (-K)` is exactly `-K'`.
-/
theorem rightLogarithmicDerivative_expNegUnitsPath
    {K : ℝ → A} {t : ℝ} {K' : A}
    (hK : HasDerivAt K K' t)
    (hcomm : Commute K' (K t)) :
    rightLogarithmicDerivative (expNegUnitsPath K) t =
      -K' := by
  have hExp := hasDerivAt_exp_neg_of_commute (A := A) hK hcomm
  rw [rightLogarithmicDerivative, show
    deriv (fun s : ℝ => ((expNegUnitsPath K s : Aˣ) : A)) t =
        NormedSpace.exp (-K t) * (-K') by
      simpa using hExp.deriv]
  rw [← expNegUnitsPath_val (K := K) t]
  have hcommExp :
      Commute (-K') (NormedSpace.exp (-K t)) :=
    (hcomm.neg_left.neg_right).exp_right
  have hMulInv :
      NormedSpace.exp (-K t) *
          (↑((expNegUnitsPath K t)⁻¹) : A) = 1 := by
    rw [← expNegUnitsPath_val (K := K) t]
    exact Units.mul_inv _
  calc
    (NormedSpace.exp (-K t) * (-K')) *
          (↑((expNegUnitsPath K t)⁻¹) : A) =
        ((-K') * NormedSpace.exp (-K t)) *
          (↑((expNegUnitsPath K t)⁻¹) : A) := by
            exact congrArg
              (fun x : A => x * (↑((expNegUnitsPath K t)⁻¹) : A))
              hcommExp.eq.symm
    _ = (-K') *
          (NormedSpace.exp (-K t) *
            (↑((expNegUnitsPath K t)⁻¹) : A)) := by
              rw [mul_assoc]
    _ = -K' := by rw [hMulInv, mul_one]

/--
The left and right logarithmic derivatives agree on the commuting
negative-exponential path.
-/
theorem leftLogarithmicDerivative_eq_right_of_expNegUnitsPath
    {K : ℝ → A} {t : ℝ} {K' : A}
    (hK : HasDerivAt K K' t)
    (hcomm : Commute K' (K t)) :
    leftLogarithmicDerivative (expNegUnitsPath K) t =
      rightLogarithmicDerivative (expNegUnitsPath K) t := by
  rw [leftLogarithmicDerivative_expNegUnitsPath hK hcomm,
    rightLogarithmicDerivative_expNegUnitsPath hK hcomm]

end InfoGeometry.OperatorAlgebra.SpatialDerivativeLogarithmicVariation
