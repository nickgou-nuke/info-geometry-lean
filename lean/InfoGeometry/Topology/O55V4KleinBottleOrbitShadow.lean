import InfoGeometry.Topology.O55V4KleinBottleFinite
import Mathlib.Tactic

/-!
# Finite `O(5,5)` / `{I,-I}` quotient / V4 orbit shadow

This file adds theorem-safe finite descent lemmas over the coordinate packet from
`O55V4KleinBottleFinite`.

Closed content:
- projective sign equivalence is an equivalence relation;
- the V4 generators preserve projective sign equivalence;
- the four-point V4 orbit shadow is closed under the two generating reflections;
- the central sign sends the orbit shadow of `x` to the orbit shadow of `negAll x`.

It does **not** prove the actual quotient space `Vec55/{±I}`, a Lie-group action,
a `Pin(5,5)` double cover, or a full orbit classification.
-/

namespace O55V4KleinBottleOrbitShadow

open O55V4KleinBottleFinite

/-- Four-point V4 orbit shadow generated by the two commuting pair reflections. -/
def InV4OrbitShadow (x y : Vec55) : Prop :=
  y = x ∨ y = reflPair0 x ∨ y = reflPair1 x ∨ y = reflPair01 x

theorem projectiveSignEq_symm {x y : Vec55} :
    ProjectiveSignEq x y → ProjectiveSignEq y x := by
  intro h
  rcases h with rfl | h
  · exact projectiveSignEq_refl _
  · right
    simpa [h] using (negAll_involutive x).symm

theorem projectiveSignEq_trans {x y z : Vec55} :
    ProjectiveSignEq x y → ProjectiveSignEq y z → ProjectiveSignEq x z := by
  intro hxy hyz
  rcases hxy with rfl | hxy
  · exact hyz
  · rcases hyz with hyz | hyz
    · rw [hyz, hxy]
      exact projectiveSignEq_negAll _
    · left
      rw [hyz, hxy]
      exact negAll_involutive _

theorem negAll_descends_projective {x y : Vec55} :
    ProjectiveSignEq x y → ProjectiveSignEq (negAll x) (negAll y) := by
  intro h
  rcases h with rfl | h
  · exact projectiveSignEq_refl _
  · right
    simp [h]

theorem reflPair0_negAll_comm (x : Vec55) :
    reflPair0 (negAll x) = negAll (reflPair0 x) := by
  ext i
  fin_cases i <;> simp [reflPair0, negAll]

theorem reflPair1_negAll_comm (x : Vec55) :
    reflPair1 (negAll x) = negAll (reflPair1 x) := by
  ext i
  fin_cases i <;> simp [reflPair1, negAll]

theorem reflPair01_negAll_comm (x : Vec55) :
    reflPair01 (negAll x) = negAll (reflPair01 x) := by
  ext i
  fin_cases i <;> simp [reflPair01, reflPair0, reflPair1, negAll]

theorem reflPair0_descends_projective {x y : Vec55} :
    ProjectiveSignEq x y → ProjectiveSignEq (reflPair0 x) (reflPair0 y) := by
  intro h
  rcases h with rfl | h
  · exact projectiveSignEq_refl _
  · right
    simp [h, reflPair0_negAll_comm]

theorem reflPair1_descends_projective {x y : Vec55} :
    ProjectiveSignEq x y → ProjectiveSignEq (reflPair1 x) (reflPair1 y) := by
  intro h
  rcases h with rfl | h
  · exact projectiveSignEq_refl _
  · right
    simp [h, reflPair1_negAll_comm]

theorem reflPair01_descends_projective {x y : Vec55} :
    ProjectiveSignEq x y → ProjectiveSignEq (reflPair01 x) (reflPair01 y) := by
  intro h
  rcases h with rfl | h
  · exact projectiveSignEq_refl _
  · right
    simp [h, reflPair01_negAll_comm]

theorem inV4OrbitShadow_refl (x : Vec55) : InV4OrbitShadow x x := by
  exact Or.inl rfl

theorem inV4OrbitShadow_reflPair0 (x : Vec55) : InV4OrbitShadow x (reflPair0 x) := by
  exact Or.inr <| Or.inl rfl

theorem inV4OrbitShadow_reflPair1 (x : Vec55) : InV4OrbitShadow x (reflPair1 x) := by
  exact Or.inr <| Or.inr <| Or.inl rfl

theorem inV4OrbitShadow_reflPair01 (x : Vec55) : InV4OrbitShadow x (reflPair01 x) := by
  exact Or.inr <| Or.inr <| Or.inr rfl

theorem reflPair0_orbitShadow_closed {x y : Vec55} :
    InV4OrbitShadow x y → InV4OrbitShadow x (reflPair0 y) := by
  intro h
  rcases h with rfl | rfl | rfl | rfl
  · exact inV4OrbitShadow_reflPair0 _
  · rw [reflPair0_involutive x]
    exact inV4OrbitShadow_refl x
  · simpa [reflPair01] using inV4OrbitShadow_reflPair01 x
  · rw [reflPair01, reflPair0_involutive (reflPair1 x)]
    exact inV4OrbitShadow_reflPair1 x

theorem reflPair1_orbitShadow_closed {x y : Vec55} :
    InV4OrbitShadow x y → InV4OrbitShadow x (reflPair1 y) := by
  intro h
  rcases h with rfl | rfl | rfl | rfl
  · exact inV4OrbitShadow_reflPair1 _
  · simpa [reflPair01, reflPair0_comm_reflPair1] using inV4OrbitShadow_reflPair01 x
  · rw [reflPair1_involutive x]
    exact inV4OrbitShadow_refl x
  · rw [reflPair01, reflPair0_comm_reflPair1, reflPair1_involutive (reflPair0 x)]
    exact inV4OrbitShadow_reflPair0 x

theorem negAll_orbitShadow_closed {x y : Vec55} :
    InV4OrbitShadow x y → InV4OrbitShadow (negAll x) (negAll y) := by
  intro h
  rcases h with rfl | rfl | rfl | rfl
  · exact inV4OrbitShadow_refl _
  · simpa [reflPair0_negAll_comm] using inV4OrbitShadow_reflPair0 (negAll x)
  · simpa [reflPair1_negAll_comm] using inV4OrbitShadow_reflPair1 (negAll x)
  · simpa [reflPair01_negAll_comm] using inV4OrbitShadow_reflPair01 (negAll x)

theorem finite_projective_v4_orbit_packet (x y z : Vec55) :
    (ProjectiveSignEq x y → ProjectiveSignEq y x) ∧
    (ProjectiveSignEq x y → ProjectiveSignEq y z → ProjectiveSignEq x z) ∧
    (ProjectiveSignEq x y → ProjectiveSignEq (reflPair0 x) (reflPair0 y)) ∧
    (ProjectiveSignEq x y → ProjectiveSignEq (reflPair1 x) (reflPair1 y)) ∧
    (ProjectiveSignEq x y → ProjectiveSignEq (reflPair01 x) (reflPair01 y)) ∧
    (InV4OrbitShadow x y → InV4OrbitShadow x (reflPair0 y)) ∧
    (InV4OrbitShadow x y → InV4OrbitShadow x (reflPair1 y)) ∧
    (InV4OrbitShadow x y → InV4OrbitShadow (negAll x) (negAll y)) := by
  exact ⟨projectiveSignEq_symm, projectiveSignEq_trans,
    reflPair0_descends_projective, reflPair1_descends_projective,
    reflPair01_descends_projective, reflPair0_orbitShadow_closed,
    reflPair1_orbitShadow_closed, negAll_orbitShadow_closed⟩

end O55V4KleinBottleOrbitShadow
