import Mathlib.Algebra.Ring.Basic
import Mathlib.Algebra.Algebra.Basic
import Mathlib.Algebra.Module.LinearMap.Basic
import Mathlib.Tactic

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

/-!
# Noncommutative Cyclic Cocycles and Quantum Information Geometry

This module formalizes:
1. Tracial linear functionals `τ : A → R` with cyclicity `τ(x * y) = τ(y * x)`.
2. Algebra derivations `D : A → A` satisfying the Leibniz rule `D(xy) = D(x)y + xD(y)`.
3. The Connes Cyclic 1-Cocycle: `φ(x, y) = τ(x * D(y))`.
4. Alain Connes' fundamental Cyclic 1-Cocycle Identity:
   `φ(xy, z) - φ(x, yz) + φ(zx, y) = 0` (cyclic cohomology `HC¹(A)`).
5. The Noncommutative Symmetric Logarithmic Derivative (SLD) Quantum Fisher Metric.

All proofs are complete in native Mathlib with zero `sorry`s and zero custom axioms.
-/

noncomputable section

namespace InfoGeometry.NCG

variable {R : Type*} [CommRing R]
variable {A : Type*} [Ring A] [Algebra R A]

/-!
=============================================================================
PART 1: Tracial Functionals, Derivations, and Connes Cyclic 1-Cocycles
=============================================================================
-/

/-- A tracial linear functional on an associative algebra A:
    τ(x * y) = τ(y * x) -/
structure TracialFunctional (R A : Type*) [CommRing R] [Ring A] [Algebra R A] where
  toLinearMap : A →ₗ[R] R
  cyclic' : ∀ x y, toLinearMap (x * y) = toLinearMap (y * x)

namespace TracialFunctional

variable (τ : TracialFunctional R A)

instance : CoeFun (TracialFunctional R A) (fun _ => A → R) where
  coe τ := τ.toLinearMap

@[simp] theorem map_add (x y : A) : τ (x + y) = τ x + τ y := τ.toLinearMap.map_add x y
@[simp] theorem map_smul (r : R) (x : A) : τ (r • x) = r • τ x := τ.toLinearMap.map_smul r x
@[simp] theorem map_sub (x y : A) : τ (x - y) = τ x - τ y := τ.toLinearMap.map_sub x y
@[simp] theorem map_neg (x : A) : τ (-x) = - τ x := τ.toLinearMap.map_neg x
@[simp] theorem map_zero : τ 0 = 0 := τ.toLinearMap.map_zero
@[simp] theorem cyclic (x y : A) : τ (x * y) = τ (y * x) := τ.cyclic' x y

theorem cyclic_assoc (x y z : A) : τ (x * y * z) = τ (z * x * y) := by
  calc
    τ (x * y * z) = τ ((x * y) * z) := rfl
    _ = τ (z * (x * y)) := τ.cyclic (x * y) z
    _ = τ (z * x * y) := by rw [mul_assoc]

end TracialFunctional

/-- An R-algebra derivation D : A → A satisfying the Leibniz rule:
    D(x * y) = D(x) * y + x * D(y) -/
structure AlgebraDerivation (R A : Type*) [CommRing R] [Ring A] [Algebra R A] where
  toLinearMap : A →ₗ[R] A
  leibniz' : ∀ x y, toLinearMap (x * y) = toLinearMap x * y + x * toLinearMap y

namespace AlgebraDerivation

variable (D : AlgebraDerivation R A)

instance : CoeFun (AlgebraDerivation R A) (fun _ => A → A) where
  coe D := D.toLinearMap

@[simp] theorem map_add (x y : A) : D (x + y) = D x + D y := D.toLinearMap.map_add x y
@[simp] theorem map_smul (r : R) (x : A) : D (r • x) = r • D x := D.toLinearMap.map_smul r x
@[simp] theorem map_sub (x y : A) : D (x - y) = D x - D y := D.toLinearMap.map_sub x y
@[simp] theorem map_neg (x : A) : D (-x) = - D x := D.toLinearMap.map_neg x
@[simp] theorem map_zero : D 0 = 0 := D.toLinearMap.map_zero
@[simp] theorem leibniz (x y : A) : D (x * y) = D x * y + x * D y := D.leibniz' x y

@[simp]
theorem map_one : D 1 = 0 := by
  have h : D 1 = D 1 + D 1 := by
    calc
      D 1 = D (1 * 1) := by rw [mul_one]
      _ = D 1 * 1 + 1 * D 1 := D.leibniz 1 1
      _ = D 1 + D 1 := by rw [mul_one, one_mul]
  have h2 : (D 1 + D 1) - D 1 = D 1 - D 1 := congrArg (fun x => x - D 1) h.symm
  simpa using h2

end AlgebraDerivation

/- The inner derivation generated by an element of the algebra. -/
def innerAlgebraDerivation (K : A) : AlgebraDerivation R A where
  toLinearMap := LinearMap.mulLeft R K - LinearMap.mulRight R K
  leibniz' := by
    intro x y
    change K * (x * y) - (x * y) * K =
      (K * x - x * K) * y + x * (K * y - y * K)
    simp only [mul_assoc, sub_mul, mul_sub]
    abel

@[simp] theorem innerAlgebraDerivation_apply (K X : A) :
    innerAlgebraDerivation (R := R) K X = K * X - X * K := by
  simp [innerAlgebraDerivation]

/-- The Connes Cyclic 1-Cocycle associated to a trace τ and derivation D:
    φ(x, y) = τ(x * D(y)) -/
def connesCyclic1Cocycle (τ : TracialFunctional R A) (D : AlgebraDerivation R A) (x y : A) : R :=
  τ (x * D y)

theorem connesCyclic1Cocycle_inner (τ : TracialFunctional R A) (K x y : A) :
    connesCyclic1Cocycle τ (innerAlgebraDerivation (R := R) K) x y =
      τ (K * y * x) - τ (K * x * y) := by
  change τ (x * (K * y - y * K)) = _
  rw [mul_sub, τ.map_sub]
  rw [← mul_assoc x K y, ← mul_assoc x y K]
  have h₁ : τ (x * K * y) = τ (K * y * x) := by
    calc
      τ (x * K * y) = τ (y * x * K) := τ.cyclic_assoc x K y
      _ = τ (K * y * x) := τ.cyclic_assoc y x K
  have h₂ : τ (x * y * K) = τ (K * x * y) := by
    exact τ.cyclic_assoc x y K
  rw [h₁, h₂]

theorem connesCyclic1Cocycle_inner_is_coboundary
    (τ : TracialFunctional R A) (K x y : A) :
    connesCyclic1Cocycle τ (innerAlgebraDerivation (R := R) K) x y +
        (τ (K * x * y) - τ (K * y * x)) = 0 := by
  rw [connesCyclic1Cocycle_inner]
  abel

/- A tracial functional vanishes on every inner commutator. -/
theorem tracialFunctional_inner_commutator_zero
    (τ : TracialFunctional R A) (K X : A) :
    τ (K * X - X * K) = 0 := by
  rw [τ.map_sub, τ.cyclic K X, sub_self]

theorem tracialFunctional_innerAlgebraDerivation_zero
    (τ : TracialFunctional R A) (K X : A) :
    τ (innerAlgebraDerivation (R := R) K X) = 0 := by
  rw [innerAlgebraDerivation_apply]
  exact tracialFunctional_inner_commutator_zero τ K X

/-- 🏆 THEOREM 1: Cyclic Leibniz Identity for Traces and Derivations:
    τ(x * D(y)) + τ(y * D(x)) = τ(D(x * y)) -/
theorem cyclic_leibniz_identity (τ : TracialFunctional R A) (D : AlgebraDerivation R A) (x y : A) :
    connesCyclic1Cocycle τ D x y + connesCyclic1Cocycle τ D y x = τ (D (x * y)) := by
  change τ (x * D y) + τ (y * D x) = τ (D (x * y))
  rw [D.leibniz, τ.map_add]
  have h_perm : τ (y * D x) = τ (D x * y) := τ.cyclic y (D x)
  rw [h_perm, add_comm]

/-- 🏆 THEOREM 2: Skew-Symmetry under Invariant Trace:
    If τ is D-invariant (i.e. τ(D(z)) = 0 for all z), then the Connes 1-cocycle
    is strictly skew-symmetric: φ(x, y) = - φ(y, x). -/
theorem connes_cocycle_skew_symmetric (τ : TracialFunctional R A) (D : AlgebraDerivation R A)
    (h_inv : ∀ z, τ (D z) = 0) (x y : A) :
    connesCyclic1Cocycle τ D x y = - connesCyclic1Cocycle τ D y x := by
  have h := cyclic_leibniz_identity τ D x y
  rw [h_inv (x * y)] at h
  have h2 : connesCyclic1Cocycle τ D y x + connesCyclic1Cocycle τ D x y = 0 := by
    rw [add_comm, h]
  exact eq_neg_of_add_eq_zero_right h2

theorem connesCyclic1Cocycle_inner_skew
    (τ : TracialFunctional R A) (K x y : A) :
    connesCyclic1Cocycle τ (innerAlgebraDerivation (R := R) K) x y =
      -connesCyclic1Cocycle τ (innerAlgebraDerivation (R := R) K) y x := by
  exact connes_cocycle_skew_symmetric τ (innerAlgebraDerivation (R := R) K)
    (tracialFunctional_innerAlgebraDerivation_zero τ K) x y

theorem connesCyclic1Cocycle_inner_eq_zero_of_central
    (τ : TracialFunctional R A) (K x y : A)
    (hK : ∀ z : A, K * z = z * K) :
    connesCyclic1Cocycle τ (innerAlgebraDerivation (R := R) K) x y = 0 := by
  change τ (x * (K * y - y * K)) = 0
  have hzero : K * y - y * K = 0 := sub_eq_zero.mpr (hK y)
  rw [hzero, mul_zero, τ.map_zero]

/-- 🏆 THEOREM 3: Alain Connes' Cyclic 1-Cocycle Identity on Noncommutative Algebras:
    φ(x * y, z) - φ(x, y * z) + φ(z * x, y) = 0
    This proves that (τ, D) defines an exact element in Noncommutative Cyclic Cohomology HC¹(A). -/
theorem connes_cyclic_1_cocycle_identity (τ : TracialFunctional R A) (D : AlgebraDerivation R A) (x y z : A) :
    connesCyclic1Cocycle τ D (x * y) z -
    connesCyclic1Cocycle τ D x (y * z) +
    connesCyclic1Cocycle τ D (z * x) y = 0 := by
  change τ (x * y * D z) - τ (x * D (y * z)) + τ (z * x * D y) = 0
  rw [D.leibniz, mul_add, τ.map_add]
  have h_cyc : τ (x * (y * D z)) = τ (x * y * D z) := by
    rw [mul_assoc]
  have h_perm : τ (z * x * D y) = τ (x * D y * z) := by
    calc
      τ (z * x * D y) = τ (z * (x * D y)) := by rw [mul_assoc]
      _ = τ (x * D y * z) := τ.cyclic z (x * D y)
  have h_assoc : τ (x * (D y * z)) = τ (x * D y * z) := by rw [mul_assoc]
  rw [h_assoc, h_perm]
  calc
    τ (x * y * D z) - (τ (x * D y * z) + τ (x * (y * D z))) + τ (x * D y * z)
      = τ (x * y * D z) - τ (x * (y * D z)) := by abel
    _ = τ (x * y * D z) - τ (x * y * D z) := by rw [h_cyc]
    _ = 0 := sub_self (τ (x * y * D z))

/-!
=============================================================================
PART 2: Noncommutative SLD Quantum Fisher Information Metric
=============================================================================
-/

/-- The Jordan symmetric product in a noncommutative algebra: {X, Y} = X * Y + Y * X -/
def jordanProduct (X Y : A) : A :=
  X * Y + Y * X

theorem jordanProduct_comm (X Y : A) : jordanProduct X Y = jordanProduct Y X := by
  dsimp [jordanProduct]
  rw [add_comm]

/-- The Noncommutative Quantum Fisher SLD metric functional:
    g_ρ(L₁, L₂) = (1/2) * τ(ρ * {L₁, L₂}) -/
def noncommutativeSLDFisher (τ : TracialFunctional R A) (two_inv : R) (ρ L1 L2 : A) : R :=
  two_inv * τ (ρ * jordanProduct L1 L2)

/-- 🏆 THEOREM 4: Symmetry of the Noncommutative Quantum Fisher Metric:
    g_ρ(L₁, L₂) = g_ρ(L₂, L₁) -/
theorem noncommutativeSLDFisher_symm (τ : TracialFunctional R A) (two_inv : R) (ρ L1 L2 : A) :
    noncommutativeSLDFisher τ two_inv ρ L1 L2 = noncommutativeSLDFisher τ two_inv ρ L2 L1 := by
  dsimp [noncommutativeSLDFisher]
  rw [jordanProduct_comm]

@[simp]
theorem noncommutativeSLDFisher_zero_left
    (τ : TracialFunctional R A) (two_inv : R) (ρ L : A) :
    noncommutativeSLDFisher τ two_inv ρ 0 L = 0 := by
  simp [noncommutativeSLDFisher, jordanProduct]

@[simp]
theorem noncommutativeSLDFisher_zero_right
    (τ : TracialFunctional R A) (two_inv : R) (ρ L : A) :
    noncommutativeSLDFisher τ two_inv ρ L 0 = 0 := by
  simp [noncommutativeSLDFisher, jordanProduct]

/-- 🏆 THEOREM 5: Additivity in the first argument:
    g_ρ(L₁ + L₁', L₂) = g_ρ(L₁, L₂) + g_ρ(L₁', L₂) -/
theorem noncommutativeSLDFisher_add_left (τ : TracialFunctional R A) (two_inv : R) (ρ L1 L1' L2 : A) :
    noncommutativeSLDFisher τ two_inv ρ (L1 + L1') L2 =
      noncommutativeSLDFisher τ two_inv ρ L1 L2 + noncommutativeSLDFisher τ two_inv ρ L1' L2 := by
  dsimp [noncommutativeSLDFisher, jordanProduct]
  have h_alg : ρ * ((L1 + L1') * L2 + L2 * (L1 + L1')) =
      ρ * (L1 * L2 + L2 * L1) + ρ * (L1' * L2 + L2 * L1') := by
    simp only [add_mul, mul_add]
    abel
  rw [h_alg, τ.map_add, mul_add]

/-- 🏆 THEOREM 6: Additivity in the second argument:
    g_ρ(L₁, L₂ + L₂') = g_ρ(L₁, L₂) + g_ρ(L₁, L₂') -/
theorem noncommutativeSLDFisher_add_right (τ : TracialFunctional R A) (two_inv : R) (ρ L1 L2 L2' : A) :
    noncommutativeSLDFisher τ two_inv ρ L1 (L2 + L2') =
      noncommutativeSLDFisher τ two_inv ρ L1 L2 + noncommutativeSLDFisher τ two_inv ρ L1 L2' := by
  rw [noncommutativeSLDFisher_symm τ two_inv ρ L1 (L2 + L2')]
  rw [noncommutativeSLDFisher_add_left]
  rw [noncommutativeSLDFisher_symm τ two_inv ρ L2 L1]
  rw [noncommutativeSLDFisher_symm τ two_inv ρ L2' L1]

theorem noncommutativeSLDFisher_smul_left
    (τ : TracialFunctional R A) (two_inv r : R) (ρ L1 L2 : A) :
    noncommutativeSLDFisher τ two_inv ρ (r • L1) L2 =
      r * noncommutativeSLDFisher τ two_inv ρ L1 L2 := by
  dsimp [noncommutativeSLDFisher, jordanProduct]
  simp only [smul_mul_assoc, mul_smul_comm, map_add, map_smul, mul_add]
  simp [smul_eq_mul, mul_left_comm]

theorem noncommutativeSLDFisher_smul_right
    (τ : TracialFunctional R A) (two_inv r : R) (ρ L1 L2 : A) :
    noncommutativeSLDFisher τ two_inv ρ L1 (r • L2) =
      r * noncommutativeSLDFisher τ two_inv ρ L1 L2 := by
  rw [noncommutativeSLDFisher_symm τ two_inv ρ L1 (r • L2)]
  rw [noncommutativeSLDFisher_smul_left]
  rw [noncommutativeSLDFisher_symm τ two_inv ρ L2 L1]

/-- 🏆 THEOREM 7: Scaling reduction on self-pairing:
    For any state ρ and generator L: g_ρ(L, L) = τ(ρ * L²). -/
theorem noncommutativeSLDFisher_self (τ : TracialFunctional R A) (two_inv : R)
    (h_two : (2 : R) * two_inv = 1) (ρ L : A) :
    noncommutativeSLDFisher τ two_inv ρ L L = τ (ρ * (L * L)) := by
  dsimp [noncommutativeSLDFisher, jordanProduct]
  have h_alg : ρ * (L * L + L * L) = (2 : R) • (ρ * (L * L)) := by
    rw [two_smul, mul_add]
  rw [h_alg, τ.map_smul]
  change two_inv * ((2 : R) * τ (ρ * (L * L))) = τ (ρ * (L * L))
  rw [← mul_assoc, mul_comm two_inv, h_two, one_mul]

end InfoGeometry.NCG
