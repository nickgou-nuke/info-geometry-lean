import InfoGeometry.Arithmetic.PrimitiveSetsAbove

/-!
# InfoGeometry.Arithmetic.LPrimitive

Primitive-set-only L-multiple skeleton extracted from Lichtman's proof of the
Erdos primitive set conjecture.

The paper defines

`L_a = { b * a : every prime p | b satisfies p >= P(a) }`,

where `P(a)` is the largest prime factor of `a`, and calls a set `L`-primitive
when no distinct member is an `L`-multiple of another.

This file installs the finite/order-theoretic skeleton only.  The analytic
parts of Lichtman's proof, such as log-density of `L_A`, Mertens estimates,
odd-prime strength, and the special `p = 2` bound, remain explicit witness
surfaces.
-/

namespace InfoGeometry.Arithmetic

/-- All prime factors of `m` are at least `B`. -/
def PrimeFactorsGE (m B : ℕ) : Prop :=
  ∀ ⦃p : ℕ⦄, Nat.Prime p → p ∣ m → B ≤ p

/-- `P` is a largest prime factor of `a`. -/
def IsLargestPrimeFactorOf (P a : ℕ) : Prop :=
  Nat.Prime P ∧ P ∣ a ∧ ∀ ⦃q : ℕ⦄, Nat.Prime q → q ∣ a → q ≤ P

/--
`n` is an `L`-multiple of `a`, witnessed using a largest prime factor `P` of `a`.

This is the direct Lean surface for

`n ∈ L_a` iff `n = b * a` and every prime divisor of `b` is at least `P(a)`.
-/
def LMultiple (a n : ℕ) : Prop :=
  ∃ P : ℕ, IsLargestPrimeFactorOf P a ∧ ∃ b : ℕ, n = b * a ∧ PrimeFactorsGE b P

/-- Set of `L`-multiples of `a`. -/
def LMultiplesOf (a : ℕ) : Set ℕ :=
  {n | LMultiple a n}

/-- Set of `L`-multiples generated by a set `A`. -/
def LMultiplesOfSet (A : Set ℕ) : Set ℕ :=
  {n | ∃ a ∈ A, LMultiple a n}

/-- `A` is `L`-primitive when no distinct member is an `L`-multiple of another. -/
def LPrimitiveSet (A : Set ℕ) : Prop :=
  ∀ ⦃a a' : ℕ⦄, a ∈ A → a' ∈ A → LMultiple a a' → a = a'

/-- Finite `L`-primitive specialization. -/
def LPrimitiveFinset (A : Finset ℕ) : Prop :=
  LPrimitiveSet (A : Set ℕ)

/-- An `L`-multiple is an ordinary multiple. -/
theorem LMultiple.dvd {a n : ℕ} (h : LMultiple a n) : a ∣ n := by
  rcases h with ⟨_P, _hP, b, rfl, _hb⟩
  exact ⟨b, by rw [Nat.mul_comm]⟩

/-- If `P` is a largest prime factor of `a`, then `a ∈ L_a`. -/
theorem LMultiple.self_of_largestPrimeFactor {a P : ℕ}
    (hP : IsLargestPrimeFactorOf P a) :
    LMultiple a a := by
  refine ⟨P, hP, 1, ?_, ?_⟩
  · simp
  · intro p hp hpdvd
    exact (Nat.Prime.not_dvd_one hp hpdvd).elim

/-- Ordinary primitive sets are `L`-primitive. -/
theorem PrimitiveSet.toLPrimitiveSet {A : Set ℕ}
    (hA : PrimitiveSet A) :
    LPrimitiveSet A := by
  intro a a' ha ha' hL
  exact hA ha ha' hL.dvd

/-- Finite ordinary primitive sets are finite `L`-primitive sets. -/
theorem PrimitiveFinset.toLPrimitiveFinset {A : Finset ℕ}
    (hA : PrimitiveFinset A) :
    LPrimitiveFinset A :=
  PrimitiveSet.toLPrimitiveSet hA

/-- Membership in `LMultiplesOfSet` is union membership over generators. -/
theorem mem_LMultiplesOfSet_iff {A : Set ℕ} {n : ℕ} :
    n ∈ LMultiplesOfSet A ↔ ∃ a ∈ A, n ∈ LMultiplesOf a := by
  rfl

/--
Lichtman trichotomy input.

The paper proves that if `L_a` and `L_a'` meet, then one generator is an
`L`-multiple of the other.  We keep this as an explicit finite combinatorial
input until the largest-prime-factor arithmetic proof is fully formalized.
-/
structure LTrichotomyInput where
  trichotomy :
    ∀ ⦃a a' x : ℕ⦄,
      1 < a →
      1 < a' →
      LMultiple a x →
      LMultiple a' x →
        LMultiple a a' ∨ LMultiple a' a

namespace LTrichotomyInput

/--
For an `L`-primitive set, distinct generators have disjoint `L`-multiple
surfaces, assuming the Lichtman trichotomy input.
-/
theorem not_common_LMultiple_of_lprimitive
    (T : LTrichotomyInput)
    {A : Set ℕ}
    (hA : LPrimitiveSet A)
    {a a' x : ℕ}
    (ha : a ∈ A)
    (ha' : a' ∈ A)
    (haa' : a ≠ a')
    (ha_gt : 1 < a)
    (ha'_gt : 1 < a')
    (hx : LMultiple a x)
    (hx' : LMultiple a' x) :
    False := by
  rcases T.trichotomy ha_gt ha'_gt hx hx' with h | h
  · exact haa' (hA ha ha' h)
  · exact haa' ((hA ha' ha h).symm)

end LTrichotomyInput

/-- Density data for a single `L_a` surface. -/
structure LMultipleDensityWitness (a : ℕ) where
  density : ℝ
  density_True : Prop := by
    sorry
  density_law_holds : density_True

/-- Log-density data for `L_A`. -/
structure LPrimitiveLogDensityWitness (A : Set ℕ) where
  logDensity : ℝ
  densitySum : ℝ
  density_eq_sum : logDensity = densitySum

/--
Analytic input corresponding to the Lichtman local `L`-primitive bound.

This is intentionally a witness packet: it names the density/Mertens/local
estimate obligations without pretending they are proved by this skeleton.
-/
structure LichtmanLocalBoundInput where
  localBoundLaw : Prop
  localBoundLaw_holds : localBoundLaw
  lDensityLaw : Prop
  lDensityLaw_holds : lDensityLaw
  mertensProductLaw : Prop
  mertensProductLaw_holds : mertensProductLaw

end InfoGeometry.Arithmetic
