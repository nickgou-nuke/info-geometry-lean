import Mathlib.Tactic

/-!
# The `Cl(1,1)` CPT atom and the signum map

The squashing operator `tanh(K/2)` tends at infinite rapidity to a signum
operator.  For a boost `K=v ε`, the normalized sign is `sgn(v) ε`.
The limit atom is the real Clifford algebra generated by

* `ε²=+1`  (scale signum / boost direction),
* `J²=-1`  (modular conjugation / glide orientation reversal),
* `εJ=-Jε`.

Then `(εJ)²=+1`, giving the minimal CPT grading atom.
-/

noncomputable section

namespace InfoGeometry.Physics.CPTAtom

open Matrix

abbrev M2R := Matrix (Fin 2) (Fin 2) ℝ

/-- Scale signum generator. -/
def eps : M2R := !![0, 1; 1, 0]

/-- Real modular glide generator, square `-1`. -/
def J : M2R := !![0, -1; 1, 0]

/-- CPT product. -/
def CPT : M2R := eps * J

/-- `ε²=1`. -/
theorem eps_sq : eps * eps = 1 := by
  ext i j <;> fin_cases i <;> fin_cases j <;> simp [eps, Matrix.mul_apply, Fin.sum_univ_two]

/-- `J²=-1`. -/
theorem J_sq : J * J = (-1 : ℝ) • (1 : M2R) := by
  ext i j <;> fin_cases i <;> fin_cases j <;> simp [J, Matrix.mul_apply, Matrix.smul_apply, Fin.sum_univ_two]

/-- Clifford anticommutation: `εJ=-Jε`. -/
theorem eps_J_anticomm : eps * J = - (J * eps) := by
  ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [eps, J, Matrix.mul_apply, Matrix.neg_apply, Fin.sum_univ_two]

/-- Equivalently, `{ε,J}=0`. -/
theorem eps_J_anticomm_add : eps * J + J * eps = 0 := by
  rw [eps_J_anticomm]
  simp

/-- The CPT product squares to `+1`. -/
theorem CPT_sq : CPT * CPT = 1 := by
  unfold CPT
  calc
    (eps * J) * (eps * J) = eps * (J * eps) * J := by simp [mul_assoc]
    _ = eps * (-(eps * J)) * J := by
      have h := congrArg Neg.neg eps_J_anticomm
      simp at h
      rw [h]
    _ = -((eps * eps) * (J * J)) := by simp [mul_assoc]
    _ = 1 := by rw [eps_sq, J_sq]; ext i j <;> fin_cases i <;> fin_cases j <;> simp

/-- Abstract CPT atom structure. -/
structure CPTAtomStruct where
  ε : M2R
  Jg : M2R
  eps_sq' : ε * ε = 1
  J_sq' : Jg * Jg = (-1 : ℝ) • (1 : M2R)
  anticomm' : ε * Jg = - (Jg * ε)

/-- Concrete `Cl(1,1)` atom. -/
def concreteAtom : CPTAtomStruct where
  ε := eps
  Jg := J
  eps_sq' := eps_sq
  J_sq' := J_sq
  anticomm' := eps_J_anticomm

/-- Boost generator `K=vε`. -/
def Kboost (v : ℝ) : M2R := v • eps

/-- Signum of a nonzero real. -/
def rsign (v : ℝ) : ℝ := if v > 0 then 1 else -1

/-- Normalizing `vε` by `|v|` gives `sgn(v) ε`. -/
theorem signum_mapping (v : ℝ) (hv : v ≠ 0) :
    (1 / |v|) • Kboost v = (rsign v) • eps := by
  unfold Kboost rsign
  rw [smul_smul]
  by_cases hp : v > 0
  · have hcoef : (1 / |v|) * v = 1 := by
      rw [abs_of_pos hp]
      field_simp [ne_of_gt hp]
    rw [hcoef]
    simp [hp]
  · have hn : v < 0 := lt_of_le_of_ne (le_of_not_gt hp) hv
    have hcoef : (1 / |v|) * v = -1 := by
      rw [abs_of_neg hn]
      field_simp [hv]
    rw [hcoef]
    simp [hp]

/-- Tripotent sector polynomial for the signum/zero limiting spectrum. -/
def Trip : Matrix (Fin 3) (Fin 3) ℝ := !![1, 0, 0; 0, -1, 0; 0, 0, 0]

theorem Trip_tripotent : Trip^3 - Trip = 0 := by
  ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [Trip, pow_succ, Matrix.mul_apply, Fin.sum_univ_three]

#check eps_sq
#check J_sq
#check eps_J_anticomm
#check CPT_sq
#check signum_mapping
#check Trip_tripotent

end InfoGeometry.Physics.CPTAtom
