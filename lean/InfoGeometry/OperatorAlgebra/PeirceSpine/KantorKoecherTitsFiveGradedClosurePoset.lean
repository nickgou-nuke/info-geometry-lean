      ((1 - Gap N_plus) * Y * N_plus)) =
      (1 - Gap N_plus) * X * (1 - Gap N_plus) * Y * N_plus := hBracket
    _ = (1 - Gap N_plus) * (X * (1 - Gap N_plus) * Y) * N_plus := by
          noncomm_ring

