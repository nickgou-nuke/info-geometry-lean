import InfoGeometry.OperatorAlgebra.PeirceSpine.DiracPolynomialAction
import InfoGeometry.Meta.ArchetypePipeline

/-!
# A compact Peirce–Dirac algebraic synthesis

This module adds the logistic-state defect identity to the existing Peirce
Dirac polynomial spine and records its cyclic-trace consequence. The trace
statement is an algebraic identity for a supplied cyclic functional; it does
not assert a Fredholm index or an Atiyah–Singer theorem.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine

open InfoGeometry.Core.IdempotentGraphGrassmannian
open InfoGeometry.MetaCompiler

/-! ### D₅₉ theorem input carriers -/

/-- Data for even-coordinate Connes one-form curvature confinement. -/
structure D59OneFormCurvatureInput (B : Type*) [Ring B] where
  cut : B
  forwardAmplitude : B
  backwardAmplitude : B
  secondForwardAmplitude : B
  secondBackwardAmplitude : B
  leftCoordinate : B
  rightCoordinate : B

/-- Data for the cyclic trace of the massive Peirce Dirac square. -/
structure D59MassTraceInput (B R : Type*) [Ring B] [Ring R] where
  cut : B
  trace : B → R
  forwardAmplitude : B
  backwardAmplitude : B

/-- Data for cyclic cancellation of an arbitrary commutator. -/
structure D59CommutatorTraceInput (B R : Type*) [Ring B] [Ring R] where
  trace : B → R
  left : B
  right : B

/-- Curvature confinement for the commutator one-forms generated by even
coordinates. The hypotheses are premises of the mathematical claim, not fields
of the operator data. -/
def d59OneFormCurvatureClaim {B : Type*} [Ring B]
    (input : D59OneFormCurvatureInput B) : Prop :=
  input.cut * input.cut = input.cut →
    input.cut * input.leftCoordinate = input.leftCoordinate * input.cut →
    input.cut * input.rightCoordinate = input.rightCoordinate * input.cut →
    comm input.cut
      (comm (genPhi input.cut input.forwardAmplitude input.backwardAmplitude)
        input.leftCoordinate *
      comm (genPhi input.cut input.secondForwardAmplitude input.secondBackwardAmplitude)
        input.rightCoordinate) = 0

/-- The chiral mass-square trace formula, conditional on the exact cyclic
trace laws it uses. -/
def d59MassTraceClaim {B R : Type*} [Ring B] [Ring R]
    (input : D59MassTraceInput B R) : Prop :=
  input.cut * input.cut = input.cut →
    (∀ X Y : B, input.trace (X + Y) = input.trace X + input.trace Y) →
    (∀ X Y : B, input.trace (X - Y) = input.trace X - input.trace Y) →
    (∀ X Y : B, input.trace (X * Y) = input.trace (Y * X)) →
    input.trace (invS input.cut *
      (peirceMassDirac input.cut input.forwardAmplitude input.backwardAmplitude *
        peirceMassDirac input.cut input.forwardAmplitude input.backwardAmplitude)) =
      input.trace input.cut - input.trace (1 - input.cut)

/-- A cyclic trace annihilates an arbitrary commutator. -/
def d59CommutatorTraceClaim {B R : Type*} [Ring B] [Ring R]
    (input : D59CommutatorTraceInput B R) : Prop :=
  (∀ X Y : B, input.trace (X - Y) = input.trace X - input.trace Y) →
    (∀ X Y : B, input.trace (X * Y) = input.trace (Y * X)) →
    input.trace (comm input.left input.right) = 0

/-! ### D₅₉ causal archetype poset -/

/-- The five algebraic strata in the differential-calculus extraction. -/
inductive D59Stage (B : Type*) [Ring B] where
  | oneForm
  | curvature
  | realStructure
  | fluctuation
  | traceLaws
  | traceIndex
  deriving DecidableEq, Repr

/-- A topological rank for the dependency graph. -/
def D59Stage.rank {B : Type*} [Ring B] : D59Stage B → ℕ
  | .oneForm => 0
  | .curvature => 1
  | .realStructure => 1
  | .fluctuation => 2
  | .traceLaws => 0
  | .traceIndex => 3

/-- Each cover relation carries its exact algebraic theorem statement. The
real-structure node is independent; curvature does not serve as a premise of
the mass-square trace calculation. -/
def D59Stage.edge {B : Type*} [Ring B] : D59Stage B → D59Stage B → Prop
  | .oneForm, .curvature =>
      ∀ input : D59OneFormCurvatureInput B,
        d59OneFormCurvatureClaim input
  | .fluctuation, .traceIndex =>
      ∀ {R : Type} [Ring R] (input : D59MassTraceInput B R),
        d59MassTraceClaim input
  | .traceLaws, .traceIndex =>
      ∀ {R : Type} [Ring R] (input : D59CommutatorTraceInput B R),
        d59CommutatorTraceClaim input
  | _, _ => False

/-- Reflexive-transitive reachability generated by the cover relations. -/
inductive D59Stage.Reachable {B : Type*} [Ring B] :
    D59Stage B → D59Stage B → Prop where
  | refl (a : D59Stage B) : Reachable a a
  | edge {a b : D59Stage B} : a.edge b → Reachable a b
  | trans {a b c : D59Stage B} : Reachable a b → Reachable b c → Reachable a c

def D59Stage.causalLE {B : Type*} [Ring B] :
    D59Stage B → D59Stage B → Prop := Reachable

theorem D59Stage.causalLE_refl {B : Type*} [Ring B] (a : D59Stage B) :
    a.causalLE a := by
  exact Reachable.refl a

theorem D59Stage.causalLE_trans {B : Type*} [Ring B] {a b c : D59Stage B}
    (hab : a.causalLE b) (hbc : b.causalLE c) : a.causalLE c := by
  exact Reachable.trans hab hbc

theorem D59Stage.edge_rank_strict {B : Type*} [Ring B] {a b : D59Stage B}
    (h : a.edge b) :
    a.rank < b.rank := by
  cases a <;> cases b <;> simp [edge, rank] at h ⊢

theorem D59Stage.reachable_rank_strict_of_ne {B : Type*} [Ring B]
    {a b : D59Stage B}
    (h : a.Reachable b) (hne : a ≠ b) : a.rank < b.rank := by
  induction h with
  | @refl x => exact (hne rfl).elim
  | edge h => exact edge_rank_strict h
  | @trans x y z hxy hyz ihxy ihyz =>
      by_cases hxyEq : x = y
      · subst y
        exact ihyz hne
      · by_cases hyzEq : y = z
        · subst z
          exact ihxy hne
        · exact lt_trans (ihxy hxyEq) (ihyz hyzEq)

theorem D59Stage.causalLE_antisymm {B : Type*} [Ring B] {a b : D59Stage B}
    (hab : a.causalLE b) (hba : b.causalLE a) : a = b := by
  by_cases hEq : a = b
  · exact hEq
  · exact (lt_asymm (reachable_rank_strict_of_ne hab hEq)
      (reachable_rank_strict_of_ne hba (Ne.symm hEq))).elim

instance {B : Type*} [Ring B] : PartialOrder (D59Stage B) where
  le := D59Stage.causalLE
  le_refl := D59Stage.causalLE_refl
  le_trans := fun _ _ _ hab hbc => D59Stage.causalLE_trans hab hbc
  le_antisymm := fun _ _ hab hba => D59Stage.causalLE_antisymm hab hba

theorem D59Stage.edge_causal {B : Type*} [Ring B] {a b : D59Stage B}
    (h : a.edge b) : a.causalLE b := by
  exact Reachable.edge h

variable {B : Type*} [Ring B]
variable {P : B} (hP : P * P = P)
include hP

/-- The algebraic state assembled from the two ordered round-trip corners. -/
def peirceLogisticState (A C : B) : B :=
  P * (1 - qgtPlus P A C) + (1 - P) * qgtMinus P A C

/-- The corner state is the cut corrected by the ordered `J Φ` product. -/
theorem peirce_logistic_state_eq (A C : B) :
    peirceLogisticState (P := P) A C = P - genJ P A C * genPhi P A C := by
  simp only [peirceLogisticState, qgtPlus, qgtMinus, genJ, genPhi,
    conePlus, coneMinus]
  peirce_nf hP

/-- Its idempotency defect is exactly the defect of the two-wave metric. -/
theorem peirce_logistic_state_defect (A C : B) :
    idempotencyDefect (peirceLogisticState (P := P) A C) =
      idempotencyDefect (genV P A C) := by
  rw [peirce_logistic_state_eq hP A C]
  simp only [idempotencyDefect, genJ, genPhi, genV, anticomm,
    conePlus, coneMinus]
  peirce_nf hP

/-! ### Proof-carrying D₅₉ archetype -/

/-- The cut carrier packages idempotency in the element type. -/
abbrev D59IdempotentCut (B : Type*) [Ring B] := {P : B // P * P = P}

/-- Input data for the logistic-state defect archetype.  The cut condition is
part of the mathematical input, while the amplitudes remain arbitrary ring
elements. -/
structure D59LogisticDefectInput (B : Type*) [Ring B] where
  cut : D59IdempotentCut B
  forwardAmplitude : B
  backwardAmplitude : B

/-- The two-wave logistic state has the same idempotency defect as the
associated Peirce metric.  The evidence is the owner theorem
`peirce_logistic_state_defect`. -/
def d59LogisticDefectArchetype {B : Type*} [Ring B] :
    TypedArchetype (D59LogisticDefectInput B) .proved where
  name := `InfoGeometry.OperatorAlgebra.PeirceSpine.d59LogisticDefectArchetype
  phase := 59
  claim := fun input =>
    idempotencyDefect
        (peirceLogisticState (P := (input.cut : B)) input.forwardAmplitude
          input.backwardAmplitude) =
      idempotencyDefect
        (genV (input.cut : B) input.forwardAmplitude input.backwardAmplitude)
  evidence := fun input => peirce_logistic_state_defect
    input.cut.property input.forwardAmplitude input.backwardAmplitude

/-- The shifted massive-Dirac polynomial is the logistic-state defect. -/
theorem peirce_dirac_higgs_eq_logistic_defect (A C : B) :
    (peirceMassDirac P A C * peirceMassDirac P A C -
        (2 : ℤ) • (1 : B)) *
      (peirceMassDirac P A C * peirceMassDirac P A C - 1) =
      idempotencyDefect (peirceLogisticState (P := P) A C) := by
  rw [dirac_higgs_polynomial_is_operator_defect hP A C,
    peirce_logistic_state_defect hP A C]

/-- A cyclic additive functional annihilates the commutator contribution to
the chiral mass-square trace, leaving only the trace of the grading. -/
theorem peirce_cyclic_trace_mass_square
    {R : Type*} [Ring R] (τ : B → R)
    (hAdd : ∀ X Y : B, τ (X + Y) = τ X + τ Y)
    (hSub : ∀ X Y : B, τ (X - Y) = τ X - τ Y)
    (hCyc : ∀ X Y : B, τ (X * Y) = τ (Y * X))
    (A C : B) :
    τ (invS P * (peirceMassDirac P A C * peirceMassDirac P A C)) =
      τ P - τ (1 - P) := by
  have hSV : invS P * genV P A C = genSig P A C := by
    peirce_nf hP
  have hSquare := peirce_mass_dirac_square hP A C
  have hSig : τ (genSig P A C) = 0 := by
    unfold genSig comm
    rw [hSub, hCyc, sub_self]
  calc
    τ (invS P * (peirceMassDirac P A C * peirceMassDirac P A C)) =
        τ (invS P * (1 + genV P A C)) := by rw [hSquare]
    _ = τ (invS P + genSig P A C) := by rw [mul_add, mul_one, hSV]
    _ = τ (invS P) := by rw [hAdd, hSig, add_zero]
    _ = τ P - τ (1 - P) := by
      unfold invS
      exact hSub P (1 - P)

/-- The typed curvature archetype is the existing Peirce evenness theorem
applied to two one-forms generated from even coordinates. -/
def d59OneFormCurvatureArchetype {B : Type*} [Ring B] :
    TypedArchetype (D59OneFormCurvatureInput B) .proved where
  name := `d59OneFormCurvatureArchetype
  phase := 59
  claim := d59OneFormCurvatureClaim
  evidence := fun input hP hEvenA hEvenB => by
    have hEvenA' : comm input.cut input.leftCoordinate = 0 := by
      unfold comm
      rw [hEvenA, sub_self]
    have hEvenB' : comm input.cut input.rightCoordinate = 0 := by
      unfold comm
      rw [hEvenB, sub_self]
    exact peirce_one_form_product_is_even hP
      input.forwardAmplitude input.backwardAmplitude
      input.secondForwardAmplitude input.secondBackwardAmplitude
      input.leftCoordinate input.rightCoordinate hEvenA' hEvenB'

/-- The typed trace archetype reuses the owner theorem for the chiral
mass-square trace. -/
def d59MassTraceArchetype {B R : Type*} [Ring B] [Ring R] :
    TypedArchetype (D59MassTraceInput B R) .proved where
  name := `d59MassTraceArchetype
  phase := 59
  claim := d59MassTraceClaim
  evidence := fun input hP hAdd hSub hCyc =>
    peirce_cyclic_trace_mass_square hP input.trace hAdd hSub hCyc
      input.forwardAmplitude input.backwardAmplitude

/-- The typed cyclicity archetype records the elementary trace cancellation
used by the preceding mass-square result. -/
def d59CommutatorTraceArchetype {B R : Type*} [Ring B] [Ring R] :
    TypedArchetype (D59CommutatorTraceInput B R) .proved where
  name := `d59CommutatorTraceArchetype
  phase := 59
  claim := d59CommutatorTraceClaim
  evidence := fun input hSub hCyc => by
    unfold comm
    rw [hSub (input.left * input.right) (input.right * input.left),
      hCyc input.left input.right, sub_self]

omit [Ring B] hP in
/-- The causal covers consume the same proved archetypes recorded by the
repository's archetype registry. -/
theorem D59Stage.edge_oneForm_curvature {B : Type*} [Ring B] :
    D59Stage.edge (B := B) .oneForm .curvature := by
  intro input
  exact TypedArchetype.discharge d59OneFormCurvatureArchetype input

omit [Ring B] hP in
theorem D59Stage.edge_fluctuation_traceIndex {B : Type*} [Ring B] :
    D59Stage.edge (B := B) .fluctuation .traceIndex := by
  intro R _ input
  exact TypedArchetype.discharge d59MassTraceArchetype input

omit [Ring B] hP in
theorem D59Stage.edge_traceLaws_traceIndex {B : Type*} [Ring B] :
    D59Stage.edge (B := B) .traceLaws .traceIndex := by
  intro R _ input
  exact TypedArchetype.discharge d59CommutatorTraceArchetype input

/-- D₅₉'s algebraic dependency chain: the established Dirac polynomial spine
feeds the logistic-state defect identity and the cyclic-trace mass-square
identity. The final conjunct is not an analytic index theorem. -/
theorem architectural_blueprint_D59_algebraic_synthesis
    {R : Type*} [Ring R] (τ : B → R)
    (hAdd : ∀ X Y : B, τ (X + Y) = τ X + τ Y)
    (hSub : ∀ X Y : B, τ (X - Y) = τ X - τ Y)
    (hCyc : ∀ X Y : B, τ (X * Y) = τ (Y * X))
    (A C : B) (n : ℕ) :
    peirceMassDirac P A C * peirceMassDirac P A C = 1 + genV P A C ∧
    diracQuarticPolynomial (peirceMassDirac P A C) =
      (2 : ℤ) • genV P A C + idempotencyDefect (genV P A C) ∧
    peirceLogisticState (P := P) A C = P - genJ P A C * genPhi P A C ∧
    idempotencyDefect (peirceLogisticState (P := P) A C) =
      idempotencyDefect (genV P A C) ∧
    (peirceMassDirac P A C * peirceMassDirac P A C -
        (2 : ℤ) • (1 : B)) *
      (peirceMassDirac P A C * peirceMassDirac P A C - 1) =
      idempotencyDefect (peirceLogisticState (P := P) A C) ∧
    invS P * peirceOperatorPower (n + 1) (genV P A C) =
      comm (peirceOperatorPower n (genV P A C) * conePlus P A)
        (coneMinus P C) ∧
    τ (invS P * peirceOperatorPower (n + 1) (genV P A C)) = 0 ∧
    τ (invS P * (peirceMassDirac P A C * peirceMassDirac P A C)) =
      τ P - τ (1 - P) := by
  exact ⟨peirce_mass_dirac_square hP A C,
    dirac_quartic_polynomial_split hP A C,
    peirce_logistic_state_eq hP A C,
    peirce_logistic_state_defect hP A C,
    peirce_dirac_higgs_eq_logistic_defect hP A C,
    peirce_chiral_power_is_commutator hP n A C,
    peirce_chiral_power_cyclic_trace_zero hP τ hSub hCyc n A C,
    peirce_cyclic_trace_mass_square hP τ hAdd hSub hCyc A C⟩

/-- The differential-calculus layer of D₅₉, composed with the existing
Peirce Dirac polynomial and trace results. The fluctuation parameters range
over the full odd Peirce image by `peirce_odd_grade_representation`; the trace
conclusion remains algebraic and does not assert an analytic Fredholm index. -/
theorem architectural_blueprint_D59_differential_calculus_synthesis
    [StarRing B] {R : Type*} [Ring R] (τ : B → R)
    (hAdd : ∀ X Y : B, τ (X + Y) = τ X + τ Y)
    (hSub : ∀ X Y : B, τ (X - Y) = τ X - τ Y)
    (hCyc : ∀ X Y : B, τ (X * Y) = τ (Y * X))
    (hPstar : star P = P) (A C Aω Cω a b : B)
    (hEven : comm P a = 0) (hEvenB : comm P b = 0) :
    anticomm (invS P) (comm (genPhi P A C) a) = 0 ∧
    comm (genPhi P A C) (a * b) =
      comm (genPhi P A C) a * b + a * comm (genPhi P A C) b ∧
    comm P (comm (genPhi P A C) a * comm (genPhi P Aω Cω) b) = 0 ∧
    peirceRealTwist P (peirceRealTwist P a) = a ∧
    peirceRealTwist P (a * b) = peirceRealTwist P b * peirceRealTwist P a ∧
    peirceRealTwist P (invS P) = invS P ∧
    (∀ Ω : B, oddGrade P Ω = Ω → ∃ Aω Cω : B, genPhi P Aω Cω = Ω) ∧
    peirceMassDirac P (A + Aω) (C + Cω) *
      peirceMassDirac P (A + Aω) (C + Cω) =
        1 + genV P (A + Aω) (C + Cω) ∧
    diracQuarticPolynomial (peirceMassDirac P (A + Aω) (C + Cω)) =
      (2 : ℤ) • genV P (A + Aω) (C + Cω) +
        idempotencyDefect (genV P (A + Aω) (C + Cω)) ∧
    τ (invS P * (peirceMassDirac P (A + Aω) (C + Cω) *
      peirceMassDirac P (A + Aω) (C + Cω))) = τ P - τ (1 - P) := by
  have hDifferentialOdd := peirce_yukawa_commutator_is_odd hP A C a hEven
  have hLeibniz : comm (genPhi P A C) (a * b) =
      comm (genPhi P A C) a * b + a * comm (genPhi P A C) b := by
    unfold comm
    noncomm_ring
  have hCurvature := peirce_one_form_product_is_even hP A C Aω Cω a b hEven hEvenB
  have hReal := peirce_real_twist_anti_involution (P := P) hP hPstar a b
  have hSquare := peirce_mass_dirac_square hP (A + Aω) (C + Cω)
  have hQuartic := dirac_quartic_polynomial_split hP (A + Aω) (C + Cω)
  have hIndex := peirce_cyclic_trace_mass_square hP τ hAdd hSub hCyc
    (A + Aω) (C + Cω)
  have hOddRepresentation := fun Ω hΩ =>
    peirce_odd_grade_representation (P := P) Ω hΩ
  exact ⟨hDifferentialOdd, hLeibniz, hCurvature, hReal.1, hReal.2.1,
    hReal.2.2, hOddRepresentation, hSquare, hQuartic, hIndex⟩

/-- D₆₁ composes the differential and curvature facts with the existing
Peirce Dirac and trace spine. The curvature conclusions are block-algebra
identities; the trace conclusion is for a supplied cyclic additive functional.
-/
theorem architectural_blueprint_D61_connes_forms_curvature_and_spectral_synthesis
    [StarRing B] {R : Type*} [Ring R] (τ : B → R)
    (hAdd : ∀ X Y : B, τ (X + Y) = τ X + τ Y)
    (hSub : ∀ X Y : B, τ (X - Y) = τ X - τ Y)
    (hCyc : ∀ X Y : B, τ (X * Y) = τ (Y * X))
    (hPstar : star P = P) (A C Aω Cω a b X Y : B)
    (hEvenA : comm P a = 0) (hEvenB : comm P b = 0) :
    comm (genPhi P A C) (a * b) =
      comm (genPhi P A C) a * b + a * comm (genPhi P A C) b ∧
    anticomm (invS P) (comm (genPhi P A C) a) = 0 ∧
    comm P (comm (genPhi P A C) a * comm (genPhi P Aω Cω) b) = 0 ∧
    oddGrade P (oddGrade P X * oddGrade P Y) = 0 ∧
    comm P (oddGrade P X * oddGrade P Y) = 0 ∧
    peirceRealTwist P (peirceRealTwist P X) = X ∧
    peirceRealTwist P (X * Y) = peirceRealTwist P Y * peirceRealTwist P X ∧
    peirceRealTwist P (conePlus P A) = -coneMinus P (star A) ∧
    peirceRealTwist P (coneMinus P (star A)) = -conePlus P A ∧
    peirceMassDirac P (A + Aω) (C + Cω) *
      peirceMassDirac P (A + Aω) (C + Cω) =
        1 + genV P (A + Aω) (C + Cω) ∧
    (peirceMassDirac P (A + Aω) (C + Cω) *
        peirceMassDirac P (A + Aω) (C + Cω) -
          (2 : ℤ) • (1 : B)) *
      (peirceMassDirac P (A + Aω) (C + Cω) *
        peirceMassDirac P (A + Aω) (C + Cω) - 1) =
      idempotencyDefect (genV P (A + Aω) (C + Cω)) ∧
    diracQuarticPolynomial (peirceMassDirac P (A + Aω) (C + Cω)) =
      (2 : ℤ) • genV P (A + Aω) (C + Cω) +
        idempotencyDefect (genV P (A + Aω) (C + Cω)) ∧
    τ (invS P * (peirceMassDirac P (A + Aω) (C + Cω) *
      peirceMassDirac P (A + Aω) (C + Cω))) = τ P - τ (1 - P) := by
  have hLeibniz : comm (genPhi P A C) (a * b) =
      comm (genPhi P A C) a * b + a * comm (genPhi P A C) b := by
    unfold comm
    noncomm_ring
  have hOddForm := peirce_yukawa_commutator_is_odd hP A C a hEvenA
  have hOneFormCurv := peirce_one_form_product_is_even
    hP A C Aω Cω a b hEvenA hEvenB
  have hOddCurv : oddGrade P (oddGrade P X * oddGrade P Y) = 0 := by
    simp only [oddGrade]
    peirce_nf hP
  have hEvenCurv : comm P (oddGrade P X * oddGrade P Y) = 0 := by
    unfold comm oddGrade
    peirce_nf hP
  have hReal := peirce_real_twist_anti_involution (P := P) hP hPstar X Y
  have hPlusStar : peirceRealTwist P (conePlus P A) =
      -coneMinus P (star A) := by
    unfold peirceRealTwist conePlus coneMinus
    simp only [star_mul, star_sub, star_one, hPstar]
    peirce_nf hP
  have hMinusStar : peirceRealTwist P (coneMinus P (star A)) =
      -conePlus P A := by
    unfold peirceRealTwist conePlus coneMinus
    simp only [star_mul, star_sub, star_one, hPstar, star_star]
    peirce_nf hP
  have hSquare := peirce_mass_dirac_square hP (A + Aω) (C + Cω)
  have hHiggs := dirac_higgs_polynomial_is_operator_defect
    hP (A + Aω) (C + Cω)
  have hQuartic := dirac_quartic_polynomial_split hP (A + Aω) (C + Cω)
  have hIndex := peirce_cyclic_trace_mass_square hP τ hAdd hSub hCyc
    (A + Aω) (C + Cω)
  exact ⟨hLeibniz, hOddForm, hOneFormCurv, hOddCurv, hEvenCurv,
    hReal.1, hReal.2.1, hPlusStar, hMinusStar, hSquare, hHiggs,
    hQuartic, hIndex⟩

omit hP in
/-- The D₅₈ unitary-fluctuation dependency order: conjugation produces the
inner one-form; even conjugation preserves the Peirce transitions; polynomial
actions then transform by the same unitary covariance. -/
theorem inner_fluctuation_causal_synthesis
    [StarRing B] {D U : B}
    (hU : U * star U = 1) (hUinv : star U * U = 1)
    (hD : star D = D)
    (hPU : P * U = U * P) (hPUstar : P * star U = star U * P)
    (A C : B) :
    U * D * star U = D + U * comm D (star U) ∧
    star (U * comm D (star U)) = U * comm D (star U) ∧
    U * genPhi P A C * star U =
      genPhi P (U * A * star U) (U * C * star U) ∧
    diracQuarticPolynomial (U * D * star U) =
      U * diracQuarticPolynomial D * star U ∧
    ((U * D * star U) * (U * D * star U) -
        (2 : ℤ) • (1 : B)) *
      ((U * D * star U) * (U * D * star U) - 1) =
      U * ((D * D - (2 : ℤ) • (1 : B)) * (D * D - 1)) * star U := by
  exact ⟨peirce_unitary_inner_fluctuation hU,
    peirce_unitary_inner_fluctuation_selfAdjoint hU hD,
    peirce_yukawa_unitary_covariance hPU hPUstar A C,
    dirac_quartic_unitary_covariance hUinv,
    dirac_higgs_unitary_covariance hUinv hU⟩

