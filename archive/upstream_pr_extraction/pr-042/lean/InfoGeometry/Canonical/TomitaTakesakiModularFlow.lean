import InfoGeometry.Canonical.SouriauTomitaModularFlowBridge
import InfoGeometry.Canonical.TomitaTakesakiCommutantBridge

/-!
# Tomita-Takesaki modular flow bridge

This file does not rebuild modular theory from scratch.  It exposes the owned
Souriau/Tomita modular logarithm context as a compact flow-bearing surface and
keeps the modular conjugation `J` from the commutant bridge in view.
-/

noncomputable section

namespace InfoGeometry.Canonical.TomitaTakesakiModularFlow

open InfoGeometry.Canonical.SouriauTomitaModularFlowBridge
open InfoGeometry.Canonical.SouriauTomitaModularFlowBridge.SouriauTomitaLogContext
open InfoGeometry.Canonical.TomitaTakesakiCommutantBridge
open InfoGeometry.Canonical.StandardFormCore
open InfoGeometry.Volume.ConnesCocycle

universe u v

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable {Symmetry : Type v}

/-- The Tomita-Takesaki modular flow attached to the owned logarithmic context. -/
def modularFlowOfContext (C : SouriauTomitaLogContext (H := H) (Symmetry := Symmetry)) :
    AdditiveModularFlow (H := H) :=
  C.tomitaAdditiveModularFlow

@[simp] theorem modularFlowOfContext_eq
    (C : SouriauTomitaLogContext (H := H) (Symmetry := Symmetry)) :
    modularFlowOfContext C =
      C.tomitaAdditiveModularFlow :=
  rfl

/-- The flow is generated by the same modular Hamiltonian carried by the Souriau context. -/
theorem modularFlowOfContext_eq_generator
    (C : SouriauTomitaLogContext (H := H) (Symmetry := Symmetry)) :
    modularFlowOfContext C =
      additiveModularFlowOfGenerator C.modularHamiltonian := by
  rw [modularFlowOfContext_eq]
  exact C.tomitaAdditiveModularFlow_eq_generator_modularHamiltonian

/-- The unit cocycle attached to the Tomita-Takesaki modular flow is a Connes cocycle. -/
theorem modularFlow_unit_cocycle
    (C : SouriauTomitaLogContext (H := H) (Symmetry := Symmetry)) :
    IsConnesCocycle (modularFlowOfContext C)
      (flowUnitCocycle (modularFlowOfContext C)) :=
  flowUnitCocycle_isConnesCocycle (modularFlowOfContext C)

/-- The modular-flow seed records the modular conjugation from the operator-algebra bridge. -/
def modularFlowSeed (C : SouriauTomitaLogContext (H := H) (Symmetry := Symmetry)) :
    StandardFormSeed H :=
  C.toStandardFormSeed

/-- The modular-flow carrier packages the same seed together with its generator. -/
def modularFlowCarrier (C : SouriauTomitaLogContext (H := H) (Symmetry := Symmetry)) :
    StandardFormCarrier H :=
  C.toStandardFormCarrier

@[simp] theorem modularFlowSeed_J_eq
    (C : SouriauTomitaLogContext (H := H) (Symmetry := Symmetry)) :
    (modularFlowSeed C).J =
      InfoGeometry.Canonical.TomitaTakesaki.modularConjugationJ (E := H) :=
  rfl

@[simp] theorem modularFlowSeed_modularFlow_eq
    (C : SouriauTomitaLogContext (H := H) (Symmetry := Symmetry)) :
    (modularFlowSeed C).modularFlow =
      modularFlowOfContext C :=
  rfl

/-- The modular-flow carrier is built from the same logarithmic modular Hamiltonian. -/
theorem modularFlowCarrier_Delta_eq_modularHamiltonian
    (C : SouriauTomitaLogContext (H := H) (Symmetry := Symmetry)) :
    (modularFlowCarrier C).Delta = C.modularHamiltonian :=
  rfl

end InfoGeometry.Canonical.TomitaTakesakiModularFlow
