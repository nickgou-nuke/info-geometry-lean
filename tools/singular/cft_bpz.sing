LIB "ncalg.lib";

// Define the base parameters: d for Delta, b for b
// We order variables such that those with negative indices (creation operators)
// appear on the left in the normal form.
// Variable ordering: Lm2 > Lm1 > L0 > L1 > L2
ring r = (0, d, b), (Lm2, Lm1, L0, L1, L2), dp;

matrix C[5][5];
matrix D[5][5];

int i, j;
for(i=1; i<=5; i++)
{
  for(j=i; j<=5; j++)
  {
    C[i,j] = 1;
    D[i,j] = 0;
  }
}

// Variables: 1=Lm2, 2=Lm1, 3=L0, 4=L1, 5=L2
// Plural relation for i < j: x_j x_i = c_{ij} x_i x_j + d_{ij}

// [L0, Lm2] = 2 Lm2 => L0 Lm2 - Lm2 L0 = 2 Lm2 => x_3 x_1 = x_1 x_3 + 2 x_1
D[1,3] = 2*Lm2;

// [L0, Lm1] = Lm1 => L0 Lm1 - Lm1 L0 = Lm1 => x_3 x_2 = x_2 x_3 + x_2
D[2,3] = Lm1;

// [L1, Lm2] = 3 Lm1 => L1 Lm2 - Lm2 L1 = 3 Lm1 => x_4 x_1 = x_1 x_4 + 3 x_2
D[1,4] = 3*Lm1;

// [L1, Lm1] = 2 L0 => L1 Lm1 - Lm1 L1 = 2 L0 => x_4 x_2 = x_2 x_4 + 2 x_3
D[2,4] = 2*L0;

// [L1, L0] = L1 => L1 L0 - L0 L1 = L1 => x_4 x_3 = x_3 x_4 + x_4
D[3,4] = L1;

// [L2, Lm2] = 4 L0
D[1,5] = 4*L0;

// [L2, Lm1] = 3 L1 => L2 Lm1 - Lm1 L2 = 3 L1 => x_5 x_2 = x_2 x_5 + 3 x_4
D[2,5] = 3*L1;

// [L2, L0] = 2 L2 => L2 L0 - L0 L2 = 2 L2 => x_5 x_3 = x_3 x_5 + 2 x_5
D[3,5] = 2*L2;

// Define the non-commutative algebra
def R = nc_algebra(C, D);
setring R;

// Define the level-2 null vector state action on V
// N = L_1 * (L_{-1}^2 + b^2 * L_{-2})
poly N = L1 * (Lm1^2 + b^2 * Lm2);

// Evaluate on primary state V where L1 V = 0, L2 V = 0, L0 V = d V
// This means we quotient by the left ideal generated by L1, L2, L0 - d
ideal I = L1, L2, L0 - d;
ideal SI = std(I);

// Reduce N modulo the left ideal to get the action on V
poly N_reduced = reduce(N, SI);

// Print the result
N_reduced;

// Verify against the theoretically expected result: (4*d + 2 + 3*b^2) Lm1
poly expected = (4*d + 2 + 3*b^2) * Lm1;

if (N_reduced - expected == 0)
{
  print("Verification successful: The action algebraically reduces to exactly (4*d + 2 + 3*b^2)*Lm1");
}
else
{
  print("Verification failed!");
}

quit;
