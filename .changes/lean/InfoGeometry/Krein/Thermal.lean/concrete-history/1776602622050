{"type":"new","contents":"import InfoGeometry.Krein.DoubledSpace\nimport Mathlib.Analysis.Normed.Algebra.Exponential\nimport Mathlib.Analysis.Normed.Module.Basic\nimport Mathlib.Analysis.Normed.Operator.Basic\nimport Mathlib.Analysis.Normed.Operator.Mul\nimport Mathlib.Analysis.Normed.Algebra.Basic\nimport Mathlib.Topology.Algebra.Ring.Basic\n\nnamespace InfoGeometry.Krein\n\nsection KreinThermalRoot\n\nvariable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] [KreinSpace H]\n\nlocal notation \"EndK\" => H →L[ℝ] H\n\nnoncomputable local instance : NormedRing EndK := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndK := inferInstance\nlocal instance : IsTopologicalRing EndK := inferInstance\nlocal instance : CompleteSpace EndK := inferInstance\n\n/-- Genuine Krein-rooted modular conjugation of an observable by the flow generated by `K`. -/\nnoncomputable def krein_modular_shift\n    (K : EndK) (β : ℝ) (B : EndK) : EndK :=\n  (NormedSpace.exp (β • K)) * B * (NormedSpace.exp ((-β) • K))\n\nomit [CompleteSpace H] in\n@[simp] lemma krein_modular_shift_zero\n    (K : EndK) (B : EndK) :\n    krein_modular_shift K 0 B = B := by\n  simp [krein_modular_shift]\n\nomit [KreinSpace H] in\n/-- Additive-time law for Krein-rooted modular conjugation. -/\nlemma krein_modular_shift_add\n    (K : EndK) (s t : ℝ) (B : EndK) :\n    krein_modular_shift K (s + t) B =\n      krein_modular_shift K s (krein_modular_shift K t B) := by\n  have h_comm : Commute (s • K) (t • K) :=\n    ((Commute.refl K).smul_left s).smul_right t\n  have h_comm_neg : Commute ((-t) • K) ((-s) • K) :=\n    ((Commute.refl K).smul_left (-t)).smul_right (-s)\n  unfold krein_modular_shift\n  change\n    NormedSpace.exp ((s + t) • K) * B * NormedSpace.exp ((-(s + t)) • K) =\n      NormedSpace.exp (s • K) *\n          (NormedSpace.exp (t • K) * B * NormedSpace.exp ((-t) • K)) *\n        NormedSpace.exp ((-s) • K)\n  calc\n    NormedSpace.exp ((s + t) • K) * B * NormedSpace.exp ((-(s + t)) • K)\n        = (NormedSpace.exp (s • K) * NormedSpace.exp (t • K)) * B *\n            (NormedSpace.exp ((-t) • K) * NormedSpace.exp ((-s) • K)) := by\n          rw [← NormedSpace.exp_add_of_commute h_comm]\n          rw [← NormedSpace.exp_add_of_commute h_comm_neg]\n          simp [add_smul, mul_assoc, add_comm]\n    _ = NormedSpace.exp (s • K) *\n          (NormedSpace.exp (t • K) * B * NormedSpace.exp ((-t) • K)) *\n        NormedSpace.exp ((-s) • K) := by\n          ring_nf\n          simp [mul_assoc]\n\n/-- Simplified Krein-rooted KMS-like algebraic identity at inverse temperature `β`. -/\nnoncomputable def krein_satisfies_kms_like\n    (K : EndK)\n    (ω : EndK →L[ℝ] ℝ)\n    (β : ℝ) : Prop :=\n  ∀ A B : EndK, ω (A * krein_modular_shift K β B) = ω (B * A)\n\n/-- Compatibility alias for the Krein-rooted KMS identity. -/\nnoncomputable def krein_satisfies_kms\n    (K : EndK)\n    (ω : EndK →L[ℝ] ℝ)\n    (β : ℝ) : Prop :=\n  krein_satisfies_kms_like K ω β\n\nomit [CompleteSpace H] in\nlemma krein_kms_like_zero_implies_commutation\n    (K : EndK)\n    (ω : EndK →L[ℝ] ℝ)\n    (hKMS : krein_satisfies_kms_like K ω 0) :\n    ∀ A B : EndK, ω (A * B) = ω (B * A) := by\n  intro A B\n  have h := hKMS A B\n  have hshift : krein_modular_shift K 0 B = B := by\n    simp [krein_modular_shift]\n  simpa [hshift] using h\n\nomit [CompleteSpace H] in\nlemma krein_kms_zero_implies_commutation\n    (K : EndK)\n    (ω : EndK →L[ℝ] ℝ)\n    (hKMS : krein_satisfies_kms K ω 0) :\n    ∀ A B : EndK, ω (A * B) = ω (B * A) :=\n  krein_kms_like_zero_implies_commutation K ω hKMS\n\nend KreinThermalRoot\n\nsection KreinThermal\n\nvariable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\n\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : CompleteSpace EndH := inferInstance\n\n/-- Compatibility specialization of the Krein-rooted modular shift to `DoubledSpace E`. -/\nnoncomputable abbrev modular_shift\n    (K : EndH) (β : ℝ) (B : EndH) : EndH :=\n  krein_modular_shift (H := H₂) K β B\n\nomit [CompleteSpace E] in\n@[simp] lemma modular_shift_zero\n    (K : EndH) (B : EndH) :\n    modular_shift K 0 B = B := by\n  exact krein_modular_shift_zero (H := H₂) K B\n\n/-- Compatibility specialization of the additive-time modular-shift law to `DoubledSpace E`. -/\nlemma modular_shift_add\n    (K : EndH) (s t : ℝ) (B : EndH) :\n    modular_shift K (s + t) B =\n      modular_shift K s (modular_shift K t B) := by\n  simpa [modular_shift] using krein_modular_shift_add (H := H₂) K s t B\n\n/-- Compatibility specialization of the Krein-rooted KMS-like identity. -/\nnoncomputable abbrev satisfies_kms_like\n    (K : EndH)\n    (ω : EndH →L[ℝ] ℝ)\n    (β : ℝ) : Prop :=\n  krein_satisfies_kms_like (H := H₂) K ω β\n\n/-- Compatibility alias for `satisfies_kms_like`. -/\nnoncomputable abbrev satisfies_kms\n    (K : EndH)\n    (ω : EndH →L[ℝ] ℝ)\n    (β : ℝ) : Prop :=\n  krein_satisfies_kms (H := H₂) K ω β\n\nomit [CompleteSpace E] in\n/-- At `β = 0`, the KMS-like identity reduces to commutation symmetry `ω (A B) = ω (B A)`. -/\nlemma kms_like_zero_implies_commutation\n    (K : EndH)\n    (ω : EndH →L[ℝ] ℝ)\n    (hKMS : satisfies_kms_like K ω 0) :\n    ∀ A B : EndH, ω (A * B) = ω (B * A) := by\n  simpa [satisfies_kms_like] using\n    (krein_kms_like_zero_implies_commutation (H := H₂) K ω hKMS)\n\nomit [CompleteSpace E] in\n/-- Compatibility alias for `kms_like_zero_implies_commutation`. -/\nlemma kms_zero_implies_commutation\n    (K : EndH)\n    (ω : EndH →L[ℝ] ℝ)\n    (hKMS : satisfies_kms K ω 0) :\n    ∀ A B : EndH, ω (A * B) = ω (B * A) := by\n  simpa [satisfies_kms] using\n    (krein_kms_zero_implies_commutation (H := H₂) K ω hKMS)\n\n/-- Thermal vacuum data for a chosen modular generator `K`. -/\nstructure ThermalVacuum (K : EndH) where\n  Omega : H₂\n  modular_j_fixed : modular_j Omega = Omega\n  generator_annihilates : K Omega = 0\n  vacuum_nonzero : Omega ≠ 0\n\nomit [CompleteSpace E] in\nlemma spectral_epsilon_eq_zero_iff (v : H₂) :\n    spectral_epsilon v = 0 ↔ v = 0 := by\n  constructor\n  · intro h\n    apply DoubledSpace.ext\n    · simpa using (congr_arg WithLp.fst h)\n    · simpa using (congr_arg WithLp.snd h)\n  · rintro rfl; simp\n\nomit [CompleteSpace E] in\nlemma ThermalVacuum.modular_j_Omega\n    {K : EndH}\n    (Ω : ThermalVacuum K) :\n    modular_j Ω.Omega = Ω.Omega :=\n  Ω.modular_j_fixed\n\nomit [CompleteSpace E] in\n/-- Special case: if the generator is `spectral_epsilon`, the vacuum is forced to be zero. -/\nlemma ThermalVacuum.eq_zero_of_spectral_epsilon\n    (Ω : ThermalVacuum (spectral_epsilon : EndH)) :\n    Ω.Omega = 0 :=\n  (spectral_epsilon_eq_zero_iff Ω.Omega).1 Ω.generator_annihilates\n\nomit [CompleteSpace E] in\n/-- Degenerate special case: for generator `ε`, the modular flow fixes the (zero) vacuum. -/\nlemma modular_flow_inv_Omega_of_spectral_epsilon\n    (Ω : ThermalVacuum (spectral_epsilon : EndH))\n    (t : ℝ) :\n    (NormedSpace.exp (t • (spectral_epsilon : EndH))) Ω.Omega = Ω.Omega := by\n  have hzero : Ω.Omega = 0 := Ω.eq_zero_of_spectral_epsilon\n  rw [hzero]\n  simp\n\nomit [CompleteSpace E] in\n/-- Compatibility alias for the degenerate `ε`-generated flow statement. -/\nlemma modular_flow_inv_Omega\n    (Ω : ThermalVacuum (spectral_epsilon : EndH))\n    (t : ℝ) :\n    (NormedSpace.exp (t • (spectral_epsilon : EndH))) Ω.Omega = Ω.Omega :=\n  modular_flow_inv_Omega_of_spectral_epsilon Ω t\n\nend KreinThermal\n\nend InfoGeometry.Krein\n","mtime":1776602622050}