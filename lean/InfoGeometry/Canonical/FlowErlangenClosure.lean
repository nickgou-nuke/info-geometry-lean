import Mathlib.GroupTheory.GroupAction.FixingSubgroup
import Mathlib.Order.Closure

/-!
# Erlangen closure of flow-generated symmetry groups

For an existing group action on an invariant carrier `X`, the native Galois
connection between `fixingSubgroup` and `MulAction.fixedPoints` constructs a
native closure operator on subgroups. The closure fixes every invariant of
the original subgroup. In particular, an invariant point bounds the closure
by its stabilizer; the existence of one invariant does not imply equality
with that stabilizer.

This is the action-level construction underlying the repository's
`OperatorErlangenGaloisConnection`. No semiring structure on `X` is needed,
so the same native construction applies to measures, fields and flows.

The time carrier below is a monoid. A homomorphism is an algebraic family;
continuity, differentiability and global existence are separate analytic
properties. The generated subgroup explicitly adjoins inverses even when
the time monoid itself has no inverses.
-/

namespace InfoGeometry.Canonical.FlowErlangenClosure

section Action

variable (G X : Type*) [Group G] [MulAction G X]

/-- The native closure from the fixed-point/fixing-subgroup Galois connection. -/
def symmetryClosure : ClosureOperator (Subgroup G) :=
  (fixingSubgroup_fixedPoints_gc G X).dual.closureOperator

/-- Its action on a subgroup is pointwise fixation of that subgroup's invariants. -/
@[simp] theorem symmetryClosure_apply (H : Subgroup G) :
    symmetryClosure G X H = fixingSubgroup G (MulAction.fixedPoints H X) := rfl

variable {G X}

/-- Fixed-point membership is exactly containment in the point stabilizer. -/
theorem mem_fixedPoints_iff_le_stabilizer (H : Subgroup G) (x : X) :
    x ∈ MulAction.fixedPoints H X ↔ H ≤ MulAction.stabilizer G x := by
  constructor
  · intro hx g hg
    exact hx ⟨g, hg⟩
  · intro h g
    exact h g.property

/-- Erlangen closure introduces symmetries but does not change invariant points. -/
theorem fixedPoints_symmetryClosure (H : Subgroup G) :
    MulAction.fixedPoints (symmetryClosure G X H) X = MulAction.fixedPoints H X := by
  apply Set.Subset.antisymm
  · exact fixedPoints_subgroup_antitone G X ((symmetryClosure G X).le_closure H)
  · intro x hx g
    exact g.property ⟨x, hx⟩

/-- Every pointwise stabilizer is closed under the native Erlangen closure. -/
@[simp] theorem symmetryClosure_fixingSubgroup (S : Set X) :
    symmetryClosure G X (fixingSubgroup G S) = fixingSubgroup G S :=
  (fixingSubgroup_fixedPoints_gc G X).l_u_l_eq_l S

/-- Fixing a singleton is the native stabilizer of its unique point. -/
theorem fixingSubgroup_singleton (x : X) :
    fixingSubgroup G ({x} : Set X) = MulAction.stabilizer G x := by
  ext g
  simp only [mem_fixingSubgroup_iff, Set.mem_singleton_iff, forall_eq,
    MulAction.mem_stabilizer_iff]

/-- An invariant point confines the Erlangen closure to its stabilizer. -/
theorem symmetryClosure_le_stabilizer_of_fixed
    {H : Subgroup G} {x : X} (hx : x ∈ MulAction.fixedPoints H X) :
    symmetryClosure G X H ≤ MulAction.stabilizer G x := by
  intro g hg
  exact hg ⟨x, hx⟩

/-- A subgroup and its closure have exactly the same pointwise stabilizer bounds. -/
theorem symmetryClosure_le_stabilizer_iff (H : Subgroup G) (x : X) :
    symmetryClosure G X H ≤ MulAction.stabilizer G x ↔
      H ≤ MulAction.stabilizer G x := by
  constructor
  · exact fun h => ((symmetryClosure G X).le_closure H).trans h
  · intro h
    exact symmetryClosure_le_stabilizer_of_fixed
      ((mem_fixedPoints_iff_le_stabilizer H x).mpr h)

/-- The same universal bound holds for any family of invariants. -/
theorem symmetryClosure_le_fixingSubgroup_iff (H : Subgroup G) (S : Set X) :
    symmetryClosure G X H ≤ fixingSubgroup G S ↔ H ≤ fixingSubgroup G S := by
  constructor
  · exact fun h => ((symmetryClosure G X).le_closure H).trans h
  · intro h
    simpa only [symmetryClosure_fixingSubgroup] using
      (symmetryClosure G X).monotone h

/-- A point stabilizer is itself Erlangen closed. -/
@[simp] theorem symmetryClosure_stabilizer (x : X) :
    symmetryClosure G X (MulAction.stabilizer G x) = MulAction.stabilizer G x := by
  rw [← fixingSubgroup_singleton x, symmetryClosure_fixingSubgroup]

end Action

section Families

variable {Time G ι X : Type*} [Monoid Time] [Group G] [MulAction G X]

/-- The native subgroup generated by all times of all displayed families.
No inverse or regularity of the time parameter is assumed. -/
def flowFamilySubgroup (Φ : ι → Time →* G) : Subgroup G :=
  Subgroup.closure (Set.range (fun it : ι × Time => Φ it.1 it.2))

/-- Every displayed time map belongs to the generated subgroup. -/
theorem flowFamily_mem (Φ : ι → Time →* G) (i : ι) (t : Time) :
    Φ i t ∈ flowFamilySubgroup Φ :=
  Subgroup.subset_closure ⟨(i, t), rfl⟩

/-- The universal property of the subgroup generated by the family. -/
theorem flowFamilySubgroup_le_iff (Φ : ι → Time →* G) (H : Subgroup G) :
    flowFamilySubgroup Φ ≤ H ↔ ∀ i t, Φ i t ∈ H := by
  constructor
  · intro h i t
    exact h (flowFamily_mem Φ i t)
  · intro h
    apply (Subgroup.closure_le _).mpr
    rintro g ⟨⟨i, t⟩, rfl⟩
    exact h i t

/-- A point is invariant under the generated subgroup exactly when every
displayed family fixes it at every time. -/
theorem fixedPoints_flowFamilySubgroup_iff (Φ : ι → Time →* G) (x : X) :
    x ∈ MulAction.fixedPoints (flowFamilySubgroup Φ) X ↔
      ∀ i t, Φ i t • x = x := by
  rw [mem_fixedPoints_iff_le_stabilizer, flowFamilySubgroup_le_iff]
  rfl

/-- An invariant point bounds the entire generated subgroup. -/
theorem flowFamilySubgroup_le_stabilizer (Φ : ι → Time →* G) (x : X)
    (hfix : ∀ i t, Φ i t • x = x) :
    flowFamilySubgroup Φ ≤ MulAction.stabilizer G x :=
  (flowFamilySubgroup_le_iff Φ (MulAction.stabilizer G x)).mpr hfix

/-- The invariant-point bound survives Erlangen closure. -/
theorem flowFamily_symmetryClosure_le_stabilizer (Φ : ι → Time →* G) (x : X)
    (hfix : ∀ i t, Φ i t • x = x) :
    symmetryClosure G X (flowFamilySubgroup Φ) ≤ MulAction.stabilizer G x :=
  (symmetryClosure_le_stabilizer_iff (flowFamilySubgroup Φ) x).mpr
    (flowFamilySubgroup_le_stabilizer Φ x hfix)

/-- The subgroup generated by the family sits between its time maps and its
Erlangen closure, with the latter bounded by any common invariant. -/
theorem flowFamilySubgroup_le_symmetryClosure_le_stabilizer
    (Φ : ι → Time →* G) (x : X) (hfix : ∀ i t, Φ i t • x = x) :
    flowFamilySubgroup Φ ≤ symmetryClosure G X (flowFamilySubgroup Φ) ∧
      symmetryClosure G X (flowFamilySubgroup Φ) ≤ MulAction.stabilizer G x :=
  ⟨(symmetryClosure G X).le_closure _,
    flowFamily_symmetryClosure_le_stabilizer Φ x hfix⟩

end Families

end InfoGeometry.Canonical.FlowErlangenClosure
