import InfoGeometry.Geometry.Statistical.SplitOctonionDualFlatDerivationBridge

/-!
# Algebraic span of split-octonion derivation curvature

This owner records the finite algebraic curvature span generated by the native
derivation-valued curvature.  It does not identify the span with geometric
holonomy; parallel transport and a principal-connection model belong to a
separate owner.
-/

namespace InfoGeometry.Geometry.Statistical.SplitOctonionDerivationCurvatureSpan

noncomputable section

open InfoGeometry.Geometry.Statistical.SplitOctonionDualFlatDerivationBridge
open InfoGeometry.Lie.CanonicalZornDerivation

def derivationCurvatureSpan
    (C : SplitOctonionDualFlatDatum) : Submodule ℝ canonicalZornDerivations :=
  Submodule.span ℝ (Set.range (fun p : InfoGeometry.Lie.CanonicalZornDerivation.CZ × InfoGeometry.Lie.CanonicalZornDerivation.CZ => derivationCurvature C p.1 p.2))

theorem derivationCurvature_mem_span
    (C : SplitOctonionDualFlatDatum) (X Y : InfoGeometry.Lie.CanonicalZornDerivation.CZ) :
    derivationCurvature C X Y ∈ derivationCurvatureSpan C := by
  apply Submodule.subset_span
  exact ⟨(X, Y), rfl⟩

theorem derivationCurvatureSpan_le
    (C : SplitOctonionDualFlatDatum) (S : Submodule ℝ canonicalZornDerivations)
    (hS : ∀ X Y, derivationCurvature C X Y ∈ S) :
    derivationCurvatureSpan C ≤ S := by
  apply Submodule.span_le.2
  rintro _ ⟨⟨X, Y⟩, rfl⟩
  exact hS X Y

end
end InfoGeometry.Geometry.Statistical.SplitOctonionDerivationCurvatureSpan
