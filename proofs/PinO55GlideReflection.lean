import proofs.Clifford55
import proofs.TorusKleinO55Bridge
import proofs.O55CasimirIsospinHamiltonian

/-!
# `Pin(5,5)` / `O(5,5)` glide-reflection interface

This module binds three already-compiled layers into one formal object:

* the canonical mathlib `pinGroup Q55` element generated by a negative
  Clifford vector;
* the Wareham null-basis swap `n ↔ -nbar` inside `Cl(5,5)`;
* the Klein glide relation whose square is a translation, with orientation
  character `-1`, over the split `O(5,5)` carrier.
-/

noncomputable section

namespace PinO55GlideReflection

open Clifford55

abbrev Q := ℚ

/-- The mandatory crosscap reflection index is the fifth positive generator,
the one used by `Clifford55.n_vec` and `Clifford55.n_bar_vec`. -/
def crosscapIndex : Fin 5 := 4

/-- A negative unit Clifford generator lies in the canonical mathlib
`Pin(5,5)` submonoid.  This is the mathlib star-unitary convention for the
split signature. -/
theorem f_neg_mem_pin55 (i : Fin 5) : ι55 (f_neg i) ∈ Pin55 := by
  classical
  rw [pinGroup.mem_iff]
  constructor
  · have hQunit : IsUnit (Q55 (f_neg i)) := by
      rw [Q55_f_neg]
      exact ⟨-1, rfl⟩
    let u : Cl55ˣ :=
      (CliffordAlgebra.isUnit_ι_of_isUnit Q55 hQunit).unit
    have huval : (u : Cl55) = ι55 (f_neg i) :=
      (CliffordAlgebra.isUnit_ι_of_isUnit Q55 hQunit).unit_spec
    have hgen : u ∈ ((↑) ⁻¹' Set.range ι55 : Set Cl55ˣ) := by
      change (u : Cl55) ∈ Set.range ι55
      rw [huval]
      exact Set.mem_range_self (f_neg i)
    refine ⟨u, ?_, ?_⟩
    · exact Subgroup.subset_closure hgen
    · simpa using huval
  · rw [Unitary.mem_iff]
    constructor
    · rw [CliffordAlgebra.star_ι, neg_mul, f_neg_mul_self]
      simp
    · rw [CliffordAlgebra.star_ι, mul_neg, f_neg_mul_self]
      simp

/-- The concrete crosscap reflection as a `Pin(5,5)` element. -/
def crosscapReflectionPin55 : Pin55 :=
  ⟨ι55 (f_neg crosscapIndex), f_neg_mem_pin55 crosscapIndex⟩

private theorem crosscap_pin_inverse :
    (↑((pinToUnits crosscapReflectionPin55)⁻¹) : Cl55) =
      -ι55 (f_neg crosscapIndex) := by
  let u : Cl55ˣ := pinToUnits crosscapReflectionPin55
  have hu : (u : Cl55) = ι55 (f_neg crosscapIndex) := rfl
  have hmul : (-ι55 (f_neg crosscapIndex)) * (u : Cl55) = 1 := by
    rw [hu, neg_mul, f_neg_mul_self]
    simp
  have huinv : (u : Cl55) * (↑(u⁻¹) : Cl55) = 1 := Units.val_inv u
  calc
    (↑(u⁻¹) : Cl55) = 1 * (↑(u⁻¹) : Cl55) := by simp
    _ = ((-ι55 (f_neg crosscapIndex)) * (u : Cl55)) *
        (↑(u⁻¹) : Cl55) := by rw [hmul]
    _ = (-ι55 (f_neg crosscapIndex)) *
        ((u : Cl55) * (↑(u⁻¹) : Cl55)) := by rw [mul_assoc]
    _ = -ι55 (f_neg crosscapIndex) := by rw [huinv]; simp

/-! The native `twisted_adj` action is proved directly on the canonical null
plane.  It is not identified with the positive-generator reflection on the
whole Clifford carrier. -/

theorem crosscap_pin_twisted_adj_n_to_neg_nbar :
    twisted_adj crosscapReflectionPin55 (n_pair crosscapIndex) =
      -ι55 (nbar_pair crosscapIndex) := by
  simp only [twisted_adj, crosscapReflectionPin55]
  have hInv := crosscap_pin_inverse
  simp only [crosscapReflectionPin55] at hInv
  rw [hInv]
  dsimp [n_pair, nbar_pair]
  rw [map_add, map_sub]
  have hanti := orthogonal_anticomm crosscapIndex crosscapIndex
  have hanti' : ι55 (f_neg crosscapIndex) * ι55 (e_pos crosscapIndex) +
      ι55 (e_pos crosscapIndex) * ι55 (f_neg crosscapIndex) = 0 := by
    calc
      _ = ι55 (e_pos crosscapIndex) * ι55 (f_neg crosscapIndex) +
          ι55 (f_neg crosscapIndex) * ι55 (e_pos crosscapIndex) := add_comm _ _
      _ = 0 := hanti
  have hfe : ι55 (f_neg crosscapIndex) * ι55 (e_pos crosscapIndex) =
      -(ι55 (e_pos crosscapIndex) * ι55 (f_neg crosscapIndex)) := by
    rw [← add_eq_zero_iff_eq_neg]
    exact hanti'
  calc
    ι55 (f_neg crosscapIndex) *
        (ι55 (e_pos crosscapIndex) + ι55 (f_neg crosscapIndex)) *
        (-ι55 (f_neg crosscapIndex)) =
      -(ι55 (f_neg crosscapIndex) *
        (ι55 (e_pos crosscapIndex) + ι55 (f_neg crosscapIndex)) *
        ι55 (f_neg crosscapIndex)) := by noncomm_ring
    _ = -(ι55 (e_pos crosscapIndex) - ι55 (f_neg crosscapIndex)) := by
      simp only [mul_add, add_mul, hfe, f_neg_mul_self, neg_mul, mul_assoc]
      noncomm_ring

theorem crosscap_pin_twisted_adj_nbar_to_neg_n :
    twisted_adj crosscapReflectionPin55 (nbar_pair crosscapIndex) =
      -ι55 (n_pair crosscapIndex) := by
  simp only [twisted_adj, crosscapReflectionPin55]
  have hInv := crosscap_pin_inverse
  simp only [crosscapReflectionPin55] at hInv
  rw [hInv]
  dsimp [n_pair, nbar_pair]
  rw [map_sub, map_add]
  have hanti := orthogonal_anticomm crosscapIndex crosscapIndex
  have hanti' : ι55 (f_neg crosscapIndex) * ι55 (e_pos crosscapIndex) +
      ι55 (e_pos crosscapIndex) * ι55 (f_neg crosscapIndex) = 0 := by
    calc
      _ = ι55 (e_pos crosscapIndex) * ι55 (f_neg crosscapIndex) +
          ι55 (f_neg crosscapIndex) * ι55 (e_pos crosscapIndex) := add_comm _ _
      _ = 0 := hanti
  have hfe : ι55 (f_neg crosscapIndex) * ι55 (e_pos crosscapIndex) =
      -(ι55 (e_pos crosscapIndex) * ι55 (f_neg crosscapIndex)) := by
    rw [← add_eq_zero_iff_eq_neg]
    exact hanti'
  calc
    ι55 (f_neg crosscapIndex) *
        (ι55 (e_pos crosscapIndex) - ι55 (f_neg crosscapIndex)) *
        (-ι55 (f_neg crosscapIndex)) =
      -(ι55 (f_neg crosscapIndex) *
        (ι55 (e_pos crosscapIndex) - ι55 (f_neg crosscapIndex)) *
        ι55 (f_neg crosscapIndex)) := by noncomm_ring
    _ = -(ι55 (e_pos crosscapIndex) + ι55 (f_neg crosscapIndex)) := by
      simp only [mul_sub, sub_mul, hfe, f_neg_mul_self, neg_mul, mul_assoc]
      noncomm_ring

/-- The crosscap reflection is orientation reversing at the finite
torus/Klein generator level. -/
def crosscapOrientationSign : ℤ :=
  TorusKleinO55Bridge.generatorOrientationSign
    TorusKleinO55Bridge.ManifoldGenerator.kleinGlide

@[simp] theorem crosscap_orientation_reversing :
    crosscapOrientationSign = -1 := rfl

/-- The corresponding orientable torus translation has orientation character
`+1`. -/
def torusTranslationOrientationSign : ℤ :=
  TorusKleinO55Bridge.generatorOrientationSign
    TorusKleinO55Bridge.ManifoldGenerator.torusTranslation

@[simp] theorem torus_translation_orientation_sign :
    torusTranslationOrientationSign = 1 := rfl

/-- `O(5,5)` carrier dimension for the doubled charge space. -/
def o55CarrierDimension : ℕ :=
  TorusKleinO55Bridge.doubledCartanCarrierDimension

/-- `O(5,5)` Lie algebra generator count. -/
def o55GeneratorCount : ℕ :=
  O55GradedGeneratorBasis.fullGradedGeneratorCount

/-- Frozen/active gliding generator count. -/
def activeGlideGeneratorCount : ℕ :=
  O55GradedGeneratorBasis.activeGradedGeneratorCount

theorem o55_glide_counts :
    o55CarrierDimension = 10 ∧
    o55GeneratorCount = 45 ∧
    activeGlideGeneratorCount = 15 := by
  exact ⟨TorusKleinO55Bridge.doubled_cartan_carrier_dimension_eq,
    O55GradedGeneratorBasis.full_graded_generator_count_eq,
    O55GradedGeneratorBasis.active_graded_generator_count_eq⟩

/-- The positive-generator Clifford calculation gives the null-basis readout
of the crosscap Pin action. -/
theorem crosscap_e_reflects_n_to_neg_nbar :
    reflect_in_e crosscapIndex (ι55 (n_pair crosscapIndex)) =
      -ι55 (nbar_pair crosscapIndex) :=
  reflect_n_eq_neg_nbar crosscapIndex

/-- The opposite null-basis readout of the same native Clifford action. -/
theorem crosscap_e_reflects_nbar_to_neg_n :
    reflect_in_e crosscapIndex (ι55 (nbar_pair crosscapIndex)) =
      -ι55 (n_pair crosscapIndex) :=
  reflect_nbar_eq_neg_n crosscapIndex

/-- The mandatory glide-reflection relation: the non-orientable generator
conjugates the torus translation to its inverse and has square a translation in
the orientable double cover. -/
theorem mandatory_glide_relation :
    (∀ z : ℂ, KleinBottle.G (KleinBottle.T z) =
      KleinBottle.T_inv (KleinBottle.G z)) ∧
    (∀ z : ℂ, KleinBottle.G (KleinBottle.G z) = z + 2) :=
  ⟨TorusKleinO55Bridge.klein_glide_twists_torus_translation,
    TorusKleinO55Bridge.klein_glide_square_is_translation⟩

/-- The O(5,5)-derived structural Hamiltonian inherits the mandatory
orientation reversal as the odd mirror sign. -/
theorem mandatory_glide_sets_positive_structural_mirror
    (m2 J Tiso v t : Q) :
    CasimirIsospinHamiltonian.mirrorDifference
      (fun Tz =>
        O55CasimirIsospinHamiltonian.o55StructuralHamiltonian
          (-crosscapOrientationSign) m2 J Tiso v Tz) t =
      (2 / 3) * t := by
  simpa [crosscapOrientationSign] using
    O55CasimirIsospinHamiltonian.o55_structural_mirror_oriented_positive
      m2 J Tiso v t

/-- Finite closure packet: native Pin membership, the separately owned
orientation/readout facts, the Klein glide laws, and the finite Hamiltonian
sign substitution.  No Pin-to-Klein or Pin-to-`O(5,5)` action theorem is
asserted here. -/
theorem pin_o55_glide_reflection_kernel :
    (ι55 (f_neg crosscapIndex) ∈ Pin55) ∧
    crosscapOrientationSign = -1 ∧
    torusTranslationOrientationSign = 1 ∧
    o55CarrierDimension = 10 ∧
    o55GeneratorCount = 45 ∧
    activeGlideGeneratorCount = 15 ∧
    twisted_adj crosscapReflectionPin55 (n_pair crosscapIndex) =
      -ι55 (nbar_pair crosscapIndex) ∧
    twisted_adj crosscapReflectionPin55 (nbar_pair crosscapIndex) =
      -ι55 (n_pair crosscapIndex) ∧
    (∀ z : ℂ, KleinBottle.G (KleinBottle.T z) =
      KleinBottle.T_inv (KleinBottle.G z)) ∧
    (∀ z : ℂ, KleinBottle.G (KleinBottle.G z) = z + 2) ∧
    (∀ m2 J Tiso v t : Q,
      CasimirIsospinHamiltonian.mirrorDifference
        (fun Tz =>
          O55CasimirIsospinHamiltonian.o55StructuralHamiltonian
            (-crosscapOrientationSign) m2 J Tiso v Tz) t =
        (2 / 3) * t) := by
  constructor
  · exact f_neg_mem_pin55 crosscapIndex
  constructor
  · exact crosscap_orientation_reversing
  constructor
  · exact torus_translation_orientation_sign
  constructor
  · exact TorusKleinO55Bridge.doubled_cartan_carrier_dimension_eq
  constructor
  · exact O55GradedGeneratorBasis.full_graded_generator_count_eq
  constructor
  · exact O55GradedGeneratorBasis.active_graded_generator_count_eq
  constructor
  · exact crosscap_pin_twisted_adj_n_to_neg_nbar
  constructor
  · exact crosscap_pin_twisted_adj_nbar_to_neg_n
  constructor
  · exact TorusKleinO55Bridge.klein_glide_twists_torus_translation
  constructor
  · exact TorusKleinO55Bridge.klein_glide_square_is_translation
  · exact mandatory_glide_sets_positive_structural_mirror

end PinO55GlideReflection

end noncomputable section
