import InfoGeometry.Canonical.GeometricMonodromy
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Canonical.JordanWignerCantorRepresentation

/-!
# Jordan--Wigner Hestenes monodromy in the real colimit

This file specializes the theorem-safe spinorial half-angle transport from
`GeometricMonodromy` to the already constructed global Hestenes--Krein phase
`hestenesBivectorInf` and its transported real Cantor-operator image
`realCantorBivectorInf`.

It proves only algebraic/trigonometric monodromy readouts (`2π ↦ -1`,
`4π ↦ 1`).  It does not claim a geometric Stokes theorem, de Rham residue
calculus, GNS annihilation theorem, or analytic-completion result.
-/

set_option synthInstance.maxHeartbeats 100000

noncomputable section

namespace InfoGeometry.Canonical.JordanWignerGeometricMonodromy

open InfoGeometry.Canonical.GeometricMonodromy
open InfoGeometry.Canonical.JordanWignerCantorRepresentation
open InfoGeometry.Clifford.Cl11TensorTowerLimit

/-- Matrix-colimit half-angle transport generated by the global Hestenes phase. -/
def hestenesBivectorTransport (θ : ℝ) : Limit :=
  spinorTransport hestenesBivectorInf θ

/-- Cantor-operator half-angle transport generated by the transported global phase. -/
def realCantorBivectorTransport (θ : ℝ) : RealCantorOpInf :=
  spinorTransport realCantorBivectorInf θ

/-- The actual global Hestenes--Krein colimit phase has spinorial `2π` monodromy `-1`. -/
theorem hestenesBivectorInf_spinorial_monodromy_around_pole :
    hestenesBivectorTransport (2 * Real.pi) = -(1 : Limit) :=
  spinorial_monodromy_around_pole hestenesBivectorInf

/-- The actual global Hestenes--Krein colimit phase returns to `+1` after `4π`. -/
theorem hestenesBivectorInf_spinorial_double_loop_identity :
    hestenesBivectorTransport (4 * Real.pi) = (1 : Limit) :=
  spinorial_double_loop_identity hestenesBivectorInf

/-- The transported real Cantor-operator phase has spinorial `2π` monodromy `-1`. -/
theorem realCantorBivectorInf_spinorial_monodromy_around_pole :
    realCantorBivectorTransport (2 * Real.pi) = -(1 : RealCantorOpInf) :=
  spinorial_monodromy_around_pole realCantorBivectorInf

/-- The transported real Cantor-operator phase returns to `+1` after `4π`. -/
theorem realCantorBivectorInf_spinorial_double_loop_identity :
    realCantorBivectorTransport (4 * Real.pi) = (1 : RealCantorOpInf) :=
  spinorial_double_loop_identity realCantorBivectorInf

end InfoGeometry.Canonical.JordanWignerGeometricMonodromy
