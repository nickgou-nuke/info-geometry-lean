import InfoGeometry.Cocycle.MatrixDetExpTrace
import InfoGeometry.Algebra.FiniteSpinAlgebra

noncomputable section

namespace InfoGeometry.Analysis.LieExponentialTraceDeterminant

open Matrix

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Lie-exponential path generated by a fixed finite real matrix. -/
def lieExponentialPath (A : Matrix n n ℝ) : ℝ → Matrix n n ℝ :=
  fun t => NormedSpace.exp (t • A)

/-- The Lie-exponential path starts at the identity. -/
theorem lieExponentialPath_zero (A : Matrix n n ℝ) :
    lieExponentialPath A 0 = 1 := by
  simp [lieExponentialPath]

/-- The constant-generator path is a one-parameter matrix group. -/
theorem lieExponentialPath_add (A : Matrix n n ℝ) (s t : ℝ) :
    lieExponentialPath A (s + t) =
      lieExponentialPath A s * lieExponentialPath A t := by
  have hcomm : Commute (s • A) (t • A) := by
    exact (Commute.refl A).smul_left s |>.smul_right t
  simpa [lieExponentialPath, add_smul] using
    (Matrix.exp_add_of_commute (s • A) (t • A) hcomm)

/-- Determinant of the Lie-exponential path is the scalar exponential of the trace. -/
theorem det_lieExponentialPath (A : Matrix n n ℝ) (t : ℝ) :
    (lieExponentialPath A t).det =
      Real.exp (t * Matrix.trace A) := by
  calc
    (lieExponentialPath A t).det =
        NormedSpace.exp (Matrix.trace (t • A)) := by
      simpa [lieExponentialPath] using
        (InfoGeometry.Cocycle.MatrixDetExpTrace.det_exp_eq_exp_trace_real (t • A))
    _ = Real.exp (t * Matrix.trace A) := by
      rw [Matrix.trace_smul, smul_eq_mul]
      rw [← Real.exp_eq_exp_ℝ]

/-- Zero-trace generators yield determinant-one flows. -/
theorem lieExponential_volume_preserving_of_trace_zero
    (A : Matrix n n ℝ) (hA : Matrix.trace A = 0) :
    ∀ t : ℝ, (lieExponentialPath A t).det = 1 := by
  intro t
  rw [det_lieExponentialPath]
  simp [hA]

end InfoGeometry.Analysis.LieExponentialTraceDeterminant
