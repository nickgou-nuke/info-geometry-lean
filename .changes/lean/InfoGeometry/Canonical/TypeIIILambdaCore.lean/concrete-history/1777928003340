{"type":"new","contents":"import InfoGeometry.Canonical.DiscreteModularSpectrum\nimport InfoGeometry.Canonical.ChiralOperatorConeClosure\nimport InfoGeometry.Canonical.DrazinSupercharge\nimport InfoGeometry.Canonical.TypeIIIContinuousCoreReal\nimport InfoGeometry.Meta.Architecture\n\n/-!\n# Type III Lambda Core\n\nConservative Connes-scale classification surface for the discrete modular\nspectrum lane.\n\nThis file provides coordinate-free modular scale bookkeeping. \nFinite-dimensional scalar diagonal matrices are NOT allowed.\n-/\n\nnamespace InfoGeometry.Canonical.TypeIIILambdaCore\n\nopen InfoGeometry.Canonical.DiscreteModularSpectrum\n\n/-- Additive log-scale group used for Connes-style modular scale bookkeeping. -/\n@[rep_depth transport]\nstructure TypeIIIScaleGroup where\n  G : Set ℝ\n  zero_mem : 0 ∈ G\n  add_closed : ∀ {a b : ℝ}, a ∈ G → b ∈ G → a + b ∈ G\n  neg_closed : ∀ {a : ℝ}, a ∈ G → -a ∈ G\n\nnamespace TypeIIIScaleGroup\n\n/-- Integer-period subgroup generated by `T`. -/\n@[rep_depth transport]\ndef integerPeriodSet (T : ℝ) : Set ℝ :=\n  { t | ∃ k : ℤ, t = (k : ℝ) * T }\n\n/-- The integer multiples of any period form an additive log-scale group. -/\n@[rep_depth transport]\ndef integerPeriod (T : ℝ) : TypeIIIScaleGroup where\n  G := integerPeriodSet T\n  zero_mem := ⟨0, by simp⟩\n  add_closed := by\n    rintro a b ⟨k, rfl⟩ ⟨m, rfl⟩\n    refine ⟨k + m, ?_⟩\n    push_cast; ring\n  neg_closed := by\n    rintro a ⟨k, rfl⟩\n    refine ⟨-k, ?_⟩\n    push_cast; ring\n\n@[rep_depth transport, simp]\ntheorem integerPeriod_mem_iff (T t : ℝ) :\n    t ∈ (integerPeriod T).G ↔ ∃ k : ℤ, t = (k : ℝ) * T :=\n  Iff.rfl\n\nend TypeIIIScaleGroup\n\n/--\nType `III_λ` discrete scale data with `q > 1`.\nThe period is `log q`.\n-/\n@[rep_depth transport]\nstructure DiscreteTypeIIILambdaScale extends TypeIIIScaleGroup where\n  q : ℝ\n  hq : 1 < q\n  period_eq_log_q : (TypeIIIScaleGroup.integerPeriod (Real.log q)).G = G\n\nnamespace DiscreteTypeIIILambdaScale\n\n/-- Canonical Type `III_λ` scale generated by `q > 1`. -/\n@[rep_depth transport]\ndef ofQ (q : ℝ) (hq : 1 < q) : DiscreteTypeIIILambdaScale where\n  toTypeIIIScaleGroup := TypeIIIScaleGroup.integerPeriod (Real.log q)\n  q := q\n  hq := hq\n  period_eq_log_q := rfl\n\n/-- The Connes lambda parameter associated to `q`; here `λ = q⁻¹`. -/\n@[rep_depth transport]\nnoncomputable def lambda (S : DiscreteTypeIIILambdaScale) : ℝ :=\n  S.q⁻¹\n\n/-- Every integer multiple of the fundamental period belongs to the scale group. -/\n@[rep_depth transport]\ntheorem int_mul_log_q_mem (S : DiscreteTypeIIILambdaScale) (k : ℤ) :\n    (k : ℝ) * Real.log S.q ∈ S.G := by\n  rw [← S.period_eq_log_q]\n  exact ⟨k, rfl⟩\n\nend DiscreteTypeIIILambdaScale\n\nsection LambdaLattice\n\n/--\nProof-carrying Type `III_λ` modular lattice.\nCoordinate-free and strictly operator-first.\n-/\n@[rep_depth operator]\nstructure ModularLambdaLattice (E : Type 0) [NormedAddCommGroup E] \n    [InnerProductSpace ℝ E] [CompleteSpace E] (CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)) where\n  scale : DiscreteTypeIIILambdaScale\n  lattice : ModularMellinLattice E CIK\n  q_eq : lattice.q = scale.q\n  /--\n  Spectral restriction gate: any certified eigenvalue/readout of the modular\n  Hamiltonian lies in the Type `III_λ` log-scale group.\n  -/\n  spectralReadoutInScale : ∀ eval : ℝ, eval ∈ scale.G\n\nnamespace ModularLambdaLattice\n\nvariable {E : Type 0} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\nvariable {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)}\nvariable (L : ModularLambdaLattice E CIK)\n\n/-- Lattice thermal-time samples are integer multiples of the Type `III_λ` period. -/\n@[rep_depth transport, capstone]\ntheorem thermalTimeStep_mem_scale (k : ℤ) :\n    L.lattice.thermalTimeStep k ∈ L.scale.G := by\n  unfold ModularMellinLattice.thermalTimeStep\n  have hlog : Real.log L.lattice.q = Real.log L.scale.q := by\n    exact congrArg Real.log L.q_eq\n  rw [hlog]\n  exact L.scale.int_mul_log_q_mem k\n\n/-- The Drazin projector is invariant under discrete boosts on the lambda lattice. -/\n@[rep_depth operator]\ntheorem drazin_projector_invariant (k : ℤ) :\n    L.lattice.discreteBoost k (CertifiedInverseKernel.spectralProjector (E := InfoGeometry.Krein.DoubledSpace E) CIK) = \n      CertifiedInverseKernel.spectralProjector (E := InfoGeometry.Krein.DoubledSpace E) CIK :=\n  L.lattice.drazin_projector_invariant k\n\nend ModularLambdaLattice\n\nsection SuperMellin\n\n/--\nMellin shift operator on a Type `III_λ` modular lattice.\nCoordinate-free algebraic interface.\n-/\n@[rep_depth operator]\nstructure MellinShift (E : Type 0) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n    {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)} (L : ModularLambdaLattice E CIK) where\n  shiftOperator : (InfoGeometry.Krein.DoubledSpace E →L[ℝ] InfoGeometry.Krein.DoubledSpace E)\n  shiftInverse : (InfoGeometry.Krein.DoubledSpace E →L[ℝ] InfoGeometry.Krein.DoubledSpace E)\n  shift_left_inv : shiftInverse * shiftOperator = ContinuousLinearMap.id ℝ (InfoGeometry.Krein.DoubledSpace E)\n  shift_right_inv : shiftOperator * shiftInverse = ContinuousLinearMap.id ℝ (InfoGeometry.Krein.DoubledSpace E)\n  weyl_covariance :\n    shiftOperator * L.lattice.K0 * shiftInverse =\n      (L.scale.q⁻¹) • L.lattice.K0\n\n/--\nSupercharge interface over a Type `III_λ` modular lattice.\nCoordinate-free root algebra.\n-/\n@[rep_depth operator]\nstructure MellinSupercharge (E : Type 0) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n    {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)} (L : ModularLambdaLattice E CIK) where\n  Q : (InfoGeometry.Krein.DoubledSpace E →L[ℝ] InfoGeometry.Krein.DoubledSpace E)\n  nilpotent : Q * Q = 0\n  halfWeight : ℝ\n  modular_weight :\n    L.lattice.K0 * Q - Q * L.lattice.K0 = halfWeight • Q\n\n/--\nOperatorial central extension of the Super-Mellin algebra.\nStrictly coordinate-free.\n-/\n@[rep_depth operator]\nstructure SuperMellinAlgebra (E : Type 0) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] \n    {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)} (L : ModularLambdaLattice E CIK) where\n  shift : MellinShift E L\n  supercharge : MellinSupercharge E L\n  centralOperator : (InfoGeometry.Krein.DoubledSpace E →L[ℝ] InfoGeometry.Krein.DoubledSpace E)\n  central_isDrazinLaneCentral :\n    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.IsDrazinLaneCentralK\n      CIK centralOperator\n  central_isDefectSupported :\n    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.IsDefectSupportedK\n      CIK centralOperator\n  supercharge_mem_chiralCone :\n    InfoGeometry.Canonical.ChiralOperatorConeClosure.IsInChiralOperatorCone\n      CIK supercharge.Q\n  superHamiltonian_split :\n    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.superHamiltonianK (E := InfoGeometry.Krein.DoubledSpace E) CIK =\n      L.lattice.K0 + centralOperator\n  shift_supercharge_commutator :\n    shift.shiftOperator * supercharge.Q * shift.shiftInverse - supercharge.Q =\n      centralOperator * supercharge.Q\n\nnamespace SuperMellinAlgebra\n\nvariable {E : Type 0} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\nvariable {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)}\nvariable {L : ModularLambdaLattice E CIK}\nvariable (A : SuperMellinAlgebra E L)\n\nlocal notation \"H₂_loc\" => InfoGeometry.Krein.DoubledSpace E\nlocal notation \"EndH_loc\" => H₂_loc →L[ℝ] H₂_loc\n\nnoncomputable local instance : NormedRing EndH_loc := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH_loc := inferInstance\nlocal instance : IsTopologicalRing EndH_loc := inferInstance\nlocal instance : CompleteSpace EndH_loc := inferInstance\n\n/-- The operator-valued central channel is central on the Drazin lane. -/\n@[rep_depth krein]\ntheorem centralOperator_isDrazinLaneCentral :\n    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.IsDrazinLaneCentralK\n      CIK A.centralOperator :=\n  A.central_isDrazinLaneCentral\n\n/-- The operator-valued central channel is supported on the defect block. -/\n@[rep_depth krein]\ntheorem centralOperator_isDefectSupported :\n    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.IsDefectSupportedK\n      CIK A.centralOperator :=\n  A.central_isDefectSupported\n\n/-- The Super-Mellin root lies in the repo-owned spectral chiral cone. -/\n@[rep_depth krein]\ntheorem supercharge_in_chiralCone :\n    InfoGeometry.Canonical.ChiralOperatorConeClosure.IsInChiralOperatorCone\n      CIK A.supercharge.Q :=\n  A.supercharge_mem_chiralCone\n\n/-- The Super-Mellin commutator lands through the operator-valued central action. -/\n@[rep_depth krein]\ntheorem shift_supercharge_commutator_eq_central_action :\n    A.shift.shiftOperator * A.supercharge.Q * A.shift.shiftInverse - A.supercharge.Q =\n      A.centralOperator * A.supercharge.Q :=\n  A.shift_supercharge_commutator\n\nend SuperMellinAlgebra\n\nend SuperMellin\n\nend LambdaLattice\n\nend InfoGeometry.Canonical.TypeIIILambdaCore\n","mtime":1777928003340}