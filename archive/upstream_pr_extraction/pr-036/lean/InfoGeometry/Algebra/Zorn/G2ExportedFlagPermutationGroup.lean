import InfoGeometry.Algebra.Zorn.G2ExportedFlagGeneratorAction

/-!
# The subgroup generated by the verified exported flag permutations

This is the honest finite action owner available before an ambient
`SplitOctF2Aut`-to-certificate homomorphism has been proved.
-/

namespace InfoGeometry.Algebra.Zorn.G2ExportedFlagPermutationGroup

open InfoGeometry.Algebra.Zorn.G2ExportedFlagGeneratorAction

def exportedFlagGenerators : Set (Equiv.Perm ExportedFlag) :=
  Set.range pcFlagPerm ∪ {correctedTFlagPerm}

def exportedFlagPermutationGroup :
    Subgroup (Equiv.Perm ExportedFlag) :=
  Subgroup.closure exportedFlagGenerators

instance : MulAction exportedFlagPermutationGroup ExportedFlag :=
  MulAction.ofSubgroup (Equiv.Perm ExportedFlag)
    exportedFlagPermutationGroup

theorem pcFlagPerm_mem (k : Fin 7) :
    pcFlagPerm k ∈ exportedFlagPermutationGroup := by
  apply Subgroup.subset_closure
  exact Or.inl ⟨k, rfl⟩

theorem correctedTFlagPerm_mem :
    correctedTFlagPerm ∈ exportedFlagPermutationGroup := by
  apply Subgroup.subset_closure
  exact Or.inr rfl

end InfoGeometry.Algebra.Zorn.G2ExportedFlagPermutationGroup
