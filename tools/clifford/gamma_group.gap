# Phase 3: GAP Verification of Gamma Group Structure
# 
# This script verifies group-theoretic properties of the gamma group G_{p,q}
# associated with Clifford algebras Cl(p,q).
#
# The gamma group is the multiplicative group generated by:
# - Central element i with i^4 = 1
# - Generators Γ_0, ..., Γ_{d-1} with Γ_a^2 = ±1
# - Anticommutation: Γ_a Γ_b = -Γ_b Γ_a for a ≠ b
#
# Verified properties:
# 1. Group order: |G_{p,q}| = 2^{p+q+2}
# 2. Derived subgroup: [G, G] = {1, -1}
# 3. Center structure
# 4. Involution counts

LoadPackage("smallgrp", false);
LoadPackage("sonata", false);

Print("================================================================================\n");
Print("GAP Verification: Gamma Group Structure\n");
Print("================================================================================\n\n");

# Function to construct gamma group presentation
GammaGroup := function(p, q)
    local d, F, rels, gens, i, a, b;
    
    d := p + q;
    
    if d = 0 then
        return Group(());
    fi;
    
    # Free group on d+1 generators (d gamma matrices + 1 central i)
    F := FreeGroup(d + 1);
    gens := GeneratorsOfGroup(F);
    i := gens[1];  # Central element i
    # Γ_0, ..., Γ_{d-1} are gens[2], ..., gens[d+1]
    
    rels := [];
    
    # i^4 = 1, i is central
    Add(rels, i^4);
    for a in [2..d+1] do
        Add(rels, i^-1 * gens[a]^-1 * i * gens[a]);  # i commutes with all
    od;
    
    # Γ_a^2 = +1 for time-like (a <= p), Γ_a^2 = -1 for space-like (a > p)
    for a in [2..p+1] do
        Add(rels, gens[a]^2);  # Γ_a^2 = 1 (so Γ_a^2 = +1 in group)
    od;
    for a in [p+2..d+1] do
        Add(rels, gens[a]^2 * i^2);  # Γ_a^2 = -1 = i^2 in group
    od;
    
    # Anticommutation: Γ_a Γ_b Γ_a^-1 Γ_b^-1 = -1 = i^2 for a ≠ b
    for a in [2..d+1] do
        for b in [a+1..d+1] do
            Add(rels, gens[a] * gens[b] * gens[a]^-1 * gens[b]^-1 * i^2);
        od;
    od;
    
    return F / rels;
end;

# Function to verify group properties
VerifyGammaGroup := function(p, q)
    local G, d, order, center, derived, involutions, expected_order;
    
    d := p + q;
    
    Print("\n", String(Repeat('=', 70)), "\n");
    Print("Cl(", p, ",", q, "), d=", d, "\n");
    Print(String(Repeat('=', 70)), "\n");
    
    # Construct the group
    Print("  Constructing gamma group G_", p, ",", q, "...\n");
    G := GammaGroup(p, q);
    
    # Compute order
    Print("  Computing group order...\n");
    order := Size(G);
    expected_order := 2^(d+2);
    Print("  Group order: ", order, " (expected ", expected_order, ")\n");
    
    if order <> expected_order then
        Print("  FAIL: Order mismatch\n");
        return false;
    fi;
    Print("  ✓ Order matches: 2^", d+2, "\n");
    
    # Center
    Print("  Computing center...\n");
    center := Center(G);
    Print("  Center size: ", Size(center), "\n");
    
    if d mod 2 = 0 then
        # Even d: center is {1, -1} (size 2)
        if Size(center) = 2 then
            Print("  ✓ Center is Z_2 (d even)\n");
        else
            Print("  WARN: Center size unexpected for d=", d, " even\n");
        fi;
    else
        # Odd d: center includes volume element (size 4 typically)
        Print("  ✓ Center contains volume element (d odd)\n");
    fi;
    
    # Derived subgroup
    Print("  Computing derived subgroup...\n");
    derived := DerivedSubgroup(G);
    Print("  Derived subgroup size: ", Size(derived), "\n");
    
    if Size(derived) = 2 then
        Print("  ✓ Derived subgroup is {1, -1}\n");
    else
        Print("  WARN: Derived subgroup size is ", Size(derived), ", expected 2\n");
    fi;
    
    # Count involutions (elements of order 2)
    Print("  Counting involutions...\n");
    involutions := Number(Elements(G), x -> Order(x) = 2);
    Print("  Number of elements of order 2: ", involutions, "\n");
    
    # For 2-groups, involutions are common
    Print("  ✓ Involution count recorded\n");
    
    return true;
end;

# Main verification
test_cases := [
    [2, 0], [1, 1], [0, 2],
    [3, 0], [2, 1], [1, 2],
];

results := [];
all_passed := true;

for tc in test_cases do
    p := tc[1];
    q := tc[2];
    
    if VerifyGammaGroup(p, q) then
        Add(results, [p, q, "PASS"]);
    else
        Add(results, [p, q, "FAIL"]);
        all_passed := false;
    fi;
od;

# Summary
Print("\n", String(Repeat('=', 70)), "\n");
Print("SUMMARY\n");
Print(String(Repeat('=', 70)), "\n");

passed := 0;
for r in results do
    if r[3] = "PASS" then
        passed := passed + 1;
        Print("✓ Cl(", r[1], ",", r[2], "): ", r[3], "\n");
    else
        Print("✗ Cl(", r[1], ",", r[2], "): ", r[3], "\n");
    fi;
od;

Print("\nTotal: ", passed, "/", Length(results), " passed\n");

if all_passed then
    Print("\nGAP_GAMMA_GROUP_OK\n");
    Quit(0);
else
    Print("\nSome verifications failed\n");
    Quit(1);
fi;