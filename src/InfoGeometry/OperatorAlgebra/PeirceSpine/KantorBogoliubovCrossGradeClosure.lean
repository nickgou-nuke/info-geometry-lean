import InfoGeometry.OperatorAlgebra.PeirceSpine.KantorBogoliubovSpinePoset
import InfoGeometry.OperatorAlgebra.PeirceSpine.KantorCrossGradeBrackets

/-!
# Corrected cross-grade Kantor closure and Bogoliubov mode actions

This file extends A₅₀–A₅₈ in the same arbitrary associative ring with an
idempotent. It records the chiral cross-bracket readouts, Peirce grade
separation, and mode/projector identities that follow from the owner
definitions. In particular, extremal Kantor sandwiches factor through the
odd Peirce grade.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine

variable {B : Type*} [Ring B]

/-- Sum of the two extremal Kantor sandwich operators. -/
def kantorExt (P A C X : B) : B := kantorGp2 P A X + kantorGm2 P C X

/-- The two mode combinations used in the cross-grade readout. -/
def crossGradeDarkMode (P A C : B) : B :=
  genV P A C * genPhi P A C + genSig P A C

def crossGradeAmpMode (P A C : B) : B := genPhi P A C - genSig P A C

/-- Double commutator with the grading perturbation `S + Φ`. -/
def crossGradeQuasiProjector (P A C X : B) : B :=
  comm (invS P + genPhi P A C) (comm (invS P + genPhi P A C) X)

/-- Opposite extremal sandwiches reconstruct the two diagonal support
corners, while the square of the zero-grade operator reconstructs the two
crossed support corners. -/
theorem archetype_A60_bilateral_support_reconstruction
    {P : B} (hP : P * P = P) (A C X : B) :
    (kantorGp2 P A (kantorGm2 P C X) + kantorGm2 P C (kantorGp2 P A X)) +
      kantorG0 P A C (kantorG0 P A C X) =
      genV P A C * X * genV P A C ∧
    kantorG0 P A C (kantorG0 P A C X) -
      (kantorGp2 P A (kantorGm2 P C X) + kantorGm2 P C (kantorGp2 P A X)) =
      genSig P A C * X * genSig P A C := by
  refine ⟨?_, ?_⟩ <;> peirce_abel_golay hP

/-- The sum of the two explicitly defined mode operators is annihilated by
the zero-grade Kantor operator. -/
theorem archetype_A62_kantor_action_on_bogoliubov_modes
    {P : B} (hP : P * P = P) (A C : B) :
    kantorG0 P A C (crossGradeDarkMode P A C) =
      -(genV P A C * genSig P A C) ∧
    kantorG0 P A C (crossGradeAmpMode P A C) =
      genV P A C * genSig P A C ∧
    kantorG0 P A C (crossGradeDarkMode P A C + crossGradeAmpMode P A C) = 0 := by
  dsimp only [crossGradeDarkMode, crossGradeAmpMode]
  dsimp only [kantorG0, kantorTriple]
  peirce_nf hP
  simp

/-- The extremal and charge-one Kantor channels on the same two modes. -/
theorem archetype_A62_extremal_and_grade_one_mode_actions
    {P : B} (hP : P * P = P) (A C : B) :
    kantorExt P A C (crossGradeDarkMode P A C) =
      (genV P A C * genV P A C) * genPhi P A C ∧
    kantorExt P A C (crossGradeAmpMode P A C) =
      genV P A C * genPhi P A C ∧
    kantorGp1 P A (crossGradeDarkMode P A C) +
        kantorGm1 P C (crossGradeDarkMode P A C) =
      -((2 : ℤ) • (genV P A C * genJ P A C)) ∧
    kantorGp1 P A (crossGradeAmpMode P A C) +
        kantorGm1 P C (crossGradeAmpMode P A C) =
      (2 : ℤ) • (genV P A C * genJ P A C) := by
  dsimp only [crossGradeDarkMode, crossGradeAmpMode, kantorExt,
    kantorGp2, kantorGm2, kantorGp1, kantorGm1, comm]
  peirce_nf hP
  simp

/-- The double commutator generated by `S + Φ` splits into the Peirce
double commutator, the `Φ` double commutator, and both mixed compositions. -/
theorem archetype_A63_bogoliubov_quasiparticle_projector_decomposition
    {P : B} (hP : P * P = P) (A C X : B) :
    crossGradeQuasiProjector P A C X =
      (4 : ℤ) • oddGrade P X - derivSqPhi P A C X +
        comm (invS P) (comm (genPhi P A C) X) +
        comm (genPhi P A C) (comm (invS P) X) ∧
    crossGradeQuasiProjector P A C (genPhi P A C) =
      (4 : ℤ) • genPhi P A C - (4 : ℤ) • genSig P A C ∧
    crossGradeQuasiProjector P A C (genSig P A C) =
      (4 : ℤ) • (genV P A C * genSig P A C) -
        (4 : ℤ) • (genV P A C * genPhi P A C) := by
  have hExpand : crossGradeQuasiProjector P A C X =
      comm (invS P) (comm (invS P) X) +
        comm (invS P) (comm (genPhi P A C) X) +
        comm (genPhi P A C) (comm (invS P) X) +
        comm (genPhi P A C) (comm (genPhi P A C) X) := by
    dsimp only [crossGradeQuasiProjector, comm]
    noncomm_ring
  have hGrade : comm (invS P) (comm (invS P) X) =
      (4 : ℤ) • oddGrade P X := by
    peirce_nf hP
  have hDecomp : crossGradeQuasiProjector P A C X =
      (4 : ℤ) • oddGrade P X - derivSqPhi P A C X +
        comm (invS P) (comm (genPhi P A C) X) +
        comm (genPhi P A C) (comm (invS P) X) := by
    calc
    crossGradeQuasiProjector P A C X =
        comm (invS P) (comm (invS P) X) +
          comm (invS P) (comm (genPhi P A C) X) +
          comm (genPhi P A C) (comm (invS P) X) +
          comm (genPhi P A C) (comm (genPhi P A C) X) := hExpand
    _ = (4 : ℤ) • oddGrade P X - derivSqPhi P A C X +
          comm (invS P) (comm (genPhi P A C) X) +
          comm (genPhi P A C) (comm (invS P) X) := by
      rw [hGrade]
      simp only [derivSqPhi]
      abel
  refine ⟨hDecomp, ?_, ?_⟩ <;> dsimp only [crossGradeQuasiProjector,
    genPhi, genSig, genV, qgtPlus, qgtMinus, conePlus, coneMinus,
    invS, comm, anticomm] <;> peirce_nf hP

/-- The difference of the squared extremal and zero-grade Kantor operators
has the negative chiral sandwich. Equivalently, reversing the subtraction
gives `Σ X Σ`. This fixes the sign in the proposed `kExt² - kG0²` identity. -/
theorem archetype_A64_kantor_square_difference_sign
    {P : B} (hP : P * P = P) (A C X : B) :
    kantorG0 P A C (kantorG0 P A C X) -
        kantorExt P A C (kantorExt P A C X) =
      genSig P A C * X * genSig P A C ∧
    kantorExt P A C (kantorExt P A C X) -
        kantorG0 P A C (kantorG0 P A C X) =
      -(genSig P A C * X * genSig P A C) := by
  have hCross : kantorExt P A C (kantorExt P A C X) =
      kantorGp2 P A (kantorGm2 P C X) +
        kantorGm2 P C (kantorGp2 P A X) := by
    dsimp only [kantorExt, kantorGp2, kantorGm2]
    peirce_nf hP
  have hSign := (archetype_A60_bilateral_support_reconstruction hP A C X).2
  constructor
  · rw [hCross]
    exact hSign
  · rw [hCross]
    calc
      (kantorGp2 P A (kantorGm2 P C X) +
          kantorGm2 P C (kantorGp2 P A X)) -
          kantorG0 P A C (kantorG0 P A C X) =
        -(kantorG0 P A C (kantorG0 P A C X) -
          (kantorGp2 P A (kantorGm2 P C X) +
            kantorGm2 P C (kantorGp2 P A X))) := by abel
      _ = -(genSig P A C * X * genSig P A C) := by rw [hSign]

end InfoGeometry.OperatorAlgebra.PeirceSpine
