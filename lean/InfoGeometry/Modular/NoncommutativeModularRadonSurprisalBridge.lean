/-!
=============================================================================
PART 1: The Inner Derivation / Modular Commutator
=============================================================================
-/

variable {A : Type*} [Ring A]

/-- The Adjoint Action (Commutator) generated by a Modular Relative Surprisal K:
    ad_K(X) = [K, X] = K * X - X * K -/
def adK (K : A) : A →ₗ[ℤ] A where
  toFun X := K * X - X * K
  map_add' X Y := by
    simp only [mul_add, add_mul]
    abel
  map_smul' r X := by
    change K * (r • X) - (r • X) * K = r • (K * X - X * K)
    have hL : K * (r • X) = r • (K * X) := (AddMonoidHom.mulLeft K).map_zsmul X r
    have hR : (r • X) * K = r • (X * K) := (AddMonoidHom.mulRight K).map_zsmul X r
    rw [hL, hR, smul_sub]

@[simp]
theorem adK_apply (K X : A) : adK K X = K * X - X * K := rfl

/-- 
  THEOREM 1: The Modular Commutator is a Genuine Derivation (Leibniz Rule).
  ad_K(X * Y) = (ad_K X) * Y + X * (ad_K Y)
-/
theorem adK_is_derivation (K : A) (X Y : A) :
    adK K (X * Y) = (adK K X) * Y + X * (adK K Y) := by
  simp only [adK_apply]
  calc
    K * (X * Y) - (X * Y) * K
      = (K * X * Y - X * K * Y) + (X * K * Y - X * Y * K) := by
        simp only [mul_assoc]
        abel
    _ = (K * X - X * K) * Y + X * (K * Y - Y * K) := by
        simp only [sub_mul, mul_sub, mul_assoc]

/-- THEOREM 2: The Modular Derivation annihilates the identity element: ad_K(1) = 0. -/
@[simp]
theorem adK_one (K : A) :
    adK K 1 = 0 := by
  rw [adK_apply K 1, mul_one, one_mul, sub_self]

/-- THEOREM 3: The Modular Derivation annihilates its generator: ad_K(K) = 0. -/
@[simp]
theorem adK_self (K : A) :
    adK K K = 0 := by
  rw [adK_apply K K, sub_self]

/-- THEOREM 4: Vanishing of ad_K(X) is equivalent to commutation K * X = X * K. -/
theorem adK_eq_zero_iff_commute (K X : A) :
    adK K X = 0 ↔ K * X = X * K := by
  simp only [adK_apply, sub_eq_zero]

/-- THEOREM 5: Commutator of Inner Derivations is the Inner Derivation of the Commutator. -/
theorem adK_commutator (K L X : A) :
    adK K (adK L X) - adK L (adK K X) = adK (K * L - L * K) X := by
  simp only [adK_apply]
  noncomm_ring

/-!
=============================================================================
PART 2: Noncommutative Radon–Nikodym Logarithmic Derivatives
=============================================================================
-/

/-- A Leibniz derivation on an arbitrary ring A. -/
structure RingDerivation (A : Type*) [Ring A] where
  toFun : A → A
  map_add' : ∀ x y, toFun (x + y) = toFun x + toFun y
  leibniz' : ∀ x y, toFun (x * y) = toFun x * y + x * toFun y

namespace RingDerivation

variable (D : RingDerivation A)

instance : CoeFun (RingDerivation A) (fun _ => A → A) where
  coe D := D.toFun

@[simp] theorem map_add (x y : A) : D (x + y) = D x + D y := D.map_add' x y
@[simp] theorem leibniz (x y : A) : D (x * y) = D x * y + x * D y := D.leibniz' x y

@[simp]
theorem map_zero : D 0 = 0 := by
  have h : D 0 + D 0 = D 0 + 0 := by
    rw [add_zero, ← D.map_add, add_zero]
  exact add_left_cancel h

@[simp]
theorem map_one : D 1 = 0 := by
  have h : D 1 = D 1 + D 1 := by
    calc
      D 1 = D (1 * 1) := by rw [mul_one]
      _ = D 1 * 1 + 1 * D 1 := D.leibniz 1 1
      _ = D 1 + D 1 := by rw [mul_one, one_mul]
  have h2 : (D 1 + D 1) - D 1 = D 1 - D 1 := congrArg (fun x => x - D 1) h.symm
  simpa using h2

/-- Noncommutative Left Logarithmic Derivative: dlog_L(u) = u⁻¹ * D(u) -/
def dlogL (u : Aˣ) : A :=
  (u⁻¹ : Aˣ).val * D (u.val)

/-- Noncommutative Right Logarithmic Derivative: dlog_R(u) = D(u) * u⁻¹ -/
def dlogR (u : Aˣ) : A :=
  D (u.val) * (u⁻¹ : Aˣ).val

@[simp]
theorem dlogL_one : D.dlogL (1 : Aˣ) = 0 := by
  dsimp [dlogL]
  rw [D.map_one, mul_zero]

@[simp]
theorem dlogR_one : D.dlogR (1 : Aˣ) = 0 := by
  dsimp [dlogR]
  rw [D.map_one, zero_mul]

/-- 
  THEOREM 6: Connes Noncommutative Gauge Cocycle Transformation (Left dlog).
  dlog_L(u * v) = v⁻¹ * dlog_L(u) * v + dlog_L(v)
-/
theorem dlogL_mul (u : Aˣ) (v : Aˣ) :
    D.dlogL (u * v) = (v⁻¹ : Aˣ).val * D.dlogL u * (v : Aˣ).val + D.dlogL v := by
  dsimp [dlogL]
  rw [D.leibniz]
  have h_inv : ((u * v)⁻¹ : Aˣ).val = (v⁻¹ : Aˣ).val * (u⁻¹ : Aˣ).val := by
    rw [mul_inv_rev, Units.val_mul]
  rw [h_inv]
  have hu : (u⁻¹ : Aˣ).val * (u.val) = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  calc
    ((v⁻¹ : Aˣ).val * (u⁻¹ : Aˣ).val) * (D (u.val) * (v.val) + (u.val) * D (v.val))
      = ((v⁻¹ : Aˣ).val * (u⁻¹ : Aˣ).val) * (D (u.val) * (v.val)) +
        ((v⁻¹ : Aˣ).val * (u⁻¹ : Aˣ).val) * ((u.val) * D (v.val)) := by rw [mul_add]
    _ = (v⁻¹ : Aˣ).val * ((u⁻¹ : Aˣ).val * D (u.val)) * (v.val) +
        (v⁻¹ : Aˣ).val * (((u⁻¹ : Aˣ).val * (u.val)) * D (v.val)) := by
          simp only [mul_assoc]
    _ = (v⁻¹ : Aˣ).val * ((u⁻¹ : Aˣ).val * D (u.val)) * (v.val) +
        (v⁻¹ : Aˣ).val * (1 * D (v.val)) := by rw [hu]
    _ = (v⁻¹ : Aˣ).val * ((u⁻¹ : Aˣ).val * D (u.val)) * (v.val) +
        (v⁻¹ : Aˣ).val * D (v.val) := by rw [one_mul]

/-- 
  THEOREM 7: Noncommutative Right Logarithmic Product Rule.
  dlog_R(u * v) = dlog_R(u) + u * dlog_R(v) * u⁻¹
-/
theorem dlogR_mul (u : Aˣ) (v : Aˣ) :
    D.dlogR (u * v) = D.dlogR u + (u : Aˣ).val * D.dlogR v * (u⁻¹ : Aˣ).val := by
  dsimp [dlogR]
  rw [D.leibniz]
  have h_inv : ((u * v)⁻¹ : Aˣ).val = (v⁻¹ : Aˣ).val * (u⁻¹ : Aˣ).val := by
    rw [mul_inv_rev, Units.val_mul]
  rw [h_inv]
  have hv : (v.val * (v⁻¹ : Aˣ).val) = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  calc
    (D (u.val) * (v.val) + (u.val) * D (v.val)) * ((v⁻¹ : Aˣ).val * (u⁻¹ : Aˣ).val)
      = (D (u.val) * (v.val)) * ((v⁻¹ : Aˣ).val * (u⁻¹ : Aˣ).val) +
        ((u.val) * D (v.val)) * ((v⁻¹ : Aˣ).val * (u⁻¹ : Aˣ).val) := by rw [add_mul]
    _ = D (u.val) * ((v.val * (v⁻¹ : Aˣ).val) * (u⁻¹ : Aˣ).val) +
        (u.val * (D (v.val) * (v⁻¹ : Aˣ).val)) * (u⁻¹ : Aˣ).val := by
          simp only [mul_assoc]
    _ = D (u.val) * (1 * (u⁻¹ : Aˣ).val) +
        (u.val * (D (v.val) * (v⁻¹ : Aˣ).val)) * (u⁻¹ : Aˣ).val := by rw [hv]
    _ = D (u.val) * (u⁻¹ : Aˣ).val +
        (u.val * (D (v.val) * (v⁻¹ : Aˣ).val)) * (u⁻¹ : Aˣ).val := by rw [one_mul]

/-- 
  THEOREM 8: Noncommutative Inversion Duality: dlog_L(u⁻¹) = - dlog_R(u).
-/
theorem dlogL_inv_eq_neg_dlogR (u : Aˣ) :
    D.dlogL (u⁻¹) = - D.dlogR u := by
  have _ := u
  have h_prod : D (u.val * (u⁻¹ : Aˣ).val) = 0 := by
    have hu : u.val * (u⁻¹ : Aˣ).val = 1 := by
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
    rw [hu, D.map_one]
  rw [D.leibniz] at h_prod
  have h_shift : u.val * D (u⁻¹ : Aˣ).val = - (D (u.val) * (u⁻¹ : Aˣ).val) :=
    eq_neg_of_add_eq_zero_right h_prod
  dsimp [dlogL, dlogR]
  have h_inv_inv : ((u⁻¹ : Aˣ)⁻¹ : Aˣ).val = u.val := rfl
  rw [h_inv_inv, h_shift]

/-- 
  THEOREM 9: Commuting Additivity of the Logarithmic Derivation.
  If v commutes with dlog_L(u), then dlog_L(u * v) = dlog_L(u) + dlog_L(v).
-/
theorem dlogL_mul_of_commute (u : Aˣ) (v : Aˣ)
    (h_comm : D.dlogL u * (v : Aˣ).val = (v : Aˣ).val * D.dlogL u) :
    D.dlogL (u * v) = D.dlogL u + D.dlogL v := by
  rw [D.dlogL_mul]
  have hv : (v⁻¹ : Aˣ).val * (v : Aˣ).val = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  calc
    (v⁻¹ : Aˣ).val * D.dlogL u * (v : Aˣ).val + D.dlogL v
      = (v⁻¹ : Aˣ).val * (D.dlogL u * (v : Aˣ).val) + D.dlogL v := by simp only [mul_assoc]
    _ = (v⁻¹ : Aˣ).val * ((v : Aˣ).val * D.dlogL u) + D.dlogL v := by rw [h_comm]
    _ = ((v⁻¹ : Aˣ).val * (v : Aˣ).val) * D.dlogL u + D.dlogL v := by simp only [mul_assoc]
    _ = 1 * D.dlogL u + D.dlogL v := by rw [hv]
    _ = D.dlogL u + D.dlogL v := by rw [one_mul]

end RingDerivation

/-!
=============================================================================
PART 3: The Trifold Surprisal Decomposition in 2x2 Matrix Algebra
=============================================================================
-/

variable {R : Type*} [CommRing R]

open Matrix

/-- The Identity / Common Weyl matrix generator: I₂ = [[1, 0], [0, 1]] -/
def commonWeyl : Matrix (Fin 2) (Fin 2) R :=
  1

/-- The Chiral Grading / Berezinian matrix generator: Γ = [[1, 0], [0, -1]] -/
def chiralWeyl : Matrix (Fin 2) (Fin 2) R :=
  ![![1, 0], ![0, -1]]

/-- The Off-Diagonal Split-Octonionic Shape Matrix: K₀(u, v) = [[0, u], [v, 0]] -/
def shapeDerivation (u v : R) : Matrix (Fin 2) (Fin 2) R :=
  ![![0, u], ![v, 0]]

/-- The Universal Trifold Relative Surprisal Operator:
    K = α • I₂ + β • Γ + K₀(u, v) -/
def trifoldSurprisal (α β u v : R) : Matrix (Fin 2) (Fin 2) R :=
  α • commonWeyl + β • chiralWeyl + shapeDerivation u v

/-- Supertrace definition on 2x2 matrices: STr(M) = M 0 0 - M 1 1 -/
def supertrace (M : Matrix (Fin 2) (Fin 2) R) : R :=
  M 0 0 - M 1 1

theorem supertrace_add (M N : Matrix (Fin 2) (Fin 2) R) :
    supertrace (M + N) = supertrace M + supertrace N := by
  dsimp [supertrace]
  ring

theorem supertrace_smul (c : R) (M : Matrix (Fin 2) (Fin 2) R) :
    supertrace (c • M) = c * supertrace M := by
  dsimp [supertrace]
  ring

/-- THEOREM 10: Trace of Common Weyl is 2. -/
@[simp]
theorem trace_commonWeyl : trace (commonWeyl : Matrix (Fin 2) (Fin 2) R) = (2 : R) := by
  dsimp [commonWeyl, trace]
  simp

/-- THEOREM 11: Trace of Chiral Weyl vanishes. -/
@[simp]
theorem trace_chiralWeyl : trace (chiralWeyl : Matrix (Fin 2) (Fin 2) R) = 0 := by
  dsimp [chiralWeyl, trace]
  simp

/-- THEOREM 12: Trace of Shape Derivation vanishes (Traceless). -/
@[simp]
theorem trace_shapeDerivation (u : R) (v : R) :
    trace (shapeDerivation u v : Matrix (Fin 2) (Fin 2) R) = 0 := by
  dsimp [shapeDerivation, trace]
  simp

/-- THEOREM 13: Supertrace of Common Weyl vanishes. -/
@[simp]
theorem supertrace_commonWeyl : supertrace (commonWeyl : Matrix (Fin 2) (Fin 2) R) = 0 := by
  dsimp [commonWeyl, supertrace]
  simp

/-- THEOREM 14: Supertrace of Chiral Weyl is 2. -/
@[simp]
theorem supertrace_chiralWeyl : supertrace (chiralWeyl : Matrix (Fin 2) (Fin 2) R) = (2 : R) := by
  dsimp [chiralWeyl, supertrace]
  ring

/-- THEOREM 15: Supertrace of Shape Derivation vanishes (Supertraceless). -/
@[simp]
theorem supertrace_shapeDerivation (u : R) (v : R) :
    supertrace (shapeDerivation u v : Matrix (Fin 2) (Fin 2) R) = 0 := by
  have _ := u
  have _ := v
  dsimp [shapeDerivation, supertrace]
  simp

/-- 
  🏆 THEOREM 16: The Master Trace Readout (Common Radon–Nikodym Volume).
  Tr(K) = 2 • α
-/
theorem trace_trifoldSurprisal (α : R) (β : R) (u : R) (v : R) :
    trace (trifoldSurprisal α β u v) = (2 : R) * α := by
  dsimp [trifoldSurprisal]
  rw [trace_add, trace_add, trace_smul, trace_smul]
  rw [trace_commonWeyl, trace_chiralWeyl, trace_shapeDerivation u v]
  simp only [smul_eq_mul, mul_zero, add_zero]
  ring

/-- 
  🏆 THEOREM 17: The Master Supertrace Readout (Chiral Berezinian Imbalance).
  STr(K) = 2 • β
-/
theorem supertrace_trifoldSurprisal (α : R) (β : R) (u : R) (v : R) :
    supertrace (trifoldSurprisal α β u v) = (2 : R) * β := by
  dsimp [trifoldSurprisal]
  rw [supertrace_add, supertrace_add, supertrace_smul, supertrace_smul]
  rw [supertrace_commonWeyl, supertrace_chiralWeyl, supertrace_shapeDerivation u v]
  ring

/-- 
  🏆 THEOREM 18: Pure Shape Derivations are both Traceless and Supertraceless.
  Tr(K₀) = 0 ∧ STr(K₀) = 0
-/
theorem shapeDerivation_traceless_and_supertraceless (u : R) (v : R) :
    trace (shapeDerivation u v : Matrix (Fin 2) (Fin 2) R) = 0 ∧
    supertrace (shapeDerivation u v : Matrix (Fin 2) (Fin 2) R) = 0 :=
  ⟨trace_shapeDerivation u v, supertrace_shapeDerivation u v⟩

end InfoGeometry.Modular.Synthesis

end noncomputable section
