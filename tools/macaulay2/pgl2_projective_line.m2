-- tools/macaulay2/pgl2_projective_line.m2

-- Define the homogeneous coordinate ring of P^1 and the generic matrix variables
R = QQ[a, b, c, d, z1, z2, w1, w2]

-- Define the generic matrix action on the homogeneous coordinate ring of P^1
-- The action is given by [w1:w2] = [a*z1 + b*z2 : c*z1 + d*z2]
-- This corresponds to the ideal generated by the 2x2 minors of the matrix
-- [ w1  a*z1 + b*z2 ]
-- [ w2  c*z1 + d*z2 ]
I = ideal(w1 * (c*z1 + d*z2) - w2 * (a*z1 + b*z2))

-- Compute the ideal linking the homogeneous coordinates (w_1, w_2) to the affine coordinate chart patch where z_2 = 1 and w_2 = 1
Ipatch = substitute(I, {z2 => 1, w2 => 1})

-- Verify that the restricted algebra simplifies into exactly w_1 = (a z_1 + b)/(c z_1 + d)
-- This corresponds to the polynomial relation w1 * (c*z1 + d) - (a*z1 + b) == 0
expected = ideal(w1 * (c*z1 + d) - (a*z1 + b))

if Ipatch == expected then (
    print "Verification passed: The restricted algebra simplifies into exactly w_1 = (a z_1 + b)/(c z_1 + d)";
) else (
    print "Verification failed.";
    exit 1;
)
