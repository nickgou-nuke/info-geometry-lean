import InfoGeometry.Algebra.Zorn.G2TwoSylowPCGenerators
import InfoGeometry.Algebra.Zorn.G2TwoSylowPCAutomorphisms

namespace InfoGeometry.Algebra.Zorn.G2TwoSylowSubgroup

open InfoGeometry.OperatorAlgebra.G2TwoAutomorphismTheorem
open InfoGeometry.Algebra.Zorn.G2TwoSylowPCGenerators (pc1Fun pc2Fun pc3Fun pc4Fun pc5Fun pc6Fun)
open InfoGeometry.Algebra.Zorn.G2TwoSylowPCAutomorphisms

/-- A boolean exponent choice for the 6 PC generators. -/
abbrev PCWordExp := Fin 6 → Bool

def pcTerm (i : Fin 6) (b : Bool) : SplitOctF2Aut :=
  if b then pcGenerator i else 1

/-- The ordered polycyclic normal form word p1^e0 * p2^e1 * p3^e2 * p4^e3 * p5^e4 * p6^e5. -/
def pcWord (e : PCWordExp) : SplitOctF2Aut :=
  pcTerm 0 (e 0) * pcTerm 1 (e 1) * pcTerm 2 (e 2) *
  pcTerm 3 (e 3) * pcTerm 4 (e 4) * pcTerm 5 (e 5)

/-- The 2-Sylow subgroup generated by the 6 polycyclic generators. -/
def sylowTwoSubgroup : Subgroup SplitOctF2Aut :=
  Subgroup.closure (Set.range pcGenerator)

theorem pcTerm_mem_sylow (i : Fin 6) (b : Bool) :
    pcTerm i b ∈ sylowTwoSubgroup := by
  dsimp [pcTerm]
  split_ifs
  · exact Subgroup.subset_closure ⟨i, rfl⟩
  · exact Subgroup.one_mem _

/-- Every PC word belongs to the 2-Sylow subgroup. -/
theorem pcWord_mem_sylow (e : PCWordExp) : pcWord e ∈ sylowTwoSubgroup := by
  dsimp [pcWord]
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _
    (Subgroup.mul_mem _ (Subgroup.mul_mem _
      (pcTerm_mem_sylow 0 (e 0)) (pcTerm_mem_sylow 1 (e 1)))
      (pcTerm_mem_sylow 2 (e 2))) (pcTerm_mem_sylow 3 (e 3)))
      (pcTerm_mem_sylow 4 (e 4))) (pcTerm_mem_sylow 5 (e 5))

/-- The domain of 6-bit exponents has cardinality 64. -/
theorem pcWordExp_card : Fintype.card PCWordExp = 64 := by
  rw [Fintype.card_fun, Fintype.card_fin, Fintype.card_bool]
  norm_num

/-- Term action on SplitOctF2. -/
def pcTermFun (i : Fin 6) (b : Bool) (X : SplitOctF2) : SplitOctF2 :=
  if b then
    match i with
    | 0 => pc1Fun X
    | 1 => pc2Fun X
    | 2 => pc3Fun X
    | 3 => pc4Fun X
    | 4 => pc5Fun X
    | 5 => pc6Fun X
  else X

theorem pcTerm_apply (i : Fin 6) (b : Bool) (X : SplitOctF2) :
    (pcTerm i b).1 X = pcTermFun i b X := by
  dsimp [pcTerm, pcTermFun, pcGenerator, pc1Aut, pc2Aut, pc3Aut, pc4Aut, pc5Aut, pc6Aut,
    involutiveEquiv, pc2Equiv, pc3Equiv]
  cases b
  · rfl
  · fin_cases i <;> rfl

/-- Computable action of PC word on SplitOctF2. -/
def pcWordFun (e : PCWordExp) (X : SplitOctF2) : SplitOctF2 :=
  pcTermFun 5 (e 5) (pcTermFun 4 (e 4) (pcTermFun 3 (e 3)
    (pcTermFun 2 (e 2) (pcTermFun 1 (e 1) (pcTermFun 0 (e 0) X)))))

theorem aut_mul_apply (g h : SplitOctF2Aut) (X : SplitOctF2) :
    (g * h).1 X = h.1 (g.1 X) := rfl

theorem pcWord_apply (e : PCWordExp) (X : SplitOctF2) :
    (pcWord e).1 X = pcWordFun e X := by
  dsimp [pcWord, pcWordFun]
  repeat rw [aut_mul_apply]
  repeat rw [pcTerm_apply]

/-- The concrete 8-basis action of each PC exponent word. -/
def basisAction (e : PCWordExp) : Fin 8 → SplitOctF2 :=
  fun i => pcWordFun e (basis8 i)

/-- 🏆 THEOREM: The 64 PC basis actions are 100% distinct (injective). -/
theorem basisAction_injective : Function.Injective basisAction := by
  decide

theorem pcWord_apply_basis (e : PCWordExp) (i : Fin 8) :
    (pcWord e).1 (basis8 i) = basisAction e i := by
  dsimp [basisAction]
  rw [pcWord_apply]

theorem pcWord_injective : Function.Injective pcWord := by
  intro e1 e2 h
  apply basisAction_injective
  funext i
  have hi : (pcWord e1).1 (basis8 i) = (pcWord e2).1 (basis8 i) := by
    rw [h]
  rw [pcWord_apply_basis, pcWord_apply_basis] at hi
  exact hi

/-- 🏆 THEOREM: The image of pcWord in SplitOctF2Aut has cardinality exactly 64. -/
theorem pcWord_range_card :
    Nat.card (Set.range pcWord) = 64 := by
  rw [Nat.card_range_of_injective pcWord_injective, Nat.card_eq_fintype_card, pcWordExp_card]

end InfoGeometry.Algebra.Zorn.G2TwoSylowSubgroup
