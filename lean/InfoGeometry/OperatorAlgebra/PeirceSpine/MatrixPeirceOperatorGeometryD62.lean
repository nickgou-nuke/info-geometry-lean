import InfoGeometry.OperatorAlgebra.PeirceSpine.ConnesGaugeConfinementD61
import InfoGeometry.OperatorAlgebra.PeirceChiralGeometry
import InfoGeometry.Meta.ArchetypePipeline

/-!
# D₆₂: Matrix realization of Peirce odd geometry

This module identifies the D₆₁ odd Peirce projection with the existing matrix
odd-part owner and transports its Gram, positivity, and kernel theorems. The
projection is an arbitrary star projection in `Matrix n n ℂ`; no coordinate
diagonalization or commutativity assumption is imposed.
-/

noncomputable section

namespace InfoGeometry.OperatorAlgebra.PeirceSpine

open Matrix InfoGeometry.Core.IdempotentCartan
open InfoGeometry.Core.PeirceDecomposition
open InfoGeometry.OperatorAlgebra.PeirceChiralGeometry
open InfoGeometry.MetaCompiler
open scoped ComplexOrder

variable {n : Type*} [Fintype n] [DecidableEq n]

/-! ## The D₆₂ causal archetypes -/

inductive MatrixD62Stage where
  | peirceCut
  | oddComponent
  | gramIdentity
  | positiveGeometry
  | kernelCriterion
  deriving DecidableEq, Repr

def MatrixD62Stage.rank : MatrixD62Stage → ℕ
  | .peirceCut => 0
  | .oddComponent => 1
  | .gramIdentity => 2
  | .positiveGeometry => 3
  | .kernelCriterion => 3

/-- The kernel criterion and positivity are separate consequences of the Gram identity. -/
def MatrixD62Stage.edge : MatrixD62Stage → MatrixD62Stage → Prop
  | .peirceCut, .oddComponent =>
      ∀ {n : Type} [Fintype n] [DecidableEq n] (p A : Matrix n n ℂ),
        oddGrade p A = p * A * (1 - p) + (1 - p) * A * p
  | .oddComponent, .gramIdentity =>
      ∀ {n : Type} [Fintype n] [DecidableEq n] {p A : Matrix n n ℂ},
        IsStarProjection p → IsSelfAdjoint A →
          oddGrade p A * oddGrade p A = star ⁅p, A⁆ * ⁅p, A⁆
  | .gramIdentity, .positiveGeometry =>
      ∀ {n : Type} [Fintype n] [DecidableEq n] {p A : Matrix n n ℂ},
        IsStarProjection p → IsSelfAdjoint A →
          (oddGrade p A * oddGrade p A).PosSemidef
  | .gramIdentity, .kernelCriterion =>
      ∀ {n : Type} [Fintype n] [DecidableEq n] {p A : Matrix n n ℂ},
        IsStarProjection p → IsSelfAdjoint A →
          (oddGrade p A * oddGrade p A = 0 ↔ Commute p A)
  | _, _ => False

inductive MatrixD62Stage.Reachable : MatrixD62Stage → MatrixD62Stage → Prop where
  | refl (a : MatrixD62Stage) : Reachable a a
  | edge {a b : MatrixD62Stage} : a.edge b → Reachable a b
  | trans {a b c : MatrixD62Stage} : Reachable a b → Reachable b c → Reachable a c

/-- The causal order is generated by the direct theorem dependencies. -/
def MatrixD62Stage.causalLE : MatrixD62Stage → MatrixD62Stage → Prop := Reachable

theorem MatrixD62Stage.causalLE_refl (a : MatrixD62Stage) : a.causalLE a := by
  exact Reachable.refl a

theorem MatrixD62Stage.causalLE_trans {a b c : MatrixD62Stage}
    (hab : a.causalLE b) (hbc : b.causalLE c) : a.causalLE c := by
  exact Reachable.trans hab hbc

theorem MatrixD62Stage.edge_rank_strict {a b : MatrixD62Stage} (h : a.edge b) :
    a.rank < b.rank := by
  cases a <;> cases b <;> simp [edge, rank] at h ⊢

theorem MatrixD62Stage.reachable_rank_strict_of_ne {a b : MatrixD62Stage}
    (h : a.Reachable b) (hne : a ≠ b) : a.rank < b.rank := by
  induction h with
  | @refl x => exact (hne rfl).elim
  | edge h => exact edge_rank_strict h
  | @trans x y z hxy hyz ihxy ihyz =>
      by_cases hxyEq : x = y
      · subst y
        exact ihyz hne
      · by_cases hyzEq : y = z
        · subst z
          exact ihxy hne
        · exact lt_trans (ihxy hxyEq) (ihyz hyzEq)

theorem MatrixD62Stage.causalLE_antisymm {a b : MatrixD62Stage}
    (hab : a.causalLE b) (hba : b.causalLE a) : a = b := by
  by_cases hEq : a = b
  · exact hEq
  · exact (lt_asymm (reachable_rank_strict_of_ne hab hEq)
      (reachable_rank_strict_of_ne hba (Ne.symm hEq))).elim

instance : PartialOrder MatrixD62Stage where
  le := MatrixD62Stage.causalLE
  le_refl := MatrixD62Stage.causalLE_refl
  le_trans := fun _ _ _ hab hbc => MatrixD62Stage.causalLE_trans hab hbc
  le_antisymm := fun _ _ hab hba => MatrixD62Stage.causalLE_antisymm hab hba

theorem MatrixD62Stage.edge_causal {a b : MatrixD62Stage} (h : a.edge b) :
    a.causalLE b := by
  exact MatrixD62Stage.Reachable.edge h

/-! ## Matrix geometry transported from the Peirce owner -/

/-- The square of a self-adjoint odd Peirce component is the Gram operator of
the commutator with the arbitrary star projection. -/
theorem d62_odd_square_eq_commutator_gram {p A : Matrix n n ℂ}
    (hp : IsStarProjection p) (hA : IsSelfAdjoint A) :
    oddGrade p A * oddGrade p A = star ⁅p, A⁆ * ⁅p, A⁆ := by
  simpa [oddGrade, oddPart, component10, component01, complementIdempotent] using
    odd_square_eq_lie_gram hp hA

/-- The matrix Gram identity makes the odd Peirce square positive semidefinite. -/
theorem d62_odd_square_posSemidef {p A : Matrix n n ℂ}
    (hp : IsStarProjection p) (hA : IsSelfAdjoint A) :
    (oddGrade p A * oddGrade p A).PosSemidef := by
  rw [d62_odd_square_eq_commutator_gram hp hA]
  exact Matrix.posSemidef_conjTranspose_mul_self _

/-- Faithfulness of the matrix Gram form: the odd square vanishes exactly when
the operator commutes with the star projection. -/
theorem d62_odd_square_eq_zero_iff_commute {p A : Matrix n n ℂ}
    (hp : IsStarProjection p) (hA : IsSelfAdjoint A) :
    oddGrade p A * oddGrade p A = 0 ↔ Commute p A := by
  simpa [oddGrade, oddPart, component10, component01, complementIdempotent] using
    odd_square_eq_zero_iff_commute hp hA

/-- Trace faithfulness gives the same commutation criterion from vanishing
matrix trace of the positive Peirce square. -/
theorem d62_trace_odd_square_eq_zero_iff_commute {p A : Matrix n n ℂ}
    (hp : IsStarProjection p) (hA : IsSelfAdjoint A) :
    Matrix.trace (oddGrade p A * oddGrade p A) = 0 ↔ Commute p A := by
  simpa [oddGrade, oddPart, component10, component01, complementIdempotent] using
    trace_odd_square_eq_zero_iff_commute hp hA

/-- Synthesis of matrix identification, Gram positivity, and faithful kernel
criterion over arbitrary finite-dimensional operator matrices. -/
theorem stage_D62_matrix_peirce_gram_geometry {p A : Matrix n n ℂ}
    (hp : IsStarProjection p) (hA : IsSelfAdjoint A) :
    oddGrade p A * oddGrade p A = star ⁅p, A⁆ * ⁅p, A⁆ ∧
    (oddGrade p A * oddGrade p A).PosSemidef ∧
    (oddGrade p A * oddGrade p A = 0 ↔ Commute p A) ∧
    (Matrix.trace (oddGrade p A * oddGrade p A) = 0 ↔ Commute p A) := by
  exact ⟨d62_odd_square_eq_commutator_gram hp hA,
    d62_odd_square_posSemidef hp hA,
    d62_odd_square_eq_zero_iff_commute hp hA,
    d62_trace_odd_square_eq_zero_iff_commute hp hA⟩

theorem MatrixD62Stage.edge_cut_odd :
    MatrixD62Stage.edge .peirceCut .oddComponent := by
  intro n _ _ p A
  simp [oddGrade, oddPart, component10, component01, complementIdempotent]

theorem MatrixD62Stage.edge_odd_gram :
    MatrixD62Stage.edge .oddComponent .gramIdentity := by
  intro n _ _ p A hp hA
  exact d62_odd_square_eq_commutator_gram hp hA

theorem MatrixD62Stage.edge_gram_positive :
    MatrixD62Stage.edge .gramIdentity .positiveGeometry := by
  intro n _ _ p A hp hA
  exact d62_odd_square_posSemidef hp hA

theorem MatrixD62Stage.edge_gram_kernel :
    MatrixD62Stage.edge .gramIdentity .kernelCriterion := by
  intro n _ _ p A hp hA
  exact d62_odd_square_eq_zero_iff_commute hp hA

/-- Finite-matrix input for the Gram-geometry archetype. Its cut and
self-adjointness requirements are explicit data, not diagonalization axioms. -/
structure MatrixD62GramInput (n : Type*) [Fintype n] [DecidableEq n] where
  cut : Matrix n n ℂ
  operator : Matrix n n ℂ
  cutProjection : IsStarProjection cut
  operatorSelfAdjoint : IsSelfAdjoint operator

/-- The odd Peirce square is a positive Gram operator, with its zero and
trace-zero cases characterized by commutation with the projection. -/
def matrixD62GramArchetype :
    TypedArchetype (MatrixD62GramInput n) .proved where
  name := `InfoGeometry.OperatorAlgebra.PeirceSpine.matrixD62GramArchetype
  phase := 62
  claim := fun input =>
    oddGrade input.cut input.operator * oddGrade input.cut input.operator =
        star ⁅input.cut, input.operator⁆ * ⁅input.cut, input.operator⁆ ∧
      (oddGrade input.cut input.operator * oddGrade input.cut input.operator).PosSemidef ∧
      (oddGrade input.cut input.operator * oddGrade input.cut input.operator = 0 ↔
        Commute input.cut input.operator) ∧
      (Matrix.trace (oddGrade input.cut input.operator * oddGrade input.cut input.operator) = 0 ↔
        Commute input.cut input.operator)
  evidence := fun input => stage_D62_matrix_peirce_gram_geometry
    input.cutProjection input.operatorSelfAdjoint

#register_archetype matrixD62GramArchetype
#audit_archetype matrixD62GramArchetype

end InfoGeometry.OperatorAlgebra.PeirceSpine

end
