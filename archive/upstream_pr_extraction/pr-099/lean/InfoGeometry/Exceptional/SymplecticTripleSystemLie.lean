import InfoGeometry.Exceptional.SymplecticTripleSystem

noncomputable section

namespace InfoGeometry.Exceptional

/-!
# Inner derivations of a symplectic triple system

The triple-system laws provide a canonical Lie subalgebra of endomorphisms:
the Lie subalgebra generated by the operators `z ↦ [x,y,z]`.  This owner only
packages that already-available closure; it does not assert a particular
exceptional Lie algebra or a standard-envelope identification.
-/

def innerDerivationLieSubalgebra
    {T : Type*} [AddCommGroup T] [Module ℝ T]
    (S : SymplecticTripleSystemDatum T) :
    LieSubalgebra ℝ (Module.End ℝ T) :=
  LieSubalgebra.lieSpan ℝ (Module.End ℝ T)
    (Set.range fun p : T × T => innerDerivation S p.1 p.2)

theorem innerDerivation_mem_lieSubalgebra
    {T : Type*} [AddCommGroup T] [Module ℝ T]
    (S : SymplecticTripleSystemDatum T) (x y : T) :
    innerDerivation S x y ∈ innerDerivationLieSubalgebra S := by
  apply LieSubalgebra.subset_lieSpan
    (s := Set.range fun p : T × T => innerDerivation S p.1 p.2)
  exact ⟨(x, y), rfl⟩

theorem innerDerivation_commutator_mem_lieSubalgebra
    {T : Type*} [AddCommGroup T] [Module ℝ T]
    (S : SymplecticTripleSystemDatum T) (x y u v : T) :
    ⁅innerDerivation S x y, innerDerivation S u v⁆ ∈
      innerDerivationLieSubalgebra S := by
  rw [innerDerivation_commutator S x y u v]
  exact (innerDerivationLieSubalgebra S).add_mem
    (LieSubalgebra.subset_lieSpan
      (s := Set.range fun p : T × T => innerDerivation S p.1 p.2)
      ⟨(S.triple x y u, v), rfl⟩)
    (LieSubalgebra.subset_lieSpan
      (s := Set.range fun p : T × T => innerDerivation S p.1 p.2)
      ⟨(u, S.triple x y v), rfl⟩)

end InfoGeometry.Exceptional
