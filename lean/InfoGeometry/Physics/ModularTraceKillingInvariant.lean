import Mathlib.LinearAlgebra.Matrix.Trace
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Algebra.Lie.Basic
import Mathlib.Tactic
import InfoGeometry.Physics.MatrixTraceBimodulePairingNative

/-!
# Modular Trace Killing Invariant

This module proves that the finite trace pairing on matrix operators is
infinitesimally ad-invariant with respect to the commutator action generated by K,
and that the commutator derivation is skew-adjoint with respect to this pairing.
-/

open scoped Matrix
open InfoGeometry.Physics

namespace InfoGeometry.Physics.ModularTraceKillingInvariant

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- 🏆 THEOREM 1: Skew-adjointness of the commutator action with respect to the trace pairing. -/
theorem commutator_skew_adjoint (A X Y : TraceOperatorSpace n) :
    tracePairingNative (commutatorActionNative A X) Y =
      - tracePairingNative X (commutatorActionNative A Y) :=
  commutator_tracePairing_native A X Y

/-- 🏆 THEOREM 2: Energy conservation / infinitesimal modular orthogonality: Tr(H · [H, X]) = 0. -/
theorem energy_orthogonal (H X : TraceOperatorSpace n) :
    tracePairingNative H (commutatorActionNative H X) = 0 :=
  commutator_tracePairing_energyOrthogonal H X

/-- 🏆 THEOREM 3: Lie Jacobi identity for matrix commutator derivations. -/
theorem commutator_jacobi (A B X : TraceOperatorSpace n) :
    commutatorActionNative A (commutatorActionNative B X) -
        commutatorActionNative B (commutatorActionNative A X) =
      commutatorActionNative (A * B - B * A) X :=
  commutatorActionNative_jacobi A B X

end InfoGeometry.Physics.ModularTraceKillingInvariant
