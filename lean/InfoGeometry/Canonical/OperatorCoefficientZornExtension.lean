/-- THEOREM: The flow preserves the unit -/
theorem opFlow_preserves_one (D : OpDerivation) (t : ℂ) :
    (opFlow D t) (1 : OpZorn) = 1 := by
  have h₁ : (opFlow D t) (1 : OpZorn) = 1 := by
    have h₂ : opFlow D t = (D.toLinearMap).exp.map (t • (1 : OpZorn →L[ℂ] OpZorn)) := rfl
    rw [h₂]
    have h₃ : ((D.toLinearMap).exp.map (t • (1 : OpZorn →L[ℂ] OpZorn))) (1 : OpZorn) = 1 := by
      have h₄ : ((D.toLinearMap).exp.map (t • (1 : OpZorn →L[ℂ] OpZorn))) (1 : OpZorn) = 1 := by
        -- The exponential of a derivation preserves the identity
        have h₅ : ∀ (n : ℕ), ((D.toLinearMap) ^ n) (1 : OpZorn) = if n = 0 then (1 : OpZorn) else 0 := by
          intro n
          induction n with
          | zero => simp [LinearMap.one_apply]
          | succ n ih =>
            rw [Function.iterate_succ_apply']
            rw [ih]
            split_ifs <;> simp_all [LinearMap.map_zero]
            <;> aesop
        -- The exponential map applied to 1 gives 1
        simp [LinearMap.exp_apply, h₅]
        <;>
        norm_num
        <;>
        simp_all [Finset.sum_ite_eq']
        <;>
        aesop
      exact h₄
    exact h₃
  exact h₁

/-- THEOREM: The flow preserves the product -/
theorem opFlow_preserves_mul (D : OpDerivation) (t : ℂ) (X Y : OpZorn) :
    (opFlow D t) (X * Y) = (opFlow D t) X * (opFlow D t) Y := by
  exact opFlow_is_automorphism D t X Y

/-- THEOREM: The star operation is an involution -/
theorem opZornStar_involutive (X : OpZorn) : opZornStar (opZornStar X) = X := by
  ext <;> simp [opZornStar, ContinuousLinearMap.adjoint_adjoint]
  <;> aesop

/-- THEOREM: The star operation is an anti-automorphism -/
theorem opZornStar_antiAutomorphism (X Y : OpZorn) :
    opZornStar (X * Y) = opZornStar Y * opZornStar X := by
  ext <;> simp [opZornStar, opZornMul, ContinuousLinearMap.adjoint_comp]
  <;>
  (try aesop) <;>
  (try simp_all [ContinuousLinearMap.adjoint_comp, ContinuousLinearMap.adjoint_adjoint]) <;>
  (try ring_nf) <;>
  (try aesop)

/-- THEOREM: Derivation commutes with star iff D(X†) = D(X)† -/
theorem derivation_commutes_star (D : OpDerivation) (X : OpZorn) :
    (D.toLinearMap (opZornStar X)) = opZornStar (D.toLinearMap X) := by
  ext <;> simp [opZornStar, OpDerivation, ContinuousLinearMap.adjoint_apply]
  <;>
  (try aesop) <;>
  (try simp_all [ContinuousLinearMap.adjoint_apply]) <;>
  (try aesop)

