-- ============================================================================
-- Section 7: Distinctness of the Four Parity Operators
-- ============================================================================

private def vectorTest : Coord :=
  ((0 : ℝ), (fun _ : Fin 3 => 1), (fun _ : Fin 3 => 0), (0 : ℝ))

private def bivectorTest : Coord :=
  ((0 : ℝ), (fun _ : Fin 3 => 0), (fun _ : Fin 3 => 1), (0 : ℝ))

theorem P_ne_one : P ≠ 1 := by
  intro h
  have h' := congrArg (fun T : CoordEnd => T bivectorTest) h
  have h'' := congrArg (fun z : Coord => z.2.2.1 0) h'
  norm_num [bivectorTest, P, peirceGrading] at h''

theorem GammaF_ne_one : GammaF ≠ 1 := by
  intro h
  have h' := congrArg (fun T : CoordEnd => T vectorTest) h
  have h'' := congrArg (fun z : Coord => z.2.1 0) h'
  norm_num [vectorTest, GammaF, exteriorFermionParity, chiralGrading] at h''

theorem P_ne_GammaF : P ≠ GammaF := by
  intro h
  have h' := congrArg (fun T : CoordEnd => T vectorTest) h
  have h'' := congrArg (fun z : Coord => z.2.1 0) h'
  norm_num [vectorTest, P, GammaF, peirceGrading, exteriorFermionParity,
    chiralGrading] at h''

theorem M_mid_ne_one : M_mid ≠ 1 := by
  intro h
  have h' := congrArg (fun T : CoordEnd => T vectorTest) h
  have h'' := congrArg (fun z : Coord => z.2.1 0) h'
  norm_num [vectorTest, M_mid, middleSignFlip] at h''

theorem P_ne_M_mid : P ≠ M_mid := by
  intro h
  have h' := congrArg (fun T : CoordEnd => P * T) h
  have h'' : (1 : CoordEnd) = GammaF := by
    simpa [P_sq, P_mul_M] using h'
  exact GammaF_ne_one h''.symm

theorem GammaF_ne_M_mid : GammaF ≠ M_mid := by
  intro h
  have h' := congrArg (fun T : CoordEnd => GammaF * T) h
  have h'' : (1 : CoordEnd) = P := by
    simpa [GammaF_sq, GammaF_mul_M] using h'
  exact P_ne_one h''.symm

theorem parityPacket_ncard : parityPacket.ncard = 4 := by
  change ({1, P, GammaF, M_mid} : Set CoordEnd).ncard = 4
  rw [Set.ncard_insert_of_notMem]
  · rw [Set.ncard_insert_of_notMem]
    · rw [Set.ncard_insert_of_notMem]
      · simp
      · simp only [Set.mem_singleton_iff]
        exact GammaF_ne_M_mid
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
      exact ⟨P_ne_GammaF, P_ne_M_mid⟩
  · simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    exact ⟨P_ne_one.symm, GammaF_ne_one.symm, M_mid_ne_one.symm⟩

theorem paritySubmonoid_ncard : paritySubmonoid.carrier.ncard = 4 := by
  exact parityPacket_ncard

end InfoGeometry.Canonical.CayleyPeirceKleinFourBridge
