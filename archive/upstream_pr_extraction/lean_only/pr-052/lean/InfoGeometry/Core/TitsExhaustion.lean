import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Data.Set.Basic

/-!
# Subgroup-generation exhaustion for invariant subsets

This file isolates the group-theoretic engine used by concrete Bruhat corridors.
The central theorem deliberately proves only that the subgroup generated by a
set of stabilizing elements is contained in the invariant set. No ambient
`closure = ⊤` hypothesis is needed.
-/

namespace InfoGeometry.Foundations

section TitsExhaustion

variable {G : Type*} [Group G]

/-- The subgroup of elements whose left translations preserve membership in
`U` in both directions. -/
def leftStabilizer (U : Set G) : Subgroup G where
  carrier := {g | ∀ x, x ∈ U ↔ g * x ∈ U}
  one_mem' := by
    intro x
    simp
  mul_mem' := by
    intro g₁ g₂ hg₁ hg₂ x
    exact (hg₂ x).trans <| by
      simpa [mul_assoc] using hg₁ (g₂ * x)
  inv_mem' := by
    intro g hg x
    have h := (hg (g⁻¹ * x)).symm
    simpa [mul_assoc] using h

@[simp]
theorem mem_leftStabilizer_iff (U : Set G) (g : G) :
    g ∈ leftStabilizer U ↔ ∀ x, x ∈ U ↔ g * x ∈ U :=
  Iff.rfl

/-- A one-sided invariant action by an involution is automatically a
membership-preserving action. -/
theorem mem_leftStabilizer_of_sq_eq_one
    (U : Set G) {r : G}
    (hr : r * r = 1)
    (hforward : ∀ {x : G}, x ∈ U → r * x ∈ U) :
    r ∈ leftStabilizer U := by
  intro x
  constructor
  · exact hforward
  · intro hrx
    have hrrx : r * (r * x) ∈ U := hforward hrx
    simpa [← mul_assoc, hr] using hrrx

/-- If `U` contains `1` and every generator in `S` acts by a membership-
preserving left translation, then every element of `Subgroup.closure S`
belongs to `U`.

This is the non-circular exhaustion form: it makes no claim that the generated
subgroup is the whole ambient group. -/
theorem closure_subset_of_leftStabilizer
    (U : Set G) (h1 : (1 : G) ∈ U)
    (S : Set G) (hstab : S ⊆ leftStabilizer U) :
    (Subgroup.closure S : Set G) ⊆ U := by
  intro g hg
  have hle : Subgroup.closure S ≤ leftStabilizer U :=
    Subgroup.closure_le.mpr hstab
  have hgstab : g ∈ leftStabilizer U := hle hg
  have hmem : g * 1 ∈ U :=
    ((mem_leftStabilizer_iff U g).mp hgstab 1).mp h1
  simpa using hmem

/-- Full ambient exhaustion is a corollary once generation of the ambient
group has independently been proved. -/
theorem tits_exhaustion_of_closure_top
    (U : Set G) (h1 : (1 : G) ∈ U)
    (S : Set G) (hgen : Subgroup.closure S = ⊤)
    (hstab : S ⊆ leftStabilizer U) :
    U = Set.univ := by
  ext g
  simp only [Set.mem_univ, iff_true]
  apply closure_subset_of_leftStabilizer U h1 S hstab
  rw [hgen]
  exact Subgroup.mem_top g

end TitsExhaustion

end InfoGeometry.Foundations
