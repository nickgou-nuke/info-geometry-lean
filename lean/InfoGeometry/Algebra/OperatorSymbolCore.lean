import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra

/-!
# Canonical operator symbol algebra core

Dimension-free algebraic owners for two structures repeatedly used by the
finite Pauli--Dirac and Peirce/Witt bridges:

* an off-diagonal operator on `V × W`, whose square is controlled by the two
  ordered compositions of its chiral blocks;
* a rank-one CAR pair in an arbitrary associative ring, from which the two
  complementary Peirce projectors and their transport identities follow.

These statements are purely algebraic.  They make no analytic, spectral,
bundle, or unbounded-operator assertion.
-/

noncomputable section

namespace InfoGeometry.Algebra.OperatorSymbolCore

/-! ## Off-diagonal symbol square -/

section OffDiagonalSemiring

variable {R V W : Type*}
variable [Semiring R]
variable [AddCommMonoid V] [Module R V]
variable [AddCommMonoid W] [Module R W]

/-- The universal off-diagonal block operator with chiral blocks `A` and `B`. -/
def offDiagonalEnd (A : W →ₗ[R] V) (B : V →ₗ[R] W) : Module.End R (V × W) where
  toFun ψ := (A ψ.2, B ψ.1)
  map_add' := by
    intro x y
    ext <;> simp
  map_smul' := by
    intro r x
    ext <;> simp

@[simp]
theorem offDiagonalEnd_apply
    (A : W →ₗ[R] V) (B : V →ₗ[R] W) (v : V) (w : W) :
    offDiagonalEnd A B (v, w) = (A w, B v) :=
  rfl

/-- Squaring an off-diagonal symbol produces the two ordered block
compositions. -/
theorem offDiagonalEnd_sq_apply
    (A : W →ₗ[R] V) (B : V →ₗ[R] W) (ψ : V × W) :
    offDiagonalEnd A B (offDiagonalEnd A B ψ) =
      ((A.comp B) ψ.1, (B.comp A) ψ.2) := by
  rcases ψ with ⟨v, w⟩
  rfl

end OffDiagonalSemiring

section OffDiagonalCommSemiring

variable {R V W : Type*}
variable [CommSemiring R]
variable [AddCommMonoid V] [Module R V]
variable [AddCommMonoid W] [Module R W]

/-- If both ordered block products are the same scalar identity, the complete
off-diagonal symbol squares to that scalar on the product carrier. -/
theorem offDiagonalEnd_sq_scalar_apply
    (A : W →ₗ[R] V) (B : V →ₗ[R] W) (q : R)
    (hAB : A.comp B = q • (LinearMap.id : Module.End R V))
    (hBA : B.comp A = q • (LinearMap.id : Module.End R W))
    (ψ : V × W) :
    offDiagonalEnd A B (offDiagonalEnd A B ψ) = q • ψ := by
  rw [offDiagonalEnd_sq_apply, hAB, hBA]
  rcases ψ with ⟨v, w⟩
  ext <;> simp

/-- Endomorphism form of the scalar square law. -/
theorem offDiagonalEnd_sq_scalar
    (A : W →ₗ[R] V) (B : V →ₗ[R] W) (q : R)
    (hAB : A.comp B = q • (LinearMap.id : Module.End R V))
    (hBA : B.comp A = q • (LinearMap.id : Module.End R W)) :
    (offDiagonalEnd A B).comp (offDiagonalEnd A B) =
      q • (LinearMap.id : Module.End R (V × W)) := by
  apply LinearMap.ext
  intro ψ
  exact offDiagonalEnd_sq_scalar_apply A B q hAB hBA ψ

end OffDiagonalCommSemiring

/-! ## Rank-one CAR / Peirce algebra -/

section RankOneCAR

variable {A : Type*} [Ring A]

/-- A left inverse of the central integer `2` is two-sided and central, even
when the ambient ring is noncommutative. -/
theorem two_left_inverse_is_central (half : A) (hhalf : (2 : A) * half = 1) :
    half * (2 : A) = 1 ∧ ∀ x : A, half * x = x * half := by
  have hhalfRight : half * (2 : A) = 1 := by
    calc
      half * (2 : A) = half + half := by simp [mul_two]
      _ = (2 : A) * half := by simp [two_mul]
      _ = 1 := hhalf
  refine ⟨hhalfRight, ?_⟩
  intro x
  calc
    half * x = half * x * ((2 : A) * half) := by rw [hhalf]; simp
    _ = half * ((2 : A) * x) * half := by noncomm_ring
    _ = (half * (2 : A)) * x * half := by noncomm_ring
    _ = x * half := by rw [hhalfRight]; simp

/-- Particle/occupied Peirce projector generated by a CAR pair. -/
def carPlus (create annihilate : A) : A := create * annihilate

/-- Hole/vacuum Peirce projector generated by a CAR pair. -/
def carMinus (create annihilate : A) : A := annihilate * create

/-- CAR immediately gives completeness of the two Peirce sectors. -/
theorem car_projectors_complete
    {create annihilate : A}
    (hcar : create * annihilate + annihilate * create = 1) :
    carPlus create annihilate + carMinus create annihilate = 1 := by
  simpa [carPlus, carMinus] using hcar

/-- A square-zero CAR creation operator satisfies `c† c c† = c†`. -/
theorem create_annihilate_create
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    create * annihilate * create = create := by
  have h := congrArg (fun x : A => x * create) hcar
  simpa [add_mul, mul_assoc, hcreate] using h

/-- A square-zero CAR annihilation operator satisfies `c c† c = c`. -/
theorem annihilate_create_annihilate
    {create annihilate : A}
    (hannihilate : annihilate * annihilate = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    annihilate * create * annihilate = annihilate := by
  have h := congrArg (fun x : A => x * annihilate) hcar
  simpa [add_mul, mul_assoc, hannihilate] using h

/-- The occupied Peirce sector is idempotent. -/
theorem carPlus_idempotent
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carPlus create annihilate * carPlus create annihilate =
      carPlus create annihilate := by
  simp only [carPlus, ← mul_assoc]
  rw [create_annihilate_create hcreate hcar]

/-- The hole Peirce sector is idempotent. -/
theorem carMinus_idempotent
    {create annihilate : A}
    (hannihilate : annihilate * annihilate = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carMinus create annihilate * carMinus create annihilate =
      carMinus create annihilate := by
  simp only [carMinus, ← mul_assoc]
  rw [annihilate_create_annihilate hannihilate hcar]

/-- The two CAR Peirce projectors are orthogonal in both orders. -/
theorem car_projectors_orthogonal
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hannihilate : annihilate * annihilate = 0) :
    carPlus create annihilate * carMinus create annihilate = 0 ∧
      carMinus create annihilate * carPlus create annihilate = 0 := by
  constructor
  · calc
      carPlus create annihilate * carMinus create annihilate =
          create * (annihilate * annihilate) * create := by
            simp [carPlus, carMinus, mul_assoc]
      _ = 0 := by rw [hannihilate]; simp
  · calc
      carMinus create annihilate * carPlus create annihilate =
          annihilate * (create * create) * annihilate := by
            simp [carPlus, carMinus, mul_assoc]
      _ = 0 := by rw [hcreate]; simp

/-- Creation maps the hole sector into the occupied sector exactly. -/
theorem car_create_peirce_transport
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carPlus create annihilate * create * carMinus create annihilate = create := by
  rw [carPlus, carMinus]
  have hucu := create_annihilate_create hcreate hcar
  calc
    (create * annihilate) * create * (annihilate * create) =
        (create * annihilate * create) * (annihilate * create) := by
          simp [mul_assoc]
    _ = create * (annihilate * create) := by rw [hucu]
    _ = create * annihilate * create := by simp [mul_assoc]
    _ = create := hucu

/-- Annihilation maps the occupied sector into the hole sector exactly. -/
theorem car_annihilate_peirce_transport
    {create annihilate : A}
    (hannihilate : annihilate * annihilate = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carMinus create annihilate * annihilate * carPlus create annihilate =
      annihilate := by
  rw [carPlus, carMinus]
  have hdc := annihilate_create_annihilate hannihilate hcar
  calc
    (annihilate * create) * annihilate * (create * annihilate) =
        (annihilate * create * annihilate) * (create * annihilate) := by
          simp [mul_assoc]
    _ = annihilate * (create * annihilate) := by rw [hdc]
    _ = annihilate * create * annihilate := by simp [mul_assoc]
    _ = annihilate := hdc

/-- Complete rank-one CAR/Peirce packet. -/
theorem rankOneCAR_peirce_packet
    {create annihilate : A}
    (hcreate : create * create = 0)
    (hannihilate : annihilate * annihilate = 0)
    (hcar : create * annihilate + annihilate * create = 1) :
    carPlus create annihilate * carPlus create annihilate = carPlus create annihilate ∧
      carMinus create annihilate * carMinus create annihilate = carMinus create annihilate ∧
      carPlus create annihilate + carMinus create annihilate = 1 ∧
      carPlus create annihilate * carMinus create annihilate = 0 ∧
      carMinus create annihilate * carPlus create annihilate = 0 ∧
      carPlus create annihilate * create * carMinus create annihilate = create ∧
      carMinus create annihilate * annihilate * carPlus create annihilate = annihilate := by
  rcases car_projectors_orthogonal hcreate hannihilate with ⟨hpm, hmp⟩
  exact ⟨carPlus_idempotent hcreate hcar,
    carMinus_idempotent hannihilate hcar,
    car_projectors_complete hcar,
    hpm, hmp,
    car_create_peirce_transport hcreate hcar,
    car_annihilate_peirce_transport hannihilate hcar⟩

end RankOneCAR

/-! ## Split-quaternion Witt ladders without division -/

section SplitQuaternionWittLadders

variable {A : Type*} [Ring A]

/-- The doubled ladder packet associated to a split-quaternion pair. Keeping
the factors of two explicit makes the identities valid over every ring,
including characteristic two; normalized projectors require a separate
invertibility-of-two hypothesis. -/
theorem splitQuaternion_doubled_witt_ladders
    (J Ω : A)
    (hJ : J * J = 1)
    (hΩ : Ω * Ω = -1)
    (hJO : J * Ω + Ω * J = 0) :
    let K := J * Ω
    let ψp := K + Ω
    let ψm := K - Ω
    K * K = 1 ∧
      ψp * ψp = 0 ∧
      ψm * ψm = 0 ∧
      ψp * ψm = 2 • (1 + J) ∧
      ψm * ψp = 2 • (1 - J) ∧
      ψp * ψm + ψm * ψp = 4 • (1 : A) ∧
      ψp * ψm - ψm * ψp = 4 • J := by
  have hOJ : Ω * J = -(J * Ω) := by
    calc
      Ω * J = (J * Ω + Ω * J) - J * Ω := by abel
      _ = -(J * Ω) := by rw [hJO, zero_sub]
  have hK2 : (J * Ω) * (J * Ω) = 1 := by
    calc
      (J * Ω) * (J * Ω) = J * (Ω * J) * Ω := by noncomm_ring
      _ = J * (-(J * Ω)) * Ω := by rw [hOJ]
      _ = -((J * J) * (Ω * Ω)) := by noncomm_ring
      _ = 1 := by rw [hJ, hΩ]; simp
  have hKO : (J * Ω) * Ω = -J := by
    calc
      (J * Ω) * Ω = J * (Ω * Ω) := by rw [mul_assoc]
      _ = J * (-1) := by rw [hΩ]
      _ = -J := by simp
  have hOK : Ω * (J * Ω) = J := by
    calc
      Ω * (J * Ω) = (Ω * J) * Ω := by rw [mul_assoc]
      _ = (-(J * Ω)) * Ω := by rw [hOJ]
      _ = J := by rw [neg_mul, hKO, neg_neg]
  dsimp
  refine ⟨hK2, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp only [add_mul, mul_add]
    rw [hK2, hKO, hOK, hΩ]
    abel
  · simp only [sub_mul, mul_sub]
    rw [hK2, hKO, hOK, hΩ]
    abel
  · simp only [add_mul, mul_sub]
    rw [hK2, hKO, hOK, hΩ]
    abel
  · simp only [sub_mul, mul_add]
    rw [hK2, hKO, hOK, hΩ]
    abel
  · simp only [add_mul, sub_mul, mul_add, mul_sub]
    rw [hK2, hKO, hOK, hΩ]
    abel
  · simp only [add_mul, sub_mul, mul_add, mul_sub]
    rw [hK2, hKO, hOK, hΩ]
    abel

/-- If the coefficient ring contains a central inverse of two, normalizing
the doubled ladders gives genuine complementary Peirce idempotents. The
centrality premise is explicit because coefficients need not commute with
operators in a noncommutative ring. -/
theorem splitQuaternion_normalized_witt_peirce
    (J Ω half : A)
    (hJ : J * J = 1)
    (hΩ : Ω * Ω = -1)
    (hJO : J * Ω + Ω * J = 0)
    (hhalf : (2 : A) * half = 1) :
    let K := J * Ω
    let ψp := half * (K + Ω)
    let ψm := half * (K - Ω)
    ψp * ψp = 0 ∧
      ψm * ψm = 0 ∧
      ψp * ψm = half * (1 + J) ∧
      ψm * ψp = half * (1 - J) ∧
      ψp * ψm + ψm * ψp = 1 ∧
      ψp * ψm - ψm * ψp = J := by
  obtain ⟨_, hp2, hm2, hpm, hmp, _, _⟩ :=
    splitQuaternion_doubled_witt_ladders J Ω hJ hΩ hJO
  obtain ⟨hhalfRight, hcentral⟩ := two_left_inverse_is_central half hhalf
  have hhalfSq : half * half * (2 : A) = half := by
    calc
      half * half * (2 : A) = half * (half * (2 : A)) := by noncomm_ring
      _ = half := by rw [hhalfRight]; simp
  have hscaled (x y : A) :
      (half * x) * (half * y) = half * half * (x * y) := by
    calc
      (half * x) * (half * y) = half * x * half * y := by noncomm_ring
      _ = half * (x * half) * y := by noncomm_ring
      _ = half * (half * x) * y := by rw [← hcentral x]
      _ = half * half * (x * y) := by
        calc
          half * (half * x) * y = half * (half * (x * y)) := by
            simp only [mul_assoc]
          _ = half * half * (x * y) := (mul_assoc half half (x * y)).symm
  dsimp
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hscaled, hp2]
    simp
  · rw [hscaled, hm2]
    simp
  · rw [hscaled, hpm]
    simp only [two_smul]
    calc
      half * half * ((1 + J) + (1 + J)) =
          (half * half * (2 : A)) * (1 + J) := by noncomm_ring
      _ = half * (1 + J) := by rw [hhalfSq]
  · rw [hscaled, hmp]
    simp only [two_smul]
    calc
      half * half * ((1 - J) + (1 - J)) =
          (half * half * (2 : A)) * (1 - J) := by noncomm_ring
      _ = half * (1 - J) := by rw [hhalfSq]
  · rw [hscaled, hpm, hscaled, hmp]
    simp only [two_smul]
    calc
      half * half * (1 + J + (1 + J)) +
          half * half * (1 - J + (1 - J)) =
          (half * half * (2 : A)) * (1 + J) +
            (half * half * (2 : A)) * (1 - J) := by noncomm_ring
      _ = half * (1 + J) + half * (1 - J) := by rw [hhalfSq]
      _ = half + half := by noncomm_ring
      _ = 1 := by simpa only [two_mul] using hhalf
  · rw [hscaled, hpm, hscaled, hmp]
    simp only [two_smul]
    calc
      half * half * (1 + J + (1 + J)) -
          half * half * (1 - J + (1 - J)) =
          (half * half * (2 : A)) * (1 + J) -
            (half * half * (2 : A)) * (1 - J) := by noncomm_ring
      _ = half * (1 + J) - half * (1 - J) := by rw [hhalfSq]
      _ = (2 : A) * (half * J) := by noncomm_ring
      _ = ((2 : A) * half) * J := by noncomm_ring
      _ = J := by rw [hhalf]; simp

/-- The one-sided Cartan action `X ↦ J*X` fails to preserve multiplication
by exactly the lower Peirce contribution. The formula keeps the operator
order and uses only the central inverse-of-two needed to define the projector. -/
theorem leftCartan_multiplicativity_defect
    (J half X Y : A) (hhalf : (2 : A) * half = 1) :
    J * (X * Y) - (J * X) * (J * Y) =
      (2 : A) * (J * X * (half * (1 - J)) * Y) := by
  calc
    J * (X * Y) - (J * X) * (J * Y) = J * X * (1 - J) * Y := by
      noncomm_ring
    _ = (2 : A) * (J * X * (half * (1 - J)) * Y) := by
      calc
        J * X * (1 - J) * Y = J * X * ((2 : A) * half) * (1 - J) * Y := by
          rw [hhalf]
          simp only [mul_one, mul_assoc]
        _ = (2 : A) * (J * X * (half * (1 - J)) * Y) := by noncomm_ring

/-- The right-handed Cartan action has the corresponding, oppositely ordered
defect. Together the two formulas distinguish left and right chirality in an
arbitrary noncommutative operator ring. -/
theorem rightCartan_multiplicativity_defect
    (J half X Y : A) (hhalf : (2 : A) * half = 1) :
    (X * Y) * J - (X * J) * (Y * J) =
      (2 : A) * (X * (half * (1 - J)) * Y * J) := by
  calc
    (X * Y) * J - (X * J) * (Y * J) = X * (1 - J) * Y * J := by
      noncomm_ring
    _ = (2 : A) * (X * (half * (1 - J)) * Y * J) := by
      calc
        X * (1 - J) * Y * J = X * ((2 : A) * half) * (1 - J) * Y * J := by
          rw [hhalf]
          simp only [mul_one, mul_assoc]
        _ = (2 : A) * (X * (half * (1 - J)) * Y * J) := by noncomm_ring

/-- The normalized split-quaternion ladders generate actual, orthogonal
Peirce idempotents through their ordered round trips. This packages the
ladder-to-projector bridge using the generic CAR theorem above. -/
theorem splitQuaternion_normalized_peirce_packet
    (J Ω half : A)
    (hJ : J * J = 1)
    (hΩ : Ω * Ω = -1)
    (hJO : J * Ω + Ω * J = 0)
    (hhalf : (2 : A) * half = 1) :
    let K := J * Ω
    let ψp := half * (K + Ω)
    let ψm := half * (K - Ω)
    (ψp * ψm) * (ψp * ψm) = ψp * ψm ∧
      (ψm * ψp) * (ψm * ψp) = ψm * ψp ∧
      ψp * ψm + ψm * ψp = 1 ∧
      ψp * ψm * ψm * ψp = 0 ∧
      ψm * ψp * ψp * ψm = 0 := by
  let create : A := half * (J * Ω + Ω)
  let annihilate : A := half * (J * Ω - Ω)
  have h := splitQuaternion_normalized_witt_peirce J Ω half hJ hΩ hJO hhalf
  dsimp [create, annihilate] at h
  rcases h with ⟨hpsq, hmsq, hpm, hmp, hcar, _⟩
  rcases rankOneCAR_peirce_packet hpsq hmsq hcar with
    ⟨hp, hm, hsum, hcross, hcross', _, _⟩
  have hpacket :
      carPlus create annihilate * carPlus create annihilate =
          carPlus create annihilate ∧
      carMinus create annihilate * carMinus create annihilate =
          carMinus create annihilate ∧
      carPlus create annihilate + carMinus create annihilate = 1 ∧
      carPlus create annihilate * carMinus create annihilate = 0 ∧
      carMinus create annihilate * carPlus create annihilate = 0 :=
    ⟨hp, hm, hsum, hcross, hcross'⟩
  simpa [carPlus, carMinus, create, annihilate, mul_assoc] using hpacket

/-- The two Peirce idempotents of an involution split every operator into four
bimodule corners. The reconstruction and the four left/right eigenvalue laws
are stated over the noncommutative ring itself. -/
theorem cartan_four_bimodule_corners
    (J half X : A) (hJ : J * J = 1) (hhalf : (2 : A) * half = 1) :
    let Pp := half * (1 + J)
    let Pm := half * (1 - J)
    Pp * Pp = Pp ∧
      Pm * Pm = Pm ∧
      Pp * Pm = 0 ∧
      Pm * Pp = 0 ∧
      Pp + Pm = 1 ∧
      Pp * X * Pp + Pp * X * Pm + Pm * X * Pp + Pm * X * Pm = X ∧
      J * (Pp * X * Pp) = Pp * X * Pp ∧
      (Pp * X * Pp) * J = Pp * X * Pp ∧
      J * (Pp * X * Pm) = Pp * X * Pm ∧
      (Pp * X * Pm) * J = -(Pp * X * Pm) ∧
      J * (Pm * X * Pp) = -(Pm * X * Pp) ∧
      (Pm * X * Pp) * J = Pm * X * Pp ∧
      J * (Pm * X * Pm) = -(Pm * X * Pm) ∧
      (Pm * X * Pm) * J = -(Pm * X * Pm) := by
  obtain ⟨hhalfRight, hcentral⟩ := two_left_inverse_is_central half hhalf
  have hhalfSq : half * half * (2 : A) = half := by
    calc
      half * half * (2 : A) = half * (half * (2 : A)) := by noncomm_ring
      _ = half := by rw [hhalfRight]; simp
  have hscaled (x y : A) :
      (half * x) * (half * y) = half * half * (x * y) := by
    calc
      (half * x) * (half * y) = half * x * half * y := by noncomm_ring
      _ = half * (x * half) * y := by noncomm_ring
      _ = half * (half * x) * y := by rw [← hcentral x]
      _ = half * half * (x * y) := by
        calc
          half * (half * x) * y = half * (half * (x * y)) := by
            simp only [mul_assoc]
          _ = half * half * (x * y) := (mul_assoc half half (x * y)).symm
  have hPpSq : (half * (1 + J)) * (half * (1 + J)) = half * (1 + J) := by
    rw [hscaled]
    calc
      half * half * ((1 + J) * (1 + J)) =
          (half * half * (2 : A)) * (1 + J) := by noncomm_ring [hJ]
      _ = half * (1 + J) := by rw [hhalfSq]
  have hPmSq : (half * (1 - J)) * (half * (1 - J)) = half * (1 - J) := by
    rw [hscaled]
    calc
      half * half * ((1 - J) * (1 - J)) =
          (half * half * (2 : A)) * (1 - J) := by noncomm_ring [hJ]
      _ = half * (1 - J) := by rw [hhalfSq]
  have hPpPm : (half * (1 + J)) * (half * (1 - J)) = 0 := by
    calc
      (half * (1 + J)) * (half * (1 - J)) =
          half * half * ((1 + J) * (1 - J)) := hscaled (1 + J) (1 - J)
      _ = 0 := by noncomm_ring [hJ]
  have hPmPp : (half * (1 - J)) * (half * (1 + J)) = 0 := by
    calc
      (half * (1 - J)) * (half * (1 + J)) =
          half * half * ((1 - J) * (1 + J)) := hscaled (1 - J) (1 + J)
      _ = 0 := by noncomm_ring [hJ]
  have hsum' : half * (1 + J) + half * (1 - J) = 1 := by
    calc
      half * (1 + J) + half * (1 - J) = half * (2 : A) := by noncomm_ring
      _ = 1 := hhalfRight
  have hpLeft : J * (half * (1 + J)) = half * (1 + J) := by
    calc
      J * (half * (1 + J)) = (J * half) * (1 + J) := by simp [mul_assoc]
      _ = (half * J) * (1 + J) := by rw [← hcentral J]
      _ = half * (J * (1 + J)) := by simp [mul_assoc]
      _ = half * (1 + J) := by noncomm_ring [hJ]
  have hpRight : (half * (1 + J)) * J = half * (1 + J) := by
    calc
      (half * (1 + J)) * J = half * ((1 + J) * J) := by simp [mul_assoc]
      _ = half * (1 + J) := by noncomm_ring [hJ]
  have hmLeft : J * (half * (1 - J)) = -(half * (1 - J)) := by
    calc
      J * (half * (1 - J)) = (J * half) * (1 - J) := by simp [mul_assoc]
      _ = (half * J) * (1 - J) := by rw [← hcentral J]
      _ = half * (J * (1 - J)) := by simp [mul_assoc]
      _ = -(half * (1 - J)) := by noncomm_ring [hJ]
  have hmRight : (half * (1 - J)) * J = -(half * (1 - J)) := by
    calc
      (half * (1 - J)) * J = half * ((1 - J) * J) := by simp [mul_assoc]
      _ = -(half * (1 - J)) := by noncomm_ring [hJ]
  refine ⟨hPpSq, hPmSq, hPpPm, hPmPp, hsum', ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · calc
      half * (1 + J) * X * (half * (1 + J)) +
          half * (1 + J) * X * (half * (1 - J)) +
          half * (1 - J) * X * (half * (1 + J)) +
          half * (1 - J) * X * (half * (1 - J)) =
          (half * (1 + J) + half * (1 - J)) * X *
            (half * (1 + J) + half * (1 - J)) := by noncomm_ring
      _ = X := by rw [hsum']; simp
  · calc
      J * (half * (1 + J) * X * (half * (1 + J))) =
          (J * (half * (1 + J))) * X * (half * (1 + J)) := by noncomm_ring
      _ = half * (1 + J) * X * (half * (1 + J)) := by rw [hpLeft]
  · calc
      (half * (1 + J) * X * (half * (1 + J))) * J =
          half * (1 + J) * X * ((half * (1 + J)) * J) := by noncomm_ring
      _ = half * (1 + J) * X * (half * (1 + J)) := by rw [hpRight]
  · calc
      J * (half * (1 + J) * X * (half * (1 - J))) =
          (J * (half * (1 + J))) * X * (half * (1 - J)) := by noncomm_ring
      _ = half * (1 + J) * X * (half * (1 - J)) := by rw [hpLeft]
  · calc
      (half * (1 + J) * X * (half * (1 - J))) * J =
          half * (1 + J) * X * ((half * (1 - J)) * J) := by noncomm_ring
      _ = -(half * (1 + J) * X * (half * (1 - J))) := by rw [hmRight]; noncomm_ring
  · calc
      J * (half * (1 - J) * X * (half * (1 + J))) =
          (J * (half * (1 - J))) * X * (half * (1 + J)) := by noncomm_ring
      _ = -(half * (1 - J) * X * (half * (1 + J))) := by rw [hmLeft]; noncomm_ring
  · calc
      (half * (1 - J) * X * (half * (1 + J))) * J =
          half * (1 - J) * X * ((half * (1 + J)) * J) := by noncomm_ring
      _ = half * (1 - J) * X * (half * (1 + J)) := by rw [hpRight]
  · calc
      J * (half * (1 - J) * X * (half * (1 - J))) =
          (J * (half * (1 - J))) * X * (half * (1 - J)) := by noncomm_ring
      _ = -(half * (1 - J) * X * (half * (1 - J))) := by rw [hmLeft]; noncomm_ring
  · calc
      (half * (1 - J) * X * (half * (1 - J))) * J =
          half * (1 - J) * X * ((half * (1 - J)) * J) := by noncomm_ring
      _ = -(half * (1 - J) * X * (half * (1 - J))) := by rw [hmRight]; noncomm_ring

/-- The additive upper-right corner map. It is not a ring homomorphism:
its image is a square-zero operator subspace. -/
def upperRightCorner (X : A) : Matrix (Fin 2) (Fin 2) A := !![0, X; 0, 0]

/-- The upper-right corner is an injective additive placement of the original
operator carrier, but its matrix products vanish in either order. Thus the
KKT corner lift must not be treated as an associative-algebra embedding. -/
theorem upperRightCorner_add_injective_and_products_zero (X Y : A) :
    upperRightCorner (X + Y) = upperRightCorner X + upperRightCorner Y ∧
      (upperRightCorner X = upperRightCorner Y ↔ X = Y) ∧
      upperRightCorner X * upperRightCorner Y = 0 ∧
      upperRightCorner Y * upperRightCorner X = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [upperRightCorner]
  · constructor
    · intro h
      have h01 := congrArg (fun M : Matrix (Fin 2) (Fin 2) A => M 0 1) h
      simpa [upperRightCorner] using h01
    · rintro rfl
      rfl
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [upperRightCorner, Matrix.mul_apply, Fin.sum_univ_two]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [upperRightCorner, Matrix.mul_apply, Fin.sum_univ_two]

/-- Conjugation by an involutive operator is a unital algebra automorphism of
the full noncommutative operator-matrix algebra.  This records multiplicativity
on arbitrary matrices, not only on the embedded upper-right corner. -/
theorem involutive_matrix_conjugation_is_unital_multiplicative
    (U : Matrix (Fin 2) (Fin 2) A) (hU : U * U = 1)
    (M N : Matrix (Fin 2) (Fin 2) A) :
    U * (M * N) * U = (U * M * U) * (U * N * U) ∧
      U * (1 : Matrix (Fin 2) (Fin 2) A) * U = 1 ∧
      U * (U * M * U) * U = M := by
  refine ⟨?_, ?_, ?_⟩
  · calc
      U * (M * N) * U = (U * M) * (N * U) := by noncomm_ring
      _ = (U * M * U) * (U * N * U) := by
        calc
          (U * M) * (N * U) = U * M * (1 : Matrix (Fin 2) (Fin 2) A) * N * U := by noncomm_ring
          _ = U * M * (U * U) * N * U := by rw [hU]
          _ = (U * M * U) * (U * N * U) := by noncomm_ring
  · rw [mul_one, hU]
  · calc
      U * (U * M * U) * U = (U * U) * M * (U * U) := by noncomm_ring
      _ = M := by rw [hU]; simp

/-- The matrix shift exchanging the two Peirce sectors. -/
def operatorShift {A : Type*} [Ring A] : Matrix (Fin 2) (Fin 2) A :=
  !![0, 1; 1, 0]

/-- An operator-valued clock with no centrality assumption on its parameter. -/
def operatorClock {A : Type*} [Ring A] (u : A) : Matrix (Fin 2) (Fin 2) A :=
  !![1, 0; 0, u]

/-- The noncommutative hyperbolic dilation associated to a unit. -/
def operatorDilation {A : Type*} [Ring A] (u : Aˣ) : Matrix (Fin 2) (Fin 2) A :=
  !![(u : A), 0; 0, (↑u⁻¹ : A)]

/-- The operator-valued Weyl relation: exchanging the two Peirce sectors
braids the clock with the dilation in the displayed order.  No commutativity
of the coefficient ring and no centrality of `u` are assumed. -/
theorem operator_weyl_braiding {A : Type*} [Ring A] (u : Aˣ) :
    operatorShift * operatorClock (u : A) =
      operatorDilation u * operatorClock (u : A) * operatorShift := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [operatorShift, operatorClock, operatorDilation, Matrix.mul_apply,
      Fin.sum_univ_two]

/-- Conjugation by the shift inverts the operator-valued dilation. -/
theorem operator_dilation_shift_inversion {A : Type*} [Ring A] (u : Aˣ) :
    operatorShift * operatorDilation u * operatorShift = operatorDilation u⁻¹ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [operatorShift, operatorDilation, Matrix.mul_apply,
      Fin.sum_univ_two]

/-- The two one-sided Cartan actions on an arbitrary ring are realized by
genuine inner involutions on its doubled matrix algebra. Their restriction to
the additive upper-right corner realizes the chiral actions; the corner map
itself is not multiplicative, as recorded by
`upperRightCorner_add_injective_and_products_zero`. -/
theorem doubled_matrix_inner_chiral_actions
    (J X : A) (hJ : J * J = 1) :
    let Uₗ : Matrix (Fin 2) (Fin 2) A := !![J, 0; 0, 1]
    let Uᵣ : Matrix (Fin 2) (Fin 2) A := !![1, 0; 0, J]
    let ιX := upperRightCorner X
    Uₗ * Uₗ = 1 ∧
      Uᵣ * Uᵣ = 1 ∧
      Uₗ * Uᵣ = Uᵣ * Uₗ ∧
      Uₗ * ιX * Uₗ = !![0, J * X; 0, 0] ∧
      Uᵣ * ιX * Uᵣ = !![0, X * J; 0, 0] ∧
      (Uₗ * Uᵣ) * ιX * (Uₗ * Uᵣ) = !![0, J * X * J; 0, 0] := by
  dsimp
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two, hJ]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two, hJ]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [upperRightCorner, Matrix.mul_apply, Fin.sum_univ_two]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [upperRightCorner, Matrix.mul_apply, Fin.sum_univ_two]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [upperRightCorner, Matrix.mul_apply, Fin.sum_univ_two]

end SplitQuaternionWittLadders

section MatrixWitness

/-- Matrix multiplication on `Mat₂(A)` is genuinely noncommutative whenever
the coefficient ring is nontrivial. -/
theorem matTwo_noncommute {A : Type*} [Ring A] [Nontrivial A] :
    ∃ matI matJ : Matrix (Fin 2) (Fin 2) A,
      matI * matJ ≠ matJ * matI := by
  refine ⟨!![(0 : A), 1; 0, 0], !![0, 0; 1, 0], ?_⟩
  intro h
  have h00 := congrArg (fun M : Matrix (Fin 2) (Fin 2) A => M 0 0) h
  simp [Matrix.mul_apply, Fin.sum_univ_two] at h00

end MatrixWitness

