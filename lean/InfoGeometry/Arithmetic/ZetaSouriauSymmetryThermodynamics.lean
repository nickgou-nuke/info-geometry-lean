import Mathlib.Tactic
import InfoGeometry.Arithmetic.ZetaCoordinateSymmetry

/-!
# InfoGeometry.Arithmetic.ZetaSouriauSymmetryThermodynamics

Souriau-style thermodynamic readouts for the zeta symmetry chart.

This file separates two symmetry levels.

* The exact completed-zeta chart symmetries form the finite Klein frame
  generated by conjugation and the functional-equation reflection.
  On centered coordinates they act by sign changes, so the linear
  Souriau pairing between inverse temperature and moment map is invariant
  under simultaneous transformation of both arguments.

* The centered chart also carries a vertical real flow.  Together with the
  finite reflections it gives the algebraic semidirect action
  `R ⋊ V₄` on the chart.  This is a chart/Killing symmetry of the flat
  displacement, not a theorem that zeta itself is vertically translation
  invariant.

No analytic zeta function, explicit formula, RH statement, or global Lie-group
manifold theorem is asserted here.
-/

noncomputable section

open scoped BigOperators

namespace InfoGeometry.Arithmetic.ZetaSouriauSymmetryThermodynamics

open InfoGeometry.Arithmetic.ZetaCoordinateSymmetry
open InfoGeometry.Arithmetic.ZetaCoordinateSymmetry.ZetaAffineChart
open InfoGeometry.Arithmetic.ZetaCoordinateSymmetry.ZetaAffineChart.ZetaCenteredChart

/-! ## Finite zeta symmetry frame on centered coordinates -/

theorem chartSymmetryCompose_assoc (g h k : ChartSymmetry) :
    chartSymmetryCompose (chartSymmetryCompose g h) k =
      chartSymmetryCompose g (chartSymmetryCompose h k) := by
  cases g <;> cases h <;> cases k <;> rfl

@[simp] theorem chartSymmetry_identity_compose (g : ChartSymmetry) :
    chartSymmetryCompose ChartSymmetry.identity g = g := by
  rfl

@[simp] theorem chartSymmetry_compose_identity (g : ChartSymmetry) :
    chartSymmetryCompose g ChartSymmetry.identity = g := by
  cases g <;> rfl

instance chartSymmetryCommGroup : CommGroup ChartSymmetry where
  one := ChartSymmetry.identity
  mul := chartSymmetryCompose
  inv := id
  one_mul := chartSymmetry_identity_compose
  mul_one := chartSymmetry_compose_identity
  mul_assoc := chartSymmetryCompose_assoc
  inv_mul_cancel := chartSymmetryCompose_self
  mul_comm := chartSymmetryCompose_commute

@[simp] theorem chartSymmetry_mul_self (g : ChartSymmetry) :
    g * g = 1 := by
  exact chartSymmetryCompose_self g

theorem chartSymmetry_mul_comm (g h : ChartSymmetry) :
    g * h = h * g := by
  exact chartSymmetryCompose_commute g h

/-- Action of the exact finite zeta chart symmetry frame on centered coordinates. -/
def centeredChartSymmetryAct :
    ChartSymmetry → ZetaCenteredChart → ZetaCenteredChart
  | ChartSymmetry.identity, x => x
  | ChartSymmetry.conjugation, x => conjugation x
  | ChartSymmetry.functionalDual, x => functionalDual x
  | ChartSymmetry.criticalMirror, x => criticalMirror x

/--
Sign character describing how a finite zeta symmetry conjugates the vertical
height flow.

Conjugation and functional duality reverse height; the identity and critical
mirror preserve it.
-/
def zetaHeightSign : ChartSymmetry → ℝ
  | ChartSymmetry.identity => 1
  | ChartSymmetry.conjugation => -1
  | ChartSymmetry.functionalDual => -1
  | ChartSymmetry.criticalMirror => 1

@[simp] theorem zetaHeightSign_sq (g : ChartSymmetry) :
    zetaHeightSign g * zetaHeightSign g = 1 := by
  cases g <;> norm_num [zetaHeightSign]

theorem zetaHeightSign_compose (g h : ChartSymmetry) :
    zetaHeightSign (chartSymmetryCompose g h) =
      zetaHeightSign g * zetaHeightSign h := by
  cases g <;> cases h <;> norm_num [zetaHeightSign, chartSymmetryCompose]

/-- The height sign as a unit-valued character of the finite frame. -/
def zetaHeightSignUnit (g : ChartSymmetry) : ℝˣ :=
  Units.mk0 (zetaHeightSign g) (by
    cases g <;> norm_num [zetaHeightSign])

@[simp] theorem coe_zetaHeightSignUnit (g : ChartSymmetry) :
    (zetaHeightSignUnit g : ℝ) = zetaHeightSign g := by
  rfl

def zetaHeightSignHom : ChartSymmetry →* ℝˣ where
  toFun := zetaHeightSignUnit
  map_one' := by
    change zetaHeightSignUnit ChartSymmetry.identity = 1
    ext
    simp [zetaHeightSignUnit, zetaHeightSign]
  map_mul' := by
    intro g h
    change zetaHeightSignUnit (chartSymmetryCompose g h) =
      zetaHeightSignUnit g * zetaHeightSignUnit h
    cases g <;> cases h <;>
      ext <;> norm_num [zetaHeightSignUnit, zetaHeightSign,
        chartSymmetryCompose]

/-- The centered finite action composes according to the existing Klein table. -/
theorem centeredChartSymmetryAct_compose
    (g h : ChartSymmetry) (x : ZetaCenteredChart) :
    centeredChartSymmetryAct (chartSymmetryCompose g h) x =
      centeredChartSymmetryAct g (centeredChartSymmetryAct h x) := by
  cases g <;> cases h <;> cases x <;>
    simp [centeredChartSymmetryAct, chartSymmetryCompose, conjugation,
      functionalDual, criticalMirror]

/-- Every exact finite zeta chart symmetry is an involution in centered coordinates. -/
theorem centeredChartSymmetryAct_involutive (g : ChartSymmetry) :
    Function.Involutive (centeredChartSymmetryAct g) := by
  intro x
  simpa [chartSymmetryCompose_self] using
    (centeredChartSymmetryAct_compose g g x).symm

/--
Finite zeta symmetries conjugate the vertical flow by the height-sign
character.
-/
theorem centeredChartSymmetryAct_heightTranslation
    (g : ChartSymmetry) (a : ℝ) (x : ZetaCenteredChart) :
    centeredChartSymmetryAct g (heightTranslation a x) =
      heightTranslation (zetaHeightSign g * a) (centeredChartSymmetryAct g x) := by
  cases g <;> cases x <;>
    simp [centeredChartSymmetryAct, zetaHeightSign, heightTranslation,
      conjugation, functionalDual, criticalMirror] <;>
    ring

/-- Finite zeta symmetries preserve the flat centered displacement. -/
theorem centeredChartSymmetryAct_preserves_flatDisplacement
    (g : ChartSymmetry) (x y : ZetaCenteredChart) :
    flatDisplacement
        (centeredChartSymmetryAct g x)
        (centeredChartSymmetryAct g y) =
      flatDisplacement x y := by
  cases g <;> cases x <;> cases y <;>
    simp [centeredChartSymmetryAct, flatDisplacement, conjugation,
      functionalDual, criticalMirror] <;>
    ring

/-! ## The finite-by-real zeta chart symmetry action `R ⋊ V₄` -/

/--
Finite-by-real zeta chart symmetry.

The `frame` field is an exact completed-zeta chart symmetry.  The `height`
field is the vertical real chart flow.  This is the algebraic semidirect
symmetry of the centered chart, not a claim of vertical translation invariance
of the analytic zeta function.
-/
structure ZetaSouriauLieSymmetry where
  frame : ChartSymmetry
  height : ℝ
  deriving DecidableEq

namespace ZetaSouriauLieSymmetry

@[ext] theorem ext {A B : ZetaSouriauLieSymmetry}
    (hframe : A.frame = B.frame) (hheight : A.height = B.height) : A = B := by
  cases A
  cases B
  simp_all

/-- Identity element of the semidirect chart symmetry. -/
def identity : ZetaSouriauLieSymmetry :=
  ⟨ChartSymmetry.identity, 0⟩

/-- Semidirect product law: `(g,t)(h,s) = (gh, t + sign(g)s)`. -/
def compose (A B : ZetaSouriauLieSymmetry) : ZetaSouriauLieSymmetry :=
  ⟨chartSymmetryCompose A.frame B.frame,
    A.height + zetaHeightSign A.frame * B.height⟩

/-- Semidirect inverse. -/
def inverse (A : ZetaSouriauLieSymmetry) : ZetaSouriauLieSymmetry :=
  ⟨A.frame, -zetaHeightSign A.frame * A.height⟩

/-- Action on centered zeta coordinates. -/
def act (A : ZetaSouriauLieSymmetry) (x : ZetaCenteredChart) :
    ZetaCenteredChart :=
  heightTranslation A.height (centeredChartSymmetryAct A.frame x)

@[simp] theorem identity_compose (A : ZetaSouriauLieSymmetry) :
    compose identity A = A := by
  cases A
  ext <;> simp [compose, identity, zetaHeightSign, chartSymmetryCompose]

@[simp] theorem compose_identity (A : ZetaSouriauLieSymmetry) :
    compose A identity = A := by
  cases A with
  | mk g a =>
  cases g <;> ext <;> simp [compose, identity, zetaHeightSign, chartSymmetryCompose]

theorem compose_assoc
    (A B C : ZetaSouriauLieSymmetry) :
    compose (compose A B) C = compose A (compose B C) := by
  cases A with
  | mk g a =>
  cases B with
  | mk h b =>
  cases C with
  | mk k c =>
  ext
  · cases g <;> cases h <;> cases k <;> rfl
  · cases g <;> cases h <;> cases k <;>
      simp [compose, zetaHeightSign, chartSymmetryCompose] <;>
      ring

@[simp] theorem inverse_compose (A : ZetaSouriauLieSymmetry) :
    compose (inverse A) A = identity := by
  cases A with
  | mk g a =>
  ext
  · cases g <;> rfl
  · cases g <;> simp [compose, inverse, identity, zetaHeightSign,
      chartSymmetryCompose]

@[simp] theorem compose_inverse (A : ZetaSouriauLieSymmetry) :
    compose A (inverse A) = identity := by
  cases A with
  | mk g a =>
  ext
  · cases g <;> rfl
  · cases g <;> simp [compose, inverse, identity, zetaHeightSign,
      chartSymmetryCompose]

/-- Native group packaging of the finite-by-real semidirect chart symmetry. -/
instance : Group ZetaSouriauLieSymmetry where
  one := identity
  mul := compose
  inv := inverse
  one_mul := identity_compose
  mul_one := compose_identity
  mul_assoc := compose_assoc
  inv_mul_cancel := inverse_compose

/-- The semidirect composition law agrees with composition of the chart action. -/
theorem act_compose
    (A B : ZetaSouriauLieSymmetry) (x : ZetaCenteredChart) :
    act (compose A B) x = act A (act B x) := by
  cases A with
  | mk g a =>
  cases B with
  | mk h b =>
  cases g <;> cases h <;> cases x <;>
    simp [act, compose, centeredChartSymmetryAct, zetaHeightSign,
      chartSymmetryCompose, heightTranslation, conjugation, functionalDual,
      criticalMirror] <;>
    ring

@[simp] theorem act_identity (x : ZetaCenteredChart) :
  act identity x = x := by
  cases x
  simp [act, identity, centeredChartSymmetryAct, heightTranslation]

/-- Native `MulAction` packaging of the semidirect chart action. -/
instance : SMul ZetaSouriauLieSymmetry ZetaCenteredChart :=
  ⟨act⟩

instance : MulAction ZetaSouriauLieSymmetry ZetaCenteredChart where
  one_smul := act_identity
  mul_smul := by
    intro A B x
    exact act_compose A B x

@[simp] theorem smul_compose
    (A B : ZetaSouriauLieSymmetry) (x : ZetaCenteredChart) :
    (A * B) • x = A • (B • x) := by
  change act (compose A B) x = act A (act B x)
  exact act_compose A B x

/-- The full finite-by-real chart action preserves flat displacement. -/
theorem act_preserves_flatDisplacement
    (A : ZetaSouriauLieSymmetry) (x y : ZetaCenteredChart) :
    flatDisplacement (act A x) (act A y) = flatDisplacement x y := by
  cases A with
  | mk g a =>
  cases g <;> cases x <;> cases y <;>
    simp [act, centeredChartSymmetryAct, heightTranslation, flatDisplacement,
      conjugation, functionalDual, criticalMirror] <;>
    ring

theorem smul_preserves_flatDisplacement
    (A : ZetaSouriauLieSymmetry) (x y : ZetaCenteredChart) :
    flatDisplacement (A • x) (A • y) = flatDisplacement x y := by
  change flatDisplacement (act A x) (act A y) = flatDisplacement x y
  exact act_preserves_flatDisplacement A x y

/--
Thermodynamic 1-cocycle of a chart potential.

For a potential `Φ` on centered zeta temperatures, this is the finite Souriau
defect `c(A, β) = Φ(A • β) - Φ(β)`.
-/
def thermodynamicPotentialCocycle
    (Φ : ZetaCenteredChart → ℝ)
    (A : ZetaSouriauLieSymmetry)
    (beta : ZetaCenteredChart) : ℝ :=
  Φ (act A beta) - Φ beta

@[simp] theorem thermodynamicPotentialCocycle_identity
    (Φ : ZetaCenteredChart → ℝ) (beta : ZetaCenteredChart) :
    thermodynamicPotentialCocycle Φ identity beta = 0 := by
  simp [thermodynamicPotentialCocycle]

/--
The Souriau chart-potential defect is a `1`-cocycle for the semidirect chart
action.
-/
theorem thermodynamicPotentialCocycle_compose
    (Φ : ZetaCenteredChart → ℝ)
    (A B : ZetaSouriauLieSymmetry)
    (beta : ZetaCenteredChart) :
    thermodynamicPotentialCocycle Φ (compose A B) beta =
      thermodynamicPotentialCocycle Φ A (act B beta) +
        thermodynamicPotentialCocycle Φ B beta := by
  unfold thermodynamicPotentialCocycle
  rw [act_compose]
  ring

/-- A chart potential is invariant under the finite-by-real Souriau chart action. -/
def PotentialInvariant (Φ : ZetaCenteredChart → ℝ) : Prop :=
  ∀ (A : ZetaSouriauLieSymmetry) (beta : ZetaCenteredChart), Φ (act A beta) = Φ beta

/-- Invariant potentials have zero Souriau thermodynamic cocycle. -/
theorem thermodynamicPotentialCocycle_eq_zero_of_invariant
    {Φ : ZetaCenteredChart → ℝ}
    (hΦ : PotentialInvariant Φ)
    (A : ZetaSouriauLieSymmetry)
    (beta : ZetaCenteredChart) :
    thermodynamicPotentialCocycle Φ A beta = 0 := by
  unfold thermodynamicPotentialCocycle
  rw [hΦ A beta]
  simp

end ZetaSouriauLieSymmetry

/-! ## Souriau finite thermodynamics on the zeta symmetry chart -/

/--
Linear Souriau pairing between inverse temperature and a moment-map readout in
the centered zeta chart.
-/
def zetaSouriauPairing (beta moment : ZetaCenteredChart) : ℝ :=
  beta.u * moment.u + beta.v * moment.v

/-- The linear Souriau pairing is invariant under exact finite zeta symmetries. -/
theorem zetaSouriauPairing_finiteSymmetry
    (g : ChartSymmetry) (beta moment : ZetaCenteredChart) :
    zetaSouriauPairing
        (centeredChartSymmetryAct g beta)
        (centeredChartSymmetryAct g moment) =
      zetaSouriauPairing beta moment := by
  cases g <;> cases beta <;> cases moment <;>
    simp [zetaSouriauPairing, centeredChartSymmetryAct, conjugation,
      functionalDual, criticalMirror]

/-- Finite Souriau partition from a centered zeta moment map. -/
def zetaSouriauLinearPartition
    {State : Type*} [Fintype State]
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) : ℝ :=
  ∑ x : State, Real.exp (-(zetaSouriauPairing beta (moment x)))

theorem zetaSouriauLinearPartition_pos
    {State : Type*} [Fintype State] [Nonempty State]
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    0 < zetaSouriauLinearPartition moment beta := by
  unfold zetaSouriauLinearPartition
  apply Finset.sum_pos'
  · intro i hi
    exact le_of_lt (Real.exp_pos _)
  · let i₀ : State := Classical.choice (inferInstance : Nonempty State)
    exact ⟨i₀, Finset.mem_univ _, Real.exp_pos _⟩

theorem zetaSouriauLinearPartition_ne_zero
    {State : Type*} [Fintype State] [Nonempty State]
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    zetaSouriauLinearPartition moment beta ≠ 0 :=
  ne_of_gt (zetaSouriauLinearPartition_pos moment beta)

/-- Linear Massieu potential `Φ = log Z` for the finite zeta Souriau partition. -/
def zetaSouriauLinearMassieu
    {State : Type*} [Fintype State]
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) : ℝ :=
  Real.log (zetaSouriauLinearPartition moment beta)

theorem zetaSouriauLinearPartition_finiteSymmetry
    {State : Type*} [Fintype State]
    (g : ChartSymmetry)
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    zetaSouriauLinearPartition
        (fun x => centeredChartSymmetryAct g (moment x))
        (centeredChartSymmetryAct g beta) =
      zetaSouriauLinearPartition moment beta := by
  classical
  unfold zetaSouriauLinearPartition
  apply Finset.sum_congr rfl
  intro x hx
  rw [zetaSouriauPairing_finiteSymmetry]

theorem zetaSouriauLinearMassieu_finiteSymmetry
    {State : Type*} [Fintype State]
    (g : ChartSymmetry)
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    zetaSouriauLinearMassieu
        (fun x => centeredChartSymmetryAct g (moment x))
        (centeredChartSymmetryAct g beta) =
      zetaSouriauLinearMassieu moment beta := by
  unfold zetaSouriauLinearMassieu
  rw [zetaSouriauLinearPartition_finiteSymmetry]

/--
Massieu cocycle for the finite linear Souriau partition under simultaneous
exact zeta-frame transformation of inverse temperature and moment map.
-/
def zetaSouriauLinearMassieuCocycle
    {State : Type*} [Fintype State]
    (g : ChartSymmetry)
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) : ℝ :=
  zetaSouriauLinearMassieu
      (fun x => centeredChartSymmetryAct g (moment x))
      (centeredChartSymmetryAct g beta) -
    zetaSouriauLinearMassieu moment beta

/-- Exact zeta-frame invariance kills the finite linear Massieu cocycle. -/
theorem zetaSouriauLinearMassieuCocycle_eq_zero
    {State : Type*} [Fintype State]
    (g : ChartSymmetry)
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    zetaSouriauLinearMassieuCocycle g moment beta = 0 := by
  unfold zetaSouriauLinearMassieuCocycle
  rw [zetaSouriauLinearMassieu_finiteSymmetry]
  ring

/--
Displacement energy between inverse temperature and moment-map readout.  This
is the chart/Killing thermodynamic energy preserved by the full `R ⋊ V₄`
action.
-/
def zetaSouriauDisplacementEnergy
    (beta moment : ZetaCenteredChart) : ℝ :=
  flatDisplacement beta moment

theorem zetaSouriauDisplacementEnergy_invariant
    (A : ZetaSouriauLieSymmetry) (beta moment : ZetaCenteredChart) :
    zetaSouriauDisplacementEnergy (A.act beta) (A.act moment) =
      zetaSouriauDisplacementEnergy beta moment := by
  exact ZetaSouriauLieSymmetry.act_preserves_flatDisplacement A beta moment

/-- Full chart-symmetric finite Souriau partition built from displacement energy. -/
def zetaSouriauDisplacementPartition
    {State : Type*} [Fintype State]
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) : ℝ :=
  ∑ x : State, Real.exp (-(zetaSouriauDisplacementEnergy beta (moment x)))

theorem zetaSouriauDisplacementPartition_pos
    {State : Type*} [Fintype State] [Nonempty State]
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    0 < zetaSouriauDisplacementPartition moment beta := by
  unfold zetaSouriauDisplacementPartition
  apply Finset.sum_pos'
  · intro i hi
    exact le_of_lt (Real.exp_pos _)
  · let i₀ : State := Classical.choice (inferInstance : Nonempty State)
    exact ⟨i₀, Finset.mem_univ _, Real.exp_pos _⟩

theorem zetaSouriauDisplacementPartition_ne_zero
    {State : Type*} [Fintype State] [Nonempty State]
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    zetaSouriauDisplacementPartition moment beta ≠ 0 :=
  ne_of_gt (zetaSouriauDisplacementPartition_pos moment beta)

/-- Displacement Massieu potential `Φ = log Z`. -/
def zetaSouriauDisplacementMassieu
    {State : Type*} [Fintype State]
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) : ℝ :=
  Real.log (zetaSouriauDisplacementPartition moment beta)

theorem zetaSouriauDisplacementPartition_invariant
    {State : Type*} [Fintype State]
    (A : ZetaSouriauLieSymmetry)
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    zetaSouriauDisplacementPartition
        (fun x => A.act (moment x))
        (A.act beta) =
      zetaSouriauDisplacementPartition moment beta := by
  classical
  unfold zetaSouriauDisplacementPartition
  apply Finset.sum_congr rfl
  intro x hx
  rw [zetaSouriauDisplacementEnergy_invariant]

theorem zetaSouriauDisplacementMassieu_invariant
    {State : Type*} [Fintype State]
    (A : ZetaSouriauLieSymmetry)
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    zetaSouriauDisplacementMassieu
        (fun x => A.act (moment x))
        (A.act beta) =
      zetaSouriauDisplacementMassieu moment beta := by
  unfold zetaSouriauDisplacementMassieu
  rw [zetaSouriauDisplacementPartition_invariant]

/-- A finite displacement-Massieu contour at level `r` in the centered chart. -/
def zetaSouriauDisplacementMassieuLevelSet
    {State : Type*} [Fintype State]
    (moment : State → ZetaCenteredChart) (r : ℝ) : Set ZetaCenteredChart :=
  {beta | zetaSouriauDisplacementMassieu moment beta = r}

/-- Simultaneous chart symmetries transport finite displacement-Massieu contours. -/
theorem zetaSouriauDisplacementMassieuLevelSet_mem_iff
    {State : Type*} [Fintype State]
    (A : ZetaSouriauLieSymmetry)
    (moment : State → ZetaCenteredChart)
    (r : ℝ) (beta : ZetaCenteredChart) :
    A.act beta ∈
        zetaSouriauDisplacementMassieuLevelSet
          (fun x => A.act (moment x)) r ↔
      beta ∈ zetaSouriauDisplacementMassieuLevelSet moment r := by
  change zetaSouriauDisplacementMassieu
      (fun x => A.act (moment x)) (A.act beta) = r ↔
    zetaSouriauDisplacementMassieu moment beta = r
  rw [zetaSouriauDisplacementMassieu_invariant]

/-- A finite displacement-energy contour at level `r` in the centered chart. -/
def zetaSouriauDisplacementEnergyLevelSet
    (moment : ZetaCenteredChart) (r : ℝ) : Set ZetaCenteredChart :=
  {beta | zetaSouriauDisplacementEnergy beta moment = r}

/-- The full `ℝ ⋊ V₄` chart action transports displacement-energy contours. -/
theorem zetaSouriauDisplacementEnergyLevelSet_mem_iff
    (A : ZetaSouriauLieSymmetry)
    (moment : ZetaCenteredChart)
    (r : ℝ) (beta : ZetaCenteredChart) :
    A.act beta ∈ zetaSouriauDisplacementEnergyLevelSet (A.act moment) r ↔
      beta ∈ zetaSouriauDisplacementEnergyLevelSet moment r := by
  change zetaSouriauDisplacementEnergy (A.act beta) (A.act moment) = r ↔
    zetaSouriauDisplacementEnergy beta moment = r
  rw [zetaSouriauDisplacementEnergy_invariant]

/--
Massieu cocycle for the displacement Souriau partition under simultaneous
finite-by-real chart action.
-/
def zetaSouriauDisplacementMassieuCocycle
    {State : Type*} [Fintype State]
    (A : ZetaSouriauLieSymmetry)
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) : ℝ :=
  zetaSouriauDisplacementMassieu
      (fun x => A.act (moment x))
      (A.act beta) -
    zetaSouriauDisplacementMassieu moment beta

/-- Full chart/Killing invariance kills the displacement Massieu cocycle. -/
theorem zetaSouriauDisplacementMassieuCocycle_eq_zero
    {State : Type*} [Fintype State]
    (A : ZetaSouriauLieSymmetry)
    (moment : State → ZetaCenteredChart)
    (beta : ZetaCenteredChart) :
    zetaSouriauDisplacementMassieuCocycle A moment beta = 0 := by
  unfold zetaSouriauDisplacementMassieuCocycle
  rw [zetaSouriauDisplacementMassieu_invariant]
  ring

end InfoGeometry.Arithmetic.ZetaSouriauSymmetryThermodynamics
