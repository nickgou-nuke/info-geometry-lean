import InfoGeometry.Krein.Superphysics
import InfoGeometry.Quantum.SplitTrialityKernel
import InfoGeometry.Meta.Architecture

open scoped InnerProductSpace

/-!
# InfoGeometry.Quantum.SuperchargeMultiplet

Canonical supercharge multiplet on the doubled real Majorana carrier.

This file does not invent a new supersymmetry shell. It packages the owner
surfaces the repository already has:

- the `Π`-odd triality/parity supercharge from `SplitTrialityKernel`,
- the `J`-odd modular supercharge generated by `ε`,
- and the derived phase channel `Q_Π Q_J = J ε`.

The point is to keep the supercharge taxonomy lawful and operatorial:
relations are proved on the existing doubled-carrier maps rather than read off
from external SUSY notation.
-/

namespace InfoGeometry.Quantum

open InfoGeometry.Krein
open InfoGeometry.Quantum.RealMajoranaCategory

section Core

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "Xc" => cl11DoubledCore E
local notation "H₂" => DoubledSpace E

/--
Canonical doubled-carrier supercharge multiplet.

`QΠ` is the `Π`-odd triality supercharge carried by the split-triality kernel.
`QJ` is the `J`-odd modular supercharge carried by the spectral involution `ε`.
-/
@[rep_depth krein]
structure SuperchargeMultiplet where
  parity : ParitySupercharge Xc
  modular : InfoGeometry.Krein.Supercharge (E := E)
  parity_eq_modularJ : parity.Q = (modular_j (E := E)).toLinearMap
  modular_eq_epsilon : modular.Q = spectral_epsilon (E := E)

namespace SuperchargeMultiplet

/-- The derived phase channel of the supercharge multiplet. -/
@[rep_depth krein]
noncomputable def phaseChannel
    (M : SuperchargeMultiplet (E := E)) : Xc →ₗ[ℝ] Xc :=
  M.parity.Q.comp M.modular.Q.toLinearMap

/-- In the canonical doubled-carrier multiplet, `QΠ QJ` is exactly `J ε`. -/
@[rep_depth krein]
theorem phaseChannel_eq_complexI
    (M : SuperchargeMultiplet (E := E)) :
    M.phaseChannel = (complex_i (E := E)).toLinearMap := by
  rw [phaseChannel, M.parity_eq_modularJ, M.modular_eq_epsilon]
  rfl

/-- Reversing the order of the two primitive supercharges introduces the expected sign. -/
@[rep_depth krein]
theorem modular_comp_parity_eq_neg_complexI
    (M : SuperchargeMultiplet (E := E)) :
    M.modular.Q.toLinearMap.comp M.parity.Q
      =
    -((complex_i (E := E)).toLinearMap) := by
  rw [M.parity_eq_modularJ, M.modular_eq_epsilon]
  exact congrArg ContinuousLinearMap.toLinearMap
    (spectral_epsilon_comp_modular_j (E := E))

/-- The primitive `Π`-odd and `J`-odd supercharges anticommute. -/
@[rep_depth krein]
theorem parity_modular_anticommutator_eq_zero
    (M : SuperchargeMultiplet (E := E)) :
    RealMajoranaCategory.anticommutator M.parity.Q M.modular.Q.toLinearMap = 0 := by
  ext v
  have hAnti :
      (modular_j (E := E)) ((spectral_epsilon (E := E)) v)
        =
      -((spectral_epsilon (E := E)) ((modular_j (E := E)) v)) := by
    exact congrArg (fun T : H₂ →L[ℝ] H₂ => T v)
      (modular_j_spectral_epsilon_anticommute (E := E))
  rw [RealMajoranaCategory.anticommutator, M.parity_eq_modularJ, M.modular_eq_epsilon]
  change modular_j (spectral_epsilon v) + spectral_epsilon (modular_j v) = 0
  rw [hAnti]
  simp

/-- The derived phase channel squares to `-Id`. -/
@[rep_depth krein]
theorem phaseChannel_sq_eq_neg_id
    (M : SuperchargeMultiplet (E := E)) :
    M.phaseChannel.comp M.phaseChannel = -((LinearMap.id : Xc →ₗ[ℝ] Xc)) := by
  rw [M.phaseChannel_eq_complexI]
  exact congrArg ContinuousLinearMap.toLinearMap (complex_i_sq (E := E))

/-- The modular supercharge Hamiltonian is the identity in the canonical multiplet. -/
@[rep_depth krein]
theorem modular_hamiltonian_eq_id
    (M : SuperchargeMultiplet (E := E))
    (hM : M.modular = epsilonSupercharge (E := E)) :
    InfoGeometry.Krein.superHamiltonian M.modular
      =
    ContinuousLinearMap.id ℝ H₂ := by
  rw [hM]
  exact epsilonSupercharge_hamiltonian (E := E)

end SuperchargeMultiplet

namespace canonicalSuperchargeMultiplet

/-- Canonical supercharge multiplet already owned by the current repo. -/
@[rep_depth krein]
noncomputable def inst : SuperchargeMultiplet (E := E) where
  parity := canonicalSplitTrialityKernel.paritySupercharge (E := E)
  modular := epsilonSupercharge (E := E)
  parity_eq_modularJ :=
    canonicalSplitTrialityKernel.trialitySupercharge_eq_modularJ (E := E)
  modular_eq_epsilon := rfl

/-- The canonical `Π`-odd supercharge is exactly the triality/parity owner. -/
@[rep_depth krein, simp]
theorem parity_eq_triality :
    (inst (E := E)).parity
      =
    canonicalSplitTrialityKernel.paritySupercharge (E := E) := rfl

/-- The canonical `J`-odd supercharge is the epsilon modular supercharge. -/
@[rep_depth krein, simp]
theorem modular_eq_epsilonSupercharge :
    (inst (E := E)).modular = epsilonSupercharge (E := E) := rfl

/-- The canonical multiplet phase channel is the repo-native `K = J ε` axis. -/
@[rep_depth krein]
theorem phaseChannel_eq_complexI :
    (inst (E := E)).phaseChannel = (complex_i (E := E)).toLinearMap :=
  SuperchargeMultiplet.phaseChannel_eq_complexI (E := E) (inst (E := E))

/-- The canonical parity and modular supercharges anticommute. -/
@[rep_depth krein]
theorem parity_modular_anticommutator_eq_zero :
    RealMajoranaCategory.anticommutator
        (inst (E := E)).parity.Q
        (inst (E := E)).modular.Q.toLinearMap
      = 0 :=
  SuperchargeMultiplet.parity_modular_anticommutator_eq_zero (E := E) (inst (E := E))

/-- The canonical parity supercharge Hamiltonian is the identity on the doubled core. -/
@[rep_depth krein]
theorem parity_hamiltonian_eq_id :
    (inst (E := E)).parity.hamiltonian = LinearMap.id := by
  exact canonicalSplitTrialityKernel.paritySupercharge_hamiltonian_eq_id (E := E)

/-- The canonical modular supercharge Hamiltonian is the identity on the doubled carrier. -/
@[rep_depth krein]
theorem modular_hamiltonian_eq_id :
    InfoGeometry.Krein.superHamiltonian (inst (E := E)).modular
      =
    ContinuousLinearMap.id ℝ H₂ := by
  exact epsilonSupercharge_hamiltonian (E := E)

/-- The canonical phase channel squares to `-Id`. -/
@[rep_depth krein]
theorem phaseChannel_sq_eq_neg_id :
    (inst (E := E)).phaseChannel.comp (inst (E := E)).phaseChannel
      =
    -((LinearMap.id : Xc →ₗ[ℝ] Xc)) :=
  SuperchargeMultiplet.phaseChannel_sq_eq_neg_id (E := E) (inst (E := E))

end canonicalSuperchargeMultiplet

end Core

end InfoGeometry.Quantum
