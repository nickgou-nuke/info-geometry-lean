import InfoGeometry.Analysis.LieExponentialTraceDeterminant
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Algebra.NoncommutativeTetraktysFlows
import InfoGeometry.Arithmetic.MajoranaPolyaHilbert.BerryKeating
import InfoGeometry.Canonical.RelativeSurprisalJacobianCocycleBridge

/-!
# Log-Jacobian readout of a finite Lie-exponential flow

This owner connects the native matrix exponential path to the existing
finite log-volume/surprisal cocycle.  It is a finite-dimensional statement:
no nonlinear flow, change-of-variables theorem, divergence field, or
continuum measure is introduced here.
-/

noncomputable section

namespace InfoGeometry.Analysis.LieFlowLogJacobianBridge

open InfoGeometry.Analysis.LieExponentialTraceDeterminant
open InfoGeometry.Canonical.RelativeSurprisalJacobianCocycleBridge
open Matrix
open InfoGeometry.Algebra.NoncommutativeTetraktysFlows

variable {n : ℕ}

/-- Logarithmic volume readout along the constant-generator matrix flow. -/
def lieFlowLogJacobian (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) : ℝ :=
  logJacobian (lieExponentialPath A t)

/-- Negative log-volume, read as the finite flow surprisal. -/
def lieFlowJacobianSurprisal (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) : ℝ :=
  jacobianSurprisal (lieExponentialPath A t)

theorem lieFlowLogJacobian_eq_trace
    (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowLogJacobian A t = t * Matrix.trace A := by
  unfold lieFlowLogJacobian logJacobian
  rw [det_lieExponentialPath]
  rw [abs_of_pos (Real.exp_pos _), Real.log_exp]

theorem lieFlowJacobianSurprisal_eq_neg_trace
    (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowJacobianSurprisal A t = -(t * Matrix.trace A) := by
  change -lieFlowLogJacobian A t = -(t * Matrix.trace A)
  rw [lieFlowLogJacobian_eq_trace]

theorem lieFlowLogJacobian_add
    (A : Matrix (Fin n) (Fin n) ℝ) (s t : ℝ) :
    lieFlowLogJacobian A (s + t) =
      lieFlowLogJacobian A s + lieFlowLogJacobian A t := by
  rw [lieFlowLogJacobian_eq_trace,
    lieFlowLogJacobian_eq_trace,
    lieFlowLogJacobian_eq_trace]
  rw [add_mul]

theorem lieFlowLogJacobian_eq_zero_of_trace_zero
    (A : Matrix (Fin n) (Fin n) ℝ) (hA : Matrix.trace A = 0) (t : ℝ) :
    lieFlowLogJacobian A t = 0 := by
  rw [lieFlowLogJacobian_eq_trace, hA, mul_zero]

theorem lieFlowJacobianSurprisal_add
    (A : Matrix (Fin n) (Fin n) ℝ) (s t : ℝ) :
    lieFlowJacobianSurprisal A (s + t) =
      lieFlowJacobianSurprisal A s + lieFlowJacobianSurprisal A t := by
  rw [lieFlowJacobianSurprisal_eq_neg_trace,
    lieFlowJacobianSurprisal_eq_neg_trace,
    lieFlowJacobianSurprisal_eq_neg_trace]
  rw [add_mul, neg_add]

theorem lieFlowJacobianSurprisal_eq_zero_of_trace_zero
    (A : Matrix (Fin n) (Fin n) ℝ) (hA : Matrix.trace A = 0) (t : ℝ) :
    lieFlowJacobianSurprisal A t = 0 := by
  rw [lieFlowJacobianSurprisal_eq_neg_trace, hA, mul_zero, neg_zero]

/-! ### Tetraktys and central-dilation readout

The algebraic Tetraktys owner works over arbitrary rings and retains its
commutator obstruction in the square of `flowGen`.  On its real `2 × 2`
specialization, the generator itself is traceless.  Consequently its finite
Lie-exponential flow preserves log-volume.  A central scalar direction adds
the expected trace contribution, without identifying that scalar direction
with the noncommutative Tetraktys components.
-/

/-- The real `Cl(1,1)` Tetraktys generator is traceless on its two-dimensional
matrix carrier, independently of the values of its three coefficients. -/
theorem tetraktys_flowGen_trace_zero (cGamma cSigma cOmega : ℝ) :
    Matrix.trace (flowGen cGamma cSigma cOmega) = 0 := by
  simp [flowGen, fiberEmbed, gamma1Op, sigmaOp, omegaOp,
    Matrix.trace, Matrix.diag, Fin.sum_univ_two]

/-- The finite Lie flow generated by the real Tetraktys operator preserves
logarithmic volume. -/
theorem tetraktys_flowGen_lieFlowLogJacobian_eq_zero
    (cGamma cSigma cOmega t : ℝ) :
    lieFlowLogJacobian (flowGen cGamma cSigma cOmega) t = 0 := by
  exact lieFlowLogJacobian_eq_zero_of_trace_zero
    (flowGen cGamma cSigma cOmega) (tetraktys_flowGen_trace_zero cGamma cSigma cOmega) t

/-- Adding the central diagonal dilation `d • I₂` to the Tetraktys generator
changes its log-volume rate by exactly `2d`. -/
theorem tetraktys_dilaton_lieFlowLogJacobian
    (cGamma cSigma cOmega d t : ℝ) :
    lieFlowLogJacobian (fiberEmbed d + flowGen cGamma cSigma cOmega) t =
      t * (2 * d) := by
  have hD : Matrix.trace (fiberEmbed d) = 2 * d := by
    simp [fiberEmbed, Matrix.trace, Matrix.diag, Fin.sum_univ_two]
    ring
  rw [lieFlowLogJacobian_eq_trace, Matrix.trace_add,
    tetraktys_flowGen_trace_zero, hD]
  ring

/-! ### Jordan-Lie (Symmetric/Antisymmetric) & Dilaton/SL Trace Splits -/

/-- Symmetric (Jordan / dissipative / metric) part `½(A + Aᵀ)` of a matrix generator. -/
def symPart (A : Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  (1 / 2 : ℝ) • (A + Aᵀ)

/-- Antisymmetric (Lie / reversible / symplectic) part `½(A - Aᵀ)` of a matrix generator. -/
def antisymPart (A : Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  (1 / 2 : ℝ) • (A - Aᵀ)

theorem symPart_add_antisymPart (A : Matrix (Fin n) (Fin n) ℝ) :
    symPart A + antisymPart A = A := by
  ext i j
  simp [symPart, antisymPart]
  ring

theorem symPart_transpose (A : Matrix (Fin n) (Fin n) ℝ) :
    (symPart A)ᵀ = symPart A := by
  ext i j
  simp [symPart]
  ring

theorem antisymPart_transpose (A : Matrix (Fin n) (Fin n) ℝ) :
    (antisymPart A)ᵀ = -antisymPart A := by
  ext i j
  simp [antisymPart]
  ring

theorem trace_antisymPart (A : Matrix (Fin n) (Fin n) ℝ) :
    Matrix.trace (antisymPart A) = 0 := by
  rw [antisymPart, Matrix.trace_smul, Matrix.trace_sub, Matrix.trace_transpose, sub_self, smul_zero]

theorem trace_symPart (A : Matrix (Fin n) (Fin n) ℝ) :
    Matrix.trace (symPart A) = Matrix.trace A := by
  rw [symPart, Matrix.trace_smul, Matrix.trace_add, Matrix.trace_transpose, smul_eq_mul]
  ring

/-- The antisymmetric (reversible / rotational) channel is strictly volume-preserving. -/
theorem lieFlowLogJacobian_antisymPart_eq_zero
    (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowLogJacobian (antisymPart A) t = 0 :=
  lieFlowLogJacobian_eq_zero_of_trace_zero (antisymPart A) (trace_antisymPart A) t

/-- All logarithmic volume flow is carried exclusively by the symmetric part `½(A + Aᵀ)`. -/
theorem lieFlowLogJacobian_eq_symPart
    (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowLogJacobian A t = lieFlowLogJacobian (symPart A) t := by
  rw [lieFlowLogJacobian_eq_trace, lieFlowLogJacobian_eq_trace, trace_symPart]

/-- All flow surprisal is carried exclusively by the symmetric part `½(A + Aᵀ)`. -/
theorem lieFlowJacobianSurprisal_eq_symPart
    (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowJacobianSurprisal A t = lieFlowJacobianSurprisal (symPart A) t := by
  rw [lieFlowJacobianSurprisal_eq_neg_trace, lieFlowJacobianSurprisal_eq_neg_trace, trace_symPart]

/-- Pure-trace dilaton scalar generator `(Tr(A) / n) • I`. -/
def dilatonPart (A : Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  (Matrix.trace A / (n : ℝ)) • (1 : Matrix (Fin n) (Fin n) ℝ)

/-- Trace-free `slₙ(ℝ)` projection `A - (Tr(A) / n) • I`. -/
def tracelessPart (A : Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  A - dilatonPart A

theorem dilatonPart_add_tracelessPart (A : Matrix (Fin n) (Fin n) ℝ) :
    dilatonPart A + tracelessPart A = A := by
  simp [tracelessPart]

theorem trace_dilatonPart (hn : n ≠ 0) (A : Matrix (Fin n) (Fin n) ℝ) :
    Matrix.trace (dilatonPart A) = Matrix.trace A := by
  have hn' : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hn
  simp [dilatonPart, Matrix.trace_smul, Matrix.trace_one, smul_eq_mul, div_mul_cancel₀ _ hn']

theorem trace_tracelessPart (hn : n ≠ 0) (A : Matrix (Fin n) (Fin n) ℝ) :
    Matrix.trace (tracelessPart A) = 0 := by
  simp [tracelessPart, Matrix.trace_sub, trace_dilatonPart hn A]

/-- The traceless `slₙ(ℝ)` projection generates a strictly volume-preserving Lie flow. -/
theorem lieFlowLogJacobian_tracelessPart_eq_zero
    (hn : n ≠ 0) (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowLogJacobian (tracelessPart A) t = 0 :=
  lieFlowLogJacobian_eq_zero_of_trace_zero (tracelessPart A) (trace_tracelessPart hn A) t

/-- The pure-trace dilaton part carries the full logarithmic volume change of the Lie flow. -/
theorem lieFlowLogJacobian_eq_dilatonPart
    (hn : n ≠ 0) (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowLogJacobian A t = lieFlowLogJacobian (dilatonPart A) t := by
  rw [lieFlowLogJacobian_eq_trace, lieFlowLogJacobian_eq_trace, trace_dilatonPart hn A]

/-- Every matrix commutator `[A, B]` generates a volume-preserving Lie flow. -/
theorem lieFlowLogJacobian_commutator_eq_zero
    (A B : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowLogJacobian (A * B - B * A) t = 0 := by
  apply lieFlowLogJacobian_eq_zero_of_trace_zero
  rw [Matrix.trace_sub, Matrix.trace_mul_comm, sub_self]

/-- A Gram operator `Aᵀ A` has nonnegative trace. -/
theorem trace_transpose_mul_self_nonneg (A : Matrix (Fin n) (Fin n) ℝ) :
    0 ≤ Matrix.trace (Aᵀ * A) := by
  simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.transpose_apply]
  exact Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun j _ => mul_self_nonneg (A j _)

/-- Negative Sato/Gram metric flows `exp(-t Aᵀ A)` contract log-volume for `t ≥ 0`. -/
theorem lieFlowLogJacobian_neg_gram_nonpos
    (A : Matrix (Fin n) (Fin n) ℝ) {t : ℝ} (ht : 0 ≤ t) :
    lieFlowLogJacobian (-(Aᵀ * A)) t ≤ 0 := by
  rw [lieFlowLogJacobian_eq_trace, Matrix.trace_neg, mul_neg]
  exact neg_nonpos.mpr (mul_nonneg ht (trace_transpose_mul_self_nonneg A))

/-- Negative Sato/Gram metric flows `exp(-t Aᵀ A)` produce nonnegative surprisal for `t ≥ 0`. -/
theorem lieFlowJacobianSurprisal_neg_gram_nonneg
    (A : Matrix (Fin n) (Fin n) ℝ) {t : ℝ} (ht : 0 ≤ t) :
    0 ≤ lieFlowJacobianSurprisal (-(Aᵀ * A)) t := by
  rw [lieFlowJacobianSurprisal_eq_neg_trace, Matrix.trace_neg, mul_neg, neg_neg]
  exact mul_nonneg ht (trace_transpose_mul_self_nonneg A)

/-! ### Symmetrized `xp` Dilaton vs. Antisymmetric Commutator Log-Jacobian Separation -/

section XPDilatonLogJacobian

open InfoGeometry.Arithmetic.MajoranaPolyaHilbert

/-- The trace of `finiteSymmetrizedDilation x p` equals `Matrix.trace (x * p)` for all `n`. -/
theorem trace_finiteSymmetrizedDilation (x p : Matrix (Fin n) (Fin n) ℝ) :
    Matrix.trace (finiteSymmetrizedDilation x p) = Matrix.trace (x * p) := by
  dsimp [finiteSymmetrizedDilation]
  rw [Matrix.trace_smul, Matrix.trace_add, Matrix.trace_mul_comm p x, smul_eq_mul]
  ring

/-- The symmetric `xp` dilaton carries the full log-Jacobian rate `t * Matrix.trace (x * p)`. -/
theorem lieFlowLogJacobian_finiteSymmetrizedDilation
    (x p : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowLogJacobian (finiteSymmetrizedDilation x p) t = t * Matrix.trace (x * p) := by
  rw [lieFlowLogJacobian_eq_trace, trace_finiteSymmetrizedDilation]

/-- The log-Jacobian of `x * p` equals that of `finiteSymmetrizedDilation x p`. -/
theorem lieFlowLogJacobian_xp_eq_finiteSymmetrizedDilation
    (x p : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowLogJacobian (x * p) t = lieFlowLogJacobian (finiteSymmetrizedDilation x p) t := by
  rw [lieFlowLogJacobian_eq_trace, lieFlowLogJacobian_finiteSymmetrizedDilation]

/-- The antisymmetric commutator channel `antisymComm x p = x * p - p * x` is strictly isochoric. -/
theorem lieFlowLogJacobian_antisymComm_eq_zero
    (x p : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    lieFlowLogJacobian (antisymComm x p) t = 0 := by
  rw [lieFlowLogJacobian_eq_trace, antisymComm, Matrix.trace_sub,
    Matrix.trace_mul_comm p x, sub_self, mul_zero]

/-- For symmetric matrices `xᵀ = x` and `pᵀ = p`, `symPart (x * p)` matches
`finiteSymmetrizedDilation x p`. -/
theorem symPart_xp_eq_finiteSymmetrizedDilation
    (x p : Matrix (Fin n) (Fin n) ℝ) (hx : xᵀ = x) (hp : pᵀ = p) :
    symPart (x * p) = finiteSymmetrizedDilation x p := by
  dsimp [symPart, finiteSymmetrizedDilation]
  rw [Matrix.transpose_mul, hx, hp]

/-- For symmetric matrices `xᵀ = x` and `pᵀ = p`, `antisymPart (x * p)` matches
`(1 / 2 : ℝ) • antisymComm x p`. -/
theorem antisymPart_xp_eq_half_antisymComm
    (x p : Matrix (Fin n) (Fin n) ℝ) (hx : xᵀ = x) (hp : pᵀ = p) :
    antisymPart (x * p) = (1 / 2 : ℝ) • antisymComm x p := by
  dsimp [antisymPart, antisymComm]
  rw [Matrix.transpose_mul, hx, hp]

/-- The real Tetraktys generator built from `(symDilaton2 x p, antisymComm x p, cOmega)`
preserves logarithmic volume identically. -/
theorem tetraktys_xp_flowGen_lieFlowLogJacobian (x p cOmega t : ℝ) :
    lieFlowLogJacobian (flowGen (symDilaton2 x p) (antisymComm x p) cOmega) t = 0 := by
  rw [lieFlowLogJacobian_eq_trace, tetraktys_flowGen_trace_zero, mul_zero]

/-- Adding the central scalar `Matrix.trace (finiteSymmetrizedDilation x p)` to the Tetraktys
`xp` flow shifts its log-Jacobian rate by `2 * Matrix.trace (x * p)`. -/
theorem tetraktys_xp_dilaton_lieFlowLogJacobian
    (x p : Matrix (Fin n) (Fin n) ℝ) (c1 c2 cOmega t : ℝ) :
    lieFlowLogJacobian
        (fiberEmbed (Matrix.trace (finiteSymmetrizedDilation x p)) +
          flowGen (symDilaton2 c1 c2) (antisymComm c1 c2) cOmega) t =
      t * (2 * Matrix.trace (x * p)) := by
  rw [tetraktys_dilaton_lieFlowLogJacobian, trace_finiteSymmetrizedDilation]

end XPDilatonLogJacobian

end InfoGeometry.Analysis.LieFlowLogJacobianBridge
