import InfoGeometry.Canonical.CanonicalZornCliffordRepresentation

/-!
# Non-Abelian Braiding and Topological Quantum Computation

This module formalizes the non-Abelian braiding statistics of the Majorana
zero modes generated by the Klein bottle Brillouin topology.
Leveraging the Canonical Zorn Clifford representation, we define the 
Majorana braiding operators and prove that they satisfy the fundamental 
Yang-Baxter equation. We also demonstrate that these braiding operations
commute with the local 4-Majorana code stabilizer, securing the topological
protection of the quantum code.
-/

noncomputable section

namespace ZornMajoranaBraiding

open LinearMap

/--
The Majorana braid operator U_{ij} = exp(π/4 * γ_i * γ_j).
Because (γ_i γ_j)² = -I, this expands exactly as (1/√2)(I + γ_i γ_j).
Here we use the exact algebraic form.
-/
def majoranaBraidOperator (γ_i γ_j : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16) : 
    Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16 :=
  (Real.sqrt 2 / 2 : ℂ) • (1 + γ_i * γ_j)

/--
The inverse braid operator U_{ij}^{-1} = exp(-π/4 * γ_i * γ_j) = (1/√2)(I - γ_i γ_j).
-/
def majoranaBraidOperatorInv (γ_i γ_j : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16) : 
    Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16 :=
  (Real.sqrt 2 / 2 : ℂ) • (1 - γ_i * γ_j)

theorem braidCoefficient_mul_self :
    (Real.sqrt 2 / 2 : ℂ) * (Real.sqrt 2 / 2 : ℂ) = 1 / 2 := by
  have hsqrtC : ((Real.sqrt 2 : ℝ) : ℂ) * (Real.sqrt 2 : ℝ) = 2 := by
    exact_mod_cast Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 2)
  calc
    _ = (((Real.sqrt 2 : ℝ) : ℂ) * (Real.sqrt 2 : ℝ)) / 4 := by ring
    _ = 1 / 2 := by rw [hsqrtC]; norm_num

theorem end_mul_neg
    (A B : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16) :
    A * (-B) = -(A * B) := by
  apply eq_neg_of_add_eq_zero_right
  rw [← mul_add, add_neg_cancel, mul_zero]

theorem end_neg_mul
    (A B : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16) :
    (-A) * B = -(A * B) := by
  apply eq_neg_of_add_eq_zero_right
  rw [← add_mul, add_neg_cancel, zero_mul]

theorem scaled_triple_mul (c : ℂ)
    (A B C : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16) :
    (c • A) * (c • B) * (c • C) = (c * c * c) • (A * B * C) := by
  rw [smul_mul_smul, smul_mul_smul]

theorem mul_self_mul_comm_of_comm
    (A K : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16)
    (hAK : A * K = K * A) :
    A * (A * K) = (A * K) * A := by
  calc
    A * (A * K) = A * (K * A) := congrArg (fun X => A * X) hAK
    _ = (A * K) * A := (mul_assoc A K A).symm

section BraidRelations

variable {γ_i γ_j γ_k γ_l : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16}

/- Abstract assumptions on the generators: they anticommute and square to the identity. -/
variable (h_anti_ij : γ_i * γ_j + γ_j * γ_i = 0)
variable (h_sq_i : γ_i * γ_i = 1)
variable (h_sq_j : γ_j * γ_j = 1)

include h_anti_ij h_sq_i h_sq_j

/--
Proof that U_{ij} and U_{ij}^{-1} are indeed inverses.
-/
theorem braid_inv :
    majoranaBraidOperator γ_i γ_j * majoranaBraidOperatorInv γ_i γ_j = 1 := by
  dsimp [majoranaBraidOperator, majoranaBraidOperatorInv]
  rw [smul_mul_smul]
  have hswap : γ_j * γ_i = -(γ_i * γ_j) := by
    exact eq_neg_of_add_eq_zero_right h_anti_ij
  have hpair_sq : (γ_i * γ_j) * (γ_i * γ_j) = -1 := by
    calc
      (γ_i * γ_j) * (γ_i * γ_j) = γ_i * (γ_j * γ_i) * γ_j := by
        simp only [mul_assoc]
      _ = γ_i * (-(γ_i * γ_j)) * γ_j := by rw [hswap]
      _ = -((γ_i * γ_i) * (γ_j * γ_j)) := by
        rw [← neg_one_smul ℂ (γ_i * γ_j),
          ← neg_one_smul ℂ ((γ_i * γ_i) * (γ_j * γ_j))]
        rw [mul_smul_comm, smul_mul_assoc]
        simp only [mul_assoc]
      _ = -1 := by rw [h_sq_i, h_sq_j, one_mul]
  have hcore :
      (1 + γ_i * γ_j) * (1 - γ_i * γ_j) =
        (2 : ℂ) • (1 : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16) := by
    calc
      _ = 1 - (γ_i * γ_j) * (γ_i * γ_j) := by
        rw [add_mul, one_mul, mul_sub, mul_one]
        abel
      _ = (2 : ℂ) • (1 : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16) := by
        rw [hpair_sq, two_smul]
        simp
  rw [hcore, smul_smul]
  have hsqrtC : ((Real.sqrt 2 : ℝ) : ℂ) * (Real.sqrt 2 : ℝ) = 2 := by
    exact_mod_cast Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 2)
  have hcoef :
      (Real.sqrt 2 / 2 : ℂ) * (Real.sqrt 2 / 2 : ℂ) * 2 = 1 := by
    calc
      _ = ((((Real.sqrt 2 : ℝ) : ℂ) * (Real.sqrt 2 : ℝ)) / 4) * 2 := by ring
      _ = 1 := by rw [hsqrtC]; norm_num
  rw [hcoef, one_smul]

theorem braid_inv_rev :
    majoranaBraidOperatorInv γ_i γ_j * majoranaBraidOperator γ_i γ_j = 1 := by
  dsimp [majoranaBraidOperator, majoranaBraidOperatorInv]
  rw [smul_mul_smul]
  have hswap : γ_j * γ_i = -(γ_i * γ_j) :=
    eq_neg_of_add_eq_zero_right h_anti_ij
  have hpair_sq : (γ_i * γ_j) * (γ_i * γ_j) = -1 := by
    calc
      _ = γ_i * (γ_j * γ_i) * γ_j := by simp only [mul_assoc]
      _ = γ_i * (-(γ_i * γ_j)) * γ_j := by rw [hswap]
      _ = -((γ_i * γ_i) * (γ_j * γ_j)) := by
        rw [← neg_one_smul ℂ (γ_i * γ_j),
          ← neg_one_smul ℂ ((γ_i * γ_i) * (γ_j * γ_j))]
        rw [mul_smul_comm, smul_mul_assoc]
        simp only [mul_assoc]
      _ = -1 := by rw [h_sq_i, h_sq_j, one_mul]
  have hcore :
      (1 - γ_i * γ_j) * (1 + γ_i * γ_j) =
        (2 : ℂ) • (1 : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16) := by
    calc
      _ = 1 - (γ_i * γ_j) * (γ_i * γ_j) := by
        rw [sub_mul, one_mul, mul_add, mul_one]
        abel
      _ = _ := by rw [hpair_sq, two_smul]; simp
  rw [hcore, smul_smul]
  rw [show (Real.sqrt 2 / 2 : ℂ) * (Real.sqrt 2 / 2 : ℂ) = 1 / 2 from
    braidCoefficient_mul_self]
  module

omit h_anti_ij h_sq_i h_sq_j in
theorem conjugate_mul
    (U V A B : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16)
    (hVU : V * U = 1) :
    U * (A * B) * V = (U * A * V) * (U * B * V) := by
  calc
    U * (A * B) * V = U * A * B * V := by simp only [mul_assoc]
    _ = U * A * (V * U) * B * V := by rw [hVU, mul_one]
    _ = (U * A * V) * (U * B * V) := by simp only [mul_assoc]

/-- With the chosen `1 + γ_iγ_j` convention, conjugation sends `γ_i` to
`-γ_j`. -/
theorem braid_transformation_i :
    majoranaBraidOperator γ_i γ_j * γ_i * majoranaBraidOperatorInv γ_i γ_j = -γ_j := by
  have hswap : γ_j * γ_i = -(γ_i * γ_j) :=
    eq_neg_of_add_eq_zero_right h_anti_ij
  rw [majoranaBraidOperator, majoranaBraidOperatorInv,
    smul_mul_assoc, mul_smul_comm, smul_mul_assoc, smul_smul,
    braidCoefficient_mul_self]
  have hAi : (γ_i * γ_j) * γ_i = -γ_j := by
    calc
      _ = γ_i * (γ_j * γ_i) := mul_assoc _ _ _
      _ = γ_i * (-(γ_i * γ_j)) := by rw [hswap]
      _ = -(γ_i * (γ_i * γ_j)) := end_mul_neg _ _
      _ = -((γ_i * γ_i) * γ_j) := by rw [mul_assoc]
      _ = -γ_j := by rw [h_sq_i, one_mul]
  have hiA : γ_i * (γ_i * γ_j) = γ_j := by
    rw [← mul_assoc, h_sq_i, one_mul]
  have hjA : γ_j * (γ_i * γ_j) = -γ_i := by
    calc
      _ = (γ_j * γ_i) * γ_j := by rw [mul_assoc]
      _ = (-(γ_i * γ_j)) * γ_j := by rw [hswap]
      _ = -((γ_i * γ_j) * γ_j) := end_neg_mul _ _
      _ = -(γ_i * (γ_j * γ_j)) := by rw [mul_assoc]
      _ = -γ_i := by rw [h_sq_j, mul_one]
  have hsubA : (γ_i - γ_j) * (γ_i * γ_j) = γ_i + γ_j := by
    rw [sub_mul, hiA, hjA]
    abel
  have hcore :
      (1 + γ_i * γ_j) * γ_i * (1 - γ_i * γ_j) = -2 • γ_j := by
    rw [add_mul, one_mul, hAi]
    change (γ_i - γ_j) * (1 - γ_i * γ_j) = -2 • γ_j
    rw [mul_sub, mul_one, hsubA]
    module
  rw [hcore]
  module

/-- The companion conjugation formula for the second generator. -/
theorem braid_transformation_j :
    majoranaBraidOperator γ_i γ_j * γ_j * majoranaBraidOperatorInv γ_i γ_j = γ_i := by
  have hswap : γ_j * γ_i = -(γ_i * γ_j) :=
    eq_neg_of_add_eq_zero_right h_anti_ij
  rw [majoranaBraidOperator, majoranaBraidOperatorInv,
    smul_mul_assoc, mul_smul_comm, smul_mul_assoc, smul_smul,
    braidCoefficient_mul_self]
  have hAj : (γ_i * γ_j) * γ_j = γ_i := by
    rw [mul_assoc, h_sq_j, mul_one]
  have hjA : γ_j * (γ_i * γ_j) = -γ_i := by
    calc
      _ = (γ_j * γ_i) * γ_j := by rw [mul_assoc]
      _ = (-(γ_i * γ_j)) * γ_j := by rw [hswap]
      _ = -((γ_i * γ_j) * γ_j) := end_neg_mul _ _
      _ = -γ_i := by rw [hAj]
  have hiA : γ_i * (γ_i * γ_j) = γ_j := by
    rw [← mul_assoc, h_sq_i, one_mul]
  have hsumA : (γ_j + γ_i) * (γ_i * γ_j) = -γ_i + γ_j := by
    rw [add_mul, hjA, hiA]
  have hcore :
      (1 + γ_i * γ_j) * γ_j * (1 - γ_i * γ_j) = 2 • γ_i := by
    rw [add_mul, one_mul, hAj]
    rw [mul_sub, mul_one, hsumA]
    module
  rw [hcore]
  module

/-- A generator anticommuting with both entries of the braided pair is fixed
by their conjugation. -/
theorem braid_fixes_other
    (h_anti_ik : γ_i * γ_k + γ_k * γ_i = 0)
    (h_anti_jk : γ_j * γ_k + γ_k * γ_j = 0) :
    majoranaBraidOperator γ_i γ_j * γ_k *
        majoranaBraidOperatorInv γ_i γ_j = γ_k := by
  have hik : γ_i * γ_k = -(γ_k * γ_i) :=
    eq_neg_of_add_eq_zero_left h_anti_ik
  have hjk : γ_j * γ_k = -(γ_k * γ_j) :=
    eq_neg_of_add_eq_zero_left h_anti_jk
  have hAk : (γ_i * γ_j) * γ_k = γ_k * (γ_i * γ_j) := by
    calc
      _ = γ_i * (γ_j * γ_k) := by rw [mul_assoc]
      _ = γ_i * (-(γ_k * γ_j)) := by rw [hjk]
      _ = -(γ_i * (γ_k * γ_j)) := end_mul_neg _ _
      _ = -((γ_i * γ_k) * γ_j) := by rw [mul_assoc]
      _ = -((-(γ_k * γ_i)) * γ_j) := by rw [hik]
      _ = -(-((γ_k * γ_i) * γ_j)) := by rw [end_neg_mul]
      _ = γ_k * (γ_i * γ_j) := by rw [neg_neg, mul_assoc]
  have hUk : majoranaBraidOperator γ_i γ_j * γ_k =
      γ_k * majoranaBraidOperator γ_i γ_j := by
    rw [majoranaBraidOperator, smul_mul_assoc, mul_smul_comm]
    congr 1
    rw [add_mul, one_mul, mul_add, mul_one, hAk]
  calc
    majoranaBraidOperator γ_i γ_j * γ_k *
        majoranaBraidOperatorInv γ_i γ_j =
      γ_k * majoranaBraidOperator γ_i γ_j *
        majoranaBraidOperatorInv γ_i γ_j := by rw [hUk]
    _ = γ_k * (majoranaBraidOperator γ_i γ_j *
        majoranaBraidOperatorInv γ_i γ_j) := by rw [mul_assoc]
    _ = γ_k := by rw [braid_inv h_anti_ij h_sq_i h_sq_j, mul_one]

/-- 
The fundamental Yang-Baxter Equation for adjacent Majorana modes.
This strictly proves the generation of the Braid Group B_n inside the Zorn Clifford algebra.
-/
theorem yang_baxter_braid_relation 
    (h_anti_jk : γ_j * γ_k + γ_k * γ_j = 0)
    (h_anti_ik : γ_i * γ_k + γ_k * γ_i = 0)
    (h_sq_k : γ_k * γ_k = 1) :
    majoranaBraidOperator γ_i γ_j * majoranaBraidOperator γ_j γ_k * majoranaBraidOperator γ_i γ_j =
    majoranaBraidOperator γ_j γ_k * majoranaBraidOperator γ_i γ_j * majoranaBraidOperator γ_j γ_k := by
  have hji : γ_j * γ_i = -(γ_i * γ_j) :=
    eq_neg_of_add_eq_zero_right h_anti_ij
  have hkj : γ_k * γ_j = -(γ_j * γ_k) :=
    eq_neg_of_add_eq_zero_right h_anti_jk
  have hki : γ_k * γ_i = -(γ_i * γ_k) :=
    eq_neg_of_add_eq_zero_right h_anti_ik
  let A := γ_i * γ_j
  let B := γ_j * γ_k
  have hA_sq : A * A = -1 := by
    dsimp [A]
    calc
      _ = γ_i * (γ_j * γ_i) * γ_j := by simp only [mul_assoc]
      _ = γ_i * (-(γ_i * γ_j)) * γ_j := by rw [hji]
      _ = -((γ_i * γ_i) * (γ_j * γ_j)) := by
        rw [end_mul_neg, end_neg_mul]
        simp only [mul_assoc]
      _ = -1 := by rw [h_sq_i, h_sq_j, one_mul]
  have hB_sq : B * B = -1 := by
    dsimp [B]
    calc
      _ = γ_j * (γ_k * γ_j) * γ_k := by simp only [mul_assoc]
      _ = γ_j * (-(γ_j * γ_k)) * γ_k := by rw [hkj]
      _ = -((γ_j * γ_j) * (γ_k * γ_k)) := by
        rw [end_mul_neg, end_neg_mul]
        simp only [mul_assoc]
      _ = -1 := by rw [h_sq_j, h_sq_k, one_mul]
  have hAB : A * B = -(B * A) := by
    have hBA : B * A = -(A * B) := by
      dsimp [A, B]
      calc
        _ = γ_j * (γ_k * γ_i) * γ_j := by simp only [mul_assoc]
        _ = γ_j * (-(γ_i * γ_k)) * γ_j := by rw [hki]
        _ = -(γ_j * (γ_i * γ_k) * γ_j) := by
          rw [end_mul_neg, end_neg_mul]
        _ = -((γ_j * γ_i) * (γ_k * γ_j)) := by
          simp only [mul_assoc]
        _ = -((-(γ_i * γ_j)) * (-(γ_j * γ_k))) := by
          rw [hji, hkj]
        _ = -((γ_i * γ_j) * (γ_j * γ_k)) := by
          rw [end_neg_mul, end_mul_neg, neg_neg]
    rw [hBA, neg_neg]
  have hBBA : B * (B * A) = -A := by
    rw [← mul_assoc, hB_sq]
    exact neg_one_mul A
  have hcore : (1 + A) * (1 + B) * (1 + A) =
      (1 + B) * (1 + A) * (1 + B) := by
    noncomm_ring [hA_sq, hB_sq, hAB, hBBA]
  simp only [majoranaBraidOperator]
  rw [scaled_triple_mul, scaled_triple_mul]
  change _ • ((1 + A) * (1 + B) * (1 + A)) =
    _ • ((1 + B) * (1 + A) * (1 + B))
  rw [hcore]

/--
The local Code Stabilizer (Plaquette Operator) for a 4-Majorana surface code.
-/
def zornCodeStabilizer (γ1 γ2 γ3 γ4 : Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16) : 
    Module.End ℂ CanonicalZornCliffordRepresentation.DiracSpinor16 :=
  γ1 * γ2 * γ3 * γ4

/- The normalized adjacent-pair operator commutes with the four-generator
product under the four stated cross-anticommutation relations. -/
omit h_anti_ij h_sq_i h_sq_j in
theorem braid_preserves_stabilizer
    (h_anti_ik : γ_i * γ_k + γ_k * γ_i = 0)
    (h_anti_il : γ_i * γ_l + γ_l * γ_i = 0)
    (h_anti_jk : γ_j * γ_k + γ_k * γ_j = 0)
    (h_anti_jl : γ_j * γ_l + γ_l * γ_j = 0) :
    majoranaBraidOperator γ_i γ_j * zornCodeStabilizer γ_i γ_j γ_k γ_l = 
    zornCodeStabilizer γ_i γ_j γ_k γ_l * majoranaBraidOperator γ_i γ_j := by
  have hik : γ_i * γ_k = -(γ_k * γ_i) :=
    eq_neg_of_add_eq_zero_left h_anti_ik
  have hil : γ_i * γ_l = -(γ_l * γ_i) :=
    eq_neg_of_add_eq_zero_left h_anti_il
  have hjk : γ_j * γ_k = -(γ_k * γ_j) :=
    eq_neg_of_add_eq_zero_left h_anti_jk
  have hjl : γ_j * γ_l = -(γ_l * γ_j) :=
    eq_neg_of_add_eq_zero_left h_anti_jl
  let A := γ_i * γ_j
  let K := γ_k * γ_l
  have hAK : A * K = K * A := by
    dsimp [A, K]
    calc
      (γ_i * γ_j) * (γ_k * γ_l) =
          γ_i * ((γ_j * γ_k) * γ_l) := by simp only [mul_assoc]
      _ = γ_i * ((-(γ_k * γ_j)) * γ_l) := by rw [hjk]
      _ = -(γ_i * (γ_k * (γ_j * γ_l))) := by
        rw [end_neg_mul, end_mul_neg]
        simp only [mul_assoc]
      _ = -(γ_i * (γ_k * (-(γ_l * γ_j)))) := by rw [hjl]
      _ = γ_i * (γ_k * (γ_l * γ_j)) := by
        rw [end_mul_neg, end_mul_neg, neg_neg]
      _ = (γ_i * γ_k) * (γ_l * γ_j) := by simp only [mul_assoc]
      _ = (-(γ_k * γ_i)) * (γ_l * γ_j) := by rw [hik]
      _ = -(γ_k * (γ_i * (γ_l * γ_j))) := by
        rw [end_neg_mul]
        simp only [mul_assoc]
      _ = -(γ_k * ((γ_i * γ_l) * γ_j)) := by simp only [mul_assoc]
      _ = -(γ_k * ((-(γ_l * γ_i)) * γ_j)) := by rw [hil]
      _ = γ_k * (γ_l * (γ_i * γ_j)) := by
        rw [end_neg_mul, end_mul_neg, neg_neg]
        simp only [mul_assoc]
      _ = (γ_k * γ_l) * (γ_i * γ_j) := by simp only [mul_assoc]
  have hAS : A * (A * K) = (A * K) * A :=
    mul_self_mul_comm_of_comm A K hAK
  have hcore : (1 + A) * (A * K) = (A * K) * (1 + A) := by
    rw [add_mul, one_mul, mul_add, mul_one, hAS]
  rw [majoranaBraidOperator, smul_mul_assoc, mul_smul_comm]
  change _ • ((1 + A) * (A * K)) = _ • ((A * K) * (1 + A))
  rw [hcore]

end BraidRelations

end ZornMajoranaBraiding
