import InfoGeometry.OperatorAlgebra.PeirceSpine.BoundaryDependence
import InfoGeometry.OperatorAlgebra.PeirceSpine.OnShellKernel
import Mathlib.Algebra.Ring.Commute

/-!
# A cubic bridge determined by the cut and one coupling

The diagonal part is the existing `evenGrade P A`; the arrows and their
cycles are the existing Peirce operators. Subtracting the compressed cubic
diagonal term leaves an odd operator compressed by `1 - genV`; on shell
it is supported on the residual corner. The word cubic describes the
inner diagonal correction, before expanding the outer polynomial factors.
The bridge belongs to the native subring generated by the original two
operators. Neither its nonvanishing nor generation of a full matrix ring
is asserted.

An independent elliptic operator gives a self-adjoint sum of twisted
arrows whose square is `genV`. This is an algebraic identity, without a
state, spectral gap, or physical pairing classification.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSpine

variable {B : Type*} [Ring B]

/-- The corrected cubic bridge, expressed entirely in the two seed operators. -/
def endogenousKernelBridge (P A : B) : B :=
  (1 - genV P A A) * (evenGrade P A * A * evenGrade P A) * (1 - genV P A A) -
    (1 - genV P A A) * (evenGrade P A) ^ 3 * (1 - genV P A A)

/-- The subtracted term removes precisely the diagonal cubic contribution. -/
theorem endogenousKernelBridge_eq_odd_sandwich {P : B} (hP : P * P = P) (A : B) :
    endogenousKernelBridge P A =
      (1 - genV P A A) * evenGrade P A * genPhi P A A * evenGrade P A *
        (1 - genV P A A) := by
  have hodd : A - evenGrade P A = genPhi P A A := by
    simp only [genPhi, conePlus, coneMinus]
    peirce_nf hP
  unfold endogenousKernelBridge
  calc
    _ = (1 - genV P A A) * evenGrade P A * (A - evenGrade P A) *
        evenGrade P A * (1 - genV P A A) := by noncomm_ring
    _ = _ := by rw [hodd]

/-- The bridge crosses the two residual cut sectors; its diagonal part vanishes. -/
theorem endogenousKernelBridge_is_odd {P : B} (hP : P * P = P) (A : B) :
    evenGrade P (endogenousKernelBridge P A) = 0 ∧
      oddGrade P (endogenousKernelBridge P A) = endogenousKernelBridge P A := by
  rw [endogenousKernelBridge_eq_odd_sandwich hP]
  constructor <;> peirce_nf hP

/-- On shell the residual idempotent fixes both sides of the actual bridge. -/
theorem endogenousKernelBridge_supported {P : B} (hP : P * P = P) (A : B)
    (hV : genV P A A * genV P A A = genV P A A) :
    (1 - genV P A A) * endogenousKernelBridge P A = endogenousKernelBridge P A ∧
      endogenousKernelBridge P A * (1 - genV P A A) = endogenousKernelBridge P A := by
  have he := onShell_kernel_idempotent A A hV
  rw [endogenousKernelBridge_eq_odd_sandwich hP]
  constructor
  · calc
      _ = ((1 - genV P A A) * (1 - genV P A A)) * evenGrade P A *
          genPhi P A A * evenGrade P A * (1 - genV P A A) := by
            simp only [mul_assoc]
      _ = _ := by rw [he]
  · calc
      _ = (1 - genV P A A) * evenGrade P A * genPhi P A A * evenGrade P A *
          ((1 - genV P A A) * (1 - genV P A A)) := by
            simp only [mul_assoc]
      _ = _ := by rw [he]

/-- Endogeneity is membership in the ordinary native two-generator subring. -/
theorem endogenousKernelBridge_mem_seed_ring (P A : B) :
    endogenousKernelBridge P A ∈ Subring.closure ({P, A} : Set B) := by
  let R := Subring.closure ({P, A} : Set B)
  have hp : P ∈ R := Subring.subset_closure (by simp)
  have ha : A ∈ R := Subring.subset_closure (by simp)
  have hc : 1 - P ∈ R := R.sub_mem R.one_mem hp
  have hn : conePlus P A ∈ R := R.mul_mem (R.mul_mem hp ha) hc
  have hm : coneMinus P A ∈ R := R.mul_mem (R.mul_mem hc ha) hp
  have hd : evenGrade P A ∈ R :=
    R.add_mem (R.mul_mem (R.mul_mem hp ha) hp) (R.mul_mem (R.mul_mem hc ha) hc)
  have hv : genV P A A ∈ R := R.add_mem (R.mul_mem hn hm) (R.mul_mem hm hn)
  have he : 1 - genV P A A ∈ R := R.sub_mem R.one_mem hv
  exact R.sub_mem
    (R.mul_mem (R.mul_mem he (R.mul_mem (R.mul_mem hd ha) hd)) he)
    (R.mul_mem (R.mul_mem he (R.pow_mem hd 3)) he)

/-- Any two arrows through the residual corner have degree one for the
signed active support. This does not assert that the resulting element is nonzero. -/
theorem onShell_kernel_bridge_comm {P : B} (hP : P * P = P) (A C X Y : B)
    (hV : genV P A C * genV P A C = genV P A C) :
    comm (genSig P A C)
        (qgtPlus P A C * X * (1 - genV P A C) +
          (1 - genV P A C) * Y * qgtMinus P A C) =
      qgtPlus P A C * X * (1 - genV P A C) +
        (1 - genV P A C) * Y * qgtMinus P A C := by
  let p := qgtPlus P A C
  let m := qgtMinus P A C
  let e := 1 - genV P A C
  obtain ⟨hpp, hmm⟩ := (genV_idempotent_iff_qgt_idempotent hP A C).mp hV
  obtain ⟨hpm, hmp⟩ := qgt_cycles_orthogonal hP A C
  obtain ⟨hpe, hep, hme, hem⟩ := onShell_kernel_cycle_products hP A C hV
  change (p - m) * (p * X * e + e * Y * m) -
      (p * X * e + e * Y * m) * (p - m) = p * X * e + e * Y * m
  have hl : (p - m) * (p * X * e + e * Y * m) = p * X * e := by
    calc
      _ = (p * p - m * p) * X * e + (p * e - m * e) * Y * m := by
        noncomm_ring
      _ = _ := by rw [hpp, hmp, hpe, hme]; simp
  have hr : (p * X * e + e * Y * m) * (p - m) = -(e * Y * m) := by
    calc
      _ = p * X * (e * p - e * m) + e * Y * (m * p - m * m) := by
        noncomm_ring
      _ = _ := by rw [hep, hem, hmp, hmm]; simp
  rw [hl, hr, sub_neg_eq_add]

/-- The square is the ordered through-kernel product, with no surjectivity claim. -/
theorem onShell_kernel_bridge_square {P : B} (hP : P * P = P) (A C X Y : B)
    (hV : genV P A C * genV P A C = genV P A C) :
    (qgtPlus P A C * X * (1 - genV P A C) +
        (1 - genV P A C) * Y * qgtMinus P A C) ^ 2 =
      qgtPlus P A C * X * (1 - genV P A C) * Y * qgtMinus P A C := by
  let p := qgtPlus P A C
  let m := qgtMinus P A C
  let e := 1 - genV P A C
  have he := onShell_kernel_idempotent A C hV
  have hmp := (qgt_cycles_orthogonal hP A C).2
  obtain ⟨hpe, hep, hme, hem⟩ := onShell_kernel_cycle_products hP A C hV
  change (p * X * e + e * Y * m) ^ 2 = p * X * e * Y * m
  calc
    _ = p * X * (e * p) * X * e + p * X * (e * e) * Y * m +
        e * Y * (m * p) * X * e + e * Y * (m * e) * Y * m := by
      noncomm_ring
    _ = _ := by rw [hep, he, hmp, hme]; simp

/-- The through-kernel charge made from the diagonal part and the corrected bridge. -/
def endogenousCharge (P A : B) : B :=
  qgtPlus P A A * (evenGrade P A * endogenousKernelBridge P A) * (1 - genV P A A) +
    (1 - genV P A A) * evenGrade P A * qgtMinus P A A

/-- The charge also belongs to the original two-generator subring. -/
theorem endogenousCharge_mem_seed_ring (P A : B) :
    endogenousCharge P A ∈ Subring.closure ({P, A} : Set B) := by
  let R := Subring.closure ({P, A} : Set B)
  have hp : P ∈ R := Subring.subset_closure (by simp)
  have ha : A ∈ R := Subring.subset_closure (by simp)
  have hc : 1 - P ∈ R := R.sub_mem R.one_mem hp
  have hn : conePlus P A ∈ R := R.mul_mem (R.mul_mem hp ha) hc
  have hm : coneMinus P A ∈ R := R.mul_mem (R.mul_mem hc ha) hp
  have hq : qgtPlus P A A ∈ R := R.mul_mem hn hm
  have hr : qgtMinus P A A ∈ R := R.mul_mem hm hn
  have hd : evenGrade P A ∈ R :=
    R.add_mem (R.mul_mem (R.mul_mem hp ha) hp) (R.mul_mem (R.mul_mem hc ha) hc)
  have hv : genV P A A ∈ R := R.add_mem hq hr
  have he : 1 - genV P A A ∈ R := R.sub_mem R.one_mem hv
  have hg : endogenousKernelBridge P A ∈ R := endogenousKernelBridge_mem_seed_ring P A
  exact R.add_mem (R.mul_mem (R.mul_mem hq (R.mul_mem hd hg)) he)
    (R.mul_mem (R.mul_mem he hd) hr)

/-- The constructed charge is an actual degree-one element on shell. -/
theorem endogenousCharge_comm {P : B} (hP : P * P = P) (A : B)
    (hV : genV P A A * genV P A A = genV P A A) :
    comm (genSig P A A) (endogenousCharge P A) = endogenousCharge P A := by
  exact onShell_kernel_bridge_comm hP A A
    (evenGrade P A * endogenousKernelBridge P A) (evenGrade P A) hV

/-- Its square retains the ordered factorization through the residual corner. -/
theorem endogenousCharge_square {P : B} (hP : P * P = P) (A : B)
    (hV : genV P A A * genV P A A = genV P A A) :
    endogenousCharge P A ^ 2 =
      qgtPlus P A A * (evenGrade P A * endogenousKernelBridge P A) *
        (1 - genV P A A) * evenGrade P A * qgtMinus P A A := by
  exact onShell_kernel_bridge_square hP A A
    (evenGrade P A * endogenousKernelBridge P A) (evenGrade P A) hV

/-- The actual square has degree two; it may still be zero. -/
theorem endogenousCharge_square_comm {P : B} (hP : P * P = P) (A : B)
    (hV : genV P A A * genV P A A = genV P A A) :
    comm (genSig P A A) (endogenousCharge P A ^ 2) =
      (2 : ℤ) • (endogenousCharge P A ^ 2) := by
  have hq := endogenousCharge_comm hP A hV
  calc
    _ = comm (genSig P A A) (endogenousCharge P A) * endogenousCharge P A +
        endogenousCharge P A * comm (genSig P A A) (endogenousCharge P A) := by
      simp only [comm]
      noncomm_ring
    _ = _ := by rw [hq]; simp only [pow_two, two_smul]

/-- The two oppositely oriented arrows twisted by an elliptic operator. -/
def ellipticArrowSum (P A I : B) : B :=
  I * coneMinus P A - conePlus P A * I

/-- Commutation with the two seeds implies commutation with their actual corners. -/
theorem commute_peirce_arrows {P A I : B} (hIP : Commute I P) (hIA : Commute I A) :
    Commute I (conePlus P A) ∧ Commute I (coneMinus P A) := by
  have hc : Commute I (1 - P) := (Commute.one_right I).sub_right hIP
  exact ⟨(hIP.mul_right hIA).mul_right hc, (hc.mul_right hIA).mul_right hIP⟩

/-- The elliptic sum is minus the elliptic operator times the skew Peirce generator. -/
theorem ellipticArrowSum_eq_neg_mul_genJ {P A I : B}
    (hIP : Commute I P) (hIA : Commute I A) :
    ellipticArrowSum P A I = -(I * genJ P A A) := by
  have hp := (commute_peirce_arrows hIP hIA).1
  simp only [ellipticArrowSum, genJ, mul_sub, neg_sub, hp.eq]

/-- Its square is the active metric in an arbitrary associative ring. -/
theorem ellipticArrowSum_square {P A I : B} (hP : P * P = P)
    (hIP : Commute I P) (hIA : Commute I A) (hI : I * I = -1) :
    ellipticArrowSum P A I * ellipticArrowSum P A I = genV P A A := by
  obtain ⟨hp, hm⟩ := commute_peirce_arrows hIP hIA
  have hj : Commute I (genJ P A A) := hp.sub_right hm
  have hjsq : genJ P A A * genJ P A A = -genV P A A := by peirce_nf hP
  rw [ellipticArrowSum_eq_neg_mul_genJ hIP hIA, neg_mul_neg]
  calc
    _ = (I * I) * (genJ P A A * genJ P A A) := by
      simpa only [pow_two] using hj.mul_pow 2
    _ = genV P A A := by rw [hI, hjsq]; simp

/-- On shell the square contributes nothing to the residual corner. -/
theorem ellipticArrowSum_square_kernel {P A I : B} (hP : P * P = P)
    (hIP : Commute I P) (hIA : Commute I A) (hI : I * I = -1)
    (hV : genV P A A * genV P A A = genV P A A) :
    (1 - genV P A A) * (ellipticArrowSum P A I * ellipticArrowSum P A I) *
      (1 - genV P A A) = 0 := by
  rw [ellipticArrowSum_square hP hIP hIA hI,
    (onShell_genV_kernel_products A A hV).2, zero_mul]

section Star

variable [StarRing B]

/-- Self-adjoint seed data produce a self-adjoint corrected bridge. -/
theorem star_endogenousKernelBridge {P A : B} (hPs : star P = P) (hAs : star A = A) :
    star (endogenousKernelBridge P A) = endogenousKernelBridge P A := by
  have hd : star (evenGrade P A) = evenGrade P A := by
    simp only [evenGrade, star_add, star_mul, star_sub, star_one, hPs, hAs, mul_assoc]
  have hv : star (genV P A A) = genV P A A := by
    simpa only [hAs] using star_genV hPs A
  simp only [endogenousKernelBridge, star_sub, star_mul, star_pow, star_one,
    hd, hv, hAs, mul_assoc]

/-- Opposite-side twisting is self-adjoint without requiring a scalar imaginary unit. -/
theorem star_ellipticArrowSum {P A I : B} (hPs : star P = P)
    (hAs : star A = A) (hIs : star I = -I) :
    star (ellipticArrowSum P A I) = ellipticArrowSum P A I := by
  simp only [ellipticArrowSum, star_sub, star_mul, star_coneMinus hPs,
    star_conePlus hPs, hAs, hIs, mul_neg, neg_mul, neg_sub_neg]

end Star

end InfoGeometry.OperatorAlgebra.PeirceSpine
