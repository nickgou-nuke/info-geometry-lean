-- InfoGeometry/OperatorAlgebra/ParabolicClockInClifford.lean
import Mathlib.LinearAlgebra.CliffordAlgebra.Basic
import Mathlib.Algebra.Category.AlgCat.Basic
import Mathlib.Algebra.Category.Ring.Basic
import InfoGeometry.Algebraic.SplitQuadraticForm
import InfoGeometry.Projective.ParabolicTimeMonodromy

open CategoryTheory

noncomputable section

namespace InfoGeometry.OperatorAlgebra

/-- The parabolic clock algebra: the algebra generated by a single nilpotent element ε with ε² = 0. -/
def ParabolicClockAlg : Type := ℝ[X] / (X^2)  -- quotient of polynomial ring by X^2

instance : Ring ParabolicClockAlg := by sorry
instance : Algebra ℝ ParabolicClockAlg := by sorry

/-- The nilpotent generator in the parabolic clock algebra. -/
def ε : ParabolicClockAlg := by sorry

property ε_sq_zero : ε * ε = 0 := by sorry

/-- Embedding of the parabolic clock algebra into Cl(1,1) (the split Clifford algebra for n=1). -/
-- We know Cl(1,1) ≅ M₂(ℝ) and contains nilpotent matrices, e.g., [[0,1],[0,0]].
def embed_parabolic_to_Cl11 : ParabolicClockAlg →ₐ[ℝ] CliffordAlgebra (splitQuadraticForm 1) := by sorry

property embed_preserves_nilpotent : (embed_parabolic_to_Cl11 ε) * (embed_parabolic_to_Cl11 ε) = 0 := by sorry

/-- For any n ≥ 1, we have a bonding map from Cl(1,1) to Cl(n,n) given by including the first hyperbolic plane.
-- This can be obtained from the functoriality of the Clifford algebra construction with respect to
-- orthogonal sum of quadratic spaces (see CliffordCAR for the split basis).
-- We assume the existence of such a map as part of the directed system used to build the Clifford infinity CAR.
def embed_Cl11_to_Clnn {n : ℕ} (hn : 1 ≤ n) : CliffordAlgebra (splitQuadraticForm 1) →ₐ[ℝ] CliffordAlgebra (splitQuadraticForm n) := by sorry

/-- The composite embedding of the parabolic clock algebra into Cl(n,n) for any n ≥ 1.
def embed_parabolic_to_Clnn {n : ℕ} (hn : 1 ≤ n) : ParabolicClockAlg →ₐ[ℝ] CliffordAlgebra (splitQuadraticForm n) := by sorry

/-- The embeddings are compatible with the bonding maps, thus defining an element in the colimit
-- of the directed system (Cl(n,n))_{n∈ℕ} (the Clifford infinity CAR).
-- We state that the colimit contains a nilpotent element corresponding to the parabolic clock.
theorem parabolic_clock_in_clifford_infinity :
    ∃ (x : CliffordAlgebra (splitQuadraticForm 0)), False := by sorry  -- placeholder

end InfoGeometry.OperatorAlgebra