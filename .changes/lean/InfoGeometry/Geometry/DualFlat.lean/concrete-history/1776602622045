{"type":"new","contents":"import Mathlib.Analysis.Calculus.FDeriv.Basic\nimport Mathlib.Analysis.Convex.Deriv\nimport Mathlib.Analysis.InnerProductSpace.Basic\nimport Mathlib.Analysis.InnerProductSpace.Dual\nimport Mathlib.Order.Closure\nimport Mathlib.Tactic.Abel\nimport Mathlib.Tactic.Linarith\nimport Mathlib.Tactic.Ring\nimport InfoGeometry.Convex.Bregman\nimport InfoGeometry.Projective.Rays\nimport InfoGeometry.MaxEnt.Core\n\nnamespace InfoGeometry.Geometry\n\nvariable {Θ : Type _}\nvariable [NormedAddCommGroup Θ]\nvariable [NormedSpace ℝ Θ]\n\n/-- Hessian geometry generated by a potential function. -/\nstructure HessianGeometry (Θ : Type _) where\n  ψ : Θ → ℝ\n\n/-- Hessian operator at a point. -/\nnoncomputable def hessian\n    (H : HessianGeometry Θ)\n    (x : Θ) : Θ →L[ℝ] (Θ →L[ℝ] ℝ) :=\n  fderiv ℝ (fun y => fderiv ℝ H.ψ y) x\n\n/-- Metric tensor induced by the Hessian. -/\nnoncomputable def metric\n    (H : HessianGeometry Θ)\n    (x : Θ)\n    (u v : Θ) : ℝ :=\n  (hessian H x u) v\n\n/-- Dual-coordinate map given by the gradient covector. -/\nnoncomputable def dualCoord\n    (H : HessianGeometry Θ)\n    (x : Θ) : Θ →L[ℝ] ℝ :=\n  fderiv ℝ H.ψ x\n\n/-- Bregman divergence induced by the Hessian potential. -/\nnoncomputable def divergence\n    (H : HessianGeometry Θ)\n    (η θ : Θ) : ℝ :=\n  H.ψ η - H.ψ θ - (dualCoord H θ) (η - θ)\n\n@[simp] lemma divergence_self\n    (H : HessianGeometry Θ) (θ : Θ) :\n    divergence H θ θ = 0 := by\n  unfold divergence\n  simp\n\nsection Structural\n\n/-- Affine `e`-geodesic in primal coordinates. -/\nnoncomputable def eGeodesic\n    (x y : Θ)\n    (t : ℝ) : Θ :=\n  (1 - t) • x + t • y\n\n@[simp]\nlemma eGeodesic_zero\n    (x y : Θ) :\n    eGeodesic x y 0 = x := by\n  simp [eGeodesic]\n\n@[simp]\nlemma eGeodesic_one\n    (x y : Θ) :\n    eGeodesic x y 1 = y := by\n  simp [eGeodesic]\n\n/-- Geodesic convexity along affine `e`-geodesics. -/\ndef eGeodesicConvex\n    (f : Θ → ℝ) : Prop :=\n  ∀ x y t,\n    0 ≤ t → t ≤ 1 →\n      f (eGeodesic x y t) ≤ (1 - t) * f x + t * f y\n\nlemma ConvexOn.eGeodesicConvex\n    {f : Θ → ℝ}\n    (hconv : ConvexOn ℝ Set.univ f) :\n    eGeodesicConvex f := by\n  rcases hconv with ⟨_, hineq⟩\n  intro x y t ht0 ht1\n  have ht1' : 0 ≤ 1 - t := by linarith\n  have hsum : (1 - t) + t = (1 : ℝ) := by ring\n  simpa [eGeodesic] using\n    hineq (x := x) (by simp) (y := y) (by simp)\n      (a := 1 - t) (b := t) ht1' ht0 hsum\n\nlemma eGeodesicConvex.convexOn_univ\n    {f : Θ → ℝ}\n    (hgeo : eGeodesicConvex f) :\n    ConvexOn ℝ Set.univ f := by\n  refine ⟨convex_univ, ?_⟩\n  intro x hx y hy a b ha hb hab\n  have ha' : a = 1 - b := by linarith\n  rw [ha']\n  exact hgeo x y b hb (by linarith)\n\n/-- Convexity on the ambient affine space is equivalent to `e`-geodesic convexity. -/\ntheorem convexOn_univ_iff_eGeodesicConvex\n    (f : Θ → ℝ) :\n    ConvexOn ℝ Set.univ f ↔ eGeodesicConvex f := by\n  constructor\n  · intro hconv\n    exact ConvexOn.eGeodesicConvex hconv\n  · intro hgeo\n    exact hgeo.convexOn_univ\n\n/-- Alias for the main convexity/e-geodesic-convexity equivalence. -/\ntheorem convex_iff_eGeodesicConvex\n    (f : Θ → ℝ) :\n    ConvexOn ℝ Set.univ f ↔ eGeodesicConvex f :=\n  convexOn_univ_iff_eGeodesicConvex f\n\n/-- Data witnessing that `dualCoord` is bijective with a chosen inverse. -/\nstructure GradientBijection\n    (H : HessianGeometry Θ) where\n  invDual : (Θ →L[ℝ] ℝ) → Θ\n  left_inv : ∀ θ, invDual (dualCoord H θ) = θ\n  right_inv : ∀ η, dualCoord H (invDual η) = η\n\n/-- Dual (`m`-) geodesic: affine interpolation in dual coordinates, pulled back by the inverse gradient. -/\nnoncomputable def mGeodesic\n    (H : HessianGeometry Θ)\n    (hGrad : GradientBijection H)\n    (x y : Θ)\n    (t : ℝ) : Θ :=\n  hGrad.invDual ((1 - t) • dualCoord H x + t • dualCoord H y)\n\n@[simp]\nlemma mGeodesic_zero\n    (H : HessianGeometry Θ)\n    (hGrad : GradientBijection H)\n    (x y : Θ) :\n    mGeodesic H hGrad x y 0 = x := by\n  simp [mGeodesic, hGrad.left_inv]\n\n@[simp]\nlemma mGeodesic_one\n    (H : HessianGeometry Θ)\n    (hGrad : GradientBijection H)\n    (x y : Θ) :\n    mGeodesic H hGrad x y 1 = y := by\n  simp [mGeodesic, hGrad.left_inv]\n\nlemma dualCoord_mGeodesic\n    (H : HessianGeometry Θ)\n    (hGrad : GradientBijection H)\n    (x y : Θ)\n    (t : ℝ) :\n    dualCoord H (mGeodesic H hGrad x y t)\n      = (1 - t) • dualCoord H x + t • dualCoord H y := by\n  simp [mGeodesic, hGrad.right_inv]\n\n/-- Algebraic three-point identity for the Hessian/Bregman divergence. -/\nlemma divergence_three_point\n    (H : HessianGeometry Θ)\n    (η θ θ' : Θ) :\n    divergence H η θ\n      =\n      divergence H η θ'\n        + divergence H θ' θ\n        + ((dualCoord H θ' - dualCoord H θ) (η - θ')) := by\n  unfold divergence\n  have hsplit : η - θ = (η - θ') + (θ' - θ) := by\n    abel_nf\n  have hlin :\n      (dualCoord H θ) (η - θ)\n        = (dualCoord H θ) (η - θ') + (dualCoord H θ) (θ' - θ) := by\n    rw [hsplit, map_add]\n  rw [hlin]\n  simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]\n  ring\n\n/-- Pythagorean decomposition from orthogonality of the residual term. -/\nlemma divergence_pythagorean\n    (H : HessianGeometry Θ)\n    (η θ θ' : Θ)\n    (horth : ((dualCoord H θ' - dualCoord H θ) (η - θ')) = 0) :\n    divergence H η θ = divergence H η θ' + divergence H θ' θ := by\n  rw [divergence_three_point (H := H) (η := η) (θ := θ) (θ' := θ')]\n  simp [horth]\n\nend Structural\n\nsection Riesz\n\nvariable {E : Type _}\nvariable [NormedAddCommGroup E]\nvariable [InnerProductSpace ℝ E]\nvariable [CompleteSpace E]\n\n/-- Riesz-identified vector gradient corresponding to `dualCoord`. -/\nnoncomputable def dualCoordVec\n    (H : HessianGeometry E)\n    (x : E) : E :=\n  (InnerProductSpace.toDual ℝ E).symm (dualCoord (Θ := E) H x)\n\n/-- `dualCoordVec` represents the same functional as `dualCoord` via Riesz. -/\nlemma dualCoordVec_spec\n    (H : HessianGeometry E)\n    (x y : E) :\n    inner ℝ (dualCoordVec H x) y = (dualCoord (Θ := E) H x) y := by\n  change inner ℝ\n      ((InnerProductSpace.toDual ℝ E).symm (dualCoord (Θ := E) H x)) y\n      = (dualCoord (Θ := E) H x) y\n  exact InnerProductSpace.toDual_symm_apply\n    (𝕜 := ℝ) (E := E) (x := y) (y := dualCoord (Θ := E) H x)\n\n/-- Vector-gradient form of Bregman divergence. -/\nnoncomputable def divergenceVec\n    (H : HessianGeometry E)\n    (η θ : E) : ℝ :=\n  H.ψ η - H.ψ θ - inner ℝ (dualCoordVec H θ) (η - θ)\n\n@[simp] lemma divergenceVec_self\n    (H : HessianGeometry E) (θ : E) :\n    divergenceVec H θ θ = 0 := by\n  unfold divergenceVec\n  simp\n\nlemma divergence_eq_divergenceVec\n    (H : HessianGeometry E)\n    (η θ : E) :\n    divergence (Θ := E) H η θ = divergenceVec H η θ := by\n  unfold divergence divergenceVec\n  simp [dualCoordVec_spec]\n\nlemma divergenceVec_three_point\n    (H : HessianGeometry E)\n    (η θ θ' : E) :\n    divergenceVec H η θ\n      =\n      divergenceVec H η θ'\n        + divergenceVec H θ' θ\n        + inner ℝ (dualCoordVec H θ' - dualCoordVec H θ) (η - θ') := by\n  have hinner :\n      ((dualCoord H θ' - dualCoord H θ) (η - θ'))\n        = inner ℝ (dualCoordVec H θ' - dualCoordVec H θ) (η - θ') := by\n    calc\n      ((dualCoord H θ' - dualCoord H θ) (η - θ'))\n          = (dualCoord H θ') (η - θ') - (dualCoord H θ) (η - θ') := by\n              simp [ContinuousLinearMap.sub_apply]\n      _ = inner ℝ (dualCoordVec H θ') (η - θ')\n            - inner ℝ (dualCoordVec H θ) (η - θ') := by\n              simp [dualCoordVec_spec]\n      _ = inner ℝ (dualCoordVec H θ' - dualCoordVec H θ) (η - θ') := by\n            simp [inner_sub_left]\n  rw [← divergence_eq_divergenceVec (H := H) (η := η) (θ := θ)]\n  rw [← divergence_eq_divergenceVec (H := H) (η := η) (θ := θ')]\n  rw [← divergence_eq_divergenceVec (H := H) (η := θ') (θ := θ)]\n  rw [divergence_three_point (H := H) (η := η) (θ := θ) (θ' := θ')]\n  rw [hinner]\n\nlemma divergenceVec_pythagorean\n    (H : HessianGeometry E)\n    (η θ θ' : E)\n    (horth : inner ℝ (dualCoordVec H θ' - dualCoordVec H θ) (η - θ') = 0) :\n    divergenceVec H η θ = divergenceVec H η θ' + divergenceVec H θ' θ := by\n  rw [divergenceVec_three_point (H := H) (η := η) (θ := θ) (θ' := θ')]\n  simp [horth]\n\nend Riesz\n\nsection Abstract\n\n/-! Abstract Hessian-manifold wrappers for finite/infinite-dimensional use. -/\n\nstructure HessianManifold (Θ : Type _)\n    [NormedAddCommGroup Θ] [NormedSpace ℝ Θ] where\n  ψ : Θ → ℝ\n  twiceDiff :\n    ∀ x,\n      HasFDerivAt\n        (fun y => fderiv ℝ ψ y)\n        (fderiv ℝ (fun y => fderiv ℝ ψ y) x)\n        x\n\nnoncomputable def HessianManifold.metric\n    (H : HessianManifold Θ)\n    (x : Θ)\n    (u v : Θ) : ℝ :=\n  (fderiv ℝ (fun y => fderiv ℝ H.ψ y) x u) v\n\nstructure HilbertHessian (H : Type _)\n    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] where\n  ψ : H → ℝ\n  twiceDiff :\n    ∀ x,\n      HasFDerivAt\n        (fun y => fderiv ℝ ψ y)\n        (fderiv ℝ (fun y => fderiv ℝ ψ y) x)\n        x\n\nnoncomputable def HilbertHessian.metric\n    {H : Type _}\n    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]\n    (M : HilbertHessian H)\n    (x : H)\n    (u v : H) : ℝ :=\n  (fderiv ℝ (fun y => fderiv ℝ M.ψ y) x u) v\n\nend Abstract\n\nend InfoGeometry.Geometry\n\n/-!\n# Dual Flat Geometry and Projective Bayesian Bridge\n\nAn explicit dual-flat package over inner-product spaces, together with a\nprojective/statistical bridge theorem phrased as a Bregman Pythagorean identity.\n-/\n\nnamespace InfoGeometry.Geometry.DualFlat\n\nopen Set\nopen scoped Real\n\nvariable {E : Type _}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\n/--\nA dual-flat structure generated by a strictly convex differentiable potential `ψ`.\nVia Riesz, the dual gradient is represented as a vector field on `E`.\n-/\nstructure DualFlatStructure (E : Type _)\n    [NormedAddCommGroup E] [InnerProductSpace ℝ E] where\n  ψ : E → ℝ\n  h_convex : StrictConvexOn ℝ Set.univ ψ\n  h_diff : Differentiable ℝ ψ\n\nvariable (S : DualFlatStructure E)\n\n/-- Repackage a dual-flat potential as a Hessian-geometry potential. -/\ndef toHessianGeometry : InfoGeometry.Geometry.HessianGeometry E where\n  ψ := S.ψ\n\n/-- Primal gradient coordinates `∇ψ`, represented in `E` using Riesz. -/\nnoncomputable def nabla (x : E) : E :=\n  InfoGeometry.Geometry.dualCoordVec (H := toHessianGeometry S) x\n\n/-- Bregman divergence induced by `ψ`. -/\nnoncomputable def divergence (x y : E) : ℝ :=\n  InfoGeometry.Geometry.divergenceVec (H := toHessianGeometry S) x y\n\n@[simp] lemma divergence_self (x : E) :\n    divergence S x x = 0 := by\n  simp [divergence, toHessianGeometry]\n\n/-- Three-point identity (dual-flat law of cosines). -/\ntheorem three_point_identity (x y z : E) :\n    divergence S x z\n      = divergence S x y + divergence S y z\n        - inner ℝ (nabla S z - nabla S y) (x - y) := by\n  have hbase :=\n    InfoGeometry.Geometry.divergenceVec_three_point\n      (H := toHessianGeometry S) (η := x) (θ := z) (θ' := y)\n  have hsign :\n      inner ℝ (nabla S y - nabla S z) (x - y)\n        = -inner ℝ (nabla S z - nabla S y) (x - y) := by\n    have hswap : nabla S y - nabla S z = -(nabla S z - nabla S y) := by\n      abel_nf\n    rw [hswap, inner_neg_left]\n  calc\n    divergence S x z\n        = divergence S x y + divergence S y z\n            + inner ℝ (nabla S y - nabla S z) (x - y) := by\n              simpa [divergence, nabla, toHessianGeometry] using hbase\n    _ = divergence S x y + divergence S y z\n          - inner ℝ (nabla S z - nabla S y) (x - y) := by\n            rw [hsign]\n            ring\n\n/--\nGeneralized Bregman Pythagorean theorem:\northogonality of dual and primal residual directions implies additive divergence\ndecomposition.\n-/\ntheorem bregman_pythagorean\n    (x y z : E)\n    (h_ortho : inner ℝ (nabla S z - nabla S y) (x - y) = 0) :\n    divergence S x z = divergence S x y + divergence S y z := by\n  rw [three_point_identity (S := S), h_ortho]\n  simp\n\nsection RealBridge\n\nlemma dualCoord_apply_sub_eq_deriv_mul\n    (SR : DualFlatStructure ℝ) (x y : ℝ) :\n    (InfoGeometry.Geometry.dualCoord (Θ := ℝ) (toHessianGeometry SR) y) (x - y)\n      = deriv SR.ψ y * (x - y) := by\n  change (fderiv ℝ SR.ψ y : ℝ →L[ℝ] ℝ) (x - y) = deriv SR.ψ y * (x - y)\n  calc\n    (fderiv ℝ SR.ψ y : ℝ →L[ℝ] ℝ) (x - y)\n        = (x - y) * deriv SR.ψ y := by\n            rw [fderiv_eq_smul_deriv (f := SR.ψ) (x := y) (y := x - y)]\n            simp [smul_eq_mul]\n    _ = deriv SR.ψ y * (x - y) := by ring\n\nlemma divergence_eq_bregmanDiv_real\n    (SR : DualFlatStructure ℝ) (x y : ℝ) :\n    divergence SR x y = InfoGeometry.bregmanDiv SR.ψ x y := by\n  unfold divergence\n  unfold InfoGeometry.Geometry.divergenceVec InfoGeometry.bregmanDiv\n  rw [InfoGeometry.Geometry.dualCoordVec_spec\n    (H := toHessianGeometry SR) (x := y) (y := x - y)]\n  rw [dualCoord_apply_sub_eq_deriv_mul (SR := SR) (x := x) (y := y)]\n  simp [toHessianGeometry]\n\nend RealBridge\n\nnamespace ProjectiveBridge\n\nopen InfoGeometry.MaxEnt\n\nvariable {Ω : Type _} [MeasurableSpace Ω]\n\n/-- Unnormalized state/mass package used for projective-probability interpretation. -/\nstructure UnnormalizedMeasure (μ₀ : MeasureTheory.Measure Ω) where\n  representative : ACProbMeasure μ₀\n  totalMass : ℝ\n  mass_pos : 0 < totalMass\n\n/-- Conceptual ray space of probability states via doubled-space projectivization. -/\nabbrev ProjectiveProbability : Type _ := InfoGeometry.Projective.ProjectiveState (E := E)\n\n/-- Projective divergence on representatives: measure-theoretic KL on AC probabilities. -/\nnoncomputable def projectiveDivergence\n    {μ₀ : MeasureTheory.Measure Ω}\n    (P Q : UnnormalizedMeasure μ₀) : ENNReal :=\n  InfoGeometry.KL.kl_div P.representative.μ Q.representative.μ\n\nlemma projectiveDivergence_eq_kl\n    {μ₀ : MeasureTheory.Measure Ω}\n    (P Q : UnnormalizedMeasure μ₀) :\n    projectiveDivergence P Q\n      = InfoGeometry.KL.kl_div P.representative.μ Q.representative.μ :=\n  rfl\n\nlemma projectiveDivergence_eq_of_representative_eq\n    {μ₀ : MeasureTheory.Measure Ω}\n    {P P' Q Q' : UnnormalizedMeasure μ₀}\n    (hP : P.representative = P'.representative)\n    (hQ : Q.representative = Q'.representative) :\n    projectiveDivergence P Q = projectiveDivergence P' Q' := by\n  cases P\n  cases P'\n  cases Q\n  cases Q'\n  cases hP\n  cases hQ\n  rfl\n\ntheorem bayesian_update_pythagorean_point\n    (Prior Posterior Alt : E)\n    (h_ortho :\n      inner ℝ (nabla S Prior - nabla S Posterior) (Alt - Posterior) = 0) :\n    divergence S Alt Prior\n      = divergence S Alt Posterior + divergence S Posterior Prior := by\n  exact bregman_pythagorean (S := S) (x := Alt) (y := Posterior) (z := Prior) h_ortho\n\n/--\nBayesian/MaxEnt update as Bregman-orthogonal projection:\nfor any feasible alternative `Alt`, divergence to `Prior` decomposes through\nthe projected posterior.\n-/\ntheorem bayesian_update_pythagorean\n    (Prior Posterior Alt : E)\n    (h_projection :\n      ∀ v, (∃ t : ℝ, v = Alt + t • (Posterior - Alt)) →\n        inner ℝ (nabla S Prior - nabla S Posterior) (v - Posterior) = 0) :\n    divergence S Alt Prior\n      = divergence S Alt Posterior + divergence S Posterior Prior := by\n  exact bayesian_update_pythagorean_point (S := S) Prior Posterior Alt\n    (h_projection Alt ⟨0, by simp⟩)\n\n/--\nBayesian/MaxEnt update as a scalar Bregman Pythagorean identity in `ℝ`,\nbridging `Geometry.DualFlat` with `InfoGeometry.bregmanDiv`.\n-/\ntheorem bayesian_update_pythagorean_bregman\n    (SR : DualFlatStructure ℝ)\n    (Prior Posterior Alt : ℝ)\n    (h_projection :\n      ∀ v, (∃ t : ℝ, v = Alt + t • (Posterior - Alt)) →\n        inner ℝ (nabla SR Prior - nabla SR Posterior) (v - Posterior) = 0) :\n    InfoGeometry.bregmanDiv SR.ψ Alt Prior\n      = InfoGeometry.bregmanDiv SR.ψ Alt Posterior\n        + InfoGeometry.bregmanDiv SR.ψ Posterior Prior := by\n  have hgeom :\n      divergence SR Alt Prior\n        = divergence SR Alt Posterior + divergence SR Posterior Prior :=\n    bayesian_update_pythagorean (S := SR) Prior Posterior Alt h_projection\n  simpa [divergence_eq_bregmanDiv_real] using hgeom\n\nend ProjectiveBridge\n\nend InfoGeometry.Geometry.DualFlat\n","mtime":1776602622045}