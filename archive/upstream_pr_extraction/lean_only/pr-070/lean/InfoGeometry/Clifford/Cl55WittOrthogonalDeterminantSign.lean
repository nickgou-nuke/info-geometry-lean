import InfoGeometry.Clifford.Cl55WittCartanDieudonneFull
import InfoGeometry.Clifford.Cl55WittReflectionDeterminant
import InfoGeometry.Clifford.Cl55WittSpinOrthogonalAction

/-!
# Determinant-sign boundary for the native split orthogonal action

The native `Q55` orthogonal group is generated by anisotropic quadratic
reflections, each of determinant `-1`.  This gives the exact finite
orientation dichotomy `det = 1 ∨ det = -1`.  The file deliberately does not
identify the native `Spin55` image with the determinant-one component: an
even-word presentation of every native Spin element is a separate theorem.
-/

noncomputable section

namespace InfoGeometry.Clifford.Clifford55

def orthogonalDeterminantSignSubgroup : Subgroup orthogonalGroup55 where
  carrier := {g | g.1.det = (1 : ℝˣ) ∨ g.1.det = (-1 : ℝˣ)}
  one_mem' := by
    exact Or.inl (by simp)
  mul_mem' := by
    intro g h hg hh
    change (g.1 * h.1).det = (1 : ℝˣ) ∨
      (g.1 * h.1).det = (-1 : ℝˣ)
    rw [map_mul]
    rcases hg with hg | hg <;> rcases hh with hh | hh
    · rw [hg, hh]
      simp
    · rw [hg, hh]
      simp
    · rw [hg, hh]
      simp
    · rw [hg, hh]
      simp
  inv_mem' := by
    intro g hg
    change (g.1⁻¹).det = (1 : ℝˣ) ∨
      (g.1⁻¹).det = (-1 : ℝˣ)
    have hdet : (g.1⁻¹).det = (g.1.det)⁻¹ := by
      exact (LinearEquiv.det (R := ℝ) (M := V55)).map_inv g.1
    rw [hdet]
    rcases hg with hg | hg
    · rw [hg]
      simp
    · rw [hg]
      simp

theorem quadraticReflectionElement_mem_orthogonalDeterminantSignSubgroup
    (v : V55) (hv : Q55 v ≠ 0) :
    quadraticReflectionElement v hv ∈
      orthogonalDeterminantSignSubgroup := by
  exact Or.inr (quadraticReflectionElement_det v hv)

theorem quadraticReflectionSubgroup_le_orthogonalDeterminantSignSubgroup :
    quadraticReflectionSubgroup ≤ orthogonalDeterminantSignSubgroup := by
  refine (Subgroup.closure_le _).2 ?_
  rintro _ ⟨v, hv, rfl⟩
  exact quadraticReflectionElement_mem_orthogonalDeterminantSignSubgroup v hv

theorem orthogonalGroup55_det_eq_one_or_neg_one (g : orthogonalGroup55) :
    g.1.det = (1 : ℝˣ) ∨ g.1.det = (-1 : ℝˣ) := by
  have hg : g ∈ quadraticReflectionSubgroup := by
    rw [quadraticReflectionSubgroup_eq_top]
    trivial
  exact quadraticReflectionSubgroup_le_orthogonalDeterminantSignSubgroup hg

theorem spinActionOrthogonal_det_eq_one_or_neg_one (g : Spin55) :
    (spinActionOrthogonal g).1.det = (1 : ℝˣ) ∨
      (spinActionOrthogonal g).1.det = (-1 : ℝˣ) := by
  exact orthogonalGroup55_det_eq_one_or_neg_one (spinActionOrthogonal g)

end InfoGeometry.Clifford.Clifford55
