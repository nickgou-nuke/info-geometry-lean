import InfoGeometry.Krein.Modular
import InfoGeometry.Algebra.FiniteSpinAlgebra

/-!
# Krein Liouvillean dynamics

This file owns the operator-theoretic replacement for proposition-valued
Liouvillean and eta-unitarity gates.

A Krein-self-adjoint Liouvillean and a Krein-skew-adjoint flow generator are
represented by subtypes of continuous linear endomorphisms.  The modular flow
is then constructed by `modularFlowOfGenerator`; its identity, composition,
and Krein-isometry laws are derived theorems rather than stored evidence.
-/

namespace InfoGeometry.Krein

open scoped InnerProductSpace
open KreinSpace

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable [KreinSpace H]

local notation "EndH" => H →L[ℝ] H

/-- A bounded Liouvillean carrying the native Krein-self-adjoint predicate. -/
abbrev KreinSelfAdjointLiouvillean :=
  {L : EndH // IsKreinSelfAdjoint L}

/--
A bounded infinitesimal generator carrying the native Krein-skew-adjoint
predicate required for Krein-isometric exponential evolution.
-/
abbrev KreinSkewGenerator :=
  {G : EndH // IsKreinSkewAdjoint G}

/-- The canonical exponential modular flow generated by `G`. -/
noncomputable def KreinSkewGenerator.modularFlow
    (G : KreinSkewGenerator (H := H)) :
    ModularFlow G.1 :=
  modularFlowOfGenerator G.1 G.2

/-- The time-zero evolution is the identity operator. -/
@[simp] theorem KreinSkewGenerator.flow_zero
    (G : KreinSkewGenerator (H := H)) :
    G.modularFlow.flow 0 = 1 :=
  G.modularFlow.flow_zero

/-- The canonical evolution satisfies the one-parameter group law. -/
theorem KreinSkewGenerator.flow_add
    (G : KreinSkewGenerator (H := H)) (s t : ℝ) :
    G.modularFlow.flow (s + t) =
      G.modularFlow.flow s * G.modularFlow.flow t :=
  G.modularFlow.flow_add s t

/-- Every time slice of the canonical evolution preserves the Krein form. -/
theorem KreinSkewGenerator.flow_isKreinIsometry
    (G : KreinSkewGenerator (H := H)) (t : ℝ) :
    IsKreinIsometry (G.modularFlow.flow t) :=
  G.modularFlow.flow_is_isometry t

/--
The modular operator generated by any bounded operator is a canonical
Krein-self-adjoint Liouvillean.
-/
noncomputable def modularLiouvillean (T : EndH) :
    KreinSelfAdjointLiouvillean (H := H) :=
  ⟨modularOperator T, modularOperator_kreinSelfAdjoint T⟩

/-- The operator underlying `modularLiouvillean T` is `T♯T`. -/
@[simp] theorem modularLiouvillean_coe (T : EndH) :
    (modularLiouvillean T : EndH) = modularOperator T :=
  rfl

/-- Native Krein self-adjointness of the constructed modular Liouvillean. -/
theorem modularLiouvillean_isKreinSelfAdjoint (T : EndH) :
    IsKreinSelfAdjoint (modularLiouvillean T : EndH) :=
  (modularLiouvillean T).2

end InfoGeometry.Krein
