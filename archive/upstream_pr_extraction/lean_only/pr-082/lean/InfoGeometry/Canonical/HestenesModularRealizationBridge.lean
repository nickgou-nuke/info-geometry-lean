import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import InfoGeometry.Canonical.LogScaleModularSurprisalBridge

/-!
# Hestenes Modular Realization Bridge

This file provides the real internal-I realization of the abstract complex surprisal generator $\mathcal{K}$.
It connects the Hestenes Space-Time algebra formulation, where the imaginary unit is replaced by a real
geometric operator $I$ satisfying $I^2 = -1$, to the modular surprisal flow.
-/

namespace InfoGeometry.Canonical.HestenesModularRealizationBridge

noncomputable section

variable {M : Type*} [NormedAddCommGroup M] [NormedSpace ℝ M] [CompleteSpace M]

local notation "EndM" => M →L[ℝ] M

noncomputable local instance : NormedRing EndM := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndM := inferInstance
noncomputable local instance : NormedAlgebra ℚ EndM :=
  NormedAlgebra.restrictScalars ℚ ℝ EndM

/-- The Hestenes geometric realization datum for the modular generator. -/
structure HestenesModularDatum where
  /-- The real internal geometric unit $I$. -/
  I : EndM
  /-- The condition that $I^2 = -1$, serving as the geometric imaginary unit. -/
  I_sq_eq_neg_one : I ∘L I = -ContinuousLinearMap.id ℝ M
  /-- The real generator $V$. -/
  V_op : EndM
  /-- $I$ and $V_{op}$ commute, making $IV$ a well-behaved complexified operator. -/
  commute_I_V : Commute I V_op
  /-- The real modular implementer. -/
  Delta_real : ℝ → EndM
  /-- The flow corresponds to the real exponential. The complex exponent $-it \mathcal{K}$
      with $\mathcal{K} \leftrightarrow IV$ maps to $-(t I) (IV) = t V_{op}$. -/
  flow_eq_exp : ∀ t : ℝ,
    Delta_real t = NormedSpace.exp ((t : ℝ) • V_op)

/-- The fundamental real generator associated to the complexified $\mathcal{K}$. -/
noncomputable def realSurprisalGenerator (D : HestenesModularDatum (M := M)) : EndM :=
  D.I ∘L D.V_op

/-- 
The real modular flow is exactly a one-parameter group generated by $V_{op}$.
-/
theorem hestenes_flow_add (D : HestenesModularDatum (M := M)) (t s : ℝ) :
    D.Delta_real (t + s) = D.Delta_real t ∘L D.Delta_real s := by
  rw [D.flow_eq_exp, D.flow_eq_exp, D.flow_eq_exp]
  have hts : (t + s) • D.V_op =
      t • D.V_op + s • D.V_op := by
    exact add_smul t s D.V_op
  rw [hts]
  have hcomm : Commute (t • D.V_op) (s • D.V_op) := by
    exact (Commute.refl D.V_op).smul_left t |>.smul_right s
  calc
    NormedSpace.exp (t • D.V_op + s • D.V_op) =
        NormedSpace.exp (t • D.V_op) * NormedSpace.exp (s • D.V_op) :=
      NormedSpace.exp_add_of_commute hcomm
    _ = (NormedSpace.exp (t • D.V_op)).comp
        (NormedSpace.exp (s • D.V_op)) := by
      ext v
      rfl

theorem hestenes_flow_zero (D : HestenesModularDatum (M := M)) :
    D.Delta_real 0 = ContinuousLinearMap.id ℝ M := by
  rw [D.flow_eq_exp]
  simp only [zero_smul]
  rw [NormedSpace.exp_zero]
  ext v
  rfl

theorem hestenes_flow_nat_mul
    (D : HestenesModularDatum (M := M)) (u : ℝ) (k : ℕ) :
    D.Delta_real ((k : ℝ) * u) = (D.Delta_real u) ^ k := by
  induction k with
  | zero =>
      simp only [Nat.cast_zero, zero_mul, pow_zero]
      rw [hestenes_flow_zero D]
      ext v
      rfl
  | succ k ih =>
      have hscalar : ((Nat.succ k : ℕ) : ℝ) * u =
          (k : ℝ) * u + u := by
        push_cast
        ring
      rw [hscalar, hestenes_flow_add D, ih, pow_succ]
      rfl

/-- The modular flow sampled at the logarithmic scale of a positive natural. -/
noncomputable def hestenesLogScaleSample
    (D : HestenesModularDatum (M := M)) (n : ℕ) : EndM :=
  D.Delta_real (Real.log (n : ℝ))

theorem hestenesLogScaleSample_mul
    (D : HestenesModularDatum (M := M))
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    hestenesLogScaleSample D (m * n) =
      hestenesLogScaleSample D m ∘L hestenesLogScaleSample D n := by
  unfold hestenesLogScaleSample
  rw [show ((m * n : ℕ) : ℝ) = (m : ℝ) * (n : ℝ) by norm_num]
  rw [Real.log_mul (by positivity) (by positivity)]
  exact hestenes_flow_add D _ _

theorem hestenesLogScaleSample_pow
    (D : HestenesModularDatum (M := M))
    (n k : ℕ) :
    hestenesLogScaleSample D (n ^ k) =
      (hestenesLogScaleSample D n) ^ k := by
  unfold hestenesLogScaleSample
  rw [show ((n ^ k : ℕ) : ℝ) = (n : ℝ) ^ k by norm_num]
  rw [Real.log_pow]
  exact hestenes_flow_nat_mul D (Real.log (n : ℝ)) k

end

end InfoGeometry.Canonical.HestenesModularRealizationBridge
