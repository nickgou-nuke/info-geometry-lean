+      variableExteriorDerivativeAt s u v = 0 ∧
+      variableCartanCurvatureAt s u v = 0 := by
+  exact ⟨omegaCoeff_eq_dlog01 hs,
+    hasDerivAt_omegaCoeff hs,
+    variableExteriorDerivativeAt_eq_zero s u v,
+    variableCartanMaurerCartan s u v⟩
