import InfoGeometry.Krein.DoubledSpace
import InfoGeometry.Clifford.Grading

/-!
# InfoGeometry.Krein.Superphysics

Algebraic supercharge generators and supersymmetric Hamiltonian structures
on doubled information spaces.

This implementation is strictly algebraic, avoiding coordinate-based L2 proofs
to ensure performance and generality across general Hilbert spaces.
-/

namespace InfoGeometry.Krein

open InfoGeometry.Cartan

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- Algebraic supercharge package: odd generator and its square Hamiltonian. -/
structure Supercharge where
  Q : DoubledSpace E →L[ℝ] DoubledSpace E
  odd : isOdd Q

/-- Algebraic square of a supercharge. -/
abbrev superSquare (S : Supercharge (E := E)) :
    DoubledSpace E →L[ℝ] DoubledSpace E :=
  S.Q.comp S.Q

/-- The Hamiltonian generated by a supercharge. -/
def superHamiltonian (S : Supercharge (E := E)) :
    DoubledSpace E →L[ℝ] DoubledSpace E :=
  superSquare S

omit [CompleteSpace E] in
/-- Supersymmetric Hamiltonians are always grade-preserving (even). -/
lemma superHamiltonian_isEven (S : Supercharge (E := E)) :
    isEven (superHamiltonian S) := by
  simp only [isEven, superHamiltonian, superSquare]
  calc
    modular_j.comp (S.Q.comp S.Q)
        = (modular_j.comp S.Q).comp S.Q := by rw [ContinuousLinearMap.comp_assoc]
      _ = (-(S.Q.comp modular_j)).comp S.Q := by rw [S.odd]
      _ = -(S.Q.comp (modular_j.comp S.Q)) := by simp [ContinuousLinearMap.comp_assoc]
      _ = -(S.Q.comp (-(S.Q.comp modular_j))) := by rw [S.odd]
      _ = (S.Q.comp S.Q).comp modular_j := by simp [ContinuousLinearMap.comp_assoc]

omit [CompleteSpace E] in
lemma supercharge_maps_plus_to_minus
    (S : Supercharge (E := E))
    {v : DoubledSpace E}
    (hv : inGradePlus v) :
    inGradeMinus (S.Q v) := by
  simp only [inGradePlus] at hv
  simp only [inGradeMinus]
  have h := congrArg (fun T : DoubledSpace E →L[ℝ] DoubledSpace E => T v) S.odd
  simpa [ContinuousLinearMap.comp_apply, hv] using h

omit [CompleteSpace E] in
lemma supercharge_maps_minus_to_plus
    (S : Supercharge (E := E))
    {v : DoubledSpace E}
    (hv : inGradeMinus v) :
    inGradePlus (S.Q v) := by
  simp only [inGradeMinus] at hv
  simp only [inGradePlus]
  have h := congrArg (fun T : DoubledSpace E →L[ℝ] DoubledSpace E => T v) S.odd
  simpa [ContinuousLinearMap.comp_apply, hv] using h

omit [CompleteSpace E] in
lemma superHamiltonian_maps_plus_to_plus
    (S : Supercharge (E := E))
    {v : DoubledSpace E}
    (hv : inGradePlus v) :
    inGradePlus ((superHamiltonian S) v) := by
  apply supercharge_maps_minus_to_plus
  apply supercharge_maps_plus_to_minus
  exact hv

omit [CompleteSpace E] in
lemma superHamiltonian_maps_minus_to_minus
    (S : Supercharge (E := E))
    {v : DoubledSpace E}
    (hv : inGradeMinus v) :
    inGradeMinus ((superHamiltonian S) v) := by
  apply supercharge_maps_plus_to_minus
  apply supercharge_maps_minus_to_plus
  exact hv

/-- Canonical supercharge generated by the spectral sign `ε`. -/
noncomputable def epsilonSupercharge : Supercharge (E := E) where
  Q := spectral_epsilon
  odd := spectral_epsilon_isOdd

lemma epsilonSupercharge_hamiltonian :
    superHamiltonian (epsilonSupercharge (E := E))
      = ContinuousLinearMap.id ℝ (DoubledSpace E) :=
  spectral_epsilon_involution E

/-- Canonical supercharge generated by the complex structure `I = J ∘ ε`. -/
noncomputable def complex_i_isOdd :
    isOdd (complex_i (E := E)) := by
  simp only [isOdd]
  rw [modular_j_comp_complex_i (E := E), complex_i_comp_modular_j (E := E)]
  simp

noncomputable def complex_iSupercharge : Supercharge (E := E) where
  Q := complex_i
  odd := complex_i_isOdd

lemma complex_iSupercharge_hamiltonian :
    superHamiltonian (complex_iSupercharge (E := E))
      = -(ContinuousLinearMap.id ℝ (DoubledSpace E)) :=
  complex_i_sq E

end InfoGeometry.Krein
