      dotProduct archiveCycleFlow
        ((incidenceTranspose archiveCycleSource archiveCycleTarget).mulVec potential) =
          0 := by
    apply (archiveCycle_edgeWeight_exact_iff_cyclePairing_zero _).mp
    refine ⟨potential, ?_⟩
    intro edge
    rw [incidenceTranspose_mulVec_apply]
  funext edge
  change (dotProduct archiveCycleFlow
    ((incidenceTranspose archiveCycleSource archiveCycleTarget).mulVec potential) / 4) *
      archiveCycleFlow edge = 0
  rw [hPairing]
  simp

/-- Subtracting the cycle projection from any edge weighting leaves an exact
cochain, so the orthogonal complement is precisely the potential-difference
subspace on this four-edge carrier. -/
theorem archiveCycle_projection_complement_is_exact
    (weight : Fin 4 → ℝ) :
    ∃ potential : Fin 4 → ℝ,
      (fun edge => weight edge - archiveCycleProjection weight edge) =
        (incidenceTranspose archiveCycleSource archiveCycleTarget).mulVec potential := by
  have hPairing :
      dotProduct archiveCycleFlow
        (fun edge => weight edge - archiveCycleProjection weight edge) = 0 := by
    change dotProduct archiveCycleFlow
      (weight - archiveCycleProjection weight) = 0
    rw [dotProduct_sub, archiveCycleProjection_pairing, sub_self]
  obtain ⟨potential, hPotential⟩ :=
    (archiveCycle_edgeWeight_exact_iff_cyclePairing_zero
      (fun edge => weight edge - archiveCycleProjection weight edge)).mpr hPairing
  refine ⟨potential, ?_⟩
  funext edge
  rw [incidenceTranspose_mulVec_apply]
  have h := hPotential edge
  linarith

/-- Canonical direct-sum decomposition of an archive-cycle edge cochain into
an exact potential difference and its orthogonal cycle projection. -/
theorem archiveCycle_hodge_projection_decomposition
    (weight : Fin 4 → ℝ) :
    ∃ potential : Fin 4 → ℝ,
      weight = fun edge =>
        (incidenceTranspose archiveCycleSource archiveCycleTarget).mulVec
          potential edge + archiveCycleProjection weight edge := by
  obtain ⟨potential, hPotential⟩ :=
    archiveCycle_projection_complement_is_exact weight
  refine ⟨potential, ?_⟩
  funext edge
  have h := congrFun hPotential edge
  linarith

/-- The exact residual after orthogonal cycle projection is orthogonal to
the projected cycle component. -/
theorem archiveCycle_projection_residual_orthogonal (weight : Fin 4 → ℝ) :
    dotProduct
      (fun edge => weight edge - archiveCycleProjection weight edge)
      (archiveCycleProjection weight) = 0 := by
  let residual : Fin 4 → ℝ := fun edge =>
    weight edge - archiveCycleProjection weight edge
  have hPairing : dotProduct archiveCycleFlow residual = 0 := by
    change dotProduct archiveCycleFlow
      (weight - archiveCycleProjection weight) = 0
    rw [dotProduct_sub, archiveCycleProjection_pairing, sub_self]
  change dotProduct residual (archiveCycleProjection weight) = 0
  rw [dotProduct_comm]
  change dotProduct
      ((dotProduct archiveCycleFlow weight / 4) • archiveCycleFlow) residual = 0
  rw [smul_dotProduct, hPairing]
  simp

/-- The squared edge-weight norm splits as the sum of the squared norms of
the exact residual and the projected archive cycle. -/
theorem archiveCycle_hodge_pythagorean (weight : Fin 4 → ℝ) :
    dotProduct weight weight =
      dotProduct
          (fun edge => weight edge - archiveCycleProjection weight edge)
          (fun edge => weight edge - archiveCycleProjection weight edge) +
        dotProduct (archiveCycleProjection weight) (archiveCycleProjection weight) := by
  let residual : Fin 4 → ℝ := fun edge =>
    weight edge - archiveCycleProjection weight edge
  have hSplit : weight = residual + archiveCycleProjection weight := by
    funext edge
    simp [residual]
  have hOrth : dotProduct residual (archiveCycleProjection weight) = 0 :=
    archiveCycle_projection_residual_orthogonal weight
  have hOrthSymm : dotProduct (archiveCycleProjection weight) residual = 0 := by
    rw [dotProduct_comm]
    exact hOrth
  calc
    dotProduct weight weight =
        dotProduct (residual + archiveCycleProjection weight)
          (residual + archiveCycleProjection weight) :=
      congrArg₂ dotProduct hSplit hSplit
    _ = dotProduct residual residual +
        dotProduct (archiveCycleProjection weight) (archiveCycleProjection weight) := by
      simp only [add_dotProduct, dotProduct_add]
      rw [hOrth, hOrthSymm]
      ring

/-- Filling the chosen archive cycle gives face coboundary four times the
unit face coordinate, the squared norm of its signed boundary vector. -/
theorem archiveCycleFace_coboundary_on_flow :
    archiveCycleFaceBoundary.transpose.mulVec archiveCycleFlow = fun _ => 4 := by
  classical
  funext face
  fin_cases face
  simp [archiveCycleFaceBoundary, Matrix.mulVec, dotProduct,
    archiveCycleFlow, Fin.sum_univ_succ]
  norm_num

/-- The face-boundary contribution to the edge Hodge operator is four times
the orthogonal projection onto the archived cycle line. -/
theorem archiveCycle_faceLaplacian_eq_four_projection
    (weight : Fin 4 → ℝ) :
    archiveCycleFaceBoundary.mulVec
      (archiveCycleFaceBoundary.transpose.mulVec weight) =
        fun edge => 4 * archiveCycleProjection weight edge := by
  classical
  funext edge
  simp [archiveCycleFaceBoundary, archiveCycleProjection,
    Matrix.mulVec, dotProduct, archiveCycleFlow, Fin.sum_univ_succ]
  ring

/-- After choosing the archived circulation as a 2-cell boundary, the
edge Hodge operator acts on it by four. Thus this particular flow is harmonic
in the unfilled graph but is not harmonic in the chosen filled complex. -/
theorem archiveCycle_filled_laplacian_on_flow :
    graphOneLaplacianWithFaces
      (incidenceTranspose archiveCycleSource archiveCycleTarget)
      archiveCycleFaceBoundary archiveCycleFlow =
        fun edge => 4 * archiveCycleFlow edge := by
  have hCycle := archiveCycleFlow_zero_boundary
  have hFace := archiveCycleFace_coboundary_on_flow
  unfold graphOneLaplacianWithFaces
  rw [hCycle]
  simp only [Matrix.mulVec_zero, zero_add]
  rw [hFace]
  funext edge
  simp [archiveCycleFaceBoundary, Matrix.mulVec, dotProduct,
    archiveCycleFlow]
  ring

/-- The full filled Hodge Laplacian has eigenvalue four on the entire
projected archive-cycle line, not only on the chosen generator. -/
theorem archiveCycle_filled_laplacian_on_projection
    (weight : Fin 4 → ℝ) :
    graphOneLaplacianWithFaces
      (incidenceTranspose archiveCycleSource archiveCycleTarget)
      archiveCycleFaceBoundary (archiveCycleProjection weight) =
        fun edge => 4 * archiveCycleProjection weight edge := by
  let coefficient : ℝ := dotProduct archiveCycleFlow weight / 4
  have hProjection : archiveCycleProjection weight =
      fun edge => coefficient * archiveCycleFlow edge := rfl
  rw [hProjection, graphOneLaplacianWithFaces_smul]
  rw [archiveCycle_filled_laplacian_on_flow]
  funext edge
  simp [coefficient]
  ring

/-- The selected face filling removes the archive circulation from the
harmonic subspace: its filled edge Laplacian is nonzero on that flow. -/
theorem archiveCycle_filled_flow_not_harmonic :
    graphOneLaplacianWithFaces
      (incidenceTranspose archiveCycleSource archiveCycleTarget)
      archiveCycleFaceBoundary archiveCycleFlow ≠ 0 := by
  rw [archiveCycle_filled_laplacian_on_flow]
  intro hZero
  have hAtZero := congrFun hZero 0
  norm_num [archiveCycleFlow] at hAtZero

/-- The chosen face filling removes every harmonic 1-form of the unfilled
archive graph: the only such forms are cycle multiples, and the face term
acts by four on that line. -/
theorem archiveCycle_filling_kills_harmonic_flow (flow : Fin 4 → ℝ)
    (hHarmonic :
      hodgeLaplacian
        (incidenceTranspose archiveCycleSource archiveCycleTarget) (0, flow) = 0)
    (hFilled :
      graphOneLaplacianWithFaces
        (incidenceTranspose archiveCycleSource archiveCycleTarget)
        archiveCycleFaceBoundary flow = 0) :
    flow = 0 := by
  obtain ⟨c, hFlow⟩ :=
    archiveCycle_harmonic_flow_iff_cycle_multiple flow |>.mp hHarmonic
  rw [hFlow, graphOneLaplacianWithFaces_smul,
    archiveCycle_filled_laplacian_on_flow] at hFilled
  have hAtZero := congrFun hFilled 0
  have hc : c = 0 := by
    norm_num [archiveCycleFlow] at hAtZero
    linarith
  funext edge
  rw [hFlow, hc]
  simp

/-- The archived directed parent relation is acyclic, while the signed
circulation is a nonzero harmonic 1-form in the unfilled incidence complex. -/
theorem archiveCycle_dag_with_harmonic_flow :
    archiveCycleMergeParents.parents.size = 2 ∧
    archiveCycleRootRef ≠ archiveCycleMiddleRef ∧
    (∀ edge : Fin 4,
      archiveCycleLink edge ∈ orderedCommitParentLinks archiveCycleParentRecords) ∧
    (∀ edge : Fin 4,
      archiveCycleSource edge =
          (archiveCycleLink edge).src.topologicalIndex ∧
        archiveCycleTarget edge =
          (archiveCycleLink edge).dst.topologicalIndex) ∧
    WellFounded (exportedFiniteParentStep archiveCycleLink) ∧
    archiveCycleFlow ≠ 0 ∧
    graphDifferential archiveCycleSource archiveCycleTarget
      (0, archiveCycleFlow) = 0 ∧
    graphCodifferential archiveCycleSource archiveCycleTarget
      (0, archiveCycleFlow) = 0 ∧
    hodgeLaplacian (incidenceTranspose archiveCycleSource archiveCycleTarget)
      (0, archiveCycleFlow) = 0 ∧
    graphOneLaplacianWithFaces
      (incidenceTranspose archiveCycleSource archiveCycleTarget)
      archiveCycleFaceBoundary archiveCycleFlow ≠ 0 := by
  rcases archiveCycle_is_two_parent_merge_cycle with
    ⟨hParentCount, _, _, hDistinct, _, _, _, _, _, _, _, _, _, _, _⟩
  refine ⟨hParentCount, hDistinct,
    archiveCycle_links_have_parent_provenance,
    archiveCycle_incidence_endpoints_match_parent_links,
    archiveCycle_parentGraph_wellFounded, ?_, ?_, ?_, ?_, ?_⟩
  · intro hZero
    have hAtZero := congrFun hZero 0
    norm_num [archiveCycleFlow] at hAtZero
  · exact (zero_boundary_flow_is_harmonic archiveCycleSource
      archiveCycleTarget archiveCycleFlow archiveCycleFlow_zero_boundary).1
  · exact (zero_boundary_flow_is_harmonic archiveCycleSource
      archiveCycleTarget archiveCycleFlow archiveCycleFlow_zero_boundary).2.1
  · exact (zero_boundary_flow_is_harmonic archiveCycleSource
      archiveCycleTarget archiveCycleFlow archiveCycleFlow_zero_boundary).2.2
  · exact archiveCycle_filled_flow_not_harmonic

end InfoGeometry.Graph.FiniteDirectedGraphHodge
