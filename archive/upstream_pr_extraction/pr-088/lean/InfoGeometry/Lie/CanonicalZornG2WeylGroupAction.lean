import InfoGeometry.Lie.CanonicalZornG2CartanConcreteReflectionEquiv
import InfoGeometry.Lie.CanonicalZornG2CartanParameterCoordinates
import InfoGeometry.Lie.CanonicalZornCartanRootReflections

/-!
# The concrete finite G₂ Weyl action on the Cartan and parameter carriers

The native short and long reflections are already proved as involutive linear
equivalences.  This owner forms the subgroup generated by the paired Cartan
and contragredient parameter generators.  It therefore supplies a genuine
Weyl-group action without introducing a free symbolic group or claiming that
the native adjoint root pairing has already been packaged as a Mathlib
`RootPairing`.
-/

noncomputable section

namespace InfoGeometry.Lie.CanonicalZornG2WeylGroupAction

open InfoGeometry.Lie.CanonicalZornG2CartanConcreteReflectionEquiv
open InfoGeometry.Lie.CanonicalZornG2CartanMellinWeylBridge
open InfoGeometry.Lie.CanonicalZornG2CartanWeylEquivariant
open InfoGeometry.Lie.CanonicalZornG2CartanParameterCoordinates
open InfoGeometry.Lie.CanonicalZornCartanRootReflections
open InfoGeometry.Lie.SplitOctonionAxialCartanErlangen


abbrev Cartan := CanonicalZornG2CartanConcreteReflectionEquiv.Cartan
abbrev Parameter := CanonicalZornG2CartanConcreteReflectionEquiv.Parameter
abbrev Generator := (Cartan ≃ₗ[ℝ] Cartan) × (Parameter ≃ₗ[ℝ] Parameter)

def cartanCoordinates : Cartan ≃ₗ[ℝ] Parameter :=
  (cartanToTraceless.trans tracelessWeightEquiv.symm).trans change

def cartanEquivToParameterEquiv (E : Cartan ≃ₗ[ℝ] Cartan) :
    Parameter ≃ₗ[ℝ] Parameter :=
  cartanCoordinates.symm.trans (E.trans cartanCoordinates)

def cartanParameterTransport :
    (Cartan ≃ₗ[ℝ] Cartan) →* (Parameter ≃ₗ[ℝ] Parameter) where
  toFun := cartanEquivToParameterEquiv
  map_one' := by
    apply LinearEquiv.ext
    intro x
    simp [cartanEquivToParameterEquiv]
  map_mul' := by
    intro E F
    apply LinearEquiv.ext
    intro x
    simp [cartanEquivToParameterEquiv, LinearEquiv.trans_apply]

def shortGenerator : Generator :=
  (canonicalShortReflectionEquiv, canonicalShortParameterDualEquiv)

def longGenerator : Generator :=
  (canonicalLongReflectionEquiv, canonicalLongParameterDualEquiv)

theorem cartanEquivToParameterEquiv_short :
    cartanEquivToParameterEquiv canonicalShortReflectionEquiv =
      canonicalShortParameterDualEquiv := by
  apply LinearEquiv.ext
  intro s
  funext i
  fin_cases i <;>
    simp [cartanEquivToParameterEquiv, cartanCoordinates,
      canonicalShortReflectionEquiv_apply, canonicalShortReflection,
      shortReflectionOnCartan, shortReflection, LinearMap.comp_apply,
      tracelessWeightEquiv, canonicalShortReflectionDualReal,
      change_symm_apply] <;> ring

theorem cartanEquivToParameterEquiv_long :
    cartanEquivToParameterEquiv canonicalLongReflectionEquiv =
      canonicalLongParameterDualEquiv := by
  apply LinearEquiv.ext
  intro s
  funext i
  fin_cases i <;>
    simp [cartanEquivToParameterEquiv, cartanCoordinates,
      canonicalLongReflectionEquiv_apply, canonicalLongReflection,
      longReflectionOnCartan, longReflection, LinearMap.comp_apply,
      tracelessWeightEquiv, canonicalLongReflectionDualReal,
      change_symm_apply] <;> ring

theorem cartanParameterTransport_short :
    cartanParameterTransport canonicalShortReflectionEquiv =
      canonicalShortParameterDualEquiv := by
  exact cartanEquivToParameterEquiv_short

theorem cartanParameterTransport_long :
    cartanParameterTransport canonicalLongReflectionEquiv =
      canonicalLongParameterDualEquiv := by
  exact cartanEquivToParameterEquiv_long

def WeylGroup : Subgroup Generator :=
  Subgroup.closure ({shortGenerator, longGenerator} : Set Generator)

theorem pairedGenerator_dual_compatibility (w : WeylGroup) :
    w.1.2 = cartanParameterTransport w.1.1 := by
  refine Subgroup.closure_induction ?_ ?_ ?_ ?_ w.2
  · intro g hg
    rcases hg with rfl | rfl
    · exact cartanParameterTransport_short.symm
    · exact cartanParameterTransport_long.symm
  · apply LinearEquiv.ext
    intro x
    simp [cartanParameterTransport, cartanEquivToParameterEquiv]
  · intro g h _ _ hg hh
    change g.2 * h.2 = cartanParameterTransport (g.1 * h.1)
    rw [hg, hh, map_mul]
  · intro g _ hg
    change g.2⁻¹ = cartanParameterTransport g.1⁻¹
    rw [hg, map_inv]

def cartanAction : WeylGroup →* Cartan ≃ₗ[ℝ] Cartan where
  toFun w := w.1.1
  map_one' := rfl
  map_mul' := by intros; rfl

def parameterTransport : WeylGroup →* Parameter ≃ₗ[ℝ] Parameter where
  toFun w := w.1.2
  map_one' := rfl
  map_mul' := by intros; rfl

theorem cartanAction_injective : Function.Injective cartanAction := by
  intro w v h
  apply Subtype.ext
  apply Prod.ext
  · exact h
  · change w.1.1 = v.1.1 at h
    change w.1.2 = v.1.2
    rw [pairedGenerator_dual_compatibility w,
      pairedGenerator_dual_compatibility v, h]

def cartanActionRange : Subgroup (Cartan ≃ₗ[ℝ] Cartan) :=
  MonoidHom.range cartanAction

def cartanActionRangeHom : WeylGroup →* cartanActionRange :=
  cartanAction.codRestrict cartanActionRange (fun w => ⟨w, rfl⟩)

theorem cartanActionRangeHom_injective :
    Function.Injective cartanActionRangeHom := by
  intro w v h
  apply cartanAction_injective
  exact congrArg Subtype.val h

theorem cartanActionRangeHom_surjective :
    Function.Surjective cartanActionRangeHom := by
  intro w
  rcases w.property with ⟨v, hv⟩
  refine ⟨v, ?_⟩
  apply Subtype.ext
  exact hv

noncomputable def cartanActionRangeMulEquiv :
    WeylGroup ≃* cartanActionRange :=
  MulEquiv.ofBijective cartanActionRangeHom
    ⟨cartanActionRangeHom_injective, cartanActionRangeHom_surjective⟩

@[simp] theorem cartanAction_apply (w : WeylGroup) :
    cartanAction w = w.1.1 := rfl

@[simp] theorem parameterTransport_apply (w : WeylGroup) :
    parameterTransport w = w.1.2 := rfl

theorem shortGenerator_mem : shortGenerator ∈ WeylGroup := by
  exact Subgroup.subset_closure (by simp [shortGenerator])

theorem longGenerator_mem : longGenerator ∈ WeylGroup := by
  exact Subgroup.subset_closure (by simp [longGenerator])

theorem shortGenerator_sq :
    (⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) ^ 2 = 1 := by
  apply Subtype.ext
  change (shortGenerator ^ 2) = 1
  apply Prod.ext
  · apply LinearEquiv.ext
    intro x
    exact canonicalShortReflection_involutive x
  · exact canonicalShortParameterDualEquiv_sq

theorem longGenerator_sq :
    (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) ^ 2 = 1 := by
  apply Subtype.ext
  change (longGenerator ^ 2) = 1
  apply Prod.ext
  · apply LinearEquiv.ext
    intro x
    exact canonicalLongReflection_involutive x
  · exact canonicalLongParameterDualEquiv_sq

@[simp] theorem cartanAction_shortGenerator :
    cartanAction ⟨shortGenerator, shortGenerator_mem⟩ =
      canonicalShortReflectionEquiv := rfl

@[simp] theorem cartanAction_longGenerator :
    cartanAction ⟨longGenerator, longGenerator_mem⟩ =
      canonicalLongReflectionEquiv := rfl

@[simp] theorem parameterTransport_shortGenerator :
    parameterTransport ⟨shortGenerator, shortGenerator_mem⟩ =
      canonicalShortParameterDualEquiv := rfl

@[simp] theorem parameterTransport_longGenerator :
    parameterTransport ⟨longGenerator, longGenerator_mem⟩ =
      canonicalLongParameterDualEquiv := rfl

theorem cartanAction_simpleProduct_order_six :
    (cartanAction
      (⟨shortGenerator, shortGenerator_mem⟩ *
        ⟨longGenerator, longGenerator_mem⟩)) ^ 6 = 1 := by
  rw [map_mul]
  apply LinearEquiv.ext
  intro x
  apply LinearEquiv.injective cartanToTraceless
  have h := congrArg (fun f : (TracelessWeight →ₗ[ℝ] TracelessWeight) =>
      f (cartanToTraceless x)) nativeCartanReflectionsOnCartan_order_six
  simpa [canonicalShortReflectionEquiv, canonicalLongReflectionEquiv,
    canonicalShortReflection, canonicalLongReflection,
    shortGenerator, longGenerator,
    LinearEquiv.mul_apply, LinearMap.comp_apply, pow_succ] using h

theorem parameterTransport_simpleProduct_order_six :
    (parameterTransport
      (⟨shortGenerator, shortGenerator_mem⟩ *
        ⟨longGenerator, longGenerator_mem⟩)) ^ 6 = 1 := by
  rw [map_mul]
  exact canonicalParameterDualEquiv_order_six

theorem simpleProduct_order_six :
    ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
      ⟨longGenerator, longGenerator_mem⟩) ^ 6 = 1 := by
  apply Subtype.ext
  apply Prod.ext
  · exact cartanAction_simpleProduct_order_six
  · exact parameterTransport_simpleProduct_order_six

theorem cartanActionRange_simpleProduct_order_six :
    (cartanActionRangeHom
      ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
        ⟨longGenerator, longGenerator_mem⟩)) ^ 6 = 1 := by
  apply Subtype.ext
  exact cartanAction_simpleProduct_order_six

def simpleProductPower (i : ZMod 6) : WeylGroup :=
  ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
    ⟨longGenerator, longGenerator_mem⟩) ^ i.val

theorem simpleProductPower_add (i j : ZMod 6) :
    simpleProductPower (i + j) = simpleProductPower i * simpleProductPower j := by
  have hmod : (i + j).val ≡ i.val + j.val [MOD 6] := by
    simp [Nat.ModEq, ZMod.val_add, Nat.add_mod]
  simpa [simpleProductPower, pow_add] using
    (pow_eq_pow_of_modEq hmod simpleProduct_order_six)

theorem shortGenerator_conjugates_simpleProduct :
    (⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
        ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
          ⟨longGenerator, longGenerator_mem⟩) *
        ⟨shortGenerator, shortGenerator_mem⟩ =
      ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
        ⟨longGenerator, longGenerator_mem⟩)⁻¹ := by
  calc
    (⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
        ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
          ⟨longGenerator, longGenerator_mem⟩) *
        ⟨shortGenerator, shortGenerator_mem⟩ =
      (⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
        ⟨shortGenerator, shortGenerator_mem⟩ *
        (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
        ⟨shortGenerator, shortGenerator_mem⟩ := by simp only [mul_assoc]
    _ = (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
        ⟨shortGenerator, shortGenerator_mem⟩ := by
      calc
        (⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
            ⟨shortGenerator, shortGenerator_mem⟩ *
            (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
            ⟨shortGenerator, shortGenerator_mem⟩ =
          ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
            ⟨shortGenerator, shortGenerator_mem⟩) *
            ((⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
              ⟨shortGenerator, shortGenerator_mem⟩) := by
                simp only [mul_assoc]
        _ = (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
            ⟨shortGenerator, shortGenerator_mem⟩ := by
              calc
                (⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
                    ⟨shortGenerator, shortGenerator_mem⟩ *
                    (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
                    ⟨shortGenerator, shortGenerator_mem⟩ =
                  ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
                    ⟨shortGenerator, shortGenerator_mem⟩) *
                    ((⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
                      ⟨shortGenerator, shortGenerator_mem⟩) := by
                        simp only [mul_assoc]
                _ = _ := by
                  rw [show (⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
                      ⟨shortGenerator, shortGenerator_mem⟩ = 1 by
                        simpa [pow_two] using shortGenerator_sq]
                  simp
    _ = ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
        ⟨longGenerator, longGenerator_mem⟩)⁻¹ := by
      apply (eq_inv_iff_mul_eq_one).2
      calc
        ((⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
          ⟨shortGenerator, shortGenerator_mem⟩) *
            (⟨shortGenerator, shortGenerator_mem⟩ *
              ⟨longGenerator, longGenerator_mem⟩) =
          (⟨longGenerator, longGenerator_mem⟩ *
            ⟨shortGenerator, shortGenerator_mem⟩ *
              ⟨shortGenerator, shortGenerator_mem⟩) *
            ⟨longGenerator, longGenerator_mem⟩ := by simp only [mul_assoc]
        _ = 1 := by
          calc
            (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
                ⟨shortGenerator, shortGenerator_mem⟩ *
                ⟨shortGenerator, shortGenerator_mem⟩ *
                ⟨longGenerator, longGenerator_mem⟩ =
              (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
                (⟨shortGenerator, shortGenerator_mem⟩ *
                  ⟨shortGenerator, shortGenerator_mem⟩) *
                ⟨longGenerator, longGenerator_mem⟩ := by
                  simp only [mul_assoc]
            _ = 1 := by
              rw [show (⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
                  ⟨shortGenerator, shortGenerator_mem⟩ = 1 by
                    simpa [pow_two] using shortGenerator_sq]
              simpa only [pow_two, mul_one, one_mul] using
                congrArg Subtype.val longGenerator_sq

theorem longGenerator_conjugates_simpleProduct :
    (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
        ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
          ⟨longGenerator, longGenerator_mem⟩) *
        ⟨longGenerator, longGenerator_mem⟩ =
      ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
        ⟨longGenerator, longGenerator_mem⟩)⁻¹ := by
  calc
    (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
        ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
          ⟨longGenerator, longGenerator_mem⟩) *
        ⟨longGenerator, longGenerator_mem⟩ =
      (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
        ⟨shortGenerator, shortGenerator_mem⟩ *
        (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
        ⟨longGenerator, longGenerator_mem⟩ := by simp only [mul_assoc]
    _ = (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
        ⟨shortGenerator, shortGenerator_mem⟩ := by
      calc
        (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
            ⟨shortGenerator, shortGenerator_mem⟩ *
            (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
            ⟨longGenerator, longGenerator_mem⟩ =
          ((⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
            ⟨shortGenerator, shortGenerator_mem⟩) *
            ((⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
              ⟨longGenerator, longGenerator_mem⟩) := by
                simp only [mul_assoc]
        _ = _ := by
          rw [show (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
              ⟨longGenerator, longGenerator_mem⟩ = 1 by
                simpa [pow_two] using longGenerator_sq]
          simp
    _ = ((⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
        ⟨longGenerator, longGenerator_mem⟩)⁻¹ := by
      apply (eq_inv_iff_mul_eq_one).2
      calc
        ((⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
          ⟨shortGenerator, shortGenerator_mem⟩) *
            (⟨shortGenerator, shortGenerator_mem⟩ *
              ⟨longGenerator, longGenerator_mem⟩) =
          (⟨longGenerator, longGenerator_mem⟩ *
            ⟨shortGenerator, shortGenerator_mem⟩ *
              ⟨shortGenerator, shortGenerator_mem⟩) *
            ⟨longGenerator, longGenerator_mem⟩ := by simp only [mul_assoc]
        _ = 1 := by
          calc
            (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
                ⟨shortGenerator, shortGenerator_mem⟩ *
                ⟨shortGenerator, shortGenerator_mem⟩ *
                ⟨longGenerator, longGenerator_mem⟩ =
              (⟨longGenerator, longGenerator_mem⟩ : WeylGroup) *
                (⟨shortGenerator, shortGenerator_mem⟩ *
                  ⟨shortGenerator, shortGenerator_mem⟩) *
                ⟨longGenerator, longGenerator_mem⟩ := by
                  simp only [mul_assoc]
            _ = 1 := by
              rw [show (⟨shortGenerator, shortGenerator_mem⟩ : WeylGroup) *
                  ⟨shortGenerator, shortGenerator_mem⟩ = 1 by
                    simpa [pow_two] using shortGenerator_sq]
              simpa only [pow_two, mul_one, one_mul] using
                congrArg Subtype.val longGenerator_sq

end InfoGeometry.Lie.CanonicalZornG2WeylGroupAction
