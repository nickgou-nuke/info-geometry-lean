import GrandPartitionProbability
import Mathlib

noncomputable section

open Finset
open scoped BigOperators

section RobustPoissonLayer

/-- Exact scalar Poisson deviance with the boundary convention
`D(0; μ) = 2μ`. -/
def poissonDeviance (y μ : ℝ) : ℝ :=
  if y = 0 then 2 * μ
  else 2 * (y * Real.log (y / μ) - y + μ)

@[simp]
theorem poissonDeviance_zero (μ : ℝ) :
    poissonDeviance 0 μ = 2 * μ := by
  simp [poissonDeviance]

theorem poissonDeviance_self {μ : ℝ} (hμ : μ ≠ 0) :
    poissonDeviance μ μ = 0 := by
  simp [poissonDeviance, hμ, div_self hμ]

/-- Anscombe variance-stabilizing map used as an optional Euclidean
approximation to the exact Poisson geometry. -/
def anscombe (x : ℝ) : ℝ :=
  2 * Real.sqrt (x + 3 / 8)

/-- Squared Euclidean discrepancy in Anscombe coordinates. -/
def anscombeDeviance (x μ : ℝ) : ℝ :=
  (anscombe x - anscombe μ) ^ 2

theorem anscombeDeviance_nonneg (x μ : ℝ) :
    0 ≤ anscombeDeviance x μ := by
  exact sq_nonneg _

/-- Prior odds interpreted as physical activity. -/
def priorActivity (α : ℝ) : ℝ :=
  α / (1 - α)

/-- Boltzmann factor generated by deviance `d` at temperature `ε`. -/
def boltzmannFactor (ε d : ℝ) : ℝ :=
  Real.exp (-d / ε)

/-- Binary-occupancy Gibbs responsibility. -/
def gibbsResponsibility (α ε d : ℝ) : ℝ :=
  siteResponsibility (priorActivity α) (boltzmannFactor ε d)

theorem boltzmannFactor_pos (ε d : ℝ) :
    0 < boltzmannFactor ε d := by
  exact Real.exp_pos _

theorem priorActivity_nonneg
    {α : ℝ} (hα0 : 0 ≤ α) (hα1 : α < 1) :
    0 ≤ priorActivity α := by
  exact div_nonneg hα0 (sub_nonneg.mpr hα1.le)

theorem gibbsResponsibility_nonneg
    {α ε d : ℝ} (hα0 : 0 ≤ α) (hα1 : α < 1) :
    0 ≤ gibbsResponsibility α ε d := by
  exact siteResponsibility_nonneg
    (priorActivity_nonneg hα0 hα1)
    (boltzmannFactor_pos ε d).le

theorem gibbsResponsibility_le_one
    {α ε d : ℝ} (hα0 : 0 ≤ α) (hα1 : α < 1) :
    gibbsResponsibility α ε d ≤ 1 := by
  exact siteResponsibility_le_one
    (priorActivity_nonneg hα0 hα1)
    (boltzmannFactor_pos ε d).le

/-- Prior-normalized binary partition factor. -/
def binaryPartitionFactor (α ε d : ℝ) : ℝ :=
  (1 - α) + α * boltzmannFactor ε d

/-- Reduced bounded robust loss obtained after eliminating the binary
occupancy variable. -/
def reducedRobustLoss (α ε d : ℝ) : ℝ :=
  -ε * Real.log (binaryPartitionFactor α ε d)

@[simp]
theorem binaryPartitionFactor_zero_deviance (α ε : ℝ) :
    binaryPartitionFactor α ε 0 = 1 := by
  simp [binaryPartitionFactor, boltzmannFactor]

@[simp]
theorem reducedRobustLoss_zero (α ε : ℝ) :
    reducedRobustLoss α ε 0 = 0 := by
  simp [reducedRobustLoss]

/-- Fixed-responsibility weighted Poisson mean. -/
def weightedPoissonMean
    {ι : Type*} [Fintype ι] (r x : ι → ℝ) : ℝ :=
  (∑ i, r i * x i) / ∑ i, r i

/-- Weighted score equation. -/
def weightedPoissonScore
    {ι : Type*} [Fintype ι] (r x : ι → ℝ) (μ : ℝ) : ℝ :=
  ∑ i, r i * (x i - μ)

theorem weightedPoissonScore_eq_zero_at_mean
    {ι : Type*} [Fintype ι]
    (r x : ι → ℝ) (hN : (∑ i, r i) ≠ 0) :
    weightedPoissonScore r x (weightedPoissonMean r x) = 0 := by
  unfold weightedPoissonScore weightedPoissonMean
  simp_rw [mul_sub]
  rw [Finset.sum_sub_distrib, ← Finset.sum_mul]
  field_simp [hN]

/-- The weighted score equation has the unique solution given by the weighted
mean when the total fixed weight is nonzero. -/
theorem weightedPoissonScore_eq_zero_iff
    {ι : Type*} [Fintype ι]
    (r x : ι → ℝ) (μ : ℝ) (hN : (∑ i, r i) ≠ 0) :
    weightedPoissonScore r x μ = 0 ↔
      μ = weightedPoissonMean r x := by
  unfold weightedPoissonScore weightedPoissonMean
  simp_rw [mul_sub]
  rw [Finset.sum_sub_distrib, ← Finset.sum_mul]
  constructor
  · intro h
    apply (eq_div_iff hN).2
    linarith
  · intro h
    rw [h]
    field_simp [hN]

end RobustPoissonLayer
