/-!
# Extremal KKT-style closure and 5-Graded Kantor–Koecher–Tits Lie Poset (`KKT₁`–`KKT₁₀`)

This file proves identities for the extremal sandwich operators generated by
the existing anomaly-first owner and formalizes the 5-graded Kantor–Koecher–Tits
Lie grading (`g_{-2} ⊕ g_{-1} ⊕ g_0 ⊕ g_{+1} ⊕ g_{+2}`) graded by `ad(Σ)` over
any non-commutative star-ring `[Ring B] [StarRing B]`.
-/
namespace InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTits

open InfoGeometry.Core.JordanAssociator
open OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset

variable {B : Type*} [Ring B] [StarRing B]

/-- The unnormalized Jordan associator used by the KKT sandwich generators. -/
def JordanAssoc (X Y Z : B) : B :=
  ((X * Y + Y * X) * Z + Z * (X * Y + Y * X)) -
    (X * (Y * Z + Z * Y) + (Y * Z + Z * Y) * X)

/-- Positive extremal generator, defined by its Jordan associator owner. -/
def K_plus2 (N X : B) : B := JordanAssoc X N N

/-- Negative extremal generator. -/
def K_minus2 (N X : B) : B := JordanAssoc X (star N) (star N)

omit [StarRing B] in
/-- For a square-zero element the Jordan associator is twice the quadratic
triple sandwich. -/
theorem K_plus2_eq_two_sandwich (N X : B) (hN : N * N = 0) :
    K_plus2 N X = 2 • (N * X * N) := by
  dsimp [K_plus2, JordanAssoc]
  rw [InfoGeometry.Core.JordanAssociator.symm_associator_eq_double_commutator]
  have hleft : N * (N * X) = 0 := by rw [← mul_assoc, hN, zero_mul]
  have hright : (X * N) * N = 0 := by rw [mul_assoc, hN, mul_zero]
  have hexpand : N * (X * N - N * X) - (X * N - N * X) * N =
      ((N * X) * N - N * (N * X)) - ((X * N) * N - (N * X) * N) := by
    noncomm_ring
  rw [hexpand, hleft, hright]
  simp only [zero_sub, sub_zero, two_nsmul]
  noncomm_ring

theorem K_minus2_eq_two_sandwich (N X : B) (hN : N * N = 0) :
    K_minus2 N X = 2 • (star N * X * star N) := by
  exact K_plus2_eq_two_sandwich (star N) X
    (by rw [← star_mul, hN, star_zero])

/-- The anomaly grades the positive sandwich with adjoint weight `+2`. -/
theorem comm_Sigma_K_plus2 (N X : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    comm (Sigma N) (K_plus2 N X) = 2 • K_plus2 N X := by
  rw [K_plus2_eq_two_sandwich N X hN]
  dsimp [comm]
  have hL : Sigma N * (N * X * N) = N * X * N := by
    calc Sigma N * (N * X * N)
        = ((Sigma N * N) * X) * N := by noncomm_ring
      _ = (N * X) * N := by rw [Sigma_mul_N_plus N hN hreg]
      _ = N * X * N := rfl
  have hR : (N * X * N) * Sigma N = -(N * X * N) := by
    calc (N * X * N) * Sigma N
        = (N * X) * (N * Sigma N) := by rw [mul_assoc]
      _ = (N * X) * (-N) := by rw [N_plus_mul_Sigma N hN hreg]
      _ = -(N * X * N) := by rw [mul_neg]
  simp only [two_nsmul, mul_add, add_mul, hL, hR]
  noncomm_ring

/-- The anomaly grades the negative sandwich with adjoint weight `-2`. -/
theorem comm_Sigma_K_minus2 (N X : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    comm (Sigma N) (K_minus2 N X) = -((2 : ℕ) • K_minus2 N X) := by
  rw [K_minus2_eq_two_sandwich N X hN]
  dsimp [comm]
  have hL : Sigma N * (star N * X * star N) = -(star N * X * star N) := by
    calc Sigma N * (star N * X * star N)
        = ((Sigma N * star N) * X) * star N := by noncomm_ring
      _ = ((-star N) * X) * star N := by rw [Sigma_mul_star_N_plus N hN hreg]
      _ = -(star N * X * star N) := by rw [neg_mul, neg_mul]
  have hR : (star N * X * star N) * Sigma N = star N * X * star N := by
    calc (star N * X * star N) * Sigma N
        = (star N * X) * (star N * Sigma N) := by rw [mul_assoc]
      _ = (star N * X) * star N := by rw [star_N_plus_mul_Sigma N hN hreg]
      _ = star N * X * star N := rfl
  simp only [two_nsmul, mul_add, add_mul, hL, hR]
  noncomm_ring

omit [StarRing B] in
/-- Same-grade positive sandwiches multiply to zero. -/
theorem sandwich_plus_mul_sandwich_plus (N X Y : B) (hN : N * N = 0) :
    (N * X * N) * (N * Y * N) = 0 := by
  calc (N * X * N) * (N * Y * N)
      = ((N * X) * (N * N)) * (Y * N) := by noncomm_ring
    _ = 0 := by rw [hN, mul_zero, zero_mul]

/-- Same-grade negative sandwiches multiply to zero. -/
theorem sandwich_minus_mul_sandwich_minus (N X Y : B) (hN : N * N = 0) :
    (star N * X * star N) * (star N * Y * star N) = 0 := by
  exact sandwich_plus_mul_sandwich_plus (star N) X Y
    (by rw [← star_mul, hN, star_zero])

omit [StarRing B] in
theorem K_plus2_mul_K_plus2 (N X Y : B) (hN : N * N = 0) :
    K_plus2 N X * K_plus2 N Y = 0 := by
  rw [K_plus2_eq_two_sandwich N X hN, K_plus2_eq_two_sandwich N Y hN]
  simp only [two_nsmul, add_mul, mul_add,
    sandwich_plus_mul_sandwich_plus N X Y hN, add_zero]

theorem K_minus2_mul_K_minus2 (N X Y : B) (hN : N * N = 0) :
    K_minus2 N X * K_minus2 N Y = 0 := by
  rw [K_minus2_eq_two_sandwich N X hN, K_minus2_eq_two_sandwich N Y hN]
  simp only [two_nsmul, add_mul, mul_add,
    sandwich_minus_mul_sandwich_minus N X Y hN, add_zero]

theorem K_plus2_seed (N : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    K_plus2 N (star N) = 2 • N := by
  rw [K_plus2_eq_two_sandwich N (star N) hN, hreg]

theorem K_minus2_seed (N : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    K_minus2 N N = 2 • star N := by
  rw [K_minus2_eq_two_sandwich N N hN]
  have hreg' := star_N_plus_reg N hreg
  rw [hreg']

/-- The positive transition cone selected by the chiral support is exactly
the original nilpotent generator. -/
theorem conePlus_of_regular_nilpotent (N : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    InfoGeometry.OperatorAlgebra.PeirceSpine.conePlus
      (InfoGeometry.OperatorAlgebra.PeirceSpine.YangMillsVortexPoset.P N) N = N := by
  unfold InfoGeometry.OperatorAlgebra.PeirceSpine.conePlus
    InfoGeometry.OperatorAlgebra.PeirceSpine.YangMillsVortexPoset.P
  have hleft : N * star N * N = N := hreg
  have hright : N * (N * star N) = 0 := by
    rw [← mul_assoc, hN, zero_mul]
  rw [hleft]
  calc N * (1 - N * star N)
      = N * 1 - N * (N * star N) := by rw [mul_sub]
    _ = N := by rw [mul_one, hright, sub_zero]

/-- The Jordan-associator extremal generator is twice the established
Kantor–Peirce grade `+2` operator after specializing its transition cone to
the regular nilpotent `N`. -/
theorem K_plus2_eq_two_kantorGp2 (N X : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    K_plus2 N X = 2 •
      InfoGeometry.OperatorAlgebra.PeirceSpine.kantorGp2
        (InfoGeometry.OperatorAlgebra.PeirceSpine.YangMillsVortexPoset.P N) N X := by
  rw [K_plus2_eq_two_sandwich N X hN,
    InfoGeometry.OperatorAlgebra.PeirceSpine.kantorGp2,
    conePlus_of_regular_nilpotent N hN hreg]

end InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTits

namespace InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTitsClosurePoset

open OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset
open InfoGeometry.OperatorAlgebra.PeirceSpine.YangMillsVortexPoset (P Q)

local notation "Sigma" => OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset.Sigma

universe u

/-!
## 1. 10-Stage Kantor–Koecher–Tits 5-Graded Closure Poset (`KantorKoecherTitsStage`)
-/

/-- The 10-stage dependency poset for the 5-graded Kantor–Koecher–Tits Lie algebra
`g_{-2} ⊕ g_{-1} ⊕ g_0 ⊕ g_{+1} ⊕ g_{+2}` generated by a regular nilpotent pair `(N_+, N_-)`
and graded by the adjoint action of the parity anomaly `Σ = [N_+, N_-]`. -/
inductive KantorKoecherTitsStage : Type
  | KKT1_JordanQuadraticTripleSandwich
  | KKT2_ExtremalGradePlusMinusTwo
  | KKT3_ExtremalAbelianNilpotency
  | KKT4_RegularNilpotentSeedFixedPoint
  | KKT5_OddGradePlusMinusOneCarriers
  | KKT6_OddToExtremalBracketClosure
  | KKT7_ExtremalOppositeGradeToZero
  | KKT8_ZeroGradeDiagonalNeutralCentralizer
  | KKT9_ExtremalCommutatorZeroGradeClosure
  | KKT10_MasterFiveGradedKantorKoecherTitsSynthesis
  deriving DecidableEq, Repr

namespace KantorKoecherTitsStage

/-- Monotone integer rank of each stage in `KantorKoecherTitsStage`. -/
def rank : KantorKoecherTitsStage → ℕ
  | .KKT1_JordanQuadraticTripleSandwich => 1
  | .KKT2_ExtremalGradePlusMinusTwo => 2
  | .KKT3_ExtremalAbelianNilpotency => 3
  | .KKT4_RegularNilpotentSeedFixedPoint => 4
  | .KKT5_OddGradePlusMinusOneCarriers => 5
  | .KKT6_OddToExtremalBracketClosure => 6
  | .KKT7_ExtremalOppositeGradeToZero => 7
  | .KKT8_ZeroGradeDiagonalNeutralCentralizer => 8
  | .KKT9_ExtremalCommutatorZeroGradeClosure => 9
  | .KKT10_MasterFiveGradedKantorKoecherTitsSynthesis => 10

theorem rank_injective : Function.Injective rank := by
  intro a b h
  cases a <;> cases b <;> first | rfl | cases h

/-- Causal order relation on `KantorKoecherTitsStage`. -/
def causalEdge (a b : KantorKoecherTitsStage) : Prop :=
  rank a ≤ rank b

instance instDecidableRelCausalEdge : DecidableRel causalEdge :=
  fun a b => Nat.decLe (rank a) (rank b)

instance instLE : LE KantorKoecherTitsStage where
  le := causalEdge

instance instPreorder : Preorder KantorKoecherTitsStage where
  le := causalEdge
  le_refl a := Nat.le_refl (rank a)
  le_trans _ _ _ hab hbc := Nat.le_trans hab hbc

instance instPartialOrder : PartialOrder KantorKoecherTitsStage where
  le_antisymm _ _ hab hba := rank_injective (Nat.le_antisymm hab hba)

instance instDecidableRelLE :
    DecidableRel (fun a b : KantorKoecherTitsStage => a ≤ b) :=
  instDecidableRelCausalEdge

theorem causalEdge_KKT1_KKT2 :
    causalEdge .KKT1_JordanQuadraticTripleSandwich .KKT2_ExtremalGradePlusMinusTwo := by decide
theorem causalEdge_KKT2_KKT3 :
    causalEdge .KKT2_ExtremalGradePlusMinusTwo .KKT3_ExtremalAbelianNilpotency := by decide
theorem causalEdge_KKT3_KKT4 :
    causalEdge .KKT3_ExtremalAbelianNilpotency .KKT4_RegularNilpotentSeedFixedPoint := by decide
theorem causalEdge_KKT4_KKT5 :
    causalEdge .KKT4_RegularNilpotentSeedFixedPoint .KKT5_OddGradePlusMinusOneCarriers := by decide
theorem causalEdge_KKT5_KKT6 :
    causalEdge .KKT5_OddGradePlusMinusOneCarriers .KKT6_OddToExtremalBracketClosure := by decide
theorem causalEdge_KKT6_KKT7 :
    causalEdge .KKT6_OddToExtremalBracketClosure .KKT7_ExtremalOppositeGradeToZero := by decide
theorem causalEdge_KKT7_KKT8 :
    causalEdge .KKT7_ExtremalOppositeGradeToZero .KKT8_ZeroGradeDiagonalNeutralCentralizer := by decide
theorem causalEdge_KKT8_KKT9 :
    causalEdge .KKT8_ZeroGradeDiagonalNeutralCentralizer .KKT9_ExtremalCommutatorZeroGradeClosure := by decide
theorem causalEdge_KKT9_KKT10 :
    causalEdge .KKT9_ExtremalCommutatorZeroGradeClosure
      .KKT10_MasterFiveGradedKantorKoecherTitsSynthesis := by decide

end KantorKoecherTitsStage

/-!
## 2. Pure Ring Helpers (Before `[StarRing B]`)
-/

section RingHelpers

variable {B : Type u} [Ring B]

/-- The unnormalized Jordan associator `{{X, Y}, Z} - {X, {Y, Z}}`. -/
def JordanAssoc (X Y Z : B) : B :=
  ((X * Y + Y * X) * Z + Z * (X * Y + Y * X)) -
  (X * (Y * Z + Z * Y) + (Y * Z + Z * Y) * X)

/-- Positive extremal Jordan triple sandwich `G_{+2}(N_+, X) := N_+ X N_+`. -/
def G_plus2 (N_plus X : B) : B := N_plus * X * N_plus

/-- Positive extremal Jordan associator generator `K_{+2}(N_+, X) := JordanAssoc(X, N_+, N_+)`. -/
def K_plus2 (N_plus X : B) : B := JordanAssoc X N_plus N_plus

/-- Pure ring identity: when `N * N = 0`, `JordanAssoc X N N = (2 : ℕ) • (N * X * N)`. -/
theorem kkt_jordan_assoc_eq_two_sandwich (N X : B) (h_nil : N * N = 0) :
    JordanAssoc X N N = (2 : ℕ) • (N * X * N) := by
  change InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTits.JordanAssoc X N N = _
  exact InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTits.K_plus2_eq_two_sandwich N X h_nil

/-- Pure ring helper: when `S * N = N` and `N * S = -N`, `[S, N * X * N] = 2 • (N * X * N)`. -/
theorem kkt_comm_grading_plus2 (S N X : B)
    (hL : S * N = N) (hR : N * S = -N) :
    comm S (N * X * N) = (2 : ℕ) • (N * X * N) := by
  dsimp [comm]
  have h1 : S * (N * X * N) = N * X * N := by
    calc S * (N * X * N)
        = (S * N) * X * N := by noncomm_ring
      _ = N * X * N := by rw [hL]
  have h2 : (N * X * N) * S = -(N * X * N) := by
    calc (N * X * N) * S
        = (N * X) * (N * S) := by noncomm_ring
      _ = (N * X) * (-N) := by rw [hR]
      _ = -(N * X * N) := by noncomm_ring
  rw [h1, h2, sub_neg_eq_add, two_nsmul]

/-- Pure ring helper: when `S * M = -M` and `M * S = M`, `[S, M * X * M] = -(2 • (M * X * M))`. -/
theorem kkt_comm_grading_minus2 (S M X : B)
    (hL : S * M = -M) (hR : M * S = M) :
    comm S (M * X * M) = -((2 : ℕ) • (M * X * M)) := by
  dsimp [comm]
  have h1 : S * (M * X * M) = -(M * X * M) := by
    calc S * (M * X * M)
        = (S * M) * X * M := by noncomm_ring
      _ = (-M) * X * M := by rw [hL]
      _ = -(M * X * M) := by noncomm_ring
  have h2 : (M * X * M) * S = M * X * M := by
    calc (M * X * M) * S
        = (M * X) * (M * S) := by rw [mul_assoc]
      _ = M * X * M := by rw [hR]
  rw [h1, h2, two_nsmul]
  noncomm_ring

/-- Pure ring helper: `[S, (2 : ℕ) • A] = (2 : ℕ) • [S, A]`. -/
theorem kkt_comm_two_nsmul_right (S A : B) :
    comm S ((2 : ℕ) • A) = (2 : ℕ) • comm S A := by
  dsimp [comm]
  rw [two_nsmul, two_nsmul]
  noncomm_ring

/-- Pure ring helper: `(2 : ℕ) • (-((2 : ℕ) • A)) = -((2 : ℕ) • ((2 : ℕ) • A))`. -/
theorem kkt_two_nsmul_neg (A : B) :
    (2 : ℕ) • (-((2 : ℕ) • A)) = -((2 : ℕ) • ((2 : ℕ) • A)) := by
  rw [two_nsmul, two_nsmul]
  abel

/-- Pure ring helper: `(N * X * N) * (N * Y * N) = 0` when `N * N = 0`. -/
theorem kkt_sandwich_mul_sandwich_zero (N X Y : B) (h_nil : N * N = 0) :
    (N * X * N) * (N * Y * N) = 0 := by
  calc (N * X * N) * (N * Y * N)
      = (N * X) * (N * N) * (Y * N) := by noncomm_ring
    _ = 0 := by rw [h_nil, mul_zero, zero_mul]

/-- Pure ring helper: `((2 : ℕ) • A) * ((2 : ℕ) • C) = 0` when `A * C = 0`. -/
theorem kkt_two_nsmul_mul_two_nsmul_zero (A C : B) (hAC : A * C = 0) :
    ((2 : ℕ) • A) * ((2 : ℕ) • C) = 0 := by
  rw [two_nsmul, two_nsmul]
  calc (A + A) * (C + C)
      = A * C + A * C + A * C + A * C := by noncomm_ring
    _ = 0 := by rw [hAC, add_zero, add_zero, add_zero]

/-- Pure ring helper for left odd grade `+1`: when `S * N = N` and `X * (1 - V) * S = 0`,
`comm S (N * X * (1 - V)) = N * X * (1 - V)`. -/
theorem kkt_comm_odd_plus1_L (S N V X : B)
    (hSN : S * N = N) (hVS : (1 - V) * S = 0) :
    comm S (N * X * (1 - V)) = N * X * (1 - V) := by
  dsimp [comm]
  have h1 : S * (N * X * (1 - V)) = N * X * (1 - V) := by
    calc S * (N * X * (1 - V))
        = (S * N) * X * (1 - V) := by noncomm_ring
      _ = N * X * (1 - V) := by rw [hSN]
  have h2 : (N * X * (1 - V)) * S = 0 := by
    calc (N * X * (1 - V)) * S
        = (N * X) * ((1 - V) * S) := by noncomm_ring
      _ = 0 := by rw [hVS, mul_zero]
  rw [h1, h2, sub_zero]

/-- Pure ring helper for right odd grade `+1`: when `S * (1 - V) = 0` and `N * S = -N`,
`comm S ((1 - V) * X * N) = (1 - V) * X * N`. -/
theorem kkt_comm_odd_plus1_R (S N V X : B)
    (hSV : S * (1 - V) = 0) (hNS : N * S = -N) :
    comm S ((1 - V) * X * N) = (1 - V) * X * N := by
  dsimp [comm]
  have h1 : S * ((1 - V) * X * N) = 0 := by
    calc S * ((1 - V) * X * N)
        = (S * (1 - V)) * (X * N) := by noncomm_ring
      _ = 0 := by rw [hSV, zero_mul]
  have h2 : ((1 - V) * X * N) * S = -((1 - V) * X * N) := by
    calc ((1 - V) * X * N) * S
        = ((1 - V) * X) * (N * S) := by noncomm_ring
      _ = ((1 - V) * X) * (-N) := by rw [hNS]
      _ = -((1 - V) * X * N) := by noncomm_ring
  rw [h1, h2, zero_sub, neg_neg]

/-- Pure ring helper for left odd grade `-1`: when `S * M = -M` and `(1 - V) * S = 0`,
`comm S (M * X * (1 - V)) = -(M * X * (1 - V))`. -/
theorem kkt_comm_odd_minus1_L (S M V X : B)
    (hSM : S * M = -M) (hVS : (1 - V) * S = 0) :
    comm S (M * X * (1 - V)) = -(M * X * (1 - V)) := by
  dsimp [comm]
  have h1 : S * (M * X * (1 - V)) = -(M * X * (1 - V)) := by
    calc S * (M * X * (1 - V))
        = (S * M) * X * (1 - V) := by noncomm_ring
      _ = (-M) * X * (1 - V) := by rw [hSM]
      _ = -(M * X * (1 - V)) := by noncomm_ring
  have h2 : (M * X * (1 - V)) * S = 0 := by
    calc (M * X * (1 - V)) * S
        = (M * X) * ((1 - V) * S) := by noncomm_ring
      _ = 0 := by rw [hVS, mul_zero]
  rw [h1, h2, sub_zero]

/-- Pure ring helper for right odd grade `-1`: when `S * (1 - V) = 0` and `M * S = M`,
`comm S ((1 - V) * X * M) = -((1 - V) * X * M)`. -/
theorem kkt_comm_odd_minus1_R (S M V X : B)
    (hSV : S * (1 - V) = 0) (hMS : M * S = M) :
    comm S ((1 - V) * X * M) = -((1 - V) * X * M) := by
  dsimp [comm]
  have h1 : S * ((1 - V) * X * M) = 0 := by
    calc S * ((1 - V) * X * M)
        = (S * (1 - V)) * (X * M) := by noncomm_ring
      _ = 0 := by rw [hSV, zero_mul]
  have h2 : ((1 - V) * X * M) * S = (1 - V) * X * M := by
    calc ((1 - V) * X * M) * S
        = ((1 - V) * X) * (M * S) := by noncomm_ring
      _ = (1 - V) * X * M := by rw [hMS]
  rw [h1, h2, zero_sub]

/-- Pure ring helper for `[g_{+1}, g_{+1}] ⊆ g_{+2}` and `[g_{-1}, g_{-1}] ⊆ g_{-2}`. -/
theorem kkt_comm_G1_into_G2_helper (N V X Y : B) (h_nil : N * N = 0)
    (hV_idem : (1 - V) * (1 - V) = 1 - V) :
    comm (N * X * (1 - V)) ((1 - V) * Y * N) =
      N * (X * (1 - V) * Y) * N := by
  dsimp [comm]
  have h_second : ((1 - V) * Y * N) * (N * X * (1 - V)) = 0 := by
    calc ((1 - V) * Y * N) * (N * X * (1 - V))
        = ((1 - V) * Y) * (N * N) * (X * (1 - V)) := by noncomm_ring
      _ = 0 := by rw [h_nil, mul_zero, zero_mul]
  rw [h_second, sub_zero]
  calc (N * X * (1 - V)) * ((1 - V) * Y * N)
      = N * X * ((1 - V) * (1 - V)) * Y * N := by noncomm_ring
    _ = N * (X * (1 - V) * Y) * N := by rw [hV_idem]; noncomm_ring

/-- Pure ring helper for `[g_{+2}, g_{-2}] ⊆ g_0`. -/
theorem kkt_comm_extremal_into_G0_helper (N M P Q X Y : B)
    (hP : N * M = P) (hQ : M * N = Q)
    (hPN : P * N = N) (hMP : M * P = M)
    (hQM : Q * M = M) (hNQ : N * Q = N) :
    comm (N * X * N) (M * Y * M) =
      P * (N * X * P * Y * M) * P - Q * (M * Y * Q * X * N) * Q := by
  dsimp [comm]
  have h1 : P * (N * X * P * Y * M) * P = (N * X * N) * (M * Y * M) := by
    calc P * (N * X * P * Y * M) * P
        = (P * N) * X * (N * M) * Y * (M * P) := by
          rw [← hP]
          noncomm_ring
      _ = (N * X * N) * (M * Y * M) := by
          rw [hPN, hMP]
          noncomm_ring
  have h2 : Q * (M * Y * Q * X * N) * Q = (M * Y * M) * (N * X * N) := by
    calc Q * (M * Y * Q * X * N) * Q
        = (Q * M) * Y * (M * N) * X * (N * Q) := by
          rw [← hQ]
          noncomm_ring
      _ = (M * Y * M) * (N * X * N) := by
          rw [hQM, hNQ]
          noncomm_ring
  rw [h1, h2]

/-- Pure ring helper: when `S * E = c • E` and `E * S = c • E` (with `c = ±1`),
`comm S (E * X * E) = 0`. -/
theorem kkt_comm_grade0_idempotent (S E X : B)
    (hL : S * E = E) (hR : E * S = E) :
    comm S (E * X * E) = 0 := by
  dsimp [comm]
  have h1 : S * (E * X * E) = E * X * E := by
    calc S * (E * X * E)
        = (S * E) * X * E := by noncomm_ring
      _ = E * X * E := by rw [hL]
  have h2 : (E * X * E) * S = E * X * E := by
    calc (E * X * E) * S
        = (E * X) * (E * S) := by noncomm_ring
      _ = E * X * E := by rw [hR]
  rw [h1, h2, sub_self]

/-- Pure ring helper: when `S * E = -E` and `E * S = -E`,
`comm S (E * X * E) = 0`. -/
theorem kkt_comm_grade0_neg_idempotent (S E X : B)
    (hL : S * E = -E) (hR : E * S = -E) :
    comm S (E * X * E) = 0 := by
  dsimp [comm]
  have h1 : S * (E * X * E) = -(E * X * E) := by
    calc S * (E * X * E)
        = (S * E) * X * E := by noncomm_ring
      _ = (-E) * X * E := by rw [hL]
      _ = -(E * X * E) := by noncomm_ring
  have h2 : (E * X * E) * S = -(E * X * E) := by
    calc (E * X * E) * S
        = (E * X) * (E * S) := by noncomm_ring
      _ = (E * X) * (-E) := by rw [hR]
      _ = -(E * X * E) := by noncomm_ring
  rw [h1, h2, sub_self]

/-- Pure ring helper: when `S * E = 0` and `E * S = 0`, `comm S (E * X * E) = 0`. -/
theorem kkt_comm_grade0_zero_idempotent (S E X : B)
    (hL : S * E = 0) (hR : E * S = 0) :
    comm S (E * X * E) = 0 := by
  dsimp [comm]
  have h1 : S * (E * X * E) = 0 := by
    calc S * (E * X * E)
        = (S * E) * (X * E) := by noncomm_ring
      _ = 0 := by rw [hL, zero_mul]
  have h2 : (E * X * E) * S = 0 := by
    calc (E * X * E) * S
        = (E * X) * (E * S) := by noncomm_ring
      _ = 0 := by rw [hR, mul_zero]
  rw [h1, h2, sub_self]

/-- Pure ring helper: `comm S (A - C) = comm S A - comm S C`. -/
theorem kkt_comm_sub_right (S A C : B) :
    comm S (A - C) = comm S A - comm S C := by
  dsimp [comm]
  noncomm_ring

theorem kkt_comm_add_right (S A C : B) :
    comm S (A + C) = comm S A + comm S C := by
  dsimp [comm]
  noncomm_ring

theorem kkt_comm_block_plus2 (S E F X : B)
    (hSE : S * E = E) (hFS : F * S = -F) :
    comm S (E * X * F) = (2 : ℕ) • (E * X * F) := by
  dsimp [comm]
  have hL : S * (E * X * F) = E * X * F := by
    calc S * (E * X * F) = (S * E) * X * F := by noncomm_ring
      _ = E * X * F := by rw [hSE]
  have hR : (E * X * F) * S = -(E * X * F) := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = E * X * (-F) := by rw [hFS]
      _ = -(E * X * F) := by noncomm_ring
  rw [hL, hR, sub_neg_eq_add, two_nsmul]

theorem kkt_comm_block_plus1_left (S E F X : B)
    (hSE : S * E = E) (hFS : F * S = 0) :
    comm S (E * X * F) = E * X * F := by
  dsimp [comm]
  have hL : S * (E * X * F) = E * X * F := by
    calc S * (E * X * F) = (S * E) * X * F := by noncomm_ring
      _ = E * X * F := by rw [hSE]
  have hR : (E * X * F) * S = 0 := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = 0 := by rw [hFS, mul_zero]
  rw [hL, hR, sub_zero]

theorem kkt_comm_block_plus1_right (S E F X : B)
    (hSE : S * E = 0) (hFS : F * S = -F) :
    comm S (E * X * F) = E * X * F := by
  dsimp [comm]
  have hL : S * (E * X * F) = 0 := by
    calc S * (E * X * F) = (S * E) * (X * F) := by noncomm_ring
      _ = 0 := by rw [hSE, zero_mul]
  have hR : (E * X * F) * S = -(E * X * F) := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = E * X * (-F) := by rw [hFS]
      _ = -(E * X * F) := by noncomm_ring
  rw [hL, hR, zero_sub, neg_neg]

theorem kkt_comm_block_minus1_left (S E F X : B)
    (hSE : S * E = 0) (hFS : F * S = F) :
    comm S (E * X * F) = -(E * X * F) := by
  dsimp [comm]
  have hL : S * (E * X * F) = 0 := by
    calc S * (E * X * F) = (S * E) * (X * F) := by noncomm_ring
      _ = 0 := by rw [hSE, zero_mul]
  have hR : (E * X * F) * S = E * X * F := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = E * X * F := by rw [hFS]
  rw [hL, hR, zero_sub]

theorem kkt_comm_block_minus1_right (S E F X : B)
    (hSE : S * E = -E) (hFS : F * S = 0) :
    comm S (E * X * F) = -(E * X * F) := by
  dsimp [comm]
  have hL : S * (E * X * F) = -(E * X * F) := by
    calc S * (E * X * F) = (S * E) * X * F := by noncomm_ring
      _ = (-E) * X * F := by rw [hSE]
      _ = -(E * X * F) := by noncomm_ring
  have hR : (E * X * F) * S = 0 := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = 0 := by rw [hFS, mul_zero]
  rw [hL, hR, sub_zero]

theorem kkt_comm_block_minus2 (S E F X : B)
    (hSE : S * E = -E) (hFS : F * S = F) :
    comm S (E * X * F) = -((2 : ℕ) • (E * X * F)) := by
  dsimp [comm]
  have hL : S * (E * X * F) = -(E * X * F) := by
    calc S * (E * X * F) = (S * E) * X * F := by noncomm_ring
      _ = (-E) * X * F := by rw [hSE]
      _ = -(E * X * F) := by noncomm_ring
  have hR : (E * X * F) * S = E * X * F := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = E * X * F := by rw [hFS]
  rw [hL, hR, two_nsmul]
  noncomm_ring

end RingHelpers

/-!
## 3. 5-Graded Kantor–Koecher–Tits Lie Algebra Theorems (`KKT₁`–`KKT₁₀`)
-/

variable {B : Type u} [Ring B] [StarRing B]

/-- The inner commutator is a derivation of the Lie bracket. This identity is
the general mechanism behind addition of `ad(S)`-grades under commutators. -/
omit [StarRing B] in
theorem kkt_commutator_derivation (S A C : B) :
    comm S (comm A C) = comm (comm S A) C + comm A (comm S C) := by
  dsimp [comm]
  noncomm_ring

/-- Negative extremal Jordan triple sandwich `G_{-2}(N_+, X) := N_- X N_-`. -/
def G_minus2 (N_plus X : B) : B := star N_plus * X * star N_plus

/-- Negative extremal Jordan associator generator `K_{-2}(N_+, X) := JordanAssoc(X, N_-, N_-)`. -/
def K_minus2 (N_plus X : B) : B := JordanAssoc X (star N_plus) (star N_plus)

/-- Left odd Grade `+1` carrier `G_{+1}^L(N_+, X) := N_+ X (1 - Gap(N_+))`. -/
def G_plus1_L (N_plus X : B) : B := N_plus * X * (1 - Gap N_plus)

/-- Right odd Grade `+1` carrier `G_{+1}^R(N_+, X) := (1 - Gap(N_+)) X N_+`. -/
def G_plus1_R (N_plus X : B) : B := (1 - Gap N_plus) * X * N_plus

/-- Left odd Grade `-1` carrier `G_{-1}^L(N_+, X) := N_- X (1 - Gap(N_+))`. -/
def G_minus1_L (N_plus X : B) : B := star N_plus * X * (1 - Gap N_plus)

/-- Right odd Grade `-1` carrier `G_{-1}^R(N_+, X) := (1 - Gap(N_+)) X N_-`. -/
def G_minus1_R (N_plus X : B) : B := (1 - Gap N_plus) * X * star N_plus

/-- Grade `0` positive sheet diagonal carrier `G_0^P(N_+, X) := P(N_+) X P(N_+)`. -/
def G_0_P (N_plus X : B) : B := P N_plus * X * P N_plus

/-- Grade `0` negative sheet diagonal carrier `G_0^Q(N_+, X) := Q(N_+) X Q(N_+)`. -/
def G_0_Q (N_plus X : B) : B := Q N_plus * X * Q N_plus

/-- Grade `0` neutral Peirce complement carrier
`G_0^0(N_+, X) := (1 - Gap(N_+)) X (1 - Gap(N_+))`. -/
def G_0_neutral (N_plus X : B) : B := (1 - Gap N_plus) * X * (1 - Gap N_plus)

/-! ### Explicit Peirce sectors of the whole algebra -/

def peirceR (N_plus : B) : B := 1 - Gap N_plus

def peircePP (N_plus X : B) : B := P N_plus * X * P N_plus
def peircePQ (N_plus X : B) : B := P N_plus * X * Q N_plus
def peircePR (N_plus X : B) : B := P N_plus * X * peirceR N_plus
def peirceQP (N_plus X : B) : B := Q N_plus * X * P N_plus
def peirceQQ (N_plus X : B) : B := Q N_plus * X * Q N_plus
def peirceQR (N_plus X : B) : B := Q N_plus * X * peirceR N_plus
def peirceRP (N_plus X : B) : B := peirceR N_plus * X * P N_plus
def peirceRQ (N_plus X : B) : B := peirceR N_plus * X * Q N_plus
def peirceRR (N_plus X : B) : B := peirceR N_plus * X * peirceR N_plus

def peirceGradePlus2 (N_plus X : B) : B := peircePQ N_plus X
def peirceGradePlus1 (N_plus X : B) : B := peircePR N_plus X + peirceRQ N_plus X
def peirceGradeZero (N_plus X : B) : B :=
  peircePP N_plus X + peirceQQ N_plus X + peirceRR N_plus X
def peirceGradeMinus1 (N_plus X : B) : B := peirceRP N_plus X + peirceQR N_plus X
def peirceGradeMinus2 (N_plus X : B) : B := peirceQP N_plus X

/-- The nilpotent sandwich parametrization reaches every Peirce grade `+2` block. -/
theorem G_plus2_preimage_peirce (N_plus X : B) :
    G_plus2 N_plus (star N_plus * X * star N_plus) = peirceGradePlus2 N_plus X := by
  dsimp [G_plus2, peirceGradePlus2, peircePQ, P, Q]
  noncomm_ring

/-- The adjoint nilpotent sandwich parametrization reaches every Peirce grade `-2` block. -/
theorem G_minus2_preimage_peirce (N_plus X : B) :
    G_minus2 N_plus (N_plus * X * N_plus) = peirceGradeMinus2 N_plus X := by
  dsimp [G_minus2, peirceGradeMinus2, peirceQP, P, Q]
  noncomm_ring

/-- The associator-generated extremal operators cover the complete Peirce `±2`
sectors, with the conventional factor of two from the unnormalized Jordan associator. -/
theorem K_extremals_cover_peirce_grades (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) :
    K_plus2 N_plus (star N_plus * X * star N_plus) =
        (2 : ℕ) • peirceGradePlus2 N_plus X ∧
    K_minus2 N_plus (N_plus * X * N_plus) =
        (2 : ℕ) • peirceGradeMinus2 N_plus X := by
  constructor
  · change JordanAssoc (star N_plus * X * star N_plus) N_plus N_plus = _
    rw [kkt_jordan_assoc_eq_two_sandwich N_plus
      (star N_plus * X * star N_plus) h_nil]
    have hpre := G_plus2_preimage_peirce N_plus X
    change (2 : ℕ) • G_plus2 N_plus (star N_plus * X * star N_plus) = _
    rw [hpre]
  · change JordanAssoc (N_plus * X * N_plus) (star N_plus) (star N_plus) = _
    rw [kkt_jordan_assoc_eq_two_sandwich (star N_plus)
      (N_plus * X * N_plus) (star_N_plus_sq N_plus h_nil)]
    have hpre := G_minus2_preimage_peirce N_plus X
    change (2 : ℕ) • G_minus2 N_plus (N_plus * X * N_plus) = _
    rw [hpre]

/-- The nilpotent pairing's support is the sum of its two Peirce idempotents. -/
theorem Gap_eq_P_add_Q (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Gap N_plus = P N_plus + Q N_plus := by
  rw [Gap_eq_anticomm N_plus h_nil h_reg]
  rfl

/-- The three diagonal support pieces `P`, `Q`, and `1 - Gap` sum to the ambient
identity; here `1` is the ring unit required by this unital Peirce decomposition. -/
theorem peirce_idempotents_sum_one (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    P N_plus + Q N_plus + peirceR N_plus = 1 := by
  rw [peirceR, Gap_eq_P_add_Q N_plus h_nil h_reg]
  noncomm_ring

/-- Every element has the full nine-block Peirce decomposition induced by the two
chiral supports and their complementary support. -/
theorem peirce_nine_block_decomposition (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    X = peircePP N_plus X + peircePQ N_plus X + peircePR N_plus X +
      peirceQP N_plus X + peirceQQ N_plus X + peirceQR N_plus X +
      peirceRP N_plus X + peirceRQ N_plus X + peirceRR N_plus X := by
  have hsum := peirce_idempotents_sum_one N_plus h_nil h_reg
  calc X = 1 * X * 1 := by noncomm_ring
    _ = (P N_plus + Q N_plus + peirceR N_plus) * X *
        (P N_plus + Q N_plus + peirceR N_plus) := by rw [hsum]
    _ = peircePP N_plus X + peircePQ N_plus X + peircePR N_plus X +
        peirceQP N_plus X + peirceQQ N_plus X + peirceQR N_plus X +
        peirceRP N_plus X + peirceRQ N_plus X + peirceRR N_plus X := by
          simp only [peircePP, peircePQ, peircePR, peirceQP, peirceQQ, peirceQR,
            peirceRP, peirceRQ, peirceRR, peirceR]
          noncomm_ring

/-- Grouping the nine Peirce blocks by the eigenvalue difference of their left and
right support produces grades `+2,+1,0,-1,-2`. -/
theorem peirce_five_grade_decomposition (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
      peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
      peirceGradeMinus2 N_plus X := by
  calc X = peircePP N_plus X + peircePQ N_plus X + peircePR N_plus X +
      peirceQP N_plus X + peirceQQ N_plus X + peirceQR N_plus X +
      peirceRP N_plus X + peirceRQ N_plus X + peirceRR N_plus X :=
        peirce_nine_block_decomposition N_plus X h_nil h_reg
    _ = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
        peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
        peirceGradeMinus2 N_plus X := by
          simp only [peirceGradePlus2, peirceGradePlus1, peirceGradeZero,
            peirceGradeMinus1, peirceGradeMinus2]
          abel

omit [StarRing B] in
/-- **Theorem `KKT₁` (Positive Jordan Quadratic Triple Sandwich)**:
`K_{+2}(N_+, X) = 2 • G_{+2}(N_+, X)`. -/
theorem K_plus2_eq_two_sandwich (N_plus X : B) (h_nil : N_plus * N_plus = 0) :
    K_plus2 N_plus X = (2 : ℕ) • G_plus2 N_plus X :=
  kkt_jordan_assoc_eq_two_sandwich N_plus X h_nil

/-- **Theorem `KKT₁'` (Negative Jordan Quadratic Triple Sandwich)**:
`K_{-2}(N_+, X) = 2 • G_{-2}(N_+, X)`. -/
theorem K_minus2_eq_two_sandwich (N_plus X : B) (h_nil : N_plus * N_plus = 0) :
    K_minus2 N_plus X = (2 : ℕ) • G_minus2 N_plus X :=
  kkt_jordan_assoc_eq_two_sandwich (star N_plus) X (star_N_plus_sq N_plus h_nil)

/-- **Theorem `KKT₂` (Extremal Grade `+2` Adjoint Eigenvalue)**:
`[Σ, K_{+2}(N_+, X)] = 2 • K_{+2}(N_+, X)`. -/
theorem comm_Sigma_K_plus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (K_plus2 N_plus X) = (2 : ℕ) • K_plus2 N_plus X := by
  rw [K_plus2_eq_two_sandwich N_plus X h_nil,
      kkt_comm_two_nsmul_right]
  congr 1
  exact kkt_comm_grading_plus2 (Sigma N_plus) N_plus X
    (Sigma_mul_N_plus N_plus h_nil h_reg)
    (N_plus_mul_Sigma N_plus h_nil h_reg)

/-- **Theorem `KKT₂'` (Extremal Grade `-2` Adjoint Eigenvalue)**:
`[Σ, K_{-2}(N_+, X)] = -(2 • K_{-2}(N_+, X))`. -/
theorem comm_Sigma_K_minus2 (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (K_minus2 N_plus X) = -((2 : ℕ) • K_minus2 N_plus X) := by
  rw [K_minus2_eq_two_sandwich N_plus X h_nil, kkt_comm_two_nsmul_right]
  change (2 : ℕ) • comm (Sigma N_plus) (star N_plus * X * star N_plus) =
    -((2 : ℕ) • ((2 : ℕ) • (star N_plus * X * star N_plus)))
  rw [kkt_comm_grading_minus2 (Sigma N_plus) (star N_plus) X
    (Sigma_mul_star_N_plus N_plus h_nil h_reg)
    (star_N_plus_mul_Sigma N_plus h_nil h_reg)]
  exact kkt_two_nsmul_neg (star N_plus * X * star N_plus)

omit [StarRing B] in
/-- **Theorem `KKT₃` (Abelian Nilpotency of Extremal Grade `+2`)**:
`K_{+2}(N_+, X) * K_{+2}(N_+, Y) = 0`. -/
theorem K_plus2_mul_K_plus2 (N_plus X Y : B) (h_nil : N_plus * N_plus = 0) :
    K_plus2 N_plus X * K_plus2 N_plus Y = 0 := by
  rw [K_plus2_eq_two_sandwich N_plus X h_nil,
      K_plus2_eq_two_sandwich N_plus Y h_nil]
  exact kkt_two_nsmul_mul_two_nsmul_zero (G_plus2 N_plus X) (G_plus2 N_plus Y)
    (kkt_sandwich_mul_sandwich_zero N_plus X Y h_nil)

/-- **Theorem `KKT₃'` (Abelian Nilpotency of Extremal Grade `-2`)**:
`K_{-2}(N_+, X) * K_{-2}(N_+, Y) = 0`. -/
theorem K_minus2_mul_K_minus2 (N_plus X Y : B) (h_nil : N_plus * N_plus = 0) :
    K_minus2 N_plus X * K_minus2 N_plus Y = 0 := by
  rw [K_minus2_eq_two_sandwich N_plus X h_nil,
      K_minus2_eq_two_sandwich N_plus Y h_nil]
  exact kkt_two_nsmul_mul_two_nsmul_zero (G_minus2 N_plus X) (G_minus2 N_plus Y)
    (kkt_sandwich_mul_sandwich_zero (star N_plus) X Y (star_N_plus_sq N_plus h_nil))

/-- **Theorem `KKT₄` (Regular Nilpotent Seed Fixed Point in Grade `+2`)**:
`K_{+2}(N_+, N_-) = 2 • N_+`. -/
theorem K_plus2_seed (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    K_plus2 N_plus (star N_plus) = (2 : ℕ) • N_plus := by
  rw [K_plus2_eq_two_sandwich N_plus (star N_plus) h_nil]
  dsimp [G_plus2]
  rw [h_reg]

/-- **Theorem `KKT₄'` (Regular Nilpotent Seed Fixed Point in Grade `-2`)**:
`K_{-2}(N_+, N_+) = 2 • N_-`. -/
theorem K_minus2_seed (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    K_minus2 N_plus N_plus = (2 : ℕ) • star N_plus := by
  rw [K_minus2_eq_two_sandwich N_plus N_plus h_nil]
  dsimp [G_minus2]
  rw [star_N_plus_reg N_plus h_reg]

/-- Helper: `(1 - Gap N_plus) * Sigma N_plus = 0`. -/
theorem one_sub_Gap_mul_Sigma (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    (1 - Gap N_plus) * Sigma N_plus = 0 := by
  rw [sub_mul, one_mul, Gap_mul_Sigma N_plus h_nil h_reg, sub_self]

theorem Sigma_mul_Gap (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * Gap N_plus = Sigma N_plus := by
  calc Sigma N_plus * Gap N_plus
      = Sigma N_plus * (Sigma N_plus * Sigma N_plus) := rfl
    _ = (Sigma N_plus * Sigma N_plus) * Sigma N_plus := by rw [mul_assoc]
    _ = Gap N_plus * Sigma N_plus := rfl
    _ = Sigma N_plus := Gap_mul_Sigma N_plus h_nil h_reg

/-- Helper: `Sigma N_plus * (1 - Gap N_plus) = 0`. -/
theorem Sigma_mul_one_sub_Gap (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * (1 - Gap N_plus) = 0 := by
  rw [mul_sub, mul_one, Sigma_mul_Gap N_plus h_nil h_reg, sub_self]

/-- **Theorem `KKT₅` (Odd Grade `+1` Left Carrier Eigenvalue)**:
`[Σ, G_{+1}^L(N_+, X)] = G_{+1}^L(N_+, X)`. -/
theorem comm_Sigma_G_plus1_L (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_plus1_L N_plus X) = G_plus1_L N_plus X :=
  kkt_comm_odd_plus1_L (Sigma N_plus) N_plus (Gap N_plus) X
    (Sigma_mul_N_plus N_plus h_nil h_reg)
    (one_sub_Gap_mul_Sigma N_plus h_nil h_reg)

/-- **Theorem `KKT₅'` (Odd Grade `+1` Right Carrier Eigenvalue)**:
`[Σ, G_{+1}^R(N_+, X)] = G_{+1}^R(N_+, X)`. -/
theorem comm_Sigma_G_plus1_R (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_plus1_R N_plus X) = G_plus1_R N_plus X :=
  kkt_comm_odd_plus1_R (Sigma N_plus) N_plus (Gap N_plus) X
    (Sigma_mul_one_sub_Gap N_plus h_nil h_reg)
    (N_plus_mul_Sigma N_plus h_nil h_reg)

/-- **Theorem `KKT₅''` (Odd Grade `-1` Left Carrier Eigenvalue)**:
`[Σ, G_{-1}^L(N_+, X)] = -G_{-1}^L(N_+, X)`. -/
theorem comm_Sigma_G_minus1_L (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_minus1_L N_plus X) = -G_minus1_L N_plus X :=
  kkt_comm_odd_minus1_L (Sigma N_plus) (star N_plus) (Gap N_plus) X
    (Sigma_mul_star_N_plus N_plus h_nil h_reg)
    (one_sub_Gap_mul_Sigma N_plus h_nil h_reg)

/-- **Theorem `KKT₅'''` (Odd Grade `-1` Right Carrier Eigenvalue)**:
`[Σ, G_{-1}^R(N_+, X)] = -G_{-1}^R(N_+, X)`. -/
theorem comm_Sigma_G_minus1_R (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_minus1_R N_plus X) = -G_minus1_R N_plus X :=
  kkt_comm_odd_minus1_R (Sigma N_plus) (star N_plus) (Gap N_plus) X
    (Sigma_mul_one_sub_Gap N_plus h_nil h_reg)
    (star_N_plus_mul_Sigma N_plus h_nil h_reg)

/-- **Theorem `KKT₆` (Odd-to-Extremal Bracket Closure `[g_{+1}, g_{+1}] ⊆ g_{+2}`)**:
`[G_{+1}^L(N_+, X), G_{+1}^R(N_+, Y)] = G_{+2}(N_+, X (1 - Gap) Y)`. -/
theorem comm_G_plus1_into_G_plus2 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_plus1_L N_plus X) (G_plus1_R N_plus Y) =
      G_plus2 N_plus (X * (1 - Gap N_plus) * Y) := by
  have hGap_idem := Gap_idem N_plus h_nil h_reg
  have hR : (1 - Gap N_plus) * (1 - Gap N_plus) = 1 - Gap N_plus := by
    dsimp [Gap] at hGap_idem ⊢
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap_idem, sub_self, sub_zero]
  exact kkt_comm_G1_into_G2_helper N_plus (Gap N_plus) X Y h_nil hR

/-- **Theorem `KKT₆'` (Odd-to-Extremal Bracket Closure `[g_{-1}, g_{-1}] ⊆ g_{-2}`)**:
`[G_{-1}^L(N_+, X), G_{-1}^R(N_+, Y)] = G_{-2}(N_+, X (1 - Gap) Y)`. -/
theorem comm_G_minus1_into_G_minus2 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_minus1_L N_plus X) (G_minus1_R N_plus Y) =
      G_minus2 N_plus (X * (1 - Gap N_plus) * Y) := by
  have hGap_idem := Gap_idem N_plus h_nil h_reg
  have hR : (1 - Gap N_plus) * (1 - Gap N_plus) = 1 - Gap N_plus := by
    dsimp [Gap] at hGap_idem ⊢
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap_idem, sub_self, sub_zero]
  exact kkt_comm_G1_into_G2_helper (star N_plus) (Gap N_plus) X Y
    (star_N_plus_sq N_plus h_nil) hR

/-- **Theorem `KKT₇` (Opposite Extremal Commutator Lands in Grade `0`, `[g_{+2}, g_{-2}] ⊆ g_0`)**:
`[G_{+2}(N_+, X), G_{-2}(N_+, Y)] = G_0^P(N_+, N_+ X P Y N_-) - G_0^Q(N_+, N_- Y Q X N_+)`. -/
theorem comm_G_plus2_G_minus2_in_G_0 (N_plus X Y : B)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_plus2 N_plus X) (G_minus2 N_plus Y) =
      G_0_P N_plus (N_plus * X * P N_plus * Y * star N_plus) -
      G_0_Q N_plus (star N_plus * Y * Q N_plus * X * N_plus) := by
  have hPN : P N_plus * N_plus = N_plus := h_reg
  have hMP : star N_plus * P N_plus = star N_plus := by
    dsimp [P]
    rw [← mul_assoc]
    exact star_N_plus_reg N_plus h_reg
  have hQM : Q N_plus * star N_plus = star N_plus := star_N_plus_reg N_plus h_reg
  have hNQ : N_plus * Q N_plus = N_plus := by
    dsimp [Q]
    rw [← mul_assoc]
    exact h_reg
  exact kkt_comm_extremal_into_G0_helper N_plus (star N_plus) (P N_plus) (Q N_plus) X Y
    rfl rfl hPN hMP hQM hNQ

/-- Helper: `Sigma N_plus * P N_plus = P N_plus`. -/
theorem Sigma_mul_P_eq_P (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * P N_plus = P N_plus := by
  dsimp [P]
  rw [← mul_assoc, Sigma_mul_N_plus N_plus h_nil h_reg]

/-- Helper: `P N_plus * Sigma N_plus = P N_plus`. -/
theorem P_mul_Sigma_eq_P (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    P N_plus * Sigma N_plus = P N_plus := by
  dsimp [P]
  rw [mul_assoc, star_N_plus_mul_Sigma N_plus h_nil h_reg]

/-- Helper: `Sigma N_plus * Q N_plus = -Q N_plus`. -/
theorem Sigma_mul_Q_eq_neg_Q (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * Q N_plus = -Q N_plus := by
  dsimp [Q]
  rw [← mul_assoc, Sigma_mul_star_N_plus N_plus h_nil h_reg, neg_mul]

/-- Helper: `Q N_plus * Sigma N_plus = -Q N_plus`. -/
theorem Q_mul_Sigma_eq_neg_Q (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Q N_plus * Sigma N_plus = -Q N_plus := by
  dsimp [Q]
  rw [mul_assoc, N_plus_mul_Sigma N_plus h_nil h_reg, mul_neg]

/-- **Theorem `KKT₈` (Grade `0` Positive Sheet Centralizes `Σ`)**:
`[Σ, G_0^P(N_+, X)] = 0`. -/
theorem comm_Sigma_G_0_P (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_0_P N_plus X) = 0 :=
  kkt_comm_grade0_idempotent (Sigma N_plus) (P N_plus) X
    (Sigma_mul_P_eq_P N_plus h_nil h_reg)
    (P_mul_Sigma_eq_P N_plus h_nil h_reg)

/-- **Theorem `KKT₈'` (Grade `0` Negative Sheet Centralizes `Σ`)**:
`[Σ, G_0^Q(N_+, X)] = 0`. -/
theorem comm_Sigma_G_0_Q (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_0_Q N_plus X) = 0 :=
  kkt_comm_grade0_neg_idempotent (Sigma N_plus) (Q N_plus) X
    (Sigma_mul_Q_eq_neg_Q N_plus h_nil h_reg)
    (Q_mul_Sigma_eq_neg_Q N_plus h_nil h_reg)

/-- **Theorem `KKT₈''` (Grade `0` Neutral Peirce Complement Centralizes `Σ`)**:
`[Σ, G_0^0(N_+, X)] = 0`. -/
theorem comm_Sigma_G_0_neutral (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_0_neutral N_plus X) = 0 :=
  kkt_comm_grade0_zero_idempotent (Sigma N_plus) (1 - Gap N_plus) X
    (Sigma_mul_one_sub_Gap N_plus h_nil h_reg)
    (one_sub_Gap_mul_Sigma N_plus h_nil h_reg)

/-- Each grouped Peirce sector is an eigenspace of `ad(Σ)` with its indicated
integer grade. This is the grading statement for the five sectors above. -/
theorem comm_Sigma_peirce_five_grades (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (peirceGradePlus2 N_plus X) =
        (2 : ℕ) • peirceGradePlus2 N_plus X ∧
    comm (Sigma N_plus) (peirceGradePlus1 N_plus X) = peirceGradePlus1 N_plus X ∧
    comm (Sigma N_plus) (peirceGradeZero N_plus X) = 0 ∧
    comm (Sigma N_plus) (peirceGradeMinus1 N_plus X) = -peirceGradeMinus1 N_plus X ∧
    comm (Sigma N_plus) (peirceGradeMinus2 N_plus X) =
        -((2 : ℕ) • peirceGradeMinus2 N_plus X) := by
  have hPleft := Sigma_mul_P_eq_P N_plus h_nil h_reg
  have hPright := P_mul_Sigma_eq_P N_plus h_nil h_reg
  have hQleft := Sigma_mul_Q_eq_neg_Q N_plus h_nil h_reg
  have hQright := Q_mul_Sigma_eq_neg_Q N_plus h_nil h_reg
  have hRleft := Sigma_mul_one_sub_Gap N_plus h_nil h_reg
  have hRright := one_sub_Gap_mul_Sigma N_plus h_nil h_reg
  have hPQ := kkt_comm_block_plus2 (Sigma N_plus) (P N_plus) (Q N_plus) X
    hPleft hQright
  have hPR := kkt_comm_block_plus1_left (Sigma N_plus) (P N_plus)
    (peirceR N_plus) X hPleft hRright
  have hRQ := kkt_comm_block_plus1_right (Sigma N_plus) (peirceR N_plus)
    (Q N_plus) X hRleft hQright
  have hRP := kkt_comm_block_minus1_left (Sigma N_plus) (peirceR N_plus)
    (P N_plus) X hRleft hPright
  have hQR := kkt_comm_block_minus1_right (Sigma N_plus) (Q N_plus)
    (peirceR N_plus) X hQleft hRright
  have hQP := kkt_comm_block_minus2 (Sigma N_plus) (Q N_plus) (P N_plus) X
    hQleft hPright
  have hPR' : comm (Sigma N_plus) (peircePR N_plus X) = peircePR N_plus X := by
    simpa [peircePR, peirceR] using hPR
  have hRQ' : comm (Sigma N_plus) (peirceRQ N_plus X) = peirceRQ N_plus X := by
    simpa [peirceRQ, peirceR] using hRQ
  have hRP' : comm (Sigma N_plus) (peirceRP N_plus X) = -peirceRP N_plus X := by
    simpa [peirceRP, peirceR] using hRP
  have hQR' : comm (Sigma N_plus) (peirceQR N_plus X) = -peirceQR N_plus X := by
    simpa [peirceQR, peirceR] using hQR
  have hPP : comm (Sigma N_plus) (peircePP N_plus X) = 0 := by
    simpa [peircePP, G_0_P] using comm_Sigma_G_0_P N_plus X h_nil h_reg
  have hQQ : comm (Sigma N_plus) (peirceQQ N_plus X) = 0 := by
    simpa [peirceQQ, G_0_Q] using comm_Sigma_G_0_Q N_plus X h_nil h_reg
  have hRR : comm (Sigma N_plus) (peirceRR N_plus X) = 0 := by
    simpa [peirceRR, peirceR, G_0_neutral] using
      comm_Sigma_G_0_neutral N_plus X h_nil h_reg
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simpa [peirceGradePlus2, peircePQ] using hPQ
  · rw [peirceGradePlus1, kkt_comm_add_right, hPR', hRQ']
  · rw [peirceGradeZero, kkt_comm_add_right, kkt_comm_add_right, hPP, hQQ, hRR]
    simp
  · rw [peirceGradeMinus1, kkt_comm_add_right, hRP', hQR']
    abel
  · simpa [peirceGradeMinus2, peirceQP] using hQP

/-- Completion interface: the five Peirce sectors exhaust each operator, are graded
by `ad(Σ)`, and their extremal pieces are reached by the Jordan-associator generators. -/
theorem kkt_peirce_five_grade_completion (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    (X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
      peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
      peirceGradeMinus2 N_plus X) ∧
    (comm (Sigma N_plus) (peirceGradePlus2 N_plus X) =
        (2 : ℕ) • peirceGradePlus2 N_plus X ∧
     comm (Sigma N_plus) (peirceGradePlus1 N_plus X) = peirceGradePlus1 N_plus X ∧
     comm (Sigma N_plus) (peirceGradeZero N_plus X) = 0 ∧
     comm (Sigma N_plus) (peirceGradeMinus1 N_plus X) = -peirceGradeMinus1 N_plus X ∧
     comm (Sigma N_plus) (peirceGradeMinus2 N_plus X) =
        -((2 : ℕ) • peirceGradeMinus2 N_plus X)) ∧
    (K_plus2 N_plus (star N_plus * X * star N_plus) =
        (2 : ℕ) • peirceGradePlus2 N_plus X ∧
     K_minus2 N_plus (N_plus * X * N_plus) =
        (2 : ℕ) • peirceGradeMinus2 N_plus X) := by
  exact ⟨peirce_five_grade_decomposition N_plus X h_nil h_reg,
    comm_Sigma_peirce_five_grades N_plus X h_nil h_reg,
    K_extremals_cover_peirce_grades N_plus X h_nil⟩

/-- **Theorem `KKT₉` (Opposite Extremal Commutator Has Adjoint Grade `0`)**:
`[Σ, [G_{+2}(N_+, X), G_{-2}(N_+, Y)]] = 0`. -/
theorem comm_Sigma_comm_G_plus2_G_minus2 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (comm (G_plus2 N_plus X) (G_minus2 N_plus Y)) = 0 := by
  rw [comm_G_plus2_G_minus2_in_G_0 N_plus X Y h_reg,
      kkt_comm_sub_right,
      comm_Sigma_G_0_P N_plus _ h_nil h_reg,
      comm_Sigma_G_0_Q N_plus _ h_nil h_reg,
      sub_self]

/-- **Theorem `KKT₁₀` (`kantor_koecher_tits_five_graded_closure_poset_master_synthesis`)**:
Master synthesis of the 10-stage Kantor–Koecher–Tits 5-graded Lie closure (`KKT₁`–`KKT₁₀`):
1. The causal poset `KantorKoecherTitsStage` chains `KKT₁ → ⋯ → KKT₁₀`,
2. Extremal Jordan associator triple sandwiches `K_{±2} = 2 • G_{±2}` carry adjoint eigenvalues `±2`
   under `ad(Σ)`, are abelian-nilpotent (`K_{+2} K_{+2} = 0`, `K_{-2} K_{-2} = 0`), and have `N_±` as
   seed fixed points (`K_{+2}(N_+, N_-) = 2 • N_+`, `K_{-2}(N_+, N_+) = 2 • N_-`),
3. Odd carriers `G_{±1}^{L,R}` carry adjoint eigenvalues `±1` and bracket into `G_{±2}`,
4. Opposite extremal commutators `[G_{+2}, G_{-2}]` decompose into `G_0^P - G_0^Q` and commute
   with `Σ` (`[Σ, [G_{+2}, G_{-2}]] = 0`). -/
theorem kantor_koecher_tits_five_graded_closure_poset_master_synthesis
    (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    (KantorKoecherTitsStage.causalEdge
       .KKT1_JordanQuadraticTripleSandwich .KKT2_ExtremalGradePlusMinusTwo ∧
     KantorKoecherTitsStage.causalEdge
       .KKT2_ExtremalGradePlusMinusTwo .KKT3_ExtremalAbelianNilpotency ∧
     KantorKoecherTitsStage.causalEdge
       .KKT3_ExtremalAbelianNilpotency .KKT4_RegularNilpotentSeedFixedPoint ∧
     KantorKoecherTitsStage.causalEdge
       .KKT4_RegularNilpotentSeedFixedPoint .KKT5_OddGradePlusMinusOneCarriers ∧
     KantorKoecherTitsStage.causalEdge
       .KKT5_OddGradePlusMinusOneCarriers .KKT6_OddToExtremalBracketClosure ∧
     KantorKoecherTitsStage.causalEdge
       .KKT6_OddToExtremalBracketClosure .KKT7_ExtremalOppositeGradeToZero ∧
     KantorKoecherTitsStage.causalEdge
       .KKT7_ExtremalOppositeGradeToZero .KKT8_ZeroGradeDiagonalNeutralCentralizer ∧
     KantorKoecherTitsStage.causalEdge
       .KKT8_ZeroGradeDiagonalNeutralCentralizer .KKT9_ExtremalCommutatorZeroGradeClosure ∧
     KantorKoecherTitsStage.causalEdge
       .KKT9_ExtremalCommutatorZeroGradeClosure
       .KKT10_MasterFiveGradedKantorKoecherTitsSynthesis) ∧
    (K_plus2 N_plus X = (2 : ℕ) • G_plus2 N_plus X ∧
     K_minus2 N_plus X = (2 : ℕ) • G_minus2 N_plus X ∧
     comm (Sigma N_plus) (K_plus2 N_plus X) = (2 : ℕ) • K_plus2 N_plus X ∧
     comm (Sigma N_plus) (K_minus2 N_plus X) = -((2 : ℕ) • K_minus2 N_plus X)) ∧
    (K_plus2 N_plus X * K_plus2 N_plus Y = 0 ∧
     K_minus2 N_plus X * K_minus2 N_plus Y = 0 ∧
     K_plus2 N_plus (star N_plus) = (2 : ℕ) • N_plus ∧
     K_minus2 N_plus N_plus = (2 : ℕ) • star N_plus) ∧
    (comm (Sigma N_plus) (G_plus1_L N_plus X) = G_plus1_L N_plus X ∧
     comm (Sigma N_plus) (G_plus1_R N_plus X) = G_plus1_R N_plus X ∧
     comm (Sigma N_plus) (G_minus1_L N_plus X) = -G_minus1_L N_plus X ∧
     comm (Sigma N_plus) (G_minus1_R N_plus X) = -G_minus1_R N_plus X) ∧
    (comm (G_plus1_L N_plus X) (G_plus1_R N_plus Y) =
       G_plus2 N_plus (X * (1 - Gap N_plus) * Y) ∧
     comm (G_minus1_L N_plus X) (G_minus1_R N_plus Y) =
       G_minus2 N_plus (X * (1 - Gap N_plus) * Y)) ∧
    (comm (G_plus2 N_plus X) (G_minus2 N_plus Y) =
       G_0_P N_plus (N_plus * X * P N_plus * Y * star N_plus) -
       G_0_Q N_plus (star N_plus * Y * Q N_plus * X * N_plus) ∧
     comm (Sigma N_plus) (G_0_P N_plus X) = 0 ∧
     comm (Sigma N_plus) (G_0_Q N_plus X) = 0 ∧
     comm (Sigma N_plus) (G_0_neutral N_plus X) = 0 ∧
     comm (Sigma N_plus) (comm (G_plus2 N_plus X) (G_minus2 N_plus Y)) = 0) :=
  ⟨⟨KantorKoecherTitsStage.causalEdge_KKT1_KKT2,
    KantorKoecherTitsStage.causalEdge_KKT2_KKT3,
    KantorKoecherTitsStage.causalEdge_KKT3_KKT4,
    KantorKoecherTitsStage.causalEdge_KKT4_KKT5,
    KantorKoecherTitsStage.causalEdge_KKT5_KKT6,
    KantorKoecherTitsStage.causalEdge_KKT6_KKT7,
    KantorKoecherTitsStage.causalEdge_KKT7_KKT8,
    KantorKoecherTitsStage.causalEdge_KKT8_KKT9,
    KantorKoecherTitsStage.causalEdge_KKT9_KKT10⟩,
   ⟨K_plus2_eq_two_sandwich N_plus X h_nil,
    K_minus2_eq_two_sandwich N_plus X h_nil,
    comm_Sigma_K_plus2 N_plus X h_nil h_reg,
    comm_Sigma_K_minus2 N_plus X h_nil h_reg⟩,
   ⟨K_plus2_mul_K_plus2 N_plus X Y h_nil,
    K_minus2_mul_K_minus2 N_plus X Y h_nil,
    K_plus2_seed N_plus h_nil h_reg,
    K_minus2_seed N_plus h_nil h_reg⟩,
   ⟨comm_Sigma_G_plus1_L N_plus X h_nil h_reg,
    comm_Sigma_G_plus1_R N_plus X h_nil h_reg,
    comm_Sigma_G_minus1_L N_plus X h_nil h_reg,
    comm_Sigma_G_minus1_R N_plus X h_nil h_reg⟩,
   ⟨comm_G_plus1_into_G_plus2 N_plus X Y h_nil h_reg,
    comm_G_minus1_into_G_minus2 N_plus X Y h_nil h_reg⟩,
   ⟨comm_G_plus2_G_minus2_in_G_0 N_plus X Y h_reg,
    comm_Sigma_G_0_P N_plus X h_nil h_reg,
    comm_Sigma_G_0_Q N_plus X h_nil h_reg,
    comm_Sigma_G_0_neutral N_plus X h_nil h_reg,
    comm_Sigma_comm_G_plus2_G_minus2 N_plus X Y h_nil h_reg⟩⟩

end InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTitsClosurePoset
