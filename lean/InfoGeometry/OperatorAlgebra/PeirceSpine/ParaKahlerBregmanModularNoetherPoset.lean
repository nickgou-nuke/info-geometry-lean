  have hM7 := archetype_M7_modular_surprisal_space_charge_and_verlinde_entropic_force hP A C
  have hM8 := archetype_M8_operator_killing_fields_and_noether_centralizer hP A C
  have hM9 := archetype_M9_helmholtz_hodge_irrotational_and_rotational_lie_flows hP A C X
  exact ⟨ParaKahlerModularNoetherStage.causalEdge_acyclic,
