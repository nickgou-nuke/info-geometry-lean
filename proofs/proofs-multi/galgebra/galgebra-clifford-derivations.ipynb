print("\n--- pseudoscalar I = gamma^0 gamma^1 ---")
print(f"  I = {simplify(pseudo.trace())} (trace)")
print(f"  I^2 = {simplify(expand(gp(pseudo, pseudo).trace()))} (trace)")
# Each vector v dual: ~v = -I v  (in Cl(1,1))
# Bregman metric g_ij: use Minkowski restricted to chiral cone
# g = diag(+1, -1)
# compute H_ij(b) = phi''(b) delta_ij  => diag(1/b_0, 1/b_1)
b_mu = symbols('b_0 b_1', positive=True)
H_bregman = Matrix([[b_mu**-1 if i==j else 0 for j in range(2)] for i in range(2)])
print("\n--- Bregman conformal H(b) ---")
print(f"  H = {H_bregman}")

# Clifford product of bivector with H(b) gives
#   H * (gamma^mu gamma^nu)  =  eta^{mu nu} H_{mu nu}
# In 2D only one bivector {e_1,e_2}.
H12 = H_bregman[0,1]
print(f"  H_12 (mixed) = {H12}")
# total trace / factor
factor_total = sum(H_bregman.diagonal())
print(f"  tr(H) = {factor_total}")

# ------- Cell 9: Explicit grade projection -------
# In [9]
# gin: for any multivector M, grade-selector
def grade(Mv, k, dim=4):
    # prototype: Mv is a dict grade->list-of-coeff
    return Mv.coeffs.get(k, [0]*(20))

# Demonstrate graded Leibniz rule for derivations.
# Let d be grade-1 derivation via gamma^mu acting on MV elements.
# For MV multiplications we compute [d(v),w] + (-1)^{|v|}[v, d(w)] = d(vw)
mv_a = MV({1: [1,2,3,4]})  # grade-1
mv_b = MV({0: [7]})        # grade-0 (scalar)
# "product" of grade-1 and scalar = scalar-grade1 (graded commutative)
# The derivation should kill the scalar: d(7) = 0

class AdjointDerivation:
    """d(v) = gamma_mu v for a fixed gamma_mu (grade-1 derivation)."""
    def __init__(self, mu=0):
        self.mu = mu
        self.gamma_cl = _conformal_basis()
        self.G = [self.gamma_cl[1], self.gamma_cl[2],
                  self.gamma_cl['+'], self.gamma_cl['-']]
        self.Gmu = self.G[mu] if isinstance(mu, int) and mu<4 else eye(4)

    def act(self, v): return self.Gmu * v

# verify Leibniz
deriv = AdjointDerivation(0)
vand = Matrix([1,0,0,0])
wnum = 7
# d(v*w) = d(v)*scalar + v*d(scalar)
dv = deriv.act(vand)
cls = dv*wnum
grad = deriv.act(vand*wnum)
print("\n--- Leibniz rule check (grade-1 derivation) ---")
print(f"  d(v*w) - d(v)*w = 0 : {simplify(expand((grad - cls).norm())) == 0}")

