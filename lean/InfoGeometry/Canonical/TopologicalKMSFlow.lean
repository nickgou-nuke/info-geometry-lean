import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import Mathlib.Data.Real.Basic
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import Mathlib.LinearAlgebra.CliffordAlgebra.Basic
import InfoGeometry.Clifford.SplitQ44
import InfoGeometry.Clifford.Cl44Witt
import InfoGeometry.Clifford.ChiralGrandCanonicalOperatorGeometry

/-!
# Topological KMS Flow and the Modular Automorphism Group

This file establishes the continuous 1-parameter modular automorphism group
(the birth of Time) generated by the native non-commutative Grand Canonical 
Hamiltonian.

We replace axiomatic C*-algebra assumptions with constructive Mathlib
lemmas and the finite algebraic flow is constructed
as a true `AlgEquiv` (algebra equivalence) on the split-signature `Cl(4,4)` 
Clifford algebra.

The time evolution is built natively via `CliffordAlgebra.equivOfIsometry` by 
lifting the exact pseudo-orthogonal Lorentz boost isometry of the null Witt basis.
-/

open InfoGeometry.Clifford
open InfoGeometry.Clifford.Cl44Witt
open InfoGeometry.Clifford.ChiralGrandCanonicalOperatorGeometry
open CliffordAlgebra

noncomputable section

namespace InfoGeometry.Canonical.TopologicalKMSFlow

variable (E μ : Fin 4 → ℝ)

/-- The frequency (energy minus chemical potential) for each mode. -/
noncomputable def ω (i : Fin 4) : ℝ := E i - μ i

/-- 
The continuous time evolution on the finite-dimensional vector space `V_{4,4}`.
It is an exact Lorentz boost in the split signature.
-/
noncomputable def boostFun (t : ℝ) (x : Fin 8 → ℝ) : Fin 8 → ℝ
  | 0 => Real.cosh (t * ω E μ 0) * x 0 - Real.sinh (t * ω E μ 0) * x 4
  | 1 => Real.cosh (t * ω E μ 1) * x 1 - Real.sinh (t * ω E μ 1) * x 5
  | 2 => Real.cosh (t * ω E μ 2) * x 2 - Real.sinh (t * ω E μ 2) * x 6
  | 3 => Real.cosh (t * ω E μ 3) * x 3 - Real.sinh (t * ω E μ 3) * x 7
  | 4 => -Real.sinh (t * ω E μ 0) * x 0 + Real.cosh (t * ω E μ 0) * x 4
  | 5 => -Real.sinh (t * ω E μ 1) * x 1 + Real.cosh (t * ω E μ 1) * x 5
  | 6 => -Real.sinh (t * ω E μ 2) * x 2 + Real.cosh (t * ω E μ 2) * x 6
  | 7 => -Real.sinh (t * ω E μ 3) * x 3 + Real.cosh (t * ω E μ 3) * x 7

theorem boostFun_zero (x : Fin 8 → ℝ) :
    boostFun E μ 0 x = x := by
  ext j
  fin_cases j <;> simp [boostFun]

theorem boostFun_comp (s t : ℝ) (x : Fin 8 → ℝ) :
    boostFun E μ t (boostFun E μ s x) = boostFun E μ (t + s) x := by
  ext j
  fin_cases j <;>
    simp [boostFun, Real.cosh_add, Real.sinh_add, add_mul,
      mul_add, sub_eq_add_neg] <;> ring

theorem continuous_boostFun (x : Fin 8 → ℝ) :
    Continuous (fun t : ℝ => boostFun E μ t x) := by
  refine continuous_pi fun j => ?_
  fin_cases j <;> simp only [boostFun]
  all_goals fun_prop

lemma boostFun_add (t : ℝ) (x y : Fin 8 → ℝ) :
    boostFun E μ t (x + y) = boostFun E μ t x + boostFun E μ t y := by
  ext j; fin_cases j <;> simp [boostFun, Pi.add_apply] <;> ring

lemma boostFun_smul (t c : ℝ) (x : Fin 8 → ℝ) :
    boostFun E μ t (c • x) = c • boostFun E μ t x := by
  ext j; fin_cases j <;> simp [boostFun, Pi.smul_apply] <;> ring

/-- The exact continuous time evolution is an isometry of the split quadratic form. -/
theorem boostFun_preserves_Q (t : ℝ) (x : Fin 8 → ℝ) :
    splitQ44 (boostFun E μ t x) = splitQ44 x := by
  have h0 : Real.cosh (t * ω E μ 0) ^ 2 - Real.sinh (t * ω E μ 0) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 0)
  have h1 : Real.cosh (t * ω E μ 1) ^ 2 - Real.sinh (t * ω E μ 1) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 1)
  have h2 : Real.cosh (t * ω E μ 2) ^ 2 - Real.sinh (t * ω E μ 2) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 2)
  have h3 : Real.cosh (t * ω E μ 3) ^ 2 - Real.sinh (t * ω E μ 3) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 3)
  simp [splitQ44_apply, boostFun]
  calc
    (Real.cosh (t * ω E μ 0) * x 0 - Real.sinh (t * ω E μ 0) * x 4) *
            (Real.cosh (t * ω E μ 0) * x 0 - Real.sinh (t * ω E μ 0) * x 4) +
          (Real.cosh (t * ω E μ 1) * x 1 - Real.sinh (t * ω E μ 1) * x 5) *
            (Real.cosh (t * ω E μ 1) * x 1 - Real.sinh (t * ω E μ 1) * x 5) +
        (Real.cosh (t * ω E μ 2) * x 2 - Real.sinh (t * ω E μ 2) * x 6) *
          (Real.cosh (t * ω E μ 2) * x 2 - Real.sinh (t * ω E μ 2) * x 6) +
      (Real.cosh (t * ω E μ 3) * x 3 - Real.sinh (t * ω E μ 3) * x 7) *
        (Real.cosh (t * ω E μ 3) * x 3 - Real.sinh (t * ω E μ 3) * x 7) -
    ((-(Real.sinh (t * ω E μ 0) * x 0) + Real.cosh (t * ω E μ 0) * x 4) *
            (-(Real.sinh (t * ω E μ 0) * x 0) + Real.cosh (t * ω E μ 0) * x 4) +
          (-(Real.sinh (t * ω E μ 1) * x 1) + Real.cosh (t * ω E μ 1) * x 5) *
            (-(Real.sinh (t * ω E μ 1) * x 1) + Real.cosh (t * ω E μ 1) * x 5) +
        (-(Real.sinh (t * ω E μ 2) * x 2) + Real.cosh (t * ω E μ 2) * x 6) *
          (-(Real.sinh (t * ω E μ 2) * x 2) + Real.cosh (t * ω E μ 2) * x 6) +
      (-(Real.sinh (t * ω E μ 3) * x 3) + Real.cosh (t * ω E μ 3) * x 7) *
        (-(Real.sinh (t * ω E μ 3) * x 3) + Real.cosh (t * ω E μ 3) * x 7))
    = (Real.cosh (t * ω E μ 0) ^ 2 - Real.sinh (t * ω E μ 0) ^ 2) * (x 0 * x 0 - x 4 * x 4) +
      (Real.cosh (t * ω E μ 1) ^ 2 - Real.sinh (t * ω E μ 1) ^ 2) * (x 1 * x 1 - x 5 * x 5) +
      (Real.cosh (t * ω E μ 2) ^ 2 - Real.sinh (t * ω E μ 2) ^ 2) * (x 2 * x 2 - x 6 * x 6) +
      (Real.cosh (t * ω E μ 3) ^ 2 - Real.sinh (t * ω E μ 3) ^ 2) * (x 3 * x 3 - x 7 * x 7) := by ring
    _ = 1 * (x 0 * x 0 - x 4 * x 4) + 1 * (x 1 * x 1 - x 5 * x 5) +
        1 * (x 2 * x 2 - x 6 * x 6) + 1 * (x 3 * x 3 - x 7 * x 7) := by rw [h0, h1, h2, h3]
    _ = x 0 * x 0 + x 1 * x 1 + x 2 * x 2 + x 3 * x 3 - (x 4 * x 4 + x 5 * x 5 + x 6 * x 6 + x 7 * x 7) := by ring

/-- The boost function is a linear equivalence on the vector space. -/
noncomputable def boostIsometryEquiv (t : ℝ) : QuadraticMap.IsometryEquiv splitQ44 splitQ44 where
  toFun := boostFun E μ t
  invFun := boostFun E μ (-t)
  map_add' := boostFun_add E μ t
  map_smul' := boostFun_smul E μ t
  left_inv x := by
    ext j
    have h0 : Real.cosh (t * ω E μ 0) ^ 2 - Real.sinh (t * ω E μ 0) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 0)
    have h1 : Real.cosh (t * ω E μ 1) ^ 2 - Real.sinh (t * ω E μ 1) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 1)
    have h2 : Real.cosh (t * ω E μ 2) ^ 2 - Real.sinh (t * ω E μ 2) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 2)
    have h3 : Real.cosh (t * ω E μ 3) ^ 2 - Real.sinh (t * ω E μ 3) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 3)
    fin_cases j <;> simp [boostFun, neg_mul, Real.cosh_neg, Real.sinh_neg]
    · calc Real.cosh (t * ω E μ 0) * (Real.cosh (t * ω E μ 0) * x 0 - Real.sinh (t * ω E μ 0) * x 4) + Real.sinh (t * ω E μ 0) * (-(Real.sinh (t * ω E μ 0) * x 0) + Real.cosh (t * ω E μ 0) * x 4) = (Real.cosh (t * ω E μ 0) ^ 2 - Real.sinh (t * ω E μ 0) ^ 2) * x 0 := by ring
      _ = 1 * x 0 := by rw [h0]
      _ = x 0 := by ring
    · calc Real.cosh (t * ω E μ 1) * (Real.cosh (t * ω E μ 1) * x 1 - Real.sinh (t * ω E μ 1) * x 5) + Real.sinh (t * ω E μ 1) * (-(Real.sinh (t * ω E μ 1) * x 1) + Real.cosh (t * ω E μ 1) * x 5) = (Real.cosh (t * ω E μ 1) ^ 2 - Real.sinh (t * ω E μ 1) ^ 2) * x 1 := by ring
      _ = 1 * x 1 := by rw [h1]
      _ = x 1 := by ring
    · calc Real.cosh (t * ω E μ 2) * (Real.cosh (t * ω E μ 2) * x 2 - Real.sinh (t * ω E μ 2) * x 6) + Real.sinh (t * ω E μ 2) * (-(Real.sinh (t * ω E μ 2) * x 2) + Real.cosh (t * ω E μ 2) * x 6) = (Real.cosh (t * ω E μ 2) ^ 2 - Real.sinh (t * ω E μ 2) ^ 2) * x 2 := by ring
      _ = 1 * x 2 := by rw [h2]
      _ = x 2 := by ring
    · calc Real.cosh (t * ω E μ 3) * (Real.cosh (t * ω E μ 3) * x 3 - Real.sinh (t * ω E μ 3) * x 7) + Real.sinh (t * ω E μ 3) * (-(Real.sinh (t * ω E μ 3) * x 3) + Real.cosh (t * ω E μ 3) * x 7) = (Real.cosh (t * ω E μ 3) ^ 2 - Real.sinh (t * ω E μ 3) ^ 2) * x 3 := by ring
      _ = 1 * x 3 := by rw [h3]
      _ = x 3 := by ring
    · calc Real.sinh (t * ω E μ 0) * (Real.cosh (t * ω E μ 0) * x 0 - Real.sinh (t * ω E μ 0) * x 4) + Real.cosh (t * ω E μ 0) * (-(Real.sinh (t * ω E μ 0) * x 0) + Real.cosh (t * ω E μ 0) * x 4) = (Real.cosh (t * ω E μ 0) ^ 2 - Real.sinh (t * ω E μ 0) ^ 2) * x 4 := by ring
      _ = 1 * x 4 := by rw [h0]
      _ = x 4 := by ring
    · calc Real.sinh (t * ω E μ 1) * (Real.cosh (t * ω E μ 1) * x 1 - Real.sinh (t * ω E μ 1) * x 5) + Real.cosh (t * ω E μ 1) * (-(Real.sinh (t * ω E μ 1) * x 1) + Real.cosh (t * ω E μ 1) * x 5) = (Real.cosh (t * ω E μ 1) ^ 2 - Real.sinh (t * ω E μ 1) ^ 2) * x 5 := by ring
      _ = 1 * x 5 := by rw [h1]
      _ = x 5 := by ring
    · calc Real.sinh (t * ω E μ 2) * (Real.cosh (t * ω E μ 2) * x 2 - Real.sinh (t * ω E μ 2) * x 6) + Real.cosh (t * ω E μ 2) * (-(Real.sinh (t * ω E μ 2) * x 2) + Real.cosh (t * ω E μ 2) * x 6) = (Real.cosh (t * ω E μ 2) ^ 2 - Real.sinh (t * ω E μ 2) ^ 2) * x 6 := by ring
      _ = 1 * x 6 := by rw [h2]
      _ = x 6 := by ring
    · calc Real.sinh (t * ω E μ 3) * (Real.cosh (t * ω E μ 3) * x 3 - Real.sinh (t * ω E μ 3) * x 7) + Real.cosh (t * ω E μ 3) * (-(Real.sinh (t * ω E μ 3) * x 3) + Real.cosh (t * ω E μ 3) * x 7) = (Real.cosh (t * ω E μ 3) ^ 2 - Real.sinh (t * ω E μ 3) ^ 2) * x 7 := by ring
      _ = 1 * x 7 := by rw [h3]
      _ = x 7 := by ring
  right_inv x := by
    ext j
    have h0 : Real.cosh (t * ω E μ 0) ^ 2 - Real.sinh (t * ω E μ 0) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 0)
    have h1 : Real.cosh (t * ω E μ 1) ^ 2 - Real.sinh (t * ω E μ 1) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 1)
    have h2 : Real.cosh (t * ω E μ 2) ^ 2 - Real.sinh (t * ω E μ 2) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 2)
    have h3 : Real.cosh (t * ω E μ 3) ^ 2 - Real.sinh (t * ω E μ 3) ^ 2 = 1 := Real.cosh_sq_sub_sinh_sq (t * ω E μ 3)
    fin_cases j <;> simp [boostFun, neg_mul, Real.cosh_neg, Real.sinh_neg]
    · calc Real.cosh (t * ω E μ 0) * (Real.cosh (t * ω E μ 0) * x 0 + Real.sinh (t * ω E μ 0) * x 4) - Real.sinh (t * ω E μ 0) * (Real.sinh (t * ω E μ 0) * x 0 + Real.cosh (t * ω E μ 0) * x 4) = (Real.cosh (t * ω E μ 0) ^ 2 - Real.sinh (t * ω E μ 0) ^ 2) * x 0 := by ring
      _ = 1 * x 0 := by rw [h0]
      _ = x 0 := by ring
    · calc Real.cosh (t * ω E μ 1) * (Real.cosh (t * ω E μ 1) * x 1 + Real.sinh (t * ω E μ 1) * x 5) - Real.sinh (t * ω E μ 1) * (Real.sinh (t * ω E μ 1) * x 1 + Real.cosh (t * ω E μ 1) * x 5) = (Real.cosh (t * ω E μ 1) ^ 2 - Real.sinh (t * ω E μ 1) ^ 2) * x 1 := by ring
      _ = 1 * x 1 := by rw [h1]
      _ = x 1 := by ring
    · calc Real.cosh (t * ω E μ 2) * (Real.cosh (t * ω E μ 2) * x 2 + Real.sinh (t * ω E μ 2) * x 6) - Real.sinh (t * ω E μ 2) * (Real.sinh (t * ω E μ 2) * x 2 + Real.cosh (t * ω E μ 2) * x 6) = (Real.cosh (t * ω E μ 2) ^ 2 - Real.sinh (t * ω E μ 2) ^ 2) * x 2 := by ring
      _ = 1 * x 2 := by rw [h2]
      _ = x 2 := by ring
    · calc Real.cosh (t * ω E μ 3) * (Real.cosh (t * ω E μ 3) * x 3 + Real.sinh (t * ω E μ 3) * x 7) - Real.sinh (t * ω E μ 3) * (Real.sinh (t * ω E μ 3) * x 3 + Real.cosh (t * ω E μ 3) * x 7) = (Real.cosh (t * ω E μ 3) ^ 2 - Real.sinh (t * ω E μ 3) ^ 2) * x 3 := by ring
      _ = 1 * x 3 := by rw [h3]
      _ = x 3 := by ring
    · calc -(Real.sinh (t * ω E μ 0) * (Real.cosh (t * ω E μ 0) * x 0 + Real.sinh (t * ω E μ 0) * x 4)) + Real.cosh (t * ω E μ 0) * (Real.sinh (t * ω E μ 0) * x 0 + Real.cosh (t * ω E μ 0) * x 4) = (Real.cosh (t * ω E μ 0) ^ 2 - Real.sinh (t * ω E μ 0) ^ 2) * x 4 := by ring
      _ = 1 * x 4 := by rw [h0]
      _ = x 4 := by ring
    · calc -(Real.sinh (t * ω E μ 1) * (Real.cosh (t * ω E μ 1) * x 1 + Real.sinh (t * ω E μ 1) * x 5)) + Real.cosh (t * ω E μ 1) * (Real.sinh (t * ω E μ 1) * x 1 + Real.cosh (t * ω E μ 1) * x 5) = (Real.cosh (t * ω E μ 1) ^ 2 - Real.sinh (t * ω E μ 1) ^ 2) * x 5 := by ring
      _ = 1 * x 5 := by rw [h1]
      _ = x 5 := by ring
    · calc -(Real.sinh (t * ω E μ 2) * (Real.cosh (t * ω E μ 2) * x 2 + Real.sinh (t * ω E μ 2) * x 6)) + Real.cosh (t * ω E μ 2) * (Real.sinh (t * ω E μ 2) * x 2 + Real.cosh (t * ω E μ 2) * x 6) = (Real.cosh (t * ω E μ 2) ^ 2 - Real.sinh (t * ω E μ 2) ^ 2) * x 6 := by ring
      _ = 1 * x 6 := by rw [h2]
      _ = x 6 := by ring
    · calc -(Real.sinh (t * ω E μ 3) * (Real.cosh (t * ω E μ 3) * x 3 + Real.sinh (t * ω E μ 3) * x 7)) + Real.cosh (t * ω E μ 3) * (Real.sinh (t * ω E μ 3) * x 3 + Real.cosh (t * ω E μ 3) * x 7) = (Real.cosh (t * ω E μ 3) ^ 2 - Real.sinh (t * ω E μ 3) ^ 2) * x 7 := by ring
      _ = 1 * x 7 := by rw [h3]
      _ = x 7 := by ring
  map_app' x := boostFun_preserves_Q E μ t x

/-- 
The continuous 1-parameter modular automorphism group (KMS flow) on the exact
operator algebra `Cl(4,4)`. Constructed purely natively via Mathlib.
-/
noncomputable def modularFlow (t : ℝ) : Cl44 ≃ₐ[ℝ] Cl44 :=
  CliffordAlgebra.equivOfIsometry (boostIsometryEquiv E μ t)

/-- The flow exactly scales the annihilation operators (the birth of Time). -/
theorem modularFlow_aVec (t : ℝ) (i : Fin 4) :
    boostFun E μ t (aVec i) = (Real.cosh (t * ω E μ i) - Real.sinh (t * ω E μ i)) • aVec i := by
  ext j
  have h_exp : Real.cosh (t * ω E μ i) - Real.sinh (t * ω E μ i) = Real.exp (-(t * ω E μ i)) := by
    rw [Real.cosh_eq, Real.sinh_eq]
    ring
  fin_cases i <;> fin_cases j <;> simp [boostFun, aVec, eVec, fVec, Pi.smul_apply, Pi.add_apply, Real.cosh_eq, Real.sinh_eq] <;> ring

/-- The flow exactly scales the creation operators. -/
theorem modularFlow_adagVec (t : ℝ) (i : Fin 4) :
    boostFun E μ t (adagVec i) = (Real.cosh (t * ω E μ i) + Real.sinh (t * ω E μ i)) • adagVec i := by
  ext j
  have h_exp : Real.cosh (t * ω E μ i) + Real.sinh (t * ω E μ i) = Real.exp (t * ω E μ i) := by
    rw [Real.cosh_eq, Real.sinh_eq]
    ring
  fin_cases i <;> fin_cases j <;> simp [boostFun, adagVec, eVec, fVec, Pi.smul_apply, Pi.sub_apply, Real.cosh_eq, Real.sinh_eq] <;> ring

end InfoGeometry.Canonical.TopologicalKMSFlow
