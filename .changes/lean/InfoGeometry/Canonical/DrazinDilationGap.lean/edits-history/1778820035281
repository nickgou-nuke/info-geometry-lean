{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Canonical/DrazinDilationGap.lean","time":1778820035281,"baseTime":1778820034555,"changes":[{"range":{"start":{"line":112,"character":0},"end":{"line":113,"character":0}},"text":"  rw [G.G_def, hSupport]\n  simp only [sub_self]\n  exact hzero\n\n/--\nModular persistence of the Drazin support.\n\nThe regular support P_D is physically stable when it is a modular zero-mode.\nThe \"noise\" (defect sector) is everything that fails this invariance.\n-/\nstructure ModularPersistenceData\n    (Op : Type*)\n    [Ring Op]\n    [Star Op] where\n\n  drazin :\n    DrazinData Op\n\n  flow :\n    InfoGeometry.OperatorAlgebra.OperatorThermodynamics.OperatorFlow Op\n\n  /--\n  The regular support P_D is a modular zero-mode.\n  -/\n  is_modularly_stable :\n    ∀ t : ℝ, flow.flow t drazin.P_D = drazin.P_D\n\n/--\nThe \"noise\" (defect Q₀) is also modularly stable if the support P_D is.\n-/\ntheorem defect_modularly_stable\n    {Op : Type*}\n    [Ring Op]\n    [Star Op]\n    (M : ModularPersistenceData Op)\n    (hMulti : ∀ t : ℝ, ∀ x y : Op, M.flow.flow t (x * y) = M.flow.flow t x * M.flow.flow t y)\n    (hOne : ∀ t : ℝ, M.flow.flow t (1 : Op) = 1) :\n    ∀ t : ℝ, M.flow.flow t M.drazin.Q0 = M.drazin.Q0 := by\n  intro t\n  rw [M.drazin.Q0_def]\n  have hsub : ∀ t : ℝ, ∀ x y : Op, M.flow.flow t (x - y) = M.flow.flow t x - M.flow.flow t y := by\n    -- In an OperatorFlow, multiplicativity is often assumed.\n    -- If it's a ring-homomorphism for each t:\n    sorry \n  rw [hsub, hOne, M.is_modularly_stable]\n","rangeOffset":3173,"rangeLength":40}]}