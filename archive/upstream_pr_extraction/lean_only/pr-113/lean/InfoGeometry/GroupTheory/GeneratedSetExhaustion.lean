import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Data.Set.Basic

/-!
# Generated-set exhaustion

Generic group-theoretic lemmas for proving that a subset contains the subgroup
generated by elements whose left translations preserve the subset.
-/

namespace InfoGeometry.GroupTheory.GeneratedSetExhaustion

variable {G : Type*} [Group G]

/-- The subgroup of elements whose left translation preserves membership in `U`
in both directions. -/
def leftStabilizer (U : Set G) : Subgroup G where
  carrier := {g | ∀ x, x ∈ U ↔ g * x ∈ U}
  one_mem' := by
    intro x
    simp
  mul_mem' := by
    intro g h hg hh x
    simpa [mul_assoc] using (hh x).trans (hg (h * x))
  inv_mem' := by
    intro g hg x
    have hx := (hg (g⁻¹ * x)).symm
    simpa [mul_assoc] using hx

@[simp]
theorem mem_leftStabilizer_iff (U : Set G) (g : G) :
    g ∈ leftStabilizer U ↔ ∀ x, x ∈ U ↔ g * x ∈ U :=
  Iff.rfl

/-- One-way invariance under an involution upgrades to two-way membership
preservation. -/
theorem mem_leftStabilizer_of_involution_mapsTo
    (U : Set G) (s : G)
    (hsq : s * s = 1)
    (hmap : Set.MapsTo (fun x => s * x) U U) :
    s ∈ leftStabilizer U := by
  intro x
  constructor
  · intro hx
    exact hmap hx
  · intro hsx
    have hback : s * (s * x) ∈ U := hmap hsx
    simpa [← mul_assoc, hsq] using hback

/-- If `1 ∈ U` and every generator stabilizes `U`, then every element of the
subgroup generated by those generators belongs to `U`. -/
theorem mem_of_mem_closure_of_stabilizes
    (U : Set G) (h1 : (1 : G) ∈ U)
    (S : Set G)
    (hstab : S ⊆ (leftStabilizer U : Set G))
    {g : G} (hg : g ∈ Subgroup.closure S) :
    g ∈ U := by
  have hclosure : Subgroup.closure S ≤ leftStabilizer U :=
    (Subgroup.closure_le (leftStabilizer U)).2 hstab
  have hgstab : g ∈ leftStabilizer U := hclosure hg
  have h_eval := ((mem_leftStabilizer_iff U g).mp hgstab 1).mp h1
  simpa using h_eval

/-- Variant where the generators are involutions and only one-way left
invariance is supplied. -/
theorem mem_of_mem_closure_of_involutive_mapsTo
    (U : Set G) (h1 : (1 : G) ∈ U)
    (S : Set G)
    (hinvol : ∀ s ∈ S, s * s = 1)
    (hmap : ∀ s ∈ S, Set.MapsTo (fun x => s * x) U U)
    {g : G} (hg : g ∈ Subgroup.closure S) :
    g ∈ U := by
  apply mem_of_mem_closure_of_stabilizes U h1 S
  · intro s hs
    exact mem_leftStabilizer_of_involution_mapsTo
      U s (hinvol s hs) (hmap s hs)
  · exact hg

/-- If a stabilizing generating set generates all of `G`, then `U` is the
whole group. -/
theorem exhaustion_of_closure_top
    (U : Set G) (h1 : (1 : G) ∈ U)
    (S : Set G) (hgen : Subgroup.closure S = ⊤)
    (hstab : S ⊆ (leftStabilizer U : Set G)) :
    U = Set.univ := by
  ext g
  simp only [Set.mem_univ, iff_true]
  apply mem_of_mem_closure_of_stabilizes U h1 S hstab
  rw [hgen]
  exact Subgroup.mem_top g

end InfoGeometry.GroupTheory.GeneratedSetExhaustion
