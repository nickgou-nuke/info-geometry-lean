import Architect
import InfoGeometry.Canonical.Promoted.CayleyBregmanBridge
import Mathlib.Analysis.Calculus.FDeriv.Basic
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Tactic.Linarith

/-!
# The Grand Unification of the Physics of Information in Lean 4

Core formal layer for the grand-unification thesis:
dually-flat information geometry, Jordan/KKT barrier structure, and Bregman/Fenchel identities.
-/

namespace InfoGeometry.Research.GrandUnification

open InfoGeometry.Geometry.DualFlat

/-- Data for a Jordan/KKT barrier model on an ambient space `E`. -/
@[blueprint "def:jordan-kkt-data"]
structure JordanKKTData (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] where
  detJ : E → ℝ
  detJ_pos : ∀ x, 0 < detJ x
  gradK : E → E
  /-- Specification that gradK represents the gradient of the barrier potential K = -log detJ. -/
  has_gradient : ∀ x, HasFDerivAt (fun y => - Real.log (detJ y)) (InnerProductSpace.toDual ℝ E (gradK x)) x
  /-- Pointwise differentiability of `gradK` (Hessian exists pointwise). -/
  has_hessian : ∀ x, DifferentiableAt ℝ gradK x
  /-- Strict positivity of the Bregman divergence for distinct points. -/
  dbregman_pos_of_ne : ∀ x y, x ≠ y → 0 < (- Real.log (detJ x)) - (- Real.log (detJ y)) - inner ℝ (gradK y) (x - y)

namespace JordanKKTData

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- KKT/Jordan barrier potential. -/
noncomputable def K (J : JordanKKTData E) (x : E) : ℝ :=
  - Real.log (J.detJ x)

/-- Dual coordinate map: θ(x) = ∇K(x). -/
noncomputable def dualCoord (J : JordanKKTData E) (x : E) : E :=
  J.gradK x

/--
The dual potential K*(θ) defined as the Fenchel conjugate of K.
In the context of grand unification, this corresponds to the Legendre transform.
This definition uses the Hilbert space (Riesz) identification to define the conjugate on the primal space.
-/
noncomputable def dualPotential (J : JordanKKTData E) (θ : E) : ℝ :=
  sSup { r : ℝ | ∃ x : E, r = inner ℝ x θ - J.K x }

@[simp] theorem dualPotential_def (J : JordanKKTData E) (θ : E) :
    J.dualPotential θ = sSup { r : ℝ | ∃ x : E, r = inner ℝ x θ - J.K x } := rfl

/-- Bregman divergence generated by the barrier potential `K`. -/
noncomputable def DBregman (J : JordanKKTData E) (x y : E) : ℝ :=
  J.K x - J.K y - inner ℝ (J.gradK y) (x - y)

@[simp] theorem K_def (J : JordanKKTData E) (x : E) :
    J.K x = - Real.log (J.detJ x) := rfl

@[simp] theorem DBregman_def (J : JordanKKTData E) (x y : E) :
    J.DBregman x y = J.K x - J.K y - inner ℝ (J.gradK y) (x - y) := rfl

@[simp] theorem DBregman_self (J : JordanKKTData E) (x : E) :
    J.DBregman x x = 0 := by
  simp [DBregman]

/-- Gradient specification theorem for the barrier potential. -/
@[simp] theorem hasFDerivAt_K (J : JordanKKTData E) (x : E) :
    HasFDerivAt J.K (InnerProductSpace.toDual ℝ E (J.gradK x)) x := by
  simpa [K] using J.has_gradient x

/-- The Bregman divergence is strictly positive for distinct points. -/
theorem DBregman_pos (J : JordanKKTData E) {x y : E} (h : x ≠ y) :
    0 < J.DBregman x y := by
  simpa [DBregman, K] using J.dbregman_pos_of_ne x y h

/-- The Bregman divergence is always non-negative. -/
theorem DBregman_nonneg (J : JordanKKTData E) (x y : E) : 0 ≤ J.DBregman x y := by
  by_cases h : x = y
  · rw [h]
    simp
  · exact le_of_lt (J.DBregman_pos h)

/-- The fundamental identity of Bregman geometry: distance is zero iff points are identical. -/
@[blueprint "thm:grand-unification-bregman-identity", simp]
theorem DBregman_eq_zero_iff (J : JordanKKTData E) (x y : E) :
    J.DBregman x y = 0 ↔ x = y := by
  constructor
  · intro h
    by_contra hne
    -- If x ≠ y, then DBregman > 0, which contradicts DBregman = 0
    have hpos := J.DBregman_pos hne
    linarith [hpos, h]
  · rintro rfl
    exact J.DBregman_self x

/--
The Fenchel-Young equality case: when θ is the gradient of K at x,
the dual potential satisfies K(x) + K*(θ) = ⟨x, θ⟩.
This identity holds by the strict supporting hyperplane property assumed in `dbregman_pos_of_ne`.
-/
@[blueprint "thm:grand-unification-fenchel-young-equality"]
theorem fenchel_young_equality (J : JordanKKTData E) (x : E)
    (h_bdd : BddAbove { r : ℝ | ∃ x' : E, r = inner ℝ x' (J.gradK x) - J.K x' }) :
    J.K x + J.dualPotential (J.gradK x) = inner ℝ x (J.gradK x) := by
  let S : Set ℝ := { r : ℝ | ∃ x' : E, r = inner ℝ x' (J.gradK x) - J.K x' }
  have hSbdd : BddAbove S := by
    simpa [S] using h_bdd
  have hx_mem : inner ℝ x (J.gradK x) - J.K x ∈ S := by
    exact ⟨x, rfl⟩
  have hSnempty : S.Nonempty := ⟨_, hx_mem⟩
  have h_upper : ∀ r ∈ S, r ≤ inner ℝ x (J.gradK x) - J.K x := by
    intro r hr
    rcases hr with ⟨x', rfl⟩
    by_cases hxeq : x' = x
    · subst hxeq
      exact le_rfl
    · have hpos : 0 < J.K x' - J.K x - inner ℝ (J.gradK x) (x' - x) := by
        simpa [K] using J.dbregman_pos_of_ne x' x hxeq
      rw [inner_sub_right] at hpos
      have hlt' : inner ℝ (J.gradK x) x' - J.K x' < inner ℝ (J.gradK x) x - J.K x := by
        linarith
      have hlt : inner ℝ x' (J.gradK x) - J.K x' < inner ℝ x (J.gradK x) - J.K x := by
        simpa [real_inner_comm] using hlt'
      exact le_of_lt hlt
  have hsSup_le : sSup S ≤ inner ℝ x (J.gradK x) - J.K x := by
    exact csSup_le hSnempty h_upper
  have hle_sSup : inner ℝ x (J.gradK x) - J.K x ≤ sSup S := by
    exact le_csSup hSbdd hx_mem
  have hdual : J.dualPotential (J.gradK x) = inner ℝ x (J.gradK x) - J.K x := by
    have hsSup_eq : sSup S = inner ℝ x (J.gradK x) - J.K x := by
      exact le_antisymm hsSup_le hle_sSup
    simpa [dualPotential, S] using hsSup_eq
  linarith [hdual]

/-- Helper lemma for the dual potential at a gradient point. -/
@[simp] theorem dualPotential_grad_eq (J : JordanKKTData E) (x : E)
    (h_bdd : BddAbove { r : ℝ | ∃ x' : E, r = inner ℝ x' (J.gradK x) - J.K x' }) :
    J.dualPotential (J.gradK x) = inner ℝ x (J.gradK x) - J.K x := by
  have hFY := J.fenchel_young_equality x h_bdd
  linarith

/--
The "mixed" identity for Bregman divergence:
D_K(x, y) = K(x) + K*(θ_y) - ⟨x, θ_y⟩
where θ_y = ∇K(y).
-/
@[blueprint "thm:grand-unification-mixed-bregman"]
theorem mixed_bregman_identity (J : JordanKKTData E) (x y : E)
    (h_bdd : BddAbove { r : ℝ | ∃ x' : E, r = inner ℝ x' (J.gradK y) - J.K x' }) :
    J.DBregman x y = J.K x + J.dualPotential (J.gradK y) - inner ℝ x (J.gradK y) := by
  rw [J.dualPotential_grad_eq y h_bdd]
  simp [DBregman, inner_sub_right]
  rw [real_inner_comm (J.gradK y) x, real_inner_comm (J.gradK y) y]
  linarith

/--
A mixed identity relating primal and dual potentials:
K*(θ_x) - K*(θ_y) - ⟨y, θ_x - θ_y⟩ = D_K(y, x).
This captures the dual structure using primal variables.
-/
@[blueprint "thm:grand-unification-dual-mixed-identity"]
theorem dual_potential_mixed_identity (J : JordanKKTData E) (x y : E)
    (h_bdd_x : BddAbove { r : ℝ | ∃ x' : E, r = inner ℝ x' (J.gradK x) - J.K x' })
    (h_bdd_y : BddAbove { r : ℝ | ∃ x' : E, r = inner ℝ x' (J.gradK y) - J.K x' }) :
    J.dualPotential (J.gradK x) - J.dualPotential (J.gradK y) - inner ℝ y (J.gradK x - J.gradK y) =
    J.DBregman y x := by
  rw [J.dualPotential_grad_eq x h_bdd_x, J.dualPotential_grad_eq y h_bdd_y]
  rw [DBregman, inner_sub_right, inner_sub_right]
  rw [real_inner_comm (J.gradK x) y, real_inner_comm (J.gradK x) x]
  linarith

/--
The three-point law of Bregman geometry:
D(x, y) + D(y, z) - D(x, z) = ⟨∇K(z) - ∇K(y), x - y⟩.
This is the basis for the generalized Pythagoras theorem.
-/
@[blueprint "thm:grand-unification-three-point-law"]
theorem three_point_law (J : JordanKKTData E) (x y z : E) :
    J.DBregman x y + J.DBregman y z - J.DBregman x z =
    inner ℝ (J.gradK z - J.gradK y) (x - y) := by
  have hxz : x - z = (x - y) + (y - z) := by
    simp [sub_eq_add_neg, add_assoc, add_left_comm]
  rw [DBregman, DBregman, DBregman, inner_sub_left, hxz, inner_add_right]
  linarith

/--
Three points `x, y, z` are Bregman-orthogonal if the primal segment from `x` to `y`
is orthogonal to the dual segment from `θ_y` to `θ_z`.
Formally: ⟨∇K(z) - ∇K(y), x - y⟩ = 0.
-/
def IsBregmanOrthogonal (J : JordanKKTData E) (x y z : E) : Prop :=
  inner ℝ (J.gradK z - J.gradK y) (x - y) = 0

/--
The Generalized Pythagorean Theorem:
If x, y, z are Bregman-orthogonal, then D(x, y) + D(y, z) = D(x, z).
-/
@[blueprint "thm:grand-unification-pythagoras"]
theorem generalized_pythagorean_theorem (J : JordanKKTData E) (x y z : E)
    (h_ortho : J.IsBregmanOrthogonal x y z) :
    J.DBregman x y + J.DBregman y z = J.DBregman x z := by
  have h_law := J.three_point_law x y z
  rw [h_ortho] at h_law
  linarith

/--
A point `y` is the Bregman projection of `z` onto a set `C` if it satisfies
the variational inequality: ⟨∇K(z) - ∇K(y), x - y⟩ ≤ 0 for all x ∈ C.
-/
def IsBregmanProjection (J : JordanKKTData E) (C : Set E) (z : E) (y : E) : Prop :=
  y ∈ C ∧ ∀ x ∈ C, inner ℝ (J.gradK z - J.gradK y) (x - y) ≤ 0

/--
The Generalized Pythagorean Inequality:
If `y` is the Bregman projection of `z` onto `C`, then for any `x ∈ C`,
D_K(x, y) + D_K(y, z) ≤ D_K(x, z).
-/
@[blueprint "thm:grand-unification-pythagoras-ineq"]
theorem pythagorean_inequality (J : JordanKKTData E) {C : Set E} {z y : E}
    (h_proj : J.IsBregmanProjection C z y) (x : E) (hx : x ∈ C) :
    J.DBregman x y + J.DBregman y z ≤ J.DBregman x z := by
  have h_law := J.three_point_law x y z
  have h_vi := h_proj.2 x hx
  linarith

/--
The Bregman projection minimizes the divergence D_K(x, z) over x ∈ C.
-/
@[blueprint "thm:grand-unification-projection-min"]
theorem projection_minimizes (J : JordanKKTData E) {C : Set E} {z y : E}
    (h_proj : J.IsBregmanProjection C z y) (x : E) (hx : x ∈ C) :
    J.DBregman y z ≤ J.DBregman x z := by
  have h_ineq := J.pythagorean_inequality h_proj x hx
  have h_nonneg := J.DBregman_nonneg x y
  linarith

/--
Uniqueness of the Bregman projection:
If two points both satisfy the variational inequality for the same set and target, they must be equal.
-/
@[blueprint "thm:grand-unification-projection-unique"]
theorem projection_unique (J : JordanKKTData E) {C : Set E} {z y₁ y₂ : E}
    (h₁ : J.IsBregmanProjection C z y₁) (h₂ : J.IsBregmanProjection C z y₂) :
    y₁ = y₂ := by
  have ineq1 := J.pythagorean_inequality h₁ y₂ h₂.1
  have ineq2 := J.pythagorean_inequality h₂ y₁ h₁.1
  have h_sum : J.DBregman y₁ y₂ + J.DBregman y₂ y₁ ≤ 0 := by linarith
  have h_nonneg1 := J.DBregman_nonneg y₁ y₂
  have h_nonneg2 := J.DBregman_nonneg y₂ y₁
  have h_zero : J.DBregman y₁ y₂ = 0 := by linarith
  exact (J.DBregman_eq_zero_iff y₁ y₂).mp h_zero

end JordanKKTData

/--
Compatibility witness saying an existing `DualFlatStructure` is exactly the
Jordan/KKT Bregman geometry generated by `J`.
-/
structure IsJordanKKTGeometry
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (J : JordanKKTData E) (S : DualFlatStructure E) : Prop where
  D_eq_DBregman : ∀ x y, divergence S x y = J.DBregman x y

/-- Machine-checked bridge theorem for grand unification. -/
@[blueprint "thm:grand-unification-divergence", simp]
theorem geometry_divergence_eq_jordan_bregman
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (J : JordanKKTData E) (S : DualFlatStructure E)
    (hJG : IsJordanKKTGeometry J S) (x y : E) :
    divergence S x y = J.DBregman x y :=
  hJG.D_eq_DBregman x y

end InfoGeometry.Research.GrandUnification
