import InfoGeometry.Meta.Architecture
import InfoGeometry.Canonical.TopologicalGapShadow
import Mathlib

/-!
# InfoGeometry.Canonical.SuperchargeHoppingBridge

Naming bridge from the odd-odd anticommutator lane to the discrete hopping
operator already owned by `TopologicalGapShadow`.

This file does not introduce new physics. It only records that the discrete
SUSY hopping operator is exactly the odd-odd closure `{Q,Q†}`.
-/

namespace InfoGeometry.Canonical.SuperchargeHoppingBridge

open InfoGeometry.Canonical.TopologicalGapShadow

section Core

variable {E : Type _} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "EndH" => E →L[ℝ] E

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance

/-- The odd-odd anticommutator lane. -/
@[rep_depth operator]
noncomputable def oddOddBracket (Qi Qj : EndH) : EndH :=
  Qi * Qj + Qj * Qi

/-- The discrete hopping operator is the odd-odd closure `{Q,Q†}`. -/
@[rep_depth operator]
theorem susyHoppingOperator_eq_oddOddBracket_adjoint
    (Q : EndH) :
    susyHoppingOperator Q =
      oddOddBracket Q (ContinuousLinearMap.adjoint Q) := by
  unfold susyHoppingOperator oddOddBracket
  ring

/-- Naming alias for the hopping translation candidate generated by a supercharge. -/
@[rep_depth operator]
noncomputable def hoppingTranslationCandidate (Q : EndH) : EndH :=
  oddOddBracket Q (ContinuousLinearMap.adjoint Q)

/-- The naming alias agrees with the already-owned SUSY hopping operator. -/
@[rep_depth operator]
theorem hoppingTranslationCandidate_eq_susyHoppingOperator
    (Q : EndH) :
    hoppingTranslationCandidate Q = susyHoppingOperator Q := by
  symm
  exact susyHoppingOperator_eq_oddOddBracket_adjoint (Q := Q)

end Core

end InfoGeometry.Canonical.SuperchargeHoppingBridge
