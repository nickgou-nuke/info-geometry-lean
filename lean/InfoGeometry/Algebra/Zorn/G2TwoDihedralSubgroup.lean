import InfoGeometry.Algebra.Zorn.G2TwoExplicitGenerators
import InfoGeometry.Algebra.Zorn.G2TwoBasisRigidity
import Mathlib.Tactic

/-!
# The concrete dihedral subgroup generated by the two simple-root automorphisms

This owner closes the finite subgroup generated by the two already certified
involutions.  It proves an exact order eight result by a normal-form argument;
no enumeration of the 256-element carrier or of the full automorphism group is
used.
-/

namespace InfoGeometry.Algebra.Zorn.G2Unipotent

open InfoGeometry.OperatorAlgebra.G2TwoAutomorphismTheorem

private def wordVal : Fin 8 → SplitOctF2Aut :=
  fun i => (eightRootSubgroupWords i : SplitOctF2Aut)

private theorem wordVal_mem (i : Fin 8) :
    wordVal i ∈ simpleRootSubgroup := by
  exact (eightRootSubgroupWords i).property

private theorem left_short_word (i : Fin 8) :
    ∃ j : Fin 8, unipotentShortAut true * wordVal i = wordVal j := by
  fin_cases i
  · exact ⟨4, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨7, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨5, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨6, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨0, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨2, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨3, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨1, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩

private theorem left_long_word (i : Fin 8) :
    ∃ j : Fin 8, unipotentLongAut true * wordVal i = wordVal j := by
  fin_cases i
  · exact ⟨7, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨5, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨6, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨4, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨3, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨1, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨2, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · exact ⟨0, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩

private theorem simpleRootSubgroup_mem_words
    (x : simpleRootSubgroup) :
    ∃ i : Fin 8, (x : SplitOctF2Aut) = wordVal i := by
  refine Subgroup.closure_induction_left (p := fun x _ =>
    ∃ i : Fin 8, x = wordVal i) ?_ ?_ ?_ x.property
  · exact ⟨0, automorphism_ext_of_basis _ _ (by intro k; fin_cases k <;> decide)⟩
  · intro y hy z hz hzword
    rcases hzword with ⟨i, rfl⟩
    rcases hy with rfl | rfl
    · exact left_short_word i
    · exact left_long_word i
  · intro y hy z hz hzword
    rcases hzword with ⟨i, rfl⟩
    rcases hy with rfl | rfl
    · simpa [unipotentShortAut_inv] using left_short_word i
    · simpa [unipotentLongAut_inv] using left_long_word i

/-- 🏆 THEOREM: The concrete dihedral subgroup generated by the two simple-root automorphisms has EXACT ORDER 8. -/
theorem simpleRootSubgroup_card_eq_eight :
    Fintype.card simpleRootSubgroup = 8 := by
  apply Nat.le_antisymm
  · let f : simpleRootSubgroup → Fin 8 := fun x =>
      Classical.choose (simpleRootSubgroup_mem_words x)
    have hf : Function.Injective f := by
      intro x y hxy
      apply Subtype.ext
      have hx : (x : SplitOctF2Aut) = wordVal (f x) := by
        exact Classical.choose_spec (simpleRootSubgroup_mem_words x)
      have hy : (y : SplitOctF2Aut) = wordVal (f y) := by
        exact Classical.choose_spec (simpleRootSubgroup_mem_words y)
      rw [hx, hy, hxy]
    have hcard := Fintype.card_le_of_injective f hf
    simpa using hcard
  · exact simpleRootSubgroup_card_lower_bound_eight

end InfoGeometry.Algebra.Zorn.G2Unipotent
