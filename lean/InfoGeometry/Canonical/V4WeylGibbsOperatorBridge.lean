import InfoGeometry.Canonical.V4GroupFourierTransform
import InfoGeometry.Canonical.CayleyPeirceKleinFourBridge
import InfoGeometry.Thermo.Gibbs
import Mathlib.Tactic

/-!
# V₄ character, Weyl-gauge Gibbs, and operator-sector bridge

This file joins existing finite owners without identifying their distinct
carriers: `V4GroupFourierTransform` supplies the order-four character transform,
`Thermo.Gibbs` supplies normalized finite Gibbs probabilities, and
`CayleyPeirceKleinFourBridge` supplies the four operator projectors and their
resolution of identity.  Weyl gauge factors are positive orbit weights; their
global scale changes the partition function but cancels from normalized Gibbs
weights.  Character coefficients are signed Fourier coordinates, not
probabilities in general.
-/

noncomputable section

namespace InfoGeometry.Canonical.V4WeylGibbsOperatorBridge

open scoped BigOperators
open InfoGeometry.Topology.V4RootSystem
open InfoGeometry.Canonical.V4GroupFourierTransform
open InfoGeometry.Canonical.CayleyPeirceKleinFourBridge

private theorem v4Group_mul_eq_table (g h : V4Group) :
    g * h = InfoGeometry.Topology.V4RootSystem.v4_mul g h := by
  cases g <;> cases h <;> rfl

/-- The concrete representation of the finite `V₄` generated by the two
commuting Cayley sign involutions on the existing coordinate carrier. -/
def cayleyV4Representation : V4Group →* CoordEnd where
  toFun
    | .I => 1
    | .W1 => P
    | .W2 => GammaF
    | .W12 => M_mid
  map_one' := rfl
  map_mul' := by
    intro g h
    rw [v4Group_mul_eq_table]
    cases g <;> cases h <;>
      simp [InfoGeometry.Topology.V4RootSystem.v4_mul, P, GammaF, M_mid,
        P_sq, GammaF_sq, M_mid_sq, P_comm_GammaF,
        GammaF_mul_P, GammaF_mul_M,
        M_mul_GammaF, M_mul_P, P_mul_M]

/-- The order of the native Klein group used by the character transform. -/
theorem v4Group_card : Fintype.card V4Group = 4 := by
  classical
  simpa using (Fintype.card_congr v4EquivFin).symm

/-- Normalized finite-group averaging operator for this actual Cayley
representation. The normalization uses the group order, not a guessed scale. -/
noncomputable def v4HaarAverage : CoordEnd :=
  (Fintype.card V4Group : ℝ)⁻¹ • ∑ g : V4Group, cayleyV4Representation g

/-- The unnormalized representation sum is the four-term Cayley projector
numerator. -/
theorem cayleyV4Representation_sum :
    (∑ g : V4Group, cayleyV4Representation g) = 1 + P + GammaF + M_mid := by
  classical
  rw [← Equiv.sum_comp v4EquivFin
    (fun g => cayleyV4Representation g)]
  simp [v4EquivFin, cayleyV4Representation, Fin.sum_univ_succ]
  abel

/-- The finite Haar average is exactly the trivial-character projector from
the existing operator-PoU owner. -/
theorem v4HaarAverage_eq_invariantProjector :
    v4HaarAverage = proj0 := by
  unfold v4HaarAverage
  rw [v4Group_card, cayleyV4Representation_sum]
  norm_num [proj0_eq_character_formula]

/-- The averaged operator is fixed by every group element, so its range lies
in the invariant sector. -/
theorem v4HaarAverage_fixed (g : V4Group) (x : Coord) :
    cayleyV4Representation g (v4HaarAverage x) = v4HaarAverage x := by
  rw [v4HaarAverage_eq_invariantProjector]
  cases g <;>
    simp [cayleyV4Representation, proj0, P, GammaF, M_mid,
      CayleyWittenPeirceParityBridge.peirceGrading,
      CayleyConjugationExteriorDualityBridge.chiralGrading,
      CayleyConjugationExteriorDualityBridge.middleSignFlip]

theorem v4HaarAverage_of_generators_fixed (x : Coord)
    (hP : P x = x) (hGamma : GammaF x = x) :
    v4HaarAverage x = x := by
  have hsector : x ∈ E_plus_plus := by
    rw [E_plus_plus]
    constructor
    · change P x - x = 0
      rw [hP]
      simp
    · change GammaF x - x = 0
      rw [hGamma]
      simp
  rw [mem_E_plus_plus_iff] at hsector
  rcases hsector with ⟨hvec, hbiv, htri⟩
  have hproj : proj0 x = x := by
    ext <;> simp [proj0, hvec, hbiv, htri]
  rw [v4HaarAverage_eq_invariantProjector, hproj]

theorem v4HaarAverage_idempotent :
    v4HaarAverage * v4HaarAverage = v4HaarAverage := by
  rw [v4HaarAverage_eq_invariantProjector]
  exact proj0_idempotent

def numerator (energy gauge : V4Group → ℝ) (β : ℝ) (g : V4Group) : ℝ :=
  gauge g * InfoGeometry.Thermo.weight energy β g

/-- Partition function of the Weyl-gauged four-sector ensemble. -/
def partitionFunction (energy gauge : V4Group → ℝ) (β : ℝ) : ℝ :=
  ∑ g : V4Group, numerator energy gauge β g

/-- Normalized Weyl-gauged Gibbs weight on the four group sectors. -/
def probability (energy gauge : V4Group → ℝ) (β : ℝ) (g : V4Group) : ℝ :=
  numerator energy gauge β g / partitionFunction energy gauge β

theorem numerator_pos (energy gauge : V4Group → ℝ)
    (hg : ∀ g, 0 < gauge g) (β : ℝ) (g : V4Group) :
    0 < numerator energy gauge β g := by
  unfold numerator
  exact mul_pos (hg g) (InfoGeometry.Thermo.weight_pos energy β g)

theorem partitionFunction_pos (energy gauge : V4Group → ℝ)
    (hg : ∀ g, 0 < gauge g) (β : ℝ) :
    0 < partitionFunction energy gauge β := by
  unfold partitionFunction
  apply Finset.sum_pos
  · intro g _
    exact numerator_pos energy gauge hg β g
  · exact Finset.univ_nonempty

theorem probability_nonneg (energy gauge : V4Group → ℝ)
    (hg : ∀ g, 0 < gauge g) (β : ℝ) (g : V4Group) :
    0 ≤ probability energy gauge β g := by
  unfold probability
  exact div_nonneg (le_of_lt (numerator_pos energy gauge hg β g))
    (le_of_lt (partitionFunction_pos energy gauge hg β))

theorem probability_pos (energy gauge : V4Group → ℝ)
    (hg : ∀ g, 0 < gauge g) (β : ℝ) (g : V4Group) :
    0 < probability energy gauge β g := by
  unfold probability
  exact div_pos (numerator_pos energy gauge hg β g)
    (partitionFunction_pos energy gauge hg β)

theorem probability_sum_one (energy gauge : V4Group → ℝ)
    (hg : ∀ g, 0 < gauge g) (β : ℝ) :
    ∑ g : V4Group, probability energy gauge β g = 1 := by
  unfold probability partitionFunction
  rw [← Finset.sum_div]
  exact div_self (ne_of_gt (partitionFunction_pos energy gauge hg β))

/-- A global positive Weyl rescaling scales the partition function by that
factor and leaves every normalized Gibbs weight unchanged. -/
theorem partitionFunction_globalGaugeScale (energy gauge : V4Group → ℝ)
    (β c : ℝ) :
    partitionFunction energy (fun g => c * gauge g) β =
      c * partitionFunction energy gauge β := by
  unfold partitionFunction numerator
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro g _
  ring

theorem probability_globalGaugeScale (energy gauge : V4Group → ℝ)
    (hg : ∀ g, 0 < gauge g) (β c : ℝ) (hc : 0 < c) (g : V4Group) :
    probability energy (fun x => c * gauge x) β g =
      probability energy gauge β g := by
  unfold probability numerator
  rw [partitionFunction_globalGaugeScale energy gauge β c]
  have hZ : partitionFunction energy gauge β ≠ 0 :=
    (partitionFunction_pos energy gauge hg β).ne'
  field_simp

/-- The normalized Fourier coefficient of a Weyl-gauged Gibbs law.  This is a
signed character moment, not a positive probability weight. -/
def characterCoefficient (energy gauge : V4Group → ℝ) (β : ℝ)
    (k : Fin 4) : ℝ :=
  (1 / 4 : ℝ) * v4Fourier k (probability energy gauge β)

theorem characterCoefficient_reconstruction (energy gauge : V4Group → ℝ)
    (β : ℝ) (g : V4Group) :
    ∑ k : Fin 4, v4Character k g * characterCoefficient energy gauge β k =
      probability energy gauge β g := by
  unfold characterCoefficient
  calc
    ∑ k : Fin 4, v4Character k g *
        ((1 / 4 : ℝ) * v4Fourier k (probability energy gauge β)) =
      ∑ k : Fin 4, (1 / 4 : ℝ) *
        (v4Character k g * v4Fourier k (probability energy gauge β)) := by
          apply Finset.sum_congr rfl
          intro k hk
          ring
    _ = (1 / 4 : ℝ) * ∑ k : Fin 4,
        v4Character k g * v4Fourier k (probability energy gauge β) := by
          rw [← Finset.mul_sum]
    _ = probability energy gauge β g :=
      v4Fourier_inversion (probability energy gauge β) g

/-- The character-zero coefficient of the unnormalized gauge-Gibbs numerator
is the uniform group average, namely `Z / |V₄| = Z / 4`. -/
theorem trivialCharacterCoefficient_eq_partition_over_card
    (energy gauge : V4Group → ℝ) (β : ℝ) :
    (1 / 4 : ℝ) * v4Fourier 0 (numerator energy gauge β) =
      partitionFunction energy gauge β / 4 := by
  have htrivial : v4Fourier 0 (numerator energy gauge β) =
      ∑ g : V4Group, numerator energy gauge β g := by
    simp [v4Fourier, v4Character]
  rw [htrivial]
  unfold partitionFunction
  ring

/-- The four existing Cayley character-sector projectors, ordered by the
`(W1,W2)` signs `(+,+),(+,-),(-,+),(-,-)`. -/
def operatorProjector : Fin 4 → CoordEnd
  | 0 => proj0
  | 1 => proj1
  | 2 => proj2
  | 3 => proj3

theorem operatorProjectors_sum_identity :
    ∑ k : Fin 4, operatorProjector k = 1 := by
  classical
  simp [operatorProjector, Fin.sum_univ_succ]
  simpa [add_assoc] using character_projectors_sum_id

/-- The four character projectors multiply as mutually orthogonal
idempotents, with indices ordered by their sign pair. -/
theorem operatorProjector_mul (i j : Fin 4) :
    operatorProjector i * operatorProjector j =
      if i = j then operatorProjector i else 0 := by
  fin_cases i <;> fin_cases j <;>
    simp [operatorProjector,
      CayleyPeirceKleinFourBridge.proj0_idempotent,
      CayleyPeirceKleinFourBridge.proj1_idempotent,
      CayleyPeirceKleinFourBridge.proj2_idempotent,
      CayleyPeirceKleinFourBridge.proj3_idempotent,
      CayleyPeirceKleinFourBridge.proj0_mul_proj1,
      CayleyPeirceKleinFourBridge.proj0_mul_proj2,
      CayleyPeirceKleinFourBridge.proj0_mul_proj3,
      CayleyPeirceKleinFourBridge.proj1_mul_proj0,
      CayleyPeirceKleinFourBridge.proj1_mul_proj2,
      CayleyPeirceKleinFourBridge.proj1_mul_proj3,
      CayleyPeirceKleinFourBridge.proj2_mul_proj0,
      CayleyPeirceKleinFourBridge.proj2_mul_proj1,
      CayleyPeirceKleinFourBridge.proj2_mul_proj3,
      CayleyPeirceKleinFourBridge.proj3_mul_proj0,
      CayleyPeirceKleinFourBridge.proj3_mul_proj1,
      CayleyPeirceKleinFourBridge.proj3_mul_proj2]

/-- Gibbs-weighted operator mixture of the four existing character-sector
projectors.  The projectors themselves, not this non-idempotent mixture, form
the resolution of the identity. -/
def gibbsOperator (energy gauge : V4Group → ℝ) (β : ℝ) : CoordEnd :=
  ∑ k : Fin 4, probability energy gauge β (v4EquivFin k) • operatorProjector k

theorem gibbsOperator_apply_sector (energy gauge : V4Group → ℝ)
    (β : ℝ) (k : Fin 4) (x : Coord) :
    gibbsOperator energy gauge β (operatorProjector k x) =
      probability energy gauge β (v4EquivFin k) • operatorProjector k x := by
  classical
  simp only [gibbsOperator, LinearMap.sum_apply, LinearMap.smul_apply]
  rw [Finset.sum_eq_single k]
  · have hkk : operatorProjector k * operatorProjector k = operatorProjector k := by
      rw [operatorProjector_mul]
      simp
    change probability energy gauge β (v4EquivFin k) •
      ((operatorProjector k * operatorProjector k) x) = _
    rw [hkk]
  · intro j hj hjk
    have hmul : operatorProjector j * operatorProjector k = 0 := by
      rw [operatorProjector_mul]
      simp [hjk]
    have hx : operatorProjector j (operatorProjector k x) = 0 := by
      change (operatorProjector j * operatorProjector k) x = 0
      rw [hmul]
      rfl
    simp [hx]
  · intro hk
    exact (hk (Finset.mem_univ _)).elim

end InfoGeometry.Canonical.V4WeylGibbsOperatorBridge

end noncomputable section
