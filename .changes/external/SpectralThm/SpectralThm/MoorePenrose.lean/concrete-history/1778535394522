{"type":"new","contents":"module\n\npublic import Mathlib.Algebra.Ring.Basic\npublic import Mathlib.Algebra.Star.Basic\npublic import Mathlib.Analysis.InnerProductSpace.Adjoint\npublic import Mathlib.Analysis.InnerProductSpace.Projection.Basic\npublic import Mathlib.Analysis.InnerProductSpace.Projection.Submodule\npublic import Mathlib.Analysis.Normed.Operator.Banach\n\n/-!\n# Moore--Penrose inverse\n\nThis file contains the algebraic Penrose equations in a star ring, together with\nthe constructive Moore--Penrose inverse for operators on a Hilbert space.\n\nThe algebraic section provides the axiomatic Penrose equations and uniqueness.\nThe Hilbert section provides the construction for endomorphisms with closed range.\n-/\n\n@[expose] public section\n\nnamespace SpectralThm.MoorePenrose\n\nsection Algebraic\n\nvariable {R : Type*} [Ring R] [StarRing R]\n\n/-- The four Penrose equations in a star ring. -/\ndef IsMoorePenroseInverse (A B : R) : Prop :=\n  A * B * A = A ∧\n  B * A * B = B ∧\n  star (A * B) = A * B ∧\n  star (B * A) = B * A\n\nnamespace IsMoorePenroseInverse\n\nvariable {A B : R}\n\ntheorem mk\n    (h1 : A * B * A = A)\n    (h2 : B * A * B = B)\n    (h3 : star (A * B) = A * B)\n    (h4 : star (B * A) = B * A) :\n    IsMoorePenroseInverse A B :=\n  ⟨h1, h2, h3, h4⟩\n\ntheorem aba_eq_a (h : IsMoorePenroseInverse A B) : A * B * A = A := h.1\ntheorem bab_eq_b (h : IsMoorePenroseInverse A B) : B * A * B = B := h.2.1\ntheorem ab_star_eq (h : IsMoorePenroseInverse A B) : star (A * B) = A * B := h.2.2.1\ntheorem ba_star_eq (h : IsMoorePenroseInverse A B) : star (B * A) = B * A := h.2.2.2\n\n/-- Backward-compatible alias for the first Penrose equation. -/\ntheorem eq1 (h : IsMoorePenroseInverse A B) : A * B * A = A := h.aba_eq_a\n\n/-- Backward-compatible alias for the second Penrose equation. -/\ntheorem eq2 (h : IsMoorePenroseInverse A B) : B * A * B = B := h.bab_eq_b\n\n/-- Backward-compatible alias for the third Penrose equation. -/\ntheorem eq3 (h : IsMoorePenroseInverse A B) : star (A * B) = A * B := h.ab_star_eq\n\n/-- Backward-compatible alias for the fourth Penrose equation. -/\ntheorem eq4 (h : IsMoorePenroseInverse A B) : star (B * A) = B * A := h.ba_star_eq\n\nend IsMoorePenroseInverse\n\n/-- Star reverses a triple product. -/\nlemma star_mul_triple (X Y Z : R) : star (X * Y * Z) = star Z * star Y * star X := by\n  calc\n    star (X * Y * Z) = star (X * (Y * Z)) := by rw [mul_assoc]\n    _ = star (Y * Z) * star X := by rw [star_mul]\n    _ = star Z * star Y * star X := by rw [star_mul]\n\n/-- The range projector `A * B` from a Moore--Penrose pair. -/\ndef mpProjector (A B : R) (_h : IsMoorePenroseInverse A B) : R := A * B\n\nlemma mpProjector_idempotent {A B : R} (h : IsMoorePenroseInverse A B) :\n    mpProjector A B h * mpProjector A B h = mpProjector A B h := by\n  unfold mpProjector\n  calc\n    (A * B) * (A * B) = A * (B * (A * B)) := by rw [mul_assoc]\n    _ = A * (B * A * B) := by rw [← mul_assoc B A B]\n    _ = A * B := by rw [h.bab_eq_b]\n\nlemma mpProjector_self_adjoint {A B : R} (h : IsMoorePenroseInverse A B) :\n    star (mpProjector A B h) = mpProjector A B h := by\n  unfold mpProjector\n  exact h.ab_star_eq\n\n/-- The Moore--Penrose inverse is unique when it exists. -/\ntheorem MoorePenrose_unique {A B C : R}\n    (hB : IsMoorePenroseInverse A B)\n    (hC : IsMoorePenroseInverse A C) : B = C := by\n  have h1 : A * B = A * C := by\n    calc\n      A * B = star (A * B) := hB.ab_star_eq.symm\n      _ = star B * star A := star_mul _ _\n      _ = star B * star (A * C * A) := by rw [hC.aba_eq_a]\n      _ = star B * (star A * star C * star A) := by simp only [star_mul, mul_assoc]\n      _ = (star B * star A) * star C * star A := by simp only [mul_assoc]\n      _ = star (A * B) * star C * star A := by rw [star_mul]\n      _ = (A * B) * star C * star A := by rw [hB.ab_star_eq]\n      _ = A * B * (star C * star A) := by rw [mul_assoc]\n      _ = A * B * star (A * C) := by rw [star_mul]\n      _ = A * B * (A * C) := by rw [hC.ab_star_eq]\n      _ = (A * B * A) * C := by simp only [mul_assoc]\n      _ = A * C := by rw [hB.aba_eq_a]\n  have h2 : B * A = C * A := by\n    calc\n      B * A = star (B * A) := hB.ba_star_eq.symm\n      _ = star A * star B := star_mul _ _\n      _ = star (A * C * A) * star B := by rw [hC.aba_eq_a]\n      _ = (star A * star C * star A) * star B := by simp only [star_mul, mul_assoc]\n      _ = star A * star C * (star A * star B) := by simp only [mul_assoc]\n      _ = star A * star C * star (B * A) := by rw [star_mul]\n      _ = star A * star C * (B * A) := by rw [hB.ba_star_eq]\n      _ = star (C * A) * (B * A) := by rw [star_mul]\n      _ = (C * A) * (B * A) := by rw [hC.ba_star_eq]\n      _ = C * (A * B * A) := by simp only [mul_assoc]\n      _ = C * A := by rw [hB.aba_eq_a]\n  calc\n    B = B * A * B := hB.bab_eq_b.symm\n    _ = (B * A) * B := by rw [mul_assoc]\n    _ = (C * A) * B := by rw [h2]\n    _ = C * (A * B) := by rw [← mul_assoc]\n    _ = C * (A * C) := by rw [h1]\n    _ = C * A * C := by rw [mul_assoc]\n    _ = C := hC.bab_eq_b\n\nend Algebraic\n\nsection ContinuousLinearMap\n\nvariable {𝕜 E F : Type*} [RCLike 𝕜]\nvariable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\nvariable [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] [CompleteSpace F]\n\n/--\nThe four Penrose equations for bounded operators between possibly different Hilbert spaces.\n-/\ndef IsMoorePenroseInverseCLM (A : E →L[𝕜] F) (B : F →L[𝕜] E) : Prop :=\n  (A.comp B).comp A = A ∧\n  (B.comp A).comp B = B ∧\n  star (A.comp B) = A.comp B ∧\n  star (B.comp A) = B.comp A\n\nnamespace IsMoorePenroseInverseCLM\n\nvariable {A : E →L[𝕜] F} {B : F →L[𝕜] E}\n\ntheorem aba_eq_a (h : IsMoorePenroseInverseCLM A B) : (A.comp B).comp A = A := h.1\ntheorem bab_eq_b (h : IsMoorePenroseInverseCLM A B) : (B.comp A).comp B = B := h.2.1\ntheorem ab_star_eq (h : IsMoorePenroseInverseCLM A B) : star (A.comp B) = A.comp B := h.2.2.1\ntheorem ba_star_eq (h : IsMoorePenroseInverseCLM A B) : star (B.comp A) = B.comp A := h.2.2.2\n\nend IsMoorePenroseInverseCLM\n\n/-- Restriction of `A` to the orthogonal complement of its kernel. -/\nnoncomputable def mpRestricted (A : E →L[𝕜] E) : (A.ker)ᗮ →L[𝕜] A.range :=\n  (A.comp (A.ker)ᗮ.subtypeL).codRestrict A.range (fun x => LinearMap.mem_range.mpr ⟨x.1, rfl⟩)\n\n/-- The restricted operator has a trivial kernel. -/\ntheorem mpRestricted_ker_eq_bot (A : E →L[𝕜] E) :\n    (mpRestricted A : (A.ker)ᗮ →ₗ[𝕜] A.range).ker = ⊥ := by\n  rw [LinearMap.ker_eq_bot]\n  intro x y hxy\n  apply Subtype.ext\n  have h_val : A x.1 = A y.1 := by\n    have h := congrArg Subtype.val hxy\n    simpa [mpRestricted] using h\n  have h_mem : (x.1 - y.1 : E) ∈ A.ker := by\n    change A (x.1 - y.1) = 0\n    rw [map_sub, h_val, sub_self]\n  have h_mem_Kp : (x.1 - y.1 : E) ∈ (A.ker)ᗮ :=\n    Submodule.sub_mem _ x.2 y.2\n  have h_zero : (x.1 - y.1 : E) = 0 := by\n    have hmem : (x.1 - y.1 : E) ∈ A.ker ⊓ (A.ker)ᗮ := ⟨h_mem, h_mem_Kp⟩\n    simpa [Submodule.inf_orthogonal_eq_bot (A.ker)] using hmem\n  exact sub_eq_zero.mp h_zero\n\n/-- The restricted operator is surjective. -/\ntheorem mpRestricted_range_eq_top (A : E →L[𝕜] E) :\n    (mpRestricted A : (A.ker)ᗮ →ₗ[𝕜] A.range).range = ⊤ := by\n  rw [LinearMap.range_eq_top]\n  intro y\n  rcases y with ⟨y, hy⟩\n  rcases hy with ⟨x, rfl⟩\n\n  let K : Submodule 𝕜 E := A.ker\n  let Kp : Submodule 𝕜 E := Kᗮ\n\n  have hK_closed : IsClosed (K : Set E) := by\n    simpa [K] using A.isClosed_ker\n  haveI : CompleteSpace K := hK_closed.completeSpace_coe\n  haveI : K.HasOrthogonalProjection := inferInstance\n  haveI : CompleteSpace Kp := inferInstance\n  haveI : Kp.HasOrthogonalProjection := inferInstance\n\n  refine ⟨Kp.orthogonalProjection x, ?_⟩\n  apply Subtype.ext\n\n  have hA_on_Kp : ∀ x : E, A (Kp.starProjection x) = A x := by\n    intro x\n    have hsplit :\n        K.starProjection x + Kp.starProjection x = x :=\n      Submodule.starProjection_add_starProjection_orthogonal (K := K) x\n    have hKzero : A (K.starProjection x) = 0 :=\n      Submodule.starProjection_apply_mem K x\n    calc\n      A (Kp.starProjection x)\n          = 0 + A (Kp.starProjection x) := by rw [zero_add]\n      _ = A (K.starProjection x) + A (Kp.starProjection x) := by rw [hKzero]\n      _ = A (K.starProjection x + Kp.starProjection x) := by rw [map_add]\n      _ = A x := by rw [hsplit]\n\n  simpa [mpRestricted, K, Kp, Submodule.coe_orthogonalProjection_apply] using\n    hA_on_Kp x\n\n/-- The continuous linear equivalence between `(ker A)ᗮ` and `range A`. -/\nnoncomputable def mpEquiv (A : E →L[𝕜] E) (hClosedRange : IsClosed (A.range : Set E)) :\n    (A.ker)ᗮ ≃L[𝕜] A.range :=\n  haveI : CompleteSpace (A.ker)ᗮ := inferInstance\n  haveI : CompleteSpace A.range := hClosedRange.completeSpace_coe\n  ContinuousLinearEquiv.ofBijective\n    (mpRestricted A)\n    (mpRestricted_ker_eq_bot A)\n    (mpRestricted_range_eq_top A)\n\n/--\n  Constructive Moore--Penrose inverse for an endomorphism with closed range.\n  -/\nnoncomputable def moorePenroseInverse\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) : E →L[𝕜] E :=\n  let Kp : Submodule 𝕜 E := (A.ker)ᗮ\n  let R : Submodule 𝕜 E := A.range\n  haveI : CompleteSpace R := hClosedRange.completeSpace_coe\n  Kp.subtypeL.comp ((mpEquiv A hClosedRange).symm.toContinuousLinearMap.comp (Submodule.orthogonalProjection R))\n\n/-- Proof that the construction satisfies the Moore--Penrose identities. -/\ntheorem isMoorePenroseInverse_moorePenroseInverse\n    (A : E →L[𝕜] E)\n    (hClosedRange : IsClosed (A.range : Set E)) :\n    IsMoorePenroseInverse A (moorePenroseInverse A hClosedRange) := by\n  let B := moorePenroseInverse A hClosedRange\n  let K : Submodule 𝕜 E := A.ker\n  let Kp : Submodule 𝕜 E := Kᗮ\n  let R : Submodule 𝕜 E := A.range\n  let e := mpEquiv A hClosedRange\n\n  have hK_closed : IsClosed (K : Set E) := by\n    simpa [K] using A.isClosed_ker\n  haveI : CompleteSpace K := hK_closed.completeSpace_coe\n  haveI : K.HasOrthogonalProjection := inferInstance\n  haveI : CompleteSpace Kp := inferInstance\n  haveI : Kp.HasOrthogonalProjection := inferInstance\n  haveI : CompleteSpace R := hClosedRange.completeSpace_coe\n  haveI : R.HasOrthogonalProjection := inferInstance\n\n  have hA_on_Kp : ∀ x : E, A (Kp.starProjection x) = A x := by\n    intro x\n    have hsplit : K.starProjection x + Kp.starProjection x = x :=\n      Submodule.starProjection_add_starProjection_orthogonal (K := K) x\n    have hKzero : A (K.starProjection x) = 0 :=\n      Submodule.starProjection_apply_mem K x\n    calc\n      A (Kp.starProjection x) = 0 + A (Kp.starProjection x) := by rw [zero_add]\n      _ = A (K.starProjection x) + A (Kp.starProjection x) := by rw [hKzero]\n      _ = A (K.starProjection x + Kp.starProjection x) := by rw [map_add]\n      _ = A x := by rw [hsplit]\n\n  have hAB_apply : ∀ y : E, A (B y) = R.starProjection y := by\n    intro y\n    let yR := R.orthogonalProjection y\n    have h_eval : e (e.symm yR) = yR := e.apply_symm_apply yR\n    have h_val : A (e.symm yR : E) = (yR : E) := by\n      have h := congrArg Subtype.val h_eval\n      change (mpRestricted A (e.symm yR)).val = yR.val at h\n      exact h\n    show A (↑(e.symm yR)) = R.starProjection y\n    simpa [Submodule.coe_orthogonalProjection_apply] using h_val\n\n  have hBA_apply : ∀ x : E, B (A x) = Kp.starProjection x := by\n    intro x\n    let xKp := Kp.orthogonalProjection x\n    have hAx_mem : A x ∈ R := ⟨x, rfl⟩\n    have hproj : Submodule.orthogonalProjection R (A x) = (⟨A x, hAx_mem⟩ : R) := by\n      apply Subtype.ext\n      exact Submodule.starProjection_mem_subspace_eq_self (K := R) ⟨A x, hAx_mem⟩\n    have hTz : e xKp = (⟨A x, hAx_mem⟩ : R) := by\n      apply Subtype.ext\n      simpa [e, mpEquiv, mpRestricted, K, Kp, R, xKp,\n        Submodule.coe_orthogonalProjection_apply] using hA_on_Kp x\n    have hsymm : e.symm (⟨A x, hAx_mem⟩ : R) = xKp := by\n      rw [← hTz]\n      exact e.symm_apply_apply xKp\n    show (↑(e.symm (Submodule.orthogonalProjection R (A x)))) = Kp.starProjection x\n    rw [hproj, hsymm]\n    simp [xKp, Submodule.coe_orthogonalProjection_apply]\n\n  refine IsMoorePenroseInverse.mk ?_ ?_ ?_ ?_\n  · -- ABA = A\n    ext x\n    rw [ContinuousLinearMap.mul_apply, ContinuousLinearMap.mul_apply, hAB_apply]\n    exact Submodule.starProjection_mem_subspace_eq_self (K := R) ⟨A x, ⟨x, rfl⟩⟩\n  · -- BAB = B\n    ext y\n    rw [ContinuousLinearMap.mul_apply, ContinuousLinearMap.mul_apply, hBA_apply]\n    have hBmem : B y ∈ Kp := by\n      simp only [B, moorePenroseInverse, ContinuousLinearMap.comp_apply]\n      exact (e.symm (R.orthogonalProjection y)).property\n    exact Submodule.starProjection_mem_subspace_eq_self (K := Kp) ⟨B y, hBmem⟩\n  · -- star (AB) = AB\n    have hAB : A * B = R.starProjection := by ext y; exact hAB_apply y\n    rw [hAB]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection R)\n  · -- star (BA) = BA\n    have hBA : B * A = Kp.starProjection := by ext x; exact hBA_apply x\n    rw [hBA]\n    exact IsSelfAdjoint.star_eq (isSelfAdjoint_starProjection Kp)\n\nend ContinuousLinearMap\n\nend SpectralThm.MoorePenrose\n","mtime":1778535394522}