import Mathlib
import InfoGeometry.Meta.Architecture

/-!
# InfoGeometry.Topology.FractalCantorFockWitness

Real Cantor-boundary Clifford/Fock witness packet.

Owner lane:

`Erlangen/binary boundary -> Cantor addresses -> tilt/switch operators ->
real doubled Hestenes/Krein Clifford representation -> Fock/CAR witness`.

The tilt/switch operators are not identified with repository light-cone arrows
or Tomita mirror data by definition.  Those identifications are explicit
calibration fields.

The metric graph embedding paper belongs to the finite metric graph-compression
lane, not to this Clifford/Fock witness lane.
-/

noncomputable section

namespace InfoGeometry.Topology.FractalCantorFockWitness

/-- Symbolic Cantor boundary: infinite binary address space. -/
abbrev CantorBoundary := ℕ → Bool

/-- Finite Cantor address of depth `n`. -/
abbrev CantorAddress (n : ℕ) := Fin n → Bool

/-- Finite real/doubled function space over the depth-`n` Cantor endpoint set. -/
abbrev FiniteCantorFunctionSpace (n : ℕ) (Value : Type*) :=
  CantorAddress n → Value

/-- Infinite real/doubled Cantor function-space packet, standing for the `L²(K)` socket. -/
@[rep_depth operator]
structure RealDoubledCantorFunctionSpace where
  Space : Type*
  MeasureData : Type*
  RealHilbertWitness : Type*
  DoubledKreinWitness : Type*

/--
Tilt/switch operator system.

`T p` is the tilt operator and `S p` is the switch operator.  The owner relation
is local anticommutation at the same address slot and commutation at distinct
slots.
-/
@[rep_depth operator]
structure TiltSwitchSystem
    (Op : Type*) [Ring Op] where
  T : ℕ → Op
  S : ℕ → Op

  T_sq :
    ∀ p, T p * T p = 1

  S_sq :
    ∀ p, S p * S p = 1

  T_comm :
    ∀ p q, T p * T q = T q * T p

  S_comm :
    ∀ p q, S p * S q = S q * S p

  T_S_comm_ne :
    ∀ p q, p ≠ q → T p * S q = S q * T p

  T_S_anticomm :
    ∀ p, T p * S p = - (S p * T p)

namespace TiltSwitchSystem

variable {Op : Type*} [Ring Op]
variable (TS : TiltSwitchSystem Op)

/-- Tilt squares to one at each Cantor address slot. -/
@[rep_depth operator]
theorem tilt_sq (p : ℕ) :
    TS.T p * TS.T p = 1 :=
  TS.T_sq p

/-- Switch squares to one at each Cantor address slot. -/
@[rep_depth operator]
theorem switch_sq (p : ℕ) :
    TS.S p * TS.S p = 1 :=
  TS.S_sq p

/-- Tilt and switch anticommute at the same slot. -/
@[rep_depth operator]
theorem tilt_switch_anticomm (p : ℕ) :
    TS.T p * TS.S p + TS.S p * TS.T p = 0 := by
  rw [TS.T_S_anticomm p]
  simp

/-- Tilt and switch commute at distinct slots. -/
@[rep_depth operator]
theorem tilt_switch_comm_of_ne {p q : ℕ} (hpq : p ≠ q) :
    TS.T p * TS.S q = TS.S q * TS.T p :=
  TS.T_S_comm_ne p q hpq

end TiltSwitchSystem

/--
Real doubled Hestenes/Krein Clifford representation generated from the
Cantor tilt/switch system.

`gamma i` is the image of the `i`-th Clifford generator.  The paper-specific
string formula is retained as a witness field rather than reconstructed here.
-/
@[rep_depth operator]
structure RealDoubledCantorCliffordRepresentation
    (Op : Type*) [Ring Op] where
  tiltSwitch : TiltSwitchSystem Op

  gamma : ℕ → Op

  gamma_sq :
    ∀ i, gamma i * gamma i = 1

  gamma_anticomm :
    ∀ i j, i ≠ j → gamma i * gamma j = - (gamma j * gamma i)

  stringFormulaWitness : Prop
  stringFormulaWitness_holds : stringFormulaWitness

namespace RealDoubledCantorCliffordRepresentation

variable {Op : Type*} [Ring Op]
variable (C : RealDoubledCantorCliffordRepresentation Op)

/-- Clifford square law readback. -/
@[rep_depth operator]
theorem generator_sq (i : ℕ) :
    C.gamma i * C.gamma i = 1 :=
  C.gamma_sq i

/-- Clifford anticommutator readback. -/
@[rep_depth operator]
theorem generator_anticomm {i j : ℕ} (hij : i ≠ j) :
    C.gamma i * C.gamma j + C.gamma j * C.gamma i = 0 := by
  rw [C.gamma_anticomm i j hij]
  simp

/-- The concrete Cantor-address string formula is available as an owner witness. -/
@[rep_depth operator]
theorem string_formula_holds :
    C.stringFormulaWitness :=
  C.stringFormulaWitness_holds

end RealDoubledCantorCliffordRepresentation

/--
Infinite-dimensional Cantor/Fock witness.

This packages the theorem-safe content: the real doubled Cantor function-space
representation generated by tilt/switch operators is calibrated to the Fock
socket.
-/
@[rep_depth operator]
structure CelikKocakInfiniteFockWitness
    (Op : Type*) [Ring Op] where
  cantorFunctionSpace : RealDoubledCantorFunctionSpace
  tiltSwitch : TiltSwitchSystem Op
  clifford : RealDoubledCantorCliffordRepresentation Op
  FockSpace : Type*
  FockRepresentation : Type*
  equivalentToFock : Prop
  equivalentToFock_witness : equivalentToFock

namespace CelikKocakInfiniteFockWitness

variable {Op : Type*} [Ring Op]
variable (W : CelikKocakInfiniteFockWitness Op)

/-- The fractal Cantor representation is calibrated to the Fock socket. -/
@[rep_depth operator]
theorem equivalent_to_fock :
    W.equivalentToFock :=
  W.equivalentToFock_witness

end CelikKocakInfiniteFockWitness

/--
Finite-dimensional Cantor-Pauli witness over a real/doubled matrix carrier.

The representation on endpoint functions agrees with the real Pauli tensor lane
through an explicit witness.
-/
@[rep_depth operator]
structure FiniteCantorPauliWitness
    (n : ℕ) (Mat : Type*) [Ring Mat] where
  psiGamma : Fin (2 * n) → Mat

  gamma_sq :
    ∀ i, psiGamma i * psiGamma i = 1

  gamma_anticomm :
    ∀ i j, i ≠ j → psiGamma i * psiGamma j = - (psiGamma j * psiGamma i)

  pauliTensorProductRealization : Prop
  pauliTensorProductRealization_witness : pauliTensorProductRealization

namespace FiniteCantorPauliWitness

variable {n : ℕ} {Mat : Type*} [Ring Mat]
variable (W : FiniteCantorPauliWitness n Mat)

/-- Finite Clifford square law readback. -/
@[rep_depth operator]
theorem generator_sq (i : Fin (2 * n)) :
    W.psiGamma i * W.psiGamma i = 1 :=
  W.gamma_sq i

/-- Finite Clifford anticommutator readback. -/
@[rep_depth operator]
theorem generator_anticomm {i j : Fin (2 * n)} (hij : i ≠ j) :
    W.psiGamma i * W.psiGamma j + W.psiGamma j * W.psiGamma i = 0 := by
  rw [W.gamma_anticomm i j hij]
  simp

/-- The endpoint representation is calibrated to the Pauli tensor-product lane. -/
@[rep_depth operator]
theorem pauli_tensor_product_realization :
    W.pauliTensorProductRealization :=
  W.pauliTensorProductRealization_witness

end FiniteCantorPauliWitness

/--
Real CAR pair.

This is the socket consumed by light-cone/Fock layers.  The construction from a
chosen Clifford pair is witness-gated because the repo uses real doubled phase
rather than scalar phase notation.
-/
@[rep_depth operator]
structure RealCARPair
    (Op : Type*) [Ring Op] where
  annihilation : Op
  creation : Op

  nilpotent_annihilation :
    annihilation * annihilation = 0

  nilpotent_creation :
    creation * creation = 0

  car :
    annihilation * creation + creation * annihilation = 1

namespace RealCARPair

variable {Op : Type*} [Ring Op]
variable (C : RealCARPair Op)

/-- Annihilation is nilpotent. -/
@[rep_depth operator]
theorem annihilation_sq_zero :
    C.annihilation * C.annihilation = 0 :=
  C.nilpotent_annihilation

/-- Creation is nilpotent. -/
@[rep_depth operator]
theorem creation_sq_zero :
    C.creation * C.creation = 0 :=
  C.nilpotent_creation

/-- Canonical CAR anticommutator law. -/
@[rep_depth operator]
theorem anticommutator_eq_one :
    C.annihilation * C.creation + C.creation * C.annihilation = 1 :=
  C.car

end RealCARPair

/--
Clifford-to-CAR calibration.

This explicitly records that a selected Clifford pair from the Cantor
representation supplies the CAR pair required by the light-cone/Fock socket.
-/
@[rep_depth operator]
structure CliffordToCARWitness
    (Op : Type*) [Ring Op] where
  clifford : RealDoubledCantorCliffordRepresentation Op
  gammaA : Op
  gammaB : Op
  carPair : RealCARPair Op

  gammaA_is_generator :
    ∃ i, gammaA = clifford.gamma i

  gammaB_is_generator :
    ∃ j, gammaB = clifford.gamma j

  realDoubledPhaseCalibration : Prop
  realDoubledPhaseCalibration_witness : realDoubledPhaseCalibration

namespace CliffordToCARWitness

variable {Op : Type*} [Ring Op]
variable (W : CliffordToCARWitness Op)

/-- The first selected CAR seed is a Clifford generator image. -/
@[rep_depth operator]
theorem gammaA_generator :
    ∃ i, W.gammaA = W.clifford.gamma i :=
  W.gammaA_is_generator

/-- The second selected CAR seed is a Clifford generator image. -/
@[rep_depth operator]
theorem gammaB_generator :
    ∃ j, W.gammaB = W.clifford.gamma j :=
  W.gammaB_is_generator

/-- The Clifford-to-CAR construction uses the real doubled phase calibration. -/
@[rep_depth krein]
theorem real_doubled_phase_calibrated :
    W.realDoubledPhaseCalibration :=
  W.realDoubledPhaseCalibration_witness

end CliffordToCARWitness

/--
Calibration between repository Drazin/chiral arrows and the Cantor tilt/switch
witness.

This prevents identifying tilt/switch operators with `u_+`, `u_-`, or mirror
operators without an explicit representation map.
-/
@[rep_depth operator]
structure DrazinArrowTiltSwitchCalibration
    (Op : Type*) [Ring Op] where
  tiltSwitch : TiltSwitchSystem Op

  uPlus : Op
  uMinus : Op
  mirror : Op

  uPlus_realized :
    ∃ p, uPlus = tiltSwitch.T p

  uMinus_realized :
    ∃ p, uMinus = tiltSwitch.T p ∨ uMinus = tiltSwitch.S p

  mirror_realized_by_switch :
    ∃ p, mirror = tiltSwitch.S p

namespace DrazinArrowTiltSwitchCalibration

variable {Op : Type*} [Ring Op]
variable (C : DrazinArrowTiltSwitchCalibration Op)

/-- Positive light-cone arrow is calibrated to a tilt/switch witness. -/
@[rep_depth operator]
theorem uPlus_calibrated :
    ∃ p, C.uPlus = C.tiltSwitch.T p :=
  C.uPlus_realized

/-- Negative light-cone arrow is calibrated to a tilt/switch witness. -/
@[rep_depth operator]
theorem uMinus_calibrated :
    ∃ p, C.uMinus = C.tiltSwitch.T p ∨ C.uMinus = C.tiltSwitch.S p :=
  C.uMinus_realized

/-- Mirror data is calibrated to a switch witness. -/
@[rep_depth operator]
theorem mirror_calibrated :
    ∃ p, C.mirror = C.tiltSwitch.S p :=
  C.mirror_realized_by_switch

end DrazinArrowTiltSwitchCalibration

/--
Fractal Cantor Fock witness packet.

This is the topology-side object closing the boundary-to-Fock socket:
Cantor boundary, tilt/switch Clifford representation, CAR/Fock witness, and
calibrated Drazin/chiral arrows.
-/
@[rep_depth operator]
structure FractalCantorFockWitness
    (Op : Type*) [Ring Op] where
  celikKocak : CelikKocakInfiniteFockWitness Op
  cliffordToCAR : CliffordToCARWitness Op
  drazinCalibration : DrazinArrowTiltSwitchCalibration Op
  fockSocketClosed : Prop
  fockSocketClosed_witness : fockSocketClosed

namespace FractalCantorFockWitness

variable {Op : Type*} [Ring Op]
variable (W : FractalCantorFockWitness Op)

/-- The Cantor/Fock witness closes the light-cone Fock socket, as supplied. -/
@[rep_depth operator]
theorem closes_fock_socket :
    W.fockSocketClosed :=
  W.fockSocketClosed_witness

/-- Re-export of the Fock equivalence witness. -/
@[rep_depth operator]
theorem equivalent_to_fock :
    W.celikKocak.equivalentToFock :=
  W.celikKocak.equivalentToFock_witness

/-- Re-export of the real doubled Clifford-to-CAR calibration. -/
@[rep_depth krein]
theorem real_doubled_phase_calibrated :
    W.cliffordToCAR.realDoubledPhaseCalibration :=
  W.cliffordToCAR.realDoubledPhaseCalibration_witness

end FractalCantorFockWitness

/-- Drazin support of a signal operator: `p = A Aᴰ`. -/
@[rep_depth operator]
structure DrazinHorizon
    (Op : Type*) [Ring Op] where
  A : Op
  AD : Op
  p : Op

  p_def :
    p = A * AD

  commute :
    A * AD = AD * A

  p_idempotent :
    p * p = p

/-- Drazin-Green harmonic projector: `H = 1 - L Lᴰ`. -/
@[rep_depth operator]
structure DrazinGreenHarmonic
    (Op : Type*) [Ring Op] where
  L : Op
  LD : Op
  H : Op

  H_def :
    H = 1 - L * LD

  H_idempotent :
    H * H = H

/-- Matter envelope extracted from the Cantor/Fock observable. -/
@[rep_depth operator]
def fractalFockMatterEnvelope
    {Op : Type*} [Ring Op]
    (D : DrazinHorizon Op)
    (G : DrazinGreenHarmonic Op)
    (x : Op) : Op :=
  G.H * (D.p * x * D.p) * G.H

/-- Real Fierz readout channels.  The phase-like channel is named `rotor`. -/
@[rep_depth operator]
inductive FierzChannel where
  | scalar
  | rotor
  | vector
  | axial
  | area
  deriving DecidableEq, Fintype

/-- Real Fierz readout packet. -/
@[rep_depth operator]
structure FierzReadout
    (Op : Type*) where
  channel : FierzChannel → Op → ℝ

/--
Fierz coordinates are read from the Drazin-Hodge envelope, not from the raw
Cantor/Fock operator.
-/
@[rep_depth operator]
def fractalFockFierzCoordinate
    {Op : Type*} [Ring Op]
    (D : DrazinHorizon Op)
    (G : DrazinGreenHarmonic Op)
    (R : FierzReadout Op)
    (x : Op)
    (ch : FierzChannel) : ℝ :=
  R.channel ch (fractalFockMatterEnvelope D G x)

/--
Metric graph compression for finite endpoint geometries.

This is deliberately separate from the Clifford/Fock witness lane.
-/
@[rep_depth transport]
structure FiniteEndpointMetricGraphCompression
    (n : ℕ) where
  Endpoint : Type*
  MetricData : Type*
  WeightedGraph : Type*
  embedding : Endpoint → WeightedGraph
  endpointAddress : Endpoint → CantorAddress n
  optimalityOrCompressionWitness : Prop
  optimalityOrCompressionWitness_holds : optimalityOrCompressionWitness

namespace FiniteEndpointMetricGraphCompression

variable {n : ℕ}
variable (G : FiniteEndpointMetricGraphCompression n)

/-- The finite graph layer is a metric compression witness, not a Clifford witness. -/
@[rep_depth transport]
theorem compression_witness_holds :
    G.optimalityOrCompressionWitness :=
  G.optimalityOrCompressionWitness_holds

end FiniteEndpointMetricGraphCompression

end InfoGeometry.Topology.FractalCantorFockWitness
