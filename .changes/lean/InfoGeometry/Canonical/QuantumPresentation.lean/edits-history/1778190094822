{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Canonical/QuantumPresentation.lean","time":1778190094822,"baseTime":1778190094195,"changes":[{"range":{"start":{"line":6,"character":0},"end":{"line":252,"character":0}},"text":"Raw typed interface for presentation-shaped data and proof-carrying maps between\nsuch data.\n\nThis file provides no representation equivalence by naming alone.  Equivalence\nrequires an explicit isomorphism with inverse laws and forward/inverse readout\npreservation.\n-/\n\nnamespace InfoGeometry.Canonical.QuantumPresentation\n\n/-- Named representation lanes tracked in this repository program. -/\n@[rep_depth operator]\ninductive PresentationLane where\n  | wavefunction\n  | operator\n  | phaseSpace\n  | hydrodynamic\n  | stochastic\n  | graphDirac\n  | arnoldNetwork\n  | doubledKrein\n  deriving DecidableEq, Repr\n\n/-- Raw data of a presentation-shaped interface.  This structure alone asserts no\nlaws beyond the types of its fields. -/\n@[rep_depth operator]\nstructure Presentation where\n  Scalar : Type\n  State : Type\n  Observable : Type\n  act : Observable → State → State\n  support : State → Prop\n  generator : State → State\n  metricReadout : State → Scalar\n  phaseReadout : State → Scalar\n\n/-- Attach lane metadata to a concrete presentation instance.  The tag is not a\nlane-correctness theorem. -/\n@[rep_depth operator]\nstructure TaggedPresentation where\n  lane : PresentationLane\n  data : Presentation\n\n/--\nOne-way map preserving action, support, and generator.  It is not an equivalence\nand does not preserve readouts unless paired with `ReadoutPreservation`.\n-/\n@[rep_depth krein]\nstructure Intertwiner (P Q : Presentation) where\n  mapState : P.State → Q.State\n  mapObservable : P.Observable → Q.Observable\n  mapScalar : P.Scalar → Q.Scalar\n  map_act :\n    ∀ (o : P.Observable) (s : P.State),\n      mapState (P.act o s) = Q.act (mapObservable o) (mapState s)\n  map_support :\n    ∀ s, P.support s → Q.support (mapState s)\n  map_generator :\n    ∀ s, mapState (P.generator s) = Q.generator (mapState s)\n\n/-- Scalar readout preservation contract for an intertwiner. -/\n@[rep_depth krein]\nstructure ReadoutPreservation\n    {P Q : Presentation} (F : Intertwiner P Q) : Prop where\n  metric :\n    ∀ s, F.mapScalar (P.metricReadout s) = Q.metricReadout (F.mapState s)\n  phase :\n    ∀ s, F.mapScalar (P.phaseReadout s) = Q.phaseReadout (F.mapState s)\n\n/--\nAn intertwiner is a full presentation isomorphism only when an inverse\nintertwiner is supplied, the state/observable/scalar maps cancel in both\ndirections, and readouts are preserved in both directions.\n\nThis is intentionally componentwise rather than proof-field equality of\n`Intertwiner` records: the mathematical content is carried by the inverse laws\nand readout preservation laws.\n-/\n@[rep_depth krein]\nstructure IntertwinerIsomorphism\n    {P Q : Presentation} (F : Intertwiner P Q) where\n  inverse : Intertwiner Q P\n  forward_readout : ReadoutPreservation F\n  inverse_readout : ReadoutPreservation inverse\n  left_state : ∀ s : P.State, inverse.mapState (F.mapState s) = s\n  right_state : ∀ s : Q.State, F.mapState (inverse.mapState s) = s\n  left_observable : ∀ o : P.Observable, inverse.mapObservable (F.mapObservable o) = o\n  right_observable : ∀ o : Q.Observable, F.mapObservable (inverse.mapObservable o) = o\n  left_scalar : ∀ x : P.Scalar, inverse.mapScalar (F.mapScalar x) = x\n  right_scalar : ∀ x : Q.Scalar, F.mapScalar (inverse.mapScalar x) = x\n\n/-- Alias naming the same proof object by its mathematical role. -/\n@[rep_depth krein]\nabbrev PresentationIsomorphism\n    {P Q : Presentation} (F : Intertwiner P Q) : Type :=\n  IntertwinerIsomorphism F\n\n/-- Identity intertwiner on a presentation. -/\n@[rep_depth krein]\ndef idIntertwiner (P : Presentation) : Intertwiner P P where\n  mapState := fun s => s\n  mapObservable := fun o => o\n  mapScalar := fun x => x\n  map_act := by\n    intro o s\n    rfl\n  map_support := by\n    intro s hs\n    exact hs\n  map_generator := by\n    intro s\n    rfl\n\n/-- Identity intertwiners preserve both readouts by definitional equality. -/\n@[rep_depth krein]\ndef idIntertwiner_readoutPreservation (P : Presentation) :\n    ReadoutPreservation (idIntertwiner P) where\n  metric := by\n    intro s\n    rfl\n  phase := by\n    intro s\n    rfl\n\n/-- The identity intertwiner is an isomorphism. -/\n@[rep_depth krein]\ndef idPresentationIsomorphism (P : Presentation) :\n    PresentationIsomorphism (idIntertwiner P) where\n  inverse := idIntertwiner P\n  forward_readout := idIntertwiner_readoutPreservation P\n  inverse_readout := idIntertwiner_readoutPreservation P\n  left_state := by\n    intro s\n    rfl\n  right_state := by\n    intro s\n    rfl\n  left_observable := by\n    intro o\n    rfl\n  right_observable := by\n    intro o\n    rfl\n  left_scalar := by\n    intro x\n    rfl\n  right_scalar := by\n    intro x\n    rfl\n\n/-- Backward-compatible name for the identity presentation isomorphism. -/\n@[rep_depth krein]\ndef idIntertwiner_isomorphism (P : Presentation) :\n    IntertwinerIsomorphism (idIntertwiner P) :=\n  idPresentationIsomorphism P\n\n/-- Composition of intertwiners. -/\n@[rep_depth krein]\ndef compIntertwiner\n    {P Q R : Presentation}\n    (F : Intertwiner P Q)\n    (G : Intertwiner Q R) :\n    Intertwiner P R where\n  mapState := fun s => G.mapState (F.mapState s)\n  mapObservable := fun o => G.mapObservable (F.mapObservable o)\n  mapScalar := fun x => G.mapScalar (F.mapScalar x)\n  map_act := by\n    intro o s\n    calc\n      G.mapState (F.mapState (P.act o s))\n          = G.mapState (Q.act (F.mapObservable o) (F.mapState s)) := by\n              rw [F.map_act o s]\n      _ = R.act (G.mapObservable (F.mapObservable o)) (G.mapState (F.mapState s)) := by\n              rw [G.map_act (F.mapObservable o) (F.mapState s)]\n  map_support := by\n    intro s hs\n    exact G.map_support (F.mapState s) (F.map_support s hs)\n  map_generator := by\n    intro s\n    calc\n      G.mapState (F.mapState (P.generator s))\n          = G.mapState (Q.generator (F.mapState s)) := by\n              rw [F.map_generator s]\n      _ = R.generator (G.mapState (F.mapState s)) := by\n              rw [G.map_generator (F.mapState s)]\n\n/-- Readout preservation composes along composition of intertwiners. -/\n@[rep_depth krein]\ndef compReadoutPreservation\n    {P Q R : Presentation}\n    {F : Intertwiner P Q}\n    {G : Intertwiner Q R}\n    (hF : ReadoutPreservation F)\n    (hG : ReadoutPreservation G) :\n    ReadoutPreservation (compIntertwiner F G) where\n  metric := by\n    intro s\n    calc\n      G.mapScalar (F.mapScalar (P.metricReadout s))\n          = G.mapScalar (Q.metricReadout (F.mapState s)) := by\n              rw [hF.metric s]\n      _ = R.metricReadout (G.mapState (F.mapState s)) := by\n              rw [hG.metric (F.mapState s)]\n  phase := by\n    intro s\n    calc\n      G.mapScalar (F.mapScalar (P.phaseReadout s))\n          = G.mapScalar (Q.phaseReadout (F.mapState s)) := by\n              rw [hF.phase s]\n      _ = R.phaseReadout (G.mapState (F.mapState s)) := by\n              rw [hG.phase (F.mapState s)]\n\n/--\nConcrete toy presentation on paired states.\n\nIt provides a non-identity swap example for the `Intertwiner` and\nreadout-preservation machinery.  It is not a quantum owner surface.\n-/\n@[rep_depth operator]\ndef pairedFunctionPresentation (α : Type) : Presentation where\n  Scalar := α × α\n  State := α × α\n  Observable := (α → α) × (α → α)\n  act := fun o s => (o.1 s.1, o.2 s.2)\n  support := fun s => s.1 = s.2\n  generator := fun s => (s.2, s.1)\n  metricReadout := fun s => s\n  phaseReadout := fun s => (s.2, s.1)\n\n/-- Non-identity symmetry intertwiner on the paired-function presentation. -/\n@[rep_depth krein]\ndef pairedSwapIntertwiner (α : Type) :\n    Intertwiner (pairedFunctionPresentation α) (pairedFunctionPresentation α) where\n  mapState := fun s => (s.2, s.1)\n  mapObservable := fun o => (o.2, o.1)\n  mapScalar := fun x => (x.2, x.1)\n  map_act := by\n    intro o s\n    cases o\n    cases s\n    rfl\n  map_support := by\n    intro s hs\n    exact hs.symm\n  map_generator := by\n    intro s\n    cases s\n    rfl\n\n/-- Readout preservation for the paired swap intertwiner. -/\n@[rep_depth krein]\ndef pairedSwapReadoutPreservation (α : Type) :\n    ReadoutPreservation (pairedSwapIntertwiner α) where\n  metric := by\n    intro s\n    rfl\n  phase := by\n    intro s\n    rfl\n\n/-- The paired swap intertwiner is an involutive isomorphism. -/\n@[rep_depth krein]\ndef pairedSwapPresentationIsomorphism (α : Type) :\n    PresentationIsomorphism (pairedSwapIntertwiner α) where\n  inverse := pairedSwapIntertwiner α\n  forward_readout := pairedSwapReadoutPreservation α\n  inverse_readout := pairedSwapReadoutPreservation α\n  left_state := by\n    intro s\n    cases s\n    rfl\n  right_state := by\n    intro s\n    cases s\n    rfl\n  left_observable := by\n    intro o\n    cases o\n    rfl\n  right_observable := by\n    intro o\n    cases o\n    rfl\n  left_scalar := by\n    intro x\n    cases x\n    rfl\n  right_scalar := by\n    intro x\n    cases x\n    rfl\n\n/-- Backward-compatible name for the paired-swap presentation isomorphism. -/\n@[rep_depth krein]\ndef pairedSwapIntertwiner_isomorphism (α : Type) :\n    IntertwinerIsomorphism (pairedSwapIntertwiner α) :=\n  pairedSwapPresentationIsomorphism α\n","rangeOffset":120,"rangeLength":7105}]}