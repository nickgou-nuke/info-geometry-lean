import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Volume.ConnesInfinitesimal

/-!
# Surprisal Operator, Rényi family, and cumulant hierarchy

**Ontological correction:** `K = -log ρ` is **NOT** a mechanical Hamiltonian.
It is the **Surprisal Operator** / **Local Boltzmann Negentropy** — the
log-generating operator for the entire exponential family of deformed states.

The master object is the partition function

  Z(β) = ω(exp(-β K)) = ω(ρ^β)

for a state ω.  Its **values** give the Rényi family, while its **derivatives**
give the surprisal cumulant hierarchy.  The two ladders are independent and must
not be conflated.

**Colimit frontier:** `K = -log ρ` and `ρ^β` require continuous functional
calculus, which in this repo is carried by the categorical direct-inductive
colimit algebra (`UHFInductiveColimitBoundary`, `TensorTowerColimit`,
`PrimonColimitAlgebra`), not by mathlib's standard `CStarAlgebra` class.
`AlgebraEnd H` (doubled-space endomorphisms) carries the `NormedAlgebra ℝ`
structure needed for `NormedSpace.exp`, but the log/power operations are
deferred to the colimit specialization.  The theorems below therefore work with
the generator `K` as a primitive modular Hamiltonian and use a linear functional
`ω` in place of the matrix trace.
-/

noncomputable section

namespace InfoGeometry.Volume.SurprisalRenyiCumulantBridge

open InfoGeometry.Volume.ConnesInfinitesimal
open InfoGeometry.Volume.ConnesCocycle
open scoped Matrix

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [CompleteSpace H]

noncomputable local instance : NormedRing (AlgebraEnd H) := inferInstance
noncomputable local instance : NormedAlgebra ℝ (AlgebraEnd H) := inferInstance
local instance : IsTopologicalRing (AlgebraEnd H) := inferInstance
local instance : CompleteSpace (AlgebraEnd H) := inferInstance

/-! ## 1. The Rényi exponential family -/

/-- The **Rényi operator family** `R_β = exp(-β K)` for a generator `K`.

In the colimit-compatible setting, `K = -log ρ` is the Surprisal Operator.
Here `K` is taken as a primitive generator of the modular flow. -/
def renyiOperator (β : ℝ) (K : AlgebraEnd H) : AlgebraEnd H :=
  NormedSpace.exp (-β • K)

/-- The Rényi operator at zero is the identity. -/
@[simp] theorem renyiOperator_zero (K : AlgebraEnd H) :
    renyiOperator 0 K = 1 := by
  simp [renyiOperator, NormedSpace.exp_zero]

/-- The Rényi operator is multiplicative in the exponent:
    `R_{s+t} = R_s * R_t`. -/
theorem renyiOperator_add (s t : ℝ) (K : AlgebraEnd H) :
    renyiOperator (s + t) K = renyiOperator s K * renyiOperator t K := by
  unfold renyiOperator
  have h_comm : Commute (-s • K) (-t • K) := by
    have h1 : Commute K K := Commute.refl K
    have h2 : Commute (-s • K) K := h1.smul_left (-s)
    have h3 : Commute (-s • K) (-t • K) := h2.smul_right (-t)
    exact h3
  rw [neg_add, add_smul, NormedSpace.exp_add_of_commute h_comm]

/-- Two Rényi operators commute. -/
theorem renyiOperator_comm (s t : ℝ) (K : AlgebraEnd H) :
    Commute (renyiOperator s K) (renyiOperator t K) := by
  unfold renyiOperator
  have h : Commute (-s • K) (-t • K) := by
    have h1 : Commute K K := Commute.refl K
    have h2 : Commute (-s • K) K := h1.smul_left (-s)
    have h3 : Commute (-s • K) (-t • K) := h2.smul_right (-t)
    exact h3
  exact h.exp

/-- Scaling the generator scales the exponent:
    `R_β(γ K) = R_{βγ}(K)`. -/
@[simp] theorem renyiOperator_smul_generator (β γ : ℝ) (K : AlgebraEnd H) :
    renyiOperator β (γ • K) = renyiOperator (β * γ) K := by
  unfold renyiOperator
  rw [smul_smul, neg_mul]

/-- Every Rényi operator commutes with its generator. -/
theorem renyiOperator_commutes_generator (β : ℝ) (K : AlgebraEnd H) :
    Commute K (renyiOperator β K) := by
  unfold renyiOperator
  have h : Commute K (-β • K) := (Commute.refl K).smul_right (-β)
  exact h.exp_right

/-! ## 2. Modular invariance -/

/-- The modular flow fixes every Rényi operator.
The parameter `K` here is the Surprisal Operator / modular generator. -/
theorem modularFlow_fixes_renyiOperator
    (β : ℝ) (K : AlgebraEnd H) (t : ℝ) :
    modularHamiltonianAction K (renyiOperator β K) t =
      renyiOperator β K := by
  have h_comm : Commute (renyiOperator β K) K := by
    exact (renyiOperator_commutes_generator β K).symm
  exact modularHamiltonianAction_eq_self_of_commute K (renyiOperator β K) t h_comm

/-- A modular flow generated by `L` fixes `exp(-β K)` whenever `L` commutes with `K`. -/
theorem modularFlow_fixes_renyiOperator_of_commute
    (β : ℝ) (K L : AlgebraEnd H) (t : ℝ) (hComm : Commute K L) :
    modularHamiltonianAction L (renyiOperator β K) t =
      renyiOperator β K := by
  have h_comm : Commute (renyiOperator β K) L := by
    unfold renyiOperator
    have h : Commute (-β • K) L := hComm.smul_left (-β)
    exact h.exp_left
  exact modularHamiltonianAction_eq_self_of_commute L (renyiOperator β K) t h_comm

/-! ## 3. Partition function and logarithmic potential -/

/-- The partition function `Z(β) = ω(exp(-β K))` for a state ω.
In finite dimensions with the trace functional, this reduces to `Tr(ρ^β)`. -/
def partitionFunction (β : ℝ) (K : AlgebraEnd H) (ω : AlgebraEnd H →L[ℝ] ℝ) : ℝ :=
  ω (renyiOperator β K)

/-- The logarithmic partition function `Φ(β) = log Z(β)`.

Mathematically, `Z(β) > 0` is required for the logarithm to be defined on
positive reals. -/
def logPartitionFunction (β : ℝ) (K : AlgebraEnd H) (ω : AlgebraEnd H →L[ℝ] ℝ) : ℝ :=
  Real.log (partitionFunction β K ω)

/-- The escort state `ρ_β = exp(-β K) / Z(β)`.

Mathematically, `Z(β) ≠ 0` is required for the rescaling. -/
noncomputable def escortState (β : ℝ) (K : AlgebraEnd H) (ω : AlgebraEnd H →L[ℝ] ℝ)
    (hZ : partitionFunction β K ω ≠ 0) : AlgebraEnd H :=
  (partitionFunction β K ω)⁻¹ • renyiOperator β K

/-! ## 4. Rényi entropy family -/

/-- The Rényi entropy `S_β = log Z(β) / (1 - β)`.

Mathematically, `β ≠ 1` and `Z(β) > 0` are required. -/
def renyiEntropy (β : ℝ) (K : AlgebraEnd H) (ω : AlgebraEnd H →L[ℝ] ℝ) : ℝ :=
  logPartitionFunction β K ω / (1 - β)

/-- The Rényi-2 / collision entropy `S_2 = -log Z(2)`.

Mathematically, `Z(2) > 0` is required. -/
def collisionEntropy (K : AlgebraEnd H) (ω : AlgebraEnd H →L[ℝ] ℝ) : ℝ :=
  -logPartitionFunction 2 K ω

/-- Hartley entropy `S_0 = log rank(ρ) = log ω(I)`.

Mathematically, `Z(0) > 0` is required. -/
def hartleyEntropy (K : AlgebraEnd H) (ω : AlgebraEnd H →L[ℝ] ℝ) : ℝ :=
  Real.log (partitionFunction 0 K ω)

end InfoGeometry.Volume.SurprisalRenyiCumulantBridge
