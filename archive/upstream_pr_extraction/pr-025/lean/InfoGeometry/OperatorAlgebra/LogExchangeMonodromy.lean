import InfoGeometry.Clifford.ExchangeSMatrixBridge
import InfoGeometry.Clifford.ModularCftBridge
import InfoGeometry.Clifford.MonodromyFlowAdapter
import InfoGeometry.Dynamics.KanDecomposition
import InfoGeometry.OperatorAlgebra.ContinuumLimit
import Mathlib.Tactic

noncomputable section

/-!
# LogExchangeMonodromy

Typed bridge from the finite logarithmic monodromy/exchange block to the
repository-owned parabolic `N` corridor.

What this file proves:

* the LCFT parabolic flow step is exactly `Dynamics.KanDecomposition.componentN`;
* the logarithmic partner generator is the same square-zero matrix `epsilon`;
* upper Hadjiivanov monodromy powers factor through `componentN`;
* lower/scattering exchange blocks factor through `S * componentN (-t) * S⁻¹`;
* finite lower exchange S-matrices assembled from such local blocks stay in
  that conjugated `N` corridor.

What this file deliberately does not prove:

* full analytic Todorov--Hadjiivanov exchange algebra completeness;
* global CFT analytic continuation theorems;
* a full non-abelian braid/S-matrix representation beyond the finite block
  surface formalized here.
-/

namespace InfoGeometry.OperatorAlgebra.LogExchangeMonodromy

open Matrix
open InfoGeometry.Clifford.LogCftMonodromy
open InfoGeometry.Clifford.ModularCftBridge
open InfoGeometry.Clifford.MonodromyFlowAdapter
open InfoGeometry.Clifford.ExchangeSMatrixBridge
open InfoGeometry.Dynamics.KanDecomposition

/-- The matrix carrier used by the logarithmic exchange and KAN parabolic lanes. -/
abbrev LogExchangeMatrix := Matrix (Fin 2) (Fin 2) ℂ

/-- The LCFT parabolic flow step is exactly the KAN `N` component. -/
theorem lcftParabolicFlowStep_eq_componentN (t : ℂ) :
    lcftParabolicFlowStep t = componentN t := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lcftParabolicFlowStep_eq, componentN_eq]

/--
The KAN `N` component is the unipotent matrix generated by the logarithmic
partner `epsilon`.
-/
theorem componentN_eq_unipotent_epsilon (t : ℂ) :
    componentN t = (1 : LogExchangeMatrix) + t • epsilon := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [componentN_eq, epsilon, jordanNilpotent]

/-- The logarithmic partner generator used by `componentN` is square-zero. -/
theorem logarithmic_partner_epsilon_sq :
    (epsilon : LogExchangeMatrix) * epsilon = 0 := by
  exact epsilon_sq

/--
One Hadjiivanov monodromy wrap is a conformal phase times the repository-owned
KAN `N` component at logarithmic shear `-2πi`.
-/
theorem hadjiivanovMonodromy_eq_phase_componentN (h : ℂ) :
    hadjiivanovMonodromy h = lcftPhase h • componentN logShearBase := by
  rw [monodromy_is_parabolic_flow]
  simp [lcftParabolicFlowStep_eq_componentN]

/--
After `n` wraps, Hadjiivanov monodromy factors through the same `componentN`
surface, with phase `phase^n` and additive shear `n * (-2πi)`.
-/
theorem hadjiivanovMonodromy_pow_eq_phase_componentN (h : ℂ) (n : ℕ) :
    hadjiivanovMonodromy h ^ n =
      lcftPhase h ^ n • componentN ((n : ℂ) * logShearBase) := by
  rw [monodromy_pow_is_compounded_flow]
  simp [lcftParabolicFlowStep_eq_componentN]

/--
Lower/scattering convention: a lower parabolic S-block is the `S`-conjugate of
the KAN `N` component, with the sign dictated by the standard modular
conjugation convention.
-/
theorem lowerParabolicSBlock_eq_phase_conj_componentN (phase shear : ℂ) :
    lowerParabolicSBlock phase shear =
      phase • (modularS * componentN (-shear) * modularSInverse) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lowerParabolicSBlock, lowerJordanNilpotent, componentN_eq, modularS,
      modularSInverse]

/--
Lower Hadjiivanov monodromy powers factor through the conjugated KAN `N`
corridor.
-/
theorem lowerHadjiivanovMonodromy_pow_eq_phase_conj_componentN (h : ℂ) (n : ℕ) :
    lowerHadjiivanovMonodromy h ^ n =
      lcftPhase h ^ n •
        (modularS * componentN (-((n : ℂ) * logShearBase)) * modularSInverse) := by
  rw [lowerHadjiivanovMonodromy_pow_winding]
  simpa [lowerParabolicSBlock] using
    lowerParabolicSBlock_eq_phase_conj_componentN
      (lcftPhase h ^ n) ((n : ℂ) * logShearBase)

/--
An explicitly typed finite logarithmic exchange datum: a block together with
proof that it has protected lower parabolic form.
-/
abbrev LogExchangeDatum : Type _ :=
  Σ' phase : ℂ,
    Σ' shear : ℂ,
      Σ' block : LogExchangeMatrix,
        ExchangeLowerBlockConstraint block phase shear

namespace LogExchangeDatum

abbrev phase (D : LogExchangeDatum) : ℂ := D.1
abbrev shear (D : LogExchangeDatum) : ℂ := D.2.1
abbrev block (D : LogExchangeDatum) : LogExchangeMatrix := D.2.2.1
abbrev lower_constraint (D : LogExchangeDatum) :
    ExchangeLowerBlockConstraint D.2.2.1 D.1 D.2.1 := D.2.2.2

/-- Read a lower exchange datum through the existing KAN `N` corridor. -/
def kanReadback (D : LogExchangeDatum) : LogExchangeMatrix :=
  D.phase • (modularS * componentN (-D.shear) * modularSInverse)

/--
Typed bridge theorem: if the exchange datum has logarithmic-parabolic form,
then its matrix readback is exactly the conjugated `componentN` corridor.
-/
theorem block_eq_kanReadback (D : LogExchangeDatum) :
    D.block = D.kanReadback := by
  unfold kanReadback
  change D.2.2.1 = D.1 • (modularS * componentN (-D.2.1) * modularSInverse)
  rw [D.2.2.2]
  exact lowerParabolicSBlock_eq_phase_conj_componentN D.1 D.2.1

end LogExchangeDatum

/--
Finite S-matrix factorization through the KAN `N` corridor.

This is the proved finite block surface: a product of local lower parabolic
exchange blocks is a phase times an `S`-conjugated `componentN` block whose
shear is the accumulated logarithmic shear.
-/
theorem lowerExchangeSMatrix_factors_through_componentN (blocks : List (ℂ × ℂ)) :
    lowerExchangeSMatrix blocks =
      lowerExchangePhase blocks •
        (modularS * componentN (-(lowerExchangeShear blocks)) * modularSInverse) := by
  rw [lowerExchangeSMatrix_eq_lowerParabolicSBlock]
  exact lowerParabolicSBlock_eq_phase_conj_componentN
    (lowerExchangePhase blocks) (lowerExchangeShear blocks)

/-- Compatibility name: the local parabolic/logarithmic generator is square-zero. -/
theorem epsilon_nilpotent :
    (epsilon : LogExchangeMatrix) * epsilon = 0 :=
  logarithmic_partner_epsilon_sq

/-- Compatibility name: exact entry-by-entry evaluation of the KAN `componentN` matrix. -/
theorem componentN_apply (t : ℂ) :
    componentN t = !![1, t; 0, 1] :=
  componentN_eq t

/-- Compatibility name: the KAN `componentN` corridor composes by adding shear. -/
theorem componentN_mul (t₁ t₂ : ℂ) :
    componentN t₁ * componentN t₂ = componentN (t₁ + t₂) :=
  componentN_composition t₁ t₂

/--
Concrete continuum closure for the repository-owned logarithmic parabolic
generator.

This is the owner-side specialization of the abstract rescaled-step theorem:
the square-zero hypothesis is discharged by `logarithmic_partner_epsilon_sq`,
and the resulting continuum flow is read back as the KAN `componentN` surface.
-/
theorem componentN_rescaled_parabolic_pow_exact
    (t : ℂ) {n : ℕ} (hn : (n : ℂ) ≠ 0) :
    (ContinuumLimit.scaledParabolicStep (epsilon : LogExchangeMatrix) t n) ^ n =
      componentN t := by
  calc
    (ContinuumLimit.scaledParabolicStep (epsilon : LogExchangeMatrix) t n) ^ n
        = ContinuumLimit.continuumParabolicFlow (epsilon : LogExchangeMatrix) t := by
          exact ContinuumLimit.scaledParabolicStep_pow_exact
            (epsilon : LogExchangeMatrix) logarithmic_partner_epsilon_sq t hn
    _ = componentN t := by
          rw [ContinuumLimit.continuumParabolicFlow, componentN_eq_unipotent_epsilon]

/-- Spatial mirror swapping the two logarithmic basis vectors. -/
def S_mirror : LogExchangeMatrix :=
  !![0, 1; 1, 0]

/-- The spatial mirror is a strict involution. -/
theorem S_mirror_sq :
    S_mirror * S_mirror = (1 : LogExchangeMatrix) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [S_mirror, Matrix.mul_apply]

/--
Mirror conjugation sends the lower parabolic LCFT flow to the upper KAN
`componentN` corridor.
-/
theorem S_conjugation_componentN (t : ℂ) :
    S_mirror * lowerLcftParabolicFlowStep t * S_mirror = componentN t := by
  have h_lower : lowerLcftParabolicFlowStep t = !![1, 0; t, 1] := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [lowerLcftParabolicFlowStep, lowerJordanNilpotent]
  rw [componentN_eq]
  rw [h_lower]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [S_mirror, Matrix.mul_apply, Fin.sum_univ_two]

end InfoGeometry.OperatorAlgebra.LogExchangeMonodromy

namespace InfoGeometry.OperatorAlgebra

variable {A : Type*} [Ring A]

/--
Natural-number scalars are central in every ring.

This is the scalar bookkeeping lemma used by the abstract monodromy winding
formula in a noncommutative algebra.
-/
lemma commute_nat_cast (x : A) (n : ℕ) : Commute x (n : A) := by
  induction n with
  | zero =>
      simp
  | succ k ih =>
      rw [Nat.cast_succ]
      exact Commute.add_right ih (Commute.one_right x)

/--
One unipotent Jordan multiplication step:
`(1 + nε)(1 + ε) = 1 + (n+1)ε` when `ε² = 0`.

The `lambda` and commutation hypothesis are included so this lemma has the
same parameter surface as `monodromy_winding_formula`; the step itself only
uses square-zero nilpotency.
-/
lemma monodromy_step_mul (lambda epsilon : A) (h_nil : epsilon * epsilon = 0)
    (_h_comm : Commute lambda epsilon) (n : ℕ) :
    (1 + (n : A) * epsilon) * (1 + epsilon) =
      1 + ((n + 1 : ℕ) : A) * epsilon := by
  rw [add_mul, one_mul, mul_add, mul_one]
  have h_nil_term : (n : A) * epsilon * epsilon = 0 := by
    rw [mul_assoc, h_nil, mul_zero]
  rw [h_nil_term, add_zero]
  calc
    1 + epsilon + (n : A) * epsilon =
        1 + (1 * epsilon + (n : A) * epsilon) := by rw [one_mul, add_assoc]
    _ = 1 + ((1 + (n : A)) * epsilon) := by rw [add_mul]
    _ = 1 + (((n : A) + 1) * epsilon) := by rw [add_comm (1 : A) (n : A)]
    _ = 1 + ((n + 1 : ℕ) : A) * epsilon := by rw [Nat.cast_succ]

/--
Abstract monodromy winding formula.

If `epsilon² = 0` and the phase `lambda` commutes with `epsilon`, then winding
the local unipotent block `lambda * (1 + epsilon)` exactly `n` times gives
`lambda^n * (1 + n epsilon)`.
-/
theorem monodromy_winding_formula (lambda epsilon : A) (h_nil : epsilon * epsilon = 0)
    (h_comm : Commute lambda epsilon) (n : ℕ) :
    (lambda * (1 + epsilon)) ^ n =
      lambda ^ n * (1 + (n : A) * epsilon) := by
  exact InfoGeometry.QuantumMonodromy.monodromy_winding_formula
    lambda epsilon h_nil h_comm n

namespace LogExchangeMonodromy

/--
Concrete winding law for the logarithmic unipotent block.

The generic monodromy formula's nilpotence input is discharged by the local
LCFT/KAN owner generator.
-/
theorem logarithmic_unipotent_winding (n : ℕ) :
    ((1 : LogExchangeMatrix) +
        (_root_.InfoGeometry.Clifford.LogCftMonodromy.epsilon : LogExchangeMatrix)) ^ n =
      1 + ((n : LogExchangeMatrix) *
        (_root_.InfoGeometry.Clifford.LogCftMonodromy.epsilon : LogExchangeMatrix)) := by
  let ε : LogExchangeMatrix := _root_.InfoGeometry.Clifford.LogCftMonodromy.epsilon
  have hsq : ε * ε = 0 := logarithmic_partner_epsilon_sq
  simpa using
    (monodromy_winding_formula
      (lambda := (1 : LogExchangeMatrix))
      (epsilon := ε)
      hsq (Commute.one_left ε) n)

end LogExchangeMonodromy

end InfoGeometry.OperatorAlgebra
