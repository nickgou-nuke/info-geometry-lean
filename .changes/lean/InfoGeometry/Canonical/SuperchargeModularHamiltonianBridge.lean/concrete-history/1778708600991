{"type":"new","contents":"import InfoGeometry.Canonical.DrazinSupercharge\nimport InfoGeometry.Meta.Architecture\n\nset_option linter.dupNamespace false\n\nopen scoped InnerProductSpace\n\nnamespace InfoGeometry.Canonical.SuperchargeModularHamiltonianBridge\n\nopen InfoGeometry.Canonical\n\nvariable {E : Type*}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"EndH\" => E →L[ℝ] E\n\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℚ EndH :=\n  NormedAlgebra.restrictScalars ℚ ℝ EndH\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : SMulCommClass ℝ EndH EndH := inferInstance\nlocal instance : IsScalarTower ℝ EndH EndH := inferInstance\n\n/--\nBounded modular-Hamiltonian surrogate generated by the Drazin/MP supercharge.\n\nThis structure does not assert `Q² = Δ`, does not construct `log Δ`, and does not\nclaim a Type-III realization. It only calibrates the already-owned even\nregular-support Hamiltonian `P_D * Q² * P_D` by a positive real energy unit.\n-/\n@[rep_depth krein]\nstructure SuperchargeModularHamiltonianBridge where\n  CIK : CertifiedInverseKernel E\n\n  /-- Positive calibration unit converting the even super-Hamiltonian to a modular scale. -/\n  modularEnergyUnit : ℝ\n  modularEnergyUnit_pos : 0 < modularEnergyUnit\n\n  /-- Candidate bounded modular Hamiltonian surrogate. -/\n  Ksur : EndH\n\n  /--\n  The surrogate modular Hamiltonian is exactly the calibrated regular-support\n  compression of the Drazin/MP supercharge Hamiltonian.\n  -/\n  Ksur_law :\n    Ksur =\n      modularEnergyUnit •\n        DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian CIK\n\nnamespace SuperchargeModularHamiltonianBridge\n\nvariable (H : SuperchargeModularHamiltonianBridge (E := E))\n\n/-- Readback of the defining calibration law. -/\n@[rep_depth krein]\ntheorem Ksur_eq_calibrated_regularRestrictedSuperHamiltonian :\n    H.Ksur =\n      H.modularEnergyUnit •\n        DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK :=\n  H.Ksur_law\n\n/-- Left regular-support invariance: `P_D * K_sur = K_sur`. -/\n@[rep_depth krein]\ntheorem spectralProjector_mul_Ksur :\n    H.CIK.spectralProjector * H.Ksur = H.Ksur := by\n  rw [H.Ksur_law]\n  calc\n    H.CIK.spectralProjector *\n        (H.modularEnergyUnit •\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)\n        =\n      H.modularEnergyUnit •\n        (H.CIK.spectralProjector *\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK) := by\n        simp\n    _ =\n      H.modularEnergyUnit •\n        DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK := by\n        rw [\n          DrazinSupercharge.CertifiedInverseKernel.spectralProjector_mul_regularRestrictedSuperHamiltonian\n        ]\n\n/-- Right regular-support invariance: `K_sur * P_D = K_sur`. -/\n@[rep_depth krein]\ntheorem Ksur_mul_spectralProjector :\n    H.Ksur * H.CIK.spectralProjector = H.Ksur := by\n  rw [H.Ksur_law]\n  calc\n    (H.modularEnergyUnit •\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)\n        * H.CIK.spectralProjector\n        =\n      H.modularEnergyUnit •\n        (DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK\n          * H.CIK.spectralProjector) := by\n        simp\n    _ =\n      H.modularEnergyUnit •\n        DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK := by\n        rw [\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian_mul_spectralProjector\n        ]\n\n/-- Left defect annihilation: `P₀ * K_sur = 0`. -/\n@[rep_depth krein]\ntheorem spectralComplementaryProjector_mul_Ksur_eq_zero :\n    H.CIK.spectralComplementaryProjector * H.Ksur = 0 := by\n  rw [H.Ksur_law]\n  calc\n    H.CIK.spectralComplementaryProjector *\n        (H.modularEnergyUnit •\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)\n        =\n      H.modularEnergyUnit •\n        (H.CIK.spectralComplementaryProjector *\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK) := by\n        simp\n    _ = 0 := by\n        rw [\n          DrazinSupercharge.CertifiedInverseKernel.spectralComplementaryProjector_mul_regularRestrictedSuperHamiltonian_eq_zero\n        ]\n        simp\n\n/-- Right defect annihilation: `K_sur * P₀ = 0`. -/\n@[rep_depth krein]\ntheorem Ksur_mul_spectralComplementaryProjector_eq_zero :\n    H.Ksur * H.CIK.spectralComplementaryProjector = 0 := by\n  rw [H.Ksur_law]\n  calc\n    (H.modularEnergyUnit •\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)\n        * H.CIK.spectralComplementaryProjector\n        =\n      H.modularEnergyUnit •\n        (DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK\n          * H.CIK.spectralComplementaryProjector) := by\n        simp\n    _ = 0 := by\n        rw [\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian_mul_spectralComplementaryProjector_eq_zero\n        ]\n        simp\n\n/-- The calibrated surrogate commutes with the spectral grading. -/\n@[rep_depth krein]\ntheorem Ksur_commutes_GammaS :\n    H.Ksur * H.CIK.GammaS = H.CIK.GammaS * H.Ksur := by\n  rw [H.Ksur_law]\n  calc\n    (H.modularEnergyUnit •\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK)\n        * H.CIK.GammaS\n        =\n      H.modularEnergyUnit •\n        (DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK\n          * H.CIK.GammaS) := by\n        simp\n    _ =\n      H.modularEnergyUnit •\n        (H.CIK.GammaS *\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK) := by\n        rw [\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian_commutes_GammaS\n        ]\n    _ =\n      H.CIK.GammaS *\n        (H.modularEnergyUnit •\n          DrazinSupercharge.CertifiedInverseKernel.regularRestrictedSuperHamiltonian H.CIK) := by\n        simp\n\n/-- The bounded modular-Hamiltonian surrogate is in the even/spectrally compact lane. -/\n@[rep_depth krein]\ntheorem Ksur_isSpectralCompact :\n    let T := H.CIK.toInformationCartanTriple\n    T.IsSpectralCompact H.Ksur := by\n  let T := H.CIK.toInformationCartanTriple\n  rw [CartanDecomposition.InformationCartanTriple.isSpectralCompact_iff_commute T H.CIK.hDrazin]\n  simpa [T, CertifiedInverseKernel.GammaS, CertifiedInverseKernel.cartanTriple,\n    CertifiedInverseKernel.toInformationCartanTriple] using\n    Ksur_commutes_GammaS H\n\nend SuperchargeModularHamiltonianBridge\n\nend InfoGeometry.Canonical.SuperchargeModularHamiltonianBridge\n","mtime":1778708600991}