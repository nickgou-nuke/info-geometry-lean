import «InfoGeometry».«Algebra».«H3ZornAutomorphismConjugation»
import «InfoGeometry».«Algebra».«H3ZornCubicOperatorGeometry»
import «InfoGeometry».«Algebra».«H3ZornCubicPolarization»
import «InfoGeometry».«Algebra».«H3ZornCubicReconstruction»
import «InfoGeometry».«Algebra».«H3ZornInfinitesimalReconstruction»
import «InfoGeometry».«Algebra».«H3ZornOperatorNoncommutativity»
import «InfoGeometry».«Algebra».«H3ZornTraceNondegenerate»
import «InfoGeometry».«Algebra».«TrilinearStabilizer»
import «InfoGeometry».«Algebra».«JordanInnerDerivations»
import «InfoGeometry».«Algebra».«Zorn».«OffDiagonalDerivation»
import «SeligmanCubicOperatorTests»
import Lean.Util.CollectAxioms
import Lean.Elab.Command

/-!
Audit every new proof owner, the existing owner with changed proof bodies,
the repaired direct consumer, and the split-geometry regressions. The native
collector traverses every declaration's axiom dependencies transitively.
The implementation is generated by tools/quality/reviewed_audit_source.py;
only the target array is formatted across lines.
-/

open Lean Elab Command

run_cmd do
  let env ← getEnv
  let targets : Array Name := #[
    `«InfoGeometry».«Algebra».«H3ZornAutomorphismConjugation»,
    `«InfoGeometry».«Algebra».«H3ZornCubicOperatorGeometry»,
    `«InfoGeometry».«Algebra».«H3ZornCubicPolarization»,
    `«InfoGeometry».«Algebra».«H3ZornCubicReconstruction»,
    `«InfoGeometry».«Algebra».«H3ZornInfinitesimalReconstruction»,
    `«InfoGeometry».«Algebra».«H3ZornOperatorNoncommutativity»,
    `«InfoGeometry».«Algebra».«H3ZornTraceNondegenerate»,
    `«InfoGeometry».«Algebra».«TrilinearStabilizer»,
    `«InfoGeometry».«Algebra».«JordanInnerDerivations»,
    `«InfoGeometry».«Algebra».«Zorn».«OffDiagonalDerivation»,
    `«SeligmanCubicOperatorTests»]
  let commandOnly : Array Name := #[]
  for target in targets do
    unless env.header.moduleNames.contains target do
      throwError "Selected module not imported: {target}"
  let allowed : Array Name := #[`propext, `Classical.choice, `Quot.sound]
  let mut count : Nat := 0
  let mut ownerCounts : NameMap Nat := {}
  let mut allAxioms : Array Name := #[]
  for (name, info) in env.constants do
    let some idx := env.getModuleIdxFor? name | continue
    let owner := env.header.moduleNames[idx.toNat]!
    if !targets.contains owner then continue
    if info.isUnsafe || info.isPartial then
      throwError "Unsafe or partial declaration in reviewed module: {name}"
    -- Public API handles imported axiom metadata and private-body lookup.
    let axioms ← Lean.collectAxioms name
    for ax in axioms do
      unless allowed.contains ax do
        throwError "Disallowed axiom {ax} in {name}"
      if !allAxioms.contains ax then
        allAxioms := allAxioms.push ax
    count := count + 1
    ownerCounts := ownerCounts.insert owner ((ownerCounts.find? owner).getD 0 + 1)
    logInfo m!"AUDIT_DECL: {owner}: {name}"
  for target in targets do
    let moduleCount := (ownerCounts.find? target).getD 0
    logInfo m!"AUDIT_MODULE_COUNT: {target}: {moduleCount}"
    if commandOnly.contains target then
      if moduleCount != 0 then
        throwError "Command-only module owns declarations: {target}"
      logInfo m!"AUDIT_COMMAND_MODULE: {target}"
    else
      if moduleCount == 0 then
        throwError "No declarations audited in reviewed module: {target}"
      logInfo m!"AUDIT_MODULE: {target}"
  if count == 0 then throwError "No declarations audited"
  logInfo m!"AUDIT_AXIOMS: {allAxioms.qsort Name.lt}"
  logInfo m!"AUDIT_COUNT: {count}"
