import InfoGeometry.Canonical.ProjectorEquivariance
import InfoGeometry.Canonical.BogoliubovProjectorTransport
import InfoGeometry.Dynamics.UnruhKMS
import InfoGeometry.Meta.Architecture

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.ModularHamiltonianSignum

Ordered algebraic sign laws for the doubled modular boost Hamiltonian.

This file proves the signum statement that is actually available in the repo:
on the Unruh/Rindler boost lane, the modular Hamiltonian is the already-owned
Clifford/Krein sign involution `ε`, equivalently the projector difference
`P₊ - P₋`.

It does not claim a functional-calculus theorem `ε = sign(-log Δ)` for an
arbitrary modular operator.  The proofs here are only the ordered algebraic
relations rooted in the existing projector and doubled-space Clifford laws.
-/

namespace InfoGeometry.Canonical.ModularHamiltonianSignum

open InfoGeometry.Krein
open InfoGeometry.Canonical.ProjectorEquivariance
open InfoGeometry.Canonical.BogoliubovProjectorTransport

section Core

variable {E : Type*}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂
local notation "P₊" => spectralPlusProj (E := E)
local notation "P₋" => spectralMinusProj (E := E)
local notation "ε" => spectral_epsilon (E := E)
local notation "Kᵤ" => InfoGeometry.Dynamics.modularHamiltonian (E := E)

/-! ## Generic signum `Cl(1,1)` atom -/

/-- Ordinary operator commutator. -/
@[rep_depth krein]
noncomputable def signumCommutator
    (A B : DoubledSpace E →L[ℝ] DoubledSpace E) :
    DoubledSpace E →L[ℝ] DoubledSpace E :=
  A * B - B * A

/-- Ordinary operator anticommutator. -/
@[rep_depth krein]
noncomputable def signumAnticommutator
    (A B : DoubledSpace E →L[ℝ] DoubledSpace E) :
    DoubledSpace E →L[ℝ] DoubledSpace E :=
  A * B + B * A

/-- The phase/clock axis generated by a modular reflection `J` and signum `S`. -/
@[rep_depth krein]
noncomputable def signumPhaseAxis
    (J S : DoubledSpace E →L[ℝ] DoubledSpace E) :
    DoubledSpace E →L[ℝ] DoubledSpace E :=
  J * S

section GenericSignumAtom

variable {J S : DoubledSpace E →L[ℝ] DoubledSpace E}
variable (hJ : J * J = (1 : DoubledSpace E →L[ℝ] DoubledSpace E))
variable (hS : S * S = (1 : DoubledSpace E →L[ℝ] DoubledSpace E))
variable (hJS : J * S = -(S * J))
include hJ hS hJS

/-- Product orientation: `S J = - J S`. -/
@[rep_depth krein]
theorem signum_mul_reflection_eq_neg_phase :
    S * J = -(signumPhaseAxis (E := E) J S) := by
  unfold signumPhaseAxis
  simpa using (congrArg Neg.neg hJS).symm

/-- The generated phase axis squares to `-1`. -/
@[rep_depth krein]
theorem signumPhaseAxis_sq :
    signumPhaseAxis (E := E) J S * signumPhaseAxis (E := E) J S = -(1 : EndH) := by
  unfold signumPhaseAxis
  calc
    (J * S) * (J * S) = J * (S * J) * S := by noncomm_ring
    _ = J * (-(J * S)) * S := by
          rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]
          rfl
    _ = -(J * J) * (S * S) := by
          apply ContinuousLinearMap.ext
          intro x
          simp
    _ = -(1 : EndH) := by rw [hJ, hS]; simp

/-- `J K = S`. -/
@[rep_depth krein]
theorem reflection_mul_phaseAxis :
    J * signumPhaseAxis (E := E) J S = S := by
  unfold signumPhaseAxis
  calc
    J * (J * S) = (J * J) * S := by noncomm_ring
    _ = S := by rw [hJ]; simp

/-- `K J = -S`. -/
@[rep_depth krein]
theorem phaseAxis_mul_reflection :
    signumPhaseAxis (E := E) J S * J = -S := by
  unfold signumPhaseAxis
  calc
    (J * S) * J = J * (S * J) := by noncomm_ring
    _ = J * (-(J * S)) := by
          rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]
          rfl
    _ = -((J * J) * S) := by
          apply ContinuousLinearMap.ext
          intro x
          simp
    _ = -S := by rw [hJ]; simp

/-- `S K = -J`. -/
@[rep_depth krein]
theorem signum_mul_phaseAxis :
    S * signumPhaseAxis (E := E) J S = -J := by
  unfold signumPhaseAxis
  calc
    S * (J * S) = (S * J) * S := by noncomm_ring
    _ = (-(J * S)) * S := by
          rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]
          simp [signumPhaseAxis]
    _ = -(J * (S * S)) := by
          apply ContinuousLinearMap.ext
          intro x
          rfl
    _ = -J := by rw [hS]; simp

/-- `K S = J`. -/
@[rep_depth krein]
theorem phaseAxis_mul_signum :
    signumPhaseAxis (E := E) J S * S = J := by
  unfold signumPhaseAxis
  calc
    (J * S) * S = J * (S * S) := by noncomm_ring
    _ = J := by rw [hS]; simp

/-- The identity commutes with every operator. -/
@[rep_depth krein]
theorem signumCommutator_one_left (A : EndH) :
    signumCommutator (E := E) (1 : EndH) A = 0 := by
  simp [signumCommutator]

/-- Every operator commutes with the identity. -/
@[rep_depth krein]
theorem signumCommutator_one_right (A : EndH) :
    signumCommutator (E := E) A (1 : EndH) = 0 := by
  simp [signumCommutator]

/-- The identity anticommutator doubles an operator. -/
@[rep_depth krein]
theorem signumAnticommutator_one_left (A : EndH) :
    signumAnticommutator (E := E) (1 : EndH) A = (2 : ℝ) • A := by
  simp [signumAnticommutator]
  simpa using (two_smul ℝ A).symm

/-- The right identity anticommutator doubles an operator. -/
@[rep_depth krein]
theorem signumAnticommutator_one_right (A : EndH) :
    signumAnticommutator (E := E) A (1 : EndH) = (2 : ℝ) • A := by
  simp [signumAnticommutator]
  simpa using (two_smul ℝ A).symm

/-- `[J,S] = 2K`. -/
@[rep_depth krein]
theorem signumCommutator_reflection_signum :
    signumCommutator (E := E) J S = (2 : ℝ) • signumPhaseAxis (E := E) J S := by
  unfold signumCommutator
  rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]
  unfold signumPhaseAxis
  calc
    J * S - -(J * S) = J * S + J * S := by abel
    _ = (2 : ℝ) • (J * S) := by simpa using (two_smul ℝ (J * S)).symm

/-- `[S,J] = -2K`. -/
@[rep_depth krein]
theorem signumCommutator_signum_reflection :
    signumCommutator (E := E) S J = -((2 : ℝ) • signumPhaseAxis (E := E) J S) := by
  unfold signumCommutator
  rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]
  unfold signumPhaseAxis
  calc
    -(J * S) - J * S = -((J * S) + J * S) := by abel
    _ = -((2 : ℝ) • (J * S)) := by rw [(two_smul ℝ (J * S)).symm]

/-- `[J,K] = 2S`. -/
@[rep_depth krein]
theorem signumCommutator_reflection_phaseAxis :
    signumCommutator (E := E) J (signumPhaseAxis (E := E) J S) = (2 : ℝ) • S := by
  unfold signumCommutator
  rw [reflection_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]
  rw [phaseAxis_mul_reflection (E := E) (J := J) (S := S) hJ hS hJS]
  calc
    S - -S = S + S := by abel
    _ = (2 : ℝ) • S := by simpa using (two_smul ℝ S).symm

/-- `[K,J] = -2S`. -/
@[rep_depth krein]
theorem signumCommutator_phaseAxis_reflection :
    signumCommutator (E := E) (signumPhaseAxis (E := E) J S) J = -((2 : ℝ) • S) := by
  unfold signumCommutator
  rw [reflection_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]
  rw [phaseAxis_mul_reflection (E := E) (J := J) (S := S) hJ hS hJS]
  calc
    -S - S = -(S + S) := by abel
    _ = -((2 : ℝ) • S) := by rw [(two_smul ℝ S).symm]

/-- `[S,K] = -2J`. -/
@[rep_depth krein]
theorem signumCommutator_signum_phaseAxis :
    signumCommutator (E := E) S (signumPhaseAxis (E := E) J S) = -((2 : ℝ) • J) := by
  unfold signumCommutator
  rw [signum_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]
  rw [phaseAxis_mul_signum (E := E) (J := J) (S := S) hJ hS hJS]
  calc
    -J - J = -(J + J) := by abel
    _ = -((2 : ℝ) • J) := by rw [(two_smul ℝ J).symm]

/-- `[K,S] = 2J`. -/
@[rep_depth krein]
theorem signumCommutator_phaseAxis_signum :
    signumCommutator (E := E) (signumPhaseAxis (E := E) J S) S = (2 : ℝ) • J := by
  unfold signumCommutator
  rw [signum_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]
  rw [phaseAxis_mul_signum (E := E) (J := J) (S := S) hJ hS hJS]
  calc
    J - -J = J + J := by abel
    _ = (2 : ℝ) • J := by simpa using (two_smul ℝ J).symm

/-- `{J,S} = 0`. -/
@[rep_depth krein]
theorem signumAnticommutator_reflection_signum :
    signumAnticommutator (E := E) J S = 0 := by
  unfold signumAnticommutator
  rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]
  simp [signumPhaseAxis]

/-- `{J,K} = 0`. -/
@[rep_depth krein]
theorem signumAnticommutator_reflection_phaseAxis :
    signumAnticommutator (E := E) J (signumPhaseAxis (E := E) J S) = 0 := by
  unfold signumAnticommutator
  rw [reflection_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]
  rw [phaseAxis_mul_reflection (E := E) (J := J) (S := S) hJ hS hJS]
  abel

/-- `{S,K} = 0`. -/
@[rep_depth krein]
theorem signumAnticommutator_signum_phaseAxis :
    signumAnticommutator (E := E) S (signumPhaseAxis (E := E) J S) = 0 := by
  unfold signumAnticommutator
  rw [signum_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]
  rw [phaseAxis_mul_signum (E := E) (J := J) (S := S) hJ hS hJS]
  abel

/-- `{J,J} = 2`. -/
@[rep_depth krein]
theorem signumAnticommutator_reflection_reflection :
    signumAnticommutator (E := E) J J = (2 : ℝ) • (1 : EndH) := by
  unfold signumAnticommutator
  rw [hJ]
  simpa using (two_smul ℝ (1 : EndH)).symm

/-- `{S,S} = 2`. -/
@[rep_depth krein]
theorem signumAnticommutator_signum_signum :
    signumAnticommutator (E := E) S S = (2 : ℝ) • (1 : EndH) := by
  unfold signumAnticommutator
  rw [hS]
  simpa using (two_smul ℝ (1 : EndH)).symm

/-- `{K,K} = -2`. -/
@[rep_depth krein]
theorem signumAnticommutator_phaseAxis_phaseAxis :
    signumAnticommutator (E := E) (signumPhaseAxis (E := E) J S)
        (signumPhaseAxis (E := E) J S)
      = -((2 : ℝ) • (1 : EndH)) := by
  unfold signumAnticommutator
  rw [signumPhaseAxis_sq (E := E) (J := J) (S := S) hJ hS hJS]
  calc
    -(1 : EndH) + -(1 : EndH) = -((1 : EndH) + (1 : EndH)) := by abel
    _ = -((2 : ℝ) • (1 : EndH)) := by rw [(two_smul ℝ (1 : EndH)).symm]

end GenericSignumAtom

/-! ## General modular-Hamiltonian signum atom with zero sector

For a general modular Hamiltonian `K = log Δ`, the signum `S = sgn(K)` may
have a zero-mode sector.  Algebraically this means `S² = p`, where
`p = 1 - P₀` is the complement of the zero spectral projection.

The following section does not construct functional calculus.  It proves the
complete product, commutator, and anticommutator table from the modular signum
relations:

* `J² = 1`;
* `S² = p`;
* `J S = - S J`.

These are the exact algebraic consequences of `J K J = -K` and
`S = sgn(K)` once the signum and zero-sector projection have been supplied.
-/

section GeneralSignumWithZeroSector

variable {J S p : DoubledSpace E →L[ℝ] DoubledSpace E}
variable (hJ : J * J = (1 : DoubledSpace E →L[ℝ] DoubledSpace E))
variable (hS : S * S = p)
variable (hJS : J * S = -(S * J))
include hJ hS hJS

/-- Zero-sector-aware product orientation: `S J = - J S`. -/
@[rep_depth krein]
theorem modularSignum_mul_reflection_eq_neg_phase :
    S * J = -(signumPhaseAxis (E := E) J S) := by
  unfold signumPhaseAxis
  simpa using (congrArg Neg.neg hJS).symm

/-- With `q = J S`, the square is `q² = -p`. -/
@[rep_depth krein]
theorem modularSignum_phaseAxis_sq :
    signumPhaseAxis (E := E) J S * signumPhaseAxis (E := E) J S = -p := by
  unfold signumPhaseAxis
  apply ContinuousLinearMap.ext
  intro x
  have hSJ :
      S * J = -(J * S) :=
    modularSignum_mul_reflection_eq_neg_phase
      (E := E) (J := J) (S := S) (p := p) hJ hS hJS
  have hSJx : S (J (S x)) = -J (S (S x)) := by
    simpa using congrArg (fun F : EndH => F (S x)) hSJ
  have hJx : J (J (S (S x))) = S (S x) := by
    simpa using congrArg (fun F : EndH => F (S (S x))) hJ
  have hSx : S (S x) = p x := by
    simpa using congrArg (fun F : EndH => F x) hS
  calc
    ((J * S) * (J * S)) x = J (S (J (S x))) := rfl
    _ = J (-J (S (S x))) := by rw [hSJx]
    _ = -J (J (S (S x))) := by simp
    _ = -S (S x) := by rw [hJx]
    _ = (-p) x := by rw [hSx]; rfl

/-- `J q = S`. -/
@[rep_depth krein]
theorem modularSignum_reflection_mul_phaseAxis :
    J * signumPhaseAxis (E := E) J S = S := by
  unfold signumPhaseAxis
  calc
    J * (J * S) = (J * J) * S := by noncomm_ring
    _ = S := by rw [hJ]; simp

/-- `q J = -S`. -/
@[rep_depth krein]
theorem modularSignum_phaseAxis_mul_reflection :
    signumPhaseAxis (E := E) J S * J = -S := by
  unfold signumPhaseAxis
  calc
    (J * S) * J = J * (S * J) := by noncomm_ring
    _ = J * (-(J * S)) := by
          rw [modularSignum_mul_reflection_eq_neg_phase
            (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
          rfl
    _ = -((J * J) * S) := by
          apply ContinuousLinearMap.ext
          intro x
          simp
    _ = -S := by rw [hJ]; simp

/-- `S q = -J p`. -/
@[rep_depth krein]
theorem modularSignum_signum_mul_phaseAxis :
    S * signumPhaseAxis (E := E) J S = -(J * p) := by
  unfold signumPhaseAxis
  calc
    S * (J * S) = (S * J) * S := by noncomm_ring
    _ = (-(J * S)) * S := by
          rw [modularSignum_mul_reflection_eq_neg_phase
            (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
          simp [signumPhaseAxis]
    _ = -(J * (S * S)) := by
          apply ContinuousLinearMap.ext
          intro x
          rfl
    _ = -(J * p) := by rw [hS]

/-- `q S = J p`. -/
@[rep_depth krein]
theorem modularSignum_phaseAxis_mul_signum :
    signumPhaseAxis (E := E) J S * S = J * p := by
  unfold signumPhaseAxis
  calc
    (J * S) * S = J * (S * S) := by noncomm_ring
    _ = J * p := by rw [hS]

/-- `[J,S] = 2q`. -/
@[rep_depth krein]
theorem modularSignumCommutator_reflection_signum :
    signumCommutator (E := E) J S = (2 : ℝ) • signumPhaseAxis (E := E) J S := by
  unfold signumCommutator
  rw [modularSignum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  unfold signumPhaseAxis
  calc
    J * S - -(J * S) = J * S + J * S := by abel
    _ = (2 : ℝ) • (J * S) := by simpa using (two_smul ℝ (J * S)).symm

/-- `[S,J] = -2q`. -/
@[rep_depth krein]
theorem modularSignumCommutator_signum_reflection :
    signumCommutator (E := E) S J = -((2 : ℝ) • signumPhaseAxis (E := E) J S) := by
  unfold signumCommutator
  rw [modularSignum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  unfold signumPhaseAxis
  calc
    -(J * S) - J * S = -((J * S) + J * S) := by abel
    _ = -((2 : ℝ) • (J * S)) := by rw [(two_smul ℝ (J * S)).symm]

/-- `[J,q] = 2S`. -/
@[rep_depth krein]
theorem modularSignumCommutator_reflection_phaseAxis :
    signumCommutator (E := E) J (signumPhaseAxis (E := E) J S) = (2 : ℝ) • S := by
  unfold signumCommutator
  rw [modularSignum_reflection_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  rw [modularSignum_phaseAxis_mul_reflection (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  calc
    S - -S = S + S := by abel
    _ = (2 : ℝ) • S := by simpa using (two_smul ℝ S).symm

/-- `[q,J] = -2S`. -/
@[rep_depth krein]
theorem modularSignumCommutator_phaseAxis_reflection :
    signumCommutator (E := E) (signumPhaseAxis (E := E) J S) J = -((2 : ℝ) • S) := by
  unfold signumCommutator
  rw [modularSignum_reflection_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  rw [modularSignum_phaseAxis_mul_reflection (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  calc
    -S - S = -(S + S) := by abel
    _ = -((2 : ℝ) • S) := by rw [(two_smul ℝ S).symm]

/-- `[S,q] = -2 J p`. -/
@[rep_depth krein]
theorem modularSignumCommutator_signum_phaseAxis :
    signumCommutator (E := E) S (signumPhaseAxis (E := E) J S) = -((2 : ℝ) • (J * p)) := by
  unfold signumCommutator
  rw [modularSignum_signum_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  rw [modularSignum_phaseAxis_mul_signum (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  calc
    -(J * p) - J * p = -((J * p) + (J * p)) := by abel
    _ = -((2 : ℝ) • (J * p)) := by rw [(two_smul ℝ (J * p)).symm]

/-- `[q,S] = 2 J p`. -/
@[rep_depth krein]
theorem modularSignumCommutator_phaseAxis_signum :
    signumCommutator (E := E) (signumPhaseAxis (E := E) J S) S = (2 : ℝ) • (J * p) := by
  unfold signumCommutator
  rw [modularSignum_signum_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  rw [modularSignum_phaseAxis_mul_signum (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  calc
    J * p - -(J * p) = J * p + J * p := by abel
    _ = (2 : ℝ) • (J * p) := by simpa using (two_smul ℝ (J * p)).symm

/-- `{J,S} = 0`. -/
@[rep_depth krein]
theorem modularSignumAnticommutator_reflection_signum :
    signumAnticommutator (E := E) J S = 0 := by
  unfold signumAnticommutator
  rw [modularSignum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  simp [signumPhaseAxis]

/-- `{J,q} = 0`. -/
@[rep_depth krein]
theorem modularSignumAnticommutator_reflection_phaseAxis :
    signumAnticommutator (E := E) J (signumPhaseAxis (E := E) J S) = 0 := by
  unfold signumAnticommutator
  rw [modularSignum_reflection_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  rw [modularSignum_phaseAxis_mul_reflection (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  abel

/-- `{S,q} = 0`. -/
@[rep_depth krein]
theorem modularSignumAnticommutator_signum_phaseAxis :
    signumAnticommutator (E := E) S (signumPhaseAxis (E := E) J S) = 0 := by
  unfold signumAnticommutator
  rw [modularSignum_signum_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  rw [modularSignum_phaseAxis_mul_signum (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  abel

/-- `{J,J} = 2`. -/
@[rep_depth krein]
theorem modularSignumAnticommutator_reflection_reflection :
    signumAnticommutator (E := E) J J = (2 : ℝ) • (1 : EndH) := by
  unfold signumAnticommutator
  rw [hJ]
  simpa using (two_smul ℝ (1 : EndH)).symm

/-- `{S,S} = 2p`. -/
@[rep_depth krein]
theorem modularSignumAnticommutator_signum_signum :
    signumAnticommutator (E := E) S S = (2 : ℝ) • p := by
  unfold signumAnticommutator
  rw [hS]
  simpa using (two_smul ℝ p).symm

/-- `{q,q} = -2p`. -/
@[rep_depth krein]
theorem modularSignumAnticommutator_phaseAxis_phaseAxis :
    signumAnticommutator (E := E) (signumPhaseAxis (E := E) J S)
        (signumPhaseAxis (E := E) J S)
      = -((2 : ℝ) • p) := by
  unfold signumAnticommutator
  rw [modularSignum_phaseAxis_sq (E := E) (J := J) (S := S) (p := p) hJ hS hJS]
  calc
    -p + -p = -(p + p) := by abel
    _ = -((2 : ℝ) • p) := by rw [(two_smul ℝ p).symm]

end GeneralSignumWithZeroSector

/-- Ordered readback: the projector-first sign operator is the Clifford/Krein `ε`. -/
@[rep_depth krein]
theorem epsilon_eq_projector_sign :
    ε = plusProjector (E := E) - minusProjector (E := E) := by
  simpa [modularSign] using spectral_epsilon_eq_modularSign (E := E)

/-- Ordered readback using the canonical spectral projectors. -/
@[rep_depth krein]
theorem epsilon_eq_spectral_projector_sign :
    ε = P₊ - P₋ := by
  simpa [plusProjector_eq_spectralPlusProj (E := E),
    minusProjector_eq_spectralMinusProj (E := E)] using
    epsilon_eq_projector_sign (E := E)

/-- The sign operator is an involution. -/
@[rep_depth krein]
theorem epsilon_sign_sq_one :
    (ε : EndH) * ε = (1 : EndH) := by
  change (spectral_epsilon (E := E)).comp (spectral_epsilon (E := E))
    = ContinuousLinearMap.id ℝ H₂
  simpa using spectral_epsilon_involution (E := E)

/-- The `+` spectral projector is a left `+1` eigensector for `ε`. -/
@[rep_depth krein]
theorem epsilon_mul_plusProjector :
    (ε).comp P₊ = P₊ :=
  spectral_epsilon_comp_spectralPlusProj (E := E)

/-- The `-` spectral projector is a left `-1` eigensector for `ε`. -/
@[rep_depth krein]
theorem epsilon_mul_minusProjector :
    (ε).comp P₋ = -P₋ :=
  spectral_epsilon_comp_spectralMinusProj (E := E)

/-- The `+` spectral projector is also a right `+1` eigensector for `ε`. -/
@[rep_depth krein]
theorem plusProjector_mul_epsilon :
    P₊.comp ε = P₊ :=
  spectralPlusProj_comp_spectral_epsilon (E := E)

/-- The `-` spectral projector is also a right `-1` eigensector for `ε`. -/
@[rep_depth krein]
theorem minusProjector_mul_epsilon :
    P₋.comp ε = -P₋ :=
  spectralMinusProj_comp_spectral_epsilon (E := E)

/-- On the Unruh/Rindler lane, the modular Hamiltonian is the sign involution `ε`. -/
@[rep_depth krein]
theorem unruh_modularHamiltonian_eq_epsilon :
    Kᵤ = ε := by
  rfl

/--
On the Unruh/Rindler lane, the modular Hamiltonian is the projector-first sign
`P₊ - P₋`.
-/
@[rep_depth krein]
theorem unruh_modularHamiltonian_eq_projector_sign :
    Kᵤ = plusProjector (E := E) - minusProjector (E := E) := by
  rw [unruh_modularHamiltonian_eq_epsilon]
  exact epsilon_eq_projector_sign (E := E)

/-- The Unruh/Rindler modular Hamiltonian squares to the identity. -/
@[rep_depth krein]
theorem unruh_modularHamiltonian_sq_one :
    (Kᵤ : EndH) * Kᵤ = (1 : EndH) := by
  simpa [unruh_modularHamiltonian_eq_epsilon (E := E)] using
    epsilon_sign_sq_one (E := E)

/-- The Unruh/Rindler modular Hamiltonian acts by `+1` on the plus sector. -/
@[rep_depth krein]
theorem unruh_modularHamiltonian_mul_plusProjector :
    (Kᵤ).comp P₊ = P₊ := by
  simpa [unruh_modularHamiltonian_eq_epsilon (E := E)] using
    epsilon_mul_plusProjector (E := E)

/-- The Unruh/Rindler modular Hamiltonian acts by `-1` on the minus sector. -/
@[rep_depth krein]
theorem unruh_modularHamiltonian_mul_minusProjector :
    (Kᵤ).comp P₋ = -P₋ := by
  simpa [unruh_modularHamiltonian_eq_epsilon (E := E)] using
    epsilon_mul_minusProjector (E := E)

/-- Right-action version of the plus-sector sign law. -/
@[rep_depth krein]
theorem plusProjector_mul_unruh_modularHamiltonian :
    P₊.comp Kᵤ = P₊ := by
  simpa [unruh_modularHamiltonian_eq_epsilon (E := E)] using
    plusProjector_mul_epsilon (E := E)

/-- Right-action version of the minus-sector sign law. -/
@[rep_depth krein]
theorem minusProjector_mul_unruh_modularHamiltonian :
    P₋.comp Kᵤ = -P₋ := by
  simpa [unruh_modularHamiltonian_eq_epsilon (E := E)] using
    minusProjector_mul_epsilon (E := E)

end Core

end InfoGeometry.Canonical.ModularHamiltonianSignum
