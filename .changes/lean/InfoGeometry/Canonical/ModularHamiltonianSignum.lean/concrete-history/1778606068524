{"type":"new","contents":"import InfoGeometry.Canonical.ProjectorEquivariance\nimport InfoGeometry.Canonical.BogoliubovProjectorTransport\nimport InfoGeometry.Dynamics.UnruhKMS\nimport InfoGeometry.Meta.Architecture\n\nopen scoped InnerProductSpace\n\n/-!\n# InfoGeometry.Canonical.ModularHamiltonianSignum\n\nOrdered algebraic sign laws for the doubled modular boost Hamiltonian.\n\nThis file proves the signum statement that is actually available in the repo:\non the Unruh/Rindler boost lane, the modular Hamiltonian is the already-owned\nClifford/Krein sign involution `ε`, equivalently the projector difference\n`P₊ - P₋`.\n\nIt does not claim a functional-calculus theorem `ε = sign(-log Δ)` for an\narbitrary modular operator.  The proofs here are only the ordered algebraic\nrelations rooted in the existing projector and doubled-space Clifford laws.\n-/\n\nnamespace InfoGeometry.Canonical.ModularHamiltonianSignum\n\nopen InfoGeometry.Krein\nopen InfoGeometry.Canonical.ProjectorEquivariance\nopen InfoGeometry.Canonical.BogoliubovProjectorTransport\n\nsection Core\n\nvariable {E : Type*}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\nlocal notation \"P₊\" => spectralPlusProj (E := E)\nlocal notation \"P₋\" => spectralMinusProj (E := E)\nlocal notation \"ε\" => spectral_epsilon (E := E)\nlocal notation \"Kᵤ\" => InfoGeometry.Dynamics.modularHamiltonian (E := E)\n\n/-! ## Generic signum `Cl(1,1)` atom -/\n\n/-- Ordinary operator commutator. -/\n@[rep_depth krein]\nnoncomputable def signumCommutator\n    (A B : DoubledSpace E →L[ℝ] DoubledSpace E) :\n    DoubledSpace E →L[ℝ] DoubledSpace E :=\n  A * B - B * A\n\n/-- Ordinary operator anticommutator. -/\n@[rep_depth krein]\nnoncomputable def signumAnticommutator\n    (A B : DoubledSpace E →L[ℝ] DoubledSpace E) :\n    DoubledSpace E →L[ℝ] DoubledSpace E :=\n  A * B + B * A\n\n/-- The phase/clock axis generated by a modular reflection `J` and signum `S`. -/\n@[rep_depth krein]\nnoncomputable def signumPhaseAxis\n    (J S : DoubledSpace E →L[ℝ] DoubledSpace E) :\n    DoubledSpace E →L[ℝ] DoubledSpace E :=\n  J * S\n\nsection GenericSignumAtom\n\nvariable {J S : DoubledSpace E →L[ℝ] DoubledSpace E}\nvariable (hJ : J * J = (1 : DoubledSpace E →L[ℝ] DoubledSpace E))\nvariable (hS : S * S = (1 : DoubledSpace E →L[ℝ] DoubledSpace E))\nvariable (hJS : J * S = -(S * J))\ninclude hJ hS hJS\n\n/-- Product orientation: `S J = - J S`. -/\n@[rep_depth krein]\ntheorem signum_mul_reflection_eq_neg_phase :\n    S * J = -(signumPhaseAxis (E := E) J S) := by\n  unfold signumPhaseAxis\n  simpa using (congrArg Neg.neg hJS).symm\n\n/-- The generated phase axis squares to `-1`. -/\n@[rep_depth krein]\ntheorem signumPhaseAxis_sq :\n    signumPhaseAxis (E := E) J S * signumPhaseAxis (E := E) J S = -(1 : EndH) := by\n  unfold signumPhaseAxis\n  calc\n    (J * S) * (J * S) = J * (S * J) * S := by noncomm_ring\n    _ = J * (-(J * S)) * S := by\n          rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]\n          rfl\n    _ = -(J * J) * (S * S) := by\n          apply ContinuousLinearMap.ext\n          intro x\n          simp\n    _ = -(1 : EndH) := by rw [hJ, hS]; simp\n\n/-- `J K = S`. -/\n@[rep_depth krein]\ntheorem reflection_mul_phaseAxis :\n    J * signumPhaseAxis (E := E) J S = S := by\n  unfold signumPhaseAxis\n  calc\n    J * (J * S) = (J * J) * S := by noncomm_ring\n    _ = S := by rw [hJ]; simp\n\n/-- `K J = -S`. -/\n@[rep_depth krein]\ntheorem phaseAxis_mul_reflection :\n    signumPhaseAxis (E := E) J S * J = -S := by\n  unfold signumPhaseAxis\n  calc\n    (J * S) * J = J * (S * J) := by noncomm_ring\n    _ = J * (-(J * S)) := by\n          rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]\n          rfl\n    _ = -((J * J) * S) := by\n          apply ContinuousLinearMap.ext\n          intro x\n          simp\n    _ = -S := by rw [hJ]; simp\n\n/-- `S K = -J`. -/\n@[rep_depth krein]\ntheorem signum_mul_phaseAxis :\n    S * signumPhaseAxis (E := E) J S = -J := by\n  unfold signumPhaseAxis\n  calc\n    S * (J * S) = (S * J) * S := by noncomm_ring\n    _ = (-(J * S)) * S := by\n          rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]\n          simp [signumPhaseAxis]\n    _ = -(J * (S * S)) := by\n          apply ContinuousLinearMap.ext\n          intro x\n          rfl\n    _ = -J := by rw [hS]; simp\n\n/-- `K S = J`. -/\n@[rep_depth krein]\ntheorem phaseAxis_mul_signum :\n    signumPhaseAxis (E := E) J S * S = J := by\n  unfold signumPhaseAxis\n  calc\n    (J * S) * S = J * (S * S) := by noncomm_ring\n    _ = J := by rw [hS]; simp\n\n/-- The identity commutes with every operator. -/\n@[rep_depth krein]\ntheorem signumCommutator_one_left (A : EndH) :\n    signumCommutator (E := E) (1 : EndH) A = 0 := by\n  simp [signumCommutator]\n\n/-- Every operator commutes with the identity. -/\n@[rep_depth krein]\ntheorem signumCommutator_one_right (A : EndH) :\n    signumCommutator (E := E) A (1 : EndH) = 0 := by\n  simp [signumCommutator]\n\n/-- The identity anticommutator doubles an operator. -/\n@[rep_depth krein]\ntheorem signumAnticommutator_one_left (A : EndH) :\n    signumAnticommutator (E := E) (1 : EndH) A = (2 : ℝ) • A := by\n  simp [signumAnticommutator]\n  simpa using (two_smul ℝ A).symm\n\n/-- The right identity anticommutator doubles an operator. -/\n@[rep_depth krein]\ntheorem signumAnticommutator_one_right (A : EndH) :\n    signumAnticommutator (E := E) A (1 : EndH) = (2 : ℝ) • A := by\n  simp [signumAnticommutator]\n  simpa using (two_smul ℝ A).symm\n\n/-- `[J,S] = 2K`. -/\n@[rep_depth krein]\ntheorem signumCommutator_reflection_signum :\n    signumCommutator (E := E) J S = (2 : ℝ) • signumPhaseAxis (E := E) J S := by\n  unfold signumCommutator\n  rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]\n  unfold signumPhaseAxis\n  calc\n    J * S - -(J * S) = J * S + J * S := by abel\n    _ = (2 : ℝ) • (J * S) := by simpa using (two_smul ℝ (J * S)).symm\n\n/-- `[S,J] = -2K`. -/\n@[rep_depth krein]\ntheorem signumCommutator_signum_reflection :\n    signumCommutator (E := E) S J = -((2 : ℝ) • signumPhaseAxis (E := E) J S) := by\n  unfold signumCommutator\n  rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]\n  unfold signumPhaseAxis\n  calc\n    -(J * S) - J * S = -((J * S) + J * S) := by abel\n    _ = -((2 : ℝ) • (J * S)) := by rw [(two_smul ℝ (J * S)).symm]\n\n/-- `[J,K] = 2S`. -/\n@[rep_depth krein]\ntheorem signumCommutator_reflection_phaseAxis :\n    signumCommutator (E := E) J (signumPhaseAxis (E := E) J S) = (2 : ℝ) • S := by\n  unfold signumCommutator\n  rw [reflection_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]\n  rw [phaseAxis_mul_reflection (E := E) (J := J) (S := S) hJ hS hJS]\n  calc\n    S - -S = S + S := by abel\n    _ = (2 : ℝ) • S := by simpa using (two_smul ℝ S).symm\n\n/-- `[K,J] = -2S`. -/\n@[rep_depth krein]\ntheorem signumCommutator_phaseAxis_reflection :\n    signumCommutator (E := E) (signumPhaseAxis (E := E) J S) J = -((2 : ℝ) • S) := by\n  unfold signumCommutator\n  rw [reflection_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]\n  rw [phaseAxis_mul_reflection (E := E) (J := J) (S := S) hJ hS hJS]\n  calc\n    -S - S = -(S + S) := by abel\n    _ = -((2 : ℝ) • S) := by rw [(two_smul ℝ S).symm]\n\n/-- `[S,K] = -2J`. -/\n@[rep_depth krein]\ntheorem signumCommutator_signum_phaseAxis :\n    signumCommutator (E := E) S (signumPhaseAxis (E := E) J S) = -((2 : ℝ) • J) := by\n  unfold signumCommutator\n  rw [signum_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]\n  rw [phaseAxis_mul_signum (E := E) (J := J) (S := S) hJ hS hJS]\n  calc\n    -J - J = -(J + J) := by abel\n    _ = -((2 : ℝ) • J) := by rw [(two_smul ℝ J).symm]\n\n/-- `[K,S] = 2J`. -/\n@[rep_depth krein]\ntheorem signumCommutator_phaseAxis_signum :\n    signumCommutator (E := E) (signumPhaseAxis (E := E) J S) S = (2 : ℝ) • J := by\n  unfold signumCommutator\n  rw [signum_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]\n  rw [phaseAxis_mul_signum (E := E) (J := J) (S := S) hJ hS hJS]\n  calc\n    J - -J = J + J := by abel\n    _ = (2 : ℝ) • J := by simpa using (two_smul ℝ J).symm\n\n/-- `{J,S} = 0`. -/\n@[rep_depth krein]\ntheorem signumAnticommutator_reflection_signum :\n    signumAnticommutator (E := E) J S = 0 := by\n  unfold signumAnticommutator\n  rw [signum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) hJ hS hJS]\n  simp [signumPhaseAxis]\n\n/-- `{J,K} = 0`. -/\n@[rep_depth krein]\ntheorem signumAnticommutator_reflection_phaseAxis :\n    signumAnticommutator (E := E) J (signumPhaseAxis (E := E) J S) = 0 := by\n  unfold signumAnticommutator\n  rw [reflection_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]\n  rw [phaseAxis_mul_reflection (E := E) (J := J) (S := S) hJ hS hJS]\n  abel\n\n/-- `{S,K} = 0`. -/\n@[rep_depth krein]\ntheorem signumAnticommutator_signum_phaseAxis :\n    signumAnticommutator (E := E) S (signumPhaseAxis (E := E) J S) = 0 := by\n  unfold signumAnticommutator\n  rw [signum_mul_phaseAxis (E := E) (J := J) (S := S) hJ hS hJS]\n  rw [phaseAxis_mul_signum (E := E) (J := J) (S := S) hJ hS hJS]\n  abel\n\n/-- `{J,J} = 2`. -/\n@[rep_depth krein]\ntheorem signumAnticommutator_reflection_reflection :\n    signumAnticommutator (E := E) J J = (2 : ℝ) • (1 : EndH) := by\n  unfold signumAnticommutator\n  rw [hJ]\n  simpa using (two_smul ℝ (1 : EndH)).symm\n\n/-- `{S,S} = 2`. -/\n@[rep_depth krein]\ntheorem signumAnticommutator_signum_signum :\n    signumAnticommutator (E := E) S S = (2 : ℝ) • (1 : EndH) := by\n  unfold signumAnticommutator\n  rw [hS]\n  simpa using (two_smul ℝ (1 : EndH)).symm\n\n/-- `{K,K} = -2`. -/\n@[rep_depth krein]\ntheorem signumAnticommutator_phaseAxis_phaseAxis :\n    signumAnticommutator (E := E) (signumPhaseAxis (E := E) J S)\n        (signumPhaseAxis (E := E) J S)\n      = -((2 : ℝ) • (1 : EndH)) := by\n  unfold signumAnticommutator\n  rw [signumPhaseAxis_sq (E := E) (J := J) (S := S) hJ hS hJS]\n  calc\n    -(1 : EndH) + -(1 : EndH) = -((1 : EndH) + (1 : EndH)) := by abel\n    _ = -((2 : ℝ) • (1 : EndH)) := by rw [(two_smul ℝ (1 : EndH)).symm]\n\nend GenericSignumAtom\n\n/-! ## General modular-Hamiltonian signum atom with zero sector\n\nFor a general modular Hamiltonian `K = log Δ`, the signum `S = sgn(K)` may\nhave a zero-mode sector.  Algebraically this means `S² = p`, where\n`p = 1 - P₀` is the complement of the zero spectral projection.\n\nThe following section does not construct functional calculus.  It proves the\ncomplete product, commutator, and anticommutator table from the modular signum\nrelations:\n\n* `J² = 1`;\n* `S² = p`;\n* `J S = - S J`.\n\nThese are the exact algebraic consequences of `J K J = -K` and\n`S = sgn(K)` once the signum and zero-sector projection have been supplied.\n-/\n\nsection GeneralSignumWithZeroSector\n\nvariable {J S p : DoubledSpace E →L[ℝ] DoubledSpace E}\nvariable (hJ : J * J = (1 : DoubledSpace E →L[ℝ] DoubledSpace E))\nvariable (hS : S * S = p)\nvariable (hJS : J * S = -(S * J))\ninclude hJ hS hJS\n\n/-- Zero-sector-aware product orientation: `S J = - J S`. -/\n@[rep_depth krein]\ntheorem modularSignum_mul_reflection_eq_neg_phase :\n    S * J = -(signumPhaseAxis (E := E) J S) := by\n  unfold signumPhaseAxis\n  simpa using (congrArg Neg.neg hJS).symm\n\n/-- With `q = J S`, the square is `q² = -p`. -/\n@[rep_depth krein]\ntheorem modularSignum_phaseAxis_sq :\n    signumPhaseAxis (E := E) J S * signumPhaseAxis (E := E) J S = -p := by\n  unfold signumPhaseAxis\n  apply ContinuousLinearMap.ext\n  intro x\n  have hSJ :\n      S * J = -(J * S) :=\n    modularSignum_mul_reflection_eq_neg_phase\n      (E := E) (J := J) (S := S) (p := p) hJ hS hJS\n  have hSJx : S (J (S x)) = -J (S (S x)) := by\n    simpa using congrArg (fun F : EndH => F (S x)) hSJ\n  have hJx : J (J (S (S x))) = S (S x) := by\n    simpa using congrArg (fun F : EndH => F (S (S x))) hJ\n  have hSx : S (S x) = p x := by\n    simpa using congrArg (fun F : EndH => F x) hS\n  calc\n    ((J * S) * (J * S)) x = J (S (J (S x))) := rfl\n    _ = J (-J (S (S x))) := by rw [hSJx]\n    _ = -J (J (S (S x))) := by simp\n    _ = -S (S x) := by rw [hJx]\n    _ = (-p) x := by rw [hSx]; rfl\n\n/-- `J q = S`. -/\n@[rep_depth krein]\ntheorem modularSignum_reflection_mul_phaseAxis :\n    J * signumPhaseAxis (E := E) J S = S := by\n  unfold signumPhaseAxis\n  calc\n    J * (J * S) = (J * J) * S := by noncomm_ring\n    _ = S := by rw [hJ]; simp\n\n/-- `q J = -S`. -/\n@[rep_depth krein]\ntheorem modularSignum_phaseAxis_mul_reflection :\n    signumPhaseAxis (E := E) J S * J = -S := by\n  unfold signumPhaseAxis\n  calc\n    (J * S) * J = J * (S * J) := by noncomm_ring\n    _ = J * (-(J * S)) := by\n          rw [modularSignum_mul_reflection_eq_neg_phase\n            (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n          rfl\n    _ = -((J * J) * S) := by\n          apply ContinuousLinearMap.ext\n          intro x\n          simp\n    _ = -S := by rw [hJ]; simp\n\n/-- `S q = -J p`. -/\n@[rep_depth krein]\ntheorem modularSignum_signum_mul_phaseAxis :\n    S * signumPhaseAxis (E := E) J S = -(J * p) := by\n  unfold signumPhaseAxis\n  calc\n    S * (J * S) = (S * J) * S := by noncomm_ring\n    _ = (-(J * S)) * S := by\n          rw [modularSignum_mul_reflection_eq_neg_phase\n            (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n          simp [signumPhaseAxis]\n    _ = -(J * (S * S)) := by\n          apply ContinuousLinearMap.ext\n          intro x\n          rfl\n    _ = -(J * p) := by rw [hS]\n\n/-- `q S = J p`. -/\n@[rep_depth krein]\ntheorem modularSignum_phaseAxis_mul_signum :\n    signumPhaseAxis (E := E) J S * S = J * p := by\n  unfold signumPhaseAxis\n  calc\n    (J * S) * S = J * (S * S) := by noncomm_ring\n    _ = J * p := by rw [hS]\n\n/-- `[J,S] = 2q`. -/\n@[rep_depth krein]\ntheorem modularSignumCommutator_reflection_signum :\n    signumCommutator (E := E) J S = (2 : ℝ) • signumPhaseAxis (E := E) J S := by\n  unfold signumCommutator\n  rw [modularSignum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  unfold signumPhaseAxis\n  calc\n    J * S - -(J * S) = J * S + J * S := by abel\n    _ = (2 : ℝ) • (J * S) := by simpa using (two_smul ℝ (J * S)).symm\n\n/-- `[S,J] = -2q`. -/\n@[rep_depth krein]\ntheorem modularSignumCommutator_signum_reflection :\n    signumCommutator (E := E) S J = -((2 : ℝ) • signumPhaseAxis (E := E) J S) := by\n  unfold signumCommutator\n  rw [modularSignum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  unfold signumPhaseAxis\n  calc\n    -(J * S) - J * S = -((J * S) + J * S) := by abel\n    _ = -((2 : ℝ) • (J * S)) := by rw [(two_smul ℝ (J * S)).symm]\n\n/-- `[J,q] = 2S`. -/\n@[rep_depth krein]\ntheorem modularSignumCommutator_reflection_phaseAxis :\n    signumCommutator (E := E) J (signumPhaseAxis (E := E) J S) = (2 : ℝ) • S := by\n  unfold signumCommutator\n  rw [modularSignum_reflection_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  rw [modularSignum_phaseAxis_mul_reflection (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  calc\n    S - -S = S + S := by abel\n    _ = (2 : ℝ) • S := by simpa using (two_smul ℝ S).symm\n\n/-- `[q,J] = -2S`. -/\n@[rep_depth krein]\ntheorem modularSignumCommutator_phaseAxis_reflection :\n    signumCommutator (E := E) (signumPhaseAxis (E := E) J S) J = -((2 : ℝ) • S) := by\n  unfold signumCommutator\n  rw [modularSignum_reflection_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  rw [modularSignum_phaseAxis_mul_reflection (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  calc\n    -S - S = -(S + S) := by abel\n    _ = -((2 : ℝ) • S) := by rw [(two_smul ℝ S).symm]\n\n/-- `[S,q] = -2 J p`. -/\n@[rep_depth krein]\ntheorem modularSignumCommutator_signum_phaseAxis :\n    signumCommutator (E := E) S (signumPhaseAxis (E := E) J S) = -((2 : ℝ) • (J * p)) := by\n  unfold signumCommutator\n  rw [modularSignum_signum_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  rw [modularSignum_phaseAxis_mul_signum (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  calc\n    -(J * p) - J * p = -((J * p) + (J * p)) := by abel\n    _ = -((2 : ℝ) • (J * p)) := by rw [(two_smul ℝ (J * p)).symm]\n\n/-- `[q,S] = 2 J p`. -/\n@[rep_depth krein]\ntheorem modularSignumCommutator_phaseAxis_signum :\n    signumCommutator (E := E) (signumPhaseAxis (E := E) J S) S = (2 : ℝ) • (J * p) := by\n  unfold signumCommutator\n  rw [modularSignum_signum_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  rw [modularSignum_phaseAxis_mul_signum (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  calc\n    J * p - -(J * p) = J * p + J * p := by abel\n    _ = (2 : ℝ) • (J * p) := by simpa using (two_smul ℝ (J * p)).symm\n\n/-- `{J,S} = 0`. -/\n@[rep_depth krein]\ntheorem modularSignumAnticommutator_reflection_signum :\n    signumAnticommutator (E := E) J S = 0 := by\n  unfold signumAnticommutator\n  rw [modularSignum_mul_reflection_eq_neg_phase (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  simp [signumPhaseAxis]\n\n/-- `{J,q} = 0`. -/\n@[rep_depth krein]\ntheorem modularSignumAnticommutator_reflection_phaseAxis :\n    signumAnticommutator (E := E) J (signumPhaseAxis (E := E) J S) = 0 := by\n  unfold signumAnticommutator\n  rw [modularSignum_reflection_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  rw [modularSignum_phaseAxis_mul_reflection (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  abel\n\n/-- `{S,q} = 0`. -/\n@[rep_depth krein]\ntheorem modularSignumAnticommutator_signum_phaseAxis :\n    signumAnticommutator (E := E) S (signumPhaseAxis (E := E) J S) = 0 := by\n  unfold signumAnticommutator\n  rw [modularSignum_signum_mul_phaseAxis (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  rw [modularSignum_phaseAxis_mul_signum (E := E) (J := J) (S := S) (p := p) hJ hS hJS]\n  abel\n\n/-- `{J,J} = 2`. -/\n@[rep_depth kr