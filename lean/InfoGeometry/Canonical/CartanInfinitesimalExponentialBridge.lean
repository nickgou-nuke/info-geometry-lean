/-!
# Cartan Infinitesimal / Exponential Bridge

The theorem-safe translation is:

* infinitesimal Cartan law: `ad_H X = [H,X] = λ • X`;
* exponential adjoint readout: `Φ_t X = exp(tH) X exp(-tH) = exp(tλ) • X`.

The integration step is witness-gated.  This file does not prove analytic ODE
existence, uniqueness, or noncommutative exponential calculus.
-/

/-! ## 1. Generic algebraic Cartan derivation -/

section Algebraic

variable {R : Type*}
variable [Ring R] [Algebra ℝ R]

/-- Cartan/adjoint derivation `ad_H(X) = H X - X H`. -/
@[rep_depth operator]
def cartanAdjoint (H X : R) : R :=
  H * X - X * H

/-- `X` is an eigen-operator of the Cartan derivation generated by `H`. -/
@[rep_depth operator]
def IsCartanEigenOperator (H X : R) (lam : ℝ) : Prop :=
  cartanAdjoint H X = lam • X

/-- Readback: the infinitesimal law is exactly `ad_H(X)=λX`. -/
@[rep_depth operator]
theorem cartanEigenOperator_readback
    {H X : R} {lam : ℝ}
    (hX : IsCartanEigenOperator H X lam) :
    H * X - X * H = lam • X :=
  hX

/-- The generator commutes with itself, so it has weight zero under its own adjoint action. -/
@[rep_depth operator]
theorem cartanAdjoint_self_zero
    (H : R) :
    cartanAdjoint H H = 0 := by
  simp [cartanAdjoint]

/--
Cartan weights are preserved by conjugating the whole frame.

If `H₂ = U H₁ U⁻¹` and `U⁻¹U=1`, then an eigen-operator `X`
of `ad_{H₁}` with weight `λ` transports to `U X U⁻¹`, still with weight `λ`.
-/
@[rep_depth operator]
theorem cartanEigenOperator_conjugate
    {H₁ H₂ X U Uinv : R} {lam : ℝ}
    (hH : H₂ = U * H₁ * Uinv)
    (hL : Uinv * U = 1)
    (hX : IsCartanEigenOperator H₁ X lam) :
    IsCartanEigenOperator H₂ (U * X * Uinv) lam := by
  unfold IsCartanEigenOperator cartanAdjoint at hX ⊢
  rw [hH]
  calc
    (U * H₁ * Uinv) * (U * X * Uinv) -
        (U * X * Uinv) * (U * H₁ * Uinv)
        =
      U * H₁ * (Uinv * U) * X * Uinv -
        U * X * (Uinv * U) * H₁ * Uinv := by
          noncomm_ring
    _ =
      U * H₁ * 1 * X * Uinv -
        U * X * 1 * H₁ * Uinv := by
          rw [hL]
    _ =
      U * (H₁ * X - X * H₁) * Uinv := by
          noncomm_ring
    _ =
      U * (lam • X) * Uinv := by
          rw [hX]
    _ =
      lam • (U * X * Uinv) := by
          simp [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, mul_assoc]

end Algebraic

/-! ## 2. Exponential-flow calibration socket -/

section ExponentialFlow

variable {V : Type*}
variable [AddCommGroup V] [Module ℝ V]

/--
A supplied exponential eigen-flow.

The integrated calibration is `Φ_t(X) = exp(tλ) X`.  This is a socket,
not an analytic ODE theorem.
-/
@[rep_depth operator]
structure ExponentialEigenFlow where
  flow : ℝ → V → V
  eigenvector : V
  eigenvalue : ℝ
  /-- Integrated eigen-flow readout. -/
  flow_law :
    ∀ t : ℝ, flow t eigenvector = Real.exp (t * eigenvalue) • eigenvector

namespace ExponentialEigenFlow

variable (F : ExponentialEigenFlow (V := V))

/-- At time zero, the exponential eigen-flow fixes the eigenvector. -/
@[rep_depth operator]
theorem flow_zero_on_eigenvector :
    F.flow 0 F.eigenvector = F.eigenvector := by
  rw [F.flow_law 0]
  simp

/-- Additive time readback on the eigenvector: `Φ_{t+s}(X) = exp(tλ) Φ_s(X)`. -/
@[rep_depth operator]
theorem flow_add_on_eigenvector
    (t s : ℝ) :
    F.flow (t + s) F.eigenvector =
      Real.exp (t * F.eigenvalue) • F.flow s F.eigenvector := by
  calc
    F.flow (t + s) F.eigenvector
        = Real.exp ((t + s) * F.eigenvalue) • F.eigenvector := by
            rw [F.flow_law (t + s)]
    _ = Real.exp (t * F.eigenvalue + s * F.eigenvalue) • F.eigenvector := by
            have harg :
                (t + s) * F.eigenvalue =
                  t * F.eigenvalue + s * F.eigenvalue := by
              ring
            rw [harg]
    _ = (Real.exp (t * F.eigenvalue) * Real.exp (s * F.eigenvalue)) •
          F.eigenvector := by
            rw [Real.exp_add]
    _ = Real.exp (t * F.eigenvalue) •
          (Real.exp (s * F.eigenvalue) • F.eigenvector) := by
            rw [smul_smul]
    _ = Real.exp (t * F.eigenvalue) • F.flow s F.eigenvector := by
            rw [F.flow_law s]

end ExponentialEigenFlow

end ExponentialFlow

/-! ## 3. Inner adjoint exponential-flow calibration -/

section InnerAdjoint

variable {R : Type*}
variable [Ring R] [Algebra ℝ R]

/--
A Cartan eigen-operator with a supplied inner exponential-adjoint transport law.

The maps `expH` and `expNegH` are carried abstractly.  This file does not
construct them from a functional calculus.
-/
@[rep_depth operator]
structure CartanEigenAdjointExponentialCalibration where
  H : R
  X : R
  weight : ℝ
  /-- Abstract `exp(tH)` carrier. -/
  expH : ℝ → R
  /-- Abstract `exp(-tH)` carrier. -/
  expNegH : ℝ → R
  /-- Infinitesimal Cartan eigen-operator law `[H,X]=λX`. -/
  infinitesimal_law :
    IsCartanEigenOperator H X weight
  /-- Integrated exponential-adjoint law. -/
  exponential_adjoint_law :
    ∀ t : ℝ, expH t * X * expNegH t = Real.exp (t * weight) • X

namespace CartanEigenAdjointExponentialCalibration

variable (C : CartanEigenAdjointExponentialCalibration (R := R))

/-- Readback of the infinitesimal law. -/
@[rep_depth operator]
theorem infinitesimal_readback :
    cartanAdjoint C.H C.X = C.weight • C.X :=
  C.infinitesimal_law

/-- Readback of the supplied exponential-adjoint law. -/
@[rep_depth operator]
theorem exponential_adjoint_readback
    (t : ℝ) :
    C.expH t * C.X * C.expNegH t = Real.exp (t * C.weight) • C.X :=
  C.exponential_adjoint_law t

/-- At time zero, if the exponential carriers act as identities, the readout fixes `X`. -/
@[rep_depth operator]
theorem exponential_zero_readback
    (hpos : C.expH 0 = 1)
    (hneg : C.expNegH 0 = 1) :
    C.expH 0 * C.X * C.expNegH 0 = C.X := by
  rw [hpos, hneg]
  simp

end CartanEigenAdjointExponentialCalibration

end InnerAdjoint

/-! ## 4. Hestenes-Krein analytic compatibility -/

section HestenesKrein

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

/--
Hestenes-Krein Cartan eigen-operator law using the real operator commutator on
doubled endomorphisms.
-/
@[rep_depth krein]
def IsHestenesCartanEigenOperator
    (H X : EndH) (lam : ℝ) : Prop :=
  hestenesSymmetryCommutator (E := E) H X = lam • X

/--
If `H` and `X` preserve the internal Hestenes phase axis, then their Cartan
commutator also preserves it.
-/
@[rep_depth krein]
theorem hestenesCartan_commutator_is_analytic
    {H X : EndH}
    (hH : IsHestenesAnalyticSymmetry (E := E) H)
    (hX : IsHestenesAnalyticSymmetry (E := E) X) :
    IsHestenesAnalyticSymmetry (E := E)
      (hestenesSymmetryCommutator (E := E) H X) :=
  hestenesAnalyticSymmetry_commutator (E := E) hH hX

/--
If `[H,X]=λX` and `H,X` are Hestenes analytic, then the eigen-image `λX`
is also Hestenes analytic.
-/
@[rep_depth krein]
theorem hestenesCartan_eigen_image_is_analytic
    {H X : EndH} {lam : ℝ}
    (hEig : IsHestenesCartanEigenOperator (E := E) H X lam)
    (hH : IsHestenesAnalyticSymmetry (E := E) H)
    (hX : IsHestenesAnalyticSymmetry (E := E) X) :
    IsHestenesAnalyticSymmetry (E := E) (lam • X) := by
  rw [← hEig]
  exact hestenesCartan_commutator_is_analytic (E := E) hH hX

end HestenesKrein

end InfoGeometry.Canonical.CartanInfinitesimalExponentialBridge
