import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.Analysis.Calculus.MeanValue
import Mathlib.Analysis.Calculus.Deriv.Basic
import Mathlib.Algebra.Module.Basic
import Mathlib.Algebra.Algebra.Basic
import Mathlib.Tactic
import Mathlib.Algebra.Module.Equiv.Basic
import Mathlib.Analysis.Normed.Algebra.Basic
import Mathlib.Analysis.Calculus.Deriv.Prod
import Mathlib.Analysis.Calculus.Deriv.Mul

/-!
# Exponential flow of a continuous derivation

Let `A` be a complete real normed vector space equipped with an arbitrary
continuous bilinear multiplication

`mul : A →L[ℝ] A →L[ℝ] A`.

No associativity hypothesis is imposed on `mul`.

For a bounded linear endomorphism `D : A →L[ℝ] A` satisfying the Leibniz rule

`D (mul x y) = mul (D x) y + mul x (D y)`,

the operator exponential

`Φ_t = exp (t D)`

is proved to satisfy

`Φ_t (mul x y) = mul (Φ_t x) (Φ_t y)`.

The inverse is `Φ_{-t}`. Thus every continuous derivation integrates to a
one-parameter family of multiplicative linear equivalences. The proof uses
only the associative Banach algebra of continuous linear endomorphisms; the
original multiplication on `A` may be nonassociative.

The final section records exact consequences for nonassociative structure:
associators are transported covariantly, and idempotent, square-zero, and
zero-product relations are preserved by the finite flow.
-/

noncomputable section

set_option linter.unusedSectionVars false

namespace InfoGeometry.Lie.ContinuousDerivationExponential

variable {A : Type*}
variable [NormedAddCommGroup A] [NormedSpace ℝ A] [CompleteSpace A]

local notation "EndA" => A →L[ℝ] A

noncomputable local instance : NormedRing EndA := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndA := inferInstance
local instance : NormedAlgebra ℚ EndA := NormedAlgebra.restrictScalars ℚ ℝ EndA
local instance : IsTopologicalRing EndA := inferInstance
local instance : CompleteSpace EndA := inferInstance

/-!
## Derivations
-/

/--
Leibniz predicate for an arbitrary continuous bilinear multiplication.

No associativity assumption is made on `mul`.
-/
def IsDerivation
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA) : Prop :=
  ∀ x y : A,
    D (mul x y) =
      mul (D x) y + mul x (D y)

/-!
## Exponential flow
-/

/-- The exponential flow generated by `D`. -/
noncomputable def flow
    (D : EndA)
    (t : ℝ) : EndA :=
  NormedSpace.exp (t • D)

/-- The exponential flow at time zero is the identity. -/
@[simp]
theorem flow_zero
    (D : EndA) :
    flow D 0 = 1 := by
  simp [flow]

/-- Scalar multiples of a fixed operator commute. -/
theorem smul_commute_smul
    (D : EndA)
    (s t : ℝ) :
    Commute (s • D) (t • D) := by
  exact ((Commute.refl D).smul_left s).smul_right t

/--
The exponential is a one-parameter operator group:

`Φ_(s+t) = Φ_s Φ_t`.
-/
theorem flow_add
    (D : EndA)
    (s t : ℝ) :
    flow D (s + t) =
      flow D s * flow D t := by
  simpa [flow, add_smul] using
    (NormedSpace.exp_add_of_commute
      (smul_commute_smul D s t))

/-- Negating the generator reverses the flow parameter. -/
@[simp]
theorem flow_neg_generator
    (D : EndA)
    (t : ℝ) :
    flow (-D) t = flow D (-t) := by
  simp [flow, smul_neg, neg_smul]

/-- `Φ_t Φ_{-t} = 1`. -/
theorem flow_mul_flow_neg
    (D : EndA)
    (t : ℝ) :
    flow D t * flow (-D) t = 1 := by
  rw [flow_neg_generator]
  simpa using (flow_add D t (-t)).symm

/-- `Φ_{-t} Φ_t = 1`. -/
theorem flow_neg_mul_flow
    (D : EndA)
    (t : ℝ) :
    flow (-D) t * flow D t = 1 := by
  rw [flow_neg_generator]
  simpa using (flow_add D (-t) t).symm

/-- Pointwise right-inverse identity. -/
@[simp]
theorem flow_apply_flow_neg
    (D : EndA)
    (t : ℝ)
    (x : A) :
    flow D t (flow (-D) t x) = x := by
  have h : (flow D t * flow (-D) t : EndA) = 1 := by
    rw [flow_mul_flow_neg]
  have h₁ : (flow D t * flow (-D) t : EndA) x = (1 : EndA) x := by rw [h]
  simp [ContinuousLinearMap.one_apply] at h₁ ⊢
  simp_all

/-- Pointwise left-inverse identity. -/
@[simp]
theorem flow_neg_apply_flow
    (D : EndA)
    (t : ℝ)
    (x : A) :
    flow (-D) t (flow D t x) = x := by
  have h : (flow (-D) t * flow D t : EndA) = 1 := by
    rw [flow_neg_mul_flow]
  have h₁ : (flow (-D) t * flow D t : EndA) x = (1 : EndA) x := by rw [h]
  simp [ContinuousLinearMap.one_apply] at h₁ ⊢
  simp_all

/-!
## Differential equations for the exponential flow
-/

/--
Left-generator derivative formula:

`Φ'_t = D Φ_t`.
-/
theorem hasStrictDerivAt_flow_left
    (D : EndA)
    (t : ℝ) :
    HasStrictDerivAt
      (flow D)
      (D * flow D t)
      t := by
  simpa [flow] using
    (hasStrictDerivAt_exp_smul_const' D t)

/--
Right-generator derivative formula:

`Φ'_t = Φ_t D`.
-/
theorem hasStrictDerivAt_flow_right
    (D : EndA)
    (t : ℝ) :
    HasStrictDerivAt
      (flow D)
      (flow D t * D)
      t := by
  simpa [flow] using
    (hasStrictDerivAt_exp_smul_const D t)

/--
Evaluation of a bounded endomorphism on a vector as a continuous bilinear map.
-/
private noncomputable def evalOp :
    EndA →L[ℝ] A →L[ℝ] A :=
  (ContinuousLinearMap.apply ℝ A).flip

@[simp]
private theorem evalOp_apply
    (T : EndA)
    (x : A) :
    evalOp T x = T x := by
  rfl

/--
Orbit equation:

`d/dt (Φ_t x) = D (Φ_t x)`.
-/
theorem hasStrictDerivAt_orbit
    (D : EndA)
    (x : A)
    (t : ℝ) :
    HasStrictDerivAt
      (fun s : ℝ => flow D s x)
      (D (flow D t x))
      t := by
  have h :=
    (evalOp (A := A)).hasStrictDerivAt_of_bilinear
      (hasStrictDerivAt_flow_left D t)
      (hasStrictDerivAt_const t x)
  simpa [evalOp, LinearMap.comp_apply] using h

/--
Equivalent orbit equation:

`d/dt (Φ_t x) = Φ_t (D x)`.
-/
theorem hasStrictDerivAt_orbit_right
    (D : EndA)
    (x : A)
    (t : ℝ) :
    HasStrictDerivAt
      (fun s : ℝ => flow D s x)
      (flow D t (D x))
      t := by
  have h :=
    (evalOp (A := A)).hasStrictDerivAt_of_bilinear
      (hasStrictDerivAt_flow_right D t)
      (hasStrictDerivAt_const t x)
  simpa [evalOp, LinearMap.comp_apply] using h

/--
`D` commutes with its own exponential flow:

`Φ_t (D x) = D (Φ_t x)`.
-/
theorem flow_apply_derivation
    (D : EndA)
    (t : ℝ)
    (x : A) :
    flow D t (D x) =
      D (flow D t x) := by
  have h₁ : HasDerivAt (fun s : ℝ => flow D s x) (D (flow D t x)) t :=
    (hasStrictDerivAt_orbit D x t).hasDerivAt
  have h₂ : HasDerivAt (fun s : ℝ => flow D s x) (flow D t (D x)) t :=
    (hasStrictDerivAt_orbit_right D x t).hasDerivAt
  have h₃ : D (flow D t x) = flow D t (D x) := by
    apply HasDerivAt.unique h₁ h₂
  rw [h₃]

/-- The exponential flow commutes with its infinitesimal generator. -/
theorem flow_commutes_with_derivation
    (D : EndA)
    (t : ℝ) :
    flow D t * D = D * flow D t := by
  ext x
  exact flow_apply_derivation D t x

/-- A vector annihilated by the generator is fixed by the whole exponential flow. -/
theorem flow_fixed_of_derivation_eq_zero
    (D : EndA)
    (x : A)
    (hx : D x = 0)
    (t : ℝ) :
    flow D t x = x := by
  have hder : ∀ s : ℝ,
      HasDerivAt (fun r : ℝ => flow D r x) 0 s := by
    intro s
    have h := (hasStrictDerivAt_orbit_right D x s).hasDerivAt
    simpa [hx] using h
  have hdiff : Differentiable ℝ (fun r : ℝ => flow D r x) := by
    intro s
    exact (hder s).differentiableAt
  have hzero : ∀ s : ℝ,
      deriv (fun r : ℝ => flow D r x) s = 0 := by
    intro s
    exact (hder s).deriv
  have hconst := is_const_of_deriv_eq_zero hdiff hzero t 0
  simpa using hconst

/-!
## Product evolution
-/

/--
If `D` satisfies Leibniz, the product of two exponential orbits satisfies

`d/dt [mul (Φ_t x) (Φ_t y)]
   = D [mul (Φ_t x) (Φ_t y)]`.
-/
theorem hasStrictDerivAt_mul_orbit
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (x y : A)
    (t : ℝ) :
    HasStrictDerivAt
      (fun s : ℝ =>
        mul (flow D s x) (flow D s y))
      (D (mul (flow D t x) (flow D t y)))
      t := by
  have h :=
    mul.hasStrictDerivAt_of_bilinear
      (hasStrictDerivAt_orbit D x t)
      (hasStrictDerivAt_orbit D y t)
  convert h using 1
  rw [hD]
  abel

/-!
## Interaction-picture proof of multiplicativity
-/

/--
Interaction-picture product:

`F(t) = Φ_{-t} (mul (Φ_t x) (Φ_t y))`.
-/
noncomputable def interaction
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (x y : A)
    (t : ℝ) : A :=
  flow (-D) t
    (mul (flow D t x) (flow D t y))

/--
The interaction-picture product has zero derivative.
-/
theorem hasStrictDerivAt_interaction_zero
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (x y : A)
    (t : ℝ) :
    HasStrictDerivAt
      (interaction mul D x y)
      0
      t := by
  let p : ℝ → A :=
    fun s =>
      mul (flow D s x) (flow D s y)

  have hp :
      HasStrictDerivAt
        p
        (D (p t))
        t := by
    simpa [p] using
      hasStrictDerivAt_mul_orbit
        mul D hD x y t

  have hback :
      HasStrictDerivAt
        (flow (-D))
        (flow (-D) t * (-D))
        t :=
    hasStrictDerivAt_flow_right (-D) t

  have h :=
    (evalOp (A := A)).hasStrictDerivAt_of_bilinear
      hback hp

  have hz :
      flow (-D) t (D (p t)) +
          (flow (-D) t * (-D)) (p t)
        =
      0 := by
    rw [ContinuousLinearMap.mul_apply]
    simp

  have h' :
      HasStrictDerivAt
        (interaction mul D x y)
        0
        t := by
    unfold interaction
    simpa [evalOp_apply, hz] using h

  exact h'

/--
The interaction-picture product is constant and equal to its value at zero.
-/
theorem interaction_eq_initial
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (x y : A)
    (t : ℝ) :
    interaction mul D x y t =
      mul x y := by
  have hder :
      ∀ s : ℝ,
        HasDerivAt
          (interaction mul D x y)
          0
          s :=
    fun s =>
      (hasStrictDerivAt_interaction_zero
        mul D hD x y s).hasDerivAt

  have hdiff :
      Differentiable ℝ
        (interaction mul D x y) :=
    fun s =>
      (hder s).differentiableAt

  have hzero :
      ∀ s : ℝ,
        deriv (interaction mul D x y) s = 0 :=
    fun s =>
      (hder s).deriv

  have hconst :=
    is_const_of_deriv_eq_zero
      hdiff
      hzero
      t
      0

  simpa [interaction] using hconst

/--
The exponential of a derivation preserves the multiplication.

No associativity assumption on `mul` is used.
-/
theorem flow_map_mul
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A) :
    flow D t (mul x y) =
      mul (flow D t x) (flow D t y) := by
  have h := interaction_eq_initial mul D hD x y t
  calc flow D t (mul x y)
    = flow D t (interaction mul D x y t) := by rw [h]
    _ = mul (flow D t x) (flow D t y) := by
      unfold interaction
      rw [flow_apply_flow_neg]

/-- Notation and canonical owner definition for the Geometric Flow `U_D(t) = exp(tD)`. -/
noncomputable def U_D (D : EndA) (t : ℝ) : EndA :=
  flow D t

/-- 🏆 THEOREM: The Geometric Flow `U_D(t) = exp(tD)` strictly preserves non-associative products:
    `U_D(t)(x ⋆ y) = (U_D(t) x) ⋆ (U_D(t) y)` -/
theorem U_D_map_mul
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A) :
    U_D D t (mul x y) =
      mul (U_D D t x) (U_D D t y) :=
  flow_map_mul mul D hD t x y

/-- The analytic derivation flow transports the noncommutative commutator. -/
theorem flow_map_commutator
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A) :
    flow D t (mul x y - mul y x) =
      mul (flow D t x) (flow D t y) -
        mul (flow D t y) (flow D t x) := by
  rw [map_sub, flow_map_mul mul D hD, flow_map_mul mul D hD]

/-!
## Exponential automorphism as a linear equivalence
-/

/--
The exponential flow as a genuine linear equivalence.

Its inverse is generated by `-D`.
-/
noncomputable def flowLinearEquiv
    (D : EndA)
    (t : ℝ) :
    A ≃ₗ[ℝ] A where
  toFun := flow D t
  invFun := flow (-D) t
  left_inv := flow_neg_apply_flow D t
  right_inv := flow_apply_flow_neg D t
  map_add' := (flow D t).map_add
  map_smul' := (flow D t).map_smul

@[simp]
theorem flowLinearEquiv_apply
    (D : EndA)
    (t : ℝ)
    (x : A) :
    flowLinearEquiv D t x =
      flow D t x := by
  rfl

@[simp]
theorem flowLinearEquiv_symm_apply
    (D : EndA)
    (t : ℝ)
    (x : A) :
    (flowLinearEquiv D t).symm x =
      flow (-D) t x := by
  rfl

/-- A generator-fixed vector is fixed by the bundled exponential equivalence. -/
theorem flowLinearEquiv_fixed_of_derivation_eq_zero
    (D : EndA)
    (x : A)
    (hx : D x = 0)
    (t : ℝ) :
    flowLinearEquiv D t x = x := by
  exact flow_fixed_of_derivation_eq_zero D x hx t

/-- A derivation-fixed unit is preserved by the exponential flow. -/
theorem flow_preserves_unit_of_derivation_eq_zero
    (D : EndA)
    (one : A)
    (hD_one : D one = 0)
    (t : ℝ) :
    flow D t one = one := by
  exact flow_fixed_of_derivation_eq_zero D one hD_one t

/-- Unit preservation for the bundled exponential equivalence. -/
theorem flowLinearEquiv_preserves_unit_of_derivation_eq_zero
    (D : EndA)
    (one : A)
    (hD_one : D one = 0)
    (t : ℝ) :
    flowLinearEquiv D t one = one := by
  exact flowLinearEquiv_fixed_of_derivation_eq_zero D one hD_one t

/--
Strong automorphism statement in multiplication-preserving linear-equivalence form.
-/
theorem exponential_derivation_is_automorphism
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A) :
    flowLinearEquiv D t (mul x y) =
      mul
        (flowLinearEquiv D t x)
        (flowLinearEquiv D t y) := by
  exact flow_map_mul mul D hD t x y

/--
Product preservation stated directly for the bundled linear equivalence.
This is the form needed by downstream relation-transport lemmas.
-/
theorem flowLinearEquiv_map_mul
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A) :
    flowLinearEquiv D t (mul x y) =
      mul (flowLinearEquiv D t x) (flowLinearEquiv D t y) := by
  exact exponential_derivation_is_automorphism mul D hD t x y

/-- The analytic exponential transports the noncommutative commutator. -/
theorem flowLinearEquiv_map_commutator
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A) :
    flowLinearEquiv D t (mul x y - mul y x) =
      mul (flowLinearEquiv D t x) (flowLinearEquiv D t y) -
        mul (flowLinearEquiv D t y) (flowLinearEquiv D t x) := by
  rw [map_sub, flowLinearEquiv_map_mul mul D hD,
    flowLinearEquiv_map_mul mul D hD]

/-!
## One-parameter-group laws
-/

/-- Time zero gives the identity linear equivalence. -/
@[simp]
theorem flowLinearEquiv_zero
    (D : EndA) :
    flowLinearEquiv D 0 =
      (1 : A ≃ₗ[ℝ] A) := by
  apply LinearEquiv.ext
  intro x
  simp [flowLinearEquiv]

/-- Pointwise group law: Φ_(s+t) x = Φ_s (Φ_t x). -/
theorem flow_add_apply
    (D : EndA)
    (s t : ℝ)
    (x : A) :
    flow D (s + t) x =
      flow D s (flow D t x) := by
  have h : flow D (s + t) = flow D s * flow D t := flow_add D s t
  calc
    flow D (s + t) x = (flow D s * flow D t) x := by rw [h]
    _ = flow D s (flow D t x) := by simp

/-- The corresponding linear equivalences satisfy the one-parameter group law. -/
theorem flowLinearEquiv_add_apply
    (D : EndA)
    (s t : ℝ)
    (x : A) :
    flowLinearEquiv D (s + t) x =
      flowLinearEquiv D s
        (flowLinearEquiv D t x) := by
  exact flow_add_apply D s t x

/-- The linear-equivalence flow satisfies the additive parameter law. -/
theorem flowLinearEquiv_add
    (D : EndA)
    (s t : ℝ) :
    flowLinearEquiv D (s + t) =
      flowLinearEquiv D s *
        flowLinearEquiv D t := by
  apply LinearEquiv.ext
  intro x
  rw [LinearEquiv.mul_apply]
  exact flowLinearEquiv_add_apply D s t x

/-- The linear-equivalence flow as a genuine one-parameter subgroup. -/
noncomputable def flowLinearEquivGroupHom
    (D : EndA) :
    Multiplicative ℝ →* (A ≃ₗ[ℝ] A) where
  toFun τ := flowLinearEquiv D τ.toAdd
  map_one' := by
    change flowLinearEquiv D 0 = (1 : A ≃ₗ[ℝ] A)
    exact flowLinearEquiv_zero D
  map_mul' σ τ := by
    change flowLinearEquiv D (σ.toAdd + τ.toAdd) =
      flowLinearEquiv D σ.toAdd * flowLinearEquiv D τ.toAdd
    exact flowLinearEquiv_add D σ.toAdd τ.toAdd

@[simp]
theorem flowLinearEquivGroupHom_apply
    (D : EndA)
    (t : ℝ) :
    flowLinearEquivGroupHom D (Multiplicative.ofAdd t) =
      flowLinearEquiv D t := by
  rfl

@[simp]
theorem flowLinearEquivGroupHom_zero
    (D : EndA) :
    flowLinearEquivGroupHom D (Multiplicative.ofAdd 0) = 1 := by
  exact map_one (flowLinearEquivGroupHom D)

/-- Additive parameters map to composition of linear equivalences. -/
theorem flowLinearEquivGroupHom_add
    (D : EndA)
    (s t : ℝ) :
    flowLinearEquivGroupHom D (Multiplicative.ofAdd (s + t)) =
      flowLinearEquivGroupHom D (Multiplicative.ofAdd s) *
        flowLinearEquivGroupHom D (Multiplicative.ofAdd t) := by
  change flowLinearEquiv D (s + t) =
    flowLinearEquiv D s * flowLinearEquiv D t
  exact flowLinearEquiv_add D s t

/-- Negative time maps to the inverse linear equivalence. -/
@[simp]
theorem flowLinearEquivGroupHom_neg
    (D : EndA)
    (t : ℝ) :
    flowLinearEquivGroupHom D (Multiplicative.ofAdd (-t)) =
      (flowLinearEquivGroupHom D (Multiplicative.ofAdd t))⁻¹ := by
  have h := map_inv
    (flowLinearEquivGroupHom D)
    (Multiplicative.ofAdd t)
  change flowLinearEquiv D (-t) = (flowLinearEquiv D t)⁻¹ at h
  change flowLinearEquiv D (-t) = (flowLinearEquiv D t)⁻¹
  exact h

/-- The infinitesimal generator of the automorphism flow is D. -/
theorem deriv_flow_at_zero
    (D : EndA) :
    deriv (flow D) 0 = D := by
  have h : HasStrictDerivAt (flow D) (D * flow D 0) 0 := hasStrictDerivAt_flow_left D 0
  have h₁ : HasDerivAt (flow D) (D * flow D 0) 0 := h.hasDerivAt
  have h₂ : deriv (flow D) 0 = D * flow D 0 := HasDerivAt.deriv h₁
  simp [flow] at h₂
  exact h₂

/-- Negative time is the inverse linear equivalence. -/
theorem flowLinearEquiv_neg_eq_symm
    (D : EndA)
    (t : ℝ) :
    flowLinearEquiv D (-t) =
      (flowLinearEquiv D t).symm := by
  ext x
  change
    flow D (-t) x =
      flow (-D) t x
  rw [flow_neg_generator]

/-- Inverse equivalence is exactly the negative-time flow. -/
theorem flowLinearEquiv_neg_apply
    (D : EndA)
    (t : ℝ)
    (x : A) :
    flowLinearEquiv D (-t)
        (flowLinearEquiv D t x)
      =
    x := by
  rw [flowLinearEquiv_neg_eq_symm]
  exact (flowLinearEquiv D t).symm_apply_apply x

/-! ## Transport of central elements -/

/-- A multiplicative derivation flow preserves the center of the product. -/
theorem flowLinearEquiv_preserves_central
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (x : A)
    (hx : ∀ y : A, mul x y = mul y x)
    (t : ℝ) :
    ∀ y : A,
      mul (flowLinearEquiv D t x) y =
        mul y (flowLinearEquiv D t x) := by
  intro y
  let z : A := flowLinearEquiv D (-t) y
  have hz : mul x z = mul z x := hx z
  have hmap := congrArg (flowLinearEquiv D t) hz
  rw [flowLinearEquiv_map_mul mul D hD,
    flowLinearEquiv_map_mul mul D hD] at hmap
  have hzflow : flowLinearEquiv D t z = y := by
    dsimp [z]
    have h := flowLinearEquiv_add_apply D t (-t) y
    simpa using h.symm
  rw [hzflow] at hmap
  exact hmap

/-! ## Transport of commuting pairs -/

/-- The derivation flow preserves commutation relations. -/
theorem flowLinearEquiv_preserves_commute
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (x y : A)
    (hxy : mul x y = mul y x)
    (t : ℝ) :
    mul (flowLinearEquiv D t x) (flowLinearEquiv D t y) =
      mul (flowLinearEquiv D t y) (flowLinearEquiv D t x) := by
  have hmap := flowLinearEquiv_map_commutator mul D hD t x y
  rw [hxy] at hmap
  have hzero :
      mul (flowLinearEquiv D t x) (flowLinearEquiv D t y) -
        mul (flowLinearEquiv D t y) (flowLinearEquiv D t x) = 0 := by
    simpa using hmap.symm
  exact sub_eq_zero.mp hzero

/-- Commutation is reflected as well as preserved by the invertible flow. -/
theorem flowLinearEquiv_commute_iff
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (x y : A)
    (t : ℝ) :
    (mul (flowLinearEquiv D t x) (flowLinearEquiv D t y) =
      mul (flowLinearEquiv D t y) (flowLinearEquiv D t x)) ↔
    mul x y = mul y x := by
  constructor
  · intro h
    have hmap :
        flowLinearEquiv D t (mul x y - mul y x) = 0 := by
      rw [flowLinearEquiv_map_commutator mul D hD, h, sub_self]
    have hmap' :
        flowLinearEquiv D t (mul x y - mul y x) =
          flowLinearEquiv D t 0 := by
      simpa using hmap
    have hzero : mul x y - mul y x = 0 :=
      (flowLinearEquiv D t).injective hmap'
    exact sub_eq_zero.mp hzero
  · intro h
    exact flowLinearEquiv_preserves_commute mul D hD x y h t

/-!
## Transport of nonassociative algebraic structure
-/

/--
Associator of an arbitrary bilinear multiplication.
-/
def associator
    (mul : A →L[ℝ] A →L[ℝ] A)
    (x y z : A) : A :=
  mul (mul x y) z -
    mul x (mul y z)

/--
The exponential derivation flow transports the associator covariantly.
-/
theorem flow_associator
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y z : A) :
    flow D t
        (associator mul x y z) =
      associator
        mul
        (flow D t x)
        (flow D t y)
        (flow D t z) := by
  unfold associator

  rw [map_sub]

  rw [
    flow_map_mul
      mul D hD t
      (mul x y)
      z
  ]

  rw [
    flow_map_mul
      mul D hD t
      x
      y
  ]

  rw [
    flow_map_mul
      mul D hD t
      x
      (mul y z)
  ]

  rw [
    flow_map_mul
      mul D hD t
      y
      z
  ]

/-- The bundled analytic exponential transports the associator. -/
theorem flowLinearEquiv_map_associator
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y z : A) :
    flowLinearEquiv D t (associator mul x y z) =
      associator mul
        (flowLinearEquiv D t x)
        (flowLinearEquiv D t y)
        (flowLinearEquiv D t z) := by
  exact flow_associator mul D hD t x y z

/-- The bundled analytic exponential transports idempotents. -/
theorem flowLinearEquiv_preserves_idempotent
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x : A)
    (hx : mul x x = x) :
    mul (flowLinearEquiv D t x) (flowLinearEquiv D t x) =
      flowLinearEquiv D t x := by
  rw [← flowLinearEquiv_map_mul mul D hD t x x, hx]

/-- The bundled analytic exponential transports square-zero elements. -/
theorem flowLinearEquiv_preserves_square_zero
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x : A)
    (hx : mul x x = 0) :
    mul (flowLinearEquiv D t x) (flowLinearEquiv D t x) = 0 := by
  rw [← flowLinearEquiv_map_mul mul D hD t x x, hx]
  exact (flowLinearEquiv D t).map_zero

/-- The bundled analytic exponential transports both orientations of
orthogonality without assuming commutativity. -/
theorem flowLinearEquiv_preserves_two_sided_orthogonality
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A)
    (hxy : mul x y = 0)
    (hyx : mul y x = 0) :
    mul (flowLinearEquiv D t x) (flowLinearEquiv D t y) = 0 ∧
      mul (flowLinearEquiv D t y) (flowLinearEquiv D t x) = 0 := by
  constructor
  · rw [← flowLinearEquiv_map_mul mul D hD t x y, hxy]
    exact (flowLinearEquiv D t).map_zero
  · rw [← flowLinearEquiv_map_mul mul D hD t y x, hyx]
    exact (flowLinearEquiv D t).map_zero

/--
An idempotent remains idempotent under the derivation exponential.
-/
theorem flow_preserves_idempotent
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x : A)
    (hx : mul x x = x) :
    mul
        (flow D t x)
        (flow D t x) =
      flow D t x := by
  rw [
    ← flow_map_mul
      mul D hD t x x,
    hx
  ]

/--
A continuous derivation preserves Peirce idempotents under its exponential flow.

If `e` satisfies `mul e e = e`, then `flow D t e` also satisfies
`mul (flow D t e) (flow D t e) = flow D t e`.
-/
theorem continuous_derivation_preserves_peirce
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (e : A)
    (he : mul e e = e) :
    mul (flow D t e) (flow D t e) = flow D t e :=
  flow_preserves_idempotent mul D hD t e he

/--
A square-zero element remains square-zero under the derivation exponential.
-/
theorem flow_preserves_square_zero
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x : A)
    (hx : mul x x = 0) :
    mul
        (flow D t x)
        (flow D t x) =
      0 := by
  rw [
    ← flow_map_mul
      mul D hD t x x,
    hx
  ]
  exact
    (flow D t).map_zero

/--
A zero-product relation is preserved by the derivation exponential.
-/
theorem flow_preserves_zero_product
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A)
    (hxy : mul x y = 0) :
    mul
        (flow D t x)
        (flow D t y) =
      0 := by
  rw [
    ← flow_map_mul
      mul D hD t x y,
    hxy
  ]
  exact
    (flow D t).map_zero

/-
The opposite orientation is a separate theorem because no commutativity of the
underlying product is assumed.
-/
theorem flow_preserves_zero_product_rev
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A)
    (hyx : mul y x = 0) :
    mul
        (flow D t y)
        (flow D t x) =
      0 := by
  exact flow_preserves_zero_product mul D hD t y x hyx

/-- Both oriented zero-product relations are transported independently. -/
theorem flow_preserves_two_sided_orthogonality
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y : A)
    (hxy : mul x y = 0)
    (hyx : mul y x = 0) :
    mul (flow D t x) (flow D t y) = 0 ∧
      mul (flow D t y) (flow D t x) = 0 := by
  exact ⟨
    flow_preserves_zero_product mul D hD t x y hxy,
    flow_preserves_zero_product_rev mul D hD t x y hyx
  ⟩

/--
Vanishing of an associator is preserved by the derivation exponential.
-/
theorem flow_preserves_associator_zero
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y z : A)
    (hxyz :
      associator mul x y z = 0) :
    associator
        mul
        (flow D t x)
        (flow D t y)
        (flow D t z) =
      0 := by
  rw [
    ← flow_associator
      mul D hD t x y z,
    hxyz
  ]
  exact
    (flow D t).map_zero

/--
Complete structural packet for the finite derivation flow.
-/
theorem derivation_exponential_structure_packet
    (mul : A →L[ℝ] A →L[ℝ] A)
    (D : EndA)
    (hD : IsDerivation mul D)
    (t : ℝ)
    (x y z : A) :
    flow D t (mul x y) =
        mul (flow D t x) (flow D t y)
      ∧
    flow D t
        (associator mul x y z) =
      associator
        mul
        (flow D t x)
        (flow D t y)
        (flow D t z)
      ∧
    flow (-D) t
        (flow D t x) =
      x := by
  exact ⟨
    flow_map_mul
      mul D hD t x y,
    flow_associator
      mul D hD t x y z,
    flow_neg_apply_flow
      D t x
  ⟩

/--
Complete one-parameter-group packet for the generic linear-equivalence flow.
-/
theorem derivation_exponential_group_packet
    (D : EndA)
    (s t : ℝ) :
    flowLinearEquivGroupHom D
        (Multiplicative.ofAdd 0) = 1
      ∧
    flowLinearEquivGroupHom D
        (Multiplicative.ofAdd (s + t)) =
      flowLinearEquivGroupHom D
          (Multiplicative.ofAdd s) *
        flowLinearEquivGroupHom D
          (Multiplicative.ofAdd t)
      ∧
    flowLinearEquivGroupHom D
        (Multiplicative.ofAdd (-t)) =
      (flowLinearEquivGroupHom D
        (Multiplicative.ofAdd t))⁻¹ := by
  exact ⟨
    flowLinearEquivGroupHom_zero D,
    flowLinearEquivGroupHom_add D s t,
    flowLinearEquivGroupHom_neg D t
  ⟩

end InfoGeometry.Lie.ContinuousDerivationExponential

end noncomputable section
