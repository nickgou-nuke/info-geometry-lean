import Mathlib.Tactic

/-!
# InfoGeometry.Canonical.LieFenchelQuadratic

Quadratic Fenchel/Bregman core on a real inner-product space.

This is the Lie-algebra model (`𝔤`) with the canonical quadratic potential:
`ψ(X) = 1/2 * ‖X‖²`.
It proves:
* Fenchel-Young inequality in this model;
* exact quadratic Bregman formula `Dψ(X,Y) = 1/2 * ‖X - Y‖²`;
* nonnegativity and zero-characterization.

No wrappers. No `sorry`.
-/

namespace InfoGeometry.Canonical.LieFenchelQuadratic

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Quadratic primal potential on the Lie-algebra model. -/
noncomputable def psi (x : E) : ℝ := (1 / 2 : ℝ) * ‖x‖ ^ 2

/-- Quadratic Bregman divergence generated by `psi`. -/
noncomputable def bregman (x y : E) : ℝ :=
  psi x - psi y - inner ℝ y (x - y)

/-- Fenchel-Young inequality for the quadratic potential. -/
theorem fenchel_young (x y : E) :
    inner ℝ x y ≤ psi x + psi y := by
  unfold psi
  -- from `0 ≤ ‖x - y‖² = ‖x‖² + ‖y‖² - 2⟪x,y⟫`
  have hsq : 0 ≤ ‖x - y‖ ^ 2 := sq_nonneg ‖x - y‖
  have hident : ‖x - y‖ ^ 2 = ‖x‖ ^ 2 + ‖y‖ ^ 2 - 2 * inner ℝ x y := by
    nlinarith [norm_sub_sq_real x y]
  have hcore : 2 * inner ℝ x y ≤ ‖x‖ ^ 2 + ‖y‖ ^ 2 := by
    nlinarith [hsq, hident]
  nlinarith [hcore]

/-- Exact quadratic Bregman identity. -/
theorem bregman_eq_half_norm_sub_sq (x y : E) :
    bregman x y = (1 / 2 : ℝ) * ‖x - y‖ ^ 2 := by
  unfold bregman psi
  have hy : inner ℝ y (x - y) = inner ℝ x y - ‖y‖ ^ 2 := by
    calc
      inner ℝ y (x - y) = inner ℝ y x - inner ℝ y y := by simp [inner_sub_right]
      _ = inner ℝ x y - ‖y‖ ^ 2 := by
        simp [real_inner_comm, real_inner_self_eq_norm_sq]
  rw [hy]
  nlinarith [norm_sub_sq_real x y]

/-- Nonnegativity of quadratic Bregman divergence. -/
theorem bregman_nonneg (x y : E) :
    0 ≤ bregman x y := by
  rw [bregman_eq_half_norm_sub_sq]
  exact mul_nonneg (by norm_num) (sq_nonneg ‖x - y‖)

/-- Zero iff equality for quadratic Bregman divergence. -/
theorem bregman_eq_zero_iff (x y : E) :
    bregman x y = 0 ↔ x = y := by
  rw [bregman_eq_half_norm_sub_sq]
  constructor
  · intro h
    have hs : ‖x - y‖ ^ 2 = 0 := by
      have hhalf : (1 / 2 : ℝ) ≠ 0 := by norm_num
      exact (mul_eq_zero.mp h).resolve_left hhalf
    have hnorm : ‖x - y‖ = 0 := sq_eq_zero_iff.mp hs
    exact sub_eq_zero.mp (norm_eq_zero.mp hnorm)
  · intro h
    subst h
    simp

/--
Quadratic potential is invariant under any linear isometry.

This is the finite Lie-side surrogate for `Ad`-invariance when the adjoint
action preserves the chosen inner product.
-/
theorem psi_invariant_of_isometry
    (T : E →ₗ[ℝ] E)
    (hT : ∀ x : E, ‖T x‖ = ‖x‖) (x : E) :
    psi (T x) = psi x := by
  unfold psi
  rw [hT x]

/--
Quadratic Bregman divergence is invariant under any linear isometry.
-/
theorem bregman_invariant_of_isometry
    (T : E →ₗ[ℝ] E)
    (hTnorm : ∀ x : E, ‖T x‖ = ‖x‖)
    (hTinner : ∀ x y : E, inner ℝ (T x) (T y) = inner ℝ x y)
    (x y : E) :
    bregman (T x) (T y) = bregman x y := by
  unfold bregman psi
  have hsub : T (x - y) = T x - T y := by simp
  rw [← hsub, hTnorm x, hTnorm y, hTinner y (x - y)]

end InfoGeometry.Canonical.LieFenchelQuadratic
