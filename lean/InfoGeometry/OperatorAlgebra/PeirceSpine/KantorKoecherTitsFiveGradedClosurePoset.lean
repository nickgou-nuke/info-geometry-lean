/-!
# Extremal KKT-style closure and five-sector Peirce decomposition (`KKT₁`–`KKT₁₀`)

This file proves identities for the extremal sandwich operators generated by
the existing anomaly-first owner. It also proves a five-sector Peirce
decomposition and additive direct-sum recomposition over `[Ring B] [StarRing B]`.
The integer eigenspace family of `ad(Σ)` is exposed through Mathlib's
homogeneous-bracket interface. These are related structures, but this file does
not assert Mathlib's `GradedLieAlgebra` instance: in arbitrary characteristic,
integer eigenvalues need not distinguish the five Peirce sectors.
-/
namespace InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTits

open InfoGeometry.Core.JordanAssociator
open OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset
open scoped DirectSum

attribute [local instance 100] LieRing.ofAssociativeRing

variable {B : Type*} [Ring B] [StarRing B]

/-- The unnormalized Jordan associator used by the KKT sandwich generators. -/
def JordanAssoc (X Y Z : B) : B :=
  ((X * Y + Y * X) * Z + Z * (X * Y + Y * X)) -
    (X * (Y * Z + Z * Y) + (Y * Z + Z * Y) * X)

/-- Positive extremal generator, defined by its Jordan associator owner. -/
def K_plus2 (N X : B) : B := JordanAssoc X N N

/-- Negative extremal generator. -/
def K_minus2 (N X : B) : B := JordanAssoc X (star N) (star N)

omit [StarRing B] in
/-- For a square-zero element the Jordan associator is twice the quadratic
triple sandwich. -/
theorem K_plus2_eq_two_sandwich (N X : B) (hN : N * N = 0) :
    K_plus2 N X = 2 • (N * X * N) := by
  dsimp [K_plus2, JordanAssoc]
  rw [InfoGeometry.Core.JordanAssociator.symm_associator_eq_double_commutator]
  have hleft : N * (N * X) = 0 := by rw [← mul_assoc, hN, zero_mul]
  have hright : (X * N) * N = 0 := by rw [mul_assoc, hN, mul_zero]
  have hexpand : N * (X * N - N * X) - (X * N - N * X) * N =
      ((N * X) * N - N * (N * X)) - ((X * N) * N - (N * X) * N) := by
    noncomm_ring
  rw [hexpand, hleft, hright]
  simp only [zero_sub, sub_zero, two_nsmul]
  noncomm_ring

theorem K_minus2_eq_two_sandwich (N X : B) (hN : N * N = 0) :
    K_minus2 N X = 2 • (star N * X * star N) := by
  exact K_plus2_eq_two_sandwich (star N) X
    (by rw [← star_mul, hN, star_zero])

/-- The anomaly grades the positive sandwich with adjoint weight `+2`. -/
theorem comm_Sigma_K_plus2 (N X : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    comm (Sigma N) (K_plus2 N X) = 2 • K_plus2 N X := by
  rw [K_plus2_eq_two_sandwich N X hN]
  dsimp [comm]
  have hL : Sigma N * (N * X * N) = N * X * N := by
    calc Sigma N * (N * X * N)
        = ((Sigma N * N) * X) * N := by noncomm_ring
      _ = (N * X) * N := by rw [Sigma_mul_N_plus N hN hreg]
      _ = N * X * N := rfl
  have hR : (N * X * N) * Sigma N = -(N * X * N) := by
    calc (N * X * N) * Sigma N
        = (N * X) * (N * Sigma N) := by rw [mul_assoc]
      _ = (N * X) * (-N) := by rw [N_plus_mul_Sigma N hN hreg]
      _ = -(N * X * N) := by rw [mul_neg]
  simp only [two_nsmul, mul_add, add_mul, hL, hR]
  noncomm_ring

/-- The anomaly grades the negative sandwich with adjoint weight `-2`. -/
theorem comm_Sigma_K_minus2 (N X : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    comm (Sigma N) (K_minus2 N X) = -((2 : ℕ) • K_minus2 N X) := by
  rw [K_minus2_eq_two_sandwich N X hN]
  dsimp [comm]
  have hL : Sigma N * (star N * X * star N) = -(star N * X * star N) := by
    calc Sigma N * (star N * X * star N)
        = ((Sigma N * star N) * X) * star N := by noncomm_ring
      _ = ((-star N) * X) * star N := by rw [Sigma_mul_star_N_plus N hN hreg]
      _ = -(star N * X * star N) := by rw [neg_mul, neg_mul]
  have hR : (star N * X * star N) * Sigma N = star N * X * star N := by
    calc (star N * X * star N) * Sigma N
        = (star N * X) * (star N * Sigma N) := by rw [mul_assoc]
      _ = (star N * X) * star N := by rw [star_N_plus_mul_Sigma N hN hreg]
      _ = star N * X * star N := rfl
  simp only [two_nsmul, mul_add, add_mul, hL, hR]
  noncomm_ring

omit [StarRing B] in
/-- Same-grade positive sandwiches multiply to zero. -/
theorem sandwich_plus_mul_sandwich_plus (N X Y : B) (hN : N * N = 0) :
    (N * X * N) * (N * Y * N) = 0 := by
  calc (N * X * N) * (N * Y * N)
      = ((N * X) * (N * N)) * (Y * N) := by noncomm_ring
    _ = 0 := by rw [hN, mul_zero, zero_mul]

/-- Same-grade negative sandwiches multiply to zero. -/
theorem sandwich_minus_mul_sandwich_minus (N X Y : B) (hN : N * N = 0) :
    (star N * X * star N) * (star N * Y * star N) = 0 := by
  exact sandwich_plus_mul_sandwich_plus (star N) X Y
    (by rw [← star_mul, hN, star_zero])

omit [StarRing B] in
theorem K_plus2_mul_K_plus2 (N X Y : B) (hN : N * N = 0) :
    K_plus2 N X * K_plus2 N Y = 0 := by
  rw [K_plus2_eq_two_sandwich N X hN, K_plus2_eq_two_sandwich N Y hN]
  simp only [two_nsmul, add_mul, mul_add,
    sandwich_plus_mul_sandwich_plus N X Y hN, add_zero]

theorem K_minus2_mul_K_minus2 (N X Y : B) (hN : N * N = 0) :
    K_minus2 N X * K_minus2 N Y = 0 := by
  rw [K_minus2_eq_two_sandwich N X hN, K_minus2_eq_two_sandwich N Y hN]
  simp only [two_nsmul, add_mul, mul_add,
    sandwich_minus_mul_sandwich_minus N X Y hN, add_zero]

theorem K_plus2_seed (N : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    K_plus2 N (star N) = 2 • N := by
  rw [K_plus2_eq_two_sandwich N (star N) hN, hreg]

theorem K_minus2_seed (N : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    K_minus2 N N = 2 • star N := by
  rw [K_minus2_eq_two_sandwich N N hN]
  have hreg' := star_N_plus_reg N hreg
  rw [hreg']

/-- The positive transition cone selected by the chiral support is exactly
the original nilpotent generator. -/
theorem conePlus_of_regular_nilpotent (N : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    InfoGeometry.OperatorAlgebra.PeirceSpine.conePlus
      (InfoGeometry.OperatorAlgebra.PeirceSpine.YangMillsVortexPoset.P N) N = N := by
  unfold InfoGeometry.OperatorAlgebra.PeirceSpine.conePlus
    InfoGeometry.OperatorAlgebra.PeirceSpine.YangMillsVortexPoset.P
  have hleft : N * star N * N = N := hreg
  have hright : N * (N * star N) = 0 := by
    rw [← mul_assoc, hN, zero_mul]
  rw [hleft]
  calc N * (1 - N * star N)
      = N * 1 - N * (N * star N) := by rw [mul_sub]
    _ = N := by rw [mul_one, hright, sub_zero]

/-- The Jordan-associator extremal generator is twice the established
Kantor–Peirce grade `+2` operator after specializing its transition cone to
the regular nilpotent `N`. -/
theorem K_plus2_eq_two_kantorGp2 (N X : B) (hN : N * N = 0)
    (hreg : N * star N * N = N) :
    K_plus2 N X = 2 •
      InfoGeometry.OperatorAlgebra.PeirceSpine.kantorGp2
        (InfoGeometry.OperatorAlgebra.PeirceSpine.YangMillsVortexPoset.P N) N X := by
  rw [K_plus2_eq_two_sandwich N X hN,
    InfoGeometry.OperatorAlgebra.PeirceSpine.kantorGp2,
    conePlus_of_regular_nilpotent N hN hreg]

end InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTits

namespace InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTitsClosurePoset

open OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset
open InfoGeometry.OperatorAlgebra.PeirceSpine.YangMillsVortexPoset (P Q)

local notation "Sigma" => OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset.Sigma

universe u

/-!
## 1. 10-Stage Kantor–Koecher–Tits 5-Graded Closure Poset (`KantorKoecherTitsStage`)
-/

/-- The 10-stage dependency poset for the 5-graded Kantor–Koecher–Tits Lie algebra
`g_{-2} ⊕ g_{-1} ⊕ g_0 ⊕ g_{+1} ⊕ g_{+2}` generated by a regular nilpotent pair `(N_+, N_-)`
and graded by the adjoint action of the parity anomaly `Σ = [N_+, N_-]`. -/
inductive KantorKoecherTitsStage : Type
  | KKT1_JordanQuadraticTripleSandwich
  | KKT2_ExtremalGradePlusMinusTwo
  | KKT3_ExtremalAbelianNilpotency
  | KKT4_RegularNilpotentSeedFixedPoint
  | KKT5_OddGradePlusMinusOneCarriers
  | KKT6_OddToExtremalBracketClosure
  | KKT7_ExtremalOppositeGradeToZero
  | KKT8_ZeroGradeDiagonalNeutralCentralizer
  | KKT9_ExtremalCommutatorZeroGradeClosure
  | KKT10_MasterFiveGradedKantorKoecherTitsSynthesis
  deriving DecidableEq, Repr

namespace KantorKoecherTitsStage

/-- Monotone integer rank of each stage in `KantorKoecherTitsStage`. -/
def rank : KantorKoecherTitsStage → ℕ
  | .KKT1_JordanQuadraticTripleSandwich => 1
  | .KKT2_ExtremalGradePlusMinusTwo => 2
  | .KKT3_ExtremalAbelianNilpotency => 3
  | .KKT4_RegularNilpotentSeedFixedPoint => 4
  | .KKT5_OddGradePlusMinusOneCarriers => 5
  | .KKT6_OddToExtremalBracketClosure => 6
  | .KKT7_ExtremalOppositeGradeToZero => 7
  | .KKT8_ZeroGradeDiagonalNeutralCentralizer => 8
  | .KKT9_ExtremalCommutatorZeroGradeClosure => 9
  | .KKT10_MasterFiveGradedKantorKoecherTitsSynthesis => 10

theorem rank_injective : Function.Injective rank := by
  intro a b h
  cases a <;> cases b <;> first | rfl | cases h

/-- Causal order relation on `KantorKoecherTitsStage`. -/
def causalEdge (a b : KantorKoecherTitsStage) : Prop :=
  rank a ≤ rank b

instance instDecidableRelCausalEdge : DecidableRel causalEdge :=
  fun a b => Nat.decLe (rank a) (rank b)

instance instLE : LE KantorKoecherTitsStage where
  le := causalEdge

instance instPreorder : Preorder KantorKoecherTitsStage where
  le := causalEdge
  le_refl a := Nat.le_refl (rank a)
  le_trans _ _ _ hab hbc := Nat.le_trans hab hbc

instance instPartialOrder : PartialOrder KantorKoecherTitsStage where
  le_antisymm _ _ hab hba := rank_injective (Nat.le_antisymm hab hba)

instance instDecidableRelLE :
    DecidableRel (fun a b : KantorKoecherTitsStage => a ≤ b) :=
  instDecidableRelCausalEdge

theorem causalEdge_KKT1_KKT2 :
    causalEdge .KKT1_JordanQuadraticTripleSandwich .KKT2_ExtremalGradePlusMinusTwo := by decide
theorem causalEdge_KKT2_KKT3 :
    causalEdge .KKT2_ExtremalGradePlusMinusTwo .KKT3_ExtremalAbelianNilpotency := by decide
theorem causalEdge_KKT3_KKT4 :
    causalEdge .KKT3_ExtremalAbelianNilpotency .KKT4_RegularNilpotentSeedFixedPoint := by decide
theorem causalEdge_KKT4_KKT5 :
    causalEdge .KKT4_RegularNilpotentSeedFixedPoint .KKT5_OddGradePlusMinusOneCarriers := by decide
theorem causalEdge_KKT5_KKT6 :
    causalEdge .KKT5_OddGradePlusMinusOneCarriers .KKT6_OddToExtremalBracketClosure := by decide
theorem causalEdge_KKT6_KKT7 :
    causalEdge .KKT6_OddToExtremalBracketClosure .KKT7_ExtremalOppositeGradeToZero := by decide
theorem causalEdge_KKT7_KKT8 :
    causalEdge .KKT7_ExtremalOppositeGradeToZero .KKT8_ZeroGradeDiagonalNeutralCentralizer := by decide
theorem causalEdge_KKT8_KKT9 :
    causalEdge .KKT8_ZeroGradeDiagonalNeutralCentralizer .KKT9_ExtremalCommutatorZeroGradeClosure := by decide
theorem causalEdge_KKT9_KKT10 :
    causalEdge .KKT9_ExtremalCommutatorZeroGradeClosure
      .KKT10_MasterFiveGradedKantorKoecherTitsSynthesis := by decide

end KantorKoecherTitsStage

/-!
## 2. Pure Ring Helpers (Before `[StarRing B]`)
-/

section RingHelpers

variable {B : Type u} [Ring B]

/-- The unnormalized Jordan associator `{{X, Y}, Z} - {X, {Y, Z}}`. -/
def JordanAssoc (X Y Z : B) : B :=
  ((X * Y + Y * X) * Z + Z * (X * Y + Y * X)) -
  (X * (Y * Z + Z * Y) + (Y * Z + Z * Y) * X)

/-- Positive extremal Jordan triple sandwich `G_{+2}(N_+, X) := N_+ X N_+`. -/
def G_plus2 (N_plus X : B) : B := N_plus * X * N_plus

/-- Positive extremal Jordan associator generator `K_{+2}(N_+, X) := JordanAssoc(X, N_+, N_+)`. -/
def K_plus2 (N_plus X : B) : B := JordanAssoc X N_plus N_plus

/-- Pure ring identity: when `N * N = 0`, `JordanAssoc X N N = (2 : ℕ) • (N * X * N)`. -/
theorem kkt_jordan_assoc_eq_two_sandwich (N X : B) (h_nil : N * N = 0) :
    JordanAssoc X N N = (2 : ℕ) • (N * X * N) := by
  change InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTits.JordanAssoc X N N = _
  exact InfoGeometry.OperatorAlgebra.PeirceSpine.KantorKoecherTits.K_plus2_eq_two_sandwich N X h_nil

/-- Pure ring helper: when `S * N = N` and `N * S = -N`, `[S, N * X * N] = 2 • (N * X * N)`. -/
theorem kkt_comm_grading_plus2 (S N X : B)
    (hL : S * N = N) (hR : N * S = -N) :
    comm S (N * X * N) = (2 : ℕ) • (N * X * N) := by
  dsimp [comm]
  have h1 : S * (N * X * N) = N * X * N := by
    calc S * (N * X * N)
        = (S * N) * X * N := by noncomm_ring
      _ = N * X * N := by rw [hL]
  have h2 : (N * X * N) * S = -(N * X * N) := by
    calc (N * X * N) * S
        = (N * X) * (N * S) := by noncomm_ring
      _ = (N * X) * (-N) := by rw [hR]
      _ = -(N * X * N) := by noncomm_ring
  rw [h1, h2, sub_neg_eq_add, two_nsmul]

/-- Pure ring helper: when `S * M = -M` and `M * S = M`, `[S, M * X * M] = -(2 • (M * X * M))`. -/
theorem kkt_comm_grading_minus2 (S M X : B)
    (hL : S * M = -M) (hR : M * S = M) :
    comm S (M * X * M) = -((2 : ℕ) • (M * X * M)) := by
  dsimp [comm]
  have h1 : S * (M * X * M) = -(M * X * M) := by
    calc S * (M * X * M)
        = (S * M) * X * M := by noncomm_ring
      _ = (-M) * X * M := by rw [hL]
      _ = -(M * X * M) := by noncomm_ring
  have h2 : (M * X * M) * S = M * X * M := by
    calc (M * X * M) * S
        = (M * X) * (M * S) := by rw [mul_assoc]
      _ = M * X * M := by rw [hR]
  rw [h1, h2, two_nsmul]
  noncomm_ring

/-- Pure ring helper: `[S, (2 : ℕ) • A] = (2 : ℕ) • [S, A]`. -/
theorem kkt_comm_two_nsmul_right (S A : B) :
    comm S ((2 : ℕ) • A) = (2 : ℕ) • comm S A := by
  dsimp [comm]
  rw [two_nsmul, two_nsmul]
  noncomm_ring

/-- Pure ring helper: `(2 : ℕ) • (-((2 : ℕ) • A)) = -((2 : ℕ) • ((2 : ℕ) • A))`. -/
theorem kkt_two_nsmul_neg (A : B) :
    (2 : ℕ) • (-((2 : ℕ) • A)) = -((2 : ℕ) • ((2 : ℕ) • A)) := by
  rw [two_nsmul, two_nsmul]
  abel

/-- Pure ring helper: `(N * X * N) * (N * Y * N) = 0` when `N * N = 0`. -/
theorem kkt_sandwich_mul_sandwich_zero (N X Y : B) (h_nil : N * N = 0) :
    (N * X * N) * (N * Y * N) = 0 := by
  calc (N * X * N) * (N * Y * N)
      = (N * X) * (N * N) * (Y * N) := by noncomm_ring
    _ = 0 := by rw [h_nil, mul_zero, zero_mul]

/-- Pure ring helper: `((2 : ℕ) • A) * ((2 : ℕ) • C) = 0` when `A * C = 0`. -/
theorem kkt_two_nsmul_mul_two_nsmul_zero (A C : B) (hAC : A * C = 0) :
    ((2 : ℕ) • A) * ((2 : ℕ) • C) = 0 := by
  rw [two_nsmul, two_nsmul]
  calc (A + A) * (C + C)
      = A * C + A * C + A * C + A * C := by noncomm_ring
    _ = 0 := by rw [hAC, add_zero, add_zero, add_zero]

/-- Pure ring helper for left odd grade `+1`: when `S * N = N` and `X * (1 - V) * S = 0`,
`comm S (N * X * (1 - V)) = N * X * (1 - V)`. -/
theorem kkt_comm_odd_plus1_L (S N V X : B)
    (hSN : S * N = N) (hVS : (1 - V) * S = 0) :
    comm S (N * X * (1 - V)) = N * X * (1 - V) := by
  dsimp [comm]
  have h1 : S * (N * X * (1 - V)) = N * X * (1 - V) := by
    calc S * (N * X * (1 - V))
        = (S * N) * X * (1 - V) := by noncomm_ring
      _ = N * X * (1 - V) := by rw [hSN]
  have h2 : (N * X * (1 - V)) * S = 0 := by
    calc (N * X * (1 - V)) * S
        = (N * X) * ((1 - V) * S) := by noncomm_ring
      _ = 0 := by rw [hVS, mul_zero]
  rw [h1, h2, sub_zero]

/-- Pure ring helper for right odd grade `+1`: when `S * (1 - V) = 0` and `N * S = -N`,
`comm S ((1 - V) * X * N) = (1 - V) * X * N`. -/
theorem kkt_comm_odd_plus1_R (S N V X : B)
    (hSV : S * (1 - V) = 0) (hNS : N * S = -N) :
    comm S ((1 - V) * X * N) = (1 - V) * X * N := by
  dsimp [comm]
  have h1 : S * ((1 - V) * X * N) = 0 := by
    calc S * ((1 - V) * X * N)
        = (S * (1 - V)) * (X * N) := by noncomm_ring
      _ = 0 := by rw [hSV, zero_mul]
  have h2 : ((1 - V) * X * N) * S = -((1 - V) * X * N) := by
    calc ((1 - V) * X * N) * S
        = ((1 - V) * X) * (N * S) := by noncomm_ring
      _ = ((1 - V) * X) * (-N) := by rw [hNS]
      _ = -((1 - V) * X * N) := by noncomm_ring
  rw [h1, h2, zero_sub, neg_neg]

/-- Pure ring helper for left odd grade `-1`: when `S * M = -M` and `(1 - V) * S = 0`,
`comm S (M * X * (1 - V)) = -(M * X * (1 - V))`. -/
theorem kkt_comm_odd_minus1_L (S M V X : B)
    (hSM : S * M = -M) (hVS : (1 - V) * S = 0) :
    comm S (M * X * (1 - V)) = -(M * X * (1 - V)) := by
  dsimp [comm]
  have h1 : S * (M * X * (1 - V)) = -(M * X * (1 - V)) := by
    calc S * (M * X * (1 - V))
        = (S * M) * X * (1 - V) := by noncomm_ring
      _ = (-M) * X * (1 - V) := by rw [hSM]
      _ = -(M * X * (1 - V)) := by noncomm_ring
  have h2 : (M * X * (1 - V)) * S = 0 := by
    calc (M * X * (1 - V)) * S
        = (M * X) * ((1 - V) * S) := by noncomm_ring
      _ = 0 := by rw [hVS, mul_zero]
  rw [h1, h2, sub_zero]

/-- Pure ring helper for right odd grade `-1`: when `S * (1 - V) = 0` and `M * S = M`,
`comm S ((1 - V) * X * M) = -((1 - V) * X * M)`. -/
theorem kkt_comm_odd_minus1_R (S M V X : B)
    (hSV : S * (1 - V) = 0) (hMS : M * S = M) :
    comm S ((1 - V) * X * M) = -((1 - V) * X * M) := by
  dsimp [comm]
  have h1 : S * ((1 - V) * X * M) = 0 := by
    calc S * ((1 - V) * X * M)
        = (S * (1 - V)) * (X * M) := by noncomm_ring
      _ = 0 := by rw [hSV, zero_mul]
  have h2 : ((1 - V) * X * M) * S = (1 - V) * X * M := by
    calc ((1 - V) * X * M) * S
        = ((1 - V) * X) * (M * S) := by noncomm_ring
      _ = (1 - V) * X * M := by rw [hMS]
  rw [h1, h2, zero_sub]

/-- Pure ring helper for `[g_{+1}, g_{+1}] ⊆ g_{+2}` and `[g_{-1}, g_{-1}] ⊆ g_{-2}`. -/
theorem kkt_comm_G1_into_G2_helper (N V X Y : B) (h_nil : N * N = 0)
    (hV_idem : (1 - V) * (1 - V) = 1 - V) :
    comm (N * X * (1 - V)) ((1 - V) * Y * N) =
      N * (X * (1 - V) * Y) * N := by
  dsimp [comm]
  have h_second : ((1 - V) * Y * N) * (N * X * (1 - V)) = 0 := by
    calc ((1 - V) * Y * N) * (N * X * (1 - V))
        = ((1 - V) * Y) * (N * N) * (X * (1 - V)) := by noncomm_ring
      _ = 0 := by rw [h_nil, mul_zero, zero_mul]
  rw [h_second, sub_zero]
  calc (N * X * (1 - V)) * ((1 - V) * Y * N)
      = N * X * ((1 - V) * (1 - V)) * Y * N := by noncomm_ring
    _ = N * (X * (1 - V) * Y) * N := by rw [hV_idem]; noncomm_ring

/-- Pure ring helper for `[g_{+2}, g_{-2}] ⊆ g_0`. -/
theorem kkt_comm_extremal_into_G0_helper (N M P Q X Y : B)
    (hP : N * M = P) (hQ : M * N = Q)
    (hPN : P * N = N) (hMP : M * P = M)
    (hQM : Q * M = M) (hNQ : N * Q = N) :
    comm (N * X * N) (M * Y * M) =
      P * (N * X * P * Y * M) * P - Q * (M * Y * Q * X * N) * Q := by
  dsimp [comm]
  have h1 : P * (N * X * P * Y * M) * P = (N * X * N) * (M * Y * M) := by
    calc P * (N * X * P * Y * M) * P
        = (P * N) * X * (N * M) * Y * (M * P) := by
          rw [← hP]
          noncomm_ring
      _ = (N * X * N) * (M * Y * M) := by
          rw [hPN, hMP]
          noncomm_ring
  have h2 : Q * (M * Y * Q * X * N) * Q = (M * Y * M) * (N * X * N) := by
    calc Q * (M * Y * Q * X * N) * Q
        = (Q * M) * Y * (M * N) * X * (N * Q) := by
          rw [← hQ]
          noncomm_ring
      _ = (M * Y * M) * (N * X * N) := by
          rw [hQM, hNQ]
          noncomm_ring
  rw [h1, h2]

/-- Pure ring helper: when `S * E = c • E` and `E * S = c • E` (with `c = ±1`),
`comm S (E * X * E) = 0`. -/
theorem kkt_comm_grade0_idempotent (S E X : B)
    (hL : S * E = E) (hR : E * S = E) :
    comm S (E * X * E) = 0 := by
  dsimp [comm]
  have h1 : S * (E * X * E) = E * X * E := by
    calc S * (E * X * E)
        = (S * E) * X * E := by noncomm_ring
      _ = E * X * E := by rw [hL]
  have h2 : (E * X * E) * S = E * X * E := by
    calc (E * X * E) * S
        = (E * X) * (E * S) := by noncomm_ring
      _ = E * X * E := by rw [hR]
  rw [h1, h2, sub_self]

/-- Pure ring helper: when `S * E = -E` and `E * S = -E`,
`comm S (E * X * E) = 0`. -/
theorem kkt_comm_grade0_neg_idempotent (S E X : B)
    (hL : S * E = -E) (hR : E * S = -E) :
    comm S (E * X * E) = 0 := by
  dsimp [comm]
  have h1 : S * (E * X * E) = -(E * X * E) := by
    calc S * (E * X * E)
        = (S * E) * X * E := by noncomm_ring
      _ = (-E) * X * E := by rw [hL]
      _ = -(E * X * E) := by noncomm_ring
  have h2 : (E * X * E) * S = -(E * X * E) := by
    calc (E * X * E) * S
        = (E * X) * (E * S) := by noncomm_ring
      _ = (E * X) * (-E) := by rw [hR]
      _ = -(E * X * E) := by noncomm_ring
  rw [h1, h2, sub_self]

/-- Pure ring helper: when `S * E = 0` and `E * S = 0`, `comm S (E * X * E) = 0`. -/
theorem kkt_comm_grade0_zero_idempotent (S E X : B)
    (hL : S * E = 0) (hR : E * S = 0) :
    comm S (E * X * E) = 0 := by
  dsimp [comm]
  have h1 : S * (E * X * E) = 0 := by
    calc S * (E * X * E)
        = (S * E) * (X * E) := by noncomm_ring
      _ = 0 := by rw [hL, zero_mul]
  have h2 : (E * X * E) * S = 0 := by
    calc (E * X * E) * S
        = (E * X) * (E * S) := by noncomm_ring
      _ = 0 := by rw [hR, mul_zero]
  rw [h1, h2, sub_self]

/-- Pure ring helper: `comm S (A - C) = comm S A - comm S C`. -/
theorem kkt_comm_sub_right (S A C : B) :
    comm S (A - C) = comm S A - comm S C := by
  dsimp [comm]
  noncomm_ring

theorem kkt_comm_add_right (S A C : B) :
    comm S (A + C) = comm S A + comm S C := by
  dsimp [comm]
  noncomm_ring

theorem kkt_comm_add_left (A C S : B) :
    comm (A + C) S = comm A S + comm C S := by
  dsimp [comm]
  noncomm_ring

theorem kkt_comm_antisymm (A C : B) : comm A C = -comm C A := by
  dsimp [comm]
  noncomm_ring

theorem kkt_comm_block_plus2 (S E F X : B)
    (hSE : S * E = E) (hFS : F * S = -F) :
    comm S (E * X * F) = (2 : ℕ) • (E * X * F) := by
  dsimp [comm]
  have hL : S * (E * X * F) = E * X * F := by
    calc S * (E * X * F) = (S * E) * X * F := by noncomm_ring
      _ = E * X * F := by rw [hSE]
  have hR : (E * X * F) * S = -(E * X * F) := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = E * X * (-F) := by rw [hFS]
      _ = -(E * X * F) := by noncomm_ring
  rw [hL, hR, sub_neg_eq_add, two_nsmul]

theorem kkt_comm_block_plus1_left (S E F X : B)
    (hSE : S * E = E) (hFS : F * S = 0) :
    comm S (E * X * F) = E * X * F := by
  dsimp [comm]
  have hL : S * (E * X * F) = E * X * F := by
    calc S * (E * X * F) = (S * E) * X * F := by noncomm_ring
      _ = E * X * F := by rw [hSE]
  have hR : (E * X * F) * S = 0 := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = 0 := by rw [hFS, mul_zero]
  rw [hL, hR, sub_zero]

theorem kkt_comm_block_plus1_right (S E F X : B)
    (hSE : S * E = 0) (hFS : F * S = -F) :
    comm S (E * X * F) = E * X * F := by
  dsimp [comm]
  have hL : S * (E * X * F) = 0 := by
    calc S * (E * X * F) = (S * E) * (X * F) := by noncomm_ring
      _ = 0 := by rw [hSE, zero_mul]
  have hR : (E * X * F) * S = -(E * X * F) := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = E * X * (-F) := by rw [hFS]
      _ = -(E * X * F) := by noncomm_ring
  rw [hL, hR, zero_sub, neg_neg]

theorem kkt_comm_block_minus1_left (S E F X : B)
    (hSE : S * E = 0) (hFS : F * S = F) :
    comm S (E * X * F) = -(E * X * F) := by
  dsimp [comm]
  have hL : S * (E * X * F) = 0 := by
    calc S * (E * X * F) = (S * E) * (X * F) := by noncomm_ring
      _ = 0 := by rw [hSE, zero_mul]
  have hR : (E * X * F) * S = E * X * F := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = E * X * F := by rw [hFS]
  rw [hL, hR, zero_sub]

theorem kkt_comm_block_minus1_right (S E F X : B)
    (hSE : S * E = -E) (hFS : F * S = 0) :
    comm S (E * X * F) = -(E * X * F) := by
  dsimp [comm]
  have hL : S * (E * X * F) = -(E * X * F) := by
    calc S * (E * X * F) = (S * E) * X * F := by noncomm_ring
      _ = (-E) * X * F := by rw [hSE]
      _ = -(E * X * F) := by noncomm_ring
  have hR : (E * X * F) * S = 0 := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = 0 := by rw [hFS, mul_zero]
  rw [hL, hR, sub_zero]

theorem kkt_comm_block_minus2 (S E F X : B)
    (hSE : S * E = -E) (hFS : F * S = F) :
    comm S (E * X * F) = -((2 : ℕ) • (E * X * F)) := by
  dsimp [comm]
  have hL : S * (E * X * F) = -(E * X * F) := by
    calc S * (E * X * F) = (S * E) * X * F := by noncomm_ring
      _ = (-E) * X * F := by rw [hSE]
      _ = -(E * X * F) := by noncomm_ring
  have hR : (E * X * F) * S = E * X * F := by
    calc (E * X * F) * S = E * X * (F * S) := by noncomm_ring
      _ = E * X * F := by rw [hFS]
  rw [hL, hR, two_nsmul]
  noncomm_ring

/-- The inner commutator is a derivation of the Lie bracket. This identity is
the general mechanism behind addition of `ad(S)`-grades under commutators. -/
theorem kkt_commutator_derivation (S A C : B) :
    comm S (comm A C) = comm (comm S A) C + comm A (comm S C) := by
  dsimp [comm]
  noncomm_ring

/-- The associative commutator satisfies the cyclic Jacobi identity, so the
bracket used for the KKT sectors is a Lie bracket over the underlying additive
group. -/
theorem kkt_comm_jacobi (A C D : B) :
    comm A (comm C D) + comm C (comm D A) + comm D (comm A C) = 0 := by
  dsimp [comm]
  noncomm_ring

/-- Alternating law for the commutator bracket. -/
theorem kkt_comm_self (A : B) : comm A A = 0 := by
  dsimp [comm]
  exact sub_self _

/-- The owner bracket agrees with mathlib's canonical Lie bracket on an
associative ring. The instance stays local because mathlib intentionally does
not install it globally, avoiding a bracket-instance diamond for modules. -/
theorem kkt_comm_eq_native_lie_bracket (A C : B) :
    (letI : LieRing B := LieRing.ofAssociativeRing
     comm A C = ⁅A, C⁆) := by
  rfl

/-- Commutators are additive in the first argument, including natural scalar
multiples. This lets eigenvalue equations be propagated through brackets. -/
theorem kkt_comm_nsmul_left (k : ℕ) (A C : B) :
    comm (k • A) C = k • comm A C := by
  induction k with
  | zero => simp [comm]
  | succ k ih =>
      rw [succ_nsmul, kkt_comm_add_left, ih, succ_nsmul]

/-- Commutators are additive in the second argument, including natural scalar
multiples. -/
theorem kkt_comm_nsmul_right (k : ℕ) (A C : B) :
    comm A (k • C) = k • comm A C := by
  induction k with
  | zero => simp [comm]
  | succ k ih =>
      rw [succ_nsmul, kkt_comm_add_right, ih, succ_nsmul]

/-- Integer scalar multiples in the first commutator argument. -/
theorem kkt_comm_zsmul_left (k : ℤ) (A C : B) :
    comm (k • A) C = k • comm A C := by
  let f : B →+ B :=
    { toFun := fun x => comm x C
      map_zero' := by simp [comm]
      map_add' := fun x y => kkt_comm_add_left x y C }
  exact f.map_zsmul k A

/-- Integer scalar multiples in the second commutator argument. -/
theorem kkt_comm_zsmul_right (k : ℤ) (A C : B) :
    comm A (k • C) = k • comm A C := by
  let f : B →+ B :=
    { toFun := fun x => comm A x
      map_zero' := by simp [comm]
      map_add' := fun x y => kkt_comm_add_right A x y }
  exact f.map_zsmul k C

/-- The `ad(S)` grade of a commutator is the sum of the grades. The natural
grades here cover the nonnegative half of the five-grade decomposition. -/
theorem kkt_ad_grade_bracket_add (S A C : B) (m n : ℕ)
    (hA : comm S A = m • A) (hC : comm S C = n • C) :
    comm S (comm A C) = (m + n) • comm A C := by
  rw [kkt_commutator_derivation, hA, hC,
    kkt_comm_nsmul_left, kkt_comm_nsmul_right, ← add_nsmul]

/-- A grade `+1` bracket with a grade `-1` element has grade zero. -/
theorem kkt_ad_grade_bracket_one_minus_one (S A C : B)
    (hA : comm S A = A) (hC : comm S C = -C) :
    comm S (comm A C) = 0 := by
  rw [kkt_commutator_derivation, hA, hC]
  dsimp [comm]
  noncomm_ring

/-- The bracket of two grade `+1` elements has grade `+2`. -/
theorem kkt_ad_grade_bracket_one_one (S A C : B)
    (hA : comm S A = A) (hC : comm S C = C) :
    comm S (comm A C) = (2 : ℕ) • comm A C := by
  exact kkt_ad_grade_bracket_add S A C 1 1
    (by simpa using hA) (by simpa using hC)

/-- Full signed-grade addition law: the adjoint grade of a bracket is the sum
of the integer adjoint grades of its inputs. -/
theorem kkt_ad_zgrade_bracket_add (S A C : B) (m n : ℤ)
    (hA : comm S A = m • A) (hC : comm S C = n • C) :
    comm S (comm A C) = (m + n) • comm A C := by
  rw [kkt_commutator_derivation, hA, hC,
    kkt_comm_zsmul_left, kkt_comm_zsmul_right, add_zsmul]

/-- The integer-grade eigenspace of the inner derivation `ad(S)`, bundled as
an additive subgroup of the underlying ring. -/
def kktAdjointGrade (S : B) (k : ℤ) : AddSubgroup B where
  carrier := {X | comm S X = k • X}
  zero_mem' := by simp [comm]
  add_mem' := by
    intro X Y hX hY
    change comm S X = k • X at hX
    change comm S Y = k • Y at hY
    change comm S (X + Y) = k • (X + Y)
    rw [kkt_comm_add_right, hX, hY, ← zsmul_add]
  neg_mem' := by
    intro X hX
    change comm S X = k • X at hX
    change comm S (-X) = k • (-X)
    have hneg : comm S (-X) = -comm S X := by
      dsimp [comm]
      noncomm_ring
    rw [hneg, hX, zsmul_neg]

/-- The commutator of homogeneous elements has the sum of their adjoint grades. -/
theorem kktAdjointGrade_bracket {S X Y : B} {m n : ℤ}
    (hX : X ∈ kktAdjointGrade S m) (hY : Y ∈ kktAdjointGrade S n) :
    comm X Y ∈ kktAdjointGrade S (m + n) := by
  change comm S X = m • X at hX
  change comm S Y = n • Y at hY
  change comm S (comm X Y) = (m + n) • comm X Y
  exact kkt_ad_zgrade_bracket_add S X Y m n hX hY

/-- Peirce-block composition: matching middle support idempotents compose,
and orthogonal outer supports kill the reverse product. -/
theorem kkt_peirce_bracket_composable (A E D X Y : B)
    (hE : E * E = E) (hDA : D * A = 0) :
    comm (A * X * E) (E * Y * D) = A * X * E * Y * D := by
  dsimp [comm]
  calc (A * X * E) * (E * Y * D) - (E * Y * D) * (A * X * E)
      = (A * X) * (E * E) * (Y * D) - (E * Y) * (D * A) * (X * E) := by
          noncomm_ring
    _ = (A * X) * E * (Y * D) - 0 := by rw [hE, hDA, mul_zero, zero_mul]
    _ = A * X * E * Y * D := by noncomm_ring

/-- Mismatched orthogonal Peirce endpoints make both block products vanish. -/
theorem kkt_peirce_bracket_orthogonal (A E F D X Y : B)
    (hEF : E * F = 0) (hDA : D * A = 0) :
    comm (A * X * E) (F * Y * D) = 0 := by
  dsimp [comm]
  calc (A * X * E) * (F * Y * D) - (F * Y * D) * (A * X * E)
      = (A * X) * (E * F) * (Y * D) - (F * Y) * (D * A) * (X * E) := by
          noncomm_ring
    _ = 0 - 0 := by rw [hEF, hDA, mul_zero, zero_mul, mul_zero, zero_mul]
    _ = 0 := by rw [sub_self]

/-- The diagonal blocks of a three-piece Peirce decomposition are closed under
the commutator. Cross terms vanish whenever the idempotent supports are
pairwise orthogonal. -/
theorem kkt_diagonal_peirce_bracket (P Q R X Y : B)
    (hPQ : P * Q = 0) (hQP : Q * P = 0)
    (hPR : P * R = 0) (hRP : R * P = 0)
    (hQR : Q * R = 0) (hRQ : R * Q = 0) :
    comm (P * X * P + Q * X * Q + R * X * R)
        (P * Y * P + Q * Y * Q + R * Y * R) =
      comm (P * X * P) (P * Y * P) +
      comm (Q * X * Q) (Q * Y * Q) +
      comm (R * X * R) (R * Y * R) := by
  have hPQ₁ := kkt_peirce_bracket_orthogonal P P Q Q X Y hPQ hQP
  have hQP₁ := kkt_peirce_bracket_orthogonal Q Q P P X Y hQP hPQ
  have hPR₁ := kkt_peirce_bracket_orthogonal P P R R X Y hPR hRP
  have hRP₁ := kkt_peirce_bracket_orthogonal R R P P X Y hRP hPR
  have hQR₁ := kkt_peirce_bracket_orthogonal Q Q R R X Y hQR hRQ
  have hRQ₁ := kkt_peirce_bracket_orthogonal R R Q Q X Y hRQ hQR
  simp only [kkt_comm_add_left, kkt_comm_add_right,
    hPQ₁, hQP₁, hPR₁, hRP₁, hQR₁, hRQ₁, add_zero, zero_add]

/-- The mixed bracket between the `+1` and `-1` Peirce sectors is a sum of
diagonal blocks when the middle support `R` is orthogonal to `P` and `Q`. -/
theorem kkt_mixed_peirce_grade_bracket (P Q R X Y : B)
    (hP : P * P = P) (hQ : Q * Q = Q) (hR : R * R = R)
    (hPR : P * R = 0) (hRP : R * P = 0)
    (hQR : Q * R = 0) (hRQ : R * Q = 0) :
    comm (P * X * R + R * X * Q) (R * Y * P + Q * Y * R) =
      (P * X * R * Y * P - R * Y * P * X * R) +
      (R * X * Q * Y * R - Q * Y * R * X * Q) := by
  have hPR_QR := kkt_peirce_bracket_orthogonal P R Q R X Y hRQ hRP
  have hRQ_RP := kkt_peirce_bracket_orthogonal R Q R P X Y hQR hPR
  have hPR_RP : comm (P * X * R) (R * Y * P) =
      P * X * R * Y * P - R * Y * P * X * R := by
    dsimp [comm]
    have h₁ : (P * X * R) * (R * Y * P) = P * X * R * Y * P := by
      calc (P * X * R) * (R * Y * P)
          = (P * X) * (R * R) * (Y * P) := by noncomm_ring
        _ = P * X * R * Y * P := by rw [hR]; noncomm_ring
    have h₂ : (R * Y * P) * (P * X * R) = R * Y * P * X * R := by
      calc (R * Y * P) * (P * X * R)
          = (R * Y) * (P * P) * (X * R) := by noncomm_ring
        _ = R * Y * P * X * R := by rw [hP]; noncomm_ring
    rw [h₁, h₂]
  have hRQ_QR : comm (R * X * Q) (Q * Y * R) =
      R * X * Q * Y * R - Q * Y * R * X * Q := by
    dsimp [comm]
    have h₁ : (R * X * Q) * (Q * Y * R) = R * X * Q * Y * R := by
      calc (R * X * Q) * (Q * Y * R)
          = (R * X) * (Q * Q) * (Y * R) := by noncomm_ring
        _ = R * X * Q * Y * R := by rw [hQ]; noncomm_ring
    have h₂ : (Q * Y * R) * (R * X * Q) = Q * Y * R * X * Q := by
      calc (Q * Y * R) * (R * X * Q)
          = (Q * Y) * (R * R) * (X * Q) := by noncomm_ring
        _ = Q * Y * R * X * Q := by rw [hR]; noncomm_ring
    rw [h₁, h₂]
  calc comm (P * X * R + R * X * Q) (R * Y * P + Q * Y * R)
      = (comm (P * X * R) (R * Y * P) +
          comm (P * X * R) (Q * Y * R)) +
        (comm (R * X * Q) (R * Y * P) +
          comm (R * X * Q) (Q * Y * R)) := by
            simp only [kkt_comm_add_left, kkt_comm_add_right]
            abel
    _ = (P * X * R * Y * P - R * Y * P * X * R) +
        (R * X * Q * Y * R - Q * Y * R * X * Q) := by
          rw [hPR_RP, hPR_QR, hRQ_RP, hRQ_QR]
          simp

/-- The top Peirce grade brackets trivially with the adjacent positive grade. -/
theorem kkt_plus_two_plus_one_bracket_zero (P Q R X Y : B)
    (hQP : Q * P = 0) (hRP : R * P = 0)
    (hQR : Q * R = 0) :
    comm (P * X * Q) (P * Y * R + R * Y * Q) = 0 := by
  rw [kkt_comm_add_right,
    kkt_peirce_bracket_orthogonal P Q P R X Y hQP hRP,
    kkt_peirce_bracket_orthogonal P Q R Q X Y hQR hQP,
    add_zero]

/-- The bottom Peirce grade brackets trivially with the adjacent negative grade. -/
theorem kkt_minus_two_minus_one_bracket_zero (P Q R X Y : B)
    (hPQ : P * Q = 0) (hPR : P * R = 0)
    (hRQ : R * Q = 0) :
    comm (Q * X * P) (R * Y * P + Q * Y * R) = 0 := by
  rw [kkt_comm_add_right,
    kkt_peirce_bracket_orthogonal Q P R P X Y hPR hPQ,
    kkt_peirce_bracket_orthogonal Q P Q R X Y hPQ hRQ,
    add_zero]

end RingHelpers

/-!
## 3. 5-Graded Kantor–Koecher–Tits Lie Algebra Theorems (`KKT₁`–`KKT₁₀`)
-/

variable {B : Type u} [Ring B] [StarRing B]

/-- Negative extremal Jordan triple sandwich `G_{-2}(N_+, X) := N_- X N_-`. -/
def G_minus2 (N_plus X : B) : B := star N_plus * X * star N_plus

/-- Negative extremal Jordan associator generator `K_{-2}(N_+, X) := JordanAssoc(X, N_-, N_-)`. -/
def K_minus2 (N_plus X : B) : B := JordanAssoc X (star N_plus) (star N_plus)

/-- Left odd Grade `+1` carrier `G_{+1}^L(N_+, X) := N_+ X (1 - Gap(N_+))`. -/
def G_plus1_L (N_plus X : B) : B := N_plus * X * (1 - Gap N_plus)

/-- Right odd Grade `+1` carrier `G_{+1}^R(N_+, X) := (1 - Gap(N_+)) X N_+`. -/
def G_plus1_R (N_plus X : B) : B := (1 - Gap N_plus) * X * N_plus

/-- Left odd Grade `-1` carrier `G_{-1}^L(N_+, X) := N_- X (1 - Gap(N_+))`. -/
def G_minus1_L (N_plus X : B) : B := star N_plus * X * (1 - Gap N_plus)

/-- Right odd Grade `-1` carrier `G_{-1}^R(N_+, X) := (1 - Gap(N_+)) X N_-`. -/
def G_minus1_R (N_plus X : B) : B := (1 - Gap N_plus) * X * star N_plus

/-- The full Peirce grade `+1`, combining its two matrix blocks. -/
def G_plus1 (N_plus X : B) : B := G_plus1_L N_plus X + G_plus1_R N_plus X

/-- The full Peirce grade `-1`, combining its two matrix blocks. -/
def G_minus1 (N_plus X : B) : B := G_minus1_L N_plus X + G_minus1_R N_plus X

/-- Grade `0` positive sheet diagonal carrier `G_0^P(N_+, X) := P(N_+) X P(N_+)`. -/
def G_0_P (N_plus X : B) : B := P N_plus * X * P N_plus

/-- Grade `0` negative sheet diagonal carrier `G_0^Q(N_+, X) := Q(N_+) X Q(N_+)`. -/
def G_0_Q (N_plus X : B) : B := Q N_plus * X * Q N_plus

/-- Grade `0` neutral Peirce complement carrier
`G_0^0(N_+, X) := (1 - Gap(N_+)) X (1 - Gap(N_+))`. -/
def G_0_neutral (N_plus X : B) : B := (1 - Gap N_plus) * X * (1 - Gap N_plus)

/-! ### Explicit Peirce sectors of the whole algebra -/

def peirceR (N_plus : B) : B := 1 - Gap N_plus

def peircePP (N_plus X : B) : B := P N_plus * X * P N_plus
def peircePQ (N_plus X : B) : B := P N_plus * X * Q N_plus
def peircePR (N_plus X : B) : B := P N_plus * X * peirceR N_plus
def peirceQP (N_plus X : B) : B := Q N_plus * X * P N_plus
def peirceQQ (N_plus X : B) : B := Q N_plus * X * Q N_plus
def peirceQR (N_plus X : B) : B := Q N_plus * X * peirceR N_plus
def peirceRP (N_plus X : B) : B := peirceR N_plus * X * P N_plus
def peirceRQ (N_plus X : B) : B := peirceR N_plus * X * Q N_plus
def peirceRR (N_plus X : B) : B := peirceR N_plus * X * peirceR N_plus

def peirceGradePlus2 (N_plus X : B) : B := peircePQ N_plus X
def peirceGradePlus1 (N_plus X : B) : B := peircePR N_plus X + peirceRQ N_plus X
def peirceGradeZero (N_plus X : B) : B :=
  peircePP N_plus X + peirceQQ N_plus X + peirceRR N_plus X
def peirceGradeMinus1 (N_plus X : B) : B := peirceRP N_plus X + peirceQR N_plus X
def peirceGradeMinus2 (N_plus X : B) : B := peirceQP N_plus X

/-- The range of an additive projection, packaged as a native mathlib
additive subgroup. -/
def peirceRangeAddSubgroup (f : B → B)
    (hzero : f 0 = 0)
    (hadd : ∀ X Y, f (X + Y) = f X + f Y)
    (hneg : ∀ X, f (-X) = -f X) : AddSubgroup B where
  carrier := Set.range f
  zero_mem' := ⟨0, hzero⟩
  add_mem' := by
    rintro a b ⟨X, rfl⟩ ⟨Y, rfl⟩
    exact ⟨X + Y, hadd X Y⟩
  neg_mem' := by
    rintro a ⟨X, rfl⟩
    exact ⟨-X, hneg X⟩

private theorem peirceGradePlus2_zero (N_plus : B) :
    peirceGradePlus2 N_plus 0 = 0 := by
  simp [peirceGradePlus2, peircePQ]

private theorem peirceGradePlus2_add (N_plus X Y : B) :
    peirceGradePlus2 N_plus (X + Y) =
      peirceGradePlus2 N_plus X + peirceGradePlus2 N_plus Y := by
  simp only [peirceGradePlus2, peircePQ]
  noncomm_ring

private theorem peirceGradePlus2_neg (N_plus X : B) :
    peirceGradePlus2 N_plus (-X) = -peirceGradePlus2 N_plus X := by
  simp only [peirceGradePlus2, peircePQ]
  noncomm_ring

private theorem peirceGradePlus1_zero (N_plus : B) :
    peirceGradePlus1 N_plus 0 = 0 := by
  simp [peirceGradePlus1, peircePR, peirceRQ]

private theorem peirceGradePlus1_add (N_plus X Y : B) :
    peirceGradePlus1 N_plus (X + Y) =
      peirceGradePlus1 N_plus X + peirceGradePlus1 N_plus Y := by
  simp only [peirceGradePlus1, peircePR, peirceRQ]
  noncomm_ring

private theorem peirceGradePlus1_neg (N_plus X : B) :
    peirceGradePlus1 N_plus (-X) = -peirceGradePlus1 N_plus X := by
  simp only [peirceGradePlus1, peircePR, peirceRQ]
  noncomm_ring

private theorem peirceGradeZero_zero (N_plus : B) :
    peirceGradeZero N_plus 0 = 0 := by
  simp [peirceGradeZero, peircePP, peirceQQ, peirceRR]

private theorem peirceGradeZero_add (N_plus X Y : B) :
    peirceGradeZero N_plus (X + Y) =
      peirceGradeZero N_plus X + peirceGradeZero N_plus Y := by
  simp only [peirceGradeZero, peircePP, peirceQQ, peirceRR]
  noncomm_ring

private theorem peirceGradeZero_neg (N_plus X : B) :
    peirceGradeZero N_plus (-X) = -peirceGradeZero N_plus X := by
  simp only [peirceGradeZero, peircePP, peirceQQ, peirceRR]
  noncomm_ring

private theorem peirceGradeMinus1_zero (N_plus : B) :
    peirceGradeMinus1 N_plus 0 = 0 := by
  simp [peirceGradeMinus1, peirceRP, peirceQR]

private theorem peirceGradeMinus1_add (N_plus X Y : B) :
    peirceGradeMinus1 N_plus (X + Y) =
      peirceGradeMinus1 N_plus X + peirceGradeMinus1 N_plus Y := by
  simp only [peirceGradeMinus1, peirceRP, peirceQR]
  noncomm_ring

private theorem peirceGradeMinus1_neg (N_plus X : B) :
    peirceGradeMinus1 N_plus (-X) = -peirceGradeMinus1 N_plus X := by
  simp only [peirceGradeMinus1, peirceRP, peirceQR]
  noncomm_ring

private theorem peirceGradeMinus2_zero (N_plus : B) :
    peirceGradeMinus2 N_plus 0 = 0 := by
  simp [peirceGradeMinus2, peirceQP]

private theorem peirceGradeMinus2_add (N_plus X Y : B) :
    peirceGradeMinus2 N_plus (X + Y) =
      peirceGradeMinus2 N_plus X + peirceGradeMinus2 N_plus Y := by
  simp only [peirceGradeMinus2, peirceQP]
  noncomm_ring

private theorem peirceGradeMinus2_neg (N_plus X : B) :
    peirceGradeMinus2 N_plus (-X) = -peirceGradeMinus2 N_plus X := by
  simp only [peirceGradeMinus2, peirceQP]
  noncomm_ring

/-- Native additive subgroup consisting of the canonical grade `+2` Peirce
components. -/
def peirceGradePlus2Subgroup (N_plus : B) : AddSubgroup B :=
  peirceRangeAddSubgroup (peirceGradePlus2 N_plus)
    (peirceGradePlus2_zero N_plus) (peirceGradePlus2_add N_plus)
    (peirceGradePlus2_neg N_plus)

/-- Native additive subgroup consisting of the canonical grade `+1` Peirce
components. -/
def peirceGradePlus1Subgroup (N_plus : B) : AddSubgroup B :=
  peirceRangeAddSubgroup (peirceGradePlus1 N_plus)
    (peirceGradePlus1_zero N_plus) (peirceGradePlus1_add N_plus)
    (peirceGradePlus1_neg N_plus)

/-- Native additive subgroup consisting of the canonical grade-zero Peirce
components. -/
def peirceGradeZeroSubgroup (N_plus : B) : AddSubgroup B :=
  peirceRangeAddSubgroup (peirceGradeZero N_plus)
    (peirceGradeZero_zero N_plus) (peirceGradeZero_add N_plus)
    (peirceGradeZero_neg N_plus)

/-- Native additive subgroup consisting of the canonical grade `-1` Peirce
components. -/
def peirceGradeMinus1Subgroup (N_plus : B) : AddSubgroup B :=
  peirceRangeAddSubgroup (peirceGradeMinus1 N_plus)
    (peirceGradeMinus1_zero N_plus) (peirceGradeMinus1_add N_plus)
    (peirceGradeMinus1_neg N_plus)

/-- Native additive subgroup consisting of the canonical grade `-2` Peirce
components. -/
def peirceGradeMinus2Subgroup (N_plus : B) : AddSubgroup B :=
  peirceRangeAddSubgroup (peirceGradeMinus2 N_plus)
    (peirceGradeMinus2_zero N_plus) (peirceGradeMinus2_add N_plus)
    (peirceGradeMinus2_neg N_plus)

/-- The additive subgroup generated by the five canonical Peirce-grade ranges. -/
def peirceFiveGradeSpan (N_plus : B) : AddSubgroup B :=
  peirceGradePlus2Subgroup N_plus ⊔ peirceGradePlus1Subgroup N_plus ⊔
    peirceGradeZeroSubgroup N_plus ⊔ peirceGradeMinus1Subgroup N_plus ⊔
    peirceGradeMinus2Subgroup N_plus

/-- The nilpotent sandwich parametrization reaches every Peirce grade `+2` block. -/
theorem G_plus2_preimage_peirce (N_plus X : B) :
    G_plus2 N_plus (star N_plus * X * star N_plus) = peirceGradePlus2 N_plus X := by
  dsimp [G_plus2, peirceGradePlus2, peircePQ, P, Q]
  noncomm_ring

/-- The adjoint nilpotent sandwich parametrization reaches every Peirce grade `-2` block. -/
theorem G_minus2_preimage_peirce (N_plus X : B) :
    G_minus2 N_plus (N_plus * X * N_plus) = peirceGradeMinus2 N_plus X := by
  dsimp [G_minus2, peirceGradeMinus2, peirceQP, P, Q]
  noncomm_ring

/-- The associator-generated extremal operators cover the complete Peirce `±2`
sectors, with the conventional factor of two from the unnormalized Jordan associator. -/
theorem K_extremals_cover_peirce_grades (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) :
    K_plus2 N_plus (star N_plus * X * star N_plus) =
        (2 : ℕ) • peirceGradePlus2 N_plus X ∧
    K_minus2 N_plus (N_plus * X * N_plus) =
        (2 : ℕ) • peirceGradeMinus2 N_plus X := by
  constructor
  · change JordanAssoc (star N_plus * X * star N_plus) N_plus N_plus = _
    rw [kkt_jordan_assoc_eq_two_sandwich N_plus
      (star N_plus * X * star N_plus) h_nil]
    have hpre := G_plus2_preimage_peirce N_plus X
    change (2 : ℕ) • G_plus2 N_plus (star N_plus * X * star N_plus) = _
    rw [hpre]
  · change JordanAssoc (N_plus * X * N_plus) (star N_plus) (star N_plus) = _
    rw [kkt_jordan_assoc_eq_two_sandwich (star N_plus)
      (N_plus * X * N_plus) (star_N_plus_sq N_plus h_nil)]
    have hpre := G_minus2_preimage_peirce N_plus X
    change (2 : ℕ) • G_minus2 N_plus (N_plus * X * N_plus) = _
    rw [hpre]

/-- The nilpotent pairing's support is the sum of its two Peirce idempotents. -/
theorem Gap_eq_P_add_Q (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Gap N_plus = P N_plus + Q N_plus := by
  rw [Gap_eq_anticomm N_plus h_nil h_reg]
  rfl

/-- The two chiral supports are orthogonal to the complementary Peirce support
on both sides. -/
theorem peirce_chiral_neutral_orthogonal (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    (P N_plus * peirceR N_plus = 0) ∧
    (peirceR N_plus * P N_plus = 0) ∧
    (Q N_plus * peirceR N_plus = 0) ∧
    (peirceR N_plus * Q N_plus = 0) := by
  have hP2 : P N_plus * P N_plus = P N_plus :=
    YangMillsVortexPoset.P_idem N_plus h_reg
  have hQ2 : Q N_plus * Q N_plus = Q N_plus :=
    YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 :=
    YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 :=
    YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hPG : P N_plus * Gap N_plus = P N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, mul_add, hP2, hPQ]
    exact add_zero _
  have hGP : Gap N_plus * P N_plus = P N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, add_mul, hP2, hQP]
    exact add_zero _
  have hQG : Q N_plus * Gap N_plus = Q N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, mul_add, hQP, hQ2]
    exact zero_add _
  have hGQ : Gap N_plus * Q N_plus = Q N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, add_mul, hPQ, hQ2]
    exact zero_add _
  constructor
  · dsimp [peirceR]
    rw [mul_sub, mul_one, hPG, sub_self]
  constructor
  · dsimp [peirceR]
    rw [sub_mul, one_mul, hGP, sub_self]
  constructor
  · dsimp [peirceR]
    rw [mul_sub, mul_one, hQG, sub_self]
  · dsimp [peirceR]
    rw [sub_mul, one_mul, hGQ, sub_self]

/-- The three diagonal support pieces `P`, `Q`, and `1 - Gap` sum to the ambient
identity; here `1` is the ring unit required by this unital Peirce decomposition. -/
theorem peirce_idempotents_sum_one (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    P N_plus + Q N_plus + peirceR N_plus = 1 := by
  rw [peirceR, Gap_eq_P_add_Q N_plus h_nil h_reg]
  noncomm_ring

/-- Every element has the full nine-block Peirce decomposition induced by the two
chiral supports and their complementary support. -/
theorem peirce_nine_block_decomposition (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    X = peircePP N_plus X + peircePQ N_plus X + peircePR N_plus X +
      peirceQP N_plus X + peirceQQ N_plus X + peirceQR N_plus X +
      peirceRP N_plus X + peirceRQ N_plus X + peirceRR N_plus X := by
  have hsum := peirce_idempotents_sum_one N_plus h_nil h_reg
  calc X = 1 * X * 1 := by noncomm_ring
    _ = (P N_plus + Q N_plus + peirceR N_plus) * X *
        (P N_plus + Q N_plus + peirceR N_plus) := by rw [hsum]
    _ = peircePP N_plus X + peircePQ N_plus X + peircePR N_plus X +
        peirceQP N_plus X + peirceQQ N_plus X + peirceQR N_plus X +
        peirceRP N_plus X + peirceRQ N_plus X + peirceRR N_plus X := by
          simp only [peircePP, peircePQ, peircePR, peirceQP, peirceQQ, peirceQR,
            peirceRP, peirceRQ, peirceRR, peirceR]
          noncomm_ring

/-- Grouping the nine Peirce blocks by the eigenvalue difference of their left and
right support produces grades `+2,+1,0,-1,-2`. -/
theorem peirce_five_grade_decomposition (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
      peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
      peirceGradeMinus2 N_plus X := by
  calc X = peircePP N_plus X + peircePQ N_plus X + peircePR N_plus X +
      peirceQP N_plus X + peirceQQ N_plus X + peirceQR N_plus X +
      peirceRP N_plus X + peirceRQ N_plus X + peirceRR N_plus X :=
        peirce_nine_block_decomposition N_plus X h_nil h_reg
    _ = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
        peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
        peirceGradeMinus2 N_plus X := by
          simp only [peirceGradePlus2, peirceGradePlus1, peirceGradeZero,
            peirceGradeMinus1, peirceGradeMinus2]
          abel

/-- Every canonical Peirce component belongs to its native additive subgroup,
and the five subgroup-valued components reconstruct the operator. -/
theorem peirce_five_grade_subgroup_decomposition (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceGradePlus2 N_plus X ∈ peirceGradePlus2Subgroup N_plus ∧
    peirceGradePlus1 N_plus X ∈ peirceGradePlus1Subgroup N_plus ∧
    peirceGradeZero N_plus X ∈ peirceGradeZeroSubgroup N_plus ∧
    peirceGradeMinus1 N_plus X ∈ peirceGradeMinus1Subgroup N_plus ∧
    peirceGradeMinus2 N_plus X ∈ peirceGradeMinus2Subgroup N_plus ∧
    X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
      peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
      peirceGradeMinus2 N_plus X := by
  refine ⟨⟨X, rfl⟩, ⟨X, rfl⟩, ⟨X, rfl⟩, ⟨X, rfl⟩, ⟨X, rfl⟩,
    peirce_five_grade_decomposition N_plus X h_nil h_reg⟩

/-- The five native additive subgroups span the entire ambient ring additively. -/
theorem peirceFiveGradeSpan_eq_top (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceFiveGradeSpan N_plus = ⊤ := by
  apply top_unique
  intro X _
  rcases peirce_five_grade_subgroup_decomposition N_plus X h_nil h_reg with
    ⟨h2, h1, h0, hm1, hm2, hsum⟩
  change X ∈ peirceGradePlus2Subgroup N_plus ⊔
    peirceGradePlus1Subgroup N_plus ⊔ peirceGradeZeroSubgroup N_plus ⊔
    peirceGradeMinus1Subgroup N_plus ⊔ peirceGradeMinus2Subgroup N_plus
  rw [AddSubgroup.mem_sup]
  refine ⟨peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
      peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X, ?_,
    peirceGradeMinus2 N_plus X, hm2, ?_⟩
  · rw [AddSubgroup.mem_sup]
    refine ⟨peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
        peirceGradeZero N_plus X, ?_, peirceGradeMinus1 N_plus X, hm1, ?_⟩
    · rw [AddSubgroup.mem_sup]
      refine ⟨peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X, ?_,
        peirceGradeZero N_plus X, h0, ?_⟩
      · rw [AddSubgroup.mem_sup]
        exact ⟨peirceGradePlus2 N_plus X, h2,
          peirceGradePlus1 N_plus X, h1, rfl⟩
      · rfl
    · rfl
  · calc
      peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
          peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
          peirceGradeMinus2 N_plus X =
        peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
          peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
          peirceGradeMinus2 N_plus X := rfl
      _ = X := hsum.symm

/-- The extremal Peirce corners are disjoint: a grade `+2` component cannot
equal a grade `-2` component unless both vanish. -/
theorem peirce_extremal_grade_intersection_zero (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (h_eq : peirceGradePlus2 N_plus X = peirceGradeMinus2 N_plus Y) :
    peirceGradePlus2 N_plus X = 0 := by
  have hP2 : P N_plus * P N_plus = P N_plus :=
    YangMillsVortexPoset.P_idem N_plus h_reg
  have hQ2 : Q N_plus * Q N_plus = Q N_plus :=
    YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 :=
    YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 :=
    YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hfix : P N_plus * peirceGradePlus2 N_plus X * Q N_plus =
      peirceGradePlus2 N_plus X := by
    dsimp [peirceGradePlus2, peircePQ]
    calc P N_plus * (P N_plus * X * Q N_plus) * Q N_plus
        = (P N_plus * P N_plus) * X * (Q N_plus * Q N_plus) := by noncomm_ring
      _ = P N_plus * X * Q N_plus := by rw [hP2, hQ2]
  have hkill : P N_plus * peirceGradeMinus2 N_plus Y * Q N_plus = 0 := by
    dsimp [peirceGradeMinus2, peirceQP]
    calc P N_plus * (Q N_plus * Y * P N_plus) * Q N_plus
        = (P N_plus * Q N_plus) * Y * (P N_plus * Q N_plus) := by noncomm_ring
      _ = 0 := by rw [hPQ, zero_mul, zero_mul]
  calc peirceGradePlus2 N_plus X
      = P N_plus * peirceGradePlus2 N_plus X * Q N_plus := hfix.symm
    _ = P N_plus * peirceGradeMinus2 N_plus Y * Q N_plus := by rw [h_eq]
    _ = 0 := hkill

/-- The native additive subgroups of the two extremal Peirce grades have zero
intersection. -/
theorem peirce_extremal_subgroups_inf_eq_bot (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceGradePlus2Subgroup N_plus ⊓ peirceGradeMinus2Subgroup N_plus = ⊥ := by
  apply SetLike.ext
  intro x
  change (x ∈ peirceGradePlus2Subgroup N_plus ∧
    x ∈ peirceGradeMinus2Subgroup N_plus) ↔ x = 0
  constructor
  · rintro ⟨hplus, hminus⟩
    change x ∈ Set.range (peirceGradePlus2 N_plus) at hplus
    change x ∈ Set.range (peirceGradeMinus2 N_plus) at hminus
    obtain ⟨X, hX⟩ := hplus
    obtain ⟨Y, hY⟩ := hminus
    have hXY : peirceGradePlus2 N_plus X = peirceGradeMinus2 N_plus Y :=
      hX.trans hY.symm
    have hzero := peirce_extremal_grade_intersection_zero
      N_plus X Y h_nil h_reg hXY
    calc x = peirceGradePlus2 N_plus X := hX.symm
      _ = 0 := hzero
  · rintro rfl
    exact ⟨(peirceGradePlus2Subgroup N_plus).zero_mem,
      (peirceGradeMinus2Subgroup N_plus).zero_mem⟩

/-- The five grouped Peirce components jointly determine the operator. Thus the
canonical five-sector reconstruction is unique as a decomposition induced by
the Peirce projections (without asserting that abstract adjoint eigenspaces
have distinct eigenvalues over every base ring). -/
theorem peirce_five_grade_components_injective (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (h2 : peirceGradePlus2 N_plus X = peirceGradePlus2 N_plus Y)
    (h1 : peirceGradePlus1 N_plus X = peirceGradePlus1 N_plus Y)
    (h0 : peirceGradeZero N_plus X = peirceGradeZero N_plus Y)
    (hm1 : peirceGradeMinus1 N_plus X = peirceGradeMinus1 N_plus Y)
    (hm2 : peirceGradeMinus2 N_plus X = peirceGradeMinus2 N_plus Y) :
    X = Y := by
  rw [peirce_five_grade_decomposition N_plus X h_nil h_reg,
      peirce_five_grade_decomposition N_plus Y h_nil h_reg,
      h2, h1, h0, hm1, hm2]

omit [StarRing B] in
/-- Associativity-only rule for composing two Peirce corners. -/
private theorem peirce_corner_comp (A C D E X : B) :
    A * (C * X * D) * E = (A * C) * X * (D * E) := by
  noncomm_ring

/-- The grade `+2` projection annihilates every other canonical Peirce grade. -/
theorem peirceGradePlus2_comp_other (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceGradePlus2 N_plus (peirceGradePlus1 N_plus X) = 0 ∧
    peirceGradePlus2 N_plus (peirceGradeZero N_plus X) = 0 ∧
    peirceGradePlus2 N_plus (peirceGradeMinus1 N_plus X) = 0 ∧
    peirceGradePlus2 N_plus (peirceGradeMinus2 N_plus X) = 0 := by
  have hPP : P N_plus * P N_plus = P N_plus := YangMillsVortexPoset.P_idem N_plus h_reg
  have hQQ : Q N_plus * Q N_plus = Q N_plus := YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 := YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 := YangMillsVortexPoset.Q_mul_P N_plus h_nil
  rcases peirce_chiral_neutral_orthogonal N_plus h_nil h_reg with
    ⟨hPR, hRP, hQR, hRQ⟩
  have h1 : peirceGradePlus2 N_plus (peirceGradePlus1 N_plus X) = 0 := by
    dsimp [peirceGradePlus2, peircePQ, peirceGradePlus1, peircePR, peirceRQ]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPR, hRQ]
  have h0 : peirceGradePlus2 N_plus (peirceGradeZero N_plus X) = 0 := by
    dsimp [peirceGradePlus2, peircePQ, peirceGradeZero, peircePP, peirceQQ,
      peirceRR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPQ, hPR, hRQ]
  have hm1 : peirceGradePlus2 N_plus (peirceGradeMinus1 N_plus X) = 0 := by
    dsimp [peirceGradePlus2, peircePQ, peirceGradeMinus1, peirceRP, peirceQR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPQ, hPR]
  have hm2 : peirceGradePlus2 N_plus (peirceGradeMinus2 N_plus X) = 0 := by
    dsimp [peirceGradePlus2, peircePQ, peirceGradeMinus2, peirceQP]
    rw [peirce_corner_comp]
    simp [hPQ]
  exact ⟨h1, h0, hm1, hm2⟩

/-- In a zero-sum relation among canonical grade outputs, the grade `+2`
component vanishes. This is a corner-projection component of directness. -/
theorem peirce_five_grade_sum_zero_plus2 (N_plus X₂ X₁ X₀ Xm₁ Xm₂ : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (hsum : peirceGradePlus2 N_plus X₂ + peirceGradePlus1 N_plus X₁ +
      peirceGradeZero N_plus X₀ + peirceGradeMinus1 N_plus Xm₁ +
      peirceGradeMinus2 N_plus Xm₂ = 0) :
    peirceGradePlus2 N_plus X₂ = 0 := by
  have hself : peirceGradePlus2 N_plus (peirceGradePlus2 N_plus X₂) =
      peirceGradePlus2 N_plus X₂ := by
    have hPP : P N_plus * P N_plus = P N_plus := YangMillsVortexPoset.P_idem N_plus h_reg
    have hQQ : Q N_plus * Q N_plus = Q N_plus := YangMillsVortexPoset.Q_idem N_plus h_reg
    dsimp [peirceGradePlus2, peircePQ]
    rw [peirce_corner_comp, hPP, hQQ]
  rcases peirceGradePlus2_comp_other N_plus X₁ h_nil h_reg with ⟨h1, _, _, _⟩
  rcases peirceGradePlus2_comp_other N_plus X₀ h_nil h_reg with ⟨_, h0, _, _⟩
  rcases peirceGradePlus2_comp_other N_plus Xm₁ h_nil h_reg with ⟨_, _, hm1, _⟩
  rcases peirceGradePlus2_comp_other N_plus Xm₂ h_nil h_reg with ⟨_, _, _, hm2⟩
  have hproject := congrArg (peirceGradePlus2 N_plus) hsum
  simp only [peirceGradePlus2_add, hself, h1, h0, hm1, hm2] at hproject
  simp only [peirceGradePlus2_zero, add_zero] at hproject
  exact hproject

/-- The grade `+1` projection preserves its own Peirce sector and annihilates
the other four canonical sectors. -/
theorem peirceGradePlus1_comp_filter (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceGradePlus1 N_plus (peirceGradePlus2 N_plus X) = 0 ∧
    peirceGradePlus1 N_plus (peirceGradePlus1 N_plus X) =
      peirceGradePlus1 N_plus X ∧
    peirceGradePlus1 N_plus (peirceGradeZero N_plus X) = 0 ∧
    peirceGradePlus1 N_plus (peirceGradeMinus1 N_plus X) = 0 ∧
    peirceGradePlus1 N_plus (peirceGradeMinus2 N_plus X) = 0 := by
  have hPP : P N_plus * P N_plus = P N_plus := YangMillsVortexPoset.P_idem N_plus h_reg
  have hQQ : Q N_plus * Q N_plus = Q N_plus := YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 := YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 := YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hRR : peirceR N_plus * peirceR N_plus = peirceR N_plus := by
    have hGap := Gap_idem N_plus h_nil h_reg
    dsimp [peirceR]
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap, sub_self, sub_zero]
  rcases peirce_chiral_neutral_orthogonal N_plus h_nil h_reg with
    ⟨hPR, hRP, hQR, hRQ⟩
  have h2 : peirceGradePlus1 N_plus (peirceGradePlus2 N_plus X) = 0 := by
    dsimp [peirceGradePlus1, peircePR, peirceRQ, peirceGradePlus2, peircePQ]
    simp only [peirce_corner_comp]
    simp [hRP, hQR]
  have h1 : peirceGradePlus1 N_plus (peirceGradePlus1 N_plus X) =
      peirceGradePlus1 N_plus X := by
    dsimp [peirceGradePlus1, peircePR, peirceRQ]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPP, hQQ, hRR, hPR, hRP, hQR, hRQ]
  have h0 : peirceGradePlus1 N_plus (peirceGradeZero N_plus X) = 0 := by
    dsimp [peirceGradePlus1, peircePR, peirceRQ, peirceGradeZero,
      peircePP, peirceQQ, peirceRR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPP, hQQ, hRR, hPQ, hPR, hRP, hQR, hRQ]
  have hm1 : peirceGradePlus1 N_plus (peirceGradeMinus1 N_plus X) = 0 := by
    dsimp [peirceGradePlus1, peircePR, peirceRQ, peirceGradeMinus1,
      peirceRP, peirceQR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPQ, hPR, hRQ]
  have hm2 : peirceGradePlus1 N_plus (peirceGradeMinus2 N_plus X) = 0 := by
    dsimp [peirceGradePlus1, peircePR, peirceRQ, peirceGradeMinus2, peirceQP]
    simp only [peirce_corner_comp]
    simp [hPQ, hRQ]
  exact ⟨h2, h1, h0, hm1, hm2⟩

/-- In a zero-sum relation among canonical grade outputs, the grade `+1`
component vanishes. -/
theorem peirce_five_grade_sum_zero_plus1 (N_plus X₂ X₁ X₀ Xm₁ Xm₂ : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (hsum : peirceGradePlus2 N_plus X₂ + peirceGradePlus1 N_plus X₁ +
      peirceGradeZero N_plus X₀ + peirceGradeMinus1 N_plus Xm₁ +
      peirceGradeMinus2 N_plus Xm₂ = 0) :
    peirceGradePlus1 N_plus X₁ = 0 := by
  rcases peirceGradePlus1_comp_filter N_plus X₂ h_nil h_reg with ⟨h2, _, _, _, _⟩
  rcases peirceGradePlus1_comp_filter N_plus X₁ h_nil h_reg with ⟨_, hself, _, _, _⟩
  rcases peirceGradePlus1_comp_filter N_plus X₀ h_nil h_reg with ⟨_, _, h0, _, _⟩
  rcases peirceGradePlus1_comp_filter N_plus Xm₁ h_nil h_reg with ⟨_, _, _, hm1, _⟩
  rcases peirceGradePlus1_comp_filter N_plus Xm₂ h_nil h_reg with ⟨_, _, _, _, hm2⟩
  have hproject := congrArg (peirceGradePlus1 N_plus) hsum
  simp only [peirceGradePlus1_add, h2, hself, h0, hm1, hm2] at hproject
  simp only [peirceGradePlus1_zero, add_zero, zero_add] at hproject
  exact hproject

/-- The grade-zero projection preserves its diagonal sector and annihilates
the four off-diagonal grades. -/
theorem peirceGradeZero_comp_filter (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceGradeZero N_plus (peirceGradePlus2 N_plus X) = 0 ∧
    peirceGradeZero N_plus (peirceGradePlus1 N_plus X) = 0 ∧
    peirceGradeZero N_plus (peirceGradeZero N_plus X) =
      peirceGradeZero N_plus X ∧
    peirceGradeZero N_plus (peirceGradeMinus1 N_plus X) = 0 ∧
    peirceGradeZero N_plus (peirceGradeMinus2 N_plus X) = 0 := by
  have hPP : P N_plus * P N_plus = P N_plus := YangMillsVortexPoset.P_idem N_plus h_reg
  have hQQ : Q N_plus * Q N_plus = Q N_plus := YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 := YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 := YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hRR : peirceR N_plus * peirceR N_plus = peirceR N_plus := by
    have hGap := Gap_idem N_plus h_nil h_reg
    dsimp [peirceR]
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap, sub_self, sub_zero]
  rcases peirce_chiral_neutral_orthogonal N_plus h_nil h_reg with
    ⟨hPR, hRP, hQR, hRQ⟩
  have h2 : peirceGradeZero N_plus (peirceGradePlus2 N_plus X) = 0 := by
    dsimp [peirceGradeZero, peircePP, peirceQQ, peirceRR,
      peirceGradePlus2, peircePQ]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPQ, hQP, hPR, hQR, hRQ]
  have h1 : peirceGradeZero N_plus (peirceGradePlus1 N_plus X) = 0 := by
    dsimp [peirceGradeZero, peircePP, peirceQQ, peirceRR,
      peirceGradePlus1, peircePR, peirceRQ]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPQ, hQP, hPR, hRP, hQR, hRQ]
  have h0 : peirceGradeZero N_plus (peirceGradeZero N_plus X) =
      peirceGradeZero N_plus X := by
    dsimp [peirceGradeZero, peircePP, peirceQQ, peirceRR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPP, hQQ, hRR, hPQ, hQP, hPR, hRP, hQR, hRQ]
  have hm1 : peirceGradeZero N_plus (peirceGradeMinus1 N_plus X) = 0 := by
    dsimp [peirceGradeZero, peircePP, peirceQQ, peirceRR,
      peirceGradeMinus1, peirceRP, peirceQR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPQ, hQP, hPR, hRP, hQR, hRQ]
  have hm2 : peirceGradeZero N_plus (peirceGradeMinus2 N_plus X) = 0 := by
    dsimp [peirceGradeZero, peircePP, peirceQQ, peirceRR,
      peirceGradeMinus2, peirceQP]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPQ, hQP, hRP, hRQ]
  exact ⟨h2, h1, h0, hm1, hm2⟩

/-- In a zero-sum relation among canonical grade outputs, the grade `0`
component vanishes. -/
theorem peirce_five_grade_sum_zero_zero (N_plus X₂ X₁ X₀ Xm₁ Xm₂ : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (hsum : peirceGradePlus2 N_plus X₂ + peirceGradePlus1 N_plus X₁ +
      peirceGradeZero N_plus X₀ + peirceGradeMinus1 N_plus Xm₁ +
      peirceGradeMinus2 N_plus Xm₂ = 0) :
    peirceGradeZero N_plus X₀ = 0 := by
  rcases peirceGradeZero_comp_filter N_plus X₂ h_nil h_reg with ⟨h2, _, _, _, _⟩
  rcases peirceGradeZero_comp_filter N_plus X₁ h_nil h_reg with ⟨_, h1, _, _, _⟩
  rcases peirceGradeZero_comp_filter N_plus X₀ h_nil h_reg with ⟨_, _, hself, _, _⟩
  rcases peirceGradeZero_comp_filter N_plus Xm₁ h_nil h_reg with ⟨_, _, _, hm1, _⟩
  rcases peirceGradeZero_comp_filter N_plus Xm₂ h_nil h_reg with ⟨_, _, _, _, hm2⟩
  have hproject := congrArg (peirceGradeZero N_plus) hsum
  simp only [peirceGradeZero_add, h2, h1, hself, hm1, hm2] at hproject
  simp only [peirceGradeZero_zero, add_zero, zero_add] at hproject
  exact hproject

/- The opposite extremal corner gives a parallel filter. -/
theorem peirceGradeMinus2_comp_filter (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceGradeMinus2 N_plus (peirceGradePlus2 N_plus X) = 0 ∧
    peirceGradeMinus2 N_plus (peirceGradePlus1 N_plus X) = 0 ∧
    peirceGradeMinus2 N_plus (peirceGradeZero N_plus X) = 0 ∧
    peirceGradeMinus2 N_plus (peirceGradeMinus1 N_plus X) = 0 ∧
    peirceGradeMinus2 N_plus (peirceGradeMinus2 N_plus X) =
      peirceGradeMinus2 N_plus X := by
  have hPP : P N_plus * P N_plus = P N_plus := YangMillsVortexPoset.P_idem N_plus h_reg
  have hQQ : Q N_plus * Q N_plus = Q N_plus := YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 := YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 := YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hRR : peirceR N_plus * peirceR N_plus = peirceR N_plus := by
    have hGap := Gap_idem N_plus h_nil h_reg
    dsimp [peirceR]
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap, sub_self, sub_zero]
  rcases peirce_chiral_neutral_orthogonal N_plus h_nil h_reg with
    ⟨hPR, hRP, hQR, hRQ⟩
  have h2 : peirceGradeMinus2 N_plus (peirceGradePlus2 N_plus X) = 0 := by
    dsimp [peirceGradeMinus2, peirceQP, peirceGradePlus2, peircePQ]
    rw [peirce_corner_comp]
    simp [hQP]
  have h1 : peirceGradeMinus2 N_plus (peirceGradePlus1 N_plus X) = 0 := by
    dsimp [peirceGradeMinus2, peirceQP, peirceGradePlus1, peircePR, peirceRQ]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hQP, hQR]
  have h0 : peirceGradeMinus2 N_plus (peirceGradeZero N_plus X) = 0 := by
    dsimp [peirceGradeMinus2, peirceQP, peirceGradeZero, peircePP, peirceQQ,
      peirceRR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hQP, hQR]
  have hm1 : peirceGradeMinus2 N_plus (peirceGradeMinus1 N_plus X) = 0 := by
    dsimp [peirceGradeMinus2, peirceQP, peirceGradeMinus1, peirceRP, peirceQR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hQP, hQR, hRP]
  have hm2 : peirceGradeMinus2 N_plus (peirceGradeMinus2 N_plus X) =
      peirceGradeMinus2 N_plus X := by
    dsimp [peirceGradeMinus2, peirceQP]
    rw [peirce_corner_comp, hQQ, hPP]
  exact ⟨h2, h1, h0, hm1, hm2⟩

theorem peirce_five_grade_sum_zero_minus2 (N_plus X₂ X₁ X₀ Xm₁ Xm₂ : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (hsum : peirceGradePlus2 N_plus X₂ + peirceGradePlus1 N_plus X₁ +
      peirceGradeZero N_plus X₀ + peirceGradeMinus1 N_plus Xm₁ +
      peirceGradeMinus2 N_plus Xm₂ = 0) :
    peirceGradeMinus2 N_plus Xm₂ = 0 := by
  rcases peirceGradeMinus2_comp_filter N_plus X₂ h_nil h_reg with ⟨h2, _, _, _, _⟩
  rcases peirceGradeMinus2_comp_filter N_plus X₁ h_nil h_reg with ⟨_, h1, _, _, _⟩
  rcases peirceGradeMinus2_comp_filter N_plus X₀ h_nil h_reg with ⟨_, _, h0, _, _⟩
  rcases peirceGradeMinus2_comp_filter N_plus Xm₁ h_nil h_reg with ⟨_, _, _, hm1, _⟩
  rcases peirceGradeMinus2_comp_filter N_plus Xm₂ h_nil h_reg with ⟨_, _, _, _, hself⟩
  have hproject := congrArg (peirceGradeMinus2 N_plus) hsum
  simp only [peirceGradeMinus2_add, h2, h1, h0, hm1, hself] at hproject
  simp only [peirceGradeMinus2_zero, add_zero, zero_add] at hproject
  exact hproject

theorem peirceGradeMinus1_comp_filter (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceGradeMinus1 N_plus (peirceGradePlus2 N_plus X) = 0 ∧
    peirceGradeMinus1 N_plus (peirceGradePlus1 N_plus X) = 0 ∧
    peirceGradeMinus1 N_plus (peirceGradeZero N_plus X) = 0 ∧
    peirceGradeMinus1 N_plus (peirceGradeMinus1 N_plus X) =
      peirceGradeMinus1 N_plus X ∧
    peirceGradeMinus1 N_plus (peirceGradeMinus2 N_plus X) = 0 := by
  have hPP : P N_plus * P N_plus = P N_plus := YangMillsVortexPoset.P_idem N_plus h_reg
  have hQQ : Q N_plus * Q N_plus = Q N_plus := YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 := YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 := YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hRR : peirceR N_plus * peirceR N_plus = peirceR N_plus := by
    have hGap := Gap_idem N_plus h_nil h_reg
    dsimp [peirceR]
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap, sub_self, sub_zero]
  rcases peirce_chiral_neutral_orthogonal N_plus h_nil h_reg with
    ⟨hPR, hRP, hQR, hRQ⟩
  have h2 : peirceGradeMinus1 N_plus (peirceGradePlus2 N_plus X) = 0 := by
    dsimp [peirceGradeMinus1, peirceRP, peirceQR,
      peirceGradePlus2, peircePQ]
    simp only [peirce_corner_comp]
    simp [hRP, hQP]
  have h1 : peirceGradeMinus1 N_plus (peirceGradePlus1 N_plus X) = 0 := by
    dsimp [peirceGradeMinus1, peirceRP, peirceQR,
      peirceGradePlus1, peircePR, peirceRQ]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hRP, hQP, hQR, hPQ, hPR]
  have h0 : peirceGradeMinus1 N_plus (peirceGradeZero N_plus X) = 0 := by
    dsimp [peirceGradeMinus1, peirceRP, peirceQR, peirceGradeZero,
      peircePP, peirceQQ, peirceRR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hRP, hQP, hQR, hPQ]
  have hm1 : peirceGradeMinus1 N_plus (peirceGradeMinus1 N_plus X) =
      peirceGradeMinus1 N_plus X := by
    dsimp [peirceGradeMinus1, peirceRP, peirceQR]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hPP, hQQ, hRR, hPR, hRP, hQR, hRQ]
  have hm2 : peirceGradeMinus1 N_plus (peirceGradeMinus2 N_plus X) = 0 := by
    dsimp [peirceGradeMinus1, peirceRP, peirceQR,
      peirceGradeMinus2, peirceQP]
    simp only [mul_add, add_mul, peirce_corner_comp]
    simp [hRP, hRQ, hPR]
  exact ⟨h2, h1, h0, hm1, hm2⟩

theorem peirce_five_grade_sum_zero_minus1 (N_plus X₂ X₁ X₀ Xm₁ Xm₂ : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (hsum : peirceGradePlus2 N_plus X₂ + peirceGradePlus1 N_plus X₁ +
      peirceGradeZero N_plus X₀ + peirceGradeMinus1 N_plus Xm₁ +
      peirceGradeMinus2 N_plus Xm₂ = 0) :
    peirceGradeMinus1 N_plus Xm₁ = 0 := by
  rcases peirceGradeMinus1_comp_filter N_plus X₂ h_nil h_reg with ⟨h2, _, _, _, _⟩
  rcases peirceGradeMinus1_comp_filter N_plus X₁ h_nil h_reg with ⟨_, h1, _, _, _⟩
  rcases peirceGradeMinus1_comp_filter N_plus X₀ h_nil h_reg with ⟨_, _, h0, _, _⟩
  rcases peirceGradeMinus1_comp_filter N_plus Xm₁ h_nil h_reg with ⟨_, _, _, hself, _⟩
  rcases peirceGradeMinus1_comp_filter N_plus Xm₂ h_nil h_reg with ⟨_, _, _, _, hm2⟩
  have hproject := congrArg (peirceGradeMinus1 N_plus) hsum
  simp only [peirceGradeMinus1_add, h2, h1, h0, hself, hm2] at hproject
  simp only [peirceGradeMinus1_zero, add_zero, zero_add] at hproject
  exact hproject

/-- Directness of the five canonical Peirce grades: if a sum of five grade
components is zero, every component is zero. -/
theorem peirce_five_grade_sum_zero_all (N_plus X₂ X₁ X₀ Xm₁ Xm₂ : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (hsum : peirceGradePlus2 N_plus X₂ + peirceGradePlus1 N_plus X₁ +
      peirceGradeZero N_plus X₀ + peirceGradeMinus1 N_plus Xm₁ +
      peirceGradeMinus2 N_plus Xm₂ = 0) :
    peirceGradePlus2 N_plus X₂ = 0 ∧
    peirceGradePlus1 N_plus X₁ = 0 ∧
    peirceGradeZero N_plus X₀ = 0 ∧
    peirceGradeMinus1 N_plus Xm₁ = 0 ∧
    peirceGradeMinus2 N_plus Xm₂ = 0 := by
  exact ⟨peirce_five_grade_sum_zero_plus2 N_plus X₂ X₁ X₀ Xm₁ Xm₂
      h_nil h_reg hsum,
    peirce_five_grade_sum_zero_plus1 N_plus X₂ X₁ X₀ Xm₁ Xm₂
      h_nil h_reg hsum,
    peirce_five_grade_sum_zero_zero N_plus X₂ X₁ X₀ Xm₁ Xm₂
      h_nil h_reg hsum,
    peirce_five_grade_sum_zero_minus1 N_plus X₂ X₁ X₀ Xm₁ Xm₂
      h_nil h_reg hsum,
    peirce_five_grade_sum_zero_minus2 N_plus X₂ X₁ X₀ Xm₁ Xm₂
      h_nil h_reg hsum⟩

/-- The five native additive subgroups are internally independent: a zero sum
of arbitrary elements from their respective ranges has only zero summands. -/
theorem peirce_five_grade_subgroup_sum_zero (N_plus x₂ x₁ x₀ xm₁ xm₂ : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (h₂ : x₂ ∈ peirceGradePlus2Subgroup N_plus)
    (h₁ : x₁ ∈ peirceGradePlus1Subgroup N_plus)
    (h₀ : x₀ ∈ peirceGradeZeroSubgroup N_plus)
    (hm₁ : xm₁ ∈ peirceGradeMinus1Subgroup N_plus)
    (hm₂ : xm₂ ∈ peirceGradeMinus2Subgroup N_plus)
    (hsum : x₂ + x₁ + x₀ + xm₁ + xm₂ = 0) :
    x₂ = 0 ∧ x₁ = 0 ∧ x₀ = 0 ∧ xm₁ = 0 ∧ xm₂ = 0 := by
  change x₂ ∈ Set.range (peirceGradePlus2 N_plus) at h₂
  change x₁ ∈ Set.range (peirceGradePlus1 N_plus) at h₁
  change x₀ ∈ Set.range (peirceGradeZero N_plus) at h₀
  change xm₁ ∈ Set.range (peirceGradeMinus1 N_plus) at hm₁
  change xm₂ ∈ Set.range (peirceGradeMinus2 N_plus) at hm₂
  obtain ⟨X₂, hX₂⟩ := h₂
  obtain ⟨X₁, hX₁⟩ := h₁
  obtain ⟨X₀, hX₀⟩ := h₀
  obtain ⟨Xm₁, hXm₁⟩ := hm₁
  obtain ⟨Xm₂, hXm₂⟩ := hm₂
  have hsum' : peirceGradePlus2 N_plus X₂ + peirceGradePlus1 N_plus X₁ +
      peirceGradeZero N_plus X₀ + peirceGradeMinus1 N_plus Xm₁ +
      peirceGradeMinus2 N_plus Xm₂ = 0 := by
    rw [hX₂, hX₁, hX₀, hXm₁, hXm₂]
    exact hsum
  rcases peirce_five_grade_sum_zero_all N_plus X₂ X₁ X₀ Xm₁ Xm₂
      h_nil h_reg hsum' with ⟨hz₂, hz₁, hz₀, hzm₁, hzm₂⟩
  exact ⟨hX₂ ▸ hz₂, hX₁ ▸ hz₁, hX₀ ▸ hz₀, hXm₁ ▸ hzm₁, hXm₂ ▸ hzm₂⟩

/-- Equality of two five-term sums of grade elements is componentwise equality. -/
theorem peirce_five_grade_subgroup_sum_eq (N_plus x₂ x₁ x₀ xm₁ xm₂
    y₂ y₁ y₀ ym₁ ym₂ : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (hx₂ : x₂ ∈ peirceGradePlus2Subgroup N_plus)
    (hx₁ : x₁ ∈ peirceGradePlus1Subgroup N_plus)
    (hx₀ : x₀ ∈ peirceGradeZeroSubgroup N_plus)
    (hxm₁ : xm₁ ∈ peirceGradeMinus1Subgroup N_plus)
    (hxm₂ : xm₂ ∈ peirceGradeMinus2Subgroup N_plus)
    (hy₂ : y₂ ∈ peirceGradePlus2Subgroup N_plus)
    (hy₁ : y₁ ∈ peirceGradePlus1Subgroup N_plus)
    (hy₀ : y₀ ∈ peirceGradeZeroSubgroup N_plus)
    (hym₁ : ym₁ ∈ peirceGradeMinus1Subgroup N_plus)
    (hym₂ : ym₂ ∈ peirceGradeMinus2Subgroup N_plus)
    (hsum : x₂ + x₁ + x₀ + xm₁ + xm₂ = y₂ + y₁ + y₀ + ym₁ + ym₂) :
    x₂ = y₂ ∧ x₁ = y₁ ∧ x₀ = y₀ ∧ xm₁ = ym₁ ∧ xm₂ = ym₂ := by
  have hdiff : (x₂ + x₁ + x₀ + xm₁ + xm₂) -
      (y₂ + y₁ + y₀ + ym₁ + ym₂) = 0 := by
    rw [hsum, sub_self]
  have hzero : (x₂ - y₂) + (x₁ - y₁) + (x₀ - y₀) +
      (xm₁ - ym₁) + (xm₂ - ym₂) = 0 := by
    calc (x₂ - y₂) + (x₁ - y₁) + (x₀ - y₀) +
          (xm₁ - ym₁) + (xm₂ - ym₂)
        = (x₂ + x₁ + x₀ + xm₁ + xm₂) -
          (y₂ + y₁ + y₀ + ym₁ + ym₂) := by abel
      _ = 0 := hdiff
  rcases peirce_five_grade_subgroup_sum_zero N_plus
      (x₂ - y₂) (x₁ - y₁) (x₀ - y₀) (xm₁ - ym₁) (xm₂ - ym₂)
      h_nil h_reg
      (sub_mem hx₂ hy₂) (sub_mem hx₁ hy₁) (sub_mem hx₀ hy₀)
      (sub_mem hxm₁ hym₁) (sub_mem hxm₂ hym₂)
      hzero with ⟨h₂, h₁, h₀, hm₁, hm₂⟩
  exact ⟨sub_eq_zero.mp h₂, sub_eq_zero.mp h₁, sub_eq_zero.mp h₀,
    sub_eq_zero.mp hm₁, sub_eq_zero.mp hm₂⟩

/-- The five Peirce grade ranges, indexed in order `+2,+1,0,-1,-2`. -/
def peirceFiveGradeSubgroup (N_plus : B) (i : Fin 5) : AddSubgroup B :=
  match i.val with
  | 0 => peirceGradePlus2Subgroup N_plus
  | 1 => peirceGradePlus1Subgroup N_plus
  | 2 => peirceGradeZeroSubgroup N_plus
  | 3 => peirceGradeMinus1Subgroup N_plus
  | _ => peirceGradeMinus2Subgroup N_plus

/-- The corresponding native mathlib `ℤ`-submodules. -/
def peirceFiveGradeSubmodule (N_plus : B) (i : Fin 5) : Submodule ℤ B :=
  (peirceFiveGradeSubgroup N_plus i).toIntSubmodule

/-- The five Peirce grade submodules form an internal direct sum equal to the
whole additive group of the ambient ring. -/
theorem peirce_five_grade_directSum_isInternal (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    DirectSum.IsInternal (peirceFiveGradeSubmodule N_plus) := by
  have hIndependent : iSupIndep (peirceFiveGradeSubmodule N_plus) := by
    apply (iSupIndep_iff_finsetSum_eq_imp_eq
      (R := ℤ) (N := B) (peirceFiveGradeSubmodule N_plus)).2
    intro s v w hvw hsum i hi
    classical
    let X : Fin 5 → B := fun j => if j ∈ s then v j else 0
    let Y : Fin 5 → B := fun j => if j ∈ s then w j else 0
    have hXmem (j : Fin 5) : X j ∈ peirceFiveGradeSubmodule N_plus j := by
      by_cases hj : j ∈ s
      · simpa [X, hj] using (hvw j hj).1
      · simp [X, hj]
    have hYmem (j : Fin 5) : Y j ∈ peirceFiveGradeSubmodule N_plus j := by
      by_cases hj : j ∈ s
      · simpa [Y, hj] using (hvw j hj).2
      · simp [Y, hj]
    have hXsum : (∑ j : Fin 5, X j) = ∑ j ∈ s, v j := by
      simp [X, Finset.sum_ite_mem]
    have hYsum : (∑ j : Fin 5, Y j) = ∑ j ∈ s, w j := by
      simp [Y, Finset.sum_ite_mem]
    have hsumFive : X 0 + X 1 + X 2 + X 3 + X 4 =
        Y 0 + Y 1 + Y 2 + Y 3 + Y 4 := by
      simpa [Fin.sum_univ_succ, add_assoc] using hXsum.trans (hsum.trans hYsum.symm)
    have hX0 : X 0 ∈ peirceGradePlus2Subgroup N_plus := by
      change X 0 ∈ (peirceGradePlus2Subgroup N_plus).toIntSubmodule
      exact hXmem 0
    have hX1 : X 1 ∈ peirceGradePlus1Subgroup N_plus := by
      change X 1 ∈ (peirceGradePlus1Subgroup N_plus).toIntSubmodule
      exact hXmem 1
    have hX2 : X 2 ∈ peirceGradeZeroSubgroup N_plus := by
      change X 2 ∈ (peirceGradeZeroSubgroup N_plus).toIntSubmodule
      exact hXmem 2
    have hX3 : X 3 ∈ peirceGradeMinus1Subgroup N_plus := by
      change X 3 ∈ (peirceGradeMinus1Subgroup N_plus).toIntSubmodule
      exact hXmem 3
    have hX4 : X 4 ∈ peirceGradeMinus2Subgroup N_plus := by
      change X 4 ∈ (peirceGradeMinus2Subgroup N_plus).toIntSubmodule
      exact hXmem 4
    have hY0 : Y 0 ∈ peirceGradePlus2Subgroup N_plus := by
      change Y 0 ∈ (peirceGradePlus2Subgroup N_plus).toIntSubmodule
      exact hYmem 0
    have hY1 : Y 1 ∈ peirceGradePlus1Subgroup N_plus := by
      change Y 1 ∈ (peirceGradePlus1Subgroup N_plus).toIntSubmodule
      exact hYmem 1
    have hY2 : Y 2 ∈ peirceGradeZeroSubgroup N_plus := by
      change Y 2 ∈ (peirceGradeZeroSubgroup N_plus).toIntSubmodule
      exact hYmem 2
    have hY3 : Y 3 ∈ peirceGradeMinus1Subgroup N_plus := by
      change Y 3 ∈ (peirceGradeMinus1Subgroup N_plus).toIntSubmodule
      exact hYmem 3
    have hY4 : Y 4 ∈ peirceGradeMinus2Subgroup N_plus := by
      change Y 4 ∈ (peirceGradeMinus2Subgroup N_plus).toIntSubmodule
      exact hYmem 4
    have hparts := peirce_five_grade_subgroup_sum_eq N_plus
      (X 0) (X 1) (X 2) (X 3) (X 4)
      (Y 0) (Y 1) (Y 2) (Y 3) (Y 4)
      h_nil h_reg
      hX0 hX1 hX2 hX3 hX4 hY0 hY1 hY2 hY3 hY4
      hsumFive
    rcases hparts with ⟨h0, h1, h2, h3, h4⟩
    fin_cases i <;> simp_all [X, Y]
  have hSpanning : iSup (peirceFiveGradeSubmodule N_plus) = ⊤ := by
    apply le_antisymm
    · exact le_top
    · intro X _
      rcases peirce_five_grade_subgroup_decomposition N_plus X h_nil h_reg with
        ⟨h2, h1, h0, hm1, hm2, hsum⟩
      rw [hsum]
      have hmem (i : Fin 5) {x : B} (hx : x ∈ peirceFiveGradeSubgroup N_plus i) :
          x ∈ iSup (peirceFiveGradeSubmodule N_plus) := by
        apply le_iSup (peirceFiveGradeSubmodule N_plus) i
        change x ∈ (peirceFiveGradeSubgroup N_plus i).toIntSubmodule
        exact hx
      exact add_mem (add_mem (add_mem (add_mem
        (hmem 0 h2) (hmem 1 h1)) (hmem 2 h0)) (hmem 3 hm1)) (hmem 4 hm2)
  exact (DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top
    (R := ℤ) (ι := Fin 5) (M := B) (peirceFiveGradeSubmodule N_plus)).2
      ⟨hIndependent, hSpanning⟩

/-- The canonical additive and `ℤ`-linear recomposition equivalence from the
external direct sum of the five grades onto the ring. -/
noncomputable def peirceFiveGradeDirectSumEquiv (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    DirectSum (Fin 5) (fun i => peirceFiveGradeSubmodule N_plus i) ≃ₗ[ℤ] B :=
  LinearEquiv.ofBijective (DirectSum.coeLinearMap (peirceFiveGradeSubmodule N_plus))
    (peirce_five_grade_directSum_isInternal N_plus h_nil h_reg)

/-- The five-piece external Peirce direct sum carries the Lie bracket
transported from the ambient commutator Lie ring along its recomposition map.
This bracket is defined on the whole direct sum, including sums of components. -/
@[instance_reducible]
noncomputable def peirceFiveGradeDirectSumLieRing (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    LieRing (DirectSum (Fin 5) (fun i => peirceFiveGradeSubmodule N_plus i) : Type _) := by
  letI : LieRing B := LieRing.ofAssociativeRing
  exact (peirceFiveGradeDirectSumEquiv N_plus h_nil h_reg).toAddEquiv.lieRing

/-- Recomposition preserves the transported Lie bracket on the five-piece
external direct sum. -/
theorem peirceFiveGradeDirectSum_bracket (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (x y : DirectSum (Fin 5) (fun i => peirceFiveGradeSubmodule N_plus i)) :
    letI : LieRing B := LieRing.ofAssociativeRing
    letI : LieRing
        (DirectSum (Fin 5) (fun i => peirceFiveGradeSubmodule N_plus i) : Type _) :=
      peirceFiveGradeDirectSumLieRing N_plus h_nil h_reg
    peirceFiveGradeDirectSumEquiv N_plus h_nil h_reg ⁅x, y⁆ =
      ⁅peirceFiveGradeDirectSumEquiv N_plus h_nil h_reg x,
        peirceFiveGradeDirectSumEquiv N_plus h_nil h_reg y⁆ := by
  letI : LieRing B := LieRing.ofAssociativeRing
  letI : LieRing
      (DirectSum (Fin 5) (fun i => peirceFiveGradeSubmodule N_plus i) : Type _) :=
    peirceFiveGradeDirectSumLieRing N_plus h_nil h_reg
  change peirceFiveGradeDirectSumEquiv N_plus h_nil h_reg ⁅x, y⁆ =
    ⁅peirceFiveGradeDirectSumEquiv N_plus h_nil h_reg x,
      peirceFiveGradeDirectSumEquiv N_plus h_nil h_reg y⁆
  have h := AddEquiv.bracket_def
    (peirceFiveGradeDirectSumEquiv N_plus h_nil h_reg).toAddEquiv x y
  simpa using congrArg
    (peirceFiveGradeDirectSumEquiv N_plus h_nil h_reg).toAddEquiv h

/-- The grade-zero sector is closed under the commutator: its bracket is the
sum of the three diagonal Peirce-block brackets. -/
theorem comm_peirceGradeZero_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradeZero N_plus X) (peirceGradeZero N_plus Y) =
      comm (G_0_P N_plus X) (G_0_P N_plus Y) +
      comm (G_0_Q N_plus X) (G_0_Q N_plus Y) +
      comm (G_0_neutral N_plus X) (G_0_neutral N_plus Y) := by
  have hP2 : P N_plus * P N_plus = P N_plus :=
    YangMillsVortexPoset.P_idem N_plus h_reg
  have hQ2 : Q N_plus * Q N_plus = Q N_plus :=
    YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 :=
    YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 :=
    YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hPG : P N_plus * Gap N_plus = P N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, mul_add, hP2, hPQ]
    exact add_zero (P N_plus)
  have hGP : Gap N_plus * P N_plus = P N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, add_mul, hP2, hQP]
    exact add_zero (P N_plus)
  have hQG : Q N_plus * Gap N_plus = Q N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, mul_add, hQP, hQ2]
    exact zero_add (Q N_plus)
  have hGQ : Gap N_plus * Q N_plus = Q N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, add_mul, hPQ, hQ2]
    exact zero_add (Q N_plus)
  have hPR : P N_plus * peirceR N_plus = 0 := by
    dsimp [peirceR]
    rw [mul_sub, mul_one, hPG, sub_self]
  have hRP : peirceR N_plus * P N_plus = 0 := by
    dsimp [peirceR]
    rw [sub_mul, one_mul, hGP, sub_self]
  have hQR : Q N_plus * peirceR N_plus = 0 := by
    dsimp [peirceR]
    rw [mul_sub, mul_one, hQG, sub_self]
  have hRQ : peirceR N_plus * Q N_plus = 0 := by
    dsimp [peirceR]
    rw [sub_mul, one_mul, hGQ, sub_self]
  have hR2 : peirceR N_plus * peirceR N_plus = peirceR N_plus := by
    have hGap2 := Gap_idem N_plus h_nil h_reg
    dsimp [peirceR]
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap2, sub_self, sub_zero]
  have hDiag := kkt_diagonal_peirce_bracket
    (P N_plus) (Q N_plus) (peirceR N_plus) X Y
    hPQ hQP hPR hRP hQR hRQ
  change comm (P N_plus * X * P N_plus + Q N_plus * X * Q N_plus +
      peirceR N_plus * X * peirceR N_plus)
      (P N_plus * Y * P N_plus + Q N_plus * Y * Q N_plus +
      peirceR N_plus * Y * peirceR N_plus) =
    comm (P N_plus * X * P N_plus) (P N_plus * Y * P N_plus) +
      comm (Q N_plus * X * Q N_plus) (Q N_plus * Y * Q N_plus) +
      comm (peirceR N_plus * X * peirceR N_plus)
        (peirceR N_plus * Y * peirceR N_plus)
  exact hDiag

/-- The bracket of two grade `+1` Peirce elements lands in grade `+2`.
Only the composable `P→R` and `R→Q` corners contribute. -/
theorem comm_peirceGradePlus1_self_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradePlus1 N_plus X) (peirceGradePlus1 N_plus Y) =
      peirceGradePlus2 N_plus
        (X * peirceR N_plus * Y - Y * peirceR N_plus * X) := by
  have hQP : Q N_plus * P N_plus = 0 :=
    YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hRP : peirceR N_plus * P N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.1
  have hQR : Q N_plus * peirceR N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.2.1
  have hR2 : peirceR N_plus * peirceR N_plus = peirceR N_plus := by
    have hGap2 := Gap_idem N_plus h_nil h_reg
    dsimp [peirceR]
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap2, sub_self, sub_zero]
  have hPRPR : comm (P N_plus * X * peirceR N_plus)
      (P N_plus * Y * peirceR N_plus) = 0 :=
    kkt_peirce_bracket_orthogonal (P N_plus) (peirceR N_plus)
      (P N_plus) (peirceR N_plus) X Y hRP hRP
  have hRQRQ : comm (peirceR N_plus * X * Q N_plus)
      (peirceR N_plus * Y * Q N_plus) = 0 :=
    kkt_peirce_bracket_orthogonal (peirceR N_plus) (Q N_plus)
      (peirceR N_plus) (Q N_plus) X Y hQR hQR
  have hPRRQ : comm (P N_plus * X * peirceR N_plus)
      (peirceR N_plus * Y * Q N_plus) =
      P N_plus * X * peirceR N_plus * Y * Q N_plus :=
    kkt_peirce_bracket_composable (P N_plus) (peirceR N_plus)
      (Q N_plus) X Y hR2 hQP
  have hRQPR : comm (peirceR N_plus * X * Q N_plus)
      (P N_plus * Y * peirceR N_plus) =
      -(P N_plus * Y * peirceR N_plus * X * Q N_plus) := by
    calc comm (peirceR N_plus * X * Q N_plus)
          (P N_plus * Y * peirceR N_plus)
        = -comm (P N_plus * Y * peirceR N_plus)
          (peirceR N_plus * X * Q N_plus) := by
            dsimp [comm]
            noncomm_ring
      _ = -(P N_plus * Y * peirceR N_plus * X * Q N_plus) := by
            rw [kkt_peirce_bracket_composable (P N_plus) (peirceR N_plus)
              (Q N_plus) Y X hR2 hQP]
  change comm (P N_plus * X * peirceR N_plus +
      peirceR N_plus * X * Q N_plus)
    (P N_plus * Y * peirceR N_plus +
      peirceR N_plus * Y * Q N_plus) =
    P N_plus * (X * peirceR N_plus * Y -
      Y * peirceR N_plus * X) * Q N_plus
  simp only [kkt_comm_add_left, kkt_comm_add_right,
    hPRPR, hPRRQ, hRQPR, hRQRQ]
  noncomm_ring

/-- The bracket of two grade `-1` Peirce elements lands in grade `-2`.
This is the star-dual of the grade `+1` self-bracket law. -/
theorem comm_peirceGradeMinus1_self_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradeMinus1 N_plus X) (peirceGradeMinus1 N_plus Y) =
      peirceGradeMinus2 N_plus
        (X * peirceR N_plus * Y - Y * peirceR N_plus * X) := by
  have hGapStar : Gap (star N_plus) = Gap N_plus := by
    have hSigmaStar : Sigma (star N_plus) = -Sigma N_plus := by
      dsimp [OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset.Sigma,
        OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset.comm]
      rw [star_star]
      noncomm_ring
    dsimp [Gap]
    rw [hSigmaStar]
    noncomm_ring
  have hRStar : peirceR (star N_plus) = peirceR N_plus := by
    simp [peirceR, hGapStar]
  have hregStar : star N_plus * star (star N_plus) * star N_plus = star N_plus := by
    rw [star_star]
    exact YangMillsVortexPoset.star_N_plus_reg N_plus h_reg
  have hPStar : P (star N_plus) = Q N_plus := by
    dsimp [P, Q]
    rw [star_star]
  have hQStar : Q (star N_plus) = P N_plus := by
    dsimp [P, Q]
    rw [star_star]
  have h := comm_peirceGradePlus1_self_closed (star N_plus) X Y
    (YangMillsVortexPoset.star_N_plus_sq N_plus h_nil) hregStar
  simpa [peirceGradePlus1, peirceGradeMinus1, peirceGradePlus2,
    peirceGradeMinus2, peircePQ, peirceQP, peircePR, peirceRQ, peirceRP, peirceQR,
    hPStar, hQStar, hRStar, add_comm] using h

/-- The bracket of grade `+2` with grade zero lands in grade `+2`. Only the
`P` and `Q` diagonal blocks act nontrivially on the `P→Q` corner. -/
theorem comm_peirceGradePlus2_zero_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradePlus2 N_plus X) (peirceGradeZero N_plus Y) =
      peirceGradePlus2 N_plus
        (X * Q N_plus * Y * Q N_plus -
          Y * P N_plus * X * Q N_plus) := by
  have hP2 : P N_plus * P N_plus = P N_plus :=
    YangMillsVortexPoset.P_idem N_plus h_reg
  have hQ2 : Q N_plus * Q N_plus = Q N_plus :=
    YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 :=
    YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 :=
    YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hPR : P N_plus * peirceR N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).1
  have hRP : peirceR N_plus * P N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.1
  have hQR : Q N_plus * peirceR N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.2.1
  have hRQ : peirceR N_plus * Q N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.2.2
  have hPP : comm (P N_plus * X * Q N_plus)
      (P N_plus * Y * P N_plus) =
      -(P N_plus * Y * P N_plus * X * Q N_plus) := by
    calc comm (P N_plus * X * Q N_plus) (P N_plus * Y * P N_plus)
        = -comm (P N_plus * Y * P N_plus) (P N_plus * X * Q N_plus) := by
            dsimp [comm]
            noncomm_ring
      _ = -(P N_plus * Y * P N_plus * X * Q N_plus) := by
            rw [kkt_peirce_bracket_composable (P N_plus) (P N_plus)
              (Q N_plus) Y X hP2 hQP]
  have hQQ := kkt_peirce_bracket_composable (P N_plus) (Q N_plus)
    (Q N_plus) X Y hQ2 hQP
  have hRR : comm (P N_plus * X * Q N_plus)
      (peirceR N_plus * Y * peirceR N_plus) = 0 :=
    kkt_peirce_bracket_orthogonal (P N_plus) (Q N_plus)
      (peirceR N_plus) (peirceR N_plus) X Y hQR hRP
  change comm (P N_plus * X * Q N_plus)
      (P N_plus * Y * P N_plus + Q N_plus * Y * Q N_plus +
        peirceR N_plus * Y * peirceR N_plus) =
    P N_plus * (X * Q N_plus * Y * Q N_plus -
      Y * P N_plus * X * Q N_plus) * Q N_plus
  simp only [kkt_comm_add_right, hPP, hQQ, hRR]
  noncomm_ring [hP2, hQ2]

/-- The bracket of grade `-2` with grade zero lands in grade `-2`. Only the
`P` and `Q` diagonal blocks act nontrivially on the `Q→P` corner. -/
theorem comm_peirceGradeMinus2_zero_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradeMinus2 N_plus X) (peirceGradeZero N_plus Y) =
      peirceGradeMinus2 N_plus
        (X * P N_plus * Y - Y * Q N_plus * X) := by
  have hP2 : P N_plus * P N_plus = P N_plus :=
    YangMillsVortexPoset.P_idem N_plus h_reg
  have hQ2 : Q N_plus * Q N_plus = Q N_plus :=
    YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 :=
    YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 :=
    YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hPR : P N_plus * peirceR N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).1
  have hRQ : peirceR N_plus * Q N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.2.2
  have hPP : comm (Q N_plus * X * P N_plus)
      (P N_plus * Y * P N_plus) = Q N_plus * X * P N_plus * Y * P N_plus := by
    exact kkt_peirce_bracket_composable (Q N_plus) (P N_plus)
      (P N_plus) X Y hP2 hPQ
  have hQQ : comm (Q N_plus * X * P N_plus)
      (Q N_plus * Y * Q N_plus) = -(Q N_plus * Y * Q N_plus * X * P N_plus) := by
    calc comm (Q N_plus * X * P N_plus) (Q N_plus * Y * Q N_plus)
        = -comm (Q N_plus * Y * Q N_plus) (Q N_plus * X * P N_plus) := by
            exact kkt_comm_antisymm _ _
      _ = -(Q N_plus * Y * Q N_plus * X * P N_plus) := by
            rw [kkt_peirce_bracket_composable (Q N_plus) (Q N_plus)
              (P N_plus) Y X hQ2 hPQ]
  have hRR : comm (Q N_plus * X * P N_plus)
      (peirceR N_plus * Y * peirceR N_plus) = 0 :=
    kkt_peirce_bracket_orthogonal (Q N_plus) (P N_plus)
      (peirceR N_plus) (peirceR N_plus) X Y hPR hRQ
  change comm (Q N_plus * X * P N_plus)
      (P N_plus * Y * P N_plus + Q N_plus * Y * Q N_plus +
        peirceR N_plus * Y * peirceR N_plus) =
    Q N_plus * (X * P N_plus * Y - Y * Q N_plus * X) * P N_plus
  simp only [kkt_comm_add_right, hPP, hQQ, hRR]
  noncomm_ring [hP2, hQ2]

/-- Subgroup-valued form of the `(+2)+0=+2` bracket closure. -/
theorem comm_peirceGradePlus2_zero_mem (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradePlus2 N_plus X) (peirceGradeZero N_plus Y) ∈
      peirceGradePlus2Subgroup N_plus := by
  rw [comm_peirceGradePlus2_zero_closed N_plus X Y h_nil h_reg]
  exact ⟨X * Q N_plus * Y * Q N_plus -
    Y * P N_plus * X * Q N_plus, rfl⟩

/-- Subgroup-valued form of the `(-2)+0=-2` bracket closure. -/
theorem comm_peirceGradeMinus2_zero_mem (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradeMinus2 N_plus X) (peirceGradeZero N_plus Y) ∈
      peirceGradeMinus2Subgroup N_plus := by
  rw [comm_peirceGradeMinus2_zero_closed N_plus X Y h_nil h_reg]
  exact ⟨X * P N_plus * Y - Y * Q N_plus * X, rfl⟩

/-- The mixed bracket of grades `+1` and `-1` lands in grade zero. Its three
diagonal components are the `P`, `Q`, and neutral Peirce blocks. -/
theorem comm_peirceGradePlus1_minus1_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradePlus1 N_plus X) (peirceGradeMinus1 N_plus Y) =
      G_0_P N_plus (X * peirceR N_plus * Y) -
      G_0_Q N_plus (Y * peirceR N_plus * X) +
      peirceR N_plus * (X * Q N_plus * Y - Y * P N_plus * X) * peirceR N_plus := by
  have hP2 : P N_plus * P N_plus = P N_plus :=
    YangMillsVortexPoset.P_idem N_plus h_reg
  have hQ2 : Q N_plus * Q N_plus = Q N_plus :=
    YangMillsVortexPoset.Q_idem N_plus h_reg
  have hPQ : P N_plus * Q N_plus = 0 :=
    YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hQP : Q N_plus * P N_plus = 0 :=
    YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hPG : P N_plus * Gap N_plus = P N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, mul_add, hP2, hPQ]
    exact add_zero (P N_plus)
  have hGP : Gap N_plus * P N_plus = P N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, add_mul, hP2, hQP]
    exact add_zero (P N_plus)
  have hQG : Q N_plus * Gap N_plus = Q N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, mul_add, hQP, hQ2]
    exact zero_add (Q N_plus)
  have hGQ : Gap N_plus * Q N_plus = Q N_plus := by
    rw [Gap_eq_P_add_Q N_plus h_nil h_reg, add_mul, hPQ, hQ2]
    exact zero_add (Q N_plus)
  have hPR : P N_plus * peirceR N_plus = 0 := by
    dsimp [peirceR]
    rw [mul_sub, mul_one, hPG, sub_self]
  have hRP : peirceR N_plus * P N_plus = 0 := by
    dsimp [peirceR]
    rw [sub_mul, one_mul, hGP, sub_self]
  have hQR : Q N_plus * peirceR N_plus = 0 := by
    dsimp [peirceR]
    rw [mul_sub, mul_one, hQG, sub_self]
  have hRQ : peirceR N_plus * Q N_plus = 0 := by
    dsimp [peirceR]
    rw [sub_mul, one_mul, hGQ, sub_self]
  have hR2 : peirceR N_plus * peirceR N_plus = peirceR N_plus := by
    have hGap2 := Gap_idem N_plus h_nil h_reg
    dsimp [peirceR]
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap2, sub_self, sub_zero]
  have hMix := kkt_mixed_peirce_grade_bracket
    (P N_plus) (Q N_plus) (peirceR N_plus) X Y hP2 hQ2 hR2
    hPR hRP hQR hRQ
  change comm (P N_plus * X * peirceR N_plus + peirceR N_plus * X * Q N_plus)
      (peirceR N_plus * Y * P N_plus + Q N_plus * Y * peirceR N_plus) = _
  rw [hMix]
  dsimp [G_0_P, G_0_Q]
  noncomm_ring

/-- The `+2` and `+1` Peirce sectors commute, expressing truncation above the
top grade of the five-grade decomposition. -/
theorem comm_peirceGradePlus2_plus1 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradePlus2 N_plus X) (peirceGradePlus1 N_plus Y) = 0 := by
  have hQP : Q N_plus * P N_plus = 0 :=
    YangMillsVortexPoset.Q_mul_P N_plus h_nil
  have hPR : P N_plus * peirceR N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).1
  have hRP : peirceR N_plus * P N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.1
  have hQR : Q N_plus * peirceR N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.2.1
  rw [peirceGradePlus2, peircePQ, peirceGradePlus1, peircePR, peirceRQ]
  exact kkt_plus_two_plus_one_bracket_zero
    (P N_plus) (Q N_plus) (peirceR N_plus) X Y hQP hRP hQR

/-- The mixed bracket of grades `+2` and `-1` lands in grade `+1`. The two
nonzero corner products give the `P→R` and `R→Q` summands, respectively. -/
theorem comm_peirceGradePlus2_minus1_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradePlus2 N_plus X) (peirceGradeMinus1 N_plus Y) =
      peirceGradePlus1 N_plus
        (X * Q N_plus * Y * peirceR N_plus -
          Y * P N_plus * X * Q N_plus) := by
  have hP2 : P N_plus * P N_plus = P N_plus :=
    YangMillsVortexPoset.P_idem N_plus h_reg
  have hQ2 : Q N_plus * Q N_plus = Q N_plus :=
    YangMillsVortexPoset.Q_idem N_plus h_reg
  have hQR : Q N_plus * peirceR N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.2.1
  have hRQ : peirceR N_plus * Q N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.2.2
  have hRP : peirceR N_plus * P N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.1
  have hR2 : peirceR N_plus * peirceR N_plus = peirceR N_plus := by
    have hGap2 := Gap_idem N_plus h_nil h_reg
    dsimp [peirceR]
    rw [mul_sub, mul_one, sub_mul, one_mul, hGap2, sub_self, sub_zero]
  have hFirst : comm (P N_plus * X * Q N_plus)
      (peirceR N_plus * Y * P N_plus) =
      -(peirceR N_plus * Y * P N_plus * X * Q N_plus) := by
    dsimp [comm]
    have hForward : (P N_plus * X * Q N_plus) *
        (peirceR N_plus * Y * P N_plus) = 0 := by
      calc (P N_plus * X * Q N_plus) * (peirceR N_plus * Y * P N_plus)
          = (P N_plus * X) * (Q N_plus * peirceR N_plus) * (Y * P N_plus) := by
              noncomm_ring
        _ = 0 := by rw [hQR]; noncomm_ring
    have hBackward : (peirceR N_plus * Y * P N_plus) *
        (P N_plus * X * Q N_plus) =
        peirceR N_plus * Y * P N_plus * X * Q N_plus := by
      calc (peirceR N_plus * Y * P N_plus) * (P N_plus * X * Q N_plus)
          = (peirceR N_plus * Y) * (P N_plus * P N_plus) * (X * Q N_plus) := by
              noncomm_ring
        _ = peirceR N_plus * Y * P N_plus * X * Q N_plus := by
              rw [hP2]
              noncomm_ring
    rw [hForward, hBackward, zero_sub]
  have hSecond : comm (P N_plus * X * Q N_plus)
      (Q N_plus * Y * peirceR N_plus) =
      P N_plus * X * Q N_plus * Y * peirceR N_plus :=
    kkt_peirce_bracket_composable (P N_plus) (Q N_plus) (peirceR N_plus)
      X Y hQ2 hRP
  rw [peirceGradePlus2, peircePQ, peirceGradeMinus1, peirceRP, peirceQR,
    kkt_comm_add_right, hFirst, hSecond]
  dsimp [peirceGradePlus1, peircePR, peirceRQ]
  noncomm_ring [hR2, hQR, hRQ, hQ2]

/-- Subgroup-valued form of the `(+2)+(-1)=+1` bracket closure. -/
theorem comm_peirceGradePlus2_minus1_mem (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradePlus2 N_plus X) (peirceGradeMinus1 N_plus Y) ∈
      peirceGradePlus1Subgroup N_plus := by
  rw [comm_peirceGradePlus2_minus1_closed N_plus X Y h_nil h_reg]
  exact ⟨X * Q N_plus * Y * peirceR N_plus -
    Y * P N_plus * X * Q N_plus, rfl⟩

/-- Star-dual mixed bracket closure `(-2)+(+1)=-1`, obtained by exchanging
the two chiral supports in the proved `(+2)+(-1)=+1` identity. -/
theorem comm_peirceGradeMinus2_plus1_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradeMinus2 N_plus X) (peirceGradePlus1 N_plus Y) =
      peirceGradeMinus1 N_plus
        (X * P N_plus * Y * peirceR N_plus -
          Y * Q N_plus * X * P N_plus) := by
  have hGapStar : Gap (star N_plus) = Gap N_plus := by
    have hSigmaStar : Sigma (star N_plus) = -Sigma N_plus := by
      dsimp [OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset.Sigma,
        OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset.comm]
      rw [star_star]
      noncomm_ring
    dsimp [Gap]
    rw [hSigmaStar]
    noncomm_ring
  have hRStar : peirceR (star N_plus) = peirceR N_plus := by
    simp [peirceR, hGapStar]
  have hregStar : star N_plus * star (star N_plus) * star N_plus = star N_plus := by
    rw [star_star]
    exact YangMillsVortexPoset.star_N_plus_reg N_plus h_reg
  have hPStar : P (star N_plus) = Q N_plus := by
    dsimp [P, Q]
    rw [star_star]
  have hQStar : Q (star N_plus) = P N_plus := by
    dsimp [P, Q]
    rw [star_star]
  have h := comm_peirceGradePlus2_minus1_closed (star N_plus) X Y
    (YangMillsVortexPoset.star_N_plus_sq N_plus h_nil)
    hregStar
  simpa [peirceGradePlus2, peirceGradeMinus2, peirceGradePlus1,
    peirceGradeMinus1, peircePQ, peirceQP, peircePR, peirceRQ,
    peirceRP, peirceQR, hPStar, hQStar, hRStar, add_comm] using h

/-- The mixed bracket `(+1)+(-2)=-1` is the antisymmetric counterpart of
`(-2)+(+1)=-1`, with its explicit coefficient obtained by reversing the two
corner contributions. -/
theorem comm_peirceGradePlus1_minus2_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradePlus1 N_plus X) (peirceGradeMinus2 N_plus Y) =
      peirceGradeMinus1 N_plus
        (X * Q N_plus * Y * P N_plus - Y * P N_plus * X * peirceR N_plus) := by
  rw [kkt_comm_antisymm,
    comm_peirceGradeMinus2_plus1_closed N_plus Y X h_nil h_reg]
  dsimp [peirceGradeMinus1, peirceRP, peirceQR]
  noncomm_ring

/-- Subgroup-valued form of the `(+1)+(-2)=-1` bracket closure. -/
theorem comm_peirceGradePlus1_minus2_mem (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradePlus1 N_plus X) (peirceGradeMinus2 N_plus Y) ∈
      peirceGradeMinus1Subgroup N_plus := by
  rw [comm_peirceGradePlus1_minus2_closed N_plus X Y h_nil h_reg]
  exact ⟨X * Q N_plus * Y * P N_plus - Y * P N_plus * X * peirceR N_plus, rfl⟩

/-- The extremal Peirce grades are abelian under the Lie bracket. This records
the out-of-range degree sums `(+2)+(+2)` and `(-2)+(-2)` as zero, directly on
the full Peirce sectors rather than only on the sandwich generators. -/
theorem comm_peirceGradePlus2_self (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) :
    comm (peirceGradePlus2 N_plus X) (peirceGradePlus2 N_plus Y) = 0 := by
  have hQP : Q N_plus * P N_plus = 0 :=
    YangMillsVortexPoset.Q_mul_P N_plus h_nil
  rw [peirceGradePlus2, peircePQ]
  exact kkt_peirce_bracket_orthogonal
    (P N_plus) (Q N_plus) (P N_plus) (Q N_plus) X Y hQP hQP

theorem comm_peirceGradeMinus2_self (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) :
    comm (peirceGradeMinus2 N_plus X) (peirceGradeMinus2 N_plus Y) = 0 := by
  have hPQ : P N_plus * Q N_plus = 0 :=
    YangMillsVortexPoset.P_mul_Q N_plus h_nil
  rw [peirceGradeMinus2, peirceQP]
  exact kkt_peirce_bracket_orthogonal
    (Q N_plus) (P N_plus) (Q N_plus) (P N_plus) X Y hPQ hPQ

/-- The `-2` and `-1` Peirce sectors commute, expressing truncation below the
bottom grade of the five-grade decomposition. -/
theorem comm_peirceGradeMinus2_minus1 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (peirceGradeMinus2 N_plus X) (peirceGradeMinus1 N_plus Y) = 0 := by
  have hPQ : P N_plus * Q N_plus = 0 :=
    YangMillsVortexPoset.P_mul_Q N_plus h_nil
  have hPR : P N_plus * peirceR N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).1
  have hRQ : peirceR N_plus * Q N_plus = 0 :=
    (peirce_chiral_neutral_orthogonal N_plus h_nil h_reg).2.2.2
  rw [peirceGradeMinus2, peirceQP, peirceGradeMinus1, peirceRP, peirceQR]
  exact kkt_minus_two_minus_one_bracket_zero
    (P N_plus) (Q N_plus) (peirceR N_plus) X Y hPQ hPR hRQ

