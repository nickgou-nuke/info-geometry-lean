+/-- Exact closure from logarithmic coordinates to infinitesimal and finite
+adjoint weights on the two parabolic sheets. -/
+theorem pristine_logarithmic_adjoint_flow_core
+    {s : ℂ} (hs : s ∈ punctured01) :
