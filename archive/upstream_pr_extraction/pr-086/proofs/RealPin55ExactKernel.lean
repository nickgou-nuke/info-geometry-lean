/-! # Exact kernel of the real `Pin(5,5) → O(5,5)` representation -/

noncomputable section
namespace RealPin55ExactKernel

open Clifford55
open V55Fin10Coordinates
open RealPin55Core
open RealPin55OrthogonalAction
open RealPin55MatrixRepresentation
open RealPin55Kernel
open RealPin55KernelReduction
open Clifford55PBWMonomials
open Clifford55CenterAnticenter

/-- Every word generated by normalized split Clifford vectors has reversion
norm `+1` or `-1`. -/
theorem fullPin55_reverse_norm_sign (g : FullPin55) :
    CliffordAlgebra.reverse (g.1 : Cl55) * (g.1 : Cl55) = 1 ∨
      CliffordAlgebra.reverse (g.1 : Cl55) * (g.1 : Cl55) = -1 := by
  let p : ∀ u : Cl55ˣ, u ∈ FullPin55 → Prop := fun u _ =>
    CliffordAlgebra.reverse (u : Cl55) * (u : Cl55) = 1 ∨
      CliffordAlgebra.reverse (u : Cl55) * (u : Cl55) = -1
  have hp : p g.1 g.2 := by
    apply Subgroup.closure_induction'' (p := p)
    · intro u hu
      rcases hu with ⟨a, ha, hua⟩
      change CliffordAlgebra.reverse (u : Cl55) * (u : Cl55) = 1 ∨ _
      rw [hua, CliffordAlgebra.reverse_ι, CliffordAlgebra.ι_sq_scalar]
      rcases ha with h | h
      · left; simp [h]
      · right; simp [h]
    · intro u hu
      rcases hu with ⟨a, ha, hua⟩
      change CliffordAlgebra.reverse ((u⁻¹ : Cl55ˣ) : Cl55) *
          ((u⁻¹ : Cl55ˣ) : Cl55) = 1 ∨ _
      rcases ha with hpos | hneg
      · rw [normalized_unit_inverse_pos hua hpos,
          CliffordAlgebra.reverse_ι, CliffordAlgebra.ι_sq_scalar, hpos]
        left; simp
      · rw [normalized_unit_inverse_neg hua hneg, map_neg,
          CliffordAlgebra.reverse_ι, neg_mul_neg,
          CliffordAlgebra.ι_sq_scalar, hneg]
        right; simp
    · left
      simp
    · intro x y hx hy hnx hny
      change CliffordAlgebra.reverse ((x * y : Cl55ˣ) : Cl55) *
          ((x * y : Cl55ˣ) : Cl55) = 1 ∨ _
      simp only [Units.val_mul, CliffordAlgebra.reverse.map_mul]
      rcases hnx with hxp | hxn <;> rcases hny with hyp | hyn
      · left
        calc
          CliffordAlgebra.reverse (y : Cl55) * CliffordAlgebra.reverse (x : Cl55) *
              ((x : Cl55) * (y : Cl55)) =
              CliffordAlgebra.reverse (y : Cl55) *
                (CliffordAlgebra.reverse (x : Cl55) * (x : Cl55)) * (y : Cl55) := by
                  noncomm_ring
          _ = 1 := by rw [hxp]; simpa using hyp
      · right
        calc
          CliffordAlgebra.reverse (y : Cl55) * CliffordAlgebra.reverse (x : Cl55) *
              ((x : Cl55) * (y : Cl55)) =
              CliffordAlgebra.reverse (y : Cl55) *
                (CliffordAlgebra.reverse (x : Cl55) * (x : Cl55)) * (y : Cl55) := by
                  noncomm_ring
          _ = -1 := by rw [hxp]; simpa using hyn
      · right
        calc
          CliffordAlgebra.reverse (y : Cl55) * CliffordAlgebra.reverse (x : Cl55) *
              ((x : Cl55) * (y : Cl55)) =
              CliffordAlgebra.reverse (y : Cl55) *
                (CliffordAlgebra.reverse (x : Cl55) * (x : Cl55)) * (y : Cl55) := by
                  noncomm_ring
          _ = -1 := by rw [hxn]; simpa using congrArg Neg.neg hyp
      · left
        calc
          CliffordAlgebra.reverse (y : Cl55) * CliffordAlgebra.reverse (x : Cl55) *
              ((x : Cl55) * (y : Cl55)) =
              CliffordAlgebra.reverse (y : Cl55) *
                (CliffordAlgebra.reverse (x : Cl55) * (x : Cl55)) * (y : Cl55) := by
                  noncomm_ring
          _ = 1 := by rw [hxn]; simpa using congrArg Neg.neg hyn
    · exact g.2
  exact hp

theorem involute_gradeOddPart (x : Cl55) :
    CliffordAlgebra.involute (gradeOddPart x) = -gradeOddPart x := by
  simp [gradeOddPart, map_sub, map_smul, CliffordAlgebra.involute_involute]
  module

/-- A kernel element is a scalar Clifford unit. -/
theorem kernel_element_is_scalar {g : FullPin55}
    (hg : g ∈ MonoidHom.ker fullPinToO55) :
    ∃ c : ℝ, (g.1 : Cl55) = algebraMap ℝ Cl55 c := by
  have heven : ∃ c : ℝ,
      gradeEvenPart (g.1 : Cl55) = algebraMap ℝ Cl55 c := by
    apply eq_algebraMap_of_commutes_all_gamma
    intro j
    simpa [gamma55] using (kernel_even_commutes hg (fin10Basis55 j)).symm
  have hoddline : ∃ d : ℝ,
      gradeOddPart (g.1 : Cl55) = d • cliffordMonomial55 Finset.univ := by
    apply eq_smul_volume_of_anticommutes_all_gamma
    intro j
    have h := kernel_odd_anticommutes hg (fin10Basis55 j)
    simpa [gamma55] using congrArg Neg.neg h.symm
  obtain ⟨c, hc⟩ := heven
  obtain ⟨d, hd⟩ := hoddline
  have hio := involute_gradeOddPart (g.1 : Cl55)
  rw [hd, map_smul, involute_volume55] at hio
  have hoddzero : gradeOddPart (g.1 : Cl55) = 0 := by
    have hself : gradeOddPart (g.1 : Cl55) = -gradeOddPart (g.1 : Cl55) := by
      rw [hd]
      exact hio
    have hadd : gradeOddPart (g.1 : Cl55) + gradeOddPart (g.1 : Cl55) = 0 :=
      add_eq_zero_iff_eq_neg.mpr hself
    have htwo : (2 : ℝ) • gradeOddPart (g.1 : Cl55) = 0 := by
      simpa [two_smul ℝ] using hadd
    rcases smul_eq_zero.mp htwo with hfalse | hz
    · norm_num at hfalse
    · exact hz
  refine ⟨c, ?_⟩
  calc
    (g.1 : Cl55) = gradeEvenPart (g.1 : Cl55) + gradeOddPart (g.1 : Cl55) :=
      (gradeEven_add_gradeOdd _).symm
    _ = algebraMap ℝ Cl55 c := by rw [hc, hoddzero, add_zero]

/-- Reverse inclusion: the representation kernel contains no scalar other
than the two central signs. -/
theorem kernel_le_centralSignSubgroup :
    MonoidHom.ker fullPinToO55 ≤ centralSignSubgroup := by
  intro g hg
  obtain ⟨c, hc⟩ := kernel_element_is_scalar hg
  have hn := fullPin55_reverse_norm_sign g
  rw [hc, CliffordAlgebra.reverse.commutes, ← map_mul] at hn
  have hcscalar : c * c = 1 := by
    rcases hn with hp | hn
    · exact FaithfulSMul.algebraMap_injective ℝ Cl55 (by simpa using hp)
    · have hneg : c * c = -1 :=
        FaithfulSMul.algebraMap_injective ℝ Cl55 (by simpa using hn)
      nlinarith [sq_nonneg c]
  rw [mem_centralSignSubgroup_iff]
  rcases mul_self_eq_one_iff.mp hcscalar with rfl | rfl
  · left
    apply Subtype.ext
    apply Units.ext
    simpa using hc
  · right
    apply Subtype.ext
    apply Units.ext
    simpa using hc

/-- Exact kernel of the full real split Pin representation. -/
theorem fullPinToO55_kernel_exact :
    MonoidHom.ker fullPinToO55 = centralSignSubgroup := by
  apply le_antisymm kernel_le_centralSignSubgroup centralSignSubgroup_le_kernel

/-! ## Quotient form of the first isomorphism theorem -/

/-- The central-sign subgroup is normal because it is the kernel of the native
orthogonal representation. -/
instance centralSignSubgroup_normal :
    centralSignSubgroup.Normal := by
  rw [← fullPinToO55_kernel_exact]
  infer_instance

/-- The real split Pin group modulo its exact central sign kernel is
canonically equivalent to the range of its orthogonal representation. -/
def fullPin55QuotientEquivRange :
    FullPin55 ⧸ centralSignSubgroup ≃*
      MonoidHom.range fullPinToO55 := by
  exact
    (QuotientGroup.quotientMulEquivOfEq
      (G := FullPin55) fullPinToO55_kernel_exact.symm).trans
      (QuotientGroup.quotientKerEquivRange fullPinToO55)

/-- Descriptive alias for the first-isomorphism equivalence by the central
sign subgroup. -/
noncomputable def fullPin55SignQuotientEquivRange :
    FullPin55 ⧸ centralSignSubgroup ≃*
      MonoidHom.range fullPinToO55 :=
  fullPin55QuotientEquivRange

/-- Literal form of the exact kernel theorem. -/
theorem mem_fullPinToO55_kernel_iff (g : FullPin55) :
    g ∈ MonoidHom.ker fullPinToO55 ↔ g = 1 ∨ g = pinNegOne := by
  rw [fullPinToO55_kernel_exact, mem_centralSignSubgroup_iff]

/-- Pointwise form of the exact kernel theorem. -/
@[simp] theorem fullPinToO55_eq_one_iff (g : FullPin55) :
    fullPinToO55 g = 1 ↔ g = 1 ∨ g = pinNegOne := by
  simpa only [MonoidHom.mem_ker] using
    mem_fullPinToO55_kernel_iff g

/-- The central-sign inclusion is exactly the kernel of the representation. -/
theorem centralSignSubgroup_fullPinToO55_mulExact :
    Function.MulExact centralSignSubgroup.subtype fullPinToO55 := by
  rw [MonoidHom.mulExact_iff, Subgroup.range_subtype,
    fullPinToO55_kernel_exact]

/-- The quotient equivalence sends a class to the corresponding orthogonal
image. -/
@[simp] theorem fullPin55QuotientEquivRange_mk (g : FullPin55) :
    fullPin55QuotientEquivRange (QuotientGroup.mk g) =
      fullPinToO55.rangeRestrict g :=
  rfl

@[simp] theorem fullPin55SignQuotientEquivRange_mk (g : FullPin55) :
    fullPin55SignQuotientEquivRange (QuotientGroup.mk g) =
      fullPinToO55.rangeRestrict g :=
  rfl

end RealPin55ExactKernel
end noncomputable section
