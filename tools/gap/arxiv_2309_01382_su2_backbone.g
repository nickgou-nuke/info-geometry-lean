# GAP exact algebraic/group-theoretic backbone for arXiv:2309.01382v1.
# Checks the rational spin-half su(2) commutator matrices and a finite mod-3
# group shadow generated by the raising/lowering transvections.

Jp := [[0,1],[0,0]];;
Jm := [[0,0],[1,0]];;
J0twice := [[1,0],[0,-1]];;

MatAdd := function(A,B)
  return List([1..Length(A)], i -> List([1..Length(A[i])], j -> A[i][j] + B[i][j]));
end;;
MatSub := function(A,B)
  return List([1..Length(A)], i -> List([1..Length(A[i])], j -> A[i][j] - B[i][j]));
end;;
MatMul := function(A,B)
  local n, m, p;
  n := Length(A);; m := Length(B[1]);; p := Length(B);;
  return List([1..n], i -> List([1..m], j -> Sum([1..p], k -> A[i][k] * B[k][j])));
end;;
MatComm := function(A,B) return MatSub(MatMul(A,B), MatMul(B,A)); end;;
Neg := function(A) return List(A, row -> List(row, x -> -x)); end;;

if MatComm(Jp,Jm) <> J0twice then Error("[Jp,Jm] failed"); fi;
if MatComm(J0twice,Jp) <> [[0,2],[0,0]] then Error("[2J0,Jp] failed"); fi;
if MatComm(J0twice,Jm) <> [[0,0],[-2,0]] then Error("[2J0,Jm] failed"); fi;

P := [[0,1],[1,0]];;
I2 := [[1,0],[0,1]];;
if MatMul(P,P) <> I2 then Error("parity involution failed"); fi;

F := GF(3);;
A := [[Z(3)^0, Z(3)^0], [0*Z(3), Z(3)^0]];;
B := [[Z(3)^0, 0*Z(3)], [Z(3)^0, Z(3)^0]];;
G := Group([A,B]);;
if Size(G) <> 24 then Error("mod-3 transvection shadow should have order 24"); fi;

Print("ARXIV_2309_01382_GAP_SU2_BACKBONE_OK\n");
Print("commutators=rational_exact\n");
Print("mod3_shadow_order=", Size(G), "\n");
QUIT;
