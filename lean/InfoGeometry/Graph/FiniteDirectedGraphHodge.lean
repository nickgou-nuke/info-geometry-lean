  fin_cases edge <;>
    norm_num [recordedCycleExportedLink, recordedCycleLeftParents,
      recordedCycleRightParents, recordedCycleRootRef,
      recordedCycleLeftRef, recordedCycleRightRef, orderedParentLinkAt]

