[Unit]
Description=Hive audit gate worker %i
After=network-online.target
Wants=network-online.target
PartOf=hive-beehive.target

[Service]
Type=simple
WorkingDirectory=/home/goutev/repos/info-geometry-lean
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/info-geometry-lean/hive.env
ExecStart=/usr/bin/env python3 /home/goutev/repos/info-geometry-lean/tools/infra/hive_audit_worker.py --worker-id audit-%i --poll-interval 15
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=hive-beehive.target
