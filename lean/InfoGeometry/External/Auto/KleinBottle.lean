import Mathlib.Tactic

open Complex

namespace InfoGeometry.External.Auto.KleinBottle

/-!
# The Klein Bottle Geometry and Möbius Symmetry

This file formalizes the geometric construction of the Klein bottle as a quotient
of the complex plane. This represents the global topological structure of the 
aperiodic quasicrystal space when subjected to the modular conjugation `J` 
(which acts as complex conjugation / orientation reversal).

The fundamental group of the Klein bottle is generated by two transformations:
1. `T`: A pure translation in the imaginary direction.
2. `G`: A glide reflection in the real direction (translation + complex conjugation).

This rigorously connects the local pentagonal projections and the Möbius symmetry 
(orientation reversal) to the global non-orientable topology.
-/

/-- Pure translation along the imaginary axis (loop 1) -/
def T (z : ℂ) : ℂ := z + Complex.I

/-- Glide reflection along the real axis (loop 2, orientation reversing) 
    Notice the complex conjugation `star z` representing the modular operator J. -/
def G (z : ℂ) : ℂ := star z + 1

/-- The inverse of T -/
def T_inv (z : ℂ) : ℂ := z - Complex.I

/-- The defining relation of the Klein bottle fundamental group:
    Translating then glide-reflecting is equivalent to 
    glide-reflecting then translating in the REVERSE direction.
    Mathematically: G ∘ T = T⁻¹ ∘ G -/
theorem klein_bottle_relation (z : ℂ) : G (T z) = T_inv (G z) := by
  simp [G, T, T_inv]
  ring

/-- The composition of two glide reflections is a pure translation by 2. 
    This shows the orientable double cover of the Klein bottle is a Torus. -/
theorem glide_reflection_sq (z : ℂ) : G (G z) = z + 2 := by
  simp [G]
  ring

/-!
## Non-Orientable Orbifold Singularities

While the Klein bottle action is free, introducing localized point symmetries
(like a pure reflection or a half-turn) turns the quotient space into an orbifold.
These elements have fixed points (singularities in the orbifold).
-/

/-- Pure mirror reflection along the real axis.
    This generates an orbifold boundary (a "mirror line"). -/
def M (z : ℂ) : ℂ := star z

/-- Half-turn rotation (by π). 
    This generates a cone point singularity of order 2 in the orbifold. -/
def H (z : ℂ) : ℂ := -z

/-- The real line is exactly the set of fixed points for the mirror reflection,
    forming the boundary of the non-orientable orbifold. -/
theorem mirror_fixed_points (x : ℝ) : M (x : ℂ) = (x : ℂ) := by
  simp [M]

/-- A mirror reflection is order two, the local group of an orbifold mirror. -/
theorem mirror_involution (z : ℂ) : M (M z) = z := by
  simp [M]

/-- The origin is the unique fixed point of the half-turn, 
    forming an orbifold cone point. -/
theorem cone_point_origin : H 0 = 0 := by
  simp [H]

/-- A half-turn is order two, the local group of a cone point of order 2. -/
theorem half_turn_involution (z : ℂ) : H (H z) = z := by
  simp [H]

/-- The glide reflection G is composed of the mirror reflection M
    followed by a translation by 1. -/
theorem glide_is_mirror_translated (z : ℂ) : G z = M z + 1 := by
  rfl

/-- The glide is orientation reversing but has square a pure translation. -/
theorem glide_square_translation (z : ℂ) : G (G z) = z + 2 := by
  exact glide_reflection_sq z

/-- Local symmetry types for the non-orientable orbifold quotient. -/
inductive OrbifoldLocalSymmetry where
  | mirrorBoundary
  | conePointOrderTwo
  | glideTwist
  deriving DecidableEq, Repr

/-- Orientation character: mirrors and glides reverse orientation; half-turns preserve it. -/
def orientationSign : OrbifoldLocalSymmetry → ℤ
  | OrbifoldLocalSymmetry.mirrorBoundary => -1
  | OrbifoldLocalSymmetry.conePointOrderTwo => 1
  | OrbifoldLocalSymmetry.glideTwist => -1

theorem mirror_orientation_reversing :
    orientationSign OrbifoldLocalSymmetry.mirrorBoundary = -1 := rfl

theorem cone_point_orientation_preserving :
    orientationSign OrbifoldLocalSymmetry.conePointOrderTwo = 1 := rfl

theorem glide_orientation_reversing :
    orientationSign OrbifoldLocalSymmetry.glideTwist = -1 := rfl

/-- Non-orientable orbifold theorem: the Klein relation, double cover,
    mirror/cone local groups, fixed singular points, and orientation signs. -/
theorem non_orientable_orbifold_theorem :
    (∀ z, G (T z) = T_inv (G z)) ∧
    (∀ z, G (G z) = z + 2) ∧
    (∀ z, M (M z) = z) ∧
    (∀ z, H (H z) = z) ∧
    M (0 : ℂ) = 0 ∧
    H (0 : ℂ) = 0 ∧
    orientationSign OrbifoldLocalSymmetry.mirrorBoundary = -1 ∧
    orientationSign OrbifoldLocalSymmetry.glideTwist = -1 := by
  exact ⟨klein_bottle_relation, glide_reflection_sq, mirror_involution,
    half_turn_involution, by simp [M], cone_point_origin,
    mirror_orientation_reversing, glide_orientation_reversing⟩

end InfoGeometry.External.Auto.KleinBottle
