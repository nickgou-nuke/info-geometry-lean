import Mathlib.Algebra.Ring.Defs
import Mathlib.Tactic.Basic
import Mathlib

/-!
# InfoGeometry.Arithmetic.ArithmeticSuperchargeHopfBridge

Finite algebraic supercharge bridge for the arithmetic binary lattice.

This module formalizes a conservative part of the "supercharge hopping"
picture:

* `Γ` is a parity involution;
* `Q` is odd with respect to `Γ`;
* `Q² = H`;
* therefore `H` is even: it commutes with `Γ`.

The Hopf/CFT/BRST/Schroedinger/RH interpretations are represented as witness
gates.  No RH theorem, zero-location theorem, or spectral-density theorem is
asserted here.
-/

noncomputable section

namespace InfoGeometry.Arithmetic.ArithmeticSuperchargeHopfBridge

/-! ## 1. Algebraic supercharge packet -/

/--
Parity/supercharge/Hamiltonian packet in an abstract operator ring.

`Γ` is the square-free/Möbius parity involution, `Q` is the odd supercharge,
and `H` is its square.
-/
structure ParitySuperchargePacket
    (Op : Type*) [Ring Op] where
  parity : Op
  supercharge : Op
  hamiltonian : Op
  parity_sq :
    parity * parity = 1
  supercharge_odd :
    supercharge * parity = -parity * supercharge
  squareLaw :
    supercharge * supercharge = hamiltonian

namespace ParitySuperchargePacket

variable
    {Op : Type*} [Ring Op]
    (P : ParitySuperchargePacket Op)

/--
The square of an odd supercharge commutes with parity.

This is the formal algebraic content of "two fermionic hops return to the
original parity sector".
-/
theorem supercharge_sq_commutes_with_parity :
    (P.supercharge * P.supercharge) * P.parity =
      P.parity * (P.supercharge * P.supercharge) := by
  calc
    (P.supercharge * P.supercharge) * P.parity
        = P.supercharge * (P.supercharge * P.parity) := by
            rw [mul_assoc]
    _ = P.supercharge * ((-P.parity) * P.supercharge) := by
            rw [P.supercharge_odd]
    _ = (P.supercharge * (-P.parity)) * P.supercharge := by
            rw [← mul_assoc]
    _ = (-(P.supercharge * P.parity)) * P.supercharge := by
            rw [mul_neg]
    _ = (-((-P.parity) * P.supercharge)) * P.supercharge := by
            rw [P.supercharge_odd]
    _ = (P.parity * P.supercharge) * P.supercharge := by
            simp [neg_mul]
    _ = P.parity * (P.supercharge * P.supercharge) := by
            rw [mul_assoc]

/-- The Hamiltonian generated by `Q²` is parity-even. -/
theorem hamiltonian_commutes_with_parity :
    P.hamiltonian * P.parity = P.parity * P.hamiltonian := by
  rw [← P.squareLaw]
  exact P.supercharge_sq_commutes_with_parity

/--
The supercharge commutes with the Hamiltonian generated by its square.

This is the algebraic conservation law `[Q,H] = 0`: from `H = Q²`, associativity
alone gives `QH = HQ`.
-/
theorem supercharge_commutes_with_hamiltonian :
    P.supercharge * P.hamiltonian = P.hamiltonian * P.supercharge := by
  calc
    P.supercharge * P.hamiltonian =
        P.supercharge * (P.supercharge * P.supercharge) := by
          rw [← P.squareLaw]
    _ = (P.supercharge * P.supercharge) * P.supercharge := by
          rw [mul_assoc]
    _ = P.hamiltonian * P.supercharge := by
          rw [P.squareLaw]

end ParitySuperchargePacket

/-! ## 2. Concrete Instantiation -/

/-- A trivial instantiation of the supercharge packet on the integers, 
showing the structure is non-vacuous. -/
def trivialPacket : ParitySuperchargePacket ℤ where
  parity := 1
  supercharge := 0
  hamiltonian := 0
  parity_sq := by simp
  supercharge_odd := by simp
  squareLaw := by simp

end InfoGeometry.Arithmetic.ArithmeticSuperchargeHopfBridge
