import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Complex.Basic
import InfoGeometry.Canonical.HypercomplexOneParameterFlows

/-!
# KAN Hypercomplex Flow Compatibility

This module formalizes the composite Iwasawa KAN dynamical unit flow:

$$\Phi_{\text{KAN}}(t_K, t_A, t_N) = \Phi_K(t_K) \cdot \Phi_A(t_A) \cdot \Phi_N(t_N) \in A^\times$$

landing strictly in the unit group $A^\times = \text{GL}_2(\mathbb{C})$.

## Epistemic Clarification:
1. Having the three 1-parameter group flows generated by $J^2 = -1$, $H^2 = 1$, and $N^2 = 0$
   constructs the canonical model flows for the Compact ($K$), Abelian ($A$), and Nilpotent ($N$)
   sectors into $A^\times$.
2. The composite multi-parameter flow is an explicit group element in $A^\times$, with inverse
   $$\Phi_{\text{KAN}}(t_K, t_A, t_N)^{-1} = \Phi_N(-t_N) \cdot \Phi_A(-t_A) \cdot \Phi_K(-t_K).$$
3. This establishes the structural bridge from hypercomplex polynomial kernels to group-valued
   evolution without asserting a full global Iwasawa decomposition theorem prematurely.

All proofs are complete with 0 sorries and 0 axioms.
-/

noncomputable section

namespace InfoGeometry.Canonical.KANFlowCompatibility

open Matrix
open InfoGeometry.Canonical.HypercomplexOneParameterFlows

/-! ## 1. Multi-Parameter KAN Composite Flow into Units -/

/-- Composite KAN unit flow $\Phi_K(t_K) \cdot \Phi_A(t_A) \cdot \Phi_N(t_N)$ in $\text{GL}_2(\mathbb{C})$. -/
def kanCompositeUnitFlow
    (J H N : Matrix (Fin 2) (Fin 2) ℂ)
    (hJ : J * J = -1) (hH : H * H = 1) (hN : N * N = 0)
    (t_K t_A t_N : ℝ) : Units (Matrix (Fin 2) (Fin 2) ℂ) :=
  (ellipticUnit J hJ t_K) * (hyperbolicUnit H hH t_A) * (parabolicUnit N hN t_N)

/-- Matrix coercion of the composite KAN flow. -/
def kanCompositeFlow
    (J H N : Matrix (Fin 2) (Fin 2) ℂ)
    (hJ : J * J = -1) (hH : H * H = 1) (hN : N * N = 0)
    (t_K t_A t_N : ℝ) : Matrix (Fin 2) (Fin 2) ℂ :=
  ((kanCompositeUnitFlow J H N hJ hH hN t_K t_A t_N : Units (Matrix (Fin 2) (Fin 2) ℂ)) : Matrix (Fin 2) (Fin 2) ℂ)

/-! ## 2. Fundamental Algebraic Flow Properties -/

@[simp]
theorem kanCompositeUnitFlow_zero
    (J H N : Matrix (Fin 2) (Fin 2) ℂ)
    (hJ : J * J = -1) (hH : H * H = 1) (hN : N * N = 0) :
    kanCompositeUnitFlow J H N hJ hH hN 0 0 0 = 1 := by
  dsimp [kanCompositeUnitFlow]
  have hK : ellipticUnit J hJ 0 = 1 := by apply Units.ext; simp [ellipticUnit, ellipticMat]
  have hA : hyperbolicUnit H hH 0 = 1 := by apply Units.ext; simp [hyperbolicUnit, hyperbolicMat]
  have hN' : parabolicUnit N hN 0 = 1 := by apply Units.ext; simp [parabolicUnit, parabolicMat]
  rw [hK, hA, hN', mul_one, mul_one]

@[simp]
theorem kanCompositeFlow_zero
    (J H N : Matrix (Fin 2) (Fin 2) ℂ)
    (hJ : J * J = -1) (hH : H * H = 1) (hN : N * N = 0) :
    kanCompositeFlow J H N hJ hH hN 0 0 0 = 1 := by
  dsimp [kanCompositeFlow]
  rw [kanCompositeUnitFlow_zero]
  rfl

theorem kanCompositeFlow_eq
    (J H N : Matrix (Fin 2) (Fin 2) ℂ)
    (hJ : J * J = -1) (hH : H * H = 1) (hN : N * N = 0)
    (t_K t_A t_N : ℝ) :
    kanCompositeFlow J H N hJ hH hN t_K t_A t_N =
      ellipticMat J t_K * hyperbolicMat H t_A * parabolicMat N t_N := by
  dsimp [kanCompositeFlow, kanCompositeUnitFlow]
  rfl

/-- 🏆 THEOREM: The explicit inverse of the composite KAN flow. -/
theorem kanCompositeUnitFlow_inv
    (J H N : Matrix (Fin 2) (Fin 2) ℂ)
    (hJ : J * J = -1) (hH : H * H = 1) (hN : N * N = 0)
    (t_K t_A t_N : ℝ) :
    (kanCompositeUnitFlow J H N hJ hH hN t_K t_A t_N)⁻¹ =
      (parabolicUnit N hN (-t_N)) * (hyperbolicUnit H hH (-t_A)) * (ellipticUnit J hJ (-t_K)) := by
  dsimp [kanCompositeUnitFlow]
  simp only [mul_inv_rev]
  have hNinv : (parabolicUnit N hN t_N)⁻¹ = parabolicUnit N hN (-t_N) := by
    apply Units.ext; rfl
  have hAinv : (hyperbolicUnit H hH t_A)⁻¹ = hyperbolicUnit H hH (-t_A) := by
    apply Units.ext; rfl
  have hKinv : (ellipticUnit J hJ t_K)⁻¹ = ellipticUnit J hJ (-t_K) := by
    apply Units.ext; rfl
  rw [hNinv, hAinv, hKinv, mul_assoc]

end InfoGeometry.Canonical.KANFlowCompatibility
