import InfoGeometry.OperatorAlgebra.PeirceSpine.DefectParity

/-!
# Operator time identities (D₃₆)

Five algebraic patterns are assembled from the existing Peirce owners:
the inner derivation generated by `genSig`, the integer unipotent winding,
the lower Peirce block algebra, the star parity of single and double
commutators, and the iterated idempotency defect. These are ring identities;
no analytic one-parameter flow or thermodynamic interpretation is asserted.
-/
namespace InfoGeometry.OperatorAlgebra.PeirceSpine

open InfoGeometry.Core.IdempotentGraphGrassmannian

variable {B : Type*} [Ring B]

/-! ### Five-stage causal order -/

/-- The dependency-ordered stages of the operator-time construction. -/
inductive OperatorTimeStage where
  | modular
  | relationalClock
  | causalBlock
  | starArrow
  | defectEpoch
  deriving DecidableEq, Repr

/-- Rank in the finite dependency order `C₁ ≤ C₂ ≤ C₃ ≤ C₄ ≤ C₅`. -/
def operatorTimeRank : OperatorTimeStage → ℕ
  | .modular => 0
  | .relationalClock => 1
  | .causalBlock => 2
  | .starArrow => 3
  | .defectEpoch => 4

/-- The causal partial order on the five construction stages. -/
def operatorTimePrecedes (a b : OperatorTimeStage) : Prop :=
  operatorTimeRank a ≤ operatorTimeRank b

theorem operator_time_causal_order_is_partial_order :
    (∀ a, operatorTimePrecedes a a) ∧
    (∀ a b, operatorTimePrecedes a b → operatorTimePrecedes b a → a = b) ∧
    (∀ a b c, operatorTimePrecedes a b → operatorTimePrecedes b c →
      operatorTimePrecedes a c) := by
  refine ⟨?_, ?_, ?_⟩
  · intro a
    exact Nat.le_refl _
  · intro a b hab hba
    cases a <;> cases b <;> simp_all [operatorTimePrecedes, operatorTimeRank]
  · intro a b c hab hbc
    exact Nat.le_trans hab hbc

/-! ### C₁: inner modular generator -/

/-- The algebraic modular-time derivation determined by the chiral commutator. -/
def modularTimeDeriv (P A C X : B) : B := comm (genSig P A C) X

/-- The existing tetraktys brackets give the first two modular derivatives;
the second derivative uses the noncentral product `V * V * Φ`. -/
theorem modular_time_on_tetraktys_modes {P : B} (hP : P * P = P) (A C : B) :
    modularTimeDeriv P A C (genPhi P A C) =
        (2 : ℤ) • (genV P A C * genJ P A C) ∧
    modularTimeDeriv P A C (genJ P A C) =
        (2 : ℤ) • (genV P A C * genPhi P A C) ∧
    modularTimeDeriv P A C (modularTimeDeriv P A C (genPhi P A C)) =
        (4 : ℤ) • (genV P A C * genV P A C * genPhi P A C) ∧
    modularTimeDeriv P A C (genSig P A C) = 0 ∧
    modularTimeDeriv P A C (genV P A C) = 0 := by
  have h := archetype_A7_so12_lie_brackets_and_cubic_inversions hP A C
  refine ⟨h.2.1, h.2.2.1, ?_, ?_, ?_⟩
  · unfold modularTimeDeriv
    rw [h.2.1]
    peirce_nf hP
  · unfold modularTimeDeriv comm
    peirce_nf hP
  · unfold modularTimeDeriv comm
    peirce_nf hP

/-! ### Chiral-curvature sandwich actions -/

/-- The forward ordered sandwich generated by the chiral commutator `Σ`. -/
def sigmaSandwichPlus (P A C X : B) : B :=
  (1 + genSig P A C) * X * (1 - genSig P A C)

/-- The reverse ordered sandwich generated by the chiral commutator `Σ`. -/
def sigmaSandwichMinus (P A C X : B) : B :=
  (1 - genSig P A C) * X * (1 + genSig P A C)

/-- The Peirce cone rays and the two mixed tetraktys modes under the forward
`Σ`-sandwich. The metric factor remains the operator polynomial in `V`. -/
theorem sigma_sandwich_forward_modes {P : B} (hP : P * P = P) (A C : B) :
    sigmaSandwichPlus P A C (conePlus P A) =
        ((1 + genV P A C) * (1 + genV P A C)) * conePlus P A ∧
    sigmaSandwichPlus P A C (coneMinus P C) =
        ((1 - genV P A C) * (1 - genV P A C)) * coneMinus P C ∧
    sigmaSandwichPlus P A C (genPhi P A C) =
        (1 + genV P A C * genV P A C) * genPhi P A C +
          (2 : ℤ) • (genV P A C * genJ P A C) ∧
    sigmaSandwichPlus P A C (genJ P A C) =
        (1 + genV P A C * genV P A C) * genJ P A C +
          (2 : ℤ) • (genV P A C * genPhi P A C) := by
  simp only [sigmaSandwichPlus]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> peirce_nf hP

/-- The forward `Σ`-sandwich acts on the even tetraktys modes by the same
left polynomial `1 - V²`; it does not set the defect or curvature to a scalar. -/
theorem sigma_sandwich_forward_even_modes {P : B} (hP : P * P = P) (A C : B) :
    sigmaSandwichPlus P A C (genV P A C) =
        (1 - genV P A C * genV P A C) * genV P A C ∧
    sigmaSandwichPlus P A C (genSig P A C) =
        (1 - genV P A C * genV P A C) * genSig P A C := by
  simp only [sigmaSandwichPlus]
  refine ⟨?_, ?_⟩ <;> peirce_nf hP

/-- The radial multiplier of the `Σ`-sandwich retains the idempotency defect:
`1 - V² = (1 - V) - (V² - V)`. No defect level is selected. -/
theorem sigma_sandwich_radial_factor_exposes_defect (V : B) :
    1 - V * V = (1 - V) - idempotencyDefect V := by
  simp only [idempotencyDefect]
  noncomm_ring

/-- The same ordered curvature sandwich acts on the defect by the radial
factor `1 - V²`; the obstruction is carried through the action. -/
theorem sigma_sandwich_forward_idempotency_defect
    {P : B} (hP : P * P = P) (A C : B) :
    sigmaSandwichPlus P A C (idempotencyDefect (genV P A C)) =
      (1 - genV P A C * genV P A C) * idempotencyDefect (genV P A C) := by
  simp only [sigmaSandwichPlus, idempotencyDefect]
  peirce_nf hP

/-- Every level of the idempotency-defect tower is carried by the same
operator-valued radial multiplier under both ordered curvature sandwiches.
This retains the obstruction at all finite depths. -/
theorem sigma_sandwich_defect_tower_iterates
    {P : B} (hP : P * P = P) (A C : B) (n : ℕ) :
    sigmaSandwichPlus P A C (idempotencyDefect^[n] (genV P A C)) =
      (1 - genV P A C * genV P A C) *
        idempotencyDefect^[n] (genV P A C) ∧
    sigmaSandwichMinus P A C (idempotencyDefect^[n] (genV P A C)) =
      (1 - genV P A C * genV P A C) *
        idempotencyDefect^[n] (genV P A C) := by
  rcases genV_defect_iterate_comm_tetraktys hP A C n with ⟨_, _, hSig⟩
  have hSigSq :=
    (archetype_A3_nilpotent_cones_and_tetraktys_table hP A C).2.2.2.2.2.2.2.2.2.2.1
  let D := idempotencyDefect^[n] (genV P A C)
  have hDSq : D * (genSig P A C * genSig P A C) =
      (genSig P A C * genSig P A C) * D := by
    calc
      D * (genSig P A C * genSig P A C) =
          (D * genSig P A C) * genSig P A C := by rw [mul_assoc]
      _ = (genSig P A C * D) * genSig P A C := by rw [← hSig]
      _ = genSig P A C * (D * genSig P A C) := by rw [← mul_assoc]
      _ = genSig P A C * (genSig P A C * D) := by rw [hSig]
      _ = (genSig P A C * genSig P A C) * D := by rw [mul_assoc]
  have hPlus : sigmaSandwichPlus P A C
      (idempotencyDefect^[n] (genV P A C)) =
      (1 - genV P A C * genV P A C) *
        idempotencyDefect^[n] (genV P A C) := by
    unfold sigmaSandwichPlus
    calc
      (1 + genSig P A C) * idempotencyDefect^[n] (genV P A C) *
          (1 - genSig P A C) =
        idempotencyDefect^[n] (genV P A C) -
          genSig P A C * genSig P A C *
            idempotencyDefect^[n] (genV P A C) := by
          calc
            (1 + genSig P A C) * D * (1 - genSig P A C) =
                D + genSig P A C * D - D * genSig P A C -
                  genSig P A C * D * genSig P A C := by noncomm_ring
            _ = D - (genSig P A C * genSig P A C) * D := by
              calc
                D + genSig P A C * D - D * genSig P A C -
                    genSig P A C * D * genSig P A C =
                  D - (genSig P A C * D) * genSig P A C := by
                    rw [hSig]
                    noncomm_ring
                _ = D - (D * genSig P A C) * genSig P A C := by rw [hSig]
                _ = D - D * (genSig P A C * genSig P A C) := by rw [← mul_assoc]
                _ = D - (genSig P A C * genSig P A C) * D := by rw [hDSq]
            _ = D - genSig P A C * genSig P A C * D := by rw [mul_assoc]
      _ = (1 - genV P A C * genV P A C) *
          idempotencyDefect^[n] (genV P A C) := by
          rw [hSigSq]
          noncomm_ring
  have hMinus : sigmaSandwichMinus P A C
      (idempotencyDefect^[n] (genV P A C)) =
      (1 - genV P A C * genV P A C) *
        idempotencyDefect^[n] (genV P A C) := by
    unfold sigmaSandwichMinus
    calc
      (1 - genSig P A C) * idempotencyDefect^[n] (genV P A C) *
          (1 + genSig P A C) =
        idempotencyDefect^[n] (genV P A C) -
          genSig P A C * genSig P A C *
            idempotencyDefect^[n] (genV P A C) := by
          calc
            (1 - genSig P A C) * D * (1 + genSig P A C) =
                D - genSig P A C * D + D * genSig P A C -
                  genSig P A C * D * genSig P A C := by noncomm_ring
            _ = D - (genSig P A C * genSig P A C) * D := by
              calc
                D - genSig P A C * D + D * genSig P A C -
                    genSig P A C * D * genSig P A C =
                  D - (genSig P A C * D) * genSig P A C := by
                    rw [hSig]
                    noncomm_ring
                _ = D - (D * genSig P A C) * genSig P A C := by rw [hSig]
                _ = D - D * (genSig P A C * genSig P A C) := by rw [← mul_assoc]
                _ = D - (genSig P A C * genSig P A C) * D := by rw [hDSq]
            _ = D - genSig P A C * genSig P A C * D := by rw [mul_assoc]
      _ = (1 - genV P A C * genV P A C) *
          idempotencyDefect^[n] (genV P A C) := by
          rw [hSigSq]
          noncomm_ring
  exact ⟨hPlus, hMinus⟩

/-- The defect contributes both an even and an odd Peirce component after the
`V + Φ` perturbation. This records the obstruction as a source of grades. -/
theorem idempotency_defect_generates_peirce_grades
    {P : B} (hP : P * P = P) (A C : B) :
    evenGrade P (idempotencyDefect (genV P A C + genPhi P A C)) =
      idempotencyDefect (genV P A C) + genV P A C ∧
    oddGrade P (idempotencyDefect (genV P A C + genPhi P A C)) =
      ((2 : ℤ) • genV P A C - 1) * genPhi P A C := by
  exact ⟨even_metric_phi_defect hP A C, odd_metric_phi_defect hP A C⟩

/-- The two curvature-versus-boundary double-derivation mismatches are
proportional to the unfixed idempotency defect. -/
theorem idempotency_defect_generates_double_derivation_anomaly
    {P : B} (hP : P * P = P) (A C : B) :
    derivSqSig P A C (genPhi P A C) - derivSqJ P A C (genPhi P A C) =
      -((4 : ℤ) • (idempotencyDefect (genV P A C) * genPhi P A C)) ∧
    derivSqSig P A C (genJ P A C) - derivSqPhi P A C (genJ P A C) =
      -((4 : ℤ) • (idempotencyDefect (genV P A C) * genJ P A C)) := by
  exact ⟨derivation_mismatch_phi hP A C, derivation_mismatch_j hP A C⟩

/-- Reversing the order of the two curvature factors exchanges the two cone
scalings and reverses the mixing term on the `Φ,J` plane. -/
theorem sigma_sandwich_reverse_modes {P : B} (hP : P * P = P) (A C : B) :
    sigmaSandwichMinus P A C (conePlus P A) =
        ((1 - genV P A C) * (1 - genV P A C)) * conePlus P A ∧
    sigmaSandwichMinus P A C (coneMinus P C) =
        ((1 + genV P A C) * (1 + genV P A C)) * coneMinus P C ∧
    sigmaSandwichMinus P A C (genPhi P A C) =
        (1 + genV P A C * genV P A C) * genPhi P A C -
          (2 : ℤ) • (genV P A C * genJ P A C) ∧
    sigmaSandwichMinus P A C (genJ P A C) =
        (1 + genV P A C * genV P A C) * genJ P A C -
          (2 : ℤ) • (genV P A C * genPhi P A C) := by
  simp only [sigmaSandwichMinus]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> peirce_nf hP

/-- Composing the two ordered `Σ`-sandwiches acts on every ring element by
left and right multiplication by `1 - V²`. -/
theorem sigma_sandwich_reverse_after_forward {P : B} (hP : P * P = P)
    (A C X : B) :
    sigmaSandwichMinus P A C (sigmaSandwichPlus P A C X) =
      (1 - genV P A C * genV P A C) * X *
        (1 - genV P A C * genV P A C) := by
  simp only [sigmaSandwichMinus, sigmaSandwichPlus]
  peirce_nf hP

/-! ### Modular inner derivation on cone modes and corner correlations -/

/-- The inner derivation generated by the Peirce commutator has opposite
operator-valued frequencies on the two directed cones. -/
theorem modular_time_on_cone_modes {P : B} (hP : P * P = P) (A C : B) :
    modularTimeDeriv P A C (conePlus P A) =
      (2 : ℤ) • (genV P A C * conePlus P A) ∧
    modularTimeDeriv P A C (coneMinus P C) =
      -((2 : ℤ) • (genV P A C * coneMinus P C)) := by
  unfold modularTimeDeriv comm
  refine ⟨?_, ?_⟩ <;> peirce_nf hP

/-- Conjugation by the phase generator transports each ordered cross-sheet
corner correlation to the corresponding same-corner sandwich. -/
theorem phase_conjugation_transports_cross_correlations
    {P : B} (hP : P * P = P) (A C X : B) :
    genJ P A C * (conePlus P A * X * coneMinus P C) * (-genJ P A C) =
      qgtMinus P A C * X * qgtMinus P A C ∧
    genJ P A C * (coneMinus P C * X * conePlus P A) * (-genJ P A C) =
      qgtPlus P A C * X * qgtPlus P A C := by
  simp only [qgtPlus, qgtMinus]
  refine ⟨?_, ?_⟩ <;> peirce_nf hP

/-! ### C₃: directed lower-triangular causal operators -/

theorem causal_operator_no_upper_right_corner {P : B} (hP : P * P = P)
    (F L D : B) :
    P * blockLower P F L D * (1 - P) = 0 :=
  blockLower_upper_right hP F L D

theorem causal_operator_composition {P : B} (hP : P * P = P)
    (F₁ L₁ D₁ F₂ L₂ D₂ : B) :
    blockLower P F₁ L₁ D₁ * blockLower P F₂ L₂ D₂ =
      blockLower P (F₁ * P * F₂)
        (L₁ * P * F₂ + D₁ * (1 - P) * L₂)
        (D₁ * (1 - P) * D₂) :=
  blockLower_mul hP F₁ L₁ D₁ F₂ L₂ D₂

/-! ### C₄: star parity of reversible and double-commutator terms -/

def reversibleTime (P A C X : B) : B := comm (genSig P A C) X
def dissipativeTime (P A C X : B) : B :=
  comm (genJ P A C) (comm (genJ P A C) X)
def operatorTimeGenerator (P A C X : B) : B :=
  reversibleTime P A C X + dissipativeTime P A C X

theorem operator_time_star_parity [StarRing B]
    {P : B} (hPs : star P = P) (A X : B) :
    star (reversibleTime P A (star A) X) =
        -reversibleTime P A (star A) (star X) ∧
    star (dissipativeTime P A (star A) X) =
        dissipativeTime P A (star A) (star X) ∧
    star (operatorTimeGenerator P A (star A) X) +
        operatorTimeGenerator P A (star A) (star X) =
      (2 : ℤ) • dissipativeTime P A (star A) (star X) := by
  have hSig := star_genSig (P := P) hPs A
  have hJ := star_genJ (P := P) hPs A
  have hHerm : ∀ H Z : B, star H = H →
      star (comm H Z) = -comm H (star Z) := by
    intro H Z hH
    simp only [comm, star_sub, star_mul, hH, neg_sub]
  have hSkew : ∀ J Z : B, star J = -J →
      star (comm J Z) = comm J (star Z) := by
    intro J Z hJ'
    simp only [comm, star_sub, star_mul, hJ', mul_neg, neg_mul,
      sub_neg_eq_add, add_comm]
    noncomm_ring
  have hR : star (reversibleTime P A (star A) X) =
      -reversibleTime P A (star A) (star X) := by
    exact hHerm _ _ hSig
  have hD : star (dissipativeTime P A (star A) X) =
      dissipativeTime P A (star A) (star X) := by
    unfold dissipativeTime
    rw [hSkew _ _ hJ, hSkew _ _ hJ]
  refine ⟨hR, hD, ?_⟩
  unfold operatorTimeGenerator
  rw [star_add, hR, hD]
  abel

/-! ### C₅: discrete defect epochs -/

theorem defect_epoch_stationary {P : B} (hP : P * P = P)
    (A C : B) (n : ℕ) :
    comm (genSig P A C) (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    comm (genJ P A C) (idempotencyDefect^[n] (genV P A C)) = 0 := by
  rcases genV_defect_iterate_comm_tetraktys hP A C n with ⟨_, hJ, hSig⟩
  constructor
  · unfold comm
    rw [hSig]
    exact sub_self _
  · unfold comm
    rw [hJ]
    exact sub_self _

theorem defect_epoch_operator_time_stationary {P : B}
    (hP : P * P = P) (A C : B) (n : ℕ) :
    reversibleTime P A C (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    dissipativeTime P A C (idempotencyDefect^[n] (genV P A C)) = 0 ∧
    operatorTimeGenerator P A C (idempotencyDefect^[n] (genV P A C)) = 0 := by
  rcases defect_epoch_stationary hP A C n with ⟨hSig, hJ⟩
  have hR : reversibleTime P A C (idempotencyDefect^[n] (genV P A C)) = 0 := hSig
  have hD : dissipativeTime P A C (idempotencyDefect^[n] (genV P A C)) = 0 := by
    unfold dissipativeTime
    rw [hJ]
    simp [comm]
  refine ⟨hR, hD, ?_⟩
  simp [operatorTimeGenerator, hR, hD]

/-! ### C₁ → C₅: dependency-ordered synthesis -/

/-- The algebraic D₃₆ synthesis. The clock component is the existing
`peirceWinding_group_and_charge` theorem, while the remaining conjuncts are
the modular, causal, star-parity, and defect-stationarity consequences. -/
theorem operator_time_archetype_synthesis [StarRing B]
    {P : B} (hP : P * P = P) (hPs : star P = P)
    (A C X F₁ L₁ D₁ F₂ L₂ D₂ : B) (k₁ k₂ : ℤ) (n : ℕ) :
    modularTimeDeriv P A C (genPhi P A C) =
        (2 : ℤ) • (genV P A C * genJ P A C) ∧
    modularTimeDeriv P A C (modularTimeDeriv P A C (genPhi P A C)) =
        (4 : ℤ) • (genV P A C * genV P A C * genPhi P A C) ∧
    peirceWinding k₁ P A * peirceWinding k₂ P A =
        peirceWinding (k₁ + k₂) P A ∧
    peirceWinding k₁ P A * peirceWindingInv k₁ P A = 1 ∧
    peirceWindingCharge P C (peirceWinding k₁ P A)
        (peirceWindingInv k₁ P A) = k₁ • genV P A C ∧
    P * blockLower P F₁ L₁ D₁ * (1 - P) = 0 ∧
    blockLower P F₁ L₁ D₁ * blockLower P F₂ L₂ D₂ =
      blockLower P (F₁ * P * F₂)
        (L₁ * P * F₂ + D₁ * (1 - P) * L₂)
        (D₁ * (1 - P) * D₂) ∧
    star (reversibleTime P A (star A) X) =
        -reversibleTime P A (star A) (star X) ∧
    star (dissipativeTime P A (star A) X) =
        dissipativeTime P A (star A) (star X) ∧
    operatorTimeGenerator P A C (idempotencyDefect^[n] (genV P A C)) = 0 := by
  rcases modular_time_on_tetraktys_modes hP A C with ⟨hM, _, hM2, _, _⟩
  rcases peirceWinding_group_and_charge (P := P) hP A C k₂ k₁ with
    ⟨hW, _, _, _⟩
  rcases peirceWinding_group_and_charge (P := P) hP A C k₁ 0 with
    ⟨_, hWinv, _, hCharge⟩
  have hCausal := causal_operator_no_upper_right_corner hP F₁ L₁ D₁
  have hBlock := causal_operator_composition hP F₁ L₁ D₁ F₂ L₂ D₂
  rcases operator_time_star_parity hPs A X with ⟨hRev, hDiss, _⟩
  rcases defect_epoch_operator_time_stationary hP A C n with ⟨_, _, hEpoch⟩
  exact ⟨hM, hM2, hW, hWinv, hCharge, hCausal, hBlock, hRev, hDiss, hEpoch⟩

end InfoGeometry.OperatorAlgebra.PeirceSpine
