{"type":"new","contents":"/-\nCopyright (c) 2025 Oliver Butterley. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: Oliver Butterley, Yoh Tanimoto\n-/\n\nimport Mathlib\nimport Mathlib.MeasureTheory.VectorMeasure.Basic\n\nopen MeasureTheory\n\nnamespace ComplexRMK\n\nvariable {X : Type*} [MeasurableSpace X]\n\ntheorem exists_l1_eq_withDensity_variation_λ (μ : ComplexMeasure X) (λ : Measure X)\n    [SigmaFinite λ] (hμλ : μ ≪ᵥ λ.toENNRealVectorMeasure) :\n    ∃ h : X → ℂ, Integrable h λ ∧\n    μ = λ.withDensityᵥ h := by\n  let μ_re := MeasureTheory.ComplexMeasure.re μ\n  let μ_im := MeasureTheory.ComplexMeasure.im μ\n  have h_re : μ_re ≪ᵥ λ.toENNRealVectorMeasure := by\n    apply VectorMeasure.AbsolutelyContinuous.mk\n    intro s hmeas hs\n    have : μ s = 0 := enorm_eq_zero.mp (le_antisymm (hμλ hmeas hs) (by positivity))\n    rw [MeasureTheory.ComplexMeasure.re_apply, this, Complex.zero_re]\n  have h_im : μ_im ≪ᵥ λ.toENNRealVectorMeasure := by\n    apply VectorMeasure.AbsolutelyContinuous.mk\n    intro s hmeas hs\n    have : μ s = 0 := enorm_eq_zero.mp (le_antisymm (hμλ hmeas hs) (by positivity))\n    rw [MeasureTheory.ComplexMeasure.im_apply, this, Complex.zero_im]\n  obtain ⟨f_re, hf_re_int, hf_re_eq⟩ := \n    ⟨μ_re.rnDeriv λ, integrable_rnDeriv μ_re λ, \n     μ_re.withDensityᵥ_rnDeriv_eq λ h_re⟩\n  obtain ⟨f_im, hf_im_int, hf_im_eq⟩ := \n    ⟨μ_im.rnDeriv λ, integrable_rnDeriv μ_im λ, \n     μ_im.withDensityᵥ_rnDeriv_eq λ h_im⟩\n  let h (x : X) : ℂ := ⟨f_re x, f_im x⟩\n  use h\n  constructor\n  · exact hf_re_int.complex_ofReal.add (hf_im_int.complex_ofReal.mul_const Complex.I)\n  · ext s hmeas\n    rw [VectorMeasure.withDensityᵥ_apply _ hmeas]\n    · apply Complex.ext\n      · rw [← VectorMeasure.withDensityᵥ_apply hf_re_int hmeas, hf_re_eq, \n            MeasureTheory.ComplexMeasure.re_apply]\n        rfl\n      · rw [← VectorMeasure.withDensityᵥ_apply hf_im_int hmeas, hf_im_eq, \n            MeasureTheory.ComplexMeasure.im_apply]\n        rfl\n    · exact hf_re_int.complex_ofReal.add (hf_im_int.complex_ofReal.mul_const Complex.I)\n\ntheorem exists_l1_eq_withDensity_variation (μ : ComplexMeasure X) :\n    ∃ h : X → ℂ, Integrable h μ.variation ∧\n    μ = μ.variation.withDensityᵥ h := by\n  apply exists_l1_eq_withDensity_variation_λ\n  rw [Measure.toENNRealVectorMeasure_variation]\n  exact VectorMeasure.AbsolutelyContinuous.refl _\n\nend ComplexRMK\n","mtime":1778538031961}