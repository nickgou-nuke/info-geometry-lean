/-!
## Stage I: The Primordial Binary Cut & The Two Faces of One Operator Reality
-/

/-- Complementary shadow idempotent `P_⊥ = 1 - P`. -/
def P_perp (P : B) : B := 1 - P

/-- Cartan grading involution `S_P = P - P_⊥ = 2P - 1`. -/
def S_P (P : B) : B := P - P_perp P

/-- Ring commutator `[X, Y] = X Y - Y X`. -/
def comm (X Y : B) : B := X * Y - Y * X

/-- Ring anticommutator `{X, Y} = X Y + Y X`. -/
def anticomm (X Y : B) : B := X * Y + Y * X

/-- Upper-left diagonal Peirce projection `X_11 = P X P`. -/
def X_11 (P X : B) : B := P * X * P
/-- Lower-right diagonal Peirce projection `X_00 = P_⊥ X P_⊥`. -/
def X_00 (P X : B) : B := P_perp P * X * P_perp P
/-- Upper-right corner Peirce projection `Q_+(X) = P X P_⊥`. -/
def Q_pos (P X : B) : B := P * X * P_perp P
/-- Lower-left corner Peirce projection `Q_-(X) = P_⊥ X P`. -/
def Q_neg (P X : B) : B := P_perp P * X * P

/-- Takesaki Block-Diagonal Conditional Expectation `E_P(X) = P X P + P_⊥ X P_⊥`. -/
def E_diag (P X : B) : B := X_11 P X + X_00 P X

/-- First Commutator (Modular Velocity / Skewness) `J_1(P, X) = [P, X]`. -/
def J_1 (P X : B) : B := comm P X

/-- Second Commutator (Metriplectic Dissipator / Off-Diagonal Bridge) `J_2(P, X) = [P, [P, X]]`. -/
def J_2 (P X : B) : B := comm P (J_1 P X)

/-- Active Core Gravity `V_P(X) = Q_+(X) Q_-(X)`. -/
def V_P (P X : B) : B := Q_pos P X * Q_neg P X
/-- Shadow Core Gravity `Σ_P(X) = Q_-(X) Q_+(X)`. -/
def Sigma_P (P X : B) : B := Q_neg P X * Q_pos P X

/-- Total Diagonal Horizon Gravity `Z_bridge(P, X) = V_P(P, X) + Sigma_P(P, X)`. -/
def Z_bridge (P X : B) : B := V_P P X + Sigma_P P X

/-- Right-associated idempotent helper `P * (P * Z) = P * Z`. -/
lemma proj_idem {P : B} (hP : P * P = P) (Z : B) : P * (P * Z) = P * Z := by
  rw [← mul_assoc, hP]

/-- Theorem 1.1 (`TwoFacesOfOneOperatorRealityTheorem`, Turn 0097):
    Every operator `X : B` is simultaneously governed by its additive Peirce-Takesaki
    splitting and its nested single-commutator ladder:
    1. `X = E_diag P X + J_2 P X` (Additive core + off-diagonal bridge decomposition),
    2. `comm P (E_diag P X) = 0` (The diagonal Takesaki expectation commutes with `P`),
    3. `J_1 P X = Q_pos P X - Q_neg P X` (First commutator is the chiral difference),
    4. `J_2 P X = Q_pos P X + Q_neg P X` (Second commutator is the chiral sum),
    5. `J_2 P X + J_1 P X = 2 • Q_pos P X` and `J_2 P X - J_1 P X = 2 • Q_neg P X`
       (Exact chiral root reconstruction from `J_1` and `J_2` alone!). -/
theorem two_faces_of_one_operator_reality {P : B} (hP : P * P = P) (X : B) :
    X = E_diag P X + J_2 P X ∧
    comm P (E_diag P X) = 0 ∧
    J_1 P X = Q_pos P X - Q_neg P X ∧
    J_2 P X = Q_pos P X + Q_neg P X ∧
    J_2 P X + J_1 P X = 2 • Q_pos P X ∧
    J_2 P X - J_1 P X = 2 • Q_neg P X := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp [E_diag, X_11, X_00, J_2, J_1, P_perp, comm]
    simp only [mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [E_diag, X_11, X_00, P_perp, comm]
    simp only [mul_add, add_mul, mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [J_1, Q_pos, Q_neg, P_perp, comm]
    simp only [mul_sub, sub_mul, mul_one, one_mul]
    abel
  · dsimp [J_2, J_1, Q_pos, Q_neg, P_perp, comm]
    simp only [mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [J_2, J_1, Q_pos, P_perp, comm]
    simp only [mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [J_2, J_1, Q_neg, P_perp, comm]
    simp only [mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel

/-!
## Stage II: The Single-Commutator Power Ladder & `Cl(1,1)` Self-Reproduction (Turn 0095)
-/

/-- Theorem 2.1 (`OmegaSingleCommutatorPowerLadderPoset`, Turn 0095):
    Starting solely from `J_1 = [P, X]` and `J_2 = [P, J_1]` in any `[Ring B]`:
    1. **Period-2 Adjoint Oscillator**: `comm P (J_2 P X) = J_1 P X` (`ad_P³ = ad_P`),
    2. **Symplectic / Elliptic Square of `J_1`**: `J_1 P X * J_1 P X = - Z_bridge P X`,
    3. **Hyperbolic / Bosonic Square of `J_2`**: `J_2 P X * J_2 P X = Z_bridge P X`,
    4. **Zero-Sum Balance Law**: `J_1 P X * J_1 P X + J_2 P X * J_2 P X = 0`,
    5. **Exact `Cl(1,1)` Anticommutation**: `anticomm (J_1 P X) (J_2 P X) = 0`,
    6. **Cartan / Chiral Conversion via `S_P`**:
       `S_P P * J_1 P X = J_2 P X` and `S_P P * J_2 P X = J_1 P X`,
    7. **Isospectral Centrality of `J_2² = Z_bridge`**:
       `comm (Z_bridge P X) P = 0`, `comm (Z_bridge P X) (J_1 P X) = 0`, and
       `comm (Z_bridge P X) (J_2 P X) = 0`,
    8. **Cubic Partial-Isometry Eigenvalue Law**:
       `J_1 P X * J_1 P X * J_1 P X = - (Z_bridge P X * J_1 P X)` and
       `J_2 P X * J_2 P X * J_2 P X = Z_bridge P X * J_2 P X`. -/
theorem single_commutator_power_ladder {P : B} (hP : P * P = P) (X : B) :
    comm P (J_2 P X) = J_1 P X ∧
    J_1 P X * J_1 P X = - Z_bridge P X ∧
    J_2 P X * J_2 P X = Z_bridge P X ∧
    J_1 P X * J_1 P X + J_2 P X * J_2 P X = 0 ∧
    anticomm (J_1 P X) (J_2 P X) = 0 ∧
    S_P P * J_1 P X = J_2 P X ∧
    S_P P * J_2 P X = J_1 P X ∧
    comm (Z_bridge P X) P = 0 ∧
    comm (Z_bridge P X) (J_1 P X) = 0 ∧
    comm (Z_bridge P X) (J_2 P X) = 0 ∧
    J_1 P X * J_1 P X * J_1 P X = - (Z_bridge P X * J_1 P X) ∧
    J_2 P X * J_2 P X * J_2 P X = Z_bridge P X * J_2 P X := by
  have hJ1_sq : J_1 P X * J_1 P X = - Z_bridge P X := by
    dsimp [J_1, Z_bridge, V_P, Sigma_P, Q_pos, Q_neg, P_perp, comm]
    simp only [mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  have hJ2_sq : J_2 P X * J_2 P X = Z_bridge P X := by
    dsimp [J_2, J_1, Z_bridge, V_P, Sigma_P, Q_pos, Q_neg, P_perp, comm]
    simp only [mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  refine ⟨?_, hJ1_sq, hJ2_sq, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp [J_2, J_1, comm]
    simp only [mul_sub, sub_mul, mul_assoc, hP, proj_idem hP]
    abel
  · rw [hJ1_sq, hJ2_sq, neg_add_cancel]
  · dsimp [anticomm, J_1, J_2, comm]
    simp only [mul_sub, sub_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [S_P, P_perp, J_1, J_2, comm]
    simp only [mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [S_P, P_perp, J_1, J_2, comm]
    simp only [mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [comm, Z_bridge, V_P, Sigma_P, Q_pos, Q_neg, P_perp]
    simp only [mul_add, add_mul, mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [comm, Z_bridge, V_P, Sigma_P, Q_pos, Q_neg, J_1, P_perp]
    simp only [mul_add, add_mul, mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  · dsimp [comm, Z_bridge, V_P, Sigma_P, Q_pos, Q_neg, J_2, J_1, P_perp]
    simp only [mul_add, add_mul, mul_sub, sub_mul, mul_one, one_mul, mul_assoc, hP, proj_idem hP]
    abel
  · rw [hJ1_sq, neg_mul]
  · rw [hJ2_sq]

