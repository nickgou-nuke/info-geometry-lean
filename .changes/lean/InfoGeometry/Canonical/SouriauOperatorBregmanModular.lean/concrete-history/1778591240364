{"type":"new","contents":"import InfoGeometry.Canonical.BogoliubovTransport\nimport InfoGeometry.Geometry.OperatorBregmanDivergence\nimport InfoGeometry.Meta.Architecture\n\n/-!\n# Souriau operator Bregman modular bridge\n\nThis file anchors the bounded-operator part of the Souriau/information-geometry\npicture on the repo-native real doubled Krein carrier.\n\nIt formalizes only the bounded roots available here:\n\n* operator product pairings are evaluated by Krein expectation;\n* operatorial Bregman divergence is pulled back along a Souriau representation;\n* a bounded modular Hamiltonian generates a beta-family by `exp((-beta) • K)`;\n* `Delta - I` is the deviation of a bounded modular operator from the identity.\n\nIt does not assert an unbounded logarithm theorem for type-III modular operators,\ntrace formulas, or a full Tomita-Takesaki standard form.\n-/\n\nnoncomputable section\n\nnamespace InfoGeometry.Canonical.SouriauOperatorBregmanModular\n\nopen InfoGeometry.Canonical.BogoliubovTransport\nopen InfoGeometry.Geometry.OperatorBregmanDivergence\n\nvariable {E : Type 0}\nvariable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n\nlocal notation \"H₂\" => InfoGeometry.Krein.DoubledSpace E\nlocal notation \"EndH\" => H₂ →L[ℝ] H₂\n\nnoncomputable local instance : NormedRing EndH := inferInstance\nnoncomputable local instance : NormedAlgebra ℝ EndH := inferInstance\nlocal instance : IsTopologicalRing EndH := inferInstance\nlocal instance : CompleteSpace EndH := inferInstance\n\n/-- Primal bounded operator lane on the real doubled carrier. -/\n@[rep_depth operator]\nabbrev OperatorPrimal : Type := EndH\n\n/-- Dual bounded operator lane, paired with the primal lane by a state expectation. -/\n@[rep_depth operator]\nabbrev OperatorDual : Type := EndH\n\n/-- Krein pairing of one observable against a doubled state. -/\n@[rep_depth thermo]\ndef observablePairing (ψ : H₂) (A : OperatorDual (E := E)) : ℝ :=\n  kreinExpectation (E := E) ψ A\n\n/-- Product pairing: a primal operator and a dual operator are multiplied first. -/\n@[rep_depth thermo]\ndef operatorProductPairing\n    (ψ : H₂) (ρ : OperatorPrimal (E := E)) (H : OperatorDual (E := E)) : ℝ :=\n  kreinExpectation (E := E) ψ (ρ * H)\n\n@[simp]\ntheorem observablePairing_add\n    (ψ : H₂) (A B : OperatorDual (E := E)) :\n    observablePairing (E := E) ψ (A + B) =\n      observablePairing (E := E) ψ A + observablePairing (E := E) ψ B := by\n  simp [observablePairing]\n\n@[simp]\ntheorem observablePairing_sub\n    (ψ : H₂) (A B : OperatorDual (E := E)) :\n    observablePairing (E := E) ψ (A - B) =\n      observablePairing (E := E) ψ A - observablePairing (E := E) ψ B := by\n  simp [observablePairing]\n\n@[simp]\ntheorem observablePairing_smul\n    (ψ : H₂) (c : ℝ) (A : OperatorDual (E := E)) :\n    observablePairing (E := E) ψ (c • A) =\n      c * observablePairing (E := E) ψ A := by\n  simp [observablePairing]\n\n@[simp]\ntheorem operatorProductPairing_zero_right\n    (ψ : H₂) (ρ : OperatorPrimal (E := E)) :\n    operatorProductPairing (E := E) ψ ρ 0 = 0 := by\n  simp [operatorProductPairing, kreinExpectation, InfoGeometry.Krein.KreinSpace.kreinInner_def]\n\n/-- Raw bounded-operator Bregman divergence using the product/Krein pairing. -/\n@[rep_depth thermo]\ndef boundedOperatorBregman\n    (ψ : H₂)\n    (Phi : OperatorPrimal (E := E) → ℝ)\n    (gradPhi : OperatorPrimal (E := E) → OperatorDual (E := E))\n    (X Y : OperatorPrimal (E := E)) : ℝ :=\n  Phi X - Phi Y - operatorProductPairing (E := E) ψ (gradPhi Y) (X - Y)\n\n@[simp]\ntheorem boundedOperatorBregman_self\n    (ψ : H₂)\n    (Phi : OperatorPrimal (E := E) → ℝ)\n    (gradPhi : OperatorPrimal (E := E) → OperatorDual (E := E))\n    (X : OperatorPrimal (E := E)) :\n    boundedOperatorBregman (E := E) ψ Phi gradPhi X X = 0 := by\n  simp [boundedOperatorBregman]\n\n/-- A Souriau representation by bounded operators on the real doubled carrier. -/\n@[rep_depth thermo]\nstructure SouriauOperatorRepresentation (g : Type*) where\n  /-- Infinitesimal generator assigned to an abstract Souriau parameter. -/\n  rep : g → OperatorPrimal (E := E)\n\nnamespace SouriauOperatorRepresentation\n\nvariable {g : Type*} (R : SouriauOperatorRepresentation (E := E) g)\n\n/-- Pull back the bounded-operator Bregman divergence along a Souriau representation. -/\n@[rep_depth thermo]\ndef bregmanPullback\n    (ψ : H₂)\n    (Phi : OperatorPrimal (E := E) → ℝ)\n    (gradPhi : OperatorPrimal (E := E) → OperatorDual (E := E))\n    (ξ η : g) : ℝ :=\n  boundedOperatorBregman (E := E) ψ Phi gradPhi (R.rep ξ) (R.rep η)\n\n@[simp]\ntheorem bregmanPullback_self\n    (ψ : H₂)\n    (Phi : OperatorPrimal (E := E) → ℝ)\n    (gradPhi : OperatorPrimal (E := E) → OperatorDual (E := E))\n    (ξ : g) :\n    R.bregmanPullback ψ Phi gradPhi ξ ξ = 0 := by\n  simp [bregmanPullback]\n\n/-- The bounded modular Hamiltonian generated by a Souriau parameter. -/\n@[rep_depth thermo]\nabbrev modularHamiltonian (ξ : g) : OperatorPrimal (E := E) :=\n  R.rep ξ\n\nend SouriauOperatorRepresentation\n\n/-- Bounded beta-family generated by a modular Hamiltonian `K`. -/\n@[rep_depth thermo]\ndef modularBetaExponential (K : OperatorPrimal (E := E)) (beta : ℝ) : OperatorPrimal (E := E) :=\n  NormedSpace.exp ((-beta) • K)\n\n@[simp]\ntheorem modularBetaExponential_zero\n    (K : OperatorPrimal (E := E)) :\n    modularBetaExponential (E := E) K 0 = 1 := by\n  simp [modularBetaExponential, NormedSpace.exp_zero]\n\n/-- The bounded modular operator at inverse-temperature parameter `beta = 1`. -/\n@[rep_depth thermo]\ndef modularDeltaOfHamiltonian (K : OperatorPrimal (E := E)) : OperatorPrimal (E := E) :=\n  modularBetaExponential (E := E) K 1\n\n@[simp]\ntheorem modularDeltaOfHamiltonian_eq\n    (K : OperatorPrimal (E := E)) :\n    modularDeltaOfHamiltonian (E := E) K = NormedSpace.exp ((-1 : ℝ) • K) := by\n  rfl\n\n/-- `Delta - I`: bounded deviation from the identity operator. -/\n@[rep_depth thermo]\ndef modularDeviation (Delta : OperatorPrimal (E := E)) : OperatorPrimal (E := E) :=\n  Delta - 1\n\n@[simp]\ntheorem modularDeviation_one :\n    modularDeviation (E := E) (1 : OperatorPrimal (E := E)) = 0 := by\n  simp [modularDeviation]\n\n@[simp]\ntheorem modularDeviation_beta_zero\n    (K : OperatorPrimal (E := E)) :\n    modularDeviation (E := E) (modularBetaExponential (E := E) K 0) = 0 := by\n  simp [modularDeviation]\n\n/-- A bounded pair saying that `Delta` is generated by `K` at `beta = 1`. -/\n@[rep_depth thermo]\ndef IsBoundedModularPair\n    (Delta K : OperatorPrimal (E := E)) : Prop :=\n  Delta = modularDeltaOfHamiltonian (E := E) K\n\n/-- Read `Delta - I` through the bounded modular Hamiltonian presentation. -/\n@[rep_depth thermo]\ntheorem modularDeviation_of_boundedPair\n    {Delta K : OperatorPrimal (E := E)}\n    (h : IsBoundedModularPair (E := E) Delta K) :\n    modularDeviation (E := E) Delta = NormedSpace.exp ((-1 : ℝ) • K) - 1 := by\n  rw [h]\n  rfl\n\nnamespace SouriauOperatorRepresentation\n\nvariable {g : Type*} (R : SouriauOperatorRepresentation (E := E) g)\n\n/-- Souriau beta-family of bounded modular operators. -/\n@[rep_depth thermo]\ndef modularBetaFamily (ξ : g) (beta : ℝ) : OperatorPrimal (E := E) :=\n  modularBetaExponential (E := E) (R.modularHamiltonian ξ) beta\n\n@[simp]\ntheorem modularBetaFamily_zero (ξ : g) :\n    R.modularBetaFamily ξ 0 = 1 := by\n  simp [modularBetaFamily]\n\n/-- Souriau `Delta - I` readout at `beta = 1`. -/\n@[rep_depth thermo]\ndef modularDeviationAtOne (ξ : g) : OperatorPrimal (E := E) :=\n  modularDeviation (E := E) (R.modularBetaFamily ξ 1)\n\n@[simp]\ntheorem modularDeviationAtOne_eq (ξ : g) :\n    R.modularDeviationAtOne ξ =\n      NormedSpace.exp ((-1 : ℝ) • R.modularHamiltonian ξ) - 1 := by\n  rfl\n\nend SouriauOperatorRepresentation\n\n/-- Link to the existing regular-cone Bregman root: diagonal divergence vanishes. -/\n@[simp]\ntheorem regularConeBregman_self_readback\n    {c : InfoGeometry.Canonical.CertifiedModularReduction\n      (E := InfoGeometry.Krein.DoubledSpace E)}\n    (ω : OperatorEnd E →L[ℝ] ℝ)\n    (gradPhi : OperatorEnd E → OperatorEnd E →L[ℝ] ℝ)\n    (U : RegularConePoint (E := E) c) :\n    operatorBregmanDivergence (E := E) ω gradPhi U U = 0 := by\n  simpa using operatorBregmanDivergence_self (E := E) ω gradPhi U\n\nend InfoGeometry.Canonical.SouriauOperatorBregmanModular\n","mtime":1778591240364}