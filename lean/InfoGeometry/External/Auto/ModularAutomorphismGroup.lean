import Mathlib.Tactic

/-!
# Modular automorphism group

Tomita--Takesaki modular theory associates to a faithful state `φ` a one-parameter
automorphism group

`σ_t^φ(A)=Δ_φ^{it} A Δ_φ^{-it}`.

In finite dimensions, for a faithful density matrix `ρ`, this is the inner flow

`σ_t(A)=ρ^{it} A ρ^{-it}=exp(-itK) A exp(itK)`, where `K=-log ρ`.

This file proves the algebraic core using an arbitrary group element `u`: conjugation
by powers of `u` is a `ℤ`-parameter automorphism group.
-/

namespace ModularAutomorphismGroup

variable {G : Type*} [Group G]

/-- Inner modular flow generated by a group element `u`, with integer time. -/
def sigma (u : G) (n : ℤ) (a : G) : G := u ^ n * a * (u ^ n)⁻¹

/-- Modular time zero is the identity automorphism. -/
theorem sigma_zero (u a : G) : sigma u 0 a = a := by
  unfold sigma
  simp

/-- Each modular-time map preserves multiplication. -/
theorem sigma_mul (u : G) (n : ℤ) (a b : G) :
    sigma u n (a * b) = sigma u n a * sigma u n b := by
  unfold sigma
  group

/-- Each modular-time map preserves the unit. -/
theorem sigma_one (u : G) (n : ℤ) : sigma u n 1 = 1 := by
  unfold sigma
  group

/-- Inverse modular time is inverse to the flow. -/
theorem sigma_neg_apply (u : G) (n : ℤ) (a : G) :
    sigma u (-n) (sigma u n a) = a := by
  unfold sigma
  group

/-- The modular automorphism group law: `σ_m ∘ σ_n = σ_{m+n}`. -/
theorem sigma_comp (u : G) (m n : ℤ) (a : G) :
    sigma u m (sigma u n a) = sigma u (m + n) a := by
  unfold sigma
  calc
    u ^ m * (u ^ n * a * (u ^ n)⁻¹) * (u ^ m)⁻¹ =
        (u ^ m * u ^ n) * a * (u ^ m * u ^ n)⁻¹ := by group
    _ = u ^ (m + n) * a * (u ^ (m + n))⁻¹ := by rw [← zpow_add u m n]

/-- Reversed composition form: `σ_n ∘ σ_m = σ_{n+m}`. -/
theorem sigma_comp_rev (u : G) (m n : ℤ) (a : G) :
    sigma u n (sigma u m a) = sigma u (m + n) a := by
  rw [add_comm]
  exact sigma_comp u n m a

/-- A modular automorphism group as abstract data. -/
structure ModularFlow (A : Type*) [Monoid A] where
  sigma : ℤ → A → A
  sigma_zero' : ∀ a, sigma 0 a = a
  sigma_mul' : ∀ n a b, sigma n (a * b) = sigma n a * sigma n b
  sigma_one' : ∀ n, sigma n 1 = 1
  sigma_comp' : ∀ m n a, sigma m (sigma n a) = sigma (m + n) a

/-- The inner conjugation flow is a modular-flow model on any group. -/
def innerModularFlow (u : G) : ModularFlow G where
  sigma := sigma u
  sigma_zero' := sigma_zero u
  sigma_mul' := sigma_mul u
  sigma_one' := sigma_one u
  sigma_comp' := sigma_comp u

/-- Main synthesis theorem: algebraic automorphism group. -/
theorem modular_automorphism_group_synthesis (u : G) :
    (∀ a : G, sigma u 0 a = a) ∧
    (∀ n : ℤ, sigma u n 1 = 1) ∧
    (∀ n : ℤ, ∀ a b : G, sigma u n (a * b) = sigma u n a * sigma u n b) ∧
    (∀ m n : ℤ, ∀ a : G, sigma u m (sigma u n a) = sigma u (m + n) a) := by
  exact ⟨sigma_zero u, sigma_one u, sigma_mul u, sigma_comp u⟩

#check sigma_zero
#check sigma_mul
#check sigma_comp
#check innerModularFlow
#check modular_automorphism_group_synthesis

end ModularAutomorphismGroup
