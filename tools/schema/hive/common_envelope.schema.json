{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common_envelope.schema.json",
  "title": "HiveCommonEnvelope",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "lineage_id",
    "revision",
    "origin_run_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "origin_run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_by_agent": {
      "type": "string"
    },
    "agent_role": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "session_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "parent_refs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "source_ref.schema.json"
          }
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "source_ref.schema.json"
          }
        ]
      }
    },
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epistemic_layer": {
      "type": "string",
      "enum": [
        "raw_source",
        "citation",
        "common_unconscious",
        "cognitive_process",
        "semantic",
        "lean_topology",
        "packet_lineage",
        "authority"
      ]
    },
    "psyche_layer": {
      "type": "string",
      "enum": [
        "persona",
        "ego_focus",
        "conscious",
        "personal_unconscious",
        "common_unconscious",
        "collective_unconscious",
        "shadow",
        "self_oriented",
        "unknown"
      ]
    },
    "authority_origin": {
      "type": "string",
      "enum": [
        "source_observation",
        "symbolic_navigation",
        "socratic_interrogation",
        "pauli_differentiation",
        "semantic_navigation",
        "topology_navigation",
        "typed_packet_state",
        "bounded_autoproof_attempt",
        "bounded_autoproof_episode",
        "motherbee_route_decision",
        "gate_record",
        "lean_wrapper",
        "build_gate",
        "audit_gate",
        "promotion_gate"
      ]
    },
    "cognitive_function": {
      "type": "string",
      "enum": [
        "sensation",
        "intuition",
        "thinking",
        "feeling"
      ]
    },
    "jung_function": {
      "type": "string",
      "enum": [
        "sensation",
        "intuition",
        "thinking",
        "feeling"
      ]
    },
    "jung_attitude": {
      "type": "string",
      "enum": [
        "introverted",
        "extraverted",
        "mixed",
        "unknown"
      ]
    },
    "jung_depth": {
      "type": "string",
      "enum": [
        "ego_conscious",
        "personal_unconscious",
        "collective_unconscious",
        "common_unconscious",
        "shadow",
        "self_oriented",
        "unknown"
      ]
    },
    "jung_dynamic": {
      "type": "string",
      "enum": [
        "compensation",
        "projection",
        "differentiation",
        "assimilation",
        "integration",
        "inflation_risk",
        "unknown"
      ]
    },
    "symbolic_stage": {
      "type": "string",
      "enum": [
        "nigredo",
        "albedo",
        "citrinitas",
        "rubedo"
      ]
    },
    "pauli_status": {
      "type": "string",
      "enum": [
        "unaudited",
        "critiqued",
        "blocked",
        "passed",
        "quarantined"
      ]
    },
    "promotion_state": {
      "type": "string",
      "enum": [
        "none",
        "candidate",
        "blocked",
        "held",
        "promoted",
        "quarantined"
      ]
    },
    "pipeline_state": {
      "type": "string",
      "enum": [
        "idle",
        "proposed",
        "checked",
        "audited",
        "promoted",
        "blocked"
      ]
    },
    "active_imagination": {
      "type": "boolean"
    },
    "complex_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "archetype_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shadow_status": {
      "type": "string",
      "enum": [
        "none",
        "suspected",
        "confirmed",
        "integrated",
        "quarantined"
      ]
    },
    "transcendent_function_state": {
      "type": "string",
      "enum": [
        "none",
        "opposition_detected",
        "synthesis_attempted",
        "invariant_extracted"
      ]
    },
    "individuation_state": {
      "type": "string",
      "enum": [
        "unintegrated",
        "cultivating",
        "in_cultivation",
        "packetized",
        "formally_tested",
        "integrated",
        "returned_to_residue"
      ]
    },
    "allowed_uses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_uses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
