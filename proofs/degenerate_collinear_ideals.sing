// Formulate the algebraic ideal resolving degenerate cases (collinear vertices)
ring r = 0, (xA, yA, xB, yB, xC, yC), dp;

// The determinant polynomial defining the collinearity condition (zero area)
poly collin_det = (xB - xA)*(yC - yA) - (xC - xA)*(yB - yA);

// Define the ideal generated by this polynomial
ideal I = collin_det;

// Compute the standard basis (Groebner basis) for the ideal
ideal std_I = std(I);

print("The ideal I represents the variety where points A, B, and C are collinear.");
print("Standard basis of the degenerate collinear ideal:");
print(std_I);
