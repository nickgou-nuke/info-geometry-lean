-- tools/macaulay2/derham_dmodule.m2
-- Algebraically model the score function dQ/Q using D-modules over the Weyl algebra
-- We treat it as a differential operator and evaluate its closed nature d(dQ/Q) = 0

-- Define the Weyl algebra
W = QQ[x, y, Dx, Dy, WeylAlgebra=>{x=>Dx, y=>Dy}]

-- Let Q be a general polynomial, for instance a Gaussian-like exponent
Q = x^2 + y^2

-- The score function S = dQ/Q is the connection 1-form A for the D-module generated by log(Q) or 1/Q.
-- The flat connection is \nabla_i = D_i - A_i = D_i - (D_i Q) / Q
-- To model this in the Weyl algebra with polynomial coefficients, we clear the denominator Q.
-- Let L_i = Q \nabla_i = Q D_i - (D_i Q).
-- This operator L_i is an element of the Weyl algebra W.

-- Compute the partial derivatives of Q
Qx = Dx * Q - Q * Dx
Qy = Dy * Q - Q * Dy

-- Define the scaled connection operators L_x and L_y in the Weyl algebra
Lx = Q * Dx - Qx
Ly = Q * Dy - Qy

-- Evaluate the curvature (commutator) of the scaled connection
-- In a flat connection, [\nabla_x, \nabla_y] = 0.
-- Since L_i = Q \nabla_i, we expect a syzygy instead of a strictly zero commutator,
-- because [Q \nabla_x, Q \nabla_y] = Q^2 [\nabla_x, \nabla_y] + Q (\nabla_x Q) \nabla_y - Q (\nabla_y Q) \nabla_x
-- Using \nabla_i Q = D_i Q - A_i Q = 0 (as an algebraic relation on symbols),
-- the commutator [L_x, L_y] should equal Qx * Ly - Qy * Lx if the curvature is zero.
Commutator = Lx * Ly - Ly * Lx

-- The syzygy expected if d(dQ/Q) = 0
ExpectedSyzygy = Qx * Ly - Qy * Lx

print("--- Score Function Connection in Weyl Algebra ---")
print("L_x: ", Lx)
print("L_y: ", Ly)
print("Commutator [L_x, L_y]: ", Commutator)
print("Expected Syzygy (Qx * Ly - Qy * Lx): ", ExpectedSyzygy)

-- Check if they match, which proves d(dQ/Q) = 0
CurvatureTerm = Commutator - ExpectedSyzygy
print("Curvature Obstruction (should be 0): ", CurvatureTerm)

if CurvatureTerm == 0 then print("SUCCESS: d(dQ/Q) = 0 is algebraically verified in the D-module!") else print("ERROR: Curvature is non-zero.")
