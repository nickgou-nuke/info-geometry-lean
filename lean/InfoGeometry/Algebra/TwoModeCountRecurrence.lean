import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Data.Matrix.Mul
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum
import Lean.Elab.Tactic.Omega

/-! # The specified symmetric/skew count recurrence

This owner proves the integer recurrence generated by the actual transition
matrix `[[3,1],[1,3]]`. It does not identify these values with dimensions of a
Clifford algebra or with spaces of nondegenerate forms.
-/

namespace InfoGeometry.Algebra.TwoModeCountRecurrence

open Matrix

def transition : Matrix (Fin 2) (Fin 2) ℤ := !![3, 1; 1, 3]

def firstModeProjection : Matrix (Fin 2) (Fin 2) ℤ := !![1, 0; 0, 0]

/-- Selecting the first mode before transition differs from selecting it afterward. -/
theorem transition_projection_noncommuting :
    transition * firstModeProjection ≠ firstModeProjection * transition := by
  intro h
  have h01 := congrFun (congrFun h 0) 1
  norm_num [transition, firstModeProjection, Matrix.mul_apply, Fin.sum_univ_two] at h01

/-- Initial state and iteration by the transition operator. -/
def counts : ℕ → Fin 2 → ℤ
  | 0 => ![1, 0]
  | n + 1 => transition.mulVec (counts n)

@[simp] theorem counts_zero_first : counts 0 0 = 1 := rfl
@[simp] theorem counts_zero_second : counts 0 1 = 0 := rfl

theorem counts_succ_first (n : ℕ) :
    counts (n + 1) 0 = 3 * counts n 0 + counts n 1 := by
  simp [counts, transition, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

theorem counts_succ_second (n : ℕ) :
    counts (n + 1) 1 = counts n 0 + 3 * counts n 1 := by
  simp [counts, transition, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- The recurrence is iteration of this matrix, not an unrelated scalar model. -/
theorem counts_eq_power (n : ℕ) :
    counts n = (transition ^ n).mulVec ![1, 0] := by
  induction n with
  | zero => simp [counts]
  | succ n ih =>
    rw [counts, ih, Matrix.mulVec_mulVec, pow_succ']

/-- The sum/difference rows intertwine the transition with a diagonal action over ℤ. -/
theorem sum_difference_intertwining :
    (!![1, 1; 1, -1] : Matrix (Fin 2) (Fin 2) ℤ) * transition =
      !![4, 0; 0, 2] * !![1, 1; 1, -1] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [transition, Matrix.mul_apply, Fin.sum_univ_two]

theorem counts_sum (n : ℕ) : counts n 0 + counts n 1 = (4 : ℤ) ^ n := by
  induction n with
  | zero => norm_num [counts]
  | succ n ih =>
    rw [counts_succ_first, counts_succ_second, pow_succ]
    omega

theorem counts_difference (n : ℕ) : counts n 0 - counts n 1 = (2 : ℤ) ^ n := by
  induction n with
  | zero => norm_num [counts]
  | succ n ih =>
    rw [counts_succ_first, counts_succ_second, pow_succ]
    omega

theorem twice_first (n : ℕ) :
    2 * counts n 0 = (4 : ℤ) ^ n + (2 : ℤ) ^ n := by
  have hs := counts_sum n
  have hd := counts_difference n
  omega

theorem twice_second (n : ℕ) :
    2 * counts n 1 = (4 : ℤ) ^ n - (2 : ℤ) ^ n := by
  have hs := counts_sum n
  have hd := counts_difference n
  omega

theorem counts_nonneg_ordered (n : ℕ) :
    0 ≤ counts n 1 ∧ counts n 1 ≤ counts n 0 := by
  induction n with
  | zero => norm_num [counts]
  | succ n ih =>
    rw [counts_succ_first, counts_succ_second]
    omega

theorem counts_upper_bound (n : ℕ) : counts n 0 ≤ (4 : ℤ) ^ n := by
  have hs := counts_sum n
  have hn := (counts_nonneg_ordered n).1
  omega

theorem spectral_power_bound (n : ℕ) : (2 : ℤ) ^ n ≤ (4 : ℤ) ^ n := by
  have hs := counts_sum n
  have hd := counts_difference n
  have hn := (counts_nonneg_ordered n).1
  omega

end InfoGeometry.Algebra.TwoModeCountRecurrence
