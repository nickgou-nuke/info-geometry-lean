-- 6. ORDER 29: VIRASORO SL₂ WEDGE & OPERATOR-VALUED AFFINE CURRENT ALGEBRA (𝔙𝔄₁–𝔙𝔄₅)
-- ============================================================================

/--
**Theorem 7 (`𝔙𝔄₁`–`𝔙𝔄₂` — Virasoro Mode Commutation on the Tetractys Wedge):**
For any idempotent `P * P = P` and `X, Y : B`, the un-divided Virasoro modes
`L_0 = S_P P`, `L_{-1} = N_plus P X`, and `L_1 = - N_minus P Y` satisfy:
1. `comm (L_zero P) (L_neg1 P X) = L_neg1 P X + L_neg1 P X` (`= 2 • L_{-1}`),
2. `comm (L_zero P) (L_pos1 P Y) = - (L_pos1 P Y + L_pos1 P Y)` (`= -2 • L_1`).
-/
theorem virasoro_wedge_commutation
    (P X Y : B) (hP : P * P = P) :
    let L0  := L_zero P
    let Lm1 := L_neg1 P X
    let Lp1 := L_pos1 P Y
    comm L0 Lm1 = Lm1 + Lm1 ∧
    comm L0 Lp1 = - (Lp1 + Lp1) := by
  refine ⟨?_, ?_⟩ <;>
  · dsimp only [L_zero, L_neg1, L_pos1, S_P, N_plus, N_minus, comm]
    amari_peirce_nf hP

/--
**Theorem 8 (`𝔙𝔄₃` — The Operator-Valued Current Bracket Modulated by `V`):**
The commutator `[L_1, L_{-1}] = [-N_-, N_+] = [N_+, N_-]` is modulated by the operator metric
field `V_met P X Y`:
1. `comm (L_pos1 P Y) (L_neg1 P X) = Sigma_sp P X Y`,
2. `comm (L_pos1 P Y) (L_neg1 P X) = L_zero P * V_met P X Y`,
3. `comm (L_pos1 P Y) (L_neg1 P X) = V_met P X Y * L_zero P`.
-/
theorem operator_valued_current_bracket
    (P X Y : B) (hP : P * P = P) :
    let Lm1 := L_neg1 P X
    let Lp1 := L_pos1 P Y
    let L0  := L_zero P
    let s   := Sigma_sp P X Y
    let v   := V_met P X Y
    comm Lp1 Lm1 = s ∧
    comm Lp1 Lm1 = L0 * v ∧
    comm Lp1 Lm1 = v * L0 := by
  refine ⟨?_, ?_, ?_⟩ <;>
  · dsimp only [L_pos1, L_neg1, L_zero, S_P, V_met, Sigma_sp, Q_pos, Q_neg, N_plus, N_minus, comm]
    amari_peirce_nf hP

/--
**Theorem 9 (`𝔙𝔄₄`–`𝔙𝔄₅` — Operator-Valued `c = 24` Virasoro Anomaly Vanishing & Higher Modes):**
In any associative ring `B` (`[Ring B]`):
1. `VirasoroAnomalyOp24 M = 0` on any tripotent operator `M * M * M = M` (including `S_P P` for
   `P * P = P`, as well as `-1, 0, 1 : B`),
2. Higher mode operator evaluations in `B`:
   `VirasoroAnomalyOp24 (2 • S_P P) = 12 • S_P P`,
   `VirasoroAnomalyOp24 (3 • S_P P) = 48 • S_P P`,
   `VirasoroAnomalyOp24 (2 : B) = 12 • (1 : B)`,
   `VirasoroAnomalyOp24 (3 : B) = 48 • (1 : B)`, and
   `VirasoroAnomalyOp24 (5 : B) = 240 • (1 : B)`.
-/
theorem virasoro_operator_anomaly_24_tripotent_vanishing_and_higher_modes
    (P M : B) (hP : P * P = P) (hM : M * M * M = M) :
    VirasoroAnomalyOp24 M = 0 ∧
    VirasoroAnomalyOp24 (S_P P) = 0 ∧
    VirasoroAnomalyOp24 (-1 : B) = 0 ∧
    VirasoroAnomalyOp24 (0 : B) = 0 ∧
    VirasoroAnomalyOp24 (1 : B) = 0 ∧
    VirasoroAnomalyOp24 (2 • S_P P) = 12 • S_P P ∧
    VirasoroAnomalyOp24 (3 • S_P P) = 48 • S_P P ∧
    VirasoroAnomalyOp24 (2 : B) = 12 • (1 : B) ∧
    VirasoroAnomalyOp24 (3 : B) = 48 • (1 : B) ∧
    VirasoroAnomalyOp24 (5 : B) = 240 • (1 : B) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp only [VirasoroAnomalyOp24]
    rw [hM, sub_self, smul_zero]
  · dsimp only [VirasoroAnomalyOp24, S_P]
    amari_peirce_nf hP
  · dsimp only [VirasoroAnomalyOp24]
    noncomm_ring
  · dsimp only [VirasoroAnomalyOp24]
    noncomm_ring
  · dsimp only [VirasoroAnomalyOp24]
    noncomm_ring
  · dsimp only [VirasoroAnomalyOp24, S_P]
    amari_peirce_nf hP
  · have h3 : (3 : ℕ) • S_P P = (2 : ℕ) • S_P P + S_P P := by
      rw [show (3 : ℕ) = 2 + 1 from rfl, add_nsmul, one_nsmul]
    rw [h3]
    dsimp only [VirasoroAnomalyOp24, S_P]
    amari_peirce_nf hP
  · dsimp only [VirasoroAnomalyOp24]
    have h2 : (2 : B) = 1 + 1 := by norm_num
    rw [h2]; noncomm_ring
  · dsimp only [VirasoroAnomalyOp24]
    have h3 : (3 : B) = 1 + 1 + 1 := by norm_num
    rw [h3]; noncomm_ring
  · dsimp only [VirasoroAnomalyOp24]
    have h5 : (5 : B) = 1 + 1 + 1 + 1 + 1 := by norm_num
    rw [h5]; noncomm_ring

-- ============================================================================
-- 7. ORDER 30: PURE `[Ring B]` MODULAR STEINBERG DEFECT & UNIT-METRIC SL(2) PRESENTATION
-- ============================================================================

/--
**Universal modular Steinberg braid defect in `[Ring B]`
(`universal_modular_steinberg_braid_defect`):**
For any idempotent `P * P = P` and `X, Y : B` with `S = modularInversionOp P X Y = -J_mc P X Y`,
`T_+ = parabolicFlowPlus P X 1 = 1 + N_plus P X`, and `T_- = parabolicFlowMinus P Y (-1) = 1 - N_minus P Y`:
1. `S = - J_mc P X Y`, `S * S = - V_met P X Y`, and `(S * S) * (S * S) = V_met P X Y * V_met P X Y`,
2. `T_+ * T_- * T_+ = J_mc P X Y + (1 - V_met P X Y) * T_+`,
3. `T_- * T_+ * T_- = J_mc P X Y + (1 - V_met P X Y) * T_-`,
4. `T_+ * T_- * T_+ - T_- * T_+ * T_- = (1 - V_met P X Y) * Phi_v P X Y`,
5. `(S * T_+) * (S * T_+) = V_met P X Y * (S * T_+ - 1)`.
-/
theorem universal_modular_steinberg_braid_defect
    (P X Y : B) (hP : P * P = P) :
    let S  := modularInversionOp P X Y
    let Tp := parabolicFlowPlus P X 1
    let Tm := parabolicFlowMinus P Y (-1)
    let j  := J_mc P X Y
    let ph := Phi_v P X Y
    let v  := V_met P X Y
    S = - j ∧
    S * S = - v ∧
    (S * S) * (S * S) = v * v ∧
    Tp * Tm * Tp = j + (1 - v) * Tp ∧
    Tm * Tp * Tm = j + (1 - v) * Tm ∧
    Tp * Tm * Tp - Tm * Tp * Tm = (1 - v) * ph ∧
    (S * Tp) * (S * Tp) = v * (S * Tp - 1) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  · dsimp only [modularInversionOp, parabolicFlowPlus, parabolicFlowMinus,
                J_mc, Phi_v, V_met, Q_pos, Q_neg, N_plus, N_minus]
    amari_peirce_nf hP

/--
**Unit-metric `SL(2)` modular presentation in pure `[Ring B]`
(`unit_metric_modular_group_presentation_in_ring`):**
When the Peirce metric is normalized to `V_met P X Y = 1`, the operators
`S = modularInversionOp P X Y = N_minus P Y - N_plus P X`,
`T_+ = parabolicFlowPlus P X 1 = 1 + N_plus P X`, and
`T_- = parabolicFlowMinus P Y (-1) = 1 - N_minus P Y` satisfy inside `B`:
1. `S * S = -1` and `S * S * S * S = 1`,
2. `T_+ * T_- * T_+ = - S` and `T_- * T_+ * T_- = - S`,
3. `(S * T_+) * (S * T_+) = S * T_+ - 1`,
4. `(S * T_+) * (S * T_+) * (S * T_+) = -1`,
5. `(S * T_+) * (S * T_+) * (S * T_+) = S * S`,
6. `((S * T_+) * (S * T_+) * (S * T_+)) * ((S * T_+) * (S * T_+) * (S * T_+)) = 1`.
-/
theorem unit_metric_modular_group_presentation_in_ring
    (P X Y : B) (hP : P * P = P) (hV : V_met P X Y = 1) :
    let S  := modularInversionOp P X Y
    let Tp := parabolicFlowPlus P X 1
    let Tm := parabolicFlowMinus P Y (-1)
    let ST := S * Tp
    S * S = -1 ∧
    S * S * S * S = 1 ∧
    Tp * Tm * Tp = - S ∧
    Tm * Tp * Tm = - S ∧
    ST * ST = ST - 1 ∧
    ST * ST * ST = -1 ∧
    ST * ST * ST = S * S ∧
    (ST * ST * ST) * (ST * ST * ST) = 1 := by
  have h_def := universal_modular_steinberg_braid_defect P X Y hP
  have hS_sq : modularInversionOp P X Y * modularInversionOp P X Y = -1 := by
    rw [h_def.2.1, hV]
  have hS_pow4 :
      modularInversionOp P X Y * modularInversionOp P X Y *
        modularInversionOp P X Y * modularInversionOp P X Y = 1 := by
    calc modularInversionOp P X Y * modularInversionOp P X Y *
          modularInversionOp P X Y * modularInversionOp P X Y
        = (modularInversionOp P X Y * modularInversionOp P X Y) *
          (modularInversionOp P X Y * modularInversionOp P X Y) := by rw [mul_assoc]
      _ = (-1) * (-1) := by rw [hS_sq]
      _ = 1 := by noncomm_ring
  have h_braid1 :
      parabolicFlowPlus P X 1 * parabolicFlowMinus P Y (-1) * parabolicFlowPlus P X 1 =
        - modularInversionOp P X Y := by
    rw [h_def.2.2.2.1, hV, sub_self, zero_mul, add_zero, h_def.1, neg_neg]
  have h_braid2 :
      parabolicFlowMinus P Y (-1) * parabolicFlowPlus P X 1 * parabolicFlowMinus P Y (-1) =
        - modularInversionOp P X Y := by
    rw [h_def.2.2.2.2.1, hV, sub_self, zero_mul, add_zero, h_def.1, neg_neg]
  have hST_sq :
      (modularInversionOp P X Y * parabolicFlowPlus P X 1) *
        (modularInversionOp P X Y * parabolicFlowPlus P X 1) =
      modularInversionOp P X Y * parabolicFlowPlus P X 1 - 1 := by
    rw [h_def.2.2.2.2.2.2, hV, one_mul]
  have hST_cube :
      (modularInversionOp P X Y * parabolicFlowPlus P X 1) *
        (modularInversionOp P X Y * parabolicFlowPlus P X 1) *
        (modularInversionOp P X Y * parabolicFlowPlus P X 1) = -1 := by
    set ST := modularInversionOp P X Y * parabolicFlowPlus P X 1
    calc ST * ST * ST = (ST - 1) * ST := by rw [hST_sq]
      _ = ST * ST - ST := by rw [sub_mul, one_mul]
      _ = (ST - 1) - ST := by rw [hST_sq]
      _ = -1 := by noncomm_ring
  have hST_cube_eq_S2 :
      (modularInversionOp P X Y * parabolicFlowPlus P X 1) *
        (modularInversionOp P X Y * parabolicFlowPlus P X 1) *
        (modularInversionOp P X Y * parabolicFlowPlus P X 1) =
      modularInversionOp P X Y * modularInversionOp P X Y := by
    rw [hST_cube, hS_sq]
  have hST_pow6 :
      ((modularInversionOp P X Y * parabolicFlowPlus P X 1) *
        (modularInversionOp P X Y * parabolicFlowPlus P X 1) *
        (modularInversionOp P X Y * parabolicFlowPlus P X 1)) *
      ((modularInversionOp P X Y * parabolicFlowPlus P X 1) *
        (modularInversionOp P X Y * parabolicFlowPlus P X 1) *
        (modularInversionOp P X Y * parabolicFlowPlus P X 1)) = 1 := by
    rw [hST_cube]
    noncomm_ring
  exact ⟨hS_sq, hS_pow4, h_braid1, h_braid2, hST_sq, hST_cube, hST_cube_eq_S2, hST_pow6⟩

-- ============================================================================
-- 8. ORDER 31: NON-COMMUTATIVE RING INTEGRITY & OPERATOR-VALUED 24-CLOCK (𝔑ℜ₁–𝔑ℜ₄)
-- ============================================================================

/--
**Theorem 10 (`𝔑ℜ₁` — Non-Commutative Spacetime Preservation vs. Scalar Amnesia Collapse):**
In any associative ring `B` (`[Ring B]`) with idempotent `P * P = P`:
1. **Scalar / Centralizer Collapse:** For any `c : B` commuting with `P` (`comm P c = 0`),
   all four Tetractys fields vanish identically (`J_mc P c c = 0`, `Phi_v P c c = 0`,
   `V_met P c c = 0`, `Sigma_sp P c c = 0`).
2. **Non-Commutative Spacetime Preservation:** For general `X, Y : B`,
   `comm P (J_mc P X Y) = Phi_v P X Y`, `Phi_v P X Y * Phi_v P X Y = V_met P X Y`,
   `J_mc P X Y * J_mc P X Y = - V_met P X Y`, and `anticomm (J_mc P X Y) (Phi_v P X Y) = 0`.
-/
theorem spacetime_requires_noncommutative_operator_ring
    (P c X Y : B) (hP : P * P = P) (hc : comm P c = 0) :
    let j  := J_mc P X Y
    let ph := Phi_v P X Y
    let v  := V_met P X Y
    J_mc P c c = 0 ∧
    Phi_v P c c = 0 ∧
    V_met P c c = 0 ∧
    Sigma_sp P c c = 0 ∧
    comm P j = ph ∧
    ph * ph = v ∧
    j * j = - v ∧
    anticomm j ph = 0 := by
  have hPc : P * c = c * P := sub_eq_zero.mp hc
  have h_np_c : N_plus P c = 0 := by
    dsimp only [N_plus]
    calc P * c * (1 - P)
        = P * c - (P * c) * P := by noncomm_ring
      _ = c * P - c * (P * P) := by rw [hPc, mul_assoc]
      _ = c * P - c * P := by rw [hP]
      _ = 0 := sub_self _
  have h_nm_c : N_minus P c = 0 := by
    dsimp only [N_minus]
    calc (1 - P) * c * P
        = c * P - P * (c * P) := by noncomm_ring
      _ = c * P - (P * P) * c := by rw [← hPc, ← mul_assoc]
      _ = c * P - P * c := by rw [hP]
      _ = c * P - c * P := by rw [hPc]
      _ = 0 := sub_self _
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp only [J_mc]; rw [h_np_c, h_nm_c, sub_zero]
  · dsimp only [Phi_v]; rw [h_np_c, h_nm_c, add_zero]
  · dsimp only [V_met, Q_pos, Q_neg]; rw [h_np_c, h_nm_c, zero_mul, add_zero]
  · dsimp only [Sigma_sp, Q_pos, Q_neg]; rw [h_np_c, h_nm_c, zero_mul, sub_zero]
  · dsimp only [Phi_v, J_mc, N_plus, N_minus, comm]; amari_peirce_nf hP
  · dsimp only [Phi_v, V_met, Q_pos, Q_neg, N_plus, N_minus]; amari_peirce_nf hP
  · dsimp only [J_mc, V_met, Q_pos, Q_neg, N_plus, N_minus]; amari_peirce_nf hP
  · dsimp only [Phi_v, J_mc, N_plus, N_minus, anticomm]; amari_peirce_nf hP

/--
**One-sided Peirce corner obstruction.** Suppose `A` lies in the `P`-to-`1-P`
Peirce corner (`P * A = A`, `A * P = 0`); these relations imply `A * A = 0`.
For the pair
`(X,Y) = (A,0)`, both commutator currents equal `A`, but the metric and spin
products vanish.  Thus nonzero vielbein alone does not imply a nonzero metric;
nondegeneracy requires an additional hypothesis on the corner product.
-/
theorem one_sided_square_zero_corner_has_zero_metric
    (P A : B) (hleft : P * A = A)
    (hright : A * P = 0) :
    A * A = 0 ∧ J_mc P A 0 = A ∧ Phi_v P A 0 = A ∧
    V_met P A 0 = 0 ∧ Sigma_sp P A 0 = 0 ∧
    (A ≠ 0 → J_mc P A 0 ≠ 0 ∧ Phi_v P A 0 ≠ 0) := by
  have hAsquare : A * A = 0 := by
    calc A * A = A * (P * A) := by rw [hleft]
      _ = (A * P) * A := by noncomm_ring
      _ = 0 := by rw [hright, zero_mul]
  have hplus : N_plus P A = A := by
    dsimp only [N_plus]
    calc P * A * (1 - P) = A * (1 - P) := by rw [hleft]
      _ = A - A * P := by noncomm_ring
      _ = A := by rw [hright, sub_zero]
  have hminus : N_minus P (0 : B) = 0 := by
    simp only [N_minus, mul_zero, zero_mul]
  refine ⟨hAsquare, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp only [J_mc]
    rw [hplus, hminus, sub_zero]
  · dsimp only [Phi_v]
    rw [hplus, hminus, add_zero]
  · dsimp only [V_met, Q_pos, Q_neg]
    rw [hplus, hminus]
    simp
  · dsimp only [Sigma_sp, Q_pos, Q_neg]
    rw [hplus, hminus]
    simp
  · intro hA
    constructor <;> simpa [hplus, hminus, J_mc, Phi_v] using hA

/--
**Theorem 11 (`𝔑ℜ₂` — The 4-Way Linear Operator Factorization Diamond of `1 - J⁴` in Pure `[Ring B]`):**
Without assuming commutativity of `B` or complex scalars:
1. `(1 - J_mc P X Y) * (1 + J_mc P X Y) = 1 + V_met P X Y`,
2. `(1 - Phi_v P X Y) * (1 + Phi_v P X Y) = 1 - V_met P X Y`,
3. `(1 - J_mc P X Y) * (1 + J_mc P X Y) * (1 - Phi_v P X Y) * (1 + Phi_v P X Y) = 1 - (J_mc P X Y * J_mc P X Y) * (J_mc P X Y * J_mc P X Y)`.
-/
theorem operator_factorization_diamond_in_pure_ring
    (P X Y : B) (hP : P * P = P) :
    let j  := J_mc P X Y
    let ph := Phi_v P X Y
    let v  := V_met P X Y
    let j2 := j * j
    let j4 := j2 * j2
    (1 - j) * (1 + j) = 1 + v ∧
    (1 - ph) * (1 + ph) = 1 - v ∧
    (1 - j) * (1 + j) * (1 - ph) * (1 + ph) = 1 - j4 := by
  refine ⟨?_, ?_, ?_⟩ <;>
  · dsimp only [Phi_v, J_mc, V_met, Q_pos, Q_neg, N_plus, N_minus]
    amari_peirce_nf hP

/--
**Theorem 12 (`𝔑ℜ₃`–`𝔑ℜ₄` — Complete 24-Periodic Cyclotomic Operator Identity in Pure `[Ring B]`):**
In any associative ring `B` (`[Ring B]`):
1. `(1 - J)(1 + J)(1 - Φ)(1 + Φ)(1 + J⁴ + J⁸)(1 + J⁴) Φ₂₄(J) = 1 - J²⁴`,
2. If `Φ₂₄(J) = 0`, then `J²⁴ = 1`.
-/
theorem complete_twenty_four_cyclotomic_operator_identity
    (P X Y : B) (hP : P * P = P) :
    let j   := J_mc P X Y
    let ph  := Phi_v P X Y
    let j2  := j * j
    let j4  := j2 * j2
    let j8  := j4 * j4
    let j12 := j8 * j4
    let j24 := j12 * j12
    (1 - j) * (1 + j) * (1 - ph) * (1 + ph) * (1 + j4 + j8) *
      (1 + j4) * Phi24_Operator j = 1 - j24 ∧
    (Phi24_Operator j = 0 → j24 = 1) := by
  have h_diamond :
      (1 - J_mc P X Y) * (1 + J_mc P X Y) * (1 - Phi_v P X Y) * (1 + Phi_v P X Y) =
        1 - (J_mc P X Y * J_mc P X Y) * (J_mc P X Y * J_mc P X Y) :=
    (operator_factorization_diamond_in_pure_ring P X Y hP).2.2
  set j := J_mc P X Y
  set ph := Phi_v P X Y
  set j2 := j * j
  set j4 := j2 * j2
  set j8 := j4 * j4
  set j12 := j8 * j4
  set j24 := j12 * j12
  have h_12_minus : (1 - j4) * (1 + j4 + j8) = 1 - j12 := by
    dsimp only [j12, j8, j4, j2]
    noncomm_ring
  have h_12_plus : (1 + j4) * Phi24_Operator j = 1 + j12 := by
    dsimp only [Phi24_Operator, j12, j8, j4, j2]
    noncomm_ring
  have h_24 : (1 - j12) * (1 + j12) = 1 - j24 := by
    dsimp only [j24]
    noncomm_ring
  have h_main :
      (1 - j) * (1 + j) * (1 - ph) * (1 + ph) * (1 + j4 + j8) *
        (1 + j4) * Phi24_Operator j = 1 - j24 := by
    calc (1 - j) * (1 + j) * (1 - ph) * (1 + ph) * (1 + j4 + j8) * (1 + j4) * Phi24_Operator j
        = ((1 - j4) * (1 + j4 + j8)) * ((1 + j4) * Phi24_Operator j) := by
          rw [h_diamond]; simp only [mul_assoc]
      _ = (1 - j12) * (1 + j12) := by rw [h_12_minus, h_12_plus]
      _ = 1 - j24 := h_24
  refine ⟨h_main, ?_⟩
  intro h_phi0
  have h_zero : (1 : B) - j24 = 0 := by
    rw [← h_main, h_phi0, mul_zero]
  exact (sub_eq_zero.mp h_zero).symm

