{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_ref.schema.json",
  "title": "HiveSourceRef",
  "type": "object",
  "required": [
    "ref"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "anchor_role": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
