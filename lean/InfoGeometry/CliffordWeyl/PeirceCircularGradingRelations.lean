import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Analysis.Complex.Basic
import InfoGeometry.CliffordWeyl.PauliPeirceKreinBridge
import InfoGeometry.CliffordWeyl.CircularPauliPeirceBridge
import InfoGeometry.CliffordWeyl.PeirceCircularQwpBridge

/-!
# Peirce and circular grading relations

This module relates the real Pauli Peirce projectors to the complex circular
projectors.  The circular grading is generated by `-I * EminusC`; the factor
of `-I` is essential, since the real matrix `EminusC` itself is not `σ₂`.
The change of grading is the verified quarter-wave-plate conjugation from
`PeirceCircularQwpBridge`.
-/

noncomputable section

namespace InfoGeometry.CliffordWeyl.PeirceCircularGradingRelations

open InfoGeometry.Clifford.Cl11Matrix
open InfoGeometry.CliffordWeyl.PauliPeirceKreinBridge
open InfoGeometry.CliffordWeyl.CircularPauliPeirceBridge
open InfoGeometry.CliffordWeyl.PeirceCircularQwpBridge
open Matrix

abbrev Mat2C := Matrix (Fin 2) (Fin 2) ℂ

/-- Entrywise complexification of a real two-by-two matrix. -/
def toComplex (A : Matrix (Fin 2) (Fin 2) ℝ) : Mat2C :=
  fun i j => (A i j : ℂ)

def peirceLeftC : Mat2C := !![(1 : ℂ), 0; 0, 0]
def peirceRightC : Mat2C := !![(0 : ℂ), 0; 0, 1]

theorem peirceLeftC_eq_complexification :
    peirceLeftC = toComplex pauliChiral.Pleft := by
  rw [pauliChiral_Pleft]
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

theorem peirceRightC_eq_complexification :
    peirceRightC = toComplex pauliChiral.Pright := by
  rw [pauliChiral_Pright]
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

/-- The complex circular chirality is `σ₂`, not the unscaled real generator
`EminusC`; multiplication by `-I` converts the latter to the former. -/
theorem negI_mul_EminusC_eq_sigma2 :
    (-Complex.I) • CircularPauliPeirceBridge.EminusC = sigma2 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [CircularPauliPeirceBridge.EminusC, PeirceCircularQwpBridge.sigma2,
      Matrix.smul_apply]

theorem circular_chirality_is_sigma2 : clockwiseChirality.chi = sigma2 := by
  change (-Complex.I) • CircularPauliPeirceBridge.EminusC = sigma2
  exact negI_mul_EminusC_eq_sigma2

/-- The clockwise projector is the equal diagonal part of the Peirce splitting
minus the imaginary multiple of the real rotation generator. -/
theorem clockwiseProjector_as_Peirce_generator_sum :
    clockwiseProjector =
      (1 / 2 : ℂ) • (peirceLeftC + peirceRightC)
        - (Complex.I / 2 : ℂ) • CircularPauliPeirceBridge.EminusC := by
  rw [clockwiseProjector_eq_matrix]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [peirceLeftC, peirceRightC, CircularPauliPeirceBridge.EminusC,
      Matrix.sub_apply]; ring

/-- The counterclockwise projector has the opposite sign on the imaginary
off-diagonal generator. -/
theorem counterclockwiseProjector_as_Peirce_generator_sum :
    counterclockwiseProjector =
      (1 / 2 : ℂ) • (peirceLeftC + peirceRightC)
        + (Complex.I / 2 : ℂ) • CircularPauliPeirceBridge.EminusC := by
  rw [counterclockwiseProjector_eq_matrix]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [peirceLeftC, peirceRightC, CircularPauliPeirceBridge.EminusC,
      Matrix.add_apply]; ring

end InfoGeometry.CliffordWeyl.PeirceCircularGradingRelations

end
