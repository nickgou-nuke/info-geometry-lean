{"type":"new","contents":"import InfoGeometry.Core.Involution\nimport InfoGeometry.Core.SymmetricLieGeneric\nimport InfoGeometry.Architecture.SymmetricSpace\n\n/-!\n# Unified Geometry Core\n\nUnifying abstractions for involutive symmetric geometry, Cartan splitting,\nand Lie-style compatibility.\n-/\n\nnamespace InfoGeometry.Core\n\n/-- Symmetric-space style reflection data packaged as pointwise involutions. -/\nstructure SymmetricSpace (M : Type _) where\n  reflection : M → InvolutiveAutomorphism M\n  reflection_fix : ∀ x, reflection x x = x\n\n@[simp]\nlemma reflection_involutive\n    {M : Type _}\n    (S : SymmetricSpace M) (x y : M) :\n    S.reflection x (S.reflection x y) = y :=\n  (S.reflection x).involutive y\n\n@[simp]\nlemma reflection_self\n    {M : Type _}\n    (S : SymmetricSpace M) (x : M) :\n    S.reflection x x = x :=\n  S.reflection_fix x\n\n@[ext] lemma SymmetricSpace.ext\n    {M : Type _} {S T : SymmetricSpace M}\n    (h : ∀ x y, S.reflection x y = T.reflection x y) : S = T := by\n  cases S with\n  | mk rS fS =>\n    cases T with\n    | mk rT fT =>\n      have hr : rS = rT := by\n        funext x\n        exact InvolutiveAutomorphism.ext (fun y => h x y)\n      subst hr\n      have hf : fS = fT := Subsingleton.elim _ _\n      cases hf\n      rfl\n\n/-- Bridge from the existing Cartan-Loos structure. -/\ndef SymmetricSpace.ofLegacy\n    {M : Type _}\n    (S : InfoGeometry.Architecture.SymmetricSpace M) : SymmetricSpace M where\n  reflection x :=\n    { toFun := S.symmetry x\n      involutive := S.symm_involutive x }\n  reflection_fix := S.symm_fixpoint\n\n/-- Bridge to the existing Cartan-Loos structure. -/\ndef SymmetricSpace.toLegacy\n    {M : Type _}\n    (S : SymmetricSpace M) : InfoGeometry.Architecture.SymmetricSpace M where\n  symmetry := fun x y => S.reflection x y\n  symm_involutive := by\n    intro x y\n    exact (S.reflection x).involutive y\n  symm_fixpoint := S.reflection_fix\n\n@[simp] lemma SymmetricSpace.toLegacy_ofLegacy\n    {M : Type _}\n    (S : InfoGeometry.Architecture.SymmetricSpace M) :\n    (SymmetricSpace.ofLegacy S).toLegacy = S := by\n  cases S\n  rfl\n\n@[simp] lemma SymmetricSpace.ofLegacy_toLegacy\n    {M : Type _}\n    (S : SymmetricSpace M) :\n    SymmetricSpace.ofLegacy (S.toLegacy) = S := by\n  cases S\n  rfl\n\n/-- Cartan decomposition generated by a linear involution. -/\nstructure CartanDecomposition (V : Type _)\n    [AddCommGroup V] [Module ℝ V] where\n  θ : LinearInvolutiveAutomorphism V\n\n@[ext] lemma CartanDecomposition.ext\n    {V : Type _} [AddCommGroup V] [Module ℝ V]\n    {C D : CartanDecomposition V}\n    (h : C.θ = D.θ) : C = D := by\n  cases C\n  cases D\n  cases h\n  rfl\n\nsection Cartan\n\nvariable {V : Type _} [AddCommGroup V] [Module ℝ V]\n\n/-- `+1` Cartan component. -/\nnoncomputable def plusPart\n    (C : CartanDecomposition V) (v : V) : V :=\n  InfoGeometry.Core.cartanPlus C.θ v\n\n/-- `-1` Cartan component. -/\nnoncomputable def minusPart\n    (C : CartanDecomposition V) (v : V) : V :=\n  InfoGeometry.Core.cartanMinus C.θ v\n\n/-- Even subspace predicate (`+1` eigenspace of `θ`). -/\ndef IsEven\n    (C : CartanDecomposition V) (v : V) : Prop :=\n  C.θ v = v\n\n/-- Odd subspace predicate (`-1` eigenspace of `θ`). -/\ndef IsOdd\n    (C : CartanDecomposition V) (v : V) : Prop :=\n  C.θ v = -v\n\nlemma cartan_split\n    (C : CartanDecomposition V) (v : V) :\n    v = plusPart C v + minusPart C v :=\n  InfoGeometry.Core.cartan_decomposition C.θ v\n\nlemma cartanPlus_even\n    (C : CartanDecomposition V) (v : V) :\n    IsEven C (plusPart C v) :=\n  InfoGeometry.Core.cartanPlus_fixed C.θ v\n\nlemma cartanMinus_odd\n    (C : CartanDecomposition V) (v : V) :\n    IsOdd C (minusPart C v) :=\n  InfoGeometry.Core.cartanMinus_neg_fixed C.θ v\n\nend Cartan\n\n/-- Minimal Lie-style bracket data with Cartan involution compatibility. -/\nstructure CartanLieStructure (L : Type _)\n    [AddCommGroup L] [Module ℝ L] where\n  bracket : L → L → L\n  cartan : CartanDecomposition L\n  bracket_compat :\n    ∀ x y,\n      cartan.θ (bracket x y) = bracket (cartan.θ x) (cartan.θ y)\n\nsection Endomorphism\n\nvariable {V : Type _} [NormedAddCommGroup V] [NormedSpace ℝ V]\n\n/-- Conjugation linear endomorphism on `End(V)` induced by `J`. -/\nnoncomputable def conjugationMap\n    (J : V →L[ℝ] V) :\n    (V →L[ℝ] V) →ₗ[ℝ] (V →L[ℝ] V) :=\n  { toFun := fun A => J.comp (A.comp J)\n    map_add' := by\n      intro A B\n      ext v\n      simp\n    map_smul' := by\n      intro a A\n      ext v\n      simp }\n\n/-- `conjugationMap` as an endomorphism object in the `Module.End` API. -/\nnoncomputable def conjugationEnd\n    (J : V →L[ℝ] V) :\n    Module.End ℝ (V →L[ℝ] V) :=\n  conjugationMap J\n\n/-- Involutivity of conjugation when `J² = Id`. -/\nlemma conjugationMap_involutive\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :\n    Function.Involutive (conjugationMap J) := by\n  intro A\n  have hJ_apply : ∀ x : V, J (J x) = x := by\n    intro x\n    simpa using congrArg (fun T : V →L[ℝ] V => T x) hJ\n  ext v\n  simp [conjugationMap, hJ_apply]\n\n/-- Involutivity of conjugation when `J² = -Id`. -/\nlemma conjugationMap_involutive_sq_neg_one\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = -ContinuousLinearMap.id ℝ V) :\n    Function.Involutive (conjugationMap J) := by\n  intro A\n  have hJ_apply : ∀ x : V, J (J x) = -x := by\n    intro x\n    simpa using congrArg (fun T : V →L[ℝ] V => T x) hJ\n  ext v\n  simp [conjugationMap, hJ_apply]\n\n/-- Conjugation linear endomorphism on `End(V)` induced by `J` with sign flip. -/\nnoncomputable def conjugationMapNeg\n    (J : V →L[ℝ] V) :\n    (V →L[ℝ] V) →ₗ[ℝ] (V →L[ℝ] V) :=\n  { toFun := fun A => -(J.comp (A.comp J))\n    map_add' := by\n      intro A B\n      ext v\n      simp\n      abel\n    map_smul' := by\n      intro a A\n      ext v\n      simp }\n\n/-- Involutivity of negative conjugation when `J² = -Id`. -/\nlemma conjugationMapNeg_involutive\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = -ContinuousLinearMap.id ℝ V) :\n    Function.Involutive (conjugationMapNeg J) := by\n  intro A\n  have hJ_apply : ∀ x : V, J (J x) = -x := by\n    intro x\n    simpa using congrArg (fun T : V →L[ℝ] V => T x) hJ\n  ext v\n  simp [conjugationMapNeg, hJ_apply]\n\n/-- Bracket compatibility of negative conjugation when `J² = -Id`. -/\nlemma conjugationMapNeg_bracket\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = -ContinuousLinearMap.id ℝ V)\n    (A B : V →L[ℝ] V) :\n    conjugationMapNeg J ⁅A, B⁆\n      = ⁅conjugationMapNeg J A, conjugationMapNeg J B⁆ := by\n  have hJ_apply : ∀ x : V, J (J x) = -x := by\n    intro x\n    simpa using congrArg (fun T : V →L[ℝ] V => T x) hJ\n  ext v\n  simp [conjugationMapNeg, hJ_apply, LieRing.of_associative_ring_bracket]\n  abel\n\n/-- Conjugation by a square-root of -1 as a Lie algebra equivalence on `End(V)`. -/\nnoncomputable def conjugationLieEquiv_sq_neg_one\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = -ContinuousLinearMap.id ℝ V) :\n    (V →L[ℝ] V) ≃ₗ⁅ℝ⁆ (V →L[ℝ] V) := by\n  let θ := conjugationMapNeg J\n  have hInv := conjugationMapNeg_involutive J hJ\n  refine\n    { toFun := θ\n      invFun := θ\n      left_inv := by\n        intro A\n        exact hInv A\n      right_inv := by\n        intro A\n        exact hInv A\n      map_add' := by\n        intro A B\n        exact θ.map_add A B\n      map_smul' := by\n        intro a A\n        exact θ.map_smul a A\n      map_lie' := by\n        intro A B\n        exact conjugationMapNeg_bracket J hJ A B }\n\n/-- Bracket compatibility of conjugation when `J² = Id`. -/\nlemma conjugationMap_bracket\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V)\n    (A B : V →L[ℝ] V) :\n    conjugationMap J ⁅A, B⁆\n      = ⁅conjugationMap J A, conjugationMap J B⁆ := by\n  have hJ_apply : ∀ x : V, J (J x) = x := by\n    intro x\n    simpa using congrArg (fun T : V →L[ℝ] V => T x) hJ\n  ext v\n  simp [conjugationMap, hJ_apply, LieRing.of_associative_ring_bracket]\n\n/-- Conjugation by an involution as a Lie algebra equivalence on `End(V)`. -/\nnoncomputable def conjugationLieEquiv\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :\n    (V →L[ℝ] V) ≃ₗ⁅ℝ⁆ (V →L[ℝ] V) := by\n  let θ := conjugationMap J\n  have hInv := conjugationMap_involutive J hJ\n  refine\n    { toFun := θ\n      invFun := θ\n      left_inv := by\n        intro A\n        exact hInv A\n      right_inv := by\n        intro A\n        exact hInv A\n      map_add' := by\n        intro A B\n        exact θ.map_add A B\n      map_smul' := by\n        intro a A\n        exact θ.map_smul a A\n      map_lie' := by\n        intro A B\n        exact conjugationMap_bracket J hJ A B }\n\n/-- `+1` eigenspace of conjugation by `J`. -/\nnoncomputable def conjugationEvenSubmodule\n    (J : V →L[ℝ] V) :\n    Submodule ℝ (V →L[ℝ] V) :=\n  (conjugationEnd J).eigenspace (1 : ℝ)\n\n/-- `-1` eigenspace of conjugation by `J`. -/\nnoncomputable def conjugationOddSubmodule\n    (J : V →L[ℝ] V) :\n    Submodule ℝ (V →L[ℝ] V) :=\n  (conjugationEnd J).eigenspace (-1 : ℝ)\n\nprivate lemma mem_conjugationEvenSubmodule_iff\n    (J : V →L[ℝ] V) (A : V →L[ℝ] V) :\n    A ∈ conjugationEvenSubmodule J ↔ conjugationMap J A = (1 : ℝ) • A := by\n  change A ∈ (conjugationEnd J).eigenspace (1 : ℝ)\n      ↔ (conjugationEnd J) A = (1 : ℝ) • A\n  exact Module.End.mem_eigenspace_iff\n    (f := conjugationEnd J) (μ := (1 : ℝ)) (x := A)\n\nprivate lemma mem_conjugationOddSubmodule_iff\n    (J : V →L[ℝ] V) (A : V →L[ℝ] V) :\n    A ∈ conjugationOddSubmodule J ↔ conjugationMap J A = (-1 : ℝ) • A := by\n  change A ∈ (conjugationEnd J).eigenspace (-1 : ℝ)\n      ↔ (conjugationEnd J) A = (-1 : ℝ) • A\n  exact Module.End.mem_eigenspace_iff\n    (f := conjugationEnd J) (μ := (-1 : ℝ)) (x := A)\n\n/-- Bracket closure `[𝔨, 𝔨] ⊆ 𝔨` for the conjugation eigenspace decomposition. -/\nlemma conjugation_bracket_even_even_mem_even\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V)\n    {A B : V →L[ℝ] V}\n    (hA : A ∈ conjugationEvenSubmodule J)\n    (hB : B ∈ conjugationEvenSubmodule J) :\n    ⁅A, B⁆ ∈ conjugationEvenSubmodule J := by\n  rw [mem_conjugationEvenSubmodule_iff] at hA hB ⊢\n  calc\n    conjugationMap J ⁅A, B⁆\n        = ⁅conjugationMap J A, conjugationMap J B⁆ :=\n          conjugationMap_bracket J hJ A B\n    _ = ⁅(1 : ℝ) • A, (1 : ℝ) • B⁆ := by rw [hA, hB]\n    _ = (1 : ℝ) • ⁅A, B⁆ := by simp\n\n/-- Bracket closure `[𝔨, 𝔭] ⊆ 𝔭` for the conjugation eigenspace decomposition. -/\nlemma conjugation_bracket_even_odd_mem_odd\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V)\n    {A B : V →L[ℝ] V}\n    (hA : A ∈ conjugationEvenSubmodule J)\n    (hB : B ∈ conjugationOddSubmodule J) :\n    ⁅A, B⁆ ∈ conjugationOddSubmodule J := by\n  rw [mem_conjugationEvenSubmodule_iff] at hA\n  rw [mem_conjugationOddSubmodule_iff] at hB ⊢\n  calc\n    conjugationMap J ⁅A, B⁆\n        = ⁅conjugationMap J A, conjugationMap J B⁆ :=\n          conjugationMap_bracket J hJ A B\n    _ = ⁅(1 : ℝ) • A, (-1 : ℝ) • B⁆ := by rw [hA, hB]\n    _ = (-1 : ℝ) • ⁅A, B⁆ := by simp\n\n/-- Bracket closure `[𝔭, 𝔭] ⊆ 𝔨` for the conjugation eigenspace decomposition. -/\nlemma conjugation_bracket_odd_odd_mem_even\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V)\n    {A B : V →L[ℝ] V}\n    (hA : A ∈ conjugationOddSubmodule J)\n    (hB : B ∈ conjugationOddSubmodule J) :\n    ⁅A, B⁆ ∈ conjugationEvenSubmodule J := by\n  rw [mem_conjugationOddSubmodule_iff] at hA hB\n  rw [mem_conjugationEvenSubmodule_iff]\n  calc\n    conjugationMap J ⁅A, B⁆\n        = ⁅conjugationMap J A, conjugationMap J B⁆ :=\n          conjugationMap_bracket J hJ A B\n    _ = ⁅(-1 : ℝ) • A, (-1 : ℝ) • B⁆ := by rw [hA, hB]\n    _ = (1 : ℝ) • ⁅A, B⁆ := by simp\n\n/-- The `+1` conjugation eigenspace is a Lie subalgebra. -/\nnoncomputable def conjugationEvenLieSubalgebra\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :\n    LieSubalgebra ℝ (V →L[ℝ] V) where\n  carrier := conjugationEvenSubmodule J\n  zero_mem' := by\n    simp [conjugationEvenSubmodule]\n  add_mem' := by\n    intro A B hA hB\n    exact (conjugationEvenSubmodule J).add_mem hA hB\n  smul_mem' := by\n    intro a A hA\n    exact (conjugationEvenSubmodule J).smul_mem a hA\n  lie_mem' := by\n    intro A B hA hB\n    exact conjugation_bracket_even_even_mem_even J hJ hA hB\n\n/-- Conjugation by an involutive endomorphism as a linear involution on endomorphisms. -/\nnoncomputable def conjugationByInvolution\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :\n    LinearInvolutiveAutomorphism (V →L[ℝ] V) := by\n  refine ⟨?_, ?_⟩\n  · exact\n      { toFun := conjugationMap J\n        involutive := conjugationMap_involutive J hJ }\n  · refine\n      { map_add := ?_\n        map_smul := ?_ }\n    · intro A B\n      exact (conjugationMap J).map_add A B\n    · intro a A\n      exact (conjugationMap J).map_smul a A\n\n/-- Cartan decomposition induced by involutive conjugation on endomorphisms. -/\nnoncomputable def endomorphismCartanDecomposition\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :\n    CartanDecomposition (V →L[ℝ] V) where\n  θ := conjugationByInvolution J hJ\n\n/-- Conjugation by an involutive endomorphism packaged in the generic symmetric-Lie API. -/\nnoncomputable def conjugationSymmetricLieAlgebra\n    (J : V →L[ℝ] V)\n    (hJ : J.comp J = ContinuousLinearMap.id ℝ V) :\n    InfoGeometry.Core.Generic.SymmetricLieAlgebra ℝ (V →L[ℝ] V) where\n  θ := conjugationLieEquiv J hJ\n  involution := by\n    apply LieEquiv.ext\n    intro A\n    exact conjugationMap_involutive J hJ A\n\nend Endomorphism\n\nsection GroupBridge\n\nvariable {G : Type _} [Group G]\n\nprivate lemma cartanInvolution_ext\n    {θ ψ : InfoGeometry.Architecture.CartanInvolution G}\n    (h : ∀ g, θ.toMulAut g = ψ.toMulAut g) : θ = ψ := by\n  cases θ with\n  | mk θaut θinv =>\n    cases ψ with\n    | mk ψaut ψinv =>\n      have haut : θaut = ψaut := MulEquiv.ext h\n      subst haut\n      have hproof : θinv = ψinv := Subsingleton.elim _ _\n      cases hproof\n      rfl\n\n/-- Bridge from the existing group-level Cartan involution. -/\ndef mulInvolutiveOfCartan\n    (θ : InfoGeometry.Architecture.CartanInvolution G) :\n    MulInvolutiveAutomorphism G := by\n  refine ⟨?_, ?_⟩\n  · exact\n      { toFun := θ.toMulAut\n        involutive := θ.involutive }\n  · refine\n      { map_mul := ?_\n        map_one := ?_ }\n    · intro x y\n      simp\n    · simp\n\n/-- Bridge to the existing group-level Cartan involution. -/\ndef cartanOfMulInvolutive\n    (θ : MulInvolutiveAutomorphism G) :\n    InfoGeometry.Architecture.CartanInvolution G := by\n  refine\n    { toMulAut := ?_\n      involutive := ?_ }\n  · refine\n      { toFun := θ.1\n        invFun := θ.1\n        left_inv := θ.1.involutive\n        right_inv := θ.1.involutive\n        map_mul' := by\n          intro x y\n          exact θ.2.map_mul x y }\n  · intro g\n    exact θ.1.involutive g\n\n@[simp] lemma mulInvolutiveOfCartan_toCartan\n    (θ : InfoGeometry.Architecture.CartanInvolution G) :\n    cartanOfMulInvolutive (mulInvolutiveOfCartan θ) = θ := by\n  apply cartanInvolution_ext\n  intro g\n  rfl\n\n@[simp] lemma cartanOfMulInvolutive_toMulInvolutive\n    (θ : MulInvolutiveAutomorphism G) :\n    mulInvolutiveOfCartan (cartanOfMulInvolutive θ) = θ := by\n  apply Subtype.ext\n  ext g\n  rfl\n\nend GroupBridge\n\nend InfoGeometry.Core\n","mtime":1777928003342}