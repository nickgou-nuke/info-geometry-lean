LIB "nctools.lib";

ring r = 0, (L1, L0, Lm1), dp;

matrix C[3][3];
C[1,2] = 1; C[1,3] = 1; C[2,3] = 1;
matrix D[3][3];
// L0 * L1 = L1 * L0 - L1
D[1,2] = -L1;
// Lm1 * L1 = L1 * Lm1 - 2*L0
D[1,3] = -2*L0;
// Lm1 * L0 = L0 * Lm1 - Lm1
D[2,3] = -Lm1;

def S = nc_algebra(C, D);
setring S;

proc comm(poly x, poly y)
{
    return (x * y - y * x);
}

poly J1 = comm(L1, comm(L0, Lm1)) + comm(L0, comm(Lm1, L1)) + comm(Lm1, comm(L1, L0));
poly J2 = comm(L1, comm(Lm1, L0)) + comm(Lm1, comm(L0, L1)) + comm(L0, comm(L1, Lm1));
poly J3 = comm(L0, comm(L1, Lm1)) + comm(L1, comm(Lm1, L0)) + comm(Lm1, comm(L0, L1));
poly J4 = comm(L0, comm(Lm1, L1)) + comm(Lm1, comm(L1, L0)) + comm(L1, comm(L0, Lm1));
poly J5 = comm(Lm1, comm(L1, L0)) + comm(L1, comm(L0, Lm1)) + comm(L0, comm(Lm1, L1));
poly J6 = comm(Lm1, comm(L0, L1)) + comm(L0, comm(L1, Lm1)) + comm(L1, comm(Lm1, L0));

if (J1 == 0 && J2 == 0 && J3 == 0 && J4 == 0 && J5 == 0 && J6 == 0) {
    print("Jacobi identity holds natively for all permutations of (L1, L0, Lm1).");
} else {
    print("Jacobi identity fails for some permutation.");
    print(J1); print(J2); print(J3); print(J4); print(J5); print(J6);
}

exit;
