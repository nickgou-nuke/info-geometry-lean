import InfoGeometry.Canonical.SmoothVectorFieldPushforward
import InfoGeometry.Canonical.ArnoldInformationGeometry

/-!
# Arnold flows inside the measure-based Erlangen closure

A family of time-map homomorphisms preserving a measure generates
an actual subgroup of the existing smooth diffeomorphism group. Its Galois
closure for the native action on measures remains inside the existing SDiff
subgroup. The full measure stabilizer is itself closed, but the closure of
the generated flow subgroup is not asserted to equal that full stabilizer.

The explicit Arnold flow provides the measure-invariance and time-derivative
proofs. Its actual velocity is preserved by Fréchet pushforward along its own
flow. Restricting flow symmetries to the measure stabilizer gives the precise
intersection with SDiff, and its orbit is the native coset space of that
restricted centralizer. No normality, quotient-group structure, transitivity
on all densities, or infinite-dimensional manifold theorem is inferred.
-/

noncomputable section

namespace InfoGeometry.Canonical.ArnoldSDiffFlowErlangenClosure

open MeasureTheory
open InfoGeometry.Erlangen.FlowSymmetryClosure
open InfoGeometry.Canonical.SmoothVectorFieldPushforward
open scoped InfoGeometry.Erlangen.FlowSymmetryClosure
  InfoGeometry.Canonical.SmoothVectorFieldPushforward

section Measure

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable [MeasurableSpace E] [BorelSpace E]
variable {T ι : Type*} [Monoid T]

/-- Invariant-measure Galois closure of a generated flow family is contained
in the existing smooth measure-preserving subgroup, with its exact carrier. -/
theorem sdiff_erlangen_closure_of_measure_invariant_flows
    (μ : Measure E) (F : ι → T →* smoothDiffeomorphismSubgroup E)
    (hF : ∀ i t, F i t • μ = μ) :
    invariantClosure (smoothDiffeomorphismSubgroup E) (Measure E) (generatedSubgroup F) ≤
      (smoothVolumePreservingSubgroup μ).comap
        (smoothDiffeomorphismSubgroup E).subtype := by
  rw [← measure_stabilizer_eq_comap]
  exact (invariantClosure_generatedSubgroup_le_stabilizer_iff F μ).mpr hF

/-- The full SDiff stabilizer is a closed subgroup for this Galois closure.
This equality concerns SDiff itself, not a subgroup generated by chosen flows. -/
theorem sdiff_invariantClosure (μ : Measure E) :
    invariantClosure (smoothDiffeomorphismSubgroup E) (Measure E)
        ((smoothVolumePreservingSubgroup μ).comap
          (smoothDiffeomorphismSubgroup E).subtype) =
      (smoothVolumePreservingSubgroup μ).comap
        (smoothDiffeomorphismSubgroup E).subtype := by
  rw [← measure_stabilizer_eq_comap]
  apply le_antisymm
  · exact (invariantClosure_le_stabilizer_iff _ _ _ μ).mpr le_rfl
  · exact (invariantClosure (smoothDiffeomorphismSubgroup E) (Measure E)).le_closure _

/-- Restriction to measure-preserving coordinate changes restricts the
centralizer by the actual inclusion homomorphism. -/
theorem measureRestricted_flow_stabilizer_eq_comap
    (μ : Measure E) (Φ : T →* smoothDiffeomorphismSubgroup E) :
    MulAction.stabilizer (MulAction.stabilizer (smoothDiffeomorphismSubgroup E) μ) Φ =
      (Subgroup.centralizer (Set.range Φ)).comap
        (MulAction.stabilizer (smoothDiffeomorphismSubgroup E) μ).subtype := by
  ext g
  change g.val ∈ MulAction.stabilizer (smoothDiffeomorphismSubgroup E) Φ ↔
    g.val ∈ Subgroup.centralizer (Set.range Φ)
  rw [flow_stabilizer_eq_centralizer]

/-- In the ambient smooth group the restricted symmetry group is exactly
the intersection of the flow centralizer and SDiff. -/
theorem measureRestricted_flow_stabilizer_map
    (μ : Measure E) (Φ : T →* smoothDiffeomorphismSubgroup E) :
    (MulAction.stabilizer (MulAction.stabilizer (smoothDiffeomorphismSubgroup E) μ) Φ).map
        (MulAction.stabilizer (smoothDiffeomorphismSubgroup E) μ).subtype =
      Subgroup.centralizer (Set.range Φ) ⊓
        (smoothVolumePreservingSubgroup μ).comap
          (smoothDiffeomorphismSubgroup E).subtype := by
  rw [measureRestricted_flow_stabilizer_eq_comap, Subgroup.comap_subtype,
    Subgroup.subgroupOf_map_subtype, measure_stabilizer_eq_comap]

/-- The actual orbit under measure-preserving coordinate changes is the
native coset space by the restricted flow centralizer. -/
def measurePreservingFlowOrbitEquivQuotient
    (μ : Measure E) (Φ : T →* smoothDiffeomorphismSubgroup E) :
    MulAction.orbit (MulAction.stabilizer (smoothDiffeomorphismSubgroup E) μ) Φ ≃
      (MulAction.stabilizer (smoothDiffeomorphismSubgroup E) μ) ⧸
        (Subgroup.centralizer (Set.range Φ)).comap
          (MulAction.stabilizer (smoothDiffeomorphismSubgroup E) μ).subtype := by
  rw [← measureRestricted_flow_stabilizer_eq_comap]
  exact MulAction.orbitEquivQuotientStabilizer
    (MulAction.stabilizer (smoothDiffeomorphismSubgroup E) μ) Φ

end Measure

section Arnold

open InfoGeometry.Canonical.NavierStokesShearReconstruction
open InfoGeometry.Canonical.ArnoldBeltramiFlow
open InfoGeometry.Canonical.ArnoldInformationGeometry

/-- The existing physical velocity is the actual generator of the smooth
one-parameter subgroup at every initial point. -/
theorem smoothFlowHom_hasDerivAt_zero (s : ℝ) (x : Space) :
    HasDerivAt (fun t : ℝ => (smoothFlowHom s (Multiplicative.ofAdd t)).val x)
      (velocity s x) 0 := by
  change HasDerivAt (fun t : ℝ => flow s t x) (velocity s x) 0
  simpa only [velocity_flow] using hasDerivAt_flow s 0 x

/-- The conjugated Arnold flow has the derivative-pushed physical velocity. -/
theorem conjugate_arnold_hasDerivAt_zero (g : smoothDiffeomorphismSubgroup Space)
    (s : ℝ) (y : Space) :
    HasDerivAt (fun t : ℝ => (conjugateFlow g (smoothFlowHom s)
        (Multiplicative.ofAdd t)).val y)
      (pushforward g (velocity s) y) 0 :=
  hasDerivAt_conjugateFlow g (smoothFlowHom s) (velocity s)
    (smoothFlowHom_hasDerivAt_zero s) y

/-- Symmetries of the explicit Arnold flow fix its actual vector field. -/
theorem arnold_flow_stabilizer_le_velocity_stabilizer (s : ℝ) :
    MulAction.stabilizer (smoothDiffeomorphismSubgroup Space) (smoothFlowHom s) ≤
      MulAction.stabilizer (smoothDiffeomorphismSubgroup Space) (velocity s) :=
  flow_stabilizer_le_vectorField_stabilizer (smoothFlowHom s) (velocity s)
    (smoothFlowHom_hasDerivAt_zero s)

/-- The explicit Arnold flow preserves its physical velocity by Fréchet pushforward. -/
theorem arnold_flow_pushforward_velocity (s : ℝ) (t : Multiplicative ℝ) :
    pushforward (smoothFlowHom s t) (velocity s) = velocity s :=
  timeMap_pushforward_generator (smoothFlowHom s) (velocity s)
    (smoothFlowHom_hasDerivAt_zero s) t

/-- Even different parameters in this explicit Arnold model commute: all
time maps translate horizontally while keeping the third coordinate fixed. -/
theorem arnold_timeMaps_commute (s r : ℝ) (t u : Multiplicative ℝ) :
    Commute (smoothFlowHom s t) (smoothFlowHom r u) := by
  change smoothFlowHom s t * smoothFlowHom r u = smoothFlowHom r u * smoothFlowHom s t
  apply Subtype.ext
  apply Homeomorph.ext
  intro x
  change flow s t.toAdd (flow r u.toAdd x) = flow r u.toAdd (flow s t.toAdd x)
  ext i
  fin_cases i <;> simp [flow] <;> ring

/-- The subgroup algebraically generated by this concrete family is abelian.
The general conjugation theory does not impose this specialization. -/
theorem arnold_family_generated_le_centralizer {ι : Type*} (σ : ι → ℝ) :
    generatedSubgroup (fun i => smoothFlowHom (σ i)) ≤
      Subgroup.centralizer
        (generatedSubgroup (fun i => smoothFlowHom (σ i)) :
          Set (smoothDiffeomorphismSubgroup Space)) := by
  apply (generatedSubgroup_le_iff _ _).mpr
  intro i t
  rw [generatedSubgroup, Subgroup.centralizer_closure, Subgroup.mem_centralizer_iff]
  intro h hh
  rcases Set.mem_iUnion.mp hh with ⟨j, u, rfl⟩
  exact (arnold_timeMaps_commute (σ j) (σ i) u t).eq

/-- Every family of the already-defined Arnold flows gives the exact
generated-subgroup / Galois-closure / SDiff inclusion chain.
Volume invariance holds for every real parameter; no curl-eigenvalue
specialization is required for this statement. -/
theorem arnold_family_erlangen_closure {ι : Type*} (σ : ι → ℝ) :
    generatedSubgroup (fun i => smoothFlowHom (σ i)) ≤
        invariantClosure (smoothDiffeomorphismSubgroup Space) (Measure Space)
          (generatedSubgroup (fun i => smoothFlowHom (σ i))) ∧
      invariantClosure (smoothDiffeomorphismSubgroup Space) (Measure Space)
          (generatedSubgroup (fun i => smoothFlowHom (σ i))) ≤
        (smoothVolumePreservingSubgroup (volume : Measure Space)).comap
          (smoothDiffeomorphismSubgroup Space).subtype := by
  constructor
  · exact (invariantClosure (smoothDiffeomorphismSubgroup Space)
      (Measure Space)).le_closure _
  · exact sdiff_erlangen_closure_of_measure_invariant_flows volume _
      (fun i t => smoothFlowHom_fixes_volume (σ i) t)

/-- Arnold's actual orbit under volume-preserving coordinate changes has
the restricted centralizer as its homogeneous-space stabilizer. -/
def arnoldVolumeFlowOrbitEquivQuotient (s : ℝ) :
    MulAction.orbit
        (MulAction.stabilizer (smoothDiffeomorphismSubgroup Space) (volume : Measure Space))
        (smoothFlowHom s) ≃
      (MulAction.stabilizer (smoothDiffeomorphismSubgroup Space) (volume : Measure Space)) ⧸
        (Subgroup.centralizer (Set.range (smoothFlowHom s))).comap
          (MulAction.stabilizer (smoothDiffeomorphismSubgroup Space)
            (volume : Measure Space)).subtype :=
  measurePreservingFlowOrbitEquivQuotient volume (smoothFlowHom s)

end Arnold

end InfoGeometry.Canonical.ArnoldSDiffFlowErlangenClosure
