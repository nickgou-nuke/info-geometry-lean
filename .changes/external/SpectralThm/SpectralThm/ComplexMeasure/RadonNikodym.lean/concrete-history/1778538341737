{"type":"new","contents":"/-\nCopyright (c) 2025 Oliver Butterley. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: Oliver Butterley, Yoh Tanimoto\n-/\n\nimport Mathlib\nimport Mathlib.MeasureTheory.VectorMeasure.Basic\nimport Mathlib.MeasureTheory.VectorMeasure.Variation.Defs\n\nopen MeasureTheory\n\nnamespace ComplexRMK\n\nvariable {X : Type*} [MeasurableSpace X]\n\ntheorem exists_l1_eq_withDensity_variation_lambda (μ : ComplexMeasure X) (lambda : Measure X)\n    [SigmaFinite lambda] (h_ac : μ ≪ᵥ lambda.toENNRealVectorMeasure) :\n    ∃ h : X → ℂ, Integrable h lambda ∧\n    μ = lambda.withDensityᵥ h := by\n  let μ_re := MeasureTheory.ComplexMeasure.re μ\n  let μ_im := MeasureTheory.ComplexMeasure.im μ\n  have h_re : μ_re ≪ᵥ lambda.toENNRealVectorMeasure := by\n    apply VectorMeasure.AbsolutelyContinuous.mk\n    intro s hmeas hs\n    rw [Measure.toENNRealVectorMeasure_apply_measurable hmeas] at hs\n    have : μ s = 0 := enorm_eq_zero.mp (le_antisymm (h_ac hmeas hs) (by positivity))\n    rw [MeasureTheory.ComplexMeasure.re_apply, this, Complex.zero_re]\n  have h_im : μ_im ≪ᵥ lambda.toENNRealVectorMeasure := by\n    apply VectorMeasure.AbsolutelyContinuous.mk\n    intro s hmeas hs\n    rw [Measure.toENNRealVectorMeasure_apply_measurable hmeas] at hs\n    have : μ s = 0 := enorm_eq_zero.mp (le_antisymm (h_ac hmeas hs) (by positivity))\n    rw [MeasureTheory.ComplexMeasure.im_apply, this, Complex.zero_im]\n  let f_re := μ_re.rnDeriv lambda\n  have hf_re_int := integrable_rnDeriv μ_re lambda\n  have hf_re_eq := μ_re.withDensityᵥ_rnDeriv_eq lambda h_re\n  let f_im := μ_im.rnDeriv lambda\n  have hf_im_int := integrable_rnDeriv μ_im lambda\n  have hf_im_eq := μ_im.withDensityᵥ_rnDeriv_eq lambda h_im\n  let h (x : X) : ℂ := ⟨f_re x, f_im x⟩\n  use h\n  constructor\n  · exact hf_re_int.complex_ofReal.add (hf_im_int.complex_ofReal.mul_const Complex.I)\n  · ext s hmeas\n    rw [VectorMeasure.withDensityᵥ_apply _ hmeas]\n    · apply Complex.ext\n      · rw [← VectorMeasure.withDensityᵥ_apply hf_re_int hmeas, hf_re_eq, \n            MeasureTheory.ComplexMeasure.re_apply]\n        rfl\n      · rw [← VectorMeasure.withDensityᵥ_apply hf_im_int hmeas, hf_im_eq, \n            MeasureTheory.ComplexMeasure.im_apply]\n        rfl\n    · exact hf_re_int.complex_ofReal.add (hf_im_int.complex_ofReal.mul_const Complex.I)\n\ninstance (μ : ComplexMeasure X) : IsFiniteMeasure μ.variation := \n  ⟨VectorMeasure.variation_lt_top μ Set.univ⟩\n\ntheorem exists_l1_eq_withDensity_variation (μ : ComplexMeasure X) :\n    ∃ h : X → ℂ, Integrable h μ.variation ∧\n    μ = μ.variation.withDensityᵥ h := by\n  have : SigmaFinite μ.variation := inferInstance\n  apply exists_l1_eq_withDensity_variation_lambda\n  apply VectorMeasure.AbsolutelyContinuous.mk\n  intro s hmeas hs\n  rw [Measure.toENNRealVectorMeasure_apply_measurable hmeas] at hs\n  have h_le : ‖μ s‖ₑ ≤ μ.variation s := by\n    rw [VectorMeasure.variation, VectorMeasure.ennrealToMeasure_apply hmeas]\n    exact MeasureTheory.preVariation.sum_le (‖μ ·‖ₑ) hmeas (Finpartition.top hmeas)\n  have : μ s = 0 := enorm_eq_zero.mp (le_antisymm (hs ▸ h_le) (by positivity))\n  exact this\n\nend ComplexRMK\n","mtime":1778538341737}