R = QQ[n,L];
dlaSYK4 = 2^(2*4-1)-2;
dlaSK8 = 2*(4^(8-1)-1);
poolSK8 = 8*(8-1);
poolSYK4 = 4 + 3*4*(4-1)//2;
majoranas4 = 2*4;
hilbert10 = 2^10;
cl55MatrixDim = 32*32;
clBalanced5 = 2^(2*5);
assert(dlaSYK4 == 126);
assert(dlaSK8 == 32766);
assert(poolSK8 == 56);
assert(poolSYK4 == 22);
assert(majoranas4 == 8);
assert(hilbert10 == 1024);
assert(cl55MatrixDim == 2^10);
assert(clBalanced5 == 1024);
W = QQ[q,dq, WeylAlgebra => {q=>dq}];
I = ideal(q*dq - dq*q - 1);
assert(numgens I == 1);
edges = {"has_pool_size","has_dla_dimension","embeds_by","realizes_cl55_block","scales_as"};
assert(#edges == 5);
print {dlaDimSYK4=>dlaSYK4, dlaDimSK8=>dlaSK8, poolSK8=>poolSK8, poolSYK4=>poolSYK4, majoranas4=>majoranas4, cl55MatrixDim=>cl55MatrixDim, dmoduleCCRGenerators=>numgens I, graphEdges=>#edges};
