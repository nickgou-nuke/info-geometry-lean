import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Data.Real.Basic
import Mathlib.Tactic

namespace InfoGeometry.Attention.ResidualMetriplecticFlow

open Matrix

abbrev Mat2R := Matrix (Fin 2) (Fin 2) ℝ
abbrev Vec2R := Fin 2 → ℝ

/-- The Dirac grading involution G = diag(1, -1). -/
def G_grading : Mat2R :=
  !![1,  0;
     0, -1]

/-- The diagonal dissipative core of the attention operator: diag(M). -/
def diag_core (M : Mat2R) : Mat2R :=
  !![M 0 0, 0;
     0, M 1 1]

/-- The off-diagonal chiral bipolar transport operator: C(M). -/
def chiral_bipolar (M : Mat2R) : Mat2R :=
  !![0, M 0 1;
     M 1 0, 0]

/-!
# Archetype 908 & 909: Residual Step as an Euler-Metriplectic Integrator
The transformer residual step x_{l+1} = x_l + M *ᵥ x_l is the exact forward-Euler
discretization of the continuous flow ẋ = M x = diag(M)x + C(M)x.
The layer propagator is the matrix: T = 𝕀₂ + M.
-/

/-- The discrete residual step mapping state x to x + M *ᵥ x. -/
def residual_step (M : Mat2R) (x : Vec2R) : Vec2R :=
  x + M *ᵥ x

/-- The total layer propagator matrix: T(M) = 𝕀₂ + M. -/
def layer_propagator (M : Mat2R) : Mat2R :=
  (1 : Mat2R) + M

/-- Master Theorem 1: The Residual Step is Generated by the Propagator Matrix.
    residual_step(M, x) = T(M) *ᵥ x identically for all states x. -/
theorem residual_step_eq_propagator_mul (M : Mat2R) (x : Vec2R) :
    residual_step M x = (layer_propagator M) *ᵥ x := by
  dsimp [residual_step, layer_propagator]
  rw [Matrix.add_mulVec, Matrix.one_mulVec]

/-- Master Theorem 2: Metriplectic Decomposition of the Layer Propagator.
    T(M) decomposes into an identity-shifted dissipative core and the chiral channel:
      T(M) = (𝕀₂ + diag_core(M)) + chiral_bipolar(M). -/
theorem propagator_metriplectic_split (M : Mat2R) :
    layer_propagator M = ((1 : Mat2R) + diag_core M) + chiral_bipolar M := by
  dsimp [layer_propagator, diag_core, chiral_bipolar]
  ext i j
  fin_cases i <;> fin_cases j <;> {
    simp only [Matrix.add_apply, Matrix.one_apply_eq, Matrix.one_apply_ne,
               cons_val_zero, cons_val_one, head_cons]
    ring
  }

/-!
# Archetype 910: Reversible Kinetic Energy Conservation under C(M)
When the cross-attention is skew-symmetric (M₀₁ = -M₁₀), the chiral channel
acts as an infinitesimal rotation that conserves the Euclidean norm:
  xᵀ * (C(M) *ᵥ x) = 0.
-/

/-- The standard Euclidean norm squared on ℝ²: ‖x‖² = x₀² + x₁². -/
def norm_sq (x : Vec2R) : ℝ :=
  x 0 ^ 2 + x 1 ^ 2

/-- The Euclidean inner product on ℝ²: ⟨x, y⟩ = x₀y₀ + x₁y₁. -/
def dot_product (x y : Vec2R) : ℝ :=
  x 0 * y 0 + x 1 * y 1

/-- Master Theorem 3: Chiral Transport is Orthogonal to State for Skew-Symmetric Coupling.
    When M₀₁ = -M₁₀, the chiral channel generates no radial motion: ⟨x, C(M)x⟩ = 0. -/
theorem chiral_transport_orthogonal_to_state (M : Mat2R) (x : Vec2R)
    (h_skew : M 0 1 = - M 1 0) :
    dot_product x (chiral_bipolar M *ᵥ x) = 0 := by
  dsimp [dot_product, chiral_bipolar, mulVec, dotProduct]
  simp only [Fin.sum_univ_two, cons_val_zero, cons_val_one, head_cons]
  have h_alg : x 0 * (M 0 1 * x 1) + x 1 * (M 1 0 * x 0) =
               (M 0 1 + M 1 0) * (x 0 * x 1) := by ring
  rw [h_alg, h_skew]
  ring

/-!
# Archetype 911 & 912: Dissipative Contraction and Lyapunov Stability
The diagonal dissipative core diag(M) contracts the radial distance when its
eigenvalues represent dissipation (M₀₀ < 0, M₁₁ < 0 in relaxation coordinates,
or M₀₀ + M₁₁ contracting relative to the softmax baseline).
Here we prove the exact energy change across a residual step.
-/

/-- The exact quadratic energy change across a residual step:
    ΔE = ‖x_{l+1}‖² - ‖x_l‖². -/
def energy_change (M : Mat2R) (x : Vec2R) : ℝ :=
  norm_sq (residual_step M x) - norm_sq x

/-- Master Theorem 4: The Algebraic Energy Dissipation Formula.
    For any residual step, the change in state energy evaluates identically to:
      ΔE = 2 * ⟨x, Mx⟩ + ‖Mx‖². -/
theorem residual_energy_change_exact (M : Mat2R) (x : Vec2R) :
    energy_change M x = 2 * dot_product x (M *ᵥ x) + norm_sq (M *ᵥ x) := by
  dsimp [energy_change, residual_step, norm_sq, dot_product, mulVec, dotProduct]
  simp only [Fin.sum_univ_two, cons_val_zero, cons_val_one, head_cons]
  ring

/-- Master Theorem 5: Separation of Dissipative and Chiral Energy Fluxes.
    When cross-attention is skew-symmetric (M₀₁ = -M₁₀), the linear energy flux
    is governed EXCLUSIVELY by the dissipative diagonal core:
      ⟨x, Mx⟩ = ⟨x, diag_core(M)x⟩ = M₀₀ x₀² + M₁₁ x₁². -/
theorem linear_energy_flux_is_purely_diagonal (M : Mat2R) (x : Vec2R)
    (h_skew : M 0 1 = - M 1 0) :
    dot_product x (M *ᵥ x) = M 0 0 * (x 0 ^ 2) + M 1 1 * (x 1 ^ 2) := by
  have h_split : M = diag_core M + chiral_bipolar M := by
    ext i j; fin_cases i <;> fin_cases j <;> { dsimp [diag_core, chiral_bipolar]; ring }
  rw [h_split]
  have h_add_mulVec : (diag_core M + chiral_bipolar M) *ᵥ x =
                      diag_core M *ᵥ x + chiral_bipolar M *ᵥ x := by
    rw [Matrix.add_mulVec]
  rw [h_add_mulVec]
  have h_dot_add : dot_product x (diag_core M *ᵥ x + chiral_bipolar M *ᵥ x) =
                   dot_product x (diag_core M *ᵥ x) + dot_product x (chiral_bipolar M *ᵥ x) := by
    dsimp [dot_product]
    ring
  rw [h_dot_add]
  rw [chiral_transport_orthogonal_to_state M x h_skew, add_zero]
  dsimp [dot_product, diag_core, mulVec, dotProduct]
  simp only [Fin.sum_univ_two, cons_val_zero, cons_val_one, head_cons]
  ring

/-- Master Theorem 6: Casimir Invariance of the Residual Propagator Trace.
    The trace pairing with the grading involution G = diag(1, -1) is
    completely independent of the chiral cross-attention coupling:
      tr(G * T(M)) = M₀₀ - M₁₁. -/
theorem residual_propagator_casimir_trace (M : Mat2R) :
    Matrix.trace (G_grading * layer_propagator M) = M 0 0 - M 1 1 := by
  dsimp [G_grading, layer_propagator, Matrix.trace]
  simp only [Fin.sum_univ_two, Matrix.mul_apply, Matrix.add_apply, Matrix.one_apply_eq, Matrix.one_apply_ne]
  simp only [cons_val_zero, cons_val_one, head_cons]
  ring

end InfoGeometry.Attention.ResidualMetriplecticFlow
