-- Setup polynomial ring for effective charges e_pi, e_nu and matrix elements M_IS, M_IV
R = QQ[e_pi, e_nu, M_IS, M_IV, M_1, M_2, MonomialOrder => Lex]

-- Define the ideal generated by the mirror pair B(E2) transition equations
I = ideal(
    M_1 - (e_pi * M_IS + e_nu * M_IV),
    M_2 - (e_nu * M_IS + e_pi * M_IV)
)

-- Compute the Groebner basis to uniquely solve for e_pi and e_nu
G = gb I
print "=== Groebner basis (solving for e_pi and e_nu) ==="
print gens G

-- Define the algebraic variety of the 2x2 isospin mixing matrix
R2 = QQ[v11, v12, v21, v22]
-- 2x2 orthogonal matrix conditions
J = ideal(
    v11^2 + v12^2 - 1,
    v21^2 + v22^2 - 1,
    v11*v21 + v12*v22
)

-- Compute its dimension
d = dim J
print ""
print "=== Dimension of the 2x2 isospin mixing matrix variety ==="
print d

-- Print PASS/FAIL
if d == 1 then print "PASS" else print "FAIL"
exit(0)
