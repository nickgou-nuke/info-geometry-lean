import Mathlib.Algebra.Polynomial.Taylor

/-!
# Exact polynomial evaluation along square-zero directions

The ambient `R`-algebra may be noncommutative. A square-zero direction `N`
gives the scalar formal-derivative formula at a base point `x` when `x`
commutes with `N`. The proof constructs the native subalgebra generated by
these two elements, proves its commutativity from that hypothesis, applies
Mathlib's polynomial theorem there, and maps the equality back to the original
algebra. No commutativity assumption on the ambient algebra is introduced.

At a central scalar base point, the needed commutation follows from the
algebra laws. At zero, evaluation reads only the constant and linear
coefficients. Neither theorem assumes that the direction is nonzero.
These are polynomial identities; no analytic functional calculus is asserted.
-/

set_option autoImplicit false

namespace InfoGeometry.Algebra.NilpotentPolynomial

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

open scoped IsMulCommutative in
/-- The formal derivative gives the exact polynomial change along a
square-zero direction that commutes with the base point. -/
theorem aeval_add_of_commute_of_sq_zero (f : Polynomial R) {x N : A}
    (hcomm : Commute x N) (hN : N * N = 0) :
    Polynomial.aeval (x + N) f =
      Polynomial.aeval x f + Polynomial.aeval x f.derivative * N := by
  let S : Subalgebra R A := Algebra.adjoin R ({x, N} : Set A)
  have hpair : ({x, N} : Set A).Pairwise Commute :=
    Set.pairwise_pair.mpr fun _ => ⟨hcomm, hcomm.symm⟩
  let : IsMulCommutative S := Algebra.isMulCommutative_adjoin R hpair
  let xS : S := ⟨x, Algebra.subset_adjoin (by simp)⟩
  let nS : S := ⟨N, Algebra.subset_adjoin (by simp)⟩
  have hnS : nS ^ 2 = 0 := by
    apply Subtype.ext
    change N ^ 2 = 0
    simpa only [pow_two] using hN
  have h := congrArg S.val (Polynomial.aeval_add_of_sq_eq_zero f xS nS hnS)
  simp only [map_add, map_mul, ← Polynomial.aeval_algHom_apply] at h
  simpa only [Subalgebra.val_apply, xS, nS] using h

/-- Evaluation at a square-zero operator retains exactly the constant and
linear coefficients of a polynomial over the central coefficient ring. -/
theorem aeval_of_sq_zero (f : Polynomial R) {N : A} (hN : N * N = 0) :
    Polynomial.aeval N f =
      algebraMap R A (f.coeff 0) + algebraMap R A (f.coeff 1) * N := by
  have h := aeval_add_of_commute_of_sq_zero f (Commute.zero_left N) hN
  simpa only [zero_add, ← Polynomial.coeff_zero_eq_aeval_zero',
    Polynomial.coeff_derivative, Nat.cast_zero, Nat.cast_one, mul_one] using h

/-- Exact first-order polynomial calculus at any central scalar base point,
with the operator-valued term retained in the ambient noncommutative algebra. -/
theorem aeval_scalar_add_of_sq_zero (f : Polynomial R) (r : R)
    {N : A} (hN : N * N = 0) :
    Polynomial.aeval (algebraMap R A r + N) f =
      algebraMap R A (f.eval r) + algebraMap R A (f.derivative.eval r) * N := by
  have h := aeval_add_of_commute_of_sq_zero f (Algebra.commutes r N) hN
  simpa only [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval] using h

end InfoGeometry.Algebra.NilpotentPolynomial
