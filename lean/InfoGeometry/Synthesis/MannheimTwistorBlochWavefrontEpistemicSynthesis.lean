/-! ## Section 1 (`MA₈A`): Twistor–Plücker–SuperGrassmannian, Infinity-Twistor Dilaton & Helical Pitch -/

section MA8A_TwistorDilatonPitch

/-- Non-incident twistor helical pitch squared `|⟨Z, W⟩|² / (4 |⟨Z, W⟩_∞|²)`. -/
def twistorHelicalPitchSq (Z W : Twistor4) : ℝ :=
  Complex.normSq (wittPair Z W) / (4 * pairMassSq Z W)

/-- Dilaton-compensated twistor mass invariant `S⁴ |⟨Z, W⟩_∞|²`. -/
def dilatonCompensatedMass (S : ℝ) (Z W : Twistor4) : ℝ :=
  S ^ 4 * pairMassSq Z W

lemma spinorMinor_smul (c d : ℂ) (Z W : Twistor4) :
    spinorMinor ((c • Z).2) ((d • W).2) = c * d * spinorMinor Z.2 W.2 := by
  unfold spinorMinor
  change (c * Z.2 0) * (d * W.2 1) - (c * Z.2 1) * (d * W.2 0) =
    c * d * (Z.2 0 * W.2 1 - Z.2 1 * W.2 0)
  ring

lemma pairMassSq_realScale (β : ℝ) (Z W : Twistor4) :
    pairMassSq ((Real.exp β : ℂ) • Z) ((Real.exp β : ℂ) • W) =
      Real.exp (4 * β) * pairMassSq Z W := by
  unfold pairMassSq
  rw [spinorMinor_smul, Complex.normSq_mul, Complex.normSq_mul]
  simp only [Complex.normSq_ofReal]
  have hexp : Real.exp β * Real.exp β * (Real.exp β * Real.exp β) = Real.exp (4 * β) := by
    rw [← Real.exp_add, ← Real.exp_add]
    congr 1; ring
  rw [hexp]

/-- **Twistor–Plücker–Amplituhedron–`Cl(5,5)` SuperGrassmannian & Infinity-Twistor Dilaton Pitch**:
1. Plücker–Klein nullity (`twistorPairPlucker_on_klein`), independent surjectivity of Witt and
   infinity pairings (`pairings_surjective`), amplituhedron positive cyclic brackets, and the
   `Cl(5,5) ≅ Cl(1,1) ⊗ Cl(4,4)` 5-graded KKT ladder + Penrose incidence quadric;
2. Conformal scale `c = exp β` breaks `pairMassSq` by `exp (4 * β)` via `infinityTwistor`, whereas
   `dilatonCompensatedMass` is strictly invariant under `(S, Z, W) ↦ (exp(-β) S, exp(β) Z, exp(β) W)`;
3. Whenever two twistors are non-incident wrt `infinityTwistor` (`infinityTwistor Z W ≠ 0`),
   `0 < pairMassSq Z W`, `twistorHelicalPitchSq` is conformally scale-invariant, and
   `0 < twistorHelicalPitchSq Z W ↔ wittPair Z W ≠ 0`;
4. Connects directly to `ZitterbewegungMassEmergence` subluminal velocity and Compton frequency. -/
theorem twistor_infinity_dilaton_helical_pitch_synthesis :
    (∀ Z W : Twistor4, InfoGeometry.Projective.KleinQuadricPlucker.Plucker6.kleinQ (twistorPairPlucker Z W) = 0) ∧
    Function.Surjective (fun P : PairFrame => (infinityTwistor (P 0) (P 1), wittPair (P 0) (P 1))) ∧
    (2 ^ 2 * 2 ^ 8 = 2 ^ 10 ∧ Nat.choose 10 2 = 45 ∧
      ∀ {t₁ t₂ t₃ t₄ : ℝ}, 0 < t₁ → 0 < t₂ → 0 < t₃ → 0 < t₄ →
        ∀ {Z : Matrix (Fin 4) (Fin 4) ℝ}, 0 < det4 Z →
          let C := boundaryMeasurementMatrix t₁ t₂ t₃ t₄
          0 < twistorBracket (twistorProj C Z) Z 0 1) ∧
    (∀ {R : Type} [CommRing R] (X : Matrix (Fin 8) (Fin 8) R) (Z : Twistor55 R),
      Xᵀ = -X → PenroseTwistorIncidence X Z → twistorNeutralPairing Z Z = 0) ∧
    (∀ β S : ℝ, ∀ Z W : Twistor4,
      pairMassSq ((Real.exp β : ℂ) • Z) ((Real.exp β : ℂ) • W) = Real.exp (4 * β) * pairMassSq Z W ∧
      dilatonCompensatedMass (Real.exp (-β) * S) ((Real.exp β : ℂ) • Z) ((Real.exp β : ℂ) • W) =
        dilatonCompensatedMass S Z W) ∧
    (∀ β : ℝ, ∀ Z W : Twistor4, infinityTwistor Z W ≠ 0 →
      0 < pairMassSq Z W ∧
      twistorHelicalPitchSq ((Real.exp β : ℂ) • Z) ((Real.exp β : ℂ) • W) =
        twistorHelicalPitchSq Z W ∧
      (0 < twistorHelicalPitchSq Z W ↔ wittPair Z W ≠ 0)) ∧
    (∀ p m c hbar : ℝ, m ≠ 0 → c ≠ 0 →
      velocityRatioSq p m c < 1 ∧ comptonFrequency m c hbar = 2 * m * c ^ 2 / hbar) := by
  refine ⟨twistorPairPlucker_on_klein, pairings_surjective, ?_, ?_, ?_, ?_, ?_⟩
  · refine ⟨cl11_cl44_cl55_carrier_factorization.2.2.2.1, spin55_bivector_kkt_decomposition.1, ?_⟩
    intro t₁ t₂ t₃ t₄ h1 h2 h3 h4 Z hZ
    exact (twistor_bracket_signs_from_positive_parameters h1 h2 h3 h4 hZ).1
  · intro R _ X Z hskew hinc
    exact penrose_incidence_null_of_skewSymmetric X Z hskew hinc
  · intro β S Z W
    have hmass := pairMassSq_realScale β Z W
    refine ⟨hmass, ?_⟩
    unfold dilatonCompensatedMass
    rw [hmass]
    have hcomp : (Real.exp (-β)) ^ 4 * Real.exp (4 * β) = 1 := by
      calc
        (Real.exp (-β)) ^ 4 * Real.exp (4 * β)
            = Real.exp (-β + -β + -β + -β + 4 * β) := by
              rw [show (Real.exp (-β)) ^ 4 =
                Real.exp (-β) * Real.exp (-β) * Real.exp (-β) * Real.exp (-β) by ring]
              rw [← Real.exp_add, ← Real.exp_add, ← Real.exp_add, ← Real.exp_add]
        _ = 1 := by rw [show -β + -β + -β + -β + 4 * β = 0 by ring, Real.exp_zero]
    calc
      (Real.exp (-β) * S) ^ 4 * (Real.exp (4 * β) * pairMassSq Z W)
          = ((Real.exp (-β)) ^ 4 * Real.exp (4 * β)) * (S ^ 4 * pairMassSq Z W) := by ring
      _ = S ^ 4 * pairMassSq Z W := by rw [hcomp, one_mul]
  · intro β Z W hinf
    have hne0 : pairMassSq Z W ≠ 0 := by
      intro hz
      exact hinf ((pairMassSq_zero_iff_infinityTwistor_pairing_zero Z W).mp hz)
    have hpos : 0 < pairMassSq Z W :=
      lt_of_le_of_ne (Complex.normSq_nonneg _) hne0.symm
    have hnum : Complex.normSq (wittPair ((Real.exp β : ℂ) • Z) ((Real.exp β : ℂ) • W)) =
        Real.exp (4 * β) * Complex.normSq (wittPair Z W) := by
      rw [wittPair_smul, Complex.normSq_mul, Complex.normSq_mul]
      simp only [Complex.star_def, Complex.conj_ofReal, Complex.normSq_ofReal]
      have hexp4 : Real.exp β * Real.exp β * (Real.exp β * Real.exp β) = Real.exp (4 * β) := by
        rw [← Real.exp_add, ← Real.exp_add]
        congr 1; ring
      rw [hexp4]
    have hinv : twistorHelicalPitchSq ((Real.exp β : ℂ) • Z) ((Real.exp β : ℂ) • W) =
        twistorHelicalPitchSq Z W := by
      unfold twistorHelicalPitchSq
      rw [hnum, pairMassSq_realScale]
      have hexp_pos : 0 < Real.exp (4 * β) := Real.exp_pos _
      field_simp [hexp_pos.ne', hpos.ne']
    have hpitch_pos : 0 < twistorHelicalPitchSq Z W ↔ wittPair Z W ≠ 0 := by
      unfold twistorHelicalPitchSq
      rw [div_pos_iff_of_pos_right (mul_pos (by norm_num) hpos), Complex.normSq_pos]
    exact ⟨hpos, hinv, hpitch_pos⟩
  · intro p m c hbar hm hc
    exact ⟨velocity_strictly_subluminal p m c hm hc, comptonFrequency_eq m c hbar⟩

end MA8A_TwistorDilatonPitch

/-! ## Section 2 (`MA₈B`): Möbius–Tomita Triality, `0 → 1 → 0` Wavefront Leaflets & Orthogonal Weyl–Souriau Bloch Entropy -/

section MA8B_MobiusTomitaBloch

/-- Fisher–logistic compactified `0 → 1 → 0` wavefront leaflet `4 σ(τ) (1 - σ(τ))`. -/
def fisherLeaflet (τ : ℝ) : ℝ :=
  4 * logistic τ * (1 - logistic τ)

/-- Stereographic projective temperature `0 → 1 → 0` wavefront leaflet `(2 β / (β² + 1))²`. -/
def stereoLeaflet (β : ℝ) : ℝ :=
  stereographicTemperatureX β ^ 2

/-- Traceless part `M - (Tr(M) / 2) I₂` orthogonal to the trace scalar in `M₂(ℂ)`. -/
def tracelessPart2 (M : Matrix (Fin 2) (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  M - (Matrix.trace M / 2) • (1 : Matrix (Fin 2) (Fin 2) ℂ)

/-- Weyl-ray projection `W ↦ (Tr W)⁻¹ • W` collapsing conformal scale orbits onto `Tr = 1`. -/
def weylNormalize (M : Matrix (Fin 2) (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  (Matrix.trace M)⁻¹ • M

lemma fisherLeaflet_formula (τ : ℝ) :
    fisherLeaflet τ = 4 * Real.exp τ / (1 + Real.exp τ) ^ 2 := by
  have hden : 1 + Real.exp τ ≠ 0 := ne_of_gt (by positivity)
  unfold fisherLeaflet logistic
  field_simp [hden]
  ring

/-- **Möbius–Tomita Triality & `0 → 1 → 0` Compactified Wavefront Leaflets**:
1. Connects `mobiusPunctureEquiv` (`ℂ \ {0, 1} ≃ ℂ \ {0, -1}`), `crossRatio01_logistic`, `eta_logistic`,
   `radialLogTime_inv`, `betaInvert_mem_Ioo_zero_one_of_one_lt`, `stereographicTemperature_on_unit_circle`,
   `unitarity_enforced_each_tick`, `time_derivative_eats_dilaton`, `finiteKrein_idempotent_exponential_formula`,
   `finiteKrein_idempotent_exponential_add`, and `criticalLine_sheet_readouts_inverse`;
2. `fisherLeaflet τ` runs `0 → 1 → 0`: symmetric `fisherLeaflet (-τ) = fisherLeaflet τ`, strictly positive,
   bounded above by `1` with `fisherLeaflet τ = 1 ↔ τ = 0`, and `Tendsto` `0` at both `+∞` and `-∞`;
3. `stereoLeaflet β` runs `0 → 1 → 0`: `0 ≤ stereoLeaflet β ≤ 1`, `stereoLeaflet β = 1 ↔ β = 1 ∨ β = -1`,
   `betaInvert`-invariant on `β ≠ 0`, and `Tendsto` `0` at both `+∞` and `-∞`. -/
theorem mobius_tomita_wavefront_leaflet_triality :
    (∀ s : SourcePoint, inverseCrossRatio01 (crossRatio01 (s : ℂ)) = (s : ℂ)) ∧
    (∀ τ : ℝ, crossRatio01 (logistic τ : ℂ) = (Real.exp τ : ℂ) ∧ eta (logistic τ : ℂ) = τ) ∧
    (∀ z : ℂ, radialLogTime z⁻¹ = -radialLogTime z) ∧
    (∀ β : ℝ, 1 < β → betaInvert β ∈ Set.Ioo (0 : ℝ) 1 ∧
      stereographicTemperatureX β ^ 2 + stereographicTemperatureY β ^ 2 = 1) ∧
    (∀ x lam τ : ℝ, andreev_contraction (hyperbolic_expansion x lam τ) lam τ = x ∧
      HasDerivAt (fun t => hyperbolic_expansion x lam t) (dilaton_generator lam (hyperbolic_expansion x lam τ)) τ) ∧
    (∀ s t y : ℝ, finiteKreinIdempotentExponential (s + t) =
        finiteKreinIdempotentExponential s * finiteKreinIdempotentExponential t ∧
      sheetCayleyReadout (minusLift (criticalLine y)) =
        (sheetCayleyReadout (plusLift (criticalLine y)))⁻¹ ∧
      ∀ ψ : SheetAmplitude, antiLinearDeck (antiLinearDeck ψ) = ψ) ∧
    (∀ τ : ℝ, 0 < fisherLeaflet τ ∧ fisherLeaflet τ ≤ 1 ∧ (fisherLeaflet τ = 1 ↔ τ = 0) ∧
      fisherLeaflet (-τ) = fisherLeaflet τ) ∧
    (Filter.Tendsto fisherLeaflet Filter.atTop (nhds 0) ∧
      Filter.Tendsto fisherLeaflet Filter.atBot (nhds 0)) ∧
    (∀ β : ℝ, 0 ≤ stereoLeaflet β ∧ stereoLeaflet β ≤ 1 ∧
      (stereoLeaflet β = 1 ↔ β = 1 ∨ β = -1) ∧
      (β ≠ 0 → stereoLeaflet (betaInvert β) = stereoLeaflet β)) ∧
    (Filter.Tendsto stereoLeaflet Filter.atTop (nhds 0) ∧
      Filter.Tendsto stereoLeaflet Filter.atBot (nhds 0)) := by
  refine ⟨fun s => inverseCrossRatio01_crossRatio01 s.property,
    fun τ => ⟨crossRatio01_logistic τ, eta_logistic τ⟩,
    radialLogTime_inv,
    fun β hβ => ⟨betaInvert_mem_Ioo_zero_one_of_one_lt hβ, stereographicTemperature_on_unit_circle β⟩,
    fun x lam τ => ⟨unitarity_enforced_each_tick x lam τ, time_derivative_eats_dilaton x lam τ⟩,
    fun s t y => ⟨finiteKrein_idempotent_exponential_add s t,
      criticalLine_sheet_readouts_inverse y, antiLinearDeck_sq⟩,
    ?_, ?_, ?_, ?_⟩
  · intro τ
    have he := Real.exp_pos τ
    have hden : 0 < (1 + Real.exp τ) ^ 2 := by positivity
    have hpos : 0 < fisherLeaflet τ := by
      rw [fisherLeaflet_formula]
      exact div_pos (by positivity) hden
    have hsub : 1 - fisherLeaflet τ = ((Real.exp τ - 1) ^ 2) / (1 + Real.exp τ) ^ 2 := by
      rw [fisherLeaflet_formula]
      field_simp [ne_of_gt (by positivity : 0 < 1 + Real.exp τ)]
      ring
    have hle : fisherLeaflet τ ≤ 1 := by
      have hsq : 0 ≤ (Real.exp τ - 1) ^ 2 / (1 + Real.exp τ) ^ 2 := div_nonneg (sq_nonneg _) hden.le
      linarith [hsub]
    have hiff : fisherLeaflet τ = 1 ↔ τ = 0 := by
      rw [fisherLeaflet_formula, div_eq_one_iff_eq hden.ne']
      constructor
      · intro hEq
        have hsq0 : (Real.exp τ - 1) ^ 2 = 0 := by linarith
        have hexp1 : Real.exp τ = 1 := sub_eq_zero.mp (sq_eq_zero_iff.mp hsq0)
        rwa [Real.exp_eq_one_iff] at hexp1
      · intro h0
        subst h0
        norm_num
    have hsym : fisherLeaflet (-τ) = fisherLeaflet τ := by
      rw [fisherLeaflet_formula, fisherLeaflet_formula, Real.exp_neg]
      field_simp [he.ne', ne_of_gt (by positivity : 0 < 1 + Real.exp τ)]
      ring
    exact ⟨hpos, hle, hiff, hsym⟩
  · have hAtTop : Filter.Tendsto fisherLeaflet Filter.atTop (nhds 0) := by
      have hnorm : ∀ᶠ τ : ℝ in Filter.atTop,
          fisherLeaflet τ = 4 / (Real.exp τ + 2 + (Real.exp τ)⁻¹) := by
        filter_upwards with τ
        rw [fisherLeaflet_formula]
        have he := (Real.exp_pos τ).ne'
        field_simp [he, ne_of_gt (by positivity : 0 < 1 + Real.exp τ)]
        ring
      have hden_lim : Filter.Tendsto (fun τ : ℝ => Real.exp τ + 2 + (Real.exp τ)⁻¹)
          Filter.atTop Filter.atTop := by
        have h1 : Filter.Tendsto Real.exp Filter.atTop Filter.atTop := Real.tendsto_exp_atTop
        have hinv : Filter.Tendsto (fun τ : ℝ => (Real.exp τ)⁻¹) Filter.atTop (nhds 0) :=
          tendsto_inv_atTop_zero.comp h1
        have h12 : Filter.Tendsto (fun τ : ℝ => Real.exp τ + 2) Filter.atTop Filter.atTop :=
          h1.atTop_add tendsto_const_nhds
        exact h12.atTop_add hinv
      have hdiv : Filter.Tendsto (fun τ : ℝ => 4 / (Real.exp τ + 2 + (Real.exp τ)⁻¹))
          Filter.atTop (nhds 0) :=
        tendsto_const_nhds.div_atTop hden_lim
      exact hdiv.congr' (hnorm.mono fun _ h => h.symm)
    have hAtBot : Filter.Tendsto fisherLeaflet Filter.atBot (nhds 0) := by
      have heven : fisherLeaflet ∘ Neg.neg = fisherLeaflet := by
        ext τ
        rw [Function.comp_apply, fisherLeaflet_formula, fisherLeaflet_formula, Real.exp_neg]
        field_simp [(Real.exp_pos τ).ne']
        ring
      rw [← heven]
      exact hAtTop.comp Filter.tendsto_neg_atBot_atTop
    exact ⟨hAtTop, hAtBot⟩
  · intro β
    have hden_pos : 0 < (β ^ 2 + 1) ^ 2 := by positivity
    have hnonneg : 0 ≤ stereoLeaflet β := sq_nonneg _
    have hsub : 1 - stereoLeaflet β = ((β ^ 2 - 1) ^ 2) / (β ^ 2 + 1) ^ 2 := by
      unfold stereoLeaflet stereographicTemperatureX
      field_simp [ne_of_gt (by positivity : 0 < β ^ 2 + 1)]
      ring
    have hle : stereoLeaflet β ≤ 1 := by
      have h0 : 0 ≤ (β ^ 2 - 1) ^ 2 / (β ^ 2 + 1) ^ 2 := div_nonneg (sq_nonneg _) hden_pos.le
      linarith [hsub]
    have hiff : stereoLeaflet β = 1 ↔ β = 1 ∨ β = -1 := by
      unfold stereoLeaflet stereographicTemperatureX
      rw [div_pow, div_eq_one_iff_eq hden_pos.ne']
      constructor
      · intro hEq
        have hsq : (β ^ 2 - 1) ^ 2 = 0 := by linarith
        have hb2 : β ^ 2 = 1 := sub_eq_zero.mp (sq_eq_zero_iff.mp hsq)
        exact sq_eq_one_iff.mp hb2
      · rintro (rfl | rfl) <;> norm_num
    have hinv : β ≠ 0 → stereoLeaflet (betaInvert β) = stereoLeaflet β := by
      intro hβ
      unfold stereoLeaflet stereographicTemperatureX betaInvert
      field_simp [hβ]
      ring
    exact ⟨hnonneg, hle, hiff, hinv⟩
  · have hsq_atTop : Filter.Tendsto (fun β : ℝ => β ^ 2) Filter.atTop Filter.atTop :=
      Filter.tendsto_atTop_atTop.mpr fun b =>
        ⟨max b 1, fun x hx => by nlinarith [le_max_left b 1, le_max_right b 1]⟩
    have hAtTop : Filter.Tendsto stereoLeaflet Filter.atTop (nhds 0) := by
      have hnorm : ∀ᶠ β : ℝ in Filter.atTop,
