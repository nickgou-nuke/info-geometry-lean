{"type":"new","contents":"import InfoGeometry.LLM.Llama4SpinSpec\nimport InfoGeometry.Meta.Architecture\n\nopen scoped BigOperators InnerProductSpace\n\nnamespace InfoGeometry.LLM\n\nopen Llama4BlockSpec\n\nsection PromptRegularization\n\nvariable {S : Type*}\nvariable [NormedAddCommGroup S] [InnerProductSpace ℝ S] [CompleteSpace S]\n\nlocal notation \"N\" => InfoGeometry.Krein.NeutralSpace S\nlocal notation \"EndN\" => N →L[ℝ] N\n\nvariable {Pos Expert : Type*} [Fintype Expert] [DecidableEq Expert]\n\n/--\nMangled prompt model: a clean channel plus a perturbation channel weighted by `ε`.\n-/\nstructure MangledPrompt where\n  clean : EndN\n  perturbation : EndN\n  ε : ℝ\n\nnamespace MangledPrompt\n\n/-- Mixed latent input generated by prompt mangling / code-switching perturbations. -/\nnoncomputable def mixedInput (μ : MangledPrompt (S := S)) : EndN :=\n  μ.clean + μ.ε • μ.perturbation\n\nend MangledPrompt\n\n/-- Defect-regularized core update with penalty weight `λ`. -/\nnoncomputable def regularizedCoreUpdate\n    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))\n    (lambda : ℝ) (x : EndN) : EndN :=\n  B.residualUpdate x +\n    ((B.moe.shared x + B.moe.routed.activeOutput x) + lambda • B.moe.routed.defectOutput x)\n\n/-- Regularized run: apply the spin/pin checker layer after regularized core update. -/\nnoncomputable def regularizedRun\n    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))\n    (lambda : ℝ) (x : EndN) : EndN :=\n  B.spinPin.layer.run (regularizedCoreUpdate (B := B) lambda x)\n\nsection OmitDecidableEqPromptLemmas\n\nomit [DecidableEq Expert]\n\n@[rep_depth transport]\ntheorem defect_quarantined_on_mixed_input\n    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))\n    (μ : MangledPrompt (S := S)) :\n    B.moe.routed.defectOutput (MangledPrompt.mixedInput μ) = 0 := by\n  exact B.moe.routed.defectOutput_eq_zero (MangledPrompt.mixedInput μ)\n\n/-- In hard-zero sparse routing, regularized core update is independent of `λ`. -/\n@[rep_depth transport]\ntheorem regularizedCoreUpdate_lambda_invariant\n    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))\n    (lambda1 lambda2 : ℝ) (x : EndN) :\n    regularizedCoreUpdate (B := B) lambda1 x = regularizedCoreUpdate (B := B) lambda2 x := by\n  have hDef : B.moe.routed.defectOutput x = 0 := B.moe.routed.defectOutput_eq_zero x\n  have hZero1 : lambda1 • B.moe.routed.defectOutput x = (0 : EndN) := by\n    rw [hDef]\n    apply ContinuousLinearMap.ext\n    intro y\n    simp\n  have hZero2 : lambda2 • B.moe.routed.defectOutput x = (0 : EndN) := by\n    rw [hDef]\n    apply ContinuousLinearMap.ext\n    intro y\n    simp\n  unfold regularizedCoreUpdate\n  rw [hZero1, hZero2]\n\n/-- Defect-regularized core update collapses to the canonical core update. -/\n@[rep_depth transport]\ntheorem regularizedCoreUpdate_eq_coreUpdate\n    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))\n    (lambda : ℝ) (x : EndN) :\n    regularizedCoreUpdate (B := B) lambda x = B.coreUpdate x := by\n  have hDef : B.moe.routed.defectOutput x = 0 := B.moe.routed.defectOutput_eq_zero x\n  have hZeroDef : lambda • B.moe.routed.defectOutput x = (0 : EndN) := by\n    rw [hDef]\n    apply ContinuousLinearMap.ext\n    intro y\n    simp\n  unfold regularizedCoreUpdate Llama4BlockSpec.coreUpdate Llama4BlockSpec.routedUpdate\n  rw [B.moe.output_eq_shared_plus_active x]\n  rw [hZeroDef]\n  simp\n\n/-- Consequently, the regularized run is independent of `λ`. -/\n@[rep_depth transport]\ntheorem regularizedRun_lambda_invariant\n    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))\n    (lambda1 lambda2 : ℝ) (x : EndN) :\n    regularizedRun (B := B) lambda1 x = regularizedRun (B := B) lambda2 x := by\n  unfold regularizedRun\n  rw [regularizedCoreUpdate_lambda_invariant (B := B) lambda1 lambda2 x]\n\n/-- Mixed-input version: perturbation-induced defect channel remains quarantined. -/\n@[rep_depth transport]\ntheorem regularizedRun_lambda_invariant_on_mixed_input\n    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))\n    (μ : MangledPrompt (S := S))\n    (lambda1 lambda2 : ℝ) :\n    regularizedRun (B := B) lambda1 (MangledPrompt.mixedInput μ)\n      = regularizedRun (B := B) lambda2 (MangledPrompt.mixedInput μ) := by\n  exact regularizedRun_lambda_invariant (B := B) lambda1 lambda2 (MangledPrompt.mixedInput μ)\n\n/-- Regularized run collapses to the canonical spin/pin-checked block run. -/\n@[rep_depth transport]\ntheorem regularizedRun_eq_run\n    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))\n    (lambda : ℝ) (x : EndN) :\n    regularizedRun (B := B) lambda x = B.run x := by\n  unfold regularizedRun Llama4BlockSpec.run\n  rw [regularizedCoreUpdate_eq_coreUpdate (B := B) lambda x]\n\n/-- Mixed-input specialization of the regularized-to-canonical run collapse. -/\n@[rep_depth transport]\ntheorem regularizedRun_eq_run_on_mixed_input\n    (B : Llama4BlockSpec (S := S) (Pos := Pos) (Expert := Expert))\n    (μ : MangledPrompt (S := S))\n    (lambda : ℝ) :\n    regularizedRun (B := B) lambda (MangledPrompt.mixedInput μ)\n      = B.run (MangledPrompt.mixedInput μ) := by\n  exact regularizedRun_eq_run (B := B) lambda (MangledPrompt.mixedInput μ)\n\nend OmitDecidableEqPromptLemmas\n\nend PromptRegularization\n\nend InfoGeometry.LLM\n","mtime":1776602622054}