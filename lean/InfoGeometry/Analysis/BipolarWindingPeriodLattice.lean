import InfoGeometry.Analysis.BipolarLogDifferential
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Projective.KleinQuadricMonodromy
import Mathlib.Tactic

/-!
# Two-puncture winding lattice for the bipolar logarithmic form

The twice-punctured plane has two independent elementary winding directions.
This file formalizes the corresponding integer lattice without asserting a
not-yet-installed global de Rham cohomology classification theorem.

For the specific logarithmic differential

`dq/q = ds/s - ds/(s-1)`

the residue vector is `(1,-1)`.  Therefore a winding pair `(m,n)` is detected
through the difference `m-n`, and its logarithmic period is

`(m-n) * 2πi`.

The diagonal winding `(n,n)` is invisible to this particular difference form.
That does not make the full two-generator winding lattice one-dimensional.
-/

noncomputable section

namespace InfoGeometry.Analysis.BipolarWindingPeriodLattice

open InfoGeometry.Analysis.BipolarLogDifferential
open InfoGeometry.Projective.KleinQuadric.DeRhamMonodromy

/-- Algebraic winding lattice generated by a loop around `0` and a loop around `1`. -/
abbrev WindingPair := ℤ × ℤ

/-- First elementary puncture winding. -/
def originWinding : WindingPair := (1, 0)

/-- Second elementary puncture winding. -/
def oneWinding : WindingPair := (0, 1)

/-- Residue pairing of a winding pair with the bipolar residue vector `(1,-1)`. -/
def residueWinding (w : WindingPair) : ℤ := w.1 - w.2

/-- Complex logarithmic period detected by `dq/q`. -/
def circulationPeriod (w : WindingPair) : ℂ :=
  (residueWinding w : ℂ) * (2 * Real.pi * Complex.I : ℂ)

@[simp] theorem circulationPeriod_origin :
    circulationPeriod originWinding = (2 * Real.pi * Complex.I : ℂ) := by
  simp [circulationPeriod, residueWinding, originWinding]

@[simp] theorem circulationPeriod_one :
    circulationPeriod oneWinding = -(2 * Real.pi * Complex.I : ℂ) := by
  simp [circulationPeriod, residueWinding, oneWinding]

/-- Winding equally around both finite punctures has zero period for the
residue-difference form. -/
def diagonalWinding (n : ℤ) : WindingPair := (n, n)

@[simp] theorem circulationPeriod_diagonal (n : ℤ) :
    circulationPeriod (diagonalWinding n) = 0 := by
  simp [circulationPeriod, residueWinding, diagonalWinding]

/-- The circulation period is additive on the integer winding lattice. -/
theorem circulationPeriod_add (u v : WindingPair) :
    circulationPeriod (u.1 + v.1, u.2 + v.2) =
      circulationPeriod u + circulationPeriod v := by
  simp [circulationPeriod, residueWinding]
  ring

/-- The period is exactly the pairing with the installed residue pair `(1,-1)`. -/
def residuePairing (w : WindingPair) : ℂ :=
  (w.1 : ℂ) * residuePair.1 + (w.2 : ℂ) * residuePair.2

/-- Readback of the residue theorem at the lattice level. -/
theorem residuePairing_eq_difference (w : WindingPair) :
    residuePairing w = (residueWinding w : ℂ) := by
  rcases w with ⟨m, n⟩
  simp [residuePairing, residuePair, residueWinding]
  ring

/-- The logarithmic period is residue pairing times the canonical `2πi` period. -/
theorem circulationPeriod_eq_residuePairing (w : WindingPair) :
    circulationPeriod w =
      residuePairing w * (2 * Real.pi * Complex.I : ℂ) := by
  rw [circulationPeriod, residuePairing_eq_difference]

/-- A globally exact scalar potential has zero period on the algebraic winding lattice.
This is the period readout appropriate to the globally defined radial potential `eta`. -/
def exactPotentialPeriod (_w : WindingPair) : ℝ := 0

@[simp] theorem exactPotentialPeriod_zero (w : WindingPair) :
    exactPotentialPeriod w = 0 := rfl

/-- Compact corrected period packet. -/
theorem bipolar_period_packet :
    circulationPeriod originWinding = (2 * Real.pi * Complex.I : ℂ) ∧
      circulationPeriod oneWinding = -(2 * Real.pi * Complex.I : ℂ) ∧
      circulationPeriod (diagonalWinding 1) = 0 := by
  exact ⟨circulationPeriod_origin, circulationPeriod_one,
    circulationPeriod_diagonal 1⟩

end InfoGeometry.Analysis.BipolarWindingPeriodLattice
