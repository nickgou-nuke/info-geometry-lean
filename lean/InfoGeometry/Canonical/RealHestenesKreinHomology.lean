/-!
# Real Hestenes--Krein Homology

This file provides a theorem-safe real homology/cohomology socket:

* a real nilpotent differential gives cycles and boundaries;
* homology equivalence is difference by a real boundary;
* Drazin generalized-kernel readback is witness-gated;
* a complementary projector selects the null residue by idempotence;
* boundary-vanishing real witnesses descend to homology classes;
* Krein/Hestenes frame data preserves the real pairing readout.

No complex coefficient lane, de Rham theorem, or analytic Hodge theorem is
asserted here.
-/

/-! ## 1. Real differential homology -/

/--
A real chain differential.

This is deliberately algebraic: no complex coefficients, no analytic domain
claims, and no Hodge theorem.
-/
@[rep_depth operator]
abbrev RealDifferential
    (C : Type*) [AddCommGroup C] [Module ℝ C] :=
  InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator C

namespace RealDifferential

variable {C : Type*}
variable [AddCommGroup C] [Module ℝ C]
variable (𝒟 : RealDifferential C)

abbrev D : C →ₗ[ℝ] C := 𝒟.d

abbrev D_sq_zero : (D 𝒟).comp (D 𝒟) = 0 := 𝒟.d_sq_zero

/-- Real cycle: killed by the differential. -/
@[rep_depth operator]
abbrev IsCycle (x : C) : Prop :=
  InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.IsCycle
    𝒟 x

/-- Real boundary: generated by the differential. -/
@[rep_depth operator]
abbrev IsBoundary (x : C) : Prop :=
  InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.IsBoundary
    𝒟 x

/-- Boundaries are cycles when `D² = 0`. -/
@[rep_depth operator]
theorem boundary_is_cycle
    {x : C}
    (hx : 𝒟.IsBoundary x) :
    𝒟.IsCycle x := by
  exact InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.boundary_is_cycle
    𝒟 hx

/-! ## 2. Homology equivalence -/

/-- Homology equivalence: two chains differ by a boundary. -/
@[rep_depth operator]
abbrev HomologyEquivalent (x y : C) : Prop :=
  InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.HomologyEquivalent
    𝒟 x y

/-- Homology equivalence is reflexive. -/
@[rep_depth operator]
theorem HomologyEquivalent_refl
    (x : C) :
    𝒟.HomologyEquivalent x x := by
  exact InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.homologyEquivalent_refl
    𝒟 x

/-- Homology equivalence is symmetric. -/
@[rep_depth operator]
theorem HomologyEquivalent_symm
    {x y : C}
    (h : 𝒟.HomologyEquivalent x y) :
    𝒟.HomologyEquivalent y x := by
  exact InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.homologyEquivalent_symm
    𝒟 h

/-- Homology equivalence is transitive. -/
@[rep_depth operator]
theorem HomologyEquivalent_trans
    {x y z : C}
    (hxy : 𝒟.HomologyEquivalent x y)
    (hyz : 𝒟.HomologyEquivalent y z) :
    𝒟.HomologyEquivalent x z := by
  exact InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.homologyEquivalent_trans
    𝒟 hxy hyz

/-- Homology equivalence is an equivalence relation. -/
@[rep_depth operator]
theorem HomologyEquivalent_isEquivalence :
    Equivalence 𝒟.HomologyEquivalent := by
  exact InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.homologyEquivalent_equivalence
    𝒟

/-! ## 5. Boundary-vanishing witnesses descend to homology -/

/--
A real homology witness/readout.

It descends to homology if it vanishes on generated boundaries.
-/
@[rep_depth operator]
abbrev BoundaryVanishingWitness : Type _ :=
  InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.BoundaryVanishingWitness
    𝒟

namespace BoundaryVanishingWitness

variable {𝒟}
variable (ω : BoundaryVanishingWitness 𝒟)

/-- Boundary-vanishing witnesses are constant on homology classes. -/
@[rep_depth operator]
theorem descends_to_homology_equivalence
    {x y : C}
    (hxy : 𝒟.HomologyEquivalent x y) :
    ω.1 x = ω.1 y := by
  exact InfoGeometry.Canonical.RealHomologyCohomologyDictionary.RealBoundaryOperator.BoundaryVanishingWitness.descends_to_homology_equivalence
    ω hxy

end BoundaryVanishingWitness

end RealDifferential

/-! ## 3. witness-gated (Native Closure Mandated: Closure Debt) Drazin null support -/


/-- Drazin-null elements are exactly the range of the complementary projector. -/
@[rep_depth operator]
def IsDrazinNull {C : Type*} [AddCommGroup C] [Module ℝ C]
    (A D : Module.End ℝ C) (x : C) : Prop :=
  x ∈ LinearMap.range (complementaryProjection A D)

/-- The generalized kernel is the concrete `drazinCore` from `DrazinCoreFlow`. -/
@[rep_depth operator]
def IsGeneralizedKernel {C : Type*} [AddCommGroup C] [Module ℝ C]
    (A : Module.End ℝ C) (k : ℕ) (x : C) : Prop :=
  x ∈ drazinCore A k

/-- Readback of the concrete Drazin-null/generalized-kernel identification. -/
@[rep_depth operator]
theorem drazinNull_iff_generalizedKernel
    {C : Type*} [AddCommGroup C] [Module ℝ C]
    (A D : Module.End ℝ C) (k : ℕ)
    (hDrazin : InfoGeometry.Canonical.Drazin.IsDrazinInverse A D k)
    (x : C) :
    IsDrazinNull A D x ↔ IsGeneralizedKernel A k x := by
  constructor
  · intro hx
    rcases hx with ⟨y, hy⟩
    rw [← hy]
    exact complementaryProjection_mapsTo_drazinCore
      (A := A) (D := D) (k := k) (h := hDrazin) y
  · intro hx
    simpa [IsDrazinNull, IsGeneralizedKernel,
      complementaryProjection_range_eq_drazinCore (A := A) (D := D) (k := k)
        (h := hDrazin)] using hx

/-! ## 3b. Direct Module.End Drazin generalized-kernel residue -/

namespace DrazinNullResidue

variable {K V : Type*}
variable [DivisionRing K] [AddCommGroup V] [Module K V]
variable {A D : Module.End K V} {k : ℕ}

/-- Drazin-null cycle: killed by the core-defining power `A^k`. -/
@[rep_depth operator]
def IsDrazinNullCycle (A : Module.End K V) (k : ℕ) (x : V) : Prop :=
  (A ^ k) x = 0

/-- Drazin-null cycles are exactly elements of the existing generalized kernel. -/
@[rep_depth operator]
theorem isDrazinNullCycle_iff_mem_drazinCore
    (A : Module.End K V) (k : ℕ) (x : V) :
    IsDrazinNullCycle A k x ↔ x ∈ drazinCore A k := by
  simp [IsDrazinNullCycle, drazinCore, LinearMap.mem_ker]

/--
Drazin-null cycles are exactly the range of the complementary Drazin projector.
-/
@[rep_depth operator]
theorem isDrazinNullCycle_iff_mem_range_complementaryProjection
    (h : IsDrazinInverse A D k) (x : V) :
    IsDrazinNullCycle A k x
      ↔ x ∈ LinearMap.range (complementaryProjection A D) := by
  calc
    IsDrazinNullCycle A k x
        ↔ x ∈ drazinCore A k :=
          isDrazinNullCycle_iff_mem_drazinCore A k x
    _ ↔ x ∈ LinearMap.range (complementaryProjection A D) := by
          rw [← complementaryProjection_range_eq_drazinCore (h := h)]

/-- The complementary Drazin projector selects a Drazin-null cycle. -/
@[rep_depth operator]
theorem complementaryProjection_selects_drazinNullCycle
    (h : IsDrazinInverse A D k) (x : V) :
    IsDrazinNullCycle A k (complementaryProjection A D x) := by
  exact
    (isDrazinNullCycle_iff_mem_drazinCore A k
      (complementaryProjection A D x)).2
      (complementaryProjection_mapsTo_drazinCore (h := h) x)

/-- The complementary Drazin projector fixes Drazin-null cycles. -/
@[rep_depth operator]
theorem complementaryProjection_fixes_drazinNullCycle
    (h : IsDrazinInverse A D k)
    {x : V}
    (hx : IsDrazinNullCycle A k x) :
    complementaryProjection A D x = x := by
  have hxrange :
      x ∈ LinearMap.range (complementaryProjection A D) :=
    (isDrazinNullCycle_iff_mem_range_complementaryProjection
      (A := A) (D := D) (k := k) h x).1 hx
  rcases hxrange with ⟨y, hy⟩
  rw [← hy]
  have hIdem :
      complementaryProjection A D * complementaryProjection A D =
        complementaryProjection A D :=
    complementaryProjection_is_idempotent (h := h)
  simpa using congrArg (fun F : Module.End K V => F y) hIdem

end DrazinNullResidue

/-! ## 3c. Genuine Green identity in the group-invertible Drazin sector -/

/--
For a Drazin inverse of index one, the generalized inverse is a Green
operator in the usual `A G A = A` sense.  This is the index-one consequence
of the native Drazin power law, not an assertion for an arbitrary nilpotent
Drazin sector.
-/
theorem drazin_green_identity_of_index_one
    {K V : Type*} [DivisionRing K] [AddCommGroup V] [Module K V]
    {A G : Module.End K V}
    (hG : IsDrazinInverse A G 1) :
    A * G * A = A := by
  calc
    A * G * A = A * (G * A) := by simp [mul_assoc]
    _ = A * (A * G) := by rw [hG.comm]
    _ = A ^ 2 * G := by simp [pow_two, mul_assoc]
    _ = A := by simpa [pow_two] using hG.power

/--
The preceding Green identity applied to the square of a real differential.
The theorem requires the genuine index-one Drazin owner for `D²`; the
nilpotence law `D² = 0` alone does not manufacture such a propagator.
-/
theorem differential_square_green_identity
    {C : Type*} [AddCommGroup C] [Module ℝ C]
    (𝒟 : RealDifferential C) (G : Module.End ℝ C)
    (hG : IsDrazinInverse (𝒟.D.comp 𝒟.D) G 1) :
    (𝒟.D.comp 𝒟.D) * G * (𝒟.D.comp 𝒟.D) = 𝒟.D.comp 𝒟.D := by
  exact drazin_green_identity_of_index_one hG

/-! ## 4. Generic null-projector adapter -/

/--
Generic idempotent null-projector adapter.

Use this when the projector is already known to be idempotent but is not
necessarily presented through a Drazin inverse witness.
-/
@[rep_depth operator]
structure NullProjector
    (C : Type*) [AddCommGroup C] [Module ℝ C] where
  P0 : Module.End ℝ C
  P0_idem : P0.comp P0 = P0

namespace NullProjector

variable {C : Type*}
variable [AddCommGroup C] [Module ℝ C]
variable (P : NullProjector C)

/-- Null residue selected by the complementary projector. -/
@[rep_depth operator]
def IsNullResidue (x : C) : Prop :=
  P.P0 x = x

/-- The complementary Drazin projector selects its own image. -/
@[rep_depth operator]
theorem selects_null_residue
    (x : C) :
    P.IsNullResidue (P.P0 x) := by
  unfold IsNullResidue
  have h := congrArg (fun F : Module.End ℝ C => F x) P.P0_idem
  simpa [LinearMap.comp_apply] using h

/-- Null residues are preserved by the complementary projector. -/
@[rep_depth operator]
theorem preserves_null_residue
    {x : C}
    (_hx : P.IsNullResidue x) :
    P.IsNullResidue (P.P0 x) := by
  exact P.selects_null_residue x

end NullProjector

/-! ## 6. Krein/Hestenes frame readouts -/

namespace RealFrameReadout

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable [KreinSpace H]

/-- Real Krein pairing readout. -/
@[rep_depth krein]
noncomputable def pairingReadout (u v : H) : ℝ :=
  KreinSpace.kreinInner (H := H) u v

/-- Krein-preserving frame maps preserve the pairing readout. -/
@[rep_depth krein]
theorem krein_frame_preserves_pairing
    (U : H →L[ℝ] H)
    (hU : KreinSpace.IsKreinIsometry (H := H) U)
    (u v : H) :
    pairingReadout (U u) (U v) = pairingReadout u v :=
  hU u v

end RealFrameReadout

/--
A doubled Hestenes--Krein frame.

The `kreinPreserving` field protects the real pairing readout. The
`phasePreserving` field protects the internal Hestenes phase axis.
-/
@[rep_depth krein]
structure HestenesKreinDoubledFrame
    (E : Type 0) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] where
  U : DoubledSpace E →L[ℝ] DoubledSpace E
  kreinPreserving :
    KreinSpace.IsKreinIsometry (H := DoubledSpace E) U
  phasePreserving :
    KLinear (E := E) U

namespace HestenesKreinDoubledFrame

variable {E : Type 0}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E

/-- Doubled Hestenes--Krein frames preserve the real Krein pairing readout. -/
@[rep_depth krein]
theorem preserves_pairing
    (F : HestenesKreinDoubledFrame E)
    (u v : H₂) :
    KreinSpace.kreinInner (H := H₂) (F.U u) (F.U v) =
      KreinSpace.kreinInner (H := H₂) u v :=
  F.kreinPreserving u v

/-- Readback of Hestenes phase-axis preservation. -/
@[rep_depth krein]
theorem preserves_phase
    (F : HestenesKreinDoubledFrame E) :
    KLinear (E := E) F.U :=
  F.phasePreserving

/-- Readback of Hestenes phase-axis preservation as the concrete commutation law. -/
@[rep_depth krein]
theorem preserves_phaseAxis
    (F : HestenesKreinDoubledFrame E) :
    F.U.comp (InfoGeometry.Krein.clockAxis (E := E)) =
      (InfoGeometry.Krein.clockAxis (E := E)).comp F.U :=
  F.phasePreserving

end HestenesKreinDoubledFrame

end InfoGeometry.Canonical.RealHestenesKreinHomology
