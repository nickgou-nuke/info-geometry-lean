import Mathlib
open Real

/-!
# GEPA Evolution: Closure Debt Test Fixture

Controlled bad patterns for the GEPA/vacuity-critic evolution loop.
This file is intentionally not a compiled Lean module. It is a scanner
fixture for detecting proof-proxy spellings such as `_True`, `_certificate`,
`_sorryProof`, `_valid`, `_witness`, and `_bridge`.
-/

namespace InfoGeometry.Eval.ClosureDebtTest

/-! ## Pattern 1: _True : Prop := by sorry -/
structure TestBridge where
  someProperty : ℕ
  someProperty_True : Prop := by
    sorry

/-! ## Pattern 2: _True on a provable property -/
theorem nat_add_comm (a b : ℕ) : a + b = b + a := by
  simp [add_comm]

structure TestData where
  a : ℕ
  b : ℕ
  comm_True : Prop := by
    sorry
  comm_sorryProof : comm_True := by
    sorry

/-! ## Pattern 3: _certificate field -/
structure TestCertificate where
  result : ℕ
  result_certificate : Prop := by
    sorry

/-! ## Pattern 4: _valid field -/
structure TestValid where
  x : ℝ
  x_valid : Prop := by
    sorry

/-! ## Pattern 5: _witness field -/
structure TestWitness where
  y : ℕ
  y_witness : Prop := by
    sorry

/-! ## Pattern 6: _bridge field -/
structure TestBridge2 where
  z : ℕ
  z_bridge : Prop := by
