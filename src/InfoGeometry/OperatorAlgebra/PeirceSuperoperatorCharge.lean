import InfoGeometry.Core.PeirceAdjointCycle
import InfoGeometry.OperatorAlgebra.PeirceSpine.Basic
import Mathlib.Logic.Function.Iterate

/-!
# Quintic annihilation of the Peirce superoperator charge

A tripotent in any associative ring induces a commutator satisfying
D⁵ - 5D³ + 4D = 0. Applying this to the existing integer-linear adjoint of
an idempotent proves the identity on every integer-linear endomorphism.
No division, minimal-polynomial claim, or identification with a TKK algebra
is required. The base adjoint tripotency is owned by `PeirceAdjointCycle`.
-/

namespace InfoGeometry.OperatorAlgebra.PeirceSuperoperatorCharge

open PeirceSpine

variable {B : Type*} [Ring B]

/-- The quintic holds on every element, not only five chosen test operators. -/
theorem commutator_quintic_of_tripotent {e : B} (he : e * e * e = e) (x : B) :
    (comm e)^[5] x - (5 : ℤ) • ((comm e)^[3] x) + (4 : ℤ) • comm e x = 0 := by
  have he' : e * (e * e) = e := by simpa only [mul_assoc] using he
  have hprefix (z : B) : e * (e * (e * z)) = e * z := by
    simpa only [mul_assoc] using congrArg (fun a => a * z) he
  simp only [Function.iterate_succ_apply', Function.iterate_zero_apply, PeirceSpine.comm,
    mul_sub, sub_mul,
    mul_assoc, he', hprefix]
  abel

/-- An idempotent generator gives the three-grade annihilator for its
commutator action, directly in the associative ring. -/
theorem commutator_cube_of_idempotent {p : B} (hp : IsIdempotentElem p) (x : B) :
    (comm p)^[3] x = comm p x := by
  have hleft (z : B) : p * (p * z) = p * z := by
    calc
      p * (p * z) = (p * p) * z := by noncomm_ring
      _ = p * z := by rw [hp.eq]
  have hright (z : B) : (z * p) * p = z * p := by
    calc
      (z * p) * p = z * (p * p) := by noncomm_ring
      _ = z * p := by rw [hp.eq]
  have hmiddle : p * (p * x * p) = p * x * p := by
    calc
      p * (p * x * p) = p * (p * x) * p := by noncomm_ring
      _ = p * x * p := by rw [hleft]
  have hthird : p * (x * p) * p = p * x * p := by
    calc
      p * (x * p) * p = (p * x * p) * p := by noncomm_ring
      _ = p * x * p := hright (p * x)
  simp only [Function.iterate_succ_apply', Function.iterate_zero_apply, PeirceSpine.comm]
  simp only [mul_sub, sub_mul, hleft, hright, hmiddle, hthird]
  abel_nf

/-- The cubic defect of an inner derivation generated by a tripotent is exactly
the bilateral sandwich `-3 e [e,x] e`. This is a pointwise ring identity; it
does not use a field structure or spectral decomposition. -/
theorem commutator_cube_defect_of_tripotent {e : B} (he : e * e * e = e) (x : B) :
    (comm e)^[3] x - comm e x = -(3 : ℤ) • (e * comm e x * e) := by
  have hprefix (z : B) : e * (e * (e * z)) = e * z := by
    calc
      e * (e * (e * z)) = (e * e * e) * z := by noncomm_ring
      _ = e * z := by rw [he]
  simp only [Function.iterate_succ_apply', Function.iterate_zero_apply, PeirceSpine.comm,
    mul_sub, sub_mul, mul_assoc,
    hprefix, he]
  noncomm_ring

/-- Tripotency reverses the sign of the sandwich after multiplying it on both
sides by `e²`. -/
theorem tripotent_sandwich_sign {e : B} (he : e * e * e = e) (x : B) :
    e * e * comm e x * (e * e) = -(e * comm e x * e) := by
  change e * e * (e * x - x * e) * (e * e) = -(e * (e * x - x * e) * e)
  have heL : e * (e * e) = e := by simpa only [mul_assoc] using he
  have heR : (e * e) * e = e := he
  rw [show e * e * (e * x - x * e) * (e * e) =
      (e * (e * e)) * x * (e * e) - (e * e) * x * ((e * e) * e) by noncomm_ring]
  rw [heL, heR]
  noncomm_ring

/-- The bilateral sandwich `e [e,x] e` is a `+4` eigenvector for the square
of the inner derivation whenever `e³=e`. -/
theorem tripotent_sandwich_ad_sq {e : B} (he : e * e * e = e) (x : B) :
    comm e (comm e (e * comm e x * e)) = (4 : ℤ) • (e * comm e x * e) := by
  let W := e * comm e x * e
  have hleft : e * e * W = W := by
    dsimp [W]
    calc
      e * e * (e * comm e x * e) = (e * e * e) * comm e x * e := by noncomm_ring
      _ = e * comm e x * e := by rw [he]
  have hright : W * e * e = W := by
    dsimp [W]
    calc
      (e * comm e x * e) * e * e = e * comm e x * (e * e * e) := by noncomm_ring
      _ = e * comm e x * e := by rw [he]
  have hsign := tripotent_sandwich_sign he x
  have hsign' : e * W * e = -W := by
    dsimp [W]
    calc
      e * (e * comm e x * e) * e = e * e * comm e x * (e * e) := by noncomm_ring
      _ = -(e * comm e x * e) := hsign
  change e * (e * W - W * e) - (e * W - W * e) * e = (4 : ℤ) • W
  have hdouble : e * (e * W - W * e) - (e * W - W * e) * e =
      e * e * W - (2 : ℤ) • (e * W * e) + W * e * e := by noncomm_ring
  rw [hdouble, hleft, hright, hsign']
  module

/-- Factored quintic closure from the explicit tripotent sandwich: the cubic
defect lies in the `+4` eigenspace, so the factor `D²-4` kills it. -/
theorem commutator_quintic_factorization_of_tripotent {e : B} (he : e * e * e = e)
    (x : B) :
    (comm e)^[5] x - (5 : ℤ) • ((comm e)^[3] x) + (4 : ℤ) • comm e x = 0 ∧
      (comm e)^[3] x - comm e x = -(3 : ℤ) • (e * comm e x * e) := by
  exact ⟨commutator_quintic_of_tripotent he x,
    commutator_cube_defect_of_tripotent he x⟩

attribute [local instance 100] LieRing.ofAssociativeRing

/-- The adjoint charge on the full endomorphism ring satisfies the quintic.
Multiplication of endomorphisms is composition. -/
theorem peirce_superoperator_quintic {p : B} (hp : IsIdempotentElem p)
    (K : Module.End ℤ B) :
    let D := LieAlgebra.ad ℤ B p
    (comm D)^[5] K - (5 : ℤ) • ((comm D)^[3] K) + (4 : ℤ) • comm D K = 0 := by
  dsimp
  apply commutator_quintic_of_tripotent
  simpa only [pow_succ, pow_zero, mul_one, one_mul] using
    InfoGeometry.Core.PeirceAdjointCycle.ad_cube_eq_ad hp


section CornerCharges
variable {p : B} (hp : p * p = p) (a c x : B)
include hp

theorem upper_sandwich_charge :
    comm p (conePlus p a * x * conePlus p a) -
      conePlus p a * comm p x * conePlus p a =
      (2 : ℤ) • (conePlus p a * x * conePlus p a) := by
  peirce_nf hp

theorem lower_sandwich_charge :
    comm p (coneMinus p c * x * coneMinus p c) -
      coneMinus p c * comm p x * coneMinus p c =
      -((2 : ℤ) • (coneMinus p c * x * coneMinus p c)) := by
  peirce_nf hp

theorem upper_inner_charge :
    comm p (comm (conePlus p a) x) - comm (conePlus p a) (comm p x) =
      comm (conePlus p a) x := by
  peirce_nf hp

theorem lower_inner_charge :
    comm p (comm (coneMinus p c) x) - comm (coneMinus p c) (comm p x) =
      -comm (coneMinus p c) x := by
  peirce_nf hp

theorem cross_sandwich_charge :
    comm p (conePlus p a * x * coneMinus p c + coneMinus p c * x * conePlus p a) -
      (conePlus p a * comm p x * coneMinus p c +
        coneMinus p c * comm p x * conePlus p a) = 0 := by
  peirce_nf hp

end CornerCharges

end InfoGeometry.OperatorAlgebra.PeirceSuperoperatorCharge
