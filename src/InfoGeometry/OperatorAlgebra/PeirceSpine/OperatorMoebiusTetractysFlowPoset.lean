namespace InfoGeometry.OperatorAlgebra.PeirceSpine.OperatorMoebiusTetractysFlowPoset

open InfoGeometry.OperatorAlgebra.PeirceSpine.SouriauMetriplecticParabolicPoset
open InfoGeometry.OperatorAlgebra.PeirceSpine.AmariParaKahlerConnectionSumDiffPoset

universe u
variable {B : Type u} [Ring B]

/-- Quadratic Casimir combination `C = S_P² * V + Φ² - J²` of the Tetractys in `B`. -/
def casimirTetractys (P X Y : B) : B :=
  S_P P * S_P P * V_met P X Y + Phi_v P X Y * Phi_v P X Y - J_mc P X Y * J_mc P X Y

/-- Positive parabolic horocycle shear `exp(t N_+) = 1 + t * N_+`. -/
def parabolicFlowPlus (P X t : B) : B :=
  1 + t * N_plus P X

/-- Negative parabolic horocycle shear `exp(t N_-) = 1 + t * N_-`. -/
def parabolicFlowMinus (P Y t : B) : B :=
  1 + t * N_minus P Y

/-- Polynomial hyperbolic boost rotor `c + s * S_P` (algebraic counterpart of `cosh(s) + sinh(s) S_P`). -/
def hyperbolicRotor (P c s : B) : B :=
  c + s * S_P P

/-- Polynomial elliptic rotation rotor `c + s * J` (algebraic counterpart of `cos(θ√V) + sin(θ√V) J / √V`). -/
def ellipticRotor (P X Y c s : B) : B :=
  c + s * J_mc P X Y

/-- Opposite-parabolic Bruhat–Möbius rotor `G_+ = (1 - N_+)(1 + N_-)`. -/
def bruhatMoebiusRotorPlus (P X Y : B) : B :=
  (1 - N_plus P X) * (1 + N_minus P Y)

/-- Inverse Bruhat–Möbius rotor `G_+⁻¹ = (1 - N_-)(1 + N_+)`. -/
def bruhatMoebiusRotorPlusInv (P X Y : B) : B :=
  (1 - N_minus P Y) * (1 + N_plus P X)

/-- Degree-3 Bruhat–Möbius transported projector `P̂_+ = P + Φ - Σ - V * N_+`. -/
def bruhatMoebiusProjectorPlus (P X Y : B) : B :=
  P + Phi_v P X Y - Sigma_sp P X Y - V_met P X Y * N_plus P X

/-- Two-sided diagonal Peirce / TFD-symmetric operator `D_sym = P W P + (1 - P) W (1 - P)`. -/
def TFD_Symmetric (P W : B) : B :=
  P * W * P + (1 - P) * W * (1 - P)

/-- Quadratic Peirce corner defect `P(G²)P - (P G P)²` (scramblon ladder kernel). -/
def ScramblonLadderDefect (P G : B) : B :=
  P * (G * G) * P - (P * G * P) * (P * G * P)

/-- Un-divided Virasoro mode `L_{-1} = N_+ = P X (1 - P)` in `[Ring B]`. -/
def L_neg1 (P X : B) : B :=
  N_plus P X

/-- Un-divided Virasoro Cartan mode `L_0 = S_P = 2P - 1` in `[Ring B]`. -/
def L_zero (P : B) : B :=
  S_P P

/-- Un-divided Virasoro mode `L_1 = -N_- = -(1 - P) Y P` in `[Ring B]`. -/
def L_pos1 (P Y : B) : B :=
  - N_minus P Y

/-- Operator-valued Virasoro central anomaly polynomial for `c = 24`: `A(M) = 2 • (M³ - M)` in `[Ring B]`. -/
def VirasoroAnomalyOp24 (M : B) : B :=
  2 • (M * M * M - M)

/-- Modular inversion operator `S = N_minus P Y - N_plus P X = - J_mc P X Y` in `[Ring B]`. -/
def modularInversionOp (P X Y : B) : B :=
  N_minus P Y - N_plus P X

/-- The 24th cyclotomic operator polynomial `Φ₂₄(J) = J⁸ - J⁴ + 1` in `[Ring B]`. -/
def Phi24_Operator (J : B) : B :=
  let J2 := J * J
  let J4 := J2 * J2
  let J8 := J4 * J4
  J8 - J4 + 1

-- ============================================================================
-- 1. NODES 𝔒𝔐₁ & 𝔒𝔐₂: THE TETRACTYS IS THE 𝔰𝔩₂(B) MÖBIUS LIE ALGEBRA
-- ============================================================================

/--
**Theorem 1 (`𝔒𝔐₁`–`𝔒𝔐₂` — The Tetractys Lie Algebra `𝔰𝔩₂(B)` & Cartan Decomposition):**
For any idempotent `P * P = P` and `X, Y : B`, the DeWitt Tetractys `{S_P, Φ, J}` satisfies
the exact commutation relations of `𝔰𝔩₂` over the central metric subring `ℤ[V]`:
1. **Lie Commutators:**
   - `comm (S_P P) (Phi_v P X Y) = J_mc P X Y + J_mc P X Y` (`= 2 • J_mc P X Y`),
   - `comm (S_P P) (J_mc P X Y) = Phi_v P X Y + Phi_v P X Y` (`= 2 • Phi_v P X Y`),
   - `comm (J_mc P X Y) (Phi_v P X Y) = Sigma_sp P X Y + Sigma_sp P X Y` (`= 2 • Sigma_sp P X Y`),
   - `Sigma_sp P X Y = S_P P * V_met P X Y`,
2. **Cartan Decomposition (`𝔤 = 𝔨 ⊕ 𝔭`) Squares and Clifford Orthogonality:**
   - `S_P P * S_P P = 1`, `J_mc P X Y * J_mc P X Y = - V_met P X Y`, `Phi_v P X Y * Phi_v P X Y = V_met P X Y`,
   - `anticomm (S_P P) (Phi_v P X Y) = 0`, `anticomm (S_P P) (J_mc P X Y) = 0`, `anticomm (Phi_v P X Y) (J_mc P X Y) = 0`,
3. **Centrality and Quadratic Casimir of the Metric `V`:**
   - `comm (V_met P X Y) (S_P P) = 0`, `comm (V_met P X Y) (Phi_v P X Y) = 0`, `comm (V_met P X Y) (J_mc P X Y) = 0`,
   - `casimirTetractys P X Y = 3 • V_met P X Y`.
-/
theorem tetractys_is_sl2_moebius_lie_algebra
    (P X Y : B) (hP : P * P = P) :
    let sp := S_P P
    let ph := Phi_v P X Y
    let j  := J_mc P X Y
    let s  := Sigma_sp P X Y
    let v  := V_met P X Y
    comm sp ph = j + j ∧
    comm sp j  = ph + ph ∧
    comm j ph  = s + s ∧
    s = sp * v ∧
    sp * sp = 1 ∧
    j * j = - v ∧
    ph * ph = v ∧
    anticomm sp ph = 0 ∧
    anticomm sp j  = 0 ∧
    anticomm ph j  = 0 ∧
    comm v sp = 0 ∧
    comm v ph = 0 ∧
    comm v j  = 0 ∧
    casimirTetractys P X Y = 3 • v := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  · dsimp only [casimirTetractys, S_P, Phi_v, J_mc, Sigma_sp, V_met, Q_pos, Q_neg,
                N_plus, N_minus, comm, anticomm]
    amari_peirce_nf hP

-- ============================================================================
-- 2. NODES 𝔒𝔐₃ & 𝔒𝔐₄: ROOT SPACE DECOMPOSITION & PARABOLIC HOROCYCLE FLOW
-- ============================================================================

/--
**Theorem 2 (`𝔒𝔐₃`–`𝔒𝔐₄` — Root Space Decomposition & Unipotent Parabolic Horocycle Flows):**
1. **Root Vectors of `𝔰𝔩₂(B)`:**
   - `comm (S_P P) (N_plus P X) = N_plus P X + N_plus P X`,
   - `comm (S_P P) (N_minus P Y) = - (N_minus P Y + N_minus P Y)`,
   - `comm (N_plus P X) (N_minus P Y) = Sigma_sp P X Y`,
   - `anticomm (N_plus P X) (N_minus P Y) = V_met P X Y`,
2. **Exact Parabolic Unipotent Group Law (Horocycle Translation without BCH):**
   For any central parameters `t, s : B` (`∀ Z, t * Z = Z * t` and `∀ Z, s * Z = Z * s`):
   - `parabolicFlowPlus P X t * parabolicFlowPlus P X s = parabolicFlowPlus P X (t + s)`,
   - `parabolicFlowMinus P Y t * parabolicFlowMinus P Y s = parabolicFlowMinus P Y (t + s)`,
   - `parabolicFlowPlus P X t * parabolicFlowPlus P X (-t) = 1`,
   - `parabolicFlowMinus P Y t * parabolicFlowMinus P Y (-t) = 1`,
3. **Parabolic Adjoint Action on the Cartan Generator `S_P`:**
   - `parabolicFlowPlus P X t * S_P P * parabolicFlowPlus P X (-t) = S_P P - 2 • (t * N_plus P X)`,
   - `parabolicFlowMinus P Y t * S_P P * parabolicFlowMinus P Y (-t) = S_P P + 2 • (t * N_minus P Y)`.
-/
theorem root_space_and_parabolic_horocycle_flow
    (P X Y t s : B) (hP : P * P = P)
    (ht : ∀ Z : B, t * Z = Z * t)
    (hs : ∀ Z : B, s * Z = Z * s) :
    let sp  := S_P P
    let np  := N_plus P X
    let nm  := N_minus P Y
    let sig := Sigma_sp P X Y
    let v   := V_met P X Y
    comm sp np = np + np ∧
    comm sp nm = - (nm + nm) ∧
    comm np nm = sig ∧
    anticomm np nm = v ∧
    parabolicFlowPlus P X t * parabolicFlowPlus P X s = parabolicFlowPlus P X (t + s) ∧
    parabolicFlowMinus P Y t * parabolicFlowMinus P Y s = parabolicFlowMinus P Y (t + s) ∧
    parabolicFlowPlus P X t * parabolicFlowPlus P X (-t) = 1 ∧
    parabolicFlowMinus P Y t * parabolicFlowMinus P Y (-t) = 1 ∧
    parabolicFlowPlus P X t * sp * parabolicFlowPlus P X (-t) = sp - 2 • (t * np) ∧
    parabolicFlowMinus P Y t * sp * parabolicFlowMinus P Y (-t) = sp + 2 • (t * nm) := by
  have h_np_sq : N_plus P X * N_plus P X = 0 := by
    dsimp only [N_plus]; amari_peirce_nf hP
  have h_nm_sq : N_minus P Y * N_minus P Y = 0 := by
    dsimp only [N_minus]; amari_peirce_nf hP
  have h_sp_np : S_P P * N_plus P X = N_plus P X := by
    dsimp only [S_P, N_plus]; amari_peirce_nf hP
  have h_np_sp : N_plus P X * S_P P = - N_plus P X := by
    dsimp only [S_P, N_plus]; amari_peirce_nf hP
  have h_sp_nm : S_P P * N_minus P Y = - N_minus P Y := by
    dsimp only [S_P, N_minus]; amari_peirce_nf hP
  have h_nm_sp : N_minus P Y * S_P P = N_minus P Y := by
    dsimp only [S_P, N_minus]; amari_peirce_nf hP
  have h_plus_add :
      parabolicFlowPlus P X t * parabolicFlowPlus P X s = parabolicFlowPlus P X (t + s) := by
    dsimp only [parabolicFlowPlus]
    calc (1 + t * N_plus P X) * (1 + s * N_plus P X)
        = 1 + (t + s) * N_plus P X + t * (N_plus P X * s) * N_plus P X := by noncomm_ring
      _ = 1 + (t + s) * N_plus P X + t * (s * N_plus P X) * N_plus P X := by rw [← hs (N_plus P X)]
      _ = 1 + (t + s) * N_plus P X + (t * s) * (N_plus P X * N_plus P X) := by noncomm_ring
      _ = 1 + (t + s) * N_plus P X := by rw [h_np_sq, mul_zero, add_zero]
  have h_minus_add :
      parabolicFlowMinus P Y t * parabolicFlowMinus P Y s = parabolicFlowMinus P Y (t + s) := by
    dsimp only [parabolicFlowMinus]
    calc (1 + t * N_minus P Y) * (1 + s * N_minus P Y)
        = 1 + (t + s) * N_minus P Y + t * (N_minus P Y * s) * N_minus P Y := by noncomm_ring
      _ = 1 + (t + s) * N_minus P Y + t * (s * N_minus P Y) * N_minus P Y := by rw [← hs (N_minus P Y)]
      _ = 1 + (t + s) * N_minus P Y + (t * s) * (N_minus P Y * N_minus P Y) := by noncomm_ring
      _ = 1 + (t + s) * N_minus P Y := by rw [h_nm_sq, mul_zero, add_zero]
  have h_plus_inv :
      parabolicFlowPlus P X t * parabolicFlowPlus P X (-t) = 1 := by
    have h_neg_comm : ∀ Z : B, (-t) * Z = Z * (-t) := fun Z => by
      rw [neg_mul, mul_neg, ht Z]
    have h_step :
        parabolicFlowPlus P X t * parabolicFlowPlus P X (-t) = parabolicFlowPlus P X (t + (-t)) := by
      dsimp only [parabolicFlowPlus]
      calc (1 + t * N_plus P X) * (1 + (-t) * N_plus P X)
          = 1 + (t + (-t)) * N_plus P X + t * (N_plus P X * (-t)) * N_plus P X := by noncomm_ring
        _ = 1 + (t + (-t)) * N_plus P X + t * ((-t) * N_plus P X) * N_plus P X := by
            rw [← h_neg_comm (N_plus P X)]
        _ = 1 + (t + (-t)) * N_plus P X + (t * (-t)) * (N_plus P X * N_plus P X) := by noncomm_ring
        _ = 1 + (t + (-t)) * N_plus P X := by rw [h_np_sq, mul_zero, add_zero]
    rw [h_step]
    dsimp only [parabolicFlowPlus]
    rw [add_neg_cancel, zero_mul, add_zero]
  have h_minus_inv :
      parabolicFlowMinus P Y t * parabolicFlowMinus P Y (-t) = 1 := by
    have h_neg_comm : ∀ Z : B, (-t) * Z = Z * (-t) := fun Z => by
      rw [neg_mul, mul_neg, ht Z]
    have h_step :
        parabolicFlowMinus P Y t * parabolicFlowMinus P Y (-t) = parabolicFlowMinus P Y (t + (-t)) := by
      dsimp only [parabolicFlowMinus]
      calc (1 + t * N_minus P Y) * (1 + (-t) * N_minus P Y)
          = 1 + (t + (-t)) * N_minus P Y + t * (N_minus P Y * (-t)) * N_minus P Y := by noncomm_ring
        _ = 1 + (t + (-t)) * N_minus P Y + t * ((-t) * N_minus P Y) * N_minus P Y := by
            rw [← h_neg_comm (N_minus P Y)]
        _ = 1 + (t + (-t)) * N_minus P Y + (t * (-t)) * (N_minus P Y * N_minus P Y) := by noncomm_ring
        _ = 1 + (t + (-t)) * N_minus P Y := by rw [h_nm_sq, mul_zero, add_zero]
    rw [h_step]
    dsimp only [parabolicFlowMinus]
    rw [add_neg_cancel, zero_mul, add_zero]
  have h_adj_plus :
      parabolicFlowPlus P X t * S_P P * parabolicFlowPlus P X (-t) =
        S_P P - 2 • (t * N_plus P X) := by
    dsimp only [parabolicFlowPlus]
    calc (1 + t * N_plus P X) * S_P P * (1 + (-t) * N_plus P X)
        = S_P P + t * (N_plus P X * S_P P) - (S_P P * t) * N_plus P X -
            t * (N_plus P X * S_P P) * (t * N_plus P X) := by noncomm_ring
      _ = S_P P + t * (- N_plus P X) - (t * S_P P) * N_plus P X -
            t * (- N_plus P X) * (t * N_plus P X) := by rw [h_np_sp, ← ht (S_P P)]
      _ = S_P P - t * N_plus P X - t * (S_P P * N_plus P X) +
            t * (N_plus P X * t) * N_plus P X := by noncomm_ring
      _ = S_P P - t * N_plus P X - t * N_plus P X +
            t * (t * N_plus P X) * N_plus P X := by rw [h_sp_np, ← ht (N_plus P X)]
      _ = S_P P - t * N_plus P X - t * N_plus P X +
            (t * t) * (N_plus P X * N_plus P X) := by noncomm_ring
      _ = S_P P - 2 • (t * N_plus P X) := by rw [h_np_sq, mul_zero, add_zero, two_nsmul]; abel
  have h_adj_minus :
      parabolicFlowMinus P Y t * S_P P * parabolicFlowMinus P Y (-t) =
        S_P P + 2 • (t * N_minus P Y) := by
    dsimp only [parabolicFlowMinus]
    calc (1 + t * N_minus P Y) * S_P P * (1 + (-t) * N_minus P Y)
        = S_P P + t * (N_minus P Y * S_P P) - (S_P P * t) * N_minus P Y -
            t * (N_minus P Y * S_P P) * (t * N_minus P Y) := by noncomm_ring
      _ = S_P P + t * N_minus P Y - (t * S_P P) * N_minus P Y -
            t * N_minus P Y * (t * N_minus P Y) := by rw [h_nm_sp, ← ht (S_P P)]
      _ = S_P P + t * N_minus P Y - t * (S_P P * N_minus P Y) -
            t * (N_minus P Y * t) * N_minus P Y := by noncomm_ring
      _ = S_P P + t * N_minus P Y - t * (- N_minus P Y) -
            t * (t * N_minus P Y) * N_minus P Y := by rw [h_sp_nm, ← ht (N_minus P Y)]
      _ = S_P P + t * N_minus P Y + t * N_minus P Y -
            (t * t) * (N_minus P Y * N_minus P Y) := by noncomm_ring
      _ = S_P P + 2 • (t * N_minus P Y) := by rw [h_nm_sq, mul_zero, sub_zero, two_nsmul]; abel
  refine ⟨?_, ?_, ?_, ?_, h_plus_add, h_minus_add, h_plus_inv, h_minus_inv, h_adj_plus, h_adj_minus⟩ <;>
  · dsimp only [S_P, N_plus, N_minus, Sigma_sp, V_met, Q_pos, Q_neg, comm, anticomm]
    amari_peirce_nf hP

-- ============================================================================
-- 3. NODE 𝔒𝔐₅: THE HYPERBOLIC WEYL DILATION LAW
-- ============================================================================

/--
**Theorem 3 (`𝔒𝔐₅` — Hyperbolic Weyl Scaling of the Nilpotent Roots):**
1. **Involutive and Projective Weyl Action of `S_P`:**
   - `S_P P * N_plus P X * S_P P = - N_plus P X`,
   - `S_P P * N_minus P Y * S_P P = - N_minus P Y`,
   - `(1 + S_P P) * N_plus P X * (1 - S_P P) = 4 • N_plus P X`,
   - `(1 - S_P P) * N_minus P Y * (1 + S_P P) = 4 • N_minus P Y`,
2. **Polynomial Hyperbolic Boost Rotor Law (`U_hyp(c, s) = c + s * S_P`):**
   For any central parameters `c, s : B` (`∀ Z, c * Z = Z * c` and `∀ Z, s * Z = Z * s`),
   conjugation by `hyperbolicRotor P c s` scales `N_+` by `(c + s)²` and `N_-` by `(c - s)²`:
   - `hyperbolicRotor P c s * N_plus P X * hyperbolicRotor P c (-s) = (c + s) * (c + s) * N_plus P X`,
   - `hyperbolicRotor P c s * N_minus P Y * hyperbolicRotor P c (-s) = (c - s) * (c - s) * N_minus P Y`,
   - `hyperbolicRotor P c s * hyperbolicRotor P c (-s) = c * c - s * s`.
-/
theorem hyperbolic_weyl_dilation_action
    (P X Y c s : B) (hP : P * P = P)
    (hc : ∀ Z : B, c * Z = Z * c)
    (hs : ∀ Z : B, s * Z = Z * s) :
    let sp := S_P P
    let np := N_plus P X
    let nm := N_minus P Y
    sp * np * sp = - np ∧
    sp * nm * sp = - nm ∧
    (1 + sp) * np * (1 - sp) = 4 • np ∧
    (1 - sp) * nm * (1 + sp) = 4 • nm ∧
    hyperbolicRotor P c s * np * hyperbolicRotor P c (-s) = (c + s) * (c + s) * np ∧
    hyperbolicRotor P c s * nm * hyperbolicRotor P c (-s) = (c - s) * (c - s) * nm ∧
    hyperbolicRotor P c s * hyperbolicRotor P c (-s) = c * c - s * s := by
  have h_sp_sq : S_P P * S_P P = 1 := by
    dsimp only [S_P]; amari_peirce_nf hP
  have h_sp_np : S_P P * N_plus P X = N_plus P X := by
    dsimp only [S_P, N_plus]; amari_peirce_nf hP
  have h_np_sp : N_plus P X * S_P P = - N_plus P X := by
    dsimp only [S_P, N_plus]; amari_peirce_nf hP
  have h_sp_nm : S_P P * N_minus P Y = - N_minus P Y := by
    dsimp only [S_P, N_minus]; amari_peirce_nf hP
  have h_nm_sp : N_minus P Y * S_P P = N_minus P Y := by
    dsimp only [S_P, N_minus]; amari_peirce_nf hP
  have h_left_np :
      hyperbolicRotor P c s * N_plus P X = (c + s) * N_plus P X := by
    dsimp only [hyperbolicRotor]
    calc (c + s * S_P P) * N_plus P X
        = c * N_plus P X + s * (S_P P * N_plus P X) := by noncomm_ring
      _ = c * N_plus P X + s * N_plus P X := by rw [h_sp_np]
      _ = (c + s) * N_plus P X := by noncomm_ring
  have h_right_np :
      N_plus P X * hyperbolicRotor P c (-s) = (c + s) * N_plus P X := by
    dsimp only [hyperbolicRotor]
    calc N_plus P X * (c + (-s) * S_P P)
        = N_plus P X * c - (N_plus P X * s) * S_P P := by noncomm_ring
      _ = c * N_plus P X - (s * N_plus P X) * S_P P := by
          rw [← hc (N_plus P X), ← hs (N_plus P X)]
      _ = c * N_plus P X - s * (N_plus P X * S_P P) := by noncomm_ring
      _ = c * N_plus P X - s * (- N_plus P X) := by rw [h_np_sp]
      _ = (c + s) * N_plus P X := by noncomm_ring
  have h_rot_np :
      hyperbolicRotor P c s * N_plus P X * hyperbolicRotor P c (-s) =
        (c + s) * (c + s) * N_plus P X := by
    rw [h_left_np, mul_assoc, h_right_np, ← mul_assoc]
  have h_left_nm :
      hyperbolicRotor P c s * N_minus P Y = (c - s) * N_minus P Y := by
    dsimp only [hyperbolicRotor]
    calc (c + s * S_P P) * N_minus P Y
        = c * N_minus P Y + s * (S_P P * N_minus P Y) := by noncomm_ring
      _ = c * N_minus P Y + s * (- N_minus P Y) := by rw [h_sp_nm]
      _ = (c - s) * N_minus P Y := by noncomm_ring
  have h_right_nm :
      N_minus P Y * hyperbolicRotor P c (-s) = (c - s) * N_minus P Y := by
    dsimp only [hyperbolicRotor]
    calc N_minus P Y * (c + (-s) * S_P P)
        = N_minus P Y * c - (N_minus P Y * s) * S_P P := by noncomm_ring
      _ = c * N_minus P Y - (s * N_minus P Y) * S_P P := by
          rw [← hc (N_minus P Y), ← hs (N_minus P Y)]
      _ = c * N_minus P Y - s * (N_minus P Y * S_P P) := by noncomm_ring
      _ = c * N_minus P Y - s * N_minus P Y := by rw [h_nm_sp]
      _ = (c - s) * N_minus P Y := by noncomm_ring
  have h_rot_nm :
      hyperbolicRotor P c s * N_minus P Y * hyperbolicRotor P c (-s) =
        (c - s) * (c - s) * N_minus P Y := by
    rw [h_left_nm, mul_assoc, h_right_nm, ← mul_assoc]
  have h_rot_norm :
      hyperbolicRotor P c s * hyperbolicRotor P c (-s) = c * c - s * s := by
    dsimp only [hyperbolicRotor]
    calc (c + s * S_P P) * (c + (-s) * S_P P)
        = c * c - c * s * S_P P + s * (S_P P * c) - s * (S_P P * s) * S_P P := by noncomm_ring
      _ = c * c - c * s * S_P P + s * (c * S_P P) - s * (s * S_P P) * S_P P := by
          rw [← hc (S_P P), ← hs (S_P P)]
      _ = c * c - (c * s - s * c) * S_P P - s * s * (S_P P * S_P P) := by noncomm_ring
      _ = c * c - 0 * S_P P - s * s * 1 := by rw [hc s, sub_self, h_sp_sq]
      _ = c * c - s * s := by noncomm_ring
  refine ⟨?_, ?_, ?_, ?_, h_rot_np, h_rot_nm, h_rot_norm⟩ <;>
  · dsimp only [S_P, N_plus, N_minus]
    amari_peirce_nf hP

-- ============================================================================
-- 4. NODE 𝔒𝔐₆: ELLIPTIC ROTATION, CASIMIR INVARIANCE, & BRUHAT–MÖBIUS ORBIT
-- ============================================================================

/--
**Theorem 4 (`𝔒𝔐₆` — Elliptic Rotation Casimir Invariance & Bruhat–Möbius Orbit Closure):**
For any idempotent `P * P = P`, `X, Y : B`, and central parameters `c, s : B`:
1. **Elliptic Rotor Invariance of the Metric `V` and Circle Norm-Square:**
   - `comm (ellipticRotor P X Y c s) (V_met P X Y) = 0`,
   - `ellipticRotor P X Y c s * ellipticRotor P X Y c (-s) = c * c + s * s * V_met P X Y`,
2. **Elliptic Rotation of the Hyperbolic Plane `(S_P, Φ)`:**
   - `comm (J_mc P X Y) (S_P P) = - (2 • Phi_v P X Y)`,
   - `comm (J_mc P X Y) (Phi_v P X Y) = 2 • (S_P P * V_met P X Y)`,
3. **Bruhat–Möbius Orbit Closure on the Discrete Projector `P`:**
   The opposite-parabolic Bruhat rotor `G_+ = (1 - N_+)(1 + N_-)` satisfies `G_+ * G_+⁻¹ = 1`
   and transports `P` into the degree-3 self-closing observer projector
   `bruhatMoebiusProjectorPlus = G_+ * P * G_+⁻¹ = P + Φ - Σ - V * N_+` with
   `bruhatMoebiusProjectorPlus * bruhatMoebiusProjectorPlus = bruhatMoebiusProjectorPlus`.
-/
theorem elliptic_rotation_casimir_and_bruhat_moebius_orbit
    (P X Y c s : B) (hP : P * P = P)
    (hc : ∀ Z : B, c * Z = Z * c)
    (hs : ∀ Z : B, s * Z = Z * s) :
    let sp := S_P P
    let ph := Phi_v P X Y
    let j  := J_mc P X Y
    let v  := V_met P X Y
    comm (ellipticRotor P X Y c s) v = 0 ∧
    ellipticRotor P X Y c s * ellipticRotor P X Y c (-s) = c * c + s * s * v ∧
    comm j sp = - (2 • ph) ∧
    comm j ph = 2 • (sp * v) ∧
    bruhatMoebiusRotorPlus P X Y * bruhatMoebiusRotorPlusInv P X Y = 1 ∧
    bruhatMoebiusRotorPlus P X Y * P * bruhatMoebiusRotorPlusInv P X Y =
      bruhatMoebiusProjectorPlus P X Y ∧
    bruhatMoebiusProjectorPlus P X Y * bruhatMoebiusProjectorPlus P X Y =
      bruhatMoebiusProjectorPlus P X Y := by
  have h_jv : comm (J_mc P X Y) (V_met P X Y) = 0 := by
    dsimp only [J_mc, V_met, Q_pos, Q_neg, N_plus, N_minus, comm]
    amari_peirce_nf hP
  have h_jsq : J_mc P X Y * J_mc P X Y = - V_met P X Y := by
    dsimp only [J_mc, V_met, Q_pos, Q_neg, N_plus, N_minus]
    amari_peirce_nf hP
  have h_ell_comm : comm (ellipticRotor P X Y c s) (V_met P X Y) = 0 := by
    dsimp only [ellipticRotor, comm]
    calc (c + s * J_mc P X Y) * V_met P X Y - V_met P X Y * (c + s * J_mc P X Y)
        = (c * V_met P X Y - V_met P X Y * c) +
            s * (J_mc P X Y * V_met P X Y) - (V_met P X Y * s) * J_mc P X Y := by noncomm_ring
      _ = 0 + s * (J_mc P X Y * V_met P X Y) - (s * V_met P X Y) * J_mc P X Y := by
          rw [hc (V_met P X Y), sub_self, ← hs (V_met P X Y)]
      _ = s * (comm (J_mc P X Y) (V_met P X Y)) := by dsimp only [comm]; noncomm_ring
      _ = 0 := by rw [h_jv, mul_zero]
  have h_ell_norm :
      ellipticRotor P X Y c s * ellipticRotor P X Y c (-s) =
        c * c + s * s * V_met P X Y := by
    dsimp only [ellipticRotor]
    calc (c + s * J_mc P X Y) * (c + (-s) * J_mc P X Y)
        = c * c - c * s * J_mc P X Y + s * (J_mc P X Y * c) -
            s * (J_mc P X Y * s) * J_mc P X Y := by noncomm_ring
      _ = c * c - c * s * J_mc P X Y + s * (c * J_mc P X Y) -
            s * (s * J_mc P X Y) * J_mc P X Y := by
          rw [← hc (J_mc P X Y), ← hs (J_mc P X Y)]
      _ = c * c - (c * s - s * c) * J_mc P X Y - s * s * (J_mc P X Y * J_mc P X Y) := by
          noncomm_ring
      _ = c * c - 0 * J_mc P X Y - s * s * (- V_met P X Y) := by
          rw [hc s, sub_self, h_jsq]
      _ = c * c + s * s * V_met P X Y := by noncomm_ring
  refine ⟨h_ell_comm, h_ell_norm, ?_, ?_, ?_, ?_, ?_⟩ <;>
  · dsimp only [S_P, Phi_v, J_mc, Sigma_sp, V_met, Q_pos, Q_neg,
                bruhatMoebiusRotorPlus, bruhatMoebiusRotorPlusInv, bruhatMoebiusProjectorPlus,
                N_plus, N_minus, comm]
    amari_peirce_nf hP

/--
**Master Operator Möbius & Tetractys Lie Flow Coagulation
(`master_operator_moebius_tetractys_flow_coagulation`):**
Unifies the six stages (`𝔒𝔐₁ ≺ ⋯ ≺ 𝔒𝔐₆`) of the Operator Möbius Flow Poset in a single
kernel-checked theorem over `[Ring B]`:
1. `𝔰𝔩₂(B)` brackets `[S_P, Φ] = 2 • J`, `[S_P, J] = 2 • Φ`, `[J, Φ] = 2 • Σ` and Casimir
   `S_P² V + Φ² - J² = 3 • V`,
2. Parabolic unipotent group law `(1 + t N_+)(1 + s N_+) = 1 + (t + s) N_+`,
3. Hyperbolic Weyl scaling `(c + s S_P) N_+ (c - s S_P) = (c + s)² N_+` and
   `(c + s S_P) N_- (c - s S_P) = (c - s)² N_-`,
4. Elliptic Casimir invariance `[c + s J, V] = 0` and norm-square `(c + s J)(c - s J) = c² + s² V`,
5. Degree-3 Bruhat–Möbius orbit self-closure `G_+ P G_+⁻¹ = P̂_+` (`P̂_+² = P̂_+`).
-/
theorem master_operator_moebius_tetractys_flow_coagulation
    (P X Y c s : B) (hP : P * P = P)
    (hc : ∀ Z : B, c * Z = Z * c)
    (hs : ∀ Z : B, s * Z = Z * s) :
    let sp := S_P P
    let ph := Phi_v P X Y
    let j  := J_mc P X Y
    let s_sp := Sigma_sp P X Y
    let v  := V_met P X Y
    let np := N_plus P X
    let nm := N_minus P Y
    comm sp ph = j + j ∧
    comm sp j  = ph + ph ∧
    comm j ph  = s_sp + s_sp ∧
    casimirTetractys P X Y = 3 • v ∧
    parabolicFlowPlus P X c * parabolicFlowPlus P X s = parabolicFlowPlus P X (c + s) ∧
    hyperbolicRotor P c s * np * hyperbolicRotor P c (-s) = (c + s) * (c + s) * np ∧
    hyperbolicRotor P c s * nm * hyperbolicRotor P c (-s) = (c - s) * (c - s) * nm ∧
    comm (ellipticRotor P X Y c s) v = 0 ∧
    ellipticRotor P X Y c s * ellipticRotor P X Y c (-s) = c * c + s * s * v ∧
    bruhatMoebiusRotorPlus P X Y * P * bruhatMoebiusRotorPlusInv P X Y =
      bruhatMoebiusProjectorPlus P X Y ∧
    bruhatMoebiusProjectorPlus P X Y * bruhatMoebiusProjectorPlus P X Y =
      bruhatMoebiusProjectorPlus P X Y := by
  have h12 := tetractys_is_sl2_moebius_lie_algebra P X Y hP
  have h34 := root_space_and_parabolic_horocycle_flow P X Y c s hP hc hs
  have h5  := hyperbolic_weyl_dilation_action P X Y c s hP hc hs
  have h6  := elliptic_rotation_casimir_and_bruhat_moebius_orbit P X Y c s hP hc hs
  exact ⟨h12.1, h12.2.1, h12.2.2.1, h12.2.2.2.2.2.2.2.2.2.2.2.2.2,
         h34.2.2.2.2.1, h5.2.2.2.2.1, h5.2.2.2.2.2.1,
         h6.1, h6.2.1, h6.2.2.2.2.2.1, h6.2.2.2.2.2.2⟩

