import InfoGeometry.Categorical.LogJordanBraidGroup3CategoricalLift
import InfoGeometry.Categorical.LogNilpotentMonoidalCategory

/-
# The tensor-power sector generated by the standard logarithmic Jordan object

The ambient finite-nilpotent logarithmic modules already form a native Mathlib
monoidal category.  This file restricts that category to the objects generated
by one distinguished object and the tensor unit.

The restriction is a genuine category: its morphisms are the existing
logarithmic intertwiners between the selected ambient objects.  Tensor closure
is represented by tensor syntax trees, so no strictification or unproved
identification of differently parenthesized tensor products is introduced.

The checked logarithmic R action is the existing B3 representation.  The final
readback theorems identify its two categorical generators with the existing
standard Hadjiivanov representation.  No new braid presentation is defined.
-/

noncomputable section

namespace InfoGeometry.Categorical.LogJordanTensorPowerBraidSector

open CategoryTheory
open CategoryTheory.MonoidalCategory
open scoped CategoryTheory.MonoidalCategory TensorProduct

open InfoGeometry.Categorical.LogEndModuleCategory
open InfoGeometry.Categorical.LogEndModuleCategory.LogEndModule
open InfoGeometry.Categorical.LogNilpotentModuleCategory
open InfoGeometry.Categorical.LogNilpotentModuleCategory.LogNilpotentModule
open InfoGeometry.Categorical.LogNilpotentMonoidalCategory
open InfoGeometry.Categorical.LogNilpotentMonoidalUnit
open InfoGeometry.Categorical.LogJordanBraidGroup3CategoricalLift
open InfoGeometry.Categorical.LogJordanBraidGroup3Representation
open InfoGeometry.Categorical.FibonacciBraidGroup3Representation

/-- Parenthesized tensor expressions generated by the unit and one object. -/
inductive TensorPowerWord where
  | unit
  | generator
  | tensor (left right : TensorPowerWord)

/-- Interpretation of a tensor expression in the existing logarithmic category. -/
def wordInterpret : TensorPowerWord → LogNilpotentModule ℂ
  | .unit => unitObject
  | .generator => standardJordanObject
  | .tensor left right =>
      LogNilpotentModule.tensorObj (wordInterpret left) (wordInterpret right)

/-- The predicate selecting the tensor expressions generated by the standard
Jordan object. -/
def GeneratedTensorPower (Y : LogNilpotentModule ℂ) : Prop :=
  ∃ w : TensorPowerWord, Y = wordInterpret w

/-- The full subcategory on the generated tensor-power objects.

The morphisms are the ambient logarithmic intertwiners; only the objects are
restricted. -/
abbrev TensorPowerSubcategory :=
  {Y : LogNilpotentModule ℂ // GeneratedTensorPower Y}

/-- Category structure inherited from the ambient logarithmic category. -/
noncomputable instance tensorPowerSubcategoryCategory :
    Category TensorPowerSubcategory where
  Hom X Y := X.1 ⟶ Y.1
  id X := 𝟙 X.1
  comp f g := f ≫ g
  id_comp := by
    intro X Y f
    exact Category.id_comp f
  comp_id := by
    intro X Y f
    exact Category.comp_id f
  assoc := by
    intro W X Y Z f g h
    exact Category.assoc f g h

/-- A tensor expression is an object of the generated sector. -/
def tensorWordObject (w : TensorPowerWord) : TensorPowerSubcategory :=
  ⟨wordInterpret w, ⟨w, rfl⟩⟩

/-- Tensor closure of the generated sector. -/
def sectorTensorObj
    (X Y : TensorPowerSubcategory) : TensorPowerSubcategory :=
  ⟨LogNilpotentModule.tensorObj X.1 Y.1, by
    rcases X.2 with ⟨w, hw⟩
    rcases Y.2 with ⟨z, hz⟩
    refine ⟨TensorPowerWord.tensor w z, ?_⟩
    rw [hw, hz]
    rfl⟩

/-- Tensor product of existing logarithmic intertwiners in the sector. -/
def sectorTensorHom
    {X X' Y Y' : TensorPowerSubcategory}
    (f : X ⟶ X') (g : Y ⟶ Y') :
    sectorTensorObj X Y ⟶ sectorTensorObj X' Y' :=
  LogNilpotentModule.tensorHom f g

/-- The tensor unit belongs to the generated sector. -/
def sectorTensorUnit : TensorPowerSubcategory :=
  ⟨unitObject, ⟨TensorPowerWord.unit, rfl⟩⟩

/-- The existing logarithmic associator restricted to the generated sector. -/
def sectorAssociatorIso
    (X Y Z : TensorPowerSubcategory) :
    sectorTensorObj (sectorTensorObj X Y) Z ≅
      sectorTensorObj X (sectorTensorObj Y Z) :=
  { hom := (LogNilpotentModule.associatorIso X.1 Y.1 Z.1).hom
    inv := (LogNilpotentModule.associatorIso X.1 Y.1 Z.1).inv
    hom_inv_id := (LogNilpotentModule.associatorIso X.1 Y.1 Z.1).hom_inv_id
    inv_hom_id := (LogNilpotentModule.associatorIso X.1 Y.1 Z.1).inv_hom_id }

/-- The existing left unitor restricted to the generated sector. -/
def sectorLeftUnitorIso (X : TensorPowerSubcategory) :
    sectorTensorObj sectorTensorUnit X ≅ X :=
  { hom := (LogNilpotentMonoidalUnit.leftUnitorIso X.1).hom
    inv := (LogNilpotentMonoidalUnit.leftUnitorIso X.1).inv
    hom_inv_id := (LogNilpotentMonoidalUnit.leftUnitorIso X.1).hom_inv_id
    inv_hom_id := (LogNilpotentMonoidalUnit.leftUnitorIso X.1).inv_hom_id }

/-- The existing right unitor restricted to the generated sector. -/
def sectorRightUnitorIso (X : TensorPowerSubcategory) :
    sectorTensorObj X sectorTensorUnit ≅ X :=
  { hom := (LogNilpotentMonoidalUnit.rightUnitorIso X.1).hom
    inv := (LogNilpotentMonoidalUnit.rightUnitorIso X.1).inv
    hom_inv_id := (LogNilpotentMonoidalUnit.rightUnitorIso X.1).hom_inv_id
    inv_hom_id := (LogNilpotentMonoidalUnit.rightUnitorIso X.1).inv_hom_id }

@[simp]
theorem sector_tensorHom_id
    (X Y : TensorPowerSubcategory) :
    sectorTensorHom (𝟙 X) (𝟙 Y) = 𝟙 (sectorTensorObj X Y) := by
  change
    LogNilpotentModule.tensorHom (𝟙 X.1) (𝟙 Y.1) =
      𝟙 (LogNilpotentModule.tensorObj X.1 Y.1)
  exact LogNilpotentModule.tensorHom_id X.1 Y.1

@[simp]
theorem sector_tensorHom_comp
    {X₁ X₂ X₃ Y₁ Y₂ Y₃ : TensorPowerSubcategory}
    (f₁ : X₁ ⟶ X₂) (f₂ : X₂ ⟶ X₃)
    (g₁ : Y₁ ⟶ Y₂) (g₂ : Y₂ ⟶ Y₃) :
    sectorTensorHom (f₁ ≫ f₂) (g₁ ≫ g₂) =
      sectorTensorHom f₁ g₁ ≫ sectorTensorHom f₂ g₂ := by
  change
    LogNilpotentModule.tensorHom (f₁ ≫ f₂) (g₁ ≫ g₂) =
      LogNilpotentModule.tensorHom f₁ g₁ ≫
        LogNilpotentModule.tensorHom f₂ g₂
  exact LogNilpotentModule.tensorHom_comp f₁ f₂ g₁ g₂

/-- Naturality of the restricted associator. -/
theorem sector_associator_naturality
    {X₁ X₂ X₃ Y₁ Y₂ Y₃ : TensorPowerSubcategory}
    (f₁ : X₁ ⟶ Y₁) (f₂ : X₂ ⟶ Y₂) (f₃ : X₃ ⟶ Y₃) :
    sectorTensorHom (sectorTensorHom f₁ f₂) f₃ ≫
        (sectorAssociatorIso Y₁ Y₂ Y₃).hom =
      (sectorAssociatorIso X₁ X₂ X₃).hom ≫
        sectorTensorHom f₁ (sectorTensorHom f₂ f₃) := by
  change
    LogNilpotentModule.tensorHom
          (LogNilpotentModule.tensorHom f₁ f₂) f₃ ≫
        (LogNilpotentModule.associatorIso Y₁.1 Y₂.1 Y₃.1).hom =
      (LogNilpotentModule.associatorIso X₁.1 X₂.1 X₃.1).hom ≫
        LogNilpotentModule.tensorHom f₁
          (LogNilpotentModule.tensorHom f₂ f₃)
  exact LogNilpotentMonoidalCategory.associator_naturality f₁ f₂ f₃

/-- Naturality of the restricted left unitor. -/
theorem sector_leftUnitor_naturality
    {X Y : TensorPowerSubcategory} (f : X ⟶ Y) :
    sectorTensorHom (𝟙 sectorTensorUnit) f ≫
        (sectorLeftUnitorIso Y).hom =
      (sectorLeftUnitorIso X).hom ≫ f := by
  change
    LogNilpotentModule.tensorHom (𝟙 (unitObject : LogNilpotentModule ℂ)) f ≫
        (LogNilpotentMonoidalUnit.leftUnitorIso Y.1).hom =
      (LogNilpotentMonoidalUnit.leftUnitorIso X.1).hom ≫ f
  exact LogNilpotentMonoidalCategory.leftUnitor_naturality f

/-- Naturality of the restricted right unitor. -/
theorem sector_rightUnitor_naturality
    {X Y : TensorPowerSubcategory} (f : X ⟶ Y) :
    sectorTensorHom f (𝟙 sectorTensorUnit) ≫
        (sectorRightUnitorIso Y).hom =
      (sectorRightUnitorIso X).hom ≫ f := by
  change
    LogNilpotentModule.tensorHom f (𝟙 (unitObject : LogNilpotentModule ℂ)) ≫
        (LogNilpotentMonoidalUnit.rightUnitorIso Y.1).hom =
      (LogNilpotentMonoidalUnit.rightUnitorIso X.1).hom ≫ f
  exact LogNilpotentMonoidalCategory.rightUnitor_naturality f

/-- Pentagon coherence in the generated sector. -/
theorem sector_pentagon_identity
    (W X Y Z : TensorPowerSubcategory) :
    sectorTensorHom (sectorAssociatorIso W X Y).hom (𝟙 Z) ≫
        (sectorAssociatorIso W (sectorTensorObj X Y) Z).hom ≫
        sectorTensorHom (𝟙 W) (sectorAssociatorIso X Y Z).hom =
      (sectorAssociatorIso (sectorTensorObj W X) Y Z).hom ≫
        (sectorAssociatorIso W X (sectorTensorObj Y Z)).hom := by
  change
    LogNilpotentModule.tensorHom
          (LogNilpotentModule.associatorIso W.1 X.1 Y.1).hom (𝟙 Z.1) ≫
        (LogNilpotentModule.associatorIso W.1
          (LogNilpotentModule.tensorObj X.1 Y.1) Z.1).hom ≫
        LogNilpotentModule.tensorHom (𝟙 W.1)
          (LogNilpotentModule.associatorIso X.1 Y.1 Z.1).hom =
      (LogNilpotentModule.associatorIso
          (LogNilpotentModule.tensorObj W.1 X.1) Y.1 Z.1).hom ≫
        (LogNilpotentModule.associatorIso W.1 X.1
          (LogNilpotentModule.tensorObj Y.1 Z.1)).hom
  exact LogNilpotentMonoidalCategory.pentagon_identity W.1 X.1 Y.1 Z.1

/-- Triangle coherence in the generated sector. -/
theorem sector_triangle_identity
    (X Y : TensorPowerSubcategory) :
    (sectorAssociatorIso X sectorTensorUnit Y).hom ≫
        sectorTensorHom (𝟙 X) (sectorLeftUnitorIso Y).hom =
      sectorTensorHom (sectorRightUnitorIso X).hom (𝟙 Y) := by
  change
    (LogNilpotentModule.associatorIso X.1 unitObject Y.1).hom ≫
        LogNilpotentModule.tensorHom (𝟙 X.1)
          (LogNilpotentMonoidalUnit.leftUnitorIso Y.1).hom =
      LogNilpotentModule.tensorHom
        (LogNilpotentMonoidalUnit.rightUnitorIso X.1).hom (𝟙 Y.1)
  exact LogNilpotentMonoidalUnit.triangle_identity X.1 Y.1

/-- Native Mathlib monoidal structure on the generated sector. -/
noncomputable instance tensorPowerMonoidalCategoryStruct :
    MonoidalCategoryStruct TensorPowerSubcategory where
  tensorObj := sectorTensorObj
  whiskerLeft X _ _ f := sectorTensorHom (𝟙 X) f
  whiskerRight f Y := sectorTensorHom f (𝟙 Y)
  tensorHom := sectorTensorHom
  tensorUnit := sectorTensorUnit
  associator := sectorAssociatorIso
  leftUnitor := sectorLeftUnitorIso
  rightUnitor := sectorRightUnitorIso

/-- The generated tensor-power sector is a native Mathlib monoidal category. -/
noncomputable instance tensorPowerMonoidalCategory :
    MonoidalCategory TensorPowerSubcategory :=
  MonoidalCategory.ofTensorHom
    (id_tensorHom_id := fun X Y => sector_tensorHom_id X Y)
    (id_tensorHom := fun _ _ _ _ => rfl)
    (tensorHom_id := fun _ _ _ _ => rfl)
    (tensorHom_comp_tensorHom := by
      intro X₁ Y₁ Z₁ X₂ Y₂ Z₂ f₁ f₂ g₁ g₂
      exact (sector_tensorHom_comp f₁ f₂ g₁ g₂).symm)
    (associator_naturality := fun f₁ f₂ f₃ =>
      sector_associator_naturality f₁ f₂ f₃)
    (leftUnitor_naturality := fun f =>
      sector_leftUnitor_naturality f)
    (rightUnitor_naturality := fun f =>
      sector_rightUnitor_naturality f)
    (pentagon := sector_pentagon_identity)
    (triangle := sector_triangle_identity)

/-- The positive tensor powers, with the unit included at degree zero. -/
def standardPositiveTensorWord : ℕ → TensorPowerWord
  | 0 => .generator
  | n + 1 => .tensor .generator (standardPositiveTensorWord n)

/-- Canonical right-associated tensor-power words. -/
def standardTensorWord : ℕ → TensorPowerWord
  | 0 => .unit
  | n + 1 => standardPositiveTensorWord n

/-- The canonical tensor-power objects generated by the standard Jordan cell. -/
def standardTensorPower (n : ℕ) : TensorPowerSubcategory :=
  tensorWordObject (standardTensorWord n)

@[simp]
theorem standardTensorPower_zero :
    (standardTensorPower 0).1 = unitObject := rfl

@[simp]
theorem standardTensorPower_one :
    (standardTensorPower 1).1 = standardJordanObject := rfl

@[simp]
theorem standardTensorPower_two :
    (standardTensorPower 2).1 =
      LogNilpotentModule.tensorObj standardJordanObject standardJordanObject := rfl

@[simp]
theorem standardTensorPower_three :
    (standardTensorPower 3).1 =
      TripleObj standardJordanObject := rfl

/-- Existing B3 generators, now named at the tensor-power sector carrier. -/
noncomputable def standardTensorPowerBraidGenerators :
    BraidThreeGenerators
      (StandardTripleCarrier ≃ₗ[ℂ] StandardTripleCarrier) :=
  standardHadjiivanovBraidGenerators

/-- Existing presented-group action on the third tensor power. -/
noncomputable def standardTensorPowerBraidGroupHom :
    BraidGroup3 →
      (StandardTripleCarrier ≃ₗ[ℂ] StandardTripleCarrier) :=
  standardHadjiivanovBraidGroup3Hom

/-- Existing Mathlib representation on the third tensor power. -/
noncomputable def standardTensorPowerBraidRepresentation :
    Representation ℂ BraidGroup3 StandardTripleCarrier :=
  standardHadjiivanovBraidRepresentation

/-- First generator as a morphism in the generated logarithmic sector. -/
def standardTensorPowerSigmaOne :
    standardTensorPower 3 ⟶ standardTensorPower 3 := by
  change TripleObj standardJordanObject ⟶ TripleObj standardJordanObject
  exact standardCategoricalSigmaOne

/-- Second generator as a morphism in the generated logarithmic sector. -/
def standardTensorPowerSigmaTwo :
    standardTensorPower 3 ⟶ standardTensorPower 3 := by
  change TripleObj standardJordanObject ⟶ TripleObj standardJordanObject
  exact standardCategoricalSigmaTwo

@[simp]
theorem standardTensorPowerSigmaOne_hom :
    standardTensorPowerSigmaOne.hom =
      standardTensorPowerBraidRepresentation sigmaOne := by
  change standardCategoricalSigmaOne.hom =
    standardHadjiivanovBraidRepresentation sigmaOne
  exact standardCategoricalSigmaOne_hom

@[simp]
theorem standardTensorPowerSigmaTwo_hom :
    standardTensorPowerSigmaTwo.hom =
      standardTensorPowerBraidRepresentation sigmaTwo := by
  change standardCategoricalSigmaTwo.hom =
    standardHadjiivanovBraidRepresentation sigmaTwo
  exact standardCategoricalSigmaTwo_hom

/-- The categorical generators satisfy the finite Artin relation. -/
theorem standardTensorPower_categorical_artin :
    standardTensorPowerSigmaOne ≫ standardTensorPowerSigmaTwo ≫
        standardTensorPowerSigmaOne =
      standardTensorPowerSigmaTwo ≫ standardTensorPowerSigmaOne ≫
        standardTensorPowerSigmaTwo := by
  change standardCategoricalSigmaOne ≫ standardCategoricalSigmaTwo ≫
      standardCategoricalSigmaOne =
    standardCategoricalSigmaTwo ≫ standardCategoricalSigmaOne ≫
      standardCategoricalSigmaTwo
  exact standardCategorical_artin

/-- The existing group representation satisfies the same Artin relation. -/
theorem standardTensorPower_representation_artin :
    standardTensorPowerBraidRepresentation sigmaOne *
        standardTensorPowerBraidRepresentation sigmaTwo *
        standardTensorPowerBraidRepresentation sigmaOne =
      standardTensorPowerBraidRepresentation sigmaTwo *
        standardTensorPowerBraidRepresentation sigmaOne *
        standardTensorPowerBraidRepresentation sigmaTwo := by
  have h := congrArg
    (fun b : BraidGroup3 => standardTensorPowerBraidRepresentation b)
    braidGroup3_artin
  simpa only [map_mul] using h

/-- The generator readback is a categorical representation of the existing
presented B3 action on the generated third tensor power. -/
theorem standardTensorPower_representation_readback :
    standardTensorPowerBraidRepresentation sigmaOne =
        standardTensorPowerSigmaOne.hom ∧
      standardTensorPowerBraidRepresentation sigmaTwo =
        standardTensorPowerSigmaTwo.hom ∧
      standardTensorPower_categorical_artin := by
  refine ⟨standardTensorPowerSigmaOne_hom.symm,
    standardTensorPowerSigmaTwo_hom.symm, standardTensorPower_categorical_artin⟩

end InfoGeometry.Categorical.LogJordanTensorPowerBraidSector
