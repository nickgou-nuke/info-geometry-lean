import Mathlib
import InfoGeometry.OperatorAlgebra.SplitOctonionMultiplication

namespace InfoGeometry.Canonical

open InfoGeometry.OperatorAlgebra.SplitOctonions.Multiplication
open ExteriorAlgebra

variable {R V : Type*} [CommRing R] [AddCommGroup V] [Module R V]

/-- A typed map from the Zorn quark basis (SplitOct) into the Exterior Algebra
    generated by a 3D spatial triad.
    - `a` maps to scalars (0-forms)
    - `x₀, x₁, x₂` map to vectors (1-forms)
    - `y₀, y₁, y₂` map to bivectors (2-forms)
    - `b` maps to the volume form (3-forms)
    This provides an exact 8-to-8 state mapping. -/
noncomputable def zornToTriadExterior
    (triad : Fin 3 → V) (Z : SplitOct) : ExteriorAlgebra ℝ V :=
  let e0 := ι ℝ (triad 0)
  let e1 := ι ℝ (triad 1)
  let e2 := ι ℝ (triad 2)
  -- 0-form
  algebraMap ℝ (ExteriorAlgebra ℝ V) Z.a +
  -- 1-forms (quarks)
  Z.x0 • e0 + Z.x1 • e1 + Z.x2 • e2 +
  -- 2-forms (anti-quarks)
  Z.y0 • (e1 * e2) + Z.y1 • (e2 * e0) + Z.y2 • (e0 * e1) +
  -- 3-form (lepton)
  Z.b • (e0 * e1 * e2)

/-- A typed map from the Zorn quark basis (SplitOct) into the *even* subalgebra
    of the Exterior Algebra generated by a 4D spacetime tetrad.
    - `a` maps to the scalar (0-form)
    - `x₀, x₁, x₂, y₀, y₁, y₂` map to the 6 bivectors (2-forms)
    - `b` maps to the pseudoscalar (4-form)
    This encodes the Dirac/Majorana spinor degrees of freedom natively. -/
noncomputable def zornToTetradExterior
    (tetrad : Fin 4 → V) (Z : SplitOct) : ExteriorAlgebra ℝ V :=
  let e0 := ι ℝ (tetrad 0)
  let e1 := ι ℝ (tetrad 1)
  let e2 := ι ℝ (tetrad 2)
  let e3 := ι ℝ (tetrad 3)
  -- 0-form
  algebraMap ℝ (ExteriorAlgebra ℝ V) Z.a +
  -- 2-forms (x: spatial rotations / boosts)
  Z.x0 • (e0 * e1) + Z.x1 • (e0 * e2) + Z.x2 • (e0 * e3) +
  -- 2-forms (y: spatial rotations / boosts)
  Z.y0 • (e2 * e3) + Z.y1 • (e3 * e1) + Z.y2 • (e1 * e2) +
  -- 4-form
  Z.b • (e0 * e1 * e2 * e3)

end InfoGeometry.Canonical
