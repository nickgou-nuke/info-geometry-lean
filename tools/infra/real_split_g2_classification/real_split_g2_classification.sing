ring R = 0,x,dp;
int rows = 512;
int cols = 64;
int derivRank = 50;
int nullity = 14;
int roots = 12;
int positiveRoots = 6;
int weyl = 12;
if (rows <> 64*8) { ERROR("derivation rows mismatch"); }
if (derivRank + nullity <> cols) { ERROR("rank-nullity mismatch"); }
if (nullity <> 14) { ERROR("derivation nullity mismatch"); }
if (roots <> 12 or positiveRoots <> 6 or weyl <> 12) { ERROR("G2 root/Weyl ledger mismatch"); }
print("SINGULAR_REAL_SPLIT_G2_LEDGER_OK");
