import InfoGeometry.Algebra.Zorn.G2TwoBruhatClassification

/-!
# The finite Weyl group carrier

`WeylG2` is the normal-form parameter type.  The actual finite group is the
subgroup of concrete split-octonion automorphisms generated by the two Weyl
generators.  This file supplies the carrier-level equivalence between them.
Group operations are inherited from the concrete subgroup; no group structure
is imposed on the normal-form parameters by fiat.
-/

namespace InfoGeometry.Algebra.Zorn.G2ConcreteWeylG2

open InfoGeometry.Algebra.Zorn.G2TwoBruhatClassification
open InfoGeometry.OperatorAlgebra.G2TwoAutomorphismTheorem

noncomputable def weylG2ParameterMap (p : ZMod 6 × Bool) : weylG2Subgroup :=
  ⟨weylNF p.1 p.2, weylNF_mem_weylG2Subgroup p.1 p.2⟩

noncomputable def weylG2ParameterEquiv :
    WeylG2 ≃ weylG2Subgroup :=
  Equiv.ofBijective weylG2ParameterMap
    ⟨by
      intro p q h
      apply weylNF_injective
      exact congrArg Subtype.val h, by
      intro x
      rcases weylG2Subgroup_coverage_pair x with ⟨p, hp⟩
      exact ⟨p, Subtype.ext hp.symm⟩⟩

@[simp] theorem weylG2ParameterEquiv_apply (p : WeylG2) :
    (weylG2ParameterEquiv p : SplitOctF2Aut) = weylNF p.1 p.2 :=
  rfl

theorem weylG2ParameterEquiv_card :
    Fintype.card WeylG2 = Fintype.card weylG2Subgroup := by
  exact Fintype.card_congr weylG2ParameterEquiv

theorem weylG2Subgroup_card_eq_twelve :
    Fintype.card weylG2Subgroup = 12 := by
  rw [← weylG2ParameterEquiv_card]
  exact weylG2_card

/-- Multiplication transported from the concrete Weyl subgroup, expressed in
the normal-form parameter carrier. -/
noncomputable def weylMul (p q : WeylG2) : WeylG2 :=
  let h := weylNF_mul_exists p.1 q.1 p.2 q.2
  (Classical.choose h, Classical.choose (Classical.choose_spec h))

theorem weylNF_weylMul (p q : WeylG2) :
    weylNF (weylMul p q).1 (weylMul p q).2 =
      weylNF p.1 p.2 * weylNF q.1 q.2 := by
  exact (Classical.choose_spec (Classical.choose_spec
    (weylNF_mul_exists p.1 q.1 p.2 q.2))).symm

/-- Inversion transported from the concrete Weyl subgroup. -/
noncomputable def weylInv (p : WeylG2) : WeylG2 :=
  let h := weylNF_inv_exists p.1 p.2
  (Classical.choose h, Classical.choose (Classical.choose_spec h))

theorem weylNF_weylInv (p : WeylG2) :
    weylNF (weylInv p).1 (weylInv p).2 =
      (weylNF p.1 p.2)⁻¹ := by
  exact (Classical.choose_spec (Classical.choose_spec
    (weylNF_inv_exists p.1 p.2))).symm

theorem weylMul_assoc (p q r : WeylG2) :
    weylMul (weylMul p q) r = weylMul p (weylMul q r) := by
  apply weylNF_injective
  change weylNF (weylMul (weylMul p q) r).1
      (weylMul (weylMul p q) r).2 =
    weylNF (weylMul p (weylMul q r)).1
      (weylMul p (weylMul q r)).2
  rw [weylNF_weylMul, weylNF_weylMul, weylNF_weylMul, weylNF_weylMul]
  simp [mul_assoc]

theorem weyl_one_mul (p : WeylG2) : weylMul (0, false) p = p := by
  apply weylNF_injective
  change weylNF (weylMul (0, false) p).1
      (weylMul (0, false) p).2 = weylNF p.1 p.2
  rw [weylNF_weylMul, weylNF_zero_false]
  simp

theorem weyl_mul_one (p : WeylG2) : weylMul p (0, false) = p := by
  apply weylNF_injective
  change weylNF (weylMul p (0, false)).1
      (weylMul p (0, false)).2 = weylNF p.1 p.2
  rw [weylNF_weylMul, weylNF_zero_false]
  simp

theorem weylInv_mul_self (p : WeylG2) :
    weylMul (weylInv p) p = (0, false) := by
  apply weylNF_injective
  change weylNF (weylMul (weylInv p) p).1
      (weylMul (weylInv p) p).2 = weylNF (0, false).1 (0, false).2
  rw [weylNF_weylMul, weylNF_weylInv]
  simp [weylNF_zero_false]

theorem weyl_mul_inv_self (p : WeylG2) :
    weylMul p (weylInv p) = (0, false) := by
  apply weylNF_injective
  change weylNF (weylMul p (weylInv p)).1
      (weylMul p (weylInv p)).2 = weylNF (0, false).1 (0, false).2
  rw [weylNF_weylMul, weylNF_weylInv]
  simp [weylNF_zero_false]

end InfoGeometry.Algebra.Zorn.G2ConcreteWeylG2
