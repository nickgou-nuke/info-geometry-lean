{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://info-geometry-lean.local/schemas/claim_packet.schema.json",
  "title": "InjectionClaimPacket",
  "type": "object",
  "required": [
    "packet_id",
    "title",
    "source",
    "raw_text",
    "distilled_claim",
    "repo_mapping",
    "verification_plan",
    "status",
    "history"
  ],
  "properties": {
    "packet_id": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 3},
    "source": {
      "type": "object",
      "required": ["type", "ref", "date"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["web", "chat", "manual", "llm", "paper", "other"]
        },
        "ref": {"type": "string"},
        "date": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "raw_text": {"type": "string"},
    "distilled_claim": {"type": "string"},
    "research": {
      "type": "object",
      "properties": {
        "topic": {"type": "string"},
        "questions": {"type": "array", "items": {"type": "string"}},
        "sources": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "properties": {
                  "kind": {"type": "string"},
                  "ref": {"type": "string"},
                  "title": {"type": "string"},
                  "date": {"type": "string"}
                },
                "required": ["kind", "ref"],
                "additionalProperties": false
              }
            ]
          }
        },
        "coverage": {"type": "string"},
        "workflow": {
          "type": "object",
          "required": [
            "mode",
            "creative_provider",
            "verification_provider",
            "coding_provider",
            "creative_complete",
            "verification_complete"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["standard", "gemini-hermes-codex"]
            },
            "creative_provider": {"type": "string"},
            "verification_provider": {"type": "string"},
            "coding_provider": {"type": "string"},
            "creative_complete": {"type": "boolean"},
            "verification_complete": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["segment_id", "seed_text"],
            "properties": {
              "segment_id": {"type": "string"},
              "title": {"type": "string"},
              "source_span": {"type": "string"},
              "seed_text": {"type": "string"},
              "creative_notes": {"type": "string"},
              "enriched_context": {"type": "string"},
              "claims": {"type": "array", "items": {"type": "string"}},
              "inference_flags": {"type": "array", "items": {"type": "string"}},
              "confidence": {"type": "number"},
              "literature_evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["url", "summary"],
                  "properties": {
                    "url": {"type": "string"},
                    "title": {"type": "string"},
                    "date": {"type": "string"},
                    "summary": {"type": "string"},
                    "relevance": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "repo_mapping": {
      "type": "object",
      "required": ["owner_files", "symbols", "target_theorems"],
      "properties": {
        "owner_files": {"type": "array", "items": {"type": "string"}},
        "symbols": {"type": "array", "items": {"type": "string"}},
        "target_theorems": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "verification_plan": {
      "type": "object",
      "required": ["build_targets"],
      "properties": {
        "build_targets": {"type": "array", "items": {"type": "string"}},
        "audit_targets": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["raw", "distilled", "translated", "gated", "accepted", "rejected", "archived"]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "event"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "event": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
