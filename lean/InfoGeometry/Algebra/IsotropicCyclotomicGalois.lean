import InfoGeometry.Algebra.IsotropicCyclotomicGenesis
import Mathlib.RingTheory.Polynomial.Cyclotomic.Basic
import Mathlib.Tactic.NoncommRing

/-! # Cyclotomic calculus and Galois-type actions from isotropic pairs

This layer extends the square-zero-pair corner calculus. Universal polynomial
identities are stated in an arbitrary associative ring, while pair-specific
claims retain their square-zero and mutual-regularity hypotheses explicitly.
-/

namespace InfoGeometry.Algebra.IsotropicCyclotomicGalois

open InfoGeometry.Algebra.IsotropicCyclotomicGenesis

variable {B : Type*} [Ring B]

def commutator (x y : B) : B := x * y - y * x
def anticommutator (x y : B) : B := x * y + y * x
def idempotencyDefect (x : B) : B := x * x - x
def idempotencyDefectBar (x : B) : B := x * x + x
def secondDefectBar (x : B) : B := idempotencyDefectBar (idempotencyDefect x)

def cyclo1 (x : B) : B := x - 1
def cyclo2 (x : B) : B := x + 1
def cyclo3 (x : B) : B := x * x + x + 1
def cyclo4 (x : B) : B := x * x + 1
def cyclo6 (x : B) : B := x * x - x + 1

def pairParity (u v : B) : B := cornerPlus u v - cornerMinus u v

/-- The four support-normalized sandwich operators generated by the
square-zero pair. They are only a group action after restricting to the
regular-pair support corner. -/
def galId (u v x : B) : B :=
  (cornerUnit u v * cornerUnit u v) * x

def galPhi (u v x : B) : B :=
  cornerUnit u v * (isotropicSum u v * x * isotropicSum u v)

def galJ (u v x : B) : B :=
  -(cornerUnit u v * (isotropicDifference u v * x * isotropicDifference u v))

def galSig (u v x : B) : B :=
  pairParity u v * x * pairParity u v

/-- Inner derivation generated by an element of the associative ring. -/
def innerDerivation (a x : B) : B := commutator a x

/-- The degree-two Kantor sandwich associated to a generator. -/
def kantorSandwich (a x : B) : B := a * x * a

/-- The conventional cyclotomic factors in one noncommuting ring element
still obey their polynomial identities: all factors are polynomials in the
same element, so no commutativity of the ambient ring is needed. -/
theorem cyclotomic_polynomial_calculus (x : B) :
    idempotencyDefect x = cyclo6 x - 1 ∧
    idempotencyDefectBar x = cyclo3 x - 1 ∧
    (cyclo3 x - 1) * (cyclo6 x - 1) = idempotencyDefect (x * x) ∧
    cyclo3 x * cyclo6 x = cyclo3 (x * x) ∧
    cyclo1 x * cyclo2 x * cyclo3 x * cyclo6 x =
      x * x * x * x * x * x - 1 := by
  simp only [idempotencyDefect, idempotencyDefectBar, cyclo1, cyclo2,
    cyclo3, cyclo6]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> noncomm_ring

/-- Evaluate the standard integral cyclotomic polynomial at a possibly
noncommuting ring element. The coefficients are central, so this evaluation
is multiplicative even though the ambient ring need not be commutative. -/
noncomputable def cyclotomicEval (n : ℕ) (x : B) : B :=
  Polynomial.aeval x (Polynomial.cyclotomic n ℤ)

/-- Cyclotomic evaluations at one operator commute pairwise: their source
polynomials commute in `ℤ[X]`, and evaluation preserves their product. -/
theorem cyclotomicEval_commute (m n : ℕ) (x : B) :
    cyclotomicEval m x * cyclotomicEval n x =
      cyclotomicEval n x * cyclotomicEval m x := by
  dsimp [cyclotomicEval]
  rw [← Polynomial.aeval_mul, mul_comm (Polynomial.cyclotomic m ℤ)
    (Polynomial.cyclotomic n ℤ), Polynomial.aeval_mul]

/-- The full divisor-indexed cyclotomic product evaluates to `x^n - 1`
inside any associative ring. This is the general, arbitrary-order version
of the finite `Φ₁, Φ₂, Φ₃, Φ₄, Φ₆` identities above. -/
noncomputable def cyclotomicDivisorProduct (n : ℕ) (x : B) : B :=
  ((Nat.divisors n).toList.map (fun d => cyclotomicEval d x)).prod

/-- The divisor product uses the finset's canonical list order, so it is
defined in a noncommutative monoid. Pairwise commutativity of the factors
ensures that this ordered product realizes the usual cyclotomic product. -/
theorem cyclotomicEval_divisor_product (n : ℕ) (hn : 0 < n) (x : B) :
    cyclotomicDivisorProduct n x = x ^ n - 1 := by
  have h := Polynomial.prod_cyclotomic_eq_X_pow_sub_one hn ℤ
  have hlist : ((Nat.divisors n).toList.map (fun d =>
      Polynomial.cyclotomic d ℤ)).prod = Polynomial.X ^ n - 1 := by
    rw [← Finset.prod_map_toList] at h
    exact h
  have heval := congrArg (Polynomial.aeval x) hlist
  simpa only [cyclotomicDivisorProduct, cyclotomicEval, List.map_map,
    Function.comp_def, map_list_prod, Polynomial.aeval_X, map_sub,
    map_one, map_pow] using heval

/-- A normalized square-zero pair closes the relative third- and
sixth-cyclotomic equations on the idempotent metric it generates. This
connects nilpotent-first idempotent birth to the existing relative-root
calculus without assuming regularity separately. -/
theorem normalized_pair_relative_cyclotomic_roots (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hunit : u * v + v * u = 1) :
    relativePhi3 (cornerUnit u v) (root3 u v) = 0 ∧
    relativePhi4 (cornerUnit u v) (isotropicDifference u v) = 0 ∧
    relativePhi6 (cornerUnit u v) (root6 u v) = 0 := by
  obtain ⟨hregU, hregV⟩ :=
    normalized_square_zero_pair_is_mutually_regular u v hu hv hunit
  exact regular_pair_relative_cyclotomic_roots u v hu hv hregU hregV

/-- When the normalized anticommutator is the unit, the relative equations
are the ordinary third, fourth, and sixth cyclotomic equations. -/
theorem normalized_pair_cyclotomic_roots (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hunit : u * v + v * u = 1) :
    cyclo3 (root3 u v) = 0 ∧
    cyclo4 (isotropicDifference u v) = 0 ∧
    cyclo6 (root6 u v) = 0 := by
  obtain ⟨h3, h4, h6⟩ :=
    normalized_pair_relative_cyclotomic_roots u v hu hv hunit
  refine ⟨?_, ?_, ?_⟩
  · simpa [cyclo3, relativePhi3, cornerUnit, hunit] using h3
  · simpa [cyclo4, relativePhi4, cornerUnit, hunit] using h4
  · simpa [cyclo6, relativePhi6, cornerUnit, hunit] using h6

/-- The normalized square-zero pair's relative roots are exact roots of
unity: a third root, a fourth root, and an anti-periodic sixth root. -/
theorem normalized_pair_root_of_unity_laws (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hunit : u * v + v * u = 1) :
    root3 u v * root3 u v * root3 u v = 1 ∧
    isotropicDifference u v * isotropicDifference u v *
      isotropicDifference u v * isotropicDifference u v = 1 ∧
    root6 u v * root6 u v * root6 u v = -1 := by
  obtain ⟨hregU, hregV⟩ :=
    normalized_square_zero_pair_is_mutually_regular u v hu hv hunit
  refine ⟨?_, ?_, ?_⟩
  · simpa [cornerUnit, hunit] using
      regular_pair_third_root_cube u v hu hv hregU hregV
  · simpa [cornerUnit, hunit] using
      regular_pair_fourth_root_fourth_power u v hu hv hregU hregV
  · simpa [cornerUnit, hunit] using
      regular_pair_sixth_root_cube u v hu hv hregU hregV

/-- The complementary idempotents born from a normalized pair define an
involutive grading: the ordered-product difference fixes the positive corner
and negates the reverse-product corner. -/
theorem normalized_pair_parity_grading (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hunit : u * v + v * u = 1) :
    pairParity u v * pairParity u v = 1 ∧
    pairParity u v * cornerPlus u v = cornerPlus u v ∧
    pairParity u v * cornerMinus u v = -cornerMinus u v := by
  obtain ⟨hPlus, hMinus, hPM, hMP, hsum⟩ :=
    normalized_square_zero_pair_generates_orthogonal_idempotents u v hu hv hunit
  have hPlus' : (u * v) * (u * v) = u * v := by
    simpa [cornerPlus] using hPlus
  have hMinus' : (v * u) * (v * u) = v * u := by
    simpa [cornerMinus] using hMinus
  have hPM' : (u * v) * (v * u) = 0 := by
    simpa [cornerPlus, cornerMinus] using hPM
  have hMP' : (v * u) * (u * v) = 0 := by
    simpa [cornerPlus, cornerMinus] using hMP
  refine ⟨?_, ?_, ?_⟩
  · dsimp [pairParity, cornerPlus, cornerMinus]
    calc
      (u * v - v * u) * (u * v - v * u) =
          (u * v) * (u * v) - (u * v) * (v * u) -
            (v * u) * (u * v) + (v * u) * (v * u) := by noncomm_ring
      _ = u * v + v * u := by rw [hPlus', hMinus', hPM', hMP']; noncomm_ring
      _ = 1 := by simpa [cornerPlus, cornerMinus] using hsum
  · dsimp [pairParity, cornerPlus, cornerMinus]
    calc
      (u * v - v * u) * (u * v) =
          (u * v) * (u * v) - (v * u) * (u * v) := by noncomm_ring
      _ = u * v := by rw [hPlus', hMP']; noncomm_ring
  · dsimp [pairParity, cornerPlus, cornerMinus]
    calc
      (u * v - v * u) * (v * u) =
          (u * v) * (v * u) - (v * u) * (v * u) := by noncomm_ring
      _ = -(v * u) := by rw [hPM', hMinus']; noncomm_ring

/-- The born parity has opposite left and right signs on the two normalized
square-zero generators, which are the odd Peirce modes. -/
theorem normalized_pair_generators_are_odd (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hunit : u * v + v * u = 1) :
    pairParity u v * u = u ∧
    u * pairParity u v = -u ∧
    pairParity u v * v = -v ∧
    v * pairParity u v = v := by
  obtain ⟨hregU, hregV⟩ :=
    normalized_square_zero_pair_is_mutually_regular u v hu hv hunit
  refine ⟨?_, ?_, ?_, ?_⟩
  · dsimp [pairParity, cornerPlus, cornerMinus]
    calc
      (u * v - v * u) * u = u * v * u - v * (u * u) := by noncomm_ring
      _ = u := by rw [hregU, hu]; noncomm_ring
  · dsimp [pairParity, cornerPlus, cornerMinus]
    calc
      u * (u * v - v * u) = (u * u) * v - u * v * u := by noncomm_ring
      _ = -u := by rw [hu, hregU]; noncomm_ring
  · dsimp [pairParity, cornerPlus, cornerMinus]
    calc
      (u * v - v * u) * v = u * (v * v) - v * u * v := by noncomm_ring
      _ = -v := by rw [hv, hregV]; noncomm_ring
  · dsimp [pairParity, cornerPlus, cornerMinus]
    calc
      v * (u * v - v * u) = v * u * v - (v * v) * u := by noncomm_ring
      _ = v := by rw [hregV, hv]; noncomm_ring

/-- The defect operator iterated once has an exact factorization in any ring. -/
theorem defect_iterate_factorization (x : B) :
    idempotencyDefect (idempotencyDefect x) =
      idempotencyDefect x * (idempotencyDefect x - 1) := by
  simp only [idempotencyDefect]
  noncomm_ring

/-- The square of an inner derivation generated by a square-zero element is
minus twice the corresponding Kantor sandwich. -/
theorem nilpotent_inner_derivation_square (a x : B) (ha : a * a = 0) :
    innerDerivation a (innerDerivation a x) =
      -(kantorSandwich a x + kantorSandwich a x) := by
  simp only [innerDerivation, commutator, kantorSandwich]
  calc
    a * (a * x - x * a) - (a * x - x * a) * a =
        a * (a * x) - a * (x * a) - (a * x) * a + (x * a) * a := by
          noncomm_ring
    _ = -(a * x * a + a * x * a) := by
      rw [show a * (a * x) = 0 by rw [← mul_assoc, ha, zero_mul],
        show (x * a) * a = 0 by rw [mul_assoc, ha, mul_zero]]
      noncomm_ring

/-- The commutator of two inner derivations is generated by the commutator
of their generators (the associative-algebra Jacobi identity). -/
theorem inner_derivation_commutator (a b x : B) :
    innerDerivation a (innerDerivation b x) -
      innerDerivation b (innerDerivation a x) =
        innerDerivation (commutator a b) x := by
  simp only [innerDerivation, commutator]
  noncomm_ring

/-- A square-zero generator annihilates the next sandwich grade on either
side of the inner derivation. -/
theorem nilpotent_extremal_grade_termination (a x : B) (ha : a * a = 0) :
    innerDerivation a (kantorSandwich a x) = 0 ∧
    kantorSandwich a (innerDerivation a x) = 0 ∧
    kantorSandwich a (kantorSandwich a x) = 0 := by
  simp only [innerDerivation, commutator, kantorSandwich]
  have hLeft : a * (a * x * a) = 0 := by
    calc
      a * (a * x * a) = (a * a) * x * a := by noncomm_ring
      _ = 0 := by rw [ha]; simp
  have hRight : a * x * a * a = 0 := by
    calc
      a * x * a * a = a * x * (a * a) := by noncomm_ring
      _ = 0 := by rw [ha]; simp
  refine ⟨?_, ?_, ?_⟩
  · calc
      a * (a * x * a) - a * x * a * a = 0 - 0 := by rw [hLeft, hRight]
      _ = 0 := by simp
  · calc
      a * (a * x - x * a) * a =
          a * (a * x * a) - a * x * a * a := by noncomm_ring
      _ = 0 := by rw [hLeft, hRight]; simp
  · calc
      a * (a * x * a) * a = (a * a) * x * (a * a) := by noncomm_ring
      _ = 0 := by rw [ha]; simp

/-- A root of the sixth cyclotomic polynomial is a meta-idempotent: its
ordinary defect is `-1`, the bar-defect of that defect vanishes, and its cube
is `-1`. -/
theorem cyclo6_root_meta_idempotent (x : B) (h : cyclo6 x = 0) :
    idempotencyDefect x = -1 ∧ secondDefectBar x = 0 ∧
      x * x * x = -1 := by
  have hDefect : idempotencyDefect x = -1 := by
    have hCalc := (cyclotomic_polynomial_calculus x).1
    rw [h] at hCalc
    simpa [idempotencyDefect] using hCalc
  dsimp [cyclo6] at h
  refine ⟨hDefect, ?_, ?_⟩
  · simp [secondDefectBar, idempotencyDefectBar, hDefect]
  · have hLinear : x * x - x = -1 := by
      calc
        x * x - x = (x * x - x + 1) - 1 := by noncomm_ring
        _ = -1 := by rw [h]; noncomm_ring
    calc
      x * x * x = (x * x - x + 1) * x + (x * x - x) := by noncomm_ring
      _ = -1 := by rw [h, hLinear]; simp

/-- The third cyclotomic root has the dual defect and cube laws. -/
theorem cyclo3_root_dual_meta_idempotent (x : B) (h : cyclo3 x = 0) :
    idempotencyDefectBar x = -1 ∧
      idempotencyDefectBar (idempotencyDefectBar x) = 0 ∧
      x * x * x = 1 := by
  have hDefect : idempotencyDefectBar x = -1 := by
    have hCalc := (cyclotomic_polynomial_calculus x).2.1
    rw [h] at hCalc
    simpa [idempotencyDefectBar] using hCalc
  dsimp [cyclo3] at h
  refine ⟨hDefect, ?_, ?_⟩
  · rw [hDefect]
    simp [idempotencyDefectBar]
  · have hLinear : x * x + x = -1 := by
      calc
        x * x + x = (x * x + x + 1) - 1 := by noncomm_ring
        _ = -1 := by simpa using congrArg (fun z : B => z - 1) h
    calc
      x * x * x = (x * x + x + 1) * x - (x * x + x) := by noncomm_ring
      _ = 1 := by rw [h, hLinear]; simp

/-- The square-zero generators satisfy the split-quaternion tetraktys:
the symmetric and antisymmetric combinations square to `±V`, their Jordan
anticommutator vanishes, and the ordered product `J Φ` is the corner parity. -/
theorem isotropic_pair_tetraktys (u v : B)
    (hu : u * u = 0) (hv : v * v = 0) :
    isotropicSum u v * isotropicSum u v = cornerUnit u v ∧
    isotropicDifference u v * isotropicDifference u v = -cornerUnit u v ∧
    anticommutator (isotropicSum u v) (isotropicDifference u v) = 0 ∧
    isotropicDifference u v * isotropicSum u v = pairParity u v ∧
    pairParity u v * pairParity u v = cornerUnit u v * cornerUnit u v ∧
    commutator u (cornerUnit u v) = 0 ∧
    commutator v (cornerUnit u v) = 0 := by
  refine ⟨isotropic_sum_square u v hu hv,
    isotropic_difference_square u v hu hv, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp [anticommutator, isotropicSum, isotropicDifference]
    noncomm_ring [hu, hv]
  · dsimp [isotropicSum, isotropicDifference, pairParity, cornerPlus, cornerMinus,
      commutator]
    noncomm_ring [hu, hv]
  · dsimp [pairParity, cornerPlus, cornerMinus, cornerUnit]
    noncomm_ring [hu, hv, ← mul_assoc u u, ← mul_assoc v v]
  · dsimp [commutator, cornerUnit]
    noncomm_ring [hu, hv, ← mul_assoc u u, ← mul_assoc v v]
  · dsimp [commutator, cornerUnit]
    noncomm_ring [hu, hv, ← mul_assoc u u, ← mul_assoc v v]

/-- Mutual regularity upgrades the square-zero pair's commutator to a
tripotent which acts with opposite signs on the two generators. -/
theorem regular_pair_parity_tripotent (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hregU : u * v * u = u) (hregV : v * u * v = v) :
    pairParity u v * pairParity u v * pairParity u v = pairParity u v ∧
    pairParity u v * u = u ∧ u * pairParity u v = -u ∧
    pairParity u v * v = -v ∧ v * pairParity u v = v := by
  obtain ⟨hregU', hregV'⟩ :=
    regular_pair_right_nested_forms u v hregU hregV
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;>
    dsimp [pairParity, cornerPlus, cornerMinus] <;>
    noncomm_ring [hu, hv, ← mul_assoc u u, ← mul_assoc v v,
      hregU, hregV, hregU', hregV']

/-- Under mutual regularity, the support and its complement are idempotent,
and the commutator grading squares to that support. -/
theorem regular_pair_support_and_parity_square (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hregU : u * v * u = u) (hregV : v * u * v = v) :
    cornerUnit u v * cornerUnit u v = cornerUnit u v ∧
    (1 - cornerUnit u v) * (1 - cornerUnit u v) = 1 - cornerUnit u v ∧
    pairParity u v * pairParity u v = cornerUnit u v := by
  obtain ⟨hregU', hregV'⟩ := regular_pair_right_nested_forms u v hregU hregV
  have hUnit := regular_pair_generates_orthogonal_idempotents
    u v hu hv hregU hregV |>.2.2.1
  have hUnitSq : cornerUnit u v * cornerUnit u v = cornerUnit u v :=
    sub_eq_zero.mp hUnit
  refine ⟨hUnitSq, ?_, ?_⟩
  · noncomm_ring [hUnitSq]
  · dsimp [pairParity, cornerPlus, cornerMinus, cornerUnit]
    noncomm_ring [hu, hv, ← mul_assoc u u, ← mul_assoc v v,
      hregU, hregV, hregU', hregV']

/-- The ordinary cyclotomic factors of the sum and difference of a
square-zero pair evaluate to the corresponding cyclotomic polynomial of
the generated support `V = u*v + v*u`. -/
theorem cyclotomic_evaluation_on_isotropic_pair (u v : B)
    (hu : u * u = 0) (hv : v * v = 0) :
    cyclo3 (isotropicDifference u v) * cyclo6 (isotropicDifference u v) =
        cyclo6 (cornerUnit u v) ∧
    cyclo3 (isotropicSum u v) * cyclo6 (isotropicSum u v) =
        cyclo3 (cornerUnit u v) := by
  constructor <;> dsimp [cyclo3, cyclo6, isotropicDifference,
    isotropicSum, cornerUnit] <;>
    noncomm_ring [hu, hv, ← mul_assoc u u, ← mul_assoc v v]

/-- Defect of the generated support is the sum of the defects of its two
orthogonal round-trip products; no regularity is needed. -/
theorem support_defect_is_corner_defect_sum (u v : B)
    (hu : u * u = 0) (hv : v * v = 0) :
    idempotencyDefect (cornerUnit u v) =
      idempotencyDefect (cornerPlus u v) +
        idempotencyDefect (cornerMinus u v) := by
  dsimp [idempotencyDefect, cornerUnit, cornerPlus, cornerMinus]
  noncomm_ring [hu, hv, ← mul_assoc u u, ← mul_assoc v v]

/-- Under a cyclo6 root equation, the sixth root's cube is `-1`.
This is the absolute (constant term one) polynomial, distinct from the
relative corner-root equations in `IsotropicCyclotomicGenesis`. -/
theorem cyclo6_root_cube (x : B) (h : cyclo6 x = 0) :
    x * x * x = -1 :=
  (cyclo6_root_meta_idempotent x h).2.2

/-- Under a cyclo3 root equation, the third root's cube is `1`. -/
theorem cyclo3_root_cube (x : B) (h : cyclo3 x = 0) :
    x * x * x = 1 :=
  (cyclo3_root_dual_meta_idempotent x h).2.2

/-- The proposed character expressions select the sum and difference
channels of the isotropic tetraktys. These are element identities, not a
claim that the four displayed maps form a global group action. -/
theorem isotropic_character_sieve (u v : B)
    (hu : u * u = 0) (hv : v * v = 0) :
    let phi := isotropicSum u v
    let j := isotropicDifference u v
    galId u v phi + galPhi u v phi - galJ u v phi - galSig u v phi =
      4 • (cornerUnit u v * cornerUnit u v * phi) ∧
    galId u v j - galPhi u v j + galJ u v j - galSig u v j =
      4 • (cornerUnit u v * cornerUnit u v * j) := by
  dsimp [isotropicSum, isotropicDifference, cornerUnit, pairParity,
    cornerPlus, cornerMinus, galId, galPhi, galJ, galSig]
  constructor <;>
    noncomm_ring [hu, hv, ← mul_assoc u u, ← mul_assoc v v]

/-- Product table of the four tetraktys elements on a mutually regular
square-zero pair. These ordered identities are the algebraic input for the
supported Klein-four sandwich action. -/
theorem regular_pair_tetraktys_products (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hregU : u * v * u = u) (hregV : v * u * v = v) :
    isotropicSum u v * isotropicSum u v = cornerUnit u v ∧
    isotropicDifference u v * isotropicDifference u v = -cornerUnit u v ∧
    pairParity u v * pairParity u v = cornerUnit u v ∧
    isotropicSum u v * isotropicDifference u v = -pairParity u v ∧
    isotropicDifference u v * isotropicSum u v = pairParity u v ∧
    isotropicSum u v * pairParity u v = -isotropicDifference u v ∧
    pairParity u v * isotropicSum u v = isotropicDifference u v ∧
    isotropicDifference u v * pairParity u v = -isotropicSum u v ∧
    pairParity u v * isotropicDifference u v = isotropicSum u v := by
  obtain ⟨hregU', hregV'⟩ := regular_pair_right_nested_forms u v hregU hregV
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    dsimp [isotropicSum, isotropicDifference, pairParity,
      cornerPlus, cornerMinus, cornerUnit] <;>
    noncomm_ring [hu, hv, ← mul_assoc u u, ← mul_assoc v v,
      hregU, hregV, hregU', hregV']

/-- On the corner supported by the regular-pair idempotent `V`, the identity
sandwich acts as the identity. The other unnormalized sandwiches are not
asserted here to form a global Klein-four action. -/
theorem regular_pair_galois_identity_on_support (u v x : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hregU : u * v * u = u) (hregV : v * u * v = v)
    (hsupp : x = cornerUnit u v * x * cornerUnit u v) :
    galId u v x = x := by
  have hV : cornerUnit u v * cornerUnit u v = cornerUnit u v := by
    exact sub_eq_zero.mp (regular_pair_generates_orthogonal_idempotents
      u v hu hv hregU hregV).2.2.1
  have hLeft : cornerUnit u v * x = x := by
    calc
      cornerUnit u v * x = cornerUnit u v *
          (cornerUnit u v * x * cornerUnit u v) := congrArg
            (fun y : B => cornerUnit u v * y) hsupp
      _ = (cornerUnit u v * cornerUnit u v) * x * cornerUnit u v := by
        noncomm_ring
      _ = cornerUnit u v * x * cornerUnit u v := by rw [hV]
      _ = x := hsupp.symm
  dsimp [galId]
  rw [hV, hLeft]

/-- D79 synthesis, with the logical boundary made explicit: orthogonality and
the tetraktys need only square-zero hypotheses; idempotency, cyclotomic root
closure, and Frobenius sandwiches additionally require mutual regularity. -/
theorem stage_D79_isotropic_cyclotomic_galois_synthesis (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hregU : u * v * u = u) (hregV : v * u * v = v) :
    cornerPlus u v * cornerMinus u v = 0 ∧
    isotropicSum u v * isotropicSum u v = cornerUnit u v ∧
    isotropicDifference u v * isotropicDifference u v = -cornerUnit u v ∧
    defect (cornerPlus u v) = 0 ∧
    defect (cornerMinus u v) = 0 ∧
    defect (cornerUnit u v) = 0 ∧
    pairParity u v * pairParity u v = cornerUnit u v ∧
    relativePhi3 (cornerUnit u v) (root3 u v) = 0 ∧
    relativePhi4 (cornerUnit u v) (isotropicDifference u v) = 0 ∧
    relativePhi6 (cornerUnit u v) (root6 u v) = 0 ∧
    defect (root6 u v) = -cornerUnit u v ∧
    defect (-defect (root6 u v)) = 0 ∧
    isotropicSum u v * root3 u v * isotropicSum u v = root3 u v * root3 u v ∧
    isotropicSum u v * (root3 u v * root3 u v) * isotropicSum u v = root3 u v := by
  have hOrth := isotropic_products_and_defects u v hu hv
  have hIdem := regular_pair_generates_orthogonal_idempotents
    u v hu hv hregU hregV
  have hTet := isotropic_pair_tetraktys u v hu hv
  have hParity := regular_pair_support_and_parity_square u v hu hv hregU hregV
  have hRoots := regular_pair_relative_cyclotomic_roots u v hu hv hregU hregV
  have hMeta := sixth_root_defect_generates_idempotent u v hu hv hregU hregV
  have hFrob := isotropic_sum_galois_sandwich u v hu hv hregU hregV
  have hRound := isotropic_sum_galois_round_trip u v hu hv hregU hregV
  exact ⟨hOrth.1, hTet.1, hTet.2.1, hIdem.1, hIdem.2.1,
    hIdem.2.2.1, hParity.2.2, hRoots.1, hRoots.2.1, hRoots.2.2,
    hMeta.1, hMeta.2, hFrob, hRound⟩

end InfoGeometry.Algebra.IsotropicCyclotomicGalois
