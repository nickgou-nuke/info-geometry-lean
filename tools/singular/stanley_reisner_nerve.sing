LIB "dmod.lib";

// The nerve of a poset P is the simplicial complex of chains in P.
// The 1-skeleton of this nerve is a graph (1-dimensional simplicial complex)
// whose edges are the comparable pairs in P.
// The Stanley-Reisner ideal of this 1-skeleton is generated by its minimal non-faces:
// 1. The non-edges (incomparable pairs in P)
// 2. The triangles (3-chains in P, since they are not in the 1-skeleton)

// Let's use the Boolean algebra on 2 elements as our poset:
// Elements: 1, 2, 3, 4
// Relations: 1 < 2, 1 < 3, 2 < 4, 3 < 4 (and transitivity: 1 < 4)
// Incomparable pairs: {2, 3}
// 3-chains (triangles in the graph): {1, 2, 4} and {1, 3, 4}

ring R = 0, (x1, x2, x3, x4), dp;

// Define the Stanley-Reisner ideal of the 1-skeleton
ideal I = x2*x3, x1*x2*x4, x1*x3*x4;

// Compute its standard Groebner basis
ideal GB = std(I);
print("--- Standard Groebner Basis ---");
print(GB);
print("");

// Compute its free resolution
resolution resI = res(I, 0);
print("--- Free Resolution ---");
print(resI);
print("");

quit;
