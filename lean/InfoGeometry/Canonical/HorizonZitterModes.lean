import InfoGeometry.Canonical.DrazinModularPersistence
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Meta.Architecture

/-!
# Horizon zitter modes

Matter as modular-chiral trembling around a Drazin horizon.

This file extends `DrazinModularPersistence` without duplicating its owner API.
The existing file owns:

* modular zero modes,
* Drazin support horizons,
* physical horizons,

This file adds the theorem-safe zitter socket:

* a discrete involutive symmetry for chiral/CPT/V₄-style trembling;
* a structural Klein-four-style action socket;
* a Drazin frequency projector `1 - L * Lᴰ` for harmonic envelopes;
* a horizon zitter mode whose raw observable may move, while its envelope is
  explicitly extracted by double-sided harmonic compression of the
  Drazin-compressed raw observable and certified horizon-localized, harmonic,
  and modular-zero;
No claim is made that a raw modular-chiral orbit is itself physical.  Optional
Fierz/channel readouts are isolated in `HorizonZitterFierzReadout`.
-/

noncomputable section

namespace InfoGeometry.Canonical.HorizonZitterModes

open InfoGeometry.Canonical.DrazinModularPersistence
open InfoGeometry.Canonical.Drazin
open InfoGeometry.OperatorAlgebra.Thermodynamics

/-- Drazin horizon data reuses the persistence support owner. -/
abbrev DrazinHorizon
    (Obs : Type*) [Ring Obs] [Star Obs] :=
  DrazinSupportData Obs

/--
A discrete involutive multiplicative symmetry.

This is an abstract socket for chirality, CPT, or a generator of a Klein-four
symmetry.  The file does not assume such a symmetry exists canonically.
-/
@[rep_depth operator]
structure InvolutiveSymmetry
    (Obs : Type*) [Ring Obs] where
  action : Obs ≃+* Obs
  involutive : ∀ x : Obs, action (action x) = x

/--
A Klein-four-style action by ring automorphisms.

This is intentionally structural.  It records an abstract fourfold discrete
symmetry action without choosing a concrete finite type or proving that the
type has exactly four elements.
-/
@[rep_depth operator]
structure KleinFourAction
    (Obs : Type*) [Ring Obs] where
  V4 : Type*
  one : V4
  mul : V4 → V4 → V4
  action : V4 → Obs ≃+* Obs
  action_one : action one = RingEquiv.refl Obs
  action_mul :
    ∀ g h : V4, ∀ x : Obs,
      action (mul g h) x = action g (action h x)
  involutive :
    ∀ g : V4, ∀ x : Obs,
      action g (action g x) = x

/--
The modular-chiral trembling orbit generated by modular time and one supplied
involutive symmetry.
-/
@[rep_depth operator]
def modularChiralOrbit
    {Obs : Type*} [Ring Obs]
    (flow : ModularFlow Obs)
    (χ : InvolutiveSymmetry Obs)
    (x : Obs)
    (t : ℝ) : Obs :=
  flow.flow t (χ.action x)

/--
A modular V₄ orbit point.

This is the structural form of `x(t,g) = σ_t(g · x)`.
-/
@[rep_depth operator]
def modularV4Orbit
    {Obs : Type*} [Ring Obs]
    (flow : ModularFlow Obs)
    (V : KleinFourAction Obs)
    (x : Obs)
    (g : V.V4)
    (t : ℝ) : Obs :=
  flow.flow t (V.action g x)

/--
Drazin data for a modular-chiral frequency operator.

This is distinct from the signal Drazin support.  Here the projector
`1 - L * LD` is the harmonic / zero-frequency selector.
-/
@[rep_depth operator]
structure DrazinFrequencyData
    (Obs : Type*) [Ring Obs] [Star Obs] where
  L : Obs
  LD : Obs
  harmonicProj : Obs
  index : ℕ
  hDrazin : IsDrazinInverse L LD index
  harmonicProj_def : harmonicProj = 1 - L * LD
  harmonic_self_adjoint : star harmonicProj = harmonicProj

namespace DrazinFrequencyData

variable {Obs : Type*} [Ring Obs] [Star Obs]
variable (F : DrazinFrequencyData Obs)

/-- The harmonic / zero-frequency projector is idempotent. -/
@[rep_depth operator]
theorem harmonic_idempotent :
    F.harmonicProj * F.harmonicProj = F.harmonicProj := by
  rw [F.harmonicProj_def]
  simpa [IsDrazinInverse.complementaryProjection, IsDrazinInverse.projection] using
    IsDrazinInverse.complementaryProjection_is_idempotent F.hDrazin

end DrazinFrequencyData

/--
A horizon harmonic mode is localized on the Drazin horizon, selected by the
frequency harmonic projector on both sides, and fixed by the modular flow.
-/
@[rep_depth operator]
def IsHorizonHarmonicMode
    {Obs : Type*} [Ring Obs] [Star Obs]
    (flow : ModularFlow Obs)
    (H : DrazinHorizon Obs)
    (F : DrazinFrequencyData Obs)
    (x : Obs) : Prop :=
  H.p * x * H.p = x ∧
  F.harmonicProj * x * F.harmonicProj = x ∧
  IsModularZeroMode flow x

/--
Envelope extraction formula.

The raw observable may tremble under modular-chiral transport.  The physical
envelope is required to be the double-sided harmonic projection of the
Drazin-compressed raw observable:

`envelope = P_harm * (p * raw * p) * P_harm`.

This is a definition-level link between the raw orbit and the certified
envelope; it is not a proof that arbitrary raw observables have such envelopes.
-/
@[rep_depth operator]
def HorizonEnvelopeFormula
    {Obs : Type*} [Ring Obs]
    (p : Obs)
    (P_harm : Obs)
    (raw envelope : Obs) : Prop :=
  envelope = P_harm * (p * raw * p) * P_harm

/--
A horizon zitter mode.

The raw observable is allowed to tremble under modular-chiral flow.  The
physical readout is its supplied envelope, explicitly extracted as the harmonic
double compression of the Drazin-compressed raw observable and certified as a
harmonic zero mode localized on the Drazin horizon.
-/
@[rep_depth operator]
structure HorizonZitterMode
    (Obs : Type*) [Ring Obs] [Star Obs] where
  flow : ModularFlow Obs
  horizon : DrazinHorizon Obs
  frequency : DrazinFrequencyData Obs
  chirality : InvolutiveSymmetry Obs
  raw : Obs
  envelope : Obs
  horizon_fixed : IsPhysicalHorizon flow horizon
  envelope_formula :
    HorizonEnvelopeFormula
      horizon.p
      frequency.harmonicProj
      raw
      envelope
  envelope_is_harmonic :
    IsHorizonHarmonicMode flow horizon frequency envelope

/--
A horizon zitter mode with an explicit V₄-style symmetry action.

The same safety boundary applies: the raw observable may move around the
discrete-modular orbit, while the supplied envelope is explicitly extracted
by double-sided harmonic compression from the Drazin-compressed raw observable
and certified as the physical harmonic zero mode on the Drazin horizon.
-/
@[rep_depth operator]
structure HorizonV4ZitterMode
    (Obs : Type*) [Ring Obs] [Star Obs] where
  flow : ModularFlow Obs
  horizon : DrazinHorizon Obs
  frequency : DrazinFrequencyData Obs
  V4 : KleinFourAction Obs
  raw : Obs
  envelope : Obs
  horizon_fixed : IsPhysicalHorizon flow horizon
  envelope_formula :
    HorizonEnvelopeFormula
      horizon.p
      frequency.harmonicProj
      raw
      envelope
  envelope_is_harmonic :
    IsHorizonHarmonicMode flow horizon frequency envelope

namespace HorizonZitterMode

variable {Obs : Type*}
variable [Ring Obs] [Star Obs]
variable (Z : HorizonZitterMode Obs)

/-- The raw modular-chiral trembling orbit attached to a horizon zitter mode. -/
@[rep_depth operator]
def orbit (t : ℝ) : Obs :=
  modularChiralOrbit Z.flow Z.chirality Z.raw t

/-- Certificate readout: the envelope is localized on the Drazin horizon. -/
@[rep_depth operator]
theorem envelope_horizon_localized :
    Z.horizon.p * Z.envelope * Z.horizon.p = Z.envelope :=
  Z.envelope_is_harmonic.1

/-- Certificate readout: the envelope is selected by the frequency harmonic projector. -/
@[rep_depth operator]
theorem envelope_harmonic_projected :
    Z.frequency.harmonicProj * Z.envelope * Z.frequency.harmonicProj = Z.envelope :=
  Z.envelope_is_harmonic.2.1

/-- Certificate readout: the envelope is a modular zero mode. -/
@[rep_depth operator]
theorem envelope_modular_zero :
    IsModularZeroMode Z.flow Z.envelope :=
  Z.envelope_is_harmonic.2.2

/-- Certificate readout: the Drazin horizon of a horizon zitter mode is modularly fixed. -/
@[rep_depth operator]
theorem horizon_is_physical :
    IsPhysicalHorizon Z.flow Z.horizon :=
  Z.horizon_fixed

/-- Certificate readout: the envelope is linked to the raw trembling observable. -/
@[rep_depth operator]
theorem envelope_extraction_formula :
    HorizonEnvelopeFormula
      Z.horizon.p
      Z.frequency.harmonicProj
      Z.raw
      Z.envelope :=
  Z.envelope_formula

end HorizonZitterMode

namespace HorizonV4ZitterMode

variable {Obs : Type*}
variable [Ring Obs] [Star Obs]
variable (Z : HorizonV4ZitterMode Obs)

/-- The raw modular-V₄ trembling orbit attached to a horizon V₄ zitter mode. -/
@[rep_depth operator]
def orbit (g : Z.V4.V4) (t : ℝ) : Obs :=
  modularV4Orbit Z.flow Z.V4 Z.raw g t

/-- Certificate readout: the envelope is localized on the Drazin horizon. -/
@[rep_depth operator]
theorem envelope_horizon_localized :
    Z.horizon.p * Z.envelope * Z.horizon.p = Z.envelope :=
  Z.envelope_is_harmonic.1

/-- Certificate readout: the envelope is selected by the frequency harmonic projector. -/
@[rep_depth operator]
theorem envelope_harmonic_projected :
    Z.frequency.harmonicProj * Z.envelope * Z.frequency.harmonicProj = Z.envelope :=
  Z.envelope_is_harmonic.2.1

/-- Certificate readout: the envelope is a modular zero mode. -/
@[rep_depth operator]
theorem envelope_modular_zero :
    IsModularZeroMode Z.flow Z.envelope :=
  Z.envelope_is_harmonic.2.2

/-- Certificate readout: the Drazin horizon of a horizon V₄ zitter mode is modularly fixed. -/
@[rep_depth operator]
theorem horizon_is_physical :
    IsPhysicalHorizon Z.flow Z.horizon :=
  Z.horizon_fixed

/-- Certificate readout: the envelope is linked to the raw V₄ trembling observable. -/
@[rep_depth operator]
theorem envelope_extraction_formula :
    HorizonEnvelopeFormula
      Z.horizon.p
      Z.frequency.harmonicProj
      Z.raw
      Z.envelope :=
  Z.envelope_formula

end HorizonV4ZitterMode

/--
The apex algebra of the chiral causal cone, represented theorem-safely as a
predicate on observables.

The intended readback is the joint sector that is Drazin-supported, modular
zero-frequency, chiral/CPT balanced, and harmonic.
-/
@[rep_depth operator]
structure ChiralCausalApex
    (Obs : Type*) [Ring Obs] [Star Obs] where
  flow : ModularFlow Obs
  horizon : DrazinHorizon Obs
  frequency : DrazinFrequencyData Obs
  chirality : InvolutiveSymmetry Obs
  Apex : Obs → Prop
  apex_supported :
    ∀ x : Obs, Apex x → horizon.p * x * horizon.p = x
  apex_modular_zero :
    ∀ x : Obs, Apex x → IsModularZeroMode flow x
  apex_harmonic :
    ∀ x : Obs, Apex x → frequency.harmonicProj * x * frequency.harmonicProj = x
  apex_chiral_balanced :
    ∀ x : Obs, Apex x → chirality.action x = x

end InfoGeometry.Canonical.HorizonZitterModes
