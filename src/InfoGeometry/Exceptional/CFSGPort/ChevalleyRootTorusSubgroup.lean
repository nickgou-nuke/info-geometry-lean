module

public import InfoGeometry.Exceptional.CFSGPort.ChevalleyRootGroupsTorus
public import InfoGeometry.Exceptional.CFSGPort.ChevalleyRootGroups
import Mathlib.GroupTheory.Subgroup.Centralizer

public section

namespace InfoGeometry.Exceptional.CFSGPort.Chevalley

universe u

variable (τ : Tag) (R : Type u) [CommRing R]

/-- The root-module operator subgroup generated by the simple coroot torus
operators. Its elements act on every root and Cartan basis vector in the
actual pinned root-module representation. -/
@[expose] noncomputable def rootTorusSubgroup : Subgroup (Module.End R (RootModule τ R))ˣ :=
  Subgroup.closure (Set.range fun it : Fin τ.rank × Rˣ => torusElt τ R it.1 it.2)

theorem torusElt_commute (i j : Fin τ.rank) (s t : Rˣ) :
    Commute (torusElt τ R i s) (torusElt τ R j t) := by
  apply Units.ext
  refine Finsupp.lhom_ext' fun b => LinearMap.ext_ring (Finsupp.ext fun a => ?_)
  change (torusElt τ R i s : Module.End R (RootModule τ R))
      ((torusElt τ R j t : Module.End R (RootModule τ R)) (Finsupp.single b 1)) a =
    (torusElt τ R j t : Module.End R (RootModule τ R))
      ((torusElt τ R i s : Module.End R (RootModule τ R)) (Finsupp.single b 1)) a
  rw [torusElt_apply_eq, torusElt_apply_eq, torusElt_apply_eq, torusElt_apply_eq]
  ring

theorem rootTorusSubgroup_isMulCommutative :
    IsMulCommutative (rootTorusSubgroup τ R) := by
  apply Subgroup.isMulCommutative_closure
  intro x hx y hy _
  obtain ⟨⟨i, s⟩, rfl⟩ := Set.mem_range.mp hx
  obtain ⟨⟨j, t⟩, rfl⟩ := Set.mem_range.mp hy
  exact torusElt_commute τ R i j s t

/-- The concrete root torus lies in the adjoint group generated by the local
root operators. -/
theorem rootTorusSubgroup_le_adjointGroup {K : Type u} [Field K] :
    rootTorusSubgroup τ K ≤ adjointGroup τ K := by
  apply (Subgroup.closure_le _).2
  rintro _ ⟨⟨i, t⟩, rfl⟩
  exact torusElt_mem_adjointGroup i t

end InfoGeometry.Exceptional.CFSGPort.Chevalley
