/-!
# Type III Lambda Core

Conservative Connes-scale classification surface for the discrete modular
spectrum lane.

This file provides coordinate-free modular scale bookkeeping. 
Finite-dimensional scalar diagonal matrices are NOT allowed.
-/

namespace InfoGeometry.Canonical.TypeIIILambdaCore

open InfoGeometry.Canonical.DiscreteModularSpectrum

/-- Additive log-scale group used for Connes-style modular scale bookkeeping. -/
@[rep_depth transport]
structure TypeIIIScaleGroup where
  G : Set ℝ
  zero_mem : 0 ∈ G
  add_closed : ∀ {a b : ℝ}, a ∈ G → b ∈ G → a + b ∈ G
  neg_closed : ∀ {a : ℝ}, a ∈ G → -a ∈ G

namespace TypeIIIScaleGroup

/-- Integer-period subgroup generated by `T`. -/
@[rep_depth transport]
def integerPeriodSet (T : ℝ) : Set ℝ :=
  { t | ∃ k : ℤ, t = (k : ℝ) * T }

/-- The integer multiples of any period form an additive log-scale group. -/
@[rep_depth transport]
def integerPeriod (T : ℝ) : TypeIIIScaleGroup where
  G := integerPeriodSet T
  zero_mem := ⟨0, by simp⟩
  add_closed := by
    rintro a b ⟨k, rfl⟩ ⟨m, rfl⟩
    refine ⟨k + m, ?_⟩
    push_cast; ring
  neg_closed := by
    rintro a ⟨k, rfl⟩
    refine ⟨-k, ?_⟩
    push_cast; ring

@[rep_depth transport, simp]
theorem integerPeriod_mem_iff (T t : ℝ) :
    t ∈ (integerPeriod T).G ↔ ∃ k : ℤ, t = (k : ℝ) * T :=
  Iff.rfl

end TypeIIIScaleGroup

/--
Type `III_λ` discrete scale data with `q > 1`.
The period is `log q`.
-/
@[rep_depth transport]
structure DiscreteTypeIIILambdaScale extends TypeIIIScaleGroup where
  q : ℝ
  hq : 1 < q
  period_eq_log_q : (TypeIIIScaleGroup.integerPeriod (Real.log q)).G = G

namespace DiscreteTypeIIILambdaScale

/-- Canonical Type `III_λ` scale generated by `q > 1`. -/
@[rep_depth transport]
def ofQ (q : ℝ) (hq : 1 < q) : DiscreteTypeIIILambdaScale where
  toTypeIIIScaleGroup := TypeIIIScaleGroup.integerPeriod (Real.log q)
  q := q
  hq := hq
  period_eq_log_q := rfl

/-- The Connes lambda parameter associated to `q`; here `λ = q⁻¹`. -/
@[rep_depth transport]
noncomputable def lambda (S : DiscreteTypeIIILambdaScale) : ℝ :=
  S.q⁻¹

/-- Every integer multiple of the fundamental period belongs to the scale group. -/
@[rep_depth transport]
theorem int_mul_log_q_mem (S : DiscreteTypeIIILambdaScale) (k : ℤ) :
    (k : ℝ) * Real.log S.q ∈ S.G := by
  rw [← S.period_eq_log_q]
  exact ⟨k, rfl⟩

end DiscreteTypeIIILambdaScale

section LambdaLattice

/--
Proof-carrying Type `III_λ` modular lattice.
Coordinate-free and strictly operator-first.
-/
@[rep_depth operator]
structure ModularLambdaLattice (E : Type 0) [NormedAddCommGroup E] 
    [InnerProductSpace ℝ E] [CompleteSpace E] (CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)) where
  scale : DiscreteTypeIIILambdaScale
  lattice : ModularMellinLattice E CIK
  q_eq : lattice.q = scale.q
  /--
  Spectral restriction gate: any certified eigenvalue/readout of the modular
  Hamiltonian lies in the Type `III_λ` log-scale group.
  -/
  spectralReadoutInScale : ∀ eval : ℝ, eval ∈ scale.G

namespace ModularLambdaLattice

variable {E : Type 0} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)}
variable (L : ModularLambdaLattice E CIK)

/-- Lattice thermal-time samples are integer multiples of the Type `III_λ` period. -/
@[rep_depth transport, capstone]
theorem thermalTimeStep_mem_scale (k : ℤ) :
    L.lattice.thermalTimeStep k ∈ L.scale.G := by
  unfold ModularMellinLattice.thermalTimeStep
  have hlog : Real.log L.lattice.q = Real.log L.scale.q := by
    exact congrArg Real.log L.q_eq
  rw [hlog]
  exact L.scale.int_mul_log_q_mem k

/-- The Drazin projector is invariant under discrete boosts on the lambda lattice. -/
@[rep_depth operator]
theorem drazin_projector_invariant (k : ℤ) :
    L.lattice.discreteBoost k (CertifiedInverseKernel.spectralProjector (E := InfoGeometry.Krein.DoubledSpace E) CIK) = 
      CertifiedInverseKernel.spectralProjector (E := InfoGeometry.Krein.DoubledSpace E) CIK :=
  L.lattice.drazin_projector_invariant k

end ModularLambdaLattice

section SuperMellin

/--
Mellin shift operator on a Type `III_λ` modular lattice.
Coordinate-free algebraic interface.
-/
@[rep_depth operator]
structure MellinShift (E : Type 0) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)} (L : ModularLambdaLattice E CIK) where
  shiftOperator : (InfoGeometry.Krein.DoubledSpace E →L[ℝ] InfoGeometry.Krein.DoubledSpace E)
  shiftInverse : (InfoGeometry.Krein.DoubledSpace E →L[ℝ] InfoGeometry.Krein.DoubledSpace E)
  shift_left_inv : shiftInverse * shiftOperator = ContinuousLinearMap.id ℝ (InfoGeometry.Krein.DoubledSpace E)
  shift_right_inv : shiftOperator * shiftInverse = ContinuousLinearMap.id ℝ (InfoGeometry.Krein.DoubledSpace E)
  weyl_covariance :
    shiftOperator * L.lattice.K0 * shiftInverse =
      (L.scale.q⁻¹) • L.lattice.K0

/--
Supercharge interface over a Type `III_λ` modular lattice.
Coordinate-free root algebra.
-/
@[rep_depth operator]
structure MellinSupercharge (E : Type 0) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)} (L : ModularLambdaLattice E CIK) where
  Q : (InfoGeometry.Krein.DoubledSpace E →L[ℝ] InfoGeometry.Krein.DoubledSpace E)
  nilpotent : Q * Q = 0
  halfWeight : ℝ
  modular_weight :
    L.lattice.K0 * Q - Q * L.lattice.K0 = halfWeight • Q

/--
Operatorial central extension of the Super-Mellin algebra.
Strictly coordinate-free.
-/
@[rep_depth operator]
structure SuperMellinAlgebra (E : Type 0) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] 
    {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)} (L : ModularLambdaLattice E CIK) where
  shift : MellinShift E L
  supercharge : MellinSupercharge E L
  centralOperator : (InfoGeometry.Krein.DoubledSpace E →L[ℝ] InfoGeometry.Krein.DoubledSpace E)
  central_isDrazinLaneCentral :
    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.IsDrazinLaneCentralK
      CIK centralOperator
  central_isDefectSupported :
    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.IsDefectSupportedK
      CIK centralOperator
  supercharge_mem_chiralCone :
    InfoGeometry.Canonical.ChiralOperatorConeClosure.IsInChiralOperatorCone
      CIK supercharge.Q
  superHamiltonian_split :
    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.superHamiltonianK (E := InfoGeometry.Krein.DoubledSpace E) CIK =
      L.lattice.K0 + centralOperator
  shift_supercharge_commutator :
    shift.shiftOperator * supercharge.Q * shift.shiftInverse - supercharge.Q =
      centralOperator * supercharge.Q

namespace SuperMellinAlgebra

variable {E : Type 0} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {CIK : CertifiedInverseKernel (InfoGeometry.Krein.DoubledSpace E)}
variable {L : ModularLambdaLattice E CIK}
variable (A : SuperMellinAlgebra E L)

local notation "H₂_loc" => InfoGeometry.Krein.DoubledSpace E
local notation "EndH_loc" => H₂_loc →L[ℝ] H₂_loc

noncomputable local instance : NormedRing EndH_loc := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH_loc := inferInstance
local instance : IsTopologicalRing EndH_loc := inferInstance
local instance : CompleteSpace EndH_loc := inferInstance

/-- The operator-valued central channel is central on the Drazin lane. -/
@[rep_depth krein]
theorem centralOperator_isDrazinLaneCentral :
    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.IsDrazinLaneCentralK
      CIK A.centralOperator :=
  A.central_isDrazinLaneCentral

/-- The operator-valued central channel is supported on the defect block. -/
@[rep_depth krein]
theorem centralOperator_isDefectSupported :
    InfoGeometry.Canonical.DrazinSupercharge.CertifiedInverseKernel.IsDefectSupportedK
      CIK A.centralOperator :=
  A.central_isDefectSupported

/-- The Super-Mellin root lies in the repo-owned spectral chiral cone. -/
@[rep_depth krein]
theorem supercharge_in_chiralCone :
    InfoGeometry.Canonical.ChiralOperatorConeClosure.IsInChiralOperatorCone
      CIK A.supercharge.Q :=
  A.supercharge_mem_chiralCone

/-- The Super-Mellin commutator lands through the operator-valued central action. -/
@[rep_depth krein]
theorem shift_supercharge_commutator_eq_central_action :
    A.shift.shiftOperator * A.supercharge.Q * A.shift.shiftInverse - A.supercharge.Q =
      A.centralOperator * A.supercharge.Q :=
  A.shift_supercharge_commutator

end SuperMellinAlgebra

end SuperMellin

end LambdaLattice

end InfoGeometry.Canonical.TypeIIILambdaCore
