import InfoGeometry.Canonical.Cl55WittFiveGradeDecomposition
import Mathlib.Algebra.Lie.Subalgebra

/-!
# The Lie span of the finite Witt generators

This owner records the associative-matrix Lie span generated by the five-stage
creation and annihilation packets.  It deliberately does not identify that
span with `wittFiveGrade`: that identification requires the complete bracket
routing table and is a separate theorem.
-/

noncomputable section
set_option autoImplicit false

namespace InfoGeometry.Canonical.Cl55WittLieRouting

open InfoGeometry.Clifford.Cl11TensorTower
open InfoGeometry.Canonical.Cl55WittCAR

def wittLieGenerators : Set (MatStage 5) :=
  Set.range creation ∪ Set.range annihilation

def wittGeneratorLieSpan : LieSubalgebra ℝ (MatStage 5) :=
  LieSubalgebra.lieSpan ℝ (MatStage 5) wittLieGenerators

lemma creation_mem_wittGeneratorLieSpan (i : Fin 5) :
    creation i ∈ wittGeneratorLieSpan := by
  exact LieSubalgebra.subset_lieSpan (Or.inl ⟨i, rfl⟩)

lemma annihilation_mem_wittGeneratorLieSpan (i : Fin 5) :
    annihilation i ∈ wittGeneratorLieSpan := by
  exact LieSubalgebra.subset_lieSpan (Or.inr ⟨i, rfl⟩)

lemma creation_quadratic_mem_wittGeneratorLieSpan (i j : Fin 5) :
    creation i * creation j ∈ wittGeneratorLieSpan := by
  have h := wittGeneratorLieSpan.lie_mem
    (creation_mem_wittGeneratorLieSpan i)
    (creation_mem_wittGeneratorLieSpan j)
  change bracket (creation i) (creation j) ∈ wittGeneratorLieSpan at h
  rw [creation_bracket_real] at h
  have h' := wittGeneratorLieSpan.smul_mem (1 / 2 : ℝ) h
  simpa [smul_smul] using h'

lemma annihilation_quadratic_mem_wittGeneratorLieSpan (i j : Fin 5) :
    annihilation i * annihilation j ∈ wittGeneratorLieSpan := by
  have h := wittGeneratorLieSpan.lie_mem
    (annihilation_mem_wittGeneratorLieSpan i)
    (annihilation_mem_wittGeneratorLieSpan j)
  change bracket (annihilation i) (annihilation j) ∈ wittGeneratorLieSpan at h
  rw [annihilation_bracket_real] at h
  have h' := wittGeneratorLieSpan.smul_mem (1 / 2 : ℝ) h
  simpa [smul_smul] using h'

lemma E_mem_wittGeneratorLieSpan (i j : Fin 5) :
    E i j ∈ wittGeneratorLieSpan := by
  have h := wittGeneratorLieSpan.lie_mem
    (creation_mem_wittGeneratorLieSpan i)
    (annihilation_mem_wittGeneratorLieSpan j)
  change bracket (creation i) (annihilation j) ∈ wittGeneratorLieSpan at h
  rw [creation_annihilation_bracket_real] at h
  have h' := wittGeneratorLieSpan.smul_mem (1 / 2 : ℝ) h
  simpa [smul_smul] using h'

theorem wittPosOne_le_wittGeneratorLieSpan :
    wittPosOne ≤ (wittGeneratorLieSpan : Submodule ℝ (MatStage 5)) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  exact creation_mem_wittGeneratorLieSpan i

theorem wittNegOne_le_wittGeneratorLieSpan :
    wittNegOne ≤ (wittGeneratorLieSpan : Submodule ℝ (MatStage 5)) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  exact annihilation_mem_wittGeneratorLieSpan i

theorem wittZero_le_wittGeneratorLieSpan :
    wittZero ≤ (wittGeneratorLieSpan : Submodule ℝ (MatStage 5)) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨⟨i, j⟩, rfl⟩
  exact E_mem_wittGeneratorLieSpan i j

theorem wittPosTwo_le_wittGeneratorLieSpan :
    wittPosTwo ≤ (wittGeneratorLieSpan : Submodule ℝ (MatStage 5)) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨⟨i, j⟩, rfl⟩
  exact creation_quadratic_mem_wittGeneratorLieSpan i j

theorem wittNegTwo_le_wittGeneratorLieSpan :
    wittNegTwo ≤ (wittGeneratorLieSpan : Submodule ℝ (MatStage 5)) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨⟨i, j⟩, rfl⟩
  exact annihilation_quadratic_mem_wittGeneratorLieSpan i j

end InfoGeometry.Canonical.Cl55WittLieRouting
