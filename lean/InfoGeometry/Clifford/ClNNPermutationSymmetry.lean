import InfoGeometry.Clifford.ClNNNeutralChevalleyBridge
import InfoGeometry.Clifford.ClNNFockRepresentation
import InfoGeometry.Clifford.FockSpaceCAR
import Mathlib.Analysis.Convex.Birkhoff

/-!
# Finite permutation symmetries of the symmetric split Clifford tower

Coordinate permutations act simultaneously on the primal and dual modes of
the neutral phase-space carrier. This preserves the evaluation quadratic form,
so Mathlib's Clifford functor lifts each such isometry to an algebra
equivalence. The subgroup generated by these equivalences is the finite-stage
permutation symmetry closure of the split Clifford algebra.

This owner also constructs the induced exterior-Fock automorphisms and proves
their covariance with creation and CAR annihilation. Full intertwining with
the split Clifford representation and compatibility with the Cantor/colimit
inclusions remain separate results.
-/

noncomputable section

namespace InfoGeometry.Clifford.ClNNPermutationSymmetry

open InfoGeometry.Clifford.ClNNNeutralChevalleyBridge
open InfoGeometry.Clifford.ClNNFockRepresentation
open InfoGeometry.Clifford.FockSpaceCAR
open InfoGeometry.Clifford.NeutralPhaseSpaceCore
open Matrix
open scoped BigOperators

variable (n : ℕ)

/-- The action of a mode permutation on coordinate vectors, by pullback along
the inverse permutation. -/
def modePermutationLinearEquiv (σ : Equiv.Perm (Fin n)) :
    Vector n ≃ₗ[ℝ] Vector n where
  toFun x i := x (σ.symm i)
  invFun x i := x (σ i)
  left_inv x := by
    funext i
    simp
  right_inv x := by
    funext i
    simp
  map_add' x y := by
    funext i
    rfl
  map_smul' c x := by
    funext i
    rfl

/-- The corresponding action on the neutral mode/covector carrier. -/
def neutralModePermutation (σ : Equiv.Perm (Fin n)) :
    Neutral n ≃ₗ[ℝ] Neutral n :=
  LinearEquiv.prodCongr (modePermutationLinearEquiv n σ)
    (modePermutationLinearEquiv n σ).dualMap.symm

/-- Simultaneous primal and dual permutation preserves the neutral evaluation
quadratic form. -/
theorem neutralModePermutation_preservesForm (σ : Equiv.Perm (Fin n))
    (X : Neutral n) :
    canonicalNeutralFormUnscaled (E := Vector n)
        (neutralModePermutation n σ X) =
      canonicalNeutralFormUnscaled (E := Vector n) X := by
  rcases X with ⟨x, φ⟩
  simp [neutralModePermutation, canonicalNeutralFormUnscaled_apply,
    LinearEquiv.dualMap_symm, LinearEquiv.dualMap_apply]

/-- Transport the mode permutation to the recursive symmetric split
coordinates used by the `Cl(n,n)` tower. -/
def splitModePermutation (σ : Equiv.Perm (Fin n)) :
    TowerSpace n ≃ₗ[ℝ] TowerSpace n :=
  (neutralToSplit n).symm.trans
    ((neutralModePermutation n σ).trans (neutralToSplit n))

/-- The transported action preserves the recursive symmetric split
quadratic form. -/
theorem splitModePermutation_preservesForm (σ : Equiv.Perm (Fin n))
    (x : TowerSpace n) :
    TowerForm n (splitModePermutation n σ x) = TowerForm n x := by
  change TowerForm n (neutralToSplit n
    (neutralModePermutation n σ ((neutralToSplit n).symm x))) = TowerForm n x
  rw [Qsplit_neutralToSplit_chevalley]
  conv_rhs => rw [← (neutralToSplit n).apply_symm_apply x]
  rw [Qsplit_neutralToSplit_chevalley]
  rw [chevelleyQsplit_eq_neutralForm]
  exact neutralModePermutation_preservesForm n σ ((neutralToSplit n).symm x)

/-- The finite mode-permutation action as an isometry of the symmetric split
quadratic space. -/
def splitModePermutationIsometry (σ : Equiv.Perm (Fin n)) :
    (TowerForm n).IsometryEquiv (TowerForm n) where
  __ := splitModePermutation n σ
  map_app' := splitModePermutation_preservesForm n σ

/-- The Clifford-algebra automorphism induced by a finite mode permutation. -/
def splitCliffordPermutationEquiv (σ : Equiv.Perm (Fin n)) :
    CliffordAlgebra (TowerForm n) ≃ₐ[ℝ] CliffordAlgebra (TowerForm n) :=
  CliffordAlgebra.equivOfIsometry (splitModePermutationIsometry n σ)

/-- The subgroup of split Clifford-algebra automorphisms generated by all
finite coordinate permutations. -/
def permutationSymmetryClosure :
    Subgroup (CliffordAlgebra (TowerForm n) ≃ₐ[ℝ] CliffordAlgebra (TowerForm n)) :=
  Subgroup.closure (Set.range (splitCliffordPermutationEquiv n))

/-- Every coordinate-permutation Clifford automorphism belongs to the
generated symmetry closure. -/
theorem splitCliffordPermutationEquiv_mem_closure (σ : Equiv.Perm (Fin n)) :
    splitCliffordPermutationEquiv n σ ∈ permutationSymmetryClosure n :=
  Subgroup.subset_closure ⟨σ, rfl⟩

/-- The linear average of Clifford algebra automorphisms selected by weights
on the finite permutation group. -/
noncomputable def randomPermutationCliffordAverage (w : Equiv.Perm (Fin n) → ℝ) :
    Module.End ℝ (CliffordAlgebra (TowerForm n)) :=
  ∑ σ : Equiv.Perm (Fin n),
    w σ • (splitCliffordPermutationEquiv n σ).toLinearMap

/-- A probability-weighted permutation average is unital. -/
theorem randomPermutationCliffordAverage_one
    (w : Equiv.Perm (Fin n) → ℝ) (hw : ∑ σ, w σ = 1) :
    randomPermutationCliffordAverage n w 1 = 1 := by
  classical
  simp only [randomPermutationCliffordAverage, LinearMap.sum_apply,
    LinearMap.smul_apply, AlgEquiv.toLinearMap_apply, map_one]
  calc
    (∑ σ : Equiv.Perm (Fin n), w σ • (1 : CliffordAlgebra (TowerForm n))) =
        (∑ σ : Equiv.Perm (Fin n), w σ) • (1 : CliffordAlgebra (TowerForm n)) :=
      (Finset.sum_smul).symm
    _ = 1 := by rw [hw]; simp

/-- The randomized symmetry acts on Clifford generators by the same weighted
sum of the genuine mode permutations. This identifies the channel's action
inside the noncommutative Clifford algebra, rather than treating the scalar
transition matrix as the operator carrier. -/
theorem randomPermutationCliffordAverage_generator
    (w : Equiv.Perm (Fin n) → ℝ) (x : TowerSpace n) :
    randomPermutationCliffordAverage n w
        (CliffordAlgebra.ι (TowerForm n) x) =
      ∑ σ : Equiv.Perm (Fin n),
        w σ • CliffordAlgebra.ι (TowerForm n) (splitModePermutation n σ x) := by
  classical
  simp only [randomPermutationCliffordAverage, LinearMap.sum_apply,
    LinearMap.smul_apply, AlgEquiv.toLinearMap_apply,
    splitCliffordPermutationEquiv, CliffordAlgebra.equivOfIsometry_apply,
    CliffordAlgebra.map_apply_ι]
  apply Finset.sum_congr rfl
  intro σ hσ
  congr 2

/-- The linear map from a primal mode to its generator in the split Clifford
algebra. -/
def primalCliffordGenerator :
    Vector n →ₗ[ℝ] CliffordAlgebra (TowerForm n) :=
  (CliffordAlgebra.ι (TowerForm n)).comp (neutralPrimalSheetMap n)

/-- If the inverse-indexed permutation matrices reconstruct `P`, their
weighted mode action on the primal carrier is exactly `P`. The inverse is
required by the pullback convention in `modePermutationLinearEquiv`. -/
theorem weightedModePermutation_eq_mulVec
    (w : Equiv.Perm (Fin n) → ℝ)
    (P : Matrix (Fin n) (Fin n) ℝ)
    (hw : ∑ σ : Equiv.Perm (Fin n), w σ • σ⁻¹.permMatrix ℝ = P)
    (x : Vector n) :
    (∑ σ : Equiv.Perm (Fin n), w σ • modePermutationLinearEquiv n σ x) =
      P *ᵥ x := by
  calc
    (∑ σ : Equiv.Perm (Fin n), w σ • modePermutationLinearEquiv n σ x) =
        (∑ σ : Equiv.Perm (Fin n),
          (w σ • σ⁻¹.permMatrix ℝ) *ᵥ x) := by
          apply Finset.sum_congr rfl
          intro σ hσ
          rw [show modePermutationLinearEquiv n σ x =
              σ⁻¹.permMatrix ℝ *ᵥ x by
              funext i
              simp [modePermutationLinearEquiv, Matrix.permMatrix_mulVec]]
          rw [Matrix.smul_mulVec]
    _ = (∑ σ : Equiv.Perm (Fin n),
          w σ • σ⁻¹.permMatrix ℝ) *ᵥ x := by
          symm
          exact Matrix.sum_mulVec Finset.univ
            (fun σ => w σ • σ⁻¹.permMatrix ℝ) x
    _ = P *ᵥ x := by rw [hw]

/-- On the actual primal Clifford generators, the weighted symmetry average
acts by the reconstructed transition matrix. The action is stated in the
Clifford algebra itself, so the coefficient matrix is not used as a surrogate
operator carrier. -/
theorem randomPermutationCliffordAverage_primalMatrixAction
    (w : Equiv.Perm (Fin n) → ℝ)
    (P : Matrix (Fin n) (Fin n) ℝ)
    (hw : ∑ σ : Equiv.Perm (Fin n), w σ • σ⁻¹.permMatrix ℝ = P)
    (x : Vector n) :
    randomPermutationCliffordAverage n w (primalCliffordGenerator n x) =
      primalCliffordGenerator n (P *ᵥ x) := by
  have hmode (σ : Equiv.Perm (Fin n)) :
      splitModePermutation n σ (neutralPrimalSheetMap n x) =
        neutralPrimalSheetMap n (modePermutationLinearEquiv n σ x) := by
    simp [splitModePermutation, neutralPrimalSheetMap, neutralModePermutation,
      modePermutationLinearEquiv]
  change randomPermutationCliffordAverage n w
    (CliffordAlgebra.ι (TowerForm n) (neutralPrimalSheetMap n x)) = _
  rw [randomPermutationCliffordAverage_generator]
  simp_rw [hmode]
  change (∑ σ : Equiv.Perm (Fin n),
      w σ • primalCliffordGenerator n (modePermutationLinearEquiv n σ x)) = _
  calc
    (∑ σ : Equiv.Perm (Fin n),
        w σ • primalCliffordGenerator n (modePermutationLinearEquiv n σ x)) =
        primalCliffordGenerator n
          (∑ σ : Equiv.Perm (Fin n),
            w σ • modePermutationLinearEquiv n σ x) := by
          simp only [map_sum, map_smul]
    _ = primalCliffordGenerator n (P *ᵥ x) := by
          rw [weightedModePermutation_eq_mulVec n w P hw x]

/-- Every finite doubly-stochastic transition matrix admits Birkhoff weights,
reindexed for the inverse-pullback convention, whose Clifford symmetry average
acts on all primal generators by that matrix. -/
theorem exists_randomPermutationCliffordAverage_primalMatrixAction
    (P : Matrix (Fin n) (Fin n) ℝ)
    (hP : P ∈ doublyStochastic ℝ (Fin n)) :
    ∃ w : Equiv.Perm (Fin n) → ℝ,
      (∀ σ, 0 ≤ w σ) ∧
      ∑ σ, w σ = 1 ∧
      ∀ x : Vector n,
        randomPermutationCliffordAverage n w (primalCliffordGenerator n x) =
          primalCliffordGenerator n (P *ᵥ x) := by
  rcases exists_eq_sum_perm_of_mem_doublyStochastic (M := P) hP with
    ⟨v, hv_nonneg, hv_sum, hv_matrix⟩
  let w : Equiv.Perm (Fin n) → ℝ := fun σ => v σ⁻¹
  have hw_nonneg : ∀ σ, 0 ≤ w σ := by
    intro σ
    exact hv_nonneg (σ⁻¹)
  have hw_sum : ∑ σ : Equiv.Perm (Fin n), w σ = 1 := by
    calc
      (∑ σ : Equiv.Perm (Fin n), w σ) =
          ∑ σ : Equiv.Perm (Fin n), v σ := by
            exact Fintype.sum_equiv (Equiv.inv _)
              (fun σ => v σ⁻¹) (fun σ => v σ) (by intro σ; simp)
      _ = 1 := hv_sum
  have hw_matrix :
      ∑ σ : Equiv.Perm (Fin n), w σ • σ⁻¹.permMatrix ℝ = P := by
    calc
      (∑ σ : Equiv.Perm (Fin n), w σ • σ⁻¹.permMatrix ℝ) =
          ∑ σ : Equiv.Perm (Fin n), v σ • σ.permMatrix ℝ := by
            exact Fintype.sum_equiv (Equiv.inv _)
              (fun σ => v σ⁻¹ • σ⁻¹.permMatrix ℝ)
              (fun σ => v σ • σ.permMatrix ℝ)
              (by intro σ; simp)
      _ = P := hv_matrix
  refine ⟨w, hw_nonneg, hw_sum, ?_⟩
  intro x
  exact randomPermutationCliffordAverage_primalMatrixAction n w P hw_matrix x

/-- The action on the Clifford algebra after two successive weighted
permutation steps. This remains an operator on the noncommutative Clifford
algebra; the indices record which symmetry was applied at each step. -/
noncomputable def sequentialRandomPermutationCliffordAverage
    (w v : Equiv.Perm (Fin n) → ℝ) :
    Module.End ℝ (CliffordAlgebra (TowerForm n)) :=
  ∑ τ : Equiv.Perm (Fin n), ∑ σ : Equiv.Perm (Fin n),
    (v τ * w σ) •
      ((splitCliffordPermutationEquiv n σ).toLinearMap.comp
        (splitCliffordPermutationEquiv n τ).toLinearMap)

/-- Sequential application of two finite Markov steps built from permutation
symmetries equals their operator average over ordered pairs of symmetries.
The theorem gives the composition law on the Clifford carrier without
asserting that a convex average itself is a symmetry-group element. -/
theorem randomPermutationCliffordAverage_comp
    (w v : Equiv.Perm (Fin n) → ℝ) :
    randomPermutationCliffordAverage n w * randomPermutationCliffordAverage n v =
      sequentialRandomPermutationCliffordAverage n w v := by
  classical
  ext x
  simp [sequentialRandomPermutationCliffordAverage,
    randomPermutationCliffordAverage, Module.End.mul_eq_comp,
    LinearMap.comp_apply, Finset.smul_sum, smul_smul]

/-- Birkhoff--von Neumann turns every finite bistochastic matrix into weights
whose randomized Clifford symmetry average is unital and whose permutation
matrices reconstruct the original transition matrix. -/
theorem exists_randomCliffordAverage_of_doublyStochastic
    (P : Matrix (Fin n) (Fin n) ℝ)
    (hP : P ∈ doublyStochastic ℝ (Fin n)) :
    ∃ w : Equiv.Perm (Fin n) → ℝ,
      (∀ σ, 0 ≤ w σ) ∧
      ∑ σ, w σ = 1 ∧
      ∑ σ, w σ • σ.permMatrix ℝ = P ∧
      randomPermutationCliffordAverage n w 1 = 1 := by
  rcases exists_eq_sum_perm_of_mem_doublyStochastic (M := P) hP with
    ⟨w, hw_nonneg, hw_sum, hw_matrix⟩
  exact ⟨w, hw_nonneg, hw_sum, hw_matrix,
    randomPermutationCliffordAverage_one n w hw_sum⟩

/-- The induced linear equivalence on the finite primal-sheet mode space. -/
def primalSheetModePermutation (σ : Equiv.Perm (Fin n)) :
    PrimalSheet n ≃ₗ[ℝ] PrimalSheet n :=
  (neutralPrimalSheetParametrization n).symm.trans
    ((modePermutationLinearEquiv n σ).trans
      (neutralPrimalSheetParametrization n))

/-- Exterior-algebra automorphism implementing a mode permutation on the
actual finite Fock carrier. -/
noncomputable def fockPermutationAlgHom (σ : Equiv.Perm (Fin n)) :
    FockSpace (PrimalSheet n) →ₐ[ℝ] FockSpace (PrimalSheet n) :=
  ExteriorAlgebra.map (primalSheetModePermutation n σ).toLinearMap

/-- An exterior-algebra map induced by a mode equivalence is bijective. -/
theorem fockPermutationAlgHom_bijective (σ : Equiv.Perm (Fin n)) :
    Function.Bijective (fockPermutationAlgHom n σ) := by
  constructor
  · change Function.Injective
      (ExteriorAlgebra.map (primalSheetModePermutation n σ).toLinearMap)
    apply ExteriorAlgebra.map_injective
    refine ⟨(primalSheetModePermutation n σ).symm.toLinearMap, ?_⟩
    ext x
    simp
  · change Function.Surjective
      (ExteriorAlgebra.map (primalSheetModePermutation n σ).toLinearMap)
    exact ExteriorAlgebra.map_surjective_iff.mpr
      (primalSheetModePermutation n σ).surjective

/-- The finite Fock-space algebra automorphism induced by a mode permutation. -/
noncomputable def fockPermutationAlgEquiv (σ : Equiv.Perm (Fin n)) :
    FockSpace (PrimalSheet n) ≃ₐ[ℝ] FockSpace (PrimalSheet n) :=
  AlgEquiv.ofBijective (fockPermutationAlgHom n σ)
    (fockPermutationAlgHom_bijective n σ)

@[simp] theorem fockPermutationAlgEquiv_apply_ι
    (σ : Equiv.Perm (Fin n)) (u : PrimalSheet n) :
    fockPermutationAlgEquiv n σ (ExteriorAlgebra.ι ℝ u) =
      ExteriorAlgebra.ι ℝ (primalSheetModePermutation n σ u) := by
  simp [fockPermutationAlgEquiv, fockPermutationAlgHom]

/-- The Fock-space symmetry intertwines creation with the permuted mode. -/
theorem fockPermutation_creation_intertwining
    (σ : Equiv.Perm (Fin n)) (u : PrimalSheet n)
    (ψ : FockSpace (PrimalSheet n)) :
    fockPermutationAlgEquiv n σ (sheetCreation n u ψ) =
      sheetCreation n (primalSheetModePermutation n σ u)
        (fockPermutationAlgEquiv n σ ψ) := by
  simp only [sheetCreation, creation_apply_ι_mul]
  rw [map_mul, fockPermutationAlgEquiv_apply_ι]

/-- The exterior-Fock permutation intertwines contraction when the covector
is transported by the dual mode equivalence. -/
theorem fockPermutation_contractLeft_intertwining
    (σ : Equiv.Perm (Fin n)) (α : Module.Dual ℝ (PrimalSheet n))
    (ψ : FockSpace (PrimalSheet n)) :
    fockPermutationAlgEquiv n σ (CliffordAlgebra.contractLeft α ψ) =
      CliffordAlgebra.contractLeft
        ((primalSheetModePermutation n σ).dualMap.symm α)
        (fockPermutationAlgEquiv n σ ψ) := by
  induction ψ using CliffordAlgebra.left_induction with
  | algebraMap r => simp [fockPermutationAlgEquiv, fockPermutationAlgHom]
  | add ψ χ hψ hχ => simp [hψ, hχ]
  | ι_mul ψ u hψ =>
      simp only [CliffordAlgebra.contractLeft_ι_mul, map_sub, map_smul,
        map_mul, fockPermutationAlgEquiv_apply_ι, hψ,
        CliffordAlgebra.contractLeft_ι_mul]
      congr 1
      have hdual := congrArg (fun β : Module.Dual ℝ (PrimalSheet n) => β u)
        ((primalSheetModePermutation n σ).dualMap.apply_symm_apply α)
      have hpair : α u =
          ((primalSheetModePermutation n σ).dualMap.symm α)
            (primalSheetModePermutation n σ u) := by
        simpa only [LinearEquiv.dualMap_apply] using hdual.symm
      exact congrArg (fun c : ℝ => c • fockPermutationAlgEquiv n σ ψ) hpair

/-- The subgroup of linear Fock-space symmetries generated by all finite mode
permutations. -/
def fockPermutationSymmetryClosure :
    Subgroup (FockSpace (PrimalSheet n) ≃ₗ[ℝ] FockSpace (PrimalSheet n)) :=
  Subgroup.closure (Set.range
    (fun σ : Equiv.Perm (Fin n) => (fockPermutationAlgEquiv n σ).toLinearEquiv))

/-- Every finite mode-permutation Fock symmetry lies in the generated closure. -/
theorem fockPermutationAlgEquiv_mem_closure (σ : Equiv.Perm (Fin n)) :
    (fockPermutationAlgEquiv n σ).toLinearEquiv ∈ fockPermutationSymmetryClosure n :=
  Subgroup.subset_closure ⟨σ, rfl⟩

/-- Conjugation by a finite Fock mode permutation, acting on the full
noncommutative endomorphism algebra of the split-Clifford Fock module. -/
noncomputable def fockOperatorPermutationEquiv (σ : Equiv.Perm (Fin n)) :
    Module.End ℝ (FockSpace (PrimalSheet n)) ≃ₐ[ℝ]
      Module.End ℝ (FockSpace (PrimalSheet n)) :=
  (fockPermutationAlgEquiv n σ).toLinearEquiv.conjAlgEquiv ℝ

/-- Conjugation by a finite mode permutation transports each creation
operator to the permuted primal mode. -/
theorem fockPermutation_conj_creation
    (σ : Equiv.Perm (Fin n)) (u : PrimalSheet n) :
    fockOperatorPermutationEquiv n σ (sheetCreation n u) =
      sheetCreation n (primalSheetModePermutation n σ u) := by
  ext ψ
  change fockPermutationAlgEquiv n σ
      (sheetCreation n u ((fockPermutationAlgEquiv n σ).symm ψ)) =
    sheetCreation n (primalSheetModePermutation n σ u) ψ
  exact (fockPermutation_creation_intertwining n σ u
    ((fockPermutationAlgEquiv n σ).symm ψ)).trans (by simp)

/-- Conjugation by a mode permutation sends the actual Fock annihilation
operator to the annihilation operator with the transported dual mode. -/
theorem fockPermutation_conj_annihilation
    (σ : Equiv.Perm (Fin n)) (α : Module.Dual ℝ (PrimalSheet n)) :
    fockOperatorPermutationEquiv n σ (annihilation α) =
      annihilation ((primalSheetModePermutation n σ).dualMap.symm α) := by
  ext ψ
  change fockPermutationAlgEquiv n σ
      (annihilation α ((fockPermutationAlgEquiv n σ).symm ψ)) =
    annihilation ((primalSheetModePermutation n σ).dualMap.symm α) ψ
  rw [annihilation_apply_contractLeft, annihilation_apply_contractLeft,
    fockPermutation_contractLeft_intertwining]
  simp

private theorem primalSheetModePermutation_param (σ : Equiv.Perm (Fin n))
    (u : Vector n) :
    primalSheetModePermutation n σ (neutralPrimalSheetParametrization n u) =
      neutralPrimalSheetParametrization n (modePermutationLinearEquiv n σ u) := by
  simp [primalSheetModePermutation, neutralPrimalSheetParametrization]

private theorem dualModePermutation_param (σ : Equiv.Perm (Fin n))
    (φ : Module.Dual ℝ (Vector n)) :
    (primalSheetModePermutation n σ).dualMap.symm
        (neutralVacuumSheetDualEquiv n (neutralVacuumSheetParametrization n φ)) =
      neutralVacuumSheetDualEquiv n
        (neutralVacuumSheetParametrization n
          ((modePermutationLinearEquiv n σ).dualMap.symm φ)) := by
  ext u
  simp [neutralVacuumSheetDualEquiv, neutralVacuumSheetParametrization,
    neutralPrimalSheetParametrization, primalSheetModePermutation,
    LinearEquiv.dualMap_apply]

/-- The Fock permutation automorphism intertwines the represented split
Clifford action on each neutral vector generator. -/
theorem fockOperatorPermutation_towerFockRep_neutralGenerator
    (σ : Equiv.Perm (Fin n)) (X : Neutral n) :
    fockOperatorPermutationEquiv n σ
        (towerFockRep n
          (CliffordAlgebra.ι (TowerForm n) (neutralToSplit n X))) =
      towerFockRep n
        (CliffordAlgebra.ι (TowerForm n)
          (neutralToSplit n (neutralModePermutation n σ X))) := by
  rcases X with ⟨u, φ⟩
  ext ψ
  change fockPermutationAlgEquiv n σ
      (towerFockRep n
        (CliffordAlgebra.ι (TowerForm n) (neutralToSplit n (u, φ)))
        ((fockPermutationAlgEquiv n σ).symm ψ)) =
    towerFockRep n
      (CliffordAlgebra.ι (TowerForm n)
        (neutralToSplit n (neutralModePermutation n σ (u, φ)))) ψ
  rw [towerFockRep_neutral_generator, towerFockRep_neutral_generator]
  simp only [map_add, fockPermutation_creation_intertwining]
  simp only [sheetAnnihilation, annihilation_apply_contractLeft,
    fockPermutation_contractLeft_intertwining]
  rw [primalSheetModePermutation_param, dualModePermutation_param]
  simp [neutralModePermutation]

/-- The generated subgroup of operator-algebra automorphisms induced by the
finite split-Clifford Fock mode symmetries. -/
def fockOperatorSymmetryClosure :
    Subgroup
      (Module.End ℝ (FockSpace (PrimalSheet n)) ≃ₐ[ℝ]
        Module.End ℝ (FockSpace (PrimalSheet n))) :=
  Subgroup.closure (Set.range (fockOperatorPermutationEquiv n))

/-- Every finite Fock mode permutation induces an element of the operator
symmetry closure. -/
theorem fockOperatorPermutationEquiv_mem_closure (σ : Equiv.Perm (Fin n)) :
    fockOperatorPermutationEquiv n σ ∈ fockOperatorSymmetryClosure n :=
  Subgroup.subset_closure ⟨σ, rfl⟩

/-- The finite Markov average of the actual Fock operator-algebra
automorphisms generated by mode permutations. The carrier is
`Module.End ℝ (Module.End ℝ (FockSpace (PrimalSheet n)))`; the average is a
linear channel, not asserted to be an algebra automorphism. -/
noncomputable def randomFockOperatorAverage
    (w : Equiv.Perm (Fin n) → ℝ) :
    Module.End ℝ (Module.End ℝ (FockSpace (PrimalSheet n))) :=
  ∑ σ : Equiv.Perm (Fin n),
    w σ • (fockOperatorPermutationEquiv n σ).toLinearMap

/-- The Birkhoff-weighted Fock operator channel acts on an actual CAR
annihilation operator by the weighted sum of its permuted modes. -/
theorem randomFockOperatorAverage_annihilation
    (w : Equiv.Perm (Fin n) → ℝ) (α : Module.Dual ℝ (PrimalSheet n)) :
    randomFockOperatorAverage n w (annihilation α) =
      ∑ σ : Equiv.Perm (Fin n),
        w σ • annihilation ((primalSheetModePermutation n σ).dualMap.symm α) := by
  classical
  simp [randomFockOperatorAverage, fockPermutation_conj_annihilation]

/-- Creation modes, embedded from the recursive primal vector carrier, as a
linear family of operators on the actual Fock module. -/
def primalSheetCreationOperator :
    Vector n →ₗ[ℝ] Module.End ℝ (FockSpace (PrimalSheet n)) :=
  (creationOperator (L := PrimalSheet n)).comp
    (neutralPrimalSheetParametrization n).toLinearMap

/-- The finite Markov average acts on each genuine Fock creation operator by
the corresponding weighted sum of permuted modes. -/
theorem randomFockOperatorAverage_creation
    (w : Equiv.Perm (Fin n) → ℝ) (u : PrimalSheet n) :
    randomFockOperatorAverage n w (sheetCreation n u) =
      ∑ σ : Equiv.Perm (Fin n),
        w σ • sheetCreation n (primalSheetModePermutation n σ u) := by
  classical
  simp [randomFockOperatorAverage, fockPermutation_conj_creation]

/-- On the represented primal creation operators, the Fock operator channel
reconstructs the input bistochastic transition matrix exactly. The channel
acts on `Module.End` of the Fock module; `P` records only the coefficients of
its action on the creation-mode family. -/
theorem randomFockOperatorAverage_primalCreationMatrixAction
    (w : Equiv.Perm (Fin n) → ℝ)
    (P : Matrix (Fin n) (Fin n) ℝ)
    (hw : ∑ σ : Equiv.Perm (Fin n), w σ • σ⁻¹.permMatrix ℝ = P)
    (x : Vector n) :
    randomFockOperatorAverage n w (primalSheetCreationOperator n x) =
      primalSheetCreationOperator n (P *ᵥ x) := by
  change randomFockOperatorAverage n w
      (sheetCreation n (neutralPrimalSheetParametrization n x)) = _
  rw [randomFockOperatorAverage_creation]
  simp_rw [primalSheetModePermutation_param]
  change (∑ σ : Equiv.Perm (Fin n),
      w σ • primalSheetCreationOperator n
        (modePermutationLinearEquiv n σ x)) =
    primalSheetCreationOperator n (P *ᵥ x)
  calc
    (∑ σ : Equiv.Perm (Fin n),
        w σ • primalSheetCreationOperator n
          (modePermutationLinearEquiv n σ x)) =
        primalSheetCreationOperator n
          (∑ σ : Equiv.Perm (Fin n),
            w σ • modePermutationLinearEquiv n σ x) := by
              simp only [map_sum, map_smul]
    _ = primalSheetCreationOperator n (P *ᵥ x) := by
          rw [weightedModePermutation_eq_mulVec n w P hw x]

/-- Every finite bistochastic matrix has Birkhoff weights whose Fock
operator-algebra Markov channel realizes that matrix on all primal creation
operators. -/
theorem exists_randomFockOperatorAverage_primalCreationMatrixAction
    (P : Matrix (Fin n) (Fin n) ℝ)
    (hP : P ∈ doublyStochastic ℝ (Fin n)) :
    ∃ w : Equiv.Perm (Fin n) → ℝ,
      (∀ σ, 0 ≤ w σ) ∧
      ∑ σ, w σ = 1 ∧
      ∑ σ, w σ • σ⁻¹.permMatrix ℝ = P ∧
      ∀ x : Vector n,
        randomFockOperatorAverage n w (primalSheetCreationOperator n x) =
          primalSheetCreationOperator n (P *ᵥ x) := by
  rcases exists_eq_sum_perm_of_mem_doublyStochastic (M := P) hP with
    ⟨v, hv_nonneg, hv_sum, hv_matrix⟩
  let w : Equiv.Perm (Fin n) → ℝ := fun σ => v σ⁻¹
  have hw_nonneg : ∀ σ, 0 ≤ w σ := by
    intro σ
    exact hv_nonneg (σ⁻¹)
  have hw_sum : ∑ σ : Equiv.Perm (Fin n), w σ = 1 := by
    calc
      (∑ σ : Equiv.Perm (Fin n), w σ) =
          ∑ σ : Equiv.Perm (Fin n), v σ := by
            exact Fintype.sum_equiv (Equiv.inv _)
              (fun σ => v σ⁻¹) (fun σ => v σ) (by intro σ; simp)
      _ = 1 := hv_sum
  have hw_matrix :
      ∑ σ : Equiv.Perm (Fin n), w σ • σ⁻¹.permMatrix ℝ = P := by
    calc
      (∑ σ : Equiv.Perm (Fin n), w σ • σ⁻¹.permMatrix ℝ) =
          ∑ σ : Equiv.Perm (Fin n), v σ • σ.permMatrix ℝ := by
            exact Fintype.sum_equiv (Equiv.inv _)
              (fun σ => v σ⁻¹ • σ⁻¹.permMatrix ℝ)
              (fun σ => v σ • σ.permMatrix ℝ)
              (by intro σ; simp)
      _ = P := hv_matrix
  refine ⟨w, hw_nonneg, hw_sum, hw_matrix, ?_⟩
  intro x
  exact randomFockOperatorAverage_primalCreationMatrixAction n w P hw_matrix x

/-- A normalized Fock operator-algebra Markov average fixes the identity
operator. -/
theorem randomFockOperatorAverage_one
    (w : Equiv.Perm (Fin n) → ℝ) (hw : ∑ σ, w σ = 1) :
    randomFockOperatorAverage n w (1 : Module.End ℝ (FockSpace (PrimalSheet n))) = 1 := by
  classical
  simp only [randomFockOperatorAverage, LinearMap.sum_apply,
    LinearMap.smul_apply, AlgEquiv.toLinearMap_apply, map_one]
  calc
    (∑ σ : Equiv.Perm (Fin n), w σ •
        (1 : Module.End ℝ (FockSpace (PrimalSheet n)))) =
        (∑ σ : Equiv.Perm (Fin n), w σ) •
          (1 : Module.End ℝ (FockSpace (PrimalSheet n))) :=
      (Finset.sum_smul).symm
    _ = 1 := by rw [hw]; simp

/-- The ordered-pair average for two successive Fock operator-algebra Markov
steps. -/
noncomputable def sequentialRandomFockOperatorAverage
    (w v : Equiv.Perm (Fin n) → ℝ) :
    Module.End ℝ (Module.End ℝ (FockSpace (PrimalSheet n))) :=
  ∑ τ : Equiv.Perm (Fin n), ∑ σ : Equiv.Perm (Fin n),
    (v τ * w σ) •
      ((fockOperatorPermutationEquiv n σ).toLinearMap.comp
        (fockOperatorPermutationEquiv n τ).toLinearMap)

/-- Composition of finite Fock operator-algebra Markov steps expands over the
ordered pairs of underlying permutation symmetries. -/
theorem randomFockOperatorAverage_comp
    (w v : Equiv.Perm (Fin n) → ℝ) :
    randomFockOperatorAverage n w * randomFockOperatorAverage n v =
      sequentialRandomFockOperatorAverage n w v := by
  classical
  ext A
  simp [sequentialRandomFockOperatorAverage,
    randomFockOperatorAverage, Module.End.mul_eq_comp,
    LinearMap.comp_apply, Finset.smul_sum, smul_smul]

/-- Birkhoff--von Neumann gives a normalized Markov average on the actual
Fock operator algebra for every finite doubly-stochastic transition matrix. -/
theorem exists_randomFockOperatorAverage_of_doublyStochastic
    (P : Matrix (Fin n) (Fin n) ℝ)
    (hP : P ∈ doublyStochastic ℝ (Fin n)) :
    ∃ w : Equiv.Perm (Fin n) → ℝ,
      (∀ σ, 0 ≤ w σ) ∧
      ∑ σ, w σ = 1 ∧
      ∑ σ, w σ • σ.permMatrix ℝ = P ∧
      randomFockOperatorAverage n w
        (1 : Module.End ℝ (FockSpace (PrimalSheet n))) = 1 := by
  rcases exists_eq_sum_perm_of_mem_doublyStochastic (M := P) hP with
    ⟨w, hw_nonneg, hw_sum, hw_matrix⟩
  exact ⟨w, hw_nonneg, hw_sum, hw_matrix,
    randomFockOperatorAverage_one n w hw_sum⟩

end InfoGeometry.Clifford.ClNNPermutationSymmetry
