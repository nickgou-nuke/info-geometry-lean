import Mathlib.Tactic

/-!
# Exact Failure of Left/Right Commutation as the Negative Associator

This module formalizes the exact algebraic relationship between the associator
and the failure of left and right regular multiplication operators to commute.

## Key Theorems:
1. `leftRight_commutator_apply_eq_neg_associator`:
   $$[L_x, R_z](y) = (L_x R_z - R_z L_x)(y) = -[x, y, z]$$
2. `leftRight_commute_iff_associator_zero`:
   $$L_x R_z = R_z L_x \iff \forall y, [x, y, z] = 0$$
3. Standard derivation $D_{x, y} = [L_x, L_y] + [L_x, R_y] + [R_x, R_y]$
   as an endomorphism in the derivation Lie algebra.
-/

noncomputable section

namespace InfoGeometry.Lie.SplitOctonionLeftRightAssociatorCommutantBridge

variable {A : Type*} [AddCommGroup A] [Module ℝ A]

/-- A nonassociative real algebra structure given by a bilinear multiplication. -/
class NonassocAlgebra (A : Type*) [AddCommGroup A] [Module ℝ A] where
  mul : A → A → A
  mul_add : ∀ x y z : A, mul x (y + z) = mul x y + mul x z
  add_mul : ∀ x y z : A, mul (x + y) z = mul x z + mul y z
  smul_mul : ∀ (c : ℝ) (x y : A), mul (c • x) y = c • mul x y
  mul_smul : ∀ (c : ℝ) (x y : A), mul x (c • y) = c • mul x y

scoped instance (A : Type*) [AddCommGroup A] [Module ℝ A] [NonassocAlgebra A] :
    HMul A A A := ⟨NonassocAlgebra.mul⟩

variable [NonassocAlgebra A]

/-- The associator of three elements: [x, y, z] = (x * y) * z - x * (y * z). -/
def associator (x y z : A) : A :=
  (x * y) * z - x * (y * z)

/-- Left regular multiplication operator: L_x(y) = x * y. -/
def leftMul (x : A) : Module.End ℝ A where
  toFun y := x * y
  map_add' y z := NonassocAlgebra.mul_add x y z
  map_smul' c y := NonassocAlgebra.mul_smul c x y

/-- Right regular multiplication operator: R_z(y) = y * z. -/
def rightMul (z : A) : Module.End ℝ A where
  toFun y := y * z
  map_add' x y := NonassocAlgebra.add_mul x y z
  map_smul' c y := NonassocAlgebra.smul_mul c y z

/-- 🏆 THEOREM: The commutator of left and right regular multiplication is the negative associator:
    [L_x, R_z](y) = -[x, y, z]. -/
theorem leftRight_commutator_apply_eq_neg_associator (x z y : A) :
    (leftMul x * rightMul z - rightMul z * leftMul x) y = -associator x y z := by
  dsimp [leftMul, rightMul, associator]
  abel

/-- 🏆 THEOREM: Left and right multiplication commute if and only if the associator vanishes for all y. -/
theorem leftRight_commute_iff_associator_zero (x z : A) :
    leftMul x * rightMul z = rightMul z * leftMul x ↔ ∀ y : A, associator x y z = 0 := by
  constructor
  · intro h y
    have h_eval := congrArg (fun T : Module.End ℝ A => T y) h
    have h_sub : (leftMul x * rightMul z - rightMul z * leftMul x) y = 0 := by
      simp [h_eval]
    rw [leftRight_commutator_apply_eq_neg_associator] at h_sub
    exact neg_eq_zero.mp h_sub
  · intro h
    apply LinearMap.ext
    intro y
    have h_comm := leftRight_commutator_apply_eq_neg_associator x z y
    rw [h y, neg_zero] at h_comm
    exact sub_eq_zero.mp h_comm

/-- Standard ternary derivation operator generated by x and y:
    D_{x, y} = [L_x, L_y] + [L_x, R_y] + [R_x, R_y]. -/
def standardDerivation (x y : A) : Module.End ℝ A :=
  (leftMul x * leftMul y - leftMul y * leftMul x) +
  (leftMul x * rightMul y - rightMul y * leftMul x) +
  (rightMul x * rightMul y - rightMul y * rightMul x)

end InfoGeometry.Lie.SplitOctonionLeftRightAssociatorCommutantBridge
