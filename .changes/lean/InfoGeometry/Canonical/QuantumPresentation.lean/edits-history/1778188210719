{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Canonical/QuantumPresentation.lean","time":1778188210719,"baseTime":1778188210169,"changes":[{"range":{"start":{"line":89,"character":0},"end":{"line":220,"character":0}},"text":"  forward_readout : ReadoutPreservation F\n  inverse_readout : ReadoutPreservation inverse\n  left_state : ∀ s : P.State, inverse.mapState (F.mapState s) = s\n  right_state : ∀ s : Q.State, F.mapState (inverse.mapState s) = s\n  left_observable : ∀ o : P.Observable, inverse.mapObservable (F.mapObservable o) = o\n  right_observable : ∀ o : Q.Observable, F.mapObservable (inverse.mapObservable o) = o\n  left_scalar : ∀ x : P.Scalar, inverse.mapScalar (F.mapScalar x) = x\n  right_scalar : ∀ x : Q.Scalar, F.mapScalar (inverse.mapScalar x) = x\n\n/-- Identity intertwiner on a presentation. -/\n@[rep_depth krein]\ndef idIntertwiner (P : Presentation) : Intertwiner P P where\n  mapState := fun s => s\n  mapObservable := fun o => o\n  mapScalar := fun x => x\n  map_act := by\n    intro o s\n    rfl\n  map_support := by\n    intro s hs\n    exact hs\n  map_generator := by\n    intro s\n    rfl\n\n/-- The identity intertwiner is an isomorphism. -/\n@[rep_depth krein]\ndef idIntertwiner_isomorphism (P : Presentation) :\n    IntertwinerIsomorphism (idIntertwiner P) where\n  inverse := idIntertwiner P\n  forward_readout := by\n    refine ⟨?_, ?_⟩ <;> intro s <;> rfl\n  inverse_readout := by\n    refine ⟨?_, ?_⟩ <;> intro s <;> rfl\n  left_state := by\n    intro s\n    rfl\n  right_state := by\n    intro s\n    rfl\n  left_observable := by\n    intro o\n    rfl\n  right_observable := by\n    intro o\n    rfl\n  left_scalar := by\n    intro x\n    rfl\n  right_scalar := by\n    intro x\n    rfl\n\n/-- Composition of intertwiners. -/\n@[rep_depth krein]\ndef compIntertwiner\n    {P Q R : Presentation}\n    (F : Intertwiner P Q)\n    (G : Intertwiner Q R) :\n    Intertwiner P R where\n  mapState := fun s => G.mapState (F.mapState s)\n  mapObservable := fun o => G.mapObservable (F.mapObservable o)\n  mapScalar := fun x => G.mapScalar (F.mapScalar x)\n  map_act := by\n    intro o s\n    calc\n      G.mapState (F.mapState (P.act o s))\n          = G.mapState (Q.act (F.mapObservable o) (F.mapState s)) := by\n              rw [F.map_act o s]\n      _ = R.act (G.mapObservable (F.mapObservable o)) (G.mapState (F.mapState s)) := by\n              rw [G.map_act (F.mapObservable o) (F.mapState s)]\n  map_support := by\n    intro s hs\n    exact G.map_support (F.mapState s) (F.map_support s hs)\n  map_generator := by\n    intro s\n    calc\n      G.mapState (F.mapState (P.generator s))\n          = G.mapState (Q.generator (F.mapState s)) := by\n              rw [F.map_generator s]\n      _ = R.generator (G.mapState (F.mapState s)) := by\n              rw [G.map_generator (F.mapState s)]\n\n/--\nConcrete nontrivial presentation on paired states.\n\nThis gives a load-bearing witness that the intertwiner lane is not only identity\nscaffolding: the state map can be a genuine symmetry (swap) while preserving the\ntyped action/support/generator contracts.\n-/\n@[rep_depth operator]\ndef pairedFunctionPresentation (α : Type) : Presentation where\n  Scalar := α × α\n  State := α × α\n  Observable := (α → α) × (α → α)\n  act := fun o s => (o.1 s.1, o.2 s.2)\n  support := fun s => (s.2, s.1).2 = s.1\n  generator := fun s => (s.2, s.1)\n  metricReadout := fun s => s\n  phaseReadout := fun s => (s.2, s.1)\n\n/-- Non-identity symmetry intertwiner on the paired-function presentation. -/\n@[rep_depth krein]\ndef pairedSwapIntertwiner (α : Type) :\n    Intertwiner (pairedFunctionPresentation α) (pairedFunctionPresentation α) where\n  mapState := fun s => (s.2, s.1)\n  mapObservable := fun o => (o.2, o.1)\n  mapScalar := fun x => (x.2, x.1)\n  map_act := by\n    intro o s\n    cases o\n    cases s\n    rfl\n  map_support := by\n    intro s hs\n    rfl\n  map_generator := by\n    intro s\n    cases s\n    rfl\n\n/-- Readout preservation for the paired swap intertwiner. -/\n@[rep_depth krein]\ndef pairedSwapReadoutPreservation (α : Type) :\n    ReadoutPreservation (pairedSwapIntertwiner α) where\n  metric := by\n    intro s\n    rfl\n  phase := by\n    intro s\n    rfl\n\n/-- The paired swap intertwiner is an involutive isomorphism. -/\n@[rep_depth krein]\ndef pairedSwapIntertwiner_isomorphism (α : Type) :\n    IntertwinerIsomorphism (pairedSwapIntertwiner α) where\n  inverse := pairedSwapIntertwiner α\n  forward_readout := pairedSwapReadoutPreservation α\n  inverse_readout := pairedSwapReadoutPreservation α\n","rangeOffset":2700,"rangeLength":3880}]}