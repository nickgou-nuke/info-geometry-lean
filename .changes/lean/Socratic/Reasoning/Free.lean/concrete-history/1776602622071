{"type":"new","contents":"import Mathlib.CategoryTheory.PathCategory.Basic\nimport Mathlib.Algebra.Category.ModuleCat.Basic\nimport Mathlib.Data.Real.Basic\n\n/-!\n# Socratic.Reasoning.Free\n\nFoundational free-category syntax/semantics structures for Socratic reasoning.\n-/\n\nnamespace Socratic\n\nuniverse u v w\n\n/-- A generic Quiver representation. -/\nstructure Syntax where\n  Obj : Type u\n  Hom : Obj → Obj → Type v\n\n/-- The canonical `Quiver` instance induced by `Syntax.Hom`. -/\ninstance (S : Syntax) : Quiver S.Obj := ⟨S.Hom⟩\n\n/-- The free category generated by the syntax quiver. -/\nabbrev Free (S : Syntax) := CategoryTheory.Paths S.Obj\n\n/-- A functorial semantics mapping our syntax into a target category C. -/\nstructure Semantics (S : Syntax) (C : Type w) [CategoryTheory.Category C] where\n  obj : S.Obj → C\n  map : ∀ {a b}, S.Hom a b → (obj a ⟶ obj b)\n\nnamespace Semantics\nopen CategoryTheory\n\n/-- Lift a raw semantics map into a functor out of the free category. -/\nnoncomputable def toFunctor {S : Syntax} {C : Type w} [CategoryTheory.Category C]\n    (sem : Semantics S C) : Free S ⥤ C :=\n  Paths.lift { obj := sem.obj, map := fun e => sem.map e }\nend Semantics\n\nopen CategoryTheory\n\n/-- The alignment between structural execution, logical truth, and continuous representation. -/\nstructure HomTriple (S : Syntax) where\n  ProgSem : Semantics S (Type u)\n  SpecSem : Semantics S (Type u)\n  VecSem  : Semantics S (Type u)\n\n  -- The logical specification must map to propositions.\n  spec_isProp : ∀ X : S.Obj, Subsingleton (SpecSem.obj X)\n\n  -- Programs must be logically sound.\n  sound  : ProgSem.toFunctor ⟶ SpecSem.toFunctor\n\n  -- Programs must have compositional geometric embeddings.\n  encode : ProgSem.toFunctor ⟶ VecSem.toFunctor\n\nend Socratic\n","mtime":1776602622071}