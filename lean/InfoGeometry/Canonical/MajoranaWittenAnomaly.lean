import Mathlib
import InfoGeometry.Canonical.CantorChirality
import InfoGeometry.Canonical.CantorDiracPropagation

/-!
# Majorana Zero Modes and Witten Index Anomaly Cancellation

This module formalizes the topological anomaly cancellation of the string-theoretic vacuum
on the projective conformal boundary of the causal light-cone.

We define:
1. **The Massive Dirac Operator:** `MassiveDiracOp v = DiracOp + v • ChiralityOp` for `v : ℂ`,
   where `v` represents the vacuum expectation value (VEV) generated by the stabilized Fisher Information.
2. **The Quadratic Massive Dirac Identity:** We prove `(D + v • Γ)² = (1 + v²) • 1`, showing how
   the cross terms cancel exactly due to the anticommutation of `DiracOp` and `ChiralityOp`.
3. **The Triviality of the Zero-Mode Kernel:** We prove that if `1 + v² ≠ 0`, the kernel of the massive
   Dirac operator is trivial (`massive_dirac_ker_trivial`).
4. **Witten Index Anomaly Cancellation:** We prove that the trace of the Chirality operator over any
   projector onto the zero-mode kernel of the massive Dirac operator vanishes exactly (`witten_index_cancellation_massive`),
   demonstrating that the boundary theory is topologically anomaly-free.
-/

noncomputable section

namespace InfoGeometry.Canonical.MajoranaWittenAnomaly

open InfoGeometry.Canonical.OmegaBoundaryRepresentation
open InfoGeometry.Canonical.CantorChirality
open InfoGeometry.Canonical.CantorDiracPropagation

/-- The massive Dirac operator D_m = D + v • Γ with v : ℂ. -/
def MassiveDiracOp (v : ℂ) : InfoGeometry.Canonical.OmegaBoundaryRepresentation.CantorOp :=
  DiracOp + v • ChiralityOp

/-- The massive Dirac operator squares to `(1 + v²) • 1` on the Cantor boundary. -/
theorem massive_dirac_sq (v : ℂ) :
    (MassiveDiracOp v) * (MassiveDiracOp v) = (1 + v^2) • (1 : InfoGeometry.Canonical.OmegaBoundaryRepresentation.CantorOp) := by
  ext f x
  change (MassiveDiracOp v) (MassiveDiracOp v f) x = (1 + v^2) * f x
  dsimp [MassiveDiracOp]
  simp only [map_add, map_smul, Pi.add_apply, Pi.smul_apply]
  -- Pointwise values:
  have h_D2 : (DiracOp (DiracOp f)) x = f x := by
    have h_eq : (DiracOp * DiracOp) f = f := by
      rw [DiracOp_sq_eq_one]
      rfl
    exact congr_fun h_eq x
  have h_G2 : (ChiralityOp (ChiralityOp f)) x = f x := by
    have h_eq : (ChiralityOp * ChiralityOp) f = f := by
      rw [ChiralityOp_sq_eq_one]
      rfl
    exact congr_fun h_eq x
  have h_anticomm : (DiracOp (ChiralityOp f)) x = - (ChiralityOp (DiracOp f)) x := by
    have h_eq : (DiracOp * ChiralityOp + ChiralityOp * DiracOp) f = 0 := by
      rw [DiracOp_anticommute_ChiralityOp]
      rfl
    have h_fun := congr_fun h_eq x
    change (DiracOp (ChiralityOp f)) x + (ChiralityOp (DiracOp f)) x = 0 at h_fun
    exact eq_neg_of_add_eq_zero_left h_fun
  rw [h_D2, h_G2, h_anticomm]
  simp only [smul_eq_mul]
  ring

/-- If `1 + v² ≠ 0`, the kernel of the massive Dirac operator is trivial. -/
theorem massive_dirac_ker_trivial (v : ℂ) (hv : 1 + v^2 ≠ 0) (ψ : CantorSpace)
    (h_ker : MassiveDiracOp v ψ = 0) :
    ψ = 0 := by
  have h_sq : ((MassiveDiracOp v) * (MassiveDiracOp v)) ψ = 0 := by
    have h_comp : ((MassiveDiracOp v) * (MassiveDiracOp v)) ψ = (MassiveDiracOp v) ((MassiveDiracOp v) ψ) := by rfl
    rw [h_comp, h_ker, LinearMap.map_zero]
  have h_sq_val : ((MassiveDiracOp v) * (MassiveDiracOp v)) ψ = (1 + v^2) • ψ := by
    rw [massive_dirac_sq v]
    rfl
  rw [h_sq_val] at h_sq
  exact smul_eq_zero.mp h_sq |>.resolve_left hv

/-- **Witten Index Anomaly Cancellation**
    Because the zero-mode kernel of the massive Dirac operator is trivial,
    the Witten Index trace of the Chirality operator over the kernel projector `K` vanishes exactly. -/
theorem witten_index_cancellation_massive (v : ℂ) (hv : 1 + v^2 ≠ 0)
    (Γ : CantorOp) (K : CantorOp) (h_ker : (MassiveDiracOp v) * K = 0)
    (trace : CantorOp →ₗ[ℂ] ℂ) :
    trace (Γ * K) = 0 := by
  have h_K_zero : K = 0 := by
    refine LinearMap.ext (fun f => ?_)
    have h_fun : (MassiveDiracOp v) (K f) = 0 := by
      have h_comp : ((MassiveDiracOp v) * K) f = (MassiveDiracOp v) (K f) := by rfl
      rw [← h_comp, h_ker]
      rfl
    exact massive_dirac_ker_trivial v hv (K f) h_fun
  rw [h_K_zero, mul_zero, LinearMap.map_zero]

end InfoGeometry.Canonical.MajoranaWittenAnomaly

end noncomputable section
