-- dmodule_determinant_line.m2
-- Construct the D-module corresponding to the Quillen metric and the canonical connection on the determinant line bundle.

needsPackage "Dmodules"

-- We work over the Weyl algebra to represent differential operators
-- acting on the sections of the determinant line bundle.
n = 2
W = QQ[x_1..x_n, dx_1..dx_n, WeylAlgebra => {x_1 => dx_1, x_2 => dx_2}]

-- The determinant line bundle over the space of connections has a canonical connection.
-- We model the D-module generated by the partition function (or a section with the Quillen metric).

-- Define a differential operator representing the covariant derivative
-- with respect to the connection.
nabla = dx_1 + x_1*dx_2

-- The D-module representing the determinant line bundle section.
I = ideal(nabla)
M = W^1 / I

print "D-module for Determinant Line Bundle:"
print M

-- Holonomic D-module check
isHolonomic = isHolonomic M
print("Is the D-module holonomic? ", isHolonomic)
