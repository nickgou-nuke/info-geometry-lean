R = QQ[y,sy,yr,syr,obs,sobs,weighted,sweighted,pred,Eexact,Eadapt,delta];
yv = -12/125;
syv = 37/1000;
yrv = -51/500;
syrv = 41/1000;
obsv = 90;
sobsv = 35;
weightedv = 72;
sweightedv = 26;
predv = 190;
assert(abs(yv)/syv == 96/37);
assert(abs(yrv)/syrv == 102/41);
assert(obsv-sobsv == 55 and obsv+sobsv == 125);
assert(weightedv-sweightedv == 46 and weightedv+sweightedv == 98);
assert(obsv/predv == 9/19);
assert(weightedv/predv == 36/95);
assert(1-obsv/predv == 10/19);
assert(1-weightedv/predv == 59/95);
b11=4/5; b3k=19/100; b3o=1/100; b3=b3k+b3o;
assert(b11+b3k+b3o == 1);
assert(b3 == 1/5);
weightedA = b11*(-2/3) + b3*(1/3);
assert(weightedA == -7/15);
assert(abs(weightedA - (-467/1000)) == 1/3000);
W = QQ[x,dx, WeylAlgebra => {x=>dx}];
I = ideal(x*dx - dx*x - 1);
assert(numgens I == 1);
M = coker matrix{{Eexact*delta - Eexact + Eadapt}};
edges={"decays_to","measures","implies","compares_with","motivates"};
assert(#edges == 5);
print {"yWeighted", yv, "ySignificance", 96/37, "recoilSignificance", 102/41, "observedToPredicted", 9/19, "weightedToPredicted", 36/95, "weightedGTAsymmetry", weightedA, "dmoduleCCRGenerators", numgens I, "graphEdges", #edges};
