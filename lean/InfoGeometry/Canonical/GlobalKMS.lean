import InfoGeometry.Canonical.SpacetimeSynthesis
import InfoGeometry.Canonical.ModularEvolution

open CategoryTheory Limits

namespace InfoGeometry.Canonical

variable (Q : ∀ n, QuadraticForm ℝ (InfoGeometry.Topology.V n))
variable (h_compat : ∀ (m n : ℕ) (h : m ≤ n) (x : InfoGeometry.Topology.V m), 
  Q n (fun i => if h_lim : i.val < 2 * m then x ⟨i.val, h_lim⟩ else 0) = Q m x)

/--
  The Global Modular Automorphism Group of the CPT Spinor Vacuum.
  This represents the exact macroscopic thermodynamic time-evolution
  generated by the infinite limit of the Clifford tower.
-/
abbrev GlobalModularEvolution [HasColimit (CliffordTowerCausalFunctor Q h_compat)] :=
  ModularAutomorphismGroup (CliffordTowerCausalFunctor Q h_compat)

/--
  The Global KMS Equilibrium State.
  A state `ω` on the CPT Spinor Vacuum is formally a Global KMS state 
  if it is perfectly invariant under the macroscopic modular flow.
-/
def GlobalKMSState [HasColimit (CliffordTowerCausalFunctor Q h_compat)]
    (σ : GlobalModularEvolution Q h_compat) 
    (ω : CPTSpinorVacuum Q h_compat → ℝ) : Prop :=
  IsModularInvariantState (CliffordTowerCausalFunctor Q h_compat) σ ω

/--
  The Equilibrium Thermodynamic Limit Theorem.
  If the global state is a KMS equilibrium state under the modular flow,
  then its pullback to any finite scale (any local event in the Causal Spacetime)
  must be invariant under the restriction of the modular flow to that patch.
-/
theorem global_kms_implies_local_equilibrium
    [HasColimit (CliffordTowerCausalFunctor Q h_compat)]
    (σ : GlobalModularEvolution Q h_compat)
    (ω : CPTSpinorVacuum Q h_compat → ℝ)
    (h_kms : GlobalKMSState Q h_compat σ ω)
    (n : CantorIndexCategory)
    (x : (CliffordTowerCausalFunctor Q h_compat).obj n)
    (t : Multiplicative ℝ) :
    ω (((σ t).hom) ((colimit.ι (CliffordTowerCausalFunctor Q h_compat) n) x)) = 
    ω ((colimit.ι (CliffordTowerCausalFunctor Q h_compat) n) x) := by
  -- By definition, the Global KMS State is invariant on the entire Universal Causal Future.
  -- The local observable is pushed forward into the Universal Causal Future via the colimit leg.
  apply h_kms t ((colimit.ι (CliffordTowerCausalFunctor Q h_compat) n) x)

end InfoGeometry.Canonical
