import Mathlib.Algebra.PresentedMonoid.Basic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Twistor.ProjectiveNullConfigurationWordAction

/-!
# Positive Artin monoid action on projective-null configurations

This owner packages the already proved adjacent Artin and far-commutativity
relations with Mathlib's native `PresentedMonoid`.  The resulting monoid acts
on the unordered projective-null configuration carrier through the existing
configuration generators.

The generator type is `ℕ`, so this is the countably generated positive Artin
monoid used by the current repository API.  It is not an Artin braid group:
no inverse generators, loop classes, fundamental-group identification,
monodromy, or anyon interpretation are introduced here.
-/

noncomputable section

namespace InfoGeometry.Twistor.ProjectiveNullPositiveArtinMonoid

open InfoGeometry.Twistor.ProjectiveNullConfiguration
open InfoGeometry.Twistor.ProjectiveNullConfigurationWordAction
open InfoGeometry.Twistor.ProjectiveNullUnorderedConfiguration

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- The local defining relations of the countably generated positive Artin
monoid: the adjacent braid relation and far commutativity.  Context closure,
symmetry, and transitivity are supplied by `PresentedMonoid`. -/
inductive PositiveArtinRelation : FreeMonoid ℕ → FreeMonoid ℕ → Prop
  | braid (i : ℕ) :
      PositiveArtinRelation
        (FreeMonoid.of i * FreeMonoid.of (i + 1) * FreeMonoid.of i)
        (FreeMonoid.of (i + 1) * FreeMonoid.of i * FreeMonoid.of (i + 1))
  | commute {i j : ℕ} (h : i + 1 < j) :
      PositiveArtinRelation
        (FreeMonoid.of i * FreeMonoid.of j)
        (FreeMonoid.of j * FreeMonoid.of i)

/-- The native Mathlib presented monoid generated by the positive Artin
relations on countably many neighboring-exchange labels. -/
abbrev PositiveArtinMonoid := PresentedMonoid PositiveArtinRelation

/-- One projective-null configuration generator, regarded as an element of
the endomorphism monoid of the unordered configuration carrier. -/
def configurationGeneratorEnd
    (Q : QuadraticForm K V) (ρ : ℕ → (V ≃ₗ[K] V))
    (hQ : ∀ i v, Q (ρ i v) = Q v) (n : ℕ) :
    ℕ → Function.End (Unordered Q n) :=
  fun i => mapUnorderedConfiguration Q ρ hQ i n

/-- Evaluation by the free-monoid lift agrees with the repository's existing
recursive braid-word evaluator. -/
theorem freeMonoidLift_configurationGeneratorEnd_ofList
    (Q : QuadraticForm K V) (ρ : ℕ → (V ≃ₗ[K] V))
    (hQ : ∀ i v, Q (ρ i v) = Q v) (n : ℕ)
    (w : List ℕ) :
    FreeMonoid.lift (configurationGeneratorEnd Q ρ hQ n)
        (FreeMonoid.ofList w) =
      mapUnorderedConfigurationWord Q ρ hQ n w := by
  induction w with
  | nil => rfl
  | cons i w ih =>
      rw [FreeMonoid.ofList_cons, map_mul]
      exact congrArg (fun f => configurationGeneratorEnd Q ρ hQ n i * f) ih

/-- The concrete projective-null generators satisfy every defining relation
of `PositiveArtinMonoid`. -/
theorem configurationGeneratorEnd_respects_positiveArtinRelation
    (Q : QuadraticForm K V) (ρ : ℕ → (V ≃ₗ[K] V))
    (hQ : ∀ i v, Q (ρ i v) = Q v)
    (hArtin : ∀ i : ℕ,
      (ρ i).toLinearMap.comp
          ((ρ (i + 1)).toLinearMap.comp (ρ i).toLinearMap) =
        (ρ (i + 1)).toLinearMap.comp
          ((ρ i).toLinearMap.comp (ρ (i + 1)).toLinearMap))
    (hComm : ∀ {i j : ℕ}, i + 1 < j →
      (ρ i).toLinearMap.comp (ρ j).toLinearMap =
        (ρ j).toLinearMap.comp (ρ i).toLinearMap)
    (n : ℕ) (a b : FreeMonoid ℕ) (h : PositiveArtinRelation a b) :
    FreeMonoid.lift (configurationGeneratorEnd Q ρ hQ n) a =
      FreeMonoid.lift (configurationGeneratorEnd Q ρ hQ n) b := by
  cases h with
  | braid i =>
      apply funext
      intro p
      exact mapUnorderedConfiguration_artin_relation Q ρ hQ hArtin i n p
  | @commute i j hsep =>
      apply funext
      intro p
      exact mapUnorderedConfiguration_commute_relation Q ρ hQ i j n
        (hComm hsep) p

/-- The positive Artin presented monoid acts on unordered projective-null
configurations.  This is a monoid action by global configuration maps, not an
action by geometric exchange loops. -/
def positiveArtinConfigurationAction
    (Q : QuadraticForm K V) (ρ : ℕ → (V ≃ₗ[K] V))
    (hQ : ∀ i v, Q (ρ i v) = Q v)
    (hArtin : ∀ i : ℕ,
      (ρ i).toLinearMap.comp
          ((ρ (i + 1)).toLinearMap.comp (ρ i).toLinearMap) =
        (ρ (i + 1)).toLinearMap.comp
          ((ρ i).toLinearMap.comp (ρ (i + 1)).toLinearMap))
    (hComm : ∀ {i j : ℕ}, i + 1 < j →
      (ρ i).toLinearMap.comp (ρ j).toLinearMap =
        (ρ j).toLinearMap.comp (ρ i).toLinearMap)
    (n : ℕ) :
    PositiveArtinMonoid →* Function.End (Unordered Q n) :=
  PresentedMonoid.lift (configurationGeneratorEnd Q ρ hQ n)
    (configurationGeneratorEnd_respects_positiveArtinRelation
      Q ρ hQ hArtin hComm n)

@[simp] theorem positiveArtinConfigurationAction_generator
    (Q : QuadraticForm K V) (ρ : ℕ → (V ≃ₗ[K] V))
    (hQ : ∀ i v, Q (ρ i v) = Q v)
    (hArtin : ∀ i : ℕ,
      (ρ i).toLinearMap.comp
          ((ρ (i + 1)).toLinearMap.comp (ρ i).toLinearMap) =
        (ρ (i + 1)).toLinearMap.comp
          ((ρ i).toLinearMap.comp (ρ (i + 1)).toLinearMap))
    (hComm : ∀ {i j : ℕ}, i + 1 < j →
      (ρ i).toLinearMap.comp (ρ j).toLinearMap =
        (ρ j).toLinearMap.comp (ρ i).toLinearMap)
    (n i : ℕ) :
    positiveArtinConfigurationAction Q ρ hQ hArtin hComm n
        (PresentedMonoid.of PositiveArtinRelation i) =
      mapUnorderedConfiguration Q ρ hQ i n := by
  exact PresentedMonoid.lift_of _ _

@[simp] theorem positiveArtinConfigurationAction_word
    (Q : QuadraticForm K V) (ρ : ℕ → (V ≃ₗ[K] V))
    (hQ : ∀ i v, Q (ρ i v) = Q v)
    (hArtin : ∀ i : ℕ,
      (ρ i).toLinearMap.comp
          ((ρ (i + 1)).toLinearMap.comp (ρ i).toLinearMap) =
        (ρ (i + 1)).toLinearMap.comp
          ((ρ i).toLinearMap.comp (ρ (i + 1)).toLinearMap))
    (hComm : ∀ {i j : ℕ}, i + 1 < j →
      (ρ i).toLinearMap.comp (ρ j).toLinearMap =
        (ρ j).toLinearMap.comp (ρ i).toLinearMap)
    (n : ℕ) (w : List ℕ) :
    positiveArtinConfigurationAction Q ρ hQ hArtin hComm n
        (PresentedMonoid.mk PositiveArtinRelation (FreeMonoid.ofList w)) =
      mapUnorderedConfigurationWord Q ρ hQ n w := by
  change FreeMonoid.lift (configurationGeneratorEnd Q ρ hQ n)
      (FreeMonoid.ofList w) = _
  exact freeMonoidLift_configurationGeneratorEnd_ofList Q ρ hQ n w

end InfoGeometry.Twistor.ProjectiveNullPositiveArtinMonoid
