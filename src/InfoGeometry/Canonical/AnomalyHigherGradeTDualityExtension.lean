/-! ## 1. Stage $0 \to \pm 1$: Oblique Idempotent Counterexample Generates Grade $\pm 1$ -/

/-- Lower-left matrix unit $E_{10}$ on $\mathrm{Mat}_2(\mathbb{R})$, dual to the anomaly $E_{01}$. -/
def E10 : Matrix (Fin 2) (Fin 2) ℝ := Matrix.single 1 0 1

/-- Diagonal Cartan element $H_{01} = E_{00} - E_{11}$ generated by $[E_{01}, E_{10}]$. -/
def E11 : Matrix (Fin 2) (Fin 2) ℝ := Matrix.single 1 1 1

/-- Counterexample to grade-$0$ commutativity: the commutator of `oblique` and `leftProjector`
is $-E_{01} \neq 0$. -/
theorem stage0_oblique_counterexample :
    commutator (oblique (R := ℝ)) leftProjector = -E01 ∧
      commutator (oblique (R := ℝ)) leftProjector ≠ 0 :=
  ⟨oblique_commutator_leftProjector, oblique_commutator_nonzero⟩

/-- Relative to the projector grading $H_0 = E_{00}$, the anomaly generator $E_{01}$ has
grade $+1$: $[E_{00}, E_{01}] = E_{01}$. -/
theorem E01_has_projector_grade_pos_one :
    commutator (leftProjector (R := ℝ)) E01 = E01 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [GenericObliqueIdempotentAnomaly.commutator, leftProjector, E00, E01]

/-- Relative to the projector grading $H_0 = E_{00}$, the opposite generator $E_{10}$ has
grade $-1$: $[E_{00}, E_{10}] = -E_{10}$. -/
theorem E10_has_projector_grade_neg_one :
    commutator (leftProjector (R := ℝ)) E10 = -E10 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [GenericObliqueIdempotentAnomaly.commutator, leftProjector, E00, E10]

/-- The bracket of the grade-$+1$ anomaly $E_{01}$ and grade-$-1$ partner $E_{10}$ closes
into the diagonal Cartan generator $E_{00} - E_{11}$ at grade $0$. -/
theorem E01_E10_commutator_closes_grade_zero :
    commutator (E01 (R := ℝ)) E10 = E00 - E11 ∧
      commutator (leftProjector (R := ℝ)) (commutator (E01 (R := ℝ)) E10) = 0 := by
  constructor
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [GenericObliqueIdempotentAnomaly.commutator, E01, E10, E00, E11]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [GenericObliqueIdempotentAnomaly.commutator, leftProjector, E01, E10, E00,
        Matrix.mul_apply, Fin.sum_univ_two]

/-! ## 2. Stage $\pm 1 \to \pm 2$: Multi-Channel Counterexample Generates Grade $\pm 2$ Heisenberg Centers -/

/-- Rank-two bivector generator on the positive outer null 2-plane (grade $+2$). -/
def positiveTwoGenerator (a b : Outer2) : O55Lie :=
  splitRankTwo (embedOuterPlus a) (embedOuterPlus b)

/-- Rank-two bivector generator on the negative outer null 2-plane (grade $-2$). -/
def negativeTwoGenerator (a b : Outer2) : O55Lie :=
  splitRankTwo (embedOuterMinus a) (embedOuterMinus b)

/-- Every `positiveTwoGenerator a b` lies in contact grade $+2$. -/
theorem positiveTwoGenerator_mem_grade_two (a b : Outer2) :
    positiveTwoGenerator a b ∈ realContactGradeSpace 2 := by
  rcases embedded_weight_packet with ⟨_, _, hp⟩
  simpa [positiveTwoGenerator] using splitRankTwo_grade (hp a) (hp b)

/-- Every `negativeTwoGenerator a b` lies in contact grade $-2$. -/
theorem negativeTwoGenerator_mem_grade_neg_two (a b : Outer2) :
    negativeTwoGenerator a b ∈ realContactGradeSpace (-2) := by
  rcases embedded_weight_packet with ⟨hm, _, _⟩
  simpa [negativeTwoGenerator] using splitRankTwo_grade (hm a) (hm b)

/--Every `positiveOneGenerator a w` lies in contact grade $+1$. -/
theorem positiveOneGenerator_mem_grade_one (a : Outer2) (w : Middle6) :
    positiveOneGenerator a w ∈ realContactGradeSpace 1 := by
  rcases embedded_weight_packet with ⟨_, h0, hp⟩
  simpa [positiveOneGenerator] using splitRankTwo_grade (h0 w) (hp a)

/-- Every `negativeOneGenerator a w` lies in contact grade $-1$. -/
theorem negativeOneGenerator_mem_grade_neg_one (a : Outer2) (w : Middle6) :
    negativeOneGenerator a w ∈ realContactGradeSpace (-1) := by
  rcases embedded_weight_packet with ⟨hm, h0, _⟩
  simpa [negativeOneGenerator] using splitRankTwo_grade (hm a) (h0 w)

/-- Self-wedge of any vector in `splitRankTwo` vanishes. -/
@[simp] theorem splitRankTwo_self (u : Vector55) :
    splitRankTwo u u = 0 := by
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  simp [splitRankTwo, splitRankTwoEnd]

/-- Universal Grade-$+1$ Bracket Law:
The commutator of two grade-$+1$ generators is proportional to the grade-$+2$
bivector `positiveTwoGenerator a b` weighted by `middlePairing w z`. -/
theorem positiveOne_bracket_eq_positiveTwo
    (a b : Outer2) (w z : Middle6) :
    ⁅positiveOneGenerator a w, positiveOneGenerator b z⁆ =
      - (middlePairing w z • positiveTwoGenerator a b) := by
  unfold positiveOneGenerator positiveTwoGenerator
  rw [splitRankTwo_bracket]
  have h1 : splitPairing (embedOuterPlus a) (embedMiddle z) = 0 :=
    pairing_outerPlus_middle a z
  have h2 : splitPairing (embedMiddle w) (embedMiddle z) = middlePairing w z :=
    pairing_middle_middle w z
  have h3 : splitPairing (embedOuterPlus a) (embedOuterPlus b) = 0 :=
    pairing_outerPlus_outerPlus a b
  have h4 : splitPairing (embedMiddle w) (embedOuterPlus b) = 0 := by
    rw [splitPairing_comm]
    exact pairing_outerPlus_middle b w
  rw [h1, h2, h3, h4]
  simp

/-- Universal Grade-$-1$ Bracket Law:
The commutator of two grade-$-1$ generators is proportional to the grade-$-2$
bivector `negativeTwoGenerator a b` weighted by `middlePairing w z`. -/
theorem negativeOne_bracket_eq_negativeTwo
    (a b : Outer2) (w z : Middle6) :
    ⁅negativeOneGenerator a w, negativeOneGenerator b z⁆ =
      - (middlePairing w z • negativeTwoGenerator a b) := by
  unfold negativeOneGenerator negativeTwoGenerator
  rw [splitRankTwo_bracket]
  have h1 : splitPairing (embedMiddle w) (embedOuterMinus b) = 0 := by
    rw [splitPairing_comm]
    exact pairing_outerMinus_middle b w
  have h2 : splitPairing (embedOuterMinus a) (embedOuterMinus b) = 0 :=
    pairing_outerMinus_outerMinus a b
  have h3 : splitPairing (embedMiddle w) (embedMiddle z) = middlePairing w z :=
    pairing_middle_middle w z
  have h4 : splitPairing (embedOuterMinus a) (embedMiddle z) = 0 :=
    pairing_outerMinus_middle a z
  rw [h1, h2, h3, h4]
  simp

/-- Single-Channel Vanishing: When restricted to a single outer channel `a`,
two grade-$+1$ generators commute (`[g_{+1}, g_{+1}] = 0` in the 3-graded TKK truncation). -/
theorem positiveOne_same_channel_commutator_eq_zero
    (a : Outer2) (w z : Middle6) :
    ⁅positiveOneGenerator a w, positiveOneGenerator a z⁆ = 0 := by
  rw [positiveOne_bracket_eq_positiveTwo]
  simp [positiveTwoGenerator]

/-- Single-Channel Vanishing: When restricted to a single outer channel `a`,
two grade-$-1$ generators commute (`[g_{-1}, g_{-1}] = 0` in the 3-graded TKK truncation). -/
theorem negativeOne_same_channel_commutator_eq_zero
    (a : Outer2) (w z : Middle6) :
    ⁅negativeOneGenerator a w, negativeOneGenerator a z⁆ = 0 := by
  rw [negativeOne_bracket_eq_negativeTwo]
  simp [negativeTwoGenerator]

/-- The canonical grade-$+2$ Kalb–Ramond / Heisenberg central anomaly generator $Z_{+2}$. -/
def anomalyGeneratorPlusTwo : O55Lie :=
  positiveTwoGenerator (outerBasis 0) (outerBasis 1)

/-- The canonical grade-$-2$ dual winding / $\beta$-bivector anomaly generator $Z_{-2}$. -/
def anomalyGeneratorMinusTwo : O55Lie :=
  negativeTwoGenerator (outerBasis 0) (outerBasis 1)

theorem anomalyGeneratorPlusTwo_mem_grade_two :
    anomalyGeneratorPlusTwo ∈ realContactGradeSpace 2 :=
  positiveTwoGenerator_mem_grade_two (outerBasis 0) (outerBasis 1)

theorem anomalyGeneratorMinusTwo_mem_grade_neg_two :
    anomalyGeneratorMinusTwo ∈ realContactGradeSpace (-2) :=
  negativeTwoGenerator_mem_grade_neg_two (outerBasis 0) (outerBasis 1)

/-- Concrete evaluation showing `anomalyGeneratorPlusTwo` acts non-trivially on
`embedOuterMinus (outerBasis 1)` at coordinate `8`. -/
theorem anomalyGeneratorPlusTwo_eval_coord8 :
    ((anomalyGeneratorPlusTwo : End55) (embedOuterMinus (outerBasis 1))) 8 = 1 := by
  simp [anomalyGeneratorPlusTwo, positiveTwoGenerator, splitRankTwo, splitRankTwoEnd,
    splitPairing, embedOuterPlus, embedOuterMinus, outerBasis]

/-- Concrete evaluation showing `anomalyGeneratorMinusTwo` acts non-trivially on
`embedOuterPlus (outerBasis 1)` at coordinate `0`. -/
theorem anomalyGeneratorMinusTwo_eval_coord0 :
    ((anomalyGeneratorMinusTwo : End55) (embedOuterPlus (outerBasis 1))) 0 = 1 := by
  simp [anomalyGeneratorMinusTwo, negativeTwoGenerator, splitRankTwo, splitRankTwoEnd,
    splitPairing, embedOuterPlus, embedOuterMinus, outerBasis]

/-- The grade-$+2$ anomaly generator $Z_{+2}$ is strictly non-zero. -/
theorem anomalyGeneratorPlusTwo_ne_zero :
    anomalyGeneratorPlusTwo ≠ 0 := by
  intro h
  have h8 : ((anomalyGeneratorPlusTwo : End55) (embedOuterMinus (outerBasis 1))) 8 = 0 := by
    rw [h]
    rfl
  rw [anomalyGeneratorPlusTwo_eval_coord8] at h8
  exact one_ne_zero h8

/-- The grade-$-2$ anomaly generator $Z_{-2}$ is strictly non-zero. -/
theorem anomalyGeneratorMinusTwo_ne_zero :
    anomalyGeneratorMinusTwo ≠ 0 := by
  intro h
  have h0 : ((anomalyGeneratorMinusTwo : End55) (embedOuterPlus (outerBasis 1))) 0 = 0 := by
    rw [h]
    rfl
  rw [anomalyGeneratorMinusTwo_eval_coord0] at h0
  exact one_ne_zero h0

/-- Multi-Channel Counterexample to 3-Grade TKK Abelianness (Positive Sheet):
Two grade-$+1$ generators coupled to `outerBasis 0` and `outerBasis 1` across
`middleBasis 0` have commutator `-anomalyGeneratorPlusTwo ≠ 0` in grade $+2$. -/
theorem positiveOne_multi_channel_anomaly_counterexample :
    ⁅positiveOneGenerator (outerBasis 0) (middleBasis 0),
      positiveOneGenerator (outerBasis 1) (middleBasis 0)⁆ =
      -anomalyGeneratorPlusTwo ∧
    ⁅positiveOneGenerator (outerBasis 0) (middleBasis 0),
      positiveOneGenerator (outerBasis 1) (middleBasis 0)⁆ ≠ 0 := by
  have hmid : middlePairing (middleBasis 0) (middleBasis 0) = 1 := by
    simp [middlePairing, middleBasis]
  have hbr :
      ⁅positiveOneGenerator (outerBasis 0) (middleBasis 0),
        positiveOneGenerator (outerBasis 1) (middleBasis 0)⁆ =
        -anomalyGeneratorPlusTwo := by
    rw [positiveOne_bracket_eq_positiveTwo, hmid, one_smul]
    rfl
  refine ⟨hbr, ?_⟩
  rw [hbr]
  exact neg_ne_zero.mpr anomalyGeneratorPlusTwo_ne_zero

/-- Multi-Channel Counterexample to 3-Grade TKK Abelianness (Negative Sheet):
Two grade-$-1$ generators coupled to `outerBasis 0` and `outerBasis 1` across
`middleBasis 0` have commutator `-anomalyGeneratorMinusTwo ≠ 0` in grade $-2$. -/
theorem negativeOne_multi_channel_anomaly_counterexample :
    ⁅negativeOneGenerator (outerBasis 0) (middleBasis 0),
      negativeOneGenerator (outerBasis 1) (middleBasis 0)⁆ =
      -anomalyGeneratorMinusTwo ∧
    ⁅negativeOneGenerator (outerBasis 0) (middleBasis 0),
      negativeOneGenerator (outerBasis 1) (middleBasis 0)⁆ ≠ 0 := by
  have hmid : middlePairing (middleBasis 0) (middleBasis 0) = 1 := by
    simp [middlePairing, middleBasis]
  have hbr :
      ⁅negativeOneGenerator (outerBasis 0) (middleBasis 0),
        negativeOneGenerator (outerBasis 1) (middleBasis 0)⁆ =
        -anomalyGeneratorMinusTwo := by
    rw [negativeOne_bracket_eq_negativeTwo, hmid, one_smul]
    rfl
  refine ⟨hbr, ?_⟩
  rw [hbr]
  exact neg_ne_zero.mpr anomalyGeneratorMinusTwo_ne_zero

/-! ## 3. Stage $\pm 2 \to \text{Saturation}$: Vanishing of Grades $|k| \ge 3$ (Heisenberg Closure) -/

/-- Grade $+3$ Vanishes (`[g_{+1}, g_{+2}] = 0`):
Every grade-$+1$ generator commutes with every grade-$+2$ anomaly generator, so
$\mathfrak{g}_{+1} \oplus \mathfrak{g}_{+2}$ closes as a 2-step nilpotent Heisenberg algebra. -/
theorem positiveOne_bracket_positiveTwo_eq_zero
    (a b c : Outer2) (w : Middle6) :
    ⁅positiveOneGenerator a w, positiveTwoGenerator b c⁆ = 0 := by
  unfold positiveOneGenerator positiveTwoGenerator
  rw [splitRankTwo_bracket]
  have h1 : splitPairing (embedOuterPlus a) (embedOuterPlus b) = 0 :=
    pairing_outerPlus_outerPlus a b
  have h2 : splitPairing (embedMiddle w) (embedOuterPlus b) = 0 := by
    rw [splitPairing_comm]
    exact pairing_outerPlus_middle b w
  have h3 : splitPairing (embedOuterPlus a) (embedOuterPlus c) = 0 :=
    pairing_outerPlus_outerPlus a c
  have h4 : splitPairing (embedMiddle w) (embedOuterPlus c) = 0 := by
    rw [splitPairing_comm]
    exact pairing_outerPlus_middle c w
  rw [h1, h2, h3, h4]
  simp

/-- Grade $-3$ Vanishes (`[g_{-1}, g_{-2}] = 0`):
Every grade-$-1$ generator commutes with every grade-$-2$ anomaly generator, so
$\mathfrak{g}_{-1} \oplus \mathfrak{g}_{-2}$ closes as the opposite 2-step nilpotent Heisenberg algebra. -/
theorem negativeOne_bracket_negativeTwo_eq_zero
    (a b c : Outer2) (w : Middle6) :
    ⁅negativeOneGenerator a w, negativeTwoGenerator b c⁆ = 0 := by
  unfold negativeOneGenerator negativeTwoGenerator
  rw [splitRankTwo_bracket]
  have h1 : splitPairing (embedMiddle w) (embedOuterMinus b) = 0 := by
    rw [splitPairing_comm]
    exact pairing_outerMinus_middle b w
  have h2 : splitPairing (embedOuterMinus a) (embedOuterMinus b) = 0 :=
    pairing_outerMinus_outerMinus a b
  have h3 : splitPairing (embedMiddle w) (embedOuterMinus c) = 0 := by
    rw [splitPairing_comm]
    exact pairing_outerMinus_middle c w
  have h4 : splitPairing (embedOuterMinus a) (embedOuterMinus c) = 0 :=
    pairing_outerMinus_outerMinus a c
  rw [h1, h2, h3, h4]
  simp

/-- Grade $+4$ Vanishes (`[g_{+2}, g_{+2}] = 0`):
The positive top-grade sector is abelian. -/
theorem positiveTwo_bracket_positiveTwo_eq_zero
    (a b c d : Outer2) :
    ⁅positiveTwoGenerator a b, positiveTwoGenerator c d⁆ = 0 := by
  unfold positiveTwoGenerator
  rw [splitRankTwo_bracket]
  simp

/-- Grade $-4$ Vanishes (`[g_{-2}, g_{-2}] = 0`):
The negative bottom-grade sector is abelian. -/
theorem negativeTwo_bracket_negativeTwo_eq_zero
    (a b c d : Outer2) :
    ⁅negativeTwoGenerator a b, negativeTwoGenerator c d⁆ = 0 := by
  unfold negativeTwoGenerator
  rw [splitRankTwo_bracket]
  simp

/-! ## 4. Stage $(-2, +2) \to 0$: Opposite Anomaly Centers Generate the Contact $\mathfrak{sl}_2(\mathbb{R})$ Triad -/

/-- The bracket of the grade-$-2$ winding anomaly center $Z_{-2}$ and the grade-$+2$
momentum/B-field anomaly center $Z_{+2}$ is the contact Euler grading operator itself:
$$[Z_{-2}, Z_{+2}] = \mathrm{contactEuler} \in \mathfrak{g}_0.$$ -/
theorem anomaly_minusTwo_bracket_plusTwo_eq_contactEuler :
    ⁅anomalyGeneratorMinusTwo, anomalyGeneratorPlusTwo⁆ = contactEuler := by
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  funext i
  change (anomalyGeneratorMinusTwo : End55) ((anomalyGeneratorPlusTwo : End55) x) i -
      (anomalyGeneratorPlusTwo : End55) ((anomalyGeneratorMinusTwo : End55) x) i =
    contactEulerEnd x i
  fin_cases i <;>
    simp [anomalyGeneratorMinusTwo, anomalyGeneratorPlusTwo,
      negativeTwoGenerator, positiveTwoGenerator,
      splitRankTwo, splitRankTwoEnd, splitPairing,
      embedOuterMinus, embedOuterPlus, outerBasis,
      contactEulerEnd, contactWeightR, contactWeight]

/-- The three generators `(anomalyGeneratorPlusTwo, anomalyGeneratorMinusTwo, contactEuler)`
form an exact $\mathfrak{sl}_2(\mathbb{R})$ triad at contact grades `(+2, -2, 0)`. -/
theorem anomaly_centers_form_contact_sl2_triad :
    ⁅contactEuler, anomalyGeneratorPlusTwo⁆ = (2 : ℝ) • anomalyGeneratorPlusTwo ∧
    ⁅contactEuler, anomalyGeneratorMinusTwo⁆ = (-2 : ℝ) • anomalyGeneratorMinusTwo ∧
    ⁅anomalyGeneratorMinusTwo, anomalyGeneratorPlusTwo⁆ = contactEuler := by
  refine ⟨?_, ?_, anomaly_minusTwo_bracket_plusTwo_eq_contactEuler⟩
  · have hpos : endCommutator contactEulerEnd (anomalyGeneratorPlusTwo : End55) =
        ((2 : ℤ) : ℝ) • (anomalyGeneratorPlusTwo : End55) :=
      anomalyGeneratorPlusTwo_mem_grade_two
    apply Subtype.ext
    change endCommutator contactEulerEnd (anomalyGeneratorPlusTwo : End55) =
      (2 : ℝ) • (anomalyGeneratorPlusTwo : End55)
    simpa using hpos
  · have hneg : endCommutator contactEulerEnd (anomalyGeneratorMinusTwo : End55) =
        ((-2 : ℤ) : ℝ) • (anomalyGeneratorMinusTwo : End55) :=
      anomalyGeneratorMinusTwo_mem_grade_neg_two
    apply Subtype.ext
    change endCommutator contactEulerEnd (anomalyGeneratorMinusTwo : End55) =
      (-2 : ℝ) • (anomalyGeneratorMinusTwo : End55)
    simpa using hneg

/-! ## 5. Closure Under $O(5,5)$ T-Duality (`tDualityEnd` and `tDualityLie`) -/

/-- The $O(5,5)$ T-duality / Witt outer-sheet exchange operator on `Vector55`,
acting by coordinate permutation `dualIndex` (`0 ↔ 8`, `1 ↔ 9`, fixing `2..7`). -/
def tDualityEnd : End55 where
  toFun x i := x (dualIndex i)
  map_add' x y := by ext i; rfl
  map_smul' c x := by ext i; rfl

@[simp] theorem tDualityEnd_apply (x : Vector55) (i : Fin 10) :
    tDualityEnd x i = x (dualIndex i) := rfl

/-- `tDualityEnd` is a strict involution on `Vector55`. -/
@[simp] theorem tDualityEnd_apply_tDualityEnd (x : Vector55) :
    tDualityEnd (tDualityEnd x) = x := by
  funext i
  simp [tDualityEnd, dualIndex_involutive]

/-- `tDualityEnd` squares to the identity endomorphism. -/
theorem tDualityEnd_sq :
    tDualityEnd * tDualityEnd = 1 := by
  apply LinearMap.ext
  intro x
  exact tDualityEnd_apply_tDualityEnd x

/-- `tDualityEnd` is an exact isometry of the split $O(5,5)$ bilinear form `splitPairing`. -/
theorem splitPairing_tDualityEnd (x y : Vector55) :
    splitPairing (tDualityEnd x) (tDualityEnd y) = splitPairing x y := by
  simp [tDualityEnd, splitPairing, dualIndex]
  ring

/-- `tDualityEnd` is self-adjoint with respect to `splitPairing`. -/
theorem splitPairing_tDualityEnd_left (x y : Vector55) :
    splitPairing (tDualityEnd x) y = splitPairing x (tDualityEnd y) := by
  have h := splitPairing_tDualityEnd x (tDualityEnd y)
  simpa using h

/-- `tDualityEnd` swaps the negative outer null sheet into the positive outer null sheet. -/
@[simp] theorem tDualityEnd_embedOuterMinus (a : Outer2) :
    tDualityEnd (embedOuterMinus a) = embedOuterPlus a := by
  funext i
  fin_cases i <;> simp [tDualityEnd, dualIndex, embedOuterMinus, embedOuterPlus]

/-- `tDualityEnd` swaps the positive outer null sheet into the negative outer null sheet. -/
@[simp] theorem tDualityEnd_embedOuterPlus (a : Outer2) :
    tDualityEnd (embedOuterPlus a) = embedOuterMinus a := by
  funext i
  fin_cases i <;> simp [tDualityEnd, dualIndex, embedOuterMinus, embedOuterPlus]

/-- `tDualityEnd` fixes the middle 6-space pointwise. -/
@[simp] theorem tDualityEnd_embedMiddle (w : Middle6) :
    tDualityEnd (embedMiddle w) = embedMiddle w := by
  funext i
  fin_cases i <;> simp [tDualityEnd, dualIndex, embedMiddle]

/-- Conjugation by `tDualityEnd` negates the contact Euler grading operator. -/
theorem tDualityEnd_conjugates_contactEulerEnd :
    tDualityEnd * contactEulerEnd * tDualityEnd = -contactEulerEnd := by
  apply LinearMap.ext
  intro x
  funext i
  fin_cases i <;>
    simp [Module.End.mul_apply, tDualityEnd, contactEulerEnd,
      contactWeightR, contactWeight, dualIndex]

/-- Conjugation by `tDualityEnd` preserves the split-orthogonal Lie condition `IsSplitSkew`. -/
theorem isSplitSkew_tDualityConj {A : End55} (hA : IsSplitSkew A) :
    IsSplitSkew (tDualityEnd * A * tDualityEnd) := by
  intro x y
  change splitPairing (tDualityEnd (A (tDualityEnd x))) y +
      splitPairing x (tDualityEnd (A (tDualityEnd y))) = 0
  rw [splitPairing_tDualityEnd_left (A (tDualityEnd x)) y,
    ← splitPairing_tDualityEnd_left x (A (tDualityEnd y))]
  exact hA (tDualityEnd x) (tDualityEnd y)

/-- The $O(5,5)$ T-duality involution on the split-orthogonal Lie algebra `O55Lie`. -/
def tDualityLie (A : O55Lie) : O55Lie :=
  ⟨tDualityEnd * (A : End55) * tDualityEnd, isSplitSkew_tDualityConj A.property⟩

@[simp] theorem tDualityLie_coe (A : O55Lie) :
    ((tDualityLie A : O55Lie) : End55) = tDualityEnd * (A : End55) * tDualityEnd := rfl

/-- `tDualityLie` is an involution on `O55Lie`. -/
@[simp] theorem tDualityLie_involutive (A : O55Lie) :
    tDualityLie (tDualityLie A) = A := by
  apply Subtype.ext
  calc
    tDualityEnd * (tDualityEnd * (A : End55) * tDualityEnd) * tDualityEnd
        = (tDualityEnd * tDualityEnd) * (A : End55) * (tDualityEnd * tDualityEnd) := by
          noncomm_ring
    _ = 1 * (A : End55) * 1 := by rw [tDualityEnd_sq]
    _ = (A : End55) := by noncomm_ring

/-- `tDualityLie` preserves the Lie bracket on `O55Lie`. -/
theorem tDualityLie_bracket (A B : O55Lie) :
    tDualityLie ⁅A, B⁆ = ⁅tDualityLie A, tDualityLie B⁆ := by
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  change tDualityEnd (((A : End55) * (B : End55) - (B : End55) * (A : End55)) (tDualityEnd x)) =
    ((tDualityEnd * (A : End55) * tDualityEnd) * (tDualityEnd * (B : End55) * tDualityEnd) -
      (tDualityEnd * (B : End55) * tDualityEnd) * (tDualityEnd * (A : End55) * tDualityEnd)) x
  simp [Module.End.mul_apply, tDualityEnd_apply_tDualityEnd]

/-- `tDualityLie` negates the contact Euler grading element. -/
theorem tDualityLie_contactEuler :
    tDualityLie contactEuler = -contactEuler := by
  apply Subtype.ext
  exact tDualityEnd_conjugates_contactEulerEnd

/-- `contactEulerEnd` anticommutes with `tDualityEnd` on vectors. -/
theorem contactEulerEnd_tDualityEnd (y : Vector55) :
    contactEulerEnd (tDualityEnd y) = -tDualityEnd (contactEulerEnd y) := by
  funext i
  fin_cases i <;>
    simp [contactEulerEnd, tDualityEnd, contactWeightR, contactWeight, dualIndex]

/-- `tDualityLie` maps every homogeneous element of contact grade `k` to contact grade `-k`. -/
theorem tDualityLie_maps_grade_to_neg_grade
    {k : ℤ} {A : O55Lie} (hA : A ∈ realContactGradeSpace k) :
    tDualityLie A ∈ realContactGradeSpace (-k) := by
  change IsContactGrade (-k) (tDualityLie A)
  change IsContactGrade k A at hA
  unfold IsContactGrade at hA ⊢
  have hcomm :
      endCommutator contactEulerEnd (tDualityEnd * (A : End55) * tDualityEnd) =
        -(tDualityEnd * endCommutator contactEulerEnd (A : End55) * tDualityEnd) := by
    apply LinearMap.ext
    intro x
    simp [endCommutator, Module.End.mul_apply, contactEulerEnd_tDualityEnd,
      sub_eq_add_neg, add_comm]
  change endCommutator contactEulerEnd (tDualityEnd * (A : End55) * tDualityEnd) =
    ((-k : ℤ) : ℝ) • (tDualityEnd * (A : End55) * tDualityEnd)
  rw [hcomm, hA]
  apply LinearMap.ext
  intro x
  simp [Module.End.mul_apply, neg_smul]

/-- `tDualityLie` acts on `splitRankTwo u v` by applying `tDualityEnd` to both arguments. -/
theorem tDualityLie_splitRankTwo (u v : Vector55) :
    tDualityLie (splitRankTwo u v) = splitRankTwo (tDualityEnd u) (tDualityEnd v) := by
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  change tDualityEnd (splitRankTwoEnd u v (tDualityEnd x)) =
    splitRankTwoEnd (tDualityEnd u) (tDualityEnd v) x
  simp [splitRankTwoEnd, splitPairing_tDualityEnd_left]

/-- `tDualityLie` swaps positive and negative grade-$\pm 1$ generators. -/
theorem tDualityLie_positiveOneGenerator (a : Outer2) (w : Middle6) :
    tDualityLie (positiveOneGenerator a w) = -negativeOneGenerator a w := by
  unfold positiveOneGenerator negativeOneGenerator
  rw [tDualityLie_splitRankTwo, tDualityEnd_embedMiddle, tDualityEnd_embedOuterPlus]
  exact splitRankTwo_swap (embedOuterMinus a) (embedMiddle w)

theorem tDualityLie_negativeOneGenerator (a : Outer2) (w : Middle6) :
    tDualityLie (negativeOneGenerator a w) = -positiveOneGenerator a w := by
  unfold positiveOneGenerator negativeOneGenerator
  rw [tDualityLie_splitRankTwo, tDualityEnd_embedOuterMinus, tDualityEnd_embedMiddle]
  exact splitRankTwo_swap (embedMiddle w) (embedOuterPlus a)

/-- `tDualityLie` exchanges `positiveTwoGenerator a b` and `negativeTwoGenerator a b`. -/
theorem tDualityLie_positiveTwoGenerator (a b : Outer2) :
    tDualityLie (positiveTwoGenerator a b) = negativeTwoGenerator a b := by
  unfold positiveTwoGenerator negativeTwoGenerator
  rw [tDualityLie_splitRankTwo, tDualityEnd_embedOuterPlus, tDualityEnd_embedOuterPlus]

theorem tDualityLie_negativeTwoGenerator (a b : Outer2) :
    tDualityLie (negativeTwoGenerator a b) = positiveTwoGenerator a b := by
  unfold positiveTwoGenerator negativeTwoGenerator
  rw [tDualityLie_splitRankTwo, tDualityEnd_embedOuterMinus, tDualityEnd_embedOuterMinus]

/-- **T-Duality Exchanges the Grade-$\pm 2$ Anomaly Generators**:
The $O(5,5)$ T-duality involution sends the grade-$+2$ Kalb–Ramond / Heisenberg
anomaly generator $Z_{+2}$ to the grade-$-2$ winding anomaly generator $Z_{-2}$,
