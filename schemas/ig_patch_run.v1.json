{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ig.patch_run.v1",
  "type": "object",
  "required": [
    "schema_version",
    "source_graph_hash",
    "algorithm_version"
  ],
  "anyOf": [
    {"required": ["run_id"]},
    {"required": ["patch_run_id"]}
  ],
  "properties": {
    "_key": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "patch_run_id": {"type": "string", "minLength": 1},
    "schema_version": {"enum": ["ig.patch_run.v1", "ig_patch_run.v1"]},
    "created_at": {"type": "string", "minLength": 1},
    "source_graph_hash": {"type": "string", "minLength": 1},
    "algorithm_version": {"enum": ["chiral_patch_hashes.v1.1", "chiral_patch_hashes.v1.2"]},
    "fingerprints_available": {"type": "boolean"},
    "authority_level": {"enum": ["heuristic", "derived", "formal-adjacent", "formal"]},
    "claim_scope": {"type": "string", "minLength": 1},
    "non_overclaim": {"const": true},
    "proof_link": {"type": "string"}
  },
  "additionalProperties": true
}
