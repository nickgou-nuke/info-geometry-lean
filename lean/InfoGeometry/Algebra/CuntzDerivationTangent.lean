import InfoGeometry.Algebra.CuntzN

/-!
# Cuntz tangent families generated by star derivations

This is the algebraic infinitesimal layer: a derivation of a fixed star-ring
Cuntz presentation produces a first-order tangent family. It uses only the
native Cuntz isometry and range-sum equations.
-/

namespace InfoGeometry.Algebra.Cuntz

variable {A : Type*} [Ring A] [StarRing A]
variable {N : ℕ}

/-- An additive star derivation of a unital star ring. -/
def StarDerivationLaws (D : A →+ A) : Prop :=
  (∀ x y, D (x * y) = D x * y + x * D y) ∧
  (∀ x, D (star x) = star (D x))

def StarDerivation := {D : A →+ A // StarDerivationLaws D}

namespace StarDerivation

instance : CoeFun (StarDerivation (A := A)) (fun _ => A → A) :=
  ⟨fun D => D.1⟩

protected theorem leibniz' (D : StarDerivation (A := A)) (x y : A) :
    D (x * y) = D x * y + x * D y := D.2.1 x y

protected theorem star' (D : StarDerivation (A := A)) (x : A) :
    D (star x) = star (D x) := D.2.2 x

end StarDerivation

/-- Inner star derivation generated by a skew-adjoint element. -/
def innerStarDerivation (K : A) (hK : star K = -K) : StarDerivation (A := A) := by
  let D : A →+ A :=
    { toFun := fun x => K * x - x * K
      map_zero' := by
        simp only [mul_zero, zero_mul, sub_zero]
      map_add' := by intro x y; noncomm_ring }
  refine ⟨D, ?_⟩
  constructor
  · intro x y
    change K * (x * y) - (x * y) * K =
      (K * x - x * K) * y + x * (K * y - y * K)
    noncomm_ring
  · intro x
    change K * star x - star x * K = star (K * x - x * K)
    rw [star_sub, star_mul, star_mul, hK]
    noncomm_ring

lemma StarDerivation.map_zero (D : StarDerivation (A := A)) : D 0 = 0 :=
  D.1.map_zero

lemma StarDerivation.map_one (D : StarDerivation (A := A)) : D 1 = 0 := by
  have h := D.leibniz' (1 : A) 1
  have h' := congrArg (fun z => z - D 1) h
  have hz : (0 : A) = D 1 := by
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using h'
  exact hz.symm

/-- First-order tangent equations for a Cuntz family. -/
def CuntzTangentLaws (O : CuntzNAlgebra (N := N) A) (X : Fin N → A) : Prop :=
  (∀ i j, star (X i) * O.S j + star (O.S i) * X j = 0) ∧
  (
    ∑ i : Fin N,
      (X i * star (O.S i) + O.S i * star (X i)) = 0)

def CuntzTangent (O : CuntzNAlgebra (N := N) A) :=
  {X : Fin N → A // CuntzTangentLaws O X}

namespace CuntzTangent

def X {A : Type*} [Ring A] [StarRing A] {N : ℕ}
    {O : CuntzNAlgebra (N := N) A} (T : CuntzTangent O) : Fin N → A := T.1

theorem tangent_isometry {A : Type*} [Ring A] [StarRing A] {N : ℕ}
    {O : CuntzNAlgebra (N := N) A} (T : CuntzTangent O) (i j : Fin N) :
    star (T.X i) * O.S j + star (O.S i) * T.X j = 0 := T.2.1 i j

theorem tangent_complete {A : Type*} [Ring A] [StarRing A] {N : ℕ}
    {O : CuntzNAlgebra (N := N) A} (T : CuntzTangent O) :
    ∑ i : Fin N,
      (T.X i * star (O.S i) + O.S i * star (T.X i)) = 0 := T.2.2

end CuntzTangent

/-- A star derivation produces a tangent to every algebraic Cuntz family. -/
noncomputable def StarDerivation.cuntzTangent
    {N : ℕ}
    (D : StarDerivation (A := A))
    (O : CuntzNAlgebra (N := N) A) :
    CuntzTangent O := by
  let X : Fin N → A := fun i => D (O.S i)
  have hD1 : D (1 : A) = 0 := D.map_one
  have hisometry (i j : Fin N) :
      D (star (O.S i) * O.S j) =
        star (X i) * O.S j + star (O.S i) * X j := by
    rw [D.leibniz', D.star']
  have hsum :
      D (∑ i : Fin N, O.S i * star (O.S i)) =
        ∑ i : Fin N, (X i * star (O.S i) + O.S i * star (X i)) := by
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [D.leibniz', D.star']
  refine ⟨X, ?_, ?_⟩
  · intro i j
    have hrel := congrArg D (O.isometry i j)
    rw [hisometry] at hrel
    by_cases hij : i = j
    · simpa [hij, hD1, D.map_zero] using hrel
    · simpa [hij, D.map_zero] using hrel
  · have hrel := congrArg D O.range_sum
    rw [hsum] at hrel
    simpa [hD1] using hrel

/-! ## Transport through a star-preserving operator representation -/

def TransportedCuntzTangentLaws
    {B : Type*} [Ring B] [StarRing B]
    (ρ : A →+* B) (O : CuntzNAlgebra (N := N) A)
    (T : CuntzTangent O) (Y : Fin N → B) : Prop :=
  (∀ i, Y i = ρ (T.X i)) ∧
  (∀ i j,
    star (Y i) * ρ (O.S j) + star (ρ (O.S i)) * Y j = 0
  ) ∧
  (
    ∑ i : Fin N,
      (Y i * star (ρ (O.S i)) +
        ρ (O.S i) * star (Y i)) = 0)

def TransportedCuntzTangent
    {B : Type*} [Ring B] [StarRing B]
    (ρ : A →+* B) (O : CuntzNAlgebra (N := N) A)
    (T : CuntzTangent O) :=
  {Y : Fin N → B // TransportedCuntzTangentLaws ρ O T Y}

namespace TransportedCuntzTangent

def Y {A B : Type*} [Ring A] [StarRing A] [Ring B] [StarRing B]
    {N : ℕ} (ρ : A →+* B) (O : CuntzNAlgebra (N := N) A)
    (T₀ : CuntzTangent O)
    (T : TransportedCuntzTangent ρ O T₀) : Fin N → B := T.1

theorem Y_eq {A B : Type*} [Ring A] [StarRing A] [Ring B] [StarRing B]
    {N : ℕ} (ρ : A →+* B) (O : CuntzNAlgebra (N := N) A)
    (T₀ : CuntzTangent O)
    (T : TransportedCuntzTangent ρ O T₀) (i : Fin N) :
    Y ρ O T₀ T i = ρ (CuntzTangent.X T₀ i) := T.2.1 i

theorem tangent_isometry {A B : Type*} [Ring A] [StarRing A] [Ring B] [StarRing B]
    {N : ℕ} (ρ : A →+* B) (O : CuntzNAlgebra (N := N) A)
    (T₀ : CuntzTangent O)
    (T : TransportedCuntzTangent ρ O T₀) (i j : Fin N) :
    star (Y ρ O T₀ T i) * ρ (O.S j) + star (ρ (O.S i)) * Y ρ O T₀ T j = 0 := T.2.2.1 i j

theorem tangent_complete {A B : Type*} [Ring A] [StarRing A] [Ring B] [StarRing B]
    {N : ℕ} (ρ : A →+* B) (O : CuntzNAlgebra (N := N) A)
    (T₀ : CuntzTangent O)
    (T : TransportedCuntzTangent ρ O T₀) :
    ∑ i : Fin N,
      (Y ρ O T₀ T i * star (ρ (O.S i)) + ρ (O.S i) * star (Y ρ O T₀ T i)) = 0 := T.2.2.2

end TransportedCuntzTangent

/-- A star-preserving ring representation transports a Cuntz tangent family. -/
def CuntzTangent.transport
    {B : Type*} [Ring B] [StarRing B]
    (ρ : A →+* B)
    (hstar : ∀ x, ρ (star x) = star (ρ x))
    (O : CuntzNAlgebra (N := N) A)
    (T : CuntzTangent O) :
    TransportedCuntzTangent ρ O T := by
  refine ⟨fun i => ρ (T.X i), ?_, ?_, ?_⟩
  · intro i
    rfl
  · intro i j
    have h := congrArg ρ (T.tangent_isometry i j)
    simpa [map_add, map_mul, hstar] using h
  · have h := congrArg ρ T.tangent_complete
    simpa [map_sum, map_add, map_mul, hstar] using h

end InfoGeometry.Algebra.Cuntz
