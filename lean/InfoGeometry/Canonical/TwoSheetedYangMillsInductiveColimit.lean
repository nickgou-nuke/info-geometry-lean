import InfoGeometry.OperatorAlgebra.PeirceSpine.Tetraktys
import Mathlib.Algebra.Star.Basic

/-!
# Two-sheet operator identities and functorial transport

This module records finite algebraic identities and their preservation by a
star-preserving ring homomorphism. It does not define an inductive colimit,
positivity structure, quantum dynamics, or a spectral mass gap.
-/

namespace CanonicalTwoSheetedInductiveColimit

open InfoGeometry.OperatorAlgebra.PeirceSpine

variable {B : Type*} [Ring B]

/-- The directed upper Peirce component. -/
def opZig (P A : B) : B := conePlus P A

/-- The directed lower Peirce component. -/
def opZag (P C : B) : B := coneMinus P C

/-- The self-adjoint grading expression, without a self-adjointness claim. -/
def opBitGrading (P : B) : B := invS P

/-- The symmetric two-sheet operator. -/
def opElectron (P A C : B) : B := genPhi P A C

/-- The signed two-sheet operator. -/
def opAxial (P A C : B) : B := genJ P A C

/-- The quadratic Peirce coupling generated by the two directed components. -/
def opQuadraticCoupling (P A C : B) : B := genV P A C

/-- The ordered difference of the two Peirce-cycle products. -/
def opSpinDipole (P A C : B) : B := genSig P A C

variable {P : B} (hP : P * P = P)
include hP

/-- The two directed Peirce components are square-zero. -/
theorem directed_components_square_zero (A C : B) :
    opZig P A * opZig P A = 0 ∧ opZag P C * opZag P C = 0 := by
  exact ⟨(archetype_A3_nilpotent_cones_and_tetraktys_table hP A C).1,
    (archetype_A3_nilpotent_cones_and_tetraktys_table hP A C).2.1⟩

/-- The symmetric and signed operators square to opposite quadratic Peirce
couplings, and their ordered product is the chiral cycle difference. -/
theorem two_sheet_tetraktys (A C : B) :
    opElectron P A C * opElectron P A C = opQuadraticCoupling P A C ∧
    opAxial P A C * opAxial P A C = -opQuadraticCoupling P A C ∧
    opAxial P A C * opElectron P A C = opSpinDipole P A C := by
  rcases archetype_A3_nilpotent_cones_and_tetraktys_table hP A C with
    ⟨_, _, hPhi, hJ, _, hJPhi, _, _, hSig, _, _, _, _, _⟩
  exact ⟨hPhi, hJ, hJPhi⟩

/-- The grading squares to one, changes sign on each directed component, and
fixes the quadratic coupling. -/
theorem grading_action (A C : B) :
    opBitGrading P * opBitGrading P = 1 ∧
    opBitGrading P * opZig P A * opBitGrading P = -opZig P A ∧
    opBitGrading P * opZag P C * opBitGrading P = -opZag P C ∧
    opBitGrading P * opQuadraticCoupling P A C * opBitGrading P =
      opQuadraticCoupling P A C := by
  rcases archetype_A2_peirce_cartan_grading_and_tangent_closure hP A C with
    ⟨hS, _, _, _, _, _, _⟩
  rcases archetype_A3_nilpotent_cones_and_tetraktys_table hP A C with
    ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _⟩
  refine ⟨hS, ?_, ?_, ?_⟩
  · simp only [opBitGrading, opZig, invS, conePlus]
    peirce_nf hP
  · simp only [opBitGrading, opZag, invS, coneMinus]
    peirce_nf hP
  · simp only [opBitGrading, opQuadraticCoupling, invS]
    peirce_nf hP

variable {B₁ B₂ : Type*} [Ring B₁] [StarRing B₁] [Ring B₂] [StarRing B₂]

/-- A star-preserving unital ring homomorphism preserves the two directed
components, their symmetric and signed combinations, and the quadratic
coupling. This is a one-map naturality result, not a colimit theorem. -/
theorem starRingHom_intertwines_two_sheeted_operators
    (f : B₁ →+* B₂) (hstar : ∀ x : B₁, f (star x) = star (f x))
    (P A C : B₁) :
    f (opBitGrading P) = opBitGrading (f P) ∧
    f (opZig P A) = opZig (f P) (f A) ∧
    f (opZag P C) = opZag (f P) (f C) ∧
    f (opElectron P A C) = opElectron (f P) (f A) (f C) ∧
    f (opAxial P A C) = opAxial (f P) (f A) (f C) ∧
    f (opQuadraticCoupling P A C) =
      opQuadraticCoupling (f P) (f A) (f C) ∧
    f (opSpinDipole P A C) = opSpinDipole (f P) (f A) (f C) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp [opBitGrading, invS, map_sub, map_one]
  · simp [opZig, conePlus, map_mul, map_sub, map_one]
  · simp [opZag, coneMinus, map_mul, map_sub, map_one]
  · simp [opElectron, genPhi, map_add]
    rw [show f (conePlus P A) = conePlus (f P) (f A) by
      simp [conePlus, map_mul, map_sub, map_one],
      show f (coneMinus P C) = coneMinus (f P) (f C) by
      simp [coneMinus, map_mul, map_sub, map_one]]
  · simp [opAxial, genJ, map_sub]
    rw [show f (conePlus P A) = conePlus (f P) (f A) by
      simp [conePlus, map_mul, map_sub, map_one],
      show f (coneMinus P C) = coneMinus (f P) (f C) by
      simp [coneMinus, map_mul, map_sub, map_one]]
  · simp [opQuadraticCoupling, genV, anticomm, map_add, map_mul]
    rw [show f (conePlus P A) = conePlus (f P) (f A) by
      simp [conePlus, map_mul, map_sub, map_one],
      show f (coneMinus P C) = coneMinus (f P) (f C) by
      simp [coneMinus, map_mul, map_sub, map_one]]
  · have hPlus : f (conePlus P A) = conePlus (f P) (f A) := by
      simp [conePlus, map_mul, map_sub, map_one]
    have hMinus : f (coneMinus P C) = coneMinus (f P) (f C) := by
      simp [coneMinus, map_mul, map_sub, map_one]
    unfold opSpinDipole genSig InfoGeometry.OperatorAlgebra.PeirceSpine.comm
    rw [map_sub, map_mul, map_mul, hPlus, hMinus]

end CanonicalTwoSheetedInductiveColimit
