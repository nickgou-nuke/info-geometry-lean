import Mathlib.Algebra.Colimit.DirectLimit
import InfoGeometry.Algebra.InductiveSuperClosureLemmas

/-!
# Direct-limit superclosure lemmas

This file builds the actual algebraic direct limit of a one-step inductive
system of semirings and proves that the finite superclosure laws hold on the
explicit canonical images.

The maps are explicit:

* `bondMap bond m n h : Stage m →+* Stage n` is the iterated transition map;
* `directLimitOf bond n : Stage n →+* DirectLimitSuperClosure bond` is the
  canonical map into the direct limit;
* `directLimitLift bond toLimit hcone` is the universal map out of the direct
  limit induced by a compatible cone.
-/

noncomputable section

set_option linter.unnecessarySimpa false

namespace InfoGeometry.Algebra.DirectLimitSuperClosureLemmas

open InfoGeometry.Algebra.InductiveSuperClosureLemmas

universe u

variable {Stage : Nat → Type u} [∀ n : Nat, Semiring (Stage n)]

/-- Iterated transition map generated by one-step bonding homomorphisms. -/
def bondMap
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (m n : Nat) (h : m ≤ n) : Stage m →+* Stage n :=
  Nat.leRecOn h
    (C := fun n => Stage m →+* Stage n)
    (fun {k} ih => (bond k).comp ih)
    (RingHom.id (Stage m))

@[simp]
theorem bondMap_refl
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (m : Nat) :
    bondMap bond m m le_rfl = RingHom.id (Stage m) := by
  simpa [bondMap] using
    (Nat.leRecOn_self
      (C := fun n => Stage m →+* Stage n)
      (next := fun {k} ih => (bond k).comp ih)
      (x := RingHom.id (Stage m)))

@[simp]
theorem bondMap_succ
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (m n : Nat) (h : m ≤ n) :
    bondMap bond m (n + 1) (Nat.le_trans h (Nat.le_succ n))
      = (bond n).comp (bondMap bond m n h) := by
  unfold bondMap
  rw [Nat.leRecOn_trans h (Nat.le_succ n)]
  rw [Nat.leRecOn_succ']

/-- Iterated maps compose according to the directed-system law. -/
theorem bondMap_trans
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (m n k : Nat) (hmn : m ≤ n) (hnk : n ≤ k) :
    bondMap bond m k (hmn.trans hnk) =
      Nat.leRecOn hnk
        (fun {k} ih => (bond k).comp ih)
        (bondMap bond m n hmn) := by
  simpa [bondMap] using
    (Nat.leRecOn_trans hmn hnk
      (next := fun {k} ih => (bond k).comp ih)
      (x := RingHom.id (Stage m)))

/-- Pointwise form of `bondMap_trans`. -/
theorem bondMap_apply_trans
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (m n k : Nat) (hmn : m ≤ n) (hnk : n ≤ k)
    (x : Stage m) :
    bondMap bond m k (hmn.trans hnk) x =
      bondMap bond n k hnk (bondMap bond m n hmn x) := by
  refine Nat.le_induction
    (m := n)
    (P := fun t ht =>
      bondMap bond m t (Nat.le_trans hmn ht) x =
        bondMap bond n t ht (bondMap bond m n hmn x))
    ?base ?succ k hnk
  · simpa using
      congrArg (fun φ : Stage m →+* Stage n => φ x) (bondMap_refl bond n)
  · intro t ht ih
    have hmt : m ≤ t := Nat.le_trans hmn ht
    rw [bondMap_succ bond m t hmt, bondMap_succ bond n t ht]
    exact congrArg (fun y => bond t y) ih

/-- The semiring tower generated by one-step bonds is a directed system. -/
instance bondDirectedSystem
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1)) :
    DirectedSystem Stage (fun m n h => bondMap bond m n h) where
  map_self := by
    intro m x
    simpa using congrArg (fun φ : Stage m →+* Stage m => φ x) (bondMap_refl bond m)
  map_map := by
    intro k j i hij hjk x
    simpa using (bondMap_apply_trans bond i j k hij hjk x).symm

/-- The algebraic direct limit of the finite superclosure chain. -/
abbrev DirectLimitSuperClosure
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1)) :=
  _root_.DirectLimit Stage (fun m n h => bondMap bond m n h)

/-- Explicit canonical map from a finite stage into the direct limit. -/
def directLimitOf
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (n : Nat) : Stage n →+* DirectLimitSuperClosure bond :=
  DirectLimit.Ring.of Stage (fun m n h => bondMap bond m n h) n

@[simp]
theorem directLimitOf_apply
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (n : Nat) (x : Stage n) :
    directLimitOf bond n x =
      (⟦⟨n, x⟩⟧ : DirectLimitSuperClosure bond) :=
  rfl

@[simp]
theorem directLimitOf_bondMap
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (m n : Nat) (h : m ≤ n) (x : Stage m) :
    directLimitOf bond n (bondMap bond m n h x) =
      directLimitOf bond m x := by
  exact DirectLimit.Ring.of_f h x

@[simp]
theorem directLimitOf_bond
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (n : Nat) (x : Stage n) :
    directLimitOf bond (n + 1) (bond n x) =
      directLimitOf bond n x := by
  have hmap :
      bondMap bond n (n + 1) (Nat.le_succ n) x = bond n x := by
    have hφ :
        bondMap bond n (n + 1) (Nat.le_succ n) =
          (bond n).comp (RingHom.id (Stage n)) := by
      rw [bondMap_succ bond n n le_rfl, bondMap_refl]
    simpa using congrArg (fun φ : Stage n →+* Stage (n + 1) => φ x) hφ
  rw [← hmap]
  exact directLimitOf_bondMap bond n (n + 1) (Nat.le_succ n) x

/--
If finite-stage data are transported by the bonding maps, all their canonical
direct-limit images agree with the stage-zero image.
-/
theorem directLimitOf_eq_zero_stage
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (F : ∀ n : Nat, Stage n)
    (hF : ∀ n, bond n (F n) = F (n + 1)) :
    ∀ n : Nat, directLimitOf bond n (F n) = directLimitOf bond 0 (F 0) := by
  intro n
  induction n with
  | zero =>
      rfl
  | succ n ih =>
      rw [← hF n, directLimitOf_bond]
      exact ih

/--
Square-zero laws transported along the finite chain hold on every canonical
finite-stage image inside the algebraic direct limit.
-/
theorem directLimit_squareZero_all
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (Q : ∀ n : Nat, Stage n)
    (h0 : Q 0 * Q 0 = 0)
    (hQ : ∀ n, bond n (Q n) = Q (n + 1)) :
    ∀ n : Nat,
      directLimitOf bond n (Q n) * directLimitOf bond n (Q n) = 0 := by
  intro n
  have hstage : Q n * Q n = 0 :=
    squareZero_all bond Q h0 hQ n
  exact ringHom_preserves_square_zero (directLimitOf bond n) hstage

/--
Idempotent laws transported along the finite chain hold on every canonical
finite-stage image inside the algebraic direct limit.
-/
theorem directLimit_idempotent_all
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (P : ∀ n : Nat, Stage n)
    (h0 : P 0 * P 0 = P 0)
    (hP : ∀ n, bond n (P n) = P (n + 1)) :
    ∀ n : Nat,
      directLimitOf bond n (P n) * directLimitOf bond n (P n) =
        directLimitOf bond n (P n) := by
  intro n
  have hstage : P n * P n = P n :=
    idempotent_all bond P h0 hP n
  exact ringHom_preserves_idempotent (directLimitOf bond n) hstage

/--
Compatibility of a cone out of the one-step chain, stated directly on the
one-step maps.
-/
def CompatibleCone
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit : ∀ n : Nat, Stage n →+* Limit) : Prop :=
  ∀ (n : Nat) (x : Stage n), toLimit (n + 1) (bond n x) = toLimit n x

/-- A compatible one-step cone is compatible with every iterated transition. -/
theorem compatibleCone_bondMap
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit : ∀ n : Nat, Stage n →+* Limit)
    (hcone : CompatibleCone bond toLimit)
    (m n : Nat) (h : m ≤ n) (x : Stage m) :
    toLimit n (bondMap bond m n h x) = toLimit m x := by
  refine Nat.le_induction
    (m := m)
    (P := fun t ht => toLimit t (bondMap bond m t ht x) = toLimit m x)
    ?base ?succ n h
  · simp
  · intro t hmt ih
    rw [bondMap_succ bond m t hmt]
    exact (hcone t (bondMap bond m t hmt x)).trans ih

/--
Universal map out of the direct limit induced by explicit compatible stage
maps.
-/
def directLimitLift
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit : ∀ n : Nat, Stage n →+* Limit)
    (hcone : CompatibleCone bond toLimit) :
    DirectLimitSuperClosure bond →+* Limit :=
  DirectLimit.Ring.lift
    Stage
    (fun m n h => bondMap bond m n h)
    Limit
    toLimit
    (fun m n h x => compatibleCone_bondMap bond toLimit hcone m n h x)

@[simp]
theorem directLimitLift_of
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit : ∀ n : Nat, Stage n →+* Limit)
    (hcone : CompatibleCone bond toLimit)
    (n : Nat) (x : Stage n) :
    directLimitLift bond toLimit hcone (directLimitOf bond n x) = toLimit n x := by
  rfl

/--
Categorical uniqueness of the direct-limit lift.

Any semiring homomorphism out of the algebraic direct limit is determined by
its values on the canonical finite-stage maps.
-/
theorem directLimitLift_unique
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit : ∀ n : Nat, Stage n →+* Limit)
    (hcone : CompatibleCone bond toLimit)
    (g : DirectLimitSuperClosure bond →+* Limit)
    (hg : ∀ n : Nat, g.comp (directLimitOf bond n) = toLimit n) :
    g = directLimitLift bond toLimit hcone := by
  apply DirectLimit.Ring.hom_ext
  intro n
  ext x
  change g (directLimitOf bond n x) =
    directLimitLift bond toLimit hcone (directLimitOf bond n x)
  calc
    g (directLimitOf bond n x) = toLimit n x := by
      exact congrArg (fun φ : Stage n →+* Limit => φ x) (hg n)
    _ = directLimitLift bond toLimit hcone (directLimitOf bond n x) := by
      exact (directLimitLift_of bond toLimit hcone n x).symm

/--
Two compatible cones out of the same direct system induce the same map from the
direct limit when they agree on every finite stage.
-/
theorem directLimitLift_ext
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit₁ toLimit₂ : ∀ n : Nat, Stage n →+* Limit)
    (hcone₁ : CompatibleCone bond toLimit₁)
    (hcone₂ : CompatibleCone bond toLimit₂)
    (hstage : ∀ n : Nat, toLimit₁ n = toLimit₂ n) :
    directLimitLift bond toLimit₁ hcone₁ =
      directLimitLift bond toLimit₂ hcone₂ := by
  apply DirectLimit.Ring.hom_ext
  intro n
  ext x
  change directLimitLift bond toLimit₁ hcone₁ (directLimitOf bond n x) =
    directLimitLift bond toLimit₂ hcone₂ (directLimitOf bond n x)
  rw [directLimitLift_of, directLimitLift_of, hstage n]

/--
Functorial readback from the direct limit to an external compatible target:
square-zero laws transported to the direct limit and then lifted are the same
square-zero laws seen directly by the compatible cone.
-/
theorem directLimitLift_squareZero_all
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit : ∀ n : Nat, Stage n →+* Limit)
    (hcone : CompatibleCone bond toLimit)
    (Q : ∀ n : Nat, Stage n)
    (h0 : Q 0 * Q 0 = 0)
    (hQ : ∀ n, bond n (Q n) = Q (n + 1)) :
    ∀ n : Nat,
      directLimitLift bond toLimit hcone (directLimitOf bond n (Q n)) *
          directLimitLift bond toLimit hcone (directLimitOf bond n (Q n)) =
        0 := by
  intro n
  simp only [directLimitLift_of]
  have hstage : Q n * Q n = 0 :=
    squareZero_all bond Q h0 hQ n
  exact ringHom_preserves_square_zero (toLimit n) hstage

/--
Functorial readback from the direct limit to an external compatible target:
idempotent laws transported to the direct limit and then lifted are the same
idempotent laws seen directly by the compatible cone.
-/
theorem directLimitLift_idempotent_all
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit : ∀ n : Nat, Stage n →+* Limit)
    (hcone : CompatibleCone bond toLimit)
    (P : ∀ n : Nat, Stage n)
    (h0 : P 0 * P 0 = P 0)
    (hP : ∀ n, bond n (P n) = P (n + 1)) :
    ∀ n : Nat,
      directLimitLift bond toLimit hcone (directLimitOf bond n (P n)) *
          directLimitLift bond toLimit hcone (directLimitOf bond n (P n)) =
        directLimitLift bond toLimit hcone (directLimitOf bond n (P n)) := by
  intro n
  simp only [directLimitLift_of]
  have hstage : P n * P n = P n :=
    idempotent_all bond P h0 hP n
  exact ringHom_preserves_idempotent (toLimit n) hstage

/--
Functorial readback from the direct limit to an external compatible target:
single-supercharge closure transported to the direct limit and then lifted is
the same closure seen directly by the compatible cone.
-/
theorem directLimitLift_superClosure_all
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit : ∀ n : Nat, Stage n →+* Limit)
    (hcone : CompatibleCone bond toLimit)
    (Q H Z : ∀ n : Nat, Stage n)
    (h0 : SuperClosureAt Q H Z 0)
    (hQ : ∀ n, bond n (Q n) = Q (n + 1))
    (hH : ∀ n, bond n (H n) = H (n + 1))
    (hZ : ∀ n, bond n (Z n) = Z (n + 1)) :
    ∀ n : Nat,
      anticommutator
          (directLimitLift bond toLimit hcone (directLimitOf bond n (Q n)))
          (directLimitLift bond toLimit hcone (directLimitOf bond n (Q n))) =
        directLimitLift bond toLimit hcone (directLimitOf bond n (H n)) +
          directLimitLift bond toLimit hcone (directLimitOf bond n (Z n)) := by
  intro n
  rw [directLimitLift_of, directLimitLift_of, directLimitLift_of]
  have hstage : SuperClosureAt Q H Z n :=
    superClosure_all bond Q H Z h0 hQ hH hZ n
  unfold SuperClosureAt at hstage
  calc
    anticommutator (toLimit n (Q n)) (toLimit n (Q n))
        = toLimit n (anticommutator (Q n) (Q n)) := by
          exact (map_anticommutator (toLimit n) (Q n) (Q n)).symm
    _ = toLimit n (H n + Z n) := by
          rw [hstage]
    _ = toLimit n (H n) + toLimit n (Z n) := by
          exact map_add (toLimit n) (H n) (Z n)

/--
Functorial readback from the direct limit to an external compatible target:
mixed odd-odd closure transported to the direct limit and then lifted is the
same closure seen directly by the compatible cone.
-/
theorem directLimitLift_mixedSuperClosure_all
    {Limit : Type u} [Semiring Limit]
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (toLimit : ∀ n : Nat, Stage n →+* Limit)
    (hcone : CompatibleCone bond toLimit)
    (QA QB K Z : ∀ n : Nat, Stage n)
    (h0 : MixedSuperClosureAt QA QB K Z 0)
    (hQA : ∀ n, bond n (QA n) = QA (n + 1))
    (hQB : ∀ n, bond n (QB n) = QB (n + 1))
    (hK : ∀ n, bond n (K n) = K (n + 1))
    (hZ : ∀ n, bond n (Z n) = Z (n + 1)) :
    ∀ n : Nat,
      anticommutator
          (directLimitLift bond toLimit hcone (directLimitOf bond n (QA n)))
          (directLimitLift bond toLimit hcone (directLimitOf bond n (QB n))) =
        directLimitLift bond toLimit hcone (directLimitOf bond n (K n)) +
          directLimitLift bond toLimit hcone (directLimitOf bond n (Z n)) := by
  intro n
  rw [directLimitLift_of, directLimitLift_of, directLimitLift_of, directLimitLift_of]
  have hstage : MixedSuperClosureAt QA QB K Z n :=
    mixedSuperClosure_all bond QA QB K Z h0 hQA hQB hK hZ n
  unfold MixedSuperClosureAt at hstage
  calc
    anticommutator (toLimit n (QA n)) (toLimit n (QB n))
        = toLimit n (anticommutator (QA n) (QB n)) := by
          exact (map_anticommutator (toLimit n) (QA n) (QB n)).symm
    _ = toLimit n (K n + Z n) := by
          rw [hstage]
    _ = toLimit n (K n) + toLimit n (Z n) := by
          exact map_add (toLimit n) (K n) (Z n)

/--
Single-supercharge closure holds on the canonical image of every finite stage
inside the direct limit.
-/
theorem directLimit_superClosure_all
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (Q H Z : ∀ n : Nat, Stage n)
    (h0 : SuperClosureAt Q H Z 0)
    (hQ : ∀ n, bond n (Q n) = Q (n + 1))
    (hH : ∀ n, bond n (H n) = H (n + 1))
    (hZ : ∀ n, bond n (Z n) = Z (n + 1)) :
    ∀ n : Nat,
      anticommutator (directLimitOf bond n (Q n)) (directLimitOf bond n (Q n)) =
        directLimitOf bond n (H n) + directLimitOf bond n (Z n) := by
  intro n
  have hstage : SuperClosureAt Q H Z n :=
    superClosure_all bond Q H Z h0 hQ hH hZ n
  unfold SuperClosureAt at hstage
  calc
    anticommutator (directLimitOf bond n (Q n)) (directLimitOf bond n (Q n))
        = directLimitOf bond n (anticommutator (Q n) (Q n)) := by
          exact (map_anticommutator (directLimitOf bond n) (Q n) (Q n)).symm
    _ = directLimitOf bond n (H n + Z n) := by
          rw [hstage]
    _ = directLimitOf bond n (H n) + directLimitOf bond n (Z n) := by
          exact map_add (directLimitOf bond n) (H n) (Z n)

/--
Single-supercharge closure in the direct limit, read at stage zero.
-/
theorem directLimit_superClosure_zeroStage
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (Q H Z : ∀ n : Nat, Stage n)
    (h0 : SuperClosureAt Q H Z 0)
    (hQ : ∀ n, bond n (Q n) = Q (n + 1))
    (hH : ∀ n, bond n (H n) = H (n + 1))
    (hZ : ∀ n, bond n (Z n) = Z (n + 1)) :
    ∀ n : Nat,
      anticommutator (directLimitOf bond n (Q n)) (directLimitOf bond n (Q n)) =
        directLimitOf bond 0 (H 0) + directLimitOf bond 0 (Z 0) := by
  intro n
  calc
    anticommutator (directLimitOf bond n (Q n)) (directLimitOf bond n (Q n))
        = directLimitOf bond n (H n) + directLimitOf bond n (Z n) := by
          exact directLimit_superClosure_all bond Q H Z h0 hQ hH hZ n
    _ = directLimitOf bond 0 (H 0) + directLimitOf bond 0 (Z 0) := by
          rw [directLimitOf_eq_zero_stage bond H hH n,
            directLimitOf_eq_zero_stage bond Z hZ n]

/--
Mixed odd-odd closure holds on the canonical image of every finite stage inside
the direct limit.
-/
theorem directLimit_mixedSuperClosure_all
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (QA QB K Z : ∀ n : Nat, Stage n)
    (h0 : MixedSuperClosureAt QA QB K Z 0)
    (hQA : ∀ n, bond n (QA n) = QA (n + 1))
    (hQB : ∀ n, bond n (QB n) = QB (n + 1))
    (hK : ∀ n, bond n (K n) = K (n + 1))
    (hZ : ∀ n, bond n (Z n) = Z (n + 1)) :
    ∀ n : Nat,
      anticommutator (directLimitOf bond n (QA n)) (directLimitOf bond n (QB n)) =
        directLimitOf bond n (K n) + directLimitOf bond n (Z n) := by
  intro n
  have hstage : MixedSuperClosureAt QA QB K Z n :=
    mixedSuperClosure_all bond QA QB K Z h0 hQA hQB hK hZ n
  unfold MixedSuperClosureAt at hstage
  calc
    anticommutator (directLimitOf bond n (QA n)) (directLimitOf bond n (QB n))
        = directLimitOf bond n (anticommutator (QA n) (QB n)) := by
          exact (map_anticommutator (directLimitOf bond n) (QA n) (QB n)).symm
    _ = directLimitOf bond n (K n + Z n) := by
          rw [hstage]
    _ = directLimitOf bond n (K n) + directLimitOf bond n (Z n) := by
          exact map_add (directLimitOf bond n) (K n) (Z n)

/--
Mixed odd-odd closure in the direct limit, read at stage zero.
-/
theorem directLimit_mixedSuperClosure_zeroStage
    (bond : ∀ n : Nat, Stage n →+* Stage (n + 1))
    (QA QB K Z : ∀ n : Nat, Stage n)
    (h0 : MixedSuperClosureAt QA QB K Z 0)
    (hQA : ∀ n, bond n (QA n) = QA (n + 1))
    (hQB : ∀ n, bond n (QB n) = QB (n + 1))
    (hK : ∀ n, bond n (K n) = K (n + 1))
    (hZ : ∀ n, bond n (Z n) = Z (n + 1)) :
    ∀ n : Nat,
      anticommutator (directLimitOf bond n (QA n)) (directLimitOf bond n (QB n)) =
        directLimitOf bond 0 (K 0) + directLimitOf bond 0 (Z 0) := by
  intro n
  calc
    anticommutator (directLimitOf bond n (QA n)) (directLimitOf bond n (QB n))
        = directLimitOf bond n (K n) + directLimitOf bond n (Z n) := by
          exact directLimit_mixedSuperClosure_all bond QA QB K Z h0 hQA hQB hK hZ n
    _ = directLimitOf bond 0 (K 0) + directLimitOf bond 0 (Z 0) := by
          rw [directLimitOf_eq_zero_stage bond K hK n,
            directLimitOf_eq_zero_stage bond Z hZ n]

end InfoGeometry.Algebra.DirectLimitSuperClosureLemmas
