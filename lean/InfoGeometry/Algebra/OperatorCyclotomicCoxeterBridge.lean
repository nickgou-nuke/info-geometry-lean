import InfoGeometry.Algebra.OperatorCyclotomicParafermions
import Mathlib.GroupTheory.Coxeter.Basic

/-! # Coxeter reflection representation generated by a cyclotomic unit

An order-six unit is not itself a pair of reflections. This file constructs
the two reflections on the doubled operator carrier `B × B`: the coordinate
swap and its twist by the block rotation associated to the unit. Their
products are inverse rotations, so a sixth-power relation gives a genuine
`G₂ = I₂(6)` Coxeter representation. -/

namespace InfoGeometry.Algebra.OperatorCyclotomicCoxeterBridge

open InfoGeometry.Algebra.OperatorCyclotomicParafermions

variable {B : Type*} [Ring B]

/-- The coordinate-swap reflection. -/
def blockSwap : Equiv.Perm (B × B) where
  toFun p := (p.2, p.1)
  invFun p := (p.2, p.1)
  left_inv := by intro p; cases p; rfl
  right_inv := by intro p; cases p; rfl

/-- The block rotation corresponding to a unit and its inverse. -/
def blockRotation (g : Bˣ) : Equiv.Perm (B × B) where
  toFun p := ((g : B) * p.1, (↑(g⁻¹) : B) * p.2)
  invFun p := ((↑(g⁻¹) : B) * p.1, (g : B) * p.2)
  left_inv := by
    intro p
    rcases p with ⟨x, y⟩
    apply Prod.ext <;> simp [mul_assoc]
  right_inv := by
    intro p
    rcases p with ⟨x, y⟩
    apply Prod.ext <;> simp [mul_assoc]

/-- The second reflection is the block rotation followed by the swap. -/
def blockTwistedReflection (g : Bˣ) : Equiv.Perm (B × B) :=
  blockRotation g * blockSwap

@[simp] theorem blockSwap_apply (p : B × B) :
    blockSwap p = (p.2, p.1) := rfl

@[simp] theorem blockRotation_apply (g : Bˣ) (p : B × B) :
    blockRotation g p = ((g : B) * p.1, (↑(g⁻¹) : B) * p.2) := rfl

@[simp] theorem blockTwistedReflection_apply (g : Bˣ) (p : B × B) :
    blockTwistedReflection g p = ((g : B) * p.2, (↑(g⁻¹) : B) * p.1) := by
  rfl

private theorem blockRotation_pow_apply (g : Bˣ) (n : ℕ) (x y : B) :
    (blockRotation g ^ n) (x, y) =
      ((g : B) ^ n * x, (↑(g⁻¹) : B) ^ n * y) := by
  induction n generalizing x y with
  | zero => simp [blockRotation]
  | succ n ih =>
      rw [pow_succ, Equiv.Perm.mul_apply]
      simp only [blockRotation_apply]
      have ih' := ih ((g : B) * x) ((↑(g⁻¹) : B) * y)
      rw [ih']
      apply Prod.ext <;> simp [pow_succ, mul_assoc]

/-- A coefficient unit of sixth power one gives a block rotation of sixth
power one. -/
theorem blockRotation_pow_six (g : Bˣ) (hg : g ^ 6 = 1) :
    blockRotation g ^ 6 = 1 := by
  apply Equiv.ext
  intro p
  rcases p with ⟨x, y⟩
  rw [blockRotation_pow_apply g 6 x y]
  have hval : (g : B) ^ 6 = 1 := congrArg Units.val hg
  have hinv : (g⁻¹ : Bˣ) ^ 6 = 1 := by
    calc
      (g⁻¹ : Bˣ) ^ 6 = (g ^ 6)⁻¹ := by simp [inv_pow]
      _ = 1 := by rw [hg]; simp
  have hinvval : (↑(g⁻¹) : B) ^ 6 = 1 := congrArg Units.val hinv
  simp [hval, hinvval]

private theorem blockSwap_sq : blockSwap (B := B) ^ 2 = 1 := by
  apply Equiv.ext
  intro p
  cases p
  rfl

private theorem blockTwistedReflection_sq (g : Bˣ) :
    blockTwistedReflection g ^ 2 = 1 := by
  apply Equiv.ext
  intro p
  rcases p with ⟨x, y⟩
  change blockTwistedReflection g (blockTwistedReflection g (x, y)) = (x, y)
  simp only [blockTwistedReflection_apply]
  apply Prod.ext <;> simp [mul_assoc]

private theorem blockReflection_products (g : Bˣ) :
    blockSwap (B := B) * blockTwistedReflection g = blockRotation g⁻¹ ∧
    blockTwistedReflection g * blockSwap (B := B) = blockRotation g := by
  constructor <;> apply Equiv.ext <;> intro p <;> rcases p with ⟨x, y⟩
  · simp [blockTwistedReflection, blockSwap, blockRotation, Equiv.Perm.mul_apply,
      mul_assoc]
  · simp [blockTwistedReflection, blockSwap, blockRotation, Equiv.Perm.mul_apply,
      mul_assoc]

private theorem blockReflection_products_pow_six (g : Bˣ) (hg : g ^ 6 = 1) :
    (blockSwap (B := B) * blockTwistedReflection g) ^ 6 = 1 ∧
    (blockTwistedReflection g * blockSwap (B := B)) ^ 6 = 1 := by
  obtain ⟨h₁, h₂⟩ := blockReflection_products g
  have hinv : (g⁻¹ : Bˣ) ^ 6 = 1 := by
    calc
      (g⁻¹ : Bˣ) ^ 6 = (g ^ 6)⁻¹ := by simp [inv_pow]
      _ = 1 := by rw [hg]; simp
  exact ⟨by rw [h₁]; exact blockRotation_pow_six _ hinv,
    by rw [h₂]; exact blockRotation_pow_six g hg⟩

/-- The swap and twisted swap satisfy the `G₂ = I₂(6)` Coxeter relations. -/
theorem blockReflections_liftable (g : Bˣ) (hg : g ^ 6 = 1) :
    (CoxeterMatrix.G₂ : CoxeterMatrix (Fin 2)).IsLiftable
      (fun i => if i = 0 then blockSwap (B := B) else blockTwistedReflection g) := by
  intro i j
  fin_cases i <;> fin_cases j
  · simpa [pow_two] using blockSwap_sq (B := B)
  · exact (blockReflection_products_pow_six g hg).1
  · exact (blockReflection_products_pow_six g hg).2
  · simpa [pow_two] using blockTwistedReflection_sq g

/-- The resulting rank-two Coxeter representation on the doubled operator
carrier. -/
noncomputable def g2BlockOperatorRep (g : Bˣ) (hg : g ^ 6 = 1) :
    (CoxeterMatrix.G₂).Group →* Equiv.Perm (B × B) :=
  (CoxeterMatrix.G₂).toCoxeterSystem.lift
    ⟨(fun i => if i = 0 then blockSwap (B := B) else blockTwistedReflection g),
      blockReflections_liftable g hg⟩

@[simp] theorem g2BlockOperatorRep_apply_simple_zero (g : Bˣ)
    (hg : g ^ 6 = 1) :
    g2BlockOperatorRep g hg ((CoxeterMatrix.G₂).simple 0) =
      blockSwap (B := B) := by
  exact CoxeterSystem.lift_apply_simple
    (CoxeterMatrix.G₂).toCoxeterSystem (blockReflections_liftable g hg) 0

@[simp] theorem g2BlockOperatorRep_apply_simple_one (g : Bˣ)
    (hg : g ^ 6 = 1) :
    g2BlockOperatorRep g hg ((CoxeterMatrix.G₂).simple 1) =
      blockTwistedReflection g := by
  exact CoxeterSystem.lift_apply_simple
    (CoxeterMatrix.G₂).toCoxeterSystem (blockReflections_liftable g hg) 1

/-- The positive Coxeter generator product acts by the block rotation
associated to the coefficient unit. This identifies the abstract Coxeter
rotation with the concrete operator action. -/
theorem g2BlockOperatorRep_simple_product (g : Bˣ) (hg : g ^ 6 = 1) :
    g2BlockOperatorRep g hg
      ((CoxeterMatrix.G₂).simple 0 * (CoxeterMatrix.G₂).simple 1) =
        blockRotation g⁻¹ := by
  rw [map_mul, g2BlockOperatorRep_apply_simple_zero,
    g2BlockOperatorRep_apply_simple_one]
  exact (blockReflection_products g).1

/-- The sixth power of the represented simple-generator product acts as the
identity on the doubled operator carrier. -/
theorem g2BlockOperatorRep_simple_product_pow_six (g : Bˣ)
    (hg : g ^ 6 = 1) :
    (g2BlockOperatorRep g hg
      ((CoxeterMatrix.G₂).simple 0 * (CoxeterMatrix.G₂).simple 1)) ^ 6 = 1 := by
  rw [g2BlockOperatorRep_simple_product g hg]
  have hinv : (g⁻¹ : Bˣ) ^ 6 = 1 := by
    calc
      (g⁻¹ : Bˣ) ^ 6 = (g ^ 6)⁻¹ := by simp [inv_pow]
      _ = 1 := by rw [hg]; simp
  exact blockRotation_pow_six _ hinv

/-- The square-zero Bruhat unit on the unit-support shell therefore gives a
genuine operator-valued `G₂` Coxeter representation. -/
theorem bruhatUnit_g2_representation (u v : B)
    (hu : u * u = 0) (hv : v * v = 0)
    (hV : InfoGeometry.Algebra.IsotropicCyclotomicGalois.anticommutator u v = 1) :
    Nonempty ((CoxeterMatrix.G₂).Group →* Equiv.Perm (B × B)) := by
  let hsix := bruhatUnit_sixth_power_on_shell u v hu hv hV |>.1
  exact ⟨g2BlockOperatorRep (bruhatUnit u v hu hv) hsix⟩

end InfoGeometry.Algebra.OperatorCyclotomicCoxeterBridge
