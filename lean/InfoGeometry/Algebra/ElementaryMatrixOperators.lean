import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.Group.Units.Equiv
import Mathlib.Data.Matrix.Basis
import Mathlib.Data.Matrix.Block
import Mathlib.LinearAlgebra.Matrix.Reindex

/-!
# Elementary units and block shears over arbitrary rings

The ambient general linear group is the native group `(Matrix n n A)ˣ`.
The elementary subgroup is the native `Subgroup.closure` of scalar-entry
transvections `1 + Matrix.single i j a` with `i ≠ j`.

The upper and lower block shears are proved elementary by the native
`Matrix.induction_on'`: each single-entry block gives one scalar transvection,
and addition of blocks gives multiplication of the corresponding shears.
Reindexing uses `Units.mapEquiv` applied to `Matrix.reindexRingEquiv`.

All statements retain arbitrary noncommutative coefficients `[Ring A]`,
arbitrary finite index types, and the possibility that an index type is empty.
The unit inverse certificates are constructed explicitly. No determinant,
commutativity of coefficients, or invertibility of a block entry is assumed.

## Scope

This is finite matrix algebra supporting a Whitehead stabilization argument.
It does not encode a Hamiltonian, lattice locality, or physical circuit.
-/

namespace InfoGeometry.Algebra.ElementaryMatrixOperators

open Matrix

section Elementary

variable {n A : Type*} [Fintype n] [DecidableEq n] [Ring A]

/-- An off-diagonal matrix unit is square-zero, even with noncommutative entries. -/
theorem single_mul_self_eq_zero (i j : n) (hij : i ≠ j) (a : A) :
    Matrix.single i j a * Matrix.single i j a = 0 := by
  exact Matrix.single_mul_single_of_ne a i j i hij.symm a

/-- A scalar-entry elementary matrix, with its explicit two-sided inverse. -/
def elementaryUnit (i j : n) (hij : i ≠ j) (a : A) : (Matrix n n A)ˣ where
  val := 1 + Matrix.single i j a
  inv := 1 - Matrix.single i j a
  val_inv := by
    have hzero := single_mul_self_eq_zero i j hij a
    rw [mul_sub, mul_one, add_mul, one_mul, hzero, add_zero, add_sub_cancel_right]
  inv_val := by
    have hzero := single_mul_self_eq_zero i j hij a
    rw [mul_add, mul_one, sub_mul, one_mul, hzero, sub_zero, sub_add_cancel]

@[simp]
theorem coe_elementaryUnit (i j : n) (hij : i ≠ j) (a : A) :
    (elementaryUnit i j hij a : Matrix n n A) = 1 + Matrix.single i j a := rfl

@[simp]
theorem coe_elementaryUnit_inv (i j : n) (hij : i ≠ j) (a : A) :
    (↑((elementaryUnit i j hij a)⁻¹) : Matrix n n A) = 1 - Matrix.single i j a := rfl

@[simp]
theorem elementaryUnit_zero (i j : n) (hij : i ≠ j) :
    elementaryUnit i j hij (0 : A) = 1 := by
  apply Units.ext
  simp

/-- Inverting an elementary matrix negates its coefficient. -/
@[simp]
theorem elementaryUnit_inv (i j : n) (hij : i ≠ j) (a : A) :
    (elementaryUnit i j hij a)⁻¹ = elementaryUnit i j hij (-a) := by
  apply Units.ext
  change 1 - Matrix.single i j a = 1 + Matrix.single i j (-a)
  rw [← Matrix.single_neg, sub_eq_add_neg]

/-- Addition of coefficients corresponds to multiplication along one matrix unit. -/
theorem elementaryUnit_add (i j : n) (hij : i ≠ j) (a b : A) :
    elementaryUnit i j hij (a + b) =
      elementaryUnit i j hij a * elementaryUnit i j hij b := by
  apply Units.ext
  change 1 + Matrix.single i j (a + b) =
    (1 + Matrix.single i j a) * (1 + Matrix.single i j b)
  have hzero : Matrix.single i j a * Matrix.single i j b = 0 :=
    Matrix.single_mul_single_of_ne a i j i hij.symm b
  simp [Matrix.single_add, mul_add, add_mul, hzero, add_assoc]

variable (n A) in
/-- The subgroup generated by scalar-entry elementary matrix units. -/
def elementarySubgroup : Subgroup (Matrix n n A)ˣ :=
  Subgroup.closure
    {g | ∃ (i j : n) (hij : i ≠ j) (a : A), g = elementaryUnit i j hij a}

/-- Every specified elementary matrix belongs to the elementary subgroup. -/
theorem elementaryUnit_mem_elementarySubgroup (i j : n) (hij : i ≠ j) (a : A) :
    elementaryUnit i j hij a ∈ elementarySubgroup n A := by
  apply Subgroup.subset_closure
  exact ⟨i, j, hij, a, rfl⟩

end Elementary

section Blocks

variable {m n A : Type*} [Fintype m] [DecidableEq m]
  [Fintype n] [DecidableEq n] [Ring A]

/-- The upper block shear with off-diagonal block `B`. -/
def upperUnit (B : Matrix m n A) : (Matrix (m ⊕ n) (m ⊕ n) A)ˣ where
  val := Matrix.fromBlocks 1 B 0 1
  inv := Matrix.fromBlocks 1 (-B) 0 1
  val_inv := by simp [Matrix.fromBlocks_multiply]
  inv_val := by simp [Matrix.fromBlocks_multiply]

/-- The lower block shear with off-diagonal block `C`. -/
def lowerUnit (C : Matrix n m A) : (Matrix (m ⊕ n) (m ⊕ n) A)ˣ where
  val := Matrix.fromBlocks 1 0 C 1
  inv := Matrix.fromBlocks 1 0 (-C) 1
  val_inv := by simp [Matrix.fromBlocks_multiply]
  inv_val := by simp [Matrix.fromBlocks_multiply]

@[simp]
theorem coe_upperUnit (B : Matrix m n A) :
    (upperUnit B : Matrix (m ⊕ n) (m ⊕ n) A) = Matrix.fromBlocks 1 B 0 1 := rfl

@[simp]
theorem coe_lowerUnit (C : Matrix n m A) :
    (lowerUnit C : Matrix (m ⊕ n) (m ⊕ n) A) = Matrix.fromBlocks 1 0 C 1 := rfl

@[simp]
theorem upperUnit_zero : upperUnit (0 : Matrix m n A) = 1 := by
  apply Units.ext
  exact Matrix.fromBlocks_one

@[simp]
theorem lowerUnit_zero : lowerUnit (0 : Matrix n m A) = 1 := by
  apply Units.ext
  exact Matrix.fromBlocks_one

@[simp]
theorem upperUnit_inv (B : Matrix m n A) : (upperUnit B)⁻¹ = upperUnit (-B) :=
  Units.ext rfl

@[simp]
theorem lowerUnit_inv (C : Matrix n m A) : (lowerUnit C)⁻¹ = lowerUnit (-C) :=
  Units.ext rfl

/-- Upper block shears turn addition into multiplication. -/
theorem upperUnit_add (B C : Matrix m n A) :
    upperUnit (B + C) = upperUnit B * upperUnit C := by
  apply Units.ext
  change Matrix.fromBlocks 1 (B + C) 0 1 =
    Matrix.fromBlocks 1 B 0 1 * Matrix.fromBlocks 1 C 0 1
  simp [Matrix.fromBlocks_multiply, add_comm]

/-- Lower block shears turn addition into multiplication. -/
theorem lowerUnit_add (B C : Matrix n m A) :
    lowerUnit (B + C) = lowerUnit B * lowerUnit C := by
  apply Units.ext
  change Matrix.fromBlocks 1 0 (B + C) 1 =
    Matrix.fromBlocks 1 0 B 1 * Matrix.fromBlocks 1 0 C 1
  simp [Matrix.fromBlocks_multiply]

/-- A single-entry upper block shear is one scalar elementary matrix. -/
theorem upperUnit_single (i : m) (j : n) (a : A) :
    upperUnit (Matrix.single i j a) =
      elementaryUnit (Sum.inl i) (Sum.inr j) (by simp) a := by
  apply Units.ext
  change Matrix.fromBlocks 1 (Matrix.single i j a) 0 1 =
    1 + Matrix.single (Sum.inl i) (Sum.inr j) a
  ext x y
  cases x <;> cases y <;> simp [Matrix.single, Matrix.one_apply]

/-- A single-entry lower block shear is one scalar elementary matrix. -/
theorem lowerUnit_single (i : n) (j : m) (a : A) :
    lowerUnit (Matrix.single i j a) =
      elementaryUnit (Sum.inr i) (Sum.inl j) (by simp) a := by
  apply Units.ext
  change Matrix.fromBlocks 1 0 (Matrix.single i j a) 1 =
    1 + Matrix.single (Sum.inr i) (Sum.inl j) a
  ext x y
  cases x <;> cases y <;> simp [Matrix.single, Matrix.one_apply]

/-- Every upper block shear is generated by scalar-entry elementary matrices. -/
theorem upperUnit_mem_elementarySubgroup (B : Matrix m n A) :
    upperUnit B ∈ elementarySubgroup (m ⊕ n) A := by
  refine Matrix.induction_on' B ?_ ?_ ?_
  · rw [upperUnit_zero]
    exact (elementarySubgroup (m ⊕ n) A).one_mem
  · intro B C hB hC
    rw [upperUnit_add]
    exact (elementarySubgroup (m ⊕ n) A).mul_mem hB hC
  · intro i j a
    rw [upperUnit_single]
    exact elementaryUnit_mem_elementarySubgroup _ _ _ _

/-- Every lower block shear is generated by scalar-entry elementary matrices. -/
theorem lowerUnit_mem_elementarySubgroup (C : Matrix n m A) :
    lowerUnit C ∈ elementarySubgroup (m ⊕ n) A := by
  refine Matrix.induction_on' C ?_ ?_ ?_
  · rw [lowerUnit_zero]
    exact (elementarySubgroup (m ⊕ n) A).one_mem
  · intro B C hB hC
    rw [lowerUnit_add]
    exact (elementarySubgroup (m ⊕ n) A).mul_mem hB hC
  · intro i j a
    rw [lowerUnit_single]
    exact elementaryUnit_mem_elementarySubgroup _ _ _ _

end Blocks

section Reindex

variable {m n A : Type*} [Fintype m] [DecidableEq m]
  [Fintype n] [DecidableEq n] [Ring A]

/-- Reindex a matrix unit through the native ring and unit equivalences. -/
def reindexUnit (e : m ≃ n) : (Matrix m m A)ˣ ≃* (Matrix n n A)ˣ :=
  Units.mapEquiv (Matrix.reindexRingEquiv A e).toMulEquiv

@[simp]
theorem coe_reindexUnit (e : m ≃ n) (U : (Matrix m m A)ˣ) :
    (reindexUnit e U : Matrix n n A) = Matrix.reindex e e (U : Matrix m m A) := rfl

/-- Reindexing a scalar-entry elementary matrix reindexes its two distinguished indices. -/
theorem reindexUnit_elementaryUnit (e : m ≃ n) (i j : m) (hij : i ≠ j) (a : A) :
    reindexUnit e (elementaryUnit i j hij a) =
      elementaryUnit (e i) (e j) (fun h => hij (e.injective h)) a := by
  apply Units.ext
  change (Matrix.reindexRingEquiv A e) (1 + Matrix.single i j a) =
    1 + Matrix.single (e i) (e j) a
  rw [map_add, map_one]
  congr 1
  change (Matrix.single i j a).submatrix e.symm e.symm = Matrix.single (e i) (e j) a
  simp

/-- Changing the index type preserves membership in the elementary subgroup. -/
theorem reindexUnit_mem_elementarySubgroup (e : m ≃ n) {U : (Matrix m m A)ˣ}
    (hU : U ∈ elementarySubgroup m A) :
    reindexUnit e U ∈ elementarySubgroup n A := by
  refine Subgroup.closure_induction
    (p := fun V _ => reindexUnit e V ∈ elementarySubgroup n A) ?_ ?_ ?_ ?_ hU
  · intro V hV
    rcases hV with ⟨i, j, hij, a, rfl⟩
    rw [reindexUnit_elementaryUnit]
    exact elementaryUnit_mem_elementarySubgroup _ _ _ _
  · rw [map_one]
    exact (elementarySubgroup n A).one_mem
  · intro V W hV hW hV' hW'
    rw [map_mul]
    exact (elementarySubgroup n A).mul_mem hV' hW'
  · intro V hV hV'
    rw [map_inv]
    exact (elementarySubgroup n A).inv_mem hV'

@[simp]
theorem reindexUnit_symm_apply_apply (e : m ≃ n) (U : (Matrix m m A)ˣ) :
    reindexUnit e.symm (reindexUnit e U) = U := by
  apply Units.ext
  change Matrix.reindex e.symm e.symm (Matrix.reindex e e (U : Matrix m m A)) =
    (U : Matrix m m A)
  exact (Matrix.reindex e e).symm_apply_apply _

/-- Membership is invariant, in both directions, under an index equivalence. -/
theorem reindexUnit_mem_elementarySubgroup_iff (e : m ≃ n) (U : (Matrix m m A)ˣ) :
    reindexUnit e U ∈ elementarySubgroup n A ↔ U ∈ elementarySubgroup m A := by
  constructor
  · intro hU
    simpa only [reindexUnit_symm_apply_apply] using
      reindexUnit_mem_elementarySubgroup e.symm hU
  · exact reindexUnit_mem_elementarySubgroup e

end Reindex

section Noncommutativity

variable {A : Type*} [Ring A]

/-- The upper root matrix underlying a two-dimensional elementary operation. -/
def upperRoot : Matrix (Fin 2) (Fin 2) A := Matrix.single 0 1 1

/-- The opposite lower root matrix. -/
def lowerRoot : Matrix (Fin 2) (Fin 2) A := Matrix.single 1 0 1

/-- Opposite elementary root directions do not commute over a nontrivial ring. -/
theorem upperRoot_mul_lowerRoot_ne_lowerRoot_mul_upperRoot [Nontrivial A] :
    (upperRoot : Matrix (Fin 2) (Fin 2) A) * lowerRoot ≠ lowerRoot * upperRoot := by
  intro h
  have h00 := congrArg (fun M : Matrix (Fin 2) (Fin 2) A => M 0 0) h
  simp [upperRoot, lowerRoot] at h00

end Noncommutativity

end InfoGeometry.Algebra.ElementaryMatrixOperators
