import Mathlib.Algebra.Group.Basic

namespace InfoGeometry.Topology.V4RootSystem

/-- 
The V4 Klein Four-Group generated by the Weyl reflections of the A1 x A1 root system.
It defines the symmetries of the non-orientable Klein Bottle Brillouin Zone.
-/
inductive V4Group where
  | I  -- Identity
  | W1 -- Reflection X (Parity Left)
  | W2 -- Reflection Y (Parity Right)
  | W12 -- Point Inversion (Charge Parity)
  deriving DecidableEq, Repr

open V4Group

/-- Group multiplication (The V4 Cayley Table) -/
def v4_mul : V4Group → V4Group → V4Group
  | I, x => x
  | x, I => x
  | W1, W1 => I
  | W2, W2 => I
  | W12, W12 => I
  | W1, W2 => W12
  | W2, W1 => W12
  | W1, W12 => W2
  | W12, W1 => W2
  | W2, W12 => W1
  | W12, W2 => W1

instance : Mul V4Group where
  mul := v4_mul

/-- 
THEOREM: The Varlamov V4 Symmetry.
Proves that the point inversion of the Klein Bottle Brillouin zone is 
exactly the composition of the two chiral parity swaps, stabilizing 
into the Klein Four-Group.
-/
theorem varlamov_v4_inversion : W1 * W2 = W12 := by
  rfl

/-- 
THEOREM: Tripotent Involution.
Every state in the Weyl group squares to the identity, perfectly 
matching the projective limits of the Tripotent operator OP^3 = OP.
-/
theorem v4_involution (x : V4Group) : x * x = I := by
  cases x <;> rfl

end InfoGeometry.Topology.V4RootSystem
