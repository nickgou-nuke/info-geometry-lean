import Mathlib.CategoryTheory.Quotient
import DAG.ProofBearingMorphismRelations

/-!
# Presented path categories

This owner packages the exact relation boundary. `Quotient.category` performs
the categorical quotient generated by the supplied parallel-path relation;
without a proof in `PresentedRelations.Rel`, no equality is introduced.
-/

namespace InfoGeometry.DAG.Category

open CategoryTheory

/-- Free category of paths generated by `G`, with its quiver made explicit. -/
abbrev FreeMorphismCategory (V : Type*) [GeneratingGraph V] := Paths V

/-- Presented category obtained from the certified path relation. -/
abbrev PresentedCategory {V : Type*} [GeneratingGraph V]
    (R : PresentedRelations V) := CategoryTheory.Quotient R.homRel

instance presentedCategory {V : Type*} [GeneratingGraph V]
    (R : PresentedRelations V) : Category (PresentedCategory R) :=
  Quotient.category R.homRel

/-- The quotient relation used by the presented category is the supplied one. -/
theorem PresentedCategory_relation {V : Type*} [GeneratingGraph V]
    (R : PresentedRelations V) :
    R.homRel = (fun {_ _} P Q => R.Rel P Q) := by
  rfl

/-- Every certified path relation is an equality after the native quotient
functor; no equality is asserted before the relation proof is supplied. -/
theorem PresentedCategory_sound {V : Type*} [GeneratingGraph V]
    (R : PresentedRelations V) {X Y : V}
    {P Q : Quiver.Path X Y} (h : R.Rel P Q) :
    (Quotient.functor R.homRel).map P = (Quotient.functor R.homRel).map Q := by
  apply CategoryTheory.Quotient.sound
  exact (show R.homRel P Q from h)

end InfoGeometry.DAG.Category
