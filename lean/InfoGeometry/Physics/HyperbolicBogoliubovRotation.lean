import Mathlib.CategoryTheory.Category.Basic
import Mathlib.CategoryTheory.Preadditive.Basic
import Mathlib.CategoryTheory.Limits.Shapes.ZeroMorphisms
import Mathlib.Tactic.Abel
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith

/-!
# Hyperbolic Bogoliubov Rotation & BdG Diagonalization

This module formalizes the hyperbolic Bogoliubov rotation `U(θ) = cosh(θ) 𝟙 + sinh(θ) τ₁`
generated by the canonical particle-hole split involution `τ₁ = p₁ i₂ + p₂ i₁` in an
ambient preadditive category `C`.

All properties are proved as standalone definitions, lemmas, and theorems.
-/

namespace InfoGeometry.Physics.Bogoliubov

open CategoryTheory
open CategoryTheory.Limits

universe v u

variable {C : Type u} [Category.{v} C] [Preadditive C]

/-! ### 1. Canonical Doublet Involutions -/

/-- The particle-hole exchange split involution `τ₁ = p₁ ≫ i₂ + p₂ ≫ i₁`. -/
@[inline]
def tau1 {E Ω : C} (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E) : E ⟶ E :=
  p1 ≫ i2 + p2 ≫ i1

/-- The charge grading Krein involution `τ₃ = p₁ ≫ i₁ - p₂ ≫ i₂`. -/
@[inline]
def tau3 {E Ω : C} (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E) : E ⟶ E :=
  p1 ≫ i1 - p2 ≫ i2

/-- `τ₁` is an exact split involution: `τ₁ ≫ τ₁ = 𝟙 E`. -/
theorem tau1_is_involution {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E) :
    tau1 p1 i1 p2 i2 ≫ tau1 p1 i1 p2 i2 = 𝟙 E := by
  dsimp [tau1]
  rw [Preadditive.add_comp, Preadditive.comp_add, Preadditive.comp_add]
  have h1 : (p1 ≫ i2) ≫ (p1 ≫ i2) = 0 := by
    calc
      (p1 ≫ i2) ≫ (p1 ≫ i2) = p1 ≫ (i2 ≫ p1) ≫ i2 := by simp only [Category.assoc]
      _ = p1 ≫ 0 ≫ i2 := by rw [horth21]
      _ = 0 := by simp only [zero_comp, comp_zero]
  have h2 : (p1 ≫ i2) ≫ (p2 ≫ i1) = p1 ≫ i1 := by
    calc
      (p1 ≫ i2) ≫ (p2 ≫ i1) = p1 ≫ (i2 ≫ p2) ≫ i1 := by simp only [Category.assoc]
      _ = p1 ≫ 𝟙 Ω ≫ i1 := by rw [hid2]
      _ = p1 ≫ i1 := by simp only [Category.id_comp]
  have h3 : (p2 ≫ i1) ≫ (p1 ≫ i2) = p2 ≫ i2 := by
    calc
      (p2 ≫ i1) ≫ (p1 ≫ i2) = p2 ≫ (i1 ≫ p1) ≫ i2 := by simp only [Category.assoc]
      _ = p2 ≫ 𝟙 Ω ≫ i2 := by rw [hid1]
      _ = p2 ≫ i2 := by simp only [Category.id_comp]
  have h4 : (p2 ≫ i1) ≫ (p2 ≫ i1) = 0 := by
    calc
      (p2 ≫ i1) ≫ (p2 ≫ i1) = p2 ≫ (i1 ≫ p2) ≫ i1 := by simp only [Category.assoc]
      _ = p2 ≫ 0 ≫ i1 := by rw [horth12]
      _ = 0 := by simp only [zero_comp, comp_zero]
  rw [h1, h2, h3, h4, zero_add, add_zero]
  exact h_decomp

/-- Anticommutation of the doublet involutions: `τ₁ ≫ τ₃ + τ₃ ≫ τ₁ = 0`. -/
theorem tau1_anticommutes_tau3 {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0) :
    tau1 p1 i1 p2 i2 ≫ tau3 p1 i1 p2 i2 +
    tau3 p1 i1 p2 i2 ≫ tau1 p1 i1 p2 i2 = 0 := by
  dsimp [tau1, tau3]
  rw [Preadditive.add_comp, Preadditive.comp_sub, Preadditive.comp_sub]
  rw [Preadditive.sub_comp, Preadditive.comp_add, Preadditive.comp_add]
  have h1 : (p1 ≫ i2) ≫ (p1 ≫ i1) = 0 := by
    calc
      (p1 ≫ i2) ≫ (p1 ≫ i1) = p1 ≫ (i2 ≫ p1) ≫ i1 := by simp only [Category.assoc]
      _ = p1 ≫ 0 ≫ i1 := by rw [horth21]
      _ = 0 := by simp only [zero_comp, comp_zero]
  have h2 : (p1 ≫ i2) ≫ (p2 ≫ i2) = p1 ≫ i2 := by
    calc
      (p1 ≫ i2) ≫ (p2 ≫ i2) = p1 ≫ (i2 ≫ p2) ≫ i2 := by simp only [Category.assoc]
      _ = p1 ≫ 𝟙 Ω ≫ i2 := by rw [hid2]
      _ = p1 ≫ i2 := by simp only [Category.id_comp]
  have h3 : (p2 ≫ i1) ≫ (p1 ≫ i1) = p2 ≫ i1 := by
    calc
      (p2 ≫ i1) ≫ (p1 ≫ i1) = p2 ≫ (i1 ≫ p1) ≫ i1 := by simp only [Category.assoc]
      _ = p2 ≫ 𝟙 Ω ≫ i1 := by rw [hid1]
      _ = p2 ≫ i1 := by simp only [Category.id_comp]
  have h4 : (p2 ≫ i1) ≫ (p2 ≫ i2) = 0 := by
    calc
      (p2 ≫ i1) ≫ (p2 ≫ i2) = p2 ≫ (i1 ≫ p2) ≫ i2 := by simp only [Category.assoc]
      _ = p2 ≫ 0 ≫ i2 := by rw [horth12]
      _ = 0 := by simp only [zero_comp, comp_zero]
  have h5 : (p1 ≫ i1) ≫ (p1 ≫ i2) = p1 ≫ i2 := by
    calc
      (p1 ≫ i1) ≫ (p1 ≫ i2) = p1 ≫ (i1 ≫ p1) ≫ i2 := by simp only [Category.assoc]
      _ = p1 ≫ 𝟙 Ω ≫ i2 := by rw [hid1]
      _ = p1 ≫ i2 := by simp only [Category.id_comp]
  have h6 : (p1 ≫ i1) ≫ (p2 ≫ i1) = 0 := by
    calc
      (p1 ≫ i1) ≫ (p2 ≫ i1) = p1 ≫ (i1 ≫ p2) ≫ i1 := by simp only [Category.assoc]
      _ = p1 ≫ 0 ≫ i1 := by rw [horth12]
      _ = 0 := by simp only [zero_comp, comp_zero]
  have h7 : (p2 ≫ i2) ≫ (p1 ≫ i2) = 0 := by
    calc
      (p2 ≫ i2) ≫ (p1 ≫ i2) = p2 ≫ (i2 ≫ p1) ≫ i2 := by simp only [Category.assoc]
      _ = p2 ≫ 0 ≫ i2 := by rw [horth21]
      _ = 0 := by simp only [zero_comp, comp_zero]
  have h8 : (p2 ≫ i2) ≫ (p2 ≫ i1) = p2 ≫ i1 := by
    calc
      (p2 ≫ i2) ≫ (p2 ≫ i1) = p2 ≫ (i2 ≫ p2) ≫ i1 := by simp only [Category.assoc]
      _ = p2 ≫ 𝟙 Ω ≫ i1 := by rw [hid2]
      _ = p2 ≫ i1 := by simp only [Category.id_comp]
  rw [h1, h2, h3, h4, h5, h6, h7, h8]
  abel

/-! ### 2. The Hyperbolic Bogoliubov Rotation Operator -/

/-- Hyperbolic Bogoliubov rotation operator `U(c, s) = c • 𝟙 E + s • τ₁`. -/
@[inline]
def bogoliubovRotation {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (c s : ℤ) : E ⟶ E :=
  c • 𝟙 E + s • tau1 p1 i1 p2 i2

/-- Group composition law: `U(c₁, s₁) ≫ U(c₂, s₂) = U(c₁ c₂ + s₁ s₂, c₁ s₂ + s₁ c₂)`. -/
theorem bogoliubov_rotation_group_law {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (c1 s1 c2 s2 : ℤ) :
    bogoliubovRotation p1 i1 p2 i2 c1 s1 ≫
    bogoliubovRotation p1 i1 p2 i2 c2 s2 =
    bogoliubovRotation p1 i1 p2 i2 (c1 * c2 + s1 * s2) (c1 * s2 + s1 * c2) := by
  dsimp [bogoliubovRotation]
  have h_tau_sq := tau1_is_involution p1 i1 p2 i2 hid1 hid2 horth12 horth21 h_decomp
  rw [Preadditive.add_comp, Preadditive.comp_add, Preadditive.comp_add]
  rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, Category.id_comp]
  rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, Category.id_comp]
  rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, Category.comp_id]
  rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, h_tau_sq]
  rw [add_zsmul, add_zsmul]
  simp only [← mul_zsmul]
  abel

/-- Two-sided inverse property: `U(c, s) ≫ U(c, -s) = 𝟙 E` when `c² - s² = 1`. -/
theorem bogoliubov_rotation_inverse {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (c s : ℤ) (h_hyp : c * c - s * s = 1) :
    bogoliubovRotation p1 i1 p2 i2 c s ≫
    bogoliubovRotation p1 i1 p2 i2 c (-s) = 𝟙 E := by
  have h_grp := bogoliubov_rotation_group_law p1 i1 p2 i2 hid1 hid2 horth12 horth21 h_decomp c s c (-s)
  rw [h_grp]
  dsimp [bogoliubovRotation]
  have h1 : c * c + s * -s = 1 := by linarith [h_hyp]
  have h2 : c * -s + s * c = 0 := by ring
  rw [h1, h2, one_zsmul, zero_zsmul, add_zero]

/-! ### 3. Peirce Spectral Decomposition of Hyperbolic Rotation -/

/-- Positive Peirce projector of the swap split involution `τ₁`. -/
@[inline]
def peircePlusTau1 {E Ω : C} (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E) : E ⟶ E :=
  (p1 + p2) ≫ (i1 + i2)

/-- Negative Peirce projector of the swap split involution `τ₁`. -/
@[inline]
def peirceMinusTau1 {E Ω : C} (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E) : E ⟶ E :=
  (p1 - p2) ≫ (i1 - i2)

/-- Integer scaling law: `2 • P₊(τ₁) = 𝟙 E + τ₁`. -/
theorem two_smul_peirce_plus_tau1 {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E) :
    peircePlusTau1 p1 i1 p2 i2 = 𝟙 E + tau1 p1 i1 p2 i2 := by
  dsimp [peircePlusTau1, tau1]
  rw [Preadditive.add_comp, Preadditive.comp_add, Preadditive.comp_add]
  rw [← h_decomp]
  abel

/-- Integer scaling law: `2 • P₋(τ₁) = 𝟙 E - τ₁`. -/
theorem two_smul_peirce_minus_tau1 {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E) :
    peirceMinusTau1 p1 i1 p2 i2 = 𝟙 E - tau1 p1 i1 p2 i2 := by
  dsimp [peirceMinusTau1, tau1]
  rw [Preadditive.sub_comp, Preadditive.comp_sub, Preadditive.comp_sub]
  rw [← h_decomp]
  abel

/-- The hyperbolic rotation decomposes into chiral exponential weights:
`2 • U(c, s) = (c + s) • (2 • P₊) + (c - s) • (2 • P₋)`. -/
theorem bogoliubov_peirce_spectral_flow {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (c s : ℤ) :
    (2 : ℤ) • bogoliubovRotation p1 i1 p2 i2 c s =
    (c + s) • peircePlusTau1 p1 i1 p2 i2 +
    (c - s) • peirceMinusTau1 p1 i1 p2 i2 := by
  dsimp [bogoliubovRotation]
  rw [two_smul_peirce_plus_tau1 p1 i1 p2 i2 h_decomp]
  rw [two_smul_peirce_minus_tau1 p1 i1 p2 i2 h_decomp]
  simp only [add_zsmul, sub_zsmul, zsmul_add, zsmul_sub]
  abel

/-! ### 4. Quasiparticle Amplitude Mixing -/

/-- Bogoliubov rotation transforms physical incoming states into a linear combination
of particles and ghost partners: `i₁ ≫ U(c, s) = c • i₁ + s • i₂`. -/
theorem bogoliubov_mixes_physical_sector {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (horth12 : i1 ≫ p2 = 0)
    (c s : ℤ) :
    i1 ≫ bogoliubovRotation p1 i1 p2 i2 c s =
    c • i1 + s • i2 := by
  dsimp [bogoliubovRotation, tau1]
  rw [Preadditive.comp_add, Preadditive.comp_zsmul, Preadditive.comp_zsmul]
  rw [Category.comp_id]
  rw [Preadditive.comp_add]
  rw [← Category.assoc i1 p1, ← Category.assoc i1 p2]
  rw [hid1, horth12]
  rw [Category.id_comp, zero_comp, add_zero]

/-- Bogoliubov rotation transforms ghost states into a linear combination
of ghosts and physical partners: `i₂ ≫ U(c, s) = s • i₁ + c • i₂`. -/
theorem bogoliubov_mixes_ghost_sector {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (hid2 : i2 ≫ p2 = 𝟙 Ω) (horth21 : i2 ≫ p1 = 0)
    (c s : ℤ) :
    i2 ≫ bogoliubovRotation p1 i1 p2 i2 c s =
    s • i1 + c • i2 := by
  dsimp [bogoliubovRotation, tau1]
  rw [Preadditive.comp_add, Preadditive.comp_zsmul, Preadditive.comp_zsmul]
  rw [Category.comp_id]
  rw [Preadditive.comp_add]
  rw [← Category.assoc i2 p1, ← Category.assoc i2 p2]
  rw [horth21, hid2]
  rw [zero_comp, Category.id_comp, zero_add]
  abel

/-! ### 5. Krein Metric Invariance (Krein-Unitary Transformation) -/

/-- The hyperbolic Bogoliubov rotation strictly preserves the indefinite Krein metric `τ₃`:
`U(c, s) ≫ τ₃ ≫ U(c, s) = τ₃` when `c² - s² = 1`. -/
theorem bogoliubov_preserves_krein_metric {E Ω : C}
    (p1 : E ⟶ Ω) (i1 : Ω ⟶ E) (p2 : E ⟶ Ω) (i2 : Ω ⟶ E)
    (hid1 : i1 ≫ p1 = 𝟙 Ω) (hid2 : i2 ≫ p2 = 𝟙 Ω)
    (horth12 : i1 ≫ p2 = 0) (horth21 : i2 ≫ p1 = 0)
    (h_decomp : p1 ≫ i1 + p2 ≫ i2 = 𝟙 E)
    (c s : ℤ) (h_hyp : c * c - s * s = 1) :
    bogoliubovRotation p1 i1 p2 i2 c s ≫ tau3 p1 i1 p2 i2 ≫
    bogoliubovRotation p1 i1 p2 i2 c s = tau3 p1 i1 p2 i2 := by
  dsimp [bogoliubovRotation]
  let T1 := tau1 p1 i1 p2 i2
  let T3 := tau3 p1 i1 p2 i2
  have h_anticomm := tau1_anticommutes_tau3 p1 i1 p2 i2 hid1 hid2 horth12 horth21
  have h_t1_sq := tau1_is_involution p1 i1 p2 i2 hid1 hid2 horth12 horth21 h_decomp
  have h_step1 : (c • 𝟙 E + s • T1) ≫ T3 = c • T3 + s • (T1 ≫ T3) := by
    rw [Preadditive.add_comp, Preadditive.zsmul_comp, Preadditive.zsmul_comp, Category.id_comp]
  rw [← Category.assoc, h_step1]
  rw [Preadditive.add_comp, Preadditive.comp_add, Preadditive.comp_add]
  rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, Category.comp_id]
  rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul]
  rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, Category.comp_id]
  rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul]
  have h_t1_t3_t1 : (T1 ≫ T3) ≫ T1 = - T3 := by
    rw [Category.assoc]
    have h_swap : T3 ≫ T1 = - (T1 ≫ T3) := by
      have h_sum : T1 ≫ T3 + T3 ≫ T1 = 0 := h_anticomm
      exact eq_neg_of_add_eq_zero_right h_sum
    rw [h_swap, Preadditive.comp_neg, ← Category.assoc, h_t1_sq, Category.id_comp]
  rw [h_t1_t3_t1]
  simp only [← mul_zsmul, smul_neg]
  have h_cross : (c * s) • (T3 ≫ T1) + (s * c) • (T1 ≫ T3) = 0 := by
    have h_comm_sc : s * c = c * s := mul_comm s c
    rw [h_comm_sc, ← zsmul_add]
    rw [add_comm (T3 ≫ T1), h_anticomm, zsmul_zero]
  have h_diag : (c * c) • T3 - (s * s) • T3 = T3 := by
    rw [sub_eq_add_neg, ← sub_zsmul, h_hyp, one_zsmul]
  calc
    (c * c) • T3 + (c * s) • (T3 ≫ T1) +
    ((s * c) • (T1 ≫ T3) + -((s * s) • T3))
      = ((c * c) • T3 - (s * s) • T3) +
        ((c * s) • (T3 ≫ T1) + (s * c) • (T1 ≫ T3)) := by abel
    _ = T3 + 0 := by rw [h_diag, h_cross]
    _ = T3     := add_zero T3

/-! ### 6. Spectral Decoupling via Normalized BdG Split Involution -/

/-- Given an energy gap scale `m` and its scalar inverse `μ` (so `μ * m = 1`),
and a BdG Hamiltonian `H` satisfying `H ≫ H = (m * m) • 𝟙 E`,
the normalized operator `ε_BdG = μ • H` is an exact split involution: `ε_BdG ≫ ε_BdG = 𝟙 E`. -/
theorem normalized_bdg_is_split_involution {E : C}
    (H : E ⟶ E) (m μ : ℤ) (h_inv : μ * m = 1)
    (h_dispersion : H ≫ H = (m * m) • 𝟙 E) :
    (μ • H) ≫ (μ • H) = 𝟙 E := by
  have h_alg : (μ * μ) * (m * m) = (μ * m) * (μ * m) := by ring
  calc
    (μ • H) ≫ (μ • H) = (μ * μ) • (H ≫ H) := by
      rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, mul_zsmul]
    _ = (μ * μ) • ((m * m) • 𝟙 E) := by rw [h_dispersion]
    _ = ((μ * μ) * (m * m)) • 𝟙 E := by rw [← mul_zsmul]
    _ = ((μ * m) * (μ * m)) • 𝟙 E := by rw [h_alg]
    _ = (1 * 1 : ℤ) • 𝟙 E := by rw [h_inv]
    _ = 𝟙 E := by
      have h1 : (1 * 1 : ℤ) = 1 := rfl
      rw [h1, one_zsmul]

/-- Positive sector isolation for the normalized BdG involution: the doubled
positive Peirce projector `Q₊ = 𝟙 E + ε_BdG` of `ε_BdG = μ • H` isolates the
`+m` energy eigenvalue, `Q₊ ≫ H = m • Q₊`.  The projector is constructed from
the proved involution; no Peirce relation is postulated. -/
theorem normalized_bdg_positive_sector_eigenvalue {E : C}
    (H : E ⟶ E) (m μ : ℤ) (h_inv : μ * m = 1)
    (h_dispersion : H ≫ H = (m * m) • 𝟙 E) :
    (𝟙 E + μ • H) ≫ H = m • (𝟙 E + μ • H) := by
  have h_m_mu : m * μ = 1 := (mul_comm μ m) ▸ h_inv
  have h_alg : μ * (m * m) = (μ * m) * m := by ring
  calc
    (𝟙 E + μ • H) ≫ H = 𝟙 E ≫ H + (μ • H) ≫ H := by rw [Preadditive.add_comp]
    _ = H + μ • (H ≫ H) := by rw [Category.id_comp, Preadditive.zsmul_comp]
    _ = H + μ • ((m * m) • 𝟙 E) := by rw [h_dispersion]
    _ = H + (μ * (m * m)) • 𝟙 E := by rw [← mul_zsmul]
    _ = H + ((μ * m) * m) • 𝟙 E := by rw [h_alg]
    _ = H + m • 𝟙 E := by rw [h_inv, one_mul]
    _ = m • 𝟙 E + H := by rw [add_comm]
    _ = m • 𝟙 E + (m * μ) • H := by rw [h_m_mu, one_zsmul]
    _ = m • 𝟙 E + m • (μ • H) := by rw [mul_zsmul]
    _ = m • (𝟙 E + μ • H) := by rw [smul_add]

/-- Negative sector isolation for the normalized BdG involution: the doubled
negative Peirce projector `Q₋ = 𝟙 E - ε_BdG` isolates the `-m` energy
eigenvalue, `Q₋ ≫ H = -m • Q₋`. -/
theorem normalized_bdg_negative_sector_eigenvalue {E : C}
    (H : E ⟶ E) (m μ : ℤ) (h_inv : μ * m = 1)
    (h_dispersion : H ≫ H = (m * m) • 𝟙 E) :
    (𝟙 E - μ • H) ≫ H = - (m • (𝟙 E - μ • H)) := by
  have h_m_mu : m * μ = 1 := (mul_comm μ m) ▸ h_inv
  have h_alg : μ * (m * m) = (μ * m) * m := by ring
  calc
    (𝟙 E - μ • H) ≫ H = 𝟙 E ≫ H - (μ • H) ≫ H := by rw [Preadditive.sub_comp]
    _ = H - μ • (H ≫ H) := by rw [Category.id_comp, Preadditive.zsmul_comp]
    _ = H - μ • ((m * m) • 𝟙 E) := by rw [h_dispersion]
    _ = H - (μ * (m * m)) • 𝟙 E := by rw [← mul_zsmul]
    _ = H - ((μ * m) * m) • 𝟙 E := by rw [h_alg]
    _ = H - m • 𝟙 E := by rw [h_inv, one_mul]
    _ = - (m • 𝟙 E - H) := by rw [neg_sub]
    _ = - (m • 𝟙 E - (m * μ) • H) := by rw [h_m_mu, one_zsmul]
    _ = - (m • 𝟙 E - m • (μ • H)) := by rw [mul_zsmul]
    _ = - (m • (𝟙 E - μ • H)) := by rw [smul_sub]

/-- Ghost decoupling of the normalized BdG involution at the doubled level:
the two Peirce projectors of `ε_BdG = μ • H` mutually annihilate,
`Q₊ ≫ Q₋ = 0`, because `ε_BdG` is a proved split involution. -/
theorem normalized_bdg_peirce_annihilation {E : C}
    (H : E ⟶ E) (m μ : ℤ) (h_inv : μ * m = 1)
    (h_dispersion : H ≫ H = (m * m) • 𝟙 E) :
    (𝟙 E + μ • H) ≫ (𝟙 E - μ • H) = 0 := by
  have hε := normalized_bdg_is_split_involution H m μ h_inv h_dispersion
  rw [Preadditive.add_comp, Preadditive.comp_sub, Preadditive.comp_sub]
  simp only [Category.id_comp, Category.comp_id, hε]
  abel

/-- Partition of unity of the normalized BdG involution at the doubled level:
`Q₊ + Q₋ = 2 • 𝟙 E`. -/
theorem normalized_bdg_peirce_partition {E : C}
    (H : E ⟶ E) (μ : ℤ) :
    (𝟙 E + μ • H) + (𝟙 E - μ • H) = (2 : ℤ) • 𝟙 E := by
  rw [two_zsmul]
  abel

end InfoGeometry.Physics.Bogoliubov
