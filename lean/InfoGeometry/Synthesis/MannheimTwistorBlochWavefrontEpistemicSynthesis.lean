instance : PartialOrder MannheimEpistemicArchetype where
  le a b := mannheimLe a b = true
  le_refl a := by
    have href : ∀ i : Fin 13, mannheimLe (archOfFin i) (archOfFin i) = true := by decide
    rw [← archOfFin_toFin a]
    exact href (archToFin a)
  le_trans a b c hab hbc := by
    have hfin : ∀ i j k : Fin 13,
        mannheimLe (archOfFin i) (archOfFin j) = true →
        mannheimLe (archOfFin j) (archOfFin k) = true →
        mannheimLe (archOfFin i) (archOfFin k) = true := by decide
    rw [← archOfFin_toFin a, ← archOfFin_toFin c]
    refine hfin (archToFin a) (archToFin b) (archToFin c) ?_ ?_
    · rw [archOfFin_toFin, archOfFin_toFin]
      exact hab
    · rw [archOfFin_toFin, archOfFin_toFin]
      exact hbc
  le_antisymm a b hab hba := by
    have hanti : ∀ i j : Fin 13,
        mannheimLe (archOfFin i) (archOfFin j) = true →
        mannheimLe (archOfFin j) (archOfFin i) = true →
        i = j := by decide
    have hidx : archToFin a = archToFin b := by
      refine hanti (archToFin a) (archToFin b) ?_ ?_
      · rw [archOfFin_toFin, archOfFin_toFin]
        exact hab
      · rw [archOfFin_toFin, archOfFin_toFin]
        exact hba
    rw [← archOfFin_toFin a, ← archOfFin_toFin b, hidx]

instance : DecidableRel (· ≤ · : MannheimEpistemicArchetype → MannheimEpistemicArchetype → Prop) :=
  fun a b => inferInstanceAs (Decidable (mannheimLe a b = true))

instance : DecidableRel (· < · : MannheimEpistemicArchetype → MannheimEpistemicArchetype → Prop) :=
