{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TranslationPacket.schema.json",
  "title": "TranslationPacket",
  "allOf": [
    {
      "$ref": "common_envelope.schema.json"
    },
    {
      "$ref": "authority.schema.json"
    },
    {
      "$ref": "representation.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "packet_version",
        "packet_hash",
        "invariant_refs",
        "namespace_candidate",
        "signature_candidates",
        "module_candidate",
        "imports_candidate",
        "minimal_probe_plan"
      ],
      "properties": {
        "kind": {
          "const": "TranslationPacket"
        },
        "status": {
          "enum": [
            "draft",
            "legalized",
            "probe_ready",
            "gated",
            "executed",
            "accepted",
            "rejected",
            "deferred"
          ]
        },
        "authority": {
          "const": "proposal"
        },
        "packet_version": {
          "type": "string",
          "minLength": 1
        },
        "packet_hash": {
          "type": "string",
          "minLength": 1
        },
        "invariant_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "source_ref.schema.json"
          }
        },
        "namespace_candidate": {
          "type": "string",
          "minLength": 1
        },
        "signature_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "module_candidate": {
          "type": "string",
          "minLength": 1
        },
        "imports_candidate": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimal_probe_plan": {
          "type": "object",
          "required": [
            "probe_kind",
            "steps"
          ],
          "properties": {
            "probe_kind": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "declaration_name_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependency_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_surface": {
          "type": "string"
        },
        "anchor_refs": {
          "type": "array",
          "items": {
            "$ref": "source_ref.schema.json"
          }
        },
        "promotion_allowed": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  ]
}
