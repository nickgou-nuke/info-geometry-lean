import InfoGeometry.Algebra.IdempotentTwoSidedSpan
import InfoGeometry.Algebra.FiniteSpinAlgebra

/-!
# Finite fullness criterion for an idempotent

The two-sided span generated by an idempotent is full whenever a finite sum
of its elementary generators is the unit.  This is the finite algebraic
criterion needed before any Morita claim; it does not assert that a chosen
idempotent is full.
-/

namespace InfoGeometry.Algebra.IdempotentTwoSidedSpan

open scoped BigOperators

variable {A : Type*} [Ring A]

theorem twoSidedSpan_eq_top_of_finite_fullness
    {ι : Type*} (e : A) (s : Finset ι) (a b : ι → A)
    (hfull : s.sum (fun i => a i * e * b i) = 1) :
    twoSidedSpan e = ⊤ := by
  apply twoSidedSpan_eq_top_iff_one_mem e |>.2
  rw [← hfull]
  exact Submodule.sum_mem (twoSidedSpan e) (fun i hi =>
    generator_mem_twoSidedSpan e (a i) (b i))

end InfoGeometry.Algebra.IdempotentTwoSidedSpan
