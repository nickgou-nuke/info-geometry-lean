import InfoGeometry.Algebra.ZornLeftCAR
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Algebra.Lie.Subalgebra

/-!
# Associator defect of the native Zorn left action

The native Zorn left-multiplication map preserves squares and polarized products.
Its failure to preserve ordered products is precisely the associator.
No Filippov or Nambu–Poisson identity is asserted.
-/

namespace InfoGeometry.Algebra.ZornLeftCAR

open ZornPinorReconstruction

attribute [local instance] LieRing.ofAssociativeRing

noncomputable section

/-- Difference between multiplication by a product and composition of actions. -/
def multiplicationDefect (X Y : Z) : Module.End ℝ Z :=
  leftMultiplication (ZornVectorMatrix.mul X Y) -
    leftMultiplication X * leftMultiplication Y

@[simp] theorem multiplicationDefect_apply (X Y W : Z) :
    multiplicationDefect X Y W = ZornVectorMatrix.associator X Y W := rfl

/-- Every associator defect annihilates the native multiplicative unit. -/
@[simp] theorem multiplicationDefect_one (X Y : Z) :
    multiplicationDefect X Y ZornVectorMatrix.one = 0 := by
  change ZornVectorMatrix.mul (ZornVectorMatrix.mul X Y) ZornVectorMatrix.one -
      ZornVectorMatrix.mul X (ZornVectorMatrix.mul Y ZornVectorMatrix.one) = 0
  rw [ZornVectorMatrix.mul_one, ZornVectorMatrix.mul_one, sub_self]

/-- A nonzero associator defect cannot itself be a left multiplication:
evaluation at the unit separates the two operator forms. -/
theorem nonzero_multiplicationDefect_not_mem_left_range
    (X Y : Z) (hD : multiplicationDefect X Y ≠ 0) :
    multiplicationDefect X Y ∉ LinearMap.range leftMultiplication := by
  rintro ⟨W, hW⟩
  have he := LinearMap.congr_fun hW ZornVectorMatrix.one
  have hW0 : W = 0 := by
    simpa only [leftMultiplication_apply, ZornVectorMatrix.mul_one,
      multiplicationDefect_one] using he
  apply hD
  calc
    multiplicationDefect X Y = leftMultiplication W := hW.symm
    _ = 0 := by rw [hW0, map_zero]

/-- Polarization makes the multiplication defect skew in its two inputs. -/
theorem multiplicationDefect_swap (X Y : Z) :
    multiplicationDefect Y X = -multiplicationDefect X Y := by
  have h := leftMultiplication_anticommutator X Y
  rw [map_add] at h
  unfold multiplicationDefect
  have h' := congrArg (fun T : Module.End ℝ Z =>
    T - leftMultiplication X * leftMultiplication Y -
      leftMultiplication (ZornVectorMatrix.mul Y X)) h
  have hn := congrArg Neg.neg h'
  convert hn using 1 <;> abel

/-- Exact criterion for a fixed pair to act multiplicatively on the whole module. -/
theorem leftMultiplication_mul_eq_iff (X Y : Z) :
    leftMultiplication (ZornVectorMatrix.mul X Y) =
        leftMultiplication X * leftMultiplication Y ↔
      ∀ W, ZornVectorMatrix.associator X Y W = ZornVectorMatrix.zero := by
  constructor
  · intro h W
    have he := LinearMap.congr_fun h W
    change ZornVectorMatrix.mul (ZornVectorMatrix.mul X Y) W =
      ZornVectorMatrix.mul X (ZornVectorMatrix.mul Y W) at he
    change ZornVectorMatrix.mul (ZornVectorMatrix.mul X Y) W -
      ZornVectorMatrix.mul X (ZornVectorMatrix.mul Y W) = 0
    exact sub_eq_zero.mpr he
  · intro h
    apply LinearMap.ext
    intro W
    exact sub_eq_zero.mp (h W)

/-- The commutator correction is twice the associator, with the owner's sign. -/
theorem leftMultiplication_commutator_defect (X Y : Z) :
    leftMultiplication X * leftMultiplication Y -
        leftMultiplication Y * leftMultiplication X =
      leftMultiplication (ZornVectorMatrix.commutator X Y) -
        2 • multiplicationDefect X Y := by
  have h := multiplicationDefect_swap X Y
  change leftMultiplication X * leftMultiplication Y -
      leftMultiplication Y * leftMultiplication X =
    leftMultiplication (ZornVectorMatrix.mul X Y - ZornVectorMatrix.mul Y X) -
      2 • multiplicationDefect X Y
  rw [map_sub, two_nsmul]
  calc
    _ = (leftMultiplication (ZornVectorMatrix.mul X Y) -
        leftMultiplication (ZornVectorMatrix.mul Y X)) -
        multiplicationDefect X Y + multiplicationDefect Y X := by
          unfold multiplicationDefect
          abel
    _ = _ := by rw [h]; abel

/-- The associator defect is generated by the left actions under the native
operator Lie bracket. -/
theorem multiplicationDefect_eq_half_commutator_correction (X Y : Z) :
    multiplicationDefect X Y =
      (1 / 2 : ℝ) •
        (leftMultiplication (ZornVectorMatrix.commutator X Y) -
          ⁅leftMultiplication X, leftMultiplication Y⁆) := by
  have h := leftMultiplication_commutator_defect X Y
  rw [two_nsmul] at h
  have hsum : multiplicationDefect X Y + multiplicationDefect X Y =
      leftMultiplication (ZornVectorMatrix.commutator X Y) -
        ⁅leftMultiplication X, leftMultiplication Y⁆ := by
    rw [LieRing.of_associative_ring_bracket, h]
    abel
  calc
    multiplicationDefect X Y =
        (1 / 2 : ℝ) • ((2 : ℝ) • multiplicationDefect X Y) := by
      norm_num [smul_smul]
    _ = (1 / 2 : ℝ) •
        (multiplicationDefect X Y + multiplicationDefect X Y) := by
      rw [two_smul]
    _ = _ := by rw [hsum]

/-- Every associator defect belongs to the Lie subalgebra generated by all
native left-multiplication operators. -/
theorem multiplicationDefect_mem_native_lieSpan (X Y : Z) :
    multiplicationDefect X Y ∈
      LieSubalgebra.lieSpan ℝ (Module.End ℝ Z) (Set.range leftMultiplication) := by
  rw [multiplicationDefect_eq_half_commutator_correction]
  exact (LieSubalgebra.lieSpan ℝ (Module.End ℝ Z) (Set.range leftMultiplication)).smul_mem
    (1 / 2 : ℝ)
    ((LieSubalgebra.lieSpan ℝ (Module.End ℝ Z) (Set.range leftMultiplication)).sub_mem
      (LieSubalgebra.subset_lieSpan ⟨ZornVectorMatrix.commutator X Y, rfl⟩)
      ((LieSubalgebra.lieSpan ℝ (Module.End ℝ Z) (Set.range leftMultiplication)).lie_mem
        (LieSubalgebra.subset_lieSpan ⟨X, rfl⟩)
        (LieSubalgebra.subset_lieSpan ⟨Y, rfl⟩)))

/-- The defect for `U 0` and `U 1` is nonzero, witnessed by its action on
`U 2` through the existing nonmultiplicativity theorem. -/
theorem multiplicationDefect_U01_ne_zero :
    multiplicationDefect (ZornVectorMatrix.U 0) (ZornVectorMatrix.U 1) ≠ 0 := by
  intro h
  apply leftMultiplication_not_multiplicative
  unfold multiplicationDefect at h
  exact (sub_eq_zero.mp h).symm

/-- A nonzero associator defect strictly enlarges the linear range of left
actions inside their generated operator Lie algebra. -/
theorem left_action_range_lt_native_lieSpan :
    LinearMap.range leftMultiplication <
      (LieSubalgebra.lieSpan ℝ (Module.End ℝ Z)
        (Set.range leftMultiplication)).toSubmodule := by
  refine lt_iff_le_not_ge.mpr ⟨?_, ?_⟩
  · intro T hT
    exact LieSubalgebra.subset_lieSpan hT
  · intro hback
    exact nonzero_multiplicationDefect_not_mem_left_range
      (ZornVectorMatrix.U 0) (ZornVectorMatrix.U 1)
      multiplicationDefect_U01_ne_zero
      (hback (multiplicationDefect_mem_native_lieSpan
        (ZornVectorMatrix.U 0) (ZornVectorMatrix.U 1)))

end
end InfoGeometry.Algebra.ZornLeftCAR
