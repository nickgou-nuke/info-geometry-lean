{"type":"new","contents":"import Mathlib.Algebra.Star.Basic\nimport Mathlib.Algebra.Star.SelfAdjoint\nimport Mathlib.Algebra.Star.StarProjection\nimport Mathlib.Algebra.Ring.Basic\nimport Mathlib.Analysis.InnerProductSpace.Adjoint\nimport Mathlib.Analysis.Normed.Ring.Basic\nimport Mathlib.Tactic.NoncommRing\nimport InfoGeometry.Canonical.Drazin\nimport InfoGeometry.Singular.MoorePenrose\nimport InfoGeometry.Meta.Architecture\n\nnamespace InfoGeometry.Canonical.MoorePenrose\n\nopen InfoGeometry.Canonical.Drazin\n\n/-!\n# Moore-Penrose Inverse\n\nFormalization of the Moore-Penrose pseudoinverse in a StarRing.\nThe Moore-Penrose inverse `b` of an element `a` satisfies:\n1. `a * b * a = a`\n2. `b * a * b = b`\n3. `(a * b)* = a * b`  (Right projector is self-adjoint)\n4. `(b * a)* = b * a`  (Left projector is self-adjoint)\n-/\n\n/-- Predicate encoding the Moore-Penrose inverse laws. -/\n@[rep_depth krein]\ndef IsMoorePenroseInverse {R : Type*} [Ring R] [StarRing R] (a b : R) : Prop :=\n  a * b * a = a ∧\n  b * a * b = b ∧\n  star (a * b) = a * b ∧\n  star (b * a) = b * a\n\nnamespace IsMoorePenroseInverse\n\nvariable {R : Type*} [Ring R] [StarRing R] {a b : R}\n\n/-- Constructor for the Moore-Penrose laws predicate. -/\n@[rep_depth krein]\ntheorem mk\n    (haba : a * b * a = a)\n    (hbab : b * a * b = b)\n    (habstar : star (a * b) = a * b)\n    (hbastar : star (b * a) = b * a) :\n    IsMoorePenroseInverse a b :=\n  ⟨haba, hbab, habstar, hbastar⟩\n\n/-- Penrose relation `a b a = a`. -/\n@[rep_depth krein]\ntheorem aba_eq_a (h : IsMoorePenroseInverse a b) : a * b * a = a := h.1\n\n/-- Penrose relation `b a b = b`. -/\n@[rep_depth krein]\ntheorem bab_eq_b (h : IsMoorePenroseInverse a b) : b * a * b = b := h.2.1\n\n/-- Self-adjointness of `a*b`. -/\n@[rep_depth krein]\ntheorem ab_star (h : IsMoorePenroseInverse a b) : star (a * b) = a * b := h.2.2.1\n\n/-- Self-adjointness of `b*a`. -/\n@[rep_depth krein]\ntheorem ba_star (h : IsMoorePenroseInverse a b) : star (b * a) = b * a := h.2.2.2\n\n/-- Star reverses a triple product. -/\n@[rep_depth krein]\nlemma star_mul_triple (x y z : R) : star (x * y * z) = star z * star y * star x := by\n  calc\n    star (x * y * z) = star ((x * y) * z) := rfl\n    _ = star z * star (x * y) := by rw [star_mul]\n    _ = star z * (star y * star x) := by rw [star_mul]\n    _ = star z * star y * star x := by rw [← mul_assoc]\n\n/-- Transport a canonical Moore-Penrose proof to the singular Moore-Penrose API. -/\nprivate theorem toSingular (h : IsMoorePenroseInverse a b) :\n    InfoGeometry.Singular.MoorePenrose.IsMoorePenroseInverse a b := by\n  exact InfoGeometry.Singular.MoorePenrose.IsMoorePenroseInverse.mk\n    h.aba_eq_a h.bab_eq_b h.ab_star h.ba_star\n\n/-- Moore-Penrose inverse uniqueness routed through the singular owner theorem. -/\n@[rep_depth krein]\ntheorem unique {c : R}\n    (hB : IsMoorePenroseInverse a b)\n    (hC : IsMoorePenroseInverse a c) :\n    b = c := by\n  exact InfoGeometry.Singular.MoorePenrose.MoorePenrose_unique\n    (toSingular hB) (toSingular hC)\n\n/-- Taking `star` transports a Moore-Penrose inverse of `a` to one of `star a`. -/\n@[rep_depth krein]\ntheorem star_isMoorePenroseInverse (h : IsMoorePenroseInverse a b) :\n    IsMoorePenroseInverse (star a) (star b) := by\n  refine mk ?_ ?_ ?_ ?_\n  · simpa [mul_assoc] using congrArg (fun x : R => star x) h.aba_eq_a\n  · simpa [mul_assoc] using congrArg (fun x : R => star x) h.bab_eq_b\n  · simpa using congrArg (fun x : R => star x) h.ba_star\n  · simpa using congrArg (fun x : R => star x) h.ab_star\n\n/--\nIf `a` is self-adjoint and `b` is a Moore-Penrose inverse of `a`, then `b` is\nself-adjoint.\n-/\n@[rep_depth krein]\ntheorem star_eq_self_of_selfAdjoint\n    (h : IsMoorePenroseInverse a b)\n    (ha : star a = a) :\n    star b = b := by\n  have hstar : IsMoorePenroseInverse a (star b) := by\n    simpa [ha] using h.star_isMoorePenroseInverse\n  exact unique hstar h\n\n/-- The geometric projection onto the range of `a`. -/\n@[rep_depth krein]\ndef rightProjector (a b : R) : R := a * b\n\n/-- The geometric projection onto the co-range of `a`. -/\n@[rep_depth krein]\ndef leftProjector (a b : R) : R := b * a\n\n/-- Root algebra for the Moore-Penrose range projector idempotence. -/\n@[rep_depth krein]\nlemma right_projector_idempotent_root (h : IsMoorePenroseInverse a b) :\n    (a * b) * (a * b) = a * b := by\n  calc\n    (a * b) * (a * b) = (a * b * a) * b := by simp [mul_assoc]\n    _ = a * b := by rw [h.aba_eq_a]\n\n/-- Theorem: The range projection is idempotent (P² = P). -/\n@[rep_depth krein]\ntheorem rightProjector_idempotent :\n    (h : IsMoorePenroseInverse a b) →\n    (rightProjector a b) * (rightProjector a b) = rightProjector a b := by\n  intro h\n  simpa [rightProjector] using right_projector_idempotent_root h\n\n/-- Theorem: The range projection is self-adjoint (P* = P). -/\n@[rep_depth krein]\ntheorem rightProjector_star (h : IsMoorePenroseInverse a b) :\n    star (rightProjector a b) = rightProjector a b :=\n  h.ab_star\n\n/-- Root algebra for the Moore-Penrose co-range projector idempotence. -/\n@[rep_depth krein]\nlemma left_projector_idempotent_root (h : IsMoorePenroseInverse a b) :\n    (b * a) * (b * a) = b * a := by\n  calc\n    (b * a) * (b * a) = (b * a * b) * a := by simp [mul_assoc]\n    _ = b * a := by rw [h.bab_eq_b]\n\n/-- Theorem: The co-range projection is idempotent (P² = P). -/\n@[rep_depth krein]\ntheorem leftProjector_idempotent :\n    (h : IsMoorePenroseInverse a b) →\n    (leftProjector a b) * (leftProjector a b) = leftProjector a b := by\n  intro h\n  simpa [leftProjector] using left_projector_idempotent_root h\n\n/-- Theorem: The co-range projection is self-adjoint (P* = P). -/\n@[rep_depth krein]\ntheorem leftProjector_star (h : IsMoorePenroseInverse a b) :\n    star (leftProjector a b) = leftProjector a b :=\n  h.ba_star\n\n/-- The Moore-Penrose range projector `a*b` is a star projection. -/\n@[rep_depth krein]\ntheorem rightProjector_isStarProjection (h : IsMoorePenroseInverse a b) :\n    IsStarProjection (rightProjector a b) := by\n  rw [isStarProjection_iff']\n  exact ⟨rightProjector_idempotent h, rightProjector_star h⟩\n\n/-- The Moore-Penrose domain/co-range projector `b*a` is a star projection. -/\n@[rep_depth krein]\ntheorem leftProjector_isStarProjection (h : IsMoorePenroseInverse a b) :\n    IsStarProjection (leftProjector a b) := by\n  rw [isStarProjection_iff']\n  exact ⟨leftProjector_idempotent h, leftProjector_star h⟩\n\n/-- The complement of the Moore-Penrose range projector is a star projection. -/\n@[rep_depth krein]\ntheorem rightProjector_complement_isStarProjection\n    (h : IsMoorePenroseInverse a b) :\n    IsStarProjection (1 - rightProjector a b) :=\n  (rightProjector_isStarProjection h).one_sub\n\n/-- The complement of the Moore-Penrose domain/co-range projector is a star projection. -/\n@[rep_depth krein]\ntheorem leftProjector_complement_isStarProjection\n    (h : IsMoorePenroseInverse a b) :\n    IsStarProjection (1 - leftProjector a b) :=\n  (leftProjector_isStarProjection h).one_sub\n\nsection Hilbert\n\nvariable {𝕜 E : Type*}\nvariable [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]\nvariable {A B : E →L[𝕜] E}\n\n/--\nThe Moore-Penrose range projector is the orthogonal projection onto its own\nrange.\n\nThe `HasOrthogonalProjection` instance for the range is produced by Mathlib\nfrom the star-projection proof.\n-/\n@[rep_depth krein]\ntheorem rightProjector_eq_ownRange_starProjection\n    (h : IsMoorePenroseInverse A B) :\n    ∃ (_ : (rightProjector A B).range.HasOrthogonalProjection),\n      rightProjector A B = (rightProjector A B).range.starProjection :=\n  isStarProjection_iff_eq_starProjection_range.mp\n    (rightProjector_isStarProjection h)\n\n/--\nThe Moore-Penrose domain/co-range projector is the orthogonal projection onto\nits own range.\n\nThe `HasOrthogonalProjection` instance for the range is produced by Mathlib\nfrom the star-projection proof.\n-/\n@[rep_depth krein]\ntheorem leftProjector_eq_ownRange_starProjection\n    (h : IsMoorePenroseInverse A B) :\n    ∃ (_ : (leftProjector A B).range.HasOrthogonalProjection),\n      leftProjector A B = (leftProjector A B).range.starProjection :=\n  isStarProjection_iff_eq_starProjection_range.mp\n    (leftProjector_isStarProjection h)\n\n/-- The range of the Moore-Penrose range projector `A*B` is the range of `A`. -/\n@[rep_depth krein]\ntheorem rightProjector_range_eq_range\n    (h : IsMoorePenroseInverse A B) :\n    (rightProjector A B).range = A.range := by\n  ext y\n  constructor\n  · intro hy\n    rcases hy with ⟨x, rfl⟩\n    exact ⟨B x, rfl⟩\n  · intro hy\n    rcases hy with ⟨x, rfl⟩\n    refine ⟨A x, ?_⟩\n    have hx := congrArg (fun T : E →L[𝕜] E => T x) h.aba_eq_a\n    simpa [rightProjector, ContinuousLinearMap.mul_def,\n      ContinuousLinearMap.comp_assoc] using hx\n\n/--\nThe Moore-Penrose range projector is the orthogonal projection onto\n`range A`.\n-/\n@[rep_depth krein]\ntheorem rightProjector_eq_range_starProjection\n    (h : IsMoorePenroseInverse A B) :\n    ∃ (_ : A.range.HasOrthogonalProjection),\n      rightProjector A B = A.range.starProjection := by\n  have hRange : (rightProjector A B).range = A.range :=\n    rightProjector_range_eq_range h\n  rw [← hRange]\n  exact rightProjector_eq_ownRange_starProjection h\n\n/--\nThe range of the Moore-Penrose domain/co-range projector `B*A` is\n`ker(A)ᗮ`.\n-/\n@[rep_depth krein]\ntheorem leftProjector_range_eq_ker_orthogonal\n    (h : IsMoorePenroseInverse A B) :\n    (leftProjector A B).range = A.kerᗮ := by\n  have hKer : (leftProjector A B).ker = A.ker := by\n    ext x\n    constructor\n    · intro hx\n      have hx' : (leftProjector A B) x = 0 := by\n        simpa [LinearMap.mem_ker] using hx\n      have hcalc : A ((leftProjector A B) x) = A x := by\n        simpa [leftProjector, ContinuousLinearMap.mul_def, ContinuousLinearMap.comp_assoc]\n          using DFunLike.congr_fun h.aba_eq_a x\n      have hzero : A ((leftProjector A B) x) = 0 := by rw [hx', map_zero]\n      exact (LinearMap.mem_ker).2 (hcalc ▸ hzero)\n    · intro hx\n      have hx' : A x = 0 := by\n        simpa [LinearMap.mem_ker] using hx\n      exact (LinearMap.mem_ker).2 (by simp [leftProjector, hx'])\n  have hOrth : (leftProjector A B).rangeᗮ = A.ker := by\n    calc\n      (leftProjector A B).rangeᗮ = (star (leftProjector A B)).ker := by\n        simpa using (leftProjector A B).orthogonal_range\n      _ = (leftProjector A B).ker := by rw [leftProjector_star h]\n      _ = A.ker := hKer\n  rcases leftProjector_eq_ownRange_starProjection h with ⟨hInst, _hProj⟩\n  letI : (leftProjector A B).range.HasOrthogonalProjection := hInst\n  calc\n    (leftProjector A B).range = ((leftProjector A B).range)ᗮᗮ := by\n      exact (Submodule.orthogonal_orthogonal (K := (leftProjector A B).range)).symm\n    _ = A.kerᗮ := by rw [hOrth]\n\n/--\nThe Moore-Penrose domain/co-range projector is the orthogonal projection onto\n`ker(A)ᗮ`.\n-/\n@[rep_depth krein]\ntheorem leftProjector_eq_kerOrthogonal_starProjection\n    (h : IsMoorePenroseInverse A B) :\n    ∃ (_ : A.kerᗮ.HasOrthogonalProjection),\n      leftProjector A B = A.kerᗮ.starProjection := by\n  rcases leftProjector_eq_ownRange_starProjection h with ⟨hProj, hEq⟩\n  have hRange : (leftProjector A B).range = A.kerᗮ :=\n    leftProjector_range_eq_ker_orthogonal h\n  rw [← hRange]\n  exact ⟨hProj, hEq⟩\n\nend Hilbert\n\nend IsMoorePenroseInverse\n\n/-! ### Chiral Anomaly and Scale Generation -/\n\n/-- Spectral projector from Drazin data. -/\n@[rep_depth krein]\ndef spectralProjector {R : Type*} [Ring R] (a a_d : R) : R :=\n  IsDrazinInverse.projection a a_d\n\n/-- Metric projector from Moore-Penrose data. -/\n@[rep_depth krein]\ndef metricProjector {R : Type*} [Ring R] [StarRing R] (a a_mp : R) : R :=\n  IsMoorePenroseInverse.leftProjector a a_mp\n\n/--\nProjector mismatch `Δ = P_D - P_MP` between spectral and metric sectors.\n-/\n@[rep_depth krein]\ndef projectorMismatch {R : Type*} [Ring R] [StarRing R] (a a_d a_mp : R) : R :=\n  spectralProjector a a_d - metricProjector a a_mp\n\n/--\nThe Chiral Anomaly Operator (χ).\nDefined as the commutator between the spectral projector (Drazin) \nand the geometric left projector (Moore-Penrose).\nχ = [P_D, P_L].\n-/\n@[rep_depth krein]\ndef chiralAnomaly {R : Type*} [Ring R] [StarRing R] (a a_d a_mp : R) : R :=\n  let P_D := IsDrazinInverse.projection a a_d\n  let P_L := IsMoorePenroseInverse.leftProjector a a_mp\n  P_D * P_L - P_L * P_D\n\n/--\nAlgebraic identity: the anomaly commutator is the mismatch commutator with the\nmetric projector.\n-/\n@[rep_depth krein]\ntheorem chiralAnomaly_eq_mismatch_commutator_metric\n    {R : Type*} [Ring R] [StarRing R] (a a_d a_mp : R) :\n    chiralAnomaly a a_d a_mp =\n      projectorMismatch a a_d a_mp * metricProjector a a_mp\n        - metricProjector a a_mp * projectorMismatch a a_d a_mp := by\n  unfold chiralAnomaly projectorMismatch spectralProjector metricProjector\n  unfold IsDrazinInverse.projection IsMoorePenroseInverse.leftProjector\n  noncomm_ring\n\n/--\nIf the spectral-metric mismatch vanishes, the anomaly vanishes.\n-/\n@[rep_depth krein]\ntheorem chiralAnomaly_eq_zero_of_projectorMismatch_eq_zero\n    {R : Type*} [Ring R] [StarRing R] {a a_d a_mp : R}\n    (hΔ : projectorMismatch a a_d a_mp = 0) :\n    chiralAnomaly a a_d a_mp = 0 := by\n  rw [chiralAnomaly_eq_mismatch_commutator_metric]\n  simp [hΔ]\n\n/-- Vanishing mismatch is equivalent to projector equality. -/\n@[rep_depth krein]\ntheorem projectorMismatch_eq_zero_iff\n    {R : Type*} [Ring R] [StarRing R] {a a_d a_mp : R} :\n    projectorMismatch a a_d a_mp = 0 ↔\n      spectralProjector a a_d = metricProjector a a_mp := by\n  unfold projectorMismatch\n  exact sub_eq_zero\n\n/--\nThe Emergent Scale ε.\nGenerated by the divergence between geometry and spectrum.\nε = || [P_D, P_L] ||.\n-/\n@[rep_depth krein]\nnoncomputable def epsilon {R : Type*} [NormedRing R] [StarRing R] (a a_d a_mp : R) : ℝ :=\n  nnnorm (chiralAnomaly a a_d a_mp)\n\n/-- Backward-compatible alias for the emergent anomaly scale ε. -/\n@[rep_depth krein]\nnoncomputable def chiralScale {R : Type*} [NormedRing R] [StarRing R] (a a_d a_mp : R) : ℝ :=\n  epsilon a a_d a_mp\n\nend InfoGeometry.Canonical.MoorePenrose\n","mtime":1778213250202}