import InfoGeometry.Modular.SchrodingerGKSL
import InfoGeometry.Modular.SchrodingerFlow
import Mathlib.Analysis.CStarAlgebra.Matrix
import Mathlib.Analysis.InnerProductSpace.Calculus
import Mathlib.Analysis.ODE.ExistUnique

/-! # Exponential evolution of the finite-matrix Schrödinger GKSL generator

This bridge uses the existing complex matrix GKSL generator and the existing
bounded exponential flow.  It proves the operator-valued semigroup law, orbit
equation, and trace preservation.  It does not identify a Kraus family or
assert complete positivity or convergence to a Gibbs state.
-/

noncomputable section

namespace InfoGeometry.Modular.SchrodingerGKSLFlowBridge

open Matrix
open scoped Matrix.Norms.L2Operator
open InfoGeometry.Modular.SchrodingerGKSL
open InfoGeometry.Modular.SchrodingerFlow

variable {n : Type*} [Fintype n] [DecidableEq n]
local notation "Mat" => Matrix n n ℂ

/-- Left multiplication by a fixed matrix, as a continuous complex-linear
operator on the full matrix algebra. -/
def leftMul (A : Mat) : Mat →L[ℂ] Mat := ContinuousLinearMap.mul ℂ Mat A

/-- Right multiplication by a fixed matrix, as a continuous complex-linear
operator on the full matrix algebra. -/
def rightMul (A : Mat) : Mat →L[ℂ] Mat := (ContinuousLinearMap.mul ℂ Mat).flip A

/-- The existing Schrödinger GKSL generator, assembled from actual matrix
multiplication operators.  This construction retains the ordered products
and obtains continuity from the finite-dimensional matrix algebra. -/
def generatorCLM (H : Mat) {ι : Type*} [Fintype ι] (V : ι → Mat) :
    Mat →L[ℂ] Mat :=
  -Complex.I • (leftMul H - rightMul H) +
    ∑ k, ((leftMul (V k)).comp (rightMul (star (V k))) -
      (1 / 2 : ℂ) •
        (leftMul (star (V k) * V k) + rightMul (star (V k) * V k)))

@[simp] theorem generatorCLM_apply (H X : Mat) {ι : Type*} [Fintype ι]
    (V : ι → Mat) :
    generatorCLM H V X = schrodingerLindbladian H V X := by
  simp [generatorCLM, leftMul, rightMul, schrodingerLindbladian,
    hamiltonianTerm, schrodingerDissipator, schrodingerDissipatorTerm,
    ContinuousLinearMap.comp_apply, mul_assoc]

/-- The real continuous endomorphism generated by the finite-dimensional GKSL
operator, obtained by restricting scalars on its complex-linear construction. -/
def generatorEnd (H : Mat) {ι : Type*} [Fintype ι] (V : ι → Mat) :
    Mat →L[ℝ] Mat :=
  (generatorCLM H V).restrictScalars ℝ

/-- Real part of the ordinary matrix trace, as a continuous real-linear map. -/
def realTraceCLM : Mat →L[ℝ] ℝ :=
  Complex.reCLM.comp (Matrix.traceLinearMap n ℝ ℂ).toContinuousLinearMap

omit [DecidableEq n] in
@[simp] private theorem realTraceCLM_apply (X : Mat) :
    realTraceCLM X = (Matrix.trace X).re := rfl

/-- Exponential orbit of the Schrödinger GKSL generator on the full matrix
operator space. -/
def gkslFlow (H : Mat) {ι : Type*} [Fintype ι] (V : ι → Mat)
    (t : ℝ) : Mat →L[ℝ] Mat :=
  flow (generatorEnd H V) t

theorem gkslFlow_add (H : Mat) {ι : Type*} [Fintype ι]
    (V : ι → Mat) (s t : ℝ) :
    gkslFlow H V (s + t) = gkslFlow H V s * gkslFlow H V t :=
  flow_add (generatorEnd H V) s t

theorem hasDerivAt_gkslFlow_orbit (H : Mat) {ι : Type*} [Fintype ι]
    (V : ι → Mat) (X : Mat) (t : ℝ) :
    HasDerivAt (fun s : ℝ => gkslFlow H V s X)
      (schrodingerLindbladian H V (gkslFlow H V t X)) t := by
  simpa [gkslFlow, generatorEnd, generatorCLM_apply] using
    (hasDerivAt_orbit (generatorEnd H V) X t)

/-- Uniqueness of the finite-matrix GKSL orbit: any global differentiable
solution of the same autonomous Schrödinger equation with initial value `X`
is the exponential flow orbit. This is the ODE uniqueness bridge needed to
identify explicit propagators with `gkslFlow`; it does not itself assert that a
particular propagator solves the equation. -/
theorem gkslFlow_unique_of_ode (H : Mat) {ι : Type*} [Fintype ι]
    (V : ι → Mat) (X : Mat) (f : ℝ → Mat)
    (hf : ∀ t, HasDerivAt f (schrodingerLindbladian H V (f t)) t)
    (h0 : f 0 = X) :
    f = fun t => gkslFlow H V t X := by
  let v : ℝ → Mat → Mat := fun _ Y => generatorEnd H V Y
  have hv : ∀ t, LipschitzOnWith ‖generatorEnd H V‖₊ (v t) Set.univ := by
    intro t
    simpa [v] using
      (lipschitzOnWith_univ.mpr (generatorEnd H V).lipschitzWith)
  have hf' : ∀ t, HasDerivAt f (v t (f t)) t ∧ f t ∈ Set.univ := by
    intro t
    constructor
    · simpa [v, generatorEnd, generatorCLM_apply] using hf t
    · exact Set.mem_univ _
  have hg' : ∀ t, HasDerivAt (fun s => gkslFlow H V s X)
      (v t (gkslFlow H V t X)) t ∧ gkslFlow H V t X ∈ Set.univ := by
    intro t
    constructor
    · simpa [v, generatorEnd, generatorCLM_apply] using
        hasDerivAt_gkslFlow_orbit H V X t
    · exact Set.mem_univ _
  have hinit : f 0 = (fun t => gkslFlow H V t X) 0 := by
    simpa [gkslFlow, flow_zero] using h0
  exact ODE_solution_unique_univ hv hf' hg' hinit

/-- The full matrix trace is conserved by the exponential flow because the
existing Schrödinger-picture generator has trace zero on every operator. -/
theorem realTrace_gkslFlow (H : Mat) {ι : Type*} [Fintype ι]
    (V : ι → Mat) (X : Mat) (t : ℝ) :
    (Matrix.trace (gkslFlow H V t X)).re = (Matrix.trace X).re := by
  apply trace_flow_preservation (generatorEnd H V) realTraceCLM ?_ X t
  intro Y
  change (Matrix.trace (generatorCLM H V Y)).re = 0
  rw [generatorCLM_apply, trace_schrodingerLindbladian_zero]
  rfl

end InfoGeometry.Modular.SchrodingerGKSLFlowBridge

end noncomputable section
