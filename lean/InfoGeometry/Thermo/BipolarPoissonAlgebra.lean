import InfoGeometry.OperatorAlgebra.OperatorExteriorAlgebra
import InfoGeometry.Thermo.BipolarGENERICThreeCoordinateModel
import Mathlib

/-!
# Poisson algebra generated by the bipolar reversible plane

The three-coordinate GENERIC owner already contains the skew cotangent map

`L(alpha) = alpha(e_a) e_theta - alpha(e_theta) e_a`.

This file gives its algebra-of-observables counterpart.  The input is not an
informal pair of partial derivatives but two repository-native `OpDerivation`s
on a commutative real algebra, together with their exact commutation law.  The
resulting bracket

`{F,G} = D_theta(F) D_a(G) - D_a(F) D_theta(G)`

is proved bilinear, skew, Leibniz in both entries, and Jacobi.  Observables
annihilated by both derivations are Casimirs.

The commutation hypothesis is structural data, not a conclusion about arbitrary
derivations.  No smooth-function algebra is postulated when no such analytic
carrier has been constructed.
-/

noncomputable section

namespace InfoGeometry.Thermo.BipolarPoissonAlgebra

open InfoGeometry.OperatorAlgebra.ExteriorAlgebra
open InfoGeometry.Thermo.BipolarGENERICThreeCoordinateModel
open InfoGeometry.Thermo.GenericMetriplecticFlow

variable {A : Type*} [CommRing A] [Algebra ℝ A]

/-- Two commuting real-linear Leibniz derivations representing the canonical
`theta` and auxiliary directions. -/
structure CommutingDerivationPair (A : Type*) [CommRing A] [Algebra ℝ A] where
  theta : OpDerivation ℝ A
  auxiliary : OpDerivation ℝ A
  commute : ∀ x : A, theta (auxiliary x) = auxiliary (theta x)

/-- Constant rank-two Poisson bracket associated with the commuting derivation
pair. -/
def poissonBracket
    (D : CommutingDerivationPair A) (F G : A) : A :=
  D.theta F * D.auxiliary G - D.auxiliary F * D.theta G

/-- Skew-symmetry. -/
theorem poissonBracket_skew
    (D : CommutingDerivationPair A) (F G : A) :
    poissonBracket D F G = -poissonBracket D G F := by
  simp [poissonBracket]
  ring

@[simp] theorem poissonBracket_self
    (D : CommutingDerivationPair A) (F : A) :
    poissonBracket D F F = 0 := by
  simp [poissonBracket]

/-- Additivity in the first argument. -/
theorem poissonBracket_add_left
    (D : CommutingDerivationPair A) (F₁ F₂ G : A) :
    poissonBracket D (F₁ + F₂) G =
      poissonBracket D F₁ G + poissonBracket D F₂ G := by
  simp [poissonBracket]
  ring

/-- Additivity in the second argument. -/
theorem poissonBracket_add_right
    (D : CommutingDerivationPair A) (F G₁ G₂ : A) :
    poissonBracket D F (G₁ + G₂) =
      poissonBracket D F G₁ + poissonBracket D F G₂ := by
  simp [poissonBracket]
  ring

/-- Real homogeneity in the first argument. -/
theorem poissonBracket_smul_left
    (D : CommutingDerivationPair A) (c : ℝ) (F G : A) :
    poissonBracket D (c • F) G = c • poissonBracket D F G := by
  simp [poissonBracket, Algebra.smul_mul_assoc,
    Algebra.mul_smul_comm, smul_sub]

/-- Real homogeneity in the second argument. -/
theorem poissonBracket_smul_right
    (D : CommutingDerivationPair A) (c : ℝ) (F G : A) :
    poissonBracket D F (c • G) = c • poissonBracket D F G := by
  simp [poissonBracket, Algebra.smul_mul_assoc,
    Algebra.mul_smul_comm, smul_sub]

/-- Leibniz rule in the second argument. -/
theorem poissonBracket_leibniz_right
    (D : CommutingDerivationPair A) (F G H : A) :
    poissonBracket D F (G * H) =
      poissonBracket D F G * H + G * poissonBracket D F H := by
  simp [poissonBracket]
  ring

/-- Leibniz rule in the first argument. -/
theorem poissonBracket_leibniz_left
    (D : CommutingDerivationPair A) (F G H : A) :
    poissonBracket D (F * G) H =
      F * poissonBracket D G H + poissonBracket D F H * G := by
  simp [poissonBracket]
  ring

/-- Expansion of the theta derivative of the bracket. -/
theorem theta_poissonBracket
    (D : CommutingDerivationPair A) (F G : A) :
    D.theta (poissonBracket D F G) =
      (D.theta (D.theta F) * D.auxiliary G +
        D.theta F * D.theta (D.auxiliary G)) -
      (D.theta (D.auxiliary F) * D.theta G +
        D.auxiliary F * D.theta (D.theta G)) := by
  simp [poissonBracket]

/-- Expansion of the auxiliary derivative of the bracket. -/
theorem auxiliary_poissonBracket
    (D : CommutingDerivationPair A) (F G : A) :
    D.auxiliary (poissonBracket D F G) =
      (D.auxiliary (D.theta F) * D.auxiliary G +
        D.theta F * D.auxiliary (D.auxiliary G)) -
      (D.auxiliary (D.auxiliary F) * D.theta G +
        D.auxiliary F * D.auxiliary (D.theta G)) := by
  simp [poissonBracket]

/-- Jacobi identity, derived from the Leibniz laws and commutation of the two
coordinate derivations. -/
theorem poissonBracket_jacobi
    (D : CommutingDerivationPair A) (F G H : A) :
    poissonBracket D (poissonBracket D F G) H +
      poissonBracket D (poissonBracket D G H) F +
      poissonBracket D (poissonBracket D H F) G = 0 := by
  change
    (D.theta (poissonBracket D F G) * D.auxiliary H -
        D.auxiliary (poissonBracket D F G) * D.theta H) +
      (D.theta (poissonBracket D G H) * D.auxiliary F -
        D.auxiliary (poissonBracket D G H) * D.theta F) +
      (D.theta (poissonBracket D H F) * D.auxiliary G -
        D.auxiliary (poissonBracket D H F) * D.theta G) = 0
  rw [theta_poissonBracket, auxiliary_poissonBracket,
    theta_poissonBracket, auxiliary_poissonBracket,
    theta_poissonBracket, auxiliary_poissonBracket]
  rw [D.commute F, D.commute G, D.commute H]
  ring

/-- Casimir predicate for the Poisson bracket. -/
def IsCasimir
    (D : CommutingDerivationPair A) (C : A) : Prop :=
  ∀ F : A, poissonBracket D F C = 0

/-- An observable annihilated by both coordinate derivations is a Casimir. -/
theorem isCasimir_of_derivations_eq_zero
    (D : CommutingDerivationPair A) (C : A)
    (hθ : D.theta C = 0) (ha : D.auxiliary C = 0) :
    IsCasimir D C := by
  intro F
  simp [poissonBracket, hθ, ha]

/-- Every observable Poisson-commutes with itself. -/
theorem hamiltonian_self_conservation
    (D : CommutingDerivationPair A) (H : A) :
    poissonBracket D H H = 0 :=
  poissonBracket_self D H

/-- A Casimir is preserved by every Hamiltonian bracket. -/
theorem casimir_conservation
    (D : CommutingDerivationPair A) (C H : A)
    (hC : IsCasimir D C) :
    poissonBracket D C H = 0 := by
  rw [poissonBracket_skew, hC H]
  simp

/-- Cotangent bivector pairing induced by the existing reversible operator. -/
def cotangentPoissonPairing
    (α β : Covector State3) : ℝ :=
  α (reversibleOperator β)

/-- Coordinate evaluation of the cotangent bivector. -/
theorem cotangentPoissonPairing_eq
    (α β : Covector State3) :
    cotangentPoissonPairing α β =
      α thetaBasis3 * β auxiliaryBasis3 -
        α auxiliaryBasis3 * β thetaBasis3 := by
  simp [cotangentPoissonPairing, reversibleOperator]
  ring

/-- The two active coordinate covectors form the canonical Poisson pair. -/
@[simp] theorem cotangentPoissonPairing_theta_auxiliary :
    cotangentPoissonPairing thetaCovector auxiliaryCovector = 1 := by
  rw [cotangentPoissonPairing_eq]
  simp

/-- Reversing the coordinate pair changes the sign. -/
@[simp] theorem cotangentPoissonPairing_auxiliary_theta :
    cotangentPoissonPairing auxiliaryCovector thetaCovector = -1 := by
  rw [cotangentPoissonPairing_eq]
  simp

/-- The longitudinal eta covector is a Casimir direction of the cotangent
Poisson tensor. -/
@[simp] theorem cotangentPoissonPairing_eta_left
    (β : Covector State3) :
    cotangentPoissonPairing etaCovector β = 0 := by
  rw [cotangentPoissonPairing_eq]
  simp

@[simp] theorem cotangentPoissonPairing_eta_right
    (α : Covector State3) :
    cotangentPoissonPairing α etaCovector = 0 := by
  rw [cotangentPoissonPairing_eq]
  simp

/-- Compact Poisson-algebra packet. -/
theorem bipolar_poisson_algebra_packet
    (D : CommutingDerivationPair A) (F G H : A) :
    poissonBracket D F G = -poissonBracket D G F ∧
      poissonBracket D F (G * H) =
        poissonBracket D F G * H + G * poissonBracket D F H ∧
      poissonBracket D (poissonBracket D F G) H +
        poissonBracket D (poissonBracket D G H) F +
        poissonBracket D (poissonBracket D H F) G = 0 := by
  exact ⟨poissonBracket_skew D F G,
    poissonBracket_leibniz_right D F G H,
    poissonBracket_jacobi D F G H⟩

end InfoGeometry.Thermo.BipolarPoissonAlgebra
