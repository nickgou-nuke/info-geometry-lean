import InfoGeometry.Canonical.BekensteinBound
import InfoGeometry.Canonical.RicciMongeAmpere
import Mathlib.Tactic

namespace MongeAmpereCramerRao

open InfoGeometry.Convex
open InfoGeometry.Canonical.MoE
open BekensteinBound
open RicciMongeAmpere

section CramerRaoMetric

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- Cramer-Rao metric operator: Hessian metric operator of the information potential. -/
noncomputable abbrev cramerRaoMetricOp
    (H : HessianGeometry E) (x : E) : E →L[ℝ] E :=
  H.metricOp x

/-- Cramer-Rao metric bilinear form induced by `cramerRaoMetricOp`. -/
noncomputable abbrev cramerRaoMetric
    (H : HessianGeometry E) (x : E) (u v : E) : ℝ :=
  H.metric x u v

end CramerRaoMetric

section MongeAmpereBridge

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [CompleteSpace E]

/-- Incompressible Monge-Ampere regime: Hessian density is identically one. -/
def IncompressibleMongeAmpere (H : HessianGeometry E) : Prop :=
  SatisfiesMongeAmpere H (fun _ => (1 : ℝ))

/-- Liouville regime: Monge-Ampere density is sourced by `exp(2 * Φ)`. -/
def LiouvilleMongeAmpere (H : HessianGeometry E) (Φ : E → ℝ) : Prop :=
  SatisfiesMongeAmperePotential H (fun x => 2 * Φ x)

/-- Operator owner surface for the Cramer-Rao metric in the Monge-Ampere lane. -/
noncomputable abbrev cramerRaoMetricOperatorOwner
    (H : HessianGeometry E) (x : E) : E →L[ℝ] E :=
  cramerRaoMetricOp H x

/-- Scalar readout shadow of the Cramer-Rao operator owner. -/
noncomputable def cramerRaoMetricVolumeShadow
    (H : HessianGeometry E) (x : E) : ℝ :=
  |LinearMap.det (cramerRaoMetricOperatorOwner H x).toLinearMap|

/-- Potential readout associated to the Cramer-Rao volume shadow. -/
noncomputable def cramerRaoMetricVolumePotential
    (H : HessianGeometry E) (x : E) : ℝ :=
  -Real.log (cramerRaoMetricVolumeShadow H x)

/-- Readout seal: potential form equals negative log absolute determinant of the owner operator. -/
@[simp] theorem cramerRaoMetricVolumePotential_eq_neg_logAbsDet
    (H : HessianGeometry E) (x : E) :
    cramerRaoMetricVolumePotential H x
      = -Real.log (|LinearMap.det (cramerRaoMetricOp H x).toLinearMap|) := by
  rfl

/-- Incompressible Monge-Ampere plus nondegeneracy implies unit Cramer-Rao determinant magnitude. -/
theorem absDet_cramerRaoMetric_eq_one_of_incompressible
    (H : HessianGeometry E)
    (hIncomp : IncompressibleMongeAmpere H)
    (x : E)
    (_hdet : LinearMap.det (cramerRaoMetricOp H x).toLinearMap ≠ 0) :
    |LinearMap.det (cramerRaoMetricOp H x).toLinearMap| = 1 := by
  simpa [IncompressibleMongeAmpere, mongeAmpereDensity, cramerRaoMetricOp] using hIncomp x

/-- Incompressible Monge-Ampere forces zero potential readout for the Cramer-Rao volume mode. -/
theorem cramerRaoMetricVolumePotential_eq_zero_of_incompressible
    (H : HessianGeometry E)
    (hIncomp : IncompressibleMongeAmpere H)
    (x : E) :
    cramerRaoMetricVolumePotential H x = 0 := by
  have hUnit : |LinearMap.det (cramerRaoMetricOp H x).toLinearMap| = 1 := by
    simpa [IncompressibleMongeAmpere, mongeAmpereDensity, cramerRaoMetricOp] using hIncomp x
  unfold cramerRaoMetricVolumePotential cramerRaoMetricVolumeShadow cramerRaoMetricOperatorOwner
  rw [hUnit, Real.log_one]
  simp

/--
Anti-trivialization witness: a nonzero Cramer-Rao potential at any point rules out
incompressible Monge-Ampere globally.
-/
theorem not_incompressible_of_cramerRaoMetricVolumePotential_ne_zero
    (H : HessianGeometry E)
    (x : E)
    (hPotNe : cramerRaoMetricVolumePotential H x ≠ 0) :
    ¬ IncompressibleMongeAmpere H := by
  intro hIncomp
  exact hPotNe (cramerRaoMetricVolumePotential_eq_zero_of_incompressible (H := H) hIncomp x)

/-- Incompressible Monge-Ampere implies zero log-volume mode of the Cramer-Rao metric. -/
theorem logAbsDet_cramerRaoMetric_eq_zero_of_incompressible
    (H : HessianGeometry E)
    (hIncomp : IncompressibleMongeAmpere H)
    (x : E) :
    Real.log (|LinearMap.det (cramerRaoMetricOp H x).toLinearMap|) = 0 := by
  have hCramerRaoMetricVolumePotentialZero : cramerRaoMetricVolumePotential H x = 0 :=
    cramerRaoMetricVolumePotential_eq_zero_of_incompressible (H := H) hIncomp x
  have hNegLogZero : -Real.log (|LinearMap.det (cramerRaoMetricOp H x).toLinearMap|) = 0 := by
    simpa [cramerRaoMetricVolumePotential_eq_neg_logAbsDet] using hCramerRaoMetricVolumePotentialZero
  linarith
end MongeAmpereBridge

section SqueezingFlow

/-- Expanding eigenvalue generated by chiral squeezing at flow parameter `t`. -/
noncomputable def squeezingEigenPlus (t : ℝ) : ℝ :=
  Real.exp (2 * t)

/-- Contracting eigenvalue generated by chiral squeezing at flow parameter `t`. -/
noncomputable def squeezingEigenMinus (t : ℝ) : ℝ :=
  Real.exp (-2 * t)

/-- Logarithmic squeezing shear ratio. -/
noncomputable def squeezingLogShear (t : ℝ) : ℝ :=
  Real.log (squeezingEigenPlus t / squeezingEigenMinus t)

/-- Chiral squeezing preserves total volume. -/
@[simp] theorem squeezingEigen_product_eq_one (t : ℝ) :
    squeezingEigenPlus t * squeezingEigenMinus t = 1 := by
  unfold squeezingEigenPlus squeezingEigenMinus
  calc
    Real.exp (2 * t) * Real.exp (-2 * t)
      = Real.exp ((2 * t) + (-2 * t)) := by
          rw [← Real.exp_add]
    _ = Real.exp 0 := by ring_nf
    _ = 1 := by simp

/-- Logarithmic shear equals `4t` for the split `exp(±2t)` spectrum. -/
@[simp] theorem squeezingLogShear_eq_four_mul (t : ℝ) :
    squeezingLogShear t = 4 * t := by
  unfold squeezingLogShear squeezingEigenPlus squeezingEigenMinus
  have hPlus : Real.exp (2 * t) ≠ 0 := Real.exp_ne_zero _
  have hMinus : Real.exp (-2 * t) ≠ 0 := Real.exp_ne_zero _
  calc
    Real.log (Real.exp (2 * t) / Real.exp (-2 * t))
      = Real.log (Real.exp (2 * t)) - Real.log (Real.exp (-2 * t)) := by
          exact Real.log_div hPlus hMinus
    _ = (2 * t) - (-2 * t) := by simp
    _ = 4 * t := by ring

/-- Absolute logarithmic shear is `4|t|`. -/
@[simp] theorem abs_squeezingLogShear_eq_four_mul_abs (t : ℝ) :
    |squeezingLogShear t| = 4 * |t| := by
  rw [squeezingLogShear_eq_four_mul]
  calc
    |4 * t| = |4| * |t| := by simp [abs_mul]
    _ = 4 * |t| := by norm_num

/-- Any barrier bound on `|t|` yields a barrier bound on logarithmic squeezing shear. -/
theorem abs_squeezingLogShear_le_of_abs_time_le_barrier
    {t b : ℝ}
    (hTime : |t| ≤ b) :
    |squeezingLogShear t| ≤ 4 * b := by
  rw [abs_squeezingLogShear_eq_four_mul_abs]
  nlinarith [hTime]

end SqueezingFlow

section BekensteinBridge

variable {n : Nat} (T : SinkhornTrajectory n)

/--
Topological Bekenstein bound controls the absolute logarithmic squeezing shear,
provided the flow-time budget is bounded by the same RN barrier level.
-/
theorem abs_squeezingLogShear_le_of_topologicalBekensteinBound
    (hBound : TopologicalBekensteinBound n T)
    (k : Nat)
    (t : ℝ)
    (hTime : |t| ≤ trajectoryRNBarrier n T k) :
    |squeezingLogShear t| ≤ 4 * trajectoryRNBarrier n T k := by
  have hBarrierNonneg : 0 ≤ trajectoryRNBarrier n T k := hBound k
  rw [abs_squeezingLogShear_eq_four_mul_abs]
  nlinarith [hTime, hBarrierNonneg]

/-- Canonical specialization using the built-in Sinkhorn trajectory Bekenstein theorem. -/
theorem abs_squeezingLogShear_le_of_sinkhornTrajectory
    (k : Nat)
    (t : ℝ)
    (hTime : |t| ≤ trajectoryRNBarrier n T k) :
    |squeezingLogShear t| ≤ 4 * trajectoryRNBarrier n T k := by
  exact abs_squeezingLogShear_le_of_topologicalBekensteinBound
    (T := T)
    (hBound := topologicalBekensteinBound_of_sinkhornTrajectory (n := n) T)
    k t hTime

end BekensteinBridge

end MongeAmpereCramerRao
