{
  "schema_version": "identity_protocol.thresholds.v1",
  "metric_mode": "proxy",
  "thresholds": {
    "tau_A_max": 0.05,
    "tau_B_max": 0.10,
    "tau_C_proxy_max": 0.20,
    "epsilon_majorana_max": 0.05,
    "kappa_max": 0.25,
    "delta_M_max": 0.10
  },
  "verdict_logic": {
    "UNIFIED": {
      "requires": [
        "tau_A_pass",
        "tau_B_pass",
        "epsilon_pass",
        "kappa_pass",
        "delta_M_pass"
      ],
      "tau_C_proxy_is_blocker_only": true
    },
    "CONDITIONAL": {
      "allows_soft_failures": [
        "tau_C_proxy_pass",
        "kappa_pass"
      ],
      "max_soft_failures": 1
    },
    "BIFURCATED": {
      "requires_any_failure": [
        "tau_A_pass",
        "tau_B_pass",
        "epsilon_pass",
        "delta_M_pass"
      ]
    }
  }
}
