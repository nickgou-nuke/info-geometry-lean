import InfoGeometry.Core.PeirceRotor
import InfoGeometry.Canonical.MatrixTwoNoncommutativity
import Mathlib.Algebra.Algebra.NonUnitalSubalgebra
import Mathlib.Data.Matrix.Basis
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.Tactic

/-! # Faithful matrix representation generated by a reflexive square-zero pair

The target is the original full matrix algebra. Its supported image need not
contain the ambient identity or exhaust the full support corner. Nonzero input
is required for faithfulness; no star, diagonalization, or commutativity of the
matrix generators is assumed.
-/
namespace InfoGeometry.Core.PeirceMatrixRepresentation

open Matrix InfoGeometry.Core.DualSeedPeirce InfoGeometry.Core.PeirceRotor
open scoped Matrix

variable {n : Type*} [Fintype n] [DecidableEq n]

section Ring
variable {R : Type*} [CommRing R] {X Y : Matrix n n R}

/-- The existing Peirce multiplication law as a native non-unital algebra map. -/
def representation (h : IsDualSeedPair X Y) :
    Matrix (Fin 2) (Fin 2) R →ₙₐ[R] Matrix n n R where
  toFun M := peirceBlock X Y (M 0 0) (M 0 1) (M 1 0) (M 1 1)
  map_zero' := by simp [peirceBlock]
  map_add' M N := by simp only [Matrix.add_apply, peirceBlock, add_smul]; abel
  map_smul' a M := by
    simp only [Matrix.smul_apply, smul_eq_mul, peirceBlock, smul_add, smul_smul,
      MonoidHom.id_apply]
  map_mul' M N := by
    simp only [peirceBlock_mul h, Matrix.mul_apply, Fin.sum_univ_two]

@[simp] theorem representation_single01 (h : IsDualSeedPair X Y) (a : R) :
    representation h (Matrix.single 0 1 a) = a • X := by
  simp [representation, peirceBlock, Matrix.single]

@[simp] theorem representation_single10 (h : IsDualSeedPair X Y) (a : R) :
    representation h (Matrix.single 1 0 a) = a • Y := by
  simp [representation, peirceBlock, Matrix.single]

/-- The identity maps to the active support, not necessarily the ambient identity. -/
theorem representation_one (h : IsDualSeedPair X Y) :
    representation h 1 = X * Y + Y * X := by
  simp [representation, peirceBlock, polePlus, poleMinus,
    InfoGeometry.Singular.MoorePenrose.exactSupport,
    InfoGeometry.Singular.MoorePenrose.coexactSupport]

theorem support_mul_representation (h : IsDualSeedPair X Y)
    (M : Matrix (Fin 2) (Fin 2) R) :
    (X * Y + Y * X) * representation h M = representation h M := by
  rw [← representation_one h, ← map_mul, one_mul]

theorem representation_mul_support (h : IsDualSeedPair X Y)
    (M : Matrix (Fin 2) (Fin 2) R) :
    representation h M * (X * Y + Y * X) = representation h M := by
  rw [← representation_one h, ← map_mul, mul_one]

/-- The image is exactly the non-unital subalgebra generated by the two matrices. -/
theorem range_eq_adjoin (h : IsDualSeedPair X Y) :
    (representation h).range = NonUnitalAlgebra.adjoin R ({X, Y} : Set (Matrix n n R)) := by
  apply le_antisymm
  · intro Z hZ
    obtain ⟨M, rfl⟩ := hZ
    have hx : X ∈ NonUnitalAlgebra.adjoin R ({X, Y} : Set (Matrix n n R)) :=
      NonUnitalAlgebra.subset_adjoin R (by simp)
    have hy : Y ∈ NonUnitalAlgebra.adjoin R ({X, Y} : Set (Matrix n n R)) :=
      NonUnitalAlgebra.subset_adjoin R (by simp)
    change M 0 0 • (X * Y) + M 0 1 • X + M 1 0 • Y + M 1 1 • (Y * X) ∈ _
    exact add_mem (add_mem (add_mem
      (SMulMemClass.smul_mem _ (mul_mem hx hy)) (SMulMemClass.smul_mem _ hx))
      (SMulMemClass.smul_mem _ hy)) (SMulMemClass.smul_mem _ (mul_mem hy hx))
  · apply NonUnitalAlgebra.adjoin_le
    intro Z hZ
    rcases Set.mem_insert_iff.mp hZ with rfl | hZ
    · refine ⟨Matrix.single 0 1 1, ?_⟩
      change representation h (Matrix.single 0 1 1) = _
      simp
    · have : Z = Y := Set.mem_singleton_iff.mp hZ
      subst Z
      refine ⟨Matrix.single 1 0 1, ?_⟩
      change representation h (Matrix.single 1 0 1) = Y
      simp

/-- Nonzero reflexive square-zero partners cannot commute, in any characteristic. -/
theorem generators_mul_ne (h : IsDualSeedPair X Y) (hx : X ≠ 0) :
    X * Y ≠ Y * X := by
  intro hc
  apply hx
  calc
    X = X * Y * X := h.inner.symm
    _ = Y * (X * X) := by rw [hc, mul_assoc]
    _ = 0 := by rw [h.d_sq, mul_zero]

end Ring

section Field
variable {R : Type*} [Field R] {X Y : Matrix n n R}

/-- Matrix-unit sandwiches recover every coefficient from a nonzero generator. -/
theorem representation_eq_zero_iff (h : IsDualSeedPair X Y) (hx : X ≠ 0)
    (M : Matrix (Fin 2) (Fin 2) R) : representation h M = 0 ↔ M = 0 := by
  constructor
  · intro hz
    ext i j
    have hs : representation h
        (Matrix.single 0 i 1 * M * Matrix.single j 1 1) = 0 := by
      rw [map_mul, map_mul, hz, mul_zero, zero_mul]
    rw [Matrix.single_mul_mul_single, one_mul, mul_one, representation_single01] at hs
    exact (smul_eq_zero.mp hs).resolve_right hx
  · rintro rfl
    exact map_zero _

theorem representation_injective (h : IsDualSeedPair X Y) (hx : X ≠ 0) :
    Function.Injective (representation h) := by
  intro M N heq
  apply sub_eq_zero.mp
  apply (representation_eq_zero_iff h hx (M - N)).mp
  rw [map_sub, heq, sub_self]

/-- Faithfulness has an explicit non-degeneracy criterion. -/
theorem representation_injective_iff (h : IsDualSeedPair X Y) :
    Function.Injective (representation h) ↔ X ≠ 0 := by
  refine ⟨?_, representation_injective h⟩
  intro hi hx
  have hm : (Matrix.single 0 1 (1 : R) : Matrix (Fin 2) (Fin 2) R) = 0 :=
    hi (by simp [hx])
  have hz := congrArg (fun M : Matrix (Fin 2) (Fin 2) R => M 0 1) hm
  simp at hz

/-- The supported image is four-dimensional even when its ambient corner is larger. -/
theorem finrank_range (h : IsDualSeedPair X Y) (hx : X ≠ 0) :
    Module.finrank R (representation h).range = 4 := by
  change Module.finrank R (LinearMap.range (LinearMap.ofClass (representation h))) = 4
  rw [LinearMap.finrank_range_of_inj (representation_injective h hx)]
  simp [Module.finrank_matrix]

/-- Dimension of the actual generated non-unital matrix subalgebra. -/
theorem finrank_adjoin (h : IsDualSeedPair X Y) (hx : X ≠ 0) :
    Module.finrank R (NonUnitalAlgebra.adjoin R ({X, Y} : Set (Matrix n n R))) = 4 := by
  rw [← range_eq_adjoin h]
  exact finrank_range h hx

end Field
end InfoGeometry.Core.PeirceMatrixRepresentation
