import Mathlib.Data.Complex.Basic
import Mathlib.Tactic.Ring

/-!
# Holographic Scale Extinctions

Formalizes the topological filter generated by the nonsymmorphic boundary 
glide reflection. The `(-1)^k` phase shift in momentum space completely 
extinguishes bulk zero-modes at odd scaling dimensions.
-/

namespace HolographicScaleExtinctions

/-- The Fourier coefficient phase shift on the fixed line `k₂ = 0` 
    under the boundary glide reflection `pg`. -/
def glidePhase (k : ℤ) : ℂ :=
  if Even k then 1 else -1

/-- If `k` is odd, the phase shift evaluates strictly to `-1`. -/
theorem glidePhase_odd (k : ℤ) (hOdd : Odd k) :
    glidePhase k = -1 := by
  unfold glidePhase
  have hNotEven : ¬ Even k := by omega
  simp [hNotEven]

/-- 
Theorem: Boundary Extinction Rule.
If a boundary state is physically symmetric under the wallpaper glide 
reflection, its Fourier coefficients must obey `c = phase * c`. 
For odd momenta, this algebraic constraint forces `c = 0`.
-/
theorem boundary_extinction (k : ℤ) (c : ℂ) (hOdd : Odd k) 
    (hSymmetric : c = glidePhase k * c) : c = 0 := by
  have hPhase := glidePhase_odd k hOdd
  rw [hPhase] at hSymmetric
  -- We now have `c = -1 * c`, which implies `2c = 0`
  calc
    c = (c + -1 * c) / 2 := by ring
    _ = (c + c) / 2 := by rw [← hSymmetric]
    _ = 0 := by ring

/-- 
A bulk zero-mode at continuous scaling dimension `s` and discrete 
boundary momentum `k` is physically allowed ONLY if:
1. It sits on the lightcone dispersion `s = ±k`.
2. It satisfies the boundary glide symmetry phase constraint.
3. Its wavefunction does not vanish (`c ≠ 0`).
-/
structure AllowedBulkState where
  s : ℤ
  k : ℤ
  c : ℂ
  dispersion : s = k ∨ s = -k
  symmetric : c = glidePhase k * c
  nonTrivial : c ≠ 0

/-- 
Theorem: Topologically Quantized Holographic Spectrum!
The bulk continuous scaling dimension `s` can NEVER be odd.

If `s` were odd, the dispersion relation would force `k` to be odd.
This would trigger the nonsymmorphic boundary extinction rule `c = 0`, 
violating the existence of the state (`c ≠ 0`). 
Therefore, the discrete 2D spatial geometry perfectly quantizes the 
allowed 3D continuous bulk spectrum strictly to even integers `s ∈ {±2n}`!
-/
theorem no_odd_bulk_scales (state : AllowedBulkState) : ¬ Odd state.s := by
  intro hOdd_s
  have hOdd_k : Odd state.k := by
    cases state.dispersion with
    | inl heq => rw [←heq]; exact hOdd_s
    | inr hneg => 
        have h_s : Odd (-state.k) := by rw [←hneg]; exact hOdd_s
        omega
  have hExtinction : state.c = 0 := boundary_extinction state.k state.c hOdd_k state.symmetric
  exact state.nonTrivial hExtinction

end HolographicScaleExtinctions
