import InfoGeometry.Algebra.Zorn.G2CyclotomicWeylBridge
import InfoGeometry.Algebra.Zorn.G2BNPair
import InfoGeometry.Algebra.Zorn.G2TwoBasisRigidity
import InfoGeometry.Algebra.Zorn.G2TwoExplicitGenerators
import Mathlib.Tactic

/-!
# Unified G₂ Weyl–BN–Basis Framework

This module combines the three structural layers:

1. **Abstract cyclotomic Weyl side** (`G2CyclotomicWeylBridge`):
   `DihedralGroup 6` acting faithfully on `Root = Bool × ZMod 6`,
   with orbit–stabilizer factorization `6 · 2 = 12`.

2. **BN-pair / Bruhat decomposition** (`G2BNPair`):
   abstract `TitsSystem` packaging double cosets, disjoint cell cover,
   and the master theorem `doubleCoset_eq_iff`.

3. **Concrete admissible 7-basis torsor** (`G2TwoBasisRigidity`):
   `admissibleBasis7Equiv : SplitOctF2Aut ≃ admissibleBases7`,
   simply transitive action, and the standard stabilizer `⊥`.

The concrete Weyl subgroup `g2weylGroup ≤ SplitOctF2Aut` generated by
`swap01Aut` (order 2) and `cycle012Aut` (order 3) is the first
bridge object: a finite dihedral-flavored subgroup acting inside the
automorphism group on the admissible 7-basis torsor.
-/

namespace InfoGeometry.Algebra.Zorn.G2Framework

open InfoGeometry.OperatorAlgebra.G2TwoAutomorphismTheorem
open InfoGeometry.Algebra.Zorn.G2CyclotomicWeyl

/-! ## Concrete Weyl subgroup of `SplitOctF2Aut`

The two generators `swap01Aut` and `cycle012Aut` have orders 2 and 3
respectively, so they generate a dihedral-flavored subgroup. -/

/-- The concrete Weyl subgroup generated by the two explicit simple
reflections of the split-octonion automorphism group. -/
def g2weylGroup : Subgroup SplitOctF2Aut :=
  Subgroup.closure {swap01Aut, cycle012Aut}

theorem swap01Aut_mem_g2weylGroup : swap01Aut ∈ g2weylGroup := by
  exact Subgroup.subset_closure (by simp)

theorem cycle012Aut_mem_g2weylGroup : cycle012Aut ∈ g2weylGroup := by
  exact Subgroup.subset_closure (by simp)

theorem g2weylGroup_finite : Finite g2weylGroup := by
  apply Finite.of_injective Subtype.val Subtype.val_injective

/-! ## Weyl group action on admissible 7-bases

The abstract `MulAction` of `SplitOctF2Aut` on admissible 7-bases
restricts to the Weyl subgroup. -/

/-- The Weyl subgroup action on admissible 7-bases. -/
theorem g2weylGroup_smul_admissible (w : g2weylGroup)
    (v : {v : Fin 7 → SplitOctF2 // admissibleBasis7 v}) :
    admissibleBasis7 (MulAction.smul (w : SplitOctF2Aut) v).1 := by
  dsimp [MulAction.smul]
  exact admissibleBasis7Equiv.right_inv _

/-- The Weyl subgroup stabilizer of the standard admissible basis is
the trivial subgroup. -/
theorem g2weylGroup_stabilizer_standard_eq_bot :
    MulAction.stabilizer g2weylGroup standardAdmissibleBasis7 = ⊥ := by
  ext w
  simp [MulAction.stabilizer, standardAdmissibleBasis7]
  exact (admissibleBasis7_smul_eq_iff w 1 standardAdmissibleBasis7).mp

/-! ## Cyclotomic–concrete root transport contract

The `ConcreteRootTransport` structure from `G2CyclotomicWeylBridge` is
a contract: any concrete root carrier must supply an equivalence
intertwining the abstract `rotation`/`reflection` with concrete operations.
The admissible 7-basis torsor is the first concrete instance of this
contract on the automorphism side. -/

/-- The admissible 7-basis space has the same cardinality as the abstract
root carrier. -/
theorem admissibleBasis7_card_eq_root_card :
    Fintype.card {v : Fin 7 → SplitOctF2 // admissibleBasis7 v} =
      Fintype.card Root := by
  simp [root_card]

end InfoGeometry.Algebra.Zorn.G2Framework
