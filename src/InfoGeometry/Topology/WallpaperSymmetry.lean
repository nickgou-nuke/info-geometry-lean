import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra

/-!
# Wallpaper `pg` symmetry: finite Klein-bottle relation

This module formalizes the elementary algebra behind the `pg` wallpaper group:
a glide reflection squares to a lattice translation and conjugates the transverse
translation to its inverse.

This is the finite group-action relation that underlies the usual Klein-bottle
presentation.  The file does not prove a full quotient-manifold classification,
a Brillouin-zone theorem, or a physical topological-insulator result.
-/

noncomputable section

namespace InfoGeometry.Topology.Wallpaper

/-- The 2D Euclidean plane representing a spatial lattice chart. -/
abbrev Lattice2D := ℝ × ℝ

/-- Unit translation in the `x` direction. -/
def T_x : Lattice2D ≃ Lattice2D where
  toFun p := (p.1 + 1, p.2)
  invFun p := (p.1 - 1, p.2)
  left_inv p := by ext <;> simp
  right_inv p := by ext <;> simp

/-- Unit translation in the `y` direction. -/
def T_y : Lattice2D ≃ Lattice2D where
  toFun p := (p.1, p.2 + 1)
  invFun p := (p.1, p.2 - 1)
  left_inv p := by ext <;> simp
  right_inv p := by ext <;> simp

/-- Glide reflection: translate by `1/2` in `x` and reflect `y`. -/
def G : Lattice2D ≃ Lattice2D where
  toFun p := (p.1 + (1 / 2 : ℝ), -p.2)
  invFun p := (p.1 - (1 / 2 : ℝ), -p.2)
  left_inv p := by ext <;> simp
  right_inv p := by ext <;> simp

/-- Concrete `pg` relation: the glide squared is the `x` translation. -/
theorem glide_squared_eq_x_translation (p : Lattice2D) :
    G (G p) = T_x p := by
  ext
  · simp [G, T_x]
    ring
  · simp [G, T_x]

/-- Concrete `pg` relation: the glide inverts the transverse translation. -/
theorem glide_y_translation_commutation (p : Lattice2D) :
    G (T_y p) = T_y.symm (G p) := by
  ext
  · simp [G, T_y]
  · simp [G, T_y]
    ring

/--
An abstract `pg` wallpaper symmetry package.  Its fields are exactly the two
relations above, for any chosen lattice chart action.
-/
structure WallpaperGroupPG where
  T_x : Lattice2D ≃ Lattice2D
  T_y : Lattice2D ≃ Lattice2D
  G : Lattice2D ≃ Lattice2D
  h_glide_squared : ∀ p : Lattice2D, G (G p) = T_x p
  h_commutation : ∀ p : Lattice2D, G (T_y p) = T_y.symm (G p)

/-- The concrete Euclidean `pg` wallpaper package. -/
def concretePG : WallpaperGroupPG where
  T_x := T_x
  T_y := T_y
  G := G
  h_glide_squared := glide_squared_eq_x_translation
  h_commutation := glide_y_translation_commutation

/-- Pullback on real-valued lattice functions induced by an invertible
wallpaper transformation. -/
def wallpaperOperator (e : Equiv.Perm Lattice2D) :
    Module.End ℝ (Lattice2D → ℝ) where
  toFun f p := f (e⁻¹ p)
  map_add' f g := by funext p; rfl
  map_smul' c f := by funext p; rfl

/-- A wallpaper transformation as an invertible function-space operator. -/
def wallpaperOperatorUnit (e : Equiv.Perm Lattice2D) :
    (Module.End ℝ (Lattice2D → ℝ))ˣ where
  val := wallpaperOperator e
  inv := wallpaperOperator e⁻¹
  val_inv := by ext f p; simp [wallpaperOperator]
  inv_val := by ext f p; simp [wallpaperOperator]

/-- The wallpaper transformations act on lattice functions by a group
homomorphism into endomorphism units. -/
def wallpaperOperatorRep : Equiv.Perm Lattice2D →*
    (Module.End ℝ (Lattice2D → ℝ))ˣ where
  toFun := wallpaperOperatorUnit
  map_one' := by apply Units.ext; ext f p; rfl
  map_mul' e₁ e₂ := by apply Units.ext; ext f p; rfl

/-- Point probes make the wallpaper operator representation faithful. -/
theorem wallpaperOperatorRep_injective : Function.Injective wallpaperOperatorRep := by
  classical
  intro e₁ e₂ he
  have hop : wallpaperOperator e₁ = wallpaperOperator e₂ := congrArg Units.val he
  have hinv : e₁⁻¹ = e₂⁻¹ := by
    apply Equiv.ext
    intro p
    let p₁ := e₁⁻¹ p
    let p₂ := e₂⁻¹ p
    let δ : Lattice2D → ℝ := fun q => if q = p₁ then 1 else 0
    have heval := congrArg (fun A : Module.End ℝ (Lattice2D → ℝ) => A δ p) hop
    change δ p₁ = δ p₂ at heval
    have hargs : p₂ = p₁ := by
      by_cases h : p₂ = p₁
      · exact h
      · simp [δ, p₁, p₂] at heval
        exact False.elim (h heval)
    exact hargs.symm
  apply Equiv.ext
  intro p
  have h := congrArg (fun e : Equiv.Perm Lattice2D => e p) (congrArg Inv.inv hinv)
  simpa using h

/-- The actual operator group generated by the concrete `pg` glide and its
transverse lattice translation. -/
def concretePGOperatorGroup : Subgroup (Module.End ℝ (Lattice2D → ℝ))ˣ :=
  Subgroup.closure {wallpaperOperatorUnit G, wallpaperOperatorUnit T_y}

theorem concretePG_glide_mem_operatorGroup :
    wallpaperOperatorUnit G ∈ concretePGOperatorGroup :=
  Subgroup.subset_closure (by simp)

theorem concretePG_yTranslation_mem_operatorGroup :
    wallpaperOperatorUnit T_y ∈ concretePGOperatorGroup :=
  Subgroup.subset_closure (by simp)

/-- The concrete glide and transverse translation do not commute as lattice
permutations. -/
theorem concretePG_glide_ne_mul_yTranslation : G * T_y ≠ T_y * G := by
  intro h
  have h0 := congrArg (fun e : Equiv.Perm Lattice2D => e (0, 0)) h
  have hcoords := congrArg Prod.snd h0
  norm_num [Equiv.Perm.mul_apply, G, T_y] at hcoords

/-- Their faithful function-space operators remain noncommuting inside the
generated operator group. -/
theorem concretePG_operators_noncommute :
    ∃ u v : ↥concretePGOperatorGroup, u * v ≠ v * u := by
  have hne : wallpaperOperatorUnit G * wallpaperOperatorUnit T_y ≠
      wallpaperOperatorUnit T_y * wallpaperOperatorUnit G := by
    intro h
    have h' : wallpaperOperatorRep G * wallpaperOperatorRep T_y =
        wallpaperOperatorRep T_y * wallpaperOperatorRep G := by
      simpa [wallpaperOperatorRep] using h
    have hrep : wallpaperOperatorRep (G * T_y) = wallpaperOperatorRep (T_y * G) := by
      rw [map_mul, map_mul]
      exact h'
    exact concretePG_glide_ne_mul_yTranslation (wallpaperOperatorRep_injective hrep)
  refine ⟨⟨wallpaperOperatorUnit G, concretePG_glide_mem_operatorGroup⟩,
    ⟨wallpaperOperatorUnit T_y, concretePG_yTranslation_mem_operatorGroup⟩, ?_⟩
  intro h
  exact hne (congrArg Subtype.val h)

/-- Any `pg` package has the glide-translation commutation relation. -/
theorem pg_generates_klein_bottle_relation (pg : WallpaperGroupPG) (p : Lattice2D) :
    pg.G (pg.T_y p) = pg.T_y.symm (pg.G p) := by
  exact pg.h_commutation p

/--
Pointwise Klein-bottle presentation relation `G T_y G⁻¹ = T_y⁻¹` for any `pg`
package.  This is the group-presentation identity underlying the quotient
picture; it is still not a proof of a full quotient-manifold classification.
-/
theorem pg_conjugates_y_translation_to_inverse (pg : WallpaperGroupPG) (p : Lattice2D) :
    pg.G (pg.T_y (pg.G.symm p)) = pg.T_y.symm p := by
  have h := pg.h_commutation (pg.G.symm p)
  simpa using h

/-- The concrete `pg` action satisfies the glide-translation commutation relation. -/
theorem concrete_pg_generates_klein_bottle_relation (p : Lattice2D) :
    concretePG.G (concretePG.T_y p) = concretePG.T_y.symm (concretePG.G p) := by
  exact pg_generates_klein_bottle_relation concretePG p

/-- The concrete `pg` action satisfies `G T_y G⁻¹ = T_y⁻¹`. -/
theorem concrete_pg_conjugates_y_translation_to_inverse (p : Lattice2D) :
    concretePG.G (concretePG.T_y (concretePG.G.symm p)) = concretePG.T_y.symm p := by
  exact pg_conjugates_y_translation_to_inverse concretePG p

/-- Iterating the transverse translation preserves the glide conjugation law.

This is the natural finite orbit consequence of the one-step `pg` relation:
the glide carries every natural iterate of `T_y` to the corresponding iterate
of the inverse translation. -/
theorem pg_glide_iterate_y
    (pg : WallpaperGroupPG) (n : ℕ) (p : Lattice2D) :
    pg.G ((pg.T_y : Lattice2D ≃ Lattice2D)^[n] p) =
      (pg.T_y.symm^[n]) (pg.G p) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply']
      rw [pg.h_commutation]
      rw [ih]
      rw [Function.iterate_succ_apply']

/-- The inverse translation satisfies the corresponding iterated glide law. -/
theorem pg_glide_iterate_y_inverse
    (pg : WallpaperGroupPG) (n : ℕ) (p : Lattice2D) :
    pg.G ((pg.T_y.symm : Lattice2D ≃ Lattice2D)^[n] p) =
      (pg.T_y^[n]) (pg.G p) := by
  have hinv (x : Lattice2D) : pg.G (pg.T_y.symm x) = pg.T_y (pg.G x) := by
    have h := pg.h_commutation (pg.T_y.symm x)
    have h' := congrArg pg.T_y h
    simpa using h'.symm
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply']
      rw [hinv]
      rw [ih]
      rw [Function.iterate_succ_apply']

/-- The glide conjugation law extends from natural iterates to all integer
powers of the transverse translation.  This is the group-action form of the
Klein-bottle relation, using the inverse-iterate theorem for negative powers.
-/
theorem pg_glide_zpow_y
    (pg : WallpaperGroupPG) (n : ℤ) (p : Lattice2D) :
    pg.G (((pg.T_y : Lattice2D ≃ Lattice2D) ^ n) p) =
      (((pg.T_y.symm) ^ n) (pg.G p)) := by
  revert p
  induction n using Int.induction_on with
  | zero =>
      intro p
      simp
  | succ n ih =>
      intro p
      rw [zpow_add_one, zpow_add_one]
      simp only [Equiv.Perm.mul_apply]
      have ih' := ih (pg.T_y p)
      rw [ih']
      rw [pg.h_commutation]
  | pred n ih =>
      intro p
      rw [zpow_sub_one, zpow_sub_one]
      simp only [Equiv.Perm.mul_apply]
      have hinv (x : Lattice2D) :
          pg.G (pg.T_y.symm x) = pg.T_y (pg.G x) := by
        have h := pg.h_commutation (pg.T_y.symm x)
        have h' := congrArg pg.T_y h
        simpa using h'.symm
      have hp : pg.T_y⁻¹ p = pg.T_y.symm p := rfl
      rw [hp]
      have ih' := ih (pg.T_y.symm p)
      rw [ih']
      rw [hinv]
      rfl

end InfoGeometry.Topology.Wallpaper

end noncomputable section
