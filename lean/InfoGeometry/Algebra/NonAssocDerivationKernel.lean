import InfoGeometry.Algebra.NonAssocIteratedLeibnizTransport
import Mathlib.Tactic

/-!
# Kernel constants for nonassociative derivations

This file isolates the theorem-safe "constant of integration" layer for a
nonassociative Leibniz derivation.  No exponential, flow, topology, or matrix
proxy is introduced here.

For a linear derivation `D` on a unital nonassociative algebra:

* `D 1 = 0` follows from Leibniz applied to `1 * 1`;
* the scalar line generated by the unit lies in `LinearMap.ker D`;
* `D u₁ = D u₂` exactly when `u₁ - u₂` lies in the kernel.

Thus solutions of `D u = v`, when they exist, form an affine coset of
`LinearMap.ker D`, not merely a coset modulo scalar multiples of `1`.
-/

namespace InfoGeometry.Algebra.NonAssocDerivationKernel

variable {R A : Type*}
variable [CommRing R]
variable [NonAssocRing A]
variable [Module R A]

/-- A Leibniz derivation on a two-sided unital nonassociative algebra kills the
unit.  This is the elementary algebraic source of the scalar integration
constants. -/
theorem map_one_eq_zero_of_isLeibniz
    (D : Module.End R A)
    (hD : NonAssocDerivation.IsLeibniz R A D) :
    D 1 = 0 := by
  have h : D (1 : A) = D 1 + D 1 := by
    simpa using hD (1 : A) (1 : A)
  abel

/-- The unit belongs to the kernel of every Leibniz derivation. -/
theorem one_mem_ker_of_isLeibniz
    (D : Module.End R A)
    (hD : NonAssocDerivation.IsLeibniz R A D) :
    (1 : A) ∈ LinearMap.ker D := by
  rw [LinearMap.mem_ker]
  exact map_one_eq_zero_of_isLeibniz D hD

/-- Every scalar multiple of the unit belongs to the kernel. -/
theorem scalar_one_mem_ker_of_isLeibniz
    (D : Module.End R A)
    (hD : NonAssocDerivation.IsLeibniz R A D)
    (c : R) :
    c • (1 : A) ∈ LinearMap.ker D := by
  rw [LinearMap.mem_ker]
  simp [map_one_eq_zero_of_isLeibniz D hD]

/-- The full scalar line `R · 1` is a submodule of the derivation kernel. -/
theorem scalar_line_le_ker_of_isLeibniz
    (D : Module.End R A)
    (hD : NonAssocDerivation.IsLeibniz R A D) :
    Submodule.span R ({(1 : A)} : Set A) ≤ LinearMap.ker D := by
  rw [Submodule.span_le]
  intro x hx
  simpa only [Set.mem_singleton_iff] using
    (show (1 : A) ∈ LinearMap.ker D from one_mem_ker_of_isLeibniz D hD)

/-- Equality after applying a linear map is exactly equality modulo its kernel.
This statement does not require a multiplication law. -/
theorem apply_eq_iff_sub_mem_ker
    (D : Module.End R A) (u₁ u₂ : A) :
    D u₁ = D u₂ ↔ u₁ - u₂ ∈ LinearMap.ker D := by
  rw [LinearMap.mem_ker, map_sub, sub_eq_zero]

/-- The kernel translation law in the orientation used for reconstruction:
adding a kernel element does not change the derived value. -/
theorem apply_add_eq_of_mem_ker
    (D : Module.End R A) {u k : A}
    (hk : k ∈ LinearMap.ker D) :
    D (u + k) = D u := by
  rw [map_add, LinearMap.mem_ker.mp hk, add_zero]

/-- Conversely, every equality of derived values determines a kernel
translation. -/
theorem sub_mem_ker_of_apply_eq
    (D : Module.End R A) {u₁ u₂ : A}
    (h : D u₁ = D u₂) :
    u₁ - u₂ ∈ LinearMap.ker D :=
  (apply_eq_iff_sub_mem_ker D u₁ u₂).mp h

/-! ## Native derivation-subtype corollaries -/

/-- Native `NonAssocDerivation.derivations` version of `D(1)=0`. -/
theorem derivation_map_one_eq_zero
    (D : NonAssocDerivation.derivations R A) :
    D 1 = 0 :=
  map_one_eq_zero_of_isLeibniz (D : Module.End R A) D.property

/-- Native derivation version of `R · 1 ⊆ ker D`. -/
theorem derivation_scalar_line_le_ker
    (D : NonAssocDerivation.derivations R A) :
    Submodule.span R ({(1 : A)} : Set A) ≤
      LinearMap.ker (D : Module.End R A) :=
  scalar_line_le_ker_of_isLeibniz (D : Module.End R A) D.property

/-- Native derivation version of reconstruction modulo the full kernel. -/
theorem derivation_apply_eq_iff_sub_mem_ker
    (D : NonAssocDerivation.derivations R A) (u₁ u₂ : A) :
    D u₁ = D u₂ ↔
      u₁ - u₂ ∈ LinearMap.ker (D : Module.End R A) :=
  apply_eq_iff_sub_mem_ker (D : Module.End R A) u₁ u₂

end InfoGeometry.Algebra.NonAssocDerivationKernel
