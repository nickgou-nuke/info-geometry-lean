import InfoGeometry.Synthesis.Cl22RealDiracCarrier
import InfoGeometry.Canonical.FiniteMatrixGibbsFunctional

set_option autoImplicit false

noncomputable section

open scoped Matrix ComplexOrder
open Matrix
open InfoGeometry.Synthesis.Cl22RealDiracCarrier
open InfoGeometry.Canonical.FiniteMatrixGibbsFunctional

namespace InfoGeometry.Synthesis.Cl22VolumeGibbsStationarityWave22

abbrev M4C := Matrix (Fin 4) (Fin 4) ℂ

/-- Coefficient extension from the real `Cl(2,2)` carrier to the finite
complex matrix carrier used by the native Gibbs functional. -/
noncomputable def castM4 (A : Matrix (Fin 4) (Fin 4) ℝ) : M4C :=
  RingHom.mapMatrix (algebraMap ℝ ℂ) A

private theorem volumeOmega_hermitian :
    (castM4 volumeOmega).IsHermitian := by
  rw [volumeOmega_explicit]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [castM4, RingHom.mapMatrix]

/-- The finite Gibbs functional generated by the doubled Clifford volume
operator is stationary under left/right multiplication by that operator.
This is the concrete finite-dimensional KMS stationarity equation for the
`Cl(2,2)` volume Hamiltonian, obtained from the native matrix Gibbs owner. -/
theorem cl22_volume_gibbs_left_eq_right
    (β : ℝ) (X : M4C) :
    gibbsFunctional (castM4 volumeOmega) volumeOmega_hermitian β
        (castM4 volumeOmega * X) =
      gibbsFunctional (castM4 volumeOmega) volumeOmega_hermitian β
        (X * castM4 volumeOmega) := by
  have h := gibbsFunctional_commutator_zero
    (castM4 volumeOmega) volumeOmega_hermitian β X
  rw [map_sub] at h
  exact sub_eq_zero.mp h

end InfoGeometry.Synthesis.Cl22VolumeGibbsStationarityWave22
