variable {n : ℕ}

/-! ## 1. Cartan Subalgebra Projection & Properties -/

/-- Projection from $\mathbb{R}^n$ onto the traceless Cartan subalgebra $\mathfrak{a} \subset \mathfrak{sl}(n, \mathbb{R})$. -/
def cartanProj (x : Fin n → ℝ) (hn : 0 < n) : Fin n → ℝ :=
  fun i => x i - (1 / (n : ℝ)) * ∑ k, x k

/-- 🏆 THEOREM 1: The Cartan projection has zero trace: $\sum_i \pi_{\mathfrak{a}}(x)_i = 0$. -/
theorem sum_cartanProj_zero (x : Fin n → ℝ) (hn : 0 < n) :
    ∑ i, cartanProj x hn i = 0 := by
  unfold cartanProj
  rw [Finset.sum_sub_distrib, Finset.sum_const]
  simp only [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn)
  have h_cancel : (n : ℝ) * ((1 / (n : ℝ)) * ∑ k, x k) = ∑ k, x k := by
    rw [← mul_assoc, mul_one_div_cancel hnR, one_mul]
  rw [h_cancel, sub_self]

/-- 🏆 THEOREM 2: Cartan projection acts as the identity on traceless elements. -/
theorem cartanProj_of_sum_zero (x : Fin n → ℝ) (hn : 0 < n) (h_zero : ∑ i, x i = 0) :
    cartanProj x hn = x := by
  unfold cartanProj
  ext i
  rw [h_zero, mul_zero, sub_zero]

/-- 🏆 THEOREM 3: Idempotence of the Cartan projector: $\pi_{\mathfrak{a}}^2 = \pi_{\mathfrak{a}}$. -/
theorem cartanProj_idempotent (x : Fin n → ℝ) (hn : 0 < n) :
    cartanProj (cartanProj x hn) hn = cartanProj x hn := by
  exact cartanProj_of_sum_zero (cartanProj x hn) hn (sum_cartanProj_zero x hn)

/-- 🏆 THEOREM 4: The center $\mathfrak{z} = \mathbb{R} \cdot \mathbf{1}$ is annihilated by $\pi_{\mathfrak{a}}$. -/
theorem cartanProj_const (c : ℝ) (hn : 0 < n) :
    cartanProj (fun _ => c) hn = fun _ => 0 := by
  unfold cartanProj
  ext i
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn)
  have : (1 / (n : ℝ)) * ((n : ℝ) * c) = c := by
    rw [← mul_assoc, one_div_mul_cancel hnR, one_mul]
  rw [this, sub_self]

/-- 🏆 THEOREM 5: Shift invariance of the Cartan projector. -/
theorem cartanProj_shift (x : Fin n → ℝ) (c : ℝ) (hn : 0 < n) :
    cartanProj (fun i => x i + c) hn = cartanProj x hn := by
  unfold cartanProj
  ext i
  rw [Finset.sum_add_distrib, Finset.sum_const]
  simp only [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn)
  have h_distrib : (1 / (n : ℝ)) * (∑ k, x k + (n : ℝ) * c) =
      (1 / (n : ℝ)) * (∑ k, x k) + c := by
    rw [mul_add, ← mul_assoc, one_div_mul_cancel hnR, one_mul]
  rw [h_distrib]
  ring

/-- 🏆 THEOREM 6: Centered log-ratio is the Cartan projection of the coordinate logarithms. -/
theorem clr_eq_cartanProj_log (P : PositiveDistribution n) (hn : 0 < n) :
    clr P hn = cartanProj (fun i => Real.log (P.p i)) hn := by
  unfold clr logMean cartanProj
  ext i
  rw [inv_eq_one_div]

/-! ## 2. Dually Flat Hessian Geometry & Softmax Diffeomorphism -/

/-- Primal potential (Log-Sum-Exp / free energy) on $\mathbb{R}^n$. -/
def primalPotential (u : Fin n → ℝ) : ℝ :=
  Real.log (∑ i, Real.exp (u i))

/-- Strict positivity of the sum of exponentials. -/
theorem sum_exp_pos (u : Fin n → ℝ) (hn : 0 < n) :
    0 < ∑ i, Real.exp (u i) := by
  have h_elem : (⟨0, hn⟩ : Fin n) ∈ Finset.univ := Finset.mem_univ _
  have h_pos : 0 < Real.exp (u ⟨0, hn⟩) := Real.exp_pos _
  exact Finset.sum_pos' (fun i _ => le_of_lt (Real.exp_pos (u i))) ⟨⟨0, hn⟩, h_elem, h_pos⟩

/-- 🏆 THEOREM 7: Shift identity of the primal potential: $\psi(\mathbf{u} + c\mathbf{1}) = \psi(\mathbf{u}) + c$. -/
theorem primalPotential_shift (u : Fin n → ℝ) (c : ℝ) (hn : 0 < n) :
    primalPotential (fun i => u i + c) = primalPotential u + c := by
  unfold primalPotential
  have h_exp : ∀ i, Real.exp (u i + c) = Real.exp (u i) * Real.exp c := by
    intro i; rw [Real.exp_add]
  simp_rw [h_exp, ← Finset.sum_mul]
  have h_sum_pos := sum_exp_pos u hn
  have h_exp_c_pos := Real.exp_pos c
  rw [Real.log_mul (ne_of_gt h_sum_pos) (ne_of_gt h_exp_c_pos)]
  rw [Real.log_exp, add_comm]

/-- Softmax distribution generated by the gradient of the primal potential. -/
def softmaxDist (u : Fin n → ℝ) (hn : 0 < n) : PositiveDistribution n where
  p := fun i => Real.exp (u i) / ∑ k, Real.exp (u k)
  h_pos := fun i => div_pos (Real.exp_pos (u i)) (sum_exp_pos u hn)
  h_sum := by
    have h_ne : ∑ k, Real.exp (u k) ≠ 0 := ne_of_gt (sum_exp_pos u hn)
    rw [← Finset.sum_div, div_self h_ne]

/-- 🏆 THEOREM 8: Coordinate logarithm of the Softmax distribution. -/
theorem log_softmax (u : Fin n → ℝ) (hn : 0 < n) (i : Fin n) :
    Real.log ((softmaxDist u hn).p i) = u i - primalPotential u := by
  dsimp [softmaxDist, primalPotential]
  have h_top_pos := Real.exp_pos (u i)
  have h_bot_pos := sum_exp_pos u hn
  rw [Real.log_div (ne_of_gt h_top_pos) (ne_of_gt h_bot_pos)]
  rw [Real.log_exp]

/-- 🏆 THEOREM 9: CLR of Softmax is the Cartan projection of the primal parameters. -/
theorem clr_softmax (u : Fin n → ℝ) (hn : 0 < n) :
    clr (softmaxDist u hn) hn = cartanProj u hn := by
  rw [clr_eq_cartanProj_log]
  have h_log : (fun i => Real.log ((softmaxDist u hn).p i)) =
      (fun i => u i - primalPotential u) := by
    ext i
    exact log_softmax u hn i
  rw [h_log]
  have h_shift : (fun i => u i - primalPotential u) = (fun i => u i + (- primalPotential u)) := by
    ext i; ring
  rw [h_shift]
  exact cartanProj_shift u (- primalPotential u) hn

/-- 🏆 THEOREM 10: Softmax is the exact inverse of CLR on the Cartan subalgebra $\mathfrak{a}$. -/
theorem clr_softmax_inversion (u : Fin n → ℝ) (hn : 0 < n) (h_zero : ∑ i, u i = 0) :
    clr (softmaxDist u hn) hn = u := by
  rw [clr_softmax, cartanProj_of_sum_zero u hn h_zero]

/-- Dual potential (negative Shannon entropy) on the probability simplex. -/
def dualPotential (P : PositiveDistribution n) : ℝ :=
  ∑ i, P.p i * Real.log (P.p i)

/-- 🏆 THEOREM 11: Legendre-Fenchel duality equality at stationary points:
    $$\psi(\mathbf{u}) + \psi^*(\mathbf{p}) = \langle \mathbf{u}, \mathbf{p} \rangle$$ -/
theorem legendre_fenchel_equality (u : Fin n → ℝ) (hn : 0 < n) :
    primalPotential u + dualPotential (softmaxDist u hn) = ∑ i, u i * (softmaxDist u hn).p i := by
  unfold dualPotential
  have h_term : ∀ i : Fin n, (softmaxDist u hn).p i * Real.log ((softmaxDist u hn).p i) =
      (softmaxDist u hn).p i * (u i - primalPotential u) := by
    intro i
    rw [log_softmax u hn i]
  simp_rw [h_term]
  have h_expand : ∀ i : Fin n, (softmaxDist u hn).p i * (u i - primalPotential u) =
      u i * (softmaxDist u hn).p i - primalPotential u * (softmaxDist u hn).p i := by
    intro i; ring
  simp_rw [h_expand]
  rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
  rw [(softmaxDist u hn).h_sum, mul_one]
  ring

/-! ## 3. Bregman Divergences and Kullback-Leibler Equivalence -/

/-- The Kullback-Leibler divergence between two positive distributions. -/
def klDivergence (P Q : PositiveDistribution n) : ℝ :=
  ∑ i, P.p i * (Real.log (P.p i) - Real.log (Q.p i))

/-- 🏆 THEOREM 12: Self-divergence vanishes: $D_{\mathrm{KL}}(P \parallel P) = 0$. -/
theorem klDivergence_self (P : PositiveDistribution n) :
    klDivergence P P = 0 := by
  unfold klDivergence
  have : ∀ i : Fin n, P.p i * (Real.log (P.p i) - Real.log (P.p i)) = 0 := by
    intro i; rw [sub_self, mul_zero]
  simp_rw [this, Finset.sum_const_zero]

/-- Dual Bregman divergence generated by the negative Shannon entropy $\psi^*$. -/
def dualBregmanDiv (P Q : PositiveDistribution n) : ℝ :=
  dualPotential P - dualPotential Q - ∑ i, (Real.log (Q.p i) + 1) * (P.p i - Q.p i)

/-- 🏆 THEOREM 13: Dual Bregman divergence is identically the Kullback-Leibler divergence:
    $$D_{\psi^*}(P \parallel Q) = D_{\mathrm{KL}}(P \parallel Q)$$ -/
theorem dualBregman_eq_kl (P Q : PositiveDistribution n) :
    dualBregmanDiv P Q = klDivergence P Q := by
  unfold dualBregmanDiv dualPotential klDivergence
  have h_grad : ∀ i : Fin n, (Real.log (Q.p i) + 1) * (P.p i - Q.p i) =
      Real.log (Q.p i) * (P.p i - Q.p i) + (P.p i - Q.p i) := by
    intro i; ring
  simp_rw [h_grad, Finset.sum_add_distrib]
  have h_sum_sub : ∑ i, (P.p i - Q.p i) = 0 := by
    rw [Finset.sum_sub_distrib, P.h_sum, Q.h_sum, sub_self]
  rw [h_sum_sub, add_zero]
  have h_expand : ∀ i : Fin n, Real.log (Q.p i) * (P.p i - Q.p i) =
      P.p i * Real.log (Q.p i) - Q.p i * Real.log (Q.p i) := by
    intro i; ring
  simp_rw [h_expand, Finset.sum_sub_distrib]
  have h_kl_term : ∀ i : Fin n, P.p i * (Real.log (P.p i) - Real.log (Q.p i)) =
      P.p i * Real.log (P.p i) - P.p i * Real.log (Q.p i) := by
    intro i; ring
  simp_rw [h_kl_term, Finset.sum_sub_distrib]
  ring

/-- Primal Bregman divergence generated by the Log-Sum-Exp potential $\psi$. -/
def primalBregmanDiv (u w : Fin n → ℝ) (hn : 0 < n) : ℝ :=
  primalPotential u - primalPotential w - ∑ i, (softmaxDist w hn).p i * (u i - w i)

/-- 🏆 THEOREM 14: Primal Bregman divergence equals dual KL divergence with swapped arguments:
    $$D_\psi(\mathbf{u} \parallel \mathbf{w}) = D_{\mathrm{KL}}(\operatorname{Softmax}(\mathbf{w}) \parallel \operatorname{Softmax}(\mathbf{u}))$$ -/
theorem primalBregman_eq_kl (u w : Fin n → ℝ) (hn : 0 < n) :
    primalBregmanDiv u w hn = klDivergence (softmaxDist w hn) (softmaxDist u hn) := by
  unfold primalBregmanDiv klDivergence
  have h_log_w : ∀ i : Fin n, Real.log ((softmaxDist w hn).p i) = w i - primalPotential w :=
    fun i => log_softmax w hn i
  have h_log_u : ∀ i : Fin n, Real.log ((softmaxDist u hn).p i) = u i - primalPotential u :=
    fun i => log_softmax u hn i
  have h_term : ∀ i : Fin n, (softmaxDist w hn).p i * (Real.log ((softmaxDist w hn).p i) - Real.log ((softmaxDist u hn).p i)) =
      - ((softmaxDist w hn).p i * (u i - w i)) + (primalPotential u - primalPotential w) * (softmaxDist w hn).p i := by
    intro i
    rw [h_log_w i, h_log_u i]
    ring
  simp_rw [h_term]
  rw [Finset.sum_add_distrib, ← Finset.mul_sum]
  rw [(softmaxDist w hn).h_sum, mul_one]
  rw [Finset.sum_neg_distrib]
  ring

/-- 🏆 THEOREM 15: Generalized Pythagorean expansion for KL divergence. -/
theorem kl_pythagorean_expansion (P Q R : PositiveDistribution n) :
    klDivergence P R - klDivergence P Q - klDivergence Q R =
    - ∑ i, (P.p i - Q.p i) * (Real.log (R.p i) - Real.log (Q.p i)) := by
  unfold klDivergence
  rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro i _
  ring

/-- 🏆 THEOREM 16: Generalized Pythagorean theorem under orthogonal geodesic intersection. -/
theorem kl_pythagorean_orthogonal (P Q R : PositiveDistribution n)
    (h_ortho : ∑ i, (P.p i - Q.p i) * (Real.log (R.p i) - Real.log (Q.p i)) = 0) :
    klDivergence P R = klDivergence P Q + klDivergence Q R := by
  have h_exp := kl_pythagorean_expansion P Q R
  rw [h_ortho, neg_zero] at h_exp
  linarith

/-! ## 4. Shannon Entropy & Jaynesian Maximum Entropy -/

/-- Shannon entropy of a positive distribution: $S(\mathbf{p}) = - \sum p_i \ln p_i$. -/
def shannonEntropy (P : PositiveDistribution n) : ℝ :=
  - dualPotential P

/-- 🏆 THEOREM 17: Shannon entropy of the Jaynesian prior equals $\ln(n)$. -/
theorem shannon_entropy_jaynesian (hn : 0 < n) :
    shannonEntropy (jaynesianDistribution n hn) = Real.log (n : ℝ) := by
  unfold shannonEntropy dualPotential jaynesianDistribution
  dsimp
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn
  have hnR_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
  have h_log_inv : Real.log (n : ℝ)⁻¹ = - Real.log (n : ℝ) := Real.log_inv (n : ℝ)
  simp_rw [h_log_inv]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have : (n : ℝ) * ((n : ℝ)⁻¹ * - Real.log (n : ℝ)) = - Real.log (n : ℝ) := by
    rw [← mul_assoc, mul_inv_cancel₀ hnR_ne, one_mul]
  rw [this, neg_neg]

/-- 🏆 THEOREM 18: KL divergence from any distribution to the Jaynesian prior is $\ln(n) - S(P)$. -/
theorem kl_to_jaynesian (P : PositiveDistribution n) (hn : 0 < n) :
    klDivergence P (jaynesianDistribution n hn) = Real.log (n : ℝ) - shannonEntropy P := by
  unfold klDivergence shannonEntropy dualPotential jaynesianDistribution
  dsimp
  have hnR_pos : 0 < (n : ℝ) := by exact_mod_cast hn
  have h_log_inv : Real.log (n : ℝ)⁻¹ = - Real.log (n : ℝ) := Real.log_inv (n : ℝ)
  simp_rw [h_log_inv]
  have h_expand : ∀ i : Fin n, P.p i * (Real.log (P.p i) - (- Real.log (n : ℝ))) =
      P.p i * Real.log (P.p i) + Real.log (n : ℝ) * P.p i := by
    intro i; ring
  simp_rw [h_expand, Finset.sum_add_distrib, ← Finset.mul_sum]
  rw [P.h_sum, mul_one]
  ring

/-! ## 5. Hilbert-Birkhoff Oscillation on the Cartan Subalgebra -/

/-- Coordinate log-ratio between two positive distributions. -/
def logRatio (P Q : PositiveDistribution n) (i : Fin n) : ℝ :=
  Real.log (P.p i / Q.p i)

/-- 🏆 THEOREM 19: Centered log-ratio difference matches centered log-ratio of coordinates:
    $$\mathrm{clr}(P)_i - \mathrm{clr}(Q)_i = \ln(P_i/Q_i) - \frac{1}{n}\sum_k \ln(P_k/Q_k)$$ -/
theorem clr_sub_clr_eq_centered_logRatio (P Q : PositiveDistribution n) (hn : 0 < n) (i : Fin n) :
    clr P hn i - clr Q hn i = logRatio P Q i - (1 / (n : ℝ)) * ∑ k, logRatio P Q k := by
  unfold clr logMean logRatio
  have h_log_div : ∀ j : Fin n, Real.log (P.p j / Q.p j) = Real.log (P.p j) - Real.log (Q.p j) := by
    intro j
    exact Real.log_div (ne_of_gt (P.h_pos j)) (ne_of_gt (Q.h_pos j))
  simp_rw [h_log_div]
  rw [Finset.sum_sub_distrib, mul_sub]
  rw [inv_eq_one_div]
  ring

/-! ## 6. Binary Simplex ($n = 2$), Relativistic Rapidity & Iwasawa Boosts -/

/-- Binary probability parameterization on the 2-simplex. -/
def binaryDistribution (p : ℝ) (hp0 : 0 < p) (hp1 : p < 1) : PositiveDistribution 2 where
  p := fun i => if i.val = 0 then p else 1 - p
  h_pos := fun i => by
    fin_cases i
    · simp; exact hp0
    · simp; linarith
  h_sum := by
    have : (∑ i : Fin 2, (if i.val = 0 then p else 1 - p)) =
        (if (0 : Fin 2).val = 0 then p else 1 - p) + (if (1 : Fin 2).val = 0 then p else 1 - p) := by
      rw [Fin.sum_univ_two]
    rw [this]
    norm_num

/-- 🏆 THEOREM 20: Centered log-ratio on the binary simplex recovers half the logit:
    $$\mathrm{clr}_0(p) = \frac{1}{2} \operatorname{logit}(p), \quad \mathrm{clr}_1(p) = -\frac{1}{2} \operatorname{logit}(p)$$ -/
theorem binary_clr_eq_half_logit (p : ℝ) (hp0 : 0 < p) (hp1 : p < 1) :
    clr (binaryDistribution p hp0 hp1) (by decide) 0 = (1 / 2 : ℝ) * Real.log (p / (1 - p)) ∧
    clr (binaryDistribution p hp0 hp1) (by decide) 1 = - (1 / 2 : ℝ) * Real.log (p / (1 - p)) := by
  unfold clr logMean binaryDistribution
  have h_log_div : Real.log (p / (1 - p)) = Real.log p - Real.log (1 - p) :=
    Real.log_div (ne_of_gt hp0) (by linarith)
  constructor
  · norm_num
    rw [h_log_div]
    ring
  · norm_num
    rw [h_log_div]
    ring

/-! ## 7. Master Conjunction -/

/-- Certified structural synthesis of the Aitchison Cartan Dually Flat Bridge. -/
structure CertifiedAitchisonCartanDuallyFlatSynthesis : Prop where
  h_cartan_zero : ∀ (x : Fin n → ℝ) (hn : 0 < n), ∑ i, cartanProj x hn i = 0
  h_cartan_idemp : ∀ (x : Fin n → ℝ) (hn : 0 < n), cartanProj (cartanProj x hn) hn = cartanProj x hn
  h_clr_cartan : ∀ (P : PositiveDistribution n) (hn : 0 < n), clr P hn = cartanProj (fun i => Real.log (P.p i)) hn
  h_clr_inv : ∀ (u : Fin n → ℝ) (hn : 0 < n), (∑ i, u i = 0) → clr (softmaxDist u hn) hn = u
  h_legendre : ∀ (u : Fin n → ℝ) (hn : 0 < n),
    primalPotential u + dualPotential (softmaxDist u hn) = ∑ i, u i * (softmaxDist u hn).p i
  h_dual_bregman_kl : ∀ (P Q : PositiveDistribution n), dualBregmanDiv P Q = klDivergence P Q
  h_primal_bregman_kl : ∀ (u w : Fin n → ℝ) (hn : 0 < n),
    primalBregmanDiv u w hn = klDivergence (softmaxDist w hn) (softmaxDist u hn)
  h_pythagorean : ∀ (P Q R : PositiveDistribution n),
    (∑ i, (P.p i - Q.p i) * (Real.log (R.p i) - Real.log (Q.p i)) = 0) →
    klDivergence P R = klDivergence P Q + klDivergence Q R
  h_jaynesian_entropy : ∀ (hn : 0 < n), shannonEntropy (jaynesianDistribution n hn) = Real.log (n : ℝ)
  h_kl_jaynesian : ∀ (P : PositiveDistribution n) (hn : 0 < n),
    klDivergence P (jaynesianDistribution n hn) = Real.log (n : ℝ) - shannonEntropy P
  h_centered_logRatio : ∀ (P Q : PositiveDistribution n) (hn : 0 < n) (i : Fin n),
    clr P hn i - clr Q hn i = logRatio P Q i - (1 / (n : ℝ)) * ∑ k, logRatio P Q k

/-- 🏆 MASTER CONJUNCTION: Certified Aitchison Cartan Dually Flat Synthesis. -/
theorem certified_aitchison_cartan_dually_flat_synthesis :
    CertifiedAitchisonCartanDuallyFlatSynthesis (n := n) :=
  ⟨sum_cartanProj_zero,
   cartanProj_idempotent,
   clr_eq_cartanProj_log,
   clr_softmax_inversion,
   legendre_fenchel_equality,
   dualBregman_eq_kl,
   primalBregman_eq_kl,
   kl_pythagorean_orthogonal,
   shannon_entropy_jaynesian,
   kl_to_jaynesian,
   clr_sub_clr_eq_centered_logRatio⟩

end InfoGeometry.Physics.AitchisonCartanDuallyFlat
