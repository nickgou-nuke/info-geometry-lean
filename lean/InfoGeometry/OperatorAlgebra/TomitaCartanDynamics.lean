/-
InfoGeometry/OperatorAlgebra/TomitaCartanDynamics.lean

Cartan dynamics into Tomita-center collapse and Krein isotropic defects.

This module connects the kinematic mechanism isolated in
`TomitaCartanSplit.lean` to a dynamical Cartan-flow socket:

* noncompact Cartan directions are the antisymmetric Tomita branch;
* a model may supply a flow saying that such directions hit the
  algebra/commutant overlap or a Drazin/Tomita defect locus;
* factor-center exclusion collapses overlap to scalars;
* a representation bridge maps that collapse to an isotropic vector in the
  doubled Krein carrier.

The file deliberately keeps the analytic convergence/limit statement as a
witness field.  The algebraic theorem proved here is the composition of those
witnesses.
-/

import Mathlib.Tactic
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.OperatorAlgebra.TomitaCartanSplit

noncomputable section

namespace InfoGeometry.OperatorAlgebra.TomitaCartanSplit

universe uOp uGen uH uSplit uCarrier

/-! ## 1. Antisymmetric Cartan routing kills mirror-balanced data -/

namespace CartanTomitaGenerator

variable {Op : Type uOp} [Ring Op]
variable {T : TomitaCommutantDatum Op}

/--
A Tomita-doubled generator is mirror-balanced when its algebra and commutant
representatives coincide in the ambient represented algebra.
-/
def MirrorBalanced
    (X : CartanTomitaGenerator T) : Prop :=
  X.mirror = X.localGen

/--
A noncompact Cartan generator vanishes on the mirror-balanced diagonal.

This is the operator-level version of `x - x = 0` and is the algebraic source
of the null/Krein collapse for noncompact Tomita routing.
-/
theorem noncompact_globalGenerator_eq_zero_of_balanced
    (X : CartanTomitaGenerator T)
    (hsec : X.sector = CartanSector.noncompact)
    (hbal : X.MirrorBalanced) :
    X.globalGenerator = 0 := by
  dsimp [globalGenerator]
  rw [hsec]
  dsimp [mirrorCombination]
  rw [hbal]
  simp

/--
A compact Cartan generator doubles on the mirror-balanced diagonal.

Compact directions are symmetric; they do not produce the antisymmetric
cancellation responsible for the Krein null readout.
-/
theorem compact_globalGenerator_eq_add_self_of_balanced
    (X : CartanTomitaGenerator T)
    (hsec : X.sector = CartanSector.compact)
    (hbal : X.MirrorBalanced) :
    X.globalGenerator = X.localGen + X.localGen := by
  dsimp [globalGenerator]
  rw [hsec]
  dsimp [mirrorCombination]
  rw [hbal]

/--
Equivalent version using the Tomita mirror field directly.
-/
theorem noncompact_globalGenerator_eq_zero_of_tomita_fixed
    (X : CartanTomitaGenerator T)
    (hsec : X.sector = CartanSector.noncompact)
    (hfixed : T.tomitaMirror X.localGen = X.localGen) :
    X.globalGenerator = 0 := by
  apply X.noncompact_globalGenerator_eq_zero_of_balanced hsec
  dsimp [MirrorBalanced]
  rw [X.mirror_eq, hfixed]

end CartanTomitaGenerator

/-! ## 2. Cartan flow socket hitting the algebra/commutant overlap -/

/--
A Cartan dynamics witness saying that noncompact directions reach the
algebra/commutant overlap at a supplied hitting time.

This is intentionally a witness socket.  Analytic statements such as convergence
of a noncompact one-parameter group to a projective boundary should be proved in
concrete models and then supplied through `noncompact_hits_overlap`.
-/
structure CartanDynamicsToOverlap
    (Gen : Type uGen)
    (Op : Type uOp) [Ring Op] [SMul ℝ Op]
    (F : FactorCenterExclusion Op) where
  /-- Cartan/modular flow generated by a symmetry direction. -/
  flow : Gen → ℝ → Op → Op

  /-- Compact/noncompact parity of the generator. -/
  parity : Gen → CartanParity

  /-- Time at which the model declares the overlap/defect boundary is reached. -/
  hittingTime : Gen → Op → ℝ

  /-- Noncompact Cartan directions reach the algebra/commutant overlap. -/
  noncompact_hits_overlap :
    ∀ (X : Gen) (x : Op),
      parity X = CartanParity.noncompact →
        flow X (hittingTime X x) x ∈ F.algebra ∧
        flow X (hittingTime X x) x ∈ F.commutant

namespace CartanDynamicsToOverlap

variable
    {Gen : Type uGen}
    {Op : Type uOp} [Ring Op] [SMul ℝ Op]
    {F : FactorCenterExclusion Op}

variable (D : CartanDynamicsToOverlap Gen Op F)

/-- The boundary/overlap representative reached by the Cartan flow. -/
def hit
    (X : Gen) (x : Op) : Op :=
  D.flow X (D.hittingTime X x) x

/-- A noncompact Cartan hit belongs to the algebra side. -/
theorem noncompact_hit_mem_algebra
    {X : Gen} {x : Op}
    (hX : D.parity X = CartanParity.noncompact) :
    D.hit X x ∈ F.algebra := by
  exact (D.noncompact_hits_overlap X x hX).1

/-- A noncompact Cartan hit belongs to the commutant side. -/
theorem noncompact_hit_mem_commutant
    {X : Gen} {x : Op}
    (hX : D.parity X = CartanParity.noncompact) :
    D.hit X x ∈ F.commutant := by
  exact (D.noncompact_hits_overlap X x hX).2

/--
A noncompact Cartan hit has zero dynamic part by factor-center exclusion.
-/
theorem noncompact_hit_dynamicPart_zero
    {X : Gen} {x : Op}
    (hX : D.parity X = CartanParity.noncompact) :
    F.dynamicPart (D.hit X x) = 0 := by
  exact
    FactorCenterExclusion.overlap_dynamicPart_zero F
      (D.noncompact_hit_mem_algebra hX)
      (D.noncompact_hit_mem_commutant hX)

/--
A noncompact Cartan hit maps to an isotropic vector under any supplied
center-collapse-to-Krein bridge.
-/
theorem noncompact_hit_isotropic
    {H : Type uH}
    [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (B : CenterCollapseMapsToIsotropic Op H F)
    {X : Gen} {x : Op}
    (hX : D.parity X = CartanParity.noncompact) :
    doubledKreinForm (B.carrierReadout (D.hit X x))
      (B.carrierReadout (D.hit X x)) = 0 := by
  apply B.dynamic_zero_is_isotropic
  exact D.noncompact_hit_dynamicPart_zero hX

end CartanDynamicsToOverlap

/-! ## 3. Cartan flow socket hitting a Tomita/Drazin defect locus -/

/--
A Cartan dynamics witness saying that noncompact directions hit an already
specified Tomita defect locus in a split source.

This is the defect-locus version of `CartanDynamicsToOverlap`.
-/
structure CartanDynamicsToDefect
    (Gen : Type uGen)
    (Op : Type uOp) [Ring Op]
    (Split : Type uSplit)
    (Carrier : Type uCarrier)
    [AddCommGroup Carrier] [Module ℝ Carrier]
    {T : TomitaCommutantDatum Op}
    (B : TomitaDefectNullBridge Op Split Carrier T) where
  /-- Cartan/modular flow on the split source. -/
  flow : Gen → ℝ → Split → Split

  /-- Compact/noncompact parity of the generator. -/
  parity : Gen → CartanParity

  /-- Time at which the model declares the defect boundary is reached. -/
  hittingTime : Gen → Split → ℝ

  /-- Noncompact directions reach the supplied defect locus. -/
  noncompact_hits_defect :
    ∀ (X : Gen) (a : Split),
      parity X = CartanParity.noncompact →
        flow X (hittingTime X a) a ∈ B.defectLocus

namespace CartanDynamicsToDefect

variable
    {Gen : Type uGen}
    {Op : Type uOp} [Ring Op]
    {Split : Type uSplit}
    {Carrier : Type uCarrier}
    [AddCommGroup Carrier] [Module ℝ Carrier]
    {T : TomitaCommutantDatum Op}
    {B : TomitaDefectNullBridge Op Split Carrier T}

variable (D : CartanDynamicsToDefect Gen Op Split Carrier B)

/-- The defect representative reached by the Cartan flow. -/
def hit
    (X : Gen) (a : Split) : Split :=
  D.flow X (D.hittingTime X a) a

/-- A noncompact Cartan hit belongs to the supplied defect locus. -/
theorem noncompact_hit_mem_defect
    {X : Gen} {a : Split}
    (hX : D.parity X = CartanParity.noncompact) :
    D.hit X a ∈ B.defectLocus := by
  exact D.noncompact_hits_defect X a hX

/--
A noncompact Cartan hit lands in the algebra/commutant overlap through the
Tomita defect bridge.
-/
theorem noncompact_hit_overlap
    {X : Gen} {a : Split}
    (hX : D.parity X = CartanParity.noncompact) :
    T.InOverlap (B.representedOperator (D.hit X a)) := by
  exact B.defect_overlap (D.hit X a) (D.noncompact_hit_mem_defect hX)

/--
A noncompact Cartan hit is scalar through the factor-like Tomita overlap rule.
-/
theorem noncompact_hit_overlap_scalar
    {X : Gen} {a : Split}
    (hX : D.parity X = CartanParity.noncompact) :
    B.representedOperator (D.hit X a) ∈ T.scalar := by
  exact B.defect_overlap_scalar (D.noncompact_hit_mem_defect hX)

/--
A noncompact Cartan hit is null under the supplied carrier quadratic readout.
-/
theorem noncompact_hit_null
    {X : Gen} {a : Split}
    (hX : D.parity X = CartanParity.noncompact) :
    B.q (B.carrierReadout (D.hit X a)) = 0 := by
  exact B.defect_is_null (D.noncompact_hit_mem_defect hX)

end CartanDynamicsToDefect

/-! ## 4. Bundled Tomita-Cartan-Krein dynamics theorem -/

/--
Bundled datum connecting Cartan dynamics to the doubled Krein null mechanism.

This is the canonical witness package:

`noncompact Cartan flow → overlap → scalar collapse → isotropic carrier`.
-/
structure TomitaCartanKreinDynamics
    (Gen : Type uGen)
    (Op : Type uOp) [Ring Op] [SMul ℝ Op]
    (H : Type uH) [NormedAddCommGroup H] [InnerProductSpace ℝ H] where
  /-- Factor-center exclusion data for the represented algebra. -/
  factor : FactorCenterExclusion Op

  /-- Bridge from scalar/dynamic collapse to Krein isotropy. -/
  bridge : CenterCollapseMapsToIsotropic Op H factor

  /-- Cartan dynamics reaching the overlap in noncompact directions. -/
  dynamics : CartanDynamicsToOverlap Gen Op factor

namespace TomitaCartanKreinDynamics

variable
    {Gen : Type uGen}
    {Op : Type uOp} [Ring Op] [SMul ℝ Op]
    {H : Type uH} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

variable (W : TomitaCartanKreinDynamics Gen Op H)

/-- The Cartan-flow boundary representative. -/
def hit
    (X : Gen) (x : Op) : Op :=
  W.dynamics.hit X x

/--
Main theorem: noncompact Cartan dynamics generates an isotropic doubled-Krein
carrier readout.

All analytic/geometric content is in the supplied witnesses.  The theorem here
is the formal composition of those witnesses.
-/
theorem noncompact_generates_isotropic
    {X : Gen} {x : Op}
    (hX : W.dynamics.parity X = CartanParity.noncompact) :
    doubledKreinForm (W.bridge.carrierReadout (W.hit X x))
      (W.bridge.carrierReadout (W.hit X x)) = 0 := by
  exact W.dynamics.noncompact_hit_isotropic W.bridge hX

/--
Equivalent named form: the noncompact hit has zero dynamic part before applying
its carrier readout.
-/
theorem noncompact_hit_dynamicPart_zero
    {X : Gen} {x : Op}
    (hX : W.dynamics.parity X = CartanParity.noncompact) :
    W.factor.dynamicPart (W.hit X x) = 0 := by
  exact W.dynamics.noncompact_hit_dynamicPart_zero hX

end TomitaCartanKreinDynamics

end InfoGeometry.OperatorAlgebra.TomitaCartanSplit
