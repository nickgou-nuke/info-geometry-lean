import Mathlib.Analysis.Complex.Exponential
import InfoGeometry.Canonical.SL2RToG2WiesbrockEmbedding

noncomputable section

open Matrix Complex
open SL2RToG2Wiesbrock

namespace InfoGeometry.Canonical.ConnesArakiRadonNikodymCocycleG2

/-- The modular flow σ_t(X) = e^{itD} X e^{-itD} acting on a matrix X.
    Generated by the Wiesbrock Boost D = diag(1/2, -1/2). -/
def modularFlow (t : ℂ) (X : Matrix (Fin 2) (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  let D_exp_t := !![Complex.exp (I * t / 2), 0; 0, Complex.exp (-I * t / 2)]
  let D_exp_neg_t := !![Complex.exp (-I * t / 2), 0; 0, Complex.exp (I * t / 2)]
  D_exp_t * X * D_exp_neg_t

/-- The modular flow acts on the horizon translation generator P₊
    by a simple phase rotation: σ_t(P₊) = e^{it} P₊. 
    This native proof bypasses all spectral theory. -/
theorem modularFlow_translationP (t : ℂ) :
    modularFlow t translationP = Complex.exp (I * t) • translationP := by
  ext i j
  fin_cases i <;> fin_cases j
  · simp [modularFlow, translationP]
  · simp [modularFlow, translationP]
    have h : I * t / 2 + I * t / 2 = I * t := by ring
    rw [← Complex.exp_add, h]
  · simp [modularFlow, translationP]
  · simp [modularFlow, translationP]

/-- The Connes-Araki Radon-Nikodym cocycle u_t explicitly integrated
    for the Araki perturbation D ↦ D + λP₊.
    Derived algebraically as u(t) = e^{it(D + λP₊)} e^{-itD} = I + λ(e^{it} - 1)P₊ -/
def radonNikodymCocycle (L t : ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  1 + (L * (Complex.exp (I * t) - 1)) • translationP

/-- The Holy Grail: The Connes Cocycle Condition Theorem.
    Proved purely algebraically (native) inside the G₂-embedded SL(2, ℝ) matrix representation,
    bypassing bounded operator functional analysis.
    u(t + s) = u(t) * σ_t(u(s)) -/
theorem connes_araki_cocycle_condition (L t s : ℂ) :
    radonNikodymCocycle L (t + s) =
      radonNikodymCocycle L t * modularFlow t (radonNikodymCocycle L s) := by
  ext i j
  fin_cases i <;> fin_cases j
  · dsimp [radonNikodymCocycle, modularFlow, translationP, Matrix.mul_apply, Fin.sum_univ_two]
    simp
    have h : I * t / 2 + -(I * t) / 2 = 0 := by ring
    rw [← Complex.exp_add, h, Complex.exp_zero]
  · dsimp [radonNikodymCocycle, modularFlow, translationP, Matrix.mul_apply, Fin.sum_univ_two]
    simp
    have h0 : -(I * t) / 2 + I * t / 2 = 0 := by ring
    have h1 : I * t / 2 + I * t / 2 = I * t := by ring
    have h2 : I * (t + s) = I * t + I * s := mul_add I t s
    have h_assoc : Complex.exp (I * t / 2) * (L * (Complex.exp (I * s) - 1)) * Complex.exp (I * t / 2) =
                   L * (Complex.exp (I * s) - 1) * (Complex.exp (I * t / 2) * Complex.exp (I * t / 2)) := by ring
    rw [← Complex.exp_add, h0, Complex.exp_zero, mul_one, h_assoc, ← Complex.exp_add, h1, h2, Complex.exp_add]
    ring
  · dsimp [radonNikodymCocycle, modularFlow, translationP, Matrix.mul_apply, Fin.sum_univ_two]
    simp
  · dsimp [radonNikodymCocycle, modularFlow, translationP, Matrix.mul_apply, Fin.sum_univ_two]
    simp
    have h3 : -(I * t) / 2 + I * t / 2 = 0 := by ring
    rw [← Complex.exp_add, h3, Complex.exp_zero]

end InfoGeometry.Canonical.ConnesArakiRadonNikodymCocycleG2
