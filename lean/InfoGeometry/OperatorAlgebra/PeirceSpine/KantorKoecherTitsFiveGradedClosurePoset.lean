    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_neutral N_plus X) (G_minus1_R N_plus Y) =
      G_minus1_R N_plus (X * (1 - Gap N_plus) * Y) := by
  have hGapIdem := Gap_idem N_plus h_nil h_reg
  have hR : (1 - Gap N_plus) * (1 - Gap N_plus) = 1 - Gap N_plus := by
    dsimp [Gap] at hGapIdem ⊢
    rw [mul_sub, mul_one, sub_mul, one_mul, hGapIdem, sub_self, sub_zero]
  have hMSigma := star_N_plus_mul_Sigma N_plus h_nil h_reg
  have hMGap : star N_plus * Gap N_plus = star N_plus := by
    calc star N_plus * Gap N_plus
        = (star N_plus * Sigma N_plus) * Sigma N_plus := by
            dsimp [Gap]
            rw [← mul_assoc]
      _ = star N_plus * Sigma N_plus := congrArg (fun z : B => z * Sigma N_plus) hMSigma
      _ = star N_plus := hMSigma
  have hMR : star N_plus * (1 - Gap N_plus) = 0 := by
    rw [mul_sub, mul_one, hMGap, sub_self]
  have hBracket := kkt_peirce_bracket_composable (1 - Gap N_plus)
    (1 - Gap N_plus) (star N_plus) X Y hR hMR
  dsimp [G_0_neutral, G_minus1_R]
  calc (comm ((1 - Gap N_plus) * X * (1 - Gap N_plus))
      ((1 - Gap N_plus) * Y * star N_plus)) =
      (1 - Gap N_plus) * X * (1 - Gap N_plus) * Y * star N_plus := hBracket
    _ = (1 - Gap N_plus) * (X * (1 - Gap N_plus) * Y) * star N_plus := by
          noncomm_ring

/-- **Theorem `KKT₇` (Opposite Extremal Commutator Lands in Grade `0`, `[g_{+2}, g_{-2}] ⊆ g_0`)**:
`[G_{+2}(N_+, X), G_{-2}(N_+, Y)] = G_0^P(N_+, N_+ X P Y N_-) - G_0^Q(N_+, N_- Y Q X N_+)`. -/
theorem comm_G_plus2_G_minus2_in_G_0 (N_plus X Y : B)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_plus2 N_plus X) (G_minus2 N_plus Y) =
      G_0_P N_plus (N_plus * X * P N_plus * Y * star N_plus) -
      G_0_Q N_plus (star N_plus * Y * Q N_plus * X * N_plus) := by
  have hPN : P N_plus * N_plus = N_plus := h_reg
  have hMP : star N_plus * P N_plus = star N_plus := by
    dsimp [P]
    rw [← mul_assoc]
    exact star_N_plus_reg N_plus h_reg
  have hQM : Q N_plus * star N_plus = star N_plus := star_N_plus_reg N_plus h_reg
  have hNQ : N_plus * Q N_plus = N_plus := by
    dsimp [Q]
    rw [← mul_assoc]
    exact h_reg
  exact kkt_comm_extremal_into_G0_helper N_plus (star N_plus) (P N_plus) (Q N_plus) X Y
    rfl rfl hPN hMP hQM hNQ

/-- The opposite extremal Jordan-associator seed generators bracket back to
four times the parity anomaly. This is the seed-level normalization of the
grade-zero closure formula. -/
theorem comm_K_plus2_seed_K_minus2_seed (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (K_plus2 N_plus (star N_plus)) (K_minus2 N_plus N_plus) =
      (4 : ℕ) • Sigma N_plus := by
  rw [K_plus2_seed N_plus h_nil h_reg, K_minus2_seed N_plus h_nil h_reg]
  rw [show comm (2 • N_plus) (2 • star N_plus) =
      (2 • N_plus) * (2 • star N_plus) - (2 • star N_plus) * (2 • N_plus) by rfl]
  dsimp only [OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset.comm,
    OperatorAlgebra.PeirceSpine.NilpotentPairingAnomalyGapPoset.Sigma]
  simp only [two_nsmul]
  noncomm_ring

omit [StarRing B] in
/-- The extremal `+2` sandwich sector is abelian because each product contains
the square-zero generator in the middle. -/
theorem comm_G_plus2_G_plus2 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) :
    comm (G_plus2 N_plus X) (G_plus2 N_plus Y) = 0 := by
  dsimp [comm, G_plus2]
  rw [kkt_sandwich_mul_sandwich_zero N_plus X Y h_nil,
    kkt_sandwich_mul_sandwich_zero N_plus Y X h_nil,
    sub_self]

/-- The extremal `-2` sandwich sector is abelian by adjoint nilpotency. -/
theorem comm_G_minus2_G_minus2 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) :
    comm (G_minus2 N_plus X) (G_minus2 N_plus Y) = 0 := by
  dsimp [comm, G_minus2]
  rw [kkt_sandwich_mul_sandwich_zero (star N_plus) X Y
      (star_N_plus_sq N_plus h_nil),
    kkt_sandwich_mul_sandwich_zero (star N_plus) Y X
      (star_N_plus_sq N_plus h_nil),
    sub_self]

/-- Helper: `Sigma N_plus * P N_plus = P N_plus`. -/
theorem Sigma_mul_P_eq_P (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * P N_plus = P N_plus := by
  dsimp [P]
  rw [← mul_assoc, Sigma_mul_N_plus N_plus h_nil h_reg]

/-- Helper: `P N_plus * Sigma N_plus = P N_plus`. -/
theorem P_mul_Sigma_eq_P (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    P N_plus * Sigma N_plus = P N_plus := by
  dsimp [P]
  rw [mul_assoc, star_N_plus_mul_Sigma N_plus h_nil h_reg]

/-- The positive diagonal grade-zero block acts on the left `+1` carrier,
and the result remains in that same Peirce block. -/
theorem comm_G_0_P_G_plus1_L (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_P N_plus X) (G_plus1_L N_plus Y) =
      G_plus1_L N_plus (star N_plus * X * N_plus * Y) := by
  have hGapN : Gap N_plus * N_plus = N_plus :=
    Gap_mul_N_plus N_plus h_nil h_reg
  have hGapP : Gap N_plus * P N_plus = P N_plus := by
    dsimp [P]
    rw [← mul_assoc, hGapN]
  have hRP : (1 - Gap N_plus) * P N_plus = 0 := by
    rw [sub_mul, one_mul, hGapP, sub_self]
  have hPN : P N_plus * N_plus = N_plus := h_reg
  have hL : G_0_P N_plus X * G_plus1_L N_plus Y =
      G_plus1_L N_plus (star N_plus * X * N_plus * Y) := by
    dsimp [G_0_P, G_plus1_L]
    calc (P N_plus * X * P N_plus) * (N_plus * Y * (1 - Gap N_plus))
        = P N_plus * X * (P N_plus * N_plus) * Y * (1 - Gap N_plus) := by noncomm_ring
      _ = P N_plus * X * N_plus * Y * (1 - Gap N_plus) := by rw [hPN]
      _ = N_plus * (star N_plus * X * N_plus * Y) * (1 - Gap N_plus) := by
            dsimp [P]
            noncomm_ring
  have hR : G_plus1_L N_plus Y * G_0_P N_plus X = 0 := by
    dsimp [G_0_P, G_plus1_L]
    calc (N_plus * Y * (1 - Gap N_plus)) * (P N_plus * X * P N_plus)
        = (N_plus * Y) * ((1 - Gap N_plus) * P N_plus) * (X * P N_plus) := by noncomm_ring
      _ = 0 := by rw [hRP, mul_zero, zero_mul]
  dsimp [comm]
  rw [hL, hR, sub_zero]

/-- The negative diagonal grade-zero block annihilates the left `+1` carrier:
its two products vanish by the orthogonality of the `Q` and `P` supports. -/
theorem comm_G_0_Q_G_plus1_L (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_Q N_plus X) (G_plus1_L N_plus Y) = 0 := by
  have hQN : Q N_plus * N_plus = 0 := by
    dsimp [Q]
    rw [mul_assoc, h_nil, mul_zero]
  have hRQ : (1 - Gap N_plus) * Q N_plus = 0 := by
    have hGapStar := Gap_mul_star_N_plus N_plus h_nil h_reg
    dsimp [Q]
    calc (1 - Gap N_plus) * (star N_plus * N_plus)
        = ((1 - Gap N_plus) * star N_plus) * N_plus := by rw [mul_assoc]
      _ = (star N_plus - Gap N_plus * star N_plus) * N_plus := by rw [sub_mul, one_mul]
      _ = (star N_plus - star N_plus) * N_plus := by rw [hGapStar]
      _ = 0 := by rw [sub_self, zero_mul]
  have hForward : G_0_Q N_plus X * G_plus1_L N_plus Y = 0 := by
    dsimp [G_0_Q, G_plus1_L]
    calc (Q N_plus * X * Q N_plus) * (N_plus * Y * (1 - Gap N_plus))
        = (Q N_plus * X) * (Q N_plus * N_plus) * (Y * (1 - Gap N_plus)) := by
            noncomm_ring
      _ = 0 := by rw [hQN, mul_zero, zero_mul]
  have hBackward : G_plus1_L N_plus Y * G_0_Q N_plus X = 0 := by
    dsimp [G_0_Q, G_plus1_L]
    calc (N_plus * Y * (1 - Gap N_plus)) * (Q N_plus * X * Q N_plus)
        = (N_plus * Y) * ((1 - Gap N_plus) * Q N_plus) * (X * Q N_plus) := by
            noncomm_ring
      _ = 0 := by rw [hRQ, mul_zero, zero_mul]
  dsimp [comm]
  rw [hForward, hBackward, sub_self]

/-- The positive diagonal block annihilates the right `+1` carrier, whose
source and target supports are orthogonal to the positive sheet endpoints. -/
theorem comm_G_0_P_G_plus1_R (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_P N_plus X) (G_plus1_R N_plus Y) = 0 := by
  have hGapP : P N_plus * Gap N_plus = P N_plus := by
    have hPS := P_mul_Sigma_eq_P N_plus h_nil h_reg
    calc P N_plus * Gap N_plus
        = (P N_plus * Sigma N_plus) * Sigma N_plus := by
            dsimp [Gap]
            rw [← mul_assoc]
      _ = P N_plus * Sigma N_plus := congrArg (fun z : B => z * Sigma N_plus) hPS
      _ = P N_plus := hPS
  have hPR : P N_plus * (1 - Gap N_plus) = 0 := by
    rw [mul_sub, mul_one, hGapP, sub_self]
  have hNP : N_plus * P N_plus = 0 := by
    dsimp [P]
    rw [← mul_assoc, h_nil, zero_mul]
  have hForward : G_0_P N_plus X * G_plus1_R N_plus Y = 0 := by
    dsimp [G_0_P, G_plus1_R]
    calc (P N_plus * X * P N_plus) * ((1 - Gap N_plus) * Y * N_plus)
        = (P N_plus * X) * (P N_plus * (1 - Gap N_plus)) * (Y * N_plus) := by
            noncomm_ring
      _ = 0 := by rw [hPR, mul_zero, zero_mul]
  have hBackward : G_plus1_R N_plus Y * G_0_P N_plus X = 0 := by
    dsimp [G_0_P, G_plus1_R]
    calc ((1 - Gap N_plus) * Y * N_plus) * (P N_plus * X * P N_plus)
        = ((1 - Gap N_plus) * Y) * (N_plus * P N_plus) * (X * P N_plus) := by
            noncomm_ring
      _ = 0 := by rw [hNP, mul_zero, zero_mul]
  dsimp [comm]
  rw [hForward, hBackward, sub_self]

/-- The positive diagonal block annihilates the left `-1` carrier by
positive/negative sheet orthogonality and neutral-support orthogonality. -/
theorem comm_G_0_P_G_minus1_L (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_P N_plus X) (G_minus1_L N_plus Y) = 0 := by
  have hGapN : Gap N_plus * N_plus = N_plus :=
    Gap_mul_N_plus N_plus h_nil h_reg
  have hGapP : Gap N_plus * P N_plus = P N_plus := by
    dsimp [P]
    rw [← mul_assoc, hGapN]
  have hRP : (1 - Gap N_plus) * P N_plus = 0 := by
    rw [sub_mul, one_mul, hGapP, sub_self]
  have hPM : P N_plus * star N_plus = 0 :=
    YangMillsVortexPoset.P_mul_star_N_plus N_plus h_nil
  have hForward : G_0_P N_plus X * G_minus1_L N_plus Y = 0 := by
    dsimp [G_0_P, G_minus1_L]
    calc (P N_plus * X * P N_plus) * (star N_plus * Y * (1 - Gap N_plus))
        = (P N_plus * X) * (P N_plus * star N_plus) *
            (Y * (1 - Gap N_plus)) := by noncomm_ring
      _ = 0 := by rw [hPM, mul_zero, zero_mul]
  have hBackward : G_minus1_L N_plus Y * G_0_P N_plus X = 0 := by
    dsimp [G_0_P, G_minus1_L]
    calc (star N_plus * Y * (1 - Gap N_plus)) * (P N_plus * X * P N_plus)
        = (star N_plus * Y) * ((1 - Gap N_plus) * P N_plus) *
            (X * P N_plus) := by noncomm_ring
      _ = 0 := by rw [hRP, mul_zero, zero_mul]
  dsimp [comm]
  rw [hForward, hBackward, sub_self]

/-- The positive diagonal block acts on the right `-1` carrier and preserves
that carrier; the sign comes from the reversed order of the nonzero product. -/
theorem comm_G_0_P_G_minus1_R (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_P N_plus X) (G_minus1_R N_plus Y) =
      -G_minus1_R N_plus (Y * star N_plus * X * N_plus) := by
  have hPS := P_mul_Sigma_eq_P N_plus h_nil h_reg
  have hGapP : P N_plus * Gap N_plus = P N_plus := by
    calc P N_plus * Gap N_plus
        = (P N_plus * Sigma N_plus) * Sigma N_plus := by
            dsimp [Gap]
            rw [← mul_assoc]
      _ = P N_plus * Sigma N_plus := congrArg (fun z : B => z * Sigma N_plus) hPS
      _ = P N_plus := hPS
  have hPR : P N_plus * (1 - Gap N_plus) = 0 := by
    rw [mul_sub, mul_one, hGapP, sub_self]
  have hStarP : star N_plus * P N_plus = star N_plus :=
    YangMillsVortexPoset.star_N_plus_mul_P N_plus h_reg
  have hForward : G_0_P N_plus X * G_minus1_R N_plus Y = 0 := by
    dsimp [G_0_P, G_minus1_R]
    calc (P N_plus * X * P N_plus) * ((1 - Gap N_plus) * Y * star N_plus)
        = (P N_plus * X) * (P N_plus * (1 - Gap N_plus)) *
            (Y * star N_plus) := by noncomm_ring
      _ = 0 := by rw [hPR, mul_zero, zero_mul]
  have hBackward : G_minus1_R N_plus Y * G_0_P N_plus X =
      G_minus1_R N_plus (Y * star N_plus * X * N_plus) := by
    dsimp [G_0_P, G_minus1_R]
    calc ((1 - Gap N_plus) * Y * star N_plus) * (P N_plus * X * P N_plus)
        = ((1 - Gap N_plus) * Y) * (star N_plus * P N_plus) * (X * P N_plus) := by
            noncomm_ring
      _ = ((1 - Gap N_plus) * Y) * star N_plus * (X * P N_plus) := by rw [hStarP]
      _ = (1 - Gap N_plus) * (Y * star N_plus * X * N_plus) * star N_plus := by
            dsimp [P]
            noncomm_ring
  dsimp [comm]
  rw [hForward, hBackward, zero_sub]

/-- Helper: `Sigma N_plus * Q N_plus = -Q N_plus`. -/
theorem Sigma_mul_Q_eq_neg_Q (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Sigma N_plus * Q N_plus = -Q N_plus := by
  dsimp [Q]
  rw [← mul_assoc, Sigma_mul_star_N_plus N_plus h_nil h_reg, neg_mul]

/-- Helper: `Q N_plus * Sigma N_plus = -Q N_plus`. -/
theorem Q_mul_Sigma_eq_neg_Q (N_plus : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    Q N_plus * Sigma N_plus = -Q N_plus := by
  dsimp [Q]
  rw [mul_assoc, N_plus_mul_Sigma N_plus h_nil h_reg, mul_neg]

/-- The negative diagonal block acts on the left `-1` carrier within that
carrier; the reverse product vanishes by orthogonality with the neutral support. -/
theorem comm_G_0_Q_G_minus1_L (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_Q N_plus X) (G_minus1_L N_plus Y) =
      G_minus1_L N_plus (N_plus * X * star N_plus * Y) := by
  have hGapStar := Gap_mul_star_N_plus N_plus h_nil h_reg
  have hRQ : (1 - Gap N_plus) * Q N_plus = 0 := by
    dsimp [Q]
    calc (1 - Gap N_plus) * (star N_plus * N_plus)
        = ((1 - Gap N_plus) * star N_plus) * N_plus := by rw [mul_assoc]
      _ = (star N_plus - Gap N_plus * star N_plus) * N_plus := by rw [sub_mul, one_mul]
      _ = (star N_plus - star N_plus) * N_plus := by rw [hGapStar]
      _ = 0 := by rw [sub_self, zero_mul]
  have hQStar : Q N_plus * star N_plus = star N_plus :=
    YangMillsVortexPoset.Q_mul_star_N_plus N_plus h_reg
  have hForward : G_0_Q N_plus X * G_minus1_L N_plus Y =
      G_minus1_L N_plus (N_plus * X * star N_plus * Y) := by
    dsimp [G_0_Q, G_minus1_L]
    calc (Q N_plus * X * Q N_plus) * (star N_plus * Y * (1 - Gap N_plus))
        = (Q N_plus * X) * (Q N_plus * star N_plus) * Y * (1 - Gap N_plus) := by
            noncomm_ring
      _ = (Q N_plus * X) * star N_plus * Y * (1 - Gap N_plus) := by rw [hQStar]
      _ = star N_plus * (N_plus * X * star N_plus * Y) * (1 - Gap N_plus) := by
            dsimp [Q]
            noncomm_ring
  have hBackward : G_minus1_L N_plus Y * G_0_Q N_plus X = 0 := by
    dsimp [G_0_Q, G_minus1_L]
    calc (star N_plus * Y * (1 - Gap N_plus)) * (Q N_plus * X * Q N_plus)
        = (star N_plus * Y) * ((1 - Gap N_plus) * Q N_plus) * (X * Q N_plus) := by
            noncomm_ring
      _ = 0 := by rw [hRQ, mul_zero, zero_mul]
  dsimp [comm]
  rw [hForward, hBackward, sub_zero]

/-- The negative diagonal block annihilates the right `-1` carrier because
both endpoint products meet orthogonal Peirce supports. -/
theorem comm_G_0_Q_G_minus1_R (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_Q N_plus X) (G_minus1_R N_plus Y) = 0 := by
  have hGapStar := Gap_mul_star_N_plus N_plus h_nil h_reg
  have hQGap : Q N_plus * Gap N_plus = Q N_plus := by
    calc Q N_plus * Gap N_plus
        = (Q N_plus * Sigma N_plus) * Sigma N_plus := by
            dsimp [Gap]
            rw [← mul_assoc]
      _ = (-Q N_plus) * Sigma N_plus := by
            rw [Q_mul_Sigma_eq_neg_Q N_plus h_nil h_reg]
      _ = -(Q N_plus * Sigma N_plus) := by rw [neg_mul]
      _ = -(-Q N_plus) := by rw [Q_mul_Sigma_eq_neg_Q N_plus h_nil h_reg]
      _ = Q N_plus := by rw [neg_neg]
  have hQR : Q N_plus * (1 - Gap N_plus) = 0 := by
    rw [mul_sub, mul_one, hQGap, sub_self]
  have hMQ : star N_plus * Q N_plus = 0 := by
    dsimp [Q]
    rw [← mul_assoc, YangMillsVortexPoset.star_N_plus_sq N_plus h_nil, zero_mul]
  have hForward : G_0_Q N_plus X * G_minus1_R N_plus Y = 0 := by
    dsimp [G_0_Q, G_minus1_R]
    calc (Q N_plus * X * Q N_plus) * ((1 - Gap N_plus) * Y * star N_plus)
        = (Q N_plus * X) * (Q N_plus * (1 - Gap N_plus)) *
            (Y * star N_plus) := by noncomm_ring
      _ = 0 := by rw [hQR, mul_zero, zero_mul]
  have hBackward : G_minus1_R N_plus Y * G_0_Q N_plus X = 0 := by
    dsimp [G_0_Q, G_minus1_R]
    calc ((1 - Gap N_plus) * Y * star N_plus) * (Q N_plus * X * Q N_plus)
        = ((1 - Gap N_plus) * Y) * (star N_plus * Q N_plus) *
            (X * Q N_plus) := by noncomm_ring
      _ = 0 := by rw [hMQ, mul_zero, zero_mul]
  dsimp [comm]
  rw [hForward, hBackward, sub_self]

/-- The negative diagonal grade-zero block acts on the right `+1` carrier
within that carrier, with the action given by Peirce block composition. -/
theorem comm_G_0_Q_G_plus1_R (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_Q N_plus X) (G_plus1_R N_plus Y) =
      -G_plus1_R N_plus (Y * N_plus * X * star N_plus) := by
  have hQS := Q_mul_Sigma_eq_neg_Q N_plus h_nil h_reg
  have hQGap : Q N_plus * Gap N_plus = Q N_plus := by
    calc Q N_plus * Gap N_plus
        = (Q N_plus * Sigma N_plus) * Sigma N_plus := by
            dsimp [Gap]
            rw [← mul_assoc]
      _ = (-Q N_plus) * Sigma N_plus := by rw [hQS]
      _ = -(Q N_plus * Sigma N_plus) := by rw [neg_mul]
      _ = -(-Q N_plus) := by rw [hQS]
      _ = Q N_plus := by rw [neg_neg]
  have hQR : Q N_plus * (1 - Gap N_plus) = 0 := by
    rw [mul_sub, mul_one, hQGap, sub_self]
  have hNQ : N_plus * Q N_plus = N_plus := by
    dsimp [Q]
    rw [← mul_assoc, h_reg]
  have hForward : G_0_Q N_plus X * G_plus1_R N_plus Y = 0 := by
    dsimp [G_0_Q, G_plus1_R]
    calc (Q N_plus * X * Q N_plus) * ((1 - Gap N_plus) * Y * N_plus)
        = (Q N_plus * X) * (Q N_plus * (1 - Gap N_plus)) * (Y * N_plus) := by
            noncomm_ring
      _ = 0 := by rw [hQR, mul_zero, zero_mul]
  have hBackward : G_plus1_R N_plus Y * G_0_Q N_plus X =
      G_plus1_R N_plus (Y * N_plus * X * star N_plus) := by
    dsimp [G_0_Q, G_plus1_R]
    calc ((1 - Gap N_plus) * Y * N_plus) * (Q N_plus * X * Q N_plus)
        = ((1 - Gap N_plus) * Y) * (N_plus * Q N_plus) * (X * Q N_plus) := by
            noncomm_ring
      _ = ((1 - Gap N_plus) * Y) * N_plus * (X * Q N_plus) := by rw [hNQ]
      _ = (1 - Gap N_plus) * (Y * N_plus * X * star N_plus) * N_plus := by
            dsimp [Q]
            noncomm_ring
  dsimp [comm]
  rw [hForward, hBackward, zero_sub]

/-- The full grade-zero Peirce sector acts on the full grade `+1` sector
without leaving grade `+1`. The formula records separately the two outgoing
corners; it is assembled from the three diagonal corner actions above. -/
theorem comm_G_plus1_G_0_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_plus1 N_plus X)
        (G_0_P N_plus Y + G_0_Q N_plus Y + G_0_neutral N_plus Y) =
      G_plus1_L N_plus
          (X * (1 - Gap N_plus) * Y - star N_plus * Y * N_plus * X) +
        G_plus1_R N_plus
          (X * N_plus * Y * star N_plus - Y * (1 - Gap N_plus) * X) := by
  have hPL : comm (G_plus1_L N_plus X) (G_0_P N_plus Y) =
      -G_plus1_L N_plus (star N_plus * Y * N_plus * X) := by
    rw [kkt_comm_antisymm,
      comm_G_0_P_G_plus1_L N_plus Y X h_nil h_reg]
  have hQL : comm (G_plus1_L N_plus X) (G_0_Q N_plus Y) = 0 := by
    rw [kkt_comm_antisymm,
      comm_G_0_Q_G_plus1_L N_plus Y X h_nil h_reg, neg_zero]
  have hNL : comm (G_plus1_L N_plus X) (G_0_neutral N_plus Y) =
      G_plus1_L N_plus (X * (1 - Gap N_plus) * Y) := by
    rw [kkt_comm_antisymm,
      comm_G_0_neutral_G_plus1_L N_plus Y X h_nil h_reg, neg_neg]
  have hPR : comm (G_plus1_R N_plus X) (G_0_P N_plus Y) = 0 := by
    rw [kkt_comm_antisymm,
      comm_G_0_P_G_plus1_R N_plus Y X h_nil h_reg, neg_zero]
  have hQR : comm (G_plus1_R N_plus X) (G_0_Q N_plus Y) =
      G_plus1_R N_plus (X * N_plus * Y * star N_plus) := by
    rw [kkt_comm_antisymm,
      comm_G_0_Q_G_plus1_R N_plus Y X h_nil h_reg, neg_neg]
  have hNR : comm (G_plus1_R N_plus X) (G_0_neutral N_plus Y) =
      -G_plus1_R N_plus (Y * (1 - Gap N_plus) * X) := by
    rw [kkt_comm_antisymm,
      comm_G_0_neutral_G_plus1_R N_plus Y X h_nil h_reg]
  change comm (G_plus1_L N_plus X + G_plus1_R N_plus X)
      ((G_0_P N_plus Y + G_0_Q N_plus Y) + G_0_neutral N_plus Y) = _
  simp only [kkt_comm_add_left, kkt_comm_add_right, hPL, hQL, hNL,
    hPR, hQR, hNR]
  dsimp [G_plus1_L, G_plus1_R]
  noncomm_ring

/-- The full grade-zero Peirce sector acts on the full grade `-1` sector
without leaving grade `-1`. The formula records the two outgoing corners,
assembled from the three diagonal corner actions. -/
theorem comm_G_0_G_minus1_closed (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (G_0_P N_plus Y + G_0_Q N_plus Y + G_0_neutral N_plus Y)
        (G_minus1 N_plus X) =
      G_minus1_L N_plus
          (N_plus * Y * star N_plus * X - X * (1 - Gap N_plus) * Y) +
        G_minus1_R N_plus
          (Y * (1 - Gap N_plus) * X - X * star N_plus * Y * N_plus) := by
  have hPL : comm (G_0_P N_plus Y) (G_minus1_L N_plus X) = 0 :=
    comm_G_0_P_G_minus1_L N_plus Y X h_nil h_reg
  have hPR : comm (G_0_P N_plus Y) (G_minus1_R N_plus X) =
      -G_minus1_R N_plus (X * star N_plus * Y * N_plus) :=
    comm_G_0_P_G_minus1_R N_plus Y X h_nil h_reg
  have hQL : comm (G_0_Q N_plus Y) (G_minus1_L N_plus X) =
      G_minus1_L N_plus (N_plus * Y * star N_plus * X) :=
    comm_G_0_Q_G_minus1_L N_plus Y X h_nil h_reg
  have hQR : comm (G_0_Q N_plus Y) (G_minus1_R N_plus X) = 0 :=
    comm_G_0_Q_G_minus1_R N_plus Y X h_nil h_reg
  have hNL : comm (G_0_neutral N_plus Y) (G_minus1_L N_plus X) =
      -G_minus1_L N_plus (X * (1 - Gap N_plus) * Y) :=
    comm_G_0_neutral_G_minus1_L N_plus Y X h_nil h_reg
  have hNR : comm (G_0_neutral N_plus Y) (G_minus1_R N_plus X) =
      G_minus1_R N_plus (Y * (1 - Gap N_plus) * X) :=
    comm_G_0_neutral_G_minus1_R N_plus Y X h_nil h_reg
  change comm ((G_0_P N_plus Y + G_0_Q N_plus Y) + G_0_neutral N_plus Y)
      (G_minus1_L N_plus X + G_minus1_R N_plus X) = _
  simp only [kkt_comm_add_left, kkt_comm_add_right, hPL, hPR, hQL,
    hQR, hNL, hNR]
  dsimp [G_minus1_L, G_minus1_R]
  noncomm_ring

/-- **Theorem `KKT₈` (Grade `0` Positive Sheet Centralizes `Σ`)**:
`[Σ, G_0^P(N_+, X)] = 0`. -/
theorem comm_Sigma_G_0_P (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_0_P N_plus X) = 0 :=
  kkt_comm_grade0_idempotent (Sigma N_plus) (P N_plus) X
    (Sigma_mul_P_eq_P N_plus h_nil h_reg)
    (P_mul_Sigma_eq_P N_plus h_nil h_reg)

/-- **Theorem `KKT₈'` (Grade `0` Negative Sheet Centralizes `Σ`)**:
`[Σ, G_0^Q(N_+, X)] = 0`. -/
theorem comm_Sigma_G_0_Q (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_0_Q N_plus X) = 0 :=
  kkt_comm_grade0_neg_idempotent (Sigma N_plus) (Q N_plus) X
    (Sigma_mul_Q_eq_neg_Q N_plus h_nil h_reg)
    (Q_mul_Sigma_eq_neg_Q N_plus h_nil h_reg)

/-- **Theorem `KKT₈''` (Grade `0` Neutral Peirce Complement Centralizes `Σ`)**:
`[Σ, G_0^0(N_+, X)] = 0`. -/
theorem comm_Sigma_G_0_neutral (N_plus X : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (G_0_neutral N_plus X) = 0 :=
  kkt_comm_grade0_zero_idempotent (Sigma N_plus) (1 - Gap N_plus) X
    (Sigma_mul_one_sub_Gap N_plus h_nil h_reg)
    (one_sub_Gap_mul_Sigma N_plus h_nil h_reg)

/-- Each grouped Peirce sector is an eigenspace of `ad(Σ)` with its indicated
integer grade. This is the grading statement for the five sectors above. -/
theorem comm_Sigma_peirce_five_grades (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (peirceGradePlus2 N_plus X) =
        (2 : ℕ) • peirceGradePlus2 N_plus X ∧
    comm (Sigma N_plus) (peirceGradePlus1 N_plus X) = peirceGradePlus1 N_plus X ∧
    comm (Sigma N_plus) (peirceGradeZero N_plus X) = 0 ∧
    comm (Sigma N_plus) (peirceGradeMinus1 N_plus X) = -peirceGradeMinus1 N_plus X ∧
    comm (Sigma N_plus) (peirceGradeMinus2 N_plus X) =
        -((2 : ℕ) • peirceGradeMinus2 N_plus X) := by
  have hPleft := Sigma_mul_P_eq_P N_plus h_nil h_reg
  have hPright := P_mul_Sigma_eq_P N_plus h_nil h_reg
  have hQleft := Sigma_mul_Q_eq_neg_Q N_plus h_nil h_reg
  have hQright := Q_mul_Sigma_eq_neg_Q N_plus h_nil h_reg
  have hRleft := Sigma_mul_one_sub_Gap N_plus h_nil h_reg
  have hRright := one_sub_Gap_mul_Sigma N_plus h_nil h_reg
  have hPQ := kkt_comm_block_plus2 (Sigma N_plus) (P N_plus) (Q N_plus) X
    hPleft hQright
  have hPR := kkt_comm_block_plus1_left (Sigma N_plus) (P N_plus)
    (peirceR N_plus) X hPleft hRright
  have hRQ := kkt_comm_block_plus1_right (Sigma N_plus) (peirceR N_plus)
    (Q N_plus) X hRleft hQright
  have hRP := kkt_comm_block_minus1_left (Sigma N_plus) (peirceR N_plus)
    (P N_plus) X hRleft hPright
  have hQR := kkt_comm_block_minus1_right (Sigma N_plus) (Q N_plus)
    (peirceR N_plus) X hQleft hRright
  have hQP := kkt_comm_block_minus2 (Sigma N_plus) (Q N_plus) (P N_plus) X
    hQleft hPright
  have hPR' : comm (Sigma N_plus) (peircePR N_plus X) = peircePR N_plus X := by
    simpa [peircePR, peirceR] using hPR
  have hRQ' : comm (Sigma N_plus) (peirceRQ N_plus X) = peirceRQ N_plus X := by
    simpa [peirceRQ, peirceR] using hRQ
  have hRP' : comm (Sigma N_plus) (peirceRP N_plus X) = -peirceRP N_plus X := by
    simpa [peirceRP, peirceR] using hRP
  have hQR' : comm (Sigma N_plus) (peirceQR N_plus X) = -peirceQR N_plus X := by
    simpa [peirceQR, peirceR] using hQR
  have hPP : comm (Sigma N_plus) (peircePP N_plus X) = 0 := by
    simpa [peircePP, G_0_P] using comm_Sigma_G_0_P N_plus X h_nil h_reg
  have hQQ : comm (Sigma N_plus) (peirceQQ N_plus X) = 0 := by
    simpa [peirceQQ, G_0_Q] using comm_Sigma_G_0_Q N_plus X h_nil h_reg
  have hRR : comm (Sigma N_plus) (peirceRR N_plus X) = 0 := by
    simpa [peirceRR, peirceR, G_0_neutral] using
      comm_Sigma_G_0_neutral N_plus X h_nil h_reg
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simpa [peirceGradePlus2, peircePQ] using hPQ
  · rw [peirceGradePlus1, kkt_comm_add_right, hPR', hRQ']
  · rw [peirceGradeZero, kkt_comm_add_right, kkt_comm_add_right, hPP, hQQ, hRR]
    simp
  · rw [peirceGradeMinus1, kkt_comm_add_right, hRP', hQR']
    abel
  · simpa [peirceGradeMinus2, peirceQP] using hQP

/-- Native additive subgroup of operators with a fixed integer eigenvalue under
the parity-anomaly adjoint action. -/
def KKTAdjointGrade (N_plus : B) (k : ℤ) : AddSubgroup B :=
  kktAdjointGrade (Sigma N_plus) k

/-- The integer adjoint eigenspaces, viewed as native `ℤ`-submodules. -/
def KKTAdjointGradeSubmodule (N_plus : B) (k : ℤ) : Submodule ℤ B :=
  (KKTAdjointGrade N_plus k).toIntSubmodule

/-- Integer degree attached to the five Peirce components indexed in order
`+2,+1,0,-1,-2`. -/
def peirceFiveGradeDegree (i : Fin 5) : ℤ :=
  match i.val with
  | 0 => 2
  | 1 => 1
  | 2 => 0
  | 3 => -1
  | _ => -2

/-- The KKT grade subgroups are closed under the Lie bracket with additive
degree: a bracket of grade `m` and grade `n` belongs to grade `m + n`.
This is the native graded-Lie closure interface for downstream constructions. -/
theorem kkt_grade_bracket_mem {N_plus X Y : B} {m n : ℤ}
    (hX : X ∈ KKTAdjointGrade N_plus m)
    (hY : Y ∈ KKTAdjointGrade N_plus n) :
    comm X Y ∈ KKTAdjointGrade N_plus (m + n) := by
  exact kktAdjointGrade_bracket hX hY

omit [StarRing B] in
/-- On an additive-torsion-free carrier, an element cannot have two distinct
integer eigenvalues under the same adjoint action. This is the separation
fact needed to turn the homogeneous-bracket family into a direct grading. -/
theorem kkt_adjoint_grades_intersection_eq_zero [IsAddTorsionFree B]
    {S X : B} {m n : ℤ}
    (hX_m : comm S X = m • X) (hX_n : comm S X = n • X)
    (hmn : m ≠ n) :
    X = 0 := by
  have hmul : (m - n) • X = 0 := by
    calc (m - n) • X
      _ = m • X - n • X := by simpa only [sub_eq_add_neg] using sub_zsmul X m n
      _ = comm S X - comm S X := by rw [← hX_m, ← hX_n]
      _ = 0 := sub_self _
  exact (IsAddTorsionFree.zsmul_eq_zero_iff_right
    (sub_ne_zero.mpr hmn)).mp hmul

/-- Distinct integer eigenspaces of the adjoint anomaly have trivial
intersection when the additive group has no torsion. This is the directness
condition for interpreting the integer adjoint-grade family as a grading. -/
theorem kkt_adjoint_grades_disjoint [IsAddTorsionFree B]
    (N_plus : B) {m n : ℤ} (hmn : m ≠ n) :
    Disjoint (KKTAdjointGrade N_plus m) (KKTAdjointGrade N_plus n) := by
  rw [AddSubgroup.disjoint_def]
  intro X hXm hXn
  change comm (Sigma N_plus) X = m • X at hXm
  change comm (Sigma N_plus) X = n • X at hXn
  exact kkt_adjoint_grades_intersection_eq_zero hXm hXn hmn

local instance : LieRing B := LieRing.ofAssociativeRing

/-- Mathlib's native homogeneous-bracket interface for the adjoint eigenspaces.
This records degree addition without asserting a direct-sum decomposition. -/
instance kkt_adjoint_grades_bracket :
    SetLike.GradedBracket (fun k : ℤ => KKTAdjointGradeSubmodule (B := B) N_plus k)
      (fun k : ℤ => KKTAdjointGradeSubmodule (B := B) N_plus k) where
  bracket_mem := by
    intro m n X Y hX hY
    change comm X Y ∈ KKTAdjointGrade N_plus (m + n)
    exact kkt_grade_bracket_mem hX hY

/-- Each of the five concrete Peirce sectors belongs to its corresponding
adjoint-eigenspace subgroup. -/
theorem peirce_five_grades_mem (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceGradePlus2 N_plus X ∈ KKTAdjointGrade N_plus 2 ∧
    peirceGradePlus1 N_plus X ∈ KKTAdjointGrade N_plus 1 ∧
    peirceGradeZero N_plus X ∈ KKTAdjointGrade N_plus 0 ∧
    peirceGradeMinus1 N_plus X ∈ KKTAdjointGrade N_plus (-1) ∧
    peirceGradeMinus2 N_plus X ∈ KKTAdjointGrade N_plus (-2) := by
  rcases comm_Sigma_peirce_five_grades N_plus X h_nil h_reg with
    ⟨h2, h1, h0, hm1, hm2⟩
  constructor
  · change comm (Sigma N_plus) (peirceGradePlus2 N_plus X) =
      (2 : ℤ) • peirceGradePlus2 N_plus X
    simpa [two_nsmul] using h2
  constructor
  · change comm (Sigma N_plus) (peirceGradePlus1 N_plus X) =
      (1 : ℤ) • peirceGradePlus1 N_plus X
    simpa using h1
  constructor
  · change comm (Sigma N_plus) (peirceGradeZero N_plus X) =
      (0 : ℤ) • peirceGradeZero N_plus X
    simpa using h0
  constructor
  · change comm (Sigma N_plus) (peirceGradeMinus1 N_plus X) =
      (-1 : ℤ) • peirceGradeMinus1 N_plus X
    simpa using hm1
  · change comm (Sigma N_plus) (peirceGradeMinus2 N_plus X) =
      (-2 : ℤ) • peirceGradeMinus2 N_plus X
    simpa [two_nsmul] using hm2

/-- Each concrete Peirce summand embeds into the corresponding native
`ℤ`-submodule of the `ad(Σ)` grading. This connects the direct-sum decomposition
to Mathlib's `GradedBracket` interface on adjoint eigenspaces. -/
theorem peirceFiveGradeSubmodule_le_KKTAdjointGradeSubmodule (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) (i : Fin 5) :
    peirceFiveGradeSubmodule N_plus i ≤
      KKTAdjointGradeSubmodule N_plus (peirceFiveGradeDegree i) := by
  intro x hx
  change x ∈ peirceFiveGradeSubgroup N_plus i at hx
  change x ∈ KKTAdjointGrade N_plus (peirceFiveGradeDegree i)
  fin_cases i
  · change x ∈ peirceGradePlus2Subgroup N_plus at hx
    change x ∈ KKTAdjointGrade N_plus 2
    change x ∈ Set.range (peirceGradePlus2 N_plus) at hx
    rcases hx with ⟨y, hy⟩
    rw [← hy]
    exact (peirce_five_grades_mem N_plus y h_nil h_reg).1
  · change x ∈ peirceGradePlus1Subgroup N_plus at hx
    change x ∈ KKTAdjointGrade N_plus 1
    change x ∈ Set.range (peirceGradePlus1 N_plus) at hx
    rcases hx with ⟨y, hy⟩
    rw [← hy]
    exact (peirce_five_grades_mem N_plus y h_nil h_reg).2.1
  · change x ∈ peirceGradeZeroSubgroup N_plus at hx
    change x ∈ KKTAdjointGrade N_plus 0
    change x ∈ Set.range (peirceGradeZero N_plus) at hx
    rcases hx with ⟨y, hy⟩
    rw [← hy]
    exact (peirce_five_grades_mem N_plus y h_nil h_reg).2.2.1
  · change x ∈ peirceGradeMinus1Subgroup N_plus at hx
    change x ∈ KKTAdjointGrade N_plus (-1)
    change x ∈ Set.range (peirceGradeMinus1 N_plus) at hx
    rcases hx with ⟨y, hy⟩
    rw [← hy]
    exact (peirce_five_grades_mem N_plus y h_nil h_reg).2.2.2.1
  · change x ∈ peirceGradeMinus2Subgroup N_plus at hx
    change x ∈ KKTAdjointGrade N_plus (-2)
    change x ∈ Set.range (peirceGradeMinus2 N_plus) at hx
    rcases hx with ⟨y, hy⟩
    rw [← hy]
    exact (peirce_five_grades_mem N_plus y h_nil h_reg).2.2.2.2

/-- The bracket of two concrete Peirce components belongs to the native
adjoint-grade submodule of the sum of their degrees. This composes the
component-to-eigenspace map with Mathlib's `GradedBracket` closure. -/
theorem peirceFiveGrade_bracket_mem_adjoint (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (i j : Fin 5) (x y : B)
    (hx : x ∈ peirceFiveGradeSubmodule N_plus i)
    (hy : y ∈ peirceFiveGradeSubmodule N_plus j) :
    comm x y ∈ KKTAdjointGradeSubmodule N_plus
      (peirceFiveGradeDegree i + peirceFiveGradeDegree j) := by
  have hx' : x ∈ KKTAdjointGrade N_plus (peirceFiveGradeDegree i) :=
    peirceFiveGradeSubmodule_le_KKTAdjointGradeSubmodule
      N_plus h_nil h_reg i hx
  have hy' : y ∈ KKTAdjointGrade N_plus (peirceFiveGradeDegree j) :=
    peirceFiveGradeSubmodule_le_KKTAdjointGradeSubmodule
      N_plus h_nil h_reg j hy
  exact kkt_grade_bracket_mem hx' hy'

/-- An adjoint eigenvector has no Peirce component whose integer grade differs
from its eigenvalue, provided the additive group is torsion-free. -/
theorem peirce_components_of_adjoint_eigenvalue [IsAddTorsionFree B]
    (N_plus X : B) (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) (k : ℤ)
    (hX : comm (Sigma N_plus) X = k • X) :
    (k ≠ 2 → peirceGradePlus2 N_plus X = 0) ∧
    (k ≠ 1 → peirceGradePlus1 N_plus X = 0) ∧
    (k ≠ 0 → peirceGradeZero N_plus X = 0) ∧
    (k ≠ -1 → peirceGradeMinus1 N_plus X = 0) ∧
    (k ≠ -2 → peirceGradeMinus2 N_plus X = 0) := by
  let x₂ := peirceGradePlus2 N_plus X
  let x₁ := peirceGradePlus1 N_plus X
  let x₀ := peirceGradeZero N_plus X
  let xm₁ := peirceGradeMinus1 N_plus X
  let xm₂ := peirceGradeMinus2 N_plus X
  have hdecomp : X = x₂ + x₁ + x₀ + xm₁ + xm₂ :=
    peirce_five_grade_decomposition N_plus X h_nil h_reg
  have hgrades := peirce_five_grades_mem N_plus X h_nil h_reg
  have he₂ : comm (Sigma N_plus) x₂ = (2 : ℤ) • x₂ := by
    change x₂ ∈ KKTAdjointGrade N_plus 2
    exact hgrades.1
  have he₁ : comm (Sigma N_plus) x₁ = (1 : ℤ) • x₁ := by
    change x₁ ∈ KKTAdjointGrade N_plus 1
    exact hgrades.2.1
  have he₀ : comm (Sigma N_plus) x₀ = (0 : ℤ) • x₀ := by
    change x₀ ∈ KKTAdjointGrade N_plus 0
    exact hgrades.2.2.1
  have hem₁ : comm (Sigma N_plus) xm₁ = (-1 : ℤ) • xm₁ := by
    change xm₁ ∈ KKTAdjointGrade N_plus (-1)
    exact hgrades.2.2.2.1
  have hem₂ : comm (Sigma N_plus) xm₂ = (-2 : ℤ) • xm₂ := by
    change xm₂ ∈ KKTAdjointGrade N_plus (-2)
    exact hgrades.2.2.2.2
  have h_ad : comm (Sigma N_plus) X =
      (2 : ℤ) • x₂ + (1 : ℤ) • x₁ + (0 : ℤ) • x₀ +
        (-1 : ℤ) • xm₁ + (-2 : ℤ) • xm₂ := by
    rw [hdecomp, kkt_comm_add_right, kkt_comm_add_right,
      kkt_comm_add_right, kkt_comm_add_right, he₂, he₁, he₀, hem₁, hem₂]
  have hdiff :
      ((2 : ℤ) • x₂ - k • x₂) + ((1 : ℤ) • x₁ - k • x₁) +
      ((0 : ℤ) • x₀ - k • x₀) + ((-1 : ℤ) • xm₁ - k • xm₁) +
      ((-2 : ℤ) • xm₂ - k • xm₂) = 0 := by
    calc
      _ = comm (Sigma N_plus) X - k • X := by
        rw [h_ad, hdecomp]
        simp only [zsmul_add]
        abel
      _ = 0 := by rw [hX, sub_self]
  have hsub₂ : (2 : ℤ) • x₂ - k • x₂ = (2 - k) • x₂ := by
    simpa only [sub_eq_add_neg] using (sub_zsmul x₂ (2 : ℤ) k).symm
  have hsub₁ : (1 : ℤ) • x₁ - k • x₁ = (1 - k) • x₁ := by
    simpa only [sub_eq_add_neg] using (sub_zsmul x₁ (1 : ℤ) k).symm
  have hsub₀ : (0 : ℤ) • x₀ - k • x₀ = (0 - k) • x₀ := by
    simpa only [sub_eq_add_neg] using (sub_zsmul x₀ (0 : ℤ) k).symm
  have hsubm₁ : (-1 : ℤ) • xm₁ - k • xm₁ = (-1 - k) • xm₁ := by
    simpa only [sub_eq_add_neg] using (sub_zsmul xm₁ (-1 : ℤ) k).symm
  have hsubm₂ : (-2 : ℤ) • xm₂ - k • xm₂ = (-2 - k) • xm₂ := by
    simpa only [sub_eq_add_neg] using (sub_zsmul xm₂ (-2 : ℤ) k).symm
  rw [hsub₂, hsub₁, hsub₀, hsubm₁, hsubm₂] at hdiff
  have hx₂ : x₂ ∈ peirceGradePlus2Subgroup N_plus := ⟨X, rfl⟩
  have hx₁ : x₁ ∈ peirceGradePlus1Subgroup N_plus := ⟨X, rfl⟩
  have hx₀ : x₀ ∈ peirceGradeZeroSubgroup N_plus := ⟨X, rfl⟩
  have hxm₁ : xm₁ ∈ peirceGradeMinus1Subgroup N_plus := ⟨X, rfl⟩
  have hxm₂ : xm₂ ∈ peirceGradeMinus2Subgroup N_plus := ⟨X, rfl⟩
  rcases peirce_five_grade_subgroup_sum_zero N_plus
      ((2 - k) • x₂) ((1 - k) • x₁) ((0 - k) • x₀)
      ((-1 - k) • xm₁) ((-2 - k) • xm₂)
      h_nil h_reg
      ((peirceGradePlus2Subgroup N_plus).zsmul_mem hx₂ (2 - k))
      ((peirceGradePlus1Subgroup N_plus).zsmul_mem hx₁ (1 - k))
      ((peirceGradeZeroSubgroup N_plus).zsmul_mem hx₀ (0 - k))
      ((peirceGradeMinus1Subgroup N_plus).zsmul_mem hxm₁ (-1 - k))
      ((peirceGradeMinus2Subgroup N_plus).zsmul_mem hxm₂ (-2 - k)) hdiff with
    ⟨h₂, h₁, h₀, hm₁, hm₂⟩
  have hkill₂ (hk : k ≠ 2) : x₂ = 0 := by
    have hmul : (2 - k) • x₂ = 0 := h₂
    have hcoef : (2 - k : ℤ) ≠ 0 := sub_ne_zero.mpr (Ne.symm hk)
    exact (IsAddTorsionFree.zsmul_eq_zero_iff_right hcoef).mp hmul
  have hkill₁ (hk : k ≠ 1) : x₁ = 0 := by
    have hmul : (1 - k) • x₁ = 0 := h₁
    have hcoef : (1 - k : ℤ) ≠ 0 := sub_ne_zero.mpr (Ne.symm hk)
    exact (IsAddTorsionFree.zsmul_eq_zero_iff_right hcoef).mp hmul
  have hkill₀ (hk : k ≠ 0) : x₀ = 0 := by
    have hmul : (0 - k) • x₀ = 0 := h₀
    have hcoef : (0 - k : ℤ) ≠ 0 := sub_ne_zero.mpr (Ne.symm hk)
    exact (IsAddTorsionFree.zsmul_eq_zero_iff_right hcoef).mp hmul
  have hkillm₁ (hk : k ≠ -1) : xm₁ = 0 := by
    have hmul : (-1 - k) • xm₁ = 0 := hm₁
    have hcoef : (-1 - k : ℤ) ≠ 0 := sub_ne_zero.mpr (Ne.symm hk)
    exact (IsAddTorsionFree.zsmul_eq_zero_iff_right hcoef).mp hmul
  have hkillm₂ (hk : k ≠ -2) : xm₂ = 0 := by
    have hmul : (-2 - k) • xm₂ = 0 := hm₂
    have hcoef : (-2 - k : ℤ) ≠ 0 := sub_ne_zero.mpr (Ne.symm hk)
    exact (IsAddTorsionFree.zsmul_eq_zero_iff_right hcoef).mp hmul
  exact ⟨hkill₂, hkill₁, hkill₀, hkillm₁, hkillm₂⟩

/-- Under additive torsion-freeness, each Peirce submodule is exactly the
corresponding native integer eigenspace of `ad(Σ)`. -/
theorem peirceFiveGradeSubmodule_eq_KKTAdjointGradeSubmodule
    [IsAddTorsionFree B] (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) (i : Fin 5) :
    peirceFiveGradeSubmodule N_plus i =
      KKTAdjointGradeSubmodule N_plus (peirceFiveGradeDegree i) := by
  ext X
  constructor
  · intro hx
    exact peirceFiveGradeSubmodule_le_KKTAdjointGradeSubmodule
      N_plus h_nil h_reg i hx
  · intro hX
    change X ∈ KKTAdjointGrade N_plus (peirceFiveGradeDegree i) at hX
    change comm (Sigma N_plus) X = peirceFiveGradeDegree i • X at hX
    have hfilter := peirce_components_of_adjoint_eigenvalue
      N_plus X h_nil h_reg (peirceFiveGradeDegree i) hX
    have hdecomp := peirce_five_grade_decomposition N_plus X h_nil h_reg
    fin_cases i
    · change X ∈ peirceGradePlus2Subgroup N_plus
      simp [peirceFiveGradeDegree] at hfilter
      have hXeq : X = peirceGradePlus2 N_plus X := by
        have h1 := hfilter.1
        have h0 := hfilter.2.1
        have hm1 := hfilter.2.2.1
        have hm2 := hfilter.2.2.2
        calc
          X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
              peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
              peirceGradeMinus2 N_plus X := hdecomp
          _ = peirceGradePlus2 N_plus X := by simp [h1, h0, hm1, hm2]
      rw [hXeq]
      exact ⟨X, rfl⟩
    · change X ∈ peirceGradePlus1Subgroup N_plus
      simp [peirceFiveGradeDegree] at hfilter
      have hXeq : X = peirceGradePlus1 N_plus X := by
        have h2 := hfilter.1
        have h0 := hfilter.2.1
        have hm1 := hfilter.2.2.1
        have hm2 := hfilter.2.2.2
        calc
          X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
              peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
              peirceGradeMinus2 N_plus X := hdecomp
          _ = peirceGradePlus1 N_plus X := by simp [h2, h0, hm1, hm2]
      rw [hXeq]
      exact ⟨X, rfl⟩
    · change X ∈ peirceGradeZeroSubgroup N_plus
      simp [peirceFiveGradeDegree] at hfilter
      have hXeq : X = peirceGradeZero N_plus X := by
        have h2 := hfilter.1
        have h1 := hfilter.2.1
        have hm1 := hfilter.2.2.1
        have hm2 := hfilter.2.2.2
        calc
          X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
              peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
              peirceGradeMinus2 N_plus X := hdecomp
          _ = peirceGradeZero N_plus X := by simp [h2, h1, hm1, hm2]
      rw [hXeq]
      exact ⟨X, rfl⟩
    · change X ∈ peirceGradeMinus1Subgroup N_plus
      simp [peirceFiveGradeDegree] at hfilter
      have hXeq : X = peirceGradeMinus1 N_plus X := by
        have h2 := hfilter.1
        have h1 := hfilter.2.1
        have h0 := hfilter.2.2.1
        have hm2 := hfilter.2.2.2
        calc
          X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
              peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
              peirceGradeMinus2 N_plus X := hdecomp
          _ = peirceGradeMinus1 N_plus X := by simp [h2, h1, h0, hm2]
      rw [hXeq]
      exact ⟨X, rfl⟩
    · change X ∈ peirceGradeMinus2Subgroup N_plus
      simp [peirceFiveGradeDegree] at hfilter
      have hXeq : X = peirceGradeMinus2 N_plus X := by
        have h2 := hfilter.1
        have h1 := hfilter.2.1
        have h0 := hfilter.2.2.1
        have hm1 := hfilter.2.2.2
        calc
          X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
              peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
              peirceGradeMinus2 N_plus X := hdecomp
          _ = peirceGradeMinus2 N_plus X := by simp [h2, h1, h0, hm1]
      rw [hXeq]
      exact ⟨X, rfl⟩

/-- If the sum of two Peirce degrees is again one of the five degrees, their
Lie bracket lies in that concrete Peirce sector. This is the Peirce-side form
of the native adjoint-eigenspace graded-bracket law. -/
theorem peirceFiveGrade_bracket_mem_peirce [IsAddTorsionFree B]
    (N_plus : B) (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (i j k : Fin 5) (x y : B)
    (hx : x ∈ peirceFiveGradeSubmodule N_plus i)
    (hy : y ∈ peirceFiveGradeSubmodule N_plus j)
    (hdegree : peirceFiveGradeDegree i + peirceFiveGradeDegree j =
      peirceFiveGradeDegree k) :
    comm x y ∈ peirceFiveGradeSubmodule N_plus k := by
  have hbracket := peirceFiveGrade_bracket_mem_adjoint
    N_plus h_nil h_reg i j x y hx hy
  rw [hdegree] at hbracket
  rw [peirceFiveGradeSubmodule_eq_KKTAdjointGradeSubmodule
    N_plus h_nil h_reg k]
  exact hbracket

/-- No other integer adjoint grades occur: under additive torsion-freeness,
the eigenspace vanishes at every degree outside `{-2,-1,0,1,2}`. -/
theorem KKTAdjointGrade_eq_bot_of_outside_five
    [IsAddTorsionFree B] (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) (k : ℤ)
    (hk₂ : k ≠ 2) (hk₁ : k ≠ 1) (hk₀ : k ≠ 0)
    (hkm₁ : k ≠ -1) (hkm₂ : k ≠ -2) :
    KKTAdjointGrade N_plus k = ⊥ := by
  ext X
  constructor
  · intro hX
    change comm (Sigma N_plus) X = k • X at hX
    rcases peirce_components_of_adjoint_eigenvalue
        N_plus X h_nil h_reg k hX with ⟨h₂, h₁, h₀, hm₁, hm₂⟩
    have hdecomp := peirce_five_grade_decomposition N_plus X h_nil h_reg
    have hXzero : X = 0 := by
      rw [hdecomp, h₂ hk₂, h₁ hk₁, h₀ hk₀, hm₁ hkm₁, hm₂ hkm₂]
      simp
    simpa [hXzero]
  · intro hX
    rw [hX]
    exact (KKTAdjointGrade N_plus k).zero_mem

/-- Brackets whose integer degree sum lies outside the five KKT degrees vanish.
Together with `peirceFiveGrade_bracket_mem_peirce`, this gives closure at every
degree sum, including the truncation at grades `±3` and `±4`. -/
theorem peirceFiveGrade_bracket_eq_zero_of_degree_sum_outside
    [IsAddTorsionFree B] (N_plus : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus)
    (i j : Fin 5) (x y : B) (k : ℤ)
    (hx : x ∈ peirceFiveGradeSubmodule N_plus i)
    (hy : y ∈ peirceFiveGradeSubmodule N_plus j)
    (hdegree : peirceFiveGradeDegree i + peirceFiveGradeDegree j = k)
    (hk₂ : k ≠ 2) (hk₁ : k ≠ 1) (hk₀ : k ≠ 0)
    (hkm₁ : k ≠ -1) (hkm₂ : k ≠ -2) :
    comm x y = 0 := by
  have hbracket := peirceFiveGrade_bracket_mem_adjoint
    N_plus h_nil h_reg i j x y hx hy
  rw [hdegree] at hbracket
  have hgrade0 := KKTAdjointGrade_eq_bot_of_outside_five
    N_plus h_nil h_reg k hk₂ hk₁ hk₀ hkm₁ hkm₂
  have hsubmodule0 : KKTAdjointGradeSubmodule N_plus k = ⊥ := by
    change (KKTAdjointGrade N_plus k).toIntSubmodule = ⊥
    rw [hgrade0]
    rfl
  rw [hsubmodule0] at hbracket
  simpa using hbracket

/-- The zero adjoint-grade sector is a native mathlib Lie subalgebra of the
associative ring equipped with its commutator Lie bracket. -/
def KKTGradeZeroLieSubalgebra (N_plus : B) :
    (letI : LieRing B := LieRing.ofAssociativeRing
     LieSubalgebra ℤ B) := by
  letI : LieRing B := LieRing.ofAssociativeRing
  exact
    { carrier := KKTAdjointGrade N_plus 0
      zero_mem' := by
        change comm (Sigma N_plus) 0 = (0 : ℤ) • 0
        simp [comm]
      add_mem' := by
        intro X Y hX hY
        change comm (Sigma N_plus) X = (0 : ℤ) • X at hX
        change comm (Sigma N_plus) Y = (0 : ℤ) • Y at hY
        simp only [zero_zsmul] at hX hY
        change comm (Sigma N_plus) (X + Y) = (0 : ℤ) • (X + Y)
        rw [kkt_comm_add_right, hX, hY, add_zero]
        simp
      smul_mem' := by
        intro n X hX
        change comm (Sigma N_plus) X = (0 : ℤ) • X at hX
        simp only [zero_zsmul] at hX
        change comm (Sigma N_plus) (n • X) = (0 : ℤ) • (n • X)
        rw [kkt_comm_zsmul_right, hX]
        simp
      lie_mem' := by
        intro X Y hX hY
        change comm (Sigma N_plus) X = (0 : ℤ) • X at hX
        change comm (Sigma N_plus) Y = (0 : ℤ) • Y at hY
        simp only [zero_zsmul] at hX hY
        change comm (Sigma N_plus) (comm X Y) = (0 : ℤ) • comm X Y
        rw [kkt_commutator_derivation, hX, hY]
        simp [comm] }

/-- The concrete Peirce grade-zero sector lies in the native KKT Lie
subalgebra. -/
theorem peirceGradeZero_mem_KKTGradeZeroLieSubalgebra (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    peirceGradeZero N_plus X ∈ KKTGradeZeroLieSubalgebra N_plus := by
  exact (peirce_five_grades_mem N_plus X h_nil h_reg).2.2.1

/-- Completion interface: the five Peirce sectors exhaust each operator, are graded
by `ad(Σ)`, and their extremal pieces are reached by the Jordan-associator generators. -/
theorem kkt_peirce_five_grade_completion (N_plus X : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    (X = peirceGradePlus2 N_plus X + peirceGradePlus1 N_plus X +
      peirceGradeZero N_plus X + peirceGradeMinus1 N_plus X +
      peirceGradeMinus2 N_plus X) ∧
    (comm (Sigma N_plus) (peirceGradePlus2 N_plus X) =
        (2 : ℕ) • peirceGradePlus2 N_plus X ∧
     comm (Sigma N_plus) (peirceGradePlus1 N_plus X) = peirceGradePlus1 N_plus X ∧
     comm (Sigma N_plus) (peirceGradeZero N_plus X) = 0 ∧
     comm (Sigma N_plus) (peirceGradeMinus1 N_plus X) = -peirceGradeMinus1 N_plus X ∧
     comm (Sigma N_plus) (peirceGradeMinus2 N_plus X) =
        -((2 : ℕ) • peirceGradeMinus2 N_plus X)) ∧
    (K_plus2 N_plus (star N_plus * X * star N_plus) =
        (2 : ℕ) • peirceGradePlus2 N_plus X ∧
     K_minus2 N_plus (N_plus * X * N_plus) =
        (2 : ℕ) • peirceGradeMinus2 N_plus X) ∧
    (comm (peirceGradePlus1 N_plus X) (peirceGradeMinus1 N_plus Y) =
      G_0_P N_plus (X * peirceR N_plus * Y) -
      G_0_Q N_plus (Y * peirceR N_plus * X) +
      peirceR N_plus * (X * Q N_plus * Y - Y * P N_plus * X) * peirceR N_plus) ∧
    comm (peirceGradePlus2 N_plus X) (peirceGradePlus1 N_plus Y) = 0 ∧
    comm (peirceGradeMinus2 N_plus X) (peirceGradeMinus1 N_plus Y) = 0 ∧
    (comm (G_plus2 N_plus X) (G_minus2 N_plus Y) =
      G_0_P N_plus (N_plus * X * P N_plus * Y * star N_plus) -
      G_0_Q N_plus (star N_plus * Y * Q N_plus * X * N_plus)) ∧
    (comm (peirceGradeZero N_plus X) (peirceGradeZero N_plus Y) =
      comm (G_0_P N_plus X) (G_0_P N_plus Y) +
      comm (G_0_Q N_plus X) (G_0_Q N_plus Y) +
      comm (G_0_neutral N_plus X) (G_0_neutral N_plus Y)) ∧
    (peirceGradePlus2 N_plus X ∈ KKTAdjointGrade N_plus 2 ∧
     peirceGradePlus1 N_plus X ∈ KKTAdjointGrade N_plus 1 ∧
     peirceGradeZero N_plus X ∈ KKTAdjointGrade N_plus 0 ∧
     peirceGradeMinus1 N_plus X ∈ KKTAdjointGrade N_plus (-1) ∧
     peirceGradeMinus2 N_plus X ∈ KKTAdjointGrade N_plus (-2)) := by
  exact ⟨peirce_five_grade_decomposition N_plus X h_nil h_reg,
    comm_Sigma_peirce_five_grades N_plus X h_nil h_reg,
    K_extremals_cover_peirce_grades N_plus X h_nil,
    comm_peirceGradePlus1_minus1_closed N_plus X Y h_nil h_reg,
    comm_peirceGradePlus2_plus1 N_plus X Y h_nil h_reg,
    comm_peirceGradeMinus2_minus1 N_plus X Y h_nil h_reg,
    comm_G_plus2_G_minus2_in_G_0 N_plus X Y h_reg,
    comm_peirceGradeZero_closed N_plus X Y h_nil h_reg,
    peirce_five_grades_mem N_plus X h_nil h_reg⟩

/-- **Theorem `KKT₉` (Opposite Extremal Commutator Has Adjoint Grade `0`)**:
`[Σ, [G_{+2}(N_+, X), G_{-2}(N_+, Y)]] = 0`. -/
theorem comm_Sigma_comm_G_plus2_G_minus2 (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0) (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    comm (Sigma N_plus) (comm (G_plus2 N_plus X) (G_minus2 N_plus Y)) = 0 := by
  rw [comm_G_plus2_G_minus2_in_G_0 N_plus X Y h_reg,
      kkt_comm_sub_right,
      comm_Sigma_G_0_P N_plus _ h_nil h_reg,
      comm_Sigma_G_0_Q N_plus _ h_nil h_reg,
      sub_self]

/-- **Theorem `KKT₁₀` (`kantor_koecher_tits_five_graded_closure_poset_master_synthesis`)**:
Master synthesis of the 10-stage Kantor–Koecher–Tits five-sector Peirce and
adjoint-grade closure results (`KKT₁`–`KKT₁₀`):
1. The causal poset `KantorKoecherTitsStage` chains `KKT₁ → ⋯ → KKT₁₀`,
2. Extremal Jordan associator triple sandwiches `K_{±2} = 2 • G_{±2}` carry adjoint eigenvalues `±2`
   under `ad(Σ)`, are abelian-nilpotent (`K_{+2} K_{+2} = 0`, `K_{-2} K_{-2} = 0`), and have `N_±` as
   seed fixed points (`K_{+2}(N_+, N_-) = 2 • N_+`, `K_{-2}(N_+, N_+) = 2 • N_-`),
3. Odd carriers `G_{±1}^{L,R}` carry adjoint eigenvalues `±1` and bracket into `G_{±2}`,
4. Opposite extremal commutators `[G_{+2}, G_{-2}]` decompose into `G_0^P - G_0^Q` and commute
   with `Σ` (`[Σ, [G_{+2}, G_{-2}]] = 0`), while additional concrete Peirce bracket closures
   land in their corresponding range subgroups. -/
theorem kantor_koecher_tits_five_graded_closure_poset_master_synthesis
    (N_plus X Y : B)
    (h_nil : N_plus * N_plus = 0)
    (h_reg : N_plus * star N_plus * N_plus = N_plus) :
    (KantorKoecherTitsStage.causalEdge
       .KKT1_JordanQuadraticTripleSandwich .KKT2_ExtremalGradePlusMinusTwo ∧
     KantorKoecherTitsStage.causalEdge
       .KKT2_ExtremalGradePlusMinusTwo .KKT3_ExtremalAbelianNilpotency ∧
     KantorKoecherTitsStage.causalEdge
       .KKT3_ExtremalAbelianNilpotency .KKT4_RegularNilpotentSeedFixedPoint ∧
     KantorKoecherTitsStage.causalEdge
       .KKT4_RegularNilpotentSeedFixedPoint .KKT5_OddGradePlusMinusOneCarriers ∧
     KantorKoecherTitsStage.causalEdge
       .KKT5_OddGradePlusMinusOneCarriers .KKT6_OddToExtremalBracketClosure ∧
     KantorKoecherTitsStage.causalEdge
       .KKT6_OddToExtremalBracketClosure .KKT7_ExtremalOppositeGradeToZero ∧
     KantorKoecherTitsStage.causalEdge
       .KKT7_ExtremalOppositeGradeToZero .KKT8_ZeroGradeDiagonalNeutralCentralizer ∧
     KantorKoecherTitsStage.causalEdge
       .KKT8_ZeroGradeDiagonalNeutralCentralizer .KKT9_ExtremalCommutatorZeroGradeClosure ∧
     KantorKoecherTitsStage.causalEdge
       .KKT9_ExtremalCommutatorZeroGradeClosure
       .KKT10_MasterFiveGradedKantorKoecherTitsSynthesis) ∧
    (K_plus2 N_plus X = (2 : ℕ) • G_plus2 N_plus X ∧
     K_minus2 N_plus X = (2 : ℕ) • G_minus2 N_plus X ∧
     comm (Sigma N_plus) (K_plus2 N_plus X) = (2 : ℕ) • K_plus2 N_plus X ∧
     comm (Sigma N_plus) (K_minus2 N_plus X) = -((2 : ℕ) • K_minus2 N_plus X)) ∧
    (K_plus2 N_plus X * K_plus2 N_plus Y = 0 ∧
     K_minus2 N_plus X * K_minus2 N_plus Y = 0 ∧
     K_plus2 N_plus (star N_plus) = (2 : ℕ) • N_plus ∧
     K_minus2 N_plus N_plus = (2 : ℕ) • star N_plus) ∧
    (comm (Sigma N_plus) (G_plus1_L N_plus X) = G_plus1_L N_plus X ∧
     comm (Sigma N_plus) (G_plus1_R N_plus X) = G_plus1_R N_plus X ∧
     comm (Sigma N_plus) (G_minus1_L N_plus X) = -G_minus1_L N_plus X ∧
     comm (Sigma N_plus) (G_minus1_R N_plus X) = -G_minus1_R N_plus X) ∧
    (comm (G_plus1_L N_plus X) (G_plus1_R N_plus Y) =
       G_plus2 N_plus (X * (1 - Gap N_plus) * Y) ∧
     comm (G_minus1_L N_plus X) (G_minus1_R N_plus Y) =
       G_minus2 N_plus (X * (1 - Gap N_plus) * Y)) ∧
    (comm (G_plus2 N_plus X) (G_minus2 N_plus Y) =
       G_0_P N_plus (N_plus * X * P N_plus * Y * star N_plus) -
       G_0_Q N_plus (star N_plus * Y * Q N_plus * X * N_plus) ∧
     comm (Sigma N_plus) (G_0_P N_plus X) = 0 ∧
     comm (Sigma N_plus) (G_0_Q N_plus X) = 0 ∧
     comm (Sigma N_plus) (G_0_neutral N_plus X) = 0 ∧
