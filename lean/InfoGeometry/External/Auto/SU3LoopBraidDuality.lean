/-! ## B₃ Braid group generators and the S₃ projection -/

/-- The Artin braid group B₃ is generated by σ₁, σ₂ with relation
  σ₁ σ₂ σ₁ = σ₂ σ₁ σ₂.

The Weyl generators swap12, swap23 from `WeylSU3ColorSymmetry` are the
S₃ projection of these braid generators: proj(σ₁) = swap12, proj(σ₂) = swap23. -/
theorem braid_relation_holds_on_weyl_generators :
    swap12 ∘ swap23 ∘ swap12 = swap23 ∘ swap12 ∘ swap23 :=
  swap12_swap23_braid

/-- The braid generators square NOT to the identity (they are lifts, not projections).
The S₃ transpositions DO square to the identity: swap12² = swap23² = id. -/
theorem weyl_transpositions_square_to_identity :
    swap12 ∘ swap12 = id ∧ swap23 ∘ swap23 = id := by
  constructor
  · funext i
    simp [swap12]
  · funext i
    simp [swap23]

/- The braid relation B₃ projects to the Weyl group S₃.  On the Gell-Mann
matrices, the Weyl action `weylAct(swap12)(λ_a) = P₁₂·λ_a·P₁₂` permutes
the color indices.  The braid relation on the generators implies that the
Weyl-conjugated Gell-Mann commutators satisfy the same braid coherence.

The full braid transport `weylAct(swap12)(A) * weylAct(swap23)(A) * ...`
is a structural consequence of the permutation-matrix algebra;
the braid relation on the permutation level is proved above. -/

/-! ## The Cuntz algebra O₄ as quantum SU_q(3) -/

/-- The quantum deformation parameter q at the conformal boundary.
For the thermal Unruh frame: q = qRapidity(β) = exp(-β(E - μQ) + θ).
At q = root of unity (q^N = 1), SU_q(3) is a finite-dimensional
Hopf algebra whose representation theory is modular. -/
def quantumDeformationParameter (β : ℝ) (E : ℝ) (μ : ℝ) (Q : ℝ) (θ : ℝ) : ℂ :=
  qRapidity (θ - β * (E - μ * Q))

/-! The identification of a quantum `SU_q(3)` representation category with a
Cuntz/Cuntz--Krieger model is not formalized here.  No proposition-valued
certificate for that analytic statement is introduced. -/

/-! ## Cantor-loop gauge steps and braid covariance -/

/-- A finite-stage Cantor-loop gauge step on the `3+1` parafermion lanes:
three local color weights and one singlet weight.  This is the checked finite
shadow of a continuous map `Cantor → U(3) × U(1)`. -/
def cantorLoopGaugeStep4 {V : Type*} [SMul ℂ V]
    (w : Fin 3 → ℂ) (s : ℂ) (ψ : ColorSpinor4 V) : ColorSpinor4 V :=
  (fun i => w i • ψ.1 i, s • ψ.2)

/-- Braiding a local diagonal gauge step transports the gauge weights by the
same color-lane permutation.  This is the finite algebraic kernel of
`Map(Cantor, SU(3)) ⋊ B₃`: braids do not destroy local gauge data; they move it
to the braided lane. -/
theorem permuteColorSpinor4_cantorLoopGaugeStep4
    {V : Type*} [AddCommMonoid V] [Module ℂ V]
    (π : Equiv.Perm (Fin 3)) (w : Fin 3 → ℂ) (s : ℂ) (ψ : ColorSpinor4 V) :
    permuteColorSpinor4 π (cantorLoopGaugeStep4 w s ψ) =
      cantorLoopGaugeStep4 (fun i => w (π i)) s (permuteColorSpinor4 π ψ) := by
  ext i <;> simp [permuteColorSpinor4, cantorLoopGaugeStep4]

/-- The q-scaled color braid is covariant for Cantor-loop gauge steps. -/
theorem qColorBraid4_cantorLoopGaugeStep4_covariant
    {V : Type*} [AddCommMonoid V] [Module ℂ V]
    (q : ℂ) (π : Equiv.Perm (Fin 3)) (w : Fin 3 → ℂ) (s : ℂ)
    (ψ : ColorSpinor4 V) :
    qColorBraid4 q π (cantorLoopGaugeStep4 w s ψ) =
      cantorLoopGaugeStep4 (fun i => w (π i)) s (qColorBraid4 q π ψ) := by
  ext i <;> simp [qColorBraid4, permuteColorSpinor4, cantorLoopGaugeStep4,
    smul_smul, mul_comm]

/-- If the local color weights are invariant under a braid generator, the
Cantor-loop gauge step commutes exactly with that braid. -/
theorem qColorBraid4_commutes_with_invariant_cantorLoopGaugeStep4
    {V : Type*} [AddCommMonoid V] [Module ℂ V]
    (q : ℂ) (π : Equiv.Perm (Fin 3)) (w : Fin 3 → ℂ) (s : ℂ)
    (hπ : ∀ i, w (π i) = w i) (ψ : ColorSpinor4 V) :
    qColorBraid4 q π (cantorLoopGaugeStep4 w s ψ) =
      cantorLoopGaugeStep4 w s (qColorBraid4 q π ψ) := by
  rw [qColorBraid4_cantorLoopGaugeStep4_covariant]
  congr
  ext i
  exact hπ i

/-! The DHR superselection-sector and loop-group equivalence layers require
