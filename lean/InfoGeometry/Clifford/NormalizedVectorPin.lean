import InfoGeometry.Clifford.FreedCliffordSuspension
import Mathlib.Algebra.Group.Subgroup.Map
import Mathlib.Algebra.Group.Units.Hom
import Mathlib.Algebra.Ring.Units
import Mathlib.LinearAlgebra.CliffordAlgebra.Inversion

/-!
# Normalized-vector Pin groups and the ordered Clifford suspensions

The Pin carrier is the subgroup of actual Clifford units generated by vectors
whose quadratic value is `1` or `-1`.  This generalizes the concrete definition
in `InfoGeometry.Clifford.Cl55RealSplitPin`; it does not use the additional
unitary restriction in Mathlib's `pinGroup`.

The target even Pin carrier consists of units of the native even Clifford
algebra whose ambient units belong to the normalized-vector subgroup.  Each
ordered suspension sends a normalized source vector to the product of two
normalized target vectors.  Subgroup closure then constructs genuine group
homomorphisms, and the underlying algebra equivalences prove injectivity.

These are algebraic embeddings.  No connected-component, topological covering,
geometric Dirac, or index-theoretic identification is asserted here.
-/

noncomputable section

namespace InfoGeometry.Clifford.NormalizedVectorPin

open CliffordAlgebra
open InfoGeometry.Clifford.FreedCliffordSuspension

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- Units represented by Clifford vectors of quadratic value `1` or `-1`. -/
def normalizedVectorUnitSet (Q : QuadraticForm R M) : Set (CliffordAlgebra Q)ˣ :=
  {u | ∃ v : M, (Q v = 1 ∨ Q v = -1) ∧ ι Q v = (u : CliffordAlgebra Q)}

/-- The subgroup generated by all normalized vectors of either sign. -/
def pin (Q : QuadraticForm R M) : Subgroup (CliffordAlgebra Q)ˣ :=
  Subgroup.closure (normalizedVectorUnitSet Q)

/-- A vector of invertible quadratic value gives an actual Clifford unit. -/
def vectorUnit (Q : QuadraticForm R M) (v : M) (hv : IsUnit (Q v)) :
    (CliffordAlgebra Q)ˣ :=
  (CliffordAlgebra.isUnit_ι_of_isUnit Q hv).unit

@[simp] theorem vectorUnit_coe (Q : QuadraticForm R M) (v : M)
    (hv : IsUnit (Q v)) :
    (vectorUnit Q v hv : CliffordAlgebra Q) = ι Q v :=
  (CliffordAlgebra.isUnit_ι_of_isUnit Q hv).unit_spec

theorem isUnit_of_normalized {r : R} (hr : r = 1 ∨ r = -1) : IsUnit r := by
  rcases hr with hr | hr
  · rw [hr]
    exact isUnit_one
  · rw [hr]
    exact isUnit_neg_one

theorem vectorUnit_mem (Q : QuadraticForm R M) (v : M)
    (hv : Q v = 1 ∨ Q v = -1) (hu : IsUnit (Q v)) :
    vectorUnit Q v hu ∈ pin Q := by
  apply Subgroup.subset_closure
  exact ⟨v, hv, (vectorUnit_coe Q v hu).symm⟩

/-- A specified normalized vector as an element of the generated Pin group. -/
def pinVector (Q : QuadraticForm R M) (v : M) (hv : Q v = 1 ∨ Q v = -1) :
    pin Q :=
  ⟨vectorUnit Q v (isUnit_of_normalized hv),
    vectorUnit_mem Q v hv (isUnit_of_normalized hv)⟩

@[simp] theorem pinVector_coe (Q : QuadraticForm R M) (v : M)
    (hv : Q v = 1 ∨ Q v = -1) :
    ((pinVector Q v hv : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = ι Q v :=
  vectorUnit_coe Q v (isUnit_of_normalized hv)

/-- A Clifford unit represented by an ordered product of two normalized
vectors belongs to the generated Pin group. -/
theorem mem_pin_of_coe_eq_mul (Q : QuadraticForm R M)
    (u : (CliffordAlgebra Q)ˣ) (v w : M)
    (hv : Q v = 1 ∨ Q v = -1) (hw : Q w = 1 ∨ Q w = -1)
    (hu : (u : CliffordAlgebra Q) = ι Q v * ι Q w) : u ∈ pin Q := by
  have hprod : u =
      vectorUnit Q v (isUnit_of_normalized hv) *
        vectorUnit Q w (isUnit_of_normalized hw) := by
    apply Units.ext
    simpa only [Units.val_mul, vectorUnit_coe] using hu
  rw [hprod]
  exact (pin Q).mul_mem (vectorUnit_mem Q v hv _) (vectorUnit_mem Q w hw _)

/-- Inclusion of even Clifford units into all Clifford units. -/
def evenUnits (Q : QuadraticForm R M) :
    (CliffordAlgebra.even Q)ˣ →* (CliffordAlgebra Q)ˣ :=
  Units.map (CliffordAlgebra.even Q).val.toMonoidHom

/-- Normalized-vector Pin elements whose value and inverse lie in the native
even Clifford algebra. -/
def evenPin (Q : QuadraticForm R M) : Subgroup (CliffordAlgebra.even Q)ˣ :=
  (pin Q).comap (evenUnits Q)

/-- The ambient unit underlying an even Pin element. -/
def evenPinToUnits (Q : QuadraticForm R M) : evenPin Q →* (CliffordAlgebra Q)ˣ :=
  (evenUnits Q).comp (evenPin Q).subtype

theorem evenPinToUnits_mem (Q : QuadraticForm R M) (g : evenPin Q) :
    evenPinToUnits Q g ∈ pin Q :=
  g.property

variable (Q : QuadraticForm R M)

/-- The positive suspension on all source units. -/
def positiveUnits :
    (CliffordAlgebra Q)ˣ →* (CliffordAlgebra.even (positiveForm Q))ˣ :=
  Units.map (positiveEquiv Q).toAlgHom.toMonoidHom

/-- The negative suspension on all source units. -/
def negativeUnits :
    (CliffordAlgebra (-Q))ˣ →* (CliffordAlgebra.even (negativeForm Q))ˣ :=
  Units.map (negativeEquiv Q).toAlgHom.toMonoidHom

theorem positiveUnits_generator_mem (u : (CliffordAlgebra Q)ˣ)
    (hu : u ∈ normalizedVectorUnitSet Q) :
    evenUnits (positiveForm Q) (positiveUnits Q u) ∈ pin (positiveForm Q) := by
  rcases hu with ⟨v, hv, hval⟩
  apply mem_pin_of_coe_eq_mul (positiveForm Q) _ (v, 0) (0, 1)
  · simpa only [positiveForm_apply, mul_zero, sub_zero] using hv
  · right
    simp only [positiveForm_apply, map_zero, one_mul, zero_sub]
  · change positiveMap Q (u : CliffordAlgebra Q) = _
    rw [← hval, positiveMap_ι]

theorem negativeUnits_generator_mem (u : (CliffordAlgebra (-Q))ˣ)
    (hu : u ∈ normalizedVectorUnitSet (-Q)) :
    evenUnits (negativeForm Q) (negativeUnits Q u) ∈ pin (negativeForm Q) := by
  rcases hu with ⟨v, hv, hval⟩
  have hv' : Q v = 1 ∨ Q v = -1 := by
    rcases hv with hv | hv
    · right
      simpa using congrArg (fun r : R => -r) hv
    · left
      simpa using congrArg (fun r : R => -r) hv
  apply mem_pin_of_coe_eq_mul (negativeForm Q) _ (v, 0) (0, 1)
  · simpa only [negativeForm_apply, mul_zero, add_zero] using hv'
  · left
    simp only [negativeForm_apply, map_zero, one_mul, zero_add]
  · change negativeMap Q (u : CliffordAlgebra (-Q)) = _
    rw [← hval, negativeMap_ι]

theorem positiveUnits_mem (u : (CliffordAlgebra Q)ˣ) (hu : u ∈ pin Q) :
    positiveUnits Q u ∈ evenPin (positiveForm Q) := by
  have hle : pin Q ≤
      (pin (positiveForm Q)).comap
        ((evenUnits (positiveForm Q)).comp (positiveUnits Q)) := by
    change Subgroup.closure (normalizedVectorUnitSet Q) ≤ _
    apply (Subgroup.closure_le _).mpr
    intro v hv
    exact positiveUnits_generator_mem Q v hv
  exact hle hu

theorem negativeUnits_mem (u : (CliffordAlgebra (-Q))ˣ) (hu : u ∈ pin (-Q)) :
    negativeUnits Q u ∈ evenPin (negativeForm Q) := by
  have hle : pin (-Q) ≤
      (pin (negativeForm Q)).comap
        ((evenUnits (negativeForm Q)).comp (negativeUnits Q)) := by
    change Subgroup.closure (normalizedVectorUnitSet (-Q)) ≤ _
    apply (Subgroup.closure_le _).mpr
    intro v hv
    exact negativeUnits_generator_mem Q v hv
  exact hle hu

/-- The actual restriction of the positive suspension to the generated groups. -/
def positivePinHom : pin Q →* evenPin (positiveForm Q) where
  toFun g := ⟨positiveUnits Q g.val, positiveUnits_mem Q g.val g.property⟩
  map_one' := by
    apply Subtype.ext
    exact (positiveUnits Q).map_one
  map_mul' g h := by
    apply Subtype.ext
    exact (positiveUnits Q).map_mul g.val h.val

/-- The actual restriction of the negative suspension to the generated groups. -/
def negativePinHom : pin (-Q) →* evenPin (negativeForm Q) where
  toFun g := ⟨negativeUnits Q g.val, negativeUnits_mem Q g.val g.property⟩
  map_one' := by
    apply Subtype.ext
    exact (negativeUnits Q).map_one
  map_mul' g h := by
    apply Subtype.ext
    exact (negativeUnits Q).map_mul g.val h.val

theorem positivePinHom_injective : Function.Injective (positivePinHom Q) := by
  intro g h heq
  apply Subtype.ext
  apply Units.map_injective (f := (positiveEquiv Q).toAlgHom.toMonoidHom)
    (positiveEquiv Q).injective
  exact congrArg Subtype.val heq

theorem negativePinHom_injective : Function.Injective (negativePinHom Q) := by
  intro g h heq
  apply Subtype.ext
  apply Units.map_injective (f := (negativeEquiv Q).toAlgHom.toMonoidHom)
    (negativeEquiv Q).injective
  exact congrArg Subtype.val heq

@[simp] theorem positivePinHom_ambient (g : pin Q) :
    (evenPinToUnits (positiveForm Q) (positivePinHom Q g) :
        CliffordAlgebra (positiveForm Q)) =
      positiveMap Q ((g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) :=
  rfl

@[simp] theorem negativePinHom_ambient (g : pin (-Q)) :
    (evenPinToUnits (negativeForm Q) (negativePinHom Q g) :
        CliffordAlgebra (negativeForm Q)) =
      negativeMap Q ((g : (CliffordAlgebra (-Q))ˣ) : CliffordAlgebra (-Q)) :=
  rfl

/-- The positive group embedding has Freed's exact ordered vector image. -/
theorem positivePinHom_vector (v : M) (hv : Q v = 1 ∨ Q v = -1) :
    (evenPinToUnits (positiveForm Q) (positivePinHom Q (pinVector Q v hv)) :
        CliffordAlgebra (positiveForm Q)) =
      ι (positiveForm Q) (v, 0) * ι (positiveForm Q) (0, 1) := by
  rw [positivePinHom_ambient, pinVector_coe, positiveMap_ι]

/-- The negative group embedding has the same order, with source form `-Q`. -/
theorem negativePinHom_vector (v : M) (hv : (-Q) v = 1 ∨ (-Q) v = -1) :
    (evenPinToUnits (negativeForm Q) (negativePinHom Q (pinVector (-Q) v hv)) :
        CliffordAlgebra (negativeForm Q)) =
      ι (negativeForm Q) (v, 0) * ι (negativeForm Q) (0, 1) := by
  rw [negativePinHom_ambient, pinVector_coe, negativeMap_ι]

end InfoGeometry.Clifford.NormalizedVectorPin
