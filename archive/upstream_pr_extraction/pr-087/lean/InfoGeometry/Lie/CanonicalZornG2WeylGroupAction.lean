import InfoGeometry.Lie.CanonicalZornG2CartanConcreteReflectionEquiv

/-!
# The concrete finite G₂ Weyl action on the Cartan and parameter carriers

The native short and long reflections are already proved as involutive linear
equivalences.  This owner forms the subgroup generated by the paired Cartan
and contragredient parameter generators.  It therefore supplies a genuine
Weyl-group action without introducing a free symbolic group or claiming that
the native adjoint root pairing has already been packaged as a Mathlib
`RootPairing`.
-/

noncomputable section

namespace InfoGeometry.Lie.CanonicalZornG2WeylGroupAction

open InfoGeometry.Lie.CanonicalZornG2CartanConcreteReflectionEquiv

abbrev Cartan := CanonicalZornG2CartanConcreteReflectionEquiv.Cartan
abbrev Parameter := CanonicalZornG2CartanConcreteReflectionEquiv.Parameter
abbrev Generator := (Cartan ≃ₗ[ℝ] Cartan) × (Parameter ≃ₗ[ℝ] Parameter)

def shortGenerator : Generator :=
  (canonicalShortReflectionEquiv, canonicalShortParameterDualEquiv)

def longGenerator : Generator :=
  (canonicalLongReflectionEquiv, canonicalLongParameterDualEquiv)

def WeylGroup : Subgroup Generator :=
  Subgroup.closure ({shortGenerator, longGenerator} : Set Generator)

def cartanAction : WeylGroup →* Cartan ≃ₗ[ℝ] Cartan where
  toFun w := w.1.1
  map_one' := rfl
  map_mul' g h := rfl

def parameterTransport : WeylGroup →* Parameter ≃ₗ[ℝ] Parameter where
  toFun w := w.1.2
  map_one' := rfl
  map_mul' g h := rfl

@[simp] theorem cartanAction_apply (w : WeylGroup) :
    cartanAction w = w.1.1 := rfl

@[simp] theorem parameterTransport_apply (w : WeylGroup) :
    parameterTransport w = w.1.2 := rfl

theorem shortGenerator_mem : shortGenerator ∈ WeylGroup := by
  exact Subgroup.subset_closure (by simp [shortGenerator])

theorem longGenerator_mem : longGenerator ∈ WeylGroup := by
  exact Subgroup.subset_closure (by simp [longGenerator])

@[simp] theorem cartanAction_shortGenerator :
    cartanAction ⟨shortGenerator, shortGenerator_mem⟩ =
      canonicalShortReflectionEquiv := rfl

@[simp] theorem cartanAction_longGenerator :
    cartanAction ⟨longGenerator, longGenerator_mem⟩ =
      canonicalLongReflectionEquiv := rfl

@[simp] theorem parameterTransport_shortGenerator :
    parameterTransport ⟨shortGenerator, shortGenerator_mem⟩ =
      canonicalShortParameterDualEquiv := rfl

@[simp] theorem parameterTransport_longGenerator :
    parameterTransport ⟨longGenerator, longGenerator_mem⟩ =
      canonicalLongParameterDualEquiv := rfl

end InfoGeometry.Lie.CanonicalZornG2WeylGroupAction
