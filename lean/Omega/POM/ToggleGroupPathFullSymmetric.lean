import Omega.Combinatorics.FibonacciCube
import Omega.POM.ToggleCoxeterRelationsPath

namespace Omega.POM

/-- The path-toggle group is the subgroup actually generated by the local
toggle operators, rather than the full permutation group of all states. -/
abbrev togglePathGroup (ell : ℕ) : Subgroup (Equiv.Perm (PathIndSets ell)) :=
  pathToggleOperatorClosure ell

/-- Independent path components carry the pointwise product of their actual
local-toggle groups. -/
abbrev toggleGeneralFiberGroup (lengths : List ℕ) :=
  ∀ i : Fin lengths.length, togglePathGroup (lengths.get i)

theorem togglePathGroup_contains_generator (ell : ℕ) (i : Fin ell) :
    pathToggleGenerator ell i ∈ togglePathGroup ell :=
  pathToggleGenerator_mem_closure ell i

theorem pathIndependentState_cardinality (ell : ℕ) :
    Fintype.card (PathIndSets ell) = Nat.fib (ell + 2) :=
  card_pathIndSets ell

end Omega.POM
