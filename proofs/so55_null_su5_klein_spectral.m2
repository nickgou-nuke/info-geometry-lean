R = QQ[m,Eexact,Eadapt,delta];
n5=5;
nullDim=2*n5;
so55Dim=nullDim*(nullDim-1)//2;
matrixDim=n5*n5;
sl5Adj=matrixDim-1;
skew10=n5*(n5-1)//2;
su5Partition=sl5Adj+1+skew10+skew10;
nullBlock=matrixDim+skew10+skew10;
assert(nullDim==10);
assert(so55Dim==45);
assert(sl5Adj==24);
assert(skew10==10);
assert(su5Partition==45);
assert(nullBlock==45);
assert(1+10+5==16);
assert(5+10+1==16);
assert(16+16==32);
tripPoly=d -> d*(d-1)*(d+1);
assert(tripPoly(-1)==0 and tripPoly(0)==0 and tripPoly(1)==0);
assert((7+3)/2 + (7-3)/2 == 7);
assert((7+3)/2 - ((7-3)/2) == 3);
assert((1+2+3+4)/4==5/2);
C1=-m^2;
stiffness=-C1;
assert(stiffness==m^2);
W = QQ[q,dq, WeylAlgebra => {q=>dq}];
I = ideal(q*dq - dq*q - 1);
assert(numgens I == 1);
M = coker matrix{{Eexact*delta - Eexact + Eadapt}};
edges={"decomposes_to","trace_splits_to","skew_splits_B","skew_splits_C","quotients_modes"};
assert(#edges==5);
print {"nullDim",nullDim,"so55Dim",so55Dim,"sl5Adj",sl5Adj,"dilaton",1,"skew10",skew10,"su5Partition",su5Partition,"spinEven16",16,"spinOdd16",16,"kleinAverage",5/2,"dmoduleCCRGenerators",numgens I,"graphEdges",#edges};
