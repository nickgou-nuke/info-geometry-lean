  | .CNS7_sylvesterOperatorMatricesAndPolynomials => 7

theorem cnsRank_injective : Function.Injective cnsRank := by
  intro x y h
  cases x <;> cases y <;> cases h <;> rfl

instance instPartialOrderCyclotomicNilpotentSylvesterArchetype :
    PartialOrder CyclotomicNilpotentSylvesterArchetype :=
