{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive_metadata.schema.json",
  "title": "HiveCognitiveMetadata",
  "type": "object",
  "properties": {
    "epistemic_layer": {
      "type": "string",
      "enum": [
        "raw_source",
        "citation",
        "common_unconscious",
        "cognitive_process",
        "semantic",
        "lean_topology",
        "packet_lineage",
        "authority"
      ]
    },
    "authority_origin": {
      "type": "string",
      "enum": [
        "source_observation",
        "symbolic_navigation",
        "socratic_interrogation",
        "pauli_differentiation",
        "semantic_navigation",
        "topology_navigation",
        "typed_packet_state",
        "gate_record",
        "lean_wrapper",
        "build_gate",
        "audit_gate",
        "promotion_gate"
      ]
    },
    "cognitive_function": {
      "type": "string",
      "enum": [
        "sensation",
        "intuition",
        "thinking",
        "feeling"
      ]
    },
    "jung_function": {
      "type": "string",
      "enum": [
        "sensation",
        "intuition",
        "thinking",
        "feeling"
      ]
    },
    "jung_attitude": {
      "type": "string",
      "enum": [
        "introverted",
        "extraverted",
        "mixed",
        "unknown"
      ]
    },
    "psyche_layer": {
      "type": "string",
      "enum": [
        "persona",
        "ego_focus",
        "conscious",
        "personal_unconscious",
        "common_unconscious",
        "collective_unconscious",
        "shadow",
        "self_oriented",
        "unknown"
      ]
    },
    "jung_depth": {
      "type": "string",
      "enum": [
        "ego_conscious",
        "personal_unconscious",
        "collective_unconscious",
        "common_unconscious",
        "shadow",
        "self_oriented",
        "unknown"
      ]
    },
    "jung_dynamic": {
      "type": "string",
      "enum": [
        "compensation",
        "projection",
        "differentiation",
        "assimilation",
        "integration",
        "inflation_risk",
        "unknown"
      ]
    },
    "symbolic_stage": {
      "type": "string",
      "enum": [
        "nigredo",
        "albedo",
        "citrinitas",
        "rubedo"
      ]
    },
    "pauli_status": {
      "type": "string",
      "enum": [
        "unaudited",
        "critiqued",
        "blocked",
        "passed",
        "quarantined"
      ]
    },
    "promotion_state": {
      "type": "string",
      "enum": [
        "none",
        "candidate",
        "blocked",
        "held",
        "promoted",
        "quarantined"
      ]
    },
    "active_imagination": {
      "type": "boolean"
    },
    "complex_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "archetype_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shadow_status": {
      "type": "string",
      "enum": [
        "none",
        "suspected",
        "confirmed",
        "integrated",
        "quarantined"
      ]
    },
    "transcendent_function_state": {
      "type": "string",
      "enum": [
        "none",
        "opposition_detected",
        "synthesis_attempted",
        "invariant_extracted"
      ]
    },
    "individuation_state": {
      "type": "string",
      "enum": [
        "unintegrated",
        "cultivating",
        "in_cultivation",
        "packetized",
        "formally_tested",
        "integrated",
        "returned_to_residue"
      ]
    },
    "allowed_uses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_uses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
