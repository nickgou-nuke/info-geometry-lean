import InfoGeometry.OperatorAlgebra.SpectralTriple
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.OperatorAlgebra.RealCommutantClosure

/-!
# Finite real spectral-triple Clifford generators

This is the theorem-safe algebraic layer suggested by
Dąbrowski--D'Andrea--Sitarz.  The associated Clifford algebra is generated by
represented algebra elements and Dirac one-forms `[D, ρ(a)]`.  The existing
`PhaseRealSpectralTriple` already carries the order-zero and order-one
conditions; this owner exposes their direct commutant consequences for those
generators.  Equality of the full generated commutant with a Morita copy is a
separate finite-dimensional Hodge-property theorem.
-/

noncomputable section

namespace InfoGeometry.OperatorAlgebra.FiniteRealSpectralTripleHodge

open InfoGeometry.OperatorAlgebra.SpectralTriple

variable {A H : Type*} [Ring A] [Star A]
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H]

def diracOneForm
    (T : PhaseRealSpectralTriple A H) (a : A) : EndR H :=
  commutator T.spectralGenerator.D
    (T.representedAlgebra.rep a)

def cliffordGeneratorSet
    (T : PhaseRealSpectralTriple A H) : Set (EndR H) :=
  Set.range T.representedAlgebra.rep ∪ Set.range (diracOneForm T)

def oppositeCliffordGenerator
    (T : PhaseRealSpectralTriple A H) (b : A) : EndR H :=
  oppositeRep T.representedAlgebra T.realStructure b

theorem represented_generator_commutes_with_opposite
    (T : PhaseRealSpectralTriple A H) (a b : A) :
    (T.representedAlgebra.rep a).comp
        (oppositeCliffordGenerator T b) =
      (oppositeCliffordGenerator T b).comp
        (T.representedAlgebra.rep a) := by
  exact T.orderZero a b

theorem dirac_one_form_commutes_with_opposite
    (T : PhaseRealSpectralTriple A H) (a b : A) :
    (diracOneForm T a).comp (oppositeCliffordGenerator T b) =
      (oppositeCliffordGenerator T b).comp (diracOneForm T a) := by
  exact T.orderOne a b

theorem opposite_clifford_generator_commutes_with_mem
    (T : PhaseRealSpectralTriple A H) (b : A) :
    ∀ x, x ∈ cliffordGeneratorSet T →
      x.comp (oppositeCliffordGenerator T b) =
        (oppositeCliffordGenerator T b).comp x := by
  intro x hx
  rcases hx with ⟨a, rfl⟩ | ⟨a, rfl⟩
  · exact represented_generator_commutes_with_opposite T a b
  · exact dirac_one_form_commutes_with_opposite T a b

/-! The previous pointwise theorem packages the order-zero/order-one laws into
the actual finite real-operator commutant predicate.  This is an inclusion of
the represented Clifford generators; it deliberately does not assert the
stronger Hodge/Morita equality for the generated algebra. -/
theorem opposite_clifford_generator_mem_realCommutant
    (T : PhaseRealSpectralTriple A H) (b : A) :
    oppositeCliffordGenerator T b ∈
      RealCommutantClosure.realCommutant (cliffordGeneratorSet T) := by
  intro x hx
  exact (opposite_clifford_generator_commutes_with_mem T b x hx).symm

end InfoGeometry.OperatorAlgebra.FiniteRealSpectralTripleHodge
