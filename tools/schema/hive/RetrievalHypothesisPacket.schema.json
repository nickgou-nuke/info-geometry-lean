{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RetrievalHypothesisPacket.schema.json",
  "title": "RetrievalHypothesisPacket",
  "allOf": [
    {
      "$ref": "common_envelope.schema.json"
    },
    {
      "$ref": "authority.schema.json"
    },
    {
      "$ref": "representation.schema.json"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "status",
        "packet_version",
        "packet_hash",
        "query_text",
        "seed_refs",
        "candidate_anchor_refs",
        "graph_mode",
        "retrieval_summary"
      ],
      "properties": {
        "kind": {
          "const": "RetrievalHypothesisPacket"
        },
        "status": {
          "enum": [
            "draft",
            "legalized",
            "probe_ready",
            "gated",
            "executed",
            "accepted",
            "rejected",
            "deferred"
          ]
        },
        "authority": {
          "const": "navigation"
        },
        "packet_version": {
          "type": "string",
          "minLength": 1
        },
        "packet_hash": {
          "type": "string",
          "minLength": 1
        },
        "query_text": {
          "type": "string",
          "minLength": 1
        },
        "seed_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "source_ref.schema.json"
          }
        },
        "candidate_anchor_refs": {
          "type": "array",
          "items": {
            "$ref": "source_ref.schema.json"
          }
        },
        "graph_mode": {
          "type": "string",
          "enum": [
            "retrieval_projection",
            "scc_overlay",
            "raw_descent",
            "mixed"
          ]
        },
        "retrieval_summary": {
          "type": "string",
          "minLength": 1
        },
        "promotion_allowed": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  ]
}
