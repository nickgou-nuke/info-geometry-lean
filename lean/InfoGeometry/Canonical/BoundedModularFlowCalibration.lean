import InfoGeometry.Canonical.SouriauModularHamiltonianBridge
import InfoGeometry.OperatorAlgebra.OperatorThermodynamics
import InfoGeometry.Meta.Architecture

open scoped InnerProductSpace

/-!
# InfoGeometry.Canonical.BoundedModularFlowCalibration

Witness-gated bounded modular-flow calibration.

This file does not construct Tomita--Takesaki modular flow, does not prove a
KMS theorem, and does not identify a bounded operator with an unbounded
Type-III modular logarithm.  It records the finite/bounded calibration layer:

`K_sur` generates a supplied one-parameter bounded flow, and the Souriau bare
operator `K̂_β` is the same calibrated generator.  KMS compatibility is carried
by the repository's analytic strip/boundary certificate for that exact flow.
-/

namespace InfoGeometry.Canonical.BoundedModularFlowCalibration

open InfoGeometry.Canonical
open InfoGeometry.Canonical.SouriauModularHamiltonianBridge
open InfoGeometry.OperatorAlgebra.Thermodynamics

section Core

variable {E : Type*}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {LieAlgebra : Type*}

local notation "EndH" => E →L[ℝ] E

noncomputable local instance boundedModularFlowNormedRing : NormedRing EndH :=
  inferInstance
noncomputable local instance boundedModularFlowNormedAlgebra : NormedAlgebra ℝ EndH :=
  inferInstance
noncomputable local instance boundedModularFlowNormedAlgebraRat : NormedAlgebra ℚ EndH :=
  NormedAlgebra.restrictScalars ℚ ℝ EndH
local instance boundedModularFlowTopologicalRing : IsTopologicalRing EndH :=
  inferInstance
local instance boundedModularFlowSMulCommClass : SMulCommClass ℝ EndH EndH :=
  inferInstance
local instance boundedModularFlowIsScalarTower : IsScalarTower ℝ EndH EndH :=
  inferInstance

/--
Bounded modular-flow calibration for the Souriau/Drazin surrogate.

The one-parameter flow and KMS-like law are supplied externally.  The structure
only records that the bounded generator is the calibrated Drazin/MP surrogate
`K_sur`, equivalently the Souriau bare source `K̂_β`.
-/
@[rep_depth operator]
structure Calibration where
  /-- Souriau calibration of the bounded Drazin/supercharge surrogate. -/
  souriau :
    InfoGeometry.Canonical.SouriauModularHamiltonianBridge.Bridge
      (E := E) (LieAlgebra := LieAlgebra)

  /-- Supplied bounded one-parameter flow. -/
  flow : ℝ → EndH

  /--
  Ring-level observable modular flow.

  This is the algebraic automorphism surface used for regular-support
  commutant stability.  It is deliberately separate from `flow : ℝ → EndH`,
  which is only the bounded one-parameter implementing family.
  -/
  modularFlow : ModularFlow EndH

  /--
  Calibration of the observable modular flow by the bounded adjoint action.
  Concrete models may replace this witness by a stronger functional-calculus
  construction.
  -/
  modularFlow_eq_bounded_adjoint :
    ∀ t : ℝ, ∀ A : EndH,
      modularFlow.flow t A = flow t * A * flow (-t)

  /-- Flow is normalized at zero. -/
  flow_zero : flow 0 = (1 : EndH)

  /-- Supplied additive/group law for the bounded flow. -/
  flow_add : ∀ s t : ℝ, flow (s + t) = flow s * flow t

  /-- Calibration: the bounded flow is generated by the Drazin/MP surrogate. -/
  flow_eq_exp_Ksur :
    ∀ t : ℝ, flow t = NormedSpace.exp (t • souriau.superBridge.Ksur)

  /-- Inverse temperature of the calibrated KMS state. -/
  beta : ℝ

  /-- State functional on the noncommutative bounded-operator algebra. -/
  state : StateFunctional EndH

  /--
  Analytic KMS strip and boundary certificate for the calibrated observable
  modular flow.
  -/
  kmsLikeCompatibility :
    KMSAnalyticCertificate modularFlow.toFlowDatum beta state


namespace Calibration

variable (C : Calibration (E := E) (LieAlgebra := LieAlgebra))

/-- The calibrated flow satisfies its installed analytic KMS boundary law. -/
@[rep_depth operator]
theorem kmsLikeCompatibility_holds :
    C.kmsLikeCompatibility.boundaryCondition :=
  C.kmsLikeCompatibility.boundaryCondition_holds

/-- The same bounded flow is generated by the Souriau bare source `K̂_β`. -/
@[rep_depth operator]
theorem flow_eq_exp_Khat_beta (t : ℝ) :
    C.flow t = NormedSpace.exp (t • C.souriau.family.Khat_beta) := by
  rw [C.flow_eq_exp_Ksur t, C.souriau.Khat_beta_eq_Ksur]

/-- Spectral projector used by the Drazin regular sector. -/
@[rep_depth operator]
abbrev spectralProjector : EndH :=
  C.souriau.superBridge.CIK.spectralProjector

/--
External predicate: the bounded surrogate modular flow fixes the Drazin
regular projector.
-/
@[rep_depth operator]
def FlowFixesSpectralProjector : Prop :=
  ∀ t : ℝ, C.modularFlow.flow t C.spectralProjector = C.spectralProjector

/--
If the ring-level modular flow fixes `P_D`, then commutation with `P_D` is
preserved by the flow.
-/
@[rep_depth operator]
theorem modularFlow_preserves_commuting_with_spectralProjector
    (hFix : C.FlowFixesSpectralProjector)
    (A : EndH)
    (hComm : C.spectralProjector * A = A * C.spectralProjector)
    (t : ℝ) :
    C.spectralProjector * C.modularFlow.flow t A =
      C.modularFlow.flow t A * C.spectralProjector := by
  let σ := C.modularFlow.flow t
  calc
    C.spectralProjector * σ A
        = σ C.spectralProjector * σ A := by
            rw [hFix t]
    _ = σ (C.spectralProjector * A) := by
            rw [map_mul]
    _ = σ (A * C.spectralProjector) := by
            rw [hComm]
    _ = σ A * σ C.spectralProjector := by
            rw [map_mul]
    _ = σ A * C.spectralProjector := by
            rw [hFix t]

/--
External predicate: the observable modular flow is compatible with the Souriau
scalar/operator scaling API.
-/
@[rep_depth operator]
def FlowCommutesWithOpScale : Prop :=
  ∀ (t : ℝ) (r : ℝ) (A : EndH),
    C.modularFlow.flow t (C.souriau.family.opScale r A) =
      C.souriau.family.opScale r (C.modularFlow.flow t A)

/--
The Massieu/partition-potential operator shift commutes through the bounded
observable modular flow, provided the flow is compatible with Souriau
`opScale`.
-/
@[rep_depth operator]
theorem partition_potential_modularFlow_central
    (hScale : C.FlowCommutesWithOpScale)
    (t : ℝ) (A : EndH) :
    C.modularFlow.flow t
        (C.souriau.family.opScale C.souriau.family.partitionPotential A) =
      C.souriau.family.opScale C.souriau.family.partitionPotential
        (C.modularFlow.flow t A) :=
  hScale t C.souriau.family.partitionPotential A

/--
The normalized Souriau modular Hamiltonian remains the bounded surrogate plus
the Massieu/free-energy scalar identity term.
-/
@[rep_depth operator]
theorem modularHamiltonian_eq_Ksur_add_partitionPotential_one :
    C.souriau.family.modularHamiltonian =
      C.souriau.superBridge.Ksur + C.souriau.family.partitionPotential • (1 : EndH) :=
  C.souriau.modularHamiltonian_eq_Ksur_add_partitionPotential_one

/-- The bounded flow generator is left-supported on the Drazin regular sector. -/
@[rep_depth operator]
theorem spectralProjector_mul_generator :
    C.souriau.superBridge.CIK.spectralProjector * C.souriau.family.Khat_beta =
      C.souriau.family.Khat_beta :=
  C.souriau.spectralProjector_mul_Khat_beta

/-- The bounded flow generator is right-supported on the Drazin regular sector. -/
@[rep_depth operator]
theorem generator_mul_spectralProjector :
    C.souriau.family.Khat_beta * C.souriau.superBridge.CIK.spectralProjector =
      C.souriau.family.Khat_beta :=
  C.souriau.Khat_beta_mul_spectralProjector

/-- The Drazin defect sector annihilates the bounded flow generator on the left. -/
@[rep_depth operator]
theorem spectralComplementaryProjector_mul_generator_eq_zero :
    C.souriau.superBridge.CIK.spectralComplementaryProjector * C.souriau.family.Khat_beta =
      0 :=
  C.souriau.spectralComplementaryProjector_mul_Khat_beta_eq_zero

/-- The Drazin defect sector annihilates the bounded flow generator on the right. -/
@[rep_depth operator]
theorem generator_mul_spectralComplementaryProjector_eq_zero :
    C.souriau.family.Khat_beta * C.souriau.superBridge.CIK.spectralComplementaryProjector =
      0 :=
  C.souriau.Khat_beta_mul_spectralComplementaryProjector_eq_zero

/-- The bounded flow generator is even for the Drazin spectral grading. -/
@[rep_depth operator]
theorem generator_commutes_GammaS :
    C.souriau.family.Khat_beta * C.souriau.superBridge.CIK.GammaS =
      C.souriau.superBridge.CIK.GammaS * C.souriau.family.Khat_beta :=
  C.souriau.Khat_beta_commutes_GammaS

end Calibration

end Core

end InfoGeometry.Canonical.BoundedModularFlowCalibration
