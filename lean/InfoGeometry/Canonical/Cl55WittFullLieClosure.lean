import InfoGeometry.Canonical.Cl55WittFiveGradeDecomposition
import InfoGeometry.Canonical.Cl55WittLieSubalgebra

/-!
# Full Lie closure of the five-mode Witt grading

The repository already proves every generator-level routing relation among

```
g_{-2}, g_{-1}, g_0, g_{+1}, g_{+2}.
```

This file performs the missing span induction.  It packages their internal sum
as a native Mathlib `LieSubalgebra` and proves that it is exactly the Lie
subalgebra generated by the five creation and five annihilation operators.

The result is an associative-matrix Lie algebra.  No real-form name is inferred
from the closure theorem alone.
-/

noncomputable section
set_option autoImplicit false

namespace InfoGeometry.Canonical.Cl55WittFullLieClosure

open InfoGeometry.Clifford.Cl11TensorTower
open InfoGeometry.Canonical.Cl55WittCAR
open InfoGeometry.Canonical.Cl55WittLieRouting

/-- The five homogeneous lanes. -/
inductive WittLane
  | negTwo
  | negOne
  | zero
  | posOne
  | posTwo
  deriving DecidableEq, Fintype

/-- Integer degree of a lane. -/
def WittLane.degree : WittLane → ℤ
  | .negTwo => -2
  | .negOne => -1
  | .zero => 0
  | .posOne => 1
  | .posTwo => 2

/-- The existing concrete submodule carried by each lane. -/
def laneSpace : WittLane → Submodule ℝ (MatStage 5)
  | .negTwo => wittNegTwo
  | .negOne => wittNegOne
  | .zero => wittZero
  | .posOne => wittPosOne
  | .posTwo => wittPosTwo

/-- Union of all homogeneous lane carriers. -/
def wittLaneSet : Set (MatStage 5) :=
  {X | ∃ lane, X ∈ laneSpace lane}

/-- Linear span of the five lanes. -/
def wittFiveGradeSpan : Submodule ℝ (MatStage 5) :=
  Submodule.span ℝ wittLaneSet

/-- Every named lane lies in the combined span. -/
theorem laneSpace_le_span (lane : WittLane) :
    laneSpace lane ≤ wittFiveGradeSpan := by
  intro X hX
  exact Submodule.subset_span ⟨lane, hX⟩

/-- Every named lane lies in the repository's nested-sup five-grade carrier. -/
theorem laneSpace_le_wittFiveGrade (lane : WittLane) :
    laneSpace lane ≤ wittFiveGrade := by
  cases lane with
  | negTwo =>
      dsimp [laneSpace]
      unfold wittFiveGrade
      calc
        wittNegTwo ≤ wittNegTwo ⊔ wittNegOne := le_sup_left
        _ ≤ (wittNegTwo ⊔ wittNegOne) ⊔ wittZero := le_sup_left
        _ ≤ ((wittNegTwo ⊔ wittNegOne) ⊔ wittZero) ⊔ wittPosOne := le_sup_left
        _ ≤ (((wittNegTwo ⊔ wittNegOne) ⊔ wittZero) ⊔ wittPosOne) ⊔
            wittPosTwo := le_sup_left
  | negOne =>
      dsimp [laneSpace]
      unfold wittFiveGrade
      calc
        wittNegOne ≤ wittNegTwo ⊔ wittNegOne := le_sup_right
        _ ≤ (wittNegTwo ⊔ wittNegOne) ⊔ wittZero := le_sup_left
        _ ≤ ((wittNegTwo ⊔ wittNegOne) ⊔ wittZero) ⊔ wittPosOne := le_sup_left
        _ ≤ (((wittNegTwo ⊔ wittNegOne) ⊔ wittZero) ⊔ wittPosOne) ⊔
            wittPosTwo := le_sup_left
  | zero =>
      dsimp [laneSpace]
      unfold wittFiveGrade
      calc
        wittZero ≤ (wittNegTwo ⊔ wittNegOne) ⊔ wittZero := le_sup_right
        _ ≤ ((wittNegTwo ⊔ wittNegOne) ⊔ wittZero) ⊔ wittPosOne := le_sup_left
        _ ≤ (((wittNegTwo ⊔ wittNegOne) ⊔ wittZero) ⊔ wittPosOne) ⊔
            wittPosTwo := le_sup_left
  | posOne =>
      dsimp [laneSpace]
      unfold wittFiveGrade
      calc
        wittPosOne ≤ ((wittNegTwo ⊔ wittNegOne) ⊔ wittZero) ⊔
            wittPosOne := le_sup_right
        _ ≤ (((wittNegTwo ⊔ wittNegOne) ⊔ wittZero) ⊔ wittPosOne) ⊔
            wittPosTwo := le_sup_left
  | posTwo =>
      dsimp [laneSpace]
      unfold wittFiveGrade
      exact le_sup_right

/-- The span presentation and the existing nested-sup presentation coincide. -/
theorem wittFiveGradeSpan_eq_wittFiveGrade :
    wittFiveGradeSpan = wittFiveGrade := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    intro X hX
    rcases hX with ⟨lane, hLane⟩
    exact laneSpace_le_wittFiveGrade lane hLane
  · unfold wittFiveGrade
    apply sup_le
    · apply sup_le
      · apply sup_le
        · apply sup_le
          · exact laneSpace_le_span .negTwo
          · exact laneSpace_le_span .negOne
        · exact laneSpace_le_span .zero
      · exact laneSpace_le_span .posOne
    · exact laneSpace_le_span .posTwo

/-- Every bracket of homogeneous lane elements lies in the five-lane span. -/
theorem lane_bracket_mem_span
    {X Y : MatStage 5} {lane₁ lane₂ : WittLane}
    (hX : X ∈ laneSpace lane₁) (hY : Y ∈ laneSpace lane₂) :
    bracket X Y ∈ wittFiveGradeSpan := by
  have hn2 : wittNegTwo ≤ wittFiveGradeSpan := laneSpace_le_span .negTwo
  have hn1 : wittNegOne ≤ wittFiveGradeSpan := laneSpace_le_span .negOne
  have hz : wittZero ≤ wittFiveGradeSpan := laneSpace_le_span .zero
  have hp1 : wittPosOne ≤ wittFiveGradeSpan := laneSpace_le_span .posOne
  have hp2 : wittPosTwo ≤ wittFiveGradeSpan := laneSpace_le_span .posTwo
  rcases lane₁ with (_ | _ | _ | _ | _) <;>
    rcases lane₂ with (_ | _ | _ | _ | _) <;>
    simp only [laneSpace] at hX hY
  · rw [wittNegTwo_bracket_eq_zero_quadratic hX hY]
    exact wittFiveGradeSpan.zero_mem
  · rw [wittNegTwo_bracket_eq_zero hX hY]
    exact wittFiveGradeSpan.zero_mem
  · exact hn2 (wittNegTwo_bracket_mem_wittNegTwo hX hY)
  · exact hn1 (wittNegTwo_bracket_mem_wittNegOne hX hY)
  · exact hz (wittNegTwo_bracket_mem_wittZero hX hY)
  · rw [wittNegOne_bracket_wittNegTwo_eq_zero hX hY]
    exact wittFiveGradeSpan.zero_mem
  · exact hn2 (wittNegOne_bracket_mem_wittNegTwo hX hY)
  · rw [bracket_swap]
    exact wittFiveGradeSpan.neg_mem
      (hn1 (wittZero_bracket_mem_wittNegOne hY hX))
  · exact hz (wittNegOne_bracket_mem_wittZero hX hY)
  · exact hp1 (wittNegOne_bracket_mem_wittPosOne hX hY)
  · exact hn2 (wittZero_bracket_mem_wittNegTwo hX hY)
  · exact hn1 (wittZero_bracket_mem_wittNegOne hX hY)
  · exact hz (wittZero_bracket_mem_wittZero hX hY)
  · exact hp1 (wittZero_bracket_mem_wittPosOne hX hY)
  · exact hp2 (wittZero_bracket_mem_wittPosTwo hX hY)
  · exact hn1 (wittPosOne_bracket_mem_wittNegOne hX hY)
  · exact hz (wittPosOne_bracket_mem_wittZero hX hY)
  · rw [bracket_swap]
    exact wittFiveGradeSpan.neg_mem
      (hp1 (wittZero_bracket_mem_wittPosOne hY hX))
  · exact hp2 (wittPosOne_bracket_mem_wittPosTwo hX hY)
  · rw [wittPosOne_bracket_wittPosTwo_eq_zero hX hY]
    exact wittFiveGradeSpan.zero_mem
  · exact hz (wittPosTwo_bracket_mem_wittZero hX hY)
  · exact hp1 (wittPosTwo_bracket_mem_wittPosOne hX hY)
  · exact hp2 (wittPosTwo_bracket_mem_wittPosTwo hX hY)
  · rw [wittPosTwo_bracket_eq_zero hX hY]
    exact wittFiveGradeSpan.zero_mem
  · rw [wittPosTwo_bracket_eq_zero_quadratic hX hY]
    exact wittFiveGradeSpan.zero_mem

/-- Span induction upgrades the homogeneous routing table to arbitrary
five-grade elements. -/
theorem wittFiveGradeSpan_bracket_mem
    {X Y : MatStage 5}
    (hX : X ∈ wittFiveGradeSpan) (hY : Y ∈ wittFiveGradeSpan) :
    bracket X Y ∈ wittFiveGradeSpan := by
  refine Submodule.span_induction
    (p := fun X _ => bracket X Y ∈ wittFiveGradeSpan)
    ?_ ?_ ?_ ?_ hX
  · intro x hx
    change ∃ lane, x ∈ laneSpace lane at hx
    rcases hx with ⟨lane₁, hx₁⟩
    refine Submodule.span_induction
      (p := fun Y _ => bracket x Y ∈ wittFiveGradeSpan)
      ?_ ?_ ?_ ?_ hY
    · intro y hy
      change ∃ lane, y ∈ laneSpace lane at hy
      rcases hy with ⟨lane₂, hy₂⟩
      exact lane_bracket_mem_span hx₁ hy₂
    · simp [bracket]
    · intro y₁ y₂ _ _ hy₁ hy₂
      rw [bracket_add_right]
      exact wittFiveGradeSpan.add_mem hy₁ hy₂
    · intro c y _ hy
      rw [bracket_smul_right]
      exact wittFiveGradeSpan.smul_mem c hy
  · simp [bracket]
  · intro x₁ x₂ _ _ hx₁ hx₂
    rw [bracket_add_left]
    exact wittFiveGradeSpan.add_mem hx₁ hx₂
  · intro c x _ hx
    rw [bracket_smul_left]
    exact wittFiveGradeSpan.smul_mem c hx

/-- The full five-grade span as a native Lie subalgebra of the associative
stage-five matrix algebra. -/
def wittFiveGradeLieSubalgebra : LieSubalgebra ℝ (MatStage 5) :=
  { wittFiveGradeSpan with
    lie_mem' := by
      intro X Y hX hY
      change bracket X Y ∈ wittFiveGradeSpan
      exact wittFiveGradeSpan_bracket_mem hX hY }

@[simp] theorem wittFiveGradeLieSubalgebra_toSubmodule :
    (wittFiveGradeLieSubalgebra : Submodule ℝ (MatStage 5)) =
      wittFiveGrade := by
  exact wittFiveGradeSpan_eq_wittFiveGrade

/-- The internal five-grade algebra is exactly the Lie algebra generated by
all five Witt creation and annihilation operators. -/
theorem wittFiveGradeLieSubalgebra_eq_generatorLieSpan :
    wittFiveGradeLieSubalgebra = wittGeneratorLieSpan := by
  apply le_antisymm
  · intro X hX
    apply wittFiveGrade_le_wittGeneratorLieSpan
    have hSpan : X ∈ wittFiveGradeSpan := hX
    rw [wittFiveGradeSpan_eq_wittFiveGrade] at hSpan
    exact hSpan
  · unfold wittGeneratorLieSpan
    rw [LieSubalgebra.lieSpan_le]
    intro X hX
    change X ∈ Set.range creation ∪ Set.range annihilation at hX
    rcases hX with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · change creation i ∈ wittFiveGradeSpan
      exact laneSpace_le_span .posOne
        (Submodule.subset_span (Set.mem_range_self i))
    · change annihilation i ∈ wittFiveGradeSpan
      exact laneSpace_le_span .negOne
        (Submodule.subset_span (Set.mem_range_self i))

/-- The previously one-sided inclusion is now an equality of underlying
submodules. -/
theorem generatorLieSpan_toSubmodule_eq_wittFiveGrade :
    (wittGeneratorLieSpan : Submodule ℝ (MatStage 5)) =
      wittFiveGrade := by
  rw [← wittFiveGradeLieSubalgebra_eq_generatorLieSpan]
  exact wittFiveGradeLieSubalgebra_toSubmodule

/-- Final closure packet: native Lie closure, generatedness, and the complete
five-by-five homogeneous routing theorem. -/
theorem cl55_witt_full_lie_closure_packet :
    (∀ {X Y : MatStage 5},
      X ∈ wittFiveGradeLieSubalgebra →
      Y ∈ wittFiveGradeLieSubalgebra →
      bracket X Y ∈ wittFiveGradeLieSubalgebra) ∧
    wittFiveGradeLieSubalgebra = wittGeneratorLieSpan ∧
    (∀ {X Y : MatStage 5} {lane₁ lane₂ : WittLane},
      X ∈ laneSpace lane₁ → Y ∈ laneSpace lane₂ →
        bracket X Y ∈ wittFiveGradeSpan) := by
  exact ⟨fun hX hY => wittFiveGradeSpan_bracket_mem hX hY,
    wittFiveGradeLieSubalgebra_eq_generatorLieSpan,
    fun hX hY => lane_bracket_mem_span hX hY⟩

end InfoGeometry.Canonical.Cl55WittFullLieClosure

