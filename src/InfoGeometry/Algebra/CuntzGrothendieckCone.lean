import Mathlib.GroupTheory.MonoidLocalization.GrothendieckGroup
import Mathlib.Algebra.Order.Monoid.Defs
import Mathlib.Tactic.Abel

/-!
# Cuntz Semigroup Grothendieck Cone and Order-Unit Theory

This module formalizes the pre-ordered Grothendieck group structure arising from
the Cuntz semigroup `W(A)` of a C*-algebra.

Given an ordered commutative additive monoid `(S, +, ≤)` (such as Murray-von Neumann
or Cuntz subequivalence classes of positive elements), the Grothendieck group completion
`GrothendieckAddGroup S` inherits a canonical positive cone:

`grothendieckCone S = { [b] - [a] | ∃ c, a + c ≤ b + c }`

This provides the exact algebraic foundation for the pre-ordered $K_0$-group and
order-unit spaces in noncommutative geometry.
-/

namespace InfoGeometry.Algebra.CuntzGrothendieck

open _root_.Algebra

variable {S : Type*} [AddCommMonoid S]

/-- Equality in the Grothendieck group corresponds to stable equality in the monoid. -/
theorem grothendieck_eq_iff (a b : S) :
    GrothendieckAddGroup.of a = GrothendieckAddGroup.of b ↔ ∃ c : S, a + c = b + c := by
  change AddLocalization.mk a 0 = AddLocalization.mk b 0 ↔ _
  simp only [AddLocalization.mk_eq_mk_iff, AddLocalization.r_iff_exists,
    AddSubmonoid.coe_zero, zero_add, Subtype.exists, AddSubmonoid.mem_top]
  simp [add_comm]

/-- Difference equality in the Grothendieck group characterized algebraically. -/
theorem grothendieck_difference_eq_iff (a b c d : S) :
    GrothendieckAddGroup.of b - GrothendieckAddGroup.of a =
      GrothendieckAddGroup.of d - GrothendieckAddGroup.of c ↔
        ∃ e : S, b + c + e = d + a + e := by
  rw [sub_eq_sub_iff_add_eq_add, ← map_add, ← map_add, grothendieck_eq_iff]

/-- Every element of the Grothendieck group is a formal difference `[b] - [a]`. -/
theorem grothendieck_exists_difference (g : GrothendieckAddGroup S) :
    ∃ a b : S, g = GrothendieckAddGroup.of b - GrothendieckAddGroup.of a := by
  induction g using AddLocalization.ind with
  | H p =>
    refine ⟨p.2, p.1, ?_⟩
    change AddLocalization.mk p.1 p.2 =
      (AddLocalization.mk p.1 0 : GrothendieckAddGroup S) -
        (AddLocalization.mk p.2 0 : GrothendieckAddGroup S)
    rw [GrothendieckAddGroup.mk_sub_mk]
    simp

variable [PartialOrder S] [IsOrderedAddMonoid S]

/-- The positive cone in the Grothendieck group generated by the partial order on `S`. -/
def grothendieckCone : AddSubmonoid (GrothendieckAddGroup S) where
  carrier := {g | ∃ a b : S, a ≤ b ∧ g = GrothendieckAddGroup.of b - GrothendieckAddGroup.of a}
  zero_mem' := ⟨0, 0, le_rfl, by simp⟩
  add_mem' := by
    rintro g h ⟨a, b, hab, rfl⟩ ⟨c, d, hcd, rfl⟩
    exact ⟨a + c, b + d, add_le_add hab hcd, by simp only [map_add]; abel⟩

/-- Membership in the Grothendieck cone is equivalent to stable algebraic domination. -/
theorem grothendieck_mem_cone_iff (a b : S) :
    GrothendieckAddGroup.of b - GrothendieckAddGroup.of a ∈ grothendieckCone ↔
      ∃ c : S, a + c ≤ b + c := by
  constructor
  · rintro ⟨c, d, hcd, heq⟩
    obtain ⟨e, he⟩ := (grothendieck_difference_eq_iff a b c d).mp heq
    refine ⟨c + e, ?_⟩
    calc
      a + (c + e) ≤ a + (d + e) := add_le_add le_rfl (add_le_add hcd le_rfl)
      _ = b + (c + e) := by rw [← add_assoc, add_comm a d, ← he, add_assoc]
  · rintro ⟨c, hc⟩
    refine ⟨a + c, b + c, hc, ?_⟩
    simp only [map_add]
    abel

/-- The canonical embedding of any positive element lies in the Grothendieck cone. -/
lemma grothendieck_of_nonneg (hzero : ∀ a : S, 0 ≤ a) (a : S) :
    GrothendieckAddGroup.of a ∈ (grothendieckCone (S := S)) :=
  ⟨0, a, hzero a, by simp⟩

/-- If `u` is an order unit for `S`, then `[u]` is an order unit for the pre-ordered Grothendieck group. -/
theorem grothendieck_orderUnit (hzero : ∀ a : S, 0 ≤ a)
    (u : S) (hunit : ∀ a : S, ∃ n : ℕ, a ≤ n • u)
    (g : GrothendieckAddGroup S) :
    ∃ n : ℕ, n • GrothendieckAddGroup.of u + g ∈ (grothendieckCone (S := S)) := by
  obtain ⟨a, b, rfl⟩ := grothendieck_exists_difference g
  obtain ⟨n, hn⟩ := hunit a
  refine ⟨n, a, n • u + b, hn.trans (le_add_of_nonneg_right (hzero b)), ?_⟩
  simp only [map_add, map_nsmul]
  abel

end InfoGeometry.Algebra.CuntzGrothendieck
