import Mathlib.CategoryTheory.Endomorphism
import InfoGeometry.Algebra.FiniteSpinAlgebra
import InfoGeometry.Categorical.LogJordanBraidGroup3CategoricalLift

/-!
# InfoGeometry.Categorical.LogJordanCategoricalBraidGroup3Representation

Group-valued categorical braid representation on the tensor cube generated by
the standard rank-two logarithmic Jordan object.

The preceding owners provide:

* the presented group `BraidGroup3` and its universal Artin-pair evaluator;
* the standard Hadjiivanov carrier representation;
* categorical logarithmic morphisms for the two local checked-`R` operators;
* the Artin/Yang--Baxter equality between those morphisms.

This file closes the remaining packaging gap.  It proves that the categorical
generators are isomorphisms, forms an `ArtinPair` in the actual automorphism
group of the logarithmic triple tensor object, and obtains the group
homomorphism

`BraidGroup3 →* Aut (X ⊗ (X ⊗ X))`

from the existing universal property.  No new braid presentation, checked-`R`
datum, or global braided-category instance is introduced.
-/

noncomputable section

namespace InfoGeometry.Categorical.LogJordanCategoricalBraidGroup3Representation

open CategoryTheory
open InfoGeometry.Categorical.LogEndModuleCategory
open InfoGeometry.Categorical.LogNilpotentModuleCategory
open InfoGeometry.Categorical.LogNilpotentModuleCategory.LogNilpotentModule
open InfoGeometry.Categorical.LogNilpotentCrossCheckedR
open InfoGeometry.Categorical.LogNilpotentBraidGroup3Representation
open InfoGeometry.Categorical.LogJordanCheckedRBraidBridge
open InfoGeometry.Categorical.LogJordanBraidGroup3Representation
open InfoGeometry.Categorical.LogJordanBraidGroup3CategoricalLift
open InfoGeometry.Categorical.FibonacciBraidGroup3Representation
open InfoGeometry.Clifford.LogCftMonodromy

/-- The standard logarithmic triple tensor object, retaining its distinguished
finite-nilpotent endomorphism. -/
abbrev StandardTripleObject : LogNilpotentModule ℂ :=
  InfoGeometry.Categorical.LogNilpotentCheckedRAdapter.TripleObj
    standardJordanObject

/-- An invertible linear map underlying a logarithmic endomorphism promotes to
an automorphism in the logarithmic category.  Intertwining for the inverse is
forced by intertwining for the forward map. -/
private def categoricalIsoOfLinearEquiv
    {X : LogNilpotentModule ℂ}
    (f : X ⟶ X)
    (e : X ≃ₗ[ℂ] X)
    (hfe : f.hom = e.toLinearMap) :
    X ≅ X where
  hom := f
  inv :=
    { hom := e.symm.toLinearMap
      comm := by
        apply LinearMap.ext
        intro x
        have hx := LinearMap.congr_fun f.comm (e.symm x)
        rw [hfe] at hx
        have hx' := congrArg e.symm hx
        simpa [LinearMap.comp_apply] using hx'.symm }
  hom_inv_id := by
    apply LogEndModule.Hom.ext
    ext x
    simp [hfe]
  inv_hom_id := by
    apply LogEndModule.Hom.ext
    ext x
    simp [hfe]

/-- First local checked-`R` as an automorphism of the logarithmic triple
object. -/
def standardCategoricalSigmaOneIso :
    Aut StandardTripleObject :=
  categoricalIsoOfLinearEquiv
    standardCategoricalSigmaOne
    (logCheckedR12 standardJordanObject standardJordanObject_sq_zero
      logShearBase)
    (standardCategoricalSigmaOne_hom.trans
      standardHadjiivanov_representation_sigmaOne)

/-- Second local checked-`R` as an automorphism of the logarithmic triple
object. -/
def standardCategoricalSigmaTwoIso :
    Aut StandardTripleObject :=
  categoricalIsoOfLinearEquiv
    standardCategoricalSigmaTwo
    (logCheckedR23 standardJordanObject standardJordanObject_sq_zero
      logShearBase)
    (standardCategoricalSigmaTwo_hom.trans
      standardHadjiivanov_representation_sigmaTwo)

@[simp]
theorem standardCategoricalSigmaOneIso_hom :
    standardCategoricalSigmaOneIso.hom = standardCategoricalSigmaOne :=
  rfl

@[simp]
theorem standardCategoricalSigmaTwoIso_hom :
    standardCategoricalSigmaTwoIso.hom = standardCategoricalSigmaTwo :=
  rfl

/-- The categorical checked-`R` generators form an Artin pair in the genuine
automorphism group of the logarithmic tensor cube. -/
def standardCategoricalBraidGenerators :
    BraidThreeGenerators (Aut StandardTripleObject) where
  sigmaOne := standardCategoricalSigmaOneIso
  sigmaTwo := standardCategoricalSigmaTwoIso
  artin := by
    apply Aut.ext
    change
      standardCategoricalSigmaOne ≫ standardCategoricalSigmaTwo ≫
          standardCategoricalSigmaOne =
        standardCategoricalSigmaTwo ≫ standardCategoricalSigmaOne ≫
          standardCategoricalSigmaTwo
    exact standardCategorical_artin

/-- The presented three-strand braid group acts by automorphisms inside the
finite-nilpotent logarithmic category. -/
def standardCategoricalBraidGroup3Hom :
    BraidGroup3 →* Aut StandardTripleObject :=
  standardCategoricalBraidGenerators.toGroupHom

/-- The first presented generator is exactly the first categorical local
checked-`R` automorphism. -/
@[simp]
theorem standardCategoricalBraidGroup3Hom_sigmaOne :
    standardCategoricalBraidGroup3Hom sigmaOne =
      standardCategoricalSigmaOneIso := by
  exact BraidThreeGenerators.toGroupHom_sigmaOne
    standardCategoricalBraidGenerators

/-- The second presented generator is exactly the second categorical local
checked-`R` automorphism. -/
@[simp]
theorem standardCategoricalBraidGroup3Hom_sigmaTwo :
    standardCategoricalBraidGroup3Hom sigmaTwo =
      standardCategoricalSigmaTwoIso := by
  exact BraidThreeGenerators.toGroupHom_sigmaTwo
    standardCategoricalBraidGenerators

/-- Forgetting the logarithmic structure on the first categorical generator
recovers the first generator of the existing carrier representation. -/
theorem standardCategoricalBraidGroup3Hom_sigmaOne_hom :
    (standardCategoricalBraidGroup3Hom sigmaOne).hom.hom =
      standardHadjiivanovBraidRepresentation sigmaOne := by
  rw [standardCategoricalBraidGroup3Hom_sigmaOne]
  exact standardCategoricalSigmaOne_hom

/-- Forgetting the logarithmic structure on the second categorical generator
recovers the second generator of the existing carrier representation. -/
theorem standardCategoricalBraidGroup3Hom_sigmaTwo_hom :
    (standardCategoricalBraidGroup3Hom sigmaTwo).hom.hom =
      standardHadjiivanovBraidRepresentation sigmaTwo := by
  rw [standardCategoricalBraidGroup3Hom_sigmaTwo]
  exact standardCategoricalSigmaTwo_hom

/-- The categorical representation satisfies the Artin relation as a group
identity, not merely as an equality of underlying linear maps. -/
theorem standardCategoricalBraidGroup3Hom_artin :
    standardCategoricalBraidGroup3Hom sigmaOne *
        standardCategoricalBraidGroup3Hom sigmaTwo *
        standardCategoricalBraidGroup3Hom sigmaOne =
      standardCategoricalBraidGroup3Hom sigmaTwo *
        standardCategoricalBraidGroup3Hom sigmaOne *
        standardCategoricalBraidGroup3Hom sigmaTwo := by
  simpa using standardCategoricalBraidGenerators.artin

end InfoGeometry.Categorical.LogJordanCategoricalBraidGroup3Representation

