import InfoGeometry.Canonical.TomitaTakesaki
import InfoGeometry.Canonical.StateDependentTransport
import InfoGeometry.Quantum.GeometricTensorOperatorLift
import InfoGeometry.Krein.SplitQuadraticSheets
import InfoGeometry.Krein.PolarizedSector

/-!
# Polarized Madelung Bridge

Minimal polarized doubled-amplitude layer between the count/projective modular
profiles and the transported spectral/thermal operator lane.

This file does not introduce a complex wavefunction or Euclidean owner. It keeps

- Hilbert normalization on the doubled real carrier,
- Krein evaluation for observables,
- polarization via the existing split sheets,
- and phase as the orbit of the internal axis `Jε`.
-/

namespace InfoGeometry.Canonical.PolarizedMadelungBridge

open InfoGeometry.Canonical.TomitaTakesaki
open InfoGeometry.Krein
open InfoGeometry.Krein.SplitQuadraticSheets
open InfoGeometry.Krein.PolarizedSector

section Basic

variable {E : Type*}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

noncomputable local instance : NormedRing EndH := inferInstance
noncomputable local instance : NormedAlgebra ℝ EndH := inferInstance
local instance : IsTopologicalRing EndH := inferInstance
local instance : CompleteSpace EndH := inferInstance

/-- Repo-native doubled-carrier expectation: Hilbert normalization, Krein evaluation. -/
noncomputable def kreinExpectation
    (ψ : H₂) (A : EndH) : ℝ :=
  KreinSpace.kreinInner (H := H₂) ψ (A ψ)

/-- A doubled amplitude normalized in the Hilbert sense, not in the Krein sense. -/
structure PolarizedDoubledAmplitude where
  ψ : H₂
  h_norm : ‖ψ‖ = 1

namespace PolarizedDoubledAmplitude

/-- Positive spectral component of a doubled amplitude. -/
noncomputable def ψplus (S : PolarizedDoubledAmplitude (E := E)) : H₂ :=
  spectralPlusProj (E := E) S.ψ

/-- Negative spectral component of a doubled amplitude. -/
noncomputable def ψminus (S : PolarizedDoubledAmplitude (E := E)) : H₂ :=
  spectralMinusProj (E := E) S.ψ

/-- Spectral decomposition into positive and negative sheets. -/
theorem sheet_decomposition (S : PolarizedDoubledAmplitude (E := E)) :
    S.ψplus + S.ψminus = S.ψ := by
  simpa [ψplus, ψminus] using spectralProj_decomposition (E := E) S.ψ

omit [CompleteSpace E] in
/-- The positive spectral component lands in the positive sheet. -/
theorem ψplus_mem_plusSheet (S : PolarizedDoubledAmplitude (E := E)) :
    S.ψplus ∈ plusSheet (E := E) := by
  simpa [ψplus] using spectralPlusProj_mem_plusSheet (E := E) S.ψ

omit [CompleteSpace E] in
/-- The negative spectral component lands in the negative sheet. -/
theorem ψminus_mem_minusSheet (S : PolarizedDoubledAmplitude (E := E)) :
    S.ψminus ∈ minusSheet (E := E) := by
  simpa [ψminus] using spectralMinusProj_mem_minusSheet (E := E) S.ψ

/-- Positive-sheet Hilbert density. -/
noncomputable def positiveDensity (S : PolarizedDoubledAmplitude (E := E)) : ℝ :=
  ‖S.ψplus‖ ^ (2 : ℕ)

/-- Negative-sheet Hilbert density. -/
noncomputable def negativeDensity (S : PolarizedDoubledAmplitude (E := E)) : ℝ :=
  ‖S.ψminus‖ ^ (2 : ℕ)

omit [CompleteSpace E] in
/-- Readback: the positive Madelung/Born density is the Hilbert norm square. -/
@[simp] theorem positiveDensity_eq_norm_sq
    (S : PolarizedDoubledAmplitude (E := E)) :
    S.positiveDensity = ‖S.ψplus‖ ^ (2 : ℕ) :=
  rfl

omit [CompleteSpace E] in
/-- Readback: the negative Madelung/Born density is the Hilbert norm square. -/
@[simp] theorem negativeDensity_eq_norm_sq
    (S : PolarizedDoubledAmplitude (E := E)) :
    S.negativeDensity = ‖S.ψminus‖ ^ (2 : ℕ) :=
  rfl

omit [CompleteSpace E] in
/-- Positive Madelung/Born density is nonnegative. -/
theorem positiveDensity_nonneg
    (S : PolarizedDoubledAmplitude (E := E)) :
    0 ≤ S.positiveDensity := by
  simp [positiveDensity]

omit [CompleteSpace E] in
/-- Negative-sheet Madelung/Born density is nonnegative despite the Krein sign. -/
theorem negativeDensity_nonneg
    (S : PolarizedDoubledAmplitude (E := E)) :
    0 ≤ S.negativeDensity := by
  simp [negativeDensity]

/-- Phase orbit generated by the internal axis `K = Jε`. -/
noncomputable def phaseOrbit
    (S : PolarizedDoubledAmplitude (E := E)) (θ : ℝ) : H₂ :=
  (NormedSpace.exp (θ • modularComplexI (E := E))) S.ψ

omit [CompleteSpace E] in
@[simp] theorem phaseOrbit_zero
    (S : PolarizedDoubledAmplitude (E := E)) :
    S.phaseOrbit 0 = S.ψ := by
  unfold phaseOrbit
  simp

/-- The phase orbit is exactly the orbit of the legacy dilation generator. -/
theorem phaseOrbit_eq_dilationOrbit
    (S : PolarizedDoubledAmplitude (E := E)) (θ : ℝ) :
    S.phaseOrbit θ = (NormedSpace.exp (θ • dilationOperator (E := E))) S.ψ := by
  unfold phaseOrbit
  rw [modularComplexI_eq_dilationOperator]

/-- The phase orbit is exactly the orbit of the owner phase axis `complex_i`. -/
theorem phaseOrbit_eq_complex_iOrbit
    (S : PolarizedDoubledAmplitude (E := E)) (θ : ℝ) :
    S.phaseOrbit θ = (NormedSpace.exp (θ • complex_i (E := E))) S.ψ := by
  unfold phaseOrbit
  rw [modularComplexI_eq_complex_i]

/-- The Madelung phase orbit is the orbit of the native doubled-carrier clock
axis.  This is a carrier-preserving identification; it does not identify the
separate `Fin 2` matrix parabolic-clock carrier with `DoubledSpace E`. -/
omit [CompleteSpace E] in
theorem phaseOrbit_eq_clockAxisOrbit
    (S : PolarizedDoubledAmplitude (E := E)) (θ : ℝ) :
    S.phaseOrbit θ =
      (NormedSpace.exp (θ • InfoGeometry.Krein.clockAxis (E := E))) S.ψ := by
  unfold phaseOrbit
  change
    (NormedSpace.exp (θ • InfoGeometry.Canonical.TomitaTakesaki.clockAxis
      (E := E))) S.ψ =
      (NormedSpace.exp (θ • InfoGeometry.Krein.clockAxis (E := E))) S.ψ
  rfl

/-- Modular conjugation reverses the `Jε` phase orbit. -/
theorem modularConjugationJ_phaseOrbit_eq_reverse
    (S : PolarizedDoubledAmplitude (E := E)) (θ : ℝ) :
    modularConjugationJ (E := E) (S.phaseOrbit θ)
      = (NormedSpace.exp ((-θ) • modularComplexI (E := E)))
          ((modularConjugationJ (E := E)) S.ψ) := by
  unfold phaseOrbit
  simpa [ContinuousLinearMap.mul_apply] using
    congrArg (fun A : H₂ →L[ℝ] H₂ => A S.ψ)
      (modularConjugationJ_exp_modularComplexI_right (E := E) θ)

/-- The owner involution `modular_j` reverses the owner phase-axis orbit. -/
theorem modular_j_phaseOrbit_eq_reverse_complex_i
    (S : PolarizedDoubledAmplitude (E := E)) (θ : ℝ) :
    modular_j (E := E) (S.phaseOrbit θ)
      = (NormedSpace.exp ((-θ) • complex_i (E := E)))
          ((modular_j (E := E)) S.ψ) := by
  simpa [modularConjugationJ_eq_modular_j, modularComplexI_eq_complex_i] using
    modularConjugationJ_phaseOrbit_eq_reverse (E := E) S θ

end PolarizedDoubledAmplitude

/-- Generic isotropic collapse on the doubled carrier. -/
theorem kreinExpectation_smul_id
    (ψ : H₂) (H : ℝ) :
    kreinExpectation (E := E) ψ (H • ContinuousLinearMap.id ℝ H₂)
      = H * KreinSpace.kreinInner (H := H₂) ψ ψ := by
  unfold kreinExpectation
  rw [ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply]
  rw [KreinSpace.kreinInner_smul_right]

omit [InnerProductSpace ℝ E] [CompleteSpace E] in
/-- Hilbert norm square of a positive-sheet point. -/
@[simp] theorem norm_sq_plusPoint (x : E) :
    ‖plusPoint (E := E) x‖ ^ (2 : ℕ) = ‖x‖ ^ (2 : ℕ) := by
  rw [plusPoint, WithLp.prod_norm_sq_eq_of_L2]
  simp

omit [InnerProductSpace ℝ E] [CompleteSpace E] in
/-- Hilbert norm square of a negative-sheet point. -/
@[simp] theorem norm_sq_minusPoint (ξ : E) :
    ‖minusPoint (E := E) ξ‖ ^ (2 : ℕ) = ‖ξ‖ ^ (2 : ℕ) := by
  rw [minusPoint, WithLp.prod_norm_sq_eq_of_L2]
  simp

/-- On the positive sheet, Krein self-pairing agrees with Hilbert norm square. -/
theorem kreinSelf_eq_norm_sq_of_mem_plusSheet
    {ψ : H₂} (hψ : ψ ∈ plusSheet (E := E)) :
    KreinSpace.kreinInner (H := H₂) ψ ψ = ‖ψ‖ ^ (2 : ℕ) := by
  rw [eq_plusPoint_of_mem_plusSheet (E := E) hψ]
  rw [kreinInner_plusPoint]
  rw [real_inner_self_eq_norm_sq]
  simp

/-- On the negative sheet, Krein self-pairing flips the Hilbert norm square. -/
theorem kreinSelf_eq_neg_norm_sq_of_mem_minusSheet
    {ψ : H₂} (hψ : ψ ∈ minusSheet (E := E)) :
    KreinSpace.kreinInner (H := H₂) ψ ψ = -(‖ψ‖ ^ (2 : ℕ)) := by
  rw [eq_minusPoint_of_mem_minusSheet (E := E) hψ]
  rw [kreinInner_minusPoint]
  rw [real_inner_self_eq_norm_sq]
  simp

/-- On the positive sheet, the isotropic doubled-carrier expectation collapses with positive sign. -/
theorem kreinExpectation_smul_id_of_mem_plusSheet
    (ψ : H₂) (hψ : ψ ∈ plusSheet (E := E)) (H : ℝ) :
    kreinExpectation (E := E) ψ (H • ContinuousLinearMap.id ℝ H₂)
      = H * ‖ψ‖ ^ (2 : ℕ) := by
  rw [kreinExpectation_smul_id, kreinSelf_eq_norm_sq_of_mem_plusSheet (E := E) hψ]

/-- On the negative sheet, the isotropic doubled-carrier expectation collapses with negative sign. -/
theorem kreinExpectation_smul_id_of_mem_minusSheet
    (ψ : H₂) (hψ : ψ ∈ minusSheet (E := E)) (H : ℝ) :
    kreinExpectation (E := E) ψ (H • ContinuousLinearMap.id ℝ H₂)
      = -(H * ‖ψ‖ ^ (2 : ℕ)) := by
  rw [kreinExpectation_smul_id, kreinSelf_eq_neg_norm_sq_of_mem_minusSheet (E := E) hψ]
  simp

namespace PolarizedDoubledAmplitude

/--
Positive-sheet Krein self-pairing recovers the positive Madelung/Born density.
-/
theorem kreinSelf_ψplus_eq_positiveDensity
    (S : PolarizedDoubledAmplitude (E := E)) :
    KreinSpace.kreinInner (H := H₂) S.ψplus S.ψplus = S.positiveDensity := by
  rw [InfoGeometry.Canonical.PolarizedMadelungBridge.kreinSelf_eq_norm_sq_of_mem_plusSheet
    (E := E) (S.ψplus_mem_plusSheet)]
  rfl

/--
Negative-sheet Krein self-pairing is the signed version of the negative
Madelung/Born density.  The Born density remains nonnegative; the sign belongs
to the Krein evaluation.
-/
theorem kreinSelf_ψminus_eq_neg_negativeDensity
    (S : PolarizedDoubledAmplitude (E := E)) :
    KreinSpace.kreinInner (H := H₂) S.ψminus S.ψminus = -S.negativeDensity := by
  rw [InfoGeometry.Canonical.PolarizedMadelungBridge.kreinSelf_eq_neg_norm_sq_of_mem_minusSheet
    (E := E) (S.ψminus_mem_minusSheet)]
  rfl

/-- A Hilbert-normalized positive-sheet amplitude collapses exactly to the scalar coefficient. -/
theorem kreinExpectation_smul_id_of_mem_plusSheet
    (S : PolarizedDoubledAmplitude (E := E))
    (hψ : S.ψ ∈ plusSheet (E := E)) (H : ℝ) :
    kreinExpectation (E := E) S.ψ (H • ContinuousLinearMap.id ℝ H₂) = H := by
  rw [InfoGeometry.Canonical.PolarizedMadelungBridge.kreinExpectation_smul_id_of_mem_plusSheet
    (E := E) S.ψ hψ H]
  simp [S.h_norm]

/-- A Hilbert-normalized negative-sheet amplitude collapses exactly to the signed scalar coefficient. -/
theorem kreinExpectation_smul_id_of_mem_minusSheet
    (S : PolarizedDoubledAmplitude (E := E))
    (hψ : S.ψ ∈ minusSheet (E := E)) (H : ℝ) :
    kreinExpectation (E := E) S.ψ (H • ContinuousLinearMap.id ℝ H₂) = -H := by
  rw [InfoGeometry.Canonical.PolarizedMadelungBridge.kreinExpectation_smul_id_of_mem_minusSheet
    (E := E) S.ψ hψ H]
  simp [S.h_norm]

end PolarizedDoubledAmplitude

end Basic

section Sheets

variable {E : Type*}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

/-- On the positive sheet, Krein expectation reduces to the ordinary Hilbert pairing. -/
theorem kreinExpectation_plusPoint
    (x : E)
    (A : EndH)
    (hA : A (plusPoint (E := E) x) ∈ plusSheet (E := E)) :
    kreinExpectation (E := E) (plusPoint (E := E) x) A
      = inner ℝ x (WithLp.fst (A (plusPoint (E := E) x))) := by
  rw [kreinExpectation]
  rw [eq_plusPoint_of_mem_plusSheet (E := E) hA]
  simpa using
    kreinInner_plusPoint (E := E) x (WithLp.fst (A (plusPoint (E := E) x)))

/-- On the negative sheet, Krein expectation flips sign. -/
theorem kreinExpectation_minusPoint
    (ξ : E)
    (A : EndH)
    (hA : A (minusPoint (E := E) ξ) ∈ minusSheet (E := E)) :
    kreinExpectation (E := E) (minusPoint (E := E) ξ) A
      = -inner ℝ ξ (WithLp.snd (A (minusPoint (E := E) ξ))) := by
  rw [kreinExpectation]
  rw [eq_minusPoint_of_mem_minusSheet (E := E) hA]
  simpa using
    kreinInner_minusPoint (E := E) ξ (WithLp.snd (A (minusPoint (E := E) ξ)))

end Sheets

section Operatorial

variable {E : Type*}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

local notation "H₂" => DoubledSpace E
local notation "EndH" => H₂ →L[ℝ] H₂

open InfoGeometry.Canonical.StateDependentTransport

/--
State-dependent generator field on the doubled carrier.
This keeps the generator operatorial and avoids scalar diagonal proxies.
-/
abbrev StateGeneratorField := H₂ → EndH

namespace StateGeneratorField

/-- Compatibility accessor for the native operator-valued field. -/
abbrev generator (G : StateGeneratorField (E := E)) : H₂ → EndH := G

noncomputable def toStateModularDatum
    (G : StateGeneratorField (E := E)) : StateModularDatum E :=
  { modularSeed := G.generator }

noncomputable def stateInducedDerivation
    (G : StateGeneratorField (E := E)) (ψ : H₂) (A : EndH) : EndH :=
  stateInducedDynamics (E := E) (toStateModularDatum (E := E) G) ψ A

noncomputable def stateGaugeDerivation
    (G : StateGeneratorField (E := E)) (ψ : H₂) (A : EndH) : EndH :=
  stateGaugeDynamics (E := E) (toStateModularDatum (E := E) G) ψ A

noncomputable def stateSourceDerivation
    (G : StateGeneratorField (E := E)) (ψ : H₂) (A : EndH) : EndH :=
  stateSourceDynamics (E := E) (toStateModularDatum (E := E) G) ψ A

noncomputable def stateMetricReadout
    (G : StateGeneratorField (E := E)) (ψ : H₂) (A : EndH) :
    LinearMap.BilinForm ℝ H₂ :=
  stateQGTMetricReadout (E := E) (toStateModularDatum (E := E) G) ψ A

noncomputable def statePhaseReadout
    (G : StateGeneratorField (E := E)) (ψ : H₂) (A : EndH) :
    LinearMap.BilinForm ℝ H₂ :=
  stateQGTPhaseReadout (E := E) (toStateModularDatum (E := E) G) ψ A

noncomputable def stateQGTReadout
    (G : StateGeneratorField (E := E)) (ψ : H₂) (A : EndH) :
    StateQGTReadout E :=
  InfoGeometry.Canonical.StateDependentTransport.stateQGTReadout (E := E)
    (toStateModularDatum (E := E) G) ψ A

theorem statePhaseReadout_eq_metric_comp_K
    (G : StateGeneratorField (E := E)) (ψ : H₂) (A : EndH) :
    statePhaseReadout (E := E) G ψ A
      =
    (stateMetricReadout (E := E) G ψ A).compLeft
      (InfoGeometry.Canonical.TomitaTakesaki.modularComplexI (E := E)).toLinearMap := by
  rw [statePhaseReadout, stateMetricReadout]
  simp

theorem statePhaseReadout_eq_metric_comp_complex_i
    (G : StateGeneratorField (E := E)) (ψ : H₂) (A : EndH) :
    statePhaseReadout (E := E) G ψ A
      =
    (stateMetricReadout (E := E) G ψ A).compLeft
      (complex_i (E := E)).toLinearMap := by
  simpa [InfoGeometry.Canonical.TomitaTakesaki.modularComplexI_eq_complex_i] using
    statePhaseReadout_eq_metric_comp_K (E := E) G ψ A

theorem stateInducedDerivation_eq_gauge_add_source
    (G : StateGeneratorField (E := E)) (ψ : H₂) (A : EndH) :
    stateInducedDerivation (E := E) G ψ A
      =
    stateGaugeDerivation (E := E) G ψ A
      +
    stateSourceDerivation (E := E) G ψ A := by
  simpa [stateInducedDerivation, stateGaugeDerivation, stateSourceDerivation] using
    (stateInducedDynamics_eq_gauge_add_source (E := E)
      (toStateModularDatum (E := E) G) ψ A)

end StateGeneratorField

end Operatorial

end InfoGeometry.Canonical.PolarizedMadelungBridge
