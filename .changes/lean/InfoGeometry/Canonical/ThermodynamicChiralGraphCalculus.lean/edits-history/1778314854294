{"file":"/home/goutev/repos/info-geometry-lean/lean/InfoGeometry/Canonical/ThermodynamicChiralGraphCalculus.lean","time":1778314854294,"baseTime":1778314853610,"changes":[{"range":{"start":{"line":162,"character":0},"end":{"line":251,"character":0}},"text":"/-- A vertex gauge/potential used to shift a discrete log-affinity by a coboundary. -/\nstructure GaugeTransform (V : Type) where\n  potential : V → ℝ\n\n/-- Gauge-shifted log-affinity on one directed edge.\n\nThe added term is the vertex coboundary `φ(dst e) - φ(src e)`. -/\ndef gaugeShiftedLogAffinity (γ : GaugeTransform V) (e : E) : ℝ :=\n  G.logAffinity e + γ.potential (G.dst e) - γ.potential (G.src e)\n\n/-- Boundary/coboundary contribution of a vertex gauge around an ordered cycle. -/\ndef gaugeBoundaryTerm (γ : GaugeTransform V) (C : Cycle E) : ℝ :=\n  (C.edges.map (fun e => γ.potential (G.dst e) - γ.potential (G.src e))).sum\n\n/-- Cycle curvature computed from the gauge-shifted log-affinity. -/\ndef gaugeShiftedCycleCurvatureLog (γ : GaugeTransform V) (C : Cycle E) : ℝ :=\n  (C.edges.map (G.gaugeShiftedLogAffinity γ)).sum\n\n/-- A cycle is gauge-closed when every vertex-gauge coboundary telescopes to zero. -/\nstructure CycleGaugeClosed (C : Cycle E) : Prop where\n  boundary_zero : ∀ γ : GaugeTransform V, G.gaugeBoundaryTerm γ C = 0\n\n@[simp] theorem logAffinity_eq (e : E) :\n    G.logAffinity e = Real.log (G.forwardRate e / G.reverseRate e) :=\n  rfl\n\n@[simp] theorem cycleCurvatureLog_eq (C : Cycle E) :\n    G.cycleCurvatureLog C = (C.edges.map G.logAffinity).sum :=\n  rfl\n\n/-! ### Gauge transforms and Wilson-loop curvature invariance -/\n\n/-- Vertex gauge coboundary on an edge.\n\nChanging local vertex potentials by `φ` shifts an additive edge connection by\n`φ(dst e) - φ(src e)`.  This is the graph-theoretic gauge term whose sum around\nclosed cycles vanishes. -/\ndef gaugeCoboundary (φ : V → ℝ) (e : E) : ℝ :=\n  φ (G.dst e) - φ (G.src e)\n\n/-- Gauge-shifted additive log-affinity connection. -/\nnoncomputable def gaugeShiftedLogAffinity (φ : V → ℝ) (e : E) : ℝ :=\n  G.logAffinity e + G.gaugeCoboundary φ e\n\n/-- Gauge-shifted additive cycle curvature. -/\nnoncomputable def gaugeShiftedCycleCurvatureLog (φ : V → ℝ) (C : Cycle E) : ℝ :=\n  (C.edges.map (G.gaugeShiftedLogAffinity φ)).sum\n\n/-- A cycle is gauge-closed when every vertex coboundary telescopes to zero on it.\n\nThis isolates the graph-incidence/closure proof from the thermodynamic readout:\nan owner module may prove this from an explicit closed walk, while this packet\nuses it to recover gauge invariance of cycle curvature. -/\ndef GaugeClosedCycle (C : Cycle E) : Prop :=\n  ∀ φ : V → ℝ, (C.edges.map (G.gaugeCoboundary φ)).sum = 0\n\n@[simp] theorem gaugeCoboundary_eq (φ : V → ℝ) (e : E) :\n    G.gaugeCoboundary φ e = φ (G.dst e) - φ (G.src e) :=\n  rfl\n\n@[simp] theorem gaugeShiftedLogAffinity_eq (φ : V → ℝ) (e : E) :\n    G.gaugeShiftedLogAffinity φ e = G.logAffinity e + G.gaugeCoboundary φ e :=\n  rfl\n\n@[simp] theorem gaugeShiftedCycleCurvatureLog_eq (φ : V → ℝ) (C : Cycle E) :\n    G.gaugeShiftedCycleCurvatureLog φ C =\n      (C.edges.map (G.gaugeShiftedLogAffinity φ)).sum :=\n  rfl\n\n/-- Gauge-shifted curvature splits into physical log-curvature plus the summed\nvertex coboundary. -/\ntheorem gaugeShiftedCycleCurvatureLog_eq_cycleCurvatureLog_add_boundary\n    (φ : V → ℝ) (C : Cycle E) :\n    G.gaugeShiftedCycleCurvatureLog φ C =\n      G.cycleCurvatureLog C + (C.edges.map (G.gaugeCoboundary φ)).sum := by\n  simp only [gaugeShiftedCycleCurvatureLog, cycleCurvatureLog, gaugeShiftedLogAffinity]\n  induction C.edges with\n  | nil => simp\n  | cons e es ih => simp [ih, add_assoc, add_left_comm, add_comm]\n\n/-- Wilson-loop log-curvature is invariant under vertex gauge shifts on a\nclosed cycle.  This is the theorem-safe Lean form of the gauge-theory reading:\nlocal potentials may change the edge connection, but closed-cycle curvature is a\ngauge-invariant observable. -/\ntheorem gaugeShiftedCycleCurvatureLog_eq_cycleCurvatureLog_of_closed\n    (φ : V → ℝ) (C : Cycle E) (hC : G.GaugeClosedCycle C) :\n    G.gaugeShiftedCycleCurvatureLog φ C = G.cycleCurvatureLog C := by\n  rw [G.gaugeShiftedCycleCurvatureLog_eq_cycleCurvatureLog_add_boundary, hC φ, add_zero]\n\n/-- If the log-affinity is a pure vertex coboundary, every gauge-closed cycle\nhas zero additive curvature.  This is the conservative Kolmogorov/Polettini\n`exact connection ⇒ trivial cycle affinity` direction. -/\ntheorem cycleCurvatureLog_eq_zero_of_logAffinity_eq_coboundary\n    (φ : V → ℝ) (C : Cycle E)\n    (hC : G.GaugeClosedCycle C)\n    (hexact : ∀ e ∈ C.edges, G.logAffinity e = G.gaugeCoboundary φ e) :\n    G.cycleCurvatureLog C = 0 := by\n  simp only [cycleCurvatureLog]\n  calc\n    (C.edges.map G.logAffinity).sum = (C.edges.map (G.gaugeCoboundary φ)).sum := by\n      congr 1\n      apply List.map_congr_left\n      intro e he\n      exact hexact e he\n    _ = 0 := hC φ\n\n@[simp] theorem stochasticAffinity_eq (e : E) :\n    G.stochasticAffinity e =\n      Real.log (G.probability (G.src e) * G.forwardRate e /\n        (G.probability (G.dst e) * G.reverseRate e)) :=\n  rfl\n\n@[simp] theorem gaugeShiftedLogAffinity_eq (γ : GaugeTransform V) (e : E) :\n    G.gaugeShiftedLogAffinity γ e =\n      G.logAffinity e + γ.potential (G.dst e) - γ.potential (G.src e) :=\n  rfl\n\n@[simp] theorem gaugeBoundaryTerm_eq (γ : GaugeTransform V) (C : Cycle E) :\n    G.gaugeBoundaryTerm γ C =\n      (C.edges.map (fun e => γ.potential (G.dst e) - γ.potential (G.src e))).sum :=\n  rfl\n\n@[simp] theorem gaugeShiftedCycleCurvatureLog_eq (γ : GaugeTransform V) (C : Cycle E) :\n    G.gaugeShiftedCycleCurvatureLog γ C =\n      (C.edges.map (G.gaugeShiftedLogAffinity γ)).sum :=\n  rfl\n\n/-- Gauge-shifted curvature is original curvature plus the gauge boundary term. -/\ntheorem gaugeShiftedCycleCurvatureLog_eq_add_boundary\n    (γ : GaugeTransform V) (C : Cycle E) :\n    G.gaugeShiftedCycleCurvatureLog γ C =\n      G.cycleCurvatureLog C + G.gaugeBoundaryTerm γ C := by\n  cases C with\n  | mk edges =>\n    induction edges with\n    | nil =>\n        simp [gaugeShiftedCycleCurvatureLog, cycleCurvatureLog, gaugeBoundaryTerm]\n    | cons e es ih =>\n        simp [gaugeShiftedCycleCurvatureLog, cycleCurvatureLog, gaugeBoundaryTerm,\n          gaugeShiftedLogAffinity, ih]\n        ring\n\n/-- Gauge invariance of cycle curvature on gauge-closed cycles. -/\ntheorem cycleCurvatureLog_gauge_invariant\n    (γ : GaugeTransform V) (C : Cycle E) (hC : G.CycleGaugeClosed C) :\n    G.gaugeShiftedCycleCurvatureLog γ C = G.cycleCurvatureLog C := by\n  rw [G.gaugeShiftedCycleCurvatureLog_eq_add_boundary γ C, hC.boundary_zero γ]\n  ring\n","rangeOffset":5806,"rangeLength":3763}]}