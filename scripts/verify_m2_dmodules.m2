W = QQ[x0, x1, x2, y0, y1, y2, dx0, dx1, dx2, dy0, dy1, dy2, 
       WeylAlgebra => {x0=>dx0, x1=>dx1, x2=>dx2, y0=>dy0, y1=>dy1, y2=>dy2}]

-- 1. Nilpotent derivations in the Weyl algebra:
ds = x1 * dx0 + y0 * dy1
dl = x2 * dx1 + y1 * dy2
dm = x2 * dx0 + y0 * dy2

print "ds in Weyl algebra:"
print ds
print "dl in Weyl algebra:"
print dl

-- Commutator [ds, dl] = ds * dl - dl * ds
comm = ds * dl - dl * ds
print "Commutator [ds, dl]:"
print comm
print "dm in Weyl algebra:"
print dm

print "Is [ds, dl] == dm?"
print (comm == dm)

-- Left ideal generated by the nilpotent derivations:
I = ideal(ds, dl, dm)
print "Left ideal I = (ds, dl, dm):"
print I

exit 0
