# tools/python/generate_amplituhedron_bounds.py
import itertools
import subprocess
import os

def count_inversions_and_sort(lst):
    """Computes the sorted list and the sign of the permutation required to sort it."""
    arr = list(lst)
    n = len(arr)
    # Check for duplicates: if present, the Plucker coordinate is 0
    if len(set(arr)) < n:
        return None, 0
    
    inversions = 0
    for i in range(n):
        for j in range(i + 1, n):
            if arr[i] > arr[j]:
                arr[i], arr[j] = arr[j], arr[i]
                inversions += 1
    sign = -1 if inversions % 2 != 0 else 1
    return tuple(arr), sign

def generate_plucker_relations(k, n):
    """Generates the complete set of algebraic Plucker relations for Gr(k,n)."""
    # 1. Generate all coordinate variables of size k
    variables = sorted(list(itertools.combinations(range(1, n + 1), k)))
    var_names = [f"p_{'_'.join(map(str, v))}" for v in variables]
    
    relations = []
    
    # 2. Iterate over all subsets I (size k-1) and J (size k+1)
    for I in itertools.combinations(range(1, n + 1), k - 1):
        for J in itertools.combinations(range(1, n + 1), k + 1):
            terms = []
            for r in range(k + 1):
                j_r = J[r]
                # Construct new index sets
                I_prime = list(I) + [j_r]
                J_prime = [x for x in J if x != j_r]
                
                # Sort and find signs
                sorted_I, sign_I = count_inversions_and_sort(I_prime)
                sorted_J, sign_J = count_inversions_and_sort(J_prime)
                
                if sorted_I is not None and sorted_J is not None:
                    # Overall sign is (-1)^r * sign_I * sign_J
                    overall_sign = ((-1)**r) * sign_I * sign_J
                    var_I = f"p_{'_'.join(map(str, sorted_I))}"
                    var_J = f"p_{'_'.join(map(str, sorted_J))}"
                    terms.append((overall_sign, var_I, var_J))
            
            # Combine terms into a Macaulay2 polynomial string
            if terms:
                poly_parts = []
                for sign, v1, v2 in terms:
                    sign_str = "+" if sign > 0 else "-"
                    poly_parts.append(f"{sign_str} {v1}*{v2}")
                # Join and clean up the sign of the first term
                poly = " ".join(poly_parts).strip()
                if poly.startswith("+"):
                    poly = poly[1:].strip()
                relations.append(poly)
                
    # Remove duplicate or trivial relations
    unique_relations = list(set(relations))
    return var_names, unique_relations

def write_m2_script(var_names, relations, cell_vars, output_path):
    """Tier 1: Writes the executable Macaulay2 script containing the generated ideals."""
    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    
    # Join variables for ring definition
    ring_vars = ", ".join(var_names)
    
    # Join relations for Plucker ideal
    ideal_generators = ",\n  ".join(relations)
    
    # Join cell boundary variables
    cell_generators = ", ".join(cell_vars)
    
    m2_code = f"""-- Auto-Generated Plucker Ideal Script
R = QQ[{ring_vars}]

-- The Plucker Ideal
I_Plucker = ideal(
  {ideal_generators}
)

-- The Positroid Cell Ideal (fixing boundary variables to zero)
I_cell = ideal({cell_generators})

-- Compute the dimension of the coordinate ring modulo the ideals
D = dim(R / (I_Plucker + I_cell))

-- Export the calculated dimension
"scratch/m2_out.txt" << D << endl;
exit
"""
    with open(output_path, 'w') as f:
        f.write(m2_code)
    print(f"[Tier 1] Wrote Macaulay2 script to {output_path}")

def run_m2(script_path):
    """Tier 2: Executes Macaulay2 and retrieves the dimension."""
    print("[Tier 2] Executing Macaulay2 Gröbner basis calculations...")
    subprocess.run(["M2", "--no-readline", "--silent", script_path], check=True)
    
    with open("scratch/m2_out.txt", "r") as f:
        dim_val = int(f.read().strip())
    print(f"[Tier 2] Macaulay2 calculated dimension = {dim_val}")
    return dim_val

def inject_to_lean(dim_val, lean_output_path):
    """Tier 3: Injects the verified dimension directly to Lean 4."""
    os.makedirs(os.path.dirname(lean_output_path), exist_ok=True)
    lean_code = f"""-- Auto-Generated by generate_amplituhedron_bounds.py
import InfoGeometry.Topology.PositroidCell

namespace InfoGeometry.Topology.Amplituhedron

/-- The concrete, Macaulay2-verified dimension constant -/
def m2_dimension_bound : ℕ := {dim_val}

end InfoGeometry.Topology.Amplituhedron
"""
    with open(lean_output_path, 'w') as f:
        f.write(lean_code)
    print(f"[Tier 3] Injected verified constant into Lean 4: {lean_output_path}")

if __name__ == "__main__":
    # Parameters for Gr(2,4)
    k, n = 2, 4
    m2_script_path = "scratch/ideal_intersections.m2"
    lean_output_path = "lean/InfoGeometry/Topology/AmplituhedronBounds.lean"
    
    # Define a cell boundary (e.g., setting p_1_2 and p_1_3 to 0)
    cell_vars = ["p_1_2", "p_1_3"]
    
    # 1. Generate coordinates and Plucker relations
    var_names, relations = generate_plucker_relations(k, n)
    print(f"[Tier 1] Generated {len(var_names)} Plucker variables and {len(relations)} relations.")
    
    # 2. Write the Macaulay2 script
    write_m2_script(var_names, relations, cell_vars, m2_script_path)
    
    # 3. Execute Macaulay2 and compute dimension
    dim_val = run_m2(m2_script_path)
    
    # 4. Inject constant into Lean 4
    inject_to_lean(dim_val, lean_output_path)
    print("[Loop Complete] System successfully synchronized.")